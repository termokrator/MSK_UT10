// Поиск товара по различным видам поиска
//Функция FindGoodByBarcode(Barcode, TypeDocument = "", GUIDDocument = "", SearchType = "ПоискШтрихкодов" )
Функция FindGoodByBarcodeForSearchType(UserGUID, Barcode, TypeDocument, GUIDDocument, SearchType )
	
	// +++ Гавриленков, 12.11.2021, WARES-215
	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис ARMStoreKeeper_Test", УровеньЖурналаРегистрации.Информация,,,"Веб-сервис:Запуск. FindGoodByBarcodeForSearchType");
	
	
	Результат = Неопределено;
	ВнешняяОбработка = ПодключитьВнешнююОбработку(); 		
	Попытка
		
		Если SearchType = "ПоискШтрихкодов"  Тогда
			                                                                                             
			ТЗ = ВнешняяОбработка.ПолучитьТоварПоШтрихкоду(UserGUID, Barcode, TypeDocument, GUIDDocument);
			МассивВременный = ВнешняяОбработка.ТаблицуВМассив(ТЗ);
			Результат = ВнешняяОбработка.ДанныеВJSONХранилище(МассивВременный);

		ИначеЕсли SearchType = "ПоискПоНормализованномуКоду"  Тогда
			
			ТЗ = ВнешняяОбработка.ПолучитьТоварПоНормализованномуКодуВызов(UserGUID, Barcode, TypeDocument, GUIDDocument);
			
			МассивВременный = ВнешняяОбработка.ТаблицуВМассив(ТЗ);
			Результат = ВнешняяОбработка.ДанныеВJSONХранилище(МассивВременный);
			
		ИначеЕсли SearchType = "ПоискПоКоду" Тогда
			
			ТЗ =  ВнешняяОбработка.ПолучитьТоварПоКодуВызов(UserGUID, Barcode, TypeDocument, GUIDDocument);
			МассивВременный = ВнешняяОбработка.ТаблицуВМассив(ТЗ);
			Результат = ВнешняяОбработка.ДанныеВJSONХранилище(МассивВременный);
			
		КонецЕсли;                                                      
		
	Исключение
		
	    Результат = ПолучитьОписаниеОшибки(ОписаниеОшибки());
		
	КонецПопытки; 
	
	ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис ARMStoreKeeper_Test", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. FindGoodByBarcodeForSearchType " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
	
	Если Не Результат = Неопределено Тогда
	
		Возврат Результат;		
		
	КонецЕсли;  
	// --- Гавриленков, 12.11.2021
		
КонецФункции

// используется при работе сканера
Функция GetDocumentByBarcode(Barcode, UserIdGUID)   
	
	// +++ Гавриленков, 12.11.2021, WARES-215
	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис ARMStoreKeeper_Test", УровеньЖурналаРегистрации.Информация,,,"Веб-сервис:Запуск. GetDocumentByBarcode");
	// --- Гавриленков, 12.11.2021
	
	ВнешняяОбработка = ПодключитьВнешнююОбработку();
	UserIdСсылка = ВнешняяОбработка.ПолучитьПользователя(UserIdGUID);
	Попытка
		
		МассивДокументов = ШтрихкодированиеПечатныхФорм.ПолучитьСсылкуПоШтрихкодуТабличногоДокумента(Barcode);
		
		Если МассивДокументов.Количество() > 0 Тогда
			ДокументСсылка = МассивДокументов.Получить(0);		
			ВнешняяОбработка.ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Получить документ по штрихкоду", Barcode); 
			// +++ Гавриленков, 12.11.2021, WARES-215 
			РезультатВыполнения = ВнешняяОбработка.ПолучитьСписокДокументовПТУ( ДокументСсылка, Неопределено);
			ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
			ЗаписьЖурналаРегистрации("Web-сервис ARMStoreKeeper_Test", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. GetDocumentByBarcode " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
			Возврат РезультатВыполнения;
			// --- Гавриленков, 12.11.2021
			
			
		КонецЕсли;  
		
	Исключение
		// +++ Гавриленков, 12.11.2021, WARES-215
		РезультатВыполнения =  ПолучитьОписаниеОшибки(ОписаниеОшибки());
		ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ЗаписьЖурналаРегистрации("Web-сервис ARMStoreKeeper_Test", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. GetDocumentByBarcode " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
		Возврат РезультатВыполнения;
		// --- Гавриленков, 12.11.2021
		
	КонецПопытки; 
	

	
КонецФункции

