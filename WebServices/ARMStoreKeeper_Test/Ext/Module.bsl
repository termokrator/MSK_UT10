
&НаСервере
Функция ПодключитьВнешнююОбработку() 
	
	//ВременныйФайл = Новый Файл(ПолучитьИмяВременногоФайла("epf"));
	//ПутьДоОбработки = ВременныйФайл.Путь + "\ARMStoreKeeper.epf";
	//Результат = ПоместитьФайл(АдресХранилищаВнешОбработки, ПутьДоОбработки, , Ложь);
	//// при подключении внешней обработки (отчета), если подключаемая обработка (отчет) двоично идентична уже подключенной и совпадает признак безопасного режима, 
	//// реального переподключения не происходит, ошибки при этом не выдается. В противном случае ранее подключенная внешняя обработка (отчет) отключается и 
	//// выполняется новое подключение внешней обработки (отчета);
	//ВнешняяОбработка = ВнешниеОбработки.Подключить(АдресХранилищаВнешОбработки);
		
	ПутьДоОбработки =	КаталогВременныхФайлов() + "ARMStoreKeeper.epf";	                  
	Файл = Новый Файл(ПутьДоОбработки);
	Если Файл.Существует() Тогда
		ВнешняяОбработка = ВнешниеОбработки.Создать(ПутьДоОбработки, Ложь);	
	Иначе
		
	   Попытка	
		   СпрЗапись = Справочники.ВнешниеОбработкиДляВерсионированияФункционала.НайтиПоНаименованию("ARMStoreKeeper",Истина);
		   Если СпрЗапись.Пустая() Или СпрЗапись = Неопределено Тогда
		   	  Возврат Неопределено;
		   КонецЕсли; 
		   ДвоичныеДанные = СпрЗапись.ХранилищеВнешнейОбработки.Получить();
		   ИмяФайла = КаталогВременныхФайлов() + СпрЗапись.Наименование + ".epf";

		   ДвоичныеДанные.Записать(ИмяФайла);
		   
	   Исключение
		   Возврат Неопределено;
	   КонецПопытки; 
		
	КонецЕсли; 
	
	Возврат ВнешняяОбработка;
	
КонецФункции
 
  
