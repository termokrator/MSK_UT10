Функция ПолучитьОстаткиДенежныеСредстваНаДату(ОтборОрганизацииСтрокой, ОтборКассыСтрокой, ДатаОкончания)
	
	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис Billing", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис: Запуск. ПолучитьОстаткиДенежныеСредстваНаДату");
	
	ДатаОстатков = КонецДня(ДатаОкончания)+1;
	
	//ОТБОР ПО ОРГАНИЗАЦИЯМ  
	МассивОрганизаций = Новый Массив;
	
	Если ЗначениеЗаполнено(ОтборОрганизацииСтрокой) Тогда
		
		ОтборОрганизации = СтрокаВМассивСтрок(ОтборОрганизацииСтрокой, ";");

		Для Каждого Орг из ОтборОрганизации Цикл  
			
			ОрганизацияСсылка = Справочники.Организации.НайтиПоРеквизиту("КодМДМГоловнойОрганизации", Орг);
			
			Если ЗначениеЗаполнено(ОрганизацияСсылка) Тогда
				МассивОрганизаций.Добавить(ОрганизацияСсылка);
			Иначе  
				
				СтруктураВозврата = Новый Структура;
				СтруктураВозврата.Вставить("Результат", Ложь);
				СтруктураВозврата.Вставить("Сообщение", "Не найдена организация в базе УТ10 по коду МДМ " + Орг);
				
				РезультатВыполнения = ДанныеВJSON(СтруктураВозврата);
					
				Возврат РезультатВыполнения;  
				
			КонецЕсли;
			
		КонецЦикла;		

	КонецЕсли;

	//ОТБОР ПО КАССАМ   
	ОтборКассы = Новый Массив;
	
	Если ЗначениеЗаполнено(ОтборКассыСтрокой) Тогда
		
		ОтборКассы = СтрокаВМассивСтрок(ОтборКассыСтрокой, ";");  
		
		Для Каждого Касса из ОтборКассы Цикл  
			
			КассаСсылка = Справочники.Кассы.НайтиПоРеквизиту("КодМДМГоловнойКассы", Касса);
			
			Если Не ЗначениеЗаполнено(КассаСсылка) Тогда

				СтруктураВозврата = Новый Структура;
				СтруктураВозврата.Вставить("Результат", Ложь);
				СтруктураВозврата.Вставить("Сообщение", "Не найдена касса в базе УТ10 по коду МДМ " + Касса);
				
				РезультатВыполнения = ДанныеВJSON(СтруктураВозврата);
					
				Возврат РезультатВыполнения;  
				
			КонецЕсли;
			
		КонецЦикла;	
		
	КонецЕсли;
	
	Запрос = Новый Запрос;   
	                 
	Запрос.Текст ="ВЫБРАТЬ
	              |	ДенежныеСредстваОстатки.Организация.КодМДМГоловнойОрганизации КАК ОрганизацияКодМДМ,
	              |	ДенежныеСредстваОстатки.БанковскийСчетКасса.КодМДМГоловнойКассы КАК КассаКодМДМ,
	              |	ДенежныеСредстваОстатки.СуммаОстаток,
	              |	ДенежныеСредстваОстатки.Организация.Наименование,
	              |	ЕСТЬNULL(Кассы.Наименование, """") КАК КассаНаименование
	              |ПОМЕСТИТЬ ВТ
	              |ИЗ
	              |	РегистрНакопления.ДенежныеСредства.Остатки(
	              |			&ДатаОстатков,
	              |			1 = 1
	              |				И ВидДенежныхСредств = &Наличные
	              |				И 2 = 2) КАК ДенежныеСредстваОстатки
	              |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Кассы КАК Кассы
	              |		ПО ДенежныеСредстваОстатки.БанковскийСчетКасса.КодМДМГоловнойКассы = Кассы.КодМДМ
	              |;
	              |
	              |////////////////////////////////////////////////////////////////////////////////
	              |ВЫБРАТЬ
	              |	ВТ.ОрганизацияКодМДМ,
	              |	ВТ.КассаКодМДМ,
	              |	СУММА(ВТ.СуммаОстаток) КАК СуммаОстаток,
	              |	ВТ.ОрганизацияНаименование,
	              |	ВТ.КассаНаименование
	              |ИЗ
	              |	ВТ КАК ВТ
	              |
	              |СГРУППИРОВАТЬ ПО
	              |	ВТ.ОрганизацияКодМДМ,
	              |	ВТ.КассаКодМДМ,
	              |	ВТ.ОрганизацияНаименование,
	              |	ВТ.КассаНаименование"; 
	
	Если ОтборКассы.Количество()>0 Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "1 = 1", "БанковскийСчетКасса.КодМДМГоловнойКассы В (&ОтборКассы)");
		Запрос.УстановитьПараметр("ОтборКассы",  ОтборКассы);	
		
	КонецЕсли;
	
	Если МассивОрганизаций.Количество()>0 Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "2 = 2", "Организация В (&МассивОрганизаций)");
		Запрос.УстановитьПараметр("МассивОрганизаций",  МассивОрганизаций);	
		
	КонецЕсли;

	Запрос.УстановитьПараметр("Наличные",  Перечисления.ВидыДенежныхСредств.Наличные);
	Запрос.УстановитьПараметр("ДатаОстатков", ДатаОстатков);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	МассивВозврата = Новый Массив;

	Пока Результат.Следующий() Цикл
		МассивВозврата.Добавить(Новый Структура("ОрганизацияКодМДМ, ОрганизацияНаименование, КассаКодМДМ, КассаНаименование, СуммаОстаток", Результат.ОрганизацияКодМДМ, Результат.ОрганизацияНаименование, Результат.КассаКодМДМ, Результат.КассаНаименование, Результат.СуммаОстаток));	
	КонецЦикла;

	РезультатВыполнения = ДанныеВJSON(МассивВозврата);
	
	ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис Billing", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. ПолучитьОстаткиДенежныеСредстваНаДату " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
	
	Возврат РезультатВыполнения;
	
КонецФункции

