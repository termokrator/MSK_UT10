		|
		|СГРУППИРОВАТЬ ПО
		|	РеализацияТоваровУслугТовары.Ссылка";  
		
		ЗапросКросс.Текст = СтрЗаменить(ЗапросКросс.Текст, "РеализацияТоваровУслуг", ТипЭлемента);
		
