		ОтборНоменклатура = СтрокаВМассивСтрок(ОтборНоменклатураСтрокой, ";");

		Для Каждого Ном из ОтборНоменклатура Цикл  
			
			НоменклатураСсылка = Справочники.Номенклатура.НайтиПоРеквизиту("КодМДМ", Ном);
			
			Если ЗначениеЗаполнено(НоменклатураСсылка) Тогда
				МассивНоменклатуры.Добавить(НоменклатураСсылка);
			Иначе  
				
				СтруктураВозврата = Новый Структура;
				СтруктураВозврата.Вставить("Результат", Ложь);
				СтруктураВозврата.Вставить("Сообщение", "Не найдена номенклатура в базе УТ10 по коду МДМ " + Ном);
				
				РезультатВыполнения = ДанныеВJSON(СтруктураВозврата);
					
				Возврат РезультатВыполнения;  
				
			КонецЕсли;
			
		КонецЦикла;	 
	
	КонецЕсли;

	МассивВозврата = Новый Массив;
		
	Запрос = Новый Запрос;   
	                 
	Запрос.Текст ="ВЫБРАТЬ
	              |	ТоварыНаСкладахОстаткиИОбороты.Склад.КодМДМ КАК КодМДМ_Склад,
	              |	ТоварыНаСкладахОстаткиИОбороты.Номенклатура.Наименование КАК Наименование,
	              |	ТоварыНаСкладахОстаткиИОбороты.Номенклатура.Артикул КАК Бит_ИнвентарныйНомер,
	              |	ТоварыНаСкладахОстаткиИОбороты.Номенклатура.КодМДМ КАК КодМДМ_Номенклатура,
	              |	ТоварыНаСкладахОстаткиИОбороты.Регистратор,
