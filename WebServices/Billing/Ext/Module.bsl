Функция ПолучитьТекстУсловияЭтоБазаОбособленногоПодразделения(пТаблицаДокументов, пТаблицаКонстант = "Константы")
//+Бычков О. 28.07.2026 #UT10-5977
// Вставка

	ТекРезультат = "ВЫБОР
		  |				КОГДА " + пТаблицаКонстант + ".ДатаСменыОП_ГП = ДАТАВРЕМЯ(1, 1, 1)
		  |					ТОГДА " + пТаблицаКонстант + ".ПополнениеДляОбособленногоПодразделенияЮЛ
		  |				ИНАЧЕ ВЫБОР
		  |						КОГДА " + пТаблицаКонстант + ".ПополнениеДляОбособленногоПодразделенияЮЛ
		  |								И " + пТаблицаДокументов + ".Дата >= " + пТаблицаКонстант + ".ДатаСменыОП_ГП
		  |							ТОГДА ИСТИНА
		  |						КОГДА НЕ " + пТаблицаКонстант + ".ПополнениеДляОбособленногоПодразделенияЮЛ
		  |								И " + пТаблицаДокументов + ".Дата < " + пТаблицаКонстант + ".ДатаСменыОП_ГП
		  |							ТОГДА ИСТИНА
		  |						ИНАЧЕ ЛОЖЬ
		  |					КОНЕЦ
		  |			КОНЕЦ";
	
	Возврат ТекРезультат;
	
//-Бычков О. 28.07.2026 #UT10-5977
КонецФункции

 
