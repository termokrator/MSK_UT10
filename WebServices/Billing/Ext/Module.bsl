Функция ПолучитьДанныеДокументовПоДиапазонуВерсий(ВерсияНачало, ВерсияКонец, Документ, Суммировать, ДатаНачала, ДатаОкончания)

	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис Billing", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Запуск. ПолучитьДанныеДокументовПоДиапазонуВерсий");
	
	//+Бычков О. 28.08.2025 #UT10-5397
	// Вставка
	ТекМаркер = "<marker>6b35e660-2303-4a8d-8611-0d32f64cfa57</marker>";
	ТекДлина = СтрДлина(ТекМаркер);
	Если Лев(Документ, ТекДлина) = ТекМаркер Тогда
		
		// Использован специальный маркер, который означает, что в параметр переданы и вид документа и вид документа базы-корреспондента.
		// Получаем эти виды отдельно.
		ТекДокумент = Сред(Документ, ТекДлина + 1);
		ТекДокументы = СтрокаВМассивСтрок(ТекДокумент, ",");
		
		Документ = ТекДокументы[0];
		
		ДокументКорреспондента = ТекДокументы[1];
		
	КонецЕсли;
	//-Бычков О. 28.08.2025 #UT10-5397
	
	Если Документ = "ПеремещениеТоваровМеждуСкладами" Тогда  
		
		РезультатПроверки = ПроверитьНастройкуДокументаВыгрузки("РеализацияТоваровУслуг"); 
		
		Если Не РезультатПроверки.Результат Тогда
			
			ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
			ЗаписьЖурналаРегистрации("Web-сервис Billing", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. ПолучитьДанныеДокументовПоДиапазонуВерсий " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
			
			Возврат РезультатПроверки.Сообщение;
			
		КонецЕсли;     
		
		РезультатПроверки = ПроверитьНастройкуДокументаВыгрузки("ПоступлениеТоваровУслуг"); 
		
		Если Не РезультатПроверки.Результат Тогда
			
			ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
			ЗаписьЖурналаРегистрации("Web-сервис Billing", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. ПолучитьДанныеДокументовПоДиапазонуВерсий " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
			
			Возврат РезультатПроверки.Сообщение;
			
		КонецЕсли; 
	
	Иначе
		
		РезультатПроверки = ПроверитьНастройкуДокументаВыгрузки(Документ); 
		
		Если Не РезультатПроверки.Результат Тогда
			
			ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
			ЗаписьЖурналаРегистрации("Web-сервис Billing", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. ПолучитьДанныеДокументовПоДиапазонуВерсий " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
			
			Возврат РезультатПроверки.Сообщение;
			
		КонецЕсли; 		
		
	КонецЕсли;
		
	ДатаН = Дата(ДатаНачала);
	ДатаО = Дата(ДатаОкончания);
	
	МассивВозврата = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВерсияНачало", ВерсияНачало);
	Запрос.УстановитьПараметр("ВерсияКонец", ВерсияКонец);
	Запрос.УстановитьПараметр("ДатаНачала", ДатаН);
	Запрос.УстановитьПараметр("ДатаОкончания", ?(Не ЗначениеЗаполнено(ДатаО), ТекущаяДата(), ДатаО));
	Запрос.УстановитьПараметр("ИНН", Константы.ОсновнаяОрганизация.Получить().ИНН); 
	Запрос.УстановитьПараметр("ОсновнойПоставщик", Константы.ОсновнойПоставщик.Получить());
	
	//Исключаем документы кросс-докинга
	Если Документ = "РеализацияТоваровУслуг" 
		ИЛИ Документ = "КорректировкаРеализации"
		ИЛИ Документ = "СчетФактураВыданный" Тогда
		
		Запрос.УстановитьПараметр("МассивДокументовКросс", ПолучитьМассивКроссовЗаПериод(ДатаН, ДатаО, Документ)); 
		
	Иначе                                                                          
		Запрос.УстановитьПараметр("МассивДокументовКросс", Новый Массив()); 
	КонецЕсли;
	
	ТекстЗапроса = ""; 
	
	Если Суммировать Тогда
		
		ТекстЗапроса = ПолучитьЗапросСпискаЭлементов(Документ) + "
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_Элементы.Ссылка) КАК Количество,
		|	СУММА(ВТ_Элементы.Ссылка.ШтампВерсии) КАК СуммаВерсий,
		|	МИНИМУМ(ВТ_Элементы.Ссылка.ШтампВерсии) КАК ВерсияНачало,
		|	МАКСИМУМ(ВТ_Элементы.Ссылка.ШтампВерсии) КАК ВерсияКонец,
		|	Сумма(Выбор когда ВТ_Элементы.Ссылка.Проведен Тогда 1 Иначе 0 Конец) КАК Проведено
		|ИЗ
		|	ВТ_Элементы КАК ВТ_Элементы";
		
		//+Бычков О. 28.08.2025 #UT10-5397
		// Было
		//ТекстЗапроса = ТекстЗапроса + ДополнитьЗапросУсловиямиСверки(Документ);  
		// Стало
		ТекстЗапроса = ТекстЗапроса + ДополнитьЗапросУсловиямиСверки(Документ, ДокументКорреспондента, Запрос);  
		//-Бычков О. 28.08.2025 #ERP-1556
		
		
		Запрос.Текст = ТекстЗапроса;
		
		СтруктураВозврата = Новый Структура("ВерсияНачало, ВерсияКонец, Количество, СуммаВерсий, Проведено");
		
		Выборка = Запрос.Выполнить().Выбрать();		
		
		Если Выборка.Следующий() Тогда
			
			СтруктураВозврата.ВерсияНачало = ?(ЗначениеЗаполнено(Выборка.ВерсияНачало), Выборка.ВерсияНачало, 0);
			СтруктураВозврата.ВерсияКонец = ?(ЗначениеЗаполнено(Выборка.ВерсияКонец), Выборка.ВерсияКонец, 0);
			СтруктураВозврата.СуммаВерсий = ?(ЗначениеЗаполнено(Выборка.СуммаВерсий), Выборка.СуммаВерсий, 0);
			СтруктураВозврата.Количество = Выборка.Количество; 
			СтруктураВозврата.Проведено = Выборка.Проведено; 
			
		КонецЕсли;  
		
		РезультатВыполнения = ДанныеВJSON(СтруктураВозврата);
			
		Возврат РезультатВыполнения; 		
					
	Иначе
		
		ТекстЗапроса = ПолучитьЗапросСпискаЭлементов(Документ) + "
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Элементы.Ссылка КАК Ссылка,
		|	ВТ_Элементы.Ссылка.ШтампВерсии КАК Версия,
		|	ВТ_Элементы.Ссылка.Дата КАК Дата,
		|	ПРЕДСТАВЛЕНИЕ(ВТ_Элементы.Ссылка) КАК Представление,
		|	ВТ_Элементы.Ссылка.Проведен КАК Проведен
		|ИЗ
		|	ВТ_Элементы КАК ВТ_Элементы";      
		
		//+Бычков О. 28.08.2025 #UT10-5397
		// Было
		//ТекстЗапроса = ТекстЗапроса + ДополнитьЗапросУсловиямиСверки(Документ);
		// Стало
		ТекстЗапроса = ТекстЗапроса + ДополнитьЗапросУсловиямиСверки(Документ, ДокументКорреспондента, Запрос);
		//-Бычков О. 28.08.2025 #UT10-5397
		
		
		Запрос.Текст = ТекстЗапроса;
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			МассивВозврата.Добавить(Новый Структура("GUID, Версия, Дата, Представление, Тип, Проведен", Строка(Выборка.Ссылка.УникальныйИдентификатор()), Выборка.Версия, Выборка.Дата, Выборка.Представление, Выборка.Ссылка.Метаданные().Имя, Выборка.Проведен));
			
		КонецЦикла;			
		
	КонецЕсли;

	РезультатВыполнения = ДанныеВJSON(МассивВозврата);
		
	ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис Billing", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. ПолучитьДанныеДокументовПоДиапазонуВерсий " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
	
	Возврат РезультатВыполнения;
	
КонецФункции

Функция ПолучитьДанныеРегистровПоПериоду(Регистр, ИмяРесурса, Суммировать, ДатаНачала, ДатаОкончания)
	
	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис Billing", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис: Запуск. ПолучитьДанныеРегистровПоПериоду");
			
	ДатаН = Дата(ДатаНачала);
	ДатаО = Дата(ДатаОкончания);
	
	МассивВозврата = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала", ДатаН);
	Запрос.УстановитьПараметр("ДатаОкончания", ?(НЕ ЗначениеЗаполнено(ДатаО), ТекущаяДата(), ДатаО));
	Запрос.УстановитьПараметр("ИНН", Константы.ОсновнаяОрганизация.Получить().ИНН); 
	Запрос.УстановитьПараметр("ВидДенежныхСредствНаличные", Перечисления.ВидыДенежныхСредств.Наличные);
	
	//Исключаем документы кросс-докинга
	Запрос.УстановитьПараметр("МассивДокументовКросс", ПолучитьОбщийМассивКроссовЗаПериод(ДатаН, ДатаО)); 
	
	ТекстЗапроса = "";
	
	Если Суммировать Тогда
		
		ТекстЗапроса = ПолучитьЗапросСпискаЭлементовРегистра(Регистр, ИмяРесурса) + "
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_Элементы.Регистратор) КАК Количество,
		|	СУММА(ВТ_Элементы.Ресурс) КАК СуммаРесурсов,
		|	МИНИМУМ(ВТ_Элементы.Регистратор.Дата) КАК ПериодНачало,
		|	МАКСИМУМ(ВТ_Элементы.Регистратор.Дата) КАК ПериодКонец
		|ИЗ
		|	ВТ_Элементы КАК ВТ_Элементы";
				
		ТекстЗапроса = ТекстЗапроса + ДополнитьЗапросУсловиямиСверкиРегистров(Регистр);  
		
		Запрос.Текст = ТекстЗапроса;
		
		СтруктураВозврата = Новый Структура("ПериодНачало, ПериодКонец, Количество, СуммаРесурсов");
		
		Выборка = Запрос.Выполнить().Выбрать();		
		
		Если Выборка.Следующий() Тогда
			
			СтруктураВозврата.ПериодНачало = ?(ЗначениеЗаполнено(Выборка.ПериодНачало), Выборка.ПериодНачало, 0);
			СтруктураВозврата.ПериодКонец = ?(ЗначениеЗаполнено(Выборка.ПериодКонец), Выборка.ПериодКонец, 0);
			СтруктураВозврата.СуммаРесурсов = ?(ЗначениеЗаполнено(Выборка.СуммаРесурсов), Выборка.СуммаРесурсов, 0);
			СтруктураВозврата.Количество = Выборка.Количество; 
			
		КонецЕсли;  
		
		РезультатВыполнения = ДанныеВJSON(СтруктураВозврата);
			
		Возврат РезультатВыполнения; 		
					
	Иначе
		
		ТекстЗапроса = ПолучитьЗапросСпискаЭлементовРегистра(Регистр, ИмяРесурса) + "
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Элементы.Регистратор КАК Регистратор,
		|	ВТ_Элементы.Ресурс КАК Ресурс,
		|	ВТ_Элементы.Регистратор.Дата КАК Дата,
		|	ПРЕДСТАВЛЕНИЕ(ВТ_Элементы.Регистратор) КАК Представление
		|ИЗ
		|	ВТ_Элементы КАК ВТ_Элементы";      
		 
		ТекстЗапроса = ТекстЗапроса + ДополнитьЗапросУсловиямиСверкиРегистров(Регистр);
		
		Запрос.Текст = ТекстЗапроса;
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			МассивВозврата.Добавить(Новый Структура("GUID, Ресурс, Дата, Представление, Тип", Строка(Выборка.Регистратор.УникальныйИдентификатор()), Выборка.Ресурс, Выборка.Дата, Выборка.Представление, Выборка.Регистратор.Метаданные().Имя));
			
		КонецЦикла;			
		
	КонецЕсли;

	РезультатВыполнения = ДанныеВJSON(МассивВозврата);
		
	ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис Billing", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. ПолучитьДанныеРегистровПоПериоду " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
	
	Возврат РезультатВыполнения;

КонецФункции

Функция ПолучитьОстаткиТоварыНаСкладахНаДату(ОтборСкладыСтрокой, ДатаОкончания, ОтборНоменклатураСтрокой, ОтборВидНоменклатурыСтрокой)

	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис Billing", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис: Запуск. ПолучитьОстаткиТоварыНаСкладахНаДату");
	
	//ОТБОР ПО СКЛАДАМ  
	МассивСкладов = Новый Массив; 

	Если ЗначениеЗаполнено(ОтборСкладыСтрокой) Тогда
		
		ОтборСклады = СтрокаВМассивСтрок(ОтборСкладыСтрокой, ";");
				
		Для Каждого Скл из ОтборСклады Цикл  
			
			СкладСсылка = Справочники.Склады.НайтиПоРеквизиту("КодМДМ", Скл);
			
			Если ЗначениеЗаполнено(СкладСсылка) Тогда
				МассивСкладов.Добавить(СкладСсылка);
			Иначе  
				
				СтруктураВозврата = Новый Структура;
				СтруктураВозврата.Вставить("Результат", Ложь);
				СтруктураВозврата.Вставить("Сообщение", "Не найден склад в базе УТ10 по коду МДМ " + Скл);
				
				РезультатВыполнения = ДанныеВJSON(СтруктураВозврата);
					
				Возврат РезультатВыполнения;  
				
			КонецЕсли;
			
		КонецЦикла;	

	КонецЕсли;

	//ОТБОР ПО НОМЕНКЛАТУРЕ      
	МассивНоменклатуры = Новый Массив; 
	
	Если ЗначениеЗаполнено(ОтборНоменклатураСтрокой) Тогда
		
		ОтборНоменклатура = СтрокаВМассивСтрок(ОтборНоменклатураСтрокой, ";");
	
		Для Каждого Ном из ОтборНоменклатура Цикл  
			
			НоменклатураСсылка = Справочники.Номенклатура.НайтиПоРеквизиту("КодМДМ", Ном);
			
			Если ЗначениеЗаполнено(НоменклатураСсылка) Тогда
				МассивНоменклатуры.Добавить(НоменклатураСсылка);
			Иначе  
				
				СтруктураВозврата = Новый Структура;
				СтруктураВозврата.Вставить("Результат", Ложь);
				СтруктураВозврата.Вставить("Сообщение", "Не найдена номенклатура в базе УТ10 по коду МДМ " + Ном);
				
				РезультатВыполнения = ДанныеВJSON(СтруктураВозврата);
					
				Возврат РезультатВыполнения;  
				
			КонецЕсли;
			
		КонецЦикла;	
	
	КонецЕсли;
	
	//ОТБОР ПО ВИДУ НОМЕНКЛАТУРЫ
	МассивВидаНоменклатуры = Новый Массив; 
	
	Если ЗначениеЗаполнено(ОтборВидНоменклатурыСтрокой) Тогда
		
		ОтборВидНоменклатуры = СтрокаВМассивСтрок(ОтборВидНоменклатурыСтрокой, ";");
	
		Для Каждого ВидНом из ОтборВидНоменклатуры Цикл  
			
			ВидНомСсылка = Справочники.ВидыНоменклатуры.НайтиПоРеквизиту("КодМДМ", ВидНом);
			
			Если ЗначениеЗаполнено(ВидНомСсылка) Тогда    
				
				Если СокрЛП(ВидНомСсылка.Наименование) = "Товар" Тогда
					МассивВидаНоменклатуры.Добавить(ВидНомСсылка);	
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;	
	
	КонецЕсли;	
	
	ДатаОстатков = КонецДня(ДатаОкончания)+1;
	
	МассивВозврата = Новый Массив;
		
	Запрос = Новый Запрос;   
	                 
	Запрос.Текст ="ВЫБРАТЬ
	              |	ТоварыНаСкладахОстатки.Склад.КодМДМ КАК КодМДМ_Склад,
	              |	ТоварыНаСкладахОстатки.Номенклатура.Наименование КАК Наименование,
	              |	ТоварыНаСкладахОстатки.Номенклатура.Артикул КАК Бит_ИнвентарныйНомер,
	              |	ТоварыНаСкладахОстатки.КоличествоОстаток КАК Остаток,
	              |	ТоварыНаСкладахОстатки.Номенклатура.КодМДМ КАК КодМДМ_Номенклатура
	              |ИЗ
	              |	РегистрНакопления.ТоварыНаСкладах.Остатки(
	              |			&Д,
	              |			   3 = 3
	              |				И 2 = 2 И 1 = 1) КАК ТоварыНаСкладахОстатки";
	
	Если МассивНоменклатуры.Количество()>0 Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "1 = 1", "Номенклатура В (&МассивНоменклатуры)");
		Запрос.УстановитьПараметр("МассивНоменклатуры",  МассивНоменклатуры);	
		
	КонецЕсли;
	
	Если МассивСкладов.Количество()>0 Тогда
	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "2 = 2", "Склад В (&МассивСкладов)");
		Запрос.УстановитьПараметр("МассивСкладов",  МассивСкладов); 
	
	КонецЕсли;
	
	Если МассивВидаНоменклатуры.Количество()>0 Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "3 = 3", "Номенклатура.ВидНоменклатуры В (&МассивВидаНоменклатуры)");
        Запрос.УстановитьПараметр("МассивВидаНоменклатуры",  МассивВидаНоменклатуры);  
		
	ИначеЕсли ЗначениеЗаполнено(ОтборВидНоменклатурыСтрокой) Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "3 = 3", "Не Номенклатура.ВидНоменклатуры = &ВидНоменклатурыТовар");
		Запрос.УстановитьПараметр("ВидНоменклатурыТовар",  Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Товар", Истина)); 
   		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Д", ДатаОстатков);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		МассивВозврата.Добавить(Новый Структура("КодМДМ_Склад, КодМДМ_Номенклатура, Наименование, Бит_ИнвентарныйНомер, Остаток", Результат.КодМДМ_Склад, Результат.КодМДМ_Номенклатура, Результат.Наименование, Результат.Бит_ИнвентарныйНомер, Результат.Остаток));	
	КонецЦикла;
	
	РезультатВыполнения = ДанныеВJSON(МассивВозврата);
	
	ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис Billing", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. ПолучитьОстаткиТоварыНаСкладахНаДату " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
	
	Возврат РезультатВыполнения;
		
КонецФункции

Функция ПолучитьОборотыТоварыНаСкладахЗаПериод(ОтборСкладыСтрокой, ДатаНачала, ДатаОкончания, ОтборНоменклатураСтрокой)
	
	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис Billing", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис: Запуск. ПолучитьОборотыТоварыНаСкладахЗаПериод");
	
