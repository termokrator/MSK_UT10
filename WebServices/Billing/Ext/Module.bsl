  
////////////Методы веб сервиса///////////////////////////
Функция ПолучитьСуммуДокументовПоПериоду(Тип, ДатаНачала, ДатаОкончания, Контрагент, ДоговорКонтрагента, ТипДокумента)
	
	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис Billing", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Запуск. ПолучитьСуммуДокументовПоПериоду");
	
	ДатаН = Дата(ДатаНачала);
	ДатаК = Дата(ДатаОкончания);
	
	Если ЗначениеЗаполнено(СокрЛП(Контрагент)) Тогда 		
		Конт = Справочники.Контрагенты.НайтиПоРеквизиту("КодМДМ", СокрЛП(Контрагент));		
	Иначе                                                         		
		Конт = Неопределено;                                      		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СокрЛП(ДоговорКонтрагента)) Тогда 		
		Дог = Справочники.ДоговорыКонтрагентов.НайтиПоРеквизиту("КодМДМ", СокрЛП(ДоговорКонтрагента));		
	Иначе                                                         		
		Дог = Неопределено;                                      		
	КонецЕсли;
	
	//+Марков И. 02.09.2025 #UT10-5410
	Если ЗначениеЗаполнено(СокрЛП(Контрагент)) Или ЗначениеЗаполнено(СокрЛП(ДоговорКонтрагента))  Тогда
		
		Если Конт = Неопределено Или Конт = Справочники.Контрагенты.ПустаяСсылка() Тогда
			
			СтруктураВозврата = Новый Структура;
			СтруктураВозврата.Вставить("message", "Контрагент """ + Контрагент + """ и Договор """ + ДоговорКонтрагента + """ не найдены в базе.");
			СтруктураВозврата.Вставить("code", "NOT_FOUND_KONTRAGENT");
			Результат = ДанныеВJSON(СтруктураВозврата);
			
			ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
			ЗаписьЖурналаРегистрации("Web-сервис Billing", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. ПолучитьСуммуДокументовПоПериоду " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
			
			Возврат Результат;			
			
		КонецЕсли; 
		
		Если Дог = Неопределено ИЛИ Дог = Справочники.ДоговорыКонтрагентов.ПустаяСсылка() Тогда
			
			СтруктураВозврата = Новый Структура;
			СтруктураВозврата.Вставить("message", "Контрагент """ + Контрагент + """ и Договор """ + ДоговорКонтрагента + """ не найдены в базе.");   
			СтруктураВозврата.Вставить("code", "NOT_FOUND_AGREEMENT");
			Результат = ДанныеВJSON(СтруктураВозврата);
			
			ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
			ЗаписьЖурналаРегистрации("Web-сервис Billing", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. ПолучитьСуммуДокументовПоПериоду " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
			
			Возврат Результат;			
			
		КонецЕсли;
		
	КонецЕсли;
	//-Марков И. 02.09.2025 #UT10-5410
	
	Если (ЗначениеЗаполнено(Конт) И ЗначениеЗаполнено(Дог)) И 
		(Конт <> Справочники.Контрагенты.ПустаяСсылка() И Дог <> Справочники.ДоговорыКонтрагентов.ПустаяСсылка()) Тогда
		
		Если Конт <> Дог.Владелец Тогда
			
			СтруктураВозврата = Новый Структура;
			СтруктураВозврата.Вставить("message", "Контрагент """ + Контрагент + """ и Договор """ + ДоговорКонтрагента + """. Договор не принадлежит контрагенту.");   
			СтруктураВозврата.Вставить("code", "AGREEMENT_NOT_OWN_KONTRAGENT");
			Результат = ДанныеВJSON(СтруктураВозврата);
			
			ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
			ЗаписьЖурналаРегистрации("Web-сервис Billing", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. ПолучитьСуммуДокументовПоПериоду " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
			
			Возврат Результат;			
			
		КонецЕсли; 
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Контрагенты.Ссылка
	|ПОМЕСТИТЬ Контрагенты
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ	
	|	(&ПустойКонтрагент
	|			ИЛИ Контрагенты.Ссылка = &Контрагент)
	|;
	|$ТексЗапросаПоДокументу$
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Суммы.Ссылка,
	|	Суммы.ТипДокумента,
	|	Суммы.ШтампВерсии,
	|	Сумма(Суммы.ШтампВерсии) КАК СуммаШтамповВерсий,
	|	Сумма(ВЫБОР
	|		КОГДА Суммы.СуммаДокумента = 0 
	|			ТОГДА 1 
	|		КОГДА (ВЫБОР КОГДА Суммы.СуммаДокумента < 0 Тогда Суммы.СуммаДокумента * -1 Иначе Суммы.СуммаДокумента Конец) * 100 / 2 - (ВЫРАЗИТЬ((ВЫБОР КОГДА Суммы.СуммаДокумента < 0 Тогда Суммы.СуммаДокумента * -1 Иначе Суммы.СуммаДокумента Конец) * 100 / 2 - 0.5 КАК ЧИСЛО(15, 0))) = 0
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ) КАК СуммаЧетныхСуммДокументов,
	|	Суммы.Номер,
	|	Суммы.Контрагент,
	|	ПРЕДСТАВЛЕНИЕ(Суммы.Контрагент) КАК КонтрагентПредставление,
	|	Суммы.Период КАК Период,
	|	СУММА(Суммы.СуммаДокумента) КАК Сумма,
	|	Суммы.Контрагент.КодМДМ,
	|	Суммы.ДоговорКонтрагента.КодМДМ
	|ИЗ
	|	Суммы КАК Суммы
	|
	|СГРУППИРОВАТЬ ПО
	|	Суммы.Ссылка,
	|	Суммы.ТипДокумента,
	|	Суммы.ШтампВерсии,
	|	Суммы.Номер,
	|	Суммы.Контрагент,
	|	Суммы.Период,
	|	Суммы.Контрагент.КодМДМ,
	|	Суммы.ДоговорКонтрагента.КодМДМ
	|
	|УПОРЯДОЧИТЬ ПО                                       
	|	Период";
	
	ЭтоПервыйЗапрос = Истина;
	
	ТипыДокументов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТипДокумента, ",", Истина);
	
	ВыборкаВидов = Справочники.AMQP_ДокументыВыгрузки.Выбрать();
	
	ТексЗапросаПоДокументу = "";
	ЕстьДокументКВыгрузке = Ложь;
	
	Пока ВыборкаВидов.Следующий() Цикл
		
		Если Не ВыборкаВидов.SOAPBilling Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяДокумента = ВыборкаВидов.ИмяДокумента;
		
		Если ТипыДокументов.Количество() > 0 И ТипыДокументов.Найти(ИмяДокумента) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ВыборкаВидов.Выгружать Тогда
			Продолжить;
		КонецЕсли;  
		
		ЕстьДокументКВыгрузке = Истина;
		
		ЗнакМинус = "";
		
		Если ИмяДокумента = "РеализацияТоваровУслуг" ИЛИ 
			ИмяДокумента = "РасходныйКассовыйОрдер" ИЛИ 
			ИмяДокумента = "ПлатежноеПоручениеИсходящее" ИЛИ
			ИмяДокумента = "КорректировкаДолга" ИЛИ
			ИмяДокумента = "КорректировкаРеализации" Тогда
			ЗнакМинус = "-";
		КонецЕсли;
		
		ТексЗапросаПоДокументу = ТексЗапросаПоДокументу + Символы.ПС + ?(НЕ ЭтоПервыйЗапрос, "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС, "");
		
		Если ИмяДокумента = "КорректировкаДолга" Тогда
			
			ТексЗапросаПоДокументу = ТексЗапросаПоДокументу + 
			"ВЫБРАТЬ
			|	ВЫРАЗИТЬ(ДокВыборки.Регистратор КАК Документ.КорректировкаДолга).Ссылка КАК Ссылка,
			|	""КорректировкаДолга"" КАК ТипДокумента,
			|	ВЫРАЗИТЬ(ДокВыборки.Регистратор КАК Документ.КорректировкаДолга).ШтампВерсии КАК ШтампВерсии,
			|	ВЫРАЗИТЬ(ДокВыборки.Регистратор КАК Документ.КорректировкаДолга).Номер КАК Номер,
			|	" + ЗнакМинус + "ЕСТЬNULL(ДокВыборки.СуммаВзаиморасчетовОборот, 0) КАК СуммаДокумента,
			|	ЕСТЬNULL(ДокВыборки.СуммаВзаиморасчетовПриход, 0) КАК СуммаДокументаПриход,
			|	ВЫРАЗИТЬ(ДокВыборки.Контрагент КАК Справочник.Контрагенты) КАК Контрагент,
			|	ДокВыборки.ДоговорКонтрагента КАК ДоговорКонтрагента,
			|	НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(ДокВыборки.Регистратор КАК Документ.КорректировкаДолга).Дата, МЕСЯЦ) КАК Период" +
			?(ЭтоПервыйЗапрос, Символы.ПС + "ПОМЕСТИТЬ Суммы", "") + "
			|ИЗ
			|	РегистрНакопления.ВзаиморасчетыСКонтрагентами.Обороты(
			|			&ДатаНачала,
			|			&ДатаОкончания,
			|			Регистратор,
			|			ВЫРАЗИТЬ(Контрагент КАК Справочник.Контрагенты) В
			|					(ВЫБРАТЬ
			|						Контрагенты.Ссылка
			|					ИЗ
			|						Контрагенты)
			|				И (&ПустойДоговор
			|					ИЛИ ДоговорКонтрагента = &ДоговорКонтрагента)) КАК ДокВыборки
			|ГДЕ
			|	ДокВыборки.Регистратор ССЫЛКА Документ.КорректировкаДолга
			|	И ДокВыборки.Регистратор.НеОтправлятьДокументВУчетныеСистемы = ЛОЖЬ
			|";
			
			Если Тип <> "day" Тогда
				
				ТексЗапросаПоДокументу = СтрЗаменить(ТексЗапросаПоДокументу, """КорректировкаДолга"" КАК ТипДокумента,", "");
				//ТексЗапросаПоДокументу = СтрЗаменить(ТексЗапросаПоДокументу, "ВЫРАЗИТЬ(ДокВыборки.Регистратор КАК Документ.КорректировкаДолга).Ссылка КАК Ссылка,", "");
				//ТексЗапросаПоДокументу = СтрЗаменить(ТексЗапросаПоДокументу, "ВЫРАЗИТЬ(ДокВыборки.Регистратор КАК Документ.КорректировкаДолга).ШтампВерсии КАК ШтампВерсии,", "");
				ТексЗапросаПоДокументу = СтрЗаменить(ТексЗапросаПоДокументу, "ВЫРАЗИТЬ(ДокВыборки.Регистратор КАК Документ.КорректировкаДолга).Номер КАК Номер,", "");
				
			Иначе
				ТексЗапросаПоДокументу = СтрЗаменить(ТексЗапросаПоДокументу, "НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(ДокВыборки.Регистратор КАК Документ.КорректировкаДолга).Дата, МЕСЯЦ)", "ВЫРАЗИТЬ(ДокВыборки.Регистратор КАК Документ.КорректировкаДолга).Дата");
			КонецЕсли;
			
		ИначеЕсли ИмяДокумента = "КорректировкаРеализации" Тогда
			
			ТексЗапросаПоДокументу = ТексЗапросаПоДокументу +
			"ВЫБРАТЬ
			|	ДокВыборки.Ссылка КАК Ссылка,
			|   """ + ВыборкаВидов.ИмяДокумента + """ КАК ТипДокумента,
			|	ДокВыборки.ШтампВерсии КАК ШтампВерсии,
			|	ДокВыборки.Номер КАК Номер,
			|	" + ЗнакМинус + "СУММА( ЕСТЬNULL(ПродажиОбороты.СтоимостьОборот, 0) ) КАК СуммаДокумента,
			|	0 КАК СуммаДокументаПриход,
			|	ВЫРАЗИТЬ(ДокВыборки.Контрагент КАК Справочник.Контрагенты) КАК Контрагент,
			|	ДокВыборки.ДоговорКонтрагента КАК ДоговорКонтрагента,
			|	НАЧАЛОПЕРИОДА(ДокВыборки.Дата, МЕСЯЦ) КАК Период" +
			?(ЭтоПервыйЗапрос, Символы.ПС + "ПОМЕСТИТЬ Суммы", "") + "
			|ИЗ
			|	Документ.КорректировкаРеализации КАК ДокВыборки
			|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Продажи.Обороты(
			|		&ДатаНачала,
			|		&ДатаОкончания,
			|		Регистратор,
			|		Контрагент В
			|			(ВЫБРАТЬ
			|				Контрагенты.Ссылка
			|			ИЗ
			|				Контрагенты)) КАК ПродажиОбороты
			|	ПО ДокВыборки.Ссылка = ПродажиОбороты.Регистратор
			|ГДЕ
			|	ВЫРАЗИТЬ(ДокВыборки.Контрагент КАК Справочник.Контрагенты) В
			|			(ВЫБРАТЬ
			|				Контрагенты.Ссылка
			|			ИЗ
			|				Контрагенты)
			|	И ДокВыборки.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
			|	И ДокВыборки.Проведен
			|	И (&ПустойДоговор ИЛИ ДокВыборки.ДоговорКонтрагента = &ДоговорКонтрагента)
			|
			|СГРУППИРОВАТЬ ПО
			|	ДокВыборки.Ссылка,
			|	ДокВыборки.ШтампВерсии,
			|	ДокВыборки.Номер,
			|	ВЫРАЗИТЬ(ДокВыборки.Контрагент КАК Справочник.Контрагенты),
			|	ДокВыборки.ДоговорКонтрагента,
			|	НАЧАЛОПЕРИОДА(ДокВыборки.Дата, МЕСЯЦ)";
			
			Если Тип <> "day" Тогда
				
				ТексЗапросаПоДокументу = СтрЗаменить(ТексЗапросаПоДокументу, """КорректировкаРеализации"" КАК ТипДокумента,", "");
				//ТексЗапросаПоДокументу = СтрЗаменить(ТексЗапросаПоДокументу, "ДокВыборки.Ссылка КАК Ссылка,", "");
				//ТексЗапросаПоДокументу = СтрЗаменить(ТексЗапросаПоДокументу, "ДокВыборки.ШтампВерсии КАК ШтампВерсии,", "");
				ТексЗапросаПоДокументу = СтрЗаменить(ТексЗапросаПоДокументу, "ДокВыборки.Номер КАК Номер,", ""); 
				
			Иначе				
				ТексЗапросаПоДокументу = СтрЗаменить(ТексЗапросаПоДокументу, "НАЧАЛОПЕРИОДА(ДокВыборки.Дата, МЕСЯЦ)", "ДокВыборки.Дата");
			КонецЕсли;
			
		ИначеЕсли ИмяДокумента = "ОплатаОтПокупателяПлатежнойКартой" Тогда
			
			ТексЗапросаПоДокументу = ТексЗапросаПоДокументу +
			"ВЫБРАТЬ
			|	ДокВыборки.Ссылка КАК Ссылка,
			|   """ + ВыборкаВидов.ИмяДокумента + """ КАК ТипДокумента,
			|	ДокВыборки.Ссылка.ШтампВерсии КАК ШтампВерсии,
			|	ДокВыборки.Ссылка.Номер КАК Номер,
			|	ВЫБОР
			|		 КОГДА ДокВыборки.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийОплатаОтПокупателяПлатежнойКартой.ОплатаПокупателя)
			|			ТОГДА 1
			|		ИНАЧЕ -1
			|		КОНЕЦ * ДокВыборки.Ссылка.СуммаДокумента КАК СуммаДокумента,
			|	0 КАК СуммаДокументаПриход,
			|	ВЫРАЗИТЬ(ДокВыборки.Ссылка.Контрагент КАК Справочник.Контрагенты) КАК Контрагент,
			|	ДокВыборки.ДоговорКонтрагента КАК ДоговорКонтрагента,
			|	НАЧАЛОПЕРИОДА(ДокВыборки.Ссылка.Дата, МЕСЯЦ) КАК Период" +
			?(ЭтоПервыйЗапрос, Символы.ПС + "ПОМЕСТИТЬ Суммы", "") + "
			|ИЗ
			|	Документ." + ВыборкаВидов.ИмяДокумента + ".РасшифровкаПлатежа КАК ДокВыборки
			|ГДЕ
			|	ВЫРАЗИТЬ(ДокВыборки.Ссылка.Контрагент КАК Справочник.Контрагенты) В
			|			(ВЫБРАТЬ
			|				Контрагенты.Ссылка
			|			ИЗ
			|				Контрагенты)
			|	И ДокВыборки.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
			|	И ДокВыборки.Ссылка.Проведен
			|	И (&ПустойДоговор ИЛИ ДокВыборки.ДоговорКонтрагента = &ДоговорКонтрагента) 
			|
			|СГРУППИРОВАТЬ ПО
			|	ДокВыборки.Ссылка,
			|	ДокВыборки.Ссылка.ШтампВерсии,
			|	ДокВыборки.Ссылка.Номер,
			|	ВЫРАЗИТЬ(ДокВыборки.Ссылка.Контрагент КАК Справочник.Контрагенты),
			|	ДокВыборки.ДоговорКонтрагента,
			|	ВЫБОР
			|		КОГДА ДокВыборки.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийОплатаОтПокупателяПлатежнойКартой.ОплатаПокупателя)
			|			ТОГДА 1
			|		ИНАЧЕ -1
			|	КОНЕЦ * ДокВыборки.Ссылка.СуммаДокумента,
			|	НАЧАЛОПЕРИОДА(ДокВыборки.Ссылка.Дата, МЕСЯЦ)";
			
			Если Тип <> "day" Тогда
				
				ТексЗапросаПоДокументу = СтрЗаменить(ТексЗапросаПоДокументу, """ОплатаОтПокупателяПлатежнойКартой"" КАК ТипДокумента,", "");
				ТексЗапросаПоДокументу = СтрЗаменить(ТексЗапросаПоДокументу, "ДокВыборки.Ссылка.Номер КАК Номер,", ""); 
				
			Иначе				
				ТексЗапросаПоДокументу = СтрЗаменить(ТексЗапросаПоДокументу, "НАЧАЛОПЕРИОДА(ДокВыборки.Ссылка.Дата, МЕСЯЦ)", "ДокВыборки.Ссылка.Дата");
			КонецЕсли;
			
		Иначе
			
			ТексЗапросаПоДокументу = ТексЗапросаПоДокументу +
			"ВЫБРАТЬ
			|	ДокВыборки.Ссылка КАК Ссылка,
			|   """ + ВыборкаВидов.ИмяДокумента + """ КАК ТипДокумента,
			|	ДокВыборки.ШтампВерсии КАК ШтампВерсии,
			|	ДокВыборки.Номер КАК Номер,
			|	" + ЗнакМинус + "СУММА(ДокВыборки.СуммаДокумента) КАК СуммаДокумента,
			|	0 КАК СуммаДокументаПриход,
			|	ВЫРАЗИТЬ(ДокВыборки.Контрагент КАК Справочник.Контрагенты) КАК Контрагент,
			|	ДокВыборки.ДоговорКонтрагента КАК ДоговорКонтрагента,
			|	НАЧАЛОПЕРИОДА(ДокВыборки.Дата, МЕСЯЦ) КАК Период" +
			?(ЭтоПервыйЗапрос, Символы.ПС + "ПОМЕСТИТЬ Суммы", "") + "
			|ИЗ
			|	Документ." + ВыборкаВидов.ИмяДокумента + " КАК ДокВыборки
			|ГДЕ
			|	ВЫРАЗИТЬ(ДокВыборки.Контрагент КАК Справочник.Контрагенты) В
			|			(ВЫБРАТЬ
			|				Контрагенты.Ссылка
			|			ИЗ
			|				Контрагенты)
			|	И ДокВыборки.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
			|	И ДокВыборки.Проведен
			|	И (&ПустойДоговор ИЛИ ДокВыборки.ДоговорКонтрагента = &ДоговорКонтрагента)" +
			?(ИмяДокумента = "РеализацияТоваровУслуг", Символы.ПС + "И НЕ ЕСТЬNULL(ДокВыборки.Грузополучатель.ОформлятьРеализацииКакВнутреннееПеремещение, Ложь)", "") + "
			|
			|СГРУППИРОВАТЬ ПО
			|	ДокВыборки.Ссылка,
			|	ДокВыборки.ШтампВерсии,
			|	ДокВыборки.Номер,
			|	ВЫРАЗИТЬ(ДокВыборки.Контрагент КАК Справочник.Контрагенты),
			|	ДокВыборки.ДоговорКонтрагента,
			|	НАЧАЛОПЕРИОДА(ДокВыборки.Дата, МЕСЯЦ)";
			
		КонецЕсли;
		
		Если Тип <> "day" Тогда
			
			ТексЗапросаПоДокументу = СтрЗаменить(ТексЗапросаПоДокументу, """" + ВыборкаВидов.ИмяДокумента + """" + " КАК ТипДокумента,", "");
			//ТексЗапросаПоДокументу = СтрЗаменить(ТексЗапросаПоДокументу, "ДокВыборки.Ссылка КАК Ссылка,", "");
			//ТексЗапросаПоДокументу = СтрЗаменить(ТексЗапросаПоДокументу, "ДокВыборки.ШтампВерсии КАК ШтампВерсии,", "");
			ТексЗапросаПоДокументу = СтрЗаменить(ТексЗапросаПоДокументу, "ДокВыборки.Номер КАК Номер,", "");
			
		Иначе
			ТексЗапросаПоДокументу = СтрЗаменить(ТексЗапросаПоДокументу, "НАЧАЛОПЕРИОДА(ДокВыборки.Дата, МЕСЯЦ)", "ДокВыборки.Дата");
		КонецЕсли;
		
		Если ЭтоПервыйЗапрос Тогда
			ЭтоПервыйЗапрос = Ложь;
		КонецЕсли;
		
	КонецЦикла; 
	
	Для каждого ТипДокумента Из ТипыДокументов Цикл
		
		Если ТипДокумента = "СборкаЗаказовПокупателя" ИЛИ ТипДокумента = "КорректировкаСборкиЗаказовПокупателя" Тогда
			
			ЗнакМинус = "-";
			
			ЕстьДокументКВыгрузке = Истина; 
			
			ТексЗапросаПоДокументу = ТексЗапросаПоДокументу + Символы.ПС + ?(НЕ ЭтоПервыйЗапрос, "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС, "");
			
			ТексЗапросаПоДокументу = ТексЗапросаПоДокументу +
			"ВЫБРАТЬ
			|	ВложенныйЗапрос.Ссылка,
			|	ВложенныйЗапрос.ТипДокумента,
			|	ВложенныйЗапрос.ШтампВерсии,
			|	ВложенныйЗапрос.Номер,
			|	ВложенныйЗапрос.Контрагент,
			|	ВложенныйЗапрос.ДоговорКонтрагента,
			|	НАЧАЛОПЕРИОДА(ВложенныйЗапрос.Период, МЕСЯЦ) КАК Период,
			|	СУММА(ВложенныйЗапрос.СуммаДокумента) КАК СуммаДокумента
			|ПОМЕСТИТЬ СуммыПервый
			|ИЗ
			|	(ВЫБРАТЬ
			|		Сборки.Ссылка КАК Ссылка,
			|		Сборки.ТипДокумента КАК ТипДокумента,
			|		МАКСИМУМ(Сборки.ШтампВерсии) КАК ШтампВерсии,
			|		Сборки.Номер КАК Номер,
			|		Сборки.Контрагент КАК Контрагент,
			|		Сборки.ДоговорКонтрагента КАК ДоговорКонтрагента,
			|		Сборки.Период КАК Период,
			|		СУММА(Заказы.Сумма / Заказы.Количество * Сборки.Количество) КАК СуммаДокумента,
			|		Сборки.Номенклатура КАК Номенклатура
			|	ИЗ
			|		(ВЫБРАТЬ
			|			ВЫРАЗИТЬ(ДокВыборки.Регистратор КАК Документ.СборкаЗаказовПокупателя).Ссылка КАК Ссылка,
			|			""СборкаЗаказовПокупателя"" КАК ТипДокумента,
			|			ВЫРАЗИТЬ(ДокВыборки.Регистратор КАК Документ.СборкаЗаказовПокупателя).ШтампВерсии КАК ШтампВерсии,
			|			ВЫРАЗИТЬ(ДокВыборки.Регистратор КАК Документ.СборкаЗаказовПокупателя).Номер КАК Номер,
			|			СУММА(ДокВыборки.СобраноОборот + ДокВыборки.КСборкеОборот) КАК Количество,
			|			ВЫРАЗИТЬ(ДокВыборки.Контрагент КАК Справочник.Контрагенты) КАК Контрагент,
			|			ДокВыборки.ЗаказПокупателя.ДоговорКонтрагента КАК ДоговорКонтрагента,
			|			ВЫРАЗИТЬ(ДокВыборки.Регистратор КАК Документ.СборкаЗаказовПокупателя).Дата КАК Период,
			|			ДокВыборки.Номенклатура КАК Номенклатура,
			|			ДокВыборки.ЗаказПокупателя КАК ЗаказПокупателя
			|		ИЗ
			|			РегистрНакопления.ТоварыВСборке.Обороты(
			|					&ДатаНачала,
			|					&ДатаОкончания,
			|					Регистратор,
			|					ВЫРАЗИТЬ(Контрагент КАК Справочник.Контрагенты) В
			|							(ВЫБРАТЬ
			|								Контрагенты.Ссылка
			|							ИЗ
			|								Контрагенты)
			|						И (&ПустойДоговор
			|							ИЛИ ЗаказПокупателя.ДоговорКонтрагента = &ДоговорКонтрагента)) КАК ДокВыборки
			|		ГДЕ
			|			ДокВыборки.Регистратор ССЫЛКА Документ.СборкаЗаказовПокупателя
			|		
			|		СГРУППИРОВАТЬ ПО
			|			ДокВыборки.ЗаказПокупателя.ДоговорКонтрагента,
			|			ВЫРАЗИТЬ(ДокВыборки.Регистратор КАК Документ.СборкаЗаказовПокупателя).Ссылка,
			|			ВЫРАЗИТЬ(ДокВыборки.Регистратор КАК Документ.СборкаЗаказовПокупателя).ШтампВерсии,
			|			ВЫРАЗИТЬ(ДокВыборки.Регистратор КАК Документ.СборкаЗаказовПокупателя).Номер,
			|			ВЫРАЗИТЬ(ДокВыборки.Контрагент КАК Справочник.Контрагенты),
			|			ВЫРАЗИТЬ(ДокВыборки.Регистратор КАК Документ.СборкаЗаказовПокупателя).Дата,
			|			ДокВыборки.Номенклатура,
			|			ДокВыборки.ЗаказПокупателя) КАК Сборки
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|				ДокВыборки.ЗаказПокупателя КАК ЗаказПокупателя,
			|				ЗаказПокупателяТовары.Номенклатура КАК Номенклатура,
			|				СУММА(ЗаказПокупателяТовары.Сумма) КАК Сумма,
			|				СУММА(ЗаказПокупателяТовары.Количество) КАК Количество
			|			ИЗ
			|				РегистрНакопления.ТоварыВСборке.Обороты(
			|						&ДатаНачала,
			|						&ДатаОкончания,
			|						Регистратор,
			|						ВЫРАЗИТЬ(Контрагент КАК Справочник.Контрагенты) В
			|								(ВЫБРАТЬ
			|									Контрагенты.Ссылка
			|								ИЗ
			|									Контрагенты)
			|							И (&ПустойДоговор
			|								ИЛИ ЗаказПокупателя.ДоговорКонтрагента = &ДоговорКонтрагента)) КАК ДокВыборки
			|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары
			|					ПО ДокВыборки.ЗаказПокупателя = ЗаказПокупателяТовары.Ссылка
			|						И ДокВыборки.Номенклатура = ЗаказПокупателяТовары.Номенклатура
			|			ГДЕ
			|				ДокВыборки.Регистратор ССЫЛКА Документ.СборкаЗаказовПокупателя
			|			
			|			СГРУППИРОВАТЬ ПО
			|				ДокВыборки.ЗаказПокупателя,
			|				ЗаказПокупателяТовары.Номенклатура) КАК Заказы
			|			ПО Сборки.ЗаказПокупателя = Заказы.ЗаказПокупателя
			|				И Сборки.Номенклатура = Заказы.Номенклатура
			|	
			|	СГРУППИРОВАТЬ ПО
			|		Сборки.Ссылка,
			|		Сборки.ТипДокумента,
			|		Сборки.Номер,
			|		Сборки.Контрагент,
			|		Сборки.ДоговорКонтрагента,
			|		Сборки.Период,
			|		Сборки.Номенклатура) КАК ВложенныйЗапрос
			|
			|СГРУППИРОВАТЬ ПО
			|	ВложенныйЗапрос.Ссылка,
			|	ВложенныйЗапрос.ТипДокумента,
			|	ВложенныйЗапрос.ШтампВерсии,
			|	ВложенныйЗапрос.Номер,
			|	ВложенныйЗапрос.Контрагент,
			|	ВложенныйЗапрос.ДоговорКонтрагента,
			|	НАЧАЛОПЕРИОДА(ВложенныйЗапрос.Период, МЕСЯЦ)";          
			
			ТексЗапросаПоДокументу = СтрЗаменить(ТексЗапросаПоДокументу, "КАК Документ.СборкаЗаказовПокупателя", "КАК Документ." + ТипДокумента);
			ТексЗапросаПоДокументу = СтрЗаменить(ТексЗапросаПоДокументу, """" + "СборкаЗаказовПокупателя" + """" + " КАК ТипДокумента,", """" + ТипДокумента + """" + " КАК ТипДокумента,");
			ТексЗапросаПоДокументу = СтрЗаменить(ТексЗапросаПоДокументу, "ССЫЛКА Документ.СборкаЗаказовПокупателя", "ССЫЛКА Документ." + ТипДокумента);  
			ТексЗапросаПоДокументу = СтрЗаменить(ТексЗапросаПоДокументу, "СУММА(ВложенныйЗапрос.СуммаДокумента)", ЗнакМинус + "СУММА(ВложенныйЗапрос.СуммаДокумента)");  
			
			Если ЭтоПервыйЗапрос Тогда
				ТексЗапросаПоДокументу = СтрЗаменить(ТексЗапросаПоДокументу, "ПОМЕСТИТЬ СуммыПервый", "ПОМЕСТИТЬ Суммы");	
			Иначе
				ТексЗапросаПоДокументу = СтрЗаменить(ТексЗапросаПоДокументу, "ПОМЕСТИТЬ СуммыПервый", "");	
			КонецЕсли;
			
			Если Тип <> "day" Тогда
				
				ТексЗапросаПоДокументу = СтрЗаменить(ТексЗапросаПоДокументу, "ВложенныйЗапрос.ТипДокумента,", "");
				ТексЗапросаПоДокументу = СтрЗаменить(ТексЗапросаПоДокументу, "ВложенныйЗапрос.Номер,", "");

			Иначе
				ТексЗапросаПоДокументу = СтрЗаменить(ТексЗапросаПоДокументу, "НАЧАЛОПЕРИОДА(ВложенныйЗапрос.Период, МЕСЯЦ)", "ВложенныйЗапрос.Период");
			КонецЕсли;
			
			Если ЭтоПервыйЗапрос Тогда
				ЭтоПервыйЗапрос = Ложь;
			КонецЕсли;

		КонецЕсли;
	
	КонецЦикла; 
	
	Если Не ЕстьДокументКВыгрузке Тогда
		
		СтруктураВозврата = Новый Структура;
		СтруктураВозврата.Вставить("message", "В справочнике ""Документы к выгрузке"" нет отмеченных типов документов для выгрузки, через SOAP"); 
		СтруктураВозврата.Вставить("code", "NOT_FOUND_DOCUMENTS");
		Результат = ДанныеВJSON(СтруктураВозврата);
		
		ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ЗаписьЖурналаРегистрации("Web-сервис Billing", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. ПолучитьСуммуДокументовПоПериоду " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
		
		Возврат Результат;			
		
	КонецЕсли; 	
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "$ТексЗапросаПоДокументу$", ТексЗапросаПоДокументу);
	
	Запрос.УстановитьПараметр("ПустаяДата", Дата(1, 1, 1));
	
	Запрос.УстановитьПараметр("ДатаНачала", ДатаН);
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаК));
	Запрос.УстановитьПараметр("Контрагент", Конт);
	Запрос.УстановитьПараметр("ПустойКонтрагент", Не ЗначениеЗаполнено(Конт));
	
	Запрос.УстановитьПараметр("ДоговорКонтрагента", Дог);
	Запрос.УстановитьПараметр("ПустойДоговор", Не ЗначениеЗаполнено(Дог));                     
	
	Если Тип <> "day" Тогда
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Суммы.Ссылка,", "");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Суммы.ТипДокумента,", "");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Суммы.ШтампВерсии,", "");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Суммы.Номер,", "");
		
		Если Тип = "year" Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "МЕСЯЦ", "ГОД");
		ИначеЕсли Тип = "month-of-year" Тогда
			//Ничего не делаем, так как подобная группировка уже зашита в запросе
		ИначеЕсли Тип = "day-of-month" Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "МЕСЯЦ", "ДЕНЬ");		
		КонецЕсли;  
		
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	МассивВозврата = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		
		Если Тип = "day" Тогда
			
			Документ = Выборка.Ссылка;
			
			СтруктураСтроки = Новый Структура;
			СтруктураСтроки.Вставить("GUID", Строка(Документ.УникальныйИдентификатор()));
			СтруктураСтроки.Вставить("ТипДокумента", AMQP_РаботаСДокументами.ПолучитьТипДокументаИзБиллингаДля1С(Выборка.ТипДокумента));
			СтруктураСтроки.Вставить("Версия", Выборка.ШтампВерсии);
			СтруктураСтроки.Вставить("Номер", Выборка.Номер);
			СтруктураСтроки.Вставить("Дата", Выборка.Период);
			СтруктураСтроки.Вставить("Контрагент", Выборка.КонтрагентПредставление);
			СтруктураСтроки.Вставить("КонтрагентКодМДМ", Выборка.КонтрагентКодМДМ);
			СтруктураСтроки.Вставить("ДоговорКонтрагентаКодМДМ", Выборка.ДоговорКонтрагентаКодМДМ);
			СтруктураСтроки.Вставить("Сумма", Выборка.Сумма);
			
		Иначе
			
			СтруктураСтроки = Новый Структура;
			СтруктураСтроки.Вставить("Период", Выборка.Период);
			СтруктураСтроки.Вставить("Контрагент", Выборка.КонтрагентПредставление);
			СтруктураСтроки.Вставить("КонтрагентКодМДМ", Выборка.КонтрагентКодМДМ);
			СтруктураСтроки.Вставить("ДоговорКонтрагентаКодМДМ", Выборка.ДоговорКонтрагентаКодМДМ);
			СтруктураСтроки.Вставить("Сумма", Выборка.Сумма);
			СтруктураСтроки.Вставить("СуммаШтамповВерсий", Выборка.СуммаШтамповВерсий);
			СтруктураСтроки.Вставить("СуммаЧетныхСуммДокументов", Выборка.СуммаЧетныхСуммДокументов);
			
		КонецЕсли;
		
		МассивВозврата.Добавить(СтруктураСтроки);                                                 
		
	КонецЦикла;
	
	Результат = ДанныеВJSON(МассивВозврата);
	
	ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис Billing", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. ПолучитьСуммуДокументовПоПериоду " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
	
	Возврат Результат;
	
КонецФункции

Функция ПовторноВыгрузитьДокумент(Тип, GUID, Получатель)
	
	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис Billing", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Запуск. ПовторноВыгрузитьДокумент");
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("Результат", Ложь);
	СтруктураВозврата.Вставить("Сообщение", "");
	
	Если Не Тип = "ОприходованиеТоваров" И Не Тип = "СписаниеТоваров" Тогда
		ТипДокумента = AMQP_РаботаСДокументами.ПолучитьТипДокументаИзБиллингаДля1С(Тип); 
	Иначе
		ТипДокумента = Тип;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТипДокумента) Тогда
		
		СтруктураВозврата.Сообщение = "Не найден такой тип документа";

		РезультатВыполнения = ДанныеВJSON(СтруктураВозврата);
		
		ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ЗаписьЖурналаРегистрации("Web-сервис Billing", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. ПовторноВыгрузитьДокумент " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
			
		Возврат РезультатВыполнения;  
		
	КонецЕсли;  
	
	ДополнЗаголовки = Неопределено;

	Если ЗначениеЗаполнено(Получатель) Тогда
		
		ДополнЗаголовки = Новый СписокЗначений;
		ДополнЗаголовки.Добавить("app_Receiver_id", Получатель); 
		
	КонецЕсли; 
	
	Попытка
		
		СсылкаНаДокумент = Документы[ТипДокумента].ПолучитьСсылку(Новый УникальныйИдентификатор(GUID));
		ОбъектДокумента = СсылкаНаДокумент.ПолучитьОбъект();
		
		Если ОбъектДокумента = Неопределено Тогда
			СтруктураВозврата.Сообщение = "Не найден документ по такому GUID";	
		Иначе
						
			Попытка				
				
				ДокументВыгрузки = Справочники.AMQP_ДокументыВыгрузки.НайтиПоРеквизиту("ИмяДокумента", ТипДокумента);
				
				Если ДокументВыгрузки.ВерсияВыгрузки =  Перечисления.ВерсияВыгрузкиСообщенийДляРаббит.Ver1_Ver2 Тогда 
					AMQP_РаботаСДокументами.СоздатьИсходящееСообщение(ОбъектДокумента, Ложь,,, ДополнЗаголовки); 
					AMQP_РаботаСДокументами_ver2.СоздатьИсходящееСообщение(ОбъектДокумента, Ложь,,, ДополнЗаголовки);
				ИначеЕсли ДокументВыгрузки.ВерсияВыгрузки =  Перечисления.ВерсияВыгрузкиСообщенийДляРаббит.Ver_1 Тогда
					AMQP_РаботаСДокументами.СоздатьИсходящееСообщение(ОбъектДокумента, Ложь,,, ДополнЗаголовки);
				ИначеЕсли ТипДокумента = "СборкаЗаказовПокупателя" ИЛИ ТипДокумента = "КорректировкаСборкиЗаказовПокупателя" Тогда
					AMQP_РаботаСДокументами.СоздатьИсходящееСообщение(ОбъектДокумента, Ложь,,, ДополнЗаголовки); 
				Иначе 
					AMQP_РаботаСДокументами_ver2.СоздатьИсходящееСообщение(ОбъектДокумента, Ложь,,, ДополнЗаголовки);				
				КонецЕсли; 				

				СтруктураВозврата.Сообщение = "Документ успешно выгружен повторно";
				СтруктураВозврата.Результат = Истина; 
				
			Исключение	   
				
				СтруктураВозврата.Сообщение = ОписаниеОшибки();
				
			КонецПопытки;   
			
		КонецЕсли;
		
	Исключение
		
		СтруктураВозврата.Сообщение = ОписаниеОшибки();
		
	КонецПопытки;
	
	РезультатВыполнения = ДанныеВJSON(СтруктураВозврата);
	
	ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис Billing", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. ПовторноВыгрузитьДокумент " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
	
	Возврат РезультатВыполнения;
		
КонецФункции

Функция ПовторноВыгрузитьСборку(НомерЗаказаКлиента, ИдентификаторЗаказа, ИдентификаторКонтрагента)  
	
	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис Billing", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Запуск. ПовторноВыгрузитьСборку");
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("status", "");
	СтруктураВозврата.Вставить("message", "");

	ЗаказПокупателя = Документы.ЗаказПокупателя.ПолучитьСсылку(Новый УникальныйИдентификатор(ИдентификаторЗаказа));	
	Если ЗаказПокупателя.ПолучитьОбъект() = Неопределено Тогда
		
		СтруктураВозврата.Вставить("status", "еrror");
		СтруктураВозврата.Вставить("message", "Заказ клиента не обнаружен " + НомерЗаказаКлиента);
		РезультатВыполнения = ДанныеВJSON(СтруктураВозврата);
		
		ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ЗаписьЖурналаРегистрации("Web-сервис Billing", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. ПовторноВыгрузитьСборку " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
	
		Возврат РезультатВыполнения;
		
	КонецЕсли; 
	                                                    
	Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту("КодМДМ", ИдентификаторКонтрагента);
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТоварыВСборкеОбороты.Сборка
	|ПОМЕСТИТЬ ВТСборка
	|ИЗ
	|	РегистрНакопления.ТоварыВСборке КАК ТоварыВСборкеОбороты
	|ГДЕ
	|	ТоварыВСборкеОбороты.Регистратор ССЫЛКА Документ.СборкаЗаказовПокупателя
	|	И ТоварыВСборкеОбороты.ЗаказПокупателя = &ЗаказПокупателя
	|	И ТоварыВСборкеОбороты.Контрагент = &Контрагент
	|	И ТоварыВСборкеОбороты.Сборка.Договор.ВыгружаетсяВБиллинг = ИСТИНА
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыВСборкеОбороты.Сборка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыВСборкеОбороты.Регистратор КАК ДокументЗаписи,
	|	ВЫБОР
	|		КОГДА ТоварыВСборкеОбороты.Регистратор ССЫЛКА Документ.КорректировкаСборкиЗаказовПокупателя
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоКорректировка,
	|	ТоварыВСборкеОбороты.Сборка КАК Сборка,
	|	ТоварыВСборкеОбороты.Контрагент.КодМДМ КАК Контрагент,
	|	ТоварыВСборкеОбороты.Сборка.Договор.КодМДМ КАК Договор,
	|	ТоварыВСборкеОбороты.ЗаказПокупателя.Номер КАК Номер,
	|	ТоварыВСборкеОбороты.ЗаказПокупателя.Дата КАК Дата,
	|	ТоварыВСборкеОбороты.ЗаказПокупателя,
	|	СУММА(ТоварыВСборкеОбороты.СуммаСобрано) КАК Сумма
	|ИЗ
	|	РегистрНакопления.ТоварыВСборке КАК ТоварыВСборкеОбороты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСборка КАК ВТСборка
	|		ПО ТоварыВСборкеОбороты.Сборка = ВТСборка.Сборка
	|ГДЕ
	|	(ТоварыВСборкеОбороты.Регистратор ССЫЛКА Документ.СборкаЗаказовПокупателя
	|			ИЛИ ТоварыВСборкеОбороты.Регистратор ССЫЛКА Документ.КорректировкаСборкиЗаказовПокупателя)
	|	И ТоварыВСборкеОбороты.Контрагент = &Контрагент
	|	И ТоварыВСборкеОбороты.Сборка.Договор.ВыгружаетсяВБиллинг = ИСТИНА
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыВСборкеОбороты.Сборка,
	|	ТоварыВСборкеОбороты.Контрагент,
	|	ТоварыВСборкеОбороты.ЗаказПокупателя,
	|	ТоварыВСборкеОбороты.Контрагент.КодМДМ,
	|	ТоварыВСборкеОбороты.Сборка.Договор.КодМДМ,
	|	ТоварыВСборкеОбороты.ЗаказПокупателя.Номер,
	|	ТоварыВСборкеОбороты.ЗаказПокупателя.Дата,
	|	ТоварыВСборкеОбороты.Регистратор
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	ЭтоКорректировка
	|ИТОГИ ПО
	|	Сборка";
	
	Запрос.УстановитьПараметр("ЗаказПокупателя", ЗаказПокупателя);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
			
	РезультатЗапроса = Запрос.Выполнить();
	Попытка
		
		Если РезультатЗапроса.Пустой() Тогда
			
			СтруктураВозврата.status = "error";					
			СтруктураВозврата.message = "Не найдены документы для заказа " + НомерЗаказаКлиента;
			
			РезультатВыполнения = ДанныеВJSON(СтруктураВозврата);
			
			ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
			ЗаписьЖурналаРегистрации("Web-сервис Billing", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. ПовторноВыгрузитьСборку " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
	
			Возврат РезультатВыполнения;
			
		Иначе
			
			ВыборкаСборка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Сборка");								       
			
			Пока ВыборкаСборка.Следующий() Цикл
				
				AMQP_РаботаСДокументами.ПроверкаДокументаВБиллинге(ВыборкаСборка.Сборка, Истина);
				AMQP_РаботаСДокументами.ПодтверждениеДокументаВБиллинге(ВыборкаСборка.Сборка);
				
				Выборка = ВыборкаСборка.Выбрать();
				
				Пока Выборка.Следующий() Цикл										
					
					Если Выборка.ЭтоКорректировка  Тогда
						AMQP_РаботаСДокументами.ОтправитьДокументКорректировкиВБиллинг(Выборка.ДокументЗаписи);	
					КонецЕсли; 										
					
				КонецЦикла; 
				
			КонецЦикла;
			
		КонецЕсли;
		
		СтруктураВозврата.status = "ок";
	    СтруктураВозврата.message = "";
		
	Исключение
		
		СтруктураВозврата.status = "еrror";
	    СтруктураВозврата.message = ОписаниеОшибки();
		
	КонецПопытки; 
	
	РезультатВыполнения = ДанныеВJSON(СтруктураВозврата);
	
	ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис Billing", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. ПовторноВыгрузитьСборку " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
	
	Возврат РезультатВыполнения;
	
КонецФункции

Функция ПолучитьДокументыПоЗаказуКлиента(УникальныйИдентификаторЗаказа)
	
	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис Billing", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Запуск. ПолучитьДокументыПоЗаказуКлиента");
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("status", "");
	СтруктураВозврата.Вставить("message", "");
	СтруктураВозврата.Вставить("data", "");
	
	ЗаказПокупателя = Документы.ЗаказПокупателя.ПолучитьСсылку(Новый УникальныйИдентификатор(УникальныйИдентификаторЗаказа));
	
	Если ЗаказПокупателя.ПолучитьОбъект() = Неопределено Тогда
		
		СтруктураВозврата.Вставить("status", "еrror");
		СтруктураВозврата.Вставить("message", "Заказ клиента не обнаружен. ГУИД " + УникальныйИдентификаторЗаказа);
		РезультатВыполнения = ДанныеВJSON(СтруктураВозврата);
		
		ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ЗаписьЖурналаРегистрации("Web-сервис Billing", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. ПолучитьДокументыПоЗаказуКлиента " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
			
		Возврат РезультатВыполнения;
		
	КонецЕсли; 
	
	Контрагент = ЗаказПокупателя.Контрагент;
	КонтрагентОбъект = Контрагент.ПолучитьОбъект();	

	
	// Получить документы реализации, корректировок реализаций
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДокВыборки.Ссылка,
	               |	""РеализацияТоваровУслуг"" КАК ТипДокумента,
	               |	ДокВыборки.ШтампВерсии КАК ШтампВерсии,
	               |	ДокВыборки.Номер,
	               |	-СУММА(ДокВыборки.СуммаДокумента) КАК СуммаДокумента,
	               |	ВЫРАЗИТЬ(ДокВыборки.Контрагент КАК Справочник.Контрагенты) КАК Контрагент,
	               |	ДокВыборки.ДоговорКонтрагента КАК ДоговорКонтрагента,
	               |	ДокВыборки.Дата КАК Дата
	               |ПОМЕСТИТЬ ВТРеализТовУсл
	               |ИЗ
	               |	Документ.РеализацияТоваровУслуг.Товары КАК ДокВыборкиТовары
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК ДокВыборки
	               |		ПО ДокВыборкиТовары.Ссылка = ДокВыборки.Ссылка
	               |ГДЕ
	               |	ДокВыборкиТовары.ЗаказПокупателя = &ЗаказПокупателя
	               |	И ДокВыборки.ДоговорКонтрагента.ВыгружаетсяВБиллинг = ИСТИНА
	               |	И ДокВыборки.Проведен
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ДокВыборки.Ссылка,
	               |	ДокВыборки.ШтампВерсии,
	               |	ДокВыборки.Номер,
	               |	ВЫРАЗИТЬ(ДокВыборки.Контрагент КАК Справочник.Контрагенты),
	               |	ДокВыборки.ДоговорКонтрагента,
	               |	ДокВыборки.Дата
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДокВыборки.Ссылка,
	               |	""КорректировкаРеализации"" КАК ТипДокумента,
	               |	ДокВыборки.ШтампВерсии КАК ШтампВерсии,
	               |	ДокВыборки.Номер,
	               |	-СУММА(ПродажиОбороты.СтоимостьОборот) КАК СуммаДокумента,
	               |	ВЫРАЗИТЬ(ДокВыборки.Контрагент КАК Справочник.Контрагенты) КАК Контрагент,
	               |	ДокВыборки.ДоговорКонтрагента,
	               |	ДокВыборки.Дата КАК Дата
	               |ПОМЕСТИТЬ ВТКорректРеализации
	               |ИЗ
	               |	Документ.КорректировкаРеализации КАК ДокВыборки
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.Продажи.Обороты(
	               |				,
	               |				,
	               |				Регистратор,
	               |				ДокументПродажи В
	               |						(ВЫБРАТЬ
	               |							ВТРеализТовУсл.Ссылка
	               |						ИЗ
	               |							ВТРеализТовУсл КАК ВТРеализТовУсл)
	               |					И ДокументПродажи ССЫЛКА Документ.РеализацияТоваровУслуг
	               |					И ЗаказПокупателя = &ЗаказПокупателя) КАК ПродажиОбороты
	               |		ПО ДокВыборки.Ссылка = ПродажиОбороты.Регистратор
	               |ГДЕ
	               |	ДокВыборки.ДоговорКонтрагента.ВыгружаетсяВБиллинг = ИСТИНА
	               |	И ДокВыборки.Проведен
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ДокВыборки.Ссылка,
	               |	ДокВыборки.ШтампВерсии,
	               |	ДокВыборки.Номер,
	               |	ВЫРАЗИТЬ(ДокВыборки.Контрагент КАК Справочник.Контрагенты),
	               |	ДокВыборки.ДоговорКонтрагента,
	               |	ДокВыборки.Дата
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТРеализТовУсл.Ссылка,
	               |	ВТРеализТовУсл.ТипДокумента,
	               |	ВТРеализТовУсл.ШтампВерсии,
	               |	ВТРеализТовУсл.Номер,
	               |	ВТРеализТовУсл.СуммаДокумента,
	               |	ВТРеализТовУсл.Контрагент,
	               |	ВТРеализТовУсл.ДоговорКонтрагента,
	               |	ВТРеализТовУсл.Дата
	               |ПОМЕСТИТЬ СуммаДокумента
	               |ИЗ
	               |	ВТРеализТовУсл КАК ВТРеализТовУсл
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВТКорректРеализации.Ссылка,
	               |	ВТКорректРеализации.ТипДокумента,
	               |	ВТКорректРеализации.ШтампВерсии,
	               |	ВТКорректРеализации.Номер,
	               |	ВТКорректРеализации.СуммаДокумента,
	               |	ВТКорректРеализации.Контрагент,
	               |	ВТКорректРеализации.ДоговорКонтрагента,
	               |	ВТКорректРеализации.Дата
	               |ИЗ
	               |	ВТКорректРеализации КАК ВТКорректРеализации
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Суммы.Ссылка,
	               |	Суммы.ТипДокумента,
	               |	Суммы.ШтампВерсии,
	               |	Суммы.Номер,
	               |	Суммы.Контрагент,
	               |	ПРЕДСТАВЛЕНИЕ(Суммы.Контрагент) КАК КонтрагентПредставление,
	               |	Суммы.Дата КАК Дата,
	               |	СУММА(Суммы.СуммаДокумента) КАК Сумма,
	               |	Суммы.Контрагент.КодМДМ,
	               |	Суммы.ДоговорКонтрагента.КодМДМ
	               |ИЗ
	               |	СуммаДокумента КАК Суммы
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Суммы.Ссылка,
	               |	Суммы.ТипДокумента,
	               |	Суммы.ШтампВерсии,
	               |	Суммы.Номер,
	               |	Суммы.Контрагент,
	               |	Суммы.Дата,
	               |	Суммы.Контрагент.КодМДМ,
	               |	Суммы.ДоговорКонтрагента.КодМДМ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Дата";
	
	Запрос.УстановитьПараметр("ЗаказПокупателя", ЗаказПокупателя);
	РезультатЗапроса = Запрос.Выполнить().Выбрать();	
	
	
	МассивВозврата = Новый Массив;
	
	Пока РезультатЗапроса.Следующий() Цикл
		
		Документ = РезультатЗапроса.Ссылка;
		СтруктураСтроки = Новый Структура;
		СтруктураСтроки.Вставить("GUID", Строка(Документ.УникальныйИдентификатор()));
		СтруктураСтроки.Вставить("ТипДокумента", РезультатЗапроса.ТипДокумента);
		СтруктураСтроки.Вставить("Версия", РезультатЗапроса.ШтампВерсии);
		СтруктураСтроки.Вставить("Номер", РезультатЗапроса.Номер);
		СтруктураСтроки.Вставить("Дата", РезультатЗапроса.Дата);
		СтруктураСтроки.Вставить("Контрагент", РезультатЗапроса.КонтрагентПредставление);
		СтруктураСтроки.Вставить("КонтрагентКодМДМ", РезультатЗапроса.КонтрагентКодМДМ);
		СтруктураСтроки.Вставить("ДоговорКонтрагентаКодМДМ", РезультатЗапроса.ДоговорКонтрагентаКодМДМ);
		СтруктураСтроки.Вставить("Сумма", РезультатЗапроса.Сумма);
		
		МассивВозврата.Добавить(СтруктураСтроки);
		
	КонецЦикла; 
	
	// Получить сборки заказов покупателей, корректировки сборок
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТоварыВСборкеОбороты.Сборка
	|ПОМЕСТИТЬ ВТСборка
	|ИЗ
	|	РегистрНакопления.ТоварыВСборке КАК ТоварыВСборкеОбороты
	|ГДЕ
	|	ТоварыВСборкеОбороты.Регистратор ССЫЛКА Документ.СборкаЗаказовПокупателя
	|	И ТоварыВСборкеОбороты.ЗаказПокупателя = &ЗаказПокупателя
	|	И ТоварыВСборкеОбороты.Контрагент = &Контрагент
	|	И ТоварыВСборкеОбороты.Сборка.Договор.ВыгружаетсяВБиллинг = ИСТИНА
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыВСборкеОбороты.Сборка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыВСборкеОбороты.Регистратор КАК ДокументЗаписи,
	|	ВЫБОР
	|		КОГДА ТоварыВСборкеОбороты.Регистратор ССЫЛКА Документ.КорректировкаСборкиЗаказовПокупателя
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоКорректировка,
	|	ТоварыВСборкеОбороты.Сборка КАК Сборка,
	|	ТоварыВСборкеОбороты.Контрагент.КодМДМ КАК Контрагент,
	|	ТоварыВСборкеОбороты.Сборка.Договор.КодМДМ КАК Договор,
	|	ТоварыВСборкеОбороты.ЗаказПокупателя.Номер КАК Номер,
	|	ТоварыВСборкеОбороты.ЗаказПокупателя.Дата КАК Дата,
	|	ТоварыВСборкеОбороты.ЗаказПокупателя,
	|	СУММА(ТоварыВСборкеОбороты.СуммаСобрано) КАК Сумма
	|ИЗ
	|	РегистрНакопления.ТоварыВСборке КАК ТоварыВСборкеОбороты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСборка КАК ВТСборка
	|		ПО ТоварыВСборкеОбороты.Сборка = ВТСборка.Сборка
	|ГДЕ
	|	(ТоварыВСборкеОбороты.Регистратор ССЫЛКА Документ.СборкаЗаказовПокупателя
	|			ИЛИ ТоварыВСборкеОбороты.Регистратор ССЫЛКА Документ.КорректировкаСборкиЗаказовПокупателя)
	|	И ТоварыВСборкеОбороты.Контрагент = &Контрагент
	|	И ТоварыВСборкеОбороты.Сборка.Договор.ВыгружаетсяВБиллинг = ИСТИНА
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыВСборкеОбороты.Сборка,
	|	ТоварыВСборкеОбороты.Контрагент,
	|	ТоварыВСборкеОбороты.ЗаказПокупателя,
	|	ТоварыВСборкеОбороты.Контрагент.КодМДМ,
	|	ТоварыВСборкеОбороты.Сборка.Договор.КодМДМ,
	|	ТоварыВСборкеОбороты.ЗаказПокупателя.Номер,
	|	ТоварыВСборкеОбороты.ЗаказПокупателя.Дата,
	|	ТоварыВСборкеОбороты.Регистратор
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	ЭтоКорректировка
	|ИТОГИ ПО
	|	Сборка";
	
	Запрос.УстановитьПараметр("ЗаказПокупателя", ЗаказПокупателя);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
			
	РезультатЗапроса = Запрос.Выполнить();
	
	Попытка
		
		Если Не РезультатЗапроса.Пустой() Тогда
					
			ВыборкаСборка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Сборка");								       
			
			Пока ВыборкаСборка.Следующий() Цикл
				
				ДокументОбъект = ВыборкаСборка.Сборка.ПолучитьОбъект(); 
				СтруктураСборки = Новый Структура;
				СтруктураСборки.Вставить("agreement_mdm_id", Строка(ДокументОбъект.Договор.КодМДМ));
				СтруктураСборки.Вставить("app_id", Строка(Константы.База.Получить()));
				СтруктураСборки.Вставить("request_id", Строка(ДокументОбъект.Ссылка.УникальныйИдентификатор()));	
				СтруктураСборки.Вставить("request_id_name", ДокументОбъект.Номер);
				СтруктураСборки.Вставить("request_id_date", Формат(ДокументОбъект.Дата, "ДФ=""гггг-ММ-дд'T'ЧЧ:мм:сс"""));

									
				ТЗСтрокиЗаказов =  AMQP_РаботаСДокументами.СформироватьСтрокуЗаказов(ДокументОбъект, Истина);
				МассивТранзакций = Новый Массив;

				Для каждого Стр Из ТЗСтрокиЗаказов Цикл
					
					СтруктураДанных = Новый Структура;
					СтруктураДанных.Вставить("order_id", Строка(Стр.Ссылка.УникальныйИдентификатор()));
					СтруктураДанных.Вставить("amount", AMQP_РаботаСДокументами.ПреобразоватьЧисло(Стр.Сумма));
					СтруктураДанных.Вставить("order_id_name", Стр.Ссылка.Номер);
					СтруктураДанных.Вставить("order_id_date", Формат(Стр.Ссылка.Дата, "ДФ=""гггг-ММ-дд'T'ЧЧ:мм:сс"""));
					МассивТранзакций.Добавить(СтруктураДанных);
					
				КонецЦикла; 	
					
				СтруктураСборки.Вставить("orders", МассивТранзакций);
				
			    /////////////////////////////////////////////////////				
				
				СтруктураСтроки = Новый Структура;
				СтруктураСтроки.Вставить("GUID", Строка(ВыборкаСборка.Сборка.УникальныйИдентификатор()));
				СтруктураСтроки.Вставить("ТипДокумента", "СборкаЗаказовПокупателя");
				СтруктураСтроки.Вставить("Данные", СтруктураСборки);
				
				МассивВозврата.Добавить(СтруктураСтроки);								
				//////////////////////////////////////////////////////
				
				Выборка = ВыборкаСборка.Выбрать();
				
				Пока Выборка.Следующий() Цикл										
					
					Если Выборка.ЭтоКорректировка  Тогда
						
						// Документ Корректировка сборки заказов покупателя
						ДокументОбъект = Выборка.ДокументЗаписи.ПолучитьОбъект(); 
						СтруктураКорректировки = Новый Структура;
						
						СтруктураКорректировки.Вставить("request_id", Строка(Выборка.ДокументЗаписи.УникальныйИдентификатор()));
						СтруктураКорректировки.Вставить("app_id", Строка(Константы.База.Получить()));
						СтруктураКорректировки.Вставить("correction_request_id", Строка(ДокументОбъект.Ссылка.УникальныйИдентификатор()));
						
						ТЗ = AMQP_РаботаСДокументами.СформироватьСтрокуКорректировкиЗаказов(ДокументОбъект, Истина);
						
						МассивТранзакций = Новый Массив;
						
						Для каждого Стр Из ТЗ Цикл
							
							СтруктураДанных = Новый Структура;
							СтруктураДанных.Вставить("source_order_id", Строка(Стр.Ссылка.УникальныйИдентификатор()));
							СтруктураДанных.Вставить("amount", AMQP_РаботаСДокументами.ПреобразоватьЧисло(Стр.Сумма));
							МассивТранзакций.Добавить(СтруктураДанных);
							
						КонецЦикла; 	
							
						СтруктураКорректировки.Вставить("transactions", МассивТранзакций);
						
						СтруктураСтроки = Новый Структура;
						СтруктураСтроки.Вставить("GUID", Строка(ДокументОбъект.УникальныйИдентификатор()));
						СтруктураСтроки.Вставить("ТипДокумента", "КорректировкаСборкиЗаказовПокупателя");
						СтруктураСтроки.Вставить("Данные", СтруктураКорректировки);
						
						МассивВозврата.Добавить(СтруктураСтроки);								

					КонецЕсли; 										
					
				КонецЦикла; 
				
			КонецЦикла;
			
		КонецЕсли;
		
		СтруктураВозврата.status = "ок";
	    СтруктураВозврата.message = "";
		СтруктураВозврата.data = МассивВозврата;
		
	Исключение
		
		СтруктураВозврата.status = "еrror";
	    СтруктураВозврата.message = ОписаниеОшибки();
		
	КонецПопытки; 
	
	РезультатВыполнения = ДанныеВJSON(СтруктураВозврата);
	
	ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис Billing", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. ПолучитьДокументыПоЗаказуКлиента " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
	
	Возврат РезультатВыполнения;

КонецФункции

Функция ПолучитьДатуНачалаВыгрузкиДокументов()
	
	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис Billing", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Запуск. ПолучитьДатуНачалаВыгрузкиДокументов");
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("status", "");
	СтруктураВозврата.Вставить("message", "");
	СтруктураВозврата.Вставить("data", "");

	Попытка 
		
		СтруктураСтроки = Новый Структура;
		СтруктураСтроки.Вставить("ДатаНачалаВыгрузки", Константы.AMQP_ДатаНачалаВыгрузки.Получить());
				
		СтруктураВозврата.status = "ок";
	    СтруктураВозврата.data = СтруктураСтроки;
			
	Исключение
		СтруктураВозврата.status = "еrror";
	    СтруктураВозврата.message = ОписаниеОшибки();
	КонецПопытки; 
	
	РезультатВыполнения = ДанныеВJSON(СтруктураВозврата);
	
	ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис Billing", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. ПолучитьДатуНачалаВыгрузкиДокументов " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
			
	Возврат РезультатВыполнения;
	
КонецФункции

Функция ПолучитьНачальныйБаланс(КодДоговораМДМ, ДатаБаланса)
	
	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис Billing", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Запуск. ПолучитьБалансНаДату");
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("status", Ложь);
	СтруктураВозврата.Вставить("message", "");
	СтруктураВозврата.Вставить("data", 0);
	
	Если Не ЗначениеЗаполнено(КодДоговораМДМ) Тогда
		
		СтруктураВозврата.message = "Не заполнен код мдм договора";
		РезультатВыполнения = ДанныеВJSON(СтруктураВозврата);
		
		ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ЗаписьЖурналаРегистрации("Web-сервис Billing", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. ПолучитьБалансНаДату " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
	
		Возврат РезультатВыполнения;
		
	КонецЕсли;
	
	Договор = Неопределено;		
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДоговорыКонтрагентов.Ссылка
	               |ИЗ
	               |	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	               |ГДЕ
	               |	ДоговорыКонтрагентов.КодМДМ = &КодМДМ";
	
	Запрос.УстановитьПараметр("КодМДМ", КодДоговораМДМ);
	
	Выборка = Запрос.Выполнить().Выбрать();	
	
	Если Выборка.Количество() > 1 Тогда
		
		СтруктураВозврата.message = "Обнаружено несколько договоров с кодом МДМ: " + КодДоговораМДМ;
		РезультатВыполнения = ДанныеВJSON(СтруктураВозврата);
		ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ЗаписьЖурналаРегистрации("Web-сервис Billing", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. ПолучитьБалансНаДату " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
	
		Возврат РезультатВыполнения;

	КонецЕсли;
	
	Если Выборка.Следующий() Тогда
		Договор = Выборка.Ссылка;	
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Договор) Тогда
		
		СтруктураВозврата.message = "Договор " + КодДоговораМДМ + " не найден в базе Торговле";	
		РезультатВыполнения = ДанныеВJSON(СтруктураВозврата);
		ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ЗаписьЖурналаРегистрации("Web-сервис Billing", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. ПолучитьБалансНаДату " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
	
		Возврат РезультатВыполнения;

	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	-ВзаиморасчетыСКонтрагентамиОстатки.СуммаВзаиморасчетовОстаток КАК Сумма
	               |ИЗ
	               |	РегистрНакопления.ВзаиморасчетыСКонтрагентами.Остатки(&Дата, ДоговорКонтрагента = &Договор) КАК ВзаиморасчетыСКонтрагентамиОстатки";
	
	Запрос.УстановитьПараметр("Дата", ДатаБаланса);
	Запрос.УстановитьПараметр("Договор", Договор);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		СтруктураВозврата.data = Выборка.Сумма;	
	КонецЕсли;
	
	СтруктураВозврата.status = Истина;
	
	РезультатВыполнения = ДанныеВJSON(СтруктураВозврата);
	ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис Billing", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. ПолучитьБалансНаДату " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
	
	Возврат РезультатВыполнения;

КонецФункции

Функция ПроверитьНастройкуДокументаВыгрузки(Документ)
	
	СтруктураВозврата = Новый Структура("Результат, Сообщение", Истина, "");
	
	ДокументВыгрузки = Справочники.AMQP_ДокументыВыгрузки.НайтиПоРеквизиту("ИмяДокумента", Документ); 
	
	Если Не ЗначениеЗаполнено(ДокументВыгрузки) 
		ИЛИ Не ДокументВыгрузки.Выгружать Тогда
		
		СтруктураСообщения = Новый Структура;
		СтруктураСообщения.Вставить("Результат", Ложь);
		СтруктураСообщения.Вставить("Сообщение", "В базе не настроена или выключена выгрузка документа: " + Документ);
		
		СтруктураВозврата.Сообщение = ДанныеВJSON(СтруктураСообщения);
		СтруктураВозврата.Результат = Ложь;
	
		Возврат СтруктураВозврата;
		
	КонецЕсли;
	
	Возврат СтруктураВозврата;
		
КонецФункции

Функция ПолучитьМассивКроссовЗаПериод(ДатаН, ДатаО, ТипЭлемента)

	ЗапросКросс = Новый Запрос;
	ЗапросКросс.УстановитьПараметр("ДатаНачала", ДатаН);
	ЗапросКросс.УстановитьПараметр("ДатаОкончания", ?(Не ЗначениеЗаполнено(ДатаО), ТекущаяДата(), ДатаО));
	
	Если ТипЭлемента = "РеализацияТоваровУслуг" ИЛИ ТипЭлемента = "КорректировкаРеализации" Тогда
		
		ЗапросКросс.Текст = "ВЫБРАТЬ
		|	РеализацияТоваровУслугТовары.Ссылка
		|ИЗ
		|	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
