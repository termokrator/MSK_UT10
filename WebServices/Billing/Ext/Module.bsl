//+Бычков О. 28.08.2025 #UT10-5397
// Было
//Функция ДополнитьЗапросУсловиямиСверки(ТипЭлемента)
// Стало
Функция ДополнитьЗапросУсловиямиСверки(ТипЭлемента, Знач пТипЭлементаКорреспондента, пЗапрос)
//-Бычков О. 28.08.2025 #UT10-5397
	
	ТекстЗапроса = "";
	
	Если ТипЭлемента = "РеализацияТоваровУслуг" ИЛИ ТипЭлемента = "КорректировкаРеализации" Тогда		
		ТекстЗапроса = ТекстЗапроса + " НЕ ЕСТЬNULL(ВТ_Элементы.Ссылка.Грузополучатель.ОформлятьРеализацииКакВнутреннееПеремещение, Ложь) И НЕ ВТ_Элементы.Ссылка В (&МассивДокументовКросс)";		
	ИначеЕсли ТипЭлемента = "СчетФактураВыданный" Тогда
		ТекстЗапроса = ТекстЗапроса + " НЕ ЕСТЬNULL(ВТ_Элементы.Ссылка.ДокументОснование.Грузополучатель.ОформлятьРеализацииКакВнутреннееПеремещение, Ложь) И НЕ ВТ_Элементы.Ссылка В (&МассивДокументовКросс)";
	ИначеЕсли ТипЭлемента = "ПоступлениеТоваровУслуг" Тогда
		ТекстЗапроса = ТекстЗапроса + " НЕ ВТ_Элементы.Ссылка.Контрагент.ИНН = &ИНН";
	ИначеЕсли ТипЭлемента = "ПеремещениеТоваровМеждуСкладами" Тогда 
		ТекстЗапроса = ТекстЗапроса + " 
		|		ВЫБОР
		|			КОГДА ВТ_Элементы.Ссылка ССЫЛКА Документ.РеализацияТоваровУслуг
		|				ТОГДА ЕСТЬNULL(ВТ_Элементы.Ссылка.Грузополучатель.ОформлятьРеализацииКакВнутреннееПеремещение, ЛОЖЬ)
		|			КОГДА ВТ_Элементы.Ссылка ССЫЛКА Документ.ПоступлениеТоваровУслуг
		|					И (НЕ ВТ_Элементы.Ссылка.ТранзитнаяПоставка ИЛИ ВТ_Элементы.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПТУ.Закрыт))
		|				ТОГДА ВТ_Элементы.Ссылка.Контрагент.ИНН = &ИНН
		//+Бычков О. 28.07.2026 #UT10-5977
		// Вставка
		|			КОГДА ВТ_Элементы.Ссылка ССЫЛКА Документ.ПоступлениеТоваровНаОтветственноеХранение
		|				ТОГДА Истина
		//-Бычков О. 28.07.2026 #UT10-5977
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ"; 
	ИначеЕсли ТипЭлемента = "КорректировкаДолга" Тогда
		ТекстЗапроса = ТекстЗапроса + " НЕ ВТ_Элементы.Ссылка.НеОтправлятьДокументВУчетныеСистемы";   
	ИначеЕсли ТипЭлемента = "ВозвратТоваровПоставщику" Тогда
		ТекстЗапроса = ТекстЗапроса + " ВТ_Элементы.Ссылка.Контрагент = &ОсновнойПоставщик";
	ИначеЕсли ТипЭлемента = "АктВыполненныхРабот" Тогда
		ТекстЗапроса = ТекстЗапроса + " ВТ_Элементы.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусАктаВыполненныхРабот.КОплате)"; 
	//+Бычков О. 28.08.2025 #UT10-5397
	// Вставка
	ИначеЕсли ТипЭлемента = "ВыкупСОтветственногоХранения" Тогда
	
		ТекДатаСменыОП_ГП = Константы.ДатаСменыОП_ГП.Получить();
		пЗапрос.УстановитьПараметр("ДатаСменыОП_ГП", ТекДатаСменыОП_ГП);
		пЗапрос.УстановитьПараметр("ДатаСменыОП_ГПЗаполнена", ЗначениеЗаполнено(ТекДатаСменыОП_ГП));
		пЗапрос.УстановитьПараметр("ПополнениеДляОбособленногоПодразделенияЮЛ", Константы.ПополнениеДляОбособленногоПодразделенияЮЛ.Получить());
		пЗапрос.УстановитьПараметр("ПустойФилиал", Метаданные.Документы.ВыкупСОтветственногоХранения.Реквизиты.Филиал.Тип.ПривестиЗначение(Неопределено));
		
		ТекстУсловияЭтоОП = "ВЫБОР
			|			КОГДА &ДатаСменыОП_ГПЗаполнена
			|				ТОГДА &ПополнениеДляОбособленногоПодразделенияЮЛ = ИСТИНА И ВТ_Элементы.Ссылка.Дата >= &ДатаСменыОП_ГП
			|					ИЛИ &ПополнениеДляОбособленногоПодразделенияЮЛ = ЛОЖЬ И ВТ_Элементы.Ссылка.Дата < &ДатаСменыОП_ГП
			|			ИНАЧЕ &ПополнениеДляОбособленногоПодразделенияЮЛ
			|		КОНЕЦ"; 
		
		ТекстУсловияВыгрузкиВПеремещение = "ВЫБОР
			|			КОГДА 
			|				" + ТекстУсловияЭтоОП + "
			|				ТОГДА Истина
			|			ИНАЧЕ НЕ ВТ_Элементы.Ссылка.Филиал = &ПустойФилиал И НЕ ВТ_Элементы.Ссылка.Статус = Значение(Перечисление.СтатусыТОХ.ВозвратПоБраку)
			|		КОНЕЦ"; 
		
		Если пТипЭлементаКорреспондента = "ПеремещениеТоваров" Тогда
			
			ТекстЗапроса = ТекстЗапроса + " 
				|		" + ТекстУсловияВыгрузкиВПеремещение; 
			
		Иначе
			
			ТекстЗапроса = ТекстЗапроса + " 
				|		НЕ (" + ТекстУсловияВыгрузкиВПеремещение + ")"; 
			
		КонецЕсли;
		
	ИначеЕсли ТипЭлемента = "КорректировкаПоступления" Тогда
		
		ТекстУсловияВыгрузкиВПеремещение = ПолучитьТекстУсловияВыгрузкиКорректировкиПоступленияТоваровИУслугВПеремещениеТоваров();
		
		Если пТипЭлементаКорреспондента = "ПеремещениеТоваров" Тогда
			
			ТекстЗапроса = ТекстЗапроса + " 
				|		" + ТекстУсловияВыгрузкиВПеремещение; 
			
		Иначе
			
			ТекстЗапроса = ТекстЗапроса + " 
				|		НЕ (" + ТекстУсловияВыгрузкиВПеремещение + ")"; 
			
		КонецЕсли;
	//+Бычков О. 31.07.2026 #UT10-5984
	// Вставка
	ИначеЕсли ТипЭлемента = "СчетФактураПолученный" Тогда
		
		ТекТекстУсловияВыгрузкиПТУВПеремещение = ПолучитьТекстУсловияВыгрузкиПоступленияТоваровИУслугВПеремещениеТоваров();
		
		ТекТекстУсловияВыгрузкиПТУВПеремещение = СтрЗаменить(ТекТекстУсловияВыгрузкиПТУВПеремещение, "ВТ_Элементы.Ссылка", "Выразить(ВТ_Элементы.Ссылка.ДокументОснование КАК Документ.ПоступлениеТоваровУслуг)");

		ТекТекстУсловияВыгрузкиКорПТУВПеремещение = ПолучитьТекстУсловияВыгрузкиКорректировкиПоступленияТоваровИУслугВПеремещениеТоваров();
		
		ТекТекстУсловияВыгрузкиКорПТУВПеремещение = СтрЗаменить(ТекТекстУсловияВыгрузкиКорПТУВПеремещение, "ВТ_Элементы.Ссылка", "Выразить(ВТ_Элементы.Ссылка.ДокументОснование КАК Документ.КорректировкаПоступления)");
		
		ТекстЗапроса = ТекстЗапроса + " 
			|		ВЫБОР
			|			КОГДА ВТ_Элементы.Ссылка.ДокументОснование ССЫЛКА Документ.ПоступлениеТоваровУслуг
			|				ТОГДА НЕ (" + ТекТекстУсловияВыгрузкиПТУВПеремещение + ")
			|			КОГДА ВТ_Элементы.Ссылка.ДокументОснование ССЫЛКА Документ.КорректировкаПоступления
			|				ТОГДА НЕ (" + ТекТекстУсловияВыгрузкиКорПТУВПеремещение + ")
			|			ИНАЧЕ ИСТИНА
			|		КОНЕЦ";
		
	//-Бычков О. 31.07.2026 #UT10-5984	
	//-Бычков О. 28.08.2025 #UT10-5397
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ТекстЗапроса) Тогда
		ТекстЗапроса = " ГДЕ " + ТекстЗапроса;		
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ДополнитьЗапросУсловиямиСверкиРегистров(ТипЭлемента)

	//Адаптация условий функции ДополнитьЗапросУсловиямиСверки под регистры
	
	ТекстЗапроса = "";
	
	Если ТипЭлемента = "ТоварыНаСкладах" Тогда
		
		ТекстЗапроса = "ВЫБОР
					   |	КОГДА ТИПЗНАЧЕНИЯ(ВТ_Элементы.Регистратор) = ТИП(Документ.РеализацияТоваровУслуг) ИЛИ ТИПЗНАЧЕНИЯ(ВТ_Элементы.Регистратор) = ТИП(Документ.КорректировкаРеализации)
					   |		ТОГДА НЕ ВТ_Элементы.Регистратор В (&МассивДокументовКросс)
					   |	ИНАЧЕ
					   |		ИСТИНА
					   |	КОНЕЦ";   
	
	КонецЕсли;

	Если ЗначениеЗаполнено(ТекстЗапроса) Тогда
		ТекстЗапроса = " ГДЕ " + ТекстЗапроса;		
	КонецЕсли;
	
	Возврат ТекстЗапроса;

КонецФункции

Функция ПолучитьЗапросСпискаЭлементов(ТипЭлемента)
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	РеализацияТоваровУслуг.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_Элементы
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &ВерсияНачало <> 0
	|				ТОГДА РеализацияТоваровУслуг.Ссылка.ШтампВерсии >= &ВерсияНачало
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ВерсияКонец <> 0
	|				ТОГДА РеализацияТоваровУслуг.Ссылка.ШтампВерсии <= &ВерсияКонец
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И РеализацияТоваровУслуг.Дата Между &ДатаНачала И &ДатаОкончания";	
	
	Если ТипЭлемента = "ПеремещениеТоваровМеждуСкладами" Тогда
		
		ТекстЗапроса = ТекстЗапроса + "
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПоступлениеТоваровУслуг.Ссылка
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &ВерсияНачало <> 0
		|				ТОГДА ПоступлениеТоваровУслуг.Ссылка.ШтампВерсии >= &ВерсияНачало
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|	И ВЫБОР
		|			КОГДА &ВерсияКонец <> 0
		|				ТОГДА ПоступлениеТоваровУслуг.Ссылка.ШтампВерсии <= &ВерсияКонец
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|	И ПоступлениеТоваровУслуг.Дата Между &ДатаНачала И &ДатаОкончания"; 
		
	//+Бычков О. 28.07.2026 #UT10-5977
	// Вставка
		ТекстЗапроса = ТекстЗапроса 
		+ "
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|" 
		+ "ВЫБРАТЬ
		  |	ПоступлениеТоваровНаОтветственноеХранение.Ссылка
		  |ИЗ
		  |	Документ.ПоступлениеТоваровНаОтветственноеХранение КАК ПоступлениеТоваровНаОтветственноеХранение,
		  |	Константы КАК Константы
		  |ГДЕ
		  |	ВЫБОР
		  |			КОГДА &ВерсияНачало <> 0
		  |				ТОГДА ПоступлениеТоваровНаОтветственноеХранение.Ссылка.ШтампВерсии >= &ВерсияНачало
		  |			ИНАЧЕ ИСТИНА
		  |		КОНЕЦ
		  |	И ВЫБОР
		  |			КОГДА &ВерсияКонец <> 0
		  |				ТОГДА ПоступлениеТоваровНаОтветственноеХранение.Ссылка.ШтампВерсии <= &ВерсияКонец
		  |			ИНАЧЕ ИСТИНА
		  |		КОНЕЦ
		  |	И ПоступлениеТоваровНаОтветственноеХранение.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		  |	И &ТекстУсловияЭтоБазаОбособленногоПодразделения"; 
		
		ТекТекстУсловия = ПолучитьТекстУсловияЭтоБазаОбособленногоПодразделения("ПоступлениеТоваровНаОтветственноеХранение");
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстУсловияЭтоБазаОбособленногоПодразделения", ТекТекстУсловия);
		
	Иначе
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "РеализацияТоваровУслуг", ТипЭлемента);
			
		Если ТипЭлемента = "ПоступлениеТоваровУслуг" Тогда
		
			ТекстЗапроса = ТекстЗапроса 
			+ "
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|" 
			+ "ВЫБРАТЬ
			  |	ПоступлениеТоваровНаОтветственноеХранение.Ссылка
			  |ИЗ
			  |	Документ.ПоступлениеТоваровНаОтветственноеХранение КАК ПоступлениеТоваровНаОтветственноеХранение,
			  |	Константы КАК Константы
			  |ГДЕ
			  |	ВЫБОР
			  |			КОГДА &ВерсияНачало <> 0
			  |				ТОГДА ПоступлениеТоваровНаОтветственноеХранение.Ссылка.ШтампВерсии >= &ВерсияНачало
			  |			ИНАЧЕ ИСТИНА
			  |		КОНЕЦ
			  |	И ВЫБОР
			  |			КОГДА &ВерсияКонец <> 0
			  |				ТОГДА ПоступлениеТоваровНаОтветственноеХранение.Ссылка.ШтампВерсии <= &ВерсияКонец
			  |			ИНАЧЕ ИСТИНА
			  |		КОНЕЦ
			  |	И ПоступлениеТоваровНаОтветственноеХранение.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
			  |	И НЕ &ТекстУсловияЭтоБазаОбособленногоПодразделения"; 
			
			ТекТекстУсловия = ПолучитьТекстУсловияЭтоБазаОбособленногоПодразделения("ПоступлениеТоваровНаОтветственноеХранение");
			
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстУсловияЭтоБазаОбособленногоПодразделения", ТекТекстУсловия);
			
		КонецЕсли;
	//-Бычков О. 28.07.2026 #UT10-5977
	
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + "
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;";       
	
	//+Бычков О. 28.07.2026 #UT10-5977
	// Было
	//Если ТипЭлемента = "ПеремещениеТоваровМеждуСкладами" Тогда
	//	//Для перемещений используется объединенный запрос с реализацями (с отборами) и поступлениями			
	//Иначе     
	//	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "РеализацияТоваровУслуг", ТипЭлемента);
	//КонецЕсли;
	// Стало
	// Перенёс это выше, поскольку там уже проверяются и обрабатываются нужные условия.
	//-Бычков О. 28.07.2026 #UT10-5977
	
	Возврат ТекстЗапроса;

КонецФункции

Функция ПолучитьЗапросСпискаЭлементовРегистра(ТипЭлемента, ИмяРесурса)

	ТекстЗапроса = "ВЫБРАТЬ
	               |	РегистрНакопления.Регистратор КАК Регистратор,
	               |	РегистрНакопления." + ИмяРесурса + "Оборот КАК Ресурс
	               |ПОМЕСТИТЬ ВТ_Элементы
	               |ИЗ
	               |	РегистрНакопления.ТоварыНаСкладах.Обороты(&ДатаНачала, &ДатаОкончания, Регистратор, 1 = 1) КАК РегистрНакопления
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Регистратор
				   |;";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТоварыНаСкладах", ТипЭлемента);
	
	Если ТипЭлемента = "ДенежныеСредства" Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "1 = 1", "ВидДенежныхСредств = &ВидДенежныхСредствНаличные");	
	КонецЕсли;

	Возврат ТекстЗапроса;

КонецФункции

Функция ПолучитьИмяПриложения()
	
	Возврат Константы.AMQP_ИдентификаторИнформацСистемы.Получить();

КонецФункции

Процедура НастроитьЗапросОстатковТоваровОрганизаций(Запрос, 
	Детально, МассивОрганизаций, МассивСкладов, МассивНоменклатуры, МассивВидаНоменклатуры, Знач ОтборВидНоменклатурыСтрокой)
//+Бычков О. 01.09.2025 #UT10-5403
// Вставка
	
	Если Детально Тогда
		
		ТекстЗапроса = "ВЫБРАТЬ
		               |	ТоварыОрганизацийМТОстаткиИОбороты.Регистратор КАК Регистратор,
		               |	ПРЕДСТАВЛЕНИЕ(ТоварыОрганизацийМТОстаткиИОбороты.Регистратор),
		               |	ТоварыОрганизацийМТОстаткиИОбороты.Организация.КодМДМ,
		               |	&КодМДМОсновногоСклада КАК СкладКодМДМ,
		               |	ТоварыОрганизацийМТОстаткиИОбороты.Номенклатура.КодМДМ КАК НоменклатураКодМДМ,
		               |	ТоварыОрганизацийМТОстаткиИОбороты.Номенклатура.Наименование КАК НоменклатураНаименование,
		               |	ТоварыОрганизацийМТОстаткиИОбороты.Номенклатура.Артикул КАК НоменклатураИнвентарныйНомер,
		               |	ТоварыОрганизацийМТОстаткиИОбороты.КоличествоНачальныйОстаток,
		               |	ТоварыОрганизацийМТОстаткиИОбороты.КоличествоПриход,
		               |	ТоварыОрганизацийМТОстаткиИОбороты.КоличествоРасход,
		               |	ТоварыОрганизацийМТОстаткиИОбороты.КоличествоКонечныйОстаток,
		               |	ЛОЖЬ КАК ТОХ
		               |ИЗ
		               |	РегистрНакопления.ТоварыОрганизацийМТ.ОстаткиИОбороты(&ДатаНачала, &Дата, Регистратор, , &ТекстДополнительныхУсловийПоТоварамОрганизацийМТ) КАК ТоварыОрганизацийМТОстаткиИОбороты
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ
		               |	ТоварыОХ.Регистратор,
		               |	ПРЕДСТАВЛЕНИЕ(ТоварыОХ.Регистратор),
		               |	ТоварыОХ.Организация.КодМДМ,
		               |	&КодМДМОсновногоСклада,
		               |	ТоварыОХ.Номенклатура.КодМДМ,
		               |	ТоварыОХ.Номенклатура.Наименование,
		               |	ТоварыОХ.Номенклатура.Артикул,
		               |	СУММА(ТоварыОХ.КоличествоНачальныйОстаток),
		               |	СУММА(ТоварыОХ.КоличествоПриход),
		               |	СУММА(ТоварыОХ.КоличествоРасход),
		               |	СУММА(ТоварыОХ.КоличествоКонечныйОстаток),
		               |	ИСТИНА
		               |ИЗ
		               |	(ВЫБРАТЬ
		               |		ТоварыТОХпоДаннымПоставщиковОстаткиИОбороты.Регистратор КАК Регистратор,
		               |		ТоварыТОХпоДаннымПоставщиковОстаткиИОбороты.Организация КАК Организация,
		               |		ТоварыТОХпоДаннымПоставщиковОстаткиИОбороты.Номенклатура КАК Номенклатура,
		               |		ТоварыТОХпоДаннымПоставщиковОстаткиИОбороты.КоличествоНачальныйОстаток КАК КоличествоНачальныйОстаток,
		               |		ТоварыТОХпоДаннымПоставщиковОстаткиИОбороты.КоличествоПриход КАК КоличествоПриход,
		               |		ТоварыТОХпоДаннымПоставщиковОстаткиИОбороты.КоличествоРасход КАК КоличествоРасход,
		               |		ТоварыТОХпоДаннымПоставщиковОстаткиИОбороты.КоличествоКонечныйОстаток КАК КоличествоКонечныйОстаток
		               |	ИЗ
		               |		РегистрНакопления.ТоварыТОХпоДаннымПоставщиков.ОстаткиИОбороты(&ДатаНачала, &Дата, Регистратор, , &ТекстДополнительныхУсловийПоТоварамТОХпоДаннымПоставщиков) КАК ТоварыТОХпоДаннымПоставщиковОстаткиИОбороты
		               |	
		               |	ОБЪЕДИНИТЬ ВСЕ
		               |	
		               |	ВЫБРАТЬ
		               |		ТоварыОтветственногоХраненияПереданныеОстаткиИОбороты.Регистратор,
		               |		ТоварыОтветственногоХраненияПереданныеОстаткиИОбороты.Организация,
		               |		ТоварыОтветственногоХраненияПереданныеОстаткиИОбороты.Номенклатура,
		               |		-ТоварыОтветственногоХраненияПереданныеОстаткиИОбороты.КоличествоНачальныйОстаток,
		               |		-ТоварыОтветственногоХраненияПереданныеОстаткиИОбороты.КоличествоПриход,
		               |		-ТоварыОтветственногоХраненияПереданныеОстаткиИОбороты.КоличествоРасход,
		               |		-ТоварыОтветственногоХраненияПереданныеОстаткиИОбороты.КоличествоКонечныйОстаток
		               |	ИЗ
		               |		РегистрНакопления.ТоварыОтветственногоХраненияПереданные.ОстаткиИОбороты(&ДатаНачала, &Дата, Регистратор, , &ТекстДополнительныхУсловийПоТоварамОтветственногоХраненияПереданным) КАК ТоварыОтветственногоХраненияПереданныеОстаткиИОбороты) КАК ТоварыОХ
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ТоварыОХ.Регистратор,
		               |	ТоварыОХ.Организация,
		               |	ТоварыОХ.Номенклатура,
		               |	ТоварыОХ.Организация.КодМДМ,
		               |	ТоварыОХ.Номенклатура.КодМДМ,
		               |	ТоварыОХ.Номенклатура.Наименование,
		               |	ТоварыОХ.Номенклатура.Артикул
		               |
		               |ИМЕЮЩИЕ
		               |	(НЕ СУММА(ТоварыОХ.КоличествоНачальныйОстаток) = 0
		               |		ИЛИ НЕ СУММА(ТоварыОХ.КоличествоПриход) = 0
		               |		ИЛИ НЕ СУММА(ТоварыОХ.КоличествоРасход) = 0
		               |		ИЛИ НЕ СУММА(ТоварыОХ.КоличествоКонечныйОстаток) = 0)"; 
		
	Иначе
		
		ТекстЗапроса = "ВЫБРАТЬ
		               |	ТоварыОрганизацийОстатки.Организация.КодМДМ,
		               |	&КодМДМОсновногоСклада КАК СкладКодМДМ,
		               |	ТоварыОрганизацийОстатки.Номенклатура.КодМДМ КАК НоменклатураКодМДМ,
		               |	ТоварыОрганизацийОстатки.Номенклатура.Наименование КАК НоменклатураНаименование,
		               |	ТоварыОрганизацийОстатки.Номенклатура.Артикул КАК НоменклатураИнвентарныйНомер,
		               |	ТоварыОрганизацийОстатки.КоличествоОстаток КАК Остаток,
		               |	ЛОЖЬ КАК ТОХ
		               |ИЗ
		               |	РегистрНакопления.ТоварыОрганизацийМТ.Остатки(&Дата, &ТекстДополнительныхУсловийПоТоварамОрганизацийМТ) КАК ТоварыОрганизацийОстатки
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ
		               |	ТоварыОХ.Организация.КодМДМ,
		               |	&КодМДМОсновногоСклада,
		               |	ТоварыОХ.Номенклатура.КодМДМ,
		               |	ТоварыОХ.Номенклатура.Наименование,
		               |	ТоварыОХ.Номенклатура.Артикул,
		               |	СУММА(ТоварыОХ.КоличествоОстаток),
		               |	ИСТИНА
		               |ИЗ
		               |	(ВЫБРАТЬ
		               |		ТоварыТОХпоДаннымПоставщиковОстатки.Организация КАК Организация,
		               |		ТоварыТОХпоДаннымПоставщиковОстатки.Номенклатура КАК Номенклатура,
		               |		ТоварыТОХпоДаннымПоставщиковОстатки.КоличествоОстаток КАК КоличествоОстаток
		               |	ИЗ
		               |		РегистрНакопления.ТоварыТОХпоДаннымПоставщиков.Остатки(&Дата, &ТекстДополнительныхУсловийПоТоварамТОХпоДаннымПоставщиков) КАК ТоварыТОХпоДаннымПоставщиковОстатки
		               |	
		               |	ОБЪЕДИНИТЬ ВСЕ
		               |	
		               |	ВЫБРАТЬ
		               |		ТоварыОтветственногоХраненияПереданныеОстатки.Организация,
		               |		ТоварыОтветственногоХраненияПереданныеОстатки.Номенклатура,
		               |		-ТоварыОтветственногоХраненияПереданныеОстатки.КоличествоОстаток
		               |	ИЗ
		               |		РегистрНакопления.ТоварыОтветственногоХраненияПереданные.Остатки(&Дата, &ТекстДополнительныхУсловийПоТоварамОтветственногоХраненияПереданным) КАК ТоварыОтветственногоХраненияПереданныеОстатки) КАК ТоварыОХ
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ТоварыОХ.Организация,
		               |	ТоварыОХ.Номенклатура,
		               |	ТоварыОХ.Организация.КодМДМ,
		               |	ТоварыОХ.Номенклатура.КодМДМ,
		               |	ТоварыОХ.Номенклатура.Наименование,
		               |	ТоварыОХ.Номенклатура.Артикул
		               |
		               |ИМЕЮЩИЕ
		               |	НЕ СУММА(ТоварыОХ.КоличествоОстаток) = 0"; 
		
	КонецЕсли;                  
	
	ТекОсновнойСклад = Константы.ОсновнойСклад.Получить();
	
	Запрос.УстановитьПараметр("КодМДМОсновногоСклада", ТекОсновнойСклад.КодМДМ);
	
	ТекТекстДополнительныхУсловийОтбораДанных = "";
	ТекРазделитель = "";
	
	Если ЗначениеЗаполнено(МассивОрганизаций) Тогда
		
		ДобавитьКТекстуДополнительноеУсловие(ТекТекстДополнительныхУсловийОтбораДанных, ТекРазделитель, "Организация В (&Организации)");
		Запрос.УстановитьПараметр("Организации", МассивОрганизаций);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(МассивНоменклатуры) Тогда
		
		ДобавитьКТекстуДополнительноеУсловие(ТекТекстДополнительныхУсловийОтбораДанных, ТекРазделитель, "Номенклатура В (&Номенклатура)");
		Запрос.УстановитьПараметр("Номенклатура", МассивНоменклатуры);
		
	КонецЕсли;

	Если МассивВидаНоменклатуры.Количество()>0 Тогда
		
		ДобавитьКТекстуДополнительноеУсловие(ТекТекстДополнительныхУсловийОтбораДанных, ТекРазделитель, "Номенклатура.ВидНоменклатуры В (&МассивВидаНоменклатуры)");
		
        Запрос.УстановитьПараметр("МассивВидаНоменклатуры",  МассивВидаНоменклатуры);
		
	ИначеЕсли ЗначениеЗаполнено(ОтборВидНоменклатурыСтрокой) Тогда
		
		ДобавитьКТекстуДополнительноеУсловие(ТекТекстДополнительныхУсловийОтбораДанных, ТекРазделитель, "Не Номенклатура.ВидНоменклатуры = &ВидНоменклатурыТовар");
		Запрос.УстановитьПараметр("ВидНоменклатурыТовар",  Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Товар", Истина)); 
   		
	КонецЕсли;

	Если ЗначениеЗаполнено(МассивСкладов) Тогда
		
		ДобавитьКТекстуДополнительноеУсловие(ТекТекстДополнительныхУсловийОтбораДанных, ТекРазделитель, "&ОсновнойСклад В (&Склады)");
		Запрос.УстановитьПараметр("Склады", МассивСкладов);
		Запрос.УстановитьПараметр("ОсновнойСклад", ТекОсновнойСклад);
		
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстДополнительныхУсловийПоТоварамТОХпоДаннымПоставщиков", ТекТекстДополнительныхУсловийОтбораДанных);	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстДополнительныхУсловийПоТоварамОтветственногоХраненияПереданным", ТекТекстДополнительныхУсловийОтбораДанных);
	
	Если ЗначениеЗаполнено(МассивСкладов) Тогда
		
		ДобавитьКТекстуДополнительноеУсловие(ТекТекстДополнительныхУсловийОтбораДанных, ТекРазделитель, "Склад В (&Склады)");
		
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстДополнительныхУсловийПоТоварамОрганизацийМТ", ТекТекстДополнительныхУсловийОтбораДанных);
	
	Запрос.Текст = ТекстЗапроса;
	
//-Бычков О. 01.09.2025 #UT10-5403	
КонецПроцедуры

Функция ПолучитьДанныеОстатковТоваровОрганизаций(ДатаНачала, ДатаОкончания, ОтборОрганизацииСтрокой, ОтборСкладыСтрокой, ОтборНоменклатураСтрокой, ОтборВидНоменклатурыСтрокой, Детально)
//+Бычков О. 01.09.2025 #UT10-5403
// Вставка

	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис Billing", УровеньЖурналаРегистрации.Информация,,,"Веб-сервис: Запуск. ПолучитьДанныеОстатковТоваровОрганизаций");
	
	ДатаНачала = Дата(ДатаНачала);
	ДатаОстатков = Дата(ДатаОкончания);
	МассивВозврата = Новый Массив;

	//ОТБОР ПО ОРГАНИЗАЦИЯМ
	МассивОрганизаций = Новый Массив;
	Если ЗначениеЗаполнено(ОтборОрганизацииСтрокой) Тогда
		
		ОтборОрганизации = СтрокаВМассивСтрок(ОтборОрганизацииСтрокой, ";");
		
		Для Каждого Орг из ОтборОрганизации Цикл  
			
			ОрганизацияСсылка = Справочники.Организации.НайтиПоРеквизиту("КодМДМ", Орг);
			Если ЗначениеЗаполнено(ОрганизацияСсылка) Тогда
				МассивОрганизаций.Добавить(ОрганизацияСсылка);
			Иначе         
				
				СтруктураВозврата = Новый Структура;
				СтруктураВозврата.Вставить("Результат", Ложь);
				СтруктураВозврата.Вставить("Сообщение", "Не найдена организация в базе УТ10 по коду МДМ " + Орг);
				
				РезультатВыполнения = ДанныеВJSON(СтруктураВозврата);
					
				Возврат РезультатВыполнения; 
				
			КонецЕсли;    
			
		КонецЦикла;
		
	КонецЕсли;
	
	//ОТБОР ПО СКЛАДАМ  
	МассивСкладов = Новый Массив; 

	Если ЗначениеЗаполнено(ОтборСкладыСтрокой) Тогда
		
		ОтборСклады = СтрокаВМассивСтрок(ОтборСкладыСтрокой, ";");
				
		Для Каждого Скл из ОтборСклады Цикл  
			
			СкладСсылка = Справочники.Склады.НайтиПоРеквизиту("КодМДМ", Скл);
			
			Если ЗначениеЗаполнено(СкладСсылка) Тогда
				МассивСкладов.Добавить(СкладСсылка);
			Иначе  
				
				СтруктураВозврата = Новый Структура;
				СтруктураВозврата.Вставить("Результат", Ложь);
				СтруктураВозврата.Вставить("Сообщение", "Не найден склад в базе УТ10 по коду МДМ " + Скл);
				
				РезультатВыполнения = ДанныеВJSON(СтруктураВозврата);
					
				Возврат РезультатВыполнения;  
				
			КонецЕсли;
			
		КонецЦикла;	

	КонецЕсли;
	
	//ОТБОР ПО НОМЕНКЛАТУРЕ
	МассивНоменклатуры = Новый Массив; 
	
	Если ЗначениеЗаполнено(ОтборНоменклатураСтрокой) Тогда
		
		ОтборНоменклатура = СтрокаВМассивСтрок(ОтборНоменклатураСтрокой, ";");
	
		Для Каждого Ном из ОтборНоменклатура Цикл  
			
			НоменклатураСсылка = Справочники.Номенклатура.НайтиПоРеквизиту("КодМДМ", Ном);
			
			Если ЗначениеЗаполнено(НоменклатураСсылка) Тогда
				МассивНоменклатуры.Добавить(НоменклатураСсылка);
			Иначе  
				
				СтруктураВозврата = Новый Структура;
				СтруктураВозврата.Вставить("Результат", Ложь);
				СтруктураВозврата.Вставить("Сообщение", "Не найдена номенклатура в базе УТ10 по коду МДМ " + Ном);
				
				РезультатВыполнения = ДанныеВJSON(СтруктураВозврата);
					
				Возврат РезультатВыполнения;  
				
			КонецЕсли;
			
		КонецЦикла;	
	
	КонецЕсли;
	
	//ОТБОР ПО ВИДУ НОМЕНКЛАТУРЫ
	МассивВидаНоменклатуры = Новый Массив; 
	
	Если ЗначениеЗаполнено(ОтборВидНоменклатурыСтрокой) Тогда
		
		ОтборВидНоменклатуры = СтрокаВМассивСтрок(ОтборВидНоменклатурыСтрокой, ";");
	
		Для Каждого ВидНом из ОтборВидНоменклатуры Цикл  
			
			ВидНомСсылка = Справочники.ВидыНоменклатуры.НайтиПоРеквизиту("КодМДМ", ВидНом);
			
			Если ЗначениеЗаполнено(ВидНомСсылка) Тогда    
				
				Если СокрЛП(ВидНомСсылка.Наименование) = "Товар" Тогда
					МассивВидаНоменклатуры.Добавить(ВидНомСсылка);	
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;	
	
	КонецЕсли;	
	
	Запрос = Новый Запрос;   

	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);   
	Запрос.УстановитьПараметр("Дата", Новый Граница(КонецДня(ДатаОстатков), ВидГраницы.Включая));
	
	НастроитьЗапросОстатковТоваровОрганизаций(Запрос, Детально, МассивОрганизаций, МассивСкладов, МассивНоменклатуры, МассивВидаНоменклатуры, ОтборВидНоменклатурыСтрокой);
	
	Выборка = Запрос.Выполнить().Выбрать();		
			
	Если НЕ Детально Тогда
		
		Пока Выборка.Следующий() Цикл		
			
			Структура = Новый Структура;      
			Структура.Вставить("ОрганизацияКодМДМ", Выборка.ОрганизацияКодМДМ);
			Структура.Вставить("СкладКодМДМ", Выборка.СкладКодМДМ);
			Структура.Вставить("НоменклатураКодМДМ", Выборка.НоменклатураКодМДМ);
			Структура.Вставить("НоменклатураНаименование", Выборка.НоменклатураНаименование);
			Структура.Вставить("НоменклатураИнвентарныйНомер", Выборка.НоменклатураИнвентарныйНомер);
			Структура.Вставить("ТОХ", Выборка.ТОХ);
			Структура.Вставить("Остаток", Выборка.Остаток);
			
			МассивВозврата.Добавить(Структура);
			
		КонецЦикла;	  
				
	Иначе

		Пока Выборка.Следующий() Цикл		
			
			Если НЕ ЗначениеЗаполнено(Выборка.Регистратор) Тогда
				Продолжить;
			КонецЕсли;
			
			Структура = Новый Структура;      
			Структура.Вставить("РегистраторИдентификатор", Строка(Выборка.Регистратор.УникальныйИдентификатор()));
			Структура.Вставить("РегистраторПредставление", ?(ЗначениеЗаполнено(Выборка.РегистраторПредставление), Выборка.РегистраторПредставление, ""));
			Структура.Вставить("ОрганизацияКодМДМ", Выборка.ОрганизацияКодМДМ);
			Структура.Вставить("СкладКодМДМ", Выборка.СкладКодМДМ);
			Структура.Вставить("НоменклатураКодМДМ", Выборка.НоменклатураКодМДМ);    
			Структура.Вставить("НоменклатураНаименование", Выборка.НоменклатураНаименование);
			Структура.Вставить("НоменклатураИнвентарныйНомер", Выборка.НоменклатураИнвентарныйНомер);
			Структура.Вставить("ТОХ", Выборка.ТОХ);
			Структура.Вставить("НачальныйОстаток", Выборка.КоличествоНачальныйОстаток);
			Структура.Вставить("Приход", Выборка.КоличествоПриход);
			Структура.Вставить("Расход", Выборка.КоличествоРасход);
			Структура.Вставить("КонечныйОстаток", Выборка.КоличествоКонечныйОстаток);
			
			МассивВозврата.Добавить(Структура);
			
		КонецЦикла;		
		
	КонецЕсли;	
	
	РезультатВыполнения = ДанныеВJSON(МассивВозврата);
		
	ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис Billing", УровеньЖурналаРегистрации.Информация,,,"Веб-сервис:Завершение. ПолучитьДанныеОстатковТоваровОрганизаций " 
	+ Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
	
	Возврат РезультатВыполнения;
	
//-Бычков О. 01.09.2025 #UT10-5403
КонецФункции

////////////Вспомогательные процедуры/////////////////////
Функция ДанныеВJSON(Данные)
	
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные,, "ОбработатьНеподдерживаемоеСвойствоJSON", МСК);
	JsonСтрока = ЗаписьJSON.Закрыть(); 

	Возврат JsonСтрока;
	
КонецФункции

