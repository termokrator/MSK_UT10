Функция ДобавитьСтрокуКЗаказуНаПортал(ВыборкаРезультата, СтрокаСтатус, КоличествоВСтатусе,ОтборСтатусов)

	Если ОтборСтатусов = "1000" Тогда
		Если Найти(СтрокаСтатус,"60;") > 0 Тогда Возврат ""; КонецЕсли; 
	ИначеЕсли ОтборСтатусов = "10" Тогда
		Если НЕ СтрокаСтатус = "10; зарезервирован" Тогда Возврат ""; КонецЕсли;
	ИначеЕсли ОтборСтатусов = "40" Тогда
		Если НЕ СтрокаСтатус = "40;готов к отгрузке" Тогда Возврат ""; КонецЕсли;
	ИначеЕсли ОтборСтатусов = "20" Тогда
		//Не обрабатывается
	ИначеЕсли ОтборСтатусов = "30" Тогда
		Если НЕ СтрокаСтатус = "30; на подборе" Тогда Возврат ""; КонецЕсли; 
	ИначеЕсли ОтборСтатусов = "110" Тогда
		//Не обрабатывается
	ИначеЕсли ОтборСтатусов = "50" Тогда
		Если НЕ СтрокаСтатус = "50;на доставке" Тогда Возврат ""; КонецЕсли; 
	ИначеЕсли ОтборСтатусов = "100" Тогда
		
		Если НЕ СтрокаСтатус = "100;отказ покупателя" И НЕ СтрокаСтатус = "110;нет на складе" 
			И НЕ СтрокаСтатус = "110;отказ поставщика" И НЕ СтрокаСтатус = "110;истек срок резервирования" Тогда 
			Возврат "";
		КонецЕсли; 
		
	ИначеЕсли ОтборСтатусов = "60" Тогда		
		Если Найти(СтрокаСтатус, "60;") = 0 Тогда Возврат ""; КонецЕсли;
	КонецЕсли;
	
	ТипСтрокаОтвета	= ФабрикаXDTO.Тип(Метаданные.WebСервисы.PM_6951_FOR_PORTAL_EX.ПространствоИмен, "Out_PM_6951_FOR_PORTAL_EX");  
	СтрокаВозврата = ФабрикаXDTO.Создать(ТипСтрокаОтвета);
	ЗаполнитьЗначенияСвойств(СтрокаВозврата, ВыборкаРезультата,, "DCODE_6051,DDATE1_6051,VALUTA,SUMMA,KOL_VO,KOL_VO_MINUS,PLAN_DATE");
	СтрокаВозврата.DCODE_6951 = СокрЛП(СтрокаВозврата.DCODE_6951) + "(" + ?(ВыборкаРезультата.Ссылка.ТаксиДоставка, "Такси", 
	          СтрЗаменить(ВыборкаРезультата.Ссылка.СпособДоставки, "Наша д", "Д")) + ")";	

	Если Найти(СтрокаВозврата.TOVAR_PRIMECH,"Стор") = 0 Тогда
		
		Если НЕ ВыборкаРезультата.Ссылка.IDСклада_СтороннийСклад.Пустая() Тогда
			
			//+Белов А. 22.10.2024 #UT10-4825
			Если (СтрДлина(СтрокаВозврата.TOVAR_PRIMECH) + СтрДлина(" Стор " + СокрЛП(ВыборкаРезультата.Ссылка.IDСклада_СтороннийСклад.Идентификатор))) <= 80 Тогда
				СтрокаВозврата.TOVAR_PRIMECH = СтрокаВозврата.TOVAR_PRIMECH + " Стор " + СокрЛП(ВыборкаРезультата.Ссылка.IDСклада_СтороннийСклад.Идентификатор);
			КонецЕсли; 		
			//	Соответствие = МСК.ПолучитьСоответствиеСтороннегоСкладаСкладуФилиала(Неопределено, ВыборкаРезультата.Ссылка.IDСклада_СтороннийСклад);
			//	IDСклада = ?(Соответствие = Неопределено, ВыборкаРезультата.Ссылка.IDСклада_СтороннийСклад.Идентификатор, Соответствие.СтороннийСклад.Идентификатор);
			//	
			//	Если (СтрДлина(СтрокаВозврата.TOVAR_PRIMECH) + СтрДлина(" Стор " + СокрЛП(IDСклада))) <= 80 Тогда
			//		СтрокаВозврата.TOVAR_PRIMECH = СтрокаВозврата.TOVAR_PRIMECH + " Стор " + СокрЛП(IDСклада);
			//	КонецЕсли;
			//-Белов А. 22.10.2024 #UT10-4825
			
		КонецЕсли; 
			
	КонецЕсли;
	
	ЕстьРН = ЗначениеЗаполнено(ВыборкаРезультата.СсылкаНаСФ);

	СтрокаВозврата.DID_6951    = СокрЛП(ВыборкаРезультата.Ссылка.УникальныйИдентификатор());
	СтрокаВозврата.DDATE1_6951 = Формат(ВыборкаРезультата.DATE_TIMESTAMP, "ДФ='dd.MM.yyyy HH:mm'");
	
	Если ЕстьРН Тогда
		
		//отображаем не РН, а СФ)
		СтрокаВозврата.DID_6051    = СокрЛП(ВыборкаРезультата.СсылкаНаСФ.УникальныйИдентификатор());
		///
		СтрокаВозврата.DDATE1_6051 = Формат(ВыборкаРезультата.DDATE1_6051, "ДФ='dd.MM.yyyy HH:mm'");
		СтрокаВозврата.DCODE_6051 = ВыборкаРезультата.DCODE_6051;
		СтрокаВозврата.VALUTA = ВыборкаРезультата.VALUTA;
		
	КонецЕсли;
	
	СтрокаВозврата.STATUS = СокрЛП(СтрокаСтатус);
	СтрокаВозврата.KOL_VO_MINUS = КоличествоВСтатусе;
	СтрокаВозврата.KOL_VO = КоличествоВСтатусе;
	
	Попытка
		СтрокаВозврата.SUMMA = КоличествоВСтатусе * ВыборкаРезультата.PRICE;
	Исключение
		СтрокаВозврата.SUMMA = 0;
	КонецПопытки;

	мМожноКорректировать = Истина;     

	Если СтрокаСтатус = "50;на доставке"
		ИЛИ НЕ Найти(СтрокаСтатус,"60;") = 0  
		ИЛИ СтрокаСтатус = "100;отказ покупателя"
		ИЛИ СтрокаСтатус = "110;отказ поставщика"
		ИЛИ СтрокаСтатус = "110;нет на складе"
		ИЛИ СтрокаСтатус = "110;истек срок резервирования"
		Тогда
		мМожноКорректировать = Ложь;
	ИначеЕсли СтрокаСтатус = "30; на подборе" Тогда		
		мМожноКорректировать = МСКWEB.ПроверитьСтатусСборки(ВыборкаРезультата.Ссылка,ВыборкаРезультата.Номенклатура); 
	ИначеЕсли СтрокаСтатус = "40;готов к отгрузке" Тогда		
		мМожноКорректировать = МСКWEB.ПроверитьСтатусОтгрузки(ВыборкаРезультата.Ссылка,ВыборкаРезультата.Номенклатура);
	КонецЕсли;
	
	Если мМожноКорректировать Тогда 
		мМожноКорректировать = НЕ Константы.ЯчейкаДляПеремещенияОтказовКлиентов.Получить().Пустая(); 
	КонецЕсли;
	
	Если мМожноКорректировать Тогда 
		мМожноКорректировать = ВыборкаРезультата.Ссылка.IDСклада_СтороннийСклад.Пустая(); 
	КонецЕсли;
	
	Если мМожноКорректировать И ВыборкаРезультата.Ссылка.ТолькоРезерв Тогда 
		мМожноКорректировать = Ложь; 
	КонецЕсли; 
	
	СтрокаВозврата.FLAG_1 = МСКWEB.ПолучитьСписокДействийСЗаказом(ВыборкаРезультата.Ссылка, ВыборкаРезультата.ЕстьСборка, ВыборкаРезультата.ЕстьЗаказ, мМожноКорректировать);
	
	Если НЕ ВыборкаРезультата.Зарезервированно = 0 ИЛИ НЕ ВыборкаРезультата.ЗаказаноПоставщику = 0 
		ИЛИ НЕ ВыборкаРезультата.Заказано = 0 ИЛИ НЕ ВыборкаРезультата.Собирается = 0 ИЛИ НЕ ВыборкаРезультата.Собрано = 0 Тогда
		СтрокаВозврата.PLAN_DATE = ?(ЗначениеЗаполнено(ВыборкаРезультата.PLAN_DATE), Формат(ВыборкаРезультата.PLAN_DATE, "ДФ=dd.MM.yyyy"), "");
	КонецЕсли;	

	Возврат СтрокаВозврата;

КонецФункции

Процедура ДобавитьНеСозданныеЗаказыПокупателей(РезультатДляВозвратаПорталу, пДатаНачалаОтчета, пДатаКонцаОтчета, ИДАвардаКонтрагента, ТипСтрокаОтвета)
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	НеСозданныеЗаказыПокупателейТовары.NumberInv КАК INV_NUM,
	|	"""" КАК VALUTA,
	|	НеСозданныеЗаказыПокупателейТовары.Кратность КАК KOEF,
	|	НеСозданныеЗаказыПокупателейТовары.Count КАК KOL_VO,
	|	НеСозданныеЗаказыПокупателейТовары.Price КАК PRICE,
	|	НеСозданныеЗаказыПокупателейТовары.Comment КАК TOVAR_PRIMECH,
	|	НеСозданныеЗаказыПокупателейТовары.Price * НеСозданныеЗаказыПокупателейТовары.Count КАК SUMMA,
	|	НеСозданныеЗаказыПокупателейТовары.Articul КАК ARTICUL_OUT,
	|	НеСозданныеЗаказыПокупателейТовары.Name КАК TOVAR_NAME,
	|	НеСозданныеЗаказыПокупателейТовары.Brand КАК BREND,
	|	НеСозданныеЗаказыПокупателейТовары.EDIzmer КАК ED_IZM,
	|	НеСозданныеЗаказыПокупателейТовары.Price_Zak,
	|	НеСозданныеЗаказыПокупателейТовары.Причина,
	|	НеСозданныеЗаказыПокупателейТовары.РазрешеноКОтгрузке,
	|	НеСозданныеЗаказыПокупателейТовары.ЦенаОтгрузки,
	|	НеСозданныеЗаказыПокупателейТовары.ПроизводительПоставщика,
	|	НеСозданныеЗаказыПокупателейТовары.Ссылка.Ссылка,
	|	НеСозданныеЗаказыПокупателейТовары.Ссылка.Код КАК DCODE_6951,
	|	НеСозданныеЗаказыПокупателейТовары.Ссылка.Дата КАК DATE_TIMESTAMP,
	|	"""" КАК DCODE_6051,
	|	"""" КАК DDATE1_6051,
	|	НеСозданныеЗаказыПокупателейТовары.Ссылка.Наименование КАК FILIAL_NAME,
	|	ВЫРАЗИТЬ(НеСозданныеЗаказыПокупателейТовары.Ссылка.Comment КАК СТРОКА(100)) КАК DNOTE,
	|	""RUB"" КАК VALUTA_NAME,
	|	"""" КАК DOGOVOR_NAME,
	|	"""" КАК SKLAD_NAME,
	|	НеСозданныеЗаказыПокупателейТовары.Ссылка.FirmID КАК OUR_FIRM,
	|	ПРЕДСТАВЛЕНИЕ(НеСозданныеЗаказыПокупателейТовары.Ссылка.Контрагент) КАК UR_LICO,
	|	0 КАК REZERV_SUM
	|ИЗ
	|	Справочник.НеСозданныеЗаказыПокупателей.Товары КАК НеСозданныеЗаказыПокупателейТовары
	|ГДЕ
	|	НеСозданныеЗаказыПокупателейТовары.Ссылка.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|	И НеСозданныеЗаказыПокупателейТовары.Ссылка.ПометкаУдаления = ЛОЖЬ
	|	И НеСозданныеЗаказыПокупателейТовары.Ссылка.KontragentID = &KontragentID
	|	И НеСозданныеЗаказыПокупателейТовары.Ссылка.ЗаказПокупателяСсылка = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)");
	
	Запрос.УстановитьПараметр("ДатаНач", ?(ЗначениеЗаполнено(пДатаНачалаОтчета), НачалоДня(пДатаНачалаОтчета), НачалоДня(ТекущаяДата() - 86400*14)));
	Запрос.УстановитьПараметр("ДатаКон", ?(ЗначениеЗаполнено(пДатаКонцаОтчета), КонецДня(пДатаКонцаОтчета), КонецДня(ТекущаяДата())));
	Запрос.УстановитьПараметр("KontragentID", ИДАвардаКонтрагента);
	
	РезЗапроса = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрРез Из РезЗапроса Цикл
		
		СтрокаВозврата = ФабрикаXDTO.Создать(ТипСтрокаОтвета);		
		
		СтрокаВозврата.INV_NUM = СтрРез.INV_NUM;
		//СтрокаВозврата.VALUTA = СтрРез.VALUTA;
		СтрокаВозврата.KOEF = СтрРез.KOEF;
		СтрокаВозврата.KOL_VO = СтрРез.KOL_VO;
		СтрокаВозврата.PRICE = СтрРез.PRICE;
		СтрокаВозврата.SUMMA = СтрРез.SUMMA;
		СтрокаВозврата.ARTICUL_OUT = СтрРез.ARTICUL_OUT;
		СтрокаВозврата.TOVAR_NAME = СтрРез.TOVAR_NAME;
		СтрокаВозврата.BREND = СтрРез.BREND;
		СтрокаВозврата.ED_IZM = СтрРез.ED_IZM;		
		СтрокаВозврата.DATE_TIMESTAMP = СтрРез.DATE_TIMESTAMP;
		//СтрокаВозврата.DCODE_6051 = СтрРез.DCODE_6051;
		//СтрокаВозврата.DDATE1_6051 = СтрРез.DDATE1_6051;
		СтрокаВозврата.FILIAL_NAME = СтрРез.FILIAL_NAME;
		СтрокаВозврата.DNOTE = СтрРез.DNOTE;
		СтрокаВозврата.VALUTA_NAME = СтрРез.VALUTA_NAME;
		СтрокаВозврата.DOGOVOR_NAME = СтрРез.DOGOVOR_NAME;
		СтрокаВозврата.SKLAD_NAME = СтрРез.SKLAD_NAME;
		СтрокаВозврата.OUR_FIRM = СтрРез.OUR_FIRM;
		СтрокаВозврата.UR_LICO = СтрРез.UR_LICO;
		
		СтрокаВозврата.DID_6951 = СокрЛП(СтрРез.Ссылка.УникальныйИдентификатор());
		СтрокаВозврата.DDATE1_6951 = Формат(СтрРез.DATE_TIMESTAMP, "ДФ='dd.MM.yyyy HH:mm'");
		СтрокаВозврата.DCODE_6951 = "Заказ от " + СтрокаВозврата.DDATE1_6951;
		СтрокаВозврата.STATUS = "10; принят в работу";
		СтрокаВозврата.REZERV_SUM = РезЗапроса.Итог("SUMMA");
		
		СтрокаВозврата.FLAG_1 = "0000";
		
		РезультатДляВозвратаПорталу.Row.Добавить(СтрокаВозврата);
		
	КонецЦикла;	
	
КонецПроцедуры
