		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	БуферАрмКладовщикаГМ.ГМ
		|ПОМЕСТИТЬ ВТ_ГМВБуфере
		|ИЗ
		|	РегистрСведений.БуферАрмКладовщикаГМ КАК БуферАрмКладовщикаГМ
		|ГДЕ
		|	БуферАрмКладовщикаГМ.ГМ = &ГМ
		|	И БуферАрмКладовщикаГМ.Объект = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	БуферАрмКладовщикаГМ.ГМ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ГМПоступлений.ГМ,
		|	ЕСТЬNULL(ВТ_ГМРазмещений.ГМ, """") КАК ГМРазмещения,
		|	ЕСТЬNULL(ВТ_ГМВБуфере.ГМ, """") КАК ГМБуфера
		|ИЗ
		|	ВТ_ГМПоступлений КАК ВТ_ГМПоступлений
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ГМРазмещений КАК ВТ_ГМРазмещений
		|		ПО ВТ_ГМПоступлений.ГМ = ВТ_ГМРазмещений.ГМ
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ГМВБуфере КАК ВТ_ГМВБуфере
		|		ПО ВТ_ГМПоступлений.ГМ = ВТ_ГМВБуфере.ГМ";
		
		Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
		Запрос.УстановитьПараметр("ГМ", Barcode);
		
		МассивВозврата = Новый Массив;
		СтруктураВозврата = Новый Структура;
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			
			Если Выборка.ГМРазмещения <> "" ИЛИ Выборка.ГМБуфера <> "" Тогда
				
				Если Выборка.ГМРазмещения <> "" Тогда
					СтруктураВозврата = Новый Структура("Ошибка", "По данному штрихкоду уже создано размещение");
				Иначе
					СтруктураВозврата = Новый Структура("Ошибка", "Данный штрих код уже есть в буфере отсканированных штрихкодов");
				КонецЕсли;
					
			Иначе
				МассивВозврата.Добавить(Новый Структура("ГМ, ТипСтрокиЗапроса", Barcode, ""));
			КонецЕсли;   
			
		Иначе
			СтруктураВозврата = Новый Структура("Ошибка", "Не найдено грузоместо в поступлении по такому штрихкоду");
		КонецЕсли;
		
		Если МассивВозврата.Количество() = 0 Тогда
			РезультатВыполнения = ARMStoreKeeper.ДанныеВJSONХранилище(СтруктураВозврата);	
		Иначе
			РезультатВыполнения = ARMStoreKeeper.ДанныеВJSONХранилище(МассивВозврата);
		КонецЕсли;
			
	Исключение
		
	    РезультатВыполнения = ПолучитьОписаниеОшибки(ОписаниеОшибки());
		
	КонецПопытки; 
	
	ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис ARMStoreKeeper", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. FindGMByBarcode " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
		
	Возврат РезультатВыполнения; 
	
КонецФункции

Функция AddBufferARMStoreKeeperGM(ObjectGUID, UserIdGUID, CreatedDate, Barcode, CellGUID, PutIntoManual)
	
	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис ARMStoreKeeper", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Запуск. AddBufferARMStoreKeeperGM");
		
	Попытка
		
		ОбъектСсылка = Документы.ПоступлениеТоваровУслуг.ПолучитьСсылку(Новый УникальныйИдентификатор(ObjectGUID) );
		
		ЯчейкаСсылка = Справочники.Ячейки.ПолучитьСсылку(Новый УникальныйИдентификатор(CellGUID));
		
		Если UserIdGUID <> Неопределено И ЗначениеЗаполнено(UserIdGUID) Тогда
			UserIdСсылка = Справочники.ФизическиеЛица.ПолучитьСсылку(Новый УникальныйИдентификатор(UserIdGUID));				
		Иначе 
			UserIdСсылка = Справочники.ФизическиеЛица.ПустаяСсылка();			
		КонецЕсли; 
		
		
		МЗ = РегистрыСведений.БуферАрмКладовщикаГМ.СоздатьМенеджерЗаписи();	
		МЗ.Объект = ОбъектСсылка;
		МЗ.UserId = UserIdСсылка;
		МЗ.ГМ = Barcode;
		МЗ.CreateDate = CreatedDate;
		МЗ.Прочитать();
		
		Если МЗ.Выбран() Тогда
			
			Если Не МЗ.ВведеноВРучную И PutIntoManual Тогда
				МЗ.ВведеноВРучную = PutIntoManual;
			КонецЕсли; 
			
		Иначе
			
			МЗ.Объект = ОбъектСсылка;
			МЗ.UserId = UserIdСсылка;
			МЗ.CreateDate = CreatedDate;
			МЗ.ГМ = Barcode;
			МЗ.Barcode = Barcode;
			МЗ.Ячейка = ЯчейкаСсылка;
			МЗ.ВведеноВРучную = PutIntoManual;
			
		КонецЕсли;	
		
		МЗ.Записать();
		
		ARMStoreKeeper.ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Создана запись в БуферАРМКладовщикаГМ" , 
			"ПТУ " + Строка(ОбъектСсылка.Номер) + ","+ Строка(ОбъектСсылка.НомерСкладскогоДокумента) + 
			"ГМ " + Barcode);
		
		РезультатВыполнения = Истина;
		
	Исключение

		РезультатВыполнения = ПолучитьОписаниеОшибки(ОписаниеОшибки());
		
	КонецПопытки; 
	
	ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис ARMStoreKeeper", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. AddBufferARMStoreKeeperGM " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
		
	Возврат РезультатВыполнения;

КонецФункции

