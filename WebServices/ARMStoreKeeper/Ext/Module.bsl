// Поиск товара по различным видам поиска
Функция FindGoodByBarcodeForSearchType(UserGUID, Barcode, TypeDocument, GUIDDocument, SearchType )
	
	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис ARMStoreKeeper", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Запуск. FindGoodByBarcodeForSearchType");
	
	РезультатВыполнения = Неопределено;
	
	Попытка
		
		Если SearchType = "ПоискШтрихкодов"  Тогда
			                                                                                             
			ТЗ = ARMStoreKeeper.ПолучитьТоварПоШтрихкоду(UserGUID, Barcode, TypeDocument, GUIDDocument);
			МассивВременный = ARMStoreKeeper.ТаблицуВМассив(ТЗ);
			РезультатВыполнения = ARMStoreKeeper.ДанныеВJSONХранилище(МассивВременный);
			
		ИначеЕсли SearchType = "ПоискПоНормализованномуКоду"  Тогда
			
			ТЗ = ARMStoreKeeper.ПолучитьТоварПоНормализованномуКодуВызов(UserGUID, Barcode, TypeDocument, GUIDDocument);
			
			МассивВременный = ARMStoreKeeper.ТаблицуВМассив(ТЗ);
			РезультатВыполнения = ARMStoreKeeper.ДанныеВJSONХранилище(МассивВременный);
			
		ИначеЕсли SearchType = "ПоискПоКоду" Тогда
			
			ТЗ =  ARMStoreKeeper.ПолучитьТоварПоКодуВызов(UserGUID, Barcode, TypeDocument, GUIDDocument);
			МассивВременный = ARMStoreKeeper.ТаблицуВМассив(ТЗ);
			РезультатВыполнения = ARMStoreKeeper.ДанныеВJSONХранилище(МассивВременный);
			
		КонецЕсли;                                                      
		
	Исключение
		
	    РезультатВыполнения = ПолучитьОписаниеОшибки(ОписаниеОшибки());
		
	КонецПопытки; 
	
	ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис ARMStoreKeeper", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. FindGoodByBarcodeForSearchType " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
	
	Если Не РезультатВыполнения = Неопределено Тогда
		Возврат РезультатВыполнения;
	КонецЕсли;
		
КонецФункции

// используется при работе сканера
Функция GetDocumentByBarcode(Barcode, UserIdGUID)   
	
	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис ARMStoreKeeper", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Запуск. GetDocumentByBarcode");
	
	РезультатВыполнения = Неопределено;
	
	UserIdСсылка = ARMStoreKeeper.ПолучитьПользователя(UserIdGUID);
	
	Попытка
		
		МассивДокументов = ШтрихкодированиеПечатныхФорм.ПолучитьСсылкуПоШтрихкодуТабличногоДокумента(Barcode);
		
		Если МассивДокументов.Количество() > 0 Тогда
			
			ДокументСсылка = МассивДокументов.Получить(0);		
			ARMStoreKeeper.ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Получить документ по штрихкоду", Barcode); 
			РезультатВыполнения = ARMStoreKeeper.ПолучитьСписокДокументовПТУ( ДокументСсылка, Неопределено);
			
		КонецЕсли;  
		
	Исключение
		
	    РезультатВыполнения = ПолучитьОписаниеОшибки(ОписаниеОшибки());
		
	КонецПопытки; 
	
	ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис ARMStoreKeeper", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. GetDocumentByBarcode " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
		
	Если Не РезультатВыполнения = Неопределено Тогда
		Возврат РезультатВыполнения;
	КонецЕсли;
	
КонецФункции

