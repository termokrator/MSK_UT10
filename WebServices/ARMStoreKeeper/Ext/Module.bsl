Функция AddBufferMovingARMStoreKeeper(UserIdGUID, CellFromGUID, GoodGUID, CreatedDate, Barcode, Quantity, CellWhereGUID, PutIntoManual)
	
	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис ARMStoreKeeper", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Запуск. AddBufferMovingARMStoreKeeper");
	
	Попытка
		
		НоменклатураСсылка = Справочники.Номенклатура.ПолучитьСсылку( Новый УникальныйИдентификатор(GoodGUID));
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.КодПроизводителя
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", НоменклатураСсылка);
		РезультатЗапроса = Запрос.Выполнить().Выбрать();
		РезультатЗапроса.Следующий();
		
		ЯчейкаОткудаСсылка = Справочники.Ячейки.ПолучитьСсылку( Новый УникальныйИдентификатор(CellFromGUID));
		ЯчейкаКудаСсылка = Справочники.Ячейки.ПолучитьСсылку( Новый УникальныйИдентификатор(CellWhereGUID));
		
		Если UserIdGUID <> Неопределено И ЗначениеЗаполнено(UserIdGUID) Тогда
			UserIdСсылка = Справочники.ФизическиеЛица.ПолучитьСсылку( Новый УникальныйИдентификатор(UserIdGUID));				
		Иначе 
			UserIdСсылка = Справочники.ФизическиеЛица.ПустаяСсылка();			
		КонецЕсли; 
				
		МЗ = РегистрыСведений.БуферАРМКладовшикаПеремещение.СоздатьМенеджерЗаписи();	
		
		МЗ.UserId = UserIdСсылка;                      		
		МЗ.ЯчейкаОткуда = ЯчейкаОткудаСсылка;
		МЗ.Номенклатура = НоменклатураСсылка;
		МЗ.CreatedDate = CreatedDate;                                                 
		
		МЗ.Прочитать();
		
		Если МЗ.Выбран() Тогда
			
			МЗ.Quantity = МЗ.Quantity + Quantity;
			
			Если Не МЗ.ВведеноВРучную И PutIntoManual Тогда
				МЗ.ВведеноВРучную = PutIntoManual;
			КонецЕсли; 
			
		Иначе
			
			МЗ.UserId = UserIdСсылка;                      		
			МЗ.ЯчейкаОткуда = ЯчейкаОткудаСсылка;
			МЗ.Номенклатура = НоменклатураСсылка;
			МЗ.CreatedDate = CreatedDate;
			МЗ.Barcode = Barcode;
			МЗ.Quantity = Quantity;
			МЗ.ЯчейкаКуда = ЯчейкаКудаСсылка;
			МЗ.КодПроизводителя = РезультатЗапроса.КодПроизводителя;
			МЗ.ВведеноВРучную = PutIntoManual;
			
		КонецЕсли;	
		                                                                                         
		МЗ.Записать();
		
		ARMStoreKeeper.ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Добавить запись в БуферАРМКладовшикаПеремещение", 
			"Откуда " + ЯчейкаОткудаСсылка.Код + " Куда " + ЯчейкаКудаСсылка.Код + "; Штрихкод " + Barcode + "; КодПроизводителя " + РезультатЗапроса.КодПроизводителя +
