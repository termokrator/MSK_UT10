// Добавить запись в регистр сведений Буффер арм кладовщика                                                               
Функция AddBufferARMStoreKeeper(ObjectGUID, GoodGUID, UserIdGUID, CreateDate, Barcode, Quantity, CellGUID, PutIntoManual)
	
	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис ARMStoreKeeper", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Запуск. AddBufferARMStoreKeeper");
		
	Попытка
		
		ОбъектСсылка = Документы.ПоступлениеТоваровУслуг.ПолучитьСсылку(Новый УникальныйИдентификатор(ObjectGUID));

		Если ОбъектСсылка.ПолучитьОбъект() = Неопределено Тогда
			ОбъектСсылка = Документы.ПоступлениеТоваровНаОтветственноеХранение.ПолучитьСсылку(Новый УникальныйИдентификатор(ObjectGUID));
		КонецЕсли;

		НоменклатураСсылка = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(GoodGUID));
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.КодПроизводителя
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", НоменклатураСсылка);
		
		РезультатЗапроса = Запрос.Выполнить().Выбрать();
		РезультатЗапроса.Следующий();
		
		ЯчейкаСсылка = Справочники.Ячейки.ПолучитьСсылку(Новый УникальныйИдентификатор(CellGUID));
		
		Если UserIdGUID <> Неопределено И ЗначениеЗаполнено(UserIdGUID) Тогда
			UserIdСсылка = Справочники.ФизическиеЛица.ПолучитьСсылку(Новый УникальныйИдентификатор(UserIdGUID));				
		Иначе 
			UserIdСсылка = Справочники.ФизическиеЛица.ПустаяСсылка();			
		КонецЕсли; 
		
		
		МЗ = РегистрыСведений.БуферАрмКладовщика.СоздатьМенеджерЗаписи();	
		МЗ.Объект = ОбъектСсылка;
		МЗ.UserId = UserIdСсылка;                      		
		МЗ.Номенклатура = НоменклатураСсылка;		
		МЗ.CreateDate = CreateDate;
		МЗ.Прочитать();
		
		Если МЗ.Выбран() Тогда
			
			МЗ.Quantity = МЗ.Quantity + Quantity;
			
			Если Не МЗ.ВведеноВРучную И PutIntoManual Тогда
				МЗ.ВведеноВРучную = PutIntoManual;
			КонецЕсли; 
			
		Иначе
			
			МЗ.Объект = ОбъектСсылка;
			МЗ.UserId = UserIdСсылка;
			МЗ.CreateDate = CreateDate;			
			МЗ.Номенклатура = НоменклатураСсылка;		
			МЗ.Barcode = Barcode;
			МЗ.Quantity = Quantity;
			МЗ.КодПроизводителя = РезультатЗапроса.КодПроизводителя;
			МЗ.Ячейка = ЯчейкаСсылка;
			МЗ.ВведеноВРучную = PutIntoManual;
			
		КонецЕсли;	
		
		МЗ.Записать();
		
		ARMStoreKeeper.ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Создана запись в БуферАРМКладовщика" , 
			"ПТУ " + Строка(ОбъектСсылка.Номер) + ","+ Строка(ОбъектСсылка.НомерСкладскогоДокумента) + 
			"Номенклатура " + НоменклатураСсылка.КодПроизводителя + ", " + НоменклатураСсылка);
		
		РезультатВыполнения = Истина;
		
	Исключение

		РезультатВыполнения = ПолучитьОписаниеОшибки(ОписаниеОшибки());
		
	КонецПопытки; 
	
	ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис ARMStoreKeeper", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. AddBufferARMStoreKeeper " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
		
	Возврат РезультатВыполнения;
	
КонецФункции

Функция AddBufferARMStoreKeeperUnion(ObjectGUID, UserIdGUID, CreatedDate, Barcode, GMGUID, PutIntoManual)
	
	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис ARMStoreKeeper", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Запуск. AddBufferARMStoreKeeperUnion");
	
	Попытка
					
		ОбъектСсылка = Документы.ОбъединениеГМВТЕ.ПолучитьСсылку(Новый УникальныйИдентификатор(ObjectGUID));

		Если ОбъектСсылка.ПолучитьОбъект() = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;  
		
		ГМСсылка = Документы.ГрузовоеМесто.ПолучитьСсылку(Новый УникальныйИдентификатор(GMGUID));

		Если ГМСсылка.ПолучитьОбъект() = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;   
		
		UserIdСсылка = Справочники.ФизическиеЛица.ПолучитьСсылку(Новый УникальныйИдентификатор(UserIdGUID));
		
		МЗ = РегистрыСведений.БуферАРМКладовщикаОбъединениеТЕ.СоздатьМенеджерЗаписи();	
		МЗ.Объединение = ОбъектСсылка;
		МЗ.UserId = UserIdСсылка;                      				
		МЗ.ГрузовоеМесто = ГМСсылка;
		МЗ.Прочитать();
		
		Если МЗ.Выбран() Тогда
			
			Если Не МЗ.ВведеноВРучную И PutIntoManual Тогда
				МЗ.ВведеноВРучную = PutIntoManual;
			КонецЕсли; 
			
		Иначе
			
			МЗ.Объединение = ОбъектСсылка;    
			МЗ.ГрузовоеМесто = ГМСсылка;
			МЗ.UserId = UserIdСсылка;
			МЗ.CreatedDate = CreatedDate;				
			МЗ.Barcode = Barcode;
			МЗ.ВведеноВРучную = PutIntoManual;
			
		КонецЕсли;	
		
		МЗ.Записать();    
		
		ARMStoreKeeper.ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Создана запись в БуферАРМКладовщикаОбъединениеТЕ",	"Объединение " + Строка(ОбъектСсылка.Номер) + ", ГМ " + Строка(ГМСсылка.Номер));
		
		РезультатВыполнения = Истина;
		
	Исключение   
		
	    РезультатВыполнения = ПолучитьОписаниеОшибки(ОписаниеОшибки());

	КонецПопытки;
	
	ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис ARMStoreKeeper", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. AddBufferARMStoreKeeperUnion " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
		
	Возврат РезультатВыполнения;

КонецФункции

