
Функция ПолучитьТаблицы(ДатаНачала, ДатаОкончания, Водитель)
	
	Запрос = Новый Запрос;
	Запрос.Текст =  
	//+Гавриленков В. 08.11.2024 #UT10-4889 Изменение в определении Стороннего склада
	"ВЫБРАТЬ
	|	ЗаданияИРеализации.ЗаданиеНаДоставку КАК ЗаданиеНаДоставку,
	|	ЗаданияИРеализации.Контрагент КАК Контрагент,
	|	МАКСИМУМ(ЗаданияИРеализации.КоличествоМест) КАК КоличествоМест,
	|	ЗаданияИРеализации.Реализация КАК Реализация,
	|	МАКСИМУМ(ЗаданияИРеализации.ОплатаНаличными) КАК ОплатаНаличными,
	|	МАКСИМУМ(ЕСТЬNULL(ОчередьПечатиККМ.Отмена, ЛОЖЬ)) КАК Отмена,
	|	МАКСИМУМ(ЕСТЬNULL(ОчередьПечатиККМ.Деньги, ЛОЖЬ)) КАК Деньги,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА НЕ ОчередьПечатиККМ.ДокументЧек ЕСТЬ NULL
	|					И ОчередьПечатиККМ.ДокументЧек <> ЗНАЧЕНИЕ(Документ.ПриходныйКассовыйОрдер.ПустаяСсылка)
	|				ТОГДА ОчередьПечатиККМ.ТекСумма
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СуммаПринятоДенег,
	|	МАКСИМУМ(ЗаданияИРеализации.НеДоставлен) КАК НеДоставлен,
	|	МАКСИМУМ(ЗаданияИРеализации.Доставляется) КАК Доставляется
	|ПОМЕСТИТЬ ЗаданияНаДоставку
	|ИЗ
	|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|		ЗаданиеНаДоставкуДоставка.Ссылка КАК ЗаданиеНаДоставку,
	|		ЗаданиеНаДоставкуДоставка.Контрагент КАК Контрагент,
	|		МАКСИМУМ(ГМПоРеализации.Количество) КАК КоличествоМест,
	|		РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка КАК Реализация,
	|		МАКСИМУМ(ЛОЖЬ) КАК ОплатаНаличными,
	|		МАКСИМУМ(ВЫБОР
	|				КОГДА НЕ СтатусРеализации.Объект ЕСТЬ NULL
	|					ТОГДА СтатусРеализации.НеДоставлен
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ) КАК НеДоставлен,
	|		МАКСИМУМ(ВЫБОР
	|				КОГДА НЕ СтатусРеализации.Объект ЕСТЬ NULL
	|					ТОГДА СтатусРеализации.Доставляется
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ) КАК Доставляется
	|	ИЗ
	|		Документ.ЗаданиеНаДоставку.Доставка КАК ЗаданиеНаДоставкуДоставка
	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.ДокументыСборкиЗаказов КАК РеализацияТоваровУслугДокументыСборкиЗаказов
	|				ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|					ВложенныйЗапрос.Объект КАК Объект,
	|					МАКСИМУМ(ЕСТЬNULL(ВложенныйЗапрос.Доставляется, ЛОЖЬ)) КАК Доставляется,
	|					МАКСИМУМ(ЕСТЬNULL(ВложенныйЗапрос.НеДоставлен, ЛОЖЬ)) КАК НеДоставлен
	|				ИЗ
	|					(ВЫБРАТЬ
	|						ЗначенияСвойствОбъектов.Объект КАК Объект,
	|						NULL КАК Доставляется,
	|						ИСТИНА КАК НеДоставлен
	|					ИЗ
	|						РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	|					ГДЕ
	|						(ЗначенияСвойствОбъектов.Значение = ЗНАЧЕНИЕ(Перечисление.СтатусыДоставки.ТоварНеДоставлен)
	|								ИЛИ ЗначенияСвойствОбъектов.Значение = ЗНАЧЕНИЕ(Перечисление.СтатусыДоставки.ПереносДоставки))
	|						И ЗначенияСвойствОбъектов.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СвойстваОбъектов.СтатусДоставки)
	|					
	|					ОБЪЕДИНИТЬ ВСЕ
	|					
	|					ВЫБРАТЬ
	|						ЗначенияСвойствОбъектов.Объект,
	|						ИСТИНА,
	|						NULL
	|					ИЗ
	|						РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	|					ГДЕ
	|						ЗначенияСвойствОбъектов.Значение = ЗНАЧЕНИЕ(Перечисление.СтатусыДоставки.ТоварДоставляется)
	|						И ЗначенияСвойствОбъектов.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СвойстваОбъектов.СтатусДоставки)) КАК ВложенныйЗапрос
	|				
	|				СГРУППИРОВАТЬ ПО
	|					ВложенныйЗапрос.Объект) КАК СтатусРеализации
	|				ПО РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка = СтатусРеализации.Объект
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|					РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка КАК ДокРеализация,
	|					СУММА(ЗаданиеНаДоставкуДоставка.Количество) КАК Количество
	|				ИЗ
	|					Документ.ЗаданиеНаДоставку.Доставка КАК ЗаданиеНаДоставкуДоставка
	|						ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.ДокументыСборкиЗаказов КАК РеализацияТоваровУслугДокументыСборкиЗаказов
	|						ПО ЗаданиеНаДоставкуДоставка.ДокументСборки = РеализацияТоваровУслугДокументыСборкиЗаказов.ДокументСборки
	|				ГДЕ
	|					ЗаданиеНаДоставкуДоставка.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|					И ЗаданиеНаДоставкуДоставка.Ссылка.Водитель = &ТекущийВодитель
	|					И НЕ РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка ЕСТЬ NULL
	|					И ЗаданиеНаДоставкуДоставка.Ссылка.Проведен
	|					И РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка.Проведен
	|					И НЕ ЗаданиеНаДоставкуДоставка.Отменено
	|				
	|				СГРУППИРОВАТЬ ПО
	|					РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка) КАК ГМПоРеализации
	|				ПО РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка = ГМПоРеализации.ДокРеализация
	|			ПО ЗаданиеНаДоставкуДоставка.ДокументСборки = РеализацияТоваровУслугДокументыСборкиЗаказов.ДокументСборки
	|	ГДЕ
	|		ЗаданиеНаДоставкуДоставка.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|		И ЗаданиеНаДоставкуДоставка.Ссылка.Водитель = &ТекущийВодитель
	|		И НЕ РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка ЕСТЬ NULL
	|		И ЗаданиеНаДоставкуДоставка.Ссылка.Проведен
	|		И РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка.Проведен
	|		И НЕ ЗаданиеНаДоставкуДоставка.Отменено
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ЗаданиеНаДоставкуДоставка.Ссылка,
	|		ЗаданиеНаДоставкуДоставка.Контрагент,
	|		РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка) КАК ЗаданияИРеализации
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОчередьПечатиККМ КАК ОчередьПечатиККМ
	|		ПО ЗаданияИРеализации.ЗаданиеНаДоставку = ОчередьПечатиККМ.ТекЗадание
	|			И ЗаданияИРеализации.Контрагент = ОчередьПечатиККМ.ТекКонтрагент
	|			И ЗаданияИРеализации.Реализация = ОчередьПечатиККМ.ТекРеализация
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаданияИРеализации.ЗаданиеНаДоставку,
	|	ЗаданияИРеализации.Контрагент,
	|	ЗаданияИРеализации.Реализация
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗаданиеНаДоставкуДоставкаПоказная.Ссылка,
	|	ЗаданиеНаДоставкуДоставкаПоказная.Контрагент,
	|	СУММА(0),
	|	NULL,
	|	МАКСИМУМ(ИСТИНА),
	|	МАКСИМУМ(ЕСТЬNULL(ОчередьПечатиККМ.Отмена, ЛОЖЬ)),
	|	МАКСИМУМ(ЕСТЬNULL(ОчередьПечатиККМ.Деньги, ЛОЖЬ)),
	|	СУММА(ВЫБОР
	|			КОГДА НЕ ОчередьПечатиККМ.ДокументЧек ЕСТЬ NULL
	|					И ОчередьПечатиККМ.ДокументЧек <> ЗНАЧЕНИЕ(Документ.ПриходныйКассовыйОрдер.ПустаяСсылка)
	|				ТОГДА ОчередьПечатиККМ.ТекСумма
	|			ИНАЧЕ 0
	|		КОНЕЦ),
	|	МАКСИМУМ(ЛОЖЬ),
	|	МАКСИМУМ(ЛОЖЬ)
	|ИЗ
	|	Документ.ЗаданиеНаДоставку.ДоставкаПоказная КАК ЗаданиеНаДоставкуДоставкаПоказная
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОчередьПечатиККМ КАК ОчередьПечатиККМ
	|		ПО ЗаданиеНаДоставкуДоставкаПоказная.Ссылка = ОчередьПечатиККМ.ТекЗадание
	|			И ЗаданиеНаДоставкуДоставкаПоказная.Контрагент = ОчередьПечатиККМ.ТекКонтрагент
	|ГДЕ
	|	ЗаданиеНаДоставкуДоставкаПоказная.Деньги
	|	И ЗаданиеНаДоставкуДоставкаПоказная.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И ЗаданиеНаДоставкуДоставкаПоказная.Ссылка.Проведен
	|	И ЗаданиеНаДоставкуДоставкаПоказная.Ссылка.Водитель = &ТекущийВодитель
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаданиеНаДоставкуДоставкаПоказная.Ссылка,
	|	ЗаданиеНаДоставкуДоставкаПоказная.Контрагент
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗаданиеНаДоставкуДоставкаПоказная.Ссылка,
	|	ЗаданиеНаДоставкуДоставкаПоказная.Контрагент,
	|	СУММА(0),
	|	NULL,
	|	МАКСИМУМ(ИСТИНА),
	|	МАКСИМУМ(ЕСТЬNULL(ОчередьПечатиККМ.Отмена, ЛОЖЬ)),
	|	МАКСИМУМ(ЕСТЬNULL(ОчередьПечатиККМ.Деньги, ЛОЖЬ)),
	|	СУММА(ВЫБОР
	|			КОГДА НЕ ОчередьПечатиККМ.ДокументЧек ЕСТЬ NULL
	|					И ОчередьПечатиККМ.ДокументЧек <> ЗНАЧЕНИЕ(Документ.ПриходныйКассовыйОрдер.ПустаяСсылка)
	|				ТОГДА ОчередьПечатиККМ.ТекСумма
	|			ИНАЧЕ 0
	|		КОНЕЦ),
	|	МАКСИМУМ(ЛОЖЬ),
	|	МАКСИМУМ(ЛОЖЬ)
	|ИЗ
	|	Документ.ЗаданиеНаДоставку.ДоставкаПоказная КАК ЗаданиеНаДоставкуДоставкаПоказная
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОчередьПечатиККМ КАК ОчередьПечатиККМ
	|		ПО ЗаданиеНаДоставкуДоставкаПоказная.Ссылка = ОчередьПечатиККМ.ТекЗадание
	|			И ЗаданиеНаДоставкуДоставкаПоказная.Контрагент = ОчередьПечатиККМ.ТекКонтрагент
	|ГДЕ
	|	ЗаданиеНаДоставкуДоставкаПоказная.Деньги
	|	И ЗаданиеНаДоставкуДоставкаПоказная.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И ЗаданиеНаДоставкуДоставкаПоказная.Ссылка.Проведен
	|	И ЗаданиеНаДоставкуДоставкаПоказная.Ссылка.Водитель = &ТекущийВодитель
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаданиеНаДоставкуДоставкаПоказная.Ссылка,
	|	ЗаданиеНаДоставкуДоставкаПоказная.Контрагент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА РеализацияТоваровУслуг.ДоговорКонтрагента.БизнесКарта
	|					ИЛИ РеализацияТоваровУслуг.ДоговорКонтрагента.РозничнаяПродажа
	|					ИЛИ РеализацияТоваровУслуг.ДоговорКонтрагента.ЛицевойСчет
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЕСТЬNULL(РеализацияТоваровУслуг.ДоговорКонтрагента.ОплатаПоДоговоруНаличными, ЛОЖЬ)
	|		КОНЕЦ) КАК ОплатаНаличными,
	|	ЗаданияНаДоставку.Реализация
	|ПОМЕСТИТЬ ОплатыНаличными
	|ИЗ
	|	ЗаданияНаДоставку КАК ЗаданияНаДоставку
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|		ПО ЗаданияНаДоставку.Реализация = РеализацияТоваровУслуг.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаданияНаДоставку.Реализация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаданияНаДоставку.ЗаданиеНаДоставку,
	|	ЗаданияНаДоставку.Контрагент,
	|	РеализацияТоваровУслугТовары.Ссылка КАК Реализация,
	|	РеализацияТоваровУслугТовары.Ссылка.Номер КАК НомерНакладной,
	|	РеализацияТоваровУслугТовары.НомерСтроки КАК НомерСтрокиСч,
	|	РеализацияТоваровУслугТовары.Номенклатура,
	|	РеализацияТоваровУслугТовары.Количество,
	|	РеализацияТоваровУслугТовары.Сумма,
	|	ВЫБОР
	|		КОГДА СторонниеСкладыИдентификаторы.Ссылка ЕСТЬ NULL
	|			ТОГДА ВЫБОР
	|					КОГДА СторонниеСкладыIDСклада.Ссылка ЕСТЬ NULL
	|						ТОГДА ЛОЖЬ
	|					ИНАЧЕ ИСТИНА
	|				КОНЕЦ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЭтоСтороннийСклад,
	|	РеализацияТоваровУслугТовары.Цена
	|ПОМЕСТИТЬ Товары
	|ИЗ
	|	ЗаданияНаДоставку КАК ЗаданияНаДоставку
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СторонниеСклады КАК СторонниеСкладыИдентификаторы
	|			ПО РеализацияТоваровУслугТовары.ЗаказПокупателя.IDСклада = СторонниеСкладыИдентификаторы.Идентификатор
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СторонниеСклады КАК СторонниеСкладыIDСклада
	|			ПО РеализацияТоваровУслугТовары.ЗаказПокупателя.IDСклада = СторонниеСкладыIDСклада.IDСклада
	|		ПО ЗаданияНаДоставку.Реализация = РеализацияТоваровУслугТовары.Ссылка
	|ГДЕ
	|	НЕ РеализацияТоваровУслугТовары.Ссылка ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаданияНаДоставку.Реализация КАК Реализация,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ЕСТЬNULL(ОчередьПечатиККМ.ТекРеализация, ЛОЖЬ) <> ЛОЖЬ
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ) КАК ЕстьОплата
	|ПОМЕСТИТЬ Оплаты
	|ИЗ
	|	ЗаданияНаДоставку КАК ЗаданияНаДоставку
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОчередьПечатиККМ КАК ОчередьПечатиККМ
	|		ПО ЗаданияНаДоставку.ЗаданиеНаДоставку = ОчередьПечатиККМ.ТекЗадание
	|			И ЗаданияНаДоставку.Контрагент = ОчередьПечатиККМ.ТекКонтрагент
	|			И ЗаданияНаДоставку.Реализация = ОчередьПечатиККМ.ТекРеализация
	|ГДЕ
	|	НЕ ОчередьПечатиККМ.Деньги
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаданияНаДоставку.Реализация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РеализацияТоваровУслугДокументыСборкиЗаказов.ДокументСборки,
	|	РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка КАК Реализация
	|ПОМЕСТИТЬ Сборки
	|ИЗ
