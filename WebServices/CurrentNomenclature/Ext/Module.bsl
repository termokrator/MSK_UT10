
Функция GetCurrentNomenclature()
	
	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис CurrentNomenclature", УровеньЖурналаРегистрации.Информация,,,"Веб-сервис:Запуск. GetCurrentNomenclature");
	
	Результат = ПолучитьСписокНоменклатуры();
	
	ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис CurrentNomenclature", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. GetCurrentNomenclature " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
		
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСписокНоменклатуры()
	
	СписокНоменклатуры = "";
	
	ЗапросТоваров = Новый Запрос;
	ЗапросТоваров.Текст =
	"ВЫБРАТЬ
	|	Константы.ВидНоменклатурыПоУмолчанию КАК ВидНоменклатурыТовар
	|ПОМЕСТИТЬ КонстантаНоменклатурыТовар
	|ИЗ
	|	Константы КАК Константы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТоварыНаСкладахОстатки.Номенклатура.КодМДМ КАК НоменклатураКодМДМ
	|ПОМЕСТИТЬ ТаблОстатков
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(
	|			,
	|			Номенклатура.ВидНоменклатуры В
	|					(ВЫБРАТЬ
	|						КонстантаНоменклатурыТовар.ВидНоменклатурыТовар
	|					ИЗ
	|						КонстантаНоменклатурыТовар)
	|				И НЕ Номенклатура.КодМДМ = """") КАК ТоварыНаСкладахОстатки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаказыПоставщикамОстатки.Номенклатура.КодМДМ 
	|ИЗ
	|	РегистрНакопления.ЗаказыПоставщикам.Остатки(
	|			,
	|			Номенклатура.ВидНоменклатуры В
	|					(ВЫБРАТЬ
	|						КонстантаНоменклатурыТовар.ВидНоменклатурыТовар
	|					ИЗ
	|						КонстантаНоменклатурыТовар)
	|				И НЕ Номенклатура.КодМДМ = """"
	|				И ЗаказПоставщику.IDСклада = ЗНАЧЕНИЕ(Справочник.СторонниеСклады.ПустаяСсылка)) КАК ЗаказыПоставщикамОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблОстатков.НоменклатураКодМДМ
	|ИЗ
	|	ТаблОстатков КАК ТаблОстатков";

	РезультатЗапросаТоваров = ЗапросТоваров.Выполнить();
	
	Если НЕ РезультатЗапросаТоваров.Пустой() Тогда
		
		ВыборкаТоваров = РезультатЗапросаТоваров.Выбрать();
		
		Запись = Новый ЗаписьXML;
		Запись.УстановитьСтроку(); 
		
		Пока ВыборкаТоваров.Следующий() Цикл
			
			Запись.ЗаписатьБезОбработки(СокрЛП(ВыборкаТоваров.НоменклатураКодМДМ) + ";");
			
		КонецЦикла;		 
		
		СписокНоменклатуры = Запись.Закрыть();	

	КонецЕсли; 

	Возврат СписокНоменклатуры;
	
КонецФункции
