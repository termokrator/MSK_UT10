			СтрЗапроса.ВидПроцесса = Строка(СтрЗапроса.Ссылка.ВидПроцесса);
			//-Шульман А. 16.12.2024 #UT10-4995   
			
			//+Кабанов А.В. 23.06.2025 # UT10-5295
			СтрЗапроса.ВозвратПоставщикуБезРазбораВГП = мВозвратПоставщикуБезРазбораВГП;   
			//-Кабанов А.В. 23.06.2025 # UT10-5295
			
			Продолжить;
			
		КонецЕсли;
		
		ЦенаПоСтроке = СтрЗапроса.Сумма / СтрЗапроса.Количество;
		НДСПоСтроке = СтрЗапроса.СуммаНДС / СтрЗапроса.Количество;
		КоличествоОсталосьПогасить = СтрЗапроса.Количество;  
		
		НайденнаяСтрока = МассивНайденных.Получить(0);
		
		КоличествоКПогашению = Мин(КоличествоОсталосьПогасить, НайденнаяСтрока.Количество);   
		НайденнаяСтрока.Количество = НайденнаяСтрока.Количество - КоличествоКПогашению; 
		СтрЗапроса.Количество = КоличествоКПогашению; 
		СтрЗапроса.ГМ = НайденнаяСтрока.ГМ;
		СтрЗапроса.Сумма = ЦенаПоСтроке * СтрЗапроса.Количество;  
		СтрЗапроса.СуммаНДС = НДСПоСтроке * СтрЗапроса.Количество;
		КоличествоОсталосьПогасить = КоличествоОсталосьПогасить - КоличествоКПогашению; 
		
		Если КоличествоОсталосьПогасить <= 0 Тогда  
			
			ДополнитьСтрЗапроса(СтрЗапроса, ЭтоБазаНН, НомерСФКакНаПечать, НомерДокумента, СчетФактура, МассивТЕ);    
			
			//+Шульман А. 16.12.2024 #UT10-4995   
			СтрЗапроса.КодМДМФилиала = Константы.КодКонтрагентаВстороннейУТ10Пополнение.Получить();   
			СтрЗапроса.ВидПроцесса = Строка(СтрЗапроса.Ссылка.ВидПроцесса);
			//-Шульман А. 16.12.2024 #UT10-4995   
			
			//+Кабанов А.В. 23.06.2025 # UT10-5295
			СтрЗапроса.ВозвратПоставщикуБезРазбораВГП = мВозвратПоставщикуБезРазбораВГП;   
			//-Кабанов А.В. 23.06.2025 # UT10-5295
			
			Продолжить;
			
		КонецЕсли;   
		
		сч = 0;
		
		Пока сч < МассивНайденных.Количество() Цикл  
			
			Если КоличествоОсталосьПогасить <= 0 Тогда
				Прервать;
			КонецЕсли;
			
			НайденнаяСтрока = МассивНайденных.Получить(сч);
			
			Если НайденнаяСтрока.Количество <= 0 Тогда  
				
				МассивНайденных.Удалить(сч);  
				Продолжить;
				
			КонецЕсли;  
			
			НовСтрока = ТаблЗапроса.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока, СтрЗапроса,, "Сумма, СуммаНДС, ГМ");
			НовСтрока.Добавлена = Истина;
			
			КоличествоКПогашению = Мин(КоличествоОсталосьПогасить, НайденнаяСтрока.Количество);
			НайденнаяСтрока.Количество = НайденнаяСтрока.Количество - КоличествоКПогашению;
			
			НовСтрока.Количество = КоличествоКПогашению;   
