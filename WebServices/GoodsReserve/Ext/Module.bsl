			НовСтрока.СуммаНДС = НДСПоСтроке * НовСтрока.Количество;
			
			КоличествоОсталосьПогасить = КоличествоОсталосьПогасить - КоличествоКПогашению;
			
			сч = сч + 1;  
			
			ДополнитьСтрЗапроса(НовСтрока, ЭтоБазаНН, НомерСФКакНаПечать, НомерДокумента, СчетФактура, МассивТЕ);
			
