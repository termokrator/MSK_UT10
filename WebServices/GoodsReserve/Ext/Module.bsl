КонецФункции

Процедура ДополнитьСтрЗапроса(СтрЗапроса, ЭтоБазаНН, НомерСФКакНаПечать, НомерДокумента, СчетФактура, МассивТЕ)  
	
	Если НомерДокумента <> СтрЗапроса.НомерДокумента Тогда
		
		НомерДокумента = СтрЗапроса.НомерДокумента;			
		СчетФактура = УчетНДС.НайтиПодчиненныйДокумент(СтрЗапроса.Ссылка, "СчетФактураВыданный");
		
	КонецЕсли;   
	
	//+Белов А. 11.01.2025 #UT10-5006
	СтрЗапроса.МассивТЕ = МассивТЕ;	
	//-Белов А. 11.01.2025 #UT10-5006
	
	Если ЗначениеЗаполнено(СтрЗапроса.Назначение) Тогда
		
		НазначениеСтруктура = Новый Структура;
		НазначениеСтруктура.Вставить("Код", "");
		НазначениеСтруктура.Вставить("Наименование", "");
		НазначениеСтруктура.Вставить("НомерЗаказа", ""); 
		НазначениеСтруктура.Вставить("ДатаЗаказа", "");
		НазначениеСтруктура.Вставить("Маршрут", "");
		НазначениеСтруктура.Вставить("Грузополучатель", "");
		НазначениеСтруктура.Вставить("ГрузополучательКодМДМ", "");
		НазначениеСтруктура.Вставить("ГрузополучательКод", "");
		НазначениеСтруктура.Вставить("БазаОтправитель", "");
		
		ЗаполнитьЗначенияСвойств(НазначениеСтруктура, СтрЗапроса.Назначение);
		
		СтрЗапроса.НазначениеСтруктура = НазначениеСтруктура;
		
	КонецЕсли;      
	
	Если ЗначениеЗаполнено(СтрЗапроса.ГМ) Тогда
		
		ГМСтруктура = Новый Структура();
		ГМСтруктура.Вставить("Дата", "");
		ГМСтруктура.Вставить("Номер", ""); 
		
		ЗаполнитьЗначенияСвойств(ГМСтруктура, СтрЗапроса.ГМ); 
		
		Если ЗначениеЗаполнено(СтрЗапроса.ГМ.ДатаПечатиШтрихкода) Тогда
			ГМСтруктура.Дата = СтрЗапроса.ГМ.ДатаПечатиШтрихкода;	
		КонецЕсли;
		
		СтрЗапроса.ГМСтруктура = ГМСтруктура;			
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СчетФактура) Тогда
		
		Если ЭтоБазаНН Или НомерСФКакНаПечать Тогда
			
			СтрЗапроса.СФНомер = ОбщегоНазначения.ПолучитьНомерНаПечать(СчетФактура); 
			
			Если НомерСФКакНаПечать Тогда
				СтрЗапроса.НомерДокумента = СтрЗапроса.СФНомер; 
			КонецЕсли;  
			
		Иначе
			СтрЗапроса.СФНомер = СчетФактура.Номер;
		КонецЕсли;
		
		СтрЗапроса.СФДата = Строка(СчетФактура.Дата);
		
	Иначе
		
		СтрЗапроса.СФНомер = "";
		СтрЗапроса.СФДата = Строка('00010101');
		
	КонецЕсли;
	
	СтрЗапроса.ИДДокументаВСмежнойБазе = СокрЛП(СтрЗапроса.Ссылка.УникальныйИдентификатор());
	
	Если ЗначениеЗаполнено(СтрЗапроса.ЗаказПокупателя.ДатаВходящегоДокументаЭлектронногоОбмена) 
		И ЗначениеЗаполнено(СтрЗапроса.ЗаказПокупателя.НомерВходящегоДокументаЭлектронногоОбмена) Тогда
		СтрЗапроса.Комментарий = Формат(СтрЗапроса.ЗаказПокупателя.ДатаВходящегоДокументаЭлектронногоОбмена, "ДФ=dd.MM.yyyy") + "/"
		+ СокрЛП(СтрЗапроса.ЗаказПокупателя.НомерВходящегоДокументаЭлектронногоОбмена);
	Иначе			
		
		Если ЭтоБазаНН Тогда
			
			Если ЗначениеЗаполнено(СтрЗапроса.СФНомер) Тогда
				СтрЗапроса.НомерДокумента = СтрЗапроса.СФНомер; 
			КонецЕсли; 		
			
		КонецЕсли;
		
	КонецЕсли;
	
	СтрЗапроса.ДоговорПоставщикаТОХКодМДМ = СокрЛП(СтрЗапроса.Ссылка.ДоговорПоставщикаТОХ.КодМДМ);
	
КонецПроцедуры

Функция ПолучитьКодыМаркировкиДляВыгрузкиМассив(мДокументыДляВыборки, ФиксироватьДокумент = Ложь) Экспорт
	
	//+Макрушин Е. 06.11.2025 #UT10-5491
	КодыМаркировкиМассив = Новый Массив;
	
	Если ТипЗнч(мДокументыДляВыборки) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда

		мДокументы = Новый Массив;
		мДокументы.Добавить(мДокументыДляВыборки);
		
	ИначеЕсли ТипЗнч(мДокументыДляВыборки) = Тип("Массив") Тогда
		мДокументы = мДокументыДляВыборки;
	Иначе
		Возврат КодыМаркировкиМассив;
	КонецЕсли;
	
	Запрос = Новый Запрос;     
	//Марков И. 06.04.2026 #UT10-5805
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РеализацияТоваровУслугКодыМаркировки.Ссылка КАК Документ,
	|	РеализацияТоваровУслугКодыМаркировки.КодМаркировки.Номенклатура.КодМДМ КАК КодМДМНоменклатуры,
	|	РеализацияТоваровУслугКодыМаркировки.КодМаркировки.КодМаркировки КАК КодМаркировки,
	|	РеализацияТоваровУслугКодыМаркировки.КодМаркировки.ДатаПроизводства КАК ДатаПроизводства,
	|	РеализацияТоваровУслугКодыМаркировки.КодМаркировки.СрокГодности КАК СрокГодности,
	|	РеализацияТоваровУслугКодыМаркировки.КодМаркировки.ТипПоступления КАК ТипПоступления,
	|	РеализацияТоваровУслугКодыМаркировки.КодМаркировки.ТипУпаковки КАК ТипУпаковки,
	|	РеализацияТоваровУслугКодыМаркировки.КодМаркировки КАК СсылкаКодМаркировки
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.КодыМаркировки КАК РеализацияТоваровУслугКодыМаркировки
	|ГДЕ
	|	РеализацияТоваровУслугКодыМаркировки.Ссылка В(&мДокументы)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Документ,
	|	РеализацияТоваровУслугКодыМаркировки.НомерСтроки
	|АВТОУПОРЯДОЧИВАНИЕ";	
	
	
	Запрос.УстановитьПараметр("мДокументы", мДокументы);
	Выборка = Запрос.Выполнить().Выбрать();    
	
	Пока Выборка.Следующий() Цикл
		                                                             
		КодыМаркировкиСтруктура = Новый Структура;
		                                       
		КодыМаркировкиСтруктура.Вставить("КодМДМНоменклатуры", ?(ЗначениеЗаполнено(Выборка.КодМДМНоменклатуры), Выборка.КодМДМНоменклатуры, ""));
		КодыМаркировкиСтруктура.Вставить("КодМаркировки", ?(ЗначениеЗаполнено(Выборка.КодМаркировки), Выборка.КодМаркировки, ""));
		КодыМаркировкиСтруктура.Вставить("ДатаПроизводства", ?(ЗначениеЗаполнено(Выборка.ДатаПроизводства), Формат(Выборка.ДатаПроизводства, "ДФ=dd.MM.yyyy"), ""));
		КодыМаркировкиСтруктура.Вставить("СрокГодности", ?(ЗначениеЗаполнено(Выборка.СрокГодности), Формат(Выборка.СрокГодности, "ДФ=dd.MM.yyyy"), ""));
		КодыМаркировкиСтруктура.Вставить("ТипПоступления", ?(ЗначениеЗаполнено(Выборка.ТипПоступления), Выборка.ТипПоступления, 0));
		КодыМаркировкиСтруктура.Вставить("ТипУпаковки", ?(ЗначениеЗаполнено(Выборка.ТипУпаковки), ОбщегоНазначения.ИмяЗначенияПеречисления(Выборка.ТипУпаковки), ""));
		//+Марков И. 06.04.2026 #UT10-5805
		ПолныйКодМаркировки = Выборка.СсылкаКодМаркировки.ПолныйКодМаркировки.Получить();
		КодыМаркировкиСтруктура.Вставить("ПолныйКодМаркировки", ?(ЗначениеЗаполнено(ПолныйКодМаркировки), СтрЗаменить(ПолныйКодМаркировки , Символ(29) , "<GS>"), ""));
		//-Марков И. 06.04.2026 #UT10-5805
		
		Если ФиксироватьДокумент Тогда
			КодыМаркировкиСтруктура.Вставить("ИДДокумента", "" + Выборка.Документ.УникальныйИдентификатор());
		КонецЕсли;
		
		КодыМаркировкиМассив.Добавить(КодыМаркировкиСтруктура);   		
		
	КонецЦикла;                 
	
	Возврат КодыМаркировкиМассив;	
	//-Макрушин Е. 06.11.2025 #UT10-5491
	
КонецФункции

Функция ПолучитьВозвратПоставщикуБезРазбораВГП(ПромСсылка)
	//+Кабанов А.В. 23.06.2025 # UT10-5295
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МАКСИМУМ(ЕСТЬNULL(РеализацияТоваровУслугТовары.ЗаказПокупателя.ВозвратПоставщикуБезРазбораВГП, ЛОЖЬ)) КАК ВозвратПоставщикуБезРазбораВГП
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|ГДЕ
	|	РеализацияТоваровУслугТовары.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка" , ПромСсылка);
		
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если НЕ РезультатЗапроса.Количество() = 0 Тогда			
		Возврат РезультатЗапроса[0].ВозвратПоставщикуБезРазбораВГП; 
	Иначе
		Возврат Ложь;
	КонецЕсли;	
	//+Кабанов А.В. 23.06.2025 # UT10-5295
КонецФункции

Функция ПолучитьОстаткиДляОбособленногоПодразделения()
	
	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис GoodsReserve", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Запуск. GetRemainsDetachedDivision");
	
	СтруктураДанных = Новый Структура; 	
	ТЗОстатков = ПолучитьОстаткиПоСкладу();	
	СтруктураДанных.Вставить("СписокДанных", ТаблицуВМассив(ТЗОстатков));
	
	РезультатВыполнения = ДанныеВJSONХранилище(СтруктураДанных); 
	ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ЗаписьЖурналаРегистрации("Web-сервис GoodsReserve", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. GetRemainsDetachedDivision " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
	
	Возврат РезультатВыполнения;
	
КонецФункции

Функция ПолучитьОстаткиПоСкладу()
	
	ЗапросСвободныхОстатков = Новый Запрос;
	ЗапросСвободныхОстатков.Текст =
	"ВЫБРАТЬ
	|	ТоварыВРезервеНаСкладахОстатки.Номенклатура КАК Номенклатура,
	|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва КАК ЗаказПокупателя
	|ПОМЕСТИТЬ ТоварыВРезерке
	|ИЗ
	|	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(
	|			,
	|			Склад = &Склад
	|				И ДокументРезерва ССЫЛКА Документ.ЗаказПокупателя) КАК ТоварыВРезервеНаСкладахОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва,
	|	ТоварыВРезервеНаСкладахОстатки.Номенклатура
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыНаСкладахОстатки.КоличествоОстаток - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0) КАК СвободныйОстатокСклад,
	|	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ НеНулевыеСвободныеОстаткиСклад
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(, Склад = &Склад) КАК ТоварыНаСкладахОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(, Склад = &Склад) КАК ТоварыВРезервеНаСкладахОстатки
	|		ПО ТоварыНаСкладахОстатки.Номенклатура = ТоварыВРезервеНаСкладахОстатки.Номенклатура
	|ГДЕ
	|	ТоварыНаСкладахОстатки.КоличествоОстаток - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0) >= 0
	|	И ТоварыНаСкладахОстатки.Номенклатура.Родитель.НеПоказыватьНаПортале = ЛОЖЬ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НеНулевыеСвободныеОстаткиСклад.СвободныйОстатокСклад,
	|	НеНулевыеСвободныеОстаткиСклад.Номенклатура КАК Номенклатура,
	|	ТоварыВЯчейкахОстатки.КоличествоОстаток - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0) + ЕСТЬNULL(ТоварыВСборкеОстатки.СобраноОстаток, 0) + ЕСТЬNULL(ТоварыВСборкеОстатки.КСборкеОстаток, 0) КАК СвободныйОстатокЯчейки,
	|	ВЫБОР
	|		КОГДА НеНулевыеСвободныеОстаткиСклад.СвободныйОстатокСклад <= ТоварыВЯчейкахОстатки.КоличествоОстаток - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0) + ЕСТЬNULL(ТоварыВСборкеОстатки.СобраноОстаток, 0) + ЕСТЬNULL(ТоварыВСборкеОстатки.КСборкеОстаток, 0)
	|			ТОГДА НеНулевыеСвободныеОстаткиСклад.СвободныйОстатокСклад
	|		ИНАЧЕ ТоварыВЯчейкахОстатки.КоличествоОстаток - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0) + ЕСТЬNULL(ТоварыВСборкеОстатки.СобраноОстаток, 0) + ЕСТЬNULL(ТоварыВСборкеОстатки.КСборкеОстаток, 0)
	|	КОНЕЦ КАК СвободныйОстаток
	|ПОМЕСТИТЬ НеНулевыеСвободныеОстатки
	|ИЗ
	|	НеНулевыеСвободныеОстаткиСклад КАК НеНулевыеСвободныеОстаткиСклад
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках.Остатки(
	|				,
	|				Склад = &Склад
	|					И Ячейка.НеУчитыватьВОперативномУчете = ЛОЖЬ) КАК ТоварыВЯчейкахОстатки
	|		ПО НеНулевыеСвободныеОстаткиСклад.Номенклатура = ТоварыВЯчейкахОстатки.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(, Склад = &Склад) КАК ТоварыВРезервеНаСкладахОстатки
	|		ПО (ТоварыВЯчейкахОстатки.Номенклатура = ТоварыВРезервеНаСкладахОстатки.Номенклатура)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВСборке.Остатки(
	|				,
	|				(ЗаказПокупателя, Номенклатура) В
	|					(ВЫБРАТЬ
	|						ТоварыВРезерке.ЗаказПокупателя КАК ЗаказПокупателя,
	|						ТоварыВРезерке.Номенклатура
	|					ИЗ
	|						ТоварыВРезерке КАК ТоварыВРезерке)) КАК ТоварыВСборкеОстатки
	|		ПО (ТоварыВЯчейкахОстатки.Номенклатура = ТоварыВСборкеОстатки.Номенклатура)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыОтветственногоХраненияОстатки.Номенклатура,
	|	ТоварыОтветственногоХраненияОстатки.КоличествоОстаток - ЕСТЬNULL(ТоварыВРезервеТОХОстатки.КоличествоОстаток, 0) - ЕСТЬNULL(ТоварыОтветственногоХраненияПереданныеОстатки.КоличествоОстаток, 0) КАК ОстатокТОХ
	|ПОМЕСТИТЬ НеНулевыеОстаткиТОХ
	|ИЗ
	|	РегистрНакопления.ТоварыОтветственногоХранения.Остатки КАК ТоварыОтветственногоХраненияОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеТОХ.Остатки КАК ТоварыВРезервеТОХОстатки
	|		ПО ТоварыОтветственногоХраненияОстатки.Номенклатура = ТоварыВРезервеТОХОстатки.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыОтветственногоХраненияПереданные.Остатки КАК ТоварыОтветственногоХраненияПереданныеОстатки
	|		ПО ТоварыОтветственногоХраненияОстатки.Номенклатура = ТоварыОтветственногоХраненияПереданныеОстатки.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Таб.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ОборотСегодня
	|ИЗ
	|	(ВЫБРАТЬ
	|		ТоварыНаСкладахОбороты.Номенклатура КАК Номенклатура
	|	ИЗ
	|		РегистрНакопления.ТоварыНаСкладах.Обороты(
	|				&НачалоСегодняшнегоДня,
	|				,
	|				,
	|				Склад = &Склад
	|					И НЕ Номенклатура В
	|							(ВЫБРАТЬ
	|								НеНулевыеСвободныеОстатки.Номенклатура
	|							ИЗ
	|								НеНулевыеСвободныеОстатки КАК НеНулевыеСвободныеОстатки)) КАК ТоварыНаСкладахОбороты
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ РАЗЛИЧНЫЕ
	|		ТоварыВРезервеНаСкладахОбороты.Номенклатура
	|	ИЗ
	|		РегистрНакопления.ТоварыВРезервеНаСкладах.Обороты(
	|				&НачалоСегодняшнегоДня,
	|				,
	|				,
	|				Склад = &Склад
	|					И НЕ Номенклатура В
	|							(ВЫБРАТЬ
	|								НеНулевыеСвободныеОстатки.Номенклатура
	|							ИЗ
	|								НеНулевыеСвободныеОстатки КАК НеНулевыеСвободныеОстатки)) КАК ТоварыВРезервеНаСкладахОбороты) КАК Таб
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СправочникНоменклатура.Ссылка КАК Номенклатура,
	|	СУММА(Т.СвободныйОстаток) КАК СвободныйОстаток,
	|	СУММА(Т.СвободныйОстатокТОХ) КАК СвободныйОстатокТОХ,
	|	СправочникНоменклатура.Артикул,
	|	СправочникНоменклатура.КодМДМ
	|ПОМЕСТИТЬ НоменклатураКВыгрузке
	|ИЗ
	|	Справочник.Номенклатура КАК СправочникНоменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			НеНулевыеСвободныеОстатки.Номенклатура КАК Номенклатура,
	|			НеНулевыеСвободныеОстатки.СвободныйОстаток КАК СвободныйОстаток,
	|			0 КАК СвободныйОстатокТОХ
	|		ИЗ
	|			НеНулевыеСвободныеОстатки КАК НеНулевыеСвободныеОстатки
	|		
	|		ОБЪЕДИНИТЬ ВСЕ
	|		
	|		ВЫБРАТЬ
	|			ОборотСегодня.Номенклатура,
	|			0,
	|			0
	|		ИЗ
	|			ОборотСегодня КАК ОборотСегодня
	|		
	|		ОБЪЕДИНИТЬ ВСЕ
	|		
	|		ВЫБРАТЬ
	|			НеНулевыеОстаткиТОХ.Номенклатура,
	|			0,
	|			НеНулевыеОстаткиТОХ.ОстатокТОХ
	|		ИЗ
	|			НеНулевыеОстаткиТОХ КАК НеНулевыеОстаткиТОХ
	|		ГДЕ
	|			НеНулевыеОстаткиТОХ.ОстатокТОХ > 0) КАК Т
	|		ПО (Т.Номенклатура = СправочникНоменклатура.Ссылка)
	|ГДЕ
	|	НЕ СправочникНоменклатура.ЭтоГруппа
	|	И НЕ СправочникНоменклатура.Артикул = """"
	|
	|СГРУППИРОВАТЬ ПО
	|	СправочникНоменклатура.Ссылка,
	|	СправочникНоменклатура.Артикул,
	|	СправочникНоменклатура.КодМДМ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НоменклатураКВыгрузке.Артикул КАК Артикул,
	|	НоменклатураКВыгрузке.КодМДМ,
	|	ЕСТЬNULL(НоменклатураКВыгрузке.СвободныйОстаток, 0) КАК СвободныйОстаток,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(НоменклатураКВыгрузке.СвободныйОстатокТОХ, 0) > ЕСТЬNULL(НоменклатураКВыгрузке.СвободныйОстаток, 0)
	|			ТОГДА ЕСТЬNULL(НоменклатураКВыгрузке.СвободныйОстаток, 0)
	|		ИНАЧЕ ЕСТЬNULL(НоменклатураКВыгрузке.СвободныйОстатокТОХ, 0)
	|	КОНЕЦ КАК СвободныйОстатокТОХ
	|ИЗ
	|	НоменклатураКВыгрузке КАК НоменклатураКВыгрузке
	|ГДЕ
	|	(ЕСТЬNULL(НоменклатураКВыгрузке.СвободныйОстаток, 0) > 0
	|			ИЛИ ВЫБОР
	|				КОГДА ЕСТЬNULL(НоменклатураКВыгрузке.СвободныйОстатокТОХ, 0) > ЕСТЬNULL(НоменклатураКВыгрузке.СвободныйОстаток, 0)
	|					ТОГДА ЕСТЬNULL(НоменклатураКВыгрузке.СвободныйОстаток, 0)
	|				ИНАЧЕ ЕСТЬNULL(НоменклатураКВыгрузке.СвободныйОстатокТОХ, 0)
	|			КОНЕЦ > 0)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Артикул";
	
	ЗапросСвободныхОстатков.УстановитьПараметр("Склад", Константы.ОсновнойСклад.Получить());
	ЗапросСвободныхОстатков.УстановитьПараметр("НачалоСегодняшнегоДня", НачалоДня(ТекущаяДата()));
	
	РезультатЗапросаСвободныхОстатков = ЗапросСвободныхОстатков.Выполнить().Выгрузить();
	
	Возврат РезультатЗапросаСвободныхОстатков;  
	
КонецФункции



