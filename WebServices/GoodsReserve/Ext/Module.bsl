	//ИЛИ (ТекБаза = Перечисления.НазваниеБазы.ЮГ)
	//ИЛИ (ТекБаза = Перечисления.НазваниеБазы.Молодогвардейская)
	//ИЛИ (ТекБаза = Перечисления.НазваниеБазы.Север)
	//ИЛИ (ТекБаза = Перечисления.НазваниеБазы.Тверь)
