Функция ЗаполнитьУИДвСтрокахЗаказа(Параметры , ГУИДЗаказаПокупателя)
	
	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис GoodsReserve", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Запуск. ЗаполнитьУИДвСтрокахЗаказа");
	
	ПараметрыСтруктура = ХранилищеJSONВСтруктуру(Параметры);
	ТЗНоменклатуры = ПараметрыСтруктура.ТЗНоменклатуры;	
	
	ДокЗаказСсылка = Документы.ЗаказПокупателя.ПолучитьСсылку(Новый УникальныйИдентификатор(ГУИДЗаказаПокупателя));
	ДокОбъект = ДокЗаказСсылка.ПолучитьОбъект();
	
	Для Каждого Стр Из ТЗНоменклатуры Цикл
		
		Товар = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", Стр.Артикул); //НормализованныйКод
		Отбор = Новый Структура("Номенклатура", Товар);
		Отбор.Вставить("Комментарий", Стр.УИД);
		Рез = ДокОбъект.Товары.НайтиСтроки(Отбор);
		
		Для Каждого СтрРез Из Рез Цикл
			СтрРез.Комментарий = Стр.Комментарий; 
		КонецЦикла;
		
	КонецЦикла;
	
	Попытка
		
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		РезультатВыполнения = Истина;
		
	Исключение
		
		ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		ДокОбъект.УстановитьПометкуУдаления(Истина);
		РезультатВыполнения = Ложь;
		
	КонецПопытки;
	
	ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис GoodsReserve", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. ЗаполнитьУИДвСтрокахЗаказа " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
	
	Возврат РезультатВыполнения;
	
КонецФункции

Функция ПолучитьРеализации(КодКонтрагента)
	
	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис GoodsReserve", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Запуск. ПолучитьРеализации");
	
	СтруктураДанных = Новый Структура;
	
	ТЗРеализация = ПолучитьРеализацииПоКонтрагенту(КодКонтрагента);
	
	СтруктураДанных.Вставить("СписокДанных", ТаблицуВМассив(ТЗРеализация));
	
	РезультатВыполнения = ДанныеВJSONХранилище(СтруктураДанных);
	
	ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис GoodsReserve", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. ПолучитьРеализации " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
	
	Возврат РезультатВыполнения;
	
КонецФункции

Функция ЗарезервироватьТовары(Параметры , КодКонтрагента)
	
	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис GoodsReserve", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Запуск. ЗарезервироватьТовары");
	
	ПараметрыСтруктура = ХранилищеJSONВСтруктуру(Параметры);
	ТЗНоменклатуры = ПараметрыСтруктура.ТЗНоменклатуры;
	
	КодМДМдоговора = ?(ПараметрыСтруктура.Свойство("КодМДМдоговора"), ПараметрыСтруктура.КодМДМдоговора, "");
	КодСоглашения = ?(ПараметрыСтруктура.Свойство("КодСоглашения"), ПараметрыСтруктура.КодСоглашения, "");
	
	СтруктураДанных = Новый Структура;
	
	ТЗРезерв = РезервированиеТоваров(ТЗНоменклатуры, КодКонтрагента,КодМДМдоговора, КодСоглашения);
	
	СтруктураДанных.Вставить("СписокДанных", ТаблицуВМассив(ТЗРезерв));
	
	РезультатВыполнения = ДанныеВJSONХранилище(СтруктураДанных);
	
	ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();    
	
	ЗаписьЖурналаРегистрации("Web-сервис GoodsReserve", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. ЗарезервироватьТовары " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
	
	Возврат РезультатВыполнения;
	
КонецФункции

Функция ПолучитьСтатусыЗаказов(ДатаНТ, ДатаКТ, КодКонтрагента, ВидОперации)
	
	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис GoodsReserve", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Запуск. ПолучитьСтатусыЗаказов");
	
	СтруктураДанных = Новый Структура;
	
	ФилиалКонтрагента = МСКWEB.НайтиФилиалПоКодуИзПортала(СокрЛП(КодКонтрагента));
	
	Запрос = Новый Запрос();
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ЗаказыПокупателей.ЗаказПокупателя,
	|	ЗаказыПокупателей.Номенклатура,
	|	ЗаказыПокупателей.Назначение,
	|	СУММА(ЗаказыПокупателей.Количество) КАК Заказано
	|ПОМЕСТИТЬ ТаблицаЗаказов
	|ИЗ
	|	РегистрНакопления.ЗаказыПокупателей КАК ЗаказыПокупателей
	|ГДЕ
	|	ЗаказыПокупателей.Период МЕЖДУ &НачПериода И &КонПериода
	|	И ЗаказыПокупателей.Регистратор ССЫЛКА Документ.ЗаказПокупателя
	|	И ЗаказыПокупателей.Регистратор.Грузополучатель = &Грузополучатель
	|	И ЗаказыПокупателей.Регистратор.КроссДокинг = ЛОЖЬ
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказыПокупателей.ЗаказПокупателя,
	|	ЗаказыПокупателей.Номенклатура,
	|	ЗаказыПокупателей.Назначение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаЗаказов.ЗаказПокупателя,
	|	ТаблицаЗаказов.Номенклатура,
	|	ТаблицаЗаказов.Назначение,
	|	МАКСИМУМ(ТаблицаЗаказов.Заказано) КАК Заказано,
	|	СУММА(ТоварыВСборкеОстатки.КСборкеОстаток) КАК КСборке,
	|	СУММА(ТоварыВСборкеОстатки.СобраноОстаток) КАК Собрано,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ТоварыВСборкеОстатки.Сборка.ДокументСобранИУпакован
	|					И ТоварыВСборкеОстатки.СобраноОстаток > 0
	|				ТОГДА ТоварыВСборкеОстатки.Сборка.ВремяОкончанияСборки
	|			ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
	|		КОНЕЦ) КАК ДатаОтгрузки
	|ПОМЕСТИТЬ ТоварыВСборке
	|ИЗ
	|	ТаблицаЗаказов КАК ТаблицаЗаказов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВСборке.Остатки(&КонПериода, ) КАК ТоварыВСборкеОстатки
	|		ПО ТаблицаЗаказов.ЗаказПокупателя = ТоварыВСборкеОстатки.ЗаказПокупателя
	|			И ТаблицаЗаказов.Номенклатура = ТоварыВСборкеОстатки.Номенклатура
	|			И ТаблицаЗаказов.Назначение = ТоварыВСборкеОстатки.Назначение
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаЗаказов.ЗаказПокупателя,
	|	ТаблицаЗаказов.Номенклатура,
	|	ТаблицаЗаказов.Назначение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыВСборке.ЗаказПокупателя,
	|	ТоварыВСборке.Номенклатура,
	|	ТоварыВСборке.Назначение,
	|	МАКСИМУМ(ТоварыВСборке.Заказано) КАК Заказано,
	|	МАКСИМУМ(ТоварыВСборке.КСборке) КАК КСборке,
	|	МАКСИМУМ(ТоварыВСборке.Собрано) КАК Собрано,
	|	СУММА(ЗаказыПокупателей.Количество) КАК Реализовано,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ЗаказыПокупателей.Количество > 0
	|				ТОГДА ЗаказыПокупателей.Регистратор.Дата
	|			ИНАЧЕ ТоварыВСборке.ДатаОтгрузки
	|		КОНЕЦ) КАК ДатаОтгрузки
	|ПОМЕСТИТЬ ТоварыВРеализации
	|ИЗ
	|	ТоварыВСборке КАК ТоварыВСборке
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыПокупателей КАК ЗаказыПокупателей
	|		ПО ТоварыВСборке.ЗаказПокупателя = ЗаказыПокупателей.ЗаказПокупателя
	|			И ТоварыВСборке.Номенклатура = ЗаказыПокупателей.Номенклатура
	|			И (ЗаказыПокупателей.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг)
	|			И ТоварыВСборке.Назначение = ЗаказыПокупателей.Назначение
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыВСборке.ЗаказПокупателя,
	|	ТоварыВСборке.Номенклатура,
	|	ТоварыВСборке.Назначение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыВРеализации.ЗаказПокупателя,
	|	ТоварыВРеализации.Номенклатура,
	|	ТоварыВРеализации.Назначение.Наименование КАК Назначение,
	|	МАКСИМУМ(ЕСТЬNULL(ТоварыВРеализации.Заказано, 0)) КАК Заказано,
	|	МАКСИМУМ(ЕСТЬNULL(ТоварыВРеализации.КСборке, 0)) КАК КСборке,
	|	МАКСИМУМ(ЕСТЬNULL(ТоварыВРеализации.Собрано, 0)) КАК Собрано,
	|	МАКСИМУМ(ЕСТЬNULL(ТоварыВРеализации.Реализовано, 0)) КАК Реализовано,
	|	СУММА(ЕСТЬNULL(-ЗаказыПокупателей.Количество, 0)) КАК Отменено,
	|	ТоварыВРеализации.Номенклатура.Артикул КАК Артикул,
	|	МАКСИМУМ(ТоварыВРеализации.ДатаОтгрузки) КАК ПлановаяДатаПоступления
	|ИЗ
	|	ТоварыВРеализации КАК ТоварыВРеализации
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыПокупателей КАК ЗаказыПокупателей
	|		ПО ТоварыВРеализации.ЗаказПокупателя = ЗаказыПокупателей.ЗаказПокупателя
	|			И ТоварыВРеализации.Номенклатура = ЗаказыПокупателей.Номенклатура
	|			И (ЗаказыПокупателей.Регистратор ССЫЛКА Документ.КорректировкаЗаказаПокупателя)
	|			И (ЗаказыПокупателей.Количество < 0)
	|			И ТоварыВРеализации.Назначение = ЗаказыПокупателей.Назначение
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыВРеализации.ЗаказПокупателя,
	|	ТоварыВРеализации.Номенклатура,
	|	ТоварыВРеализации.Номенклатура.Артикул,
	|	ТоварыВРеализации.Назначение.Наименование";
	
	Запрос.Параметры.Вставить("НачПериода", НачалоДня(ДатаНТ));
	Запрос.Параметры.Вставить("КонПериода", КонецДня(ДатаКТ));
	Запрос.Параметры.Вставить("Грузополучатель", ФилиалКонтрагента);	
	
	Если ВидОперации = "ГорючиеЖидкости" Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЗаказыПокупателей.Регистратор.КроссДокинг = ЛОЖЬ", "ЗаказыПокупателей.Регистратор.КроссДокинг = ИСТИНА");
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	ТаблТоваров = Запрос.Выполнить().Выгрузить();
	
	ТаблСтатусов = Новый ТаблицаЗначений();
	ТаблСтатусов.Колонки.Добавить("ЗаказПокупателя");
	ТаблСтатусов.Колонки.Добавить("Артикул");
	ТаблСтатусов.Колонки.Добавить("Количество");
	ТаблСтатусов.Колонки.Добавить("Статус");
	ТаблСтатусов.Колонки.Добавить("ПлановаяДатаПоступления");
	ТаблСтатусов.Колонки.Добавить("Назначение"); 
	
	Для Каждого СтрТоваров Из ТаблТоваров Цикл
		
		Если СтрТоваров.Реализовано > 0 Тогда
			
			НовСтрока = ТаблСтатусов.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока,СтрТоваров);
			НовСтрока.Статус = "50; на доставке";
			НовСтрока.Количество = СтрТоваров.Реализовано;
			СтрТоваров.Заказано = СтрТоваров.Заказано - НовСтрока.Количество;
			
		КонецЕсли;
		
		Если СтрТоваров.Собрано > 0 Тогда
			
			НовСтрока = ТаблСтатусов.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока,СтрТоваров);
			НовСтрока.Статус = "40; подобрано";
			НовСтрока.Количество = СтрТоваров.Собрано;
			СтрТоваров.Заказано = СтрТоваров.Заказано - НовСтрока.Количество;
			
		КонецЕсли;
		
		Если СтрТоваров.КСборке > 0 Тогда
			
			НовСтрока = ТаблСтатусов.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока,СтрТоваров);
			НовСтрока.Статус = "30; на подборе";
			НовСтрока.Количество = СтрТоваров.КСборке;
			СтрТоваров.Заказано = СтрТоваров.Заказано - НовСтрока.Количество;
			
		КонецЕсли;	
		
		Если СтрТоваров.Отменено > 0 Тогда
			
			НовСтрока = ТаблСтатусов.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока,СтрТоваров);
			НовСтрока.Статус = "120; нет на складе";
			НовСтрока.Количество = СтрТоваров.Отменено;
			СтрТоваров.Заказано = СтрТоваров.Заказано - НовСтрока.Количество;
			
		КонецЕсли;
		
		Если СтрТоваров.Заказано > 0 Тогда
			
			НовСтрока = ТаблСтатусов.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока,СтрТоваров);
			НовСтрока.Статус = "10; зарезервирован";
			НовСтрока.Количество = СтрТоваров.Заказано;
			СтрТоваров.Заказано = СтрТоваров.Заказано - НовСтрока.Количество;
			
		КонецЕсли;
		
	КонецЦикла;
	
	СтруктураДанных.Вставить("СписокДанных", ТаблицуВМассив(ТаблСтатусов));	
	РезультатВыполнения = ДанныеВJSONХранилище(СтруктураДанных);
	
	ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис GoodsReserve", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. ПолучитьСтатусыЗаказов " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
	
	Возврат РезультатВыполнения;	
	
КонецФункции

Функция ПолучитьДоговорКонтрагента(Контрагент)
	
	Договор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	
	Запрос = Новый Запрос
	("ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДоговорыКонтрагентов.Ссылка
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.Владелец = &Владелец
	|	И ДоговорыКонтрагентов.ПометкаУдаления = ЛОЖЬ
	|	И ДоговорыКонтрагентов.ВидДоговора = &ВидДоговора
	|	И НЕ ДоговорыКонтрагентов.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДоговорыКонтрагентов.Дата УБЫВ");
	
	Запрос.Параметры.Вставить("Владелец", Контрагент);
	Запрос.Параметры.Вставить("ВидДоговора", Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
	
	РезЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезЗапроса.Следующий() Тогда
		Договор = РезЗапроса.Ссылка;
	КонецЕсли;
	
	Возврат Договор;
	
КонецФункции

Функция ПолучитьРеализацииПоКонтрагенту(КодКонтрагента)
	
	ФилиалКонтрагента = МСКWEB.НайтиФилиалПоКодуИзПортала(СокрЛП(КодКонтрагента));
	ТекДата = ТекущаяДата();
	//+Гавриленков В. 22.08.2025 #UT10-5394  
	КоличествоДней = Справочники.МТ_ПредопределенныеЗначения.ПолучитьЗначениеПоСвойству(Справочники.МТ_ПредопределенныеЗначения.НастройкиКоличестваДней, "Количество дней для получения реализаций по контрагенту");
	ДатаНач = НачалоДня(ТекДата - ((?(ЗначениеЗаполнено(КоличествоДней), КоличествоДней, 3) * 24 * 60 * 60)));
	//ДатаНач = НачалоДня(ТекДата - (3*24*60*60));
	//-Гавриленков В. 22.08.2025 #UT10-5394
	ДатаКон = КонецДня(ТекДата);
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	РеализацияТоваровУслугТовары.Ссылка,
	|	РеализацияТоваровУслугТовары.Номенклатура КАК Номенклатура,
	|	СУММА(РеализацияТоваровУслугТовары.Количество) КАК Количество,
	|	РеализацияТоваровУслугТовары.Цена,
	|	РеализацияТоваровУслугТовары.Комментарий,
	|	РеализацияТоваровУслугТовары.ЕдиницаИзмерения,
	|	РеализацияТоваровУслугТовары.Ссылка.Номер КАК НомерДокумента,
	|	РеализацияТоваровУслугТовары.Номенклатура.Артикул КАК Артикул,
	|	РеализацияТоваровУслугТовары.Ссылка.Дата КАК ДатаДокумента,
	|	РеализацияТоваровУслугТовары.СерияНоменклатуры.НомерГТД.Код КАК НомерГТДКод,
	|	РеализацияТоваровУслугТовары.СерияНоменклатуры.СтранаПроисхождения.Код КАК СтранаПроисхожденияКод,
	|	РеализацияТоваровУслугТовары.ЗаказПокупателя,
	|	СУММА(РеализацияТоваровУслугТовары.Сумма) КАК Сумма,
	|	СУММА(РеализацияТоваровУслугТовары.СуммаНДС) КАК СуммаНДС
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|ГДЕ
	|	РеализацияТоваровУслугТовары.Ссылка.Проведен = ИСТИНА
	|	И РеализацияТоваровУслугТовары.Ссылка.Грузополучатель = &Грузополучатель
	|	И РеализацияТоваровУслугТовары.Ссылка.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|	И РеализацияТоваровУслугТовары.ЗаказПокупателя.КроссДокинг = ЛОЖЬ
	|
	|СГРУППИРОВАТЬ ПО
	|	РеализацияТоваровУслугТовары.Ссылка,
	|	РеализацияТоваровУслугТовары.Номенклатура,
	|	РеализацияТоваровУслугТовары.Цена,
	|	РеализацияТоваровУслугТовары.Комментарий,
	|	РеализацияТоваровУслугТовары.ЕдиницаИзмерения,
	|	РеализацияТоваровУслугТовары.Ссылка.Номер,
	|	РеализацияТоваровУслугТовары.Номенклатура.Артикул,
	|	РеализацияТоваровУслугТовары.Ссылка.Дата,
	|	РеализацияТоваровУслугТовары.СерияНоменклатуры.НомерГТД.Код,
	|	РеализацияТоваровУслугТовары.СерияНоменклатуры.СтранаПроисхождения.Код,
	|	РеализацияТоваровУслугТовары.ЗаказПокупателя
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаДокумента,
	|	НомерДокумента,
	|	Номенклатура");
	
	Запрос.Параметры.Вставить("Грузополучатель", ФилиалКонтрагента);	
	Запрос.Параметры.Вставить("ДатаНач", ДатаНач);
	Запрос.Параметры.Вставить("ДатаКон", ДатаКон);
	ТаблЗапроса = Запрос.Выполнить().Выгрузить();
	
	ТаблЗапроса.Колонки.Добавить("СФНомер");
	ТаблЗапроса.Колонки.Добавить("СФДата");
	ТаблЗапроса.Колонки.Добавить("ИДДокументаВСмежнойБазе");
	
	НомерДокумента = "";
	СчетФактура = Документы.СчетФактураВыданный.ПустаяСсылка();
	
	ЭтоБазаНН = Константы.База.Получить() = Перечисления.НазваниеБазы.НижнийНовгород;
	
	Для Каждого СтрЗапроса Из ТаблЗапроса Цикл
		
		Если НомерДокумента <> СтрЗапроса.НомерДокумента Тогда
			
			НомерДокумента = СтрЗапроса.НомерДокумента;			
			СчетФактура = УчетНДС.НайтиПодчиненныйДокумент(СтрЗапроса.Ссылка, "СчетФактураВыданный");
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СчетФактура) Тогда
			
			Если ЭтоБазаНН Тогда
				СтрЗапроса.СФНомер = ОбщегоНазначения.ПолучитьНомерНаПечать(СчетФактура);	
			Иначе
				СтрЗапроса.СФНомер = СчетФактура.Номер;
			КонецЕсли;
			
			СтрЗапроса.СФДата = Строка(СчетФактура.Дата);
			
		Иначе
			
			СтрЗапроса.СФНомер = "";
			СтрЗапроса.СФДата = Строка('00010101');
			
		КонецЕсли;
		
		СтрЗапроса.ИДДокументаВСмежнойБазе = СокрЛП(СтрЗапроса.Ссылка.УникальныйИдентификатор());
		
	КонецЦикла;	
	
	Если Константы.База.Получить() = Перечисления.НазваниеБазы.Ростов
		ИЛИ Константы.База.Получить() = Перечисления.НазваниеБазы.Краснодар Тогда 
		
		Для Каждого СтрокаОбрезатьномер Из ТаблЗапроса Цикл
			
			Если ЗначениеЗаполнено(СтрокаОбрезатьномер.СФНомер) Тогда 				
				
				ПромНомерВходящего = СтрокаОбрезатьномер.СФНомер;
				СтрокаОбрезатьномер.НомерДокумента = Лев(ПромНомерВходящего, 3) + СтроковыеФункцииКлиентСервер.УдалитьПовторяющиесяСимволы(Сред(ПромНомерВходящего, 6), "0", "СЛЕВА");				
				
			КонецЕсли; 
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ТаблЗапроса;
	
КонецФункции

Функция РезервированиеТоваров(ТЗНоменклатуры , КодКонтрагента , КодМДМДоговора = "" , КодСоглашения = "") 
	
	БазаПолучатель = ТЗНоменклатуры[0].БазаПолучатель; 
	
	Если ВРег(БазаПолучатель) = "МАГИСТРАЛЬ" Тогда 
		Возврат РезервированиеТоваровМагистраль(ТЗНоменклатуры, КодКонтрагента, ТЗНоменклатуры[0].КодМДМДоговора);
	КонецЕсли;	
	
	ФилиалКонтрагента = МСКWEB.НайтиФилиалПоКодуИзПортала(СокрЛП(КодКонтрагента)); 
	
	Если ЗначениеЗаполнено(КодСоглашения) 
		И ЗначениеЗаполнено(ФилиалКонтрагента)
		И ФилиалКонтрагента.КодСоглашения <> КодСоглашения Тогда  
		
		Об = ФилиалКонтрагента.ПолучитьОбъект();
		Об.ОбменДанными.Загрузка = Истина;
		Об.КодСоглашения = КодСоглашения; 
		Об.Записать();
		
	КонецЕсли;
	
	Если ТЗНоменклатуры[0].Свойство("ГУИДЗаказаПоставщику") Тогда  
		
		ГУИДЗаказаПоставщику = ТЗНоменклатуры[0].ГУИДЗаказаПоставщику;
		ЕстьЗаказПоГУИД = Документы.ЗаказПокупателя.НайтиПоРеквизиту("ГУИДЗаказаПоставщику", ГУИДЗаказаПоставщику);
		
	Иначе
		
		ГУИДЗаказаПоставщику = "";
		ЕстьЗаказПоГУИД = Документы.ЗаказПокупателя.ПустаяСсылка();
		
	КонецЕсли; 
	
	Если ЕстьЗаказПоГУИД.Пустая() ИЛИ НЕ ЕстьЗаказПоГУИД.Проведен  Тогда 
		
		ТекДата = ТекущаяДата();
		
		НовыйДокЗаказ = Документы.ЗаказПокупателя.СоздатьДокумент();
		НовыйДокЗаказ.Дата 	 = ТекДата; 
		НовыйДокЗаказ.ГУИДЗаказаПоставщику = ГУИДЗаказаПоставщику;
		
		Если НЕ ЕстьЗаказПоГУИД.Пустая() И НЕ ЕстьЗаказПоГУИД.Проведен  Тогда
			
			ЕстьЗаказПоГУИДОбъект = ЕстьЗаказПоГУИД.ПолучитьОбъект();
			ЕстьЗаказПоГУИДОбъект.ГУИДЗаказаПоставщику = "";
			
			Попытка
				ЕстьЗаказПоГУИДОбъект.Записать();
			Исключение
			КонецПопытки;
			
		КонецЕсли;
		
		Если НЕ ФилиалКонтрагента  = Неопределено Тогда    
			
			НовыйДокЗаказ.Грузополучатель = ФилиалКонтрагента;
			НовыйДокЗаказ.Контрагент = ФилиалКонтрагента.ГоловнойКонтрагент;
			НовыйДокЗаказ.ДоговорКонтрагента = ПолучитьДоговорКонтрагента(НовыйДокЗаказ.Контрагент); 
			
			Если БазаПолучатель = "УТ10Казань" ИЛИ БазаПолучатель = "УТ10Обособленное" Тогда
				
				НовыйДокЗаказ.СпособДоставки = ?(ЗначениеЗаполнено(НовыйДокЗаказ.Контрагент.СпособДоставки), НовыйДокЗаказ.Контрагент.СпособДоставки, НовыйДокЗаказ.Грузополучатель.СпособДоставки);
				
				Если НЕ КодМДМДоговора = "" Тогда  
					ПромДоговорПоКодуМДМ = Справочники.ДоговорыКонтрагентов.НайтиПоРеквизиту("КодМДМ", КодМДМдоговора);
				Иначе    
					ПромДоговорПоКодуМДМ = Справочники.ДоговорыКонтрагентов.ПустаяСсылка(); 
				КонецЕсли; 
				
				Если НЕ ПромДоговорПоКодуМДМ.Пустая() Тогда   
					НовыйДокЗаказ.ДоговорКонтрагента = ПромДоговорПоКодуМДМ;  
				КонецЕсли;
				
			ИначеЕсли БазаПолучатель = "УТ10ВостокГорючиеЖидкости" Тогда
				
				Если ЗначениеЗаполнено(КодМДМДоговора) Тогда
					
					ДоговорПоКодуМДМ = Справочники.ДоговорыКонтрагентов.НайтиПоРеквизиту("КодМДМ", КодМДМдоговора); 
					
					Если ЗначениеЗаполнено(ДоговорПоКодуМДМ) Тогда
						НовыйДокЗаказ.ДоговорКонтрагента = ДоговорПоКодуМДМ	
					КонецЕсли; 
					
				КонецЕсли;
				
				НовыйДокЗаказ.СпособДоставки = НовыйДокЗаказ.Грузополучатель.СпособДоставки; 
				
			Иначе   
				НовыйДокЗаказ.СпособДоставки = НовыйДокЗаказ.Грузополучатель.СпособДоставки; 
			КонецЕсли;	
			
			НовыйДокЗаказ.ВалютаДокумента = НовыйДокЗаказ.ДоговорКонтрагента.ВалютаВзаиморасчетов;
			НовыйДокЗаказ.Организация = НовыйДокЗаказ.ДоговорКонтрагента.Организация;
			
			Если БазаПолучатель = "УТ10Обособленное" Тогда     
				НовыйДокЗаказ.IDСклада = ?(Константы.FTPВыгрузкаОстатковКаталог.Получить() = "", 1, Число(Константы.FTPВыгрузкаОстатковКаталог.Получить()));    
			КонецЕсли;	
			
		КонецЕсли;
		
		
		НовыйДокЗаказ.СкладГруппа = Константы.ОсновнойСклад.Получить();	
		
		НовыйДокЗаказ.УчитыватьНДС = Истина;
		НовыйДокЗаказ.СуммаВключаетНДС = Истина;
		
		НовыйДокЗаказ.КратностьВзаиморасчетов = 1;
		НовыйДокЗаказ.КурсВзаиморасчетов = 1;
		
		Если БазаПолучатель = "УТ10Казань" И Константы.База.Получить() = Перечисления.НазваниеБазы.Казань Тогда     
			НовыйДокЗаказ.Комментарий = "Создан на основании заказа поставщику из базы Самара " + ТекДата;
		Иначе 
			НовыйДокЗаказ.Комментарий = "Создан на основании заказа поставщику из базы УТ10 " + ТекДата;  
		КонецЕсли;	
		
		НовыйДокЗаказ.КроссДокинг = ?(БазаПолучатель = "УТ10ВостокГорючиеЖидкости", Истина, Ложь); 
		
		//+Кабанов А.В. 03.06.2025 # UT10-5262
		Если ТЗНоменклатуры[0].Свойство("ДоговорПоставщикаТОХ") И ЗначениеЗаполнено(ТЗНоменклатуры[0].ДоговорПоставщикаТОХ)Тогда
			
			ЕстьДоговорПостащикаТОХ = Справочники.ДоговорыКонтрагентов.НайтиПоРеквизиту("КодМДМ",СокрЛП(ТЗНоменклатуры[0].ДоговорПоставщикаТОХ));
			
			Если НЕ ЕстьДоговорПостащикаТОХ.Пустая() Тогда
				НовыйДокЗаказ.ДоговорПоставщикаТОХ = ЕстьДоговорПостащикаТОХ;
			КонецЕсли;
			
		КонецЕсли;
		//-Кабанов А.В. 03.06.2025 # UT10-5262
		
		ДокСумма = 0;		
		
		//Заполняем ТЧ
		Для Каждого Стр Из ТЗНоменклатуры Цикл
			
			Товар = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", Стр.Артикул); 
			
			Если ЗначениеЗаполнено(Товар) Тогда  
				НоваяСтрока = НовыйДокЗаказ.Товары.Добавить(); 
			Иначе
				Продолжить;   
			КонецЕсли;
			
			НоваяСтрока.Номенклатура = Товар;
			
			НоваяСтрока.ЕдиницаИзмерения = Товар.ЕдиницаХраненияОстатков;
			НоваяСтрока.Количество = Стр.Количество;    
			НоваяСтрока.Коэффициент = ?(ЗначениеЗаполнено(НоваяСтрока.ЕдиницаИзмерения) И ЗначениеЗаполнено(НоваяСтрока.ЕдиницаИзмерения.Коэффициент), НоваяСтрока.ЕдиницаИзмерения.Коэффициент, 1); 
			//+Гавриленков В. 17.12.2025 #UT10-5574 Времменное решение до изменения ставки НДС во всех элементах номенклатуры
			//НоваяСтрока.СтавкаНДС = Товар.СтавкаНДС;
			НоваяСтрока.СтавкаНДС = ?(НовыйДокЗаказ.Дата >= '20260101', Перечисления.СтавкиНДС.НДС22, Товар.СтавкаНДС);
			//-Гавриленков В. 17.12.2025 #UT10-5574
			
			Если БазаПолучатель = "УТ10Казань" Тогда 
				НоваяСтрока.Комментарий = Стр.УИД;	
			Иначе        
				НоваяСтрока.Комментарий = Стр.Комментарий;  
			КонецЕсли;	
			
			Если Стр.Свойство("Назначение") И ТипЗнч(Стр.Назначение) = Тип("Структура") Тогда
				НоваяСтрока.Назначение = Справочники.Назначения.СоздатьПолучитьНазначениеИзСтруктуры(Стр.Назначение);
			КонецЕсли;
			
		КонецЦикла;
		
		СтрокиДляПолногоУдаления = Новый Массив;
		ТекстСообщенияОбУдаленииСтрок = "";   
		
		Для Каждого СтрТовары Из НовыйДокЗаказ.Товары Цикл 
			
			Если НЕ МСК.ПроверкаНоменклатурыНаКратность(СтрТовары.Номенклатура,СтрТовары.Количество) Тогда 
				
				СтрокиДляПолногоУдаления.Добавить(СтрТовары);
				ТекстСообщенияОбУдаленииСтрок = ТекстСообщенияОбУдаленииСтрок + ";" + СокрЛП(СтрТовары.Номенклатура.Артикул);     
				
			КонецЕсли;      
			
		КонецЦикла;	
		
		Для Каждого Элемент Из СтрокиДляПолногоУдаления Цикл 			
			НовыйДокЗаказ.Товары.Удалить(Элемент);       
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ТекстСообщенияОбУдаленииСтрок) Тогда
			ЗаписьЖурналаРегистрации("Web-сервис GoodsReserve", УровеньЖурналаРегистрации.Информация,,, "Код филиала " + СокрЛП(КодКонтрагента) + ?(ЗначениеЗаполнено(НовыйДокЗаказ.Грузополучатель), " (" + СокрЛП(НовыйДокЗаказ.Грузополучатель.Наименование) + ")", "") + ". Удалены строки с позициями: " + Сред(ТекстСообщенияОбУдаленииСтрок,2) + ". Причина: нарушение кратности");
		КонецЕсли;
		
		ТипЦенОпределен = Ложь;
		
		//Заполняем цены
		Если ЗначениеЗаполнено(НовыйДокЗаказ.Контрагент) И ЗначениеЗаполнено(НовыйДокЗаказ.ДоговорКонтрагента) Тогда
			
			СпособЗаполненияЦен = Перечисления.СпособыЗаполненияЦен.ПоЦенамНоменклатуры;
			СтруктураРеквизитовДокумента = Ценообразование.ПолучитьСтруктуруРеквизитовДокументаДляЦенообразования(НовыйДокЗаказ);
			ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
			
			СтруктураВозвращаемыхЗначений = Новый Структура;
			СтруктураВозвращаемыхЗначений.Вставить("ТекущийТипЦен"                 , НовыйДокЗаказ.ТипЦен);
			СтруктураВозвращаемыхЗначений.Вставить("ТекущийВалютаДокумента"        , НовыйДокЗаказ.ВалютаДокумента);
			СтруктураВозвращаемыхЗначений.Вставить("ТекущийВалютаВзаиморасчетов"   , НовыйДокЗаказ.ВалютаДокумента);
			СтруктураВозвращаемыхЗначений.Вставить("ТекущийКурсДокумента"          , НовыйДокЗаказ.КурсВзаиморасчетов);
			СтруктураВозвращаемыхЗначений.Вставить("ТекущийКурсВзаиморасчетов"     , НовыйДокЗаказ.КурсВзаиморасчетов);
			СтруктураВозвращаемыхЗначений.Вставить("ТекущийУчитыватьНДС"           , НовыйДокЗаказ.УчитыватьНДС);
			СтруктураВозвращаемыхЗначений.Вставить("ТекущийСуммаВключаетНДС"       , НовыйДокЗаказ.СуммаВключаетНДС);
			
			СтруктураВозвращаемыхЗначений.Вставить("ПерезаполнитьЦеныПоТипу"       , Истина);
			СтруктураВозвращаемыхЗначений.Вставить("НовыйТипЦен"                   , НовыйДокЗаказ.ДоговорКонтрагента.ТипЦен);
