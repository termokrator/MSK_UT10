		ИЛИ ТекБаза = Перечисления.НазваниеБазы.Казань Тогда  
		
		ПравилоВоронеж = (ТекБаза = Перечисления.НазваниеБазы.Воронеж) Или (ТекБаза = Перечисления.НазваниеБазы.Казань);
		
