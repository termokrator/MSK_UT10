			|		ПО ТаблицаНоменклатура.Номенклатура = ТоварыВЯчейкахОстатки.Номенклатура
			|ГДЕ
			|	ТоварыВЯчейкахОстатки.Ячейка.НеУчитыватьВОперативномУчете = ЛОЖЬ
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ТоварыГотовыеКСборкеОстатки.Номенклатура,
			|	-ТоварыГотовыеКСборкеОстатки.КоличествоОстаток,
			|	3
			|ИЗ
			|	ТаблицаНоменклатура КАК ТаблицаНоменклатура
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыГотовыеКСборке.Остатки(, ) КАК ТоварыГотовыеКСборкеОстатки
			|		ПО ТаблицаНоменклатура.Номенклатура = ТоварыГотовыеКСборкеОстатки.Номенклатура
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Остатки.Номенклатура,
			|	СУММА(Остатки.Остаток) КАК Остаток,
			|	ВЫБОР
			|		КОГДА КонстКратности.ЗначениеКонстанты
			|			ТОГДА ВЫБОР
			|					КОГДА НЕ Остатки.Номенклатура.КратностьФилиала = 0
			|						ТОГДА Остатки.Номенклатура.КратностьФилиала
			|					ИНАЧЕ Остатки.Номенклатура.Кратность
			|				КОНЕЦ
			|		ИНАЧЕ Остатки.Номенклатура.Кратность
			|	КОНЕЦ КАК Кратность
			|ПОМЕСТИТЬ ОстаткиГруппа
			|ИЗ
			|	Остатки КАК Остатки,
			|	КонстКратности КАК КонстКратности
			|
			|СГРУППИРОВАТЬ ПО
			|	Остатки.Номенклатура,
			|	ВЫБОР
			|		КОГДА КонстКратности.ЗначениеКонстанты
			|			ТОГДА ВЫБОР
			|					КОГДА НЕ Остатки.Номенклатура.КратностьФилиала = 0
			|						ТОГДА Остатки.Номенклатура.КратностьФилиала
			|					ИНАЧЕ Остатки.Номенклатура.Кратность
			|				КОНЕЦ
			|		ИНАЧЕ Остатки.Номенклатура.Кратность
			|	КОНЕЦ
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ОстаткиГруппа.Номенклатура,
			|	СУММА(ОстаткиГруппа.Остаток) КАК Остаток,
			|	СУММА(ВЫБОР
			|			КОГДА ОстаткиГруппа.Остаток > 0
			|				ТОГДА ВЫБОР
			|						КОГДА ОстаткиГруппа.Кратность > ОстаткиГруппа.Остаток
			|							ТОГДА 0
			|						ИНАЧЕ ВЫБОР
			|								КОГДА (ВЫРАЗИТЬ(ОстаткиГруппа.Остаток / ОстаткиГруппа.Кратность - 0.5 КАК ЧИСЛО(15, 0))) * ОстаткиГруппа.Кратность <= ОстаткиГруппа.Остаток
			|									ТОГДА (ВЫРАЗИТЬ(ОстаткиГруппа.Остаток / ОстаткиГруппа.Кратность - 0.5 КАК ЧИСЛО(15, 0))) * ОстаткиГруппа.Кратность
			|								ИНАЧЕ ВЫРАЗИТЬ(ОстаткиГруппа.Остаток / ОстаткиГруппа.Кратность - 0.5 КАК ЧИСЛО(15, 0))
			|							КОНЕЦ
			|					КОНЕЦ
			|			ИНАЧЕ ВЫБОР
			|					КОГДА (ВЫРАЗИТЬ(ОстаткиГруппа.Остаток / ОстаткиГруппа.Кратность + 0.5 КАК ЧИСЛО(15, 0))) * ОстаткиГруппа.Кратность <= ОстаткиГруппа.Остаток
			|						ТОГДА (ВЫРАЗИТЬ(ОстаткиГруппа.Остаток / ОстаткиГруппа.Кратность + 0.5 КАК ЧИСЛО(15, 0))) * ОстаткиГруппа.Кратность
			|					ИНАЧЕ ВЫРАЗИТЬ(ОстаткиГруппа.Остаток / ОстаткиГруппа.Кратность + 0.5 КАК ЧИСЛО(15, 0))
			|				КОНЕЦ
			|		КОНЕЦ) КАК ОстатокПоКратности
			|ПОМЕСТИТЬ ОстаткиИтог
			|ИЗ
			|	ОстаткиГруппа КАК ОстаткиГруппа
			|ГДЕ
			|	ОстаткиГруппа.Остаток > 0
			|
			|СГРУППИРОВАТЬ ПО
			|	ОстаткиГруппа.Номенклатура
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ТаблицаНоменклатура.Номенклатура,
			|	ВЫБОР
			|		КОГДА ТаблицаНоменклатура.Количество - ЕСТЬNULL(ОстаткиИтог.Остаток, 0) > ТаблицаНоменклатура.Количество
			|			ТОГДА ТаблицаНоменклатура.Количество
			|		ИНАЧЕ ТаблицаНоменклатура.Количество - ЕСТЬNULL(ОстаткиИтог.Остаток, 0)
			|	КОНЕЦ КАК Нехватка_,
			|	ВЫБОР
			|		КОГДА ТаблицаНоменклатура.Количество - ЕСТЬNULL(ОстаткиИтог.ОстатокПоКратности, 0) > ТаблицаНоменклатура.Количество
			|			ТОГДА ТаблицаНоменклатура.Количество
			|		ИНАЧЕ ТаблицаНоменклатура.Количество - ЕСТЬNULL(ОстаткиИтог.ОстатокПоКратности, 0)
			|	КОНЕЦ КАК Нехватка
			|ПОМЕСТИТЬ Рез
			|ИЗ
			|	ТаблицаНоменклатура КАК ТаблицаНоменклатура
			|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиИтог КАК ОстаткиИтог
			|		ПО ТаблицаНоменклатура.Номенклатура = ОстаткиИтог.Номенклатура
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Рез.Номенклатура,
			|	Рез.Нехватка
			|ИЗ
			|	Рез КАК Рез
			|ГДЕ
			|	Рез.Нехватка > 0";
			
			Запрос.УстановитьПараметр("ТЗ", ТЗ);
			Запрос.УстановитьПараметр("ПустоеРазмещение", Неопределено);
			
			Табл = Запрос.Выполнить().Выгрузить(); 
			
			Для Каждого Стр Из Табл Цикл    
				
				Отбор = Новый Структура;
				Отбор.Вставить("Номенклатура", Стр.Номенклатура);
				НайдСтроки = НовыйДокЗаказ.Товары.НайтиСтроки(Отбор);
				КУменьшению = Стр.Нехватка;    
				
				Для Каждого строка из НайдСтроки Цикл  
					
					Если КУменьшению > 0 Тогда
						
						Если Строка.Количество > КУменьшению Тогда 
							
							НоваяСтрока = НовыйДокЗаказ.Товары.Добавить();
							ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка,, "КлючСтроки");
							Строка.Количество = Строка.Количество - КУменьшению;
							НоваяСтрока.Количество = КУменьшению;
							НоваяСтрока.Размещение = "";
							НоваяСтрока.СерияНоменклатуры = "";
							
							КУменьшению = 0;
							СтрСумма = НоваяСтрока.Количество * НоваяСтрока.Цена;
							НоваяСтрока.Сумма = СтрСумма;
							ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НоваяСтрока, НовыйДокЗаказ);
							
							СтрСумма = Строка.Количество * Строка.Цена;
							Строка.Сумма = СтрСумма;
							ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(Строка, НовыйДокЗаказ);
							
						Иначе  
							
							КУменьшению = КУменьшению - Строка.Количество;
							Строка.Размещение = "";
							Строка.СерияНоменклатуры = "";
							
						КонецЕсли; 
						
					КонецЕсли; 
					
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЕсли;
		
		СтрокиДляУдаления = Новый Массив;
		ТекстСообщенияОбУдаленииСтрок = "";  
		
		Для Каждого СтрТовары Из НовыйДокЗаказ.Товары Цикл  
			
			Если СтрТовары.Цена = 0 Или СтрТовары.Сумма = 0 Или Не ЗначениеЗаполнено(СтрТовары.Размещение) Тогда
				СтрокиДляУдаления.Добавить(СтрТовары);  
			КонецЕсли;
			
			Если БазаПолучатель <> "УТ10Казань" И СтрТовары.Сумма = 0 Тогда  
				СтрТовары.Сумма = 1;  
			КонецЕсли;
			
		КонецЦикла;	
		
		Если БазаПолучатель = "УТ10Казань" 
			//+Кабанов А.В. 02.06.2025 # UT10-5262			
			ИЛИ (НовыйДокЗаказ.Грузополучатель.ПополнениеТОХ И ЗначениеЗаполнено(НовыйДокЗаказ.ДоговорПоставщикаТОХ))  Тогда   
			//+Кабанов А.В. 02.06.2025 # UT10-5262

			Для Каждого Элемент Из СтрокиДляУдаления Цикл  
				НовыйДокЗаказ.Товары.Удалить(Элемент);
			КонецЦикла;
			
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(ТекстСообщенияОбУдаленииСтрок) Тогда 
			ЗаписьЖурналаРегистрации("Web-сервис GoodsReserve", УровеньЖурналаРегистрации.Информация,,, "Код филиала " + СокрЛП(КодКонтрагента) + ?(ЗначениеЗаполнено(НовыйДокЗаказ.Грузополучатель), " (" + СокрЛП(НовыйДокЗаказ.Грузополучатель.Наименование) + ")", "") + ". Удалены строки с позициями: " + Сред(ТекстСообщенияОбУдаленииСтрок,2) + ". Причина: не заполнено Размещение, либо после пересчета с учетом ячеек сумма стала равна 0.");
		КонецЕсли;
		
		ТЗТовары = НовыйДокЗаказ.Товары.Выгрузить();
		ТЗТовары.Свернуть("Номенклатура,Цена,Комментарий","Количество");
		ТЗТовары.Колонки.Добавить("Артикул"); //НормализованныйКод
		ТЗТовары.Колонки.Добавить("Заказ");
		ТЗТовары.Колонки.Добавить("СтрЗаказ");
		
		Если ТЗТовары.Количество() = 0 Тогда
			
			ЗаписьЖурналаРегистрации("Web-сервис GoodsReserve", УровеньЖурналаРегистрации.Информация,,, "Код филиала " + СокрЛП(КодКонтрагента) + ?(ЗначениеЗаполнено(НовыйДокЗаказ.Грузополучатель), " (" + СокрЛП(НовыйДокЗаказ.Грузополучатель.Наименование) + ")", "") + ". Возвращается пустая таблица номенклатуры.");
			Возврат ТЗТовары;
			
		КонецЕсли;	
		
		Попытка
			
			НовыйДокЗаказ.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Оперативный);
			
			Для Каждого СтрТз Из ТЗТовары Цикл
				
				СтрТз.Артикул = СтрТз.Номенклатура.Артикул;
				СтрТз.Заказ = НовыйДокЗаказ.Ссылка;
				СтрТз.СтрЗаказ = СокрЛП(НовыйДокЗаказ.Номер) + "/" + Формат(НовыйДокЗаказ.Дата, "ДЛФ=D");
				
			КонецЦикла;
			
			Если БазаПолучатель <> "УТ10Казань" И НЕ ((НовыйДокЗаказ.Грузополучатель.ПополнениеТОХ И ЗначениеЗаполнено(НовыйДокЗаказ.ДоговорПоставщикаТОХ))) И СтрокиДляУдаления.Количество() > 0 Тогда
				КорректировкаЗаказаПокупателя(НовыйДокЗаказ.Ссылка, СтрокиДляУдаления);
			КонецЕсли;
			
			Если НовыйДокЗаказ.Грузополучатель.ПополнениеТОХ И НЕ ЗначениеЗаполнено(НовыйДокЗаказ.ДоговорПоставщикаТОХ) Тогда
				
				Попытка		
					МСКWEB.СоздатьКорректировкаЗаказаПокупателяПоТоварамТОХ(НовыйДокЗаказ.Ссылка, , "Заказы на пополнение ТОХ создаются только обработкой");			
				Исключение
					Сообщить(ОписаниеОшибки());
				КонецПопытки;
				
			КонецЕсли;	
			
		Исключение
			
			НовыйДокЗаказ.Записать(РежимЗаписиДокумента.Запись);
			НовыйДокЗаказ.УстановитьПометкуУдаления(Истина);
			ТЗТовары.Очистить();
			ЗаписьЖурналаРегистрации("Web-сервис GoodsReserve", УровеньЖурналаРегистрации.Ошибка,,, "Веб-сервис:Выполнение. ЗарезервироватьТовары " + СокрЛП(БазаПолучатель) + ". Описание ошибки - " + СокрЛП(ОписаниеОшибки()) + ""); 			
			
		КонецПопытки;
		
	Иначе 
		
		ЗаписьЖурналаРегистрации("Web-сервис GoodsReserve", УровеньЖурналаРегистрации.Ошибка,,, "Веб-сервис:Выполнение. ЗарезервироватьТовары " + СокрЛП(БазаПолучатель) + ". Заказ " + СокрЛП(ЕстьЗаказПоГУИД.Номер) + " был создан ранее.");
		
		ТЗТовары = ЕстьЗаказПоГУИД.Товары.Выгрузить();
		ТЗТовары.Свернуть("Номенклатура,Цена,Комментарий","Количество");
		ТЗТовары.Колонки.Добавить("Артикул");
		ТЗТовары.Колонки.Добавить("Заказ");
		ТЗТовары.Колонки.Добавить("СтрЗаказ");
		
		Для Каждого СтрТз Из ТЗТовары Цикл 
			
			СтрТз.Артикул = СтрТз.Номенклатура.Артикул;
			СтрТз.Заказ = ЕстьЗаказПоГУИД.Ссылка;
			СтрТз.СтрЗаказ = СокрЛП(ЕстьЗаказПоГУИД.Номер) + "/" + Формат(ЕстьЗаказПоГУИД.Дата,"ДЛФ=D");
			
		КонецЦикла;
		
	КонецЕсли; 
	
	Возврат ТЗТовары;
	
КонецФункции 

Функция РезервированиеТоваровМагистраль(ТЗНоменклатуры, КодКонтрагента,КодМДМДоговора = "")
	
	ДатаИномерМагистраль = СтрЗаменить(ТЗНоменклатуры[0].Комментарий, """", "");
	ДатаСтр = Лев(ДатаИномерМагистраль, Найти(ДатаИномерМагистраль, "/") - 1);
	ПромДатаДокумента = Дата(Прав(ДатаСтр, 4), Сред(ДатаСтр, 4, 2), Лев(ДатаСтр, 2));
	ПромНомерДокумента = Сред(ДатаИномерМагистраль, Найти(ДатаИномерМагистраль, "/") + 1);
	
	Если ЗначениеЗаполнено(ПромНомерДокумента) И ЗначениеЗаполнено(ПромДатаДокумента) Тогда
		
		ЗапросДокумента = Новый Запрос;
		ЗапросДокумента.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 1
		|	ЗаказПокупателя.Ссылка
		|ИЗ
		|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
		|ГДЕ
		|	ЗаказПокупателя.НомерВходящегоДокументаЭлектронногоОбмена = &НомерВходящегоДокументаЭлектронногоОбмена
		|	И ЗаказПокупателя.ДатаВходящегоДокументаЭлектронногоОбмена = &ДатаВходящегоДокументаЭлектронногоОбмена"; 
		
		ЗапросДокумента.УстановитьПараметр("НомерВходящегоДокументаЭлектронногоОбмена", ПромНомерДокумента);
		ЗапросДокумента.УстановитьПараметр("ДатаВходящегоДокументаЭлектронногоОбмена", ПромДатаДокумента);
		
		РезультатЗапроса = ЗапросДокумента.Выполнить().Выгрузить();
		
		Если НЕ РезультатЗапроса.Количество() =  0 Тогда
			
			ЕстьДокумент = РезультатЗапроса[0].Ссылка;
			
			ТЗТовары = ЕстьДокумент.Товары.Выгрузить();
			ТЗТовары.Свернуть("Номенклатура,Цена,Комментарий", "Количество");
			ТЗТовары.Колонки.Добавить("Артикул"); 
			ТЗТовары.Колонки.Добавить("Заказ");
			ТЗТовары.Колонки.Добавить("СтрЗаказ");
			
			Для Каждого СтрТз Из ТЗТовары Цикл
				
				СтрТз.Артикул = СтрТз.Номенклатура.Артикул;
				СтрТз.Заказ = ЕстьДокумент.Ссылка;
				СтрТз.СтрЗаказ = СокрЛП(ЕстьДокумент.Номер) + "/" + Формат(ЕстьДокумент.Дата, "ДЛФ=D");
				
			КонецЦикла;
			
			Если НЕ ЕстьДокумент.Проведен Тогда
				
				ДокОбъект = ЕстьДокумент.ПолучитьОбъект();
				
				Попытка
					ДокОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Оперативный); 
				Исключение
					
					ДокОбъект.НомерВходящегоДокументаЭлектронногоОбмена = "";
					ДокОбъект.ДатаВходящегоДокументаЭлектронногоОбмена  = "";					
					ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
					ДокОбъект.УстановитьПометкуУдаления(Истина);
					ТЗТовары.Очистить();
					
				КонецПопытки;
				
			КонецЕсли;
			
			Возврат ТЗТовары;
			
		Иначе			
			
			ФилиалКонтрагента = МСКWEB.НайтиФилиалПоКодуИзПортала(СокрЛП(КодКонтрагента));
			ТекДата = ТекущаяДата();
			БазаПолучатель = ТЗНоменклатуры[0].БазаПолучатель; 
			
			НовыйДокЗаказ = Документы.ЗаказПокупателя.СоздатьДокумент();
			НовыйДокЗаказ.НомерВходящегоДокументаЭлектронногоОбмена = ПромНомерДокумента;
			НовыйДокЗаказ.ДатаВходящегоДокументаЭлектронногоОбмена  = ПромДатаДокумента;
			НовыйДокЗаказ.Дата 	 = ТекДата;
			
			Если НЕ ФилиалКонтрагента  = Неопределено Тогда
				
				НовыйДокЗаказ.Грузополучатель = ФилиалКонтрагента;
				НовыйДокЗаказ.Контрагент = ФилиалКонтрагента.ГоловнойКонтрагент;
				НовыйДокЗаказ.ДоговорКонтрагента = ПолучитьДоговорКонтрагента(НовыйДокЗаказ.Контрагент);
				НовыйДокЗаказ.СпособДоставки = ?(ЗначениеЗаполнено(НовыйДокЗаказ.Контрагент.СпособДоставки), НовыйДокЗаказ.Контрагент.СпособДоставки, НовыйДокЗаказ.Грузополучатель.СпособДоставки); 
				
				Если НЕ КодМДМДоговора = "" Тогда
					ПромДоговорПоКодуМДМ = Справочники.ДоговорыКонтрагентов.НайтиПоРеквизиту("КодМДМ", КодМДМдоговора);
				Иначе
					ПромДоговорПоКодуМДМ = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
				КонецЕсли;
				
				Если НЕ ПромДоговорПоКодуМДМ.Пустая() Тогда
					НовыйДокЗаказ.ДоговорКонтрагента = ПромДоговорПоКодуМДМ;
				КонецЕсли;  			
				
				НовыйДокЗаказ.ВалютаДокумента = НовыйДокЗаказ.ДоговорКонтрагента.ВалютаВзаиморасчетов;
				НовыйДокЗаказ.Организация = НовыйДокЗаказ.ДоговорКонтрагента.Организация; 	
				
			КонецЕсли;
			
			НовыйДокЗаказ.СкладГруппа = Константы.ОсновнойСклад.Получить();	
			НовыйДокЗаказ.УчитыватьНДС = Истина;
			НовыйДокЗаказ.СуммаВключаетНДС = Истина;
			НовыйДокЗаказ.КратностьВзаиморасчетов = 1;
			НовыйДокЗаказ.КурсВзаиморасчетов = 1;
			НовыйДокЗаказ.Комментарий = "Создан на основании заказа поставщику из базы Магистрали " + ТекДата;
			
			ДокСумма = 0;
			
			//Заполняем ТЧ
			Для Каждого Стр Из ТЗНоменклатуры Цикл
				
				Товар = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул",Стр.Артикул); //НормализованныйКод
				
				Если ЗначениеЗаполнено(Товар) Тогда
					НоваяСтрока = НовыйДокЗаказ.Товары.Добавить();
				Иначе
					Продолжить;
				КонецЕсли;
				
				НоваяСтрока.Номенклатура = Товар;
				
				НоваяСтрока.ЕдиницаИзмерения = Товар.ЕдиницаХраненияОстатков;
				НоваяСтрока.Количество = Стр.Количество;
				НоваяСтрока.Коэффициент = 1; 
				//+Гавриленков В. 17.12.2025 #UT10-5574 Времменное решение до изменения ставки НДС во всех элементах номенклатуры
				//НоваяСтрока.СтавкаНДС = Товар.СтавкаНДС;
				НоваяСтрока.СтавкаНДС = ?(НовыйДокЗаказ.Дата >= '20260101', Перечисления.СтавкиНДС.НДС22, Товар.СтавкаНДС);
				//-Гавриленков В. 17.12.2025 #UT10-5574
				
				Если БазаПолучатель = "УТ10Казань" Тогда 
					НоваяСтрока.Комментарий = Стр.УИД;			 
				Иначе
					НоваяСтрока.Комментарий = Стр.Комментарий; 
				КонецЕсли;			
				
			КонецЦикла;
			
			СтрокиДляПолногоУдаления = Новый Массив;
			
			Для Каждого СтрТовары Из НовыйДокЗаказ.Товары Цикл
				
				Если НЕ МСК.ПроверкаНоменклатурыНаКратность(СтрТовары.Номенклатура,СтрТовары.Количество) Тогда 
					СтрокиДляПолногоУдаления.Добавить(СтрТовары);			
				КонецЕсли;
				
			КонецЦикла;		
			
			Для Каждого Элемент Из СтрокиДляПолногоУдаления Цикл
				НовыйДокЗаказ.Товары.Удалить(Элемент);
			КонецЦикла;
			
			//Заполняем цены
			Если ЗначениеЗаполнено(НовыйДокЗаказ.Контрагент) И ЗначениеЗаполнено(НовыйДокЗаказ.ДоговорКонтрагента) Тогда		
				
				СпособЗаполненияЦен = Перечисления.СпособыЗаполненияЦен.ПоЦенамНоменклатуры;
				СтруктураРеквизитовДокумента = Ценообразование.ПолучитьСтруктуруРеквизитовДокументаДляЦенообразования(НовыйДокЗаказ);
				ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
				
				СтруктураВозвращаемыхЗначений = Новый Структура;
				СтруктураВозвращаемыхЗначений.Вставить("ТекущийТипЦен"                 , НовыйДокЗаказ.ТипЦен);
				СтруктураВозвращаемыхЗначений.Вставить("ТекущийВалютаДокумента"        , НовыйДокЗаказ.ВалютаДокумента);
				СтруктураВозвращаемыхЗначений.Вставить("ТекущийВалютаВзаиморасчетов"   , НовыйДокЗаказ.ВалютаДокумента);
				СтруктураВозвращаемыхЗначений.Вставить("ТекущийКурсДокумента"          , НовыйДокЗаказ.КурсВзаиморасчетов);
				СтруктураВозвращаемыхЗначений.Вставить("ТекущийКурсВзаиморасчетов"     , НовыйДокЗаказ.КурсВзаиморасчетов);
				СтруктураВозвращаемыхЗначений.Вставить("ТекущийУчитыватьНДС"           , НовыйДокЗаказ.УчитыватьНДС);
				СтруктураВозвращаемыхЗначений.Вставить("ТекущийСуммаВключаетНДС"       , НовыйДокЗаказ.СуммаВключаетНДС);
				
				СтруктураВозвращаемыхЗначений.Вставить("ПерезаполнитьЦеныПоТипу"       , Истина);
				СтруктураВозвращаемыхЗначений.Вставить("НовыйТипЦен"                   , НовыйДокЗаказ.ДоговорКонтрагента.ТипЦен);
				СтруктураВозвращаемыхЗначений.Вставить("ПересчитатьЦеныПоВалюте"       , Ложь);
				СтруктураВозвращаемыхЗначений.Вставить("НовыйВалютаДокумента"          , НовыйДокЗаказ.ВалютаДокумента);
				СтруктураВозвращаемыхЗначений.Вставить("НовыйКурсДокумента"            , НовыйДокЗаказ.КурсВзаиморасчетов);
				СтруктураВозвращаемыхЗначений.Вставить("НовыйКурсВзаиморасчетов"       , НовыйДокЗаказ.КурсВзаиморасчетов);
				СтруктураВозвращаемыхЗначений.Вставить("НовыйУчитыватьНДС"             , НовыйДокЗаказ.УчитыватьНДС);
				СтруктураВозвращаемыхЗначений.Вставить("НовыйСуммаВключаетНДС"         , НовыйДокЗаказ.СуммаВключаетНДС);
				
				СтруктураВозвращаемыхЗначений.Вставить("ТекущийКратностьДокумента"     , НовыйДокЗаказ.КратностьВзаиморасчетов);
				СтруктураВозвращаемыхЗначений.Вставить("НовыйКратностьДокумента"       , НовыйДокЗаказ.КратностьВзаиморасчетов);
				
				СтруктураВозвращаемыхЗначений.Вставить("ТекущийКратностьВзаиморасчетов", НовыйДокЗаказ.КратностьВзаиморасчетов);
				СтруктураВозвращаемыхЗначений.Вставить("НовыйКратностьВзаиморасчетов"  , НовыйДокЗаказ.КратностьВзаиморасчетов);
				
				СтруктураВозвращаемыхЗначений.Вставить("ТекущийНДСВключенВСтоимость"   , Ложь);
				СтруктураВозвращаемыхЗначений.Вставить("НовыйНДСВключенВСтоимость"     , Ложь);
				
				СтруктураВозвращаемыхЗначений.Вставить("ТекущийИспользоватьПлановуюСебестоимость", НовыйДокЗаказ.ИспользоватьПлановуюСебестоимость);
				СтруктураВозвращаемыхЗначений.Вставить("НовыйИспользоватьПлановуюСебестоимость"  , НовыйДокЗаказ.ИспользоватьПлановуюСебестоимость);
				
				СтруктураВозвращаемыхЗначений.Вставить("ТекущийРегистрироватьЦеныПоставщика"     , Ложь);
				СтруктураВозвращаемыхЗначений.Вставить("НовыйРегистрироватьЦеныПоставщика"       , Ложь);
				
				СтруктураВозвращаемыхЗначений.Вставить("ТекущийУсловиеПродаж"                    , НовыйДокЗаказ.УсловиеПродаж);
				СтруктураВозвращаемыхЗначений.Вставить("НовыйУсловиеПродаж"                      , НовыйДокЗаказ.УсловиеПродаж);		
				
				НеИспользоватьЦеновыеГруппы = Ложь;
				
				Если БазаПолучатель = "УТ10Казань" Тогда
					НеИспользоватьЦеновыеГруппы = Истина;
				КонецЕсли;			
				
				ЗаполнениеДокументов.ИзменитьЦеныВалюту(НовыйДокЗаказ, СпособЗаполненияЦен, СтруктураРеквизитовДокумента, , "Товары", 
				          ВалютаРегламентированногоУчета, , СтруктураВозвращаемыхЗначений, НовыйДокЗаказ.ДоговорКонтрагента.ТипЦен, , НеИспользоватьЦеновыеГруппы);
				
			КонецЕсли;
			
			СтрокиДляПолногоУдаления = Новый Массив;
			
			Для Каждого СтрТовары Из НовыйДокЗаказ.Товары Цикл
				
				Если СтрТовары.Цена = 0 Тогда
					СтрокиДляПолногоУдаления.Добавить(СтрТовары);			
				КонецЕсли;
				
			КонецЦикла;		
			
			Для Каждого Элемент Из СтрокиДляПолногоУдаления Цикл
				НовыйДокЗаказ.Товары.Удалить(Элемент);
			КонецЦикла;
			
			ДокСумма = НовыйДокЗаказ.Товары.Итог("Сумма");
			НовыйДокЗаказ.СуммаДокумента = ДокСумма;	
			
			//Заполнение и проведение
			ВидимостьСерии = Истина;
			Авторезервирование = Истина;
			Авторазмещение = Ложь;
			СтратегияАвторезервированияПоЗаказам = Перечисления.СтратегииАвторезервированияНоменклатуры.СначалаНаСкладахПотомВЗаказахПоставщикам;
			
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("ВидимостьСерии",     ВидимостьСерии);
			СтруктураПараметров.Вставить("Авторезервирование", Авторезервирование);
			СтруктураПараметров.Вставить("Авторазмещение",     Авторазмещение);
			СтруктураПараметров.Вставить("СтратегияАвторезервированияПоЗаказам", СтратегияАвторезервированияПоЗаказам);
			
			НовыйДокЗаказ.ЗаполнитьТабличныеЧастиПередПроведениемУпр(СтруктураПараметров);	
			
			СкладФильтр = Константы.ОсновнойСклад.Получить();
			
			Для Каждого Стр Из НовыйДокЗаказ.Товары Цикл	
				
				Если НЕ Стр.Размещение = СкладФильтр ИЛИ НЕ ЗначениеЗаполнено(Стр.СерияНоменклатуры) Тогда					
					Стр.Размещение = "";
				КонецЕсли; 
				
			КонецЦикла;
			
			Если ТекущаяДата() >= Константы.РезервированиеЗаказовСУчетомЯчеек.Получить() тогда
				
				ТЗ = НовыйДокЗаказ.Товары.Выгрузить();
				ТЗ.Свернуть("Номенклатура,Размещение", "Количество");
				
				Запрос = Новый Запрос;
				Запрос.Текст =
				"ВЫБРАТЬ
				|	Константы.ИспользоватьАлгоритмПроверкиКратностиФилиала КАК ЗначениеКонстанты
				|ПОМЕСТИТЬ КонстКратности
				|ИЗ
				|	Константы КАК Константы
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ТЗ.Номенклатура КАК Номенклатура,
				|	ТЗ.Количество КАК Количество,
				|	ТЗ.Размещение КАК Размещение
				|ПОМЕСТИТЬ ТаблицаНоменклатура
				|ИЗ
				|	&ТЗ КАК ТЗ
				|ГДЕ
				|	ТЗ.Размещение <> НЕОПРЕДЕЛЕНО
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ТоварыВЯчейкахОстатки.Номенклатура,
				|	ТоварыВЯчейкахОстатки.КоличествоОстаток КАК Остаток,
				|	1 КАК Поле1
				|ПОМЕСТИТЬ Остатки
				|ИЗ
				|	ТаблицаНоменклатура КАК ТаблицаНоменклатура
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках.Остатки(, НЕ Ячейка.НеУчитыватьВОперативномУчете) КАК ТоварыВЯчейкахОстатки
				|		ПО ТаблицаНоменклатура.Номенклатура = ТоварыВЯчейкахОстатки.Номенклатура
				|ГДЕ
				|	ТоварыВЯчейкахОстатки.Ячейка.НеУчитыватьВОперативномУчете = ЛОЖЬ
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ
				|	ТоварыГотовыеКСборкеОстатки.Номенклатура,
				|	-ТоварыГотовыеКСборкеОстатки.КоличествоОстаток,
				|	3
				|ИЗ
				|	ТаблицаНоменклатура КАК ТаблицаНоменклатура
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыГотовыеКСборке.Остатки(, ) КАК ТоварыГотовыеКСборкеОстатки
				|		ПО ТаблицаНоменклатура.Номенклатура = ТоварыГотовыеКСборкеОстатки.Номенклатура
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	Остатки.Номенклатура,
				|	СУММА(Остатки.Остаток) КАК Остаток,
				|	ВЫБОР
				|		КОГДА КонстКратности.ЗначениеКонстанты
				|			ТОГДА ВЫБОР
				|					КОГДА НЕ Остатки.Номенклатура.КратностьФилиала = 0
				|						ТОГДА Остатки.Номенклатура.КратностьФилиала
				|					ИНАЧЕ Остатки.Номенклатура.Кратность
				|				КОНЕЦ
				|		ИНАЧЕ Остатки.Номенклатура.Кратность
				|	КОНЕЦ КАК Кратность
				|ПОМЕСТИТЬ ОстаткиГруппа
				|ИЗ
				|	Остатки КАК Остатки,
				|	КонстКратности КАК КонстКратности
				|
				|СГРУППИРОВАТЬ ПО
				|	Остатки.Номенклатура,
				|	ВЫБОР
				|		КОГДА КонстКратности.ЗначениеКонстанты
				|			ТОГДА ВЫБОР
				|					КОГДА НЕ Остатки.Номенклатура.КратностьФилиала = 0
				|						ТОГДА Остатки.Номенклатура.КратностьФилиала
				|					ИНАЧЕ Остатки.Номенклатура.Кратность
				|				КОНЕЦ
				|		ИНАЧЕ Остатки.Номенклатура.Кратность
				|	КОНЕЦ
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ОстаткиГруппа.Номенклатура,
				|	СУММА(ОстаткиГруппа.Остаток) КАК Остаток,
				|	СУММА(ВЫБОР
				|			КОГДА ОстаткиГруппа.Остаток > 0
				|				ТОГДА ВЫБОР
				|						КОГДА ОстаткиГруппа.Кратность > ОстаткиГруппа.Остаток
				|							ТОГДА 0
				|						ИНАЧЕ ВЫБОР
				|								КОГДА (ВЫРАЗИТЬ(ОстаткиГруппа.Остаток / ОстаткиГруппа.Кратность - 0.5 КАК ЧИСЛО(15, 0))) * ОстаткиГруппа.Кратность <= ОстаткиГруппа.Остаток
				|									ТОГДА (ВЫРАЗИТЬ(ОстаткиГруппа.Остаток / ОстаткиГруппа.Кратность - 0.5 КАК ЧИСЛО(15, 0))) * ОстаткиГруппа.Кратность
				|								ИНАЧЕ ВЫРАЗИТЬ(ОстаткиГруппа.Остаток / ОстаткиГруппа.Кратность - 0.5 КАК ЧИСЛО(15, 0))
				|							КОНЕЦ
				|					КОНЕЦ
				|			ИНАЧЕ ВЫБОР
				|					КОГДА (ВЫРАЗИТЬ(ОстаткиГруппа.Остаток / ОстаткиГруппа.Кратность + 0.5 КАК ЧИСЛО(15, 0))) * ОстаткиГруппа.Кратность <= ОстаткиГруппа.Остаток
				|						ТОГДА (ВЫРАЗИТЬ(ОстаткиГруппа.Остаток / ОстаткиГруппа.Кратность + 0.5 КАК ЧИСЛО(15, 0))) * ОстаткиГруппа.Кратность
				|					ИНАЧЕ ВЫРАЗИТЬ(ОстаткиГруппа.Остаток / ОстаткиГруппа.Кратность + 0.5 КАК ЧИСЛО(15, 0))
				|				КОНЕЦ
				|		КОНЕЦ) КАК ОстатокПоКратности
				|ПОМЕСТИТЬ ОстаткиИтог
				|ИЗ
				|	ОстаткиГруппа КАК ОстаткиГруппа
				|ГДЕ
				|	ОстаткиГруппа.Остаток > 0
				|
				|СГРУППИРОВАТЬ ПО
				|	ОстаткиГруппа.Номенклатура
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ТаблицаНоменклатура.Номенклатура,
				|	ВЫБОР
				|		КОГДА ТаблицаНоменклатура.Количество - ЕСТЬNULL(ОстаткиИтог.Остаток, 0) > ТаблицаНоменклатура.Количество
				|			ТОГДА ТаблицаНоменклатура.Количество
				|		ИНАЧЕ ТаблицаНоменклатура.Количество - ЕСТЬNULL(ОстаткиИтог.Остаток, 0)
				|	КОНЕЦ КАК Нехватка_,
				|	ВЫБОР
				|		КОГДА ТаблицаНоменклатура.Количество - ЕСТЬNULL(ОстаткиИтог.ОстатокПоКратности, 0) > ТаблицаНоменклатура.Количество
				|			ТОГДА ТаблицаНоменклатура.Количество
				|		ИНАЧЕ ТаблицаНоменклатура.Количество - ЕСТЬNULL(ОстаткиИтог.ОстатокПоКратности, 0)
				|	КОНЕЦ КАК Нехватка
				|ПОМЕСТИТЬ Рез
				|ИЗ
				|	ТаблицаНоменклатура КАК ТаблицаНоменклатура
				|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиИтог КАК ОстаткиИтог
				|		ПО ТаблицаНоменклатура.Номенклатура = ОстаткиИтог.Номенклатура
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	Рез.Номенклатура,
				|	Рез.Нехватка
				|ИЗ
				|	Рез КАК Рез
				|ГДЕ
				|	Рез.Нехватка > 0";
				
				Запрос.УстановитьПараметр("ТЗ", ТЗ);
				Запрос.УстановитьПараметр("ПустоеРазмещение", Неопределено);
				
				Табл = Запрос.Выполнить().Выгрузить();
				
				Для Каждого Стр Из Табл Цикл
					
					Отбор = Новый Структура;
					Отбор.Вставить("Номенклатура", Стр.Номенклатура);
					НайдСтроки = НовыйДокЗаказ.Товары.НайтиСтроки(Отбор);
					КУменьшению = Стр.Нехватка;
					
					Для Каждого строка из НайдСтроки Цикл
						
						Если КУменьшению >0 тогда
							
							Если Строка.Количество > КУменьшению тогда
								
								НоваяСтрока = НовыйДокЗаказ.Товары.Добавить();
								ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка,, "КлючСтроки");
								Строка.Количество = Строка.Количество - КУменьшению;
								НоваяСтрока.Количество = КУменьшению;
								НоваяСтрока.Размещение = "";
								НоваяСтрока.СерияНоменклатуры = "";
								
								КУменьшению = 0;
								СтрСумма = НоваяСтрока.Количество * НоваяСтрока.Цена;
								НоваяСтрока.Сумма = СтрСумма;
								ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НоваяСтрока, НовыйДокЗаказ);
								
								СтрСумма = Строка.Количество * Строка.Цена;
								Строка.Сумма = СтрСумма;
								ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(Строка, НовыйДокЗаказ);
								
							Иначе
								
								КУменьшению = КУменьшению - Строка.Количество;
								Строка.Размещение = "";
								Строка.СерияНоменклатуры = "";
								
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЦикла;
					
				КонецЦикла;
				
			КонецЕсли;
			
			СтрокиДляУдаления = Новый Массив;	
			
			Если ЗначениеЗаполнено(НовыйДокЗаказ.Грузополучатель) И НовыйДокЗаказ.Грузополучатель.ТоварыТолькоСоСклада Тогда
				
				Для Каждого СтрТовары Из НовыйДокЗаказ.Товары Цикл
					
					
					Если СтрТовары.Цена = 0 Или СтрТовары.Сумма = 0 Или Не ЗначениеЗаполнено(СтрТовары.Размещение) Тогда
						СтрокиДляУдаления.Добавить(СтрТовары);
					КонецЕсли;
					
				КонецЦикла;
				
			Иначе
				
				Для Каждого СтрТовары Из НовыйДокЗаказ.Товары Цикл
					
					Если СтрТовары.Цена = 0 Или СтрТовары.Сумма = 0 Тогда
						СтрокиДляУдаления.Добавить(СтрТовары);
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
			ТЗТовары = НовыйДокЗаказ.Товары.Выгрузить();
			ТЗТовары.Свернуть("Номенклатура,Цена,Комментарий", "Количество");
			ТЗТовары.Колонки.Добавить("Артикул"); //НормализованныйКод
			ТЗТовары.Колонки.Добавить("Заказ");
			ТЗТовары.Колонки.Добавить("СтрЗаказ");
			
			Если ТЗТовары.Количество() = 0 Тогда
				Возврат ТЗТовары;
			КонецЕсли;	
			
			Попытка
				
				НовыйДокЗаказ.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Оперативный);
				
				Для Каждого СтрТз Из ТЗТовары Цикл
					
					СтрТз.Артикул = СтрТз.Номенклатура.Артикул;
					СтрТз.Заказ = НовыйДокЗаказ.Ссылка;
					СтрТз.СтрЗаказ = СокрЛП(НовыйДокЗаказ.Номер) + "/" + Формат(НовыйДокЗаказ.Дата, "ДЛФ=D");
					
				КонецЦикла;
				
				Если БазаПолучатель <> "УТ10Казань" И СтрокиДляУдаления.Количество() > 0 Тогда
					КорректировкаЗаказаПокупателя(НовыйДокЗаказ.Ссылка, СтрокиДляУдаления);
				КонецЕсли;
				
			Исключение
				
				НовыйДокЗаказ.Записать(РежимЗаписиДокумента.Запись);
				НовыйДокЗаказ.УстановитьПометкуУдаления(Истина);
				ТЗТовары.Очистить(); 
				ЗаписьЖурналаРегистрации("Web-сервис GoodsReserve", УровеньЖурналаРегистрации.Ошибка,,, "Веб-сервис:Выполнение. ЗарезервироватьТовары Магистраль . Описание ошибки - "+СокрЛП(ОписаниеОшибки())+"");  
				
			КонецПопытки;
			
			Возврат ТЗТовары;			
			
		КонецЕсли;
		
	Иначе
		
		ТЗТовары = Документы.ЗаказПокупателя.ПустаяСсылка().Товары.Выгрузить();
		ТЗТовары.Свернуть("Номенклатура,Цена,Комментарий", "Количество");
		ТЗТовары.Колонки.Добавить("Артикул"); //НормализованныйКод
		ТЗТовары.Колонки.Добавить("Заказ");
		ТЗТовары.Колонки.Добавить("СтрЗаказ");
		
		Возврат ТЗТовары;
		
	КонецЕсли;
	
КонецФункции

Процедура КорректировкаЗаказаПокупателя(ДокЗаказ, СтрокиДляУдаления)
	
	ДокументКорректировки = Документы.КорректировкаЗаказаПокупателя.СоздатьДокумент();
	ДокументКорректировки.Заполнить(ДокЗаказ);
	ДокументКорректировки.Дата = ТекущаяДата();
	ДокументКорректировки.Комментарий = "Документ сформирован автоматически при загрузке заказа покупателя из УТ10";
	ДокументКорректировки.ВалютаДокумента = ДокЗаказ.ВалютаДокумента; 
	
	ДокументКорректировки.Товары.Очистить();
	
	Для Каждого СтрУдаления Из СтрокиДляУдаления Цикл 
		
		НоваяСтрока = ДокументКорректировки.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрУдаления);
		НоваяСтрока.Причина = Перечисления.ПричиныКорректировкиСборки.ОтказПоставщика;
		НоваяСтрока.Количество = -НоваяСтрока.Количество;
		НоваяСтрока.КоличествоМест = -НоваяСтрока.КоличествоМест;
		НоваяСтрока.Сумма = -НоваяСтрока.Сумма;
		НоваяСтрока.СуммаНДС = -НоваяСтрока.СуммаНДС;
		
	КонецЦикла;	
	
	ДокументКорректировки.Услуги.Очистить();
	ДокументКорректировки.ВозвратнаяТара.Очистить();
	ДокументКорректировки.Записать(РежимЗаписиДокумента.Проведение); 
	
КонецПроцедуры

Функция СоздатьЗаказПокупателя(ДанныеШапки, ДанныеТЧТовары)
	
	//+Шульман А. 21.01.2025 #UT10-5059  
	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис GoodsReserve", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Запуск. СоздатьЗаказПокупателя");
	
	СтруктураДанных = МСКWEB.СозданиеЗаказПокупателя(ДанныеШапки, ДанныеТЧТовары);
	РезультатВыполнения = ДанныеВJSONХранилище(СтруктураДанных);
	
	ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();    
	
	ЗаписьЖурналаРегистрации("Web-сервис GoodsReserve", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. СоздатьЗаказПокупателя " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
	
	Возврат РезультатВыполнения;
	//-Шульман А. 21.01.2025 #UT10-5059

КонецФункции

Функция СозданиеЗаказПокупателя(ДанныеШапки, ДанныеТЧТовары)
	
	//+Шульман А. 21.01.2025 #UT10-5059   
	//+Шульман А. 21.02.2025 #UT10-5103
	// Функция перемещена в МСКWEB    
	//-Шульман А. 21.02.2025 #UT10-5103
	
	Результат = Новый Структура("Результат, ТекстОшибки, ГУИДЗаказа, НомерЗаказа, Создан, Проведен, ПомеченНаУдаление, ДанныеТЧТовары", 
	Ложь, "", "", "", Ложь, Ложь, Ложь, Неопределено);  
	
	ВидыПроцессов = Новый Соответствие();
	ВидыПроцессов.Вставить("Возврат неликвида ТОХ через WMS", Перечисления.ВидыПроцессов.ВозвратНеликвидаТОХчерезWMS);  
	ВидыПроцессов.Вставить("Возврат неликвида ТОХ напрямую поставщику", Перечисления.ВидыПроцессов.ВозвратНеликвидаТОХНапрямуюПоставщику);  
	
	СтрШапка = ХранилищеJSONВСтруктуру(ДанныеШапки);
	
	ГУИДДокумента = СтрШапка.ГУИДДокумента;
	
	МассивДанных = ХранилищеJSONВСтруктуру(ДанныеТЧТовары);   
	тзДанныеТЧТовары = ОбщегоНазначения.ПреобразоватьМассивВТаблицуЗначений(МассивДанных);
	
	ДокСсылка = Неопределено;        
	СкладГруппа = Константы.ОсновнойСклад.Получить();
	
	Если Не ПустаяСтрока(ГУИДДокумента) И СтрДлина(ГУИДДокумента) = 36 Тогда   
		
		Попытка
			ДокСсылка = Документы.ЗаказПокупателя.ПолучитьСсылку(Новый УникальныйИдентификатор(ГУИДДокумента));
		Исключение
			
			Результат.ТекстОшибки = "Ошибка при получении заказа с ГУИД " + ГУИДДокумента + ". " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			Возврат Результат;
			
		КонецПопытки;
	
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДокСсылка) Тогда
		
		
		ДокОбъект = Документы.ЗаказПокупателя.СоздатьДокумент();
		ДокОбъект.Дата = ТекущаяДата();
		ДокОбъект.Организация = Константы.ОсновнаяОрганизация.Получить();
		ДокОбъект.КроссДокинг = СтрШапка.КроссДокинг;  
		ДокОбъект.ВидПроцесса = ВидыПроцессов.Получить(СтрШапка.ВидПроцесса);    
		
		Если ЗначениеЗаполнено(СтрШапка.КонтрагентКодМДМ) Тогда
			ДокОбъект.Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту("КодМДМ", СтрШапка.КонтрагентКодМДМ);           
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрШапка.ДоговорКонтрагентаКодМДМ) Тогда
			ДокОбъект.ДоговорКонтрагента = Справочники.ДоговорыКонтрагентов.НайтиПоРеквизиту("КодМДМ", СтрШапка.ДоговорКонтрагентаКодМДМ);
		КонецЕсли;      
		
		ДокОбъект.Грузополучатель = Справочники.Контрагенты.НайтиПоРеквизиту("КодМДМ", СтрШапка.ПартнерКодМДМ); 
		ДокОбъект.СпособДоставки = ДокОбъект.Грузополучатель.СпособДоставки;
		ДокОбъект.ИсточникЗаказа        	= Справочники.ИсточникиЗаказов.НайтиПоРеквизиту("КодИсточника", 5);   
		ДокОбъект.ВалютаДокумента 			= ДокОбъект.ДоговорКонтрагента.ВалютаВзаиморасчетов; 

		ДокОбъект.КурсВзаиморасчетов 		= 1;
		ДокОбъект.КратностьВзаиморасчетов 	= 1;
		ДокОбъект.СуммаВключаетНДС 			= Истина;
		ДокОбъект.УчитыватьНДС 				= Истина;
		ДокОбъект.СкладГруппа				= СкладГруппа;   
		ДокОбъект.Подразделение = УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(ПараметрыСеанса.ТекущийПользователь, "ОсновноеПодразделение");
		ДокОбъект.Ответственный         	= ПараметрыСеанса.ТекущийПользователь;
		
		ДокОбъект.Комментарий = СтрШапка.Комментарий;  
		
		Результат.Создан = Истина;
		
	Иначе
		ДокОбъект = ДокСсылка.ПолучитьОбъект();
	КонецЕсли;     
	
	
	Запрос = Новый Запрос;     
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	тзДанныеТЧТовары.НоменклатураКодМДМ,
	|	тзДанныеТЧТовары.Количество,
	|	тзДанныеТЧТовары.Цена,
	|	тзДанныеТЧТовары.КлючСтроки
	|ПОМЕСТИТЬ ВТ_ДанныеТЧТовары
	|ИЗ
	|	&тзДанныеТЧТовары КАК тзДанныеТЧТовары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(Номенклатура.Ссылка, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК Номенклатура,
	|	ЕСТЬNULL(Номенклатура.ЕдиницаХраненияОстатков, ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)) КАК ЕдиницаИзмерения,  
	|	ЕСТЬNULL(Номенклатура.СтавкаНДС, ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка)) КАК СтавкаНДС,
	|	ВТ_ДанныеТЧТовары.НоменклатураКодМДМ,
	|	ВТ_ДанныеТЧТовары.Количество,
	|	ВТ_ДанныеТЧТовары.Цена,
	|	ВТ_ДанныеТЧТовары.КлючСтроки,
	|	ВЫБОР
	|		КОГДА Номенклатура.Ссылка ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК НайденаНоменклатура
	|ПОМЕСТИТЬ ВТ_Товары
	|ИЗ
	|	ВТ_ДанныеТЧТовары КАК ВТ_ДанныеТЧТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|		ПО (Номенклатура.КодМДМ = ВТ_ДанныеТЧТовары.НоменклатураКодМДМ)
	|        И  НЕ Номенклатура.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Товары.Номенклатура КАК Номенклатура,
	|	ВТ_Товары.Номенклатура.КодМДМ КАК НоменклатураКодМДМ,
	|	ПартииТоваровНаСкладахОстатки.СерияНоменклатуры,
	|	ПартииТоваровНаСкладахОстатки.КоличествоОстаток,
	|	ПартииТоваровНаСкладахОстатки.СтоимостьОстаток,
	|	ВТ_Товары.Количество КАК Количество,
	|	ВТ_Товары.Цена КАК Цена,
	|	ВТ_Товары.КлючСтроки КАК КлючСтроки,
	|	ВТ_Товары.НайденаНоменклатура КАК НайденаНоменклатура
	|ИЗ
	|	ВТ_Товары КАК ВТ_Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПартииТоваровНаСкладах.Остатки(
	|				&МоментДокумента,
	|				Номенклатура В
	|					(ВЫБРАТЬ
	|						ВТ_Товары.Номенклатура
	|					ИЗ
	|						ВТ_Товары КАК ВТ_Товары
	|					ГДЕ
	|						ВТ_Товары.НайденаНоменклатура)) КАК ПартииТоваровНаСкладахОстатки
	|		ПО ВТ_Товары.Номенклатура = ПартииТоваровНаСкладахОстатки.Номенклатура
	|			И (ВТ_Товары.НайденаНоменклатура)
	|ГДЕ
	|	ПартииТоваровНаСкладахОстатки.КоличествоОстаток > 0";
	
	ТЧТовары = Новый ТаблицаЗначений;
	ТЧТовары.Колонки.Добавить("НоменклатураКодМДМ", ОбщегоНазначения.ОписаниеТипаСтрока(36));
	ТЧТовары.Колонки.Добавить("КлючСтроки", ОбщегоНазначения.ОписаниеТипаЧисло(5, 0, ДопустимыйЗнак.Неотрицательный));
	ТЧТовары.Колонки.Добавить("Количество", ОбщегоНазначения.ОписаниеТипаЧисло(15, 3, ДопустимыйЗнак.Неотрицательный));	
	ТЧТовары.Колонки.Добавить("Цена", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2, ДопустимыйЗнак.Неотрицательный));	
	
	Для каждого тзСтрока Из тзДанныеТЧТовары Цикл
		
		ДобСтрока = ТЧТовары.Добавить();
		ЗаполнитьЗначенияСвойств(ДобСтрока, тзСтрока);
		
	КонецЦикла; 
	
	Запрос.УстановитьПараметр("тзДанныеТЧТовары", ТЧТовары);    
	Запрос.УстановитьПараметр("МоментДокумента", ?(ЗначениеЗаполнено(ДокСсылка), ДокСсылка.МоментВремени(), Неопределено));
	
	ОстаткиПартий = Запрос.Выполнить().Выгрузить();  
	ТаблицаРаспределения = Запрос.МенеджерВременныхТаблиц.Таблицы["ВТ_Товары"].ПолучитьДанные().Выгрузить();
	
	ДокОбъект.Товары.Очистить(); 
	
	ТЧТовары = Новый ТаблицаЗначений;
	ТЧТовары.Колонки.Добавить("НоменклатураКодМДМ", ОбщегоНазначения.ОписаниеТипаСтрока(36));
	ТЧТовары.Колонки.Добавить("КодСтроки", ОбщегоНазначения.ОписаниеТипаЧисло(5, 0, ДопустимыйЗнак.Неотрицательный));
	ТЧТовары.Колонки.Добавить("Количество", ОбщегоНазначения.ОписаниеТипаЧисло(15, 3, ДопустимыйЗнак.Неотрицательный));	
	
	Для Каждого СтрокаТовара из ТаблицаРаспределения Цикл 
		
		СтруктураОтбора 	= Новый Структура("Номенклатура", СтрокаТовара.Номенклатура);
		МассивСтрокПартий 	= ОстаткиПартий.НайтиСтроки(СтруктураОтбора); 
		
		Распределить = СтрокаТовара.Количество;
		
		Если МассивСтрокПартий.Количество() > 0 Тогда 		
			
			Для каждого СтрокаПартия из МассивСтрокПартий Цикл                      
				
				Если Распределить <= 0 Тогда 
					Прервать;
				КонецЕсли;    
				
				Если СтрокаПартия.КоличествоОстаток <= 0 Тогда 
					Продолжить;
				КонецЕсли;	
				
				МожноРаспределить 	= Мин(Распределить, СтрокаПартия.КоличествоОстаток);
				
				НоваяСтрока = ДокОбъект.Товары.Добавить();
				НоваяСтрока.Номенклатура 		= СтрокаТовара.Номенклатура; 
				НоваяСтрока.ЕдиницаИзмерения    = СтрокаТовара.ЕдиницаИзмерения;  
				НоваяСтрока.ЕдиницаИзмеренияМест = СтрокаТовара.ЕдиницаИзмерения; 
				//+Гавриленков В. 18.12.2025 #UT10-5598
				//НоваяСтрока.СтавкаНДС           = СтрокаТовара.СтавкаНДС;
				НоваяСтрока.СтавкаНДС           = УчетНДС.ПолучитьСтавкуНДСПоНоменклатуре(СтрокаТовара.Номенклатура, ?(ЗначениеЗаполнено(ДокСсылка), ДокСсылка.Дата, Неопределено));
				//-Гавриленков В. 18.12.2025 #UT10-5598
				НоваяСтрока.Коэффициент         = СтрокаТовара.ЕдиницаИзмерения.Коэффициент;
				НоваяСтрока.СерияНоменклатуры 	= СтрокаПартия.СерияНоменклатуры;
				НоваяСтрока.Количество 			= МожноРаспределить;     
				НоваяСтрока.КоличествоМест		= МожноРаспределить;
				НоваяСтрока.Цена 				= СтрокаТовара.Цена;
				НоваяСтрока.Сумма 				= СтрокаТовара.Цена * МожноРаспределить;        
				НоваяСтрока.КлючСтроки          = СтрокаПартия.КлючСтроки;
				НоваяСтрока.Размещение 			= СкладГруппа;

				
				ДобСтрока = ТЧТовары.Добавить();
				ДобСтрока.НоменклатураКодМДМ = СтрокаТовара.НоменклатураКодМДМ;     
				ДобСтрока.Количество = МожноРаспределить;
				ДобСтрока.КодСтроки = СтрокаТовара.КлючСтроки;
				
				Распределить = Распределить - МожноРаспределить; 
				
				СтрокаПартия.КоличествоОстаток = СтрокаПартия.КоличествоОстаток - МожноРаспределить;
				
			КонецЦикла;    
			
		КонецЕсли;
		
	КонецЦикла;	       
	
	Попытка
		ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		
		Результат.Создан = Ложь;
		Результат.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
		
	КонецПопытки;
	
	Если ДокОбъект.Товары.Количество() Тогда
		
		Попытка
			
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);  
			Результат.Проведен = Истина;
			
		Исключение
			Результат.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		
	Иначе
		
		Попытка

			ДокОбъект.УстановитьПометкуУдаления(Истина);
			Результат.ПомеченНаУдаление = Истина;   
			Результат.Проведен = Истина;
		
		Исключение
			
			Результат.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			Возврат Результат;
			
		КонецПопытки;
		
	КонецЕсли;   
	
	
	Результат.ГУИДЗаказа = Строка(ДокОбъект.Ссылка.УникальныйИдентификатор());
	Результат.НомерЗаказа = ДокОбъект.Номер;             
	
	Результат.ДанныеТЧТовары = МодульРегламентныхЗаданий.ТаблицуВМассив(ТЧТовары);
	
	Результат.Результат = Истина;
	
	Возврат Результат;
	//-Шульман А. 21.01.2025 #UT10-5059

КонецФункции

Функция ПолучитьКорректировки(Параметры)
//+Белов А. 23.10.2025 #UT10-5464

	СтруктураВозврата = Новый Структура("Результат, Сообщение, Данные", Ложь, "", Неопределено);
	
	ПараметрыСтруктура = ХранилищеJSONВСтруктуру(Параметры);
	
	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис GoodsReserve", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Запуск. ПолучитьКорректировки " + ОбщегоНазначения.ВернутьJSON(ПараметрыСтруктура));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КорректировкаРеализации.Ссылка
	|ИЗ
	|	Документ.КорректировкаРеализации КАК КорректировкаРеализации
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	|		ПО КорректировкаРеализации.Ссылка = ЗначенияСвойствОбъектов.Объект
	|			И (ЗначенияСвойствОбъектов.Свойство = &Свойство)
	|ГДЕ
	|	КорректировкаРеализации.Проведен
	|	И КорректировкаРеализации.Дата >= &ДатаНачала
	|	И КорректировкаРеализации.Грузополучатель.КодМДМ = &КодМДМ
	|	И ВЫБОР
	|			КОГДА &ВсеДокументы
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЕСТЬNULL(ЗначенияСвойствОбъектов.Значение, ЛОЖЬ) = ЛОЖЬ
	|		КОНЕЦ
	|	И КорректировкаРеализации.ДоговорКонтрагента.КодМДМ = &КодМДМДоговора";
	
	Запрос.УстановитьПараметр("ДатаНачала", XMLЗначение(Тип("Дата"), ПараметрыСтруктура.ДатаНачала));
	Запрос.УстановитьПараметр("КодМДМ", ПараметрыСтруктура.КодМДМГрузополучателя);
	Запрос.УстановитьПараметр("КодМДМДоговора", ПараметрыСтруктура.КодМДМДоговора);
	Запрос.УстановитьПараметр("Свойство", ПланыВидовХарактеристик.СвойстваОбъектов.АвтоматическиСозданКорПТУВСторБазе);
	//+Гавриленков В. 29.01.2026 #UT10-5671
	Запрос.УстановитьПараметр("ВсеДокументы", ПараметрыСтруктура.Свойство("ВсеДокументы"));
	//-Гавриленков В. 29.01.2026 #UT10-5671
		
	Выборка = Запрос.Выполнить().Выбрать();     
	
	МассивДокументов = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		МассивДокументов.Добавить(ПолучитьСтруктуруПоКорректировке(Выборка.Ссылка));		
	КонецЦикла;
	
	СтруктураВозврата.Данные = МассивДокументов;
	СтруктураВозврата.Результат = Истина;
	
	РезультатВыполнения = ДанныеВJSONХранилище(СтруктураВозврата);
	
	ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();    
	
	ЗаписьЖурналаРегистрации("Web-сервис GoodsReserve", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. ПолучитьКорректировки " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0") + " " + ОбщегоНазначения.ВернутьJSON(СтруктураВозврата));
	
	Возврат РезультатВыполнения;

	//-Белов А. 23.10.2025 #UT10-5464		
КонецФункции 

Функция ПолучитьСтруктуруПоКорректировке(Корректировка)
//+Белов А. 23.10.2025 #UT10-5464		

	Данные = Новый Структура;                                                                            
	Данные.Вставить("ГУИД", Строка(Корректировка.УникальныйИдентификатор()));
	Данные.Вставить("ОснованиеГУИД", Строка(Корректировка.ДокументРеализации.УникальныйИдентификатор()));
	
	СФ = УчетНДС.НайтиПодчиненныйСчетФактуру(Корректировка, "СчетФактураВыданный");
	
	Если ЗначениеЗаполнено(СФ) Тогда
		
		Данные.Вставить("НомерСФ", ОбщегоНазначения.ПолучитьНомерНаПечать(СФ));
		Данные.Вставить("ДатаСФ", СФ.Дата);
		
	Иначе
		
		Данные.Вставить("НомерСФ", "");
		Данные.Вставить("ДатаСФ", "");
	
	КонецЕсли;  
	
	СтрокиТоваров = Корректировка.Товары.НайтиСтроки(Новый Структура("ОтражатьТоварныйУчет", Истина));
	
	МассивТоваров = Новый Массив;
	
	Для каждого Стр Из СтрокиТоваров Цикл
		
		СтруктураТовара = Новый Структура;
		СтруктураТовара.Вставить("КодМДМ", Стр.Номенклатура.КодМДМ);
		СтруктураТовара.Вставить("Количество", Стр.Количество);
		СтруктураТовара.Вставить("Сумма", Стр.Сумма);
		СтруктураТовара.Вставить("СуммаНДС", Стр.СуммаНДС);
		СтруктураТовара.Вставить("Цена", Стр.Цена); 
		СтруктураТовара.Вставить("Серия", Стр.СерияНоменклатуры.Наименование);
		
		МассивТоваров.Добавить(СтруктураТовара);
		
	КонецЦикла;
	
	Данные.Вставить("Товары", МассивТоваров);
	
	Возврат Данные;

//-Белов А. 23.10.2025 #UT10-5464			
КонецФункции

Функция КорректировкаЗагружена(ГУИД)
//+Белов А. 23.10.2025 #UT10-5464				
	Ссылка = Документы.КорректировкаРеализации.ПолучитьСсылку(Новый УникальныйИдентификатор(ГУИД));
	
	Если Ссылка <> Неопределено Тогда
		Документы.КорректировкаРеализации.УстановитьСвойствоОтправленоВСтороннююБазу(Ссылка);
	КонецЕсли;
//-Белов А. 23.10.2025 #UT10-5464				
КонецФункции



Функция ТаблицуВМассив(Таблица)
	
	МассивДанных = Новый Массив;
	
	Для Каждого ТекСтрока Из Таблица Цикл
		
		СтруктураДанных = Новый Структура;
		
		Для Каждого Колонка ИЗ Таблица.Колонки Цикл
			
			Если ЭтоСсылка(ТекСтрока[Колонка.Имя]) Тогда
				
				Если Колонка.Имя = "Номенклатура" ИЛИ Колонка.Имя = "Ссылка" ИЛИ Колонка.Имя = "Заказ" ИЛИ Колонка.Имя = "ЗаказПокупателя" Тогда
					СтруктураДанных.Вставить(Колонка.Имя, ?(ТекСтрока[Колонка.Имя] = NULL, "", Строка(ТекСтрока[Колонка.Имя].УникальныйИдентификатор())));
				Иначе
					СтруктураДанных.Вставить(Колонка.Имя, Строка(ТекСтрока[Колонка.Имя]));
				КонецЕсли;
				
			ИначеЕсли ТипЗнч(ТекСтрока[Колонка.Имя]) = Тип("Дата") Тогда
				СтруктураДанных.Вставить(Колонка.Имя, Строка(ТекСтрока[Колонка.Имя]));
			Иначе
				СтруктураДанных.Вставить(Колонка.Имя, ТекСтрока[Колонка.Имя]);
			КонецЕсли;
			
		КонецЦикла;
		
		МассивДанных.Добавить(СтруктураДанных);
		
	КонецЦикла;         
	
	Возврат МассивДанных;
	
КонецФункции

Функция ЭтоСсылка(Значение)
	
	//+Белов А. 11.01.2025 #UT10-5006 - добавить тип Массив у условие
	Если ТипЗнч(Значение) = Тип("Число") ИЛИ ТипЗнч(Значение) = Тип("Строка") ИЛИ ТипЗнч(Значение) = Тип("Дата") 
		ИЛИ ТипЗнч(Значение) = Тип("Булево") ИЛИ ТипЗнч(Значение) = Тип("Структура") ИЛИ ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

Функция ДанныеВJSONХранилище(Данные)
	
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	JsonСтрока = ЗаписьJSON.Закрыть(); 	
	
	ДанныеВозврат = Новый ХранилищеЗначения(JsonСтрока, Новый СжатиеДанных(9));
	
	Возврат ДанныеВозврат;
	
КонецФункции

Функция ХранилищеJSONВСтруктуру(Данные)
	
	ДанныеТекст = Данные.Получить();
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ДанныеТекст);
	ДанныеСтруктура = ПрочитатьJSON(ЧтениеJSON);
	
	Возврат ДанныеСтруктура;
	
КонецФункции

Функция ПолучитьРеализацииVer2(КодМДМдоговора , КодМДМКонтрагента)
	
	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис GoodsReserve", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Запуск. ПолучитьРеализацииVer2");
	
	СтруктураДанных = Новый Структура;
	
	ТЗРеализация = ПолучитьРеализацииПоДоговору(КодМДМдоговора, КодМДМКонтрагента);
	
	СтруктураДанных.Вставить("СписокДанных", ТаблицуВМассив(ТЗРеализация));
	
	//+Макрушин Е. 06.11.2025 #UT10-5491
	ТЗРеализацияСвернутая = ТЗРеализация.Скопировать(, "Ссылка");
	ТЗРеализацияСвернутая.Свернуть("Ссылка", "");

	КодыМаркировкиМассив = ПолучитьКодыМаркировкиДляВыгрузкиМассив(ТЗРеализацияСвернутая.ВыгрузитьКолонку("Ссылка"), Истина);
	
	СтруктураДополнительныеДанные = Новый Структура();
	СтруктураДополнительныеДанные.Вставить("КодыМаркировки", КодыМаркировкиМассив);
	
	СтруктураДанных.Вставить("ДополнительныеДанные", СтруктураДополнительныеДанные);
	//-Макрушин Е. 06.11.2025 #UT10-5491
	
	РезультатВыполнения = ДанныеВJSONХранилище(СтруктураДанных);
	ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ЗаписьЖурналаРегистрации("Web-сервис GoodsReserve", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. ПолучитьРеализацииVer2 " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
	
	Возврат РезультатВыполнения;
	
КонецФункции

Функция ПолучитьРеализацииПоДоговору(КодМДМдоговора , КодМДМКонтрагента)
	
	ДоговорКонтрагента = Справочники.ДоговорыКонтрагентов.НайтиПоРеквизиту("КодМДМ", КодМДМдоговора);   
	
	Контрагент = Неопределено;
	
	Если ЗначениеЗаполнено(КодМДМКонтрагента) Тогда
		
		Контрагент = МСКWEB.НайтиФилиалПоКодуИзПортала(СокрЛП(КодМДМКонтрагента));	
		
		Если Не ЗначениеЗаполнено(Контрагент) Тогда
			Контрагент = Справочники.Контрагенты.ПустаяСсылка();			
		КонецЕсли;
		
	КонецЕсли;
	
	ТекДата = ТекущаяДата();  
	//+Гавриленков В. 22.08.2025 #UT10-5394  
	КоличествоДней = Справочники.МТ_ПредопределенныеЗначения.ПолучитьЗначениеПоСвойству(Справочники.МТ_ПредопределенныеЗначения.НастройкиКоличестваДней, "Количество дней для получения реализаций по договору");
	ДатаНач = НачалоДня(ТекДата - ((?(ЗначениеЗаполнено(КоличествоДней), КоличествоДней, 3) * 24 * 60 * 60)));
	//ДатаНач = НачалоДня(ТекДата - (3*24*60*60));
	//-Гавриленков В. 22.08.2025 #UT10-5394
	ДатаКон = КонецДня(ТекДата);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеализацияТоваровУслугТовары.Ссылка,
	|	РеализацияТоваровУслугТовары.Номенклатура КАК Номенклатура,
	|	СУММА(РеализацияТоваровУслугТовары.Количество) КАК Количество,
	|	РеализацияТоваровУслугТовары.Цена,
	|	РеализацияТоваровУслугТовары.Комментарий,
	|	РеализацияТоваровУслугТовары.ЕдиницаИзмерения,
	|	РеализацияТоваровУслугТовары.Ссылка.Номер КАК НомерДокумента,
	|	РеализацияТоваровУслугТовары.Номенклатура.Артикул КАК Артикул,
	|	РеализацияТоваровУслугТовары.Ссылка.Дата КАК ДатаДокумента,
	|	РеализацияТоваровУслугТовары.СерияНоменклатуры.НомерГТД.Код КАК НомерГТДКод,
	|	РеализацияТоваровУслугТовары.СерияНоменклатуры.СтранаПроисхождения.Код КАК СтранаПроисхожденияКод,
	|	РеализацияТоваровУслугТовары.ЗаказПокупателя,
	|	СУММА(РеализацияТоваровУслугТовары.Сумма) КАК Сумма,
	|	СУММА(РеализацияТоваровУслугТовары.СуммаНДС) КАК СуммаНДС,
	|	РеализацияТоваровУслугТовары.Назначение
	|ПОМЕСТИТЬ ВТ_Реализации
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|ГДЕ
	|	РеализацияТоваровУслугТовары.Ссылка.Проведен = ИСТИНА
	|	И РеализацияТоваровУслугТовары.Ссылка.ДоговорКонтрагента = &ДоговорКонтрагента
	|	И РеализацияТоваровУслугТовары.Ссылка.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|	И РеализацияТоваровУслугТовары.ЗаказПокупателя.КроссДокинг = ЛОЖЬ
