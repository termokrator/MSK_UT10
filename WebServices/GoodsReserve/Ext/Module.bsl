				НеИспользоватьЦеновыеГруппы = Истина;
			КонецЕсли;		
			
			ЗаполнениеДокументов.ИзменитьЦеныВалюту(НовыйДокЗаказ,СпособЗаполненияЦен,СтруктураРеквизитовДокумента, , "Товары", ВалютаРегламентированногоУчета, , СтруктураВозвращаемыхЗначений,НовыйДокЗаказ.ДоговорКонтрагента.ТипЦен, ,НеИспользоватьЦеновыеГруппы);
			
			ТипЦенОпределен = ?(ЗначениеЗаполнено(НовыйДокЗаказ.ДоговорКонтрагента.ТипЦен), Истина, Ложь); 
			
		КонецЕсли;
		
		СтрокиДляПолногоУдаления = Новый Массив;  
