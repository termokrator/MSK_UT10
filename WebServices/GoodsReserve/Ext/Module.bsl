	////-Гавриленков В. 13.12.2024 #UT10-4972  
	
	//НомерСФКакНаПечать = ОбщегоНазначения.ЕстьУстановленноеЗначениеРеквизита(Справочники.МТ_ПредопределенныеЗначения.ОтправлятьДляПТУНомерСФКакНаПечать, ТекБаза);
	
	НомерСФКакНаПечать = (Справочники.МТ_ПредопределенныеЗначения.ОтправлятьДляПТУНомерСФКакНаПечать.Значение = Истина);
	//-Гавриленков В. 25.01.2025 #UT10-5060
	
	Для Каждого СтрЗапроса Из ТаблЗапроса Цикл  
		
		Если СтрЗапроса.Добавлена = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		//+Кабанов А.В. 23.06.2025 # UT10-5295		
		мВозвратПоставщикуБезРазбораВГП = ПолучитьВозвратПоставщикуБезРазбораВГП(СтрЗапроса.Ссылка);
		//-Кабанов А.В. 23.06.2025 # UT10-5295
		
		СтруктураПоиска = Новый Структура("Номенклатура, Заказ, Назначение", СтрЗапроса.Номенклатура, СтрЗапроса.ЗаказПокупателя, СтрЗапроса.Назначение);
		МассивНайденных = ТаблицаТоварыПоГрузовымМестамСНазначением.НайтиСтроки(СтруктураПоиска);    
		
		сч = 0;
		
		Пока сч < МассивНайденных.Количество() Цикл 
			
			СтрокаТаблицы = МассивНайденных.Получить(сч);    			
			
			Если СтрокаТаблицы.Количество <= 0 Тогда    
				
				МассивНайденных.Удалить(сч);
				ТаблицаТоварыПоГрузовымМестамСНазначением.Удалить(СтрокаТаблицы);
				
