	//ИЛИ (ТекБаза = Перечисления.НазваниеБазы.Тула)
	//ИЛИ (ТекБаза = Перечисления.НазваниеБазы.Калуга)
	//ИЛИ (ТекБаза = Перечисления.НазваниеБазы.Ярославль)
	////+Гавриленков В. 03.07.2024 #UT10-4590
	//ИЛИ (ТекБаза = Перечисления.НазваниеБазы.Воронеж2)
	////-Гавриленков В. 03.07.2024 #UT10-4590  
