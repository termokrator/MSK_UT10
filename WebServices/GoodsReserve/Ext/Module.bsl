			НовСтрока.Сумма = ЦенаПоСтроке * КоличествоОсталосьПогасить;  
			НовСтрока.СуммаНДС = НДСПоСтроке * КоличествоОсталосьПогасить;   
			
			ДополнитьСтрЗапроса(НовСтрока, ЭтоБазаНН, НомерСФКакНаПечать, НомерДокумента, СчетФактура, МассивТЕ);
			
		КонецЕсли;   
		
		ДополнитьСтрЗапроса(СтрЗапроса, ЭтоБазаНН, НомерСФКакНаПечать, НомерДокумента, СчетФактура, МассивТЕ);
		
