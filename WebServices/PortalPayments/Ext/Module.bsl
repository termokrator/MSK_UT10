Функция ОтправитьКопиюЧека(ИДДокумента, ТипДокумента, Email)
	
	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис PortalPayments", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Запуск. ОтправитьКопиюЧека");	
	ПараметрыЗапуска = "ИДДокумента: " + ИДДокумента + " ТипДокумента: " + ТипДокумента + " Email: " + Email;
	ЗаписьЖурналаРегистрации("Web-сервис PortalPayments", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Параметры. ОтправитьКопиюЧека" + Символы.ПС + ПараметрыЗапуска);

	СтруктураВозврата = Новый Структура("Результат, Сообщение", Ложь, ""); 
	
	Документ = Неопределено;
	
	Если ТипДокумента = "РеализацияТоваровУслуг" Тогда
		Документ = Документы.РеализацияТоваровУслуг.ПолучитьСсылку(Новый УникальныйИдентификатор(ИДДокумента));	
	ИначеЕсли ТипДокумента = "ПриходныйКассовыйОрдер" Тогда
		Документ = Документы.ПриходныйКассовыйОрдер.ПолучитьСсылку(Новый УникальныйИдентификатор(ИДДокумента));
	ИначеЕсли ТипДокумента = "КорректировкаРеализации" Тогда
		Документ = Документы.КорректировкаРеализации.ПолучитьСсылку(Новый УникальныйИдентификатор(ИДДокумента)); 
	ИначеЕсли ТипДокумента = "РасходныйКассовыйОрдер" Тогда
		Документ = Документы.РасходныйКассовыйОрдер.ПолучитьСсылку(Новый УникальныйИдентификатор(ИДДокумента));
	ИначеЕсли ТипДокумента = "ОплатаОтПокупателяПлатежнойКартой" Тогда
		Документ = Документы.ОплатаОтПокупателяПлатежнойКартой.ПолучитьСсылку(Новый УникальныйИдентификатор(ИДДокумента));
	КонецЕсли; 
	
	Если Документ = Неопределено Тогда
		СтруктураВозврата.Сообщение = "Не определен тип документа"; 
	ИначеЕсли Документ.ПолучитьОбъект() = Неопределено Тогда
		СтруктураВозврата.Сообщение = "Не найден документ по ГУИД";
	Иначе      
		
		Если Не ЗначениеЗаполнено(Email) Тогда 			
			Email = Чеки.ПолучитьEmail(Документ.Контрагент);
		КонецЕсли;  
		
		Если ЗначениеЗаполнено(Email) Тогда
			
			Чеки.ДобавитьДокументВОчередьОтправкиКопийЧеков(Документ, Email);
			
			СтруктураВозврата.Результат = Истина;
			СтруктураВозврата.Сообщение = "Отправка копии чека в очередь успешно поставлена";  
			
		Иначе
			СтруктураВозврата.Сообщение = "Не заполнен Email для получения чеков";			
		КонецЕсли;
		
	КонецЕсли;  
	
	ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("Web-сервис PortalPayments", УровеньЖурналаРегистрации.Информация,,, "Веб-сервис:Завершение. ОтправитьКопиюЧека " + Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0") + Символы.ПС + ПараметрыЗапуска);
	
	Возврат Чеки.ВернутьJSON(СтруктураВозврата);
	
КонецФункции

///////////////////Вспомогательные функции///////////////////  
Функция ПроверитьРеализациюНаВозможностьОплаты(ПромРеализация)
	
	Если НЕ ПромРеализация.Проведен	Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	ЗапросСтатусаДоставки = Новый Запрос;
	ЗапросСтатусаДоставки.Текст =
	"ВЫБРАТЬ
	|	РеализацияТоваровУслуг.Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК СвойствоСтатусДоставки
	|		ПО РеализацияТоваровУслуг.Ссылка = СвойствоСтатусДоставки.Объект
	|			И (СвойствоСтатусДоставки.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СвойстваОбъектов.СтатусДоставки))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК СвойствоЗаблокирован
	|		ПО РеализацияТоваровУслуг.Ссылка = СвойствоЗаблокирован.Объект
	|			И (СвойствоЗаблокирован.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СвойстваОбъектов.ЗаблокированоДляОплаты))
	|ГДЕ
	|	РеализацияТоваровУслуг.Ссылка = &Ссылка
	|	И НЕ ЕСТЬNULL(СвойствоСтатусДоставки.Значение, ЗНАЧЕНИЕ(Перечисление.СтатусыДоставки.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.СтатусыДоставки.ТоварНеДоставлен)
	|	И ЕСТЬNULL(СвойствоЗаблокирован.Значение, ЛОЖЬ) = ЛОЖЬ";  
	
	ЗапросСтатусаДоставки.УстановитьПараметр("Ссылка",ПромРеализация); 

	Возврат НЕ ЗапросСтатусаДоставки.Выполнить().Пустой();
	
КонецФункции

Функция ПроверитьДокументСуществует(ИДПлатежа)  

	ВозвращаемоеЗначение = Истина;

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОплатаОтПокупателяПлатежнойКартой.Ссылка
	|ИЗ
	|	Документ.ОплатаОтПокупателяПлатежнойКартой КАК ОплатаОтПокупателяПлатежнойКартой
	|ГДЕ
	|	ОплатаОтПокупателяПлатежнойКартой.ПометкаУдаления = ЛОЖЬ
	|	И ОплатаОтПокупателяПлатежнойКартой.ИДПлатежа = &ИДПлатежа
	|	И ОплатаОтПокупателяПлатежнойКартой.ВидОперации = &ВидОперации";
	
	Запрос.УстановитьПараметр("ИДПлатежа", ИДПлатежа); 
	Запрос.УстановитьПараметр("ВидОперации", Перечисления.ВидыОперацийОплатаОтПокупателяПлатежнойКартой.ОплатаПокупателя); 
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		ВозвращаемоеЗначение = Ложь;
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;	

