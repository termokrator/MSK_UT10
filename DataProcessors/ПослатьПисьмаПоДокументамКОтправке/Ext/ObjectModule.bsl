Перем ЗапросДоговоровКонтрагента;

Процедура ОтправкаПисем() Экспорт 
	
	УчетнаяЗапись = Константы.ОсновнаяУчетнаяЗаписьЭлектроннойПочты.Получить();
	
	Если  Константы.НеОтправлятьПочту.Получить() ИЛИ НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		Возврат;
	КонецЕсли;
	
	Профиль = УправлениеЭлектроннойПочтой.ПолучитьИнтернетПочтовыйПрофиль(УчетнаяЗапись);
	
	Почта = Новый ИнтернетПочта; 
	
	Попытка
		Почта.Подключиться(Профиль);
	Исключение
		Возврат; 
	КонецПопытки;
	
	
	МакетДолгов = ПолучитьМакет("ПисьмоОДолгах");
	ТабДок = Новый ТабличныйДокумент;
	
	Если Константы.База.Получить()= Перечисления.НазваниеБазы.Воронеж Тогда 
		НазваниеОрганизации = "Реестр предстоящих И ПРОСРОЧЕННЫХ платежей фирме ООО ""Москворечье Воронеж""";
	Иначе		
		НазваниеОрганизации = "Реестр предстоящих И ПРОСРОЧЕННЫХ платежей фирме ООО ""Москворечье-Трейдинг"" (" + Константы.База.Получить() + ")";
	КонецЕсли;		
	
	Если Константы.ИспользоватьДанныеБиллингаДляПисемОДолгах.Получить() Тогда
		
		ЗапросКонтрагентов = Новый Запрос;
		ЗапросКонтрагентов.Текст =
		"ВЫБРАТЬ
		|	ПисьмоОДолгах.ДоговорКонтрагента.Владелец КАК Контрагент
		|ПОМЕСТИТЬ ВТ_КонтрагентыКоторымУжеОтправленыПисьма
		|ИЗ
		|	РегистрСведений.ПисьмоОДолгах КАК ПисьмоОДолгах
		|ГДЕ
		|	ПисьмоОДолгах.Количество > 0
		|	И ПисьмоОДолгах.Период МЕЖДУ &Период1 И &Период2
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ДокументыКОтправкеПоЭП.Объект КАК Справочник.Контрагенты) КАК Контрагенты,
		|	ДокументыКОтправкеПоЭП.ЭлАдрес КАК ЭлАдрес,
		|	ВТ_КонтрагентыКоторымУжеОтправленыПисьма.Контрагент КАК КонтрагентОтправлен
		|ПОМЕСТИТЬ ВТ_Контрагенты
		|ИЗ
		|	РегистрСведений.ДокументыКОтправкеПоЭП КАК ДокументыКОтправкеПоЭП
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КонтрагентыКоторымУжеОтправленыПисьма КАК ВТ_КонтрагентыКоторымУжеОтправленыПисьма
		|		ПО ДокументыКОтправкеПоЭП.Объект = ВТ_КонтрагентыКоторымУжеОтправленыПисьма.Контрагент
		|ГДЕ
		|	ДокументыКОтправкеПоЭП.Объект ССЫЛКА Справочник.Контрагенты
		|	И ДокументыКОтправкеПоЭП.ВидВложения = ЗНАЧЕНИЕ(Перечисление.ВидВложения.Долги)
		|	И ДокументыКОтправкеПоЭП.ПопытокЗагрузки = 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Контрагенты.Контрагенты КАК Контрагент,
		|	ВТ_Контрагенты.ЭлАдрес
		|ИЗ
		|	ВТ_Контрагенты КАК ВТ_Контрагенты
		|ГДЕ
		|	НЕ ВТ_Контрагенты.Контрагенты = ЗНАЧЕНИЕ(справочник.Контрагенты.ПустаяСсылка)
		|	И НЕ ВТ_Контрагенты.ЭлАдрес = """"
		|	И ВТ_Контрагенты.КонтрагентОтправлен ЕСТЬ NULL";
		
		ЗапросКонтрагентов.УстановитьПараметр("Период1", НачалоДня(ТекущаяДата()));
		ЗапросКонтрагентов.УстановитьПараметр("Период2", КонецДня(ТекущаяДата()));
		
		РезультатЗапросаКонтрагентов = ЗапросКонтрагентов.Выполнить();
		
		Если НЕ РезультатЗапросаКонтрагентов.Пустой() Тогда
			
			ВыборкаКонтрагентов = РезультатЗапросаКонтрагентов.Выбрать();
			
			Пока ВыборкаКонтрагентов.Следующий() Цикл
				
				ТабличныйДокументДолга = СформироватьТабличныйДокументСДолгамиКонтрагентаБиллинг(ВыборкаКонтрагентов.Контрагент, НазваниеОрганизации);
				
				Если ТабличныйДокументДолга   <>  Неопределено Тогда 
					
					Сообщение = Новый ИнтернетПочтовоеСообщение;
					Сообщение.Тема = "Реестр предстоящих и ПРОСРОЧЕННЫХ платежей фирме ООО ""Москворечье Трейдинг""!!";
					
					Если ВидОперации = 0 Тогда 
						ЭлПочтаКонтрагента = ВыборкаКонтрагентов.ЭлАдрес ;
					Иначе 
						ЭлПочтаКонтрагента  = Адрес;				
					КонецЕсли;
					
					МассивАдресов = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(ЭлПочтаКонтрагента, ";");
					
					Для Каждого ТекАдрес Из МассивАдресов Цикл
						Сообщение.Получатели.Добавить(ТекАдрес); 
					КонецЦикла;
					
					Сообщение.Отправитель = УчетнаяЗапись.АдресЭлектроннойПочты;
					
					ЗаголовокФайла = Строка(Новый УникальныйИдентификатор) + ".xlsx";
					ТабличныйДокументДолга.Записать(КаталогВременныхФайлов() + ЗаголовокФайла, ТипФайлаТабличногоДокумента.XLSX);
					ДвоичныеДанныеФайла = Новый ДвоичныеДанные(КаталогВременныхФайлов() + ЗаголовокФайла);
					
					Сообщение.Вложения.Добавить(ДвоичныеДанныеФайла, "Просроченные_И_Предстоящие платежи.XLSX");
					
					Попытка
						УдалитьФайлы(КаталогВременныхФайлов() + ЗаголовокФайла);
					Исключение
					КонецПопытки;
					
					Попытка
						
						Почта.Послать(Сообщение);
						ТекстСообщения = "Отправлено письмо " + ВыборкаКонтрагентов.Контрагент + " на адрес " + ЭлПочтаКонтрагента 
						            + " с уведомлением о предстоящих и просроченных платежах";
						ЗаписьЖурналаРегистрации("Отправка электронной почты.Успешно", УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
						
						Попытка
							
							НаборЗаписей = РегистрыСведений.ПисьмоОДолгах.СоздатьНаборЗаписей(); 
							НаборЗаписей.Отбор.ДоговорКонтрагента.Установить(ВыборкаКонтрагентов.Контрагент.ОсновнойДоговорКонтрагента); 
							НаборЗаписей.Отбор.Период.Установить(ТекущаяДата()); 
							
							НовЗапись = НаборЗаписей.Добавить(); 
							НовЗапись.ДоговорКонтрагента = ВыборкаКонтрагентов.Контрагент.ОсновнойДоговорКонтрагента; 
							НовЗапись.Период = ТекущаяДата(); 
							НовЗапись.ВремяОтправки = Формат(ТекущаяДата(), "ДЛФ=T");
							НовЗапись.Количество = 1; 
							
							НаборЗаписей.Записать(Истина); 	
							
						Исключение
							
							Если НеОчищать = Ложь Тогда 
								
								Попытка	
									
									НаборЗаписей = РегистрыСведений.ДокументыКОтправкеПоЭП.СоздатьНаборЗаписей(); 
									НаборЗаписей.Отбор.Объект.Установить(ВыборкаКонтрагентов.Контрагент);
									НаборЗаписей.Отбор.ВидВложения.Установить(Перечисления.ВидВложения.Долги);
									НаборЗаписей.Записать(); 
									
								Исключение
									Сообщить(ОписаниеОшибки());
								КонецПопытки;
								
							КонецЕсли;
							
						КонецПопытки;
						
					Исключение
						
						Если НеОчищать = Ложь Тогда 
							
							Попытка	
								
								НаборЗаписей = РегистрыСведений.ДокументыКОтправкеПоЭП.СоздатьНаборЗаписей(); 
								НаборЗаписей.Отбор.Объект.Установить(ВыборкаКонтрагентов.Контрагент);
								НаборЗаписей.Отбор.ВидВложения.Установить(Перечисления.ВидВложения.Долги);
								НаборЗаписей.Записать(); 
								
							Исключение
								Сообщить(ОписаниеОшибки());
							КонецПопытки;
							
						КонецЕсли;
						
					КонецПопытки;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	Иначе
		
		// Расчет долгов для контрагентов и отправка письма с напоминанием, что предстоят оплаты
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ПисьмоОДолгах.ДоговорКонтрагента.Владелец КАК Контрагент
		|ПОМЕСТИТЬ ВТ_КонтрагентыКоторымУжеОтправленыПисьма
		|ИЗ
		|	РегистрСведений.ПисьмоОДолгах КАК ПисьмоОДолгах
		|ГДЕ
		|	ПисьмоОДолгах.Количество > 0
		|	И ПисьмоОДолгах.Период МЕЖДУ &Период1 И &Период2
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ДокументыКОтправкеПоЭП.Объект КАК Справочник.Контрагенты) КАК Контрагенты,
		|	ДокументыКОтправкеПоЭП.ЭлАдрес КАК ЭлАдрес
		|ПОМЕСТИТЬ ВТ_Контрагенты
		|ИЗ
		|	РегистрСведений.ДокументыКОтправкеПоЭП КАК ДокументыКОтправкеПоЭП
		|ГДЕ
		|	ДокументыКОтправкеПоЭП.Объект ССЫЛКА Справочник.Контрагенты
		|	И ДокументыКОтправкеПоЭП.ВидВложения = &ВидВложения
		|	И ДокументыКОтправкеПоЭП.ПопытокЗагрузки = 0
		|	И НЕ ДокументыКОтправкеПоЭП.Объект В
		|				(ВЫБРАТЬ
		|					ВТ_КонтрагентыКоторымУжеОтправленыПисьма.Контрагент
		|				ИЗ
		|					ВТ_КонтрагентыКоторымУжеОтправленыПисьма КАК ВТ_КонтрагентыКоторымУжеОтправленыПисьма)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДоговорыКонтрагентов.Ссылка
		|ПОМЕСТИТЬ Договора
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	ДоговорыКонтрагентов.Владелец В
		|			(ВЫБРАТЬ
		|				ВТ_Контрагенты.Контрагенты
		|			ИЗ
		|				ВТ_Контрагенты КАК ВТ_Контрагенты)
		|	И ДоговорыКонтрагентов.ДопустимоеЧислоДнейЗадолженности > 0
		|	И ДоговорыКонтрагентов.ВестиПоДокументамРасчетовСКонтрагентом
		|	И ДоговорыКонтрагентов.КонтролироватьЧислоДнейЗадолженности
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстатки.СуммаВзаиморасчетовОстаток КАК СуммаВзаиморасчетовОстаток,
		|	ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстатки.Контрагент КАК Контрагент,
		|	ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстатки.ДокументРасчетовСКонтрагентом КАК ДокументРасчетовСКонтрагентом,
		|	ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстатки.ДоговорКонтрагента.ДопустимоеЧислоДнейЗадолженности КАК ДопустимоеЧислоДнейЗадолженности
		|ПОМЕСТИТЬ ДолгиПоДокументам
		|ИЗ
		|	РегистрНакопления.ВзаиморасчетыСКонтрагентамиПоДокументамРасчетов.Остатки(
		|			,
		|			ДоговорКонтрагента В
		|					(ВЫБРАТЬ
		|						Т.Ссылка
		|					ИЗ
		|						Договора КАК Т)
		|				И ДокументРасчетовСКонтрагентом ССЫЛКА Документ.РеализацияТоваровУслуг) КАК ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстатки
		|ГДЕ
		|	ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстатки.СуммаВзаиморасчетовОстаток > 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(Таб.ДокументРасчетов) КАК КоличествоДней,
		|	Таб.ДокументРасчетов1 КАК ДокументРасчетов
		|ПОМЕСТИТЬ ТабДнейПроскочкиПоДокументу
		|ИЗ
		|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		ДолгиПоДокументам.ДокументРасчетовСКонтрагентом КАК ДокументРасчетов,
		|		ДолгиПоДокументам.ДокументРасчетовСКонтрагентом КАК ДокументРасчетов1,
		|		РегламентированныйПроизводственныйКалендарь.ДатаКалендаря КАК ДатаКалендаря
		|	ИЗ
		|		ДолгиПоДокументам КАК ДолгиПоДокументам,
		|		РегистрСведений.РегламентированныйПроизводственныйКалендарь КАК РегламентированныйПроизводственныйКалендарь
		|	ГДЕ
		|		ДолгиПоДокументам.ДокументРасчетовСКонтрагентом.Дата <= РегламентированныйПроизводственныйКалендарь.ДатаКалендаря
		|		И РегламентированныйПроизводственныйКалендарь.ДатаКалендаря <= &ТекущаяДата
		|		И (РегламентированныйПроизводственныйКалендарь.ВидДня = &РабочийДень
		|				ИЛИ РегламентированныйПроизводственныйКалендарь.ВидДня = &ПредпраздничныйДень)) КАК Таб
		|
		|СГРУППИРОВАТЬ ПО
		|	Таб.ДокументРасчетов1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДолгиПоДокументам.СуммаВзаиморасчетовОстаток,
		|	ДолгиПоДокументам.Контрагент,
		|	ДолгиПоДокументам.ДокументРасчетовСКонтрагентом КАК ДокументРасчетовСКонтрагентом,
		|	ДолгиПоДокументам.ДопустимоеЧислоДнейЗадолженности,
		|	ЕСТЬNULL(ТабДнейПроскочкиПоДокументу.КоличествоДней, 0) КАК Задолженность
		|ИЗ
		|	ДолгиПоДокументам КАК ДолгиПоДокументам
		|		ЛЕВОЕ СОЕДИНЕНИЕ ТабДнейПроскочкиПоДокументу КАК ТабДнейПроскочкиПоДокументу
		|		ПО ДолгиПоДокументам.ДокументРасчетовСКонтрагентом = ТабДнейПроскочкиПоДокументу.ДокументРасчетов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Контрагенты.Контрагенты КАК Контрагент,
		|	ВТ_Контрагенты.ЭлАдрес
		|ИЗ
		|	ВТ_Контрагенты КАК ВТ_Контрагенты";
		
		
		Запрос.УстановитьПараметр("РабочийДень", Перечисления.ВидыДнейПроизводственногоКалендаря.Рабочий);
		Запрос.УстановитьПараметр("ПредпраздничныйДень", Перечисления.ВидыДнейПроизводственногоКалендаря.Предпраздничный);
		
		Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
		Запрос.УстановитьПараметр("ВидВложения", Перечисления.ВидВложения.Долги);
		
		СписокВидовВложения  = Новый Массив;
		СписокВидовВложения.Добавить(Перечисления.ВидВложения.Счет);
		СписокВидовВложения.Добавить(Перечисления.ВидВложения.ТОРГ12);
		СписокВидовВложения.Добавить(Перечисления.ВидВложения.УПД);	
		
		Запрос.УстановитьПараметр("СписокВидовВложения", СписокВидовВложения);
		Запрос.УстановитьПараметр("Период1", НачалоДня(ТекущаяДата()));
		Запрос.УстановитьПараметр("Период2", КонецДня(ТекущаяДата()));
		
		Пакет = Запрос.ВыполнитьПакет();
		ТаблицаКонтрагентовДляПисьма = Пакет[6].Выгрузить(); 	
		Результат = Пакет[5].Выгрузить();  
		
		Для Каждого ТекСтр Из ТаблицаКонтрагентовДляПисьма Цикл
			
			Сообщение = Новый ИнтернетПочтовоеСообщение;
			Сообщение.Тема = "Реестр предстоящих и ПРОСРОЧЕННЫХ платежей фирме ООО ""Москворечье Трейдинг""!!";
			
			Если ВидОперации = 0 Тогда 
				МылоКонтрагента = ТекСтр.ЭлАдрес;
			Иначе 
				МылоКонтрагента = Адрес;				
			КонецЕсли;
			
			МассивАдресов = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(МылоКонтрагента, ";");
			
			Для Каждого ТекАдрес Из МассивАдресов Цикл
				Сообщение.Получатели.Добавить(ТекАдрес); 
			КонецЦикла;
			
			Сообщение.Отправитель = УчетнаяЗапись.АдресЭлектроннойПочты;
			ТабличныйДокументДолга = СформироватьТабличныйДокументСДолгамиКонтрагента(ТекСтр.Контрагент, Результат, НазваниеОрганизации);
			
			Если ТабличныйДокументДолга <> Неопределено Тогда 
				
				ЗаголовокФайла = Строка(Новый УникальныйИдентификатор) + ".xlsx";
				ТабличныйДокументДолга.Записать(КаталогВременныхФайлов() + ЗаголовокФайла, ТипФайлаТабличногоДокумента.XLSX);
				
				ДД = Новый ДвоичныеДанные(КаталогВременныхФайлов() + ЗаголовокФайла);
				Сообщение.Вложения.Добавить(ДД, "Просроченные_И_Предстоящие платежи.XLSX");
				
				Попытка
					УдалитьФайлы(КаталогВременныхФайлов() + ЗаголовокФайла);
				Исключение
				КонецПопытки;
				
				Попытка
					
					Почта.Послать(Сообщение);
					ТекстСообщения = "Отправлено письмо " + ТекСтр.Контрагент + " на адрес " + МылоКонтрагента + " с уведомлением о предстоящих и просроченных платежах";
					ЗаписьЖурналаРегистрации("Отправка электронной почты.Успешно", УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
					
					Попытка
						
						НаборЗаписей = РегистрыСведений.ПисьмоОДолгах.СоздатьНаборЗаписей(); 
						
						НаборЗаписей.Отбор.ДоговорКонтрагента.Установить(ТекСтр.Контрагент.ОсновнойДоговорКонтрагента); 
						НаборЗаписей.Отбор.Период.Установить(ТекущаяДата()); 
						
						НовЗапись = НаборЗаписей.Добавить(); 
						НовЗапись.ДоговорКонтрагента = ТекСтр.Контрагент.ОсновнойДоговорКонтрагента; 
						НовЗапись.Период = ТекущаяДата();
						НовЗапись.ВремяОтправки = Формат(ТекущаяДата(), "ДЛФ=T");
						НовЗапись.Количество = 1; 
						
						НаборЗаписей.Записать(Истина); 	
						
					Исключение
						
						Если НеОчищать = Ложь Тогда 
							
							Попытка	
								
								НаборЗаписей = РегистрыСведений.ДокументыКОтправкеПоЭП.СоздатьНаборЗаписей(); 
								НаборЗаписей.Отбор.Объект.Установить(ТекСтр.Контрагент);
								НаборЗаписей.Отбор.ВидВложения.Установить(Перечисления.ВидВложения.Долги);
								НаборЗаписей.Записать(); 
								
							Исключение
								Сообщить(ОписаниеОшибки());
							КонецПопытки;
							
						КонецЕсли;
						
					КонецПопытки;
					
				Исключение
					
					Если НеОчищать = Ложь Тогда 
						
						Попытка	
							
							НаборЗаписей = РегистрыСведений.ДокументыКОтправкеПоЭП.СоздатьНаборЗаписей(); 
							НаборЗаписей.Отбор.Объект.Установить(ТекСтр.Контрагент);
							НаборЗаписей.Отбор.ВидВложения.Установить(Перечисления.ВидВложения.Долги);
							НаборЗаписей.Записать(); 
							
						Исключение
							Сообщить(ОписаниеОшибки());
						КонецПопытки;
						
					КонецЕсли;
					
				КонецПопытки;
				
			Иначе 
				
				Если НеОчищать = Ложь Тогда 
					
					Попытка	
						
						НаборЗаписей = РегистрыСведений.ДокументыКОтправкеПоЭП.СоздатьНаборЗаписей(); 
						НаборЗаписей.Отбор.Объект.Установить(ТекСтр.Контрагент);
						НаборЗаписей.Отбор.ВидВложения.Установить(Перечисления.ВидВложения.Долги);
						НаборЗаписей.Записать(); 
						
					Исключение
						Сообщить(ОписаниеОшибки());
					КонецПопытки;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Почта.Отключиться();
	
	Если НеОчищать = Ложь Тогда 
		
		УстановитьПривилегированныйРежим(Истина);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 10000
		|	ДокументыКОтправкеПоЭП.Объект,
		|	ДокументыКОтправкеПоЭП.ВидВложения
		|ИЗ
		|	РегистрСведений.ДокументыКОтправкеПоЭП КАК ДокументыКОтправкеПоЭП
		|ГДЕ
		|	ДокументыКОтправкеПоЭП.ВидВложения = ЗНАЧЕНИЕ(Перечисление.ВидВложения.Долги)";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл 
			
			МенеджерЗаписи = РегистрыСведений.ДокументыКОтправкеПоЭП.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Объект = Выборка.Объект;
			МенеджерЗаписи.ВидВложения = Выборка.ВидВложения;
			МенеджерЗаписи.Прочитать();
			
			Если МенеджерЗаписи.Выбран() Тогда
				МенеджерЗаписи.Удалить();
			КонецЕсли;	
			
		КонецЦикла;
		
		УстановитьПривилегированныйРежим(Ложь);
		
	КонецЕсли;
	
КонецПроцедуры

Функция СформироватьТабличныйДокументСДолгамиКонтрагента(Контрагент,Результат,НазваниеОрганизации)
	
	ТабДок = Новый ТабличныйДокумент;
	Макет  = ПолучитьМакет("ПисьмоОДолгах");
	
	ОбластьМакетаШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьМакетаШапка.Параметры.НазваниеОрганизации = НазваниеОрганизации;
	СуммаПросрочено = 0;
	
	СтруктураОтбора = Новый Структура();
	СтруктураОтбора.Вставить("Контрагент", Контрагент);
	Строки =  Результат.НайтиСтроки(СтруктураОтбора);
	
	Если Строки.Количество() > 0 Тогда
		
		ТабДок.Вывести(ОбластьМакетаШапка);
		ЕстьХотьОдинДокументДолга = Ложь;
		
		Для каждого СчетчикСтрок Из Строки Цикл
			
			ДнейЗадолженности = ?(ЗначениеЗаполнено(СчетчикСтрок.ДопустимоеЧислоДнейЗадолженности), СчетчикСтрок.ДопустимоеЧислоДнейЗадолженности - 1, 0); 
			
			ДатаОплаты = ЗаполнениеДокументов.ОпределитьДату(СчетчикСтрок.ДокументРасчетовСКонтрагентом.Дата, ДнейЗадолженности);
			
			Если ДатаОплаты =Неопределено  Тогда 
				//  Возможно, не заполнен Произв. календарь на будущий год
				Возврат Неопределено;
			КонецЕсли;
			
			Если НачалоДня(ДатаОплаты) < НачалоДня(ТекущаяДата()) Тогда
				
				ОбластьМакетаСтрока = Макет.ПолучитьОбласть("Строка1");
				СуммаПросрочено =  СуммаПросрочено + СчетчикСтрок.СуммаВзаиморасчетовОстаток;
				
			Иначе 
				ОбластьМакетаСтрока = Макет.ПолучитьОбласть("Строка");
			КонецЕсли;
			
			ОбластьМакетаСтрока.Параметры.ДокументРасчетов = СчетчикСтрок.ДокументРасчетовСКонтрагентом;
			ОбластьМакетаСтрока.Параметры.СуммаДолга  =   СчетчикСтрок.СуммаВзаиморасчетовОстаток;
			ОбластьМакетаСтрока.Параметры.ДатаОплаты  =  Формат(ДатаОплаты, "ДЛФ=D");
			ТабДок.Вывести(ОбластьМакетаСтрока);
			
			ЕстьХотьОдинДокументДолга = Истина;
			
		КонецЦикла; 
		
		Если СуммаПросрочено > 0 Тогда 
			
			ОбластьМакетаИтог = Макет.ПолучитьОбласть("Итог");
			ОбластьМакетаИтог.Параметры.СуммаПросрочено = СуммаПросрочено;
			ТабДок.Вывести(ОбластьМакетаИтог);
			
		КонецЕсли;
		
		Если ЕстьХотьОдинДокументДолга Тогда 
			Возврат ТабДок;
		Иначе 
			Возврат Неопределено;
		КонецЕсли;
		
	Иначе 
		Возврат Неопределено;
	КонецЕсли; 
	
КонецФункции

Функция ПолучитьНеоплаченныеДокументы_V2(МассивДоговоров, ЗаписыватьВЖурнал = Истина) Экспорт 
	
	КолвоПопыток = 2;
	ЗадержкаПоВремени = 2;              
	
	СтруктураЗапроса = Новый Структура();
	СтруктураЗапроса.Вставить("agreements", МассивДоговоров);
	СтруктураЗапроса.Вставить("date_from" , СокрЛП(Формат(ДобавитьМесяц(ТекущаяДата(), -2), "ДЛФ=D")));
	СтруктураЗапроса.Вставить("date_to"   , Формат(ТекущаяДата(), "ДЛФ=D"));
	
	СтрокаЗапроса = "/api/v2/client/debt-documents";
	ПредставлениеЗапроса = "Получение неоплаченных документов";
	
	Для Сч = 1 По КолвоПопыток Цикл				
		
		СтруктураРезультата = AMQP_РаботаСДокументами.ОтправитьЗапросВБиллинг(СтрокаЗапроса, ПредставлениеЗапроса, "POST",,,, Чеки.ВернутьJSON(СтруктураЗапроса));
		
		Если СтруктураРезультата.Результат < 2 Тогда
			Прервать;
		КонецЕсли; 
		
		Если СтруктураРезультата.Результат = 2 И Сч <> КолвоПопыток Тогда
			AMQP_РаботаСДокументами.ПаузаИсполнения(ЗадержкаПоВремени);	
		КонецЕсли;  
		
	КонецЦикла; 		
	
	Если СтруктураРезультата.Данные <> Неопределено И ТипЗнч(СтруктураРезультата.Данные) = Тип("Массив") Тогда
		
		НеоплаченныеДокументы = Новый ТаблицаЗначений;
		НеоплаченныеДокументы.Колонки.Добавить("Контрагент");
		НеоплаченныеДокументы.Колонки.Добавить("ДоговорКонтрагента");
		НеоплаченныеДокументы.Колонки.Добавить("Документ");
		НеоплаченныеДокументы.Колонки.Добавить("ДатаДокумента");
		НеоплаченныеДокументы.Колонки.Добавить("ДатаОплаты");
		НеоплаченныеДокументы.Колонки.Добавить("Сумма");
		НеоплаченныеДокументы.Колонки.Добавить("ПросроченоДней");
		НеоплаченныеДокументы.Колонки.Добавить("Грузополучатель");
		НеоплаченныеДокументы.Колонки.Добавить("ДопустимоеЧислоДнейЗадолженности");
		НеоплаченныеДокументы.Колонки.Добавить("ДопустимаяСуммаЗадолженности");
		
		ИмяБазы = Константы.AMQP_ИдентификаторИнформацСистемы.Получить();
		
		БылиОшибки = Ложь;
		ТекстОшибок = "";
		
		Для Каждого Долг ИЗ СтруктураРезультата.Данные Цикл
			
			Попытка
				
				Дата = XmlЗначение(Тип("Дата"), Долг.date);
				
				НоваяСтрока = НеоплаченныеДокументы.Добавить();
				НоваяСтрока.Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту("КодМДМ", Долг.kontragent_mdm_id);
				НоваяСтрока.ДоговорКонтрагента = Справочники.ДоговорыКонтрагентов.НайтиПоРеквизиту("КодМДМ", Долг.agreement_mdm_id);
				
				ИмяБазыБиллинг = Долг.app_id;
				ТипДокумента = "";
				ТипДокументаПредставление = "";
				
				Если НРег(Долг.Type_Code) = "realization" Тогда
					
					ТипДокумента = "РеализацияТоваровУслуг";
					ТипДокументаПредставление = Метаданные.Документы[ТипДокумента].Синоним;
					
				КонецЕсли;
				
				Если НРег(ИмяБазыБиллинг) = НРег(Строка(ИмяБазы)) ИЛИ НРег(ИмяБазыБиллинг) = НРег(Строка(Константы.База.Получить())) Тогда
					
					Если ТипДокумента <> "" Тогда
						
						НоваяСтрока.Документ = Документы[ТипДокумента].ПолучитьСсылку(Новый УникальныйИдентификатор(Долг.source_id));
						ОбъектДокумент = НоваяСтрока.Документ.ПолучитьОбъект();
						
						Если ОбъектДокумент = Неопределено Тогда
							НоваяСтрока.Документ = ТипДокументаПредставление + " " + Долг.number + " от " + Формат(Дата, "ДЛФ=DT") + " - документ не найден";	
						Иначе
							НоваяСтрока.Грузополучатель = НоваяСтрока.Документ.Грузополучатель;
						КонецЕсли; 
						
					КонецЕсли; 
					
				Иначе
					НоваяСтрока.Документ = ТипДокументаПредставление + " " + Долг.number + " от " + Формат(Дата, "ДЛФ=DT") + " - " + ИмяБазыБиллинг;
				КонецЕсли;
				
				НоваяСтрока.ДатаДокумента  = Дата;
				НоваяСтрока.Сумма          = -Число(Долг.amount);
				НоваяСтрока.ПросроченоДней = Долг.overdue_days;  
				НоваяСтрока.ДатаОплаты     = XmlЗначение(Тип("Дата"), Долг.pay_delay_date);
				
			Исключение
				
				БылиОшибки = Истина;
				ТекстОшибок = ТекстОшибок + Символы.ПС + ОписаниеОшибки();
				
			КонецПопытки; 
			
		КонецЦикла;	
		
		Если БылиОшибки И ЗаписыватьВЖурнал Тогда
			ЗаписьЖурналаРегистрации("РаботаСБиллингом.Ошибка", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Ошибка выполнения запроса: " + ПредставлениеЗапроса + Символы.ПС + "Текст ошибки: " + ТекстОшибок + Символы.ПС + "Текст запроса: " + СтрокаЗапроса);
		КонецЕсли;
		
		СтруктураРезультата.Данные = НеоплаченныеДокументы;	
		
	КонецЕсли;     
	
	Возврат СтруктураРезультата; 
	
КонецФункции

Функция СформироватьТабличныйДокументСДолгамиКонтрагентаБиллинг(Контрагент, НазваниеОрганизации)
	
	ТабДок = Неопределено;
	
	ЗапросДоговоровКонтрагента.УстановитьПараметр("Владелец", Контрагент);
	
	РезультатЗапросаДоговоров = ЗапросДоговоровКонтрагента.Выполнить().Выгрузить();
	
	Если НЕ РезультатЗапросаДоговоров.Количество() = 0  Тогда
		
		МассивДоговоров = РезультатЗапросаДоговоров.ВыгрузитьКолонку("КодМДМ"); 
		
		СтруктураРезультатаДанныеКонтрагента = AMQP_РаботаСДокументами.ПолучитьДанныеПоМассивуДоговоров_V2(МассивДоговоров); 		
		
		Если СтруктураРезультатаДанныеКонтрагента.Результат = 0 Тогда                                                     		
			
			ДанныеМассив = СтруктураРезультатаДанныеКонтрагента.Данные;
			
			Если НЕ ДанныеМассив = Неопределено Тогда
				
				ТаблицаДанныхДолговБиллинг = ОбщегоНазначения.ПреобразоватьМассивВТаблицуЗначений(ДанныеМассив);
				
				СтруктураРезультатаНеоплаченныеДокументы = ПолучитьНеоплаченныеДокументы_V2(МассивДоговоров);
				ДанныеМассивНеоплаченныеДокументы = СтруктураРезультатаНеоплаченныеДокументы.Данные; 
				
				Если НЕ ДанныеМассивНеоплаченныеДокументы.Количество() = 0 Тогда
					
					СуммаПросрочено = 0;
					
					ТабДок = Новый ТабличныйДокумент;
					Макет= ПолучитьМакет("ПисьмоОДолгах");
					
					ОбластьМакетаШапка = Макет.ПолучитьОбласть("Шапка");
					ОбластьМакетаШапка.Параметры.НазваниеОрганизации = НазваниеОрганизации;
					ТабДок.Вывести(ОбластьМакетаШапка);
					
					Для Каждого СтрокаНеоплаченныхДокументов Из ДанныеМассивНеоплаченныеДокументы Цикл
						
						Если СтрокаНеоплаченныхДокументов.ПросроченоДней > 0 Тогда							
							
							ОбластьМакетаСтрока = Макет.ПолучитьОбласть("Строка1");
							СуммаПросрочено = СуммаПросрочено + СтрокаНеоплаченныхДокументов.Сумма; 
							
						Иначе 
							ОбластьМакетаСтрока = Макет.ПолучитьОбласть("Строка");
						КонецЕсли;
						
						ОбластьМакетаСтрока.Параметры.ДокументРасчетов = СтрокаНеоплаченныхДокументов.Документ;
						ОбластьМакетаСтрока.Параметры.СуммаДолга  =   СтрокаНеоплаченныхДокументов.Сумма;
						ОбластьМакетаСтрока.Параметры.ДатаОплаты  =  Формат(СтрокаНеоплаченныхДокументов.ДатаОплаты, "ДЛФ=D");
						ТабДок.Вывести(ОбластьМакетаСтрока);
						
						
					КонецЦикла;
					
					Если СуммаПросрочено > 0 Тогда 
						
						ОбластьМакетаИтог = Макет.ПолучитьОбласть("Итог");
						ОбластьМакетаИтог.Параметры.СуммаПросрочено = СуммаПросрочено;
						ТабДок.Вывести(ОбластьМакетаИтог);
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ТабДок;

КонецФункции 

ЗапросДоговоровКонтрагента = Новый Запрос;
ЗапросДоговоровКонтрагента.Текст =
"ВЫБРАТЬ
|	ДоговорыКонтрагентов.КодМДМ
|ИЗ
|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
|ГДЕ
|	ДоговорыКонтрагентов.Владелец = &Владелец";

