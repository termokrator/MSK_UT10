
Перем ФормаОбработки Экспорт;
Перем Соединение Экспорт;

Функция ВыполнитьОбмен(Текст,НачПериода,КонПериода) Экспорт
	
	Перем ИмяFTPСервера, ИмяКаталогаСервера;
	
	ЗагруженоЗаказов = 0;
	ВыгруженоЗаказов = 0;
	
	//Подключение к ftp
	ДатаОбмена = ТекущаяДата();
	ИДТекущегоОбмена = Новый УникальныйИдентификатор();
	НомерСообщенияПротокола = 0;
	НомерФайла = 0;
	ПроверитьНастройкиПодключения = УстановитьСоединениеСFTP(ИмяFTPСервера, ИмяКаталогаСервера);
	
	Если Не ПроверитьНастройкиПодключения Тогда
		Возврат "Ошибка проверки настройки FTP";
	КонецЕсли; 
	
	Текст.Записать(КаталогВременныхФайлов() + "PKO.txt", КодировкаТекста.ANSI);  //PKO
	ЗаголовокФайла = "ПродажиИДеньгиСамарыЗаПериод";
	
	Соединение.Записать(КаталогВременныхФайлов() + "PKO.txt", ИмяКаталогаСервера + "/" + СокрЛП(ИмяКаталогаФайлаДляМосквы) + "/PKO.txt"); 
	
	Возврат "Файл для Москвы выложен на FTP!";
	
КонецФункции

Функция УстановитьСоединениеСFTP(ИмяFTPСервера,ИмяКаталогаСервера) Экспорт
	
	ИмяКаталогаСервера = "";
	ИмяFTPСервера = "";
	
	// нужно по полному имени получить имя сервера и имя каталога
	ПолучитьИмяСервераИИмяКаталогаОбмена(НастройкаОбмена.FTPАдресОбмена, ИмяFTPСервера, ИмяКаталогаСервера);
	
	// если не задано имя сервера или каталога то невозможно обмениваться данными
	Если ПустаяСтрока(ИмяFTPСервера) Тогда
		
		ОписаниеОшибки = "Не задан сервер обмена информацией через FTP.";
		СоздатьЗаписьПротокола(ОписаниеОшибки, Перечисления.бит_ОперацияОбменаСПорталом.УстановкаСоединения);
		Возврат Ложь;
		
	КонецЕсли;
	
	// соединение
	Соединение = ВыполнитьFTPПодключениеКСерверу(ИмяFTPСервера, НастройкаОбмена);
	
	Если Соединение = Неопределено Тогда
		
		Сообщить("Не установлено соединение по протоколу FTP", СтатусСообщения.ОченьВажное);
		Возврат Ложь;
		
	КонецЕсли;
	
	// каталог проверяем
	НаличиеКаталога = ПроверитьНаличиеКаталогаНаFTPСервере(Соединение, ИмяКаталогаСервера);
	
	Если Не НаличиеКаталога Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	// Проверим подкаталог out
	НаличиеКаталога = ПроверитьНаличиеКаталогаНаFTPСервере(Соединение, ИмяКаталогаСервера + "/" + СокрЛП(ИмяКаталогаФайлаДляМосквы) + "/");
	
	Если Не НаличиеКаталога Тогда 
		
		Сообщить("Не найден каталог обмена с Москвой по имени " + ИмяКаталогаФайлаДляМосквы, СтатусСообщения.ОченьВажное);
		Возврат Ложь;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Процедура ПолучитьИмяСервераИИмяКаталогаОбмена(Знач ПолныйFTPАдрес, ИмяСервера, ИмяКаталога) Экспорт
	
	АдресОбмена = НормализоватьFTPАдрес(ПолныйFTPАдрес);
	
	// принцип получения адреса такой, все что до первой черты / или \ - это имя сервера, потом каталог
	АдресОбмена = СтрЗаменить(АдресОбмена, "\", "/");
	
	ПозицияПрямогоСлеша = Найти(АдресОбмена, "/");
	
	Если ПозицияПрямогоСлеша = 0 Тогда
		
		ИмяСервера = АдресОбмена;
		ИмяКаталога = "";
		
	Иначе
		
		ИмяСервера = Сред(АдресОбмена, 1, ПозицияПрямогоСлеша - 1);
		ИмяКаталога = Сред(АдресОбмена, ПозицияПрямогоСлеша);
		
		// последний должен быть слеш у имени каталога
		Если Сред(ИмяКаталога, СтрДлина(ИмяКаталога)) <> "/" Тогда
			ИмяКаталога = ИмяКаталога + "/";
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СоздатьЗаписьПротокола(Описание, ОперацияОбменаСПорталом,ЭтоОшибка = Истина) Экспорт
	
	Если ЗначениеЗаполнено(Описание) Тогда
		
		Если ФормаОбработки <> Неопределено Тогда
			ФормаОбработки.ЭлементыФормы.ПолеПротокола.ДобавитьСтроку(Строка(ОперацияОбменаСПорталом) + ": " + Описание);
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры

Функция ВыполнитьFTPПодключениеКСерверу(Знач ИмяFTPСервера, НастройкиОбмена)       
	
	#Если Клиент Тогда
		Состояние("Выполняется подключение к FTP: " + ИмяFTPСервера);
		СоздатьЗаписьПротокола("Выполняется подключение к FTP: " + ИмяFTPСервера, Перечисления.бит_ОперацияОбменаСПорталом.УстановкаСоединения, Ложь);
	#КонецЕсли
	
	Попытка
		
		Соединение = Новый FTPСоединение(ИмяFTPСервера, НастройкиОбмена.ПортFTPСоединения, 
		НастройкиОбмена.ПользовательFTPСоединения, НастройкиОбмена.ПарольFTPСоединения, , НастройкиОбмена.ПассивноеFTPСоединение);						
		
	Исключение
		
		// ошибка при подключении к ftp
		СоздатьЗаписьПротокола("Ошибка при подключении к FTP : " + ИмяFTPСервера + " ! " + ОписаниеОшибки(), Перечисления.бит_ОперацияОбменаСПорталом.УстановкаСоединения);
		Возврат Неопределено;
		
	КонецПопытки;
	
	СоздатьЗаписьПротокола("Соединение установлено: " + ИмяFTPСервера, Перечисления.бит_ОперацияОбменаСПорталом.УстановкаСоединения, Ложь);
	
	Возврат Соединение;
	
КонецФункции

Функция ПроверитьНаличиеКаталогаНаFTPСервере(Соединение, Знач ИмяКаталогаСервера)
	
	Если ПустаяСтрока(ИмяКаталогаСервера) Тогда
		Возврат Истина;
	КонецЕсли;
	
	//надо сначала проверить что сам каталог доступа есть
	Попытка
		МассивНайденныхКаталогов = Соединение.НайтиФайлы(ИмяКаталогаСервера, "");
	Исключение
		
		// ошибка при подключении к ftp
		СоздатьЗаписьПротокола("Ошибка при соединении с FTP : " + ИмяКаталогаСервера + " ! " + ОписаниеОшибки(), Перечисления.бит_ОперацияОбменаСПорталом.УстановкаСоединения);
		Возврат Ложь;
		
	КонецПопытки;
	
	Для Каждого НайденныйКаталог Из МассивНайденныхКаталогов Цикл
		
		// если не каталог - то дальше ищем
		Если НЕ НайденныйКаталог.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;
		
		// большие и маленькие буквы считаются различными
		Если НайденныйКаталог.ПолноеИмя + "/" <> ИмяКаталогаСервера Тогда
			Продолжить;
		КонецЕсли;
		
		Возврат Истина;
		
	КонецЦикла;
	
	// если не найден каталог для обмена
	СоздатьЗаписьПротокола("Не найден FTP каталог обмена информацией: " + ИмяКаталогаСервера, Перечисления.бит_ОперацияОбменаСПорталом.УстановкаСоединения);
	
	Возврат Ложь;
	
КонецФункции

Функция НормализоватьFTPАдрес(Знач FTPАдрес) Экспорт
	
	ИтоговыйАдрес = СокрЛП(FTPАдрес);
	ПозицияFTP = Найти(Врег(ИтоговыйАдрес), "FTP://");
	
	Если ПозицияFTP = 1 Тогда
		ИтоговыйАдрес = Сред(ИтоговыйАдрес, 7);	
	КонецЕсли;
	
	Возврат ИтоговыйАдрес;
	
КонецФункции

Функция ВыполнитьОтправку()Экспорт 
	
	РезультатРаботы = "";
	
	#Если Клиент Тогда
		
		Если Не ЗначениеЗаполнено(НастройкаОбмена) И ТипОтправки = "FTP" Тогда 
			Предупреждение("Задайте настройку обмена", 20);
			Возврат "";
		КонецЕсли;
		
		Если  ТипОтправки = "ПоПочте" И ПустаяСтрока(АдресПочтыВМоскве) Тогда
			Предупреждение("Задайте адрес электронной почты ", 20);
			Возврат "";
		КонецЕсли;
		
		Если НачПериода = Дата(1,1,1) Тогда
			Предупреждение("Задайте начало периода", 20);
			Возврат "";
		КонецЕсли;
		
		Если КонПериода = Дата(1,1,1) Тогда
			Предупреждение("Задайте конец периода", 20);
			Возврат "";
		КонецЕсли;
		
	#КонецЕсли
	
	Текст = Новый ТекстовыйДокумент;    
	мБаза = Константы.База.Получить();   
	ПериодСтр = Формат(НачПериода, "ДЛФ=D") + "@" +  Формат(КонПериода, "ДЛФ=D") + "@";
	
	Если мБаза = Перечисления.НазваниеБазы.Самара Тогда 	
		Текст.ДобавитьСтроку(ПериодСтр + "1");
	ИначеЕсли мБаза = Перечисления.НазваниеБазы.Владимир Тогда 
		Текст.ДобавитьСтроку(ПериодСтр + "2");
	ИначеЕсли мБаза = Перечисления.НазваниеБазы.Рязань Тогда 
		Текст.ДобавитьСтроку(ПериодСтр + "3");		
	ИначеЕсли мБаза = Перечисления.НазваниеБазы.Тула Тогда 
		Текст.ДобавитьСтроку(ПериодСтр + "4");			
	ИначеЕсли мБаза = Перечисления.НазваниеБазы.Ярославль Тогда 
		Текст.ДобавитьСтроку(ПериодСтр + "5");			
	КонецЕсли;
	
	// ВНИМАНИЕ! "1" на конце в Москве будет означать, что этот файл из Самары...
	
	ДатаН = НачалоДня(НачПериода);
	ДатаК = КонецДня(КонПериода);
	МассивКонтрагентов = КонтрагентыВключить.ВыгрузитьКолонку("Контрагент");
	
	// РАСХОДНЫЕ НАКЛАДНЫЕ
	Если РН Тогда
		
		Запрос  = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	РеализацияТоваровУслуг.Ссылка КАК ДокументРН,
		|	РеализацияТоваровУслуг.Дата,
		|	РеализацияТоваровУслуг.ДоговорКонтрагента.Код,
		|	РеализацияТоваровУслуг.Номер КАК НомерРН,
		|	РеализацияТоваровУслуг.ДоговорКонтрагента.Наименование,
		|	РеализацияТоваровУслуг.СуммаВключаетНДС КАК СуммаВключаетНДС,
		|	СчетФактураВыданный.Ссылка КАК ДокументСФВыданный,
		|	СчетФактураВыданный.Номер КАК НомерСФ,
		|	РеализацияТоваровУслуг.Контрагент,
		|	СчетФактураВыданный.Дата КАК ДатаСФ
		|ПОМЕСТИТЬ ДокРН
		|ИЗ
		|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
		|		ПОЛНОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|		ПО СчетФактураВыданный.ДокументОснование = РеализацияТоваровУслуг.Ссылка
		|ГДЕ
		|	РеализацияТоваровУслуг.Дата МЕЖДУ &ДатаН И &ДатаК
		|	И РеализацияТоваровУслуг.Проведен
		|	И РеализацияТоваровУслуг.Контрагент В(&СписокКонтрагентов)
		|	И СчетФактураВыданный.Проведен
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДокРН.ДокументРН КАК ДокументРН,
		|	ДокРН.Дата,
		|	ДокРН.НомерРН,
		|	ДокРН.Контрагент,
		|	ДокРН.ДоговорКонтрагентаКод,
		|	ДокРН.ДоговорКонтрагентаНаименование,
		|	ДокРН.СуммаВключаетНДС,
		|	ДокРНТовары.Номенклатура.КодПоБазеМоскоречье КАК НоменклатураКодПоБазеМоскоречье,
		|	ДокРНТовары.СерияНоменклатуры.Наименование КАК СерияНоменклатурыНаименование,
		|	ДокРНТовары.Количество,
		|	ДокРНТовары.Цена,
		|	ДокРНТовары.Сумма,
		|	ДокРНТовары.СуммаНДС,
		|	ДокРНТовары.НомерСтроки КАК НомерСтроки,
		|	ДокРН.ДокументСФВыданный,
		|	ДокРН.НомерСФ,
		|	ДокРН.ДатаСФ
		|ИЗ
		|	ДокРН КАК ДокРН
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Товары КАК ДокРНТовары
		|		ПО ДокРН.ДокументРН = ДокРНТовары.Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДокументРН,
		|	НомерСтроки
		|АВТОУПОРЯДОЧИВАНИЕ";
		
		Запрос.УстановитьПараметр("ДатаН", ДатаН);
		Запрос.УстановитьПараметр("ДатаК", ДатаК);
		
		Если МассивКонтрагентов.Количество()= 0  Тогда 
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "И РеализацияТоваровУслуг.Контрагент В(&СписокКонтрагентов)","");
		Иначе 
			Запрос.УстановитьПараметр("СписокКонтрагентов", МассивКонтрагентов);
		КонецЕсли;
		
		Выборка = Запрос.Выполнить().Выбрать();
		ТекДок = Неопределено;
		
		Пока Выборка.Следующий() Цикл 
			
			Если ТекДок <> Выборка.ДокументРН Тогда 
				
				ТекДок = Выборка.ДокументРН;
				Текст.ДобавитьСтроку(
				"1" + 
				"@" + Формат(Выборка.Дата,"ДЛФ=D") + 
				"@" + СокрЛП(Выборка.ДоговорКонтрагентаКод) + 
				"@" + СокрЛП(Выборка.НомерРН) + 
				"@" + СокрЛП(Выборка.ДоговорКонтрагентаНаименование) + 
				"@" + Выборка.НомерСФ + "_" + Прав(Год(Выборка.ДатаСФ),2) + 
				"@" + Выборка.СуммаВключаетНДС + 
				"@" + МСК.ДанныеОКонтрагентеДляСверкиСМосквой(Выборка.Контрагент,1));
				
			КонецЕсли;
			
			Текст.ДобавитьСтроку(
			"9" + 
			"@" + СокрЛП(Выборка.НоменклатураКодПоБазеМоскоречье) + 
			"@" + СтрЗаменить(СокрЛП(Выборка.СерияНоменклатурыНаименование),Символы.ПС,"") + 
			"@" + СокрЛП(СтрЗаменить(Выборка.Количество,Символы.НПП,"")) + 
			"@" + СокрЛП(СтрЗаменить(Выборка.Цена,Символы.НПП,"")) + 
			"@" + СокрЛП(СтрЗаменить(Выборка.Сумма,Символы.НПП,"") + 
			"@" + СокрЛП(СтрЗаменить(Выборка.СуммаНДС,Символы.НПП,""))));
			
		КонецЦикла;
		
	КонецЕсли;
	
	
	// Поступления ТиУ  МОСКВОРЕЧЬЕ
	КонтрагентМоскворечье = Неопределено;

	Если ЗначениеЗаполнено(Константы.ОсновнойПоставщик.Получить()) Тогда
		КонтрагентМоскворечье = Константы.ОсновнойПоставщик.Получить();
	КонецЕсли;		
	
	Если ПоступлениеТоваров и КонтрагентМоскворечье <> Неопределено Тогда
		
		Запрос  = Новый Запрос;
		Запрос.Текст =  "ВЫБРАТЬ
		|	ПоступлениеТоваровУслуг.Ссылка КАК Документ,
		|	ПоступлениеТоваровУслуг.Дата,
		|	ПоступлениеТоваровУслуг.ДоговорКонтрагента.Код КАК ДоговорКонтрагентаКод,
		|	ПоступлениеТоваровУслуг.Номер КАК Номер,
		|	ПоступлениеТоваровУслуг.ДоговорКонтрагента.Наименование КАК ДоговорКонтрагентаНаименование,
		|	ПоступлениеТоваровУслуг.СуммаВключаетНДС КАК СуммаВключаетНДС,
		|	ПоступлениеТоваровУслуг.Контрагент,
		|	ЕСТЬNULL(ПоступлениеТоваровУслугТовары.НомерСтроки, 0) КАК НомерСтроки,
		|	ЕСТЬNULL(ПоступлениеТоваровУслугТовары.Номенклатура.КодПоБазеМоскоречье, """") КАК НоменклатураКодПоБазеМоскоречье,
		|	ЕСТЬNULL(ПоступлениеТоваровУслугТовары.СерияНоменклатуры.Наименование, """") КАК СерияНоменклатурыНаименование,
		|	ЕСТЬNULL(ПоступлениеТоваровУслугТовары.Количество, 0) КАК Количество,
		|	ЕСТЬNULL(ПоступлениеТоваровУслугТовары.Цена, 0) КАК Цена,
		|	ЕСТЬNULL(ПоступлениеТоваровУслугТовары.Сумма, 0) КАК Сумма,
		|	ЕСТЬNULL(ПоступлениеТоваровУслугТовары.СуммаНДС, 0) КАК СуммаНДС
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг.Товары КАК ПоступлениеТоваровУслугТовары
