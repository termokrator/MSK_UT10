			"@" + СокрЛП(СтрЗаменить(Выборка.СерияОприходованиеНомерГТД, Символы.НПП, "")) + 
			"@" + СокрЛП(СтрЗаменить(Выборка.Цена, Символы.НПП, "")) + 
			"@" + СокрЛП(СтрЗаменить(Выборка.Количество, Символы.НПП, ""))
			);	
			
		КонецЦикла;
		
	КонецЕсли;
	
	
	//АвансовыйОтчет
	Если АвансовыйОтчет Тогда
		
		Запрос  = Новый Запрос;
		Запрос.Текст =  "ВЫБРАТЬ
		                |	АвансовыйОтчет.Ссылка КАК Документ,
		                |	АвансовыйОтчет.Дата,
		                |	АвансовыйОтчет.Номер КАК Номер,
		                |	АвансовыйОтчет.Комментарий,
		                |	АвансовыйОтчет.СуммаВключаетНДС,
		                |	АвансовыйОтчет.СуммаДокумента,
		                |	АвансовыйОтчет.ФизЛицо,
		                |	АвансовыйОтчет.ВалютаДокумента.Код,
		                |	АвансовыйОтчет.КурсДокумента,
		                |	АвансовыйОтчет.КратностьДокумента,
		                |	АвансовыйОтчет.УчитыватьНДС,
		                |	АвансовыйОтчет.НДСВключенВСтоимость,
		                |	АвансовыйОтчет.НазначениеАванса,
		                |	АвансовыйОтчетВыданныеАвансы.ДокументАванса,
		                |	АвансовыйОтчетВыданныеАвансы.Сумма,
		                |	АвансовыйОтчет.ФизЛицо.Наименование КАК ФизЛицоНаименование
		                |ИЗ
		                |	Документ.АвансовыйОтчет КАК АвансовыйОтчет
		                |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.АвансовыйОтчет.ВыданныеАвансы КАК АвансовыйОтчетВыданныеАвансы
		                |		ПО (АвансовыйОтчетВыданныеАвансы.Ссылка = АвансовыйОтчет.Ссылка)
		                |ГДЕ
		                |	АвансовыйОтчет.Дата МЕЖДУ &ДатаН И &ДатаК
		                |	И АвансовыйОтчет.Проведен
		                |
		                |УПОРЯДОЧИТЬ ПО
		                |	Документ,
		                |	АвансовыйОтчетВыданныеАвансы.НомерСтроки
		                |АВТОУПОРЯДОЧИВАНИЕ";
		
		Запрос.УстановитьПараметр("ДатаН", ДатаН);
		Запрос.УстановитьПараметр("ДатаК", ДатаК);
		
		Выборка = Запрос.Выполнить().Выбрать();
		ТекДок = Неопределено;
		
		Пока Выборка.Следующий() Цикл 
			
			Если ТекДок <> Выборка.Документ Тогда 
				
				ТекДок = Выборка.Документ;
				
				Текст.ДобавитьСтроку(
				"В" + 
				"@" + СокрЛП(Выборка.Номер) + 
				"@" + Формат(Выборка.Дата, "ДЛФ=D") + 
				"@" + СокрЛП(Выборка.Комментарий) + 
				"@" + Выборка.СуммаВключаетНДС + 
				"@" + Выборка.ВалютаДокументаКод + 
				"@" + Выборка.КурсДокумента + 
				"@" + Выборка.КратностьДокумента + 
				"@" + Выборка.УчитыватьНДС + 
				"@" + Выборка.НДСВключенВСтоимость + 
				"@" + СокрЛП(Выборка.НазначениеАванса) + 
				"@" + СокрЛП(Выборка.ФизЛицоНаименование));
				
				// Прочее
				Для каждого СтрПрочее Из ТекДок.Прочее Цикл
					
					Текст.ДобавитьСтроку(
					"Д" + 
					"@" + СокрЛП(СтрПрочее.ВидДокВходящий) + 
					"@" + Формат(СтрПрочее.ДатаВходящегоДокумента, "ДЛФ=D") + 
					"@" + СокрЛП(СтрПрочее.НомерВходящегоДокумента) + 
					"@" + СокрЛП(СтрПрочее.БланкСтрогойОтчетности) + 
					"@" + Формат(СтрПрочее.ДатаСФ, "ДЛФ=D") + 
					"@" + СокрЛП(СтрПрочее.НомерСФ) + 
					"@" + СокрЛП(СтрПрочее.Номенклатура.КодПоБазеМоскоречье) + 
					"@" + СокрЛП(СтрПрочее.Поставщик.IDАварда) + 
					"@" + СокрЛП(СтрПрочее.Содержание) + 
					"@" + СокрЛП(СтрПрочее.СтавкаНДС) + 
					"@" + СокрЛП(СтрПрочее.СтатьяЗатрат.Наименование) + 
					"@" + СокрЛП(СтрЗаменить(СтрПрочее.Сумма, Символы.НПП, "")) + 
					"@" + СокрЛП(СтрЗаменить(СтрПрочее.СуммаНДС, Символы.НПП, ""))
					);
					
				КонецЦикла;
				
			КонецЕсли;
			
			Если Выборка.ДокументАванса <> NULL Тогда 
				
				Текст.ДобавитьСтроку(
				"Г" + 
				"@" + СокрЛП(Выборка.ДокументАванса.Номер) + 
				"@" + СокрЛП(ТипЗнч(Выборка.ДокументАванса)) + 
				"@" + СокрЛП(СтрЗаменить(Выборка.Сумма, Символы.НПП, "")) 
				);	
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	//ТребованиеНакладная
	Если ТребованиеНакладная Тогда
		
		Запрос  = Новый Запрос;
		Запрос.Текст =  "ВЫБРАТЬ
		|	ТребованиеНакладная.Ссылка КАК Документ,
		|	ТребованиеНакладная.Дата,
		|	ТребованиеНакладная.Номер КАК Номер,
		|	ТребованиеНакладная.Комментарий,
		|	ТребованиеНакладная.НДСвСтоимостиТоваров,
		|	ТребованиеНакладнаяМатериалы.Номенклатура.КодПоБазеМоскоречье КАК НоменклатураКодПоБазеМоскоречье,
		|	ТребованиеНакладнаяМатериалы.СерияНоменклатуры.НомерГТД КАК СерияНоменклатурыНомерГТД,
		|	ТребованиеНакладнаяМатериалы.Количество,
		|	ТребованиеНакладнаяМатериалы.СтатьяЗатрат.Наименование КАК СтатьяЗатратНаименование
		|ИЗ
		|	Документ.ТребованиеНакладная КАК ТребованиеНакладная
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ТребованиеНакладная.Материалы КАК ТребованиеНакладнаяМатериалы
		|		ПО ТребованиеНакладнаяМатериалы.Ссылка = ТребованиеНакладная.Ссылка
		|ГДЕ
		|	ТребованиеНакладная.Дата МЕЖДУ &ДатаН И &ДатаК
		|	И ТребованиеНакладная.Проведен
		|
		|УПОРЯДОЧИТЬ ПО
		|	Документ,
		|	ТребованиеНакладнаяМатериалы.НомерСтроки
		|АВТОУПОРЯДОЧИВАНИЕ";
		
		Запрос.УстановитьПараметр("ДатаН", ДатаН);
		Запрос.УстановитьПараметр("ДатаК", ДатаК);
		
		Выборка = Запрос.Выполнить().Выбрать();
		ТекДок = Неопределено;
		
		Пока Выборка.Следующий() Цикл 
			
			Если ТекДок <> Выборка.Документ Тогда 
				
				ТекДок = Выборка.Документ;
				
				Текст.ДобавитьСтроку(
				"Е" + 
				"@" + СокрЛП(Выборка.Номер) + 
				"@" + Формат(Выборка.Дата, "ДЛФ=D") + 
				"@" + СокрЛП(Выборка.Комментарий) + 
				"@" + Выборка.НДСвСтоимостиТоваров);
				
			КонецЕсли;
			
			Текст.ДобавитьСтроку(
			"Ж" + 
			"@" + СокрЛП(Выборка.НоменклатураКодПоБазеМоскоречье) + 
			"@" + СокрЛП(СтрЗаменить(Выборка.СерияНоменклатурыНомерГТД, Символы.НПП, "")) + 
			"@" + СокрЛП(СтрЗаменить(Выборка.Количество, Символы.НПП, "")) + 
			"@" + СокрЛП(Выборка.СтатьяЗатратНаименование) 
			);	
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Поступления ТиУ НЕ МОСКВОРЕЧЬЕ
	
	Если ПоступлениеТоваровНеМоскворечье и КонтрагентМоскворечье <> Неопределено Тогда
		
		Запрос  = Новый Запрос;
		Запрос.Текст =  "ВЫБРАТЬ
		|	ПоступлениеТоваровУслуг.Ссылка КАК Документ,
		|	ПоступлениеТоваровУслуг.Дата,
		|	ПоступлениеТоваровУслуг.ДоговорКонтрагента.Код КАК ДоговорКонтрагентаКод,
		|	ПоступлениеТоваровУслуг.Номер КАК Номер,
		|	ПоступлениеТоваровУслуг.ДоговорКонтрагента.Наименование КАК ДоговорКонтрагентаНаименование,
		|	ПоступлениеТоваровУслуг.СуммаВключаетНДС КАК СуммаВключаетНДС,
		|	ПоступлениеТоваровУслуг.Контрагент,
		|	ЕСТЬNULL(ПоступлениеТоваровУслугТовары.НомерСтроки, 0) КАК НомерСтроки,
		|	ЕСТЬNULL(ПоступлениеТоваровУслугТовары.Номенклатура.КодПоБазеМоскоречье, """") КАК НоменклатураКодПоБазеМоскоречье,
		|	ЕСТЬNULL(ПоступлениеТоваровУслугТовары.СерияНоменклатуры.Наименование, """") КАК СерияНоменклатурыНаименование,
		|	ЕСТЬNULL(ПоступлениеТоваровУслугТовары.Количество, 0) КАК Количество,
		|	ЕСТЬNULL(ПоступлениеТоваровУслугТовары.Цена, 0) КАК Цена,
		|	ЕСТЬNULL(ПоступлениеТоваровУслугТовары.Сумма, 0) КАК Сумма,
		|	ЕСТЬNULL(ПоступлениеТоваровУслугТовары.СуммаНДС, 0) КАК СуммаНДС
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг.Товары КАК ПоступлениеТоваровУслугТовары
		|		ПО ПоступлениеТоваровУслуг.Ссылка = ПоступлениеТоваровУслугТовары.Ссылка
		|ГДЕ
		|	ПоступлениеТоваровУслуг.Дата МЕЖДУ &ДатаН И &ДатаК
		|	И ПоступлениеТоваровУслуг.Проведен
		|	И ПоступлениеТоваровУслуг.Контрагент В(&СписокКонтрагентов)
		|	И ПоступлениеТоваровУслуг.Контрагент <> &КонтрагентМоскворечье
		|
		|УПОРЯДОЧИТЬ ПО
		|	Документ,
		|	НомерСтроки
		|АВТОУПОРЯДОЧИВАНИЕ";
		
		Запрос.УстановитьПараметр("ДатаН", ДатаН);
		Запрос.УстановитьПараметр("ДатаК", ДатаК);
		Запрос.УстановитьПараметр("КонтрагентМоскворечье", КонтрагентМоскворечье);
		
		Если МассивКонтрагентов.Количество()= 0  Тогда 
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ПоступлениеТоваровУслуг.Контрагент В(&СписокКонтрагентов)","");
		Иначе 
			Запрос.УстановитьПараметр("СписокКонтрагентов", МассивКонтрагентов);
		КонецЕсли;
		
		Выборка = Запрос.Выполнить().Выбрать();
		ТекДок = Неопределено;
		
		Пока Выборка.Следующий() Цикл 
			
			Если ТекДок <> Выборка.Документ Тогда 
				
				ТекДок = Выборка.Документ;
				
				Текст.ДобавитьСтроку(
				"Ь" + 
				"@" + Формат(Выборка.Дата, "ДЛФ=D") + 
				"@" + СокрЛП(Выборка.ДоговорКонтрагентаКод) + 
				"@" + СокрЛП(Выборка.Номер) + 
				"@" + СокрЛП(Выборка.ДоговорКонтрагентаНаименование) + 
				"@" + Выборка.СуммаВключаетНДС + 
				"@" + МСК.ДанныеОКонтрагентеДляСверкиСМосквой(Выборка.Контрагент, 1));
				
			КонецЕсли;
			
			Если Выборка.НоменклатураКодПоБазеМоскоречье = "" И  Выборка.СерияНоменклатурыНаименование = "" Тогда 
				Продолжить;
			КонецЕсли;	
			
			Текст.ДобавитьСтроку(
			"Ю" + 
			"@" + СокрЛП(Выборка.НоменклатураКодПоБазеМоскоречье) + 
			"@" + СтрЗаменить(СокрЛП(Выборка.СерияНоменклатурыНаименование), Символы.ПС, "") + 
			"@" + СокрЛП(СтрЗаменить(Выборка.Количество, Символы.НПП, "")) + 
			"@" + СокрЛП(СтрЗаменить(Выборка.Цена, Символы.НПП, "")) + 
			"@" + СокрЛП(СтрЗаменить(Выборка.Сумма, Символы.НПП, "") + 
			"@" + СокрЛП(СтрЗаменить(Выборка.СуммаНДС, Символы.НПП, ""))) );
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ТипОтправки = "ПоПочте" Тогда
		
		ЗаголовокФайла = "ДокументыЗаПериод_с_" + Формат(НачПериода, "ДЛФ=D") + "_по_" + Формат(КонПериода, "ДЛФ=D") + ".txt";
		Текст.Записать(КаталогВременныхФайлов() + ЗаголовокФайла, КодировкаТекста.ANSI); 
		
		УчетнаяЗапись = Константы.ОсновнаяУчетнаяЗаписьЭлектроннойПочты.Получить();
		
		Если НЕ Константы.НеОтправлятьПочту.Получить() И ЗначениеЗаполнено(УчетнаяЗапись) И Текст.КоличествоСтрок() > 0 Тогда 
			
			Профиль = УправлениеЭлектроннойПочтой.ПолучитьИнтернетПочтовыйПрофиль(УчетнаяЗапись);
			Сообщение = Новый ИнтернетПочтовоеСообщение;
			
			Если Константы.База.Получить() = Перечисления.НазваниеБазы.Самара Тогда 
				Сообщение.Тема = "Документы за  период из Самары";
			ИначеЕсли Константы.База.Получить() = Перечисления.НазваниеБазы.Владимир Тогда
				Сообщение.Тема = "Документы за период из Владимира";
			ИначеЕсли Константы.База.Получить() = Перечисления.НазваниеБазы.Рязань Тогда
				Сообщение.Тема = "Документы за период из Рязани";
			ИначеЕсли Константы.База.Получить() = Перечисления.НазваниеБазы.Тула Тогда
				Сообщение.Тема = "Документы за период из Тулы";
			ИначеЕсли Константы.База.Получить() = Перечисления.НазваниеБазы.Ярославль Тогда
				Сообщение.Тема = "Документы за период из Ярославля";
			КонецЕсли;
			
			МылоКонтрагента = "";
			
			МылоКонтрагента = СокрЛП(АдресПочтыВМоскве);
			Почта = Новый ИнтернетПочта; 
			Почта.Подключиться(Профиль);
			
			Попытка
				Почта.Подключиться(Профиль);
			Исключение
				
				РезультатРаботы ="Не сумел подключиться к почтовому серверу!";
				Возврат РезультатРаботы;
				
			КонецПопытки;
			
			Сообщение.Получатели.Добавить(МылоКонтрагента);   
			Сообщение.Отправитель = УчетнаяЗапись.АдресЭлектроннойПочты;
			Сообщение.Вложения.Добавить(КаталогВременныхФайлов() + ЗаголовокФайла,ТипФайлаТабличногоДокумента.TXT);
			Почта.Послать(Сообщение);
			
			Сообщение.Получатели.Очистить();
			Сообщение.Вложения.Очистить();
			Почта.Отключиться();
			УдалитьФайлы(КаталогВременныхФайлов()+ЗаголовокФайла);
			РезультатРаботы = "Успешно!";
			
		КонецЕсли;
		
	Иначе 
		
		// Обмем через FTP
		ИмяКаталогаФайлаДляМосквы = НастройкаОбмена.ПапкаФайловДляМосквы;
		РезультатРаботы = ВыполнитьОбмен(Текст, НачПериода, КонПериода);
		
	КонецЕсли;
	
	Возврат РезультатРаботы;
	
КонецФункции	

Функция ЗапуститьВыгрузку(НастройкиОтправки) Экспорт
	
	РН 					= НастройкиОтправки.РН;
	ПКО 				= НастройкиОтправки.ПКО;
	РКО 				= НастройкиОтправки.РКО;
	ВозвратыПокупателей = НастройкиОтправки.ВозвратыПокупателей;
	Инвентаризация 		= НастройкиОтправки.Инвентаризация;
	КорректировкаРеализации = НастройкиОтправки.КорректировкаРеализации;
	ВозвратПоставщику 	= НастройкиОтправки.ВозвратПоставщику;
	ПоступлениеТоваров 	= НастройкиОтправки.ПоступлениеТоваров;
	Списание 			= НастройкиОтправки.Списание;
	Оприходование 		= НастройкиОтправки.Оприходование;
	ПересортицаТоваров 	= НастройкиОтправки.ПересортицаТоваров;
	ПоступлениеТоваровНеМоскворечье 	= НастройкиОтправки.ПоступлениеТоваровНеМоскворечье;
	
	НачДата 			= НастройкиОтправки.НачДата;
	КонДата 			= НастройкиОтправки.КонДата;
	НастройкаОбмена 	= НастройкиОтправки.НастройкаОбмена;
	АдресПочтыВМоскве 	= НастройкиОтправки.АдресПочтыВМоскве;
	ТипОтправки			= НастройкиОтправки.ТипОтправки;
	НачПериода			= НастройкиОтправки.НачДата;
