					Иначе
						Результат = Результат + "," + ПереносСтроки + СледующееСмещение + Ключ + ":" + Отступ + jsonЗаписать(Элемент.Значение, Стандарт, ПредставленияСсылок, ВспомогательныеДанные, Неопределено, СледующееСмещение, Отступ, Табуляция, ПереносСтроки, ПолноеМаскированиеСимволов, МаскированиеКириллицы);
					КонецЕсли;
				КонецЦикла;
				
			Иначе
				
				Первый = Истина; 
				
				Для Каждого Элемент Из Значение Цикл
					
					Ключ = Элемент.Ключ; 
					Тип = ТипЗнч(Ключ); 
					
					Если (Тип = Тип("Строка")) Тогда 
						Ключ = jsonЗаписатьСтроку(Ключ, ПолноеМаскированиеСимволов, МаскированиеКириллицы); 
					ИначеЕсли ТипДопустимыхКлючей.СодержитТип(Тип) Тогда 
						Ключ = """" + Ключ + """"; 
					Иначе 
						ВызватьИсключение ИсключениеНедопустимыйТипКлюча(Неопределено, Ключ); 
					КонецЕсли;
					
					Если Первый Тогда
						
						Результат = ПереносСтроки + СледующееСмещение + Ключ + ":" + Отступ + jsonЗаписать(Элемент.Значение, Стандарт, ПредставленияСсылок, 
						    ВспомогательныеДанные, Неопределено, СледующееСмещение, Отступ, Табуляция, ПереносСтроки, ПолноеМаскированиеСимволов, МаскированиеКириллицы); 
