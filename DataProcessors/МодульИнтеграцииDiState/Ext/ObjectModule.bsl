		КонецЕсли;
		
	КонецЕсли;
	
	Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "Товары") И ОбъектЗаполнения.Товары.Количество() > 0 Тогда
		
		Если ОбъектЗаполнения.Товары.Выгрузить().Колонки.Найти("СуммаБезНДСДоИзменения") <> Неопределено Тогда
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Товары.Итог("СуммаБезНДСДоИзменения");	
		ИначеЕсли ОбъектЗаполнения.Товары.Выгрузить().Колонки.Найти("СуммаДоИзменения") <> Неопределено Тогда
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Товары.Итог("СуммаДоИзменения");	
		КонецЕсли;
		
	КонецЕсли;
	
	Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "Расхождения") И ОбъектЗаполнения.Расхождения.Количество() > 0 Тогда
		СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Товары.Итог("Сумма") + ОбъектЗаполнения.Расхождения.Итог("Сумма");	
	КонецЕсли;
	
	Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "Номенклатура") И ОбъектЗаполнения.Номенклатура.Количество() > 0 Тогда
		
		Если ОбъектЗаполнения.Номенклатура.Выгрузить().Колонки.Найти("СуммаБезНДСДоИзменения") <> Неопределено Тогда
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Номенклатура.Итог("СуммаБезНДСДоИзменения");	
		Иначе
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Номенклатура.Итог("СуммаДоИзменения");	
		КонецЕсли;
		
	КонецЕсли;
	
	Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "Запасы") И ОбъектЗаполнения.Запасы.Количество() > 0 Тогда
		
		Если ОбъектЗаполнения.Запасы.Выгрузить().Колонки.Найти("СуммаБезНДСДоИзменения") <> Неопределено Тогда
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Запасы.Итог("СуммаБезНДСДоИзменения");	
		Иначе
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Запасы.Итог("СуммаДоИзменения");	
		КонецЕсли;
		
	КонецЕсли;
	
	Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "Услуги") И ОбъектЗаполнения.Услуги.Количество() > 0 Тогда
		
		Если ОбъектЗаполнения.Услуги.Выгрузить().Колонки.Найти("СуммаБезНДСДоИзменения") <> Неопределено Тогда
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Услуги.Итог("СуммаБезНДСДоИзменения");	
		Иначе
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Услуги.Итог("СуммаДоИзменения");	
		КонецЕсли;
		
	КонецЕсли;
	
	Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "УслугиОказанные") И ОбъектЗаполнения.УслугиОказанные.Количество() > 0 Тогда
		
		Если ОбъектЗаполнения.УслугиОказанные.Выгрузить().Колонки.Найти("СуммаБезНДСДоИзменения") <> Неопределено Тогда
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.УслугиОказанные.Итог("СуммаБезНДСДоИзменения");	
		Иначе
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.УслугиОказанные.Итог("СуммаДоИзменения");	
		КонецЕсли;
		
	КонецЕсли;
	
	Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "РаботыИУслуги") И ОбъектЗаполнения.РаботыИУслуги.Количество() > 0 Тогда
		
		Если ОбъектЗаполнения.РаботыИУслуги.Выгрузить().Колонки.Найти("СуммаБезНДСДоИзменения") <> Неопределено Тогда
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.РаботыИУслуги.Итог("СуммаБезНДСДоИзменения");	
		Иначе
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.РаботыИУслуги.Итог("СуммаДоИзменения");	
		КонецЕсли;
		
	КонецЕсли;
	
	Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "Доходы") И ОбъектЗаполнения.Доходы.Количество() > 0 Тогда
		
		Если ОбъектЗаполнения.Доходы.Выгрузить().Колонки.Найти("СуммаБезНДСДоИзменения") <> Неопределено Тогда
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Доходы.Итог("СуммаБезНДСДоИзменения");	
		Иначе
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Доходы.Итог("СуммаДоИзменения");	
		КонецЕсли;
		
	КонецЕсли;
	
	Если НДСВСумме = Неопределено Тогда
		НДСВСумме = МОП_ДокументВключаетНДСВСумму(ОбъектЗаполнения);
	КонецЕсли;
	
	Если КонвертацияВалютПоКурсуДокумента Тогда
		
		ВалютаДокумента = МОП_ПолучитьВалютуДокумента(ОбъектЗаполнения.Ссылка);
		ВалютаДоговора = МОП_ПолучитьВалютуДоговораДокумента(ОбъектЗаполнения.Ссылка);
		
		Если ВалютаДоговора <> ВалютаДокумента Тогда //Требуется перерасчет
			
			СтруктураПараметров = МОП_ПолучитьПараметрыВалютДокумента(ОбъектЗаполнения.Ссылка);
			Курс = СтруктураПараметров.Курс;
			Кратность = СтруктураПараметров.Кратность;
			СуммаДокумента = СуммаДокумента * Курс / Кратность;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если НДСВСумме Тогда
		СуммаДокумента = СуммаДокумента - ФОД_ПолучитьСуммуНДСДокументаДо(ВерсияЗаполнения, ОбъектЗаполнения);	
	КонецЕсли;
	
	Возврат СуммаДокумента;

КонецФункции

Функция ФОД_ПолучитьСуммуНДСДокументаДо(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	//Changelog
	//
	//22.03.2019 - добавлен обработчик ТЧ Авансы для счетов-фактур
	
	СуммаДокумента = 0;
	
	Если МОП_ЭтоСчетФактура(ОбъектЗаполнения) Тогда
		
		Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "Авансы") И ОбъектЗаполнения.Авансы.Количество() > 0 Тогда
			
			Если ОбъектЗаполнения.Авансы.Выгрузить().Колонки.Найти("НДСДоИзменения") <> Неопределено Тогда
				СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Авансы.Итог("НДСДоИзменения");	
			Иначе
				СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Авансы.Итог("СуммаНДСДоИзменения");	
			КонецЕсли;
			
		Иначе
			ОбъектЗаполнения = МОП_ПолучитьОснованиеДокумента(ОбъектЗаполнения);
		КонецЕсли;
		
	КонецЕсли;
	
	Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "Товары") И ОбъектЗаполнения.Товары.Количество() > 0 Тогда
		
		Если ОбъектЗаполнения.Товары.Выгрузить().Колонки.Найти("НДСДоИзменения") <> Неопределено Тогда
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Товары.Итог("НДСДоИзменения");	
		ИначеЕсли ОбъектЗаполнения.Товары.Выгрузить().Колонки.Найти("СуммаНДСДоИзменения") <> Неопределено Тогда 
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Товары.Итог("СуммаНДСДоИзменения");	
		КонецЕсли;
		
	КонецЕсли;
	
	Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "Расхождения") И ОбъектЗаполнения.Расхождения.Количество() > 0 Тогда
		СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Товары.Итог("СуммаНДС") + ОбъектЗаполнения.Расхождения.Итог("СуммаНДС");	
	КонецЕсли;
	
	Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "Запасы") И ОбъектЗаполнения.Запасы.Количество() > 0 Тогда
		
		Если ОбъектЗаполнения.Запасы.Выгрузить().Колонки.Найти("НДСДоИзменения") <> Неопределено Тогда
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Запасы.Итог("НДСДоИзменения");	
		Иначе
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Запасы.Итог("СуммаНДСДоИзменения");	
		КонецЕсли;
		
	КонецЕсли;
	
	Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "Номенклатура") И ОбъектЗаполнения.Номенклатура.Количество() > 0 Тогда
		
		Если ОбъектЗаполнения.Номенклатура.Выгрузить().Колонки.Найти("НДСДоИзменения") <> Неопределено Тогда
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Номенклатура.Итог("НДСДоИзменения");	
		Иначе
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Номенклатура.Итог("СуммаНДСДоИзменения");	
		КонецЕсли;
		
	КонецЕсли;
	
	Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "Услуги") И ОбъектЗаполнения.Услуги.Количество() > 0 Тогда
		
		Если ОбъектЗаполнения.Услуги.Выгрузить().Колонки.Найти("НДСДоИзменения") <> Неопределено Тогда
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Услуги.Итог("НДСДоИзменения");	
		Иначе
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Услуги.Итог("СуммаНДСДоИзменения");	
		КонецЕсли;
		
	КонецЕсли;
	
	Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "УслугиОказанные") И ОбъектЗаполнения.УслугиОказанные.Количество() > 0 Тогда
		Если ОбъектЗаполнения.УслугиОказанные.Выгрузить().Колонки.Найти("НДСДоИзменения") <> Неопределено Тогда
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.УслугиОказанные.Итог("НДСДоИзменения");	
		Иначе
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.УслугиОказанные.Итог("СуммаНДСДоИзменения");	
		КонецЕсли;
	КонецЕсли;
	
	Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "РаботыИУслуги") И ОбъектЗаполнения.РаботыИУслуги.Количество() > 0 Тогда
		
		Если ОбъектЗаполнения.РаботыИУслуги.Выгрузить().Колонки.Найти("НДСДоИзменения") <> Неопределено Тогда
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.РаботыИУслуги.Итог("НДСДоИзменения");	
		Иначе
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.РаботыИУслуги.Итог("СуммаНДСДоИзменения");	
		КонецЕсли;
		
	КонецЕсли;
	
	Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "Доходы") И ОбъектЗаполнения.Доходы.Количество() > 0 Тогда
		
		Если ОбъектЗаполнения.Доходы.Выгрузить().Колонки.Найти("НДСДоИзменения") <> Неопределено Тогда
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Доходы.Итог("НДСДоИзменения");	
		Иначе
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Доходы.Итог("СуммаНДСДоИзменения");	
		КонецЕсли;
		
	КонецЕсли;
	
	Если КонвертацияВалютПоКурсуДокумента Тогда
		
		ВалютаДокумента = МОП_ПолучитьВалютуДокумента(ОбъектЗаполнения.Ссылка);
		ВалютаДоговора = МОП_ПолучитьВалютуДоговораДокумента(ОбъектЗаполнения.Ссылка);
		
		Если ВалютаДоговора <> ВалютаДокумента Тогда //Требуется перерасчет
			
			СтруктураПараметров = МОП_ПолучитьПараметрыВалютДокумента(ОбъектЗаполнения.Ссылка);
			Курс = СтруктураПараметров.Курс;
			Кратность = СтруктураПараметров.Кратность;
			СуммаДокумента = Окр(СуммаДокумента * Курс / Кратность, 0);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СуммаДокумента;

КонецФункции

Функция ФОД_ПолучитьСуммуСНДСДокументаДо(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	
	Если МОП_ЭтоСчетФактураНаАванс(ОбъектЗаполнения) Тогда
		
		СуммаДокумента = 0;
		
		Если ОбъектЗаполнения.Авансы.Выгрузить().Колонки.Найти("СуммаБезНДСДоИзменения") <> Неопределено Тогда
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Авансы.Итог("СуммаБезНДСДоИзменения");	
		Иначе
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Авансы.Итог("СуммаДоИзменения");	
		КонецЕсли;
		
		Возврат СуммаДокумента;
		
	Иначе
		Возврат ФОД_ПолучитьСуммуДокументаДо(ВерсияЗаполнения, ОбъектЗаполнения) + ФОД_ПолучитьСуммуНДСДокументаДо(ВерсияЗаполнения, ОбъектЗаполнения);
	КонецЕсли;

КонецФункции

Функция ФОД_ПолучитьСуммуДокументаРост(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	
	ЗначениеПосле 	= ФОД_ПолучитьСуммуДокумента(ВерсияЗаполнения, ОбъектЗаполнения);
	ЗначениеДо 		= ФОД_ПолучитьСуммуДокументаДо(ВерсияЗаполнения, ОбъектЗаполнения);
	
	Если ЗначениеПосле >= ЗначениеДо Тогда
		Возврат ЗначениеПосле - ЗначениеДо;
	Иначе
		Возврат Неопределено;
	КонецЕсли;			

КонецФункции

Функция ФОД_ПолучитьСуммуНДСДокументаРост(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	
	ЗначениеПосле 	= ФОД_ПолучитьСуммуНДСДокумента(ВерсияЗаполнения, ОбъектЗаполнения);
	ЗначениеДо 		= ФОД_ПолучитьСуммуНДСДокументаДо(ВерсияЗаполнения, ОбъектЗаполнения);
	
	Если ЗначениеПосле >= ЗначениеДо Тогда
		Возврат ЗначениеПосле - ЗначениеДо;
	Иначе
		Возврат Неопределено;
	КонецЕсли;			

КонецФункции

Функция ФОД_ПолучитьСуммуСНДСДокументаРост(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	
	ЗначениеПосле 	= ФОД_ПолучитьСуммуСНДСДокумента(ВерсияЗаполнения, ОбъектЗаполнения);
	ЗначениеДо 		= ФОД_ПолучитьСуммуСНДСДокументаДо(ВерсияЗаполнения, ОбъектЗаполнения);
	
	Если ЗначениеПосле >= ЗначениеДо Тогда
		Возврат ЗначениеПосле - ЗначениеДо;
	Иначе
		Возврат Неопределено;
	КонецЕсли;			

КонецФункции

Функция ФОД_ПолучитьСуммуДокументаПадение(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	
	ЗначениеПосле 	= ФОД_ПолучитьСуммуДокумента(ВерсияЗаполнения, ОбъектЗаполнения);
	ЗначениеДо 		= ФОД_ПолучитьСуммуДокументаДо(ВерсияЗаполнения, ОбъектЗаполнения);
	
	Если ЗначениеПосле <= ЗначениеДо Тогда
