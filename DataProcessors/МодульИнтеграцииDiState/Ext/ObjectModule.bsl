Функция ПолучитьБанковскийСчетОрганизации(СсылкаНаОрганизацию) 					Экспорт
	
	СтруктураВозврата = Новый Структура("БИК,НомерСчета");
	ДанныеПоСчету = МОП_ПолучитьБанковскийСчетОрганизации(СсылкаНаОрганизацию);
	
	Если ЗначениеЗаполнено(ДанныеПоСчету) Тогда
		
		Если КНП_ЕстьРеквизит(ДанныеПоСчету, "Банк") Тогда
			СтруктураВозврата.БИК = ДанныеПоСчету.Банк.Код;
		КонецЕсли;
		
		Если КНП_ЕстьРеквизит(ДанныеПоСчету, "НомерСчета") Тогда
			СтруктураВозврата.НомерСчета = ДанныеПоСчету.НомерСчета;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СтруктураВозврата;

КонецФункции

