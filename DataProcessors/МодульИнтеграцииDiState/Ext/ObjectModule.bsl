	СуммаСНДСИтого = 0;
	СуммаНДС = 0;
	КоличествоСтрок = 0;
	МассаБруттоИтого = 0;
	КоличествоИтого = 0;
	КоличествоМестИтого = 0;
	ДолжностьПодписанта = "";
	ФИОПодписанта = "";
	ТипУПД = "";
	ИдентификаторГосКонтракта = "--";
	НомерДокумента = "";
	ДатаДокумента = "";
	НомерОснованияКорректировки = "";
	ДатаОснованияКорректировки = "";
	РазницаУвеличение = 0;
	РазницаУменьшение = 0;
	РазницаНДСУвеличение = 0;
	РазницаНДСУменьшение = 0;
	РазницаСНДСУвеличение = 0;
	РазницаСНДСУменьшение = 0;
	РазницаАкцизУвеличение = 0;
	РазницаАкцизУменьшение = 0;
	ДанныеКорректировки = Неопределено;
	ТабличнаяЧастьКорректировки = Неопределено;
	Валюта = Неопределено;
	ПредставлениеОператора = "";
	ИдентификаторЭД = "";
	ИдентификаторОтправителя = "";
	ИдентификаторПолучателя = "";
	ДоговорОснование = "";
	ЭтоУПД = Ложь;
	ЭтоСчет = Ложь;
	ЭтоКорректировка = Ложь;
	КоличествоЗаписей = 1;
	ИнфоПоля = "";
	ПлатежноРасчетныйДокумент = "";
	ДатаОтпускаГруза = "";
	ФИООтпустившегоГруз = "";
	ДолжностьОтпустившегоГруз = "";
	ДатаОтгрузкиПередачи = "";
	ОнЖе = Ложь;
	ДокументыОбОтгрузке = "";
	
	
	/////////////////////////////////////////////////////////////////////
	//		Разбор XML-структуры
	
	Если СтруктураДанных.Свойство("Файл") Тогда
		СтруктураДанных = СтруктураДанных.Файл;
	КонецЕсли;
	
	Если СтруктураДанных.Свойство("File") Тогда
		
		СтруктураДанных = СтруктураДанных.File;
		ЭтоСчет = Истина;
		
	КонецЕсли;
	
	ИдентификаторЭД = КНП_БезопасноПрочитатьЗначение(СтруктураДанных, ?(ЭтоСчет, "name", "ИдФайл") );
	ДанныеОбУчастникахДО = КНП_БезопасноПрочитатьЗначение(СтруктураДанных, "СвУчДокОбор");
	
	Если ЗначениеЗаполнено(ДанныеОбУчастникахДО) Тогда
		
		ИдентификаторОтправителя = КНП_БезопасноПрочитатьЗначение(ДанныеОбУчастникахДО, "ИдОтпр");
		ИдентификаторПолучателя = КНП_БезопасноПрочитатьЗначение(ДанныеОбУчастникахДО, "ИдПол");
		ДанныеОбОператоре = КНП_БезопасноПрочитатьЗначение(ДанныеОбУчастникахДО, "СвОЭДОтпр");
		
		Если ЗначениеЗаполнено(ДанныеОбОператоре) Тогда
			ПредставлениеОператора = КНП_БезопасноПрочитатьЗначение(ДанныеОбОператоре, "НаимОрг") 
			+ " / " 
			+ КНП_БезопасноПрочитатьЗначение(ДанныеОбОператоре, "ИННЮЛ");	
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДанныеОбУчастникахДО) И ЭтоСчет Тогда
		
		ДанныеОбУчастникахДО = КНП_БезопасноПрочитатьЗначение(СтруктураДанных, "Parties");
		
		Если ЗначениеЗаполнено(ДанныеОбУчастникахДО) Тогда
			
			ИдентификаторОтправителя = КНП_БезопасноПрочитатьЗначение(ДанныеОбУчастникахДО.Sender, "diServerId");
			ИдентификаторПолучателя = КНП_БезопасноПрочитатьЗначение(ДанныеОбУчастникахДО.Receiver, "diServerId");
			
		КонецЕсли;
		
	КонецЕсли;
	
	ДанныеДокумента = КНП_БезопасноПрочитатьЗначение(СтруктураДанных, "Документ");
	
	Если НЕ ЗначениеЗаполнено(ДанныеДокумента) И ЭтоСчет Тогда
		ДанныеДокумента = СтруктураДанных;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеДокумента) Тогда
		
		/////////////////////////////////////////////////////////////////
		//		Обработка данных документа
		
		ТипУПД = КНП_БезопасноПрочитатьЗначение(ДанныеДокумента, "Функция");
		ДанныеТоваров = Неопределено;
		ДанныеУслуг = Неопределено;
		ДанныеШапки = КНП_БезопасноПрочитатьЗначение(ДанныеДокумента, "СвДокПТПрКроме");
		
		Если ЗначениеЗаполнено(ДанныеШапки) И ДанныеШапки.Свойство("СвДокПТПр") Тогда
			
			ДанныеТоваров = КНП_БезопасноПрочитатьЗначение(ДанныеШапки, "СодФХЖ2");
			ДанныеШапки = КНП_БезопасноПрочитатьЗначение(ДанныеШапки, "СвДокПТПр");	
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ДанныеШапки) Тогда
			ДанныеШапки = КНП_БезопасноПрочитатьЗначение(ДанныеДокумента, "СвДокПРУ");	
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ДанныеШапки) Тогда
			
			ДанныеШапки = КНП_БезопасноПрочитатьЗначение(ДанныеДокумента, "СвСчФакт");
			ДанныеТоваров = КНП_БезопасноПрочитатьЗначение(ДанныеДокумента, "ТаблСчФакт");
			
			Если ЗначениеЗаполнено(ДанныеШапки) Тогда
				ЭтоУПД = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ДанныеШапки) Тогда
			
			ДанныеШапки = КНП_БезопасноПрочитатьЗначение(ДанныеДокумента, "СвКСчФ");
			ДанныеТоваров = КНП_БезопасноПрочитатьЗначение(ДанныеДокумента, "ТаблКСчФ");
			
			Если ЗначениеЗаполнено(ДанныеШапки) Тогда
				
				ЭтоКорректировка = Истина;
				ЭтоУПД = Истина;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ДанныеШапки) И ЭтоСчет Тогда
			
			ДанныеШапки = ДанныеДокумента;
			ДанныеТоваров = КНП_БезопасноПрочитатьЗначение(ДанныеДокумента, "Goods");
			
		КонецЕсли;
		
		
		Если ЗначениеЗаполнено(ДанныеШапки) Тогда
			
			Если ЭтоСчет Тогда
				
				НомерДокумента = КНП_БезопасноПрочитатьЗначение(ДанныеШапки, "number");
				ДатаДокумента = КНП_БезопасноПрочитатьЗначение(ДанныеШапки, "date");
				ДанныеШапкиПлатежа = КНП_БезопасноПрочитатьЗначение(ДанныеШапки, "PaymentDetails");
				
				Если ЗначениеЗаполнено(ДанныеШапкиПлатежа) Тогда
					
					ДанныеБанка = КНП_БезопасноПрочитатьЗначение(ДанныеШапкиПлатежа, "Bank");
					
					Если ЗначениеЗаполнено(ДанныеБанка) Тогда
						
						КоррСчетБанкаОрганизации = КНП_БезопасноПрочитатьЗначение(ДанныеБанка, "account");
						БанкОрганизации = КНП_БезопасноПрочитатьЗначение(ДанныеБанка, "name");
						БИКБанкаОрганизации = КНП_БезопасноПрочитатьЗначение(ДанныеБанка, "bik");
						
					КонецЕсли;
					
					СчетОрганизации = КНП_БезопасноПрочитатьЗначение(ДанныеШапкиПлатежа, "account");
					ИННОрганизации = КНП_БезопасноПрочитатьЗначение(ДанныеШапкиПлатежа, "inn");
					КППОрганизации = КНП_БезопасноПрочитатьЗначение(ДанныеШапкиПлатежа, "kpp");
					ИмяОрганизации = КНП_БезопасноПрочитатьЗначение(ДанныеШапкиПлатежа, "name");
					
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ИдентификаторОтправителя) Тогда
					
					ДанныеОтправителя = КНП_БезопасноПрочитатьЗначение(ДанныеОбУчастникахДО.Sender, "Company");
					
					Если ЗначениеЗаполнено(ДанныеОтправителя) Тогда
						
						ИННОрганизации = КНП_БезопасноПрочитатьЗначение(ДанныеОтправителя, "inn");
						КППОрганизации = КНП_БезопасноПрочитатьЗначение(ДанныеОтправителя, "kpp");
						ИмяОрганизации = КНП_БезопасноПрочитатьЗначение(ДанныеОтправителя, "name");
						СтруктураАдреса = КНП_БезопасноПрочитатьЗначение(ДанныеОтправителя, "Address");
						
						Если ЗначениеЗаполнено(СтруктураАдреса) Тогда
							АдресОрганизации = ПФ_РазобратьИзСтруктурыАдресОрганизации(СтруктураАдреса);
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ИдентификаторПолучателя) Тогда
					
					ДанныеПолучателя = КНП_БезопасноПрочитатьЗначение(ДанныеОбУчастникахДО.Receiver, "Company");
					
					Если ЗначениеЗаполнено(ДанныеПолучателя) Тогда
						
						ИННКонтрагента = КНП_БезопасноПрочитатьЗначение(ДанныеПолучателя, "inn");
						КППКонтрагента = КНП_БезопасноПрочитатьЗначение(ДанныеПолучателя, "kpp");
						ИмяКонтрагента = КНП_БезопасноПрочитатьЗначение(ДанныеПолучателя, "name");
						СтруктураАдреса = КНП_БезопасноПрочитатьЗначение(ДанныеПолучателя, "Address");
						
						Если ЗначениеЗаполнено(СтруктураАдреса) Тогда
							АдресКонтрагента = ПФ_РазобратьИзСтруктурыАдресОрганизации(СтруктураАдреса);
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;
				
			Иначе
				
				////////////////////////////////////////////////////////////////////////////////////
				//	Утвержденный XML РФ
				СвПРД = КНП_БезопасноПрочитатьЗначение(ДанныеШапки, "СвПРД");
				
				Если ЗначениеЗаполнено(СвПРД) Тогда
					
					НомерПРД = Строка(КНП_БезопасноПрочитатьЗначение(СвПРД, "НомерПРД") );
					ДатаПРД = Строка(КНП_БезопасноПрочитатьЗначение(СвПРД, "ДатаПРД") );
					
					Если ЗначениеЗаполнено(НомерПРД) И ТипЗнч(НомерПРД) = Тип("Строка") Тогда
						
						ПлатежноРасчетныйДокумент = НомерПРД;
						
						Если ЗначениеЗаполнено(ДатаПРД) И ТипЗнч(ДатаПРД) = Тип("Строка") Тогда
							ПлатежноРасчетныйДокумент = ПлатежноРасчетныйДокумент + " от " + ДатаПРД;
						КонецЕсли;
						
					КонецЕсли;		
					
				КонецЕсли;
				
				//С 1 июля 2021 года новый формат УПД \ УКД
				ДокПодтвОтгр = КНП_БезопасноПрочитатьЗначение(ДанныеШапки, "ДокПодтвОтгр");
				
				Если ЗначениеЗаполнено(ДокПодтвОтгр) Тогда
					ДокументыОбОтгрузке = КНП_БезопасноПрочитатьЗначение(ДокПодтвОтгр, "НаимДокОтгр") + " № " + КНП_БезопасноПрочитатьЗначение(ДокПодтвОтгр, "НомДокОтгр") + " от " + КНП_БезопасноПрочитатьЗначение(ДокПодтвОтгр, "ДатаДокОтгр");
				КонецЕсли;
				
				Если НЕ ЭтоУПД Тогда
					
					ЕдиницаВалюты = КНП_БезопасноПрочитатьЗначение(ДанныеШапки, "ДенИзм");
					
					Если ЗначениеЗаполнено(ЕдиницаВалюты) Тогда
						
						Валюта = СправочникВалюты.Найти(ЕдиницаВалюты.КодОКВ, "КодISO");
						
						Если ЗначениеЗаполнено(Валюта) Тогда
							Валюта = Валюта.Ссылка;
						Иначе
							
							Попытка
								Валюта = Справочники.Валюты.НайтиПоКоду("643");
							Исключение 
							КонецПопытки;
							
						КонецЕсли;
						
					КонецЕсли;
					
					ИдентДок = КНП_БезопасноПрочитатьЗначение(ДанныеШапки, "ИдентДок");
					
					Если ЗначениеЗаполнено(ИдентДок) Тогда
						
						НомерДокумента 				= КНП_БезопасноПрочитатьЗначение(ИдентДок, "НомДокПТ");
						
						Если НЕ ЗначениеЗаполнено(НомерДокумента) Тогда
							НомерДокумента 			= КНП_БезопасноПрочитатьЗначение(ИдентДок, "НомДокПРУ");
						КонецЕсли;
						
						ДатаДокумента 				= КНП_БезопасноПрочитатьЗначение(ИдентДок, "ДатаДокПТ");
						
						Если НЕ ЗначениеЗаполнено(ДатаДокумента) Тогда
							ДатаДокумента 			= КНП_БезопасноПрочитатьЗначение(ИдентДок, "ДатаДокПРУ");
						КонецЕсли;
						
					КонецЕсли;
					
				Иначе	
					
					НомерДокумента = КНП_БезопасноПрочитатьЗначение(ДанныеШапки, ?(ЭтоКорректировка, "НомерКСчФ", "НомерСчФ") );
					ДатаДокумента = КНП_БезопасноПрочитатьЗначение(ДанныеШапки, ?(ЭтоКорректировка, "ДатаКСчФ", "ДатаСчФ") );
					
					//+Марков И. 26.03.2025 #UT10-5160
					ЕдиницаВалюты = КНП_БезопасноПрочитатьЗначение(ДанныеШапки, "КодОКВ");
					
					Если Не ЗначениеЗаполнено(ЕдиницаВалюты) Тогда
						ЕдиницаВалюты = КНП_БезопасноПрочитатьЗначение(ДанныеШапки, "ДенИзм");
						
						Если ЗначениеЗаполнено(ЕдиницаВалюты) Тогда
							
							Валюта = СправочникВалюты.Найти(ЕдиницаВалюты.КодОКВ, "КодISO");
							
							Если ЗначениеЗаполнено(Валюта) Тогда
								Валюта = Валюта.Ссылка;
							Иначе
								
								Попытка
									Валюта = Справочники.Валюты.НайтиПоКоду("643");
								Исключение 
								КонецПопытки;
								
							КонецЕсли;
							
						КонецЕсли;
						
					Иначе
						Валюта = СправочникВалюты.Найти(ЕдиницаВалюты, "КодISO");
					КонецЕсли;
					//-Марков И. 26.03.2025 #UT10-5160
					
					Если ДанныеШапки.Свойство("ДопСвФХЖ1") Тогда
						
						ИдентификаторГосКонтракта = КНП_БезопасноПрочитатьЗначение(ДанныеШапки.ДопСвФХЖ1, "ИдГосКон");
						
						Если ИдентификаторГосКонтракта = Неопределено Тогда
							ИдентификаторГосКонтракта = "--";
						КонецЕсли;
						
					КонецЕсли;
					
					Если ДанныеДокумента.Свойство("СвПродПер") И ДанныеДокумента.СвПродПер.Свойство("СвПер") Тогда
						
						ДанныеПодвала = ДанныеДокумента.СвПродПер.СвПер;
						
						Если ДанныеПодвала.Свойство("ОснПер") Тогда
							
							ДоговорОснование = КНП_БезопасноПрочитатьЗначение(ДанныеПодвала.ОснПер, "НаимОсн");
							НомерОснования = СтрЗаменить(КНП_БезопасноПрочитатьЗначение(ДанныеПодвала.ОснПер, "НомОсн"), "0.00", "");
							ДатаОснования = КНП_БезопасноПрочитатьЗначение(ДанныеПодвала.ОснПер, "ДатаОсн");
							
							Если ЗначениеЗаполнено(НомерОснования) И НомерОснования <> "-" Тогда
								
								Если НЕ Найти(ДоговорОснование, НомерОснования) Тогда 
									ДоговорОснование = ДоговорОснование + " № " + НомерОснования;
								КонецЕсли;
								
							КонецЕсли;
							
							Если ЗначениеЗаполнено(ДатаОснования) Тогда
								
								Попытка
									
									Если КНП_ПривестиКДате(ДатаОснования) > Дата(2000,1,1) Тогда
										
										Если НЕ Найти(ДоговорОснование, "от " + ДатаОснования) Тогда
											ДоговорОснование = ДоговорОснование + " от " + ДатаОснования;
										КонецЕсли;
										
									КонецЕсли;
									
								Исключение
									ДобавитьВЖурнал(ОписаниеОшибки() + ". Доп.данные: ДатаОснования=""" + ДатаОснования + """", "ПФ_РазобратьXMLДляПечатнойФормы");
								КонецПопытки;
								
							КонецЕсли; 
							
						КонецЕсли;
						
					КонецЕсли;
					
					Если ЗначениеЗаполнено(Валюта) Тогда
						Валюта 					= Валюта.Ссылка;
					КонецЕсли;
					
				КонецЕсли;
				
				Если НЕ ЭтоУПД И НЕ ЭтоКорректировка Тогда
					СодФХЖ1 = КНП_БезопасноПрочитатьЗначение(ДанныеШапки, "СодФХЖ1");
				Иначе
					СодФХЖ1 = ДанныеШапки;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(СодФХЖ1) Тогда
					
					СтруктураИнфоПолей = КНП_БезопасноПрочитатьЗначение(СодФХЖ1, "ИнфПолФХЖ1");
					
					Если ЗначениеЗаполнено(СтруктураИнфоПолей) Тогда
						ИнфоПоля = ПФ_РазобратьИзСтруктурыИнфоПоля(СтруктураИнфоПолей);
					КонецЕсли;
					
					ГрузОтпр = КНП_БезопасноПрочитатьЗначение(СодФХЖ1, "ГрузОтпр");
					
					Если СодФХЖ1.Свойство("ГрузОт") Тогда
						
						Если СодФХЖ1.ГрузОт.Свойство("ГрузОтпр") Тогда
							ГрузОтпр = СодФХЖ1.ГрузОт.ГрузОтпр;
						ИначеЕсли СодФХЖ1.ГрузОт.Свойство("ОнЖе") Тогда
							
							ИмяГрузоотправителя = "Он же";
							АдресГрузоотправителя = "";
							ОнЖе = Истина;
							
						КонецЕсли;
						
					КонецЕсли;
					
					Если ЗначениеЗаполнено(ГрузОтпр) Тогда
						
						ИмяГрузоотправителя 	= ПФ_РазобратьИзСтруктурыПредставлениеОрганизации(ГрузОтпр);
						АдресГрузоотправителя 	= ", " + ПФ_РазобратьИзСтруктурыАдресОрганизации(ГрузОтпр);
						БИКБанкаГрузоотправителя= ПФ_РазобратьИзСтруктурыБИКБанка(ГрузОтпр);
						БанкГрузоотправителя 	= ПФ_РазобратьИзСтруктурыНаименованиеБанка(ГрузОтпр);
						СчетГрузоотправителя 	= ПФ_РазобратьИзСтруктурыСчетОрганизации(ГрузОтпр);
						
					ИначеЕсли НЕ ОнЖе Тогда
						
						ИмяГрузоотправителя = "-";
						АдресГрузоотправителя = "-";
						
					КонецЕсли;
					
					ГрузПолуч = КНП_БезопасноПрочитатьЗначение(СодФХЖ1, "ГрузПолуч");
					
					Если ЗначениеЗаполнено(ГрузПолуч) Тогда
						
						ИмяГрузополучателя 		= ПФ_РазобратьИзСтруктурыПредставлениеОрганизации(ГрузПолуч);
						АдресГрузополучателя 	= ", " + ПФ_РазобратьИзСтруктурыАдресОрганизации(ГрузПолуч);
						БИКБанкаГрузополучателя = ПФ_РазобратьИзСтруктурыБИКБанка(ГрузПолуч);
						БанкГрузополучателя 	= ПФ_РазобратьИзСтруктурыНаименованиеБанка(ГрузПолуч);
						СчетГрузополучателя 	= ПФ_РазобратьИзСтруктурыСчетОрганизации(ГрузПолуч);	
						
					Иначе
						
						ИмяГрузополучателя = "-";
						АдресГрузополучателя = "-";
						
					КонецЕсли;
					
					Продавец = КНП_БезопасноПрочитатьЗначение(СодФХЖ1, "Продавец");
					
					Если ЗначениеЗаполнено(Продавец) Тогда
						
						ИмяОрганизации 			= ПФ_РазобратьИзСтруктурыПредставлениеОрганизации(Продавец);
						АдресОрганизации 		= ПФ_РазобратьИзСтруктурыАдресОрганизации(Продавец);
						БИКБанкаОрганизации 	= ПФ_РазобратьИзСтруктурыБИКБанка(Продавец);
						БанкОрганизации 		= ПФ_РазобратьИзСтруктурыНаименованиеБанка(Продавец);
						СчетОрганизации 		= ПФ_РазобратьИзСтруктурыСчетОрганизации(Продавец);	
						
					КонецЕсли;
					
					Покупатель = КНП_БезопасноПрочитатьЗначение(СодФХЖ1, "Покупатель");
					
					Если ЗначениеЗаполнено(Покупатель) Тогда
						
						ИмяКонтрагента 			= ПФ_РазобратьИзСтруктурыПредставлениеОрганизации(Покупатель);
						АдресКонтрагента 		= ПФ_РазобратьИзСтруктурыАдресОрганизации(Покупатель);
						БИКБанкаКонтрагента 	= ПФ_РазобратьИзСтруктурыБИКБанка(Покупатель);
						БанкКонтрагента 		= ПФ_РазобратьИзСтруктурыНаименованиеБанка(Покупатель);
						СчетКонтрагента 		= ПФ_РазобратьИзСтруктурыСчетОрганизации(Покупатель);	
						
					КонецЕсли;
					
					Исполнитель = КНП_БезопасноПрочитатьЗначение(СодФХЖ1, "Исполнитель");
					
					Если СодФХЖ1.Свойство("СвПрод") Тогда
						Исполнитель = СодФХЖ1.СвПрод;
					КонецЕсли;
					
					Если ЗначениеЗаполнено(Исполнитель) Тогда
						
						ИмяОрганизации 			= ПФ_РазобратьИзСтруктурыПредставлениеОрганизации(Исполнитель);
						АдресОрганизации 		= ПФ_РазобратьИзСтруктурыАдресОрганизации(Исполнитель);
						БИКБанкаОрганизации 	= ПФ_РазобратьИзСтруктурыБИКБанка(Исполнитель);
						БанкОрганизации 		= ПФ_РазобратьИзСтруктурыНаименованиеБанка(Исполнитель);
						СчетОрганизации 		= ПФ_РазобратьИзСтруктурыСчетОрганизации(Исполнитель);
						ИННОрганизации 			= ПФ_РазобратьИзСтруктурыИННОрганизации(Исполнитель);
						КППОрганизации			= ПФ_РазобратьИзСтруктурыКППОрганизации(Исполнитель);
						
					КонецЕсли;
					
					Заказчик = КНП_БезопасноПрочитатьЗначение(СодФХЖ1, "Заказчик");
					
					Если СодФХЖ1.Свойство("СвПокуп") Тогда
						Заказчик = СодФХЖ1.СвПокуп;
					КонецЕсли;
					
					Если ЗначениеЗаполнено(Заказчик) Тогда
						
						ИмяКонтрагента 			= ПФ_РазобратьИзСтруктурыПредставлениеОрганизации(Заказчик);
						АдресКонтрагента 		= ПФ_РазобратьИзСтруктурыАдресОрганизации(Заказчик);
						БИКБанкаКонтрагента 	= ПФ_РазобратьИзСтруктурыБИКБанка(Заказчик);
						БанкКонтрагента 		= ПФ_РазобратьИзСтруктурыНаименованиеБанка(Заказчик);
						СчетКонтрагента 		= ПФ_РазобратьИзСтруктурыСчетОрганизации(Заказчик);
						ИННКонтрагента 			= ПФ_РазобратьИзСтруктурыИННОрганизации(Заказчик);
						КППКонтрагента			= ПФ_РазобратьИзСтруктурыКППОрганизации(Заказчик);
						
						Если ЗначениеЗаполнено(ГрузПолуч) Тогда
							
							Если ГрузПолуч.ИдСв.Свойство("СвЮЛУч") И ЗначениеЗаполнено(ГрузПолуч.ИдСв.СвЮЛУч.КПП) Тогда
								КППКонтрагента = ГрузПолуч.ИдСв.СвЮЛУч.КПП;
							КонецЕсли;	
							
						КонецЕсли;	
						
					КонецЕсли;
					
					Если ЭтоКорректировка Тогда
						
						ДанныеПоСФ = КНП_БезопасноПрочитатьЗначение(СодФХЖ1, "СчФ");
						
						Если ЗначениеЗаполнено(ДанныеПоСФ) Тогда
							
							НомерОснованияКорректировки = КНП_БезопасноПрочитатьЗначение(ДанныеПоСФ, "НомерСчФ");
							ДатаОснованияКорректировки = КНП_БезопасноПрочитатьЗначение(ДанныеПоСФ, "ДатаСчФ");
							
						КонецЕсли;
						
					КонецЕсли;
					
					Основание = КНП_БезопасноПрочитатьЗначение(СодФХЖ1, "Основание");
					
					Если ЗначениеЗаполнено(Основание) Тогда
						ДоговорОснование 		= КНП_БезопасноПрочитатьЗначение(Основание, "НаимОсн");	
					КонецЕсли;
					
					ДанныеУслуг = КНП_БезопасноПрочитатьЗначение(СодФХЖ1, "ОписРабот");
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		СодФХЖ3 = КНП_БезопасноПрочитатьЗначение(ДанныеДокумента, "СодФХЖ3");
		
		Если ЗначениеЗаполнено(СодФХЖ3) Тогда
			
			ОснованиеКорректировки = КНП_БезопасноПрочитатьЗначение(СодФХЖ3, "ОснКор");
			
			Если ЗначениеЗаполнено(ОснованиеКорректировки) Тогда
				ДоговорОснование = КНП_БезопасноПрочитатьЗначение(ОснованиеКорректировки, "НаимОсн");
			КонецЕсли;
			
			КоличествоЗаписей = КНП_БезопасноПрочитатьЗначение(СодФХЖ3, "КолПрил");
			
			Если КоличествоЗаписей <> Неопределено И КНП_ЭтоЧисло(КоличествоЗаписей) Тогда
				КоличествоЗаписей = Число(КоличествоЗаписей);
			Иначе
				КоличествоЗаписей = 1;
			КонецЕсли;
			
			ДатаОтпускаГруза = КНП_БезопасноПрочитатьЗначение(СодФХЖ3, "ДатаОтпуск");
			СвЛицОтпГруз = КНП_БезопасноПрочитатьЗначение(СодФХЖ3, "СвЛицОтпГруз");
			
			Если ЗначениеЗаполнено(СвЛицОтпГруз) Тогда
				
				РабОргПрод = КНП_БезопасноПрочитатьЗначение(СвЛицОтпГруз, "РабОргПрод");
				
				Если ЗначениеЗаполнено(РабОргПрод) Тогда
					
					ДолжностьОтпустившегоГруз = КНП_БезопасноПрочитатьЗначение(РабОргПрод, "Должность");
					
					Если НЕ ЗначениеЗаполнено(ДолжностьОтпустившегоГруз) И ЗначениеЗаполнено(ДолжностьПодписанта) Тогда
						ДолжностьОтпустившегоГруз = ДолжностьПодписанта;
					КонецЕсли;
					
					ПодписантФИО = КНП_БезопасноПрочитатьЗначение(РабОргПрод, "ФИО");
					
					Если ЗначениеЗаполнено(ПодписантФИО) Тогда
						
						ФИООтпустившегоГруз = "";
						
						Если ПодписантФИО.Свойство("Фамилия") Тогда
							ФИООтпустившегоГруз = ПодписантФИО.Фамилия + " ";
						КонецЕсли;
						
						Если ПодписантФИО.Свойство("Имя") Тогда
							ФИООтпустившегоГруз = ФИОПодписанта + ПодписантФИО.Имя + " ";
						КонецЕсли;
						
						Если ПодписантФИО.Свойство("Отчество") Тогда
							ФИООтпустившегоГруз = ФИОПодписанта + ПодписантФИО.Отчество;
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		ИначеЕсли ДанныеДокумента.Свойство("СвПродПер") Тогда
			
			СвПер = КНП_БезопасноПрочитатьЗначение(ДанныеДокумента.СвПродПер, "СвПер");
			
			Если ЗначениеЗаполнено(СвПер) Тогда
				
				ДатаОтгрузкиПередачи = КНП_БезопасноПрочитатьЗначение(СвПер, "ДатаПер");
				
				Если ДатаОтгрузкиПередачи = Неопределено И ДокПодтвОтгр <> Неопределено Тогда
					ДатаОтгрузкиПередачи = КНП_БезопасноПрочитатьЗначение(ДокПодтвОтгр, "ДатаДокОтгр");	
				КонецЕсли;      
				
				СвЛицПер = КНП_БезопасноПрочитатьЗначение(СвПер, "СвЛицПер");
				
				Если ЗначениеЗаполнено(СвЛицПер) Тогда
					
					РабОргПрод = КНП_БезопасноПрочитатьЗначение(СвЛицПер, "РабОргПрод");
					
					Если ЗначениеЗаполнено(РабОргПрод) Тогда
						
						ДолжностьОтпустившегоГруз = КНП_БезопасноПрочитатьЗначение(РабОргПрод, "Должность");
						
						Если НЕ ЗначениеЗаполнено(ДолжностьОтпустившегоГруз) И ЗначениеЗаполнено(ДолжностьПодписанта) Тогда
							ДолжностьОтпустившегоГруз = ДолжностьПодписанта;
						КонецЕсли;
						
						ПодписантФИО = КНП_БезопасноПрочитатьЗначение(РабОргПрод, "ФИО");
						
						Если ЗначениеЗаполнено(ПодписантФИО) Тогда
							
							ФИООтпустившегоГруз = "";
							
							Если ПодписантФИО.Свойство("Фамилия") Тогда
								ФИООтпустившегоГруз = ПодписантФИО.Фамилия + " ";
							КонецЕсли;
							
							Если ПодписантФИО.Свойство("Имя") Тогда
								ФИООтпустившегоГруз = ФИООтпустившегоГруз + ПодписантФИО.Имя + " ";
							КонецЕсли;
							
							Если ПодписантФИО.Свойство("Отчество") Тогда
								ФИООтпустившегоГруз = ФИООтпустившегоГруз + ПодписантФИО.Отчество;
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЕсли;	
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		НомерСтроки = 1;
		
		Если ЗначениеЗаполнено(ДанныеТоваров) Тогда
			
			///////////////////////////////////////////////////////////////////
			//////////////////////	ТЧ Товары	///////////////////////////////
			СвТов = КНП_БезопасноПрочитатьЗначение(ДанныеТоваров, "СвТов");
			
			Если НЕ ЗначениеЗаполнено(СвТов) Тогда
				СвТов = КНП_БезопасноПрочитатьЗначение(ДанныеТоваров, "СведТов");
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(СвТов) Тогда
				СвТов = КНП_БезопасноПрочитатьЗначение(ДанныеТоваров, "Good");
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СвТов) Тогда
				
				Товары = XML_ПолучитьМассивИзСтруктуры(СвТов);
				МетаданныеТЧ = СтруктураДокумента.ТабличнаяЧасть.Колонки;
				
				Для Каждого Товар Из Товары Цикл
					
					СтрТабЧасти = СтруктураДокумента.ТабличнаяЧасть.Добавить();
					СтрТабЧасти.НомерСтроки = ?(ТипЗнч(СвТов)=Тип("Массив"), НомерСтроки,СвТов.НомСтр);
					НомерСтроки = НомерСтроки + 1;
					СтрТабЧасти.Товар 						= КНП_БезопасноПрочитатьЗначение(Товар, ?(ЭтоСчет, "name", "НаимТов") );
					СтрТабЧасти.ЕдиницаИзмерения 			= КНП_БезопасноПрочитатьЗначение(Товар, "НаимЕдИзм");
					
					Если Товар.Свойство("ДопСведТов") И Товар.ДопСведТов.Свойство("НаимЕдИзм") Тогда
						СтрТабЧасти.ЕдиницаИзмерения 		= Товар.ДопСведТов.НаимЕдИзм;
					КонецЕсли;
					
					Если Товар.Свойство("ДопСведТов") И ТипЗнч(Товар.ДопСведТов) = Тип("Структура") И Товар.ДопСведТов.Свойство("КодТов") Тогда
						СтрТабЧасти.ТоварКод = Товар.ДопСведТов.КодТов;	
						
					КонецЕсли;
					Если НЕ ЗначениеЗаполнено(СтрТабЧасти.ЕдиницаИзмерения) И ЭтоСчет Тогда
						
						СтрЕИ = СправочникЕдиницыИзмерения.Найти(КНП_БезопасноПрочитатьЗначение(Товар, "measurement"), "КодОКЕИ");
						
						Если ЗначениеЗаполнено(СтрЕИ) Тогда
							СтрТабЧасти.ЕдиницаИзмерения 	= СтрЕИ.СокрНазвание;
						КонецЕсли;
						
					КонецЕсли;
					
					Если МетаданныеТЧ.Найти("ЕдиницаИзмеренияКод") <> Неопределено Тогда
						
						СтрТабЧасти.ЕдиницаИзмеренияКод = КНП_БезопасноПрочитатьЗначение(Товар,"ОКЕИ_Тов");
						
						//Специально для ТЭК-ТОРГ
						Если СтрТабЧасти.ЕдиницаИзмеренияКод = "0000" Тогда
							
							СтрТабЧасти.ЕдиницаИзмеренияКод = "--";
							СтрТабЧасти.ЕдиницаИзмерения = "--";
							
						КонецЕсли;
						
						//Специально для ТЭК-ТОРГ
						Если СтрТабЧасти.Товар = "Предварительная оплата" Тогда   //Специально для СФ на аванс
							
							СтрТабЧасти.ЕдиницаИзмеренияКод = "--";
							СтрТабЧасти.ЕдиницаИзмерения = "--";
							
						КонецЕсли; 
						
					КонецЕсли;
					
					Если МетаданныеТЧ.Найти("КодВидаТовара") <> Неопределено Тогда
						СтрТабЧасти.КодВидаТовара = "--";	
					КонецЕсли;
					
					Если ЭтоКорректировка Тогда
						
						СтрТабЧасти.ЕдиницаИзмеренияКод 	= КНП_БезопасноПрочитатьЗначение(Товар, "ОКЕИ_ТовПосле");
						СтрЕИ = СправочникЕдиницыИзмерения.Найти(СтрТабЧасти.ЕдиницаИзмеренияКод, "КодОКЕИ");
						
						Если СтрЕИ <> Неопределено Тогда
							СтрТабЧасти.ЕдиницаИзмерения 	= СтрЕИ.СокрНазвание;
						КонецЕсли;
						
						СтрТабЧасти.ЕдиницаИзмеренияКодДо	= КНП_БезопасноПрочитатьЗначение(Товар, "ОКЕИ_ТовДо");
						
						Если МетаданныеТЧ.Найти("ЕдиницаИзмеренияДо") <> Неопределено Тогда
							
							СтрЕИ = СправочникЕдиницыИзмерения.Найти(СтрТабЧасти.ЕдиницаИзмеренияКодДо, "КодОКЕИ");
							
							Если СтрЕИ <> Неопределено Тогда
								СтрТабЧасти.ЕдиницаИзмеренияДо = СтрЕИ.СокрНазвание;
							КонецЕсли;
							
							//Специально для ТЭК-ТОРГ
							Если СтрТабЧасти.ЕдиницаИзмеренияКодДо = "0000" Тогда
								
								СтрТабЧасти.ЕдиницаИзмеренияКодДо = "--";
								СтрТабЧасти.ЕдиницаИзмеренияДо = "--";
								
							КонецЕсли;
							//Специально для ТЭК-ТОРГ
							
						КонецЕсли;
						
						СтрТабЧасти.Количество 		 		= КНП_БезопасноПрочитатьЗначение(Товар, "КолТовПосле");
						СтрТабЧасти.КоличествоДоИзменения	= КНП_БезопасноПрочитатьЗначение(Товар, "КолТовДо");
						СтрТабЧасти.Цена 					= КНП_БезопасноПрочитатьЗначение(Товар, "ЦенаТовПосле");
						СтрТабЧасти.ЦенаДоИзменения 		= КНП_БезопасноПрочитатьЗначение(Товар, "ЦенаТовДо");
						
						Если СтрТабЧасти.Количество <> Неопределено И СтрТабЧасти.Цена <> Неопределено Тогда
							СтрТабЧасти.Сумма 					= КНП_ФорматСумм(Число(СтрТабЧасти.Количество * СтрТабЧасти.Цена) );
						ИначеЕсли Товар.Свойство("СтТовБезНДС") Тогда
							СтрТабЧасти.Сумма = Товар.СтТовБезНДС.СтоимПослеИзм;
						КонецЕсли;
						
						Если СтрТабЧасти.КоличествоДоИзменения <> Неопределено И СтрТабЧасти.ЦенаДоИзменения <> Неопределено Тогда
							СтрТабЧасти.СуммаДоИзменения 		= КНП_ФорматСумм(Число(СтрТабЧасти.КоличествоДоИзменения * СтрТабЧасти.ЦенаДоИзменения) );
						ИначеЕсли Товар.Свойство("СтТовБезНДС") Тогда
							СтрТабЧасти.СуммаДоИзменения = Товар.СтТовБезНДС.СтоимДоИзм;
						КонецЕсли;
						
						СтрТабЧасти.НДС			 			= КНП_ФорматСумм(Число(Товар.СумНалПосле.СумНДС.Значение) );
						СтрТабЧасти.НДСДоИзменения			= КНП_ФорматСумм(Число(Товар.СумНалДо.СумНДС.Значение) );
						СтрТабЧасти.СуммаСНДС 				= КНП_ФорматСумм(Число(Товар.СтТовУчНал.СтоимПослеИзм) );
						СтрТабЧасти.СуммаСНДСДоИзменения	= КНП_ФорматСумм(Число(Товар.СтТовУчНал.СтоимДоИзм) );
						РазностьВСумме 				= КНП_ПолучитьРазностьЧисел(СтрТабЧасти.Сумма, СтрТабЧасти.СуммаДоИзменения);
						РазностьВСуммеНДС 			= КНП_ПолучитьРазностьЧисел(СтрТабЧасти.НДС, СтрТабЧасти.НДСДоИзменения);
						РазностьВСуммеСНДС 			= КНП_ПолучитьРазностьЧисел(СтрТабЧасти.СуммаСНДС, СтрТабЧасти.СуммаСНДСДоИзменения);
						СтрТабЧасти.РазницаУвеличение 		= ?(РазностьВСумме > 0, РазностьВСумме, 0); 
						СтрТабЧасти.РазницаУменьшение 		= ?(РазностьВСумме < 0, -РазностьВСумме, 0);
						СтрТабЧасти.РазницаНДСУвеличение 	= ?(РазностьВСуммеНДС > 0, РазностьВСуммеНДС, 0);
						СтрТабЧасти.РазницаНДСУменьшение 	= ?(РазностьВСуммеНДС < 0, -РазностьВСуммеНДС, 0);
						СтрТабЧасти.РазницаСНДСУвеличение 	= ?(РазностьВСуммеСНДС > 0, РазностьВСуммеСНДС, 0);
						СтрТабЧасти.РазницаСНДСУменьшение 	= ?(РазностьВСуммеСНДС < 0, -РазностьВСуммеСНДС, 0);
						СтрТабЧасти.СтавкаНДСДоИзменения 	= КНП_БезопасноПрочитатьЗначение(Товар, "НалСтДо");
						СтрТабЧасти.СтавкаНДС				= КНП_БезопасноПрочитатьЗначение(Товар, "НалСтПосле");
						
						СтрТабЧасти.Количество 				= ?(СтрТабЧасти.Количество = "0.00" ИЛИ НЕ ЗначениеЗаполнено(СтрТабЧасти.Количество), "--", СтрТабЧасти.Количество);
						СтрТабЧасти.КоличествоДоИзменения 	= ?(СтрТабЧасти.КоличествоДоИзменения = "0.00" ИЛИ НЕ ЗначениеЗаполнено(СтрТабЧасти.КоличествоДоИзменения), "--", СтрТабЧасти.КоличествоДоИзменения);
						СтрТабЧасти.Цена 					= ?(СтрТабЧасти.Цена = "0.00" ИЛИ НЕ ЗначениеЗаполнено(СтрТабЧасти.Цена), "--", СтрТабЧасти.Цена);
						СтрТабЧасти.ЦенаДоИзменения 		= ?(СтрТабЧасти.ЦенаДоИзменения = "0.00" ИЛИ НЕ ЗначениеЗаполнено(СтрТабЧасти.ЦенаДоИзменения), "--", СтрТабЧасти.ЦенаДоИзменения);
						
						
						
						Если МетаданныеТЧ.Найти("Акциз") <> Неопределено Тогда
							
							СтрТабЧасти.Акциз 				= КНП_БезопасноПрочитатьЗначение(Товар, "АкцизПосле");	
							
							Если ТипЗнч(СтрТабЧасти.Акциз) = Тип("Структура") Тогда
								
								Если Товар.АкцизПосле.Свойство("СумАкциз") Тогда
									СтрТабЧасти.Акциз 		= Товар.АкцизПосле.СумАкциз.Значение;
								ИначеЕсли Товар.АкцизПосле.Свойство("БезАкциз") Тогда
									СтрТабЧасти.Акциз		= "без акциза";
								КонецЕсли;
								
							КонецЕсли;
							
						КонецЕсли;
						
						Если МетаданныеТЧ.Найти("АкцизДоИзменения") <> Неопределено Тогда
							
							СтрТабЧасти.АкцизДоИзменения 			= КНП_БезопасноПрочитатьЗначение(Товар, "АкцизДо");	
							
							Если ТипЗнч(СтрТабЧасти.АкцизДоИзменения) = Тип("Структура") Тогда
								
								Если Товар.АкцизДо.Свойство("СумАкциз") Тогда
									СтрТабЧасти.АкцизДоИзменения 	= Товар.АкцизДо.СумАкциз.Значение;
								ИначеЕсли Товар.АкцизДо.Свойство("БезАкциз") Тогда
									СтрТабЧасти.АкцизДоИзменения 	= "без акциза";
								КонецЕсли;
								
							КонецЕсли;
							
						КонецЕсли;
						
						РазностьВАкцизе				= КНП_ПолучитьРазностьЧисел(СтрТабЧасти.Акциз, СтрТабЧасти.АкцизДоИзменения);
						СтрТабЧасти.РазницаАкцизУвеличение = ?(РазностьВАкцизе > 0, РазностьВАкцизе, 0);
						СтрТабЧасти.РазницаАкцизУменьшение = ?(РазностьВАкцизе < 0, -РазностьВАкцизе, 0);
						
						РазницаУвеличение 		= РазницаУвеличение 		+ СтрТабЧасти.РазницаУвеличение;
						РазницаУменьшение 		= РазницаУменьшение 		+ СтрТабЧасти.РазницаУменьшение;
						РазницаНДСУвеличение 	= РазницаНДСУвеличение 		+ СтрТабЧасти.РазницаНДСУвеличение;
						РазницаНДСУменьшение 	= РазницаНДСУменьшение 		+ СтрТабЧасти.РазницаНДСУменьшение;
						РазницаСНДСУвеличение 	= РазницаСНДСУвеличение 	+ СтрТабЧасти.РазницаСНДСУвеличение;
						РазницаСНДСУменьшение 	= РазницаСНДСУменьшение 	+ СтрТабЧасти.РазницаСНДСУменьшение;
						РазницаАкцизУвеличение 	= РазницаАкцизУвеличение 	+ СтрТабЧасти.РазницаАкцизУвеличение;
						РазницаАкцизУменьшение 	= РазницаАкцизУменьшение 	+ СтрТабЧасти.РазницаАкцизУменьшение;
						
					Иначе
						
						СтрТабЧасти.Количество 				= КНП_БезопасноПрочитатьЗначение(Товар, "НеттоПередано");
						
						Если НЕ ЗначениеЗаполнено(СтрТабЧасти.Количество) Тогда
							СтрТабЧасти.Количество 			= КНП_БезопасноПрочитатьЗначение(Товар, "Количество");
						КонецЕсли;
						
						Если НЕ ЗначениеЗаполнено(СтрТабЧасти.Количество) Тогда
							СтрТабЧасти.Количество 			= КНП_БезопасноПрочитатьЗначение(Товар, "КолТов");
						КонецЕсли;
						
						Если НЕ ЗначениеЗаполнено(СтрТабЧасти.Количество) Тогда
							СтрТабЧасти.Количество 			= КНП_БезопасноПрочитатьЗначение(Товар, "count");
						КонецЕсли;
						
						СтрТабЧасти.Количество 				= ?(СтрТабЧасти.Количество = "0.00" ИЛИ НЕ ЗначениеЗаполнено(СтрТабЧасти.Количество), "--", СтрТабЧасти.Количество);
						
						Если МетаданныеТЧ.Найти("МассаБрутто") <> Неопределено Тогда
							
							СтрТабЧасти.МассаБрутто 		= КНП_БезопасноПрочитатьЗначение(Товар, "Брутто");
							
							Если НЕ ЗначениеЗаполнено(СтрТабЧасти.МассаБрутто) Тогда
								СтрТабЧасти.МассаБрутто = 0;
							КонецЕсли;
							
						КонецЕсли;
						
						Если МетаданныеТЧ.Найти("Упаковка") <> Неопределено Тогда
							СтрТабЧасти.Упаковка = КНП_БезопасноПрочитатьЗначение(Товар, "ВидУпак");
						КонецЕсли;
						
						Если МетаданныеТЧ.Найти("КоличествоВМесте") <> Неопределено Тогда
							
							СтрТабЧасти.КоличествоВМесте = КНП_БезопасноПрочитатьЗначение(Товар, "Место");
							
							Если НЕ ЗначениеЗаполнено(СтрТабЧасти.КоличествоВМесте) Тогда
								СтрТабЧасти.КоличествоВМесте = 0;
							КонецЕсли;
							
						КонецЕсли;
						
						Если МетаданныеТЧ.Найти("КоличествоМест") <> Неопределено Тогда
							
							СтрТабЧасти.КоличествоМест = КНП_БезопасноПрочитатьЗначение(Товар, "КолМест");
							
							Если НЕ ЗначениеЗаполнено(СтрТабЧасти.КоличествоМест) Тогда
								СтрТабЧасти.КоличествоМест = 0;
							КонецЕсли;
							
						КонецЕсли;
						
						СтрТабЧасти.Цена 					= КНП_БезопасноПрочитатьЗначение(Товар, "Цена");
						
						Если НЕ ЗначениеЗаполнено(СтрТабЧасти.Цена) Тогда
							СтрТабЧасти.Цена				= КНП_БезопасноПрочитатьЗначение(Товар, "ЦенаТов");
						КонецЕсли;
						
						Если НЕ ЗначениеЗаполнено(СтрТабЧасти.Цена) Тогда
							СтрТабЧасти.Цена 				= КНП_БезопасноПрочитатьЗначение(Товар, "price");
						КонецЕсли;
						
						СтрТабЧасти.Цена 					= ?(СтрТабЧасти.Цена = "0.00" ИЛИ НЕ ЗначениеЗаполнено(СтрТабЧасти.Цена), "--", СтрТабЧасти.Цена);
						
						СтрТабЧасти.Сумма 					= КНП_БезопасноПрочитатьЗначение(Товар, "СтБезНДС");
						
						Если НЕ ЗначениеЗаполнено(СтрТабЧасти.Сумма) Тогда
							СтрТабЧасти.Сумма				= КНП_БезопасноПрочитатьЗначение(Товар, "СтТовБезНДС");
						КонецЕсли;
						
						Если НЕ ЗначениеЗаполнено(СтрТабЧасти.Сумма) Тогда
							
							СтрТабЧасти.Сумма				= КНП_БезопасноПрочитатьЗначение(Товар, "costBeforeTax");
							СуммаИтого = СуммаИтого + ?(ЗначениеЗаполнено(СтрТабЧасти.Сумма), СтрТабЧасти.Сумма, 0);
							
						КонецЕсли;
						
						Если МетаданныеТЧ.Найти("НДС") <> Неопределено Тогда
							
							СтрТабЧасти.НДС 				= КНП_БезопасноПрочитатьЗначение(Товар, "СумНДС");
							
							Если Товар.Свойство("СумНал") Тогда
								
								Если Товар.СумНал.СумНал.Свойство("Значение") Тогда 
									СтрТабЧасти.НДС = Товар.СумНал.СумНал.Значение;
								ИначеЕсли Товар.СумНал.Свойство("БезНДС") Тогда
									СтрТабЧасти.НДС = 0;
								КонецЕсли;
								
							КонецЕсли;
							
						КонецЕсли;
						
						Если Товар.Свойство("amountOfTax") И ЗначениеЗаполнено(Товар.amountOfTax) Тогда
							СуммаНДС = СуммаНДС + Число(Товар.amountOfTax);
						КонецЕсли;
						
						Если Товар.Свойство("costAfterTax") И ЗначениеЗаполнено(Товар.costAfterTax) Тогда
							
							СуммаСНДСИтого = СуммаСНДСИтого + Число(Товар.costAfterTax);
							
							Если ЗначениеЗаполнено(СтрТабЧасти.Количество) Тогда
								
								Попытка
									СтрТабЧасти.Сумма = Число(СтрТабЧасти.Количество) * Число(СтрТабЧасти.Цена);
								Исключение
									СтрТабЧасти.Сумма = СтрТабЧасти.Цена;
								КонецПопытки;
								
							Иначе
								СтрТабЧасти.Сумма = СтрТабЧасти.Цена;	
							КонецЕсли;
							
						КонецЕсли;
						
						
						Если МетаданныеТЧ.Найти("СуммаСНДС") <> Неопределено Тогда
							
							СтрТабЧасти.СуммаСНДС 			= КНП_БезопасноПрочитатьЗначение(Товар, "СтУчНДС");
							
							Если НЕ ЗначениеЗаполнено(СтрТабЧасти.СуммаСНДС) Тогда
								СтрТабЧасти.СуммаСНДС		= КНП_БезопасноПрочитатьЗначение(Товар, "СтТовУчНал");
							КонецЕсли;
							
						КонецЕсли;
						
						Если МетаданныеТЧ.Найти("СтавкаНДС") <> Неопределено Тогда
							СтрТабЧасти.СтавкаНДС 			= КНП_БезопасноПрочитатьЗначение(Товар, "НалСт");
						КонецЕсли;
						
						Если МетаданныеТЧ.Найти("Акциз") <> Неопределено Тогда
							
							СтрТабЧасти.Акциз 				= КНП_БезопасноПрочитатьЗначение(Товар, "Акциз");	
							
							Если ТипЗнч(СтрТабЧасти.Акциз) = Тип("Структура") Тогда
								
								Если Товар.Акциз.Свойство("СумАкциз") Тогда
									СтрТабЧасти.Акциз 			= Товар.Акциз.СумАкциз.Значение;
								ИначеЕсли Товар.Акциз.Свойство("БезАкциз") Тогда
									СтрТабЧасти.Акциз		= "без акциза";
								КонецЕсли;
								
							КонецЕсли;
							
							Если СтрТабЧасти.Сумма = Неопределено Тогда   //Специально для СФ на аванс
								
								СтрТабЧасти.Акциз = "--";
								СтрТабЧасти.Сумма = "--";
								
							КонецЕсли;
							
						КонецЕсли;
						
						СтавкаНДС 							= КНП_БезопасноПрочитатьЗначение(Товар, "НалСт");
						
						Если НЕ ЗначениеЗаполнено(СтавкаНДС) Тогда
							СтавкаНДС						= МОП_ПолучитьСтавкуНДСИзСтроки(КНП_БезопасноПрочитатьЗначение(Товар, "taxRate") );
						КонецЕсли; 
						
						//Доп поля
						ДопСведТов = КНП_БезопасноПрочитатьЗначение(Товар, "ДопСведТов");
						
						Если ЗначениеЗаполнено(ДопСведТов) Тогда
							
							Если МетаданныеТЧ.Найти("ПредставлениеСтраны") <> Неопределено Тогда
								СтрТабЧасти.ПредставлениеСтраны = КНП_БезопасноПрочитатьЗначение(ДопСведТов, "КрНаимСтрПр");	
							КонецЕсли;
							
							Если МетаданныеТЧ.Найти("ТоварКод") <> Неопределено Тогда
								СтрТабЧасти.ТоварКод = КНП_БезопасноПрочитатьЗначение(ДопСведТов, "КодТов");	
							КонецЕсли;
							
						КонецЕсли;
						
						СвТД = КНП_БезопасноПрочитатьЗначение(Товар, "СвТД");
						
						Если ЗначениеЗаполнено(ДопСведТов) Тогда
							
							Если МетаданныеТЧ.Найти("СтранаПроисхожденияКод") <> Неопределено Тогда
								СтрТабЧасти.СтранаПроисхожденияКод = КНП_БезопасноПрочитатьЗначение(СвТД, "КодПроисх");	
							КонецЕсли;
							
							Если МетаданныеТЧ.Найти("ПредставлениеГТД") <> Неопределено Тогда
								СтрТабЧасти.ПредставлениеГТД = КНП_БезопасноПрочитатьЗначение(СвТД, "НомерТД");	
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЕсли;
					
					
					
					Если МетаданныеТЧ.Найти("Товар") <> Неопределено Тогда
						СтрТабЧасти.Наименование = СтрТабЧасти.Товар;
					КонецЕсли;
					
					Если МетаданныеТЧ.Найти("Описание") <> Неопределено Тогда
						
						СтрТабЧасти.Содержание = СтрТабЧасти.Описание;
						
						Если НЕ ЗначениеЗаполнено(СтрТабЧасти.Описание) Тогда 
							СтрТабЧасти.Описание = "-" 
						КонецЕсли;
						
					КонецЕсли;
					
					Если МетаданныеТЧ.Найти("СуммаНДС") <> Неопределено Тогда
						СтрТабЧасти.СуммаНДС = СтрТабЧасти.НДС;
					КонецЕсли;
					
					Если МетаданныеТЧ.Найти("СуммаНДСДоИзменения") <> Неопределено Тогда
						СтрТабЧасти.СуммаНДСДоИзменения = СтрТабЧасти.НДСДоИзменения;
					КонецЕсли;
					
					Если ЗначениеЗаполнено(СтрТабЧасти.Количество) Тогда
						
						Если НЕ СтрТабЧасти.Количество = "-" И НЕ СтрТабЧасти.Количество = "--" Тогда
							КоличествоИтого = КоличествоИтого + Число(СтрТабЧасти.Количество);
						КонецЕсли;
						
					КонецЕсли;
					
					Если МетаданныеТЧ.Найти("МассаБрутто") <> Неопределено Тогда
						МассаБруттоИтого = МассаБруттоИтого + Число(СтрТабЧасти.МассаБрутто);
					КонецЕсли;
					
					Если МетаданныеТЧ.Найти("КоличествоМест") <> Неопределено Тогда
						КоличествоМестИтого = КоличествоМестИтого + Число(СтрТабЧасти.КоличествоМест);
					КонецЕсли;
					
					СтруктураИнфоПолей = КНП_БезопасноПрочитатьЗначение(Товар, "ИнфПолФХЖ2");
					
					Если ЗначениеЗаполнено(СтруктураИнфоПолей) Тогда
						
						ИнфоПоляТовара = ПФ_РазобратьИзСтруктурыИнфоПоля(СтруктураИнфоПолей);							
						
						Если МетаданныеТЧ.Найти("ИнфоПоля") <> Неопределено Тогда
							СтрТабЧасти.ИнфоПоля = ИнфоПоляТовара;
						КонецЕсли;
						
					КонецЕсли;
					
					
					//Финальная замена
					Если СтрТабЧасти.Сумма = 0 ИЛИ СтрТабЧасти.Сумма = "0.00" Тогда
						СтрТабЧасти.Сумма = "--";
					КонецЕсли;
					
					Если МетаданныеТЧ.Найти("НДС") <> Неопределено Тогда
						
						Если СтрТабЧасти.НДС = 0 ИЛИ СтрТабЧасти.НДС = "0.00" Тогда
							
							Если НРег(СтрТабЧасти.СтавкаНДС) = "без ндс" Тогда
								СтрТабЧасти.НДС = СтрТабЧасти.СтавкаНДС;
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЕсли;
					
					Если МетаданныеТЧ.Найти("НДСДоИзменения") <> Неопределено Тогда
						
						Если СтрТабЧасти.НДСДоИзменения = 0 ИЛИ СтрТабЧасти.НДСДоИзменения = "0.00" Тогда
							
							Если НРег(СтрТабЧасти.СтавкаНДСДоИзменения) = "без ндс" Тогда
								СтрТабЧасти.НДСДоИзменения = СтрТабЧасти.СтавкаНДСДоИзменения;
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЕсли;
					
					Если МетаданныеТЧ.Найти("СтранаПроисхожденияКод") <> Неопределено Тогда
						
						Если НЕ ЗначениеЗаполнено(СтрТабЧасти.СтранаПроисхожденияКод) Тогда
							СтрТабЧасти.СтранаПроисхожденияКод = "--";
						КонецЕсли;
						
						Если НЕ ЗначениеЗаполнено(СтрТабЧасти.ПредставлениеСтраны) Тогда
							СтрТабЧасти.ПредставлениеСтраны = "--";
						КонецЕсли;
						
						Если НЕ ЗначениеЗаполнено(СтрТабЧасти.ПредставлениеГТД) Тогда
							СтрТабЧасти.ПредставлениеГТД = "--";
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
			Всего = КНП_БезопасноПрочитатьЗначение(ДанныеТоваров, "Всего");
			
			Если ЗначениеЗаполнено(Всего) Тогда
				
				СуммаИтого 		= КНП_БезопасноПрочитатьЗначение(Всего, "СтБезНДСВс"); 
				СуммаНДС 		= КНП_БезопасноПрочитатьЗначение(Всего, "СумНДСВс");
				СуммаСНДСИтого 	= КНП_БезопасноПрочитатьЗначение(Всего, "СтУчНДСВс");
				
			ИначеЕсли ДанныеТоваров.Свойство("ВсегоОпл") Тогда
				
				Всего = ДанныеТоваров.ВсегоОпл;
				СуммаИтого 		= КНП_БезопасноПрочитатьЗначение(Всего, "СтТовБезНДСВсего"); 
				ДанныеПоНДС		= КНП_БезопасноПрочитатьЗначение(Всего, "СумНалВсего");
				
				Если ЗначениеЗаполнено(ДанныеПоНДС) Тогда
					
					СуммаНДССтруктура 	= КНП_БезопасноПрочитатьЗначение(ДанныеПоНДС, "СумНал");
					
					Если ЗначениеЗаполнено(СуммаНДССтруктура) Тогда
						СуммаНДС = КНП_БезопасноПрочитатьЗначение(СуммаНДССтруктура, "Значение");
					КонецЕсли;
					
				КонецЕсли;
				
				СуммаСНДСИтого 	= КНП_БезопасноПрочитатьЗначение(Всего, "СтТовУчНалВсего");	
				
			КонецЕсли;
			
			
			//////////////////////	ТЧ Товары	///////////////////////////////
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДанныеУслуг) Тогда
			
			////////////////////////		ТЧ услуг	//////////////////////////////////
			Работа = КНП_БезопасноПрочитатьЗначение(ДанныеУслуг, "Работа");
			
			Если ЗначениеЗаполнено(Работа) Тогда
				
				Услуги = XML_ПолучитьМассивИзСтруктуры(Работа);
				МетаданныеТЧ = СтруктураДокумента.ТабличнаяЧасть.Колонки;
				
				Для Каждого Услуга Из Услуги Цикл
					
					СтрТабЧасти = СтруктураДокумента.ТабличнаяЧасть.Добавить();
					СтрТабЧасти.НомерСтроки = НомерСтроки;
					НомерСтроки = НомерСтроки + 1;
					СтрТабЧасти.Товар 					= КНП_БезопасноПрочитатьЗначение(Услуга, "НаимРабот");
					
					Если МетаданныеТЧ.Найти("Описание") <> Неопределено Тогда
						
						СтрТабЧасти.Описание 			= КНП_БезопасноПрочитатьЗначение(Услуга, "Описание");	
						
						Если ТипЗнч(СтрТабЧасти.Описание) = Тип("Структура") Тогда
							СтрТабЧасти.Описание		= КНП_БезопасноПрочитатьЗначение(Услуга.Описание, "Значение");
						КонецЕсли;
						
					КонецЕсли;
					
					СтрТабЧасти.ЕдиницаИзмерения 		= КНП_БезопасноПрочитатьЗначение(Услуга, "НаимЕдИзм");
					
					//Специально для ТЭК-ТОРГ
					Если СтрТабЧасти.ЕдиницаИзмерения = "0000" Тогда
						СтрТабЧасти.ЕдиницаИзмерения = "--";
					КонецЕсли;
					
					//Специально для ТЭК-ТОРГ
					СтрТабЧасти.Количество 				= КНП_БезопасноПрочитатьЗначение(Услуга, "Количество");
					СтрТабЧасти.Количество 				= ?(СтрТабЧасти.Количество = "0.00" ИЛИ НЕ ЗначениеЗаполнено(СтрТабЧасти.Количество), "--", СтрТабЧасти.Количество);
					СтрТабЧасти.Цена 					= КНП_БезопасноПрочитатьЗначение(Услуга, "Цена");
					СтрТабЧасти.Цена 					= ?(СтрТабЧасти.Цена = "0.00" ИЛИ НЕ ЗначениеЗаполнено(СтрТабЧасти.Цена), "--", СтрТабЧасти.Цена);
					СтрТабЧасти.Сумма 					= КНП_БезопасноПрочитатьЗначение(Услуга, "СтоимБезНДС");
					
					Если МетаданныеТЧ.Найти("НДС") <> Неопределено Тогда
						
						СтрТабЧасти.НДС 				= КНП_БезопасноПрочитатьЗначение(Услуга, "СумНДС");
						
						Если НЕ ЗначениеЗаполнено(СтрТабЧасти.НДС) Тогда
							
							Если НРег(СтрТабЧасти.СтавкаНДС) = "без ндс" Тогда
								СтрТабЧасти.НДС = СтрТабЧасти.СтавкаНДС;
							Иначе
								СтрТабЧасти.НДС = "0.00";
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЕсли;
					
					Если МетаданныеТЧ.Найти("СуммаСНДС") <> Неопределено Тогда
						СтрТабЧасти.СуммаСНДС 			= КНП_БезопасноПрочитатьЗначение(Услуга, "СтоимУчНДС");	
					КонецЕсли;
					
					Если МетаданныеТЧ.Найти("СтавкаНДС") <> Неопределено Тогда
						СтрТабЧасти.СтавкаНДС 			= КНП_БезопасноПрочитатьЗначение(Услуга, "НалСт");
					КонецЕсли;	
					
					СтавкаНДС 							= КНП_БезопасноПрочитатьЗначение(Услуга, "НалСт");
					
					Если МетаданныеТЧ.Найти("Товар") <> Неопределено Тогда
						СтрТабЧасти.Наименование 		= СтрТабЧасти.Товар;
					КонецЕсли;
					
					Если МетаданныеТЧ.Найти("Содержание") <> Неопределено И МетаданныеТЧ.Найти("Описание") <> Неопределено  Тогда
						СтрТабЧасти.Содержание 			= СтрТабЧасти.Описание;
					КонецЕсли;
					
					Если МетаданныеТЧ.Найти("СуммаНДС") <> Неопределено Тогда
						СтрТабЧасти.СуммаНДС 			= СтрТабЧасти.НДС;
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
			СуммаИтого 		= КНП_БезопасноПрочитатьЗначение(ДанныеУслуг, "СтБезНДСИт"); 
			СуммаНДС 		= КНП_БезопасноПрочитатьЗначение(ДанныеУслуг, "СумНДСИт");
			СуммаСНДСИтого 	= КНП_БезопасноПрочитатьЗначение(ДанныеУслуг, "СтУчНДСИт");
			
			////////////////////////		ТЧ услуг	//////////////////////////////////
		КонецЕсли;
		
		///////////////////////////////////////////////////////////////////
		//			Подписанты
		Если ДанныеДокумента.Свойство("Подписант") Тогда
			
			ПодписантЮЛ = КНП_БезопасноПрочитатьЗначение(ДанныеДокумента.Подписант, "ЮЛ");
			
			Если ЗначениеЗаполнено(ПодписантЮЛ) Тогда
				
				ДолжностьПодписанта = КНП_БезопасноПрочитатьЗначение(ПодписантЮЛ, "Должн");
				ПодписантФИО = КНП_БезопасноПрочитатьЗначение(ПодписантЮЛ, "ФИО");
				
				Если ЗначениеЗаполнено(ПодписантФИО) Тогда
					
					ФИОПодписанта = "";
					
					Если ПодписантФИО.Свойство("Фамилия") Тогда
						ФИОПодписанта = ПодписантФИО.Фамилия + " ";
					КонецЕсли;
					
					Если ПодписантФИО.Свойство("Имя") Тогда
						ФИОПодписанта = ФИОПодписанта + ПодписантФИО.Имя + " ";
					КонецЕсли;
					
					Если ПодписантФИО.Свойство("Отчество") Тогда
						ФИОПодписанта = ФИОПодписанта + ПодписантФИО.Отчество;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		КоличествоСтрок = НомерСтроки - 1;
		
		/////////////////////////////////////////////////////////////////
		//		Обработка данных документа	(Конец)
	КонецЕсли;
	
	ИнфПок = КНП_БезопасноПрочитатьЗначение(СтруктураДанных, "ИнфПок");
	
	Если ЗначениеЗаполнено(ИнфПок) Тогда
		ИмяКонтрагента = КНП_БезопасноПрочитатьЗначение(ИнфПок, "НаимЭконСубСост");	
	КонецЕсли;
	
	
	Если НЕ ЗначениеЗаполнено(СуммаИтого) Тогда
		СуммаИтого = 0;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СуммаНДС) Тогда
		СуммаНДС = 0;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СуммаСНДСИтого) Тогда
		СуммаСНДСИтого = 0;
	КонецЕсли;
	
	
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "ДоговорОснование",				ДоговорОснование);	
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "ПредставлениеОператора", 		ПредставлениеОператора);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "ИдентификаторЭД",				ИдентификаторЭД);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "ИдентификаторОтправителя",		ИдентификаторОтправителя);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "ИдентификаторПолучателя", 		ИдентификаторПолучателя);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "Номер", 							НомерДокумента);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "Дата", 							ДатаДокумента);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "НомерОснования", 				НомерОснованияКорректировки);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "ДатаОснования", 					ДатаОснованияКорректировки);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "КоррСчетБанка", 					КоррСчетБанкаОрганизации);
	
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "ПредставлениеОрганизации", 		ИмяОрганизации);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "ИННОрганизации", 				ИННОрганизации);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "КППОрганизации", 				КППОрганизации);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "АдресОрганизации", 				АдресОрганизации);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "Банк", 							БанкОрганизации);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "БИК", 							БИКБанкаОрганизации);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "СчетПолучателя", 				СчетОрганизации);
	
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "ПредставлениеКонтрагента", 		ИмяКонтрагента);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "ИННКонтрагента", 				ИННКонтрагента);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "КППКонтрагента", 				КППКонтрагента);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "АдресКонтрагента", 				АдресКонтрагента);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "БанкКонтрагента", 				БанкКонтрагента);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "БИККонтрагента", 				БИКБанкаКонтрагента);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "СчетКонтрагента", 				СчетКонтрагента);
	
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "ПредставлениеГрузоотправителя", 	ИмяГрузоотправителя);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "ИННГрузоотправителя", 			ИННГрузоотправителя);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "КППГрузоотправителя", 			КППГрузоотправителя);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "АдресГрузоотправителя", 			АдресГрузоотправителя);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "БанкГрузоотправителя", 			БанкГрузоотправителя);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "БИКГрузоотправителя", 			БИКБанкаГрузоотправителя);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "СчетГрузоотправителя", 			СчетГрузоотправителя);
	
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "ПредставлениеГрузополучателя", 	ИмяГрузополучателя);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "ИННГрузополучателя", 			ИННГрузополучателя);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "КППГрузополучателя", 			КППГрузополучателя);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "АдресГрузополучателя", 			АдресГрузополучателя);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "БанкГрузополучателя", 			БанкГрузополучателя);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "БИКГрузополучателя", 			БИКБанкаГрузополучателя);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "СчетГрузополучателя", 			СчетГрузополучателя);
	
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "СуммаНДС", 						?(СуммаНДС = "0.00", "--", СуммаНДС));
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "НДСИтого", 						?(СуммаНДС = "0.00", "0.00", СуммаНДС));
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "СуммаИтого", 					?(СуммаИтого = "0.00", "--", СуммаИтого) );
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "СуммаСНДСИтого", 				СуммаСНДСИтого);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "МассаБруттоИтого", 				?(ЗначениеЗаполнено(МассаБруттоИтого), КНП_ФорматСумм(МассаБруттоИтого), "") );
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "КоличествоИтого", 				?(ЗначениеЗаполнено(КоличествоИтого), КНП_ФорматСумм(КоличествоИтого), "") );
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "КоличествоМестИтого",			?(ЗначениеЗаполнено(КоличествоМестИтого), КНП_ФорматСумм(КоличествоМестИтого), "") );
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "СтавкаНДС", 						СтавкаНДС);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "КоличествоСтрок", 				КНП_СформироватьЧислоПрописью(КоличествоСтрок) );
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "КоличествоЗаписей",				КНП_СформироватьЧислоПрописью(КоличествоЗаписей) );
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "ПлатежноРасчетныйДокумент",		ПлатежноРасчетныйДокумент);
	
	Если СтруктураДокумента.Свойство("СуммаСНДСИтого") И ЗначениеЗаполнено(Валюта) Тогда
		КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "СуммаПрописью", 				КНП_СформироватьСуммуПрописью(Число(СтруктураДокумента.СуммаСНДСИтого), Валюта));
	КонецЕсли;
	
	Если СтруктураДокумента.Свойство("НДСИтого") И ЗначениеЗаполнено(Валюта) И КНП_ЭтоЧисло(СтруктураДокумента.НДСИтого, Истина) Тогда
		КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "НДСПрописью", 				КНП_СформироватьСуммуПрописью(Число(СтруктураДокумента.НДСИтого), Валюта));
	КонецЕсли;
	
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "ДолжностьПодписанта", 			ДолжностьПодписанта);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "ФИОПодписанта", 					ФИОПодписанта);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "ТипУПД", 						ТипУПД);
	
	Если ЗначениеЗаполнено(Валюта) Тогда
		КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "Валюта", 					Валюта.НаименованиеПолное + ", " + Валюта.Код);
	КонецЕсли;
	
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "ИдентификаторГосКонтракта", 		ИдентификаторГосКонтракта);
	
	Если ЭтоКорректировка Тогда
		
		КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "РазницаУвеличение", 			КНП_ФорматСумм(Число(РазницаУвеличение) ) );
		КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "РазницаНДСУвеличение", 		КНП_ФорматСумм(Число(РазницаНДСУвеличение) ) );
		КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "РазницаСНДСУвеличение", 		КНП_ФорматСумм(Число(РазницаСНДСУвеличение) ) );
		КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "РазницаУменьшение", 			КНП_ФорматСумм(Число(РазницаУменьшение) ) );
		КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "РазницаНДСУменьшение", 		КНП_ФорматСумм(Число(РазницаНДСУменьшение) ) );
		КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "РазницаСНДСУменьшение", 		КНП_ФорматСумм(Число(РазницаСНДСУменьшение) ) );
		КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "РазницаАкцизУвеличение", 	КНП_ФорматСумм(Число(РазницаАкцизУвеличение) ) );
		КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "РазницаАкцизУменьшение", 	КНП_ФорматСумм(Число(РазницаАкцизУменьшение) ) );
		
	КонецЕсли;
	
	Если СтруктураДокумента.Свойство("КоличествоИтогоПрописью") И СтруктураДокумента.Свойство("КоличествоИтого") И ЗначениеЗаполнено(СтруктураДокумента.КоличествоИтого) Тогда
		СтруктураДокумента.КоличествоИтогоПрописью = 								КНП_СформироватьЧислоПрописью(СтруктураДокумента.КоличествоИтого);
	КонецЕсли;
	
	Если СтруктураДокумента.Свойство("МассаБруттоИтогоПрописью") И СтруктураДокумента.Свойство("МассаБруттоИтого") И ЗначениеЗаполнено(СтруктураДокумента.МассаБруттоИтого) Тогда
		СтруктураДокумента.МассаБруттоИтогоПрописью = 								КНП_СформироватьЧислоПрописью(СтруктураДокумента.МассаБруттоИтого);
	КонецЕсли;
	
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "ИнфоПоля", ИнфоПоля);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "ДатаОтпуска", 					ДатаОтпускаГруза);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "ДолжностьОтпуска",				ДолжностьОтпустившегоГруз);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "ФИООтпуска",						ФИООтпустившегоГруз);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "ДатаОтгрузкиПередачи",			ДатаОтгрузкиПередачи);
	
	//Изменения с 01.07.2021 - прослеживаемость и документы об отгрузке
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "ДокументыОбОтгрузке",			ДокументыОбОтгрузке);
	
КонецПроцедуры

