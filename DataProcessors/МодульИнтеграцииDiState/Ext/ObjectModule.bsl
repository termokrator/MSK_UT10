Функция КНП_ПроверкаКорректностиЗаполненияРеквизитов()
	
	Результат = "";
	АдреснаяСтруктураОрганизации = КЗП_ПолучитьСтруктуруАдресаИзБазы(Организация, КНП_ИмяКонфигурации() );
	
	Если АдреснаяСтруктураОрганизации = Неопределено Тогда
		Результат = "Проверка адреса организации " + Организация + ": Отсутствуют данные об адресе в базе";
	Иначе
		
		Для Каждого Поле Из АдреснаяСтруктураОрганизации Цикл
			
			Если НЕ ЗначениеЗаполнено(Поле.Значение) Тогда
				
				Если Поле.Ключ = "Индекс" ИЛИ Поле.Ключ = "КодРегиона" Тогда
					Результат = Результат + "Поле " + Поле.Ключ + " не заполнено; ";
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если ЗначениеЗаполнено(Результат) Тогда
			Результат = "Проверка адреса организации " + Организация + ": " + Результат;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция КНП_ПолучитьСтруктуруИзСоответствия(ЗначВход)
	
	СтруктураВозврат=Новый Структура;
	
	Если ТипЗнч(ЗначВход) = Тип("Соответствие") Тогда
		
		ФлагОщибка = Ложь;
		
		Для Каждого р Из ЗначВход Цикл
			
			Попытка
				СтруктураВозврат.Вставить(р.Ключ,КНП_ПолучитьСтруктуруИзСоответствия(р.Значение));
			Исключение
				
				ФлагОщибка = Истина;
				Прервать;
				
			КонецПопытки;
			
		КонецЦикла;
		
		Если ФлагОщибка Тогда // пришел ключ который невозможно поместить в структуру
			
			СтруктураВозврат = Новый Массив;
			
			Для Каждого р Из ЗначВход Цикл
				
				ДопСтруктура = Новый Структура;
				ДопСтруктура.Вставить("Ключ", р.Ключ);
				ДопСтруктура.Вставить("Значение", КНП_ПолучитьСтруктуруИзСоответствия(р.Значение));
				СтруктураВозврат.Добавить(ДопСтруктура);
				
			КонецЦикла;
			
		КонецЕсли;
		
		Возврат СтруктураВозврат; 
		
	ИначеЕсли ТипЗнч(ЗначВход)=Тип("Массив") Тогда
		
		НовыйМассив=Новый Массив;
		
		Для Каждого ЭлМ Из ЗначВход Цикл
			НовыйМассив.Добавить(КНП_ПолучитьСтруктуруИзСоответствия(ЭлМ));
		КонецЦикла;
		
		Возврат НовыйМассив;
		
	КонецЕсли;
	
	Возврат ЗначВход; 
	
КонецФункции

Процедура КНП_СформироватьРеквизитыВБазе() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	МенеджерДопСведений = МОП_ПолучитьМенеджераДопСведений();
	ДопРеквизитИдентификаторКонтрагента 					= МенеджерДопСведений.НайтиПоНаименованию("DS_Контрагент_ID");
	
	Если ДопРеквизитИдентификаторКонтрагента.Пустая() Тогда
		
		ДопРеквизитИдентификаторКонтрагента 				= МенеджерДопСведений.СоздатьЭлемент();
		ДопРеквизитИдентификаторКонтрагента.Наименование 	= "DS_Контрагент_ID";
		
		Если ДопРеквизитИдентификаторКонтрагента.Метаданные().Реквизиты.Найти("Заголовок") <> Неопределено Тогда
			ДопРеквизитИдентификаторКонтрагента.Заголовок 	= "DS_Контрагент_ID";	
		КонецЕсли;
		
		ДопРеквизитИдентификаторКонтрагента.ТипЗначения 	= Новый ОписаниеТипов("Число");
		ДопРеквизитИдентификаторКонтрагента.ОбменДанными.Загрузка = Истина;
