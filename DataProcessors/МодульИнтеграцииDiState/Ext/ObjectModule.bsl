Функция ФОД_ПолучитьНаименованиеТовара(ВерсияЗаполнения, Знач ОбъектЗаполнения)	
	
	//Наименование товара игнорирует акты выполненных работ
	Если ОбъектЗаполнения.Свойство("Ссылка") И ЗначениеЗаполнено(ОбъектЗаполнения.Ссылка) Тогда
		
		Если МОП_ЭтоАктВыполненныхРабот(ОбъектЗаполнения.Ссылка) Тогда
			
			Если ОбъектЗаполнения.Свойство("Содержание") И ЗначениеЗаполнено(ОбъектЗаполнения.Содержание) Тогда
				Возврат ОбъектЗаполнения.Содержание;
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе  
		
		Если ОбъектЗаполнения.Свойство("Содержание") И ЗначениеЗаполнено(ОбъектЗаполнения.Содержание) Тогда
			Возврат ОбъектЗаполнения.Содержание;
		КонецЕсли; 
		
	КонецЕсли;
	
	Если ОбъектЗаполнения.Свойство("Номенклатура") И ЗначениеЗаполнено(ОбъектЗаполнения.Номенклатура) Тогда
		
		СтрокаБренда = "";
		
		Если ЗначениеЗаполнено(ОбъектЗаполнения.Номенклатура.Родитель) Тогда
			СтрокаБренда = " (" + Строка(ОбъектЗаполнения.Номенклатура.Родитель) + ")"	
		КонецЕсли;
		
		//+Гавриленков В. 04.02.2026 #UT10-5679
		//Возврат СтрЗаменить(ОбъектЗаполнения.Номенклатура.Наименование, "()", "") + СтрокаБренда;
		Возврат СтрЗаменить(ОбъектЗаполнения.Номенклатура.НаименованиеПолное, "()", "") + СтрокаБренда;
		//-Гавриленков В. 04.02.2026 #UT10-5679
		
	КонецЕсли; 
	
	Если ОбъектЗаполнения.Свойство("Ссылка") И ЗначениеЗаполнено(ОбъектЗаполнения.Ссылка) Тогда
		
		Если МОП_ЭтоСчетФактураНаАванс(ОбъектЗаполнения.Ссылка) Тогда
			Возврат "Предварительная оплата";
		КонецЕсли; 
		
	КонецЕсли;  
	
	Возврат ""; 
	
КонецФункции

Функция ФОД_ПолучитьОписаниеТовара(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	
	Если ОбъектЗаполнения.Свойство("Содержание") И ЗначениеЗаполнено(ОбъектЗаполнения.Содержание) Тогда
