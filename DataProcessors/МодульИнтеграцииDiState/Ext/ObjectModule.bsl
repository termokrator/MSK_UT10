Функция XML_ПрочитатьВСтруктуру(ОбъектXML)
	
	Структура = Новый Структура;
	
	Если ТипЗнч(ОбъектXML) = Тип("ЧтениеXML") Тогда
		
		Попытка
			
			ОбъектXML.Прочитать();
			
			Если ОбъектXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
				XML_ОбработатьНовыйУзел(Структура, ОбъектXML);
			КонецЕсли;
			
		Исключение
			
			ДобавитьВЖурнал(ОписаниеОшибки(), "ПрочитатьXMLВСтруктуру");
			Структура = Неопределено;
			
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Структура;

КонецФункции

Процедура XML_ОбработатьНовыйУзел(КорневаяСтруктура, УзелXML)
	
	УзловаяСтруктура = Новый Структура;
	ИмяУзла = УзелXML.Имя;
	КоличествоЭлементов = УзелXML.КоличествоАтрибутов();
	
	Для Итер = 1 По КоличествоЭлементов Цикл
		
		УзелXML.ПрочитатьАтрибут();
		
		Попытка
			УзловаяСтруктура.Вставить(УзелXML.Имя, УзелXML.Значение);
		Исключение
		КонецПопытки;
		
	КонецЦикла;	
	
	Пока УзелXML.Прочитать() Цикл
		
		Если УзелXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			XML_ОбработатьНовыйУзел(УзловаяСтруктура, УзелXML);
		КонецЕсли;
		
		Если УзелXML.ИмеетЗначение Тогда
			УзловаяСтруктура.Вставить("Значение", УзелXML.Значение);	
		КонецЕсли;
		
		Если УзелXML.ТипУзла = ТипУзлаXML.КонецЭлемента И ИмяУзла = УзелXML.Имя Тогда
			
			Если НЕ КорневаяСтруктура.Свойство(ИмяУзла) Тогда
				КорневаяСтруктура.Вставить(ИмяУзла, УзловаяСтруктура);
			Иначе
				
				ЗначениеУзла = Неопределено;
				Выполнить("ЗначениеУзла = КорневаяСтруктура." + ИмяУзла);
				
				Если ТипЗнч(ЗначениеУзла) = Тип("Массив") Тогда
					Выполнить("КорневаяСтруктура." + ИмяУзла + ".Добавить(УзловаяСтруктура)");	
				Иначе
					
					ЗначениеУзла = Новый Массив;
					Выполнить("ЗначениеУзла.Добавить(КорневаяСтруктура." + ИмяУзла + ")");
					ЗначениеУзла.Добавить(УзловаяСтруктура);
					КорневаяСтруктура.Вставить(ИмяУзла, ЗначениеУзла);
					
				КонецЕсли;
				
			КонецЕсли;
			
			Возврат;
			
		КонецЕсли;		
		
	КонецЦикла;

КонецПроцедуры

Функция XML_ПолучитьМассивИзСтруктуры(СтруктураXML)
	
	Если ТипЗнч(СтруктураXML) = Тип("Структура") Тогда
		
		МассивXML = Новый Массив;
		МассивXML.Добавить(СтруктураXML);
		
	ИначеЕсли ТипЗнч(СтруктураXML) = Тип("Массив") Тогда
		МассивXML = СтруктураXML;
	Иначе
		МассивXML = Новый Массив;
	КонецЕсли;
	
	Возврат МассивXML;
	
КонецФункции

Функция XML_ЗаменитьИнфоПоляВДокументе(ДанныеДокумента, СтруктураИнфоПолей)
	
	ЧтениеДокумента = Новый ЧтениеXML;
	ЧтениеДокумента.УстановитьСтроку(ДанныеДокумента);
	
	ПостроительDOM = Новый ПостроительDOM;
	ДокументDOM = ПостроительDOM.Прочитать(ЧтениеДокумента);
	ЧтениеДокумента.Закрыть();
	
	//Логика записи инфополей
	МассивДанныхИнфоПолей = СтруктураИнфоПолей.СписокЗначенийИнфоПоля;
	СписокТоваровDOM = ДокументDOM.ПолучитьЭлементыПоИмени("СведТов");
	
	Если СписокТоваровDOM.Количество() = 0 Тогда
		СписокТоваровDOM = ДокументDOM.ПолучитьЭлементыПоИмени("СвТов");
	КонецЕсли;
	
	Для Каждого ТоварDOM Из СписокТоваровDOM Цикл
		
		СписокИнфоПолей = ТоварDOM.ПолучитьЭлементыПоИмени("ИнфПолФХЖ2");
		
		Для Каждого ЭлементDOM Из СписокИнфоПолей Цикл
			ТоварDOM.УдалитьДочерний(ЭлементDOM);		
		КонецЦикла;
		
	КонецЦикла;
	
	Для Каждого ИнфоПоле Из МассивДанныхИнфоПолей Цикл
		
		Для Каждого ТоварDOM Из СписокТоваровDOM Цикл
			
			Если ИнфоПоле.Товар = ТоварDOM.ПолучитьАтрибут("НаимТов") Тогда
				
				ЭлементИнфоПоляDOM = ДокументDOM.СоздатьЭлемент("ИнфПолФХЖ2");
				ЭлементИнфоПоляDOM = ТоварDOM.ДобавитьДочерний(ЭлементИнфоПоляDOM);
				ЭлементИнфоПоляDOM.УстановитьАтрибут("Идентиф", ИнфоПоле.КлючИнфоПоля);
				ЭлементИнфоПоляDOM.УстановитьАтрибут("Значен", ИнфоПоле.ЗначениеИнфоПоля);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	//Поскольку в XML важен порядок тегов - удаляем и вставляем ДопСведТов
	Для Каждого ТоварDOM Из СписокТоваровDOM Цикл
		
		СписокИнфоПолей = ТоварDOM.ПолучитьЭлементыПоИмени("ДопСведТов");
		
		Для Каждого ЭлементDOM Из СписокИнфоПолей Цикл
			
			ТоварDOM.УдалитьДочерний(ЭлементDOM);
			ТоварDOM.ДобавитьДочерний(ЭлементDOM);
			
		КонецЦикла;
		
	КонецЦикла;
	
	//Запись изменений в XML
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку("windows-1251");
	
	ЗаписьDOM = Новый ЗаписьDOM;
	ЗаписьDOM.Записать(ДокументDOM, ЗаписьXML);
	Результат = ЗаписьXML.Закрыть();
	
	ВременныйФайл = ПолучитьИмяВременногоФайла("xml");
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.ДобавитьСтроку(Результат);
	ТекстовыйДокумент.Записать(ВременныйФайл,"windows-1251");
	
	ДвоичныеДанные = Новый ДвоичныеДанные(ВременныйФайл);
	УдалитьФайлы(ВременныйФайл);
	
	Результат = Base64Строка(ДвоичныеДанные);
	Возврат КНП_ОбработатьСтрокуBase64(Результат);

КонецФункции

Функция XML_ПрочитатьМассивТоваровДокумента(ДанныеДокумента)
	
	ЧтениеДокумента = Новый ЧтениеXML;
	ЧтениеДокумента.УстановитьСтроку(ДанныеДокумента);
	
	ПостроительDOM = Новый ПостроительDOM;
	ДокументDOM = ПостроительDOM.Прочитать(ЧтениеДокумента);
	ЧтениеДокумента.Закрыть();
	
	МассивТоваров = Новый Массив;
	СписокТоваровDOM = ДокументDOM.ПолучитьЭлементыПоИмени("СведТов");
	
	Если СписокТоваровDOM.Количество() = 0 Тогда
		СписокТоваровDOM = ДокументDOM.ПолучитьЭлементыПоИмени("СвТов");
	КонецЕсли;
	
	Для Каждого ТоварDOM Из СписокТоваровDOM Цикл
		
		Если ТоварDOM.ПолучитьАтрибут("НаимТов") <> Неопределено Тогда
			
			СписокИнфоПолей = ТоварDOM.ПолучитьЭлементыПоИмени("ИнфПолФХЖ2");
			
			Если СписокИнфоПолей.Количество() > 0 Тогда
				
				Для Каждого ЭлементDOM Из СписокИнфоПолей Цикл
					
					СтруктураЭлемента = Новый Структура("Товар,КлючИнфоПоля,ЗначениеИнфоПоля");
					СтруктураЭлемента.Товар = ТоварDOM.ПолучитьАтрибут("НаимТов");
					СтруктураЭлемента.КлючИнфоПоля = ЭлементDOM.ПолучитьАтрибут("Идентиф");
					СтруктураЭлемента.ЗначениеИнфоПоля = ЭлементDOM.ПолучитьАтрибут("Значен");
					МассивТоваров.Добавить(СтруктураЭлемента);
					
				КонецЦикла;
				
			Иначе
				
				СтруктураЭлемента = Новый Структура("Товар,КлючИнфоПоля,ЗначениеИнфоПоля");
				СтруктураЭлемента.Товар = ТоварDOM.ПолучитьАтрибут("НаимТов");
				МассивТоваров.Добавить(СтруктураЭлемента);	
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивТоваров;	

КонецФункции

