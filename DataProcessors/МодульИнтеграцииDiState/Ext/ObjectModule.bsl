Функция ФОД_ПолучитьЦенуДо(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	
	Результат = 0;
	
	Если ОбъектЗаполнения.Свойство("Ссылка") Тогда
		НДСВСумме = МОП_ДокументВключаетНДСВСумму(ОбъектЗаполнения.Ссылка);
	Иначе
		НДСВСумме = Ложь;
	КонецЕсли;
	
	Если ОбъектЗаполнения.Свойство("ЦенаДоИзменения") Тогда
		
		Если НЕ НДСВСумме Тогда
			Результат = ОбъектЗаполнения.ЦенаДоИзменения;
		Иначе
			
			КоличествоТовара = ФОД_ПолучитьКоличествоДо(ВерсияЗаполнения, ОбъектЗаполнения);
			
			Если КоличествоТовара <> Неопределено  Тогда
				Результат = ФОД_ПолучитьСуммуДо(ВерсияЗаполнения, ОбъектЗаполнения) / ?(КоличествоТовара > 0, КоличествоТовара, 1);
			КонецЕсли;  
			
		КонецЕсли;
		
	КонецЕсли;
	
	КоличествоТовара = ФОД_ПолучитьКоличествоДо(ВерсияЗаполнения, ОбъектЗаполнения);
	
	Если НЕ ЗначениеЗаполнено(КоличествоТовара) Тогда
		
		Если ОбъектЗаполнения.Свойство("Ссылка") И НЕ МОП_ЭтоСчетНаОплату(ОбъектЗаполнения.Ссылка)  Тогда
			Результат = 0;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

