Функция РС_СформироватьОбъектКорректировка(ОбъектДанных, Подразделение, УПД = Ложь)
	
	МассивОбъектов = Новый Массив;
	
	Если ТипЗнч(ОбъектДанных) = Тип("Соответствие") Тогда
		
		ДанныеДокумента = ОбъектДанных.Получить("invoiceCorrection");
		ДанныеИсправляемогоДокумента = ДанныеДокумента.Получить("invoice");
		
	Иначе
		
		ДанныеДокумента = ОбъектДанных;
		ДанныеИсправляемогоДокумента = ОбъектДанных;
		
	КонецЕсли;
	
	ДокОбъект = МОП_СоздатьВходящийКорректировка();
	
	Если ДокОбъект = Неопределено Тогда
		Возврат МассивОбъектов;
	КонецЕсли;
	
	ЭтоИсправление = Ложь; 
	МОП_ЗаполнитьОрганизацию(ДокОбъект, ОбъектДанных);
	МОП_ЗаполнитьКонтрагентаПартнера(ДокОбъект, Подразделение, ОбъектДанных);
	МОП_ЗаполнитьДоговор(ДокОбъект, ДанныеДокумента);
	МОП_ЗаполнитьВалюту(ДокОбъект, ДанныеДокумента);	
	МОП_ЗаполнитьДокументыОснования(ДокОбъект, ДанныеИсправляемогоДокумента, ЭтоИсправление);	
	СуммаВключаетНДС = Ложь;	
	
	Если КНП_ЕстьТабЧасть(ДокОбъект, "Товары") Тогда
		
		Если ТипЗнч(ОбъектДанных) = Тип("Соответствие") Тогда
			ТаблицаТоваров = РС_ПрочитатьТаблицуТоваров(ОбъектДанных.Получить("table") );
		Иначе
			ТаблицаТоваров = РС_ОбработатьТЧСтруктурыПФ(ОбъектДанных.ТабличнаяЧасть, ОбъектДанных);	
		КонецЕсли;
		
		Для Каждого Товар Из ТаблицаТоваров Цикл
			
			НовыйТовар = ДокОбъект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НовыйТовар, Товар);
			НовыйТовар.Номенклатура = РС_НайтиНоменклатуру(Товар.Наименование, Подразделение);
			
			Если НовыйТовар.Номенклатура.Пустая() Тогда
				НовыйТовар.Номенклатура = КЗП_СоздатьНовуюНоменклатуру(Товар);
			КонецЕсли;
			
			Если МОП_НДСВСуммеПоСтавке(Товар.СтавкаНДС) Тогда
				СуммаВключаетНДС = Истина;
			КонецЕсли;
			
			Если КНП_ЕстьОбъектМетаданных("ЕдиницыИзмерения") Тогда
				
				Если НовыйТовар.ЕдиницаИзмерения.Пустая() Тогда
					НовыйТовар.ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.НайтиПоНаименованию(Товар.ЕдиницаИзмерения.Наименование);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если КНП_ЕстьТабЧасть(ДокОбъект, "Расхождения") Тогда
		
		Если ТипЗнч(ОбъектДанных) = Тип("Соответствие") Тогда
			ТаблицаТоваров = РС_ПрочитатьТаблицуТоваров(ОбъектДанных.Получить("table") );
		Иначе
			ТаблицаТоваров = РС_ОбработатьТЧСтруктурыПФ(ОбъектДанных.ТабличнаяЧасть, ОбъектДанных);	
		КонецЕсли;
		
		Для Каждого Товар Из ТаблицаТоваров Цикл
			
			Если НЕ РС_ЕстьРасхождения(Товар) Тогда
				Продолжить;
			КонецЕсли;
			
			НовыйТовар = ДокОбъект.Расхождения.Добавить();
			ЗаполнитьЗначенияСвойств(НовыйТовар, Товар);
			НовыйТовар.Номенклатура = РС_НайтиНоменклатуру(Товар.Наименование, Подразделение);
			
			Если НовыйТовар.Номенклатура.Пустая() Тогда
				НовыйТовар.Номенклатура = КЗП_СоздатьНовуюНоменклатуру(Товар);
			КонецЕсли;
			
			НовыйТовар.Количество = Товар.КоличествоДоИзменения;
			НовыйТовар.Цена = Товар.ЦенаДоИзменения;
			НовыйТовар.Сумма = Товар.СуммаДоИзменения;
			НовыйТовар.СуммаНДС = Товар.СуммаНДСДоИзменения;
			НовыйТовар.СтавкаНДС = Товар.СтавкаНДСДоИзменения;
			
		КонецЦикла;
		
	КонецЕсли;
	
	КЗП_ЗаполнитьДопПараметрыДокумента(ДокОбъект, "Корректировка");
	МОП_ЗаполнитьРеквизитыДокумента(ДокОбъект, ДанныеДокумента, СуммаВключаетНДС, "Корректировка накладной");
	
	МассивОбъектов.Добавить(ДокОбъект);	
	
	Если УПД Тогда
		
		ДокОбъект.Записать();
		
		Попытка
			
			ДокСФ = РС_СформироватьСФПолученную(ДокОбъект.Ссылка);
			
			Если ДокСФ <> Неопределено Тогда
				МассивОбъектов.Добавить(ДокСФ);
			КонецЕсли;
			
		Исключение
			ДобавитьВЖурнал(ОписаниеОшибки(), "СформироватьОбъектКорректировка");	
		КонецПопытки
		
	КонецЕсли;
	
	Возврат МассивОбъектов;
	
КонецФункции

Функция РС_ОбработатьТЧСтруктурыПФ(Знач ТабличнаяЧасть, СсылкаНаДок = Неопределено)
	
	Для Каждого СтрокаТЧ Из ТабличнаяЧасть Цикл
		
		Если ТабличнаяЧасть.Колонки.Найти("ЕдиницаИзмерения") <> Неопределено Тогда
			
			Если ТипЗнч(СтрокаТЧ.ЕдиницаИзмерения) = Тип("Строка") Тогда
				
				ЕдиницаИзмеренияТовара = СправочникЕдиницыИзмерения.Найти(СтрокаТЧ.ЕдиницаИзмерения, "Название");
				
				Если ЗначениеЗаполнено(ЕдиницаИзмеренияТовара) Тогда
					СтрокаТЧ.ЕдиницаИзмерения = ЕдиницаИзмеренияТовара.Ссылка;
				КонецЕсли;	
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если ТабличнаяЧасть.Колонки.Найти("ЕдиницаИзмеренияКодДо") <> Неопределено Тогда
			
			Если СтрокаТЧ.ЕдиницаИзмеренияКод <> СтрокаТЧ.ЕдиницаИзмеренияКодДо Тогда
				ВывестиУведомлениеПользователю("Внимание! В корректировочном документе " + СсылкаНаДок.Номер +
				" от " + СсылкаНаДок.Дата + " отличаются единицы измерения до и после. 
				| После создания документа необходима ручная проверка");
			КонецЕсли;
			
		КонецЕсли;
		
		
		Если ТабличнаяЧасть.Колонки.Найти("СтавкаНДС") <> Неопределено Тогда
			
			Если ТипЗнч(СтрокаТЧ.СтавкаНДС) = Тип("Строка") Тогда
				СтрокаТЧ.СтавкаНДС = МОП_ПолучитьСтавкуНДСИзСтроки(СтрокаТЧ.СтавкаНДС);	
			КонецЕсли;
			
		КонецЕсли;
		
		Если ТабличнаяЧасть.Колонки.Найти("Сумма") <> Неопределено Тогда
			
			Если ТипЗнч(СтрокаТЧ.Сумма) = Тип("Строка") И КНП_ЭтоЧисло(СтрокаТЧ.Сумма, Истина) Тогда
				СтрокаТЧ.Сумма = Число(СтрокаТЧ.Сумма);	
			КонецЕсли;
			
		КонецЕсли;
		
		Если ТабличнаяЧасть.Колонки.Найти("СуммаНДС") <> Неопределено Тогда
			
			Если ТипЗнч(СтрокаТЧ.СуммаНДС) = Тип("Строка") И КНП_ЭтоЧисло(СтрокаТЧ.СуммаНДС, Истина) Тогда
				СтрокаТЧ.СуммаНДС = Число(СтрокаТЧ.СуммаНДС);	
			КонецЕсли;
			
		КонецЕсли;
		
		Если ТабличнаяЧасть.Колонки.Найти("СуммаСНДС") <> Неопределено Тогда
			
			Если ТипЗнч(СтрокаТЧ.СуммаСНДС) = Тип("Строка") И КНП_ЭтоЧисло(СтрокаТЧ.СуммаСНДС, Истина) Тогда
				СтрокаТЧ.СуммаСНДС = Число(СтрокаТЧ.СуммаСНДС);	
			КонецЕсли;
			
		КонецЕсли;
		
		Если ТабличнаяЧасть.Колонки.Найти("СтавкаНДСДоИзменения") <> Неопределено Тогда
			
			Если ТипЗнч(СтрокаТЧ.СтавкаНДСДоИзменения) = Тип("Строка") Тогда
				СтрокаТЧ.СтавкаНДСДоИзменения = МОП_ПолучитьСтавкуНДСИзСтроки(СтрокаТЧ.СтавкаНДСДоИзменения);	
			КонецЕсли;
			
		КонецЕсли;
		
		Если ТабличнаяЧасть.Колонки.Найти("Описание") <> Неопределено Тогда
			
			Если ТипЗнч(СтрокаТЧ.Описание) = Тип("Структура") Тогда
				СтрокаТЧ.Описание = КНП_БезопасноПрочитатьЗначение(СтрокаТЧ.Описание, "Значение");
			КонецЕсли;
			
		КонецЕсли;
		
		Если ТабличнаяЧасть.Колонки.Найти("Содержание") <> Неопределено Тогда
			
			Если ТипЗнч(СтрокаТЧ.Содержание) = Тип("Структура") Тогда
				СтрокаТЧ.Содержание = КНП_БезопасноПрочитатьЗначение(СтрокаТЧ.Содержание, "Значение");
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТабличнаяЧасть;

КонецФункции

Функция ПолучитьПартнеровИКонтрагентовДляОтправкиИсходящихСообщений()
	
	Запрос = Новый Запрос;    
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Текст = "ВЫБРАТЬ
	|	Контрагенты.Ссылка КАК Контрагент
	|ПОМЕСТИТЬ ВТ_Контрагенты
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.DS_Подразделение_ID > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Ссылка КАК Договор
	|ПОМЕСТИТЬ ВТ_ДоговорыКонтрагентов
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.DS_Подразделение_ID > 0";
	
	Пакет = Запрос.ВыполнитьПакетСПромежуточнымиДанными();
	
	СтруктураВозврата = Новый Структура("СписокКонтрагентов, СписокДоговоров", Неопределено, Неопределено);
	
	СтруктураВозврата.СписокКонтрагентов = Пакет[0].Выгрузить().ВыгрузитьКолонку("Контрагент");
	СтруктураВозврата.СписокДоговоров = Пакет[1].Выгрузить().ВыгрузитьКолонку("Договор");
	
	Возврат СтруктураВозврата;
	
КонецФУнкции

// Функция - Получить документы
//
// Параметры:
//  ОтборПоВиду			 - Строка	 - Отбор по виду документа. Разрешенные значения:
//										*Счет на оплату
//										*Торг-12
//										*Счет-фактура
//										*Акт сдачи-приема
//  ОтборПоКонтрагенту	 - СправочникСсылка.Контрагенты	 - Ссылка на контрагента, по которому осуществить отбор 
//  ДатаНачала			 - Дата	 - Дата начала отбора. Отбор по дате документа
//  ДатаКонца			 - Дата	 - Дата конца отбора. Отбор по дате документа
//  ОтборОтправленные	 - Булево	 - Если Истина - то выгружаются документы с заполненным идентификатором
//  Комментарий			 - Строка	 - Отбор по комментарию документа через ПОДОБНО.
// 
// Возвращаемое значение:
// ТаблицаЗначений  - Заполненная таблица значений по структуре "Исходящие данные"
//
Функция РС_ПолучитьДокументы(ОтборПоВиду = "", 
	ОтборПоКонтрагенту = Неопределено, 
	ДатаНачала = Неопределено, 
	ДатаКонца = Неопределено, 
	ОтборОтправленные = Ложь, 
	Комментарий = "", 
	УПД = Ложь)
	
	ТаблицаДанных = ИсходящиеДокументы.Выгрузить();
	ТаблицаДанных.Очистить();
	
	ВалютаРубли = МОП_ПолучитьВалютуПоКоду("643"); 
	
	Запрос = Новый Запрос;
	Запрос.Текст = КЗП_ПолучитьТекстЗапросаИсходящиеДокументы(ЗначениеЗаполнено(ДатаНачала) И ЗначениеЗаполнено(ДатаКонца), 
	ОтборОтправленные, 
	ЗначениеЗаполнено(Комментарий));
	
	Запрос.УстановитьПараметр("Свойство", МОП_ПолучитьРеквизит("DS_Документ_ID") );
	
	Если ЗначениеЗаполнено(ДатаНачала) Тогда
		Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ДатаКонца) Тогда
		Запрос.УстановитьПараметр("ДатаКонца", КонецДня(ДатаКонца) );
	КонецЕсли; 
	
	Запрос.УстановитьПараметр("Комментарий", "%" + Комментарий + "%");
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Валюта", ВалютаРубли);  
	
	СписокДоговоров = Новый Массив;
	СписокКонтрагентов = Новый Массив;
	
	//РС_УстановитьОтборПоКонтрагентам(СписокКонтрагентов);
	
	Если ЗначениеЗаполнено(ОтборПоКонтрагенту) Тогда
		
		Если ТипЗнч(ОтборПоКонтрагенту) = Тип("Массив") Тогда
			
			Для каждого ЭлементОтбора Из ОтборПоКонтрагенту Цикл
				
				Если ТипЗнч(ЭлементОтбора) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
					СписокДоговоров.Добавить(ЭлементОтбора);
				ИначеЕсли ТипЗнч(ЭлементОтбора) = Тип("СправочникСсылка.Контрагенты") Тогда
					
					СписокКонтрагентов.Добавить(ЭлементОтбора);	
					
					ВыборкаДоговоров = Справочники.ДоговорыКонтрагентов.Выбрать(,ЭлементОтбора);  
					
					Пока ВыборкаДоговоров.Следующий() Цикл
						
						Если ВыборкаДоговоров.DS_Подразделение_ID > 0 Тогда
							СписокДоговоров.Добавить(ВыборкаДоговоров.Ссылка);	
						КонецЕсли;							
						
					КонецЦикла;
					
				КонецЕсли;	
				
			КонецЦикла;	
			
		Иначе
			
			Если ТипЗнч(ОтборПоКонтрагенту) = Тип("СправочникСсылка.Контрагенты") Тогда
				
				СписокКонтрагентов.Добавить(ОтборПоКонтрагенту);  
				
				ВыборкаДоговоров = Справочники.ДоговорыКонтрагентов.Выбрать(,ОтборПоКонтрагенту);  
				
				Пока ВыборкаДоговоров.Следующий() Цикл
					Если ВыборкаДоговоров.DS_Подразделение_ID > 0 Тогда
						
						СписокДоговоров.Добавить(ВыборкаДоговоров.Ссылка);	
					КонецЕсли;							
					
				КонецЦикла;
				
			Иначе
				СписокДоговоров.Добавить(ОтборПоКонтрагенту);	
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		
		Рез = ПолучитьПартнеровИКонтрагентовДляОтправкиИсходящихСообщений();
		
		СписокКонтрагентов = Рез.СписокКонтрагентов; 
		СписокДоговоров = Рез.СписокДоговоров;
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Контрагент", СписокКонтрагентов);
	Запрос.УстановитьПараметр("Договор", СписокДоговоров);
	
	Попытка
		
		ТаблицаСведений = Запрос.Выполнить().Выгрузить();
		
		Для Каждого СтрокаТС Из ТаблицаСведений Цикл
			
			//Корректировка "на лету"
			Если КНП_ЕстьТабЧасть(СтрокаТС.Ссылка,"Услуги")	И СтрокаТС.Тип <> "Корректировка реализации" Тогда
				
				Если КНП_ЕстьТабЧасть(СтрокаТС.Ссылка, "Товары") И КНП_ЕстьТабЧасть(СтрокаТС.Ссылка, "Услуги") Тогда
					
					Если СтрокаТС.Ссылка.Услуги.Количество() > 0 И СтрокаТС.Ссылка.Товары.Количество() = 0 Тогда
						СтрокаТС.Тип = "Акт сдачи-приема";
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
			ЭтоАванс = Ложь;
			ДокументУПД = Ложь;
			
			//Отбор по признаку УПД \ не УПД
			Если УПД Тогда
				
				Если СтрокаТС.Тип = "Торг-12" ИЛИ СтрокаТС.Тип = "Акт сдачи-приема" ИЛИ Найти(СтрокаТС.Тип, "Корректир") Тогда
					
					Если Не ЗначениеЗаполнено(СтрокаТС.СФ) Тогда
						Продолжить;
					КонецЕсли;
					
					Если СтрокаТС.Тип = "Торг-12" ИЛИ СтрокаТС.Тип = "Акт сдачи-приема" Тогда
						
						СтрокаТС.Тип = "Универсальный передаточный документ";
						ДокументУПД = Истина;
						
					ИначеЕсли СтрокаТС.Тип = "Корректировка реализации" Тогда
						
						СтрокаТС.Тип = "Универсальный корректировочный документ";
						ДокументУПД = Истина;
						
					КонецЕсли;
					
				КонецЕсли;
				
				Если СтрокаТС.Тип = "Счет-фактура" Тогда
					
					Если МОП_ЭтоКорректировкаРеализации(МОП_ПолучитьСсылкуНаКорректировку(СтрокаТС.Ссылка) ) Тогда
						
						СтрокаТС.Тип = "Универсальный корректировочный документ";
						ДокументУПД = Истина;
						
					Иначе
						
						СтрокаТС.Тип = "Универсальный передаточный документ";
						ДокументУПД = Истина;
						
					КонецЕсли;
					
					Если МОП_ЭтоСчетФактураНаАванс(СтрокаТС.Ссылка) Тогда
						
						ЭтоАванс = Истина;
						ДокументУПД = Истина;
						
					КонецЕсли;
					
				КонецЕсли;
				
			Иначе
				
				Если СтрокаТС.Тип = "Счет-фактура" И МОП_ЭтоКорректировкаРеализации(МОП_ПолучитьСсылкуНаКорректировку(СтрокаТС.Ссылка) ) Тогда
					
					СтрокаТС.Тип = "Корректировочная Счет-фактура";
					ДокументУПД = Истина;
					
				ИначеЕсли СтрокаТС.Тип = "Счет-фактура" И МОП_ЭтоСчетФактураНаАванс(СтрокаТС.Ссылка) Тогда
					
					ЭтоАванс = Истина; 
					ДокументУПД = Истина;
					
				КонецЕсли;
				
			КонецЕсли;
			
			//Отбор по виду значения
			Если ЗначениеЗаполнено(ОтборПоВиду) Тогда
				
				Если ОтборПоВиду <> СокрЛП(СтрокаТС.Тип) Тогда
					
					Если Найти(ОтборПоВиду, "УПД / СЧФ (") И ДокументУПД Тогда
						
						Если ЭтоАванс И НЕ Найти(ОтборПоВиду, "аванс") Тогда
							Продолжить;
						ИначеЕсли НЕ ЭтоАванс И НЕ Найти(ОтборПоВиду, "оплат") Тогда
							Продолжить;
						КонецЕсли;
						
					Иначе 
						Продолжить;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
			
			НоваяСтрокаТД = ТаблицаДанных.Добавить();
			НоваяСтрокаТД.ОписаниеОшибки = "";
			ЗаполнитьЗначенияСвойств(НоваяСтрокаТД, СтрокаТС);
			НоваяСтрокаТД.УПД = УПД;
			
			Если НЕ КНП_ВДокументеКорректныеСтавки(НоваяСтрокаТД.Ссылка) Тогда
				НоваяСтрокаТД.ОписаниеОшибки = НоваяСтрокаТД.ОписаниеОшибки 
				+ "Внимание! В документе признак НДС в сумме не соответствует указанным ставкам НДС! 
				|Пожалуйста, проверьте корректность указания ставок и признака включения НДС в сумму документа" + Символы.ПС;
			КонецЕсли;
			
			НоваяСтрокаТД.Валюта = "руб.";
			
			Если КНП_ЕстьРеквизит(НоваяСтрокаТД.Ссылка, "Валюта") Тогда
				НоваяСтрокаТД.Валюта = НоваяСтрокаТД.Ссылка.Валюта.Наименование;
			КонецЕсли;
			
			Если КНП_ЕстьРеквизит(НоваяСтрокаТД.Ссылка, "ВалютаДокумента") Тогда
				НоваяСтрокаТД.Валюта = НоваяСтрокаТД.Ссылка.ВалютаДокумента.Наименование;
			КонецЕсли;
			
		КонецЦикла;
		
	Исключение
		
		ДобавитьВЖурнал("Ошибка при выполнении запроса. " + ОписаниеОшибки(), "ПолучитьДокументы");	
		Возврат ОписаниеОшибки();
		
	КонецПопытки;
	
	Возврат ТаблицаДанных;

КонецФункции

Функция РС_ПолучитьОрганизациюКонтрагентаПоИдентификатору(ИдПодр, ИдКонтр = Неопределено)
	
	Если ИдПодр = ИдентификаторПодразделения Тогда
		Возврат Организация;
	КонецЕсли;
	
	Подразделение = РС_ПолучитьПодразделениеПоИдентификатору(ИдПодр);
	
	Если НЕ ЗначениеЗаполнено(Подразделение) И ЗначениеЗаполнено(ИдКонтр) Тогда
		Подразделение = РС_ПолучитьКонтрагентаПоИдентификатору(ИдКонтр);
	КонецЕсли;
	
	Возврат Подразделение;

КонецФункции

// Функция - Получить подразделение по идентификатору
//
// Параметры:
//  Идентификатор	 - Число	 - Идентификатор подразделения в системе DiState
// 
// Возвращаемое значение:
// СправочникСсылка.Контрагенты  - Ссылка на элемент справочника "Контрагенты"
//
Функция РС_ПолучитьПодразделениеПоИдентификатору(Идентификатор)
	
	Результат = Справочники.Контрагенты.ПустаяСсылка(); 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Свойство", МОП_ПолучитьРеквизит("DS_Подразделение_ID") );
	Запрос.УстановитьПараметр("Значение", Идентификатор);
	Запрос.Текст = МОП_ПолучитьТекстЗапросаОбъектПоДопСведениям();
	
	Попытка
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Результат = Выборка.Ссылка;
		КонецЕсли;
		
	Исключение
		ДобавитьВЖурнал("Не удалось выполнить запрос. " + ОписаниеОшибки(), "ПолучитьПодразделениеПоИдентификатору");	
	КонецПопытки;
	
	Возврат Результат;

КонецФункции

// Функция - Получить контрагента по идентификатору
//
// Параметры:
//  Идентификатор	 - Число	 - Идентификатор контрагента в системе DiState
// 
// Возвращаемое значение:
// СправочникСсылка.Контрагенты  - Ссылка на элемент справочника контрагенты
//
Функция РС_ПолучитьКонтрагентаПоИдентификатору(Идентификатор)
	
	Результат = Справочники.Контрагенты.ПустаяСсылка(); 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Свойство", МОП_ПолучитьРеквизит("DS_Контрагент_ID") );
	Запрос.УстановитьПараметр("Значение", Идентификатор);
	Запрос.Текст = МОП_ПолучитьТекстЗапросаОбъектПоДопСведениям();
	
	Попытка
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Результат = Выборка.Ссылка;
		КонецЕсли;
		
	Исключение
		ДобавитьВЖурнал("Не удалось выполнить запрос. " + ОписаниеОшибки(), "ПолучитьПодразделениеПоИдентификатору");	
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция РС_ПолучитьОрганизациюКонтрагентаПоИдентификаторуИзДоговора(ИдПодр, ИдКонтр = Неопределено, ДоговорСПоставщиком = Ложь)

	//+Макрушин Е. 24.03.2026 #UT10-5658
	Если ИдПодр = ИдентификаторПодразделения Тогда
		Возврат Организация;
	КонецЕсли;
	
	Подразделение = РС_ПолучитьПодразделениеПоИдентификаторуИзДоговора(ИдПодр, ДоговорСПоставщиком);

	Возврат Подразделение;
    //-Макрушин Е. 24.03.2026 #UT10-5658
	
КонецФункции

// Функция - Получить контрагента по идентификатору из реквизита контрагента
//
// Параметры:
//  Идентификатор	 - Число	 - Идентификатор контрагента в системе DiState
// 
// Возвращаемое значение:
// СправочникСсылка.Контрагенты  - Ссылка на элемент справочника контрагенты
//
Функция РС_ПолучитьПодразделениеПоИдентификаторуИзДоговора(Идентификатор, ДоговорСПоставщиком = Ложь)

	//+Макрушин Е. 24.03.2026 #UT10-5658
	Результат = Справочники.ДоговорыКонтрагентов.ПустаяСсылка(); 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Значение", Идентификатор);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДоговорыКонтрагентов.Ссылка
	               |ИЗ
	               |	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	               |ГДЕ
	               |	ДоговорыКонтрагентов.DS_Подразделение_ID = &Значение
	               |	И ДоговорыКонтрагентов.ВидДоговора = &ВидДоговора";
	
	Запрос.УстановитьПараметр("ВидДоговора", ?(ДоговорСПоставщиком, Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком, Перечисления.ВидыДоговоровКонтрагентов.СПокупателем));
	
	Попытка
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Результат = Выборка.Ссылка;
		КонецЕсли;
		
	Исключение
		ДобавитьВЖурнал("Не удалось выполнить запрос. " + ОписаниеОшибки(), "ПолучитьПодразделениеПоИдентификатору");	
	КонецПопытки;

	Возврат Результат;
	//-Макрушин Е. 24.03.2026 #UT10-5658
	
КонецФункции

// Функция - Получить документ по идентификатору
//
// Параметры:
//  Идентификатор	 - Число	 - Идентификатор документа 
// 
// Возвращаемое значение:
// ДокументСсылка  - Ссылка на документ с таким идентификатором
//
Функция РС_ПолучитьДокументПоИдентификатору(Идентификатор)
	
	Результат = Справочники.Контрагенты.ПустаяСсылка(); 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Свойство", МОП_ПолучитьРеквизит("DS_Документ_ID") );
	Запрос.УстановитьПараметр("Значение", Идентификатор);
	Запрос.Текст = МОП_ПолучитьТекстЗапросаОбъектПоДопСведениям();
	
	Попытка
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Результат = Выборка.Ссылка;
		КонецЕсли;
		
	Исключение
		ДобавитьВЖурнал("Не удалось выполнить запрос. " + ОписаниеОшибки(), "ПолучитьДокументПоИдентификатору");	
	КонецПопытки;
	
	ЗаписатьЖурналВФайл();
	
	Возврат Результат;	

КонецФункции

// Функция - Получить единицу измерения по идентификатору
