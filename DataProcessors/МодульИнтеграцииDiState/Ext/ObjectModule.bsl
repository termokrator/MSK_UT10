Функция ПФ_СформироватьПечатнуюФормуXML(ДанныеXML, ТипФормы, Подписан = Ложь)
	
	Результат = Неопределено;
	
	Попытка
		
		Если НЕ ЗначениеЗаполнено(ДанныеXML) Тогда
			Возврат Результат;
		КонецЕсли;
		
		ОбъектXML = Новый ЧтениеXML;
		
		Если Найти(ДанныеXML, "<?xml") Тогда
			ОбъектXML.УстановитьСтроку(ДанныеXML);
		Иначе
			Возврат Результат;
		КонецЕсли;
		
	Исключение	
		
		ДобавитьВЖурнал(ОписаниеОшибки(), "СформироватьПечатнуюФормуXML");
		Возврат Результат;
		
	КонецПопытки;
	
	Если Найти(ТипФормы, "Счет на оплату") Тогда
		Результат = ПФ_СформироватьПечатнуюФормуСчетаНаОплатуXML(ОбъектXML, Подписан);
	ИначеЕсли ТипФормы = "Счет-фактура" Тогда
		Результат = ПФ_СформироватьПечатнуюФормуСчетФактураXML(ОбъектXML, Подписан);	
	ИначеЕсли Найти(НРег(ТипФормы), "накладная") ИЛИ Найти(ВРег(ТипФормы), "ТОРГ") Тогда
		Результат = ПФ_СформироватьПечатнуюФормуТорг12XML(ОбъектXML, Подписан);
	ИначеЕсли Найти(НРег(ТипФормы), "акт") Тогда
		Результат = ПФ_СформироватьПечатнуюФормуАктаXML(ОбъектXML, Подписан);
	ИначеЕсли Найти(ТипФормы, "передат") ИЛИ ТипФормы = "УПД" Тогда  //УПД
		Результат = ПФ_СформироватьПечатнуюФормуУПДXML(ОбъектXML, Подписан);
	ИначеЕсли Найти(НРег(ТипФормы), "корректир") ИЛИ ТипФормы = "УКД" Тогда //УКД
		Результат = ПФ_СформироватьПечатнуюФормуУКДXML(ОбъектXML, Подписан);
	ИначеЕсли Найти(НРег(ТипФормы), "подтверждение") Тогда
		Результат = ПФ_СформироватьПечатнуюФормуСлужебногоСообщенияXML(ОбъектXML, Подписан, ТипФормы);	
	ИначеЕсли Найти(НРег(ТипФормы), "извещение") Тогда
		Результат = ПФ_СформироватьПечатнуюФормуСлужебногоСообщенияXML(ОбъектXML, Подписан, ТипФормы);
	ИначеЕсли Найти(НРег(ТипФормы), "упд фнс 820") Тогда
		Результат = ПФ_СформироватьПечатнуюФормуУПДXML(ОбъектXML, Подписан);
	КонецЕсли;
	
	Возврат Результат;	

КонецФункции

Функция ПФ_ПолучитьСтруктуруДанныхИзXML(ОбъектXML, Знач СтруктураДокумента)
	
	ПФ_ДополнитьСтруктуруСведениямиОбЭД(СтруктураДокумента);
	ПФ_РазобратьXMLДляПечатнойФормы(СтруктураДокумента, ОбъектXML);
