// Функция - Получить метаданные документа
//
// Параметры:
//  СсылкаНаДокумент - ДокументСсылка	 - Ссылка на документ, чьи доп.сведения нужно вытащить из ИБ
// 
// Возвращаемое значение:
// Структура  - Структура данных со следующими полями:
//	*Идентификатор - Число
//	*ДатаВремяОтправки - Дата
//
Функция РС_ПолучитьМетаданныеДокумента(СсылкаНаДокумент)
	
	Результат = Новый Структура("Идентификатор,ДатаВремяОтправки");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Объект", СсылкаНаДокумент);
	Запрос.Текст = МОП_ПолучитьТекстЗапросаДопСведенияОбъекта();
	
	Попытка
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Если Выборка.Свойство = МОП_ПолучитьРеквизит("DS_Документ_ID") Тогда
				Результат.Идентификатор = Выборка.Значение;	
			КонецЕсли;
			
			Если Выборка.Свойство = МОП_ПолучитьРеквизит("DS_ДатаВремяОтправки") Тогда
				Результат.ДатаВремяОтправки = Выборка.Значение;	
			КонецЕсли;		
			
		КонецЦикла;
		
	Исключение
		ДобавитьВЖурнал("Не удалось выполнить запрос. " + ОписаниеОшибки(), "ПолучитьМетаданныеДокумента");		
	КонецПопытки;
	
	Возврат Результат;

КонецФункции

// Функция - Получить идентификаторы контрагента
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты	 - Ссылка на контрагента, чьи доп.сведения нужно вытащить из ИБ
// 
// Возвращаемое значение:
// Структура  - Структура данных со следующими полями:
//	*ИдентификаторКонтрагента - Число
//	*ИдентификаторПодразделения - Число
//
Функция РС_ПолучитьИдентификаторыКонтрагента(Контрагент)
	
	Результат = Новый Структура("ИдентификаторКонтрагента,ИдентификаторПодразделения");
	
	Результат.ИдентификаторКонтрагента = Контрагент.DS_Подразделение_ID;
	Результат.ИдентификаторПодразделения = Контрагент.DS_Подразделение_ID;
	Возврат Результат;

КонецФункции

Функция РС_ОбновитьРеквизитыКонтрагента(СтруктураДанных, СсылкаНаКонтрагента)
	
	Если СтруктураДанных.Свойство("БИК") И СтруктураДанных.Свойство("НомерСчета") Тогда
		
		СчетКонтрагента = МОП_ПолучитьБанковскийСчетПоБикуНомеруСчета(СтруктураДанных.БИК, СтруктураДанных.НомерСчета);
		
		Если НЕ ЗначениеЗаполнено(СчетКонтрагента) Тогда
			СчетКонтрагента = МОП_СоздатьБанковскийСчетКонтрагента(СтруктураДанных.БИК, СтруктураДанных.НомерСчета, СсылкаНаКонтрагента);
		КонецЕсли;
		
		Если КНП_ЕстьРеквизит(СчетКонтрагента, "Банк") И НЕ ЗначениеЗаполнено(СчетКонтрагента.Банк) Тогда
			
			ОбъектСчета = СчетКонтрагента.ПолучитьОбъект();
			ОбъектСчета.Банк = МОП_ПолучитьБанкПоБИКу(СтруктураДанных.БИК);
			ОбъектСчета.Записать();
			СчетКонтрагента = ОбъектСчета.Ссылка;
			
		КонецЕсли;
		
		СтруктураДанных.Удалить("БИК");
		СтруктураДанных.Удалить("НомерСчета");
		
		Если КНП_ЕстьРеквизит(СсылкаНаКонтрагента, "ОсновнойБанковскийСчет") Тогда
			СтруктураДанных.Вставить("ОсновнойБанковскийСчет", СчетКонтрагента);
		КонецЕсли;
		
		Если КНП_ЕстьРеквизит(СсылкаНаКонтрагента, "БанковскийСчетПоУмолчанию") Тогда
			СтруктураДанных.Вставить("БанковскийСчетПоУмолчанию", СчетКонтрагента);
		КонецЕсли;
		
	КонецЕсли;
	
	
	Результат = КНП_ОбновитьРеквизитыЭлементСправочника(СтруктураДанных, СсылкаНаКонтрагента);
	ЗаписатьЖурналВФайл();
	
	Возврат Результат;
	
КонецФункции

// Процедура - Привязать объект 1С к объекту ЭД
//
// Параметры:
//  Объект				 - ЛюбаяСсылка	 - Ссылка на объект метаданных 1С
//  Идентификатор		 - Строка		 - Идентификатор объекта в ЭДО. Если пустой - то будет удалено сопоставление
//  Переписывать 		 - Булево		 - Признак того, что необходимо переписать сопоставление в 1С
//
Процедура РС_ПривязатьИдентификаторКОбъекту1С(Объект,Идентификатор = Неопределено, Знач Переписывать = Ложь, Знач СвязанныеДокументы = Ложь)
	
	ДобавитьВЖурналОтладочнуюИнформацию("Вход в процедуру", "РС_ПривязатьИдентификаторКОбъекту1С");
	ПараметрИдентификатора = Неопределено;
	
	Если ТипЗнч(Объект) = Тип("СправочникСсылка.Контрагенты") Тогда
		ПараметрИдентификатора = МОП_ПолучитьРеквизит("DS_Контрагент_ID");
	Иначе //Используется идентификатор документа
		ПараметрИдентификатора = МОП_ПолучитьРеквизит("DS_Документ_ID");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПараметрИдентификатора) Тогда
		Возврат;
	КонецЕсли;
	
	
	НаборЗаписейЗначенияСвойств = МОП_ПолучитьНовыйНаборЗаписейДопСведений();
	ДобавитьВЖурналОтладочнуюИнформацию("Получен набор записей", "РС_ПривязатьИдентификаторКОбъекту1С");
	
	НаборЗаписейЗначенияСвойств.Отбор.Объект.Установить(Объект.Ссылка);
	НаборЗаписейЗначенияСвойств.Отбор.Свойство.Установить(ПараметрИдентификатора);
	НаборЗаписейЗначенияСвойств.Прочитать();
	
	Если Идентификатор = Неопределено Тогда
		
		НаборЗаписейЗначенияСвойств.Очистить();
		НаборЗаписейЗначенияСвойств.Записать();
		Возврат;
		
	КонецЕсли;
	
	Если НаборЗаписейЗначенияСвойств.Количество() = 0 Тогда
		
		Запись = НаборЗаписейЗначенияСвойств.Добавить();
		Переписывать = Истина;
		
	Иначе
		Запись = НаборЗаписейЗначенияСвойств[0];
	КонецЕсли; 
	
	Если Переписывать Тогда
		
		Запись.Объект = Объект;
		Запись.Свойство = ПараметрИдентификатора;
		Запись.Значение = Идентификатор;
		
		УстановитьПривилегированныйРежим(Истина);
		ДобавитьВЖурналОтладочнуюИнформацию("Начинаем запись идентификатора", "РС_ПривязатьИдентификаторКОбъекту1С");
		НаборЗаписейЗначенияСвойств.Записать();
		ДобавитьВЖурналОтладочнуюИнформацию("Запись идентификатора осуществлена", "РС_ПривязатьИдентификаторКОбъекту1С");
		УстановитьПривилегированныйРежим(Ложь);
		
		ДобавитьВЖурнал("Привязка " + Строка(Объект) + " с идентификатором " + Идентификатор, "ПривязатьИдентификаторКОбъекту1С");
		
		//Если счет-фактура - то нужно сделать привязку и для первичного документа
		Если (МОП_ЭтоСчетФактура(Объект) ИЛИ МОП_ЭтоСчетФактураПоставщика(Объект) ) И СвязанныеДокументы Тогда
			
			ДокОснование = МОП_ПолучитьОснованиеДокумента(Объект);
			
			Если ЗначениеЗаполнено(ДокОснование) Тогда
				РС_ПривязатьИдентификаторКОбъекту1С(ДокОснование, Идентификатор, Переписывать);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	//==Специфичный блок кода
	Если ВеткаРазработки = "ТЭК-Торг" Тогда
		РС_УстановитьИдентификаторДиадок(Объект, Идентификатор, Переписывать, СвязанныеДокументы);	
	КонецЕсли;
	//==Специфичный блок кода

КонецПроцедуры

