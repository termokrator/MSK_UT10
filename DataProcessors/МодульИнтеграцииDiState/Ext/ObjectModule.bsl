// Получить структуру ответственного лица физического лица (метаданно-ориентированный)
// *Поддержка БП 3.0, УТ 11, КА 2.4, БП 2.0, УТ 10.3, КА 1.1, УПП 1.3
// 
// Возвращаемое значение:
// Структура  - Структура с полями Фамилия, Имя, Отчество, Должность 
//
Функция МОП_СформироватьСтруктуруОтветственныеЛицаОрганизации(ФизЛицо = Неопределено)
	
	СтруктураОтвета = Новый Структура("Фамилия,Имя,Отчество,Должность,ОснованиеПолномочий", " ", " ", " ", "");
	МодульПользователей = КНП_ОбщийМодуль("ПользователиКлиентСервер");
	Пользователь = Неопределено;
	
	Если МодульПользователей <> Неопределено И ФизЛицо = Неопределено Тогда
		
		Пользователь = МодульПользователей.ТекущийПользователь();
		
		Если КНП_ЕстьРеквизит(Пользователь, "ФизическоеЛицо") Тогда
			ФизЛицо = Пользователь.ФизическоеЛицо;
		КонецЕсли;
		
		Если КНП_ЕстьРеквизит(Пользователь, "ФизЛицо") Тогда
			ФизЛицо = Пользователь.ФизЛицо;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ФизЛицо) Тогда
		
		ДолжностьЗначение = КЗП_ПолучитьДолжностьФизЛица(ФизЛицо);
		
		Если ЗначениеЗаполнено(ДолжностьЗначение) Тогда
			ДолжностьСтрока = Строка(ДолжностьЗначение);
		Иначе
			ДолжностьСтрока = "Ответственный за ЭДО";
		КонецЕсли;
		
		СтруктураФИО = КЗП_ПолучитьСтруктуруФИОФизЛица(ФизЛицо);
		СтруктураОтвета.Фамилия = СтруктураФИО.Фамилия;
		СтруктураОтвета.Имя = СтруктураФИО.Имя;
		СтруктураОтвета.Отчество = СтруктураФИО.Отчество;
		СтруктураОтвета.Должность = ДолжностьСтрока;
		СтруктураОтвета.ОснованиеПолномочий = "";
		
	ИначеЕсли Пользователь <> Неопределено Тогда
		
		СтруктураФИО = КНП_РазобратьНаименованиеИПНаМассив(Пользователь.Наименование);
		ДолжностьСтрока = "Ответственный за ЭДО";
		
		Если СтруктураФИО.Количество() > 0 Тогда
			СтруктураОтвета.Фамилия = СтруктураФИО[0];
		КонецЕсли;
		
		Если СтруктураФИО.Количество() > 1 Тогда
			СтруктураОтвета.Имя = СтруктураФИО[1];
		КонецЕсли;
		
		Если СтруктураФИО.Количество() > 2 Тогда
			СтруктураОтвета.Отчество = СтруктураФИО[2];
		КонецЕсли;
		
		СтруктураОтвета.Должность = ДолжностьСтрока;
		СтруктураОтвета.ОснованиеПолномочий = "";
		
	КонецЕсли;
	
	Возврат СтруктураОтвета;

КонецФункции

// Документ включает НДС в сумму (метаданно-ориентированный метод)
//
// Параметры:
//  СсылкаНаДокумент - ДокументСсылка	 - 
// 
// Возвращаемое значение:
// Булево  - 
//
Функция МОП_ДокументВключаетНДСВСумму(СсылкаНаДокумент, ВозвращатьНеопределено = Ложь)
	
	Если ВозвращатьНеопределено Тогда
		СуммаВключаетНДС = Неопределено;
	Иначе
		СуммаВключаетНДС = Ложь;
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(СсылкаНаДокумент, "СуммаВключаетНДС") Тогда
		СуммаВключаетНДС = СсылкаНаДокумент.СуммаВключаетНДС;
	ИначеЕсли КНП_ЕстьРеквизит(СсылкаНаДокумент, "ЦенаВключаетНДС") Тогда
		СуммаВключаетНДС = СсылкаНаДокумент.ЦенаВключаетНДС;
	ИначеЕсли КНП_ЕстьРеквизит(СсылкаНаДокумент, "СтавкаНДС") Тогда
		Возврат МОП_НДСВСуммеПоСтавке(СсылкаНаДокумент.СтавкаНДС);
	КонецЕсли;
	
	Возврат СуммаВключаетНДС;

КонецФункции

// Универсальная процедура заполнения поля "Организация" в документе
//
// Параметры:
//  ДокОбъект	 - ДокументСсылка	 - 
//  ОбъектJSON	 - Соответствие	 - JSON-объект 
//
Процедура МОП_ЗаполнитьОрганизацию(ДокОбъект, ОбъектJSON)
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "Организация") Тогда
		ДокОбъект.Организация = Организация;
	КонецЕсли;	

КонецПроцедуры

// Универсальная процедура заполнения поля "Контрагент" и "Партнер" в документе
//
// Параметры:
//  ДокОбъект	 - ДокументСсылка	 - 
//  ОбъектJSON	 - Соответствие	 - JSON-объект 
//
Процедура МОП_ЗаполнитьКонтрагентаПартнера(ДокОбъект, Подразделение, ОбъектJSON)
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "Контрагент") Тогда
		
		ДокОбъект.Контрагент = Подразделение;
		
		Если КНП_ЕстьРеквизит(ДокОбъект, "Партнер") И КНП_ЕстьРеквизит(ДокОбъект.Контрагент, "Партнер") Тогда
			ДокОбъект.Партнер = ДокОбъект.Контрагент.Партнер;
		КонецЕсли;
		
	КонецЕсли;	

КонецПроцедуры

// Универсальная процедура заполнения поля "ДоговорКонтрагента" и "Договор" в документе
//
// Параметры:
//  ДокОбъект	 - ДокументСсылка	 - 
//  ОбъектJSON	 - Соответствие	 - JSON-объект 
//
Процедура МОП_ЗаполнитьДоговор(ДокОбъект, ОбъектJSON)
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "ДоговорКонтрагента") Тогда
		ДокОбъект.ДоговорКонтрагента = КЗП_ПолучитьДоговорКонтрагентаСОрганизацией(ДокОбъект.Контрагент, ДокОбъект.Организация);
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "Договор") Тогда
		ДокОбъект.Договор = КЗП_ПолучитьДоговорКонтрагентаСОрганизацией(ДокОбъект.Контрагент, ДокОбъект.Организация);
	КонецЕсли;	

КонецПроцедуры

// Универсальная процедура заполнения поля "ВалютаДокумента", "Валюта" и "ВалютаВзаиморасчетов" в документе
//
// Параметры:
//  ДокОбъект	 - ДокументСсылка	 - 
//  ОбъектJSON	 - Соответствие, Структура	 - JSON-объект если Соответствие, XML-объект если Структура
//
Процедура МОП_ЗаполнитьВалюту(ДокОбъект, ОбъектДанных)
	
	Валюта = Неопределено;
	
	Попытка
		
		Если ТипЗнч(ОбъектДанных) = Тип("Соответствие") Тогда
			Валюта = СправочникВалюты.Найти(ОбъектДанных.Получить("currency").Получить("code"), "КодISO").Ссылка;
		Иначе
			
			КодВалюты = Прав(ОбъектДанных.Валюта, 3);
			
			Если КНП_ЭтоЧисло(КодВалюты) Тогда
				Валюта = СправочникВалюты.Найти(КодВалюты, "КодISO").Ссылка;
			Иначе
				Валюта = СправочникВалюты.Найти("643", "КодISO").Ссылка;
			КонецЕсли;
			
		КонецЕсли;
		
	Исключение
		Валюта = СправочникВалюты.Найти("643", "КодISO").Ссылка;	
	КонецПопытки;
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "ВалютаДокумента") Тогда
		ДокОбъект.ВалютаДокумента = Валюта;
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "Валюта") Тогда
		ДокОбъект.Валюта = Валюта;
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "ВалютаВзаиморасчетов") Тогда
		ДокОбъект.ВалютаВзаиморасчетов = Валюта;
	КонецЕсли;	

КонецПроцедуры

// Универсальная процедура заполнения полей основания и вида операции в документе
//
// Параметры:
//  ДокОбъект	 - ДокументСсылка	 - 
//  ОбъектJSON	 - Соответствие	 - JSON-объект
//  ЭтоИсправление - Булево - пока не используется
//
Процедура МОП_ЗаполнитьДокументыОснования(ДокОбъект, ОбъектДанных, ЭтоИсправление)
	
	Если ТипЗнч(ОбъектДанных) = Тип("Соответствие") Тогда
		
		ДокПоступления = КЗП_НайтиОснованиеСчетФактурыПоставщика(ОбъектДанных.Получить("number"), 
		КНП_ПривестиКДате(ОбъектДанных.Получить("date") ),
		ДокОбъект.Контрагент);
		
	Иначе
		
		ДокПоступления = КЗП_НайтиОснованиеСчетФактурыПоставщика(КНП_БезопасноПрочитатьЗначение(ОбъектДанных, "НомерОснования"),
		КНП_ПривестиКДате(КНП_БезопасноПрочитатьЗначение(ОбъектДанных, "ДатаОснования") ),
		ДокОбъект.Контрагент)
		
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "ДокументПоступления") Тогда
		ДокОбъект.ДокументПоступления = ДокПоступления;
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "ДокументОснование") Тогда
		ДокОбъект.ДокументОснование = ДокПоступления;
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "ВидОперации") Тогда
		
		Если ЭтоИсправление Тогда
			ДокОбъект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки");
		Иначе
			ДокОбъект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Универсальная процедура заполнения поля "ВидОперации" в документе
//
// Параметры:
//  ДокОбъект	 - ДокументСсылка	 - 
//  ОбъектJSON	 - Соответствие	 - JSON-объект 
//
Процедура МОП_ЗаполнитьВидОперации(ДокОбъект, ОбъектJSON)
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "ВидОперации") Тогда
		
		Если Метаданные.Перечисления.Найти("ВидыОперацийПоступлениеТоваровУслуг") <> Неопределено Тогда
			
			Если КНП_ЕстьТабЧасть(ДокОбъект, "Услуги") И ДокОбъект.Услуги.Количество() > 0 Тогда
				ДокОбъект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеТоваровУслуг.Услуги");
			Иначе
				ДокОбъект.ВидОперации	= ПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеТоваровУслуг.ПокупкаКомиссия");	
			КонецЕсли;
			
		ИначеЕсли Метаданные.Перечисления.Найти("ВидыОперацийПриходнаяНакладная") <> Неопределено Тогда
			ДокОбъект.ВидОперации	= ПредопределенноеЗначение("Перечисление.ВидыОперацийПриходнаяНакладная.ПоступлениеОтПоставщика");
		КонецЕсли;
		
	КонецЕсли;	

КонецПроцедуры  

// Универсальная процедура заполнения основных полей в документе
//
// Параметры:
//  ДокОбъект	 - ДокументСсылка	 - 
//  ОбъектJSON	 - Соответствие	 - JSON-объект
//  СуммаВключаетНДС - Булево - признак включения НДС в сумму
//
Процедура МОП_ЗаполнитьРеквизитыДокумента(ДокОбъект, ОбъектДанных, СуммаВключаетНДС, ВидДокумента)
	//Changelog
	//
	//10.06.2019 - скорректировано заполнение реквизитов входящего документа
	//11.06.2019 - добавлено заполнение суммы документа
	//17.01.2020 - добавлено заполнение автора документа
	
	ДокОбъект.Дата 									= ТекущаяДата();
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "НомерВходящегоДокумента") Тогда
		ДокОбъект.НомерВходящегоДокумента			= КНП_БезопасноПрочитатьЗначение(ОбъектДанных, "Номер");
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "НомерПервичногоДокумента") Тогда			
		ДокОбъект.НомерПервичногоДокумента			= КНП_БезопасноПрочитатьЗначение(ОбъектДанных, "Номер");
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "НомерПоДаннымПоставщика") Тогда			
		ДокОбъект.НомерПоДаннымПоставщика			= КНП_БезопасноПрочитатьЗначение(ОбъектДанных, "Номер");
	КонецЕсли;
	
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "ДатаВходящегоДокумента") Тогда
		ДокОбъект.ДатаВходящегоДокумента			= КНП_ПривестиКДате(КНП_БезопасноПрочитатьЗначение(ОбъектДанных, "Дата") );	
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "ДатаПервичногоДокумента") Тогда
		ДокОбъект.ДатаПервичногоДокумента			= КНП_ПривестиКДате(КНП_БезопасноПрочитатьЗначение(ОбъектДанных, "Дата") );	
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "ДатаПоДаннымПоставщика") Тогда
		ДокОбъект.ДатаПоДаннымПоставщика			= КНП_ПривестиКДате(КНП_БезопасноПрочитатьЗначение(ОбъектДанных, "Дата") );	
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "Комментарий") Тогда
		ДокОбъект.Комментарий						= "Документ загружен из системы DiState";
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "Ответственный") Тогда
		
		Попытка
			
			МодульПользователиКлиентСервер = КНП_ОбщийМодуль("ПользователиКлиентСервер");
			ДокОбъект.Ответственный 				= МодульПользователиКлиентСервер.ТекущийПользователь();
			
		Исключение
		КонецПопытки;
		
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "Автор") Тогда
		
		Попытка
			
			МодульПользователиКлиентСервер = КНП_ОбщийМодуль("ПользователиКлиентСервер");
			ДокОбъект.Автор 				= МодульПользователиКлиентСервер.ТекущийПользователь();
			
		Исключение
		КонецПопытки;
		
	КонецЕсли;	
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "СуммаДокумента") Тогда
		
		ДокОбъект.СуммаДокумента = 0;
		
		Если КНП_ЕстьТабЧасть(ДокОбъект, "Товары") Тогда
			ДокОбъект.СуммаДокумента = ДокОбъект.СуммаДокумента + ДокОбъект.Товары.Итог("Сумма");
		КонецЕсли;
		
		Если КНП_ЕстьТабЧасть(ДокОбъект, "Услуги") Тогда
			ДокОбъект.СуммаДокумента = ДокОбъект.СуммаДокумента + ДокОбъект.Услуги.Итог("Сумма");
		КонецЕсли;
		
		Если КНП_ЕстьТабЧасть(ДокОбъект, "Расходы") Тогда
			ДокОбъект.СуммаДокумента = ДокОбъект.СуммаДокумента + ДокОбъект.Расходы.Итог("Сумма");
		КонецЕсли;
		
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "НалогообложениеНДС") Тогда
		
		Если Метаданные.Перечисления.Найти("ТипыНалогообложенияНДС") <> Неопределено Тогда
			
			Если ПредопределенноеЗначение("Перечисление.ТипыНалогообложенияНДС.ОблагаетсяНДС") <> Неопределено Тогда
				ДокОбъект.НалогообложениеНДС = ПредопределенноеЗначение("Перечисление.ТипыНалогообложенияНДС.ОблагаетсяНДС");
			ИначеЕсли ПредопределенноеЗначение("Перечисление.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС") <> Неопределено Тогда
				ДокОбъект.НалогообложениеНДС = ПредопределенноеЗначение("Перечисление.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС");
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "Склад") Тогда
		ДокОбъект.Склад = СкладПоУмолчанию;
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "СтруктурнаяЕдиница") И НЕ КНП_ЕстьРеквизит(ДокОбъект, "Склад") Тогда
		ДокОбъект.СтруктурнаяЕдиница = СкладПоУмолчанию;
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "ЦенаВключаетНДС") Тогда
		ДокОбъект.ЦенаВключаетНДС = СуммаВключаетНДС;
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "СуммаВключаетНДС") Тогда
		ДокОбъект.СуммаВключаетНДС = СуммаВключаетНДС;
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "Курс") Тогда
		ДокОбъект.Курс = 1;
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "Кратность") Тогда
		ДокОбъект.Кратность = 1;
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "ПредъявленСчетФактура") Тогда
		
		Если ТипЗнч(ОбъектДанных) = Тип("Соответствие") Тогда
			
			Если ОбъектДанных.Получить("purpose") <> Неопределено Тогда
				
				Если Найти(ОбъектДанных.Получить("purpose"), "СЧФ") Тогда
					
					ДокОбъект.ПредъявленСчетФактура = Истина;
					ДокОбъект.НомерВходящегоСчетаФактуры = ОбъектДанных.Получить("number");
					ДокОбъект.ДатаВходящегоСчетаФактуры = КНП_ПривестиКДате(ОбъектДанных.Получить("date") );
					
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			
			Если ОбъектДанных.Свойство("ТипУПД") Тогда
				
				Если Найти(ОбъектДанных.ТипУПД, "СЧФ") Тогда
					
					ДокОбъект.ПредъявленСчетФактура = Истина;
					ДокОбъект.НомерВходящегоСчетаФактуры = КНП_БезопасноПрочитатьЗначение(ОбъектДанных, "Номер");
					ДокОбъект.ДатаВходящегоСчетаФактуры = КНП_ПривестиКДате(КНП_БезопасноПрочитатьЗначение(ОбъектДанных, "Дата"));	
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "КодВидаОперации") Тогда
		ДокОбъект.КодВидаОперации = "01";
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "СуммаДокумента") И ДокОбъект.СуммаДокумента = 0 И ОбъектДанных.Свойство("СуммаИтого") Тогда
		ДокОбъект.СуммаДокумента = ОбъектДанных.СуммаИтого;
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "ВидПервичногоДокумента") Тогда
		ДокОбъект.ВидПервичногоДокумента = ВидДокумента;
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "СпособЗачетаАванса") И КНП_ЕстьОбъектМетаданных("СпособыЗачетаАвансов") Тогда
		ДокОбъект.СпособЗачетаАванса = ПредопределенноеЗначение("Перечисление.СпособыЗачетаАвансов.Автоматически");
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "ПричинаНалогообложения") И КНП_ЕстьОбъектМетаданных("ПричиныНалогообложенияНДС")  Тогда
		ДокОбъект.ПричинаНалогообложения = ПредопределенноеЗначение("Перечисление.ПричиныНалогообложенияНДС.Покупка");
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "ХозяйственнаяОперация") Тогда
		ДокОбъект.ХозяйственнаяОперация = ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ЗакупкаУПоставщика");
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "СпособДоставки") Тогда
		ДокОбъект.СпособДоставки = ПредопределенноеЗначение("Перечисление.СпособыДоставки.СиламиПоставщикаДоНашегоСклада");
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "ВариантПриемкиТоваров") Тогда
		ДокОбъект.ВариантПриемкиТоваров = ПредопределенноеЗначение("Перечисление.ВариантыПриемкиТоваров.ПоДоговорамПослеЗаказовИлиНакладных");
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "ПорядокОплаты") Тогда
		ДокОбъект.ПорядокОплаты = ПредопределенноеЗначение("Перечисление.ПорядокОплатыПоСоглашениям.РасчетыВРубляхОплатаВРублях");
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "ЗакупкаПодДеятельность") Тогда
		ДокОбъект.ЗакупкаПодДеятельность = ПредопределенноеЗначение("Перечисление.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС");
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "Статус") И ВидДокумента = "Счет на оплату" Тогда
		ДокОбъект.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаказовПоставщикам.Подтвержден");
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "Приоритет") И КНП_ЕстьОбъектМетаданных("Приоритеты") Тогда
		ДокОбъект.Приоритет = Справочники.Приоритеты.НайтиПоНаименованию("Средний");	
	КонецЕсли;
	
	ДокОбъект.УстановитьНовыйНомер();	

КонецПроцедуры

// Универсальная процедура заполнения поля "СпособЗачетаАвансов" в документе
//
// Параметры:
//  ДокОбъект	 - ДокументСсылка	 - 
//  ОбъектJSON	 - Соответствие	 - JSON-объект 
//
Процедура МОП_ЗаполнитьСпособЗачетаАвансов(ДокОбъект, ОбъектJSON)
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "СпособЗачетаАвансов") Тогда
		ДокОбъект.СпособЗачетаАвансов 	= ПредопределенноеЗначение("Перечисление.СпособыЗачетаАвансов.Автоматически");
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "ПорядокРасчетов") Тогда
		ДокОбъект.ПорядокРасчетов 		= ПредопределенноеЗначение("Перечисление.ПорядокРасчетов.ПоНакладным");
	КонецЕсли;

КонецПроцедуры

// Универсальная процедура заполнения банковских счетов
//
// Параметры:
//  ДокОбъект	 - ДокументСсылка	 - 
//  ОбъектJSON	 - Соответствие	 - JSON-объект 
//
Процедура МОП_ЗаполнитьБанковскиеСчета(ДокОбъект, ОбъектДанных)
	
	СтруктураПродавца = Неопределено;
	
	Если ТипЗнч(ОбъектДанных) = Тип("Соответствие") Тогда
		
		Если ОбъектДанных.Получить("seller") <> Неопределено Тогда
			СтруктураПродавца = ОбъектДанных.Получить("seller");
		ИначеЕсли ОбъектДанных.Получить("provider") <> Неопределено Тогда
			СтруктураПродавца = ОбъектДанных.Получить("provider");
		КонецЕсли;
		
	Иначе
		
		СтруктураПродавца = Новый Соответствие;
		СтруктураПродавца.Вставить("accountNumber", "");
		
		Если ОбъектДанных.Свойство("СчетПолучателя") Тогда
			СтруктураПродавца.Вставить("accountNumber", ОбъектДанных.СчетПолучателя);
		КонецЕсли;
		
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "БанковскийСчетКонтрагента") Тогда
		
		Если КНП_ЕстьОбъектМетаданных("БанковскиеСчета") Тогда
			
			Если СтруктураПродавца <> Неопределено Тогда
				ДокОбъект.БанковскийСчетКонтрагента 	= Справочники.БанковскиеСчета.НайтиПоРеквизиту("НомерСчета", СтруктураПродавца.Получить("accountNumber") );
			КонецЕсли;
			
			Если ДокОбъект.БанковскийСчетКонтрагента.Пустая() Тогда
				ДокОбъект.БанковскийСчетКонтрагента 	= МОП_ПолучитьБанковскийСчетКонтрагента(ДокОбъект.Контрагент);	
			КонецЕсли;
			
		ИначеЕсли КНП_ЕстьОбъектМетаданных("БанковскиеСчетаКонтрагентов") Тогда
			
			Если СтруктураПродавца <> Неопределено Тогда
				ДокОбъект.БанковскийСчетКонтрагента 	= Справочники.БанковскиеСчетаКонтрагентов.НайтиПоРеквизиту("НомерСчета",  СтруктураПродавца.Получить("accountNumber") );
			КонецЕсли;
			
			Если ДокОбъект.БанковскийСчетКонтрагента.Пустая() Тогда
				ДокОбъект.БанковскийСчетКонтрагента 	= МОП_ПолучитьБанковскийСчетКонтрагента(ДокОбъект.Контрагент);	
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

