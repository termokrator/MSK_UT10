Функция МОП_ПолучитьПредставлениеСтавкиНДС(СтавкаНДС)		
	
	Если Не ЗначениеЗаполнено(СтавкаНДС) Тогда
		Возврат "0";
	КонецЕсли;	
	
	ПредставлениеСтавкиНДС = "0";
	
	Если Метаданные.Перечисления.Найти("СтавкиНДС") <> Неопределено Тогда
		
		Если СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.БезНДС") Тогда
			ПредставлениеСтавкиНДС = "-1";
		ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС0") Тогда
			ПредставлениеСтавкиНДС = "0";
		ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС10") Тогда
			ПредставлениеСтавкиНДС = "10";
		ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС18") Тогда
			ПредставлениеСтавкиНДС = "18";
		ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС10_110") Тогда
			ПредставлениеСтавкиНДС = "110";
		ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС18_118") Тогда
			ПредставлениеСтавкиНДС = "118";
		ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20_120") Тогда
			ПредставлениеСтавкиНДС = "120";
		ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20") Тогда
			ПредставлениеСтавкиНДС = "20";
		//+Гавриленков В. 11.12.2025 #UT10-5574
		ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС22_122") Тогда
			ПредставлениеСтавкиНДС = "122";
		ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС22") Тогда
			ПредставлениеСтавкиНДС = "22";
		//-Гавриленков В. 11.12.2025 #UT10-5574
		КонецЕсли;	
		
	ИначеЕсли Метаданные.Справочники.Найти("СтавкиНДС") <> Неопределено Тогда
		ПредставлениеСтавкиНДС = ?(СтавкаНДС.Расчетная, "1", "") + Строка(СтавкаНДС.Ставка);
	КонецЕсли;
	
	Возврат ПредставлениеСтавкиНДС;		

КонецФункции

