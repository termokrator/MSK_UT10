Функция ФОД_ПолучитьЗданиеАдреса(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	
	Результат = "";
	
	Если ОбъектЗаполнения.Свойство("Здание") И ЗначениеЗаполнено(ОбъектЗаполнения.Здание) Тогда
		
		Если ТипЗнч(ОбъектЗаполнения.Здание) = Тип("Структура") Тогда
			
			ВидДома = КНП_БезопасноПрочитатьЗначение(ОбъектЗаполнения.Здание, "ТипЗдания");
			Результат = нрег(КНП_БезопасноПрочитатьЗначение(ОбъектЗаполнения.Здание, "ТипЗдания"))+" "+КНП_БезопасноПрочитатьЗначение(ОбъектЗаполнения.Здание, "Номер");
			
		Иначе
			Возврат нрег(Строка(ОбъектЗаполнения.Здание));
		КонецЕсли;
		
	КонецЕсли;
	
	Если ОбъектЗаполнения.Свойство("Корпус") 
		Тогда
		
		Если ТипЗнч(ОбъектЗаполнения.Корпус) = Тип("Структура") Тогда
			
			Результат =  КНП_БезопасноПрочитатьЗначение(ОбъектЗаполнения.Корпус, "Номер");
			
			Если НЕ ЗначениеЗаполнено(Результат) Тогда
				Возврат Неопределено;
			КонецЕсли;
			
		Иначе
			
			Этаж = Неопределено;
			
			Если ОбъектЗаполнения.Свойство("этаж") И ЗначениеЗаполнено(ОбъектЗаполнения.Этаж) Тогда
				
				Если ЗначениеЗаполнено(ОбъектЗаполнения.Корпус) Тогда
					Этаж = ", эт" + ОбъектЗаполнения.Этаж;
				Иначе
					Этаж = "эт" + ОбъектЗаполнения.Этаж;
				Конецесли;
				
			КонецЕсли;
			
			Помещение = Неопределено;
			
			Если ОбъектЗаполнения.Свойство("Помещение") И ЗначениеЗаполнено(ОбъектЗаполнения.Помещение) Тогда
				Помещение =  "пом." + (Строка(ОбъектЗаполнения.Помещение));
			КонецЕсли;
			
			КорпусЭтаж = ?(Этаж = Неопределено, нрег(Строка(ОбъектЗаполнения.Корпус)), нрег(Строка(ОбъектЗаполнения.Корпус)) + Этаж);
			
			ЭтажПомещение = ?(КорпусЭтаж = "", КорпусЭтаж + Помещение,КорпусЭтаж + ?(Помещение = Неопределено, "", ", " + Помещение));
			
			ИтоговаяСтрока = ?(СтрДлина(ЭтажПомещение) > 20, СтрЗаменить(ЭтажПомещение, "корпус", "к"), ЭтажПомещение);
			
			ИтоговаяСтрока = ?(ИтоговаяСтрока = "", Результат, ?(ЗначениеЗаполнено(Результат), Результат + ?(Лев(ИтоговаяСтрока, 1) = ",", ИтоговаяСтрока, ", " + ИтоговаяСтрока), ИтоговаяСтрока));
			
			ИтоговаяСтрока = ?(СтрДлина(ИтоговаяСтрока) > 20, СтрЗаменить(ИтоговаяСтрока, "строение ", "стр"), ИтоговаяСтрока);
			
			ИтоговаяСтрока = ?(СтрДлина(ИтоговаяСтрока) > 20, СтрЗаменить(ИтоговаяСтрока, "домовладение", "двлд"), ИтоговаяСтрока);
			
			ИтоговаяСтрока = ?(СтрДлина(ИтоговаяСтрока) > 20, СтрЗаменить(ИтоговаяСтрока, "владение", "влд"), ИтоговаяСтрока);
			
			ИтоговаяСтрока = ?(СтрДлина(ИтоговаяСтрока) > 20, СтрЗаменить(ИтоговаяСтрока, "дом", "д"), ИтоговаяСтрока);
			
			ИтоговаяСтрока = ?(СтрДлина(ИтоговаяСтрока) > 20, СтрЗаменить(ИтоговаяСтрока, " ", ""), ИтоговаяСтрока);
			
			ИтоговаяСтрока = ?(СтрДлина(ИтоговаяСтрока) > 20, СтрЗаменить(ИтоговаяСтрока, "стр", "с"), ИтоговаяСтрока);
			
			ИтоговаяСтрока = ?(СтрДлина(ИтоговаяСтрока) > 20, СтрЗаменить(ИтоговаяСтрока, "пом.", "п"), ИтоговаяСтрока);
			
			Если Не ЗначениеЗаполнено(ИтоговаяСтрока) Тогда
				ИтоговаяСтрока = Неопределено;
			КонецЕсли;
			
			Возврат ИтоговаяСтрока;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Неопределено;
	

КонецФункции

