	|	И ПогрузкаВАвто.Проведен";
	
	Запрос.УстановитьПараметр("ЗаданиеНаДоставку", ОбъектЗаполнения.ЗаданиеНаДоставку);  
	
	Выборка = Запрос.Выполнить().Выбрать(); 
	
	Если Выборка.Следующий() И Выборка.Дата <> NULL Тогда
		ИсходнаяДата = Выборка.Дата;
	Иначе
