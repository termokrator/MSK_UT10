Функция КолонкиВСтроку(Таблица, МассивИсключений, МассивСуммирования)
	
	СтрокаВозврата = "";
	СтрокаВозвратаСуммирования = "";
	
	Для каждого Колонка Из Таблица.Колонки Цикл
		
		Если МассивИсключений.Найти(Колонка.Имя) <> Неопределено Тогда
			Продолжить;	
		КонецЕсли; 
		
		Если МассивСуммирования.Найти(Колонка.Имя) <> Неопределено Тогда
			Продолжить;	
		КонецЕсли;
		
		СтрокаВозврата = СтрокаВозврата + ?(ЗначениеЗаполнено(СтрокаВозврата), ",", "") + Колонка.Имя;
			
	КонецЦикла; 
	
	Для каждого Суммирование Из МассивСуммирования Цикл		
		СтрокаВозвратаСуммирования = СтрокаВозвратаСуммирования + ?(ЗначениеЗаполнено(СтрокаВозвратаСуммирования), ",", "") + Суммирование;			
	КонецЦикла; 
	
	Возврат Новый Структура("КолонкиГруппировки, КолонкиСуммирования", СтрокаВозврата, СтрокаВозвратаСуммирования);	
		
КонецФункции  

Функция ФОД_ПолучитьДопРеквизит(Знач ОбъектЗаполнения)
	
	//+Белов А. 03.03.2026 #UT10-5730
	ВыгружатьКодыМаркировки = Константы.ЭДО_ВыгружатьКодыМаркировки.Получить();
	//-Белов А. 03.03.2026 #UT10-5730
	
	МассивСтруктур = Новый Массив;
	
	Если ТипЗнч(ОбъектЗаполнения) = Тип("ДокументСсылка.СчетФактураВыданный") 
		И ТипЗнч(ОбъектЗаполнения.ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		
		Реализация = ОбъектЗаполнения.ДокументОснование;
		
		//+Белов А. 03.03.2026 #UT10-5730
		Если ВыгружатьКодыМаркировки
			И Реализация.КодыМаркировки.Количество() > 0 Тогда
			
			Если Реализация.ДоговорКонтрагента.УсловияРаботыСЧЗ = Перечисления.УсловияРаботыСЧЗ.ПокупкаДляСобственныхНужд Тогда
				МассивСтруктур.Добавить(Новый Структура("Свойство, Значение", Новый Структура("Наименование", "СвВыбытияМАРК"), "1"));
			//+Белов А. 07.05.2026 #UT10-5843
			ИначеЕсли Реализация.ДоговорКонтрагента.УсловияРаботыСЧЗ = Перечисления.УсловияРаботыСЧЗ.ТорговляСНовымиРегионами Тогда   
				
				МассивСтруктур.Добавить(Новый Структура("Свойство, Значение", Новый Структура("Наименование", "СвВыбытияМАРК"), "1"));
				МассивСтруктур.Добавить(Новый Структура("Свойство, Значение", Новый Структура("Наименование", "action"), "OTHER"));
				МассивСтруктур.Добавить(Новый Структура("Свойство, Значение", Новый Структура("Наименование", "withdrawal_type_other"), "Отгрузка в ДНР / Отгрузка в ЛНР / Отгрузка в Херсонскую обл. / Отгрузка в Запорожскую обл."));
				
			КонецЕсли;
			//-Белов А. 07.05.2026 #UT10-5843	
						
		КонецЕсли;
		//-Белов А. 03.03.2026 #UT10-5730
		
		ФилиалКонтрагент = Реализация.Грузополучатель;
		
		Если ЗначениеЗаполнено(ФилиалКонтрагент) Тогда   
			
			Для каждого Стр Из ФилиалКонтрагент.ДополнительныеПараметрыВыгрузкиВЭДО Цикл
				
				Если Не ЗначениеЗаполнено(Стр.ИмяПараметра) ИЛИ Не ЗначениеЗаполнено(Стр.ЗначениеПараметра) Тогда
					Продолжить;	
				КонецЕсли;
				
				МассивСтруктур.Добавить(Новый Структура("Свойство, Значение", Новый Структура("Наименование", Стр.ИмяПараметра), Стр.ЗначениеПараметра));	
				
			КонецЦикла;
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ОбъектЗаполнения) = Тип("ДокументСсылка.СчетФактураВыданный") 
		И ТипЗнч(ОбъектЗаполнения.ДокументОснование) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		
		КорректировкаРеализации = ОбъектЗаполнения.ДокументОснование;
		
		Для каждого Стр Из КорректировкаРеализации.ДополнительныеПараметрыВыгрузкиВЭДО Цикл
			
			Если Не ЗначениеЗаполнено(Стр.ИмяПараметра) ИЛИ Не ЗначениеЗаполнено(Стр.ЗначениеПараметра) Тогда
				Продолжить;	
			КонецЕсли;
			
			МассивСтруктур.Добавить(Новый Структура("Свойство, Значение", Новый Структура("Наименование", Стр.ИмяПараметра), Стр.ЗначениеПараметра));	
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если НЕ ЗагружатьДопРеквизитыИз1С Тогда
		Возврат МассивСтруктур;
	КонецЕсли;
	
	Если ТипЗнч(ОбъектЗаполнения) = Тип("Структура") Тогда
		Возврат МассивСтруктур;
	КонецЕсли;
	
	Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "ДополнительныеРеквизиты") Тогда
		
		ФиксированнаяСтруктураДанных = КНП_СтруктураНаОснованииКолонокТЧ(ОбъектЗаполнения.ДополнительныеРеквизиты);
		
		Для Каждого ДопРеквизит Из ОбъектЗаполнения.ДополнительныеРеквизиты Цикл
			
			СтруктураДанных = Новый Структура(ФиксированнаяСтруктураДанных);
			ЗаполнитьЗначенияСвойств(СтруктураДанных, ДопРеквизит);
			МассивСтруктур.Добавить(СтруктураДанных);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат МассивСтруктур;

КонецФункции

Функция ФОД_ПолучитьДопРеквизитТовара(Знач ОбъектЗаполнения)
	
	МассивСтруктур = Новый Массив;
	
	КодСтраныВУПД          = "";
	НаименованиеСтраныВУПД = "";
	НомерГТДВУПД           = "";
	
	Если ТипЗнч(ОбъектЗаполнения.Ссылка) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		
		//+Гавриленков В. 25.02.2026 #UT10-5710
		//СтрокаТовара = ОбъектЗаполнения.Ссылка.Товары.Найти(ОбъектЗаполнения.Номенклатура, "Номенклатура");
		СтруктураПоиска = Новый Структура("Номенклатура", ОбъектЗаполнения.Номенклатура);
		МассивНайденных = ОбъектЗаполнения.Ссылка.Товары.НайтиСтроки(СтруктураПоиска);
		
		СтрокаТовара = Неопределено;
		
		Если МассивНайденных.Количество() = 1 Тогда
			СтрокаТовара = МассивНайденных[0];
		ИначеЕсли МассивНайденных.Количество() > 1 Тогда   
			
			Для Каждого НайденнаяСтрока Из МассивНайденных Цикл 
				
				Если НайденнаяСтрока.НомерСтроки = ОбъектЗаполнения.НомерСтроки Тогда
					
					СтрокаТовара = НайденнаяСтрока;
					Прервать;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		//-Гавриленков В. 25.02.2026 #UT10-5710
		
		Если СтрокаТовара <> Неопределено Тогда
			
			Если ЗначениеЗаполнено(СтрокаТовара.СерияНоменклатуры.НомерГТД) И ЗначениеЗаполнено(СтрокаТовара.СерияНоменклатуры.СтранаПроисхождения)
				И ЗначениеЗаполнено(СтрокаТовара.СерияНоменклатуры.СтранаПроисхождения.Код) Тогда 
				
				КодСтраныВУПД          =  СтрокаТовара.СерияНоменклатуры.СтранаПроисхождения.Код;
				НаименованиеСтраныВУПД =   СтрокаТовара.СерияНоменклатуры.СтранаПроисхождения.Наименование;
				НомерГТДВУПД = Лев(СокрЛП(СтрокаТовара.СерияНоменклатуры.НомерГТД.Код), 29);	
				
				МассивСтруктур.Добавить(Новый Структура("Свойство, Значение", Новый Структура("Наименование","цифровой код страны происхождения" ), КодСтраныВУПД));
				МассивСтруктур.Добавить(Новый Структура("Свойство, Значение", Новый Структура("Наименование","краткое наименование страны происхождения"), НаименованиеСтраныВУПД));
				МассивСтруктур.Добавить(Новый Структура("Свойство, Значение", Новый Структура("Наименование","регистрационный номер декларации на товары"), НомерГТДВУПД));
				
			КонецЕсли;
			
		КонецЕсли;   
		
	//+Белов А. 15.06.2026 #
	ИначеЕсли ТипЗнч(ОбъектЗаполнения.Ссылка) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		
		МассивСтруктур.Добавить(Новый Структура("Свойство, Значение", Новый Структура("Наименование","Бренд" ), Строка(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбъектЗаполнения.Номенклатура, "Родитель"))));
		
	//-Белов А. 15.06.2026 #
	КонецЕсли;
	
	Если НЕ ЗагружатьДопРеквизитыИз1С Тогда
		Возврат МассивСтруктур;
	КонецЕсли;
	
	Если ОбъектЗаполнения.Свойство("Номенклатура") Тогда
		
		Номенклатура = ОбъектЗаполнения.Номенклатура;
		МассивСтруктур = ФОД_ПолучитьДопРеквизит(Номенклатура);
		
	КонецЕсли;
	
	Возврат МассивСтруктур;

КонецФункции

Функция ФОД_ПолучитьМассивКодовМаркировкиТовара(ВерсияЗаполнения, Знач ОбъектЗаполнения, ТребуетсяКоличествоКодов = Неопределено, Корректировка = Ложь,	
//+Макрушин Е. 08.04.2026 #UT10-5800
	мКодыМаркировкиДляОбработки = Неопределено)
//-Макрушин Е. 08.04.2026 #UT10-5800

	//+Белов А. 17.02.2026 #UT10-5696
	Результат = Неопределено;

	//+Макрушин Е. 08.04.2026 #UT10-5800
	Если мКодыМаркировкиДляОбработки = Неопределено Тогда
	//-Макрушин Е. 08.04.2026 #UT10-5800
	
		мКодыМаркировкиПоНоменклатуре = Новый Массив;
		
		Если ОбъектЗаполнения.Свойство("Номенклатура") 
			И БуферКодовМаркировкиТоваров.Колонки.Найти("Номенклатура") <> Неопределено
			И БуферКодовМаркировкиТоваров.Количество() > 0 Тогда
			
			Если ТребуетсяКоличествоКодов = Неопределено Тогда
				ТребуетсяКоличествоКодов = ОбъектЗаполнения.Количество;	
			КонецЕсли;		
			
			тзКодыМаркировки = БуферКодовМаркировкиТоваров.НайтиСтроки(Новый Структура("Номенклатура", ОбъектЗаполнения.Номенклатура));
			
			Для Каждого СтрокаКодов Из тзКодыМаркировки Цикл
				
				Если ТребуетсяКоличествоКодов = 0 Тогда
					Прервать;
				КонецЕсли;
					
				мКодыМаркировкиПоНоменклатуре.Добавить(СтрокаКодов.КодМаркировки);
				
				ТребуетсяКоличествоКодов = ТребуетсяКоличествоКодов - 1;
				
				БуферКодовМаркировкиТоваров.Удалить(СтрокаКодов);
				
			КонецЦикла;
			
		КонецЕсли;
		
	//+Макрушин Е. 08.04.2026 #UT10-5800
	Иначе
		
		// коды маркировки уже подготовлены ранее, осталось вывести
		мКодыМаркировкиПоНоменклатуре = Новый Массив;
		
		Для Каждого СтрокаКодов Из мКодыМаркировкиДляОбработки Цикл
			мКодыМаркировкиПоНоменклатуре.Добавить(СтрокаКодов.КодМаркировки);
		КонецЦикла;
		
	КонецЕсли;
	//-Макрушин Е. 08.04.2026 #UT10-5800
	
	Если мКодыМаркировкиПоНоменклатуре.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли; 
	
	Если Корректировка Тогда
		
		РезультатЭлемент = Новый Структура;
		РезультатЭлемент.Вставить("identificationNumbers", мКодыМаркировкиПоНоменклатуре);
		
		Результат = Новый Массив;
		Результат.Добавить(РезультатЭлемент);
	
	Иначе 
		
		СтруктураПоКодамМаркировкиПоНоменклатуре = Новый Структура();
		СтруктураПоКодамМаркировкиПоНоменклатуре.Вставить("collection", мКодыМаркировкиПоНоменклатуре); 
		
		СтруктураПоКодамМаркировкиПоНоменклатуре.Вставить("type", "1");
		
		РезультатЭлемент = Новый Структура;
		РезультатЭлемент.Вставить("numbers", СтруктураПоКодамМаркировкиПоНоменклатуре);
		РезультатЭлемент.Вставить("packNumber", "");
		
		Результат = Новый Массив;
		Результат.Добавить(РезультатЭлемент);
		
	КонецЕсли;
		
	Возврат Результат;
	//-Белов А. 17.02.2026 #UT10-5696
	
КонецФункции

