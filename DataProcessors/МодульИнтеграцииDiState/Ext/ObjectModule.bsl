Функция РС_ПолучитьВсехКонтрагентов(ОтборБезИдентификатора = Ложь)
	
	ТаблицаДанных = МОП_ПолучитьСписокКонтрагентов();
	ТаблицаДанных.Колонки.Добавить("НаличиеВЭДО");
	ТаблицаДанных.Колонки.Добавить("Пригласить");
	ТаблицаДанных.Колонки.Добавить("ИдентификаторКонтрагента");
	
	МассивКУдалению = Новый Массив;
	МассивИННДляПоиска = Новый Массив;
	
	Для Каждого СтрокаТаблицы Из ТаблицаДанных Цикл
		
		Если ОтборБезИдентификатора Тогда
			
			Идентификатор = РС_ПолучитьИдентификаторыКонтрагента(СтрокаТаблицы.Контрагент);
			
			Если ЗначениеЗаполнено(Идентификатор.ИдентификаторКонтрагента) Тогда
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;
		
		ИНН = СтрокаТаблицы.ИНН;
		
		Если НЕ ЗначениеЗаполнено(ИНН) Тогда
			Продолжить;
		КонецЕсли;
		
		МассивИННДляПоиска.Добавить(ИНН);
		
	КонецЦикла;
	
	СписокКонтрагентовВСистеме = ЭДО_ПолучитьСписокКонтрагентовВСистеме(МассивИННДляПоиска);
	
	ИтоговаяТаблица = ТаблицаДанных.Скопировать();
	ИтоговаяТаблица.Очистить();
	
	Для Каждого ЭлементСписка Из СписокКонтрагентовВСистеме Цикл 			
		
		СтрокаТаблицы = ИтоговаяТаблица.Добавить();
		СтрокаИсходнойТаблицы = ТаблицаДанных.Найти(ЭлементСписка.ИНН, "ИНН");
		
		Если СтрокаИсходнойТаблицы = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтрокаИсходнойТаблицы);
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ЭлементСписка);
		СтрокаТаблицы.НаличиеВЭДО = Истина;
		
	КонецЦикла;
	
	Возврат ИтоговаяТаблица;

КонецФункции

Функция РС_ЕстьРасхождения(СтрокаТоваров)
	
	Если СтрокаТоваров.Количество <> СтрокаТоваров.КоличествоДоИзменения Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если СтрокаТоваров.Цена <> СтрокаТоваров.ЦенаДоИзменения Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если СтрокаТоваров.Сумма <> СтрокаТоваров.СуммаДоИзменения Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если СтрокаТоваров.СуммаНДС <> СтрокаТоваров.СуммаНДСДоИзменения Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если СтрокаТоваров.СтавкаНДС <> СтрокаТоваров.СтавкаНДСДоИзменения Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции

Функция РС_ПрочитатьТаблицуТоваров(ОбъектJSON, УКД = Ложь)
	
	ТаблицаТоваров = Новый ТаблицаЗначений;
	ТаблицаТоваров.Колонки.Добавить("Наименование");
	ТаблицаТоваров.Колонки.Добавить("Содержание");
	ТаблицаТоваров.Колонки.Добавить("Количество");
	ТаблицаТоваров.Колонки.Добавить("Цена");
	ТаблицаТоваров.Колонки.Добавить("Сумма");
	ТаблицаТоваров.Колонки.Добавить("СуммаНДС");
	ТаблицаТоваров.Колонки.Добавить("СтавкаНДС");
	ТаблицаТоваров.Колонки.Добавить("ЕдиницаИзмерения");
	ТаблицаТоваров.Колонки.Добавить("КоличествоДоИзменения");
	ТаблицаТоваров.Колонки.Добавить("ЦенаДоИзменения");
	ТаблицаТоваров.Колонки.Добавить("СуммаДоИзменения");
	ТаблицаТоваров.Колонки.Добавить("СуммаНДСДоИзменения");
	ТаблицаТоваров.Колонки.Добавить("СтавкаНДСДоИзменения");
	ТаблицаТоваров.Колонки.Добавить("КоличествоУпаковок");
	ТаблицаТоваров.Колонки.Добавить("КоличествоУпаковокДоИзменения");
	
	Для Каждого СтрокаОбъекта Из ОбъектJSON Цикл
		
		СуммаБезНДС = СтрокаОбъекта.Получить("costBeforeTax");
		
		Если УКД Тогда
			
			СуммаБезНДС = Число(СтрокаОбъекта.Получить("costBeforeTax").Получить("after") );
			СуммаБезНДСДо = Число(СтрокаОбъекта.Получить("costBeforeTax").Получить("before") );
			
		КонецЕсли;
		
		СуммаНДС = СтрокаОбъекта.Получить("amountOfTax");
		
		Если УКД Тогда
			
			СуммаНДС = Число(СтрокаОбъекта.Получить("amountOfTax").Получить("after") );
			СуммаНДСДо = Число(СтрокаОбъекта.Получить("amountOfTax").Получить("before") );
			
		КонецЕсли;
		
		СуммаОбщая = СтрокаОбъекта.Получить("costAfterTax");
		
		Если УКД Тогда
			
			СуммаОбщая = Число(СтрокаОбъекта.Получить("costAfterTax").Получить("after") );
			СуммаОбщаяДо = Число(СтрокаОбъекта.Получить("costAfterTax").Получить("before") );
			
		КонецЕсли;
		
		СтрокаТЧ = ТаблицаТоваров.Добавить();
		СтрокаТЧ.Наименование = СтрокаОбъекта.Получить("title");
		СтрокаТЧ.Содержание = СтрокаОбъекта.Получить("declaration");
		СтрокаТЧ.Количество = СтрокаОбъекта.Получить("count");
		
		Если УКД Тогда
			
			СтрокаТЧ.Количество = Число(СтрокаОбъекта.Получить("count").Получить("after") );
			СтрокаТЧ.КоличествоДоИзменения = Число(СтрокаОбъекта.Получить("count").Получить("before") );
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.Количество) Тогда
			
			Если СтрокаОбъекта.Получить("net") <> Неопределено Тогда
				СтрокаТЧ.Количество = Число(СтрокаОбъекта.Получить("net") );
			КонецЕсли;
			
		КонецЕсли;
		
		Если СтрокаОбъекта.Получить("placeCount") <> Неопределено Тогда
			СтрокаТЧ.КоличествоУпаковок = Число(СтрокаОбъекта.Получить("placeCount") );
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.КоличествоУпаковок) Тогда
			СтрокаТЧ.КоличествоУпаковок = СтрокаТЧ.Количество;
		КонецЕсли;
		
		СтрокаТЧ.Цена = СтрокаОбъекта.Получить("price");
		
		Если УКД Тогда
			
			СтрокаТЧ.Цена = Число(СтрокаОбъекта.Получить("price").Получить("after") );
			СтрокаТЧ.ЦенаДоИзменения = Число(СтрокаОбъекта.Получить("price").Получить("before") );
			
		КонецЕсли;
		
		СтрокаТЧ.СтавкаНДС = МОП_ПолучитьСтавкуНДСИзСтроки(СтрокаОбъекта.Получить("taxRate") );
		
		Если УКД Тогда
			
			СтрокаТЧ.СтавкаНДС = МОП_ПолучитьСтавкуНДСИзСтроки(СтрокаОбъекта.Получить("taxRate").Получить("after") );
			СтрокаТЧ.СтавкаНДСДоИзменения = МОП_ПолучитьСтавкуНДСИзСтроки(СтрокаОбъекта.Получить("taxRate").Получить("before") );
			
		КонецЕсли;
		
		
		СтрокаТЧ.Сумма = ?(МОП_НДСВСуммеПоСтавке(СтрокаТЧ.СтавкаНДС), СуммаОбщая, СуммаБезНДС);
		
		Если УКД Тогда
			СтрокаТЧ.СуммаДоИзменения = ?(МОП_НДСВСуммеПоСтавке(СтрокаТЧ.СтавкаНДС), СуммаОбщаяДо, СуммаБезНДСДо);	
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.Количество) Тогда
			СтрокаТЧ.Количество = СтрокаТЧ.Сумма / СтрокаТЧ.Цена; 	
		КонецЕсли;
		
		Если УКД И НЕ ЗначениеЗаполнено(СтрокаТЧ.КоличествоДоИзменения) Тогда
			СтрокаТЧ.КоличествоДоИзменения = СтрокаТЧ.СуммаДоИзменения / СтрокаТЧ.ЦенаДоИзменения; 	
		КонецЕсли;
		
		СтрокаТЧ.СуммаНДС = ?(ЗначениеЗаполнено(СуммаНДС), СуммаНДС, 0);
		
		Если УКД Тогда
			СтрокаТЧ.СуммаНДСДоИзменения = ?(ЗначениеЗаполнено(СуммаНДСДо), СуммаНДСДо, 0);
		КонецЕсли;
		
		ЕдиницаИзмерения = СтрокаОбъекта.Получить("measurement");
		
		Если ТипЗнч(ЕдиницаИзмерения) = Тип("Соответствие") Тогда
			ЕдиницаИзмерения = ЕдиницаИзмерения.Получить("id");
		КонецЕсли;
		
		СтрокаТЧ.ЕдиницаИзмерения = РС_ПолучитьЕдиницуИзмеренияПоИдентификатору(ЕдиницаИзмерения);
		
		Если УКД Тогда
			
			ЕдиницаИзмерения = СтрокаОбъекта.Получить("measurement").Получить("after");
			
			Если ТипЗнч(ЕдиницаИзмерения) = Тип("Соответствие") Тогда
				ЕдиницаИзмерения = ЕдиницаИзмерения.Получить("code");
			КонецЕсли;
			
			СтрокаТЧ.ЕдиницаИзмерения = РС_ПолучитьЕдиницуИзмеренияПоКоду(ЕдиницаИзмерения);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаТоваров;

КонецФункции

Функция РС_СформироватьОбъектСчетНаОплату(ОбъектДанных, Подразделение)
	//Changelog
	//
	//17.01.2020 - добавлен фильтр опции "Не загружать счета на оплату"
	//19.02.2020 - реализовано создание одиночной номенклатуры "Услуги от поставщиков" при включенной опции "Загрузка номенклатуры как услуга"
	//			   Блок работы со статьями затрат перенесен в общий модуль
	
	МассивОбъектов = Новый Массив;
	ДокОбъект = МОП_СоздатьВходящийСчетНаОплату();
	
	Если ДокОбъект = Неопределено ИЛИ НеЗагружатьСчетаНаОплату Тогда
		Возврат МассивОбъектов;
	КонецЕсли;
	
	МОП_ЗаполнитьОрганизацию(ДокОбъект, ОбъектДанных);
	МОП_ЗаполнитьКонтрагентаПартнера(ДокОбъект, Подразделение, ОбъектДанных);
	МОП_ЗаполнитьДоговор(ДокОбъект, ОбъектДанных);    
	МОП_ЗаполнитьВалюту(ДокОбъект, ОбъектДанных);
	МОП_ЗаполнитьБанковскиеСчета(ДокОбъект, ОбъектДанных);
	
	СуммаВключаетНДС = Ложь;
	
	Если КНП_ЕстьТабЧасть(ДокОбъект, "Товары") Тогда
		
		ТаблицаТоваров = РС_ОбработатьТЧСтруктурыПФ(ОбъектДанных.ТабличнаяЧасть);	
		СтруктураТЧ = ДокОбъект.Товары.Выгрузить();
		
		ПодразделениеСЗатратами = ПодразделениеЗатрат;
		
		//==Специфический блок кода
		Если ВеткаРазработки = "РосМарк" Тогда
			
			ЗаданиеНаПеревозку = РосМарк_ПоискЗаданияНаПеревозку(ОбъектДанных.Номер);
			
			Если ЗначениеЗаполнено(ЗаданиеНаПеревозку) Тогда
				
				Ответственный = ЗаданиеНаПеревозку.Ответственный;
				ДокОбъект.Менеджер = Ответственный;
				ПодразделениеСЗатратами = Ответственный.Подразделение;
				
			КонецЕсли;
			
		КонецЕсли;
		//==Специфический блок кода
		
		
		Для Каждого Товар Из ТаблицаТоваров Цикл
			
			НовыйТовар = ДокОбъект.Товары.Добавить();
			
			Если СтруктураТЧ.Колонки.Найти("Содержание") <> Неопределено Тогда
				
				ЗаполнитьЗначенияСвойств(НовыйТовар, Товар,,"Содержание");
				НовыйТовар.Номенклатура = РС_НайтиНоменклатуру(Товар.Наименование, Подразделение);
				НовыйТовар.Содержание = ?(ЗначениеЗаполнено(Товар.Содержание), Товар.Содержание, Товар.Наименование);
				
			Иначе
				
				ЗаполнитьЗначенияСвойств(НовыйТовар, Товар);
				НовыйТовар.Номенклатура = РС_НайтиНоменклатуру(Товар.Наименование, Подразделение);
				
				Если НовыйТовар.Номенклатура.Пустая() Тогда
					
					Если ЗагрузкаНоменклатурыКакУслуга Тогда
						
						НовыйТовар.Номенклатура = Справочники.Номенклатура.НайтиПоНаименованию("Услуги от поставщиков", Истина);
						
						Если НовыйТовар.Номенклатура.Пустая() Тогда
							НовыйТовар.Номенклатура = КЗП_СоздатьНовуюНоменклатуру(Товар, "Услуги от поставщиков");
						КонецЕсли;
						
					Иначе
						НовыйТовар.Номенклатура = КЗП_СоздатьНовуюНоменклатуру(Товар);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
			Если СтруктураТЧ.Колонки.Найти("КоличествоУпаковок") <> Неопределено Тогда
				НовыйТовар.КоличествоУпаковок = Товар.Количество;
			КонецЕсли;
			
			Если МОП_НДСВСуммеПоСтавке(Товар.СтавкаНДС) Тогда
				СуммаВключаетНДС = Истина;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Товар.СтавкаНДС) И СтруктураТЧ.Колонки.Найти("СтавкаНДС") <> Неопределено  Тогда
				НовыйТовар.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.БезНДС");
			КонецЕсли;
			
			Если СтруктураТЧ.Колонки.Найти("СуммаСНДС") <> Неопределено Тогда
				НовыйТовар.СуммаСНДС = Товар.Сумма + ?(ЗначениеЗаполнено(Товар.СуммаНДС), Товар.СуммаНДС, 0);
			КонецЕсли;
			
			Если МОП_ЭтоУслуга(НовыйТовар.Номенклатура)
				И ЗначениеЗаполнено(ПодразделениеСЗатратами) 
				И СтруктураТЧ.Колонки.Найти("Подразделение") <> Неопределено
				И СтруктураТЧ.Колонки.Найти("СписатьНаРасходы") <> Неопределено
				Тогда
				
				НовыйТовар.Подразделение = ПодразделениеСЗатратами;
				НовыйТовар.СписатьНаРасходы = Истина;
				НовыйТовар.СтатьяРасходов = РС_ПолучитьСтатьюРасходов(Подразделение, НовыйТовар.Номенклатура);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если КНП_ЕстьТабЧасть(ДокОбъект, "Запасы") Тогда
		
		ТаблицаТоваров = РС_ОбработатьТЧСтруктурыПФ(ОбъектДанных.ТабличнаяЧасть);	
		
		Для Каждого Товар Из ТаблицаТоваров Цикл
			
			НовыйТовар = ДокОбъект.Запасы.Добавить();
			ЗаполнитьЗначенияСвойств(НовыйТовар, Товар,,"Содержание");
			НовыйТовар.Номенклатура = РС_НайтиНоменклатуру(Товар.Наименование, Подразделение);
			НовыйТовар.Содержание = ?(ЗначениеЗаполнено(Товар.Содержание), Товар.Содержание, Товар.Наименование);
			
			Если МОП_НДСВСуммеПоСтавке(Товар.СтавкаНДС) Тогда
				СуммаВключаетНДС = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	МОП_ЗаполнитьРеквизитыДокумента(ДокОбъект, ОбъектДанных, СуммаВключаетНДС, "Счет на оплату");	
	
	МассивОбъектов.Добавить(ДокОбъект);	
	
	Возврат МассивОбъектов;

КонецФункции

Функция РС_СформироватьОбъектАктВыполненныхРабот(ОбъектДанных, Подразделение, УПД = Ложь, ИскатьНакладнуюАкт = Ложь)
	//Changelog
	//
	//17.01.2020 - добавлены специфичный блоки РосМарк
	//19.02.2020 - выведены в общую редакцию работа со статьями расходов
	
	МассивОбъектов = Новый Массив;
	
	Если ИскатьНакладнуюАкт Тогда
		ДокОбъект = КЗП_НайтиОснованиеСчетФактурыПоставщика(ОбъектДанных.Номер, КНП_ПривестиКДате(ОбъектДанных.Дата), Подразделение);	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДокОбъект) Тогда
		ДокОбъект = МОП_СоздатьВходящийАкт();
	КонецЕсли;
	
	Если ДокОбъект = Неопределено Тогда
		Возврат МассивОбъектов;
	КонецЕсли;
	
	МОП_ЗаполнитьОрганизацию(ДокОбъект, ОбъектДанных);
	МОП_ЗаполнитьКонтрагентаПартнера(ДокОбъект, Подразделение, ОбъектДанных);
	МОП_ЗаполнитьДоговор(ДокОбъект, ОбъектДанных);
	МОП_ЗаполнитьВалюту(ДокОбъект, ОбъектДанных);	
	МОП_ЗаполнитьСпособЗачетаАвансов(ДокОбъект, ОбъектДанных);
	МОП_ЗаполнитьБанковскиеСчета(ДокОбъект, ОбъектДанных);
	
	СуммаВключаетНДС = Ложь;
	
	Если КНП_ЕстьТабЧасть(ДокОбъект, "Услуги") Тогда
		
		ТаблицаТоваров = РС_ОбработатьТЧСтруктурыПФ(ОбъектДанных.ТабличнаяЧасть);	
		
		Для Каждого Товар Из ТаблицаТоваров Цикл
			
			НовыйТовар = ДокОбъект.Услуги.Добавить();
			ЗаполнитьЗначенияСвойств(НовыйТовар, Товар,,"Содержание");
			НовыйТовар.Номенклатура = РС_НайтиНоменклатуру(Товар.Наименование, Подразделение);
			НовыйТовар.Содержание = ?(ЗначениеЗаполнено(Товар.Содержание), Товар.Содержание, Товар.Наименование);
			
			Если МОП_НДСВСуммеПоСтавке(Товар.СтавкаНДС) Тогда
				СуммаВключаетНДС = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если КНП_ЕстьТабЧасть(ДокОбъект, "Расходы") Тогда
		
		СтруктураТЧ = ДокОбъект.Расходы.Выгрузить();
		
		ТаблицаТоваров = РС_ОбработатьТЧСтруктурыПФ(ОбъектДанных.ТабличнаяЧасть);	
		ПодразделениеСЗатратами = ПодразделениеЗатрат;
		
		//==Специфический блок кода
		Если ВеткаРазработки = "РосМарк" Тогда
			
			ЗаказПоставщику = РосМарк_ПоискЗаказаПоставщику(ОбъектДанных.Номер);
			
			Если ЗначениеЗаполнено(ЗаказПоставщику) Тогда
				
				Если ЗаказПоставщику.СуммаДокумента <> ТаблицаТоваров.Итог("СуммаСНДС") Тогда
					Возврат "Ошибка создания приходной накладной: несоответствие суммы в документе и в заказе №" + ЗаказПоставщику.Номер;
				КонецЕсли;
				
			КонецЕсли;
			
			ЗаданиеНаПеревозку = РосМарк_ПоискЗаданияНаПеревозку(ОбъектДанных.Номер);
			
			Если ЗначениеЗаполнено(ЗаданиеНаПеревозку) Тогда
				
				Ответственный = ЗаданиеНаПеревозку.Ответственный;
				ДокОбъект.Менеджер = Ответственный;
				ПодразделениеСЗатратами = Ответственный.Подразделение;
				
			КонецЕсли;
			
		КонецЕсли;
		//==Специфический блок кода
		
		Для Каждого Товар Из ТаблицаТоваров Цикл
			
			НовыйТовар = ДокОбъект.Расходы.Добавить();
			ЗаполнитьЗначенияСвойств(НовыйТовар, Товар,,"Содержание");
			НовыйТовар.Содержание = ?(ЗначениеЗаполнено(Товар.Содержание), Товар.Содержание, Товар.Наименование);
			
			Если ЗначениеЗаполнено(ПодразделениеСЗатратами) 
				И СтруктураТЧ.Колонки.Найти("Подразделение") <> Неопределено
				И СтруктураТЧ.Колонки.Найти("СтатьяРасходов") <> Неопределено
				Тогда
				
				НовыйТовар.Подразделение = ПодразделениеСЗатратами;
				НовыйТовар.СтатьяРасходов = РС_ПолучитьСтатьюРасходов(Подразделение, НовыйТовар.Содержание);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если КНП_ЕстьТабЧасть(ДокОбъект, "УслугиИРаботы") Тогда
		
		ТаблицаТоваров = РС_ОбработатьТЧСтруктурыПФ(ОбъектДанных.ТабличнаяЧасть);	
		
		Для Каждого Товар Из ТаблицаТоваров Цикл
			
			НовыйТовар = ДокОбъект.УслугиИРаботы.Добавить();
			ЗаполнитьЗначенияСвойств(НовыйТовар, Товар,, "Содержание");
			НовыйТовар.Номенклатура = РС_НайтиНоменклатуру(Товар.Наименование, Подразделение);
			НовыйТовар.Содержание = ?(ЗначениеЗаполнено(Товар.Содержание), Товар.Содержание, Товар.Наименование);
			
		КонецЦикла;
		
	КонецЕсли;
	
	МОП_ЗаполнитьВидОперации(ДокОбъект, ОбъектДанных);
	КЗП_ЗаполнитьДопПараметрыДокумента(ДокОбъект, "Акт");
	МОП_ЗаполнитьРеквизитыДокумента(ДокОбъект, ОбъектДанных, СуммаВключаетНДС, "Акт сдачи \ приема");	
	
	МассивОбъектов.Добавить(ДокОбъект);
	
	Если УПД Тогда
		
		ДокОбъект.Записать();
		
		Попытка
			
			ДокСФ =РС_СформироватьСФПолученную(ДокОбъект.Ссылка);
			
			Если ДокСФ <> Неопределено Тогда
				МассивОбъектов.Добавить(ДокСФ);
			КонецЕсли;
			
		Исключение
			ДобавитьВЖурнал(ОписаниеОшибки(), "РС_СформироватьОбъектАктВыполненныхРабот");	
		КонецПопытки
		
	КонецЕсли;
	
	Возврат МассивОбъектов;
	
КонецФункции

Функция РС_СформироватьОбъектНакладная(ОбъектДанных, Подразделение, УПД = Ложь, ИскатьНакладнуюАкт = Ложь)
	//Changelog
	//
	//17.01.2020 - добавлены специфичный блоки кода РосМарк
	//19.02.2020 - выведены в общую редакцию заполнение статей расходов
	
	МассивОбъектов = Новый Массив;
	ДокОбъект = Неопределено;
	
	Если ИскатьНакладнуюАкт Тогда
		ДокОбъект = КЗП_НайтиОснованиеСчетФактурыПоставщика(ОбъектДанных.Номер, КНП_ПривестиКДате(ОбъектДанных.Дата), Подразделение);	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДокОбъект) Тогда
		ДокОбъект = МОП_СоздатьВходящийНакладная();
	КонецЕсли;
	
	Если ДокОбъект = Неопределено Тогда
		Возврат МассивОбъектов;
	КонецЕсли;
	
	МОП_ЗаполнитьОрганизацию(ДокОбъект, ОбъектДанных);
	МОП_ЗаполнитьКонтрагентаПартнера(ДокОбъект, Подразделение, ОбъектДанных);
	МОП_ЗаполнитьДоговор(ДокОбъект, ОбъектДанных);
	МОП_ЗаполнитьВалюту(ДокОбъект, ОбъектДанных);	
	МОП_ЗаполнитьСпособЗачетаАвансов(ДокОбъект, ОбъектДанных);
	МОП_ЗаполнитьБанковскиеСчета(ДокОбъект, ОбъектДанных);
	
	СуммаВключаетНДС = Ложь;
	
	Если КНП_ЕстьТабЧасть(ДокОбъект, "Товары") Тогда
		
		СтруктураТЧ = ДокОбъект.Товары.Выгрузить();
		
		СтруктураКолонок = КНП_СтруктураНаОснованииКолонокТЧ(ДокОбъект.Товары);
		
		Если ТипЗнч(ОбъектДанных) = Тип("Соответствие") Тогда
			ТаблицаТоваров = РС_ПрочитатьТаблицуТоваров(ОбъектДанных.Получить("goods") );
		Иначе
			ТаблицаТоваров = РС_ОбработатьТЧСтруктурыПФ(ОбъектДанных.ТабличнаяЧасть);	
		КонецЕсли;
		
		ПодразделениеСЗатратами = ПодразделениеЗатрат;
		
		//==Специфический блок кода
		Если ВеткаРазработки = "РосМарк" Тогда
			
			ЗаказПоставщику = РосМарк_ПоискЗаказаПоставщику(ОбъектДанных.Номер);
			
			Если ЗначениеЗаполнено(ЗаказПоставщику) Тогда
				
				Если ЗаказПоставщику.СуммаДокумента <> ТаблицаТоваров.Итог("СуммаСНДС") Тогда
					Возврат "Ошибка создания приходной накладной: несоответствие суммы в документе и в заказе №" + ЗаказПоставщику.Номер;
				КонецЕсли;
				
			КонецЕсли;
			
			ЗаданиеНаПеревозку = РосМарк_ПоискЗаданияНаПеревозку(ОбъектДанных.Номер);
			
			Если ЗначениеЗаполнено(ЗаданиеНаПеревозку) Тогда
				
				Ответственный = ЗаданиеНаПеревозку.Ответственный;
				ДокОбъект.Менеджер = Ответственный;
				ПодразделениеСЗатратами = Ответственный.Подразделение;
				
			КонецЕсли;
			
		КонецЕсли;
		//==Специфический блок кода
		
		Для Каждого Товар Из ТаблицаТоваров Цикл
			
			НовыйТовар = ДокОбъект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НовыйТовар, Товар);
			НовыйТовар.Номенклатура = РС_НайтиНоменклатуру(Товар.Наименование, Подразделение);
			
			Если НовыйТовар.Количество = 0 Тогда
				НовыйТовар.Количество = 1;
			КонецЕсли;
			
			Если НовыйТовар.Номенклатура.Пустая() Тогда
				НовыйТовар.Номенклатура = КЗП_СоздатьНовуюНоменклатуру(Товар);
			КонецЕсли;
			
			Если МОП_НДСВСуммеПоСтавке(Товар.СтавкаНДС) Тогда
				СуммаВключаетНДС = Истина;
			КонецЕсли;
			
			Если СтруктураКолонок.Свойство("КоличествоУпаковок") Тогда
				НовыйТовар.КоличествоУпаковок = НовыйТовар.Количество;
			КонецЕсли;
			
			Если КНП_ЕстьОбъектМетаданных("ЕдиницыИзмерения") Тогда
				
				Если НовыйТовар.ЕдиницаИзмерения.Пустая() Тогда
					НовыйТовар.ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.НайтиПоНаименованию(Товар.ЕдиницаИзмерения.Наименование);
				КонецЕсли;
				
			КонецЕсли;
			
			Если МОП_ЭтоУслуга(НовыйТовар.Номенклатура)
				И ЗначениеЗаполнено(ПодразделениеСЗатратами) 
				И СтруктураТЧ.Колонки.Найти("Подразделение") <> Неопределено
				И СтруктураТЧ.Колонки.Найти("СписатьНаРасходы") <> Неопределено
				Тогда
				
				НовыйТовар.Подразделение = ПодразделениеСЗатратами;
				НовыйТовар.СписатьНаРасходы = Истина;
				НовыйТовар.СтатьяРасходов = РС_ПолучитьСтатьюРасходов(Подразделение, НовыйТовар.Номенклатура);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если КНП_ЕстьТабЧасть(ДокОбъект, "Материалы") Тогда
		
		СтруктураКолонок = КНП_СтруктураНаОснованииКолонокТЧ(ДокОбъект.Материалы);
		
		Если ТипЗнч(ОбъектДанных) = Тип("Соответствие") Тогда
			ТаблицаТоваров = РС_ПрочитатьТаблицуТоваров(ОбъектДанных.Получить("goods") );
		Иначе
			ТаблицаТоваров = РС_ОбработатьТЧСтруктурыПФ(ОбъектДанных.ТабличнаяЧасть);	
		КонецЕсли;
		
		Для Каждого Товар Из ТаблицаТоваров Цикл
			
			НовыйТовар = ДокОбъект.Материалы.Добавить();
			ЗаполнитьЗначенияСвойств(НовыйТовар, Товар);
			НовыйТовар.Номенклатура = РС_НайтиНоменклатуру(Товар.Наименование, Подразделение);
			НовыйТовар.КоличествоМест = Товар.Количество;
			
			Если НовыйТовар.Количество = 0 Тогда
				НовыйТовар.Количество = 1;
			КонецЕсли;
			
			Если НовыйТовар.КоличествоМест = 0 Тогда
				НовыйТовар.КоличествоМест = 1;
			КонецЕсли; 
			
			Если НовыйТовар.Номенклатура.Пустая() Тогда
				НовыйТовар.Номенклатура = КЗП_СоздатьНовуюНоменклатуру(Товар);
			КонецЕсли;
			
			Если МОП_НДСВСуммеПоСтавке(Товар.СтавкаНДС) Тогда
				СуммаВключаетНДС = Истина;
			КонецЕсли;
			
			Если СтруктураКолонок.Свойство("КоличествоУпаковок") Тогда
				НовыйТовар.КоличествоУпаковок = НовыйТовар.Количество;
			КонецЕсли;
			
			Если КНП_ЕстьОбъектМетаданных("ЕдиницыИзмерения") Тогда
				
				Если НовыйТовар.ЕдиницаИзмерения.Пустая() Тогда
					НовыйТовар.ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.НайтиПоНаименованию(Товар.ЕдиницаИзмерения.Наименование);
				КонецЕсли;
				
			КонецЕсли;
			
			Если НовыйТовар.ЦенаОприходования = 0 Тогда
				НовыйТовар.ЦенаОприходования = Товар.Цена;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если КНП_ЕстьТабЧасть(ДокОбъект, "Запасы") Тогда
		
		СтруктураКолонок = КНП_СтруктураНаОснованииКолонокТЧ(ДокОбъект.Запасы);
		
		Если ТипЗнч(ОбъектДанных) = Тип("Соответствие") Тогда
			ТаблицаТоваров = РС_ПрочитатьТаблицуТоваров(ОбъектДанных.Получить("goods") );
		Иначе
			ТаблицаТоваров = РС_ОбработатьТЧСтруктурыПФ(ОбъектДанных.ТабличнаяЧасть);	
		КонецЕсли;
		
		Для Каждого Товар Из ТаблицаТоваров Цикл
			
			НовыйТовар = ДокОбъект.Запасы.Добавить();
			ЗаполнитьЗначенияСвойств(НовыйТовар, Товар);
			
			Если НовыйТовар.Количество = 0 Тогда
				НовыйТовар.Количество = 1;
			КонецЕсли;
			
			НовыйТовар.Номенклатура = РС_НайтиНоменклатуру(Товар.Наименование, Подразделение);
			
			Если НовыйТовар.Номенклатура.Пустая() Тогда
				НовыйТовар.Номенклатура = КЗП_СоздатьНовуюНоменклатуру(Товар);
			КонецЕсли;
			
			Если МОП_НДСВСуммеПоСтавке(Товар.СтавкаНДС) Тогда
				СуммаВключаетНДС = Истина;
			КонецЕсли;
			
			Если СтруктураКолонок.Свойство("КоличествоУпаковок") Тогда
				НовыйТовар.КоличествоУпаковок = НовыйТовар.Количество;
			КонецЕсли;
			
			Если КНП_ЕстьОбъектМетаданных("ЕдиницыИзмерения") Тогда
				
				Если НовыйТовар.ЕдиницаИзмерения = Неопределено ИЛИ НовыйТовар.ЕдиницаИзмерения.Пустая() Тогда
					
					Если ТипЗнч(Товар.ЕдиницаИзмерения) = Тип("Строка") Тогда
						НовыйТовар.ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.НайтиПоНаименованию(Товар.ЕдиницаИзмерения);	
					Иначе
						НовыйТовар.ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.НайтиПоНаименованию(Товар.ЕдиницаИзмерения.Наименование);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли; 
			
		КонецЦикла;
		
	КонецЕсли;
	
	МОП_ЗаполнитьВидОперации(ДокОбъект, ОбъектДанных);
	КЗП_ЗаполнитьДопПараметрыДокумента(ДокОбъект, "Накладная");
	МОП_ЗаполнитьРеквизитыДокумента(ДокОбъект, ОбъектДанных, СуммаВключаетНДС, "Накладная");
	
	МассивОбъектов.Добавить(ДокОбъект);
	
	Если УПД Тогда
		
		ДокОбъект.Записать();
		
		Попытка
			
			ДокСФ =РС_СформироватьСФПолученную(ДокОбъект.Ссылка);
			
			Если ДокСФ <> Неопределено Тогда
				МассивОбъектов.Добавить(ДокСФ);
			КонецЕсли;
			
		Исключение
			ДобавитьВЖурнал(ОписаниеОшибки(), "СформироватьОбъектКорректировка");	
		КонецПопытки
		
	КонецЕсли;
	
	Возврат МассивОбъектов;
	
КонецФункции

Функция РС_СформироватьСФПолученную(ДокументСсылка)
	
	Если КНП_ЕстьРеквизит(ДокументСсылка, "ПредъявленСчетФактура") Тогда
		
		Если ДокументСсылка.ПредъявленСчетФактура Тогда
			Возврат Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	
	Результат = Неопределено;
	
	Попытка 
		Результат = Документы.СчетФактураПолученный.СоздатьДокументНаОсновании(ДокументСсылка, ДокументСсылка.НомерВходящегоДокумента, ДокументСсылка.ДатаВходящегоДокумента);
	Исключение 
		Результат = Неопределено;
	КонецПопытки;
	
	Если Результат = Неопределено Тогда
		
		Попытка
			
			СчетФактура = Документы.СчетФактураПолученный.СоздатьДокумент();
			ЗаполнитьЗначенияСвойств(СчетФактура, ДокументСсылка);
			
			Если КНП_ЕстьТабЧасть(СчетФактура, "ДокументыОснования") Тогда
				
				Основание = СчетФактура.ДокументыОснования.Добавить();
				Основание.ДокументОснование = ДокументСсылка;
				
			КонецЕсли;
			
			Если КНП_ЕстьРеквизит(СчетФактура, "ДокументОснование") Тогда
				СчетФактура.ДокументОснование = ДокументСсылка;
			КонецЕсли;
			
			Если КНП_ЕстьРеквизит(ДокументСсылка, "ДатаВходящегоДокумента") Тогда
				
				Если ЗначениеЗаполнено(ДокументСсылка.ДатаВходящегоДокумента) Тогда
					
					СчетФактура.Дата = ДокументСсылка.ДатаВходящегоДокумента;
					
					Если КНП_ЕстьРеквизит(СчетФактура, "ДатаСоставления") Тогда
						СчетФактура.ДатаСоставления = ДокументСсылка.ДатаВходящегоДокумента;
					КонецЕсли;
					
				Иначе
					
					СчетФактура.Дата = ДокументСсылка.Дата;
					
					Если КНП_ЕстьРеквизит(СчетФактура, "ДатаСоставления") Тогда
						СчетФактура.ДатаСоставления = ДокументСсылка.Дата;	
					КонецЕсли;
					
				КонецЕсли;
				
			ИначеЕсли КНП_ЕстьРеквизит(ДокументСсылка, "ДатаПервичногоДокумента") Тогда
				
				Если ЗначениеЗаполнено(ДокументСсылка.ДатаПервичногоДокумента) Тогда
					
					СчетФактура.Дата = ДокументСсылка.ДатаПервичногоДокумента;
					
					Если КНП_ЕстьРеквизит(СчетФактура, "ДатаСоставления") Тогда
						СчетФактура.ДатаСоставления = ДокументСсылка.ДатаПервичногоДокумента;
					КонецЕсли;
					
				Иначе
					
					СчетФактура.Дата = ДокументСсылка.Дата;
					
					Если КНП_ЕстьРеквизит(СчетФактура, "ДатаСоставления") Тогда
						СчетФактура.ДатаСоставления = ДокументСсылка.Дата;	
					КонецЕсли;
					
				КонецЕсли;	
				
			Иначе
				
				СчетФактура.Дата = ДокументСсылка.Дата;
				
				Если КНП_ЕстьРеквизит(СчетФактура, "ДатаСоставления") Тогда
					СчетФактура.ДатаСоставления = ДокументСсылка.Дата;	
				КонецЕсли;
				
			КонецЕсли;
			
			Если КНП_ЕстьРеквизит(ДокументСсылка, "НомерВходящегоДокумента") Тогда
				
				Если ЗначениеЗаполнено(ДокументСсылка.НомерВходящегоДокумента) Тогда
					СчетФактура.Номер = ДокументСсылка.НомерВходящегоДокумента;	
				Иначе
					СчетФактура.Номер = ДокументСсылка.Номер;
				КонецЕсли;
				
			ИначеЕсли КНП_ЕстьРеквизит(ДокументСсылка, "НомерПервичногоДокумента") Тогда
				
				Если ЗначениеЗаполнено(ДокументСсылка.НомерПервичногоДокумента) Тогда
					СчетФактура.Номер = ДокументСсылка.НомерПервичногоДокумента;	
				Иначе
					СчетФактура.Номер = ДокументСсылка.Номер;
				КонецЕсли;
				
			Иначе
				СчетФактура.Номер = ДокументСсылка.Номер;
			КонецЕсли;
			
			Если КНП_ЕстьРеквизит(СчетФактура, "НомерВходящегоДокумента") Тогда
				
				СчетФактура.НомерВходящегоДокумента = СчетФактура.Номер;
				СчетФактура.УстановитьНовыйНомер(СчетФактура.Организация.Префикс);
				
			КонецЕсли;
			
			Если КНП_ЕстьРеквизит(СчетФактура, "НомерПервичногоДокумента") Тогда
				
				СчетФактура.НомерПервичногоДокумента = СчетФактура.Номер;
				СчетФактура.УстановитьНовыйНомер(СчетФактура.Организация.Префикс);
				
			КонецЕсли;
			
			СчетФактура.Записать(РежимЗаписиДокумента.Запись);
			Результат = СчетФактура;
			
		Исключение
			ДобавитьВЖурнал(ОписаниеОшибки(), "КЗП_СформироватьСФПолученную");
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция РС_СформироватьСФПолученнуюБезНакладной(ОбъектДанных, Подразделение)
	
	МассивОбъектов = Новый Массив;
	
	Попытка
		
		ДокОбъект = Документы.СчетФактураПолученный.СоздатьДокумент();
		МОП_ЗаполнитьОрганизацию(ДокОбъект, ОбъектДанных);
		МОП_ЗаполнитьКонтрагентаПартнера(ДокОбъект, Подразделение, ОбъектДанных);
		МОП_ЗаполнитьДоговор(ДокОбъект, ОбъектДанных);
		МОП_ЗаполнитьВалюту(ДокОбъект, ОбъектДанных);	
		МОП_ЗаполнитьРеквизитыДокумента(ДокОбъект, ОбъектДанных, Ложь, "Счет фактура");
		
		Если КНП_ЕстьТабЧасть(ДокОбъект, "СоставНФА") Тогда
			
			СтруктураКолонок = КНП_СтруктураНаОснованииКолонокТЧ(ДокОбъект.СоставНФА);
			
			Если ТипЗнч(ОбъектДанных) = Тип("Соответствие") Тогда
				ТаблицаТоваров = РС_ПрочитатьТаблицуТоваров(ОбъектДанных.Получить("goods") );
			Иначе
				ТаблицаТоваров = РС_ОбработатьТЧСтруктурыПФ(ОбъектДанных.ТабличнаяЧасть);	
			КонецЕсли;
			
			Для Каждого Товар Из ТаблицаТоваров Цикл
				
				НовыйТовар = ДокОбъект.СоставНФА.Добавить();
				ЗаполнитьЗначенияСвойств(НовыйТовар, Товар);
				НовыйТовар.НФА = РС_НайтиНоменклатуру(Товар.Наименование, Подразделение);
				
				Если НовыйТовар.Количество = 0 Тогда
					НовыйТовар.Количество = 1;
				КонецЕсли;
				
				Если НовыйТовар.НФА.Пустая() Тогда
					НовыйТовар.НФА = КЗП_СоздатьНовуюНоменклатуру(Товар);
				КонецЕсли;
				
				Если МОП_НДСВСуммеПоСтавке(Товар.СтавкаНДС) Тогда
					СуммаВключаетНДС = Истина;
				КонецЕсли;
				
				Если СтруктураКолонок.Свойство("КоличествоУпаковок") Тогда
					НовыйТовар.КоличествоУпаковок = НовыйТовар.Количество;
				КонецЕсли;
				
				Если КНП_ЕстьОбъектМетаданных("ЕдиницыИзмерения") Тогда
					
					Если НовыйТовар.ЕдиницаИзмерения.Пустая() Тогда
						НовыйТовар.ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.НайтиПоНаименованию(Товар.ЕдиницаИзмерения.Наименование);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		МассивОбъектов.Добавить(ДокОбъект);
		
	Исключение
		ДобавитьВЖурнал(ОписаниеОшибки(), "РС_СформироватьСФПолученнуюБезНакладной");
	КонецПопытки;
	
	Возврат МассивОбъектов;
	
КонецФункции

