Функция ОтправитьПодписанноеИнфоСообщение(Контент, Подпись) 					Экспорт
	
	СтруктураТелаЗапроса = Новый Структура;
	СтруктураТелаЗапроса.Вставить("content", Контент);
	СтруктураТелаЗапроса.Вставить("signature", КНП_ОбработатьСтрокуBase64(Подпись));
	Результат = API_ОтправитьДокументСПодписью("information_message", КНП_ЗаписатьJSONНаСервере(СтруктураТелаЗапроса));
	
	Если ТипЗнч(Результат) = Тип("Соответствие") Тогда
		
		Если Результат.Получить("success") = Истина Тогда
			ВывестиУведомлениеПользователю("Информационное сообщение о регистрации успешно подписано. Рекомендуем переавторизоваться");	
		Иначе
			ВывестиУведомлениеПользователю(Результат.Получить("codeDescription") );
		КонецЕсли;
		
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	ЗаписатьЖурналВФайл();
	Возврат Результат;

КонецФункции

