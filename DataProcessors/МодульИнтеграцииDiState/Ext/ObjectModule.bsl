Функция ПолучитьТаймЗону() Экспорт
	
	СоответствиеЗоныКоду = Новый Соответствие;
	СоответствиеЗоныКоду.Вставить("+1", 1);
	СоответствиеЗоныКоду.Вставить("+2", 2);
	СоответствиеЗоныКоду.Вставить("+3", 3);
	СоответствиеЗоныКоду.Вставить("+4", 4);
	СоответствиеЗоныКоду.Вставить("+5", 5);
	СоответствиеЗоныКоду.Вставить("+6", 6);
	СоответствиеЗоныКоду.Вставить("+7", 7);
	СоответствиеЗоныКоду.Вставить("+8", 8);
	СоответствиеЗоныКоду.Вставить("+9", 9);
	СоответствиеЗоныКоду.Вставить("+10", 10);
	СоответствиеЗоныКоду.Вставить("+11", 11);
	СоответствиеЗоныКоду.Вставить("+12", 12);
		
	ЧасовойПоясПредсталение = "+3";
	
	ЧасовойПоясФилиала = Константы.ЧасовойПоясФилиала.Получить();
	
	Если ЗначениеЗаполнено(ЧасовойПоясФилиала) Тогда
		ЧасовойПоясПредсталение = Строка(ЧасовойПоясФилиала);	
	КонецЕсли;
		
	Возврат СоответствиеЗоныКоду.Получить(ЧасовойПоясПредсталение);
	
КонецФункции

