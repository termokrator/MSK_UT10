//#Область ФорматыОписанияДанных

// Функция - Прочитать формат описания документа
//
// Параметры:
//  ИмяФОД	 - Строка	 - Имя макета с форматом описания документа
// 
// Возвращаемое значение:
// Структура  - Структура, полученная при использовании ФОД
//
Функция ФОД_ПрочитатьФорматОписанияДокумента(ИмяФОД)
	
	Макет = ПолучитьМакет(ИмяФОД);
	СтрокаJSON = Макет.ПолучитьТекст();
	ОбъектФОД = КНП_ПрочитатьJSONОтСервера(СтрокаJSON);
	
	Если ТипЗнч(ОбъектФОД) = Тип("Соответствие") Тогда
		ОбъектФОД = КНП_ПолучитьСтруктуруИзСоответствия(ОбъектФОД);
	КонецЕсли;
	
	Возврат ОбъектФОД;	

КонецФункции

