Функция ФОД_ПолучитьКорректируемыеДокументы(Знач ОбъектЗаполнения)
	
	МассивСтруктур = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(ОбъектЗаполнения) Тогда
		
		ДобавитьВЖурнал("Не определен объект заполнения!", "ФОД_ПолучитьКорректируемыеДокументы");
		Возврат МассивСтруктур;
		
	КонецЕсли;
	
	ДокументКоррекции = ФОД_ПолучитьКорректируемыйДокумент(ОбъектЗаполнения);
	
	Если ДокументКоррекции = Неопределено Тогда
		Возврат Новый Структура("Номер,Дата", "", "");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументКоррекции.Номер) И ЗначениеЗаполнено(ДокументКоррекции.Дата) Тогда
		МассивСтруктур.Добавить(ДокументКоррекции);
	КонецЕсли;
	
	Возврат МассивСтруктур;
	
КонецФункции

Функция ФОД_ПолучитьПредставлениеДокумента(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	
	Представление = "";
	
	Если ТипЗнч(ОбъектЗаполнения) = Тип("Структура") Тогда
		
		Если ОбъектЗаполнения.Свойство("Наименование") Тогда
			Представление = ОбъектЗаполнения.Наименование;
		КонецЕсли;
		
	Иначе //Это объект
		
		Если КНП_ЕстьРеквизит(ОбъектЗаполнения, "Наименование") Тогда
			Представление = ОбъектЗаполнения.Наименование;
		Иначе
			Представление = Строка(ОбъектЗаполнения);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Представление;
	
КонецФункции

Функция ФОД_ПолучитьКорректируемыеСЧФ(Знач ОбъектЗаполнения)
	
	МассивСтруктур = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(ОбъектЗаполнения) Тогда
		
		ДобавитьВЖурнал("Не определен объект заполнения!", "ФОД_ПолучитьКорректируемыеСЧФ");
		Возврат МассивСтруктур;
		
	КонецЕсли;
	
	ДокументСЧФ = ФОД_ПолучитьКорректируемуюСчетФактуру(ОбъектЗаполнения);
	
	Если ДокументСЧФ = Неопределено Тогда
		Возврат Новый Структура("Номер,Дата", "", "");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Константы.УказыватьПервичныйСчетФактуруВОснованииКоррСчФ.Получить()) 
		И ТипЗнч(ОбъектЗаполнения) = Тип("ДокументСсылка.СчетФактураВыданный")
		И ОбъектЗаполнения.ДокументыОснования.Количество() > 0
		И ЗначениеЗаполнено(ОбъектЗаполнения.ДокументыОснования[0].НомерИсходногоДокумента) Тогда
		МассивСтруктур.Добавить(Новый Структура("Номер,Дата", ОбъектЗаполнения.ДокументыОснования[0].НомерИсходногоДокумента, 
		           ОбъектЗаполнения.ДокументыОснования[0].ДатаИсходногоДокумента));	
	Иначе

		Если ЗначениеЗаполнено(ДокументСЧФ.Номер) И ЗначениеЗаполнено(ДокументСЧФ.Дата) Тогда
			МассивСтруктур.Добавить(ДокументСЧФ);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат МассивСтруктур;
	
КонецФункции

Функция ФОД_ПолучитьПродавцаДокумента(Знач ОбъектЗаполнения)
	
	ЕстьРеквизитОрганизации = КНП_ЕстьРеквизит(ОбъектЗаполнения, "Организация");
	
	Если ЕстьРеквизитОрганизации Тогда
		Результат = ОбъектЗаполнения.Организация;
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат; 
	
КонецФункции

Функция ФОД_ПолучитьОснованиеПолномочий(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	
	Если Строка(ФОД_ПолучитьСтатусПодписанта(ВерсияЗаполнения, ОбъектЗаполнения) ) = "4" Тогда
		Возврат "Индивидуальный предприниматель";
	Иначе
		Возврат "Должностные обязанности сотрудника";
	КонецЕсли;

КонецФункции

Функция ФОД_ПолучитьСуммуТовараПадение(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	
	ЗначениеПосле 	= ФОД_ПолучитьСуммуТовара(ВерсияЗаполнения, ОбъектЗаполнения);
	ЗначениеДо 		= ФОД_ПолучитьСуммуДо(ВерсияЗаполнения, ОбъектЗаполнения);
	
	Если ЗначениеПосле < ЗначениеДо Тогда
		Возврат ЗначениеДо - ЗначениеПосле;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

Функция ФОД_ПолучитьСуммуТовараРост(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	
	ЗначениеПосле 	= ФОД_ПолучитьСуммуТовара(ВерсияЗаполнения, ОбъектЗаполнения);
	ЗначениеДо 		= ФОД_ПолучитьСуммуДо(ВерсияЗаполнения, ОбъектЗаполнения);
	
	Если ЗначениеПосле >= ЗначениеДо Тогда
		Возврат ЗначениеПосле - ЗначениеДо;
	Иначе
		Возврат Неопределено;
	КонецЕсли;	

КонецФункции

// Процедура осуществляет анализ формата описания документа и выполняет заполнение процедуры с помощью обработчиков
//
// Параметры:
//  СтруктураДанных	 - Структура	 - Заполняемая структура данных
//  ВерсияЗаполнения - Строка	 - Версия формата документа
//  ОбъектЗаполнения - ЛюбаяСсылка	 - Ссылка на справочник, документ или другой тип метаданных, который будет использоваться для получения значений
//
Функция ФОД_ЗаполнитьСтруктуру(СтруктураДанных, ВерсияЗаполнения, Знач ОбъектЗаполнения, Знач Обязательный = Ложь, Документ = Неопределено)
	
	ПризнакОтсутствияДанных = Истина;
	Обязательный = СтруктураДанных.Свойство("__required");
	
	Если СтруктураДанных.Свойство("__object") И ЗначениеЗаполнено(СтруктураДанных.__object) Тогда
		
		Если Найти(СтруктураДанных.__object, "()") Тогда
			
			Попытка
				
				ДобавитьВЖурнал("Вызов функции " + СтруктураДанных.__object + ". ОбъектЗаполнения = " + Строка(ОбъектЗаполнения), "ФОД_ЗаполнитьСтруктуру");

				Если СтруктураДанных.__object = "ФОД_ПолучитьАдресКомпании()" ИЛИ СтруктураДанных.__object = "ФОД_ПолучитьАдресПокупателя()"  Тогда
					Выполнить("ОбъектЗаполнения = " + СтрЗаменить(СтруктураДанных.__object, "()", "(ОбъектЗаполнения, Документ)") );
					
				//+Макрушин Е. 07.04.2026 #UT10-5800
				ИначеЕсли СтруктураДанных.__object = "ФОД_ПолучитьАдресСклада()" Тогда
					Выполнить("ОбъектЗаполнения = " + СтрЗаменить(СтруктураДанных.__object, "()", "(ОбъектЗаполнения, Документ)") );
				//-Макрушин Е. 07.04.2026 #UT10-5800
	
				Иначе
					Выполнить("ОбъектЗаполнения = " + СтрЗаменить(СтруктураДанных.__object, "()", "(ОбъектЗаполнения)") );
				КонецЕсли;
				
				ДобавитьВЖурнал("Завершена работа функции " + СтруктураДанных.__object + ". Результат = " + ОбъектЗаполнения, "ФОД_ЗаполнитьСтруктуру");
				
			Исключение
				
				ДобавитьВЖурнал(ОписаниеОшибки(), "ФОД_ЗаполнитьСтруктуру: " + СтруктураДанных.__object + "()");
				ВывестиУведомлениеПользователю("Ошибка при работе метода " + СтруктураДанных.__object);
				Возврат НЕ ПризнакОтсутствияДанных;
				
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ОбъектЗаполнения = Неопределено И Обязательный Тогда
		ВывестиУведомлениеПользователю("Некорректная реализация метода " + СтруктураДанных.__object);
	ИначеЕсли ОбъектЗаполнения = Неопределено И НЕ Обязательный Тогда
		Возврат Ложь;	
	Иначе
		
		ТаблицаКлючейЗначений = КНП_ПолучитьСортированнуюТаблицуКлючейЗначений(СтруктураДанных);
		
		Для Каждого ЭлементСтруктуры Из ТаблицаКлючейЗначений Цикл
			
			Если Найти(ЭлементСтруктуры.Ключ, "__") Тогда
				Продолжить;
			КонецЕсли;
			
			Если ТипЗнч(ЭлементСтруктуры.Значение) = Тип("Структура") Тогда
				
				Если НЕ ФОД_ЗаполнитьСтруктуру(ЭлементСтруктуры.Значение, ВерсияЗаполнения, ОбъектЗаполнения, Обязательный, Документ) Тогда
					СтруктураДанных.Удалить(ЭлементСтруктуры.Ключ);	
				КонецЕсли;
				
			КонецЕсли;
			
			Если ТипЗнч(ЭлементСтруктуры.Значение) = Тип("Массив") Тогда
				ФОД_ЗаполнитьМассив(ЭлементСтруктуры.Значение, ВерсияЗаполнения, ОбъектЗаполнения);	
			КонецЕсли;
			
			Если ТипЗнч(ЭлементСтруктуры.Значение) = Тип("Строка") Тогда
				
				Если Найти(ЭлементСтруктуры.Значение, "()") Тогда
					
					Попытка
						
						ДобавитьВЖурнал("Вызов функции " + ЭлементСтруктуры.Значение + ". ОбъектЗаполнения = " + Строка(ОбъектЗаполнения), "ФОД_ЗаполнитьСтруктуру");
						
						Если ЭлементСтруктуры.Значение = "ФОД_ПолучитьКППКомпании()" ИЛИ ЭлементСтруктуры.Значение = "ФОД_ПолучитьТелефонКомпанииПеревозчика()" Тогда
							Выполнить("СтруктураДанных." + ЭлементСтруктуры.Ключ + " = КНП_Формат(" + СтрЗаменить(ЭлементСтруктуры.Значение, "()", "(ВерсияЗаполнения, ОбъектЗаполнения, Документ)") + ", ЭлементСтруктуры.Ключ)" );
						Иначе
							Выполнить("СтруктураДанных." + ЭлементСтруктуры.Ключ + " = КНП_Формат(" + СтрЗаменить(ЭлементСтруктуры.Значение, "()", "(ВерсияЗаполнения, ОбъектЗаполнения)") + ", ЭлементСтруктуры.Ключ)" );
						КонецЕсли;
						
						ДобавитьВЖурнал("Завершена работа функции " + ЭлементСтруктуры.Значение, "ФОД_ЗаполнитьСтруктуру");
						
					Исключение
						ВывестиУведомлениеПользователю("Ошибка при работе метода " + ЭлементСтруктуры.Значение);
					КонецПопытки;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если СтруктураДанных.Свойство("__object") Тогда
		СтруктураДанных.Удалить("__object");
	КонецЕсли;
	
	Если СтруктураДанных.Свойство("__version") Тогда
		СтруктураДанных.Удалить("__version");
	КонецЕсли;
	
	Если СтруктураДанных.Свойство("__required") Тогда
		СтруктураДанных.Удалить("__required");
	КонецЕсли;
	
	Для Каждого ЭлементСтруктуры Из СтруктураДанных Цикл
		
		Если ЗначениеЗаполнено(ЭлементСтруктуры.Значение) ИЛИ Обязательный Тогда
			
			ПризнакОтсутствияДанных = Ложь;
			Прервать;
			
		КонецЕсли;	
		
	КонецЦикла;
	
	ФОД_ПреобразоватьВсеВСтроку(СтруктураДанных);
	Возврат НЕ ПризнакОтсутствияДанных;

КонецФункции

// Процедура - Заполнить массив
//
// Параметры:
//  Массив			 - Массив	 - Массив элементов
//  ВерсияЗаполнения - Строка	 - Версия формата документа
//  ОбъектЗаполнения - ЛюбаяСсылка	 - Ссылка на справочник, документ или другой тип метаданных, который будет использоваться для получения значений
//
Процедура ФОД_ЗаполнитьМассив(Массив, ВерсияЗаполнения, Знач ОбъектЗаполнения)
	
	СтруктураТипаДанных = Неопределено;
	
	Если Массив.Количество() > 0 Тогда
		СтруктураТипаДанных = КНП_СкопироватьСтруктуру(Массив[0]);		
	КонецЕсли;
	
	Если СтруктураТипаДанных = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если СтруктураТипаДанных.Свойство("__object") Тогда 
		
		Попытка
			
			ДобавитьВЖурнал("Вызов функции " + СтруктураТипаДанных.__object + ". ОбъектЗаполнения = " + Строка(ОбъектЗаполнения), "ФОД_ЗаполнитьМассив");
			Выполнить("ОбъектЗаполнения = " + СтрЗаменить(СтруктураТипаДанных.__object, "()", "(ОбъектЗаполнения)") );
			ДобавитьВЖурнал("Завершена работа функции " + СтруктураТипаДанных.__object + ". Результат = " + ОбъектЗаполнения, "ФОД_ЗаполнитьМассив");
			
			Если ОбъектЗаполнения = Неопределено Тогда
				
				ВывестиУведомлениеПользователю("Некорректная реализация метода " + СтруктураТипаДанных.__object);
				Возврат;
				
			КонецЕсли;
			
		Исключение
			
			ДобавитьВЖурнал(ОписаниеОшибки(), "ФОД_ЗаполнитьМассив: " + СтруктураТипаДанных.__object);
			ВывестиУведомлениеПользователю("Ошибка при работе метода " + СтруктураТипаДанных.__object);
			Возврат;
			
		КонецПопытки;
		
	Иначе

		Если НЕ СтруктураТипаДанных.Свойство("measurementCode") И НЕ СтруктураТипаДанных.Свойство("trackings") Тогда
			ВывестиУведомлениеПользователю("Не определен тип объекта в массиве! Ошибка формата данных");
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	Массив.Очистить();
	
	Если ОбъектЗаполнения.Количество() = 0 Тогда
		ДобавитьВЖурнал("Не удалось заполнить массив в методе " + СтруктураТипаДанных.__object, "ФОД_ЗаполнитьМассив");
	КонецЕсли;
	
	//Для ОбъектЗаполнения должен быть доступен обход коллекции. Это может быть ТабличнаяЧасть, Массив объектов
	//+Гавриленков В. 25.02.2026 #UT10-5710
	//Для Каждого ЭлементДанных Из ОбъектЗаполнения Цикл
	//	
	//	СтруктураЭлементаМассива = КНП_СкопироватьСтруктуру(СтруктураТипаДанных);
	//	СтруктураЭлементаМассива.Удалить("__object");
	//	ФОД_ЗаполнитьСтруктуру(СтруктураЭлементаМассива, ВерсияЗаполнения, ЭлементДанных);
	//	ФОД_ПреобразоватьВсеВСтроку(СтруктураЭлементаМассива);
	//	Массив.Добавить(СтруктураЭлементаМассива);
	//	
	//КонецЦикла;
	сч = 0;
	МассивinfoFieldsБаза = Неопределено;
	Для Каждого ЭлементДанных Из ОбъектЗаполнения Цикл
		
		Если СтруктураТипаДанных.Свойство("infoFields") 
			//+Макрушин Е. 09.04.2026 #UT10-5800
			И ЗначениеЗаполнено(СтруктураТипаДанных.infoFields) Тогда
			//-Макрушин Е. 09.04.2026 #UT10-5800 
			 
			Если сч = 0 Тогда
				МассивinfoFieldsБаза = ОбщегоНазначенияКлиентСервер.СкопироватьМассив(СтруктураТипаДанных.infoFields);
			Иначе
				СтруктураТипаДанных.infoFields = ОбщегоНазначенияКлиентСервер.СкопироватьМассив(МассивinfoFieldsБаза);
			КонецЕсли;
			
		КонецЕсли;
		сч = сч + 1;
		
		СтруктураЭлементаМассива = КНП_СкопироватьСтруктуру(СтруктураТипаДанных);
		СтруктураЭлементаМассива.Удалить("__object");
		ФОД_ЗаполнитьСтруктуру(СтруктураЭлементаМассива, ВерсияЗаполнения, ЭлементДанных);
		ФОД_ПреобразоватьВсеВСтроку(СтруктураЭлементаМассива);
		Массив.Добавить(СтруктураЭлементаМассива);
		
	КонецЦикла;
	//-Гавриленков В. 25.02.2026 #UT10-5710

КонецПроцедуры

Процедура ФОД_ПреобразоватьВсеВСтроку(СтруктураДанных)  
	
	Для Каждого ЭлементДанных Из СтруктураДанных Цикл
		
		Если ТипЗнч(ЭлементДанных.Значение) = Тип("Строка") И Найти(ЭлементДанных.Значение, "()") Тогда
			Выполнить("СтруктураДанных." + ЭлементДанных.Ключ + " = """"");
		ИначеЕсли НЕ ФОД_ЭтоСтрогоЧисло(ЭлементДанных.Ключ) И ТипЗнч(ЭлементДанных.Значение) = Тип("Число") Тогда
			
			Если ФОД_ЭтоКонвертацияБезНулей(ЭлементДанных.Ключ) Тогда
				Выполнить("СтруктураДанных." + ЭлементДанных.Ключ + " = Строка(ЭлементДанных.Значение)");	
			Иначе
				Выполнить("СтруктураДанных." + ЭлементДанных.Ключ + " = КНП_ФорматСумм(ЭлементДанных.Значение)");
			КонецЕсли;
			
		КонецЕсли;	
		
	КонецЦикла;

КонецПроцедуры

Функция ФОД_ЭтоСтрогоЧисло(ИмяКлюча)
	
	Если 
		ИмяКлюча = "sender"
		ИЛИ
		ИмяКлюча = "seller"
		ИЛИ
		ИмяКлюча = "receiver"
		ИЛИ
		ИмяКлюча = "buyer"
		ИЛИ
		ИмяКлюча = "status"
		ИЛИ
		ИмяКлюча = "duty"
		ИЛИ
		ИмяКлюча = "executor"
		ИЛИ
		ИмяКлюча = "customer"
		ИЛИ
		ИмяКлюча = "from"
		ИЛИ
		ИмяКлюча = "to"  
		//+Белов А. 22.06.2026 #UT10-5921
		ИЛИ
		ИмяКлюча = "carrier"
		ИЛИ
		ИмяКлюча = "timeZone" 
		ИЛИ
		ИмяКлюча = "id"
		//-Белов А. 22.06.2026 #UT10-5921
		Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции

Функция ФОД_ЭтоКонвертацияБезНулей(ИмяКлюча)
	
	Если 
		ИмяКлюча = "regionCode"  
		//+Белов А. 22.06.2026 #UT10-5921
		ИЛИ
		ИмяКлюча = "placesCount"
		ИЛИ
		ИмяКлюча = "pointNumber"
		ИЛИ ИмяКлюча = "placesNumber"
		//-Белов А. 22.06.2026 #UT10-5921
		Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;	

КонецФункции


