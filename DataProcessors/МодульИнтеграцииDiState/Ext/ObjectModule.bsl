Функция РС_ПолучитьСписокОбъектовСИдентификаторами(ТипОбъектов = "Контрагент")
	
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст = МОП_ПолучитьТекстЗапросаСписокОбъектовСоСвойством(); 
	ПараметрИдентификатора = Неопределено;
	
	Если ТипОбъектов = "Контрагент" Тогда
		ПараметрИдентификатора = МОП_ПолучитьРеквизит("DS_Контрагент_ID");
	КонецЕсли;	
	
	Если ТипОбъектов = "Подразделение" Тогда
		ПараметрИдентификатора = МОП_ПолучитьРеквизит("DS_Подразделение_ID");
	КонецЕсли;	
	
	Запрос.УстановитьПараметр("Свойство", ПараметрИдентификатора);
	Результат = Запрос.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;

КонецФункции

Функция РС_ПодготовитьВложениеКНеформализованномуДокументу(ТабДок)
	
	Результат = "";
	
	Если ТипЗнч(ТабДок) = Тип("ТабличныйДокумент") Тогда
		
		СисИнфо = Новый СистемнаяИнформация;
		
		Если Строка(Метаданные.РежимСовместимости) = "Версия8_2_16" ИЛИ
			
			Строка(Метаданные.РежимСовместимости) = "Версия8_2_13" Тогда
			РежимСовместимости82 = Истина;
			
		Иначе
			РежимСовместимости82 = Ложь;
		КонецЕсли;
		
		Если Лев(СисИнфо.ВерсияПриложения, 3) = "8.2" ИЛИ РежимСовместимости82 Тогда
			
			ИмяВременногоФайла = ПолучитьИмяВременногоФайла("pdf");
			ТабДок.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.PDF);
			ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
			УдалитьФайлы(ИмяВременногоФайла);
			Результат = КНП_ОбработатьСтрокуBase64(Base64Строка(ДвоичныеДанные) );
			
		Иначе
			
			ПотокДанных = Неопределено;
			Выполнить("ПотокДанных = Новый ПотокВПамяти;");
			ТабДок.Записать(ПотокДанных, ТипФайлаТабличногоДокумента.PDF);
			ДвоичныеДанные = ПотокДанных.ЗакрытьИПолучитьДвоичныеДанные();
			Результат = КНП_ОбработатьСтрокуBase64(Base64Строка(ДвоичныеДанные) );
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Процедура РС_СоздатьДокумент(СтрокаТЧ) 	
	
	ЭтоУПД = Ложь;
	
	Если ЗначениеЗаполнено(СтрокаТЧ.Ссылка) Тогда
		
		ОбъектТЧ = СтрокаТЧ.Ссылка.ПолучитьОбъект();
		ОбъектТЧ.ПометкаУдаления = Истина;
		РС_ПривязатьИдентификаторКОбъекту1С(СтрокаТЧ.Ссылка);
		
		Попытка
			ОбъектТЧ.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Исключение
			ОбъектТЧ.Записать(РежимЗаписиДокумента.Запись);
		КонецПопытки;
		
		СтрокаТЧ.Ссылка = Неопределено;
		
	КонецЕсли;
	
	ОбъектДанных = РС_ПрочитатьОбъектДанныхИзXML(СтрокаТЧ, ЭтоУПД);
	
	Если ОбъектДанных = Неопределено Тогда
		
		СтрокаТЧ.ОписаниеОшибки = "Не удалось создать документ - не удалось прочитать XML";
		ДобавитьВЖурнал("Текст XML-файла: " + СтрокаТЧ.ДанныеДокумента, "СоздатьДокументВ1С");
		Возврат;
		
	КонецЕсли;
	
	ТипДокумента = КНП_БезопасноПрочитатьЗначение(ОбъектДанных, "ТипУПД");
	
	Если ТипДокумента = Неопределено Тогда
		ТипДокумента = "ДОП";
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если СтрокаТЧ.Тип = "Счет на оплату" Тогда
		РезультатСоздания = РС_СформироватьОбъектСчетНаОплату(ОбъектДанных, СтрокаТЧ.Контрагент);	
	ИначеЕсли СтрокаТЧ.Тип = "Акт" Тогда
		РезультатСоздания = РС_СформироватьОбъектАктВыполненныхРабот(ОбъектДанных, СтрокаТЧ.Контрагент);
	ИначеЕсли СтрокаТЧ.Тип = "Накладная" Тогда
		РезультатСоздания = РС_СформироватьОбъектНакладная(ОбъектДанных, СтрокаТЧ.Контрагент);
	ИначеЕсли Найти(СтрокаТЧ.Тип, "Универсальный передаточный документ") ИЛИ Найти(СтрокаТЧ.Тип, "УПД") Тогда
		
		Если ЗагрузкаНоменклатурыКакУслуга Тогда
			РезультатСоздания = РС_СформироватьОбъектАктВыполненныхРабот(ОбъектДанных, СтрокаТЧ.Контрагент, ?(ТипДокумента = "ДОП", Ложь, Истина));	
		Иначе
			РезультатСоздания = РС_СформироватьОбъектНакладная(ОбъектДанных, СтрокаТЧ.Контрагент, ?(ТипДокумента = "ДОП", Ложь, Истина) );
		КонецЕсли;
		
	ИначеЕсли Найти(СтрокаТЧ.Тип, "Универсальный корректировочный документ") Тогда
		РезультатСоздания = РС_СформироватьОбъектКорректировка(ОбъектДанных, СтрокаТЧ.Контрагент, Истина);
	ИначеЕсли Найти(СтрокаТЧ.Тип, "Счет-фактура") Тогда
		
		Если Найти(НРег(СтрокаТЧ.Тип), "корректир") И КНП_ЕстьОбъектМетаданных("КорректировочныйСчетФактураПолученный") Тогда
			РезультатСоздания = РС_СформироватьКСФПолученную(ОбъектДанных, СтрокаТЧ.Контрагент);	
		Иначе
			
			Если СоздаватьПоступлениеПоСчетФактуре Тогда
				
				Если ЗагрузкаНоменклатурыКакУслуга Тогда
					РезультатСоздания = РС_СформироватьОбъектАктВыполненныхРабот(ОбъектДанных, СтрокаТЧ.Контрагент, Истина, Истина);
				Иначе
					РезультатСоздания = РС_СформироватьОбъектНакладная(ОбъектДанных, СтрокаТЧ.Контрагент, Истина, Истина);
				КонецЕсли;
				
			Иначе
				РезультатСоздания = РС_СформироватьСФПолученнуюБезНакладной(ОбъектДанных, СтрокаТЧ.Контрагент);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если РезультатСоздания <> Неопределено Тогда
		
		Если ТипЗнч(РезультатСоздания) = Тип("Строка") Тогда
			СтрокаТЧ.ОписаниеОшибки = РезультатСоздания;	
		ИначеЕсли ТипЗнч(РезультатСоздания) = Тип("Массив") Тогда
			
			Для Каждого ДокОбъект Из РезультатСоздания Цикл
				
				Попытка
					
					Если НЕ ЗначениеЗаполнено(ДокОбъект.Ссылка) Тогда
						ДокОбъект.Записать();
					КонецЕсли;
					
					Если СтрокаТЧ.Ссылка = Неопределено Тогда
						
						Если СоздаватьПоступлениеПоСчетФактуре Тогда
							
							Если (ТипДокумента = "СЧФ" ИЛИ ТипДокумента = "КСЧФ") И МОП_ЭтоСчетФактураПоставщика(ДокОбъект.Ссылка) Тогда
								Продолжить;
							КонецЕсли;
							
						КонецЕсли;
						
						СтрокаТЧ.Ссылка = ДокОбъект.Ссылка;
						РС_ПривязатьИдентификаторКОбъекту1С(СтрокаТЧ.Ссылка, СтрокаТЧ.ИдентификаторДокумента,,ЭтоУПД);
						
					КонецЕсли;
					
				Исключение
					
					ДобавитьВЖурнал(ОписаниеОшибки(), "СоздатьДокументВ1С");	
					СтрокаТЧ.ОписаниеОшибки = ОписаниеОшибки();
					
				КонецПопытки;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;	
	
	УстановитьПривилегированныйРежим(Ложь)

КонецПроцедуры

Функция РС_ПрочитатьОбъектДанныхИзXML(СтрокаТЧ, ЭтоУПД = Ложь)
	
	Попытка
		
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.ДанныеДокумента) Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ОбъектXML = Новый ЧтениеXML;
		
		Если Найти(СтрокаТЧ.ДанныеДокумента, "<?xml") Тогда
			ОбъектXML.УстановитьСтроку(СтрокаТЧ.ДанныеДокумента);
		Иначе
			Возврат Неопределено;
		КонецЕсли;
		
	Исключение	
		
		ДобавитьВЖурнал(ОписаниеОшибки(), "СоздатьДокументВ1С");
		Возврат Неопределено;
		
	КонецПопытки;
	
	Если Найти(СтрокаТЧ.Тип, "Счет на оплату") Тогда
		СтруктураДокумента = ПФ_ПолучитьСтруктуруПФСчетНаОплатуПокупателю()
	ИначеЕсли СтрокаТЧ.Тип = "Счет-фактура" Тогда
		СтруктураДокумента = ПФ_ПолучитьСтруктуруПФУПДПродавца();
	ИначеЕсли Найти(НРег(СтрокаТЧ.Тип), "накладная") ИЛИ Найти(ВРег(СтрокаТЧ.Тип), "ТОРГ") Тогда
		СтруктураДокумента = ПФ_ПолучитьСтруктуруПФНакладнойПродавца();
	ИначеЕсли Найти(НРег(СтрокаТЧ.Тип), "акт") Тогда
		СтруктураДокумента = ПФ_ПолучитьСтруктуруПФАктаИсполнителя();
	ИначеЕсли Найти(СтрокаТЧ.Тип, "передат") ИЛИ СтрокаТЧ.Тип = "УПД" ИЛИ Найти(СтрокаТЧ.Тип, "УПД ФНС 820") Тогда  //УПД
		
		СтруктураДокумента = ПФ_ПолучитьСтруктуруПФУПДПродавца();
		ЭтоУПД = Истина;
		
	ИначеЕсли Найти(НРег(СтрокаТЧ.Тип), "корректир") Тогда //УКД
		
		СтруктураДокумента = ПФ_ПолучитьСтруктуруПФУКДПродавца();
		ЭтоУПД = Истина;
		
	Иначе
		СтруктураДокумента = Новый Структура;
	КонецЕсли;
	
	Возврат ПФ_ПолучитьСтруктуруДанныхИзXML(ОбъектXML, СтруктураДокумента);
	
КонецФункции

//Обновление версии 2.3.3. Сопоставление номенклатур

Функция РС_НайтиНесопоставленнуюНоменклатуру(СтрокаТЧ)
	
	УстановитьПривилегированныйРежим(Истина);
	МассивСтруктурДанных = Новый Массив;	
	ОбъектДанных = РС_ПрочитатьОбъектДанныхИзXML(СтрокаТЧ);
	
	Если ОбъектДанных = Неопределено Тогда
		
		СтрокаТЧ.ОписаниеОшибки = "Не удалось создать документ - не удалось прочитать XML";
		ДобавитьВЖурнал("Текст XML-файла: " + СтрокаТЧ.ДанныеДокумента, "СоздатьДокументВ1С");
		УстановитьПривилегированныйРежим(Ложь);
		Возврат МассивСтруктурДанных;
		
	КонецЕсли;
	
	Если ОбъектДанных.Свойство("ТабличнаяЧасть") Тогда
		
		ТаблицаСопоставления = РС_ПолучитьТаблицуСопоставленийНоменклатур();
		
		Для Каждого СтрокаТД Из ОбъектДанных.ТабличнаяЧасть Цикл
			
			СтруктураДанных = Новый Структура("Поставщик,ВнешняяНоменклатура", СтрокаТЧ.Контрагент, СтрокаТД.Товар);
			СтрокиТС = ТаблицаСопоставления.НайтиСтроки(СтруктураДанных);
			
			Если СтрокиТС.Количество() = 0 Тогда
				МассивСтруктурДанных.Добавить(СтруктураДанных);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат МассивСтруктурДанных;

КонецФункции

Функция РС_НайтиНоменклатуру(ИмяВнешнейНоменклатуры, Поставщик)
	
	ТаблицаСопоставлений = РС_ПолучитьТаблицуСопоставленийНоменклатур();
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ВнешняяНоменклатура", ИмяВнешнейНоменклатуры);
	СтруктураПоиска.Вставить("Поставщик", Поставщик);
	СтрокиТЧ = ТаблицаСопоставлений.НайтиСтроки(СтруктураПоиска);
	
	Если СтрокиТЧ.Количество() > 0 Тогда
		Возврат СтрокиТЧ[0].Номенклатура;
	КонецЕсли;
	
	Возврат Справочники.Номенклатура.НайтиПоНаименованию(ИмяВнешнейНоменклатуры);

КонецФункции

Функция РС_ПолучитьТаблицуСопоставленийНоменклатур()
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура") );
	Результат.Колонки.Добавить("Поставщик", Новый ОписаниеТипов("СправочникСсылка.Контрагенты") );
	Результат.Колонки.Добавить("ВнешняяНоменклатура", Новый ОписаниеТипов("Строка") );
	
	ПараметрИдентификатора = МОП_ПолучитьРеквизит("DS_СопоставлениеНоменклатур");
	НаборЗаписейЗначенияСвойств = МОП_ПолучитьНовыйНаборЗаписейДопСведений();
	НаборЗаписейЗначенияСвойств.Отбор.Свойство.Установить(ПараметрИдентификатора);
	НаборЗаписейЗначенияСвойств.Отбор.Объект.Установить(Организация);
	НаборЗаписейЗначенияСвойств.Прочитать();
	
	Если НаборЗаписейЗначенияСвойств.Количество() > 0 Тогда
		
		Запись = НаборЗаписейЗначенияСвойств[0];
		СтрокаДанных = Запись.Значение.ПолноеНаименование;
		
		Если ЗначениеЗаполнено(СтрокаДанных) Тогда
			
			МассивСтрокДанных = КНП_РазобратьСтрокуВМассивСтруктур(СтрокаДанных);
			
			Для Каждого СтрокаМассива Из МассивСтрокДанных Цикл
				
				СтрокаТаблицы = Результат.Добавить();
				УИДНоменклатура = Неопределено;
				УИДПоставщик = Неопределено;
				
				Если СтрокаМассива.Свойство("Номенклатура", УИДНоменклатура) Тогда
					
					Попытка
						СтрокаМассива.Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(УИДНоменклатура) );
					Исключение
						
						ЗаписьЖурналаРегистрации("Ошибка в распознавании номенклатуры", УровеньЖурналаРегистрации.Ошибка, , "УИД " + УИДНоменклатура);	
						СтрокаМассива.Номенклатура = Неопределено;
						
					КонецПопытки;
					
				КонецЕсли;
				
				Если СтрокаМассива.Свойство("Поставщик", УИДПоставщик) Тогда
					
					Попытка
						СтрокаМассива.Поставщик = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(УИДПоставщик) );
					Исключение
						
						ЗаписьЖурналаРегистрации("Ошибка в распознавании номенклатуры", УровеньЖурналаРегистрации.Ошибка, , "УИД " + УИДПоставщик);	
						СтрокаМассива.Поставщик = Неопределено;
						
					КонецПопытки;
					
				КонецЕсли;
				
				ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтрокаМассива);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

Функция РС_ЗаписатьТаблицуСопоставленийНоменклатур(ТаблицаДанных)
	
	Результат = Ложь;
	СтрокаДанных = "";
	
	Для Каждого СтрокаТЧ Из ТаблицаДанных Цикл
		
		Если СтрокаДанных <> "" Тогда
			СтрокаДанных = СтрокаДанных + ";";
		КонецЕсли;
		
		СтрокаДанных = СтрокаДанных + "Номенклатура=" + Строка(СтрокаТЧ.Номенклатура.УникальныйИдентификатор() );
		СтрокаДанных = СтрокаДанных + ",ВнешняяНоменклатура=" + СтрокаТЧ.ВнешняяНоменклатура + "";
		СтрокаДанных = СтрокаДанных + ",Поставщик=" + Строка(СтрокаТЧ.Поставщик.УникальныйИдентификатор() ); 
		
	КонецЦикла;
	
	Попытка
		
		ПараметрИдентификатора = МОП_ПолучитьРеквизит("DS_СопоставлениеНоменклатур");
		НаборЗаписейЗначенияСвойств = МОП_ПолучитьНовыйНаборЗаписейДопСведений();
		НаборЗаписейЗначенияСвойств.Отбор.Свойство.Установить(ПараметрИдентификатора);
		НаборЗаписейЗначенияСвойств.Прочитать();
		ЗначениеСвойства = Неопределено;
		
		Если НаборЗаписейЗначенияСвойств.Количество() = 0 Тогда
			
			Запись = НаборЗаписейЗначенияСвойств.Добавить();
			ЗначениеСвойства = Справочники.ЗначенияСвойствОбъектов.СоздатьЭлемент();
			ЗначениеСвойства.Наименование = "ХранилищеСопоставления";
			ЗначениеСвойства.ПолноеНаименование = "";
			ЗначениеСвойства.Владелец = ПараметрИдентификатора; 
			
		Иначе
			
			Запись = НаборЗаписейЗначенияСвойств[0];
			ЗначениеСвойства = Запись.Значение.ПолучитьОбъект();
			
		КонецЕсли; 
		
		ЗначениеСвойства.ПолноеНаименование = СтрокаДанных;
		ЗначениеСвойства.Записать();
		Запись.Объект 	= Организация;
		Запись.Свойство = ПараметрИдентификатора;
		Запись.Значение = ЗначениеСвойства.Ссылка;
		НаборЗаписейЗначенияСвойств.Записать();
		Результат = Истина;
		
	Исключение
		ДобавитьВЖурнал("Возникла ошибка " + ОписаниеОшибки(), "РС_ЗаписатьТаблицуСопоставленийНоменклатур");
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции


//Обновление версии 2.3.4. Сопоставление статей расходов

Функция РС_НайтиНесопоставленныеСтатьиРасходов(СтрокаТЧ)
	
	УстановитьПривилегированныйРежим(Истина);
	МассивСтруктурДанных = Новый Массив;	
	ОбъектДанных = РС_ПрочитатьОбъектДанныхИзXML(СтрокаТЧ);
	
	Если ОбъектДанных = Неопределено Тогда
		
		СтрокаТЧ.ОписаниеОшибки = "Не удалось создать документ - не удалось прочитать XML";
		ДобавитьВЖурнал("Текст XML-файла: " + СтрокаТЧ.ДанныеДокумента, "СоздатьДокументВ1С");
		УстановитьПривилегированныйРежим(Ложь);
		Возврат МассивСтруктурДанных;
		
	КонецЕсли;
	
	Если ОбъектДанных.Свойство("ТабличнаяЧасть") Тогда
		
		Для Каждого СтрокаТД Из ОбъектДанных.ТабличнаяЧасть Цикл
			
			СтатьяРасходов = РС_ПолучитьСтатьюРасходов(СтрокаТЧ.Контрагент, СтрокаТД.Товар);
			
			Если СтатьяРасходов = Неопределено Тогда
				
				СтруктураДанных = Новый Структура("Поставщик,ВнешняяНоменклатура,СтатьяРасходов", СтрокаТЧ.Контрагент, СтрокаТД.Товар, Неопределено);
				МассивСтруктурДанных.Добавить(СтруктураДанных);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	Возврат МассивСтруктурДанных;	

КонецФункции

Функция РС_ПолучитьТаблицуСопоставленийСтатейРасходов()
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Поставщик", Новый ОписаниеТипов("СправочникСсылка.Контрагенты") );
	Результат.Колонки.Добавить("СтрокаПоиска", Новый ОписаниеТипов("Строка") );
	Результат.Колонки.Добавить("СтатьяРасходов", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.СтатьиРасходов") );
	
	ПараметрИдентификатора = МОП_ПолучитьРеквизит("DS_СопоставлениеСтатейРасходов");
	НаборЗаписейЗначенияСвойств = МОП_ПолучитьНовыйНаборЗаписейДопСведений();
	НаборЗаписейЗначенияСвойств.Отбор.Свойство.Установить(ПараметрИдентификатора);
	НаборЗаписейЗначенияСвойств.Отбор.Объект.Установить(Организация);
	НаборЗаписейЗначенияСвойств.Прочитать();
	
	Если НаборЗаписейЗначенияСвойств.Количество() > 0 Тогда
		
		Запись = НаборЗаписейЗначенияСвойств[0];
		СтрокаДанных = Запись.Значение.ПолноеНаименование;
		
		Если ЗначениеЗаполнено(СтрокаДанных) Тогда
			
			МассивСтрокДанных = КНП_РазобратьСтрокуВМассивСтруктур(СтрокаДанных);
			
			Для Каждого СтрокаМассива Из МассивСтрокДанных Цикл
				
				СтрокаТаблицы = Результат.Добавить();
				УИДПоставщик = Неопределено;
				УИДСтатьяРасходов = Неопределено;
				
				Если СтрокаМассива.Свойство("Поставщик", УИДПоставщик) Тогда
					
					Попытка
						СтрокаМассива.Поставщик = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(УИДПоставщик) );
					Исключение
						
						ЗаписьЖурналаРегистрации("Ошибка в распознавании контрагента", УровеньЖурналаРегистрации.Ошибка, , "УИД " + УИДПоставщик);	
						СтрокаМассива.Номенклатура = Неопределено;
						
					КонецПопытки;
					
				КонецЕсли;
				
				Если СтрокаМассива.Свойство("СтатьяРасходов", УИДСтатьяРасходов) Тогда
					
					Попытка
						СтрокаМассива.СтатьяРасходов = ПланыВидовХарактеристик.СтатьиРасходов.ПолучитьСсылку(Новый УникальныйИдентификатор(УИДСтатьяРасходов) );
					Исключение
						
						ЗаписьЖурналаРегистрации("Ошибка в распознавании подразделения", УровеньЖурналаРегистрации.Ошибка, , "УИД " + УИДСтатьяРасходов);	
						СтрокаМассива.СтатьяРасходов = Неопределено;
						
					КонецПопытки;
					
				КонецЕсли;
				
				ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтрокаМассива);			
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

Функция РС_ЗаписатьТаблицуСопоставленийСтатейРасходов(ТаблицаДанных)
	
	Результат = Ложь;
	СтрокаДанных = "";
	
	Для Каждого СтрокаТЧ Из ТаблицаДанных Цикл
		
		Если СтрокаДанных <> "" Тогда
			СтрокаДанных = СтрокаДанных + ";";
		КонецЕсли;
		
		СтрокаДанных = СтрокаДанных + "Поставщик=" + Строка(СтрокаТЧ.Поставщик.УникальныйИдентификатор() );
		СтрокаДанных = СтрокаДанных + ",СтрокаПоиска=" + СтрокаТЧ.СтрокаПоиска + "";
		СтрокаДанных = СтрокаДанных + ",СтатьяРасходов=" + Строка(СтрокаТЧ.СтатьяРасходов.УникальныйИдентификатор() ); 
		
	КонецЦикла;
	
	Попытка
		
		ПараметрИдентификатора = МОП_ПолучитьРеквизит("DS_СопоставлениеСтатейРасходов");
		НаборЗаписейЗначенияСвойств = МОП_ПолучитьНовыйНаборЗаписейДопСведений();
		НаборЗаписейЗначенияСвойств.Отбор.Свойство.Установить(ПараметрИдентификатора);
		НаборЗаписейЗначенияСвойств.Прочитать();
		ЗначениеСвойства = Неопределено;
		
		Если НаборЗаписейЗначенияСвойств.Количество() = 0 Тогда
			
			Запись = НаборЗаписейЗначенияСвойств.Добавить();
			ЗначениеСвойства = Справочники.ЗначенияСвойствОбъектов.СоздатьЭлемент();
			ЗначениеСвойства.Наименование = "ХранилищеСопоставления";
			ЗначениеСвойства.ПолноеНаименование = "";
			ЗначениеСвойства.Владелец = ПараметрИдентификатора; 
			
		Иначе
			
			Запись = НаборЗаписейЗначенияСвойств[0];
			ЗначениеСвойства = Запись.Значение.ПолучитьОбъект();
			
		КонецЕсли; 
		
		ЗначениеСвойства.ПолноеНаименование = СтрокаДанных;
		ЗначениеСвойства.Записать();
		Запись.Объект 	= Организация;
		Запись.Свойство = ПараметрИдентификатора;
		Запись.Значение = ЗначениеСвойства.Ссылка;
		НаборЗаписейЗначенияСвойств.Записать();
		Результат = Истина;
		
	Исключение
		ДобавитьВЖурнал("Возникла ошибка " + ОписаниеОшибки(), "РС_ЗаписатьТаблицуСопоставленийСтатейРасходов");
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция РС_ПолучитьСтатьюРасходов(Поставщик, НоменклатураСтрока)
	
	ТаблицаСопоставлений = РС_ПолучитьТаблицуСопоставленийСтатейРасходов();
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("Поставщик", Поставщик);
	СтрокиТЧ = ТаблицаСопоставлений.НайтиСтроки(СтруктураПоиска);
	
	Для Каждого СтрокаТЧ Из СтрокиТЧ Цикл
		
		Если Найти(НоменклатураСтрока, СтрокаТЧ.СтрокаПоиска) Тогда
			Возврат СтрокаТЧ.СтатьяРасходов;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Неопределено;	

КонецФункции



//==Специфичная область

Процедура РС_УстановитьИдентификаторДиадок(Объект,Идентификатор = Неопределено, Знач Переписывать = Ложь, Знач СвязанныеДокументы = Ложь)
	
	//ДобавитьВЖурнал("Вход в процедуру", "РС_УстановитьИдентификаторДиадок");
	ПараметрИдентификатора = МОП_ПолучитьРеквизит("ИдентификаторДокументаВДиадок");
	
	Если НЕ ЗначениеЗаполнено(ПараметрИдентификатора) Тогда
		Возврат;
	КонецЕсли;  
	
	НаборЗаписейЗначенияСвойств = МОП_ПолучитьНовыйНаборЗаписейДопСведений();
	НаборЗаписейЗначенияСвойств.Отбор.Объект.Установить(Объект.Ссылка);
	НаборЗаписейЗначенияСвойств.Отбор.Свойство.Установить(ПараметрИдентификатора);
	НаборЗаписейЗначенияСвойств.Прочитать();
	
	Если НаборЗаписейЗначенияСвойств.Количество() = 0 Тогда
		
		Запись = НаборЗаписейЗначенияСвойств.Добавить();
		Переписывать = Истина;
		
	Иначе
		Запись = НаборЗаписейЗначенияСвойств[0];
	КонецЕсли; 
	
	Если Переписывать Тогда
		
		Запись.Объект = Объект;
		Запись.Свойство = ПараметрИдентификатора;
		Запись.Значение = Идентификатор;
		НаборЗаписейЗначенияСвойств.Записать();
		
		//ДобавитьВЖурнал("Привязка " + Строка(Объект) + " с идентификатором " + Идентификатор, "УстановитьИдентификаторДиадок");
		//Если счет-фактура - то нужно сделать привязку и для первичного документа
		Если (МОП_ЭтоСчетФактура(Объект) ИЛИ МОП_ЭтоСчетФактураПоставщика(Объект) ) И СвязанныеДокументы Тогда
			
			ДокОснование = МОП_ПолучитьОснованиеДокумента(Объект);
			
			Если ЗначениеЗаполнено(ДокОснование) Тогда
				РС_УстановитьИдентификаторДиадок(ДокОснование, Идентификатор, Переписывать);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;		

КонецПроцедуры

