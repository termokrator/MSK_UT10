Функция ФОД_ПолучитьГруз(Знач ОбъектЗаполнения)
//+Белов А. 17.06.2026 #UT10-5921

	СтруктураГруза = Новый Структура("КоличествоГрузомест, ВесБрутто, СтоимостьГруза, ОбъемГрузомест", 1, 10, 0, 1);  
	
	МассивВозврата = Новый Массив;
	
	Если ТипЗнч(ОбъектЗаполнения) = Тип("ДокументСсылка.ТранспортнаяНакладная") Тогда
		
		МассивДокументов = ОбъектЗаполнения.ДокументыОснования.ВыгрузитьКолонку("ДокументОснование");
				
		СтруктураГруза.КоличествоГрузомест = ПолучитьКоличествоМестПоДокументамОснованияИзЗаданияНаДоставку(МассивДокументов, ОбъектЗаполнения.ЗаданиеНаДоставку);			
		СтруктураГруза.СтоимостьГруза = ПолучитьСтоимостьГрузаПоДокументамОснования(МассивДокументов);	
		СтруктураГруза.ВесБрутто = ПолучитьВесПоДокументамОснования(МассивДокументов); 
				
	ИначеЕсли ТипЗнч(ОбъектЗаполнения) = Тип("ДокументСсылка.ЗаказЗаявка") Тогда
		
		Если ЗначениеЗаполнено(ОбъектЗаполнения.ЗаданиеНаДоставку) Тогда
			
			МассивДокументов = Документы.ЗаданиеНаДоставку.ПолучитьМассивРеализацийДляОтправкиВЭДО(ОбъектЗаполнения.ЗаданиеНаДоставку);
			
			СтруктураГруза.КоличествоГрузомест = ПолучитьКоличествоМестПоДокументамОснованияИзЗаданияНаДоставку(МассивДокументов, ОбъектЗаполнения.ЗаданиеНаДоставку);				
			СтруктураГруза.ВесБрутто = ПолучитьВесПоДокументамОснования(МассивДокументов); 
			СтруктураГруза.ОбъемГрузомест = ПолучитьОбъемПоДокументамОснования(МассивДокументов);      
			
		Иначе
			//+Белов А. 02.09.2026 #UT10-6021
			
			СтруктураГруза.КоличествоГрузомест = ОбъектЗаполнения.КоличествоГрузомест;				
			СтруктураГруза.ВесБрутто = ОбъектЗаполнения.ВесГруза; 
			СтруктураГруза.ОбъемГрузомест = ОбъектЗаполнения.ОбъемГруза;    
			
			//-Белов А. 02.09.2026 #UT10-6021
		КонецЕсли;   
		
		СтруктураГруза.Вставить("Длина", 1); 
		СтруктураГруза.Вставить("Ширина", 1);
		СтруктураГруза.Вставить("Высота", 1); 		
		
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(СтруктураГруза.ОбъемГрузомест) Тогда
		СтруктураГруза.ОбъемГрузомест = 1;
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(СтруктураГруза.ВесБрутто) Тогда
		СтруктураГруза.ВесБрутто = 10;
	КонецЕсли;

	МассивВозврата.Добавить(СтруктураГруза);
	
	Возврат МассивВозврата;
		
//-Белов А. 17.06.2026 #UT10-5921
КонецФункции   


Функция ПолучитьВесПоДокументамОснования(МассивДокументов) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СУММА(РеализацияТоваровУслугТовары.ЕдиницаИзмерения.Вес * РеализацияТоваровУслугТовары.Количество) КАК Вес
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|ГДЕ
	|	РеализацияТоваровУслугТовары.Ссылка В(&МассивДокументов)";
	
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);  
	
	Выборка = Запрос.Выполнить().Выбрать();    
	
	Если Выборка.Следующий() Тогда
		
		Если Выборка.Вес <> NULL Тогда
			Возврат Окр(Выборка.Вес, 2, 1);	
		КонецЕсли;
		
	КонецЕсли; 
	
	Возврат 10;
		
КонецФункции 

