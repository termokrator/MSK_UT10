Функция ФОД_ПолучитьСведенияОПередачеТоваров(Знач ОбъектЗаполнения)
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("Договор", ФОД_ПолучитьДоговорПоНакладной(ОбъектЗаполнения));
	СтруктураДанных.Вставить("Дата", "");
	СтруктураДанных.Вставить("СодержаниеОперации", "");	
	Возврат СтруктураДанных;

КонецФункции

Функция ФОД_ПолучитьДоговорПоНакладной(Знач ОбъектЗаполнения)
	//Changelog
	//
	//18.10.2019 - добавлена пустышка договора
	//12.12.2019 - часть функции вынесена в отдельную функцию
	
	Если ВеткаРазработки = "ТЭК-Торг" Тогда
		Возврат Новый Структура("Наименование,Дата,Номер", "Без документа-основания", Дата(2000,1,1), "-");	
	КонецЕсли;
	
	Если ТипЗнч(ОбъектЗаполнения) = Тип("Структура") Тогда
		
		Если ОбъектЗаполнения.Свойство("Договор") Тогда
			Возврат ОбъектЗаполнения.Договор;	
		КонецЕсли;
		
	Иначе
		
		Договор = МОП_ПолучитьДоговорПоДокументу(ОбъектЗаполнения);
		
		Если ЗначениеЗаполнено(Договор) Тогда
			Возврат Договор;
		КонецЕсли;
		
		Если МОП_ЭтоПлатежка(ОбъектЗаполнения) Тогда
			
			ВходящаяДата = ?(КНП_ЕстьРеквизит(ОбъектЗаполнения, "ДатаВходящегоДокумента"), ОбъектЗаполнения.ДатаВходящегоДокумента, ОбъектЗаполнения.Дата);
			ВходящийНомер = ?(КНП_ЕстьРеквизит(ОбъектЗаполнения, "НомерВходящегоДокумента"), ОбъектЗаполнения.НомерВходящегоДокумента, ОбъектЗаполнения.Номер);
			Возврат Новый Структура("Наименование,Дата,Номер", "Платежный документ", ВходящаяДата, ВходящийНомер);	
			
		КонецЕсли;
		
		Если МОП_ЭтоСчетФактура(ОбъектЗаполнения) Тогда
			
			ОснованиеОбъектаЗаполнения = МОП_ПолучитьОснованиеДокумента(ОбъектЗаполнения);
			
			Если ЗначениеЗаполнено(ОснованиеОбъектаЗаполнения) Тогда
				Возврат ФОД_ПолучитьДоговорПоНакладной(ОснованиеОбъектаЗаполнения);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Новый Структура("Наименование,Дата,Номер", "Без договора", Дата(2000,1,1), "-");

КонецФункции

