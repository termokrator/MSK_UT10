Функция МОП_ЭтоРеализацияТоваров(СсылкаНаДокумент)
	
	Результат = Ложь;
	
	Если СсылкаНаДокумент.Метаданные().Имя = "РеализацияТоваровУслуг" Тогда
		
		Если КНП_ЕстьТабЧасть(СсылкаНаДокумент, "Услуги") Тогда
			
			//+Гавриленков В. 15.11.2024 #UT10-4901 И -> ИЛИ
			Если СсылкаНаДокумент.Товары.Количество() > 0 ИЛИ СсылкаНаДокумент.Услуги.Количество() = 0 Тогда
				Результат = Истина;
			КонецЕсли;
			
		Иначе
			Результат = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Если СсылкаНаДокумент.Метаданные().Имя = "РасходнаяНакладная" Тогда
		Результат = Истина;
	КонецЕсли;
	
	Если СсылкаНаДокумент.Метаданные().Имя = "НакладнаяНаРеализациюТорг12" Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция МОП_ЭтоАктВыполненныхРабот(СсылкаНаДокумент)
	
	Результат = Ложь;
	
	Если СсылкаНаДокумент.Метаданные().Имя = "РеализацияТоваровУслуг" Тогда
		
		Если КНП_ЕстьТабЧасть(СсылкаНаДокумент, "Услуги") И КНП_ЕстьТабЧасть(СсылкаНаДокумент, "Товары") Тогда
			
			Если СсылкаНаДокумент.Товары.Количество() = 0 И СсылкаНаДокумент.Услуги.Количество() > 0 Тогда
				Результат = Истина;
			КонецЕсли;
			
		Иначе
			Результат = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Если СсылкаНаДокумент.Метаданные().Имя = "АктВыполненныхРабот" Тогда
		Результат = Истина;
	КонецЕсли;
	
	Если СсылкаНаДокумент.Метаданные().Имя = "РеализацияУслугПрочихАктивов" Тогда
		Результат = Истина;
	КонецЕсли;
	
	Если СсылкаНаДокумент.Метаданные().Имя = "АктОбОказанииУслуг" Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

