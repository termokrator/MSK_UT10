Функция jsonЗаписатьСсылку(Значение, Стандарт, ПредставленияСсылок, ВспомогательныеДанные, Перечисление, Смещение, Отступ, Табуляция, ПереносСтроки, 
	             ПолноеМаскированиеСимволов, МаскированиеКириллицы)
	
	// Идентификатор.
	Если Стандарт Тогда 
		
		Если Перечисление Тогда 
			
			Идентификатор = Лев(Прав(ЗначениеВСтрокуВнутр(Значение), 33), 32); 
			Идентификатор = Прав(Идентификатор, 8) + "-" + Сред(Идентификатор, 21, 4) + "-" + Сред(Идентификатор, 17, 4) + "-" + Лев(Идентификатор, 4) 
			     + "-" + Сред(Идентификатор, 5, 12); 
			
		Иначе 
			Идентификатор = XMLСтрока(Значение); 
		КонецЕсли;
	Иначе 
		
		Идентификатор = ЗначениеВСтрокуВнутр(Значение); 
		Идентификатор = "¦ref¦" + СтрЗаменить(СтрЗаменить(Сред(Идентификатор, 6, СтрДлина(Идентификатор) - 6), ":", "×"), ",", "÷") + "¦";
		
	КонецЕсли;
	
	// Включая представление ссылки.
	Если ПредставленияСсылок Тогда 
		Возврат jsonЗаписать(Новый Структура("Ссылка,Представление", Идентификатор, Строка(Значение)), Стандарт, ПредставленияСсылок, ВспомогательныеДанные,
		     Неопределено, Смещение, Отступ, Табуляция, ПереносСтроки, ПолноеМаскированиеСимволов, МаскированиеКириллицы); 
	КонецЕсли;
	
	// Ссылка.
	Возврат """" + Идентификатор + """";
	
КонецФункции // jsonЗаписатьСсылку()

