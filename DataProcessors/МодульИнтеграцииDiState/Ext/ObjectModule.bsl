// Получить структуру платежного документа (метаданно-ориентированный метод)
//
// Параметры:
//  СсылкаНаДокумент - ДокументСсылка	 - 
// 
// Возвращаемое значение:
// Структура  - Структура с полями number и date
//
Функция МОП_ПолучитьСтруктуруПлатежногоДокумента(СсылкаНаДокумент)
	
	СтруктураДанных = Новый Структура("Номер,Дата");
	ТекущаяКонфигурация = КНП_ИмяКонфигурации();
	
	Если КНП_ЕстьРеквизит(СсылкаНаДокумент, "ДатаПлатежноРасчетногоДокумента") И КНП_ЕстьРеквизит(СсылкаНаДокумент, "НомерПлатежноРасчетногоДокумента") И
		ЗначениеЗаполнено(СсылкаНаДокумент.ДатаПлатежноРасчетногоДокумента) И ЗначениеЗаполнено(СсылкаНаДокумент.НомерПлатежноРасчетногоДокумента) 
		Тогда
		
		СтруктураДанных.Номер = СсылкаНаДокумент.НомерПлатежноРасчетногоДокумента;
		СтруктураДанных.Дата = КНП_ДатаВФормате(СсылкаНаДокумент.ДатаПлатежноРасчетногоДокумента);
		
	ИначеЕсли КНП_ЕстьРеквизит(СсылкаНаДокумент, "ДатаДокументаОплаты") И КНП_ЕстьРеквизит(СсылкаНаДокумент, "НомерДокументаОплаты") И
		ЗначениеЗаполнено(СсылкаНаДокумент.ДатаДокументаОплаты) И ЗначениеЗаполнено(СсылкаНаДокумент.НомерДокументаОплаты)	
		Тогда
		
		СтруктураДанных.Номер = СсылкаНаДокумент.НомерДокументаОплаты;
		СтруктураДанных.Дата = КНП_ДатаВФормате(СсылкаНаДокумент.ДатаДокументаОплаты);
		
	ИначеЕсли КНП_ЕстьТабЧасть(СсылкаНаДокумент, "ПлатежноРасчетныеДокументы") Тогда
		
		Если СсылкаНаДокумент.ПлатежноРасчетныеДокументы.Количество() > 0 Тогда
			
			ПлатежныйДокумент = СсылкаНаДокумент.ПлатежноРасчетныеДокументы[0];
			СтруктураКолонок = КНП_СтруктураНаОснованииКолонокТЧ(СсылкаНаДокумент.ПлатежноРасчетныеДокументы);
			
			Если СтруктураКолонок.Свойство("НомерПлатежноРасчетногоДокумента") Тогда
				СтруктураДанных.Номер = ПлатежныйДокумент.НомерПлатежноРасчетногоДокумента;
			КонецЕсли;
			
			Если СтруктураКолонок.Свойство("НомерДокумента") Тогда
				СтруктураДанных.Номер = ПлатежныйДокумент.НомерДокумента;
			КонецЕсли;
			
			Если СтруктураКолонок.Свойство("ДатаПлатежноРасчетногоДокумента") Тогда
				СтруктураДанных.Дата = КНП_ДатаВФормате(ПлатежныйДокумент.ДатаПлатежноРасчетногоДокумента);
			КонецЕсли;
			
			Если СтруктураКолонок.Свойство("ДатаДокумента") Тогда
				СтруктураДанных.Дата = КНП_ДатаВФормате(ПлатежныйДокумент.ДатаДокумента);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ (ЗначениеЗаполнено(СтруктураДанных.Номер) ИЛИ ЗначениеЗаполнено(СтруктураДанных.Дата) ) Тогда
		СтруктураДанных = Неопределено;
	КонецЕсли;
	
	Возврат СтруктураДанных;

КонецФункции

