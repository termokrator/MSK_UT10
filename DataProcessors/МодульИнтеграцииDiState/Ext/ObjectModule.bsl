Функция API_ПолучитьСписокВалют()
	
	ЗаголовкиЗапроса = СформироватьЗаголовкиДляАПИ();
	Адрес = "";
	
	ТаблицаДанных = СправочникВалюты.Выгрузить();
	ТаблицаДанных.Очистить();
	
	Если ВерсияAPI = "v1.2" ИЛИ ВерсияAPI = "v1.3" Тогда
		Адрес = HostAddress + "/api/dictionary/currency/";	
	КонецЕсли;
	
	ТекстJSON = ОбменHTTPJSON(Адрес, ЗаголовкиЗапроса);
	
	Если ТипЗнч(ТекстJSON) = Тип("Строка") Тогда
		
		ДобавитьВЖурнал("Не удалось получить список валют: " + ТекстJSON, "API_ПолучитьСписокВалют");
		Возврат ТаблицаДанных;	
		
	КонецЕсли;
	
	Если ТипЗнч(ТекстJSON) = Тип("Соответствие") Тогда
		
		РезультатЗапроса = ТекстJSON.Получить("success") ;
		
		Если РезультатЗапроса <> Неопределено И РезультатЗапроса = Ложь Тогда
			
			ВывестиУведомлениеПользователю(ТекстJSON.Получить("codeDescription") + ": " + Адрес);
			Возврат ТекстJSON.Получить("codeDescription");
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипЗнч(ТекстJSON) = Тип("Массив") Тогда
		МассивЭлементов = ТекстJSON;
	Иначе
		МассивЭлементов = Новый Массив;
	КонецЕсли;
	
	КоличествоЭлементов = МассивЭлементов.Количество();
	
	Для ИндексМассива = 0 По КоличествоЭлементов - 1 Цикл
		
		Попытка
			
			ЭлементМассива = МассивЭлементов[ИндексМассива];
			Код 						= ЭлементМассива.Получить("digitalCode");
			КраткоеИмя 					= ЭлементМассива.Получить("letterCode");
			Имя 						= ЭлементМассива.Получить("title");
			ИД 							= ЭлементМассива.Получить("code");
			
			НоваяСтрока 				= ТаблицаДанных.Добавить();
			НоваяСтрока.КодISO 			= Код;
			НоваяСтрока.СокрНазвание 	= КраткоеИмя;
			НоваяСтрока.Название 		= Имя;
			НоваяСтрока.Идентификатор 	= КНП_ЧислоБезГруппВВидеСтроки(ИД);
			НоваяСтрока.Ссылка 			= МОП_ПолучитьВалютуПоКоду(НоваяСтрока.КодISO);	
			
			Если НЕ ЗначениеЗаполнено(НоваяСтрока.Ссылка) И СоздаватьСправочникиПоДаннымЭДО Тогда
				НоваяСтрока.Ссылка 		= МОП_СоздатьВалюту(НоваяСтрока.КодISO, НоваяСтрока.Название, НоваяСтрока.СокрНазвание);
			КонецЕсли;
			
		Исключение
			ДобавитьВЖурнал("Ошибка обработки: " + ОписаниеОшибки(), "API_ПолучитьСписокВалют");
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат ТаблицаДанных;	
	
КонецФункции

Функция API_ПолучитьСписокСтран()
	
	ЗаголовкиЗапроса = СформироватьЗаголовкиДляАПИ();
	Адрес = "";
	ТаблицаДанных = СправочникСтраны.Выгрузить();
	ТаблицаДанных.Очистить();
	
	Если ВерсияAPI = "v1.2" ИЛИ ВерсияAPI = "v1.3" Тогда
		Адрес = HostAddress + "/api/dictionary/country/";	
	КонецЕсли;
	
	ТекстJSON = ОбменHTTPJSON(Адрес, ЗаголовкиЗапроса);
	
	Если ТипЗнч(ТекстJSON) = Тип("Строка") Тогда
		
		ДобавитьВЖурнал("Не удалось получить список стран: " + ТекстJSON, "API_ПолучитьСписокСтран");
		Возврат ТаблицаДанных;	
		
	КонецЕсли;
	
	Если ТипЗнч(ТекстJSON) = Тип("Соответствие") Тогда
		
		РезультатЗапроса = ТекстJSON.Получить("success") ;
		
		Если РезультатЗапроса <> Неопределено И РезультатЗапроса = Ложь Тогда
			
			ВывестиУведомлениеПользователю(ТекстJSON.Получить("codeDescription") + ": " + Адрес);
			Возврат ТекстJSON.Получить("codeDescription");
			
		КонецЕсли;
		
	КонецЕсли;
	
	МассивЭлементов = ТекстJSON;
	КоличествоЭлементов = ТекстJSON.Количество();
	
	Для ИндексМассива = 0 По КоличествоЭлементов - 1 Цикл
		
		Попытка
			
			ЭлементМассива 				= МассивЭлементов[ИндексМассива];
			ИмяСтраны 					= ЭлементМассива.Получить("title");
			ПолноеИмя 					= ЭлементМассива.Получить("fullTitle");
			КодСтраны 					= ЭлементМассива.Получить("code");
			ИДСтраны 					= ЭлементМассива.Получить("id");
			
			НоваяСтрока 				= ТаблицаДанных.Добавить();
			НоваяСтрока.Название 		= ИмяСтраны;
			НоваяСтрока.ПолноеНазвание 	= ПолноеИмя;
			НоваяСтрока.КодСтраны 		= КодСтраны;
			НоваяСтрока.Идентификатор 	= КНП_ЧислоБезГруппВВидеСтроки(ИДСтраны);
			НоваяСтрока.Ссылка 			= МОП_ПолучитьСтрануПоКоду(КодСтраны);
			
			Если НЕ ЗначениеЗаполнено(НоваяСтрока.Ссылка) И СоздаватьСправочникиПоДаннымЭДО Тогда
				НоваяСтрока.Ссылка 		= МОП_СоздатьСтрану(КодСтраны, НоваяСтрока.ПолноеНазвание, НоваяСтрока.Название);
			КонецЕсли;
			
		Исключение
			ДобавитьВЖурнал("Ошибка обработки: " + ОписаниеОшибки(), "API_ПолучитьСписокСтран");
		КонецПопытки;
		
	КонецЦикла;	
	
	Возврат ТаблицаДанных;		

КонецФункции

Функция API_ПолучитьСписокРегионов(БезАвторизации = Ложь)
	
	Если БезАвторизации Тогда
		API_ПолучитьВерсиюАПИ();
	КонецЕсли;
	
	ЗаголовкиЗапроса = СформироватьЗаголовкиДляАПИ();
	Адрес = "";
	ТаблицаДанных = СправочникРегионы.Выгрузить();
	ТаблицаДанных.Очистить();
	
	Если ВерсияAPI = "v1.2" ИЛИ ВерсияAPI = "v1.3" Тогда
		Адрес = HostAddress + "/api/dictionary/region/";	
	КонецЕсли;
	
	ТекстJSON = ОбменHTTPJSON(Адрес, ЗаголовкиЗапроса);
	
	Если ТипЗнч(ТекстJSON) = Тип("Строка") Тогда
		
		ДобавитьВЖурнал("Не удалось получить список регионов: " + ТекстJSON, "API_ПолучитьСписокРегионов");
		Возврат ТаблицаДанных;	
		
	КонецЕсли;
	
	Если ТипЗнч(ТекстJSON) = Тип("Соответствие") Тогда	
		
		РезультатЗапроса = ТекстJSON.Получить("success") ;
		
		Если РезультатЗапроса <> Неопределено И РезультатЗапроса = Ложь Тогда
			
			ВывестиУведомлениеПользователю(ТекстJSON.Получить("codeDescription") + ": " + Адрес);
			Возврат ТекстJSON.Получить("codeDescription");
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипЗнч(ТекстJSON) = Тип("Массив") Тогда
		МассивЭлементов = ТекстJSON;
	Иначе
		МассивЭлементов = Новый Массив;
	КонецЕсли;
	
	КоличествоЭлементов = МассивЭлементов.Количество();
	
	Для ИндексМассива = 0 По КоличествоЭлементов - 1 Цикл
		
		Попытка
			
			ЭлементМассива 				= МассивЭлементов[ИндексМассива];
			ИмяРегиона 					= ЭлементМассива.Получить("title");		
			КодРегиона 					= ЭлементМассива.Получить("code");
			ИДРегиона 					= ЭлементМассива.Получить("id");
			
			НомерСимволыСкобки = Найти(ИмяРегиона, "("); 
			
			Если НомерСимволыСкобки > 0 Тогда
				ИмяРегиона = СокрЛП(Лев(ИмяРегиона, НомерСимволыСкобки - 1));	
			КонецЕсли;          
			
			НоваяСтрока 				= ТаблицаДанных.Добавить();
			НоваяСтрока.ИмяРегиона 		= ИмяРегиона;		
			НоваяСтрока.КодРегиона 		= КодРегиона;
			НоваяСтрока.Идентификатор 	= КНП_ЧислоБезГруппВВидеСтроки(ИДРегиона);
			
		Исключение
			ДобавитьВЖурнал("Ошибка обработки: " + ОписаниеОшибки(), "API_ПолучитьСписокРегионов");
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат ТаблицаДанных;	

КонецФункции

