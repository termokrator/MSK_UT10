			Возврат ОбъектЗаполнения.Номенклатура.НаименованиеПолное;
		Иначе
			Возврат ОбъектЗаполнения.Номенклатура.Наименование;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ОбъектЗаполнения.Свойство("Ссылка") И ЗначениеЗаполнено(ОбъектЗаполнения.Ссылка) Тогда
		
		Если МОП_ЭтоСчетФактураНаАванс(ОбъектЗаполнения.Ссылка) Тогда
			Возврат "Предварительная оплата";
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат "";	

КонецФункции

Функция ФОД_ПолучитьКодЕдиницыИзмеренияТовара(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	
	Результат = "0000";
	
	Если ТипЗнч(ОбъектЗаполнения) = Тип("Структура") Тогда
		
		Если ОбъектЗаполнения.Свойство("ЕдиницаИзмерения") И ЗначениеЗаполнено(ОбъектЗаполнения.ЕдиницаИзмерения) Тогда
			Результат = ФОД_ПолучитьКодЭлемента(ВерсияЗаполнения, ОбъектЗаполнения.ЕдиницаИзмерения.ЕдиницаПоКлассификатору);
		КонецЕсли;
		
		Если ОбъектЗаполнения.Свойство("Номенклатура") И ЗначениеЗаполнено(ОбъектЗаполнения.Номенклатура) Тогда
			
			Если КНП_ЕстьРеквизит(ОбъектЗаполнения.Номенклатура, "ЕдиницаИзмерения") Тогда
				Результат = ФОД_ПолучитьКодЭлемента(ВерсияЗаполнения, ОбъектЗаполнения.Номенклатура.ЕдиницаИзмерения);
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли КНП_ЕстьСтандартныйРеквизит(ОбъектЗаполнения, "Код") Тогда
		Результат = СокрЛП(ОбъектЗаполнения.Код);	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Результат = "0000";
	КонецЕсли;
	
	Если МОП_ЭтоСчетФактураНаАванс(ОбъектЗаполнения.Ссылка) Тогда
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция ФОД_ПолучитьЦенуТовара(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	
	Результат = Неопределено;
	
	Если ОбъектЗаполнения.Свойство("Ссылка") Тогда
		НДСВСумме = МОП_ДокументВключаетНДСВСумму(ОбъектЗаполнения.Ссылка);
	Иначе
		НДСВСумме = Ложь;
	КонецЕсли;
	
	Если ОбъектЗаполнения.Свойство("Цена") Тогда
		
		Если НЕ НДСВСумме Тогда
			Результат = ОбъектЗаполнения.Цена;
		Иначе
			
			КоличествоТовара = ФОД_ПолучитьКоличествоТовара(ВерсияЗаполнения, ОбъектЗаполнения);
			
			Если КоличествоТовара <> Неопределено  Тогда
				Результат = ФОД_ПолучитьСуммуТовара(ВерсияЗаполнения, ОбъектЗаполнения) / ?(КоличествоТовара > 0, КоличествоТовара, 1);
			КонецЕсли;  
			
		КонецЕсли;
		
	КонецЕсли;
	
	КоличествоТовара = ФОД_ПолучитьКоличествоТовара(ВерсияЗаполнения, ОбъектЗаполнения);
	
	Если НЕ ЗначениеЗаполнено(КоличествоТовара)  Тогда
		Результат = Неопределено;
	КонецЕсли;
	
	Если МОП_ЭтоСчетФактураНаАванс(ОбъектЗаполнения.Ссылка) Тогда
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция ФОД_ПолучитьЦенуТовараСНулем(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	
	Результат = Неопределено;
	
	Если ОбъектЗаполнения.Свойство("Ссылка") Тогда
		НДСВСумме = МОП_ДокументВключаетНДСВСумму(ОбъектЗаполнения.Ссылка);
	Иначе
		НДСВСумме = Ложь;
	КонецЕсли;
	
	Если ОбъектЗаполнения.Свойство("Цена") Тогда
		
		Если НЕ НДСВСумме Тогда
			Результат = ОбъектЗаполнения.Цена;
		Иначе
			
			КоличествоТовара = ФОД_ПолучитьКоличествоТовараСНулем(ВерсияЗаполнения, ОбъектЗаполнения);
			
			Если КоличествоТовара <> Неопределено  Тогда
				Результат = ФОД_ПолучитьСуммуТовара(ВерсияЗаполнения, ОбъектЗаполнения) / ?(КоличествоТовара > 0, КоличествоТовара, 1);
			КонецЕсли;  
			
		КонецЕсли;
		
	КонецЕсли;
	
	КоличествоТовара = ФОД_ПолучитьКоличествоТовараСНулем(ВерсияЗаполнения, ОбъектЗаполнения);
	
	Если НЕ ЗначениеЗаполнено(КоличествоТовара) Тогда
		
