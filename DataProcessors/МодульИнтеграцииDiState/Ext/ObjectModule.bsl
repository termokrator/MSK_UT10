		ДопРеквизитХранилищеСопоставлений.Наименование 	= "DS_СопоставлениеНоменклатур";
		
		Если ДопРеквизитХранилищеСопоставлений.Метаданные().Реквизиты.Найти("Заголовок") <> Неопределено Тогда
			ДопРеквизитХранилищеСопоставлений.Заголовок 	= "DS_СопоставлениеНоменклатур";	
		КонецЕсли;
		
		ДопРеквизитХранилищеСопоставлений.ТипЗначения 	= Новый ОписаниеТипов("СправочникСсылка.ЗначенияСвойствОбъектов" );
		ДопРеквизитХранилищеСопоставлений.ОбменДанными.Загрузка = Истина;
		ДопРеквизитХранилищеСопоставлений.Записать();
		
	КонецЕсли;
	
	ДопРеквизитХранилищеСтатьиРасходов						= МенеджерДопСведений.НайтиПоНаименованию("DS_СопоставлениеСтатейРасходов");
	
