Функция РосМарк_ПоискЗаданияНаПеревозку(НомерНакладной)
	
	//==Специфичный блок кода
	Если ВеткаРазработки = "РосМарк" Тогда
		
		ЗаданиеНаПеревозку = Документы.ЗаданиеНаПеревозку.ПустаяСсылка();
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗаданиеНаПеревозку.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаданиеНаПеревозку КАК ЗаданиеНаПеревозку
		|ГДЕ
		|	ЗаданиеНаПеревозку._НомераНакладных ПОДОБНО &НомерНакладной";
		
		Запрос.УстановитьПараметр("НомерНакладной", НомерНакладной);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			ЗаданиеНаПеревозку = Выборка.Ссылка;
		КонецЕсли;
		
		Возврат ЗаданиеНаПеревозку;
		
	КонецЕсли;
	//==Специфичный блок кода
	
	Возврат Неопределено;

КонецФункции

Функция РосМарк_ПоискЗаказаПоставщику(НомерНакладной)
	
	//==Специфичный блок кода
	Если ВеткаРазработки = "РосМарк" Тогда
		
		ЗаказПоставщику = Документы.ЗаказПоставщику.ПустаяСсылка();
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗаказПоставщику.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаказПоставщику КАК ЗаказПоставщику
		|ГДЕ
		|	ЗаказПоставщику.НомерПоДаннымПоставщика ПОДОБНО &НомерНакладной
		|	И ЗаказПоставщику.ПометкаУдаления = ЛОЖЬ";
		
		Запрос.УстановитьПараметр("НомерНакладной", НомерНакладной);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			ЗаказПоставщику = Выборка.Ссылка;
		КонецЕсли;
		
		Возврат ЗаказПоставщику;
		
	КонецЕсли;
	//==Специфичный блок кода
	
	Возврат Неопределено;

КонецФункции

Функция РосМарк_ПроверитьСоответствиеСчетаИУПД(ОбъектДанных)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ТипЗнч(ОбъектДанных) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;
	
	Если НЕ ОбъектДанных.Свойство("ТабличнаяЧасть") Тогда
		Возврат "";
	КонецЕсли;
	
	ТаблицаТоваров = РС_ОбработатьТЧСтруктурыПФ(ОбъектДанных.ТабличнаяЧасть);	
	
	ЗаказПоставщику = РосМарк_ПоискЗаказаПоставщику(ОбъектДанных.Номер);
	УстановитьПривилегированныйРежим(Ложь);
	
	Если ЗначениеЗаполнено(ЗаказПоставщику) Тогда
		
		Если ЗаказПоставщику.СуммаДокумента <> ТаблицаТоваров.Итог("СуммаСНДС") Тогда
			Возврат "Ошибка создания приходной накладной: несоответствие суммы в документе и в заказе №" + ЗаказПоставщику.Номер;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат "";

КонецФункции

Функция ДО_ПринятиеДокумента(ДанныеДокумента, ТипДокумента)
	
	СтруктураВозврата = Новый Структура("РазрешеноПринятие, Причина", Истина, "");
	
	СтруктураОбработки = Новый Структура("ДанныеДокумента,Тип", ДанныеДокумента, ТипДокумента);
	ОбъектДанных = РС_ПрочитатьОбъектДанныхИзXML(СтруктураОбработки);
	
	//==Специфический блок кода
	Если ВеткаРазработки = "РосМарк" Тогда	
		
		РезультатПроверки = РосМарк_ПроверитьСоответствиеСчетаИУПД(ОбъектДанных);
		
		Если ЗначениеЗаполнено(РезультатПроверки) Тогда
			
			СтруктураВозврата.РазрешеноПринятие = Ложь;
			СтруктураВозврата.Причина = РезультатПроверки;
			
		КонецЕсли;
		
	КонецЕсли;
	//==Специфический блок кода
	
	Возврат СтруктураВозврата;

КонецФункции
