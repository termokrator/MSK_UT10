Функция ЭДО_ОпределитьТипДокументаДляЭДО(ТипДокумента)
	
	Результат = ТипДокумента;
	
	Если Найти(ТипДокумента, "Торг-12") Тогда
		Результат = "waybill551";
	КонецЕсли;
	
	Если Найти(ТипДокумента, "Счет на оплату") Тогда
		Результат = "bill";
	КонецЕсли;
	
	Если Найти(ТипДокумента, "УПД") Тогда
		Результат = "universal_transfer_document_invoice_and_waybill"; //Белов "universal_transfer_document_waybill";
	КонецЕсли;
	
	Если Найти(ТипДокумента, "УКД") Тогда
		Результат = "universal_correction_document_invoice_and_waybill";  //Белов "universal_correction_document_waybill"
	КонецЕсли;
	
	Если Найти(ТипДокумента, "Универсальный передаточный документ") Тогда //На основании СФ
		Результат = "universal_transfer_document_invoice_and_waybill";	
	КонецЕсли;
	
	Если Найти(ТипДокумента, "Акт") Тогда
		Результат = "act552";	
	КонецЕсли;
	
	Если Найти(ТипДокумента, "Счет-фактура") Тогда
		Результат = "invoice_utd";	
	КонецЕсли;
	
	Если Найти(ТипДокумента, "Корректировочная Счет-фактура") Тогда
		Результат = "invoice_correction_ucd";	
	КонецЕсли;
	
	Если Найти(ТипДокумента, "Корректировка") Тогда
		Результат = "universal_correction_document_waybill";
	КонецЕсли;
	
	Если Найти(ТипДокумента, "Универсальный корректи") Тогда
		Результат = "universal_correction_document_invoice_and_waybill";
	КонецЕсли;
	
	Если Найти(ТипДокумента, "Акт сверки") Тогда
		Результат = "unformalized_bilateral";
	КонецЕсли;

	//+Макрушин Е. 09.04.2026 #UT10-5800
	Если Найти(ТипДокумента, "Торг-2") Тогда
		Результат = "torg2";
	КонецЕсли;
	//-Макрушин Е. 09.04.2026 #UT10-5800
	
	//+Белов А. 17.06.2026 #UT10-5921
	Если Найти(ТипДокумента, "Транспортная накладная") Тогда
		Результат = "electronic_waybill";
	КонецЕсли;
	
	Если Найти(ТипДокумента, "Заказ-заявка") Тогда
		Результат = "transportation_order";
	КонецЕсли;
	//-Белов А. 17.06.2026 #UT10-5921
	
	Возврат Результат;
	
КонецФункции

