Функция КНП_ЕстьОбъектМетаданных(ИмяМетаданных)
	
	Результат = Ложь;
	УстановитьПривилегированныйРежим(Истина);
	
	Если Метаданные.Справочники.Найти(ИмяМетаданных) <> Неопределено Тогда
		Результат = Истина;
	ИначеЕсли Метаданные.Документы.Найти(ИмяМетаданных) <> Неопределено Тогда
		Результат = Истина;
	ИначеЕсли Метаданные.РегистрыСведений.Найти(ИмяМетаданных) <> Неопределено Тогда
		Результат = Истина;
	ИначеЕсли Метаданные.Перечисления.Найти(ИмяМетаданных) <> Неопределено Тогда
		Результат = Истина;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;

КонецФункции

Функция КНП_ВДокументеКорректныеСтавки(СсылкаНаДокумент)
	
	Результат = Истина;
	ПризнакНДСВСуммеДокумента = МОП_ДокументВключаетНДСВСумму(СсылкаНаДокумент);
	
	Если КНП_ЕстьТабЧасть(СсылкаНаДокумент, "Товары") Тогда
		
		ТабЗначТоваров = СсылкаНаДокумент.Товары.Выгрузить();
		
		Если ТабЗначТоваров.Колонки.Найти("СтавкаНДС") = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
		
		Для Каждого Товар Из СсылкаНаДокумент.Товары Цикл
			
			Если Товар.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.БезНДС") Тогда
				Продолжить;
			КонецЕсли;
			
			Если Товар.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС0") Тогда
				Продолжить;
			КонецЕсли;
			
			Если МОП_НДСВСуммеПоСтавке(Товар.СтавкаНДС) <> ПризнакНДСВСуммеДокумента Тогда
				
				Результат = Ложь;
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если КНП_ЕстьТабЧасть(СсылкаНаДокумент, "Услуги") Тогда
		
		ТабЗначТоваров = СсылкаНаДокумент.Услуги.Выгрузить();
		
		Если ТабЗначТоваров.Колонки.Найти("СтавкаНДС") = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
		
		Для Каждого Товар Из СсылкаНаДокумент.Услуги Цикл
			
			Если Товар.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.БезНДС") Тогда
				Продолжить;
			КонецЕсли;
			
			Если Товар.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС0") Тогда
				Продолжить;
			КонецЕсли;
			
			Если МОП_НДСВСуммеПоСтавке(Товар.СтавкаНДС) <> ПризнакНДСВСуммеДокумента Тогда
				
				Результат = Ложь;
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

