Функция API_ПолучитьСписокБанков(БИКБанка = Неопределено)
	
	ЗаголовкиЗапроса = СформироватьЗаголовкиДляАПИ();
	Адрес = "";
	МассивЭлементов = Новый Массив;
	
	Если ВерсияAPI = "v1.2" ИЛИ ВерсияAPI = "v1.3" Тогда                                                                                        
		Адрес = HostAddress + "/api/dictionary/bank/" + ?(ЗначениеЗаполнено(БИКБанка), "?bik=" + БИКБанка, "");	
	КонецЕсли;
	
	ТекстJSON = ОбменHTTPJSON(Адрес, ЗаголовкиЗапроса);
	
	Если ТипЗнч(ТекстJSON) = Тип("Строка") Тогда
		ДобавитьВЖурнал("Не удалось получить список банков: " + ТекстJSON, "API_ПолучитьСписокБанков");
	КонецЕсли;
	
	Если ТипЗнч(ТекстJSON) = Тип("Соответствие") Тогда
		
		РезультатЗапроса = ТекстJSON.Получить("success") ;
		
		Если РезультатЗапроса <> Неопределено И РезультатЗапроса = Ложь Тогда
			ВывестиУведомлениеПользователю(ТекстJSON.Получить("codeDescription") + ": " + Адрес);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипЗнч(ТекстJSON) = Тип("Массив") Тогда
		МассивЭлементов = ТекстJSON;
	КонецЕсли;
	
	Возврат МассивЭлементов;

КонецФункции

Функция API_ПолучитьСписокКонтрагентов(ПолнаяЗагрузка = Ложь)
	
	ЗаголовкиЗапроса = СформироватьЗаголовкиДляАПИ();
	Адрес = "";
	МассивЭлементов = Новый Массив;
	
	Если ВерсияAPI = "v1.2" ИЛИ ВерсияAPI = "v1.3" Тогда
		Адрес = HostAddress + "/api/contractor/?limit=1000&offset=";	
	КонецЕсли;	
	
	НачалоОтбора = 0;
	ВыполнятьСбор = Истина;
	
	Пока ВыполнятьСбор Цикл
		
		ТекстJSON = ОбменHTTPJSON(Адрес + КНП_ЧислоВФормате(НачалоОтбора, 0), ЗаголовкиЗапроса);
		
		Если ТипЗнч(ТекстJSON) = Тип("Строка") Тогда
			
			ДобавитьВЖурнал("Не удалось получить список контрагентов: " + ТекстJSON, "API_ПолучитьСписокКонтрагентов");
			Прервать;
			
		КонецЕсли;
		
		Если ТипЗнч(ТекстJSON) = Тип("Соответствие") Тогда
			
			РезультатЗапроса = ТекстJSON.Получить("success") ;
			
			Если РезультатЗапроса <> Неопределено И РезультатЗапроса = Ложь Тогда
				
				ВывестиУведомлениеПользователю(ТекстJSON.Получить("codeDescription") + ": " + Адрес);
				Прервать;
				
			КонецЕсли;
			
		КонецЕсли;
		
		МассивКонтрагентов = ТекстJSON.Получить("rows");
		
		Если ТипЗнч(МассивКонтрагентов) = Тип("Массив") Тогда
			
			Если МассивКонтрагентов.Количество() = 0 Тогда
				ВыполнятьСбор = Ложь;
			Иначе
				
				Для Каждого ЭлементМассива ИЗ МассивКонтрагентов Цикл
					МассивЭлементов.Добавить(ЭлементМассива);
				КонецЦикла;
				
			КонецЕсли;
			
		Иначе
			ВыполнятьСбор = Ложь;
		КонецЕсли;
		
		НачалоОтбора = НачалоОтбора + 1000;	
		
	КонецЦикла;
	
	Возврат МассивЭлементов;

КонецФункции

