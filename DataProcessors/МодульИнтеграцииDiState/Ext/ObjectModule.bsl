// Функция - Создать новую номенклатуру
// *Поддержка БП 3.0, УТ 11, КА 2.4, БП 2.0, УТ 10.3, КА 1.1, УПП 1.3
//
// Параметры:
//  Товар	 - СтрокаТабличнойЧасти	 - Строка ТЧ Товаров, полученных через функцию ПрочитатьТаблицуТоваров()
// 
// Возвращаемое значение:
// СправочникСсылка.Номенклатура  - Ссылка на новый объект номенклатуры
//
// Расчет суммы НДС в строке товаров
// *Поддержка БП 3.0, УТ 11, КА 2.4, БП 2.0, УТ 10.3, КА 1.1, УПП 1.3
//
// Параметры:
//  СтрокаТовара	 - СтрокаТаблицыЗначений - Строка табличной части, в которой должны присутствовать следующие колонки:
//  * Сумма
//  * СуммаНДС
//  * СтавкаНДС
//  СуммаВключаетНДС - Булево				 - Признак включения НДС в сумму
Процедура КЗП_РассчитатьСуммуНДССтрокиТЧ(СтрокаТовара, СуммаВключаетНДС)
	
	ТекКонф = КНП_ИмяКонфигурации();
	
	Если ТекКонф = "БП3" Тогда
		
		МодульОбработкаТабличныхЧастейКлиентСервер = КНП_ОбщийМодуль("ОбработкаТабличныхЧастейКлиентСервер");
		МодульОбработкаТабличныхЧастейКлиентСервер.РассчитатьСуммуНДСТабЧасти(СтрокаТовара, СуммаВключаетНДС);
		
	ИначеЕсли ТекКонф = "УТ11" ИЛИ ТекКонф = "КА24" ИЛИ ТекКонф = "ERP" Тогда
		
		МодульЦенообразованиеКлиентСервер = КНП_ОбщийМодуль("ЦенообразованиеКлиентСервер");
		ТекПроцентНДС = МодульЦенообразованиеКлиентСервер.ПолучитьСтавкуНДСЧислом(СтрокаТовара.СтавкаНДС, Ложь);
		СтрокаТовара.СуммаНДС = МодульЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(СтрокаТовара.Сумма, ТекПроцентНДС, СуммаВключаетНДС);
		
	ИначеЕсли ТекКонф = "БП" ИЛИ ТекКонф = "УТ" ИЛИ ТекКонф = "КА" ИЛИ ТекКонф = "УПП" Тогда
		
		МодульУчетНДС = КНП_ОбщийМодуль("УчетНДС");
		СтрокаТовара.СуммаНДС = МодульУчетНДС.РассчитатьСуммуНДС(СтрокаТовара.Сумма, СуммаВключаетНДС, СуммаВключаетНДС, МодульУчетНДС.ПолучитьСтавкуНДС(СтрокаТовара.СтавкаНДС) );
		
	ИначеЕсли ТекКонф = "УНФ" Тогда
		
		МодульУНФ = КНП_ОбщийМодуль("УправлениеНебольшойФирмойПовтИсп");
		СтавкаНДС = МодульУНФ.ПолучитьЗначениеСтавкиНДС(СтрокаТовара.СтавкаНДС);
		СтрокаТовара.СуммаНДС = ?(СуммаВключаетНДС, 
		СтрокаТовара.Сумма - (СтрокаТовара.Сумма) / ((СтавкаНДС + 100) / 100),
		СтрокаТовара.Сумма * СтавкаНДС / 100);							  
		СтрокаТовара.Всего = СтрокаТовара.Сумма + ?(СуммаВключаетНДС, 0, СтрокаТовара.СуммаНДС);
		
	Иначе
		ДобавитьВЖурнал("Неподдерживаемая конфигурация " + ТекКонф, "РассчитатьСуммаНДССтрокиТЧ");	
	КонецЕсли;

КонецПроцедуры

Функция КЗП_СоздатьНовуюНоменклатуру(Товар, ИмяНоменклатуры = Неопределено)
	//Changelog
	//
	//Указание наименования новой номенклатуры явно
	
	ТекКонф = КНП_ИмяКонфигурации();
	НоваяНоменклатура = Справочники.Номенклатура.СоздатьЭлемент();
	
	Если ЗначениеЗаполнено(ИмяНоменклатуры) Тогда
		НоваяНоменклатура.Наименование = ИмяНоменклатуры;
	Иначе
		НоваяНоменклатура.Наименование = ?(ЗначениеЗаполнено(Товар.Содержание), Товар.Содержание, Товар.Наименование);
	КонецЕсли;
	
	НоваяНоменклатура.НаименованиеПолное = НоваяНоменклатура.Наименование;
	
	Если ТипЗнч(Товар.ЕдиницаИзмерения) = Тип("Строка") Тогда
		
		ЕдиницаИзмеренияТовара = СправочникЕдиницыИзмерения.Найти(Товар.ЕдиницаИзмерения, "Название");
		
		Если ЗначениеЗаполнено(ЕдиницаИзмеренияТовара) Тогда
			ЕдиницаИзмеренияТовара = ЕдиницаИзмеренияТовара.Ссылка;
		КонецЕсли;
		
	Иначе
		ЕдиницаИзмеренияТовара = Товар.ЕдиницаИзмерения;
	КонецЕсли;
	
	Если ТекКонф = "БП3" Тогда
		
		Если ЗначениеЗаполнено(ЕдиницаИзмеренияТовара) Тогда	
			НоваяНоменклатура.ЕдиницаИзмерения = ЕдиницаИзмеренияТовара;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(НоваяНоменклатура.ЕдиницаИзмерения) Тогда
			НоваяНоменклатура.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоНаименованию("шт");
		КонецЕсли;
		
		Если ЗагрузкаНоменклатурыКакУслуга Тогда
			НоваяНоменклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Услуги", Истина);		
		Иначе
			НоваяНоменклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Товары", Истина);	
		КонецЕсли;
		
	ИначеЕсли ТекКонф = "БП" ИЛИ ТекКонф = "УТ" ИЛИ ТекКонф = "КА" ИЛИ ТекКонф = "УПП" Тогда
		
		Если ЗначениеЗаполнено(ЕдиницаИзмеренияТовара) Тогда
			НоваяНоменклатура.БазоваяЕдиницаИзмерения = ЕдиницаИзмеренияТовара;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(НоваяНоменклатура.БазоваяЕдиницаИзмерения) Тогда
			НоваяНоменклатура.БазоваяЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоНаименованию("шт");
		КонецЕсли;
		
		Если ТекКонф = "УТ" Тогда
			
			НоваяНоменклатура.ЕдиницаДляОтчетов = Справочники.ЕдиницыИзмерения.НайтиПоНаименованию(НоваяНоменклатура.БазоваяЕдиницаИзмерения.Наименование);
			НоваяНоменклатура.ЕдиницаХраненияОстатков = НоваяНоменклатура.ЕдиницаДляОтчетов;
			
			Если ЗагрузкаНоменклатурыКакУслуга Тогда
				
				НоваяНоменклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Услуги", Истина);
				
				Если НоваяНоменклатура.ВидНоменклатуры.Пустая() Тогда
					НоваяНоменклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Услуг");	
				КонецЕсли;
				
			Иначе	
				
				НоваяНоменклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Товары", Истина);
				
				Если НоваяНоменклатура.ВидНоменклатуры.Пустая() Тогда
					НоваяНоменклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Товар");	
				КонецЕсли;
				
			КонецЕсли;
			
		ИначеЕсли ТекКонф = "КА" ИЛИ ТекКонф = "УПП" Тогда
			
			Если ЗагрузкаНоменклатурыКакУслуга Тогда
				
				НоваяНоменклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Услуги", Истина);
				
				Если НоваяНоменклатура.ВидНоменклатуры.Пустая() Тогда
					НоваяНоменклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Услуг");	
				КонецЕсли;
				
			Иначе			
				
				НоваяНоменклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Товары", Истина);
				
				Если НоваяНоменклатура.ВидНоменклатуры.Пустая() Тогда
					НоваяНоменклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Товар");	
				КонецЕсли;
				
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(НоваяНоменклатура.БазоваяЕдиницаИзмерения) Тогда
				НоваяНоменклатура.БазоваяЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоНаименованию("шт");
			КонецЕсли;
			
			НоваяНоменклатура.ЕдиницаДляОтчетов = Справочники.ЕдиницыИзмерения.НайтиПоНаименованию(НоваяНоменклатура.БазоваяЕдиницаИзмерения.Наименование);
			НоваяНоменклатура.ЕдиницаХраненияОстатков = НоваяНоменклатура.ЕдиницаДляОтчетов;
			
		КонецЕсли;
		
	ИначеЕсли ТекКонф = "УТ11" ИЛИ ТекКонф = "КА24" ИЛИ ТекКонф = "ERP" Тогда
		
		Если ЗагрузкаНоменклатурыКакУслуга Тогда
			
			НоваяНоменклатура.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Услуга");
			НоваяНоменклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Услуги", Истина);
			
			Если НоваяНоменклатура.ВидНоменклатуры.Пустая() Тогда
				НоваяНоменклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Услуг");	
			КонецЕсли;
			
		Иначе	
			
			НоваяНоменклатура.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Товар");
			НоваяНоменклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Товары", Истина);
		КонецЕсли;
		
		Если КНП_ЕстьРеквизит(НоваяНоменклатура, "БазоваяЕдиницаИзмерения") Тогда
			
			Если ЗначениеЗаполнено(ЕдиницаИзмеренияТовара) Тогда
				НоваяНоменклатура.БазоваяЕдиницаИзмерения = ЕдиницаИзмеренияТовара;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(НоваяНоменклатура.БазоваяЕдиницаИзмерения) Тогда
				НоваяНоменклатура.БазоваяЕдиницаИзмерения = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию("шт");
			КонецЕсли;
			
		ИначеЕсли КНП_ЕстьРеквизит(НоваяНоменклатура, "ЕдиницаИзмерения") Тогда
			
			Если ЗначениеЗаполнено(ЕдиницаИзмеренияТовара) Тогда
				НоваяНоменклатура.ЕдиницаИзмерения = ЕдиницаИзмеренияТовара;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(НоваяНоменклатура.ЕдиницаИзмерения) Тогда
				НоваяНоменклатура.ЕдиницаИзмерения = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию("шт");
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ТекКонф = "УНФ" Тогда
		
		НоваяНоменклатура.КатегорияНоменклатуры = Справочники.КатегорииНоменклатуры.НайтиПоНаименованию("Товары");
		
		Если ЗагрузкаНоменклатурыКакУслуга Тогда
			НоваяНоменклатура.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Услуга");
		Иначе
			НоваяНоменклатура.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Запас");
		КонецЕсли;
		
		Если КНП_ЕстьРеквизит(НоваяНоменклатура, "ЕдиницаИзмерения") Тогда
			
			Если ЗначениеЗаполнено(ЕдиницаИзмеренияТовара) Тогда
				НоваяНоменклатура.ЕдиницаИзмерения = ЕдиницаИзмеренияТовара;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(НоваяНоменклатура.ЕдиницаИзмерения) Тогда
				НоваяНоменклатура.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоНаименованию("шт");
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	НоваяНоменклатура.Родитель = КаталогДляНоменклатурыПоставщика;
	НоваяНоменклатура.Записать();
	
	Возврат НоваяНоменклатура.Ссылка;

КонецФункции

Функция КЗП_Служебный_ПечатьАктаСверкиУТ103(СсылкаНаДокумент)
	
	//Экспорт процедуры печати из УТ 10.3
	ДокОбъект = СсылкаНаДокумент.ПолучитьОбъект();
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_АктСверкиВзаиморасчетов_АктСверки";
	Макет  = ПолучитьМакет("ПФ_АктСверки");
	
	ОбластьЗаголовок    = Макет.ПолучитьОбласть("Заголовок");
	ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
	ОбластьНачОстатки   = Макет.ПолучитьОбласть("НачОстатки");
	ОбластьОбороты      = Макет.ПолучитьОбласть("Обороты");
	ОбластьОборотыИтог  = Макет.ПолучитьОбласть("ОборотыИтог");
	ОбластьКонОстатки   = Макет.ПолучитьОбласть("КонОстатки");
	ОбластьПодвал       = Макет.ПолучитьОбласть("Подвал");
	
	НазваниеОрганизации = ДокОбъект.Организация.НаименованиеПолное;
	
	Если ПустаяСтрока(НазваниеОрганизации) Тогда
		НазваниеОрганизации = ДокОбъект.Организация;
	КонецЕсли;
	
	НаименованиеКонтрагента = ДокОбъект.Контрагент.НаименованиеПолное;
	
	Если ПустаяСтрока(НаименованиеКонтрагента) Тогда
		НаименованиеКонтрагента = ДокОбъект.Контрагент;
	КонецЕсли;
	
	ОбластьЗаголовок.Параметры.НазваниеОрганизации = НазваниеОрганизации;
	ОбластьЗаголовок.Параметры.НаименованиеКонтрагента = НаименованиеКонтрагента;
	ИмяПредставителяОрганизации = ДокОбъект.ПредставительОрганизации;
	ИмяПредсатвителяКонтрагента = ДокОбъект.ПредставительКонтрагента;
	
	Если ЗначениеЗаполнено(ДокОбъект.ПредставительОрганизации) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОтветственныеЛицаОрганизацииСрезПоследних.Должность
		|ИЗ
		|	РегистрСведений.ОтветственныеЛицаОрганизации.СрезПоследних(
		|		&КонДата,
		|		СтруктурнаяЕдиница = &Организация
		|			И ФизическоеЛицо = &ФизическоеЛицо) КАК ОтветственныеЛицаОрганизацииСрезПоследних";
		
		Запрос.УстановитьПараметр("Организация", ДокОбъект.Организация);
		Запрос.УстановитьПараметр("ФизическоеЛицо", ДокОбъект.ПредставительОрганизации);
		Запрос.УстановитьПараметр("КонДата", ДокОбъект.Дата);
		
		Рез = Запрос.Выполнить();
		
		Если Рез.Пустой() тогда
			ДолжностьПредставителяОрганизации = "";
		Иначе
			
			Выборка = Рез.Выбрать();
			Выборка.Следующий();
			ДолжностьПредставителяОрганизации = СокрЛП(Выборка.Должность);
			
		КонецЕсли;
		
	Иначе
		ДолжностьПредставителяОрганизации = "";
	КонецЕсли;
	
	ДолжностьПредставителяКонтрагента = ?(НЕ ЗначениеЗаполнено(ДокОбъект.ПредставительКонтрагента), "", СокрЛП(ДокОбъект.ПредставительКонтрагента.Должность));
	
	Если НЕ ЗначениеЗаполнено(ДокОбъект.ДатаНачала) Тогда
		
		Если ДокОбъект.ПоДаннымОрганизации.Количество()>0 Тогда
			ДатаНачалаПериода = ДокОбъект.ПоДаннымОрганизации[0].Дата;
		Иначе
			ДатаНачалаПериода = ДокОбъект.ДатаНачала;
		КонецЕсли;
		
	Иначе
		ДатаНачалаПериода = ДокОбъект.ДатаНачала;
	КонецЕсли;		
	
	ТекстЗаголовка = "взаимных расчетов за период с " + Формат(ДатаНачалаПериода, "ДФ=dd.MM.yyyy") + " по " + Формат(ДокОбъект.ДатаОкончания, "ДФ=dd.MM.yyyy") + Символы.ПС
	+ "между " + НазваниеОрганизации + Символы.ПС + "и " + НаименованиеКонтрагента;
	
	Если ЗначениеЗаполнено(ДокОбъект.ДоговорКонтрагента) Тогда
		ТекстЗаголовка = ТекстЗаголовка + Символы.ПС + "по договору " + СокрЛП(ДокОбъект.ДоговорКонтрагента);
	КонецЕсли;
	
	ОбластьЗаголовок.Параметры.ТекстЗаголовка = ТекстЗаголовка;
	
	ФИОПредставителя = "" + ДокОбъект.ПредставительОрганизации;	
	СтрЗаголовокТаблица = "Мы, нижеподписавшиеся, "
	+ ?(ДолжностьПредставителяОрганизации <> "", ДолжностьПредставителяОрганизации,"_______________________") + " "
	+ НазваниеОрганизации 
	+ " " + ?(ФИОПредставителя <> "", ФИОПредставителя,"__________________________________________") + ", с одной стороны, "
	+ "и " + ?(ДолжностьПредставителяКонтрагента <> "", ДолжностьПредставителяКонтрагента,"___________________________") 
	+ " " + НаименованиеКонтрагента + " " 
	+ ?(НЕ ЗначениеЗаполнено(ДокОбъект.ПредставительКонтрагента), "_____________________________________________", ДокОбъект.ПредставительКонтрагента) + ", с другой стороны, "
	+ "составили настоящий акт сверки в том, что состояние взаимных расчетов по данным учета следующее:";
	
	ОбластьЗаголовок.Параметры.СтрЗаголовокТаблица = СтрЗаголовокТаблица;
	ОбластьЗаголовок.Параметры.ВалютаДокумента = ДокОбъект.ВалютаДокумента;
	
	ТабДок.Очистить();
	ТабДок.Вывести(ОбластьЗаголовок);
	ТабДок.Вывести(ОбластьШапкаТаблицы);
	
	ИтСуммаОборотДт      = 0;
	ИтСуммаОборотКт      = 0;
	ИтСуммаОборотДтКонтр = 0;
	ИтСуммаОборотКтКонтр = 0;
	
	НачОстДебет  = ?(ДокОбъект.ОстатокНаНачало > 0, ДокОбъект.ОстатокНаНачало, 0);
	НачОстКредит = ?(ДокОбъект.ОстатокНаНачало < 0, -ДокОбъект.ОстатокНаНачало, 0);
	
	ОстатокНаКонец = ДокОбъект.ОстатокНаНачало + ДокОбъект.ПоДаннымОрганизации.Итог("Дебет") - ДокОбъект.ПоДаннымОрганизации.Итог("Кредит");
	
	КонОстДебет  = ?(ОстатокНаКонец > 0, ОстатокНаКонец, 0);
	КонОстКредит = ?(ОстатокНаКонец < 0, -ОстатокНаКонец, 0);
	
	ОстатокНаКонецК = -ДокОбъект.ОстатокНаНачало + ДокОбъект.ПоДаннымКонтрагента.Итог("Дебет") - ДокОбъект.ПоДаннымКонтрагента.Итог("Кредит");
	
	КонОстДебетК  = ?(ОстатокНаКонецК > 0, ОстатокНаКонецК, 0);
	КонОстКредитК = ?(ОстатокНаКонецК < 0, -ОстатокНаКонецК, 0);
	
	ОбластьНачОстатки.Параметры.СуммаНачальныйОстатокДт = НачОстДебет;
	ОбластьНачОстатки.Параметры.СуммаНачальныйОстатокКт = НачОстКредит;
	ТабДок.Вывести(ОбластьНачОстатки);
	
	ТабДок.НачатьАвтогруппировкуСтрок();
	
	МаксИндекс = Макс(ДокОбъект.ПоДаннымОрганизации.Количество(), ДокОбъект.ПоДаннымКонтрагента.Количество()) - 1;
	
	Для Инд = 0 По МаксИндекс Цикл
		
		Если Инд < ДокОбъект.ПоДаннымОрганизации.Количество() Тогда
			
			СтрокаОрганизации = ДокОбъект.ПоДаннымОрганизации[Инд];
			Регистратор = 	СтрокаОрганизации.Представление;
			СуммаОборотДт = СтрокаОрганизации.Дебет;
			СуммаОборотКт = СтрокаОрганизации.Кредит;
			
			ОбластьОбороты.Параметры.СуммаОборотДт = СуммаОборотДт;
			ОбластьОбороты.Параметры.СуммаОборотКт = СуммаОборотКт;
			
			ИтСуммаОборотДт = ИтСуммаОборотДт + СуммаОборотДт;
			ИтСуммаОборотКт = ИтСуммаОборотКт + СуммаОборотКт;
			
			ОбластьОбороты.Параметры.РегистраторПредставление = СтрокаОрганизации.Представление;
			ОбластьОбороты.Параметры.Регистратор = СтрокаОрганизации.ДокументРегистратор;
			ОбластьОбороты.Параметры.ДатаДокумента = Формат(СтрокаОрганизации.Дата, "ЧЦ=21; ЧДЦ=2; ДФ=dd.MM.yy");
			
		Иначе
			
			ОбластьОбороты.Параметры.СуммаОборотДт = "";
			ОбластьОбороты.Параметры.СуммаОборотКт = "";
			ОбластьОбороты.Параметры.РегистраторПредставление = "";
			ОбластьОбороты.Параметры.Регистратор = "";
			ОбластьОбороты.Параметры.ДатаДокумента = "";
			
		КонецЕсли;
		
		Если Инд < ДокОбъект.ПоДаннымКонтрагента.Количество() Тогда
			
			СтрокаОрганизации = ДокОбъект.ПоДаннымКонтрагента[Инд];
			
			Регистратор = 	СтрокаОрганизации.Представление;
			СуммаОборотДт = СтрокаОрганизации.Дебет;
			СуммаОборотКт = СтрокаОрганизации.Кредит;
			
			ОбластьОбороты.Параметры.СуммаОборотДтКонтр = СуммаОборотДт;
			ОбластьОбороты.Параметры.СуммаОборотКтКонтр = СуммаОборотКт;
			
			ИтСуммаОборотДтКонтр = ИтСуммаОборотДтКонтр + СуммаОборотДт;
			ИтСуммаОборотКтКонтр = ИтСуммаОборотКтКонтр + СуммаОборотКт;
			
			ОбластьОбороты.Параметры.РегистраторПредставлениеКонтр = СтрокаОрганизации.Представление;
			ОбластьОбороты.Параметры.ДатаДокументаКонтр = Формат(СтрокаОрганизации.Дата, "ЧЦ=21; ЧДЦ=2; ДФ=dd.MM.yy");
			
		Иначе
			
			ОбластьОбороты.Параметры.СуммаОборотДтКонтр = "";
			ОбластьОбороты.Параметры.СуммаОборотКтКонтр = "";
			ОбластьОбороты.Параметры.РегистраторПредставлениеКонтр = "";
			ОбластьОбороты.Параметры.ДатаДокументаКонтр = "";
			
		КонецЕсли;
		
		ТабДок.Вывести(ОбластьОбороты);
		
	КонецЦикла;
	
	ТабДок.ЗакончитьАвтогруппировкуСтрок();
	
	ОбластьОборотыИтог.Параметры.СуммаОборотДт      = ИтСуммаОборотДт;
	ОбластьОборотыИтог.Параметры.СуммаОборотКт      = ИтСуммаОборотКт;
	
	Если ДокОбъект.СверкаСогласована тогда
		
		ОбластьОборотыИтог.Параметры.СуммаОборотДтКонтр = ИтСуммаОборотДтКонтр;
		ОбластьОборотыИтог.Параметры.СуммаОборотКтКонтр = ИтСуммаОборотКтКонтр;
		
	КонецЕсли;
	
	ТабДок.Вывести(ОбластьОборотыИтог);
	
	ОбластьКонОстатки.Параметры.СуммаКонечныйОстатокДт = КонОстДебет;
	ОбластьКонОстатки.Параметры.СуммаКонечныйОстатокКт = КонОстКредит;
	
	Если ДокОбъект.СверкаСогласована тогда
		
		ОбластьКонОстатки.Параметры.СуммаКонечныйОстатокДтКонтр = КонОстДебетК;
		ОбластьКонОстатки.Параметры.СуммаКонечныйОстатокКтКонтр = КонОстКредитК;
		
	КонецЕсли;
	
	ТабДок.Вывести(ОбластьКонОстатки);
	
	// Результаты сверки
	
	Если ДокОбъект.ПоДаннымОрганизации.Количество() = 0 и ДокОбъект.ОстатокНаНачало = 0 Тогда
		РезультатыСверки = "<сверка не проведена>";
	ИначеЕсли НЕ ЗначениеЗаполнено(ДокОбъект.ДатаОкончания) Тогда
		РезультатыСверки = "<не указана дата сверки>";
	ИначеЕсли НЕ ЗначениеЗаполнено(ДокОбъект.Контрагент) Тогда
		РезультатыСверки = "<не указан контрагент>";
	Иначе
		
		РезультатыСверки = "на " + Формат(ДокОбъект.ДатаОкончания, "ДФ=dd.MM.yyyy") + " задолженность ";
		
		Если ОстатокНаКонец > 0 Тогда
			РезультатыСверки = РезультатыСверки + "в пользу " + СокрЛП(НазваниеОрганизации) + " " + Формат(ОстатокНаКонец, "ЧЦ=21; ЧДЦ=2") + " " + строка(ДокОбъект.ВалютаДокумента);
			
		ИначеЕсли ОстатокНаКонец < 0 Тогда
			РезультатыСверки = РезультатыСверки + "в пользу " + СокрЛП(НаименованиеКонтрагента) + " " + Формат(-ОстатокНаКонец, "ЧЦ=21; ЧДЦ=2") + " " + строка(ДокОбъект.ВалютаДокумента);
			
		Иначе
			РезультатыСверки = РезультатыСверки + "отсутствует.";
		КонецЕсли;
		
	КонецЕсли;
	
	ОбластьПодвал.Параметры.РезультатыСверки = РезультатыСверки;
	
	Если ДокОбъект.СверкаСогласована тогда
		
		ОбластьПодвал.Параметры.ПоДаннымКонтрагента = "По данным " + СокрЛП(НаименованиеКонтрагента);
		
		Если ДокОбъект.ПоДаннымКонтрагента.Количество() = 0 и ДокОбъект.ОстатокНаНачало = 0 Тогда
			РезультатыСверки = "<сверка не проведена>";
		ИначеЕсли НЕ ЗначениеЗаполнено(ДокОбъект.ДатаОкончания) Тогда
			РезультатыСверки = "<не указана дата сверки>";
		ИначеЕсли НЕ ЗначениеЗаполнено(ДокОбъект.Контрагент) Тогда
			РезультатыСверки = "<не указан контрагент>";
		Иначе
			
			РезультатыСверки = "на " + Формат(ДокОбъект.ДатаОкончания, "ДФ=dd.MM.yyyy") + " задолженность ";
			
			Если ОстатокНаКонецК < 0 Тогда
				РезультатыСверки = РезультатыСверки + "в пользу " + СокрЛП(НазваниеОрганизации) + " " + Формат(-ОстатокНаКонецК, "ЧЦ=21; ЧДЦ=2") + " " + строка(ДокОбъект.ВалютаДокумента);
				
			ИначеЕсли ОстатокНаКонецК > 0 Тогда
				РезультатыСверки = РезультатыСверки + "в пользу " + СокрЛП(НаименованиеКонтрагента) + " " + Формат(ОстатокНаКонецК, "ЧЦ=21; ЧДЦ=2") + " " + строка(ДокОбъект.ВалютаДокумента);
				
			Иначе
				РезультатыСверки = РезультатыСверки + "отсутствует.";
			КонецЕсли;
			
		КонецЕсли;
		
		ОбластьПодвал.Параметры.РезультатыСверкиК = РезультатыСверки;
		
		Если ОстатокНаКонец+ОстатокНаКонецК <> 0 Тогда
			
			ИтогСверки = "В результате сверки выявлено расхождение информации о состоянии расчетов в размере " 
			   + Формат(?(ОстатокНаКонец + ОстатокНаКонецК > 0, 1, -1) * (ОстатокНаКонец + ОстатокНаКонецК), "ЧЦ=21; ЧДЦ=2") + " " + Строка(ДокОбъект.ВалютаДокумента);
			ОбластьПодвал.Параметры.ИтогСверки = Символы.ПС + ИтогСверки + Символы.ПС + " ";
			
		КонецЕсли; 
		
	КонецЕсли;
	
	ОбластьПодвал.Параметры.НазваниеОрганизации = СокрЛП(НазваниеОрганизации);
	ОбластьПодвал.Параметры.НаименованиеКонтрагента = СокрЛП(НаименованиеКонтрагента);
	
	ОбластьПодвал.Параметры.Должность = "________________";
	ОбластьПодвал.Параметры.ДолжностьК = "________________";
	
	ОбластьПодвал.Параметры.ФИОПредставителя  = "(" + ФИОПредставителя + ")";
	ОбластьПодвал.Параметры.ФИОПредставителяК = "(" + ?(НЕ ЗначениеЗаполнено(ДокОбъект.ПредставительКонтрагента), "_______________________", ДокОбъект.ПредставительКонтрагента) + ")";
	
	ТабДок.Вывести(ОбластьПодвал);
	
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	Возврат ТабДок;
	
КонецФункции

// Получить структуру ИП
//  *Поддержка БП 3.0, УТ 11, КА 2.4, БП 2.0, УТ 10.3, КА 1.1, УПП 1.3
//
// Параметры:
//  Ссылка				 - СправочникСсылка.Организации, СправочникСсылка.Контрагенты	 - 
//  ТекущаяКонфигация	 - Строка	 - Имя конфигурации 
// 
// Возвращаемое значение:
//  Структура - Структура с полями Фамилия, Имя, Отчество, Должность
//
Функция КЗП_СформироватьСтруктуруИП(Ссылка, ТекКонф = Неопределено)
	
	//Changelog
	//
	//28.08.2019 - сделан обход ситуации, когда у контрагента ФИО хранится в полном наименовании
	
	Если НЕ ЗначениеЗаполнено(ТекКонф) Тогда
		ТекКонф = КНП_ИмяКонфигурации();
	КонецЕсли;
	
	СтруктураВозврата = Новый Структура("Фамилия,Имя,Отчество,Должность");
	
	Если ТипЗнч(Ссылка) = Тип("СправочникСсылка.Организации") Тогда
		
		Если ТекКонф = "БП3" Тогда
			
			СтруктураВозврата.Фамилия = Ссылка.ФамилияИП;
			СтруктураВозврата.Имя = Ссылка.ИмяИП;
			СтруктураВозврата.Отчество = Ссылка.ОтчествоИП;
			
		ИначеЕсли ТекКонф = "УТ11" ИЛИ ТекКонф = "КА24" ИЛИ ТекКонф = "БП" ИЛИ ТекКонф = "КА" ИЛИ ТекКонф = "УПП" Тогда
			ЗаполнитьЗначенияСвойств(СтруктураВозврата, КЗП_ПолучитьСтруктуруФИОФизЛица(Ссылка.ИндивидуальныйПредприниматель) );
		ИначеЕсли ТекКонф = "УТ" Тогда
			
			МассивНаименования = КНП_РазобратьНаименованиеИПНаМассив(Ссылка.НаименованиеПолное);
			
			Если МассивНаименования.Количество() > 0 Тогда
				СтруктураВозврата.Фамилия = МассивНаименования[0];
			КонецЕсли;
			
			Если МассивНаименования.Количество() > 1 Тогда
				СтруктураВозврата.Имя = МассивНаименования[1];
			КонецЕсли;
			
			Если МассивНаименования.Количество() > 2 Тогда
				СтруктураВозврата.Отчество = МассивНаименования[2];
			КонецЕсли;	
			
		Иначе
			ДобавитьВЖурнал("Неподдерживаемая конфигурация", "СформироватьСтруктуруИП");	
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Ссылка) = Тип("СправочникСсылка.Контрагенты") Тогда

		НаименованиеПолное = Ссылка.НаименованиеПолное;
		НаименованиеПолное = СтрЗаменить(НаименованиеПолное, "ИП ", "");
		НаименованиеПолное = СтрЗаменить(НаименованиеПолное, "Индивидуальный предприниматель ", "");
		
		МассивНаименования = КНП_РазобратьНаименованиеИПНаМассив(НаименованиеПолное);

		Если МассивНаименования.Количество() > 0 Тогда
			СтруктураВозврата.Фамилия = МассивНаименования[0];
		КонецЕсли;
		
		Если МассивНаименования.Количество() > 1 Тогда
			СтруктураВозврата.Имя = МассивНаименования[1];
		КонецЕсли;
		
		Если МассивНаименования.Количество() > 2 Тогда
			СтруктураВозврата.Отчество = МассивНаименования[2];
		КонецЕсли;
		
	КонецЕсли;
	
	СтруктураВозврата.Должность = "Индивидуальный предприниматель";
	Возврат СтруктураВозврата;

КонецФункции

Функция КЗП_ПолучитьТекстЗапросаКорректировка()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(""Корректировка реализации"" КАК СТРОКА(50) ),
	|	Корректировка.Номер,
	|	Корректировка.Дата,
	|	ВЫБОР
	|		КОГДА Корректировка.Грузополучатель.DS_Подразделение_ID > 0
	|			ТОГДА Корректировка.Грузополучатель
	|		ИНАЧЕ Корректировка.Контрагент
	|	КОНЕЦ,
	|	Корректировка.СуммаДокумента,
	|	Корректировка.Ссылка,
	|	МАКСИМУМ(ЕСТЬNULL(СчетФактураВыданныйДокументыОснования.Ссылка, НЕОПРЕДЕЛЕНО))
	|ИЗ
	|	Документ.{КЗП_КорректировкаРеализации} КАК Корректировка
	|ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
	|	ПО (СчетФактураВыданныйДокументыОснования.ДокументОснование = Корректировка.Ссылка
	|			И СчетФактураВыданныйДокументыОснования.Ссылка.Проведен)
	|ГДЕ
	|	Корректировка.Организация = &Организация
	|	И Корректировка.Проведен = ИСТИНА
	|	И ВЫБОР
	|		КОГДА Корректировка.Грузополучатель.DS_Подразделение_ID > 0
	|			ТОГДА Корректировка.Грузополучатель В (&Контрагент)
	|		ИНАЧЕ Корректировка.ДоговорКонтрагента В (&Договор)
	|	КОНЕЦ
	|	И (Корректировка.Дата >= Корректировка.ДоговорКонтрагента.ДатаНачалаОбменаЭДО)
	|	{КорректировкаДата}
	|	{КорректировкаКомментарий}
	|
	|СГРУППИРОВАТЬ ПО
	|Корректировка.Ссылка,
	|Корректировка.Номер,
	|Корректировка.Дата,
	|Корректировка.СуммаДокумента,
	|ВЫБОР
	|	КОГДА Корректировка.Грузополучатель.DS_Подразделение_ID > 0
	|		ТОГДА Корректировка.Грузополучатель
	|	ИНАЧЕ Корректировка.Контрагент
	|КОНЕЦ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция КЗП_УНФ_ПолучитьТекстЗапросаАкта()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(""Акт сдачи-приема"" КАК СТРОКА(50)),
	|	Акт.Номер,
	|	Акт.Дата,
