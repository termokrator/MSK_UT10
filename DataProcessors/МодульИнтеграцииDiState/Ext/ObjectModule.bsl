Процедура ЭДО_ОбработатьЭД(МассивЭД, ТаблицаДанных)
	
	Для Каждого ЭД Из МассивЭД Цикл
		
		СтрокаТЧ 											= ТаблицаДанных.Добавить();
		
		Если ВерсияСервера >= 6 Тогда
			
			СтрокаТЧ.Тип 										= ЭДО_РазобратьТипДокумента(ЭД.Получить("documentTypeSystemName"), ЭД.Получить("packageFlowSystemName") );
			СтрокаТЧ.Номер										= ЭД.Получить("documentNumber");
			СтрокаТЧ.Дата										= КНП_ПривестиКДате(ЭД.Получить("documentDate") );
			СтрокаТЧ.Отправитель								= ЭД.Получить("fromCompanyName");
			СтрокаТЧ.ИдентификаторКонтрагента 					= ЭД.Получить("fromCompanyId");
			СтрокаТЧ.ИдентификаторПодразделения 				= ЭД.Получить("fromDivisionId");
			СтрокаТЧ.ИдентификаторДокумента 					= ЭД.Получить("documentId"); 
			СтрокаТЧ.ИдентификаторПакета 						= ЭД.Получить("packageId");
			//Работа с контейнерами
			СтрокаТЧ.ИДКонтейнера 								= ЭД.Получить("containerUid");
			
			Если ЗначениеЗаполнено(СтрокаТЧ.ИДКонтейнера) Тогда
				СтрокаТЧ.СвязныйКонтейнер 						= (ЭД.Получить("containerType") <> "decoupled");
			КонецЕсли;
			
		Иначе
			
			СтрокаТЧ.Тип 										= ЭД.Получить("document_type_title");
			СтрокаТЧ.Номер 										= ЭД.Получить("document_number");
			СтрокаТЧ.Дата 										= Дата(ЭД.Получить("created_at") );
			СтрокаТЧ.Отправитель 								= ЭД.Получить("from_company_name");
			СтрокаТЧ.ИдентификаторКонтрагента 					= ЭД.Получить("from_company_id");
			СтрокаТЧ.ИдентификаторПодразделения 				= ЭД.Получить("from_division_id");
			СтрокаТЧ.ИдентификаторДокумента 					= ЭД.Получить("document_id"); 
			СтрокаТЧ.ИдентификаторПакета 						= ЭД.Получить("package_id");  	
			
		КонецЕсли;
		
		СтрокаТЧ.ДанныеДокумента 							= ЭДО_ПолучитьДанныеДокумента(СтрокаТЧ.ИдентификаторДокумента).Контент;
		СтрокаТЧ.Ссылка 									= РС_ПолучитьДокументПоИдентификатору(СтрокаТЧ.ИдентификаторДокумента);
		СтрокаТЧ.Контрагент = РС_ПолучитьПодразделениеПоИдентификатору(СтрокаТЧ.ИдентификаторПодразделения);	
		СтрокаТЧ.СуммаДокумента = 0;
		
	КонецЦикла;

КонецПроцедуры

Функция ЭДО_РазобратьТипДокумента(Знач ИмяТипа, Знач ГруппаПроцессинга, Знач АльтернативноеИмя = Неопределено)
	
	Результат = ИмяТипа;
	НайденТип = Ложь;
	
	Если ИмяТипа = "on_nschfdoppr" ИЛИ ИмяТипа = "on_schfdoppr" Тогда
		
		НайденТип = Истина;
		Результат = "Универсальный передаточный документ";
		
		Если ГруппаПроцессинга = "universal_waybill"
			ИЛИ
			Найти(ГруппаПроцессинга, "universal_transfer_document_waybill")
			Тогда
			Результат = "Универсальный передаточный документ (ДОП)";	
		КонецЕсли;	
		
		Если ГруппаПроцессинга = "universal_invoice"
			ИЛИ
			(Найти(ГруппаПроцессинга, "universal_transfer_document_invoice")
			И НЕ Найти(ГруппаПроцессинга, "waybill") )
			Тогда
			Результат = "Универсальный передаточный документ (СЧФ)";	
		КонецЕсли;
		
		Если ГруппаПроцессинга = "invoice_utd" Тогда
			Результат = "Счет-фактура";	
		КонецЕсли;
		
	КонецЕсли;
	
	Если ИмяТипа = "on_korschfdoppr" Тогда         
		
		НайденТип = Истина;
		Результат = "Универсальный корректировочный документ";
		
		Если Найти(ГруппаПроцессинга, "universal_correction_document_waybill") Тогда
			Результат = "Универсальный корректировочный документ (ДИС)";	
		КонецЕсли;
		
		Если Найти(ГруппаПроцессинга, "universal_correction_document_invoice") И НЕ Найти(ГруппаПроцессинга, "waybill") Тогда
			Результат = "Универсальный корректировочный документ (КСЧФ)";
		КонецЕсли;
		
		Если ГруппаПроцессинга = "invoice_correction_ucd" Тогда
			Результат = "Корректировочная Счет-фактура";
		КонецЕсли;
		
	КонецЕсли;
	
	Если ИмяТипа = "dp_tovtorgpr" Тогда
		
		НайденТип = Истина;
		Результат = "Товарная накладная";
		
	КонецЕсли;
	
	Если ИмяТипа = "universal" Тогда
		
		НайденТип = Истина;
		Результат = "Неформализованный документ";
		
	КонецЕсли;
	
	Если ИмяТипа = "bill" Тогда
		
		НайденТип = Истина;
		Результат = "Счет на оплату";
		
	КонецЕсли;
	
	Если ИмяТипа = "dp_rezruisp" Тогда
		
		НайденТип = Истина;
		Результат = "Акт выполненных работ";
		
	КонецЕсли;			
	
	Если НЕ НайденТип И АльтернативноеИмя <> Неопределено Тогда
		Результат = АльтернативноеИмя;
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция ЭДО_РазобратьОжидаемоеДействие(Знач СтрокаДействия, Знач ГруппаПроцессинга, Знач Направление)
	//Changelog
	//
	//28.08.2019 Поправлены названия статусов
	//30.08.2019 - еще одна правка статусов
	//22.10.2019 - исправление статуса для Акт 552
	
	Результат = СтрокаДействия;
	
	Если ГруппаПроцессинга = "informationMessage" Тогда
		
	КонецЕсли;
	
	Если СтрокаДействия = "waiting_of_receiving_confirmation" Тогда 
		Результат = "Ожидается подтверждение о получении" 
	КонецЕсли;
	
	Если ГруппаПроцессинга = "bill" Тогда
		
		Если СтрокаДействия = "received" И Направление = "IN" Тогда 
			Результат = "Требуется подписать извещение о получении" 
		КонецЕсли;
		
	КонецЕсли;
	
	Если ГруппаПроцессинга = "universal_invoice_and_waybill"
		ИЛИ
		Найти(ГруппаПроцессинга, "universal_transfer_document_invoice_and_waybill")	
		Тогда
		
		Если СтрокаДействия = "received" И Направление = "IN" Тогда Результат = "Требуется подписать извещение о получении" КонецЕсли;
		Если СтрокаДействия = "waiting_of_signing" Тогда Результат = "Требуется подписать извещение от оператора" КонецЕсли;
