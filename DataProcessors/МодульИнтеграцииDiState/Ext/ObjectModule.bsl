Функция API_СоздатьXMLДокумента(СсылкаНаДокумент, СтруктураЗапроса, УниверсальныйФормат = Ложь)
	
	ЗаголовкиЗапроса = СформироватьЗаголовкиДляАПИ();
	Адрес = "";
	
	Если ВерсияAPI = "v1.2" ИЛИ ВерсияAPI = "v1.3" Тогда
		
		Если МОП_ЭтоРеализацияТоваров(СсылкаНаДокумент) И НЕ УниверсальныйФормат Тогда
			Адрес = "/api/service/document/create/waybill551";	
		КонецЕсли;
		
		Если (МОП_ЭтоРеализацияТоваров(СсылкаНаДокумент) ИЛИ МОП_ЭтоАктВыполненныхРабот(СсылкаНаДокумент) )
			И УниверсальныйФормат Тогда
			Адрес = "/api/service/document/create/universal_transfer_document_invoice_and_waybill"; // universal_transfer_document_waybill";	
		КонецЕсли;
		
		Если МОП_ЭтоСчетФактура(СсылкаНаДокумент) И УниверсальныйФормат Тогда
			
			Если МОП_ЭтоКорректировкаРеализации(МОП_ПолучитьСсылкуНаКорректировку(СсылкаНаДокумент) ) Тогда
				Адрес = "/api/service/document/create/universal_correction_document_invoice_and_waybill";	
			Иначе
				Адрес = "/api/service/document/create/universal_transfer_document_invoice_and_waybill";
			КонецЕсли;
			
		КонецЕсли;
		
		Если МОП_ЭтоСчетФактура(СсылкаНаДокумент) И НЕ УниверсальныйФормат Тогда
			
			Если МОП_ЭтоКорректировкаРеализации(МОП_ПолучитьСсылкуНаКорректировку(СсылкаНаДокумент) ) Тогда
				Адрес = "/api/service/document/create/invoice_correction_ucd";		
			Иначе
				Адрес = "/api/service/document/create/invoice_utd";	
			КонецЕсли;
			
		КонецЕсли;
		
		Если МОП_ЭтоСчетНаОплату(СсылкаНаДокумент) Тогда
			Адрес = "/api/service/document/create/bill";
		КонецЕсли;
		
		Если МОП_ЭтоАктВыполненныхРабот(СсылкаНаДокумент) И НЕ УниверсальныйФормат Тогда
			Адрес = "/api/service/document/create/act552";	
		КонецЕсли;
		
		Если МОП_ЭтоКорректировкаРеализации(СсылкаНаДокумент) Тогда
			Адрес = "/api/service/document/create/universal_correction_document_invoice_and_waybill"; //Белов universal_correction_document_waybill";
		КонецЕсли;
		
		//+Макрушин Е. 07.04.2026 #UT10-5800
		Если МОП_ЭтоАктОРасхожденияхПослеПриемки(СсылкаНаДокумент) Тогда
			Адрес = "/api/service/document/create/torg2"; 
		КонецЕсли;		
		//-Макрушин Е. 07.04.2026 #UT10-5800  
		
		//+Белов А. 17.06.2026 #UT10-5921
		Если МОП_ЭтоТранспортнаяНакладная(СсылкаНаДокумент) Тогда
			Адрес = "/api/service/document/create/tn"; 
		КонецЕсли;	
		
		Если МОП_ЭтоЗаказЗаявка(СсылкаНаДокумент) Тогда
			Адрес = "/api/service/document/create/or"; 
		КонецЕсли;	
		//-Белов А. 17.06.2026 #UT10-5921
		
	КонецЕсли;
	
	Возврат ОбменHTTPJSON(HostAddress + Адрес, ЗаголовкиЗапроса, Истина, СтруктураЗапроса.ТелоЗапроса);	

КонецФункции

