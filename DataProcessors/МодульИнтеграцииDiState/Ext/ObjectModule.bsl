Функция КЗП_УТ11_ПолучитьТекстЗапросаАктаИСФАванс()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(""Акт сдачи-приема"" КАК СТРОКА(50)),
	|	Акт.Номер,
	|	Акт.Дата,
	|	Акт.Контрагент,
	|	Акт.СуммаДокумента,
