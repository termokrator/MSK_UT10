Функция ЭДО_МассовоСоздатьДокументы(МассивСтруктур)
	
	Если ТипЗнч(МассивСтруктур) <> Тип("Массив") Тогда
		
		ДобавитьВЖурнал("Некорректный тип параметра ""МассивСтруктур""", "ЭДО_МассовоСоздатьДокументы");
		Возврат Неопределено;
		
	КонецЕсли;
	
	ТаблицаМассивУИД = Новый ТаблицаЗначений;
	ТаблицаМассивУИД.Колонки.Добавить("Ссылка");
	ТаблицаМассивУИД.Колонки.Добавить("ТипДокумента");
	ТаблицаМассивУИД.Колонки.Добавить("УИД");
	
	ТелоЗапросаСтруктура = Новый Структура("requests", Новый Массив);
	
	Для Каждого ЭлементМассива Из МассивСтруктур Цикл
		
		СтруктураЗапроса = Новый Структура("request,documentType,trackingNumber");
		
		СтруктураТелаЗапроса = Новый Структура;
		СтруктураТелаЗапроса.Вставить("from", ИдентификаторПодразделения);
		ИдентификаторыКонтрагента = РС_ПолучитьИдентификаторыКонтрагента(ЭлементМассива.Контрагент);
		
		Если ЗначениеЗаполнено(ИдентификаторыКонтрагента) И ИдентификаторыКонтрагента.Свойство("ИдентификаторПодразделения") Тогда
			СтруктураТелаЗапроса.Вставить("to", ИдентификаторыКонтрагента.ИдентификаторПодразделения);	
		КонецЕсли;   
		
		//+Белов А. 14.07.2026 #UT10-5954
		Если ЭлементМассива.ТипДокумента = "Транспортная накладная" Тогда
			СтруктураТелаЗапроса.Вставить("carrier", ФОД_ПолучитьИдентификаторПеревозчика("", ЭлементМассива.СсылкаНаДокумент));	
		КонецЕсли;
		//-Белов А. 14.07.2026 #UT10-5954
		
		Если ЗначениеЗаполнено(ЭлементМассива.СсылкаНаДокумент) Тогда
			
			Если МОП_ЭтоНеформализованныйДокумент(ЭлементМассива.СсылкаНаДокумент) Тогда
				
				СтруктураНеформализованного = ПолучитьДанныеНеформализованногоДокумента(ЭлементМассива.СсылкаНаДокумент);
				
				Для Каждого ЭлементСтруктуры Из СтруктураНеформализованного Цикл
					
					Если НЕ СтруктураТелаЗапроса.Свойство(ЭлементСтруктуры.Ключ) Тогда
						СтруктураТелаЗапроса.Вставить(ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Значение);
					КонецЕсли;
					
				КонецЦикла;
				
			Иначе
				
				КорректируемыйДокумент = Неопределено;
				
				Если МОП_ЭтоКорректировкаРеализации(ЭлементМассива.СсылкаНаДокумент) Тогда
					КорректируемыйДокумент = МОП_ПолучитьСсылкуНаКорректировку(ЭлементМассива.СсылкаНаДокумент);
				ИначеЕсли МОП_ЭтоКорректировкаРеализации(МОП_ПолучитьСсылкуНаКорректировку(ЭлементМассива.СсылкаНаДокумент) ) Тогда
					КорректируемыйДокумент = МОП_ПолучитьСсылкуНаКорректировку(МОП_ПолучитьСсылкуНаКорректировку(ЭлементМассива.СсылкаНаДокумент) );					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		СтруктураТелаЗапроса.Вставить("content", ЭлементМассива.Контент);
		
		СтруктураЗапроса.request = СтруктураТелаЗапроса;
		СтруктураЗапроса.documentType = ЭДО_ОпределитьТипДокументаДляЭДО(ЭлементМассива.ТипДокумента);
		СтруктураЗапроса.trackingNumber = Строка(ЭлементМассива.СсылкаНаДокумент.УникальныйИдентификатор() );
		
		СтрокаТаблицыСоответствий = ТаблицаМассивУИД.Добавить();
		СтрокаТаблицыСоответствий.Ссылка = ЭлементМассива.СсылкаНаДокумент;
		СтрокаТаблицыСоответствий.УИД = СтруктураЗапроса.trackingNumber;
		СтрокаТаблицыСоответствий.ТипДокумента = ЭлементМассива.ТипДокумента;
		ТелоЗапросаСтруктура.requests.Добавить(СтруктураЗапроса);
		
	КонецЦикла;
	
	ТелоЗапроса = КНП_ЗаписатьJSONНаСервере(ТелоЗапросаСтруктура);
	Результат = API_МассовоеСозданиеДокументов(ТелоЗапроса);
	МассивДокументов = Новый Массив;
	
	Если ТипЗнч(Результат) <> Тип("Соответствие") Тогда
		Возврат МассивДокументов;
	КонецЕсли;
	
	МассивЭлементовОтвета = Результат.Получить("requests");
	
	Для Каждого ЭлементОтвета Из МассивЭлементовОтвета Цикл
		
		УИДДокумента = ЭлементОтвета.Получить("trackingNumber");
		СтрокаСоответствия = ТаблицаМассивУИД.Найти(УИДДокумента, "УИД");
		
		Если СтрокаСоответствия = Неопределено Тогда
			
			ДобавитьВЖурнал("Не удалось определить ссылку по уид-у " + УИДДокумента, "МассовоСоздатьДокументыВЭДО");
			Продолжить;
			
		КонецЕсли;
		
		Если ЭлементОтвета.Получить("success") = Истина Тогда
			
			ЭтоУПД = (СтрокаСоответствия.ТипДокумента = "УПД") ИЛИ Найти(СтрокаСоответствия.ТипДокумента, "Универсальный");
			РС_ПривязатьИдентификаторКОбъекту1С(СтрокаСоответствия.Ссылка, ЭлементОтвета.Получить("documentId"), Истина, ЭтоУПД);
			
		КонецЕсли;
		
		СтруктураДанныхОбъекта = Новый Структура("Ссылка,Результат", СтрокаСоответствия.Ссылка, ЭлементОтвета);
		МассивДокументов.Добавить(СтруктураДанныхОбъекта);
		
	КонецЦикла;
	
	Возврат МассивДокументов;
	
КонецФункции

Функция ЭДО_МассовоОтправитьПодписанныеДокументы(МассивСтруктур)	
	
	Если ТипЗнч(МассивСтруктур) <> Тип("Массив") Тогда
		
		ДобавитьВЖурнал("Некорректный тип параметра ""МассивСтруктур""", "МассовоОтправитьПодписанныеДокументы");  
		Возврат Неопределено;
		
	КонецЕсли;
	
	ТелоЗапросаСтруктура = Новый Структура("requests", Новый Массив);
	
	Для Каждого ЭлементМассива Из МассивСтруктур Цикл
		
		СтруктураЗапроса = Новый Структура("documentId,request,trackingNumber");
		
		СтруктураТелаЗапроса = Новый Структура;
		СтруктураТелаЗапроса.Вставить("content", ЭлементМассива.Контент);
		СтруктураТелаЗапроса.Вставить("signature", КНП_ОбработатьСтрокуBase64(ЭлементМассива.Подпись) );
		
		СтруктураЗапроса.request = СтруктураТелаЗапроса;
		СтруктураЗапроса.documentId = ЭлементМассива.ИдентификаторДокумента;
		СтруктураЗапроса.trackingNumber = Строка(ЭлементМассива.ИдентификаторДокумента);
		ТелоЗапросаСтруктура.requests.Добавить(СтруктураЗапроса);
		
	КонецЦикла;
	
	ТелоЗапроса = КНП_ЗаписатьJSONНаСервере(ТелоЗапросаСтруктура);
	Результат = API_МассовоеПодписаниеДокументов(ТелоЗапроса);
	
	Если ТипЗнч(Результат) <> Тип("Соответствие") Тогда
		
		ВывестиУведомлениеПользователю(Результат);
		Результат = Неопределено;
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции


Функция ЭДО_ПолучитьСписокКонтрагентовВСистеме(МассивИНН)
	
	ДанныеСписка = API_МассовыйПоискПоИНН(МассивИНН);
	Результат = Новый Массив;
	
	Если ТипЗнч(ДанныеСписка) <> Тип("Соответствие") Тогда
		
		ЗаписатьЖурналВФайл();
		Возврат Результат;
		
	КонецЕсли;
	
	Если ТипЗнч(ДанныеСписка) = Тип("Соответствие") И ДанныеСписка.Получить("success") = Истина И ТипЗнч(ДанныеСписка.Получить("rows") ) = Тип("Массив") Тогда
		
		МассивДанных = ДанныеСписка.Получить("rows");
		
		Для Каждого ЭлементСписка Из МассивДанных Цикл
			
			СтруктураДанных = Новый Структура("ИНН,ИдентификаторКонтрагента,Пригласить");
			СтруктураДанных.ИНН = ЭлементСписка.Получить("inn");
			СтруктураДанных.ИдентификаторКонтрагента = ЭлементСписка.Получить("id");
			СтруктураДанных.Пригласить = ЭлементСписка.Получить("relation") = Неопределено;
			Результат.Добавить(СтруктураДанных);
			
		КонецЦикла;
		
	КонецЕсли;
	
	ЗаписатьЖурналВФайл();
	Возврат Результат;

КонецФункции

Функция ЭДО_ПолучитьСписокДоступныхСертификатов(АдресСервера, СписокОтпечатков)
	
	КНП_СкорректироватьАдресСервера(АдресСервера);	
	МассивДоступныхОтпечатков = Новый Массив;
	
	Если ТипЗнч(СписокОтпечатков) <> Тип("Массив") Тогда
		Возврат МассивДоступныхОтпечатков;
	КонецЕсли;
	
	Результат = API_ПолучитьСписокДоступныхСертификатов(СписокОтпечатков);
	
	Если ТипЗнч(Результат) = Тип("Соответствие") И Результат.Получить("success") = Истина Тогда
		
		Для Каждого Отпечаток Из Результат.Получить("thumbprints") Цикл  
			МассивДоступныхОтпечатков.Добавить(Отпечаток.Получить("thumbprint") );
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(Результат) = Тип("Строка") Тогда
		
		СтрокаТелаЗапроса = "front/certificate/diff?";
		
		Для Каждого Отпечаток Из СписокОтпечатков Цикл
			СтрокаТелаЗапроса = СтрокаТелаЗапроса + "thumbprints" + КНП_URLEncode("[]") + "=" + Отпечаток + "&";
		КонецЦикла;
		
		ЗаголовкиЗапроса = Новый Соответствие;
		ЗаголовкиЗапроса.Вставить("Cookie", "PHPSESSID=4nu3vk6u0o9n8d7vqd48b5v081");
		
		СтрокаТелаЗапроса = Лев(СтрокаТелаЗапроса, СтрДлина(СтрокаТелаЗапроса) - 1);
		СтруктураОтвета = ОтправитьGetЗапрос(HostAddress + СтрокаТелаЗапроса, ЗаголовкиЗапроса);
		
		Если СтруктураОтвета.КодОтвета = 404 Тогда
			
			СтрокаТелаЗапроса = СтрЗаменить(СтрокаТелаЗапроса, "front/", "auth/");
			СтруктураОтвета = ОтправитьGetЗапрос(HostAddress + СтрокаТелаЗапроса, ЗаголовкиЗапроса);
			
		КонецЕсли;
		
		ТекстОтвета = СтруктураОтвета.Ответ;
		
		Если НЕ ЗначениеЗаполнено(СтруктураОтвета.Заголовки) Тогда
			
			ВывестиУведомлениеПользователю(СтруктураОтвета.Ответ);
			Возврат Неопределено;
			
		Иначе
			
			Попытка
				
				ТекстJSON = КНП_ПрочитатьJSONОтСервера(ТекстОтвета);
				МассивОтпечатков = ТекстJSON.Получить("thumbprints");
				
				Если ТипЗнч(МассивОтпечатков) = Тип("Массив") Тогда
					
					Для Каждого ЭлементОтпечатка Из МассивОтпечатков Цикл
						МассивДоступныхОтпечатков.Добавить(ЭлементОтпечатка.Получить("thumbprint") );
					КонецЦикла;
					
				КонецЕсли;		
				
			Исключение
				
				ДобавитьВЖурнал("Не удалось получить перечень сертификатов: " + ИнформацияОбОшибке().Причина.Описание, "ПолучитьСписокДоступныхСертификатов");
				
				Если СтруктураОтвета.КодОтвета = 502 ИЛИ СтруктураОтвета.КодОтвета = 500 ИЛИ СтруктураОтвета.КодОтвета = 503 Тогда
					ВывестиУведомлениеПользователю("На сервере произошла непредвиденная ошибка. Повторите ваш запрос позже");
				ИначеЕсли СтруктураОтвета.КодОтвета = 404 Тогда
					ВывестиУведомлениеПользователю("Отправлен запрос на несуществующий метод. Обратитесь к разработчику!");
				ИначеЕсли СтруктураОтвета.КодОтвета <> 200 Тогда
					ВывестиУведомлениеПользователю("Ответ от сервера не соответствует ожидаемому. Для получения подробностей обратитесь к журналу регистрации обработки");
				Иначе
					ВывестиУведомлениеПользователю(ИнформацияОбОшибке().Причина.Описание);
				КонецЕсли;
				
			КонецПопытки;
			
		КонецЕсли;
		
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат МассивДоступныхОтпечатков;

КонецФункции

Функция ЭДО_ПолучитьСписокДокументовВОбработке(ДатаНачала = Неопределено, ДатаКонца = Неопределено)
	
	ТаблицаДанных = ДокументыВОбработке.Выгрузить();
	ТаблицаДанных.Очистить();
	
	СтруктураПараметров = Новый Соответствие;
	СтруктураПараметров.Вставить("packageGroupStates[0]", "processing");
	ДанныеДокументов = API_ПолучитьСписокПакетов(СтруктураПараметров);
	
	Если ТипЗнч(ДанныеДокументов) <> Тип("Соответствие") Тогда
		
		ЗаписатьЖурналВФайл();
		Возврат ТаблицаДанных;
		
	КонецЕсли;
	
	Если ДанныеДокументов.Получить("success") <> Неопределено И ДанныеДокументов.Получить("success") Тогда
		
		СписокДокументов = ДанныеДокументов.Получить("rows");
		
		Если СписокДокументов <> Неопределено И СписокДокументов.Количество() > 0 Тогда
			
			Для Каждого ДокументВОбработке Из СписокДокументов Цикл
				
				СистемноеИмяДокумента = ДокументВОбработке.Получить("documentTypeSystemName");
				СтатусПакета = ДокументВОбработке.Получить("packageStateSystemName");
				
				Если ДокументВОбработке.Получить("subFlowStateSystemName") <> Неопределено  Тогда
					СтатусПакета = ДокументВОбработке.Получить("subFlowStateSystemName");
				КонецЕсли;
				
				Если ДокументВОбработке.Получить("documentStatusSystemName") = "draft" Тогда 
					Продолжить 
				КонецЕсли;
				
				Если СтатусПакета = "complete" ИЛИ Найти(СтатусПакета, "declined") ИЛИ СтатусПакета = "accepted" ИЛИ СтатусПакета = "interrupted" Тогда
					Продолжить;
				КонецЕсли;
				
				ДатаДокумента = КНП_ПривестиКДате(ДокументВОбработке.Получить("documentDate") );
				
				Если ТипЗнч(ДатаДокумента) <> Тип("Дата") Тогда
					Продолжить;
				КонецЕсли;
				
				Если ТипЗнч(ДатаНачала) = Тип("Дата") Тогда
					
					Если ДатаДокумента < ДатаНачала Тогда
						Продолжить;
					КонецЕсли;
					
				КонецЕсли;
				
				Если ТипЗнч(ДатаКонца) = Тип("Дата") Тогда
					
					Если ДатаДокумента > ДатаКонца Тогда
						Продолжить;
					КонецЕсли;
					
				КонецЕсли;
				
				СтрокаТаблицы = ТаблицаДанных.Добавить();
				
				Если ДокументВОбработке.Получить("packageType") = "OUT" Тогда
					СтрокаТаблицы.Исходящий = Истина;
				КонецЕсли;
				
				СтрокаТаблицы.Номер = ДокументВОбработке.Получить("documentNumber");
				СтрокаТаблицы.Дата = ДатаДокумента; 
				СтрокаТаблицы.ИдентификаторОтправителя = ДокументВОбработке.Получить("fromDivisionId");					
				СтрокаТаблицы.ИдентификаторПолучателя = ДокументВОбработке.Получить("toDivisionId");
				ИдОтправителя = ДокументВОбработке.Получить("fromCompanyId");
				ИдПолучателя = ДокументВОбработке.Получить("toCompanyId");
				СтрокаТаблицы.Отправитель = РС_ПолучитьОрганизациюКонтрагентаПоИдентификатору(СтрокаТаблицы.ИдентификаторОтправителя, ИдОтправителя);
				СтрокаТаблицы.Получатель = РС_ПолучитьОрганизациюКонтрагентаПоИдентификатору(СтрокаТаблицы.ИдентификаторПолучателя, ИдПолучателя);
				СтрокаТаблицы.ИдентификаторДокумента = ДокументВОбработке.Получить("documentId");
				СтрокаТаблицы.ГруппаПроцессинга = ДокументВОбработке.Получить("packageFlowSystemName");
				СтрокаТаблицы.ОжидаемыеДействия = ЭДО_РазобратьОжидаемоеДействие(СтатусПакета, 
				СтрокаТаблицы.ГруппаПроцессинга, 
				ДокументВОбработке.Получить("packageType") );
				СтрокаТаблицы.Тип = ЭДО_РазобратьТипДокумента(СистемноеИмяДокумента, СтрокаТаблицы.ГруппаПроцессинга);
				СтрокаТаблицы.ГруппаПроцессинга = ДокументВОбработке.Получить("packageFlowGroup") + "_" + СтрокаТаблицы.ГруппаПроцессинга;
				СтрокаТаблицы.СистемноеИмя = СистемноеИмяДокумента;
				//Работа с контейнерами
				СтрокаТаблицы.ИДКонтейнера = ДокументВОбработке.Получить("containerUid");
				
				Если ЗначениеЗаполнено(СтрокаТаблицы.ИДКонтейнера) Тогда
					СтрокаТаблицы.СвязныйКонтейнер = (ДокументВОбработке.Получить("containerType") <> "decoupled");
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;	
		
	КонецЕсли;
	
	ТаблицаДанных.Сортировать("ИдентификаторДокумента Убыв");
	Возврат ТаблицаДанных;

КонецФункции

Функция ЭДО_ПолучитьСписокДокументовНаПодпись()
	
