Функция ЗагрузкаДокументов(ДатаНачала, ДатаКонца) 								Экспорт
	
	ТаблицаДанных = ВходящиеДокументы.Выгрузить();
	ТаблицаДанных.Очистить();
	МассивВходящихПакетов = ЭДО_ЗагрузитьМассивВходящихЭД(ДатаНачала, ДатаКонца);
	
	Если ЗначениеЗаполнено(МассивВходящихПакетов) И ЗначениеЗаполнено(МассивВходящихПакетов.МассивПакетов) Тогда
		ЭДО_ОбработатьЭД(МассивВходящихПакетов.МассивПакетов, ТаблицаДанных);
	ИначеЕсли ЗначениеЗаполнено(МассивВходящихПакетов.ОписаниеОшибки) Тогда
		
		ЗаписатьЖурналВФайл();
		Возврат МассивВходящихПакетов.ОписаниеОшибки;
		
	КонецЕсли;
	
	ЗаписатьЖурналВФайл();
	Возврат ТаблицаДанных;

КонецФункции

