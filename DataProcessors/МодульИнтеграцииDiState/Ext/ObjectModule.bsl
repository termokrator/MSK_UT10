	Если КНП_ПривестиКДате(СтруктураДокумента.Дата) >= Дата(2021,7,1) Тогда
		
		Макет = ПолучитьМакет("ПФ_УКД_534_Поставщик");
		ЗаголовокДокумента 			= Макет.ПолучитьОбласть("ЗаголовокДокумента");
		ОбластьОснования 			= Макет.ПолучитьОбласть("ОбластьОснования");
		Шапка 						= Макет.ПолучитьОбласть("Шапка");
		ИдентификаторГосКонтракта 	= Макет.ПолучитьОбласть("ИдентификаторГосКонтракта");
		ЗаголовокТаблицы			= Макет.ПолучитьОбласть("ЗаголовокТаблицы");
		Строка						= Макет.ПолучитьОбласть("ОбластьСтрока");
		СтрокаДоп					= Макет.ПолучитьОбласть("ОбластьСтрокаДоп");
		Итого 						= Макет.ПолучитьОбласть("Итого");
		Подвал 						= Макет.ПолучитьОбласть("Подвал");
		ПодвалНакладная				= Макет.ПолучитьОбласть("ПодвалНакладной");
		
		ЗаполнитьЗначенияСвойств(ЗаголовокДокумента.Параметры, СтруктураДокумента);
		ЗаполнитьЗначенияСвойств(ОбластьОснования.Параметры, СтруктураДокумента);	
		ЗаполнитьЗначенияСвойств(Шапка.Параметры, СтруктураДокумента);
		ЗаполнитьЗначенияСвойств(ИдентификаторГосКонтракта.Параметры, СтруктураДокумента);
		ЗаполнитьЗначенияСвойств(Итого.Параметры, СтруктураДокумента);
		ЗаполнитьЗначенияСвойств(Подвал.Параметры, СтруктураДокумента);
		ЗаполнитьЗначенияСвойств(ПодвалНакладная.Параметры, СтруктураДокумента);
		
		Если СтруктураДокумента.ТипУПД = "ДИС" Тогда
			Шапка.Параметры.СтатусУКД = 2;
		Иначе
			Шапка.Параметры.СтатусУКД = 1;
		КонецЕсли;
		
		ТабДок.Вывести(ЗаголовокДокумента);
		ТабДок.Вывести(ОбластьОснования);
		ТабДок.Вывести(Шапка);
		ТабДок.Вывести(ИдентификаторГосКонтракта);
		ТабДок.Вывести(ЗаголовокТаблицы);
		
		Для Каждого СтрокаТЧ Из СтруктураДокумента.ТабличнаяЧасть Цикл
			
			ЗаполнитьЗначенияСвойств(Строка.Параметры, СтрокаТЧ);	
			ЗаполнитьЗначенияСвойств(СтрокаДоп.Параметры, СтрокаТЧ);
			
			Если ЗначениеЗаполнено(СтрокаТЧ.ИнфоПоля) Тогда
				ТабДок.Вывести(СтрокаДоп);
			Иначе
				ТабДок.Вывести(Строка);
			КонецЕсли;
			
		КонецЦикла;
		
		ТабДок.Вывести(Итого);	
		ТабДок.Вывести(Подвал);	
		
		Если СтруктураДокумента.ТипУПД <> "СЧФ" Тогда
			ТабДок.Вывести(ПодвалНакладная);	
		КонецЕсли;
		
		Если СтруктураДокумента.Свойство("ИдентификаторЭД") Тогда
			
			ОбластьСведенияЭД = Макет.ПолучитьОбласть("ОбластьСведенияОбЭД");
			ЗаполнитьЗначенияСвойств(ОбластьСведенияЭД.Параметры, СтруктураДокумента);
			ТабДок.Вывести(ОбластьСведенияЭД);
			
		КонецЕсли;
		
		
	Иначе //Старый макет УКД
		
		Макет = ПолучитьМакет("ПФ_УКДПоставщика");
		ОбластьШапка 			= Макет.ПолучитьОбласть("ОбластьШапка");
		ОбластьСтрока			= Макет.ПолучитьОбласть("ОбластьСтрока");
		ОбластьСтрокаДоп		= Макет.ПолучитьОбласть("ОбластьСтрокаДоп");
		ОбластьПодвал			= Макет.ПолучитьОбласть("ОбластьПодвал");
		ОбластьНакладная		= Макет.ПолучитьОбласть("ОбластьНакладная");
		
		ЗаполнитьЗначенияСвойств(ОбластьШапка.Параметры, СтруктураДокумента);
		ЗаполнитьЗначенияСвойств(ОбластьПодвал.Параметры, СтруктураДокумента);
		ЗаполнитьЗначенияСвойств(ОбластьНакладная.Параметры, СтруктураДокумента);
		
		Если СтруктураДокумента.ТипУПД = "ДИС" Тогда
			ОбластьШапка.Параметры.СтатусУПД = 2;
		Иначе
			ОбластьШапка.Параметры.СтатусУПД = 1;
		КонецЕсли;
		
		ТабДок.Вывести(ОбластьШапка);
		
		Для Каждого СтрокаТЧ Из СтруктураДокумента.ТабличнаяЧасть Цикл
			
			ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, СтрокаТЧ);	
			ЗаполнитьЗначенияСвойств(ОбластьСтрокаДоп.Параметры, СтрокаТЧ);
			
			Если ЗначениеЗаполнено(СтрокаТЧ.ИнфоПоля) Тогда
				ТабДок.Вывести(ОбластьСтрокаДоп);
			Иначе
				ТабДок.Вывести(ОбластьСтрока);
			КонецЕсли;
			
		КонецЦикла;
		
		ТабДок.Вывести(ОбластьПодвал);	
		
		Если СтруктураДокумента.ТипУПД <> "СЧФ" Тогда
			ТабДок.Вывести(ОбластьНакладная);	
		КонецЕсли;
		
		Если СтруктураДокумента.Свойство("ИдентификаторЭД") Тогда
			ОбластьСведенияЭД = Макет.ПолучитьОбласть("ОбластьСведенияОбЭД");
			ЗаполнитьЗначенияСвойств(ОбластьСведенияЭД.Параметры, СтруктураДокумента);
			ТабДок.Вывести(ОбластьСведенияЭД);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ТабДок;	

КонецФункции

Функция ПФ_СформироватьПФСчетФактуры(СтруктураДокумента)
	
	ТабДок = Новый ТабличныйДокумент;
	Макет = ПолучитьМакет("ПФ_СчетФактура");
	ОбластьШапка 			= Макет.ПолучитьОбласть("ОбластьШапка");
	ОбластьСтрока			= Макет.ПолучитьОбласть("ОбластьСтрока");
	ОбластьПодвал			= Макет.ПолучитьОбласть("ОбластьПодвал");
	
	ЗаполнитьЗначенияСвойств(ОбластьШапка.Параметры, СтруктураДокумента);
	ЗаполнитьЗначенияСвойств(ОбластьПодвал.Параметры, СтруктураДокумента);
	
	ТабДок.Вывести(ОбластьШапка);
	
	Для Каждого СтрокаТЧ Из СтруктураДокумента.ТабличнаяЧасть Цикл
		
		ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, СтрокаТЧ);
		ТабДок.Вывести(ОбластьСтрока);
		
	КонецЦикла;
	
	ТабДок.Вывести(ОбластьПодвал);	
	
	Если СтруктураДокумента.Свойство("ИдентификаторЭД") Тогда
		
		ОбластьСведенияЭД = Макет.ПолучитьОбласть("ОбластьСведенияОбЭД");
		ЗаполнитьЗначенияСвойств(ОбластьСведенияЭД.Параметры, СтруктураДокумента);
		ТабДок.Вывести(ОбластьСведенияЭД);
		
	КонецЕсли;	
	
	Возврат ТабДок;	
	
КонецФункции

