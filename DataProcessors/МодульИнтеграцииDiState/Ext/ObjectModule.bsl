			ДопРеквизитИдентификаторДокумента.Заголовок 	= "DS_Документ_ID";	
		КонецЕсли;
		
		ДопРеквизитИдентификаторДокумента.ТипЗначения 		= Новый ОписаниеТипов("Число");
		ДопРеквизитИдентификаторДокумента.ОбменДанными.Загрузка = Истина;
		ДопРеквизитИдентификаторДокумента.Записать();
		
