//		Числовые функции
Функция КНП_ПолучитьАбсолютнуюРазность(Знач ПервоеЧисло, Знач ВтороеЧисло)
	
	Результат = КНП_ПолучитьРазностьЧисел(ПервоеЧисло, ВтороеЧисло);
	Возврат ?(Результат < 0, -Результат, Результат);	

КонецФункции

Функция КНП_ПолучитьРазностьЧисел(Знач ПервоеЧисло, Знач ВтороеЧисло)
	
	Попытка
		
		ПервоеЧисло = Число(ПервоеЧисло);
		ВтороеЧисло = Число(ВтороеЧисло);
		Результат = ПервоеЧисло - ВтороеЧисло;
		Возврат Результат;
		
	Исключение
		Возврат 0;	
	КонецПопытки;	

КонецФункции

//		Структурные функции
Процедура КНП_БезопасноЗаписатьЗначение(Структура, Имя, Значение)
	
	Если ТипЗнч(Структура) = Тип("Структура") И Структура.Свойство(Имя) Тогда
		Выполнить("Структура." + Имя + " = Значение");
	КонецЕсли;

КонецПроцедуры

Функция КНП_БезопасноПрочитатьЗначение(Структура, Имя)
	
	Результат = Неопределено;
	
	Если ТипЗнч(Структура) = Тип("Структура") Тогда
		
		Если Структура.Свойство(Имя) Тогда
			Выполнить("Результат = Структура." + Имя);
		КонецЕсли;
		
	Иначе
		Результат = Структура;
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция КНП_СтруктураНаОснованииКолонокТЧ(ТабличнаяЧасть)
	
	Если ТипЗнч(ТабличнаяЧасть) = Тип("ТаблицаЗначений") Тогда
		Колонки = ТабличнаяЧасть.Колонки;	
	Иначе
		Колонки = ТабличнаяЧасть.Выгрузить().Колонки;
	КонецЕсли;
	
	СтруктураКолонок = Новый Структура;
	
	Для Каждого Колонка Из Колонки Цикл
		СтруктураКолонок.Вставить(Колонка.Имя);	
	КонецЦикла;
	
	Возврат Новый ФиксированнаяСтруктура(СтруктураКолонок);

КонецФункции

Функция КНП_РазобратьНаименованиеИПНаМассив(Знач Наименование)
	
	ПозИП = Найти(ВРег(Наименование), "ИП");
	
	//Отсекаем ИП
	Если ПозИП > 0 Тогда
		
		Наименование = Сред(Наименование, ПозИП + 2);
		Наименование = СокрЛП(Наименование);
		
	КонецЕсли;
	
	МассивНаименования = Новый Массив;
	
	Наименование = СтрЗаменить(Наименование, " ", Символы.ПС);
	КоличествоСтрок = СтрЧислоСтрок(Наименование);
	
	Если КоличествоСтрок <= 3 Тогда //Попадает под структуру
		
		Для Номер = 1 По КоличествоСтрок Цикл
			МассивНаименования.Добавить(СтрПолучитьСтроку(Наименование, Номер) );	
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат МассивНаименования;

КонецФункции

Функция КНП_СкопироватьСтруктуру(ИсходнаяСтруктура)
	
	НоваяСтруктура = Новый Структура;	
	
	Для Каждого СвойствоСтруктуры Из ИсходнаяСтруктура Цикл	
		
		Если ТипЗнч(СвойствоСтруктуры.Значение) = Тип("Структура") Тогда
			НоваяСтруктура.Вставить(СвойствоСтруктуры.Ключ, КНП_СкопироватьСтруктуру(СвойствоСтруктуры.Значение));
		Иначе	
			НоваяСтруктура.Вставить(СвойствоСтруктуры.Ключ, СвойствоСтруктуры.Значение);
		КонецЕсли;
		
	КонецЦикла;	
	
	Возврат НоваяСтруктура;

КонецФункции

//		Строковые функции
Функция КНП_ФорматДат(Знач Дата, ФактВремя = Ложь)
	
	Если НЕ ФактВремя Тогда
		
		Дата = НачалоДня(Дата);
		Дата = Дата + 43200;	//Прибавляем 12 часов
		
	КонецЕсли;
	
	Возврат Формат(УниверсальноеВремя(Дата) - Дата(1970,1,1,1,0,0), "ЧГ=0")	

КонецФункции

Функция КНП_ФорматСумм(Знач Сумма, Валюта = Неопределено, ЧН = "0.00", ЧРГ = "")	
	
	Сумма = ?(Сумма < 0, -Сумма, Сумма);
	ФорматнаяСтрока = "ЧЦ=15;ЧДЦ=2;ЧРД=.;ЧН=" + ЧН + 
	?(ЗначениеЗаполнено(ЧРГ), ";ЧРГ=" + ЧРГ, "");
	РезультирующаяСтрока = СокрЛ(Формат(Сумма, ФорматнаяСтрока));
	
	Если ЗначениеЗаполнено(Валюта) Тогда
		РезультирующаяСтрока = РезультирующаяСтрока + " " + СокрП(Валюта);
	КонецЕсли;
	
	РезультирующаяСтрока = СтрЗаменить(РезультирующаяСтрока, Символы.НПП, "");
	Возврат РезультирующаяСтрока;

КонецФункции // ФорматСумм()

Функция КНП_СформироватьСуммуПрописью(СуммаЧислом, Валюта, ВыводитьСуммуБезКопеек = Ложь)
	
	Сумма = ?(СуммаЧислом < 0, -СуммаЧислом, СуммаЧислом);
	ПараметрыПрописиНаРусском = "рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 2";
	
	Если ЗначениеЗаполнено(Валюта) Тогда
		
		Если КНП_ЕстьРеквизит(Валюта, "ПараметрыПрописиНаРусском") Тогда
			ПараметрыПрописиНаРусском = Валюта.ПараметрыПрописиНаРусском;
		КонецЕсли;
		
	КонецЕсли;
	
	Результат = ЧислоПрописью(Сумма, "Л=ru_RU;ДП=Ложь", ПараметрыПрописиНаРусском);
	
	Если ВыводитьСуммуБезКопеек И Цел(Сумма) = Сумма Тогда
		Результат = Лев(Результат, Найти(Результат, "0") - 1);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КНП_СформироватьЧислоПрописью(Число)
	
	ПараметрыПрописиНаРусском = "";
	Результат = ЧислоПрописью(Число, "Л=ru_RU;ДП=Ложь", ПараметрыПрописиНаРусском);
	Результат = Лев(Результат, Найти(Результат, "0") - 1);
	Возврат Результат;

КонецФункции

Функция КНП_ПреобразоватьвСистему(Число10, СистСчис)
	
	Если СистСчис > 36 или СистСчис < 2 тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Выбранная система исчисления не поддерживается";
		Сообщение.Сообщить();
		Возврат -1;
		
	КонецЕсли;
	
	СтрокаЗначений = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";
	СтрокаСистема = "";
	
	Пока Число10 > 0 цикл
		
		РезДеления = Число10 / СистСчис;
		ЧислоСистема = цел(РезДеления);
		остатокОтДеления = Число10 - СистСчис * (ЧислоСистема);
		СтрокаСистема = сред(СтрокаЗначений, остатокОтДеления + 1, 1) + СтрокаСистема;
		Число10 = ?(ЧислоСистема = 0, 0, РезДеления); 
		
	КонецЦикла;
	
	Нечётное = стрДлина(СтрокаСистема) - цел(стрДлина(СтрокаСистема) / 2) * 2;
	
	Если Нечётное тогда
		СтрокаСистема = "0" + СтрокаСистема;
	КонецЕсли;
	
	Возврат СтрокаСистема;

КонецФункции

Функция КНП_URLEncode(Знач Значение)
	
	Стр = Строка(Значение);
	Стр = СтрЗаменить(Стр, Символы.НПП, "");
	Стр = СокрЛП(Стр);
	
	Попытка
		
		Стр = СтрЗаменить(Стр, "«", """");
		Стр = СтрЗаменить(Стр, "»", """");
		
	Исключение
	КонецПопытки;
	
	Длина = СтрДлина(Стр);
	Итог = "";
	
	Для Н = 1 По Длина Цикл
		
		Знак = Сред(Стр, Н, 1);
		Код = КодСимвола(Знак);
		
		Если ((Знак >= "a") и (Знак <= "z")) или
			((Знак >= "A") и (Знак <= "Z")) или
			((Знак >= "0") и (Знак <= "9")) тогда
			Итог = Итог + Знак;
		Иначе
			
			Если (Код >= КодСимвола("А")) И (Код <= КодСимвола("п")) Тогда
				Итог = Итог + "%" + КНП_ПреобразоватьвСистему(208, 16) + "%" + КНП_ПреобразоватьвСистему(144 + Код - КодСимвола("А"), 16);
			ИначеЕсли (Код >= КодСимвола("р")) И (Код <= КодСимвола("я")) Тогда
				Итог = Итог + "%" + КНП_ПреобразоватьвСистему(209, 16) + "%" + КНП_ПреобразоватьвСистему(128 + Код - КодСимвола("р"), 16);
			ИначеЕсли (Знак = "ё") Тогда
				Итог = Итог + "%" + КНП_ПреобразоватьвСистему(209, 16) + "%" + КНП_ПреобразоватьвСистему(145, 16);
			ИначеЕсли (Знак = "Ё") Тогда
				Итог = Итог + "%" + КНП_ПреобразоватьвСистему(208, 16) + "%" + КНП_ПреобразоватьвСистему(129, 16);
			Иначе
				Итог = Итог + "%" + КНП_ПреобразоватьвСистему(Код, 16);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Итог;

КонецФункции


Функция КНП_ЧислоВФормате(ЧислоИсточник, ЧДЦ = 2)
	
	Если ТипЗнч(ЧислоИсточник) = Тип("Число") Тогда
		Возврат Формат(ЧислоИсточник, "ЧЦ=15; ЧДЦ=" + Строка(ЧДЦ) + "; ЧРД=.; ЧРГ=; ЧН=; ЧГ=");
	КонецЕсли;
	
	Возврат ЧислоИсточник;

КонецФункции

Функция КНП_ЧислоБезГруппВВидеСтроки(Знач Значение)
	
	Результат = "";
	
	Если ЗначениеЗаполнено(Значение) Тогда
		
		Попытка
			Результат = Строка(Формат(Число(Значение), "ЧРГ=; ЧГ="));
		Исключение
			ДобавитьВЖурнал("Ошибка форматирования: Значение = " + Значение + ". Ошибка: " + ОписаниеОшибки(), "ЧислоБезГруппВВидеСтроки");
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция КНП_УдалениеВедущихНулей(Знач Номер)
	//Changelog
	//
	//21.03.2019 - добавлено сохранение префикса Аванса
	
	ЕстьАванс = Ложь;
	
	Если Лев(Номер, 1) = "А" Тогда
		
		ЕстьАванс = Истина;
		Номер = Сред(Номер, 2);
		
	КонецЕсли;
	
	Пока Лев(Номер, 1) = "0" Цикл
		Номер = Сред(Номер, 2);	
	КонецЦикла;
	
	Если ЕстьАванс Тогда
		Номер = "А" + Номер;
	КонецЕсли;
	
	Возврат Номер;

КонецФункции

Функция КНП_ПолучитьСтрокуИзМассива(ЗначениеОшибки, Разделитель = ", ")	
	
	СтрокаОписания = "";	
	
	Если ТипЗнч(ЗначениеОшибки) = Тип("Массив") Тогда
		
		Для Каждого ЭлементМассива Из ЗначениеОшибки Цикл
			
			Если ТипЗнч(ЭлементМассива) = Тип("Соответствие") Тогда
				СтрокаОписания = СтрокаОписания + КНП_ПолучитьСтрокуИзМассива(ЭлементМассива);
			Иначе
				СтрокаОписания = СтрокаОписания + ЭлементМассива + Разделитель;
			КонецЕсли;
			
		КонецЦикла;		
		
	ИначеЕсли ТипЗнч(ЗначениеОшибки) = Тип("Соответствие") Тогда
		
		Для Каждого Элемент Из ЗначениеОшибки Цикл
			СтрокаОписания = СтрокаОписания + Элемент.Ключ + ": " + КНП_ПолучитьСтрокуИзМассива(Элемент.Значение);
		КонецЦикла;
		
	КонецЕсли;	
	
	Возврат СтрокаОписания;	

КонецФункции

