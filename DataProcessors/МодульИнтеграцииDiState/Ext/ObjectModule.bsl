Функция ЭДО_ПодписатьСлужебныйДокумент(ИдентификаторДокумента, Контент, Подпись)
	
	Результат = Неопределено;
	ЗаписьЖурналаРегистрации("DS_ЗамерВремени.ПодписатьДокумент.Начало",,,ТекущаяУниверсальнаяДатаВМиллисекундах() );
	
	СтруктураТелаЗапроса = Новый Структура;
	СтруктураТелаЗапроса.Вставить("content", Контент);
	СтруктураТелаЗапроса.Вставить("signature", КНП_ОбработатьСтрокуBase64(Подпись) );
	Результат = API_ПодписатьСлужебныйДокумент(ИдентификаторДокумента, КНП_ЗаписатьJSONНаСервере(СтруктураТелаЗапроса) );
	
	Если ТипЗнч(Результат) <> Тип("Соответствие") Тогда
		Результат = Неопределено;
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации("DS_ЗамерВремени.ПодписатьДокумент.Конец",,,ТекущаяУниверсальнаяДатаВМиллисекундах() );
	Возврат Результат;

КонецФункции


