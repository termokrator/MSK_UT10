Функция МОП_ПолучитьСтавкуНДСИзСтроки(Знач СтавкаНДССтрокой)
	
	СтавкаНДССтрокой = СтрЗаменить(СтавкаНДССтрокой, "%", "");
	
	Если Метаданные.Перечисления.Найти("СтавкиНДС") <> Неопределено Тогда
		
		СтавкаНДССтрокой = Строка(СтавкаНДССтрокой);
		
		Если 
			СтавкаНДССтрокой = "0" 
			Или 
			СтавкаНДССтрокой = "0.00000" 
			Тогда
			Возврат ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС0");
			
		ИначеЕсли 
			СтавкаНДССтрокой = "10" 
			Или
			СтавкаНДССтрокой = "10.00000" 
			Тогда
			Возврат ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС10");
			
		ИначеЕсли 
			СтавкаНДССтрокой = "18" 
			Или
			СтавкаНДССтрокой = "18.00000" 
			Тогда
			Возврат ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС18");
			
		ИначеЕсли 
			СтавкаНДССтрокой = "10/110" 
			ИЛИ
			СтавкаНДССтрокой = "110" 
			Тогда
			Возврат ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС10_110");
			
		ИначеЕсли 
			СтавкаНДССтрокой = "18/118"
			ИЛИ
			СтавкаНДССтрокой = "118" 
			Тогда
			Возврат ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС18_118");
			
		ИначеЕсли 
			СтавкаНДССтрокой = "20" 
			Или
			СтавкаНДССтрокой = "20.00000" 
			Тогда
			Возврат ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20");
			
		ИначеЕсли 
			СтавкаНДССтрокой = "20/120"
			ИЛИ
			СтавкаНДССтрокой = "120" 
			Тогда
			Возврат ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20_120");
			
		//+Гавриленков В. 11.12.2025 #UT10-5574
		ИначеЕсли 
			СтавкаНДССтрокой = "22" 
			Или
			СтавкаНДССтрокой = "22.00000" 
			Тогда
			Возврат ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС22");
			
		ИначеЕсли 
			СтавкаНДССтрокой = "22/122"
			ИЛИ
			СтавкаНДССтрокой = "122" 
			Тогда
			Возврат ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС22_122");
		//-Гавриленков В. 11.12.2025 #UT10-5574
			
		Иначе
			Возврат ПредопределенноеЗначение("Перечисление.СтавкиНДС.БезНДС");		
		КонецЕсли;
		
		
	ИначеЕсли Метаданные.Справочники.Найти("СтавкиНДС") <> Неопределено Тогда
		
		СтавкаНДССтрокой = Строка(СтавкаНДССтрокой);
		
		Если 
			СтавкаНДССтрокой = "0" 
			Или 
			СтавкаНДССтрокой = "0.00000" 
			Тогда
			Возврат Справочники.СтавкиНДС.НайтиПоНаименованию("0%", Истина);
			
		ИначеЕсли 
			СтавкаНДССтрокой = "10" 
			Или
			СтавкаНДССтрокой = "10.00000" 
			Тогда
			Возврат Справочники.СтавкиНДС.НайтиПоНаименованию("10%", Истина);
			
		ИначеЕсли 
			СтавкаНДССтрокой = "18" 
			Или
			СтавкаНДССтрокой = "18.00000" 
			Тогда
			Возврат Справочники.СтавкиНДС.НайтиПоНаименованию("18%", Истина);
			
		ИначеЕсли 
			СтавкаНДССтрокой = "10/110" 
			ИЛИ
			СтавкаНДССтрокой = "110" 
			Тогда
			Возврат Справочники.СтавкиНДС.НайтиПоНаименованию("10% / 110%");
			
		ИначеЕсли 
			СтавкаНДССтрокой = "18/118"
			ИЛИ
			СтавкаНДССтрокой = "118" 
			Тогда
			Возврат Справочники.СтавкиНДС.НайтиПоНаименованию("18% / 118%");
			
		ИначеЕсли 
			СтавкаНДССтрокой = "20" 
			Или
			СтавкаНДССтрокой = "20.00000" 
			Тогда
			Возврат Справочники.СтавкиНДС.НайтиПоНаименованию("20%", Истина);
			
		ИначеЕсли 
			СтавкаНДССтрокой = "20/120"
			ИЛИ
			СтавкаНДССтрокой = "120" 
			Тогда
			Возврат Справочники.СтавкиНДС.НайтиПоНаименованию("20% / 120%");
			
		Иначе
			Возврат Справочники.СтавкиНДС.НайтиПоНаименованию("Без НДС");		
		КонецЕсли;
		
	КонецЕсли;

КонецФункции

Функция МОП_ПолучитьСписокКонтрагентов()
	
	ТаблицаКонтрагентов = Новый ТаблицаЗначений;
	ТаблицаКонтрагентов.Колонки.Добавить("Контрагент");
	ТаблицаКонтрагентов.Колонки.Добавить("ИНН");
	ТаблицаКонтрагентов.Колонки.Добавить("КПП");
	
	Если КНП_ЕстьОбъектМетаданных("Контрагенты") Тогда
		МенеджерСправочника = Справочники.Контрагенты;	
	КонецЕсли;
	
	Если МенеджерСправочника <> Неопределено Тогда
		
		Выборка = МенеджерСправочника.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			СтрокаТаблицы = ТаблицаКонтрагентов.Добавить();
			СтрокаТаблицы.Контрагент = Выборка.Ссылка;
			
			Если КНП_ЕстьРеквизит(Выборка.Ссылка, "ИНН") Тогда	
				СтрокаТаблицы.ИНН = Выборка.ИНН;
			КонецЕсли;
			
			Если КНП_ЕстьРеквизит(Выборка.Ссылка, "КПП") Тогда	
				СтрокаТаблицы.КПП = Выборка.КПП;
			КонецЕсли;
			
		КонецЦикла;	
		
	КонецЕсли;
	
	Возврат ТаблицаКонтрагентов;

КонецФункции

