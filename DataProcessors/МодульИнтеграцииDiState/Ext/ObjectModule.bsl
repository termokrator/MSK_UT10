Функция ФОД_ПолучитьБИКБанка(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	
	Если ТипЗнч(ОбъектЗаполнения) = Тип("СправочникСсылка.Организации") Тогда
		
		БанковскийСчет = МОП_ПолучитьБанковскийСчетОрганизации(ОбъектЗаполнения);
		
		Если ЗначениеЗаполнено(БанковскийСчет) Тогда
			Возврат МОП_ПолучитьБИКБанкаПоСчету(БанковскийСчет);
		КонецЕсли;	
		
	ИначеЕсли ТипЗнч(ОбъектЗаполнения) = Тип("СправочникСсылка.Контрагенты") Тогда
		
		БанковскийСчет = МОП_ПолучитьБанковскийСчетКонтрагента(ОбъектЗаполнения);
		
		Если ЗначениеЗаполнено(БанковскийСчет) Тогда
			Возврат МОП_ПолучитьБИКБанкаПоСчету(БанковскийСчет);
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ОбъектЗаполнения) = Тип("Структура") Тогда
		
