КонецФункции

// Получить грузоотправителя (метаданно-ориентированный метод)
// *Поддержка БП 3.0, УТ 11, КА 2.4, БП 2.0, УТ 10.3
//
// Параметры:
//  СсылкаНаДокумент - ДокументСсылка	 - Анализируемый документ
// 
// Возвращаемое значение:
// Булево  - 
//
Функция МОП_ПолучитьГрузоотправителя(СсылкаНаДокумент)
	
	Результат = Неопределено;	
	
	ЕстьРеквизитОрганизации = КНП_ЕстьРеквизит(СсылкаНаДокумент, "Организация");
	
	Если КНП_ЕстьРеквизит(СсылкаНаДокумент, "Грузоотправитель") Тогда
		
		Если ЗначениеЗаполнено(СсылкаНаДокумент.Грузоотправитель) Тогда
			Результат = СсылкаНаДокумент.Грузоотправитель;		
		КонецЕсли;
		
	КонецЕсли;
	
	//+Макрушин Е. 07.04.2026 #UT10-5800
	Если НЕ ЗначениеЗаполнено(Результат) И ТипЗнч(СсылкаНаДокумент) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		Результат = СсылкаНаДокумент.Контрагент;
	КонецЕсли;		
	//-Макрушин Е. 07.04.2026 #UT10-5800
	
	
	Если НЕ ЗначениеЗаполнено(Результат) И ЕстьРеквизитОрганизации Тогда
		
		//+Белов А. 01.09.2026 #UT10-6033
		Если ТипЗнч(СсылкаНаДокумент) = Тип("ДокументСсылка.ЗаказЗаявка") И ТипЗнч(СсылкаНаДокумент.Организация) = Тип("СправочникСсылка.Контрагенты") Тогда
			Результат = Константы.ОсновнаяОрганизация.Получить();
		//-Белов А. 01.09.2026 #UT10-6033
		Иначе
			Результат = СсылкаНаДокумент.Организация;	
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;	

КонецФункции

Функция МОП_ПолучитьГрузоперевозчика(СсылкаНаДокумент)
	
	Результат = Неопределено;	
	
