		КонецЕсли;
		
	КонецЕсли;
	
	Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "Доходы") И ОбъектЗаполнения.Доходы.Количество() > 0 Тогда
		
		Если ОбъектЗаполнения.Доходы.Выгрузить().Колонки.Найти("НДС") <> Неопределено Тогда
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Доходы.Итог("НДС");	
		Иначе
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Доходы.Итог("СуммаНДС");	
		КонецЕсли;
		
	КонецЕсли;
	
	Если КонвертацияВалютПоКурсуДокумента Тогда
		
		ВалютаДокумента = МОП_ПолучитьВалютуДокумента(ОбъектЗаполнения.Ссылка);
		ВалютаДоговора = МОП_ПолучитьВалютуДоговораДокумента(ОбъектЗаполнения.Ссылка);
		
		Если ВалютаДоговора <> ВалютаДокумента Тогда //Требуется перерасчет
			
			СтруктураПараметров = МОП_ПолучитьПараметрыВалютДокумента(ОбъектЗаполнения.Ссылка);
			Курс = СтруктураПараметров.Курс;
			Кратность = СтруктураПараметров.Кратность;
			СуммаДокумента = Окр(СуммаДокумента * Курс / Кратность, 0);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СуммаДокумента;

КонецФункции

Функция ФОД_ПолучитьСуммуСНДСДокумента(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	
	Если МОП_ЭтоСчетФактураНаАванс(ОбъектЗаполнения) Тогда
		
		СуммаДокумента = 0;
		
		Если ОбъектЗаполнения.Авансы.Выгрузить().Колонки.Найти("СуммаБезНДС") <> Неопределено Тогда
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Авансы.Итог("СуммаБезНДС");	
		Иначе
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Авансы.Итог("Сумма");	
		КонецЕсли;
		
		Возврат СуммаДокумента;
		
	Иначе
		Возврат ФОД_ПолучитьСуммуДокумента(ВерсияЗаполнения, ОбъектЗаполнения) + ФОД_ПолучитьСуммуНДСДокумента(ВерсияЗаполнения, ОбъектЗаполнения);
