Функция ФОД_ПолучитьГрузополучателяДокумента(Знач ОбъектЗаполнения)
	
	Если МОП_ЭтоСчетФактура(ОбъектЗаполнения) Тогда
		АнализируемыйДокумент = МОП_ПолучитьОснованиеДокумента(ОбъектЗаполнения);
	Иначе
		АнализируемыйДокумент = ОбъектЗаполнения;
	КонецЕсли;
	
	Если МОП_ЭтоАктВыполненныхРабот(АнализируемыйДокумент) Тогда
		Возврат Неопределено;
	ИначеЕсли МОП_ЭтоСчетФактураНаАванс(ОбъектЗаполнения) Тогда
		Возврат Неопределено;
	Иначе
		Возврат МОП_ПолучитьГрузополучателя(ОбъектЗаполнения);
	КонецЕсли;

КонецФункции 

Функция ФОД_ПолучитьПеревозчикаДокумента(Знач ОбъектЗаполнения)
	//+Белов А. 17.06.2026 #UT10-5921
	
	Если ТипЗнч(ОбъектЗаполнения) = Тип("ДокументСсылка.ТранспортнаяНакладная") Тогда
		
		Если ЗначениеЗаполнено(ОбъектЗаполнения.ЗаказЗаявка) Тогда
			Возврат ОбъектЗаполнения.ЗаказЗаявка.Контрагент;	
		Иначе
			Возврат ОбъектЗаполнения.Организация;	
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ОбъектЗаполнения) = Тип("ДокументСсылка.ЗаказЗаявка") Тогда
		Возврат ОбъектЗаполнения.Контрагент;
	КонецЕсли;	
	
	//-Белов А. 17.06.2026 #UT10-5921
КонецФункции    

Функция ФОД_ПолучитьИдентификаторПеревозчика(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	//+Белов А. 17.06.2026 #UT10-5921
	
	Если ТипЗнч(ОбъектЗаполнения) = Тип("ДокументСсылка.ТранспортнаяНакладная") Тогда     	
		
		Если ЗначениеЗаполнено(ОбъектЗаполнения.ЗаказЗаявка) Тогда
			Возврат ФОД_ПолучитьИдентификаторПеревозчика(Неопределено, ОбъектЗаполнения.ЗаказЗаявка);				
		Иначе
			
			Если КНП_ЕстьРеквизит(ОбъектЗаполнения, "Организация") И ЗначениеЗаполнено(ОбъектЗаполнения.Организация.ИдентификаторОрганизации) Тогда
				Возврат ОбъектЗаполнения.Организация.ИдентификаторОрганизации; 
			КонецЕсли;
			
		КонецЕсли;
		
		Возврат Цел(ИдентификаторПодразделения); 
		
	ИначеЕсли ТипЗнч(ОбъектЗаполнения) = Тип("ДокументСсылка.ЗаказЗаявка") Тогда     	
		
		Контрагент = ПолучитьКонтрагентаПоОбъектуЗаполнения(ОбъектЗаполнения); 
		
		Попытка
			
			ИдентификаторыКонтрагента = РС_ПолучитьИдентификаторыКонтрагента(Контрагент);
			
			Если ЗначениеЗаполнено(ИдентификаторыКонтрагента) И ИдентификаторыКонтрагента.Свойство("ИдентификаторПодразделения") Тогда
				Возврат Цел(ИдентификаторыКонтрагента.ИдентификаторПодразделения);
			КонецЕсли;
			
		Исключение
			ДобавитьВЖурнал(ОписаниеОшибки(), "ФОД_ПолучитьИдентификаторПеревозчика");	
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Цел(ИдентификаторПодразделения);

	//-Белов А. 17.06.2026 #UT10-5921
