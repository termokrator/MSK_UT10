Функция МОП_ЭтоСчетФактураНаАванс(СсылкаНаДокумент)
	
	Результат = Ложь;
	
	Если СсылкаНаДокумент.Метаданные().Имя = "СчетФактураВыданный" ИЛИ СсылкаНаДокумент.Метаданные().Имя = "СчетФактураВыданныйАванс" Тогда
		
		Если КНП_ЕстьТабЧасть(СсылкаНаДокумент, "Авансы") И СсылкаНаДокумент.Авансы.Количество() > 0 Тогда
			Результат = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Если СсылкаНаДокумент.Метаданные().Имя = "СчетФактура" Тогда
		
		Если КНП_ЕстьТабЧасть(СсылкаНаДокумент, "Авансы") И СсылкаНаДокумент.Авансы.Количество() > 0 Тогда
			Результат = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;	

КонецФункции

Функция МОП_ЭтоУслуга(СсылкаНаНоменклатуру)
	
	Результат = Ложь;
	
	Если КНП_ЕстьРеквизит(СсылкаНаНоменклатуру, "Услуга") И ТипЗнч(СсылкаНаНоменклатуру.Услуга) = Тип("Булево") Тогда
		Результат = СсылкаНаНоменклатуру.Услуга;
	ИначеЕсли КНП_ЕстьРеквизит(СсылкаНаНоменклатуру, "ВидНоменклатуры") И ЗначениеЗаполнено(СсылкаНаНоменклатуру.ВидНоменклатуры) Тогда
		
		Если КНП_ЕстьРеквизит(СсылкаНаНоменклатуру.ВидНоменклатуры, "Услуга") И ТипЗнч(СсылкаНаНоменклатуру.ВидНоменклатуры.Услуга) = Тип("Булево") Тогда
			Результат = СсылкаНаНоменклатуру.ВидНоменклатуры.Услуга;
		ИначеЕсли КНП_ЕстьРеквизит(СсылкаНаНоменклатуру.ВидНоменклатуры, "ТипНоменклатуры") И ЗначениеЗаполнено(СсылкаНаНоменклатуру.ТипНоменклатуры) Тогда
			
			Если Метаданные.Перечисления.Найти("ТипНоменклатуры") <> Неопределено Тогда
				
				Попытка
					
					Если 
						СсылкаНаНоменклатуру.ВидНоменклатуры.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Услуга") 
						ИЛИ
						СсылкаНаНоменклатуру.ВидНоменклатуры.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Работа")
						Тогда
						Результат = Истина;
					КонецЕсли;
					
				Исключение 
				КонецПопытки;	
				
			КонецЕсли;
			
		КонецЕсли; 
		
	ИначеЕсли КНП_ЕстьРеквизит(СсылкаНаНоменклатуру, "ТипНоменклатуры") Тогда
		
		Если Метаданные.Перечисления.Найти("ТипНоменклатуры") <> Неопределено Тогда
			
			Попытка
				
				Если 
					СсылкаНаНоменклатуру.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Услуга") 
					ИЛИ
					СсылкаНаНоменклатуру.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Работа")
					Тогда
					Результат = Истина;
				КонецЕсли;
				
			Исключение 
			КонецПопытки;	
			
		КонецЕсли;
		
	КонецЕсли;	
	
	Возврат Результат;	

КонецФункции

