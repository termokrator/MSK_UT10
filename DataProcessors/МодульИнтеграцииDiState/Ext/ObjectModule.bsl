Функция ФОД_ПолучитьСуммуДо(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	
	НДСВСумме = Ложь;
	
	Если ОбъектЗаполнения.Свойство("Ссылка") И НЕ МОП_ЭтоСчетФактура(ОбъектЗаполнения.Ссылка) Тогда
		
		НДСВСумме = МОП_ДокументВключаетНДСВСумму(ОбъектЗаполнения.Ссылка, Истина);
		
		Если НДСВСумме = Неопределено Тогда
			НДСВСумме = МОП_НДСВСуммеПоСтавке(ОбъектЗаполнения.СтавкаНДС);
		КонецЕсли;
		
	Иначе
		НДСВСумме = МОП_НДСВСуммеПоСтавке(ОбъектЗаполнения.СтавкаНДС);
	КонецЕсли;
	
	Если НДСВСумме Тогда
		
		Если ОбъектЗаполнения.Свойство("СуммаДоИзменения") Тогда
			Возврат ОбъектЗаполнения.СуммаДоИзменения - ФОД_ПолучитьСуммуНДСДо(ВерсияЗаполнения, ОбъектЗаполнения);
		КонецЕсли;		
		
	Иначе
		
		Если ОбъектЗаполнения.Свойство("СуммаДоИзменения") Тогда
			Возврат ОбъектЗаполнения.СуммаДоИзменения;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат 0;	

