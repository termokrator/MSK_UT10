Функция ПФ_РазобратьИзСтруктурыИнфоПоля(Структура)
	
	Результат = "";
	
	Если ТипЗнч(Структура) = Тип("Структура") Тогда
		
		МассивСтруктурИнфоПолей = Новый Массив;
		МассивСтруктурИнфоПолей.Добавить(Структура);
		
	ИначеЕсли ТипЗнч(Структура) = Тип("Массив") Тогда
		МассивСтруктурИнфоПолей = Структура;
	КонецЕсли;
	
	Для Каждого ИнфоПоле Из МассивСтруктурИнфоПолей Цикл
		
		Если ИнфоПоле.Свойство("Идентиф") ИЛИ ИнфоПоле.Свойство("Значен") Тогда
			
			Если ЗначениеЗаполнено(Результат) Тогда 
				Результат = Результат + ", " 
			КонецЕсли;
			
			Если КНП_БезопасноПрочитатьЗначение(ИнфоПоле, "Идентиф") = "additional_information" Тогда
				Результат = Результат + КНП_БезопасноПрочитатьЗначение(ИнфоПоле, "Значен"); 	
			Иначе
				Результат = Результат + КНП_БезопасноПрочитатьЗначение(ИнфоПоле, "Идентиф")
				+ ": "	 + КНП_БезопасноПрочитатьЗначение(ИнфоПоле, "Значен");
			КонецЕсли;
			
		Иначе
			
			Для Каждого КлючИнфоПоля Из ИнфоПоле Цикл
				
				Если ТипЗнч(КлючИнфоПоля.Значение) = Тип("Структура") Тогда
					
					Если ЗначениеЗаполнено(Результат) Тогда 
						Результат = Результат + ", " 
					КонецЕсли;
					
					Результат 	= Результат + КНП_БезопасноПрочитатьЗначение(КлючИнфоПоля.Значение, "Идентиф")
					+ ": "		+ КНП_БезопасноПрочитатьЗначение(КлючИнфоПоля.Значение, "Значен");
					
				ИначеЕсли ТипЗнч(КлючИнфоПоля.Значение) = Тип("Массив") Тогда
					
					Для Каждого ЭлементКлюча Из КлючИнфоПоля.Значение Цикл
						
						Если ЗначениеЗаполнено(Результат) Тогда 
							Результат = Результат + ", " 
						КонецЕсли;
						
						Если КНП_БезопасноПрочитатьЗначение(ИнфоПоле, "Идентиф") = "additional_information" Тогда
							Результат = Результат + КНП_БезопасноПрочитатьЗначение(ЭлементКлюча, "Значен"); 	
						Иначе
							Результат = Результат + КНП_БезопасноПрочитатьЗначение(ЭлементКлюча, "Идентиф")
							+ ": "	 + КНП_БезопасноПрочитатьЗначение(ЭлементКлюча, "Значен");
						КонецЕсли;	
						
					КонецЦикла;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;		
		
	КонецЦикла;
	
	Возврат Результат;	

КонецФункции

