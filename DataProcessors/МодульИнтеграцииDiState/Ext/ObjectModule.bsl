Функция ТП_ОтправитьПисьмоВТехПоддержку(ИмяПользователя, ПочтовыйАдрес, ТекстПисьма)
	
	Заголовки = Новый Соответствие;
	СтруктураВозврата = Новый Структура("Заголовок,Текст");
	Токен = ПрочитатьТокенВСистеме();
	
	СтруктураЗапроса = Новый Структура("token,sender,senderName,message");
	СтруктураЗапроса.token = Токен;
	СтруктураЗапроса.sender = ПочтовыйАдрес;
	СтруктураЗапроса.senderName = ИмяПользователя; 
	СтруктураЗапроса.message = ТекстПисьма;
	ТелоЗапроса = КНП_ЗаписатьJSONНаСервере(СтруктураЗапроса);
	Результат = ОбменHTTPJSON(АдресСервисаПоддержки + "support/message", Заголовки, Истина, ТелоЗапроса);
	
	Если Результат <> Неопределено И Результат.Получить("success") = Истина Тогда
		
		СтруктураВозврата.Заголовок = "Отправка письма";
		СтруктураВозврата.Текст = "Письмо успешно отправлено!";
		
	ИначеЕсли Результат <> Неопределено И Результат.Получить("success") = Ложь Тогда
		
		СтруктураВозврата.Заголовок = "Ошибка отправки сообщения";
		СтруктураВозврата.Текст = Результат.Получить("reason");
		
	Иначе
		
		СтруктураВозврата.Заголовок = "Ошибка отправки сообщения";
		СтруктураВозврата.Текст = Результат;
		
	КонецЕсли;
	
	Возврат СтруктураВозврата;

КонецФункции

