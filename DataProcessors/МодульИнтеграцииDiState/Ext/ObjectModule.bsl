	Если ДанныеДокументов.Получить("success") <> Неопределено И ДанныеДокументов.Получить("success") Тогда
		
		СписокДокументов = ДанныеДокументов.Получить("rows");
		
		Если СписокДокументов <> Неопределено И СписокДокументов.Количество() > 0 Тогда
			
			Для Каждого ДокументВОбработке Из СписокДокументов Цикл
				
				СистемноеИмяДокумента = ДокументВОбработке.Получить("documentTypeSystemName");
				СтатусПакета = ДокументВОбработке.Получить("packageStateSystemName");
				
				Если ДокументВОбработке.Получить("subFlowStateSystemName") <> Неопределено  Тогда
					СтатусПакета = ДокументВОбработке.Получить("subFlowStateSystemName");
				КонецЕсли;
				
				ДатаДокумента = КНП_ПривестиКДате(ДокументВОбработке.Получить("documentDate") );
				
				Если ТипЗнч(ДатаДокумента) <> Тип("Дата") Тогда
					Продолжить;
				КонецЕсли;
				
				Если ТипЗнч(ДатаНачала) = Тип("Дата") Тогда
					
					Если ДатаДокумента < ДатаНачала Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				
				Если ТипЗнч(ДатаКонца) = Тип("Дата") Тогда
					
					Если ДатаДокумента > ДатаКонца Тогда
						Продолжить;
					КонецЕсли;
					
				КонецЕсли;
				
				СтрокаТаблицы = ТаблицаДанных.Добавить();
				
				Если ДокументВОбработке.Получить("packageType") = "OUT" Тогда
					СтрокаТаблицы.Исходящий = Истина;
				КонецЕсли;
				
				СтрокаТаблицы.Номер = ДокументВОбработке.Получить("documentNumber");
				СтрокаТаблицы.Дата = ДатаДокумента; 
				СтрокаТаблицы.ИдентификаторОтправителя = ДокументВОбработке.Получить("fromDivisionId");					
				СтрокаТаблицы.ИдентификаторПолучателя = ДокументВОбработке.Получить("toDivisionId");
				ИдОтправителя = ДокументВОбработке.Получить("fromCompanyId");
				ИдПолучателя = ДокументВОбработке.Получить("toCompanyId");
				СтрокаТаблицы.Отправитель = РС_ПолучитьОрганизациюКонтрагентаПоИдентификатору(СтрокаТаблицы.ИдентификаторОтправителя, ИдОтправителя);
				СтрокаТаблицы.Получатель = РС_ПолучитьОрганизациюКонтрагентаПоИдентификатору(СтрокаТаблицы.ИдентификаторПолучателя, ИдПолучателя);
				СтрокаТаблицы.ИдентификаторДокумента = ДокументВОбработке.Получить("documentId");
				СтрокаТаблицы.ГруппаПроцессинга = ДокументВОбработке.Получить("packageFlowSystemName");
				СтрокаТаблицы.ОжидаемыеДействия = ЭДО_РазобратьОжидаемоеДействие(СтатусПакета, 
				СтрокаТаблицы.ГруппаПроцессинга, 
				ДокументВОбработке.Получить("packageType") );
				СтрокаТаблицы.Тип = ЭДО_РазобратьТипДокумента(СистемноеИмяДокумента, СтрокаТаблицы.ГруппаПроцессинга);
				СтрокаТаблицы.ГруппаПроцессинга = ДокументВОбработке.Получить("packageFlowGroup") + "_" + СтрокаТаблицы.ГруппаПроцессинга;
				СтрокаТаблицы.СистемноеИмя = СистемноеИмяДокумента;
				//Работа с контейнерами
				СтрокаТаблицы.ИДКонтейнера = ДокументВОбработке.Получить("containerUid");
				
				Если ЗначениеЗаполнено(СтрокаТаблицы.ИДКонтейнера) Тогда
					СтрокаТаблицы.СвязныйКонтейнер = (ДокументВОбработке.Получить("containerType") <> "decoupled");
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;	
		
	КонецЕсли;
	
	ТаблицаДанных.Сортировать("ИдентификаторДокумента Убыв");
	Возврат ТаблицаДанных;

КонецФункции

Функция ЭДО_ПолучитьСписокДокументовВходящиеОжидающихПодписи(ДатаНачала = Неопределено, ДатаКонца = Неопределено, ГруппаДокументов = "", Лимит = 1000, Префикс = "")
	
	//+Макрушин Е. 18.03.2026 #UT10-5658
	ТаблицаДанных = ДокументыВОбработке.Выгрузить();
	ТаблицаДанных.Очистить();
	
	СтруктураПараметров = Новый Соответствие;
	СтруктураПараметров.Вставить("packageStates[0]", "waiting_for_decision" + Префикс);
	СтруктураПараметров.Вставить("packageTypes[0]", "IN");   
	
	Если ЗначениеЗаполнено(ГруппаДокументов) Тогда
		СтруктураПараметров.Вставить("documentFlows[0]", ГруппаДокументов);	
	КонецЕсли;  
	
	ДанныеДокументов = API_ПолучитьСписокПакетов(СтруктураПараметров, Лимит);
	
	Если ТипЗнч(ДанныеДокументов) <> Тип("Соответствие") Тогда
		
		ЗаписатьЖурналВФайл();
		Возврат ТаблицаДанных;
		
