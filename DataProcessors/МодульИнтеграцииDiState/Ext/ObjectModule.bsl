Функция КНП_ПривестиКДате(Знач Строка)
	
	Если НЕ ЗначениеЗаполнено(Строка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если КНП_ЭтоЧисло(Строка) Тогда
		
		Дата = МестноеВремя(Дата(1970,1,1,0,0,0) + Число(Строка) );
		Возврат Дата;
		
	Иначе
		
		ТаймЗона = "UTC";
		КорректныйПорядок = Найти(Строка, ТаймЗона) > 0;
		
		Если НЕ КорректныйПорядок Тогда
			
			//Попытка определить по формату yyyy-mm-ddTTT
			Если Сред(Строка, 5, 1) = "-" И Сред(Строка, 8, 1) = "-" И НЕ КНП_ЭтоЧисло(Сред(Строка, 11, 1) ) 
				И НЕ КНП_ЭтоЧисло(Сред(Строка, 12, 1) ) И НЕ КНП_ЭтоЧисло(Сред(Строка, 13, 1) ) Тогда
				
				КорректныйПорядок = Истина;
				ТаймЗона = Сред(Строка, 11, 3);
				
			КонецЕсли;
			
		КонецЕсли;
		
		Строка = СтрЗаменить(Строка, ТаймЗона, " ");
		
		ПозТ = Найти(Строка, "T");
		
		Если ПозТ > 0 Тогда
			
			КорректныйПорядок = Истина;
			Строка = Лев(Строка, ПозТ - 1);
			
		КонецЕсли;
		
		Если Сред(Строка, 3,1) = "." Тогда
			Строка = Прав(Строка, 4) + Сред(Строка, 4, 2) + Лев(Строка, 2);	
		КонецЕсли;
		
		Если Сред(Строка, 5,1) = "-" Тогда
			
			Если КорректныйПорядок Тогда
				Строка = Лев(Строка, 5) + Сред(Строка, 6, 2) + Сред(Строка, 8, 3) + Сред(Строка, 11)
			Иначе
				Строка = Лев(Строка, 5) + Сред(Строка, 9, 2) + Сред(Строка, 5, 3) + Сред(Строка, 11)	
			КонецЕсли;
			
		КонецЕсли;
		
		Строка = СтрЗаменить(Строка, ":", "");
		Строка = СтрЗаменить(Строка, "-", "");
		Строка = СтрЗаменить(Строка, ".", "");
		Строка = СтрЗаменить(Строка, " ", "");
		
	КонецЕсли;
	
	Если СтрДлина(Строка) < 14 Тогда
		Строка = Лев(Строка, 8) + "000000";
	КонецЕсли;
	
	Попытка
		Результат = Дата(Строка);
	Исключение
		Результат = Дата(Лев(Строка, 4) + Сред(Строка, 7, 2) + Сред(Строка, 5, 2) + Сред(Строка, 9) );	
	КонецПопытки;
	
	Возврат Результат;

КонецФункции

Функция КНП_ОбработатьСтрокуBase64(Знач СтрокаBase64, URLEncoded = Ложь)
	
	ОбработаннаяСтрока = СтрЗаменить(СтрокаBase64, Символы.ПС, "");
	ОбработаннаяСтрока = СтрЗаменить(ОбработаннаяСтрока, Символы.НПП, "");
	ОбработаннаяСтрока = СтрЗаменить(ОбработаннаяСтрока, Символы.ВК, "");
	ОбработаннаяСтрока = СтрЗаменить(ОбработаннаяСтрока, " ", "");
	
	Если URLEncoded Тогда
		ОбработаннаяСтрока = СтрЗаменить(ОбработаннаяСтрока, "+", КНП_URLEncode("+") );
	КонецЕсли;
	
	Возврат ОбработаннаяСтрока;

КонецФункции

Функция КНП_ПолучитьСортированнуюТаблицуКлючейЗначений(СтруктураДанных)
	
	ТаблицаКлючейЗначений = Новый ТаблицаЗначений;
	ТаблицаКлючейЗначений.Колонки.Добавить("Ключ");
	ТаблицаКлючейЗначений.Колонки.Добавить("Значение");
	
	Для Каждого ЭлементСтруктуры Из СтруктураДанных Цикл
		
		СтрокаТЧ = ТаблицаКлючейЗначений.Добавить();
		СтрокаТЧ.Ключ = ЭлементСтруктуры.Ключ;
		СтрокаТЧ.Значение = ЭлементСтруктуры.Значение;
		
	КонецЦикла;
	
	ТаблицаКлючейЗначений.Сортировать("Ключ ВОЗР");
	Возврат ТаблицаКлючейЗначений;

КонецФункции

Функция КНП_ПолучитьСокращениеРеквАдреса(ИмяРеквизита, ЗначениеРеквизита)
	
	Результат = "";
	
	Если ИмяРеквизита = "Улица" Тогда
		
		Если Найти(НРег(ЗначениеРеквизита), "улица ") ИЛИ Найти(НРег(ЗначениеРеквизита), "ул.") ИЛИ Найти(НРег(ЗначениеРеквизита), "ул ") 
			ИЛИ Найти(НРег(ЗначениеРеквизита), " ул") 
			ИЛИ Найти(НРег(ЗначениеРеквизита), "проспект") ИЛИ Найти(НРег(ЗначениеРеквизита), "пр.") ИЛИ Найти(НРег(ЗначениеРеквизита), "пр ") 
			ИЛИ Найти(НРег(ЗначениеРеквизита), " пр")
			ИЛИ Найти(НРег(ЗначениеРеквизита), "шоссе") ИЛИ Найти(НРег(ЗначениеРеквизита), "ш.") ИЛИ Найти(НРег(ЗначениеРеквизита), "ш ") 
			ИЛИ Найти(НРег(ЗначениеРеквизита), " ш") Тогда
			Результат = ЗначениеРеквизита;
		Иначе
			Результат = "ул. " + ЗначениеРеквизита;
		КонецЕсли;
		
	ИначеЕсли ИмяРеквизита = "Дом" Тогда
		
		Если Найти(НРег(ЗначениеРеквизита), "дом ") ИЛИ Найти(НРег(ЗначениеРеквизита), "д.") ИЛИ Найти(НРег(ЗначениеРеквизита), "д ") 	
			Тогда
			Результат = ЗначениеРеквизита;
		Иначе
			Результат = "д. " + ЗначениеРеквизита;
		КонецЕсли;	
		
	ИначеЕсли ИмяРеквизита = "Корпус" Тогда
		
		Если Найти(НРег(ЗначениеРеквизита), "корпус ") ИЛИ Найти(НРег(ЗначениеРеквизита), "корп.") ИЛИ Найти(НРег(ЗначениеРеквизита), "корп ") ИЛИ Найти(НРег(ЗначениеРеквизита), "к. ") ИЛИ Найти(НРег(ЗначениеРеквизита), "к ")  
			ИЛИ Найти(НРег(ЗначениеРеквизита), "литера ") ИЛИ Найти(НРег(ЗначениеРеквизита), "лит.") ИЛИ Найти(НРег(ЗначениеРеквизита), "лит ")
			ИЛИ Найти(НРег(ЗначениеРеквизита), "здание ") ИЛИ Найти(НРег(ЗначениеРеквизита), "зд.") ИЛИ Найти(НРег(ЗначениеРеквизита), "зд ")
			ИЛИ Найти(НРег(ЗначениеРеквизита), "этаж") ИЛИ Найти(НРег(ЗначениеРеквизита), "эт.") ИЛИ Найти(НРег(ЗначениеРеквизита), "эт ") ИЛИ Найти(НРег(ЗначениеРеквизита), " эт")
			ИЛИ Найти(НРег(ЗначениеРеквизита), "строение ") ИЛИ Найти(НРег(ЗначениеРеквизита), "стр.") ИЛИ Найти(НРег(ЗначениеРеквизита), "стр ") ИЛИ Найти(НРег(ЗначениеРеквизита), " стр")
			ИЛИ Найти(НРег(ЗначениеРеквизита), "дом ") ИЛИ Найти(НРег(ЗначениеРеквизита), "д.") ИЛИ Найти(НРег(ЗначениеРеквизита), "д ") ИЛИ Найти(НРег(ЗначениеРеквизита), " д")
			ИЛИ Найти(НРег(ЗначениеРеквизита), "владение ") ИЛИ Найти(НРег(ЗначениеРеквизита), "влд.") ИЛИ Найти(НРег(ЗначениеРеквизита), "влд ") ИЛИ Найти(НРег(ЗначениеРеквизита), " влд")
			
			Тогда
			Результат = ЗначениеРеквизита;
		Иначе
			Результат = ?(Найти(ЗначениеРеквизита,","), ЗначениеРеквизита, "корп. " + ЗначениеРеквизита);
		КонецЕсли;
		
	ИначеЕсли ИмяРеквизита = "Строение" Тогда	
		
		Если Найти(НРег(ЗначениеРеквизита), "строение ") ИЛИ Найти(НРег(ЗначениеРеквизита), "стр.") ИЛИ Найти(НРег(ЗначениеРеквизита), "стр ") 
			ИЛИ Найти(НРег(ЗначениеРеквизита), " стр")
			Тогда
			Результат = ЗначениеРеквизита;
		Иначе
			Результат = "стр. " + ЗначениеРеквизита;
		КонецЕсли;
		
	ИначеЕсли ИмяРеквизита = "Квартира" Тогда
		
		Если Найти(НРег(ЗначениеРеквизита), "квартира ") ИЛИ Найти(НРег(ЗначениеРеквизита), "кв.") ИЛИ Найти(НРег(ЗначениеРеквизита), "кв ") 
			ИЛИ Найти(НРег(ЗначениеРеквизита), "помещение") ИЛИ Найти(НРег(ЗначениеРеквизита), "пом.") ИЛИ Найти(НРег(ЗначениеРеквизита), "пом ")
			
			ИЛИ Найти(НРег(ЗначениеРеквизита), "офис") ИЛИ Найти(НРег(ЗначениеРеквизита), "оф.") ИЛИ Найти(НРег(ЗначениеРеквизита), "оф ")
			ИЛИ Найти(НРег(ЗначениеРеквизита), "комната") ИЛИ Найти(НРег(ЗначениеРеквизита), "ком.") ИЛИ Найти(НРег(ЗначениеРеквизита), "ком ") 
			ИЛИ Найти(НРег(ЗначениеРеквизита), " ком") ИЛИ Найти(НРег(ЗначениеРеквизита), "комн.") 
			Тогда
			Результат = ЗначениеРеквизита;
		Иначе
			Результат = "пом. " + ЗначениеРеквизита;
		КонецЕсли;
		
	Иначе
		Результат = ЗначениеРеквизита;	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура КНП_СкорректироватьАдресСервера(Знач АдресСервера)
	
	АдресСервера = СокрЛП(АдресСервера); 
	
	Если Не Прав(АдресСервера,1) = "/" Тогда
		АдресСервера = АдресСервера + "/";
	КонецЕсли;
	
	HostAddress = АдресСервера;	

КонецПроцедуры

