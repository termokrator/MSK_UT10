Функция СоздатьXMLДокументаИВернутьДляПодписания(СтрокаТаблицы) 				Экспорт
	
	Результат = Неопределено;
	
	Если МОП_ЭтоНеформализованныйДокумент(СтрокаТаблицы.Ссылка) Тогда
		Результат = ПолучитьДанныеНеформализованногоДокумента(СтрокаТаблицы.Ссылка);	
	Иначе
		
		//Белов Формирумем ХМЛ по СФ
		ДокументФормирования = Неопределено;
		
		Если СтрокаТаблицы.Свойство("СФ") И ЗначениеЗаполнено(СтрокаТаблицы.СФ) Тогда
			ДокументФормирования = СтрокаТаблицы.СФ;
		Иначе
			ДокументФормирования = СтрокаТаблицы.Ссылка;
		КонецЕсли;
		
		СтруктураЗапроса = ЭДО_СформироватьЭД(ДокументФормирования, СтрокаТаблицы.УПД);
		Результат = API_СоздатьXMLДокумента(ДокументФормирования, СтруктураЗапроса, СтрокаТаблицы.УПД);
		
		Если ТипЗнч(Результат) <> Тип("Соответствие") Тогда
			Результат = Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	
	ЗаписатьЖурналВФайл();
	Возврат Результат;

КонецФункции

Функция СоздатьXMLКвитанциюОбУточненииИВернутьДляПодписания(СтруктураДанных) 	Экспорт
	
	СтруктураЗапроса = ЭДО_СформироватьКвитанциюОтУточнении(СтруктураДанных.Тип, СтруктураДанных.Ссылка, СтруктураДанных.Причина);
	Результат = API_СоздатьКвитанциюОбОтклонении(СтруктураДанных.Идентификатор, СтруктураДанных.Тип, СтруктураЗапроса.ТелоЗапроса );
	
	Если ТипЗнч(Результат) <> Тип("Соответствие") Тогда
		Результат = Неопределено;
	КонецЕсли;
	
	ЗаписатьЖурналВФайл();
	Возврат Результат;

КонецФункции

