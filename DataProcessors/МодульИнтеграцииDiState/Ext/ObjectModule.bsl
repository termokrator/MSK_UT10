		Если СтрокаДействия = "waiting_of_uvutoch_izvpol" Тогда Результат = "Ожидается извещение о получении уведомления от уточнении от контрагента" КонецЕсли;
		Если СтрокаДействия = "signing_pdpol_notification" И Направление = "OUT" Тогда Результат = "Требуется подписать извещение о получении подтверждения от оператора" КонецЕсли;
		
	КонецЕсли;
	
	Если ГруппаПроцессинга = "waybill_551" Тогда
		
		Если СтрокаДействия = "waiting_of_dp_tovtorgpok" Тогда Результат = "Ожидается титул покупателя"; КонецЕсли;	
		Если СтрокаДействия = "received" И Направление = "IN" Тогда Результат = "Требуется принять или отклонить документ" КонецЕсли;
		Если СтрокаДействия = "waiting_of_signing" И Направление = "IN" Тогда Результат = "Требуется принять или отклонить документ"; Возврат Результат КонецЕсли;
		
	КонецЕсли;
	
	Если ГруппаПроцессинга = "act_552" Тогда
		
		Если СтрокаДействия = "waiting_of_dp_rezruzak" Тогда Результат = "Ожидается ответ от заказчика"; КонецЕсли;
		Если СтрокаДействия = "waiting_of_signing" И Направление = "IN" Тогда Результат = "Требуется принять или отклонить документ"; Возврат Результат КонецЕсли;
		Если СтрокаДействия = "waiting_of_signing" И Направление = "OUT" Тогда Результат = "Ожидается титул заказчика"; Возврат Результат КонецЕсли;
		
	КонецЕсли;
	
	Если СтрокаДействия = "annulment_has_been_requested" Тогда Результат = "Требуется принять или отклонить запрос на аннулирование" КонецЕсли;
	Если СтрокаДействия = "complete" Тогда Результат = "Документооборот завершен"; КонецЕсли;
	Если СтрокаДействия = "declined" Тогда Результат = "Документ отклонен" КонецЕсли;
	Если СтрокаДействия = "accepted" Тогда Результат = "Документ принят покупателем" КонецЕсли;
	Если СтрокаДействия = "interrupted" Тогда Результат = "Прерван. Обратитесь к администратору" КонецЕсли;
	Если СтрокаДействия = "dp_rezruisp_has_been_declined" Тогда Результат = "Документ отклонен" КонецЕсли;
	Если СтрокаДействия = "created" Тогда Результат = "Черновик" КонецЕсли;
	
	Если СтрокаДействия = "waiting_of_receiving_notification" Тогда Результат = "Ожидание извещения о получении" КонецЕсли;
	Если СтрокаДействия = "waiting_of_signing" И Направление = "OUT" Тогда Результат = "Ожидается подписание контрагентом" КонецЕсли;
	Если СтрокаДействия = "waiting_of_signing" И Направление = "IN" Тогда Результат = "Требуется подписать документ" КонецЕсли;
	Если СтрокаДействия = "waiting_of_annulment" Тогда Результат = "На аннулировании" КонецЕсли;		
	Если СтрокаДействия = "waiting_of_signing_izvpol_pdotpr_seller_title_izvpol" Тогда Результат = "Ожидается подписание извещения на подтверждение оператора о дате отправки извещения" КонецЕсли;
	Если СтрокаДействия = "waiting_of_receiver_title_signing" Тогда Результат = "Ожидание подписания ответного титула" КонецЕсли;
	Если СтрокаДействия = "waiting_of_clarification_signing" Тогда Результат = "Ожидание подписания уведомления об уточнении" КонецЕсли;
	Если СтрокаДействия = "waiting_of_seller_title_izvpol" Тогда Результат = "Ожидание от покупателя извещения о получении" КонецЕсли; 
	Если СтрокаДействия = "signing_pdpol_notification" Тогда Результат = "Требуется подписать извещение о получении подтверждения от оператора" КонецЕсли;
	
	Если СтрокаДействия = "roaming_waiting_of_notification_delivered" Тогда Результат = "Ожидание подтверждения о принятии извещения" КонецЕсли;
	Если СтрокаДействия = "roaming_waiting_of_signing_delivered" Тогда Результат = "Ожидание подтверждения о принятии подписи получателя" КонецЕсли;
	Если СтрокаДействия = "roaming_waiting_of_clarification_delivered" Тогда Результат = "Ожидание подтверждения о принятии уведомления об уточнении" КонецЕсли;
	Если СтрокаДействия = "waiting_of_annulment_delivered" Тогда Результат = "Ожидание подтверждения аннулирования" КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция ЭДО_СформироватьКвитанциюОбАннулировании(ПричинаАннулирования, СсылкаНаДокумент = Неопределено)
	
	Результат = Неопределено;
	ФорматДанных = ФОД_ПрочитатьФорматОписанияДокумента(ФОД_ПолучитьИмяМакета_Аннулирование() );
	
	Если ФорматДанных <> Неопределено Тогда
		
		ФОД_ЗаполнитьСтруктуру(ФорматДанных, ФорматДанных.__version, СсылкаНаДокумент);
		
		Если ФорматДанных.Свойство("reason") Тогда
			ФорматДанных.reason = ПричинаАннулирования;
		ИначеЕсли ФорматДанных.Свойство("document") И ФорматДанных.document.Свойство("reason") Тогда
			ФорматДанных.document.reason = ПричинаАннулирования;
		КонецЕсли;
		
		Результат = Новый Структура("Адрес,ТелоЗапроса", "", КНП_ЗаписатьJSONНаСервере(ФорматДанных) );	
		
	Иначе
		Результат = Новый Структура("Адрес,ТелоЗапроса", "", "" );	
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция ЭДО_СформироватьКвитанциюОПриеме(ИмяТипаДокумента, СсылкаНаДокумент)
	//Changelog
	//
	//12.12.2019 - отключена обратная совместимость квитанций по 150 приказу
	//25.02.2020 - исправление ошибки анализа типа квитанции
	
	Результат = Неопределено;
	ФорматДанных = Неопределено;
	
	Если Найти(ИмяТипаДокумента, "УПД") ИЛИ Найти(ИмяТипаДокумента, "ДОП") ИЛИ Найти(ИмяТипаДокумента, "передаточ") Тогда
		ФорматДанных = ФОД_ПрочитатьФорматОписанияДокумента(ФОД_ПолучитьИмяМакета_Принять_УПД820() );
	КонецЕсли;
	
	//+Белов А. 16.09.2026 #UT10-6070 добавил:  И ИмяТипаДокумента <> "Транспортная накладная"
	Если (Найти(НРег(ИмяТипаДокумента), "наклад") ИЛИ Найти(ИмяТипаДокумента, "ТОРГ")) И ИмяТипаДокумента <> "Транспортная накладная" Тогда
		ФорматДанных = ФОД_ПрочитатьФорматОписанияДокумента(ФОД_ПолучитьИмяМакета_Принять_ТоварнаяНакладная() );
	КонецЕсли;
	
	Если Найти(НРег(ИмяТипаДокумента), "акт") Тогда
		ФорматДанных = ФОД_ПрочитатьФорматОписанияДокумента(ФОД_ПолучитьИмяМакета_Принять_Акт() );
	КонецЕсли;
	
	Если Найти(НРег(ИмяТипаДокумента), "укд") ИЛИ Найти(ИмяТипаДокумента, "ДИС") ИЛИ ИмяТипаДокумента = "Универсальный корректировочный документ"  Тогда
		ФорматДанных = ФОД_ПрочитатьФорматОписанияДокумента(ФОД_ПолучитьИмяМакета_Принять_УКД() );
	КонецЕсли; 
	
	//+Белов А. 28.09.2026 #UT10-6070
	Если ИмяТипаДокумента = "Транспортная накладная" Тогда
		ФорматДанных = ФОД_ПрочитатьФорматОписанияДокумента("ТранспортнаяНакладнаяТитул3");
	КонецЕсли;
	//-Белов А. 28.09.2026 #UT10-6070
	
	Если ФорматДанных <> Неопределено Тогда
		
		ФОД_ЗаполнитьСтруктуру(ФорматДанных, ФорматДанных.__version, СсылкаНаДокумент);
		Результат = Новый Структура("Адрес,ТелоЗапроса,ТипДокумента", "", КНП_ЗаписатьJSONНаСервере(ФорматДанных), ИмяТипаДокумента );	
		
	Иначе
		Результат = Новый Структура("Адрес,ТелоЗапроса,ТипДокумента", "", "", ИмяТипаДокумента );		
	КонецЕсли;
	
	Возврат Результат;			

КонецФункции

Функция ЭДО_СформироватьКвитанциюОтУточнении(ИмяТипаДокумента, СсылкаНаДокумент, ПричинаОтклонения)
	//Changelog
	//
	//27.08.2019 - добавлены форматы описания уведомления об уточнении для товарной накладной и акта
	
	Результат = Неопределено;
	ФорматДанных = Неопределено;
	
	Если Найти(ИмяТипаДокумента, "передаточ") ИЛИ Найти(ИмяТипаДокумента, "(СЧФ)") 
		ИЛИ 
		(
		Найти(НРег(ИмяТипаДокумента), "счет-фактура") 
		И 
		НЕ Найти(НРег(ИмяТипаДокумента), "коррект") 
		) 
		Тогда
		ФорматДанных = ФОД_ПрочитатьФорматОписанияДокумента(ФОД_ПолучитьИмяМакета_Отклонить_УПД() );
	КонецЕсли;
	
	Если Найти(ИмяТипаДокумента, "УКД") ИЛИ Найти(НРег(ИмяТипаДокумента), "коррект") ИЛИ Найти(ИмяТипаДокумента, "(КСЧФ)") Тогда
		ФорматДанных = ФОД_ПрочитатьФорматОписанияДокумента(ФОД_ПолучитьИмяМакета_Отклонить_УКД() );
	КонецЕсли;
	
	Если Найти(НРег(ИмяТипаДокумента), "накладная") Тогда
		ФорматДанных = ФОД_ПрочитатьФорматОписанияДокумента(ФОД_ПолучитьИмяМакета_Отклонить_ТоварнаяНакладная() );
	КонецЕсли;
	
	Если Найти(НРег(ИмяТипаДокумента), "акт") Тогда
		ФорматДанных = ФОД_ПрочитатьФорматОписанияДокумента(ФОД_ПолучитьИмяМакета_Отклонить_Акт() );
	КонецЕсли;
	
	Если ФорматДанных <> Неопределено Тогда
		
		ФОД_ЗаполнитьСтруктуру(ФорматДанных, ФорматДанных.__version, СсылкаНаДокумент);
		ФорматДанных.clarification = ПричинаОтклонения;
		Результат = Новый Структура("Адрес,ТелоЗапроса", "", КНП_ЗаписатьJSONНаСервере(ФорматДанных) );	
		
	Иначе
		Результат = Новый Структура("Адрес,ТелоЗапроса", "", "" );	
	КонецЕсли;
	
	Возврат Результат;		

КонецФункции

Функция ЭДО_СформироватьЭД(СсылкаНаДокумент, УниверсальныйФормат = Истина) 
	
	Результат = Неопределено;
	
	Если МОП_ЭтоРеализацияТоваров(СсылкаНаДокумент) Тогда
		
		Если УниверсальныйФормат Тогда
			ФорматДанных = ФОД_ПрочитатьФорматОписанияДокумента(ФОД_ПолучитьИмяМакета_УПДДОП() );
		Иначе
			ФорматДанных = ФОД_ПрочитатьФорматОписанияДокумента(ФОД_ПолучитьИмяМакета_ТоварнаяНакладная() );
		КонецЕсли;
		
	ИначеЕсли МОП_ЭтоАктВыполненныхРабот(СсылкаНаДокумент) Тогда
		
		Если УниверсальныйФормат Тогда
			ФорматДанных = ФОД_ПрочитатьФорматОписанияДокумента(ФОД_ПолучитьИмяМакета_УПДДОП() );
		Иначе
			ФорматДанных = ФОД_ПрочитатьФорматОписанияДокумента(ФОД_ПолучитьИмяМакета_Акт() ); 	
		КонецЕсли;
		
	ИначеЕсли МОП_ЭтоСчетНаОплату(СсылкаНаДокумент) Тогда
		ФорматДанных = ФОД_ПрочитатьФорматОписанияДокумента(ФОД_ПолучитьИмяМакета_СчетНаОплату() );
		
	ИначеЕсли МОП_ЭтоСчетФактура(СсылкаНаДокумент) Тогда
		
		Если УниверсальныйФормат Тогда
			
			Если МОП_ЭтоКорректировкаРеализации(МОП_ПолучитьСсылкуНаКорректировку(СсылкаНаДокумент) ) Тогда
				ФорматДанных = ФОД_ПрочитатьФорматОписанияДокумента(ФОД_ПолучитьИмяМакета_УКД() );
			Иначе
				ФорматДанных = ФОД_ПрочитатьФорматОписанияДокумента(ФОД_ПолучитьИмяМакета_УПД() );
			КонецЕсли;
			
		Иначе
			
			Если МОП_ЭтоКорректировкаРеализации(МОП_ПолучитьСсылкуНаКорректировку(СсылкаНаДокумент) ) Тогда
				ФорматДанных = ФОД_ПрочитатьФорматОписанияДокумента(ФОД_ПолучитьИмяМакета_УКДСЧФ() );	
			Иначе
				ФорматДанных = ФОД_ПрочитатьФорматОписанияДокумента(ФОД_ПолучитьИмяМакета_УПДСЧФ() );
			КонецЕсли;
			
		КонецЕсли;	
		
	ИначеЕсли МОП_ЭтоКорректировкаРеализации(СсылкаНаДокумент) Тогда
		ФорматДанных = ФОД_ПрочитатьФорматОписанияДокумента(ФОД_ПолучитьИмяМакета_УКДДИС() );
		
	//+Макрушин Е. 18.02.2026 #UT11-5806
	ИначеЕсли МОП_ЭтоАктОРасхожденияхПослеПриемки(СсылкаНаДокумент) Тогда
		ФорматДанных = ФОД_ПрочитатьФорматОписанияДокумента(ФОД_ПолучитьИмяМакета_Торг2());
	
	//-Макрушин Е. 18.02.2026 #UT11-5806 
	//+Белов А. 17.06.2026 #UT10-5921
	ИначеЕсли МОП_ЭтоТранспортнаяНакладная(СсылкаНаДокумент) Тогда
		ФорматДанных = ФОД_ПрочитатьФорматОписанияДокумента(ФОД_ПолучитьИмяМакета_ТранспортнаяНакладная());
	ИначеЕсли МОП_ЭтоЗаказЗаявка(СсылкаНаДокумент) Тогда
		ФорматДанных = ФОД_ПрочитатьФорматОписанияДокумента(ФОД_ПолучитьИмяМакета_ЗаказЗаявка());
	//-Белов А. 17.06.2026 #UT10-5921
	
	КонецЕсли;
	
	ФОД_ЗаполнитьСтруктуру(ФорматДанных, ФорматДанных.__version, СсылкаНаДокумент,, СсылкаНаДокумент);
	Результат = Новый Структура("Адрес,ТелоЗапроса", "", КНП_ЗаписатьJSONНаСервере(ФорматДанных) );	
	Возврат Результат;		

КонецФункции

Функция ЭДО_ОтправитьПодписанныйДокумент(Контрагент, ТипДокумента, Контент, Подпись, СсылкаНаДокумент = Неопределено)
	
	Результат = Неопределено;
	
	СтруктураТелаЗапроса = Новый Структура;
	СтруктураТелаЗапроса.Вставить("from", ИдентификаторПодразделения);
	ИдентификаторыКонтрагента = РС_ПолучитьИдентификаторыКонтрагента(Контрагент);
	
	Если ЗначениеЗаполнено(ИдентификаторыКонтрагента) И ИдентификаторыКонтрагента.Свойство("ИдентификаторПодразделения") Тогда
		СтруктураТелаЗапроса.Вставить("to", ИдентификаторыКонтрагента.ИдентификаторПодразделения);	
	КонецЕсли;       
	
	//+Белов А. 26.06.2026 #
	Если ТипЗнч(СсылкаНаДокумент) = Тип("ДокументСсылка.ТранспортнаяНакладная") Тогда
		СтруктураТелаЗапроса.Вставить("carrier", ФОД_ПолучитьИдентификаторПеревозчика(Неопределено, СсылкаНаДокумент));	
	КонецЕсли;
	//-Белов А. 26.06.2026 #
	
	СтруктураТелаЗапроса.Вставить("content", Контент);
	СтруктураТелаЗапроса.Вставить("signature", КНП_ОбработатьСтрокуBase64(Подпись) );
	
	Если ЗначениеЗаполнено(СсылкаНаДокумент) Тогда
		
		Если МОП_ЭтоНеформализованныйДокумент(СсылкаНаДокумент) Тогда
			
			СтруктураНеформализованного = ПолучитьДанныеНеформализованногоДокумента(СсылкаНаДокумент);
			
			Для Каждого ЭлементСтруктуры Из СтруктураНеформализованного Цикл
				
				Если НЕ СтруктураТелаЗапроса.Свойство(ЭлементСтруктуры.Ключ) Тогда
					СтруктураТелаЗапроса.Вставить(ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Значение);
				КонецЕсли;
				
			КонецЦикла;
			
			Результат = API_ОтправитьНеформализованныйДокумент(КНП_ЗаписатьJSONНаСервере(СтруктураТелаЗапроса), ЭДО_ДвухстороннийОбмен(ТипДокумента) ); 
			
		Иначе
			
			КорректируемыйДокумент = Неопределено;
			
			Если МОП_ЭтоКорректировкаРеализации(СсылкаНаДокумент) Тогда
				КорректируемыйДокумент = МОП_ПолучитьСсылкуНаКорректировку(СсылкаНаДокумент);
			ИначеЕсли МОП_ЭтоКорректировкаРеализации(МОП_ПолучитьСсылкуНаКорректировку(СсылкаНаДокумент) ) Тогда
				КорректируемыйДокумент = МОП_ПолучитьСсылкуНаКорректировку(МОП_ПолучитьСсылкуНаКорректировку(СсылкаНаДокумент) );	
			КонецЕсли;
			
			Результат = API_ОтправитьДокументСПодписью(ТипДокумента, КНП_ЗаписатьJSONНаСервере(СтруктураТелаЗапроса) );
			
		КонецЕсли;
		
	Иначе
		Результат = API_ОтправитьДокументСПодписью(ТипДокумента, КНП_ЗаписатьJSONНаСервере(СтруктураТелаЗапроса) );	
	КонецЕсли;
	
	Если ТипЗнч(Результат) = Тип("Соответствие") Тогда
		
		Если Результат.Получить("success") = Истина Тогда
			
			Если ЗначениеЗаполнено(СсылкаНаДокумент) Тогда
				
				ЭтоУПД = (ТипДокумента = "УПД") ИЛИ Найти(ТипДокумента, "Универсальный");
				РС_ПривязатьИдентификаторКОбъекту1С(СсылкаНаДокумент, Результат.Получить("documentId"), Истина, ЭтоУПД );
				РС_ОбновитьСтатусДокументаЭДО(СсылкаНаДокумент, Результат.Получить("message") );	
				
			КонецЕсли;
			
		Иначе
			ВывестиУведомлениеПользователю(Результат.Получить("codeDescription") );
		КонецЕсли;
		
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция ЭДО_ОтправитьПодписаннуюКвитанцию(ИдентификаторДокумента, Контент, Подпись, Команда)
	
	Результат = Неопределено;
	СтруктураТелаЗапроса = Новый Структура;
	СтруктураТелаЗапроса.Вставить("content", Контент);
	//СтруктураТелаЗапроса.Вставить("signature", КНП_ОбработатьСтрокуBase64(Подпись) );
	
	Если Команда = "Принять" Тогда
		Результат = API_ПринятьДокумент(ИдентификаторДокумента, КНП_ЗаписатьJSONНаСервере(СтруктураТелаЗапроса) );	
	ИначеЕсли Команда = "Аннулировать" Тогда
		Результат = API_АннулироватьДокумент(ИдентификаторДокумента, КНП_ЗаписатьJSONНаСервере(СтруктураТелаЗапроса) );	
	ИначеЕсли Команда = "ПринятьАннулирование" Тогда
		Результат = API_ПринятьАннулирование(ИдентификаторДокумента, КНП_ЗаписатьJSONНаСервере(СтруктураТелаЗапроса) );	
	ИначеЕсли Команда = "ОтклонитьАннулирование" Тогда
		Результат = API_ОтклонитьАннулирование(ИдентификаторДокумента, КНП_ЗаписатьJSONНаСервере(СтруктураТелаЗапроса) );
	ИначеЕсли Команда = "ОтказПодписи" Тогда
		
		СтруктураТелаЗапроса.Удалить("content");
		СтруктураТелаЗапроса.Вставить("reason", Контент);
		Результат = API_ОтклонитьДокумент(ИдентификаторДокумента, КНП_ЗаписатьJSONНаСервере(СтруктураТелаЗапроса) );
		
	Иначе	
		Результат = API_ОтклонитьДокумент(ИдентификаторДокумента, КНП_ЗаписатьJSONНаСервере(СтруктураТелаЗапроса) );	
	КонецЕсли;
	
	Если ТипЗнч(Результат) <> Тип("Соответствие") Тогда
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция ЭДО_ЗагрузитьМассивВходящихЭД(ДатаНачала, ДатаКонца)
	
	ДобавитьВЖурнал("Вход в процедуру", "ЗагрузитьМассивВходящихЭД");
	СтруктураВозврата = Новый Структура("МассивПакетов,ОписаниеОшибки");
	СтруктураПараметров = Новый Соответствие;
	СтруктураПараметров.Вставить("packageTypes[0]", "IN");
	СтруктураПараметров.Вставить("packageStates[0]", "complete");
	
	Если ВерсияAPI = "v1.2" Тогда
		СтруктураПараметров.Вставить("packageStates[1]", "accepted");
	КонецЕсли;
	
	ДанныеПакетов = API_ПолучитьСписокПакетов(СтруктураПараметров);
	
	Если ТипЗнч(ДанныеПакетов) <> Тип("Соответствие") Тогда
		
		СтруктураВозврата.ОписаниеОшибки = ДанныеПакетов;
		Возврат СтруктураВозврата;
		
	КонецЕсли;
	
	Если ДанныеПакетов.Получить("success") <> Неопределено И ДанныеПакетов.Получить("success") Тогда
		
		МассивПакетов = ДанныеПакетов.Получить("rows");
		НовыйМассив = Новый Массив; 
		
		Если НЕ ЗначениеЗаполнено(МассивПакетов) Тогда
			
			СтруктураВозврата.МассивПакетов = НовыйМассив;
			Возврат СтруктураВозврата;
			
		КонецЕсли;
		
		Для Каждого Пакет Из МассивПакетов Цикл
			
			СистемноеИмяВидаДокументооборота = Пакет.Получить("packageFlowSystemName"); 
			
			Если СистемноеИмяВидаДокументооборота = "information_message" Тогда
				Продолжить;
			КонецЕсли;	
			
			ДатаИзменения = КНП_ПривестиКДате(Пакет.Получить("documentDate") );
			
			Если ДатаИзменения >= ДатаНачала И ДатаИзменения <= КонецДня(ДатаКонца) Тогда
				НовыйМассив.Добавить(Пакет);
			КонецЕсли;
			
		КонецЦикла;
		
		СтруктураВозврата.МассивПакетов = НовыйМассив;
		
	Иначе
		ВывестиУведомлениеПользователю(ДанныеПакетов.Получить("codeDescription") );	
	КонецЕсли;
	
	Возврат СтруктураВозврата;

КонецФункции

