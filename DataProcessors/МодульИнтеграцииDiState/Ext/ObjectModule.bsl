Функция ФОД_ПолучитьДатуДоговора(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	//Changelog
	//
	//2019.09.10 - добавлена проверка на заполненность объекта заполнения
	
	//==Специфичный блок кода
	Если ВеткаРазработки = "ТЭК-Торг" Тогда
		Возврат Неопределено;	
	КонецЕсли;
	//==Специфичный блок кода
	
	Если ОбъектЗаполнения = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(ОбъектЗаполнения) = Тип("Структура") Тогда
		
		Результат = КНП_БезопасноПрочитатьЗначение(ОбъектЗаполнения, "Дата");
		
		Если Результат <> Неопределено Тогда
			Возврат Формат(Результат, "ДФ=дд.ММ.гггг");
		КонецЕсли;
		
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ОбъектЗаполнения, "ДатаДоговора") И ЗначениеЗаполнено(ОбъектЗаполнения.ДатаДоговора) Тогда
		Возврат Формат(ОбъектЗаполнения.ДатаДоговора, "ДФ=дд.ММ.гггг");	
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ОбъектЗаполнения, "Дата") И ЗначениеЗаполнено(ОбъектЗаполнения.Дата) Тогда
		Возврат Формат(ОбъектЗаполнения.Дата, "ДФ=дд.ММ.гггг");
	КонецЕсли;
	
	Возврат Формат(Дата(2019,1,1), "ДФ=дд.ММ.гггг");

КонецФункции

