Функция ПолучитьКоличествоМестПоДокументамОснованияИзЗаданияНаДоставку(МассивДокументов, ЗаданиеНаДоставку)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РеализацияТоваровУслугДокументыСборкиЗаказов.ДокументСборки
	|ПОМЕСТИТЬ ВТ_СборкиРеализаций
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.ДокументыСборкиЗаказов КАК РеализацияТоваровУслугДокументыСборкиЗаказов
	|ГДЕ
	|	РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка В(&МассивДокументов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ЗаданиеНаДоставкуДоставка.Количество) КАК Количество
	|ИЗ
	|	Документ.ЗаданиеНаДоставку.Доставка КАК ЗаданиеНаДоставкуДоставка
	|ГДЕ
	|	ЗаданиеНаДоставкуДоставка.ДокументСборки В
	|			(ВЫБРАТЬ
	|				ВТ_СборкиРеализаций.ДокументСборки
	|			ИЗ
	|				ВТ_СборкиРеализаций)
	|	И ЗаданиеНаДоставкуДоставка.Ссылка = &ЗаданиеНаДоставку";
	
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов); 
	Запрос.УстановитьПараметр("ЗаданиеНаДоставку", ЗаданиеНаДоставку);
	
	Выборка = Запрос.Выполнить().Выбрать();                 
	
	Если Выборка.Следующий() Тогда
		Если Выборка.Количество <> NULL Тогда	
			Возврат Выборка.Количество;	  
		КонецЕсли;
	КонецЕсли; 
	
	Возврат 1;	
	
КонецФункции

