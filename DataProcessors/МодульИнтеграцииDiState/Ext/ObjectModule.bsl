Функция МОП_СоздатьКонтрагента(СтруктураДанных)
	
	СправочникМенеджер = Неопределено;
	
	Если КНП_ЕстьОбъектМетаданных("Контрагенты") Тогда
		СправочникМенеджер = Справочники.Контрагенты;
	КонецЕсли;
	
	Если СправочникМенеджер = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка	
		
		ЭлементСправочника = СправочникМенеджер.СоздатьЭлемент();
		ЭлементСправочника.Наименование = СтруктураДанных.Наименование;
		
		Если СтруктураДанных.Свойство("ИНН") Тогда 
			ЭлементСправочника.ИНН = СтруктураДанных.ИНН 
		КонецЕсли;    
		
		Если СтруктураДанных.Свойство("КПП") Тогда 
			ЭлементСправочника.КПП = СтруктураДанных.КПП 
		КонецЕсли;
		
		Если СтруктураДанных.Свойство("ОГРН") Тогда
			
			Если КНП_ЕстьРеквизит(ЭлементСправочника, "ОГРН") Тогда
				ЭлементСправочника.ОГРН = СтруктураДанных.ОГРН;
			ИначеЕсли КНП_ЕстьРеквизит(ЭлементСправочника, "РегистрационныйНомер") Тогда
				ЭлементСправочника.РегистрационныйНомер = СтруктураДанных.ОГРН;
			КонецЕсли;
			
		КонецЕсли;
		
		//Юрфизлицо
		Если СтрДлина(СтруктураДанных.ИНН) > 10 Тогда
			
			Если КНП_ЕстьРеквизит(ЭлементСправочника, "ЮридическоеФизическоеЛицо") Тогда
				
				Если КНП_ЕстьОбъектМетаданных("ЮридическоеФизическоеЛицо") Тогда
					ЭлементСправочника.ЮридическоеФизическоеЛицо = ПредопределенноеЗначение("Перечисление.ЮридическоеФизическоеЛицо.ФизическоеЛицо");
				ИначеЕсли ЭлементСправочника.Метаданные().Реквизиты.ЮридическоеФизическоеЛицо.Тип.СодержитТип(Тип("СправочникСсылка.ФизическиеЛица") ) Тогда //спец. для БГУ
					ЭлементСправочника.ЮридическоеФизическоеЛицо = МОП_СоздатьФизическоеЛицо(СтруктураДанных);	
				КонецЕсли;
				
			КонецЕсли;
			
			Если КНП_ЕстьРеквизит(ЭлементСправочника, "ЮрФизЛицо") Тогда
				
				Если КНП_ЕстьОбъектМетаданных("ЮрФизЛицо") Тогда
					ЭлементСправочника.ЮрФизЛицо = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ИндивидуальныйПредприниматель");
				КонецЕсли;
				
			КонецЕсли;
			
			Если КНП_ЕстьРеквизит(ЭлементСправочника, "ВидКонтрагента") Тогда
				
				Если КНП_ЕстьОбъектМетаданных("ВидыКонтрагентов") Тогда
					ЭлементСправочника.ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ВидыКонтрагентов.ИндивидуальныйПредприниматель");
				ИначеЕсли КНП_ЕстьОбъектМетаданных("ЮрФизЛицо") Тогда
					ЭлементСправочника.ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ФизЛицо");
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			
			Если КНП_ЕстьРеквизит(ЭлементСправочника, "ЮридическоеФизическоеЛицо") Тогда
				
				Если КНП_ЕстьОбъектМетаданных("ЮридическоеФизическоеЛицо") Тогда
					ЭлементСправочника.ЮридическоеФизическоеЛицо = ПредопределенноеЗначение("Перечисление.ЮридическоеФизическоеЛицо.ЮридическоеЛицо");
				ИначеЕсли ЭлементСправочника.Метаданные().Реквизиты.ЮридическоеФизическоеЛицо.Тип.СодержитТип(Тип("СправочникСсылка.ЮридическиеЛица") ) Тогда //спец. для БГУ 
					ЭлементСправочника.ЮридическоеФизическоеЛицо = МОП_СоздатьЮридическоеЛицо(СтруктураДанных);		
				КонецЕсли;
				
			КонецЕсли;
			
			Если КНП_ЕстьРеквизит(ЭлементСправочника, "ЮрФизЛицо") Тогда
				
				Если КНП_ЕстьОбъектМетаданных("ЮрФизЛицо") Тогда
					ЭлементСправочника.ЮрФизЛицо = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ЮрЛицо");
				КонецЕсли;
				
			КонецЕсли;	
			
			Если КНП_ЕстьРеквизит(ЭлементСправочника, "ВидКонтрагента") Тогда
				
				Если КНП_ЕстьОбъектМетаданных("ВидыКонтрагентов") Тогда
					ЭлементСправочника.ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ВидыКонтрагентов.ЮридическоеЛицо");
				ИначеЕсли КНП_ЕстьОбъектМетаданных("ЮрФизЛицо") Тогда
					ЭлементСправочника.ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ЮрЛицо");
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если КНП_ЕстьРеквизит(ЭлементСправочника, "СтранаРегистрации") Тогда
			ЭлементСправочника.СтранаРегистрации = Справочники.СтраныМира.НайтиПоКоду("643");
		КонецЕсли;
		
		//Счета учета
		Если КНП_ЕстьРеквизит(ЭлементСправочника, "СчетУчетаАвансовПокупателя") Тогда
			
			Если Метаданные.ПланыСчетов.Найти("Управленческий") <> Неопределено Тогда
				
				ЭлементСправочника.СчетУчетаАвансовПокупателя = ПланыСчетов.Управленческий.РасчетыПоАвансамПолученным;
				ЭлементСправочника.СчетУчетаАвансовПоставщику = ПланыСчетов.Управленческий.РасчетыПоАвансамВыданным;
				ЭлементСправочника.СчетУчетаРасчетовСПокупателем = ПланыСчетов.Управленческий.РасчетыСПокупателями;
				ЭлементСправочника.СчетУчетаРасчетовСПоставщиком = ПланыСчетов.Управленческий.РасчетыСПоставщиками;
				
			КонецЕсли;
			
		КонецЕсли;
		
		//Партнер
		Если КНП_ЕстьОбъектМетаданных("Партнеры") Тогда
			
			Если КНП_ЕстьРеквизит(ЭлементСправочника, "Партнер") Тогда
				ЭлементСправочника.Партнер = МОП_СоздатьПартнера(ЭлементСправочника);
			КонецЕсли;
			
		КонецЕсли;
		
		ЭлементСправочника.Записать();
		
		Если СтруктураДанных.Свойство("БИК") И СтруктураДанных.Свойство("НомерСчета") Тогда
			
			БанковскийСчет = МОП_СоздатьБанковскийСчетКонтрагента(СтруктураДанных.БИК, СтруктураДанных.НомерСчета, ЭлементСправочника.Ссылка);
			
			Если КНП_ЕстьРеквизит(ЭлементСправочника, "ОсновнойБанковскийСчет") Тогда
				
				ЭлементСправочника.ОсновнойБанковскийСчет = БанковскийСчет;
				ЭлементСправочника.Записать();
				
			КонецЕсли;
			
			Если КНП_ЕстьРеквизит(ЭлементСправочника, "БанковскийСчетПоУмолчанию") Тогда
				
				ЭлементСправочника.БанковскийСчетПоУмолчанию = БанковскийСчет;
				ЭлементСправочника.Записать();
				
			КонецЕсли;
			
		КонецЕсли;
		
	Исключение
		
		ДобавитьВЖурнал(ОписаниеОшибки(), "МОП_СоздатьКонтрагента");
		Возврат СправочникМенеджер.ПустаяСсылка();
		
	КонецПопытки;
	
	Возврат ЭлементСправочника.Ссылка;
	
КонецФункции

