// Процедура - Записать в журнал
//
// Параметры:
//  Событие		 - Строка	 - Описание события
//  МестоВызова	 - Строка	 - Наименование функции, откуда она вызывалась
//
Процедура ДобавитьВЖурнал(Событие, МестоВызова = "Модуль интеграции") Экспорт
	
	ФайлЖурнала.ДобавитьСтроку(Строка(ТекущаяДата() ) + ":: " + МестоВызова + ": " + Событие);

КонецПроцедуры

Процедура ДобавитьВЖурналОтладочнуюИнформацию(Событие, МестоВызова = "Модуль интеграции") Экспорт
	
	Если Отладка Тогда
		
		ФайлЖурнала.ДобавитьСтроку("ОТЛАДКА: " + Строка(ТекущаяДата() ) + ":: " + МестоВызова + ": " + Событие);
		ЗаписатьЖурналВФайл();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаписатьЖурналВФайл() Экспорт  
	
	Если ОтключитьЗаписьЖурнала() Тогда
		
		ФайлЖурнала.Очистить();
		Возврат;
		
	КонецЕсли;
	
	Попытка
		
		ПутьКВременномуФайлу = КаталогВременныхФайлов() + "distate_log_file_" + Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy") + ".txt";
		
		ЗаписьТекста = Новый ЗаписьТекста(ПутьКВременномуФайлу,,,Истина);
		
		Если ФайлЖурнала.КоличествоСтрок() > 0 Тогда
			ЗаписьТекста.ЗаписатьСтроку(ФайлЖурнала.ПолучитьТекст() );
		КонецЕсли;    
		
		ФайлЖурнала.Очистить();
		ЗаписьТекста.Закрыть();
		
	Исключение
		
		ЗаписьЖурналаРегистрации("DS_МодульИнтеграции.Журналирование", УровеньЖурналаРегистрации.Предупреждение,,,ОписаниеОшибки() );
		ЗаписьЖурналаРегистрации("DS_МодульИнтеграции.Журналирование", УровеньЖурналаРегистрации.Предупреждение,,,"ЛОГ: " + ФайлЖурнала.ПолучитьТекст() );
		
		ФайлЖурнала.Очистить();
		
	КонецПопытки; 
	
КонецПроцедуры

Функция ОтключитьЗаписьЖурнала()
	
	Возврат Константы.ЭДО_ОтключитьЗаписьЖурнала.Получить();

КонецФункции

Функция ПрочитатьЖурналИзФайла() 				Экспорт
	
	ЗаписатьЖурналВФайл();
	
	ПутьКВременномуФайлу = КаталогВременныхФайлов() + "distate_log_file_" + Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy") + ".txt";
	ЧтениеТекста = Новый ЧтениеТекста(ПутьКВременномуФайлу, КодировкаТекста.UTF8);
	Текст = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();
	
	Возврат Текст;

КонецФункции

Процедура ОчиститьЖурналВФайле()				Экспорт
	
	ПутьКВременномуФайлу = КаталогВременныхФайлов() + "distate_log_file_" + Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy") + ".txt";
	УдалитьФайлы(ПутьКВременномуФайлу);	

КонецПроцедуры

Процедура ВывестиУведомлениеПользователю(Знач Текст) Экспорт
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;	
	Сообщение.Сообщить();
	ДобавитьВЖурнал(Текст, "Модуль интеграции");	

КонецПроцедуры

