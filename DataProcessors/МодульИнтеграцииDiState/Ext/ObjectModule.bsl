Функция МОП_СоздатьПартнера(СсылкаНаКонтрагента)
	
	СправочникМенеджер = Неопределено;
	
	Если КНП_ЕстьОбъектМетаданных("Партнеры") Тогда
		СправочникМенеджер = Справочники.Партнеры;
	КонецЕсли;
	
	Если СправочникМенеджер = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка	
		
		ЭлементСправочника = СправочникМенеджер.СоздатьЭлемент();
		ЭлементСправочника.Наименование = СсылкаНаКонтрагента.Наименование;
		
		Если КНП_ЕстьРеквизит(ЭлементСправочника, "НаименованиеПолное") И КНП_ЕстьРеквизит(СсылкаНаКонтрагента, "НаименованиеПолное") Тогда
			ЭлементСправочника.НаименованиеПолное = СсылкаНаКонтрагента.НаименованиеПолное;
		КонецЕсли;
		
		Если КНП_ЕстьРеквизит(ЭлементСправочника, "ЮрФизЛицо") И КНП_ЕстьРеквизит(СсылкаНаКонтрагента, "ЮрФизЛицо") Тогда
			ЭлементСправочника.ЮрФизЛицо = СсылкаНаКонтрагента.ЮрФизЛицо;
		КонецЕсли;
		
		ЭлементСправочника.Записать();	
		
	Исключение
		
		ДобавитьВЖурнал(ОписаниеОшибки(), "МОП_СоздатьПартнера");
		Возврат СправочникМенеджер.ПустаяСсылка();
		
	КонецПопытки;
	
	Возврат ЭлементСправочника.Ссылка;	
	
КонецФункции

Функция МОП_СоздатьБанковскийСчетКонтрагента(БИК, НомерСчета, Владелец)
	
	СправочникМенеджер = Неопределено;
	
	Если КНП_ЕстьОбъектМетаданных("БанковскиеСчета") Тогда
		СправочникМенеджер = Справочники.БанковскиеСчета;
	КонецЕсли;
	
	Если КНП_ЕстьОбъектМетаданных("БанковскиеСчетаКонтрагентов") Тогда
		СправочникМенеджер = Справочники.БанковскиеСчетаКонтрагентов;
	КонецЕсли;
	
	Если КНП_ЕстьОбъектМетаданных("БанковскиеИКазначейскиеСчета") Тогда
		СправочникМенеджер = Справочники.БанковскиеИКазначейскиеСчета;
	КонецЕсли;
	
	Если СправочникМенеджер = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка	
		
		ЭлементСправочника = СправочникМенеджер.СоздатьЭлемент();
		ЭлементСправочника.Наименование = НомерСчета;
		ЭлементСправочника.Владелец = Владелец;
		
		Если КНП_ЕстьРеквизит(ЭлементСправочника, "НомерСчета") Тогда
			ЭлементСправочника.НомерСчета = НомерСчета;
		ИначеЕсли КНП_ЕстьСтандартныйРеквизит(ЭлементСправочника, "Код") Тогда
			ЭлементСправочника.Код = НомерСчета;
		КонецЕсли;
		
		Если КНП_ЕстьРеквизит(ЭлементСправочника, "Банк") Тогда
			
			ЭлементСправочника.Банк = МОП_ПолучитьБанкПоБИКу(БИК);
			ЭлементСправочника.Наименование = ЭлементСправочника.Наименование + " (" + Строка(ЭлементСправочника.Банк) + ")";
			
		КонецЕсли;
		
		Если КНП_ЕстьРеквизит(ЭлементСправочника, "КассовыйОрган") Тогда
			
			ЭлементСправочника.КассовыйОрган = МОП_ПолучитьБанкПоБИКу(БИК);
			ЭлементСправочника.Наименование = ЭлементСправочника.Наименование + " (" + Строка(ЭлементСправочника.БанкДляРасчетов) + ")";
			
		КонецЕсли;
		
		Если КНП_ЕстьРеквизит(ЭлементСправочника, "ВалютаДенежныхСредств") Тогда
			ЭлементСправочника.ВалютаДенежныхСредств = Справочники.Валюты.НайтиПоНаименованию("руб");
		КонецЕсли;
		
		Если КНП_ЕстьРеквизит(ЭлементСправочника, "ТипЛицевогоСчета") Тогда
			
			Если КНП_ЕстьОбъектМетаданных("ТипыЛицевыхСчетов") Тогда
				ЭлементСправочника.ТипЛицевогоСчета = ПредопределенноеЗначение("Перечисление.ТипыЛицевыхСчетов.Банковский");	
			КонецЕсли;
			
		КонецЕсли;
		
		ЭлементСправочника.Записать();
		
	Исключение
		
		ДобавитьВЖурнал(ОписаниеОшибки(), "МОП_СоздатьБанковскийСчетКонтрагента");
		Возврат СправочникМенеджер.ПустаяСсылка();
		
	КонецПопытки;
	
	Возврат ЭлементСправочника.Ссылка;
	
КонецФункции

