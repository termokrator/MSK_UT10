Функция ФОД_ПолучитьТелефонКомпанииПеревозчика(ВерсияЗаполнения, Знач ОбъектЗаполнения, Документ = Неопределено)
	//+Белов А. 17.06.2026 #UT10-5921
	
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.ТранспортнаяНакладная") Тогда   
		
		Если ЗначениеЗаполнено(Документ.ЗаказЗаявка) Тогда
			
			ТелефонКонтрагента = ПолучитьТелефонПоОбъекту(Документ.ЗаказЗаявка.Контрагент); 
			
			Если ЗначениеЗаполнено(ТелефонКонтрагента) Тогда
				Возврат ТелефонКонтрагента;
			Иначе
				Возврат ПолучитьТелефонПоОбъекту(Документ.ЗаданиеНаДоставку.Водитель);	
			КонецЕсли;  
			
		Иначе
			Возврат ПолучитьТелефонПоОбъекту(Документ.ЗаданиеНаДоставку.Водитель);
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.ЗаказЗаявка") Тогда  
		
		Если ЗначениеЗаполнено(Документ.ЗаданиеНаДоставку) Тогда
			
			ТелефонКонтрагента = ПолучитьТелефонПоОбъекту(Документ.Контрагент); 
			
			Если ЗначениеЗаполнено(ТелефонКонтрагента) Тогда
				Возврат ТелефонКонтрагента;
			Иначе
				Возврат ПолучитьТелефонПоОбъекту(Документ.ЗаданиеНаДоставку.Водитель);	
			КонецЕсли;
			
		//+Белов А. 02.09.2026 #UT10-6021
		Иначе
			Возврат Документ.ТелефонКонтрагента;
		КонецЕсли;
		//-Белов А. 02.09.2026 #UT10-6021
		
	КонецЕсли;	
	
	//-Белов А. 17.06.2026 #UT10-5921
КонецФункции

Функция ПолучитьТелефонПоОбъекту(Объект)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КонтактнаяИнформация.Представление
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Тип = &Тип
	|	И КонтактнаяИнформация.Объект = &Объект";    	
	
	Запрос.УстановитьПараметр("Объект", Объект); 
	Запрос.УстановитьПараметр("Тип", Перечисления.ТипыКонтактнойИнформации.Телефон); 
	
	Выборка = Запрос.Выполнить().Выбрать();   
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Представление;
	КонецЕсли;              
	
	Возврат "";
		
КонецФункции 

Функция ФОД_ПолучитьВодителей(Знач ОбъектЗаполнения)
//+Белов А. 17.06.2026 #UT10-5921

	Водитель = ОбъектЗаполнения.ЗаданиеНаДоставку.Водитель;
	
	ФИОМассив = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(Водитель.Наименование, " ");
	
	СтруктураВодителя = Новый Структура();      
	
	Если ФИОМассив.Количество() > 0 Тогда
		
		СтруктураВодителя.Вставить("Фамилия", ФИОМассив[0]);    
		СтруктураВодителя.Вставить("Имя", ФИОМассив[1]);  
		
		Если ФИОМассив.Количество() > 2 Тогда
			СтруктураВодителя.Вставить("Отчество", ФИОМассив[2]);	
		КонецЕсли;
		
	КонецЕсли;
		   
	СтруктураВодителя.Вставить("Телефон", ПолучитьТелефонПоОбъекту(Водитель));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументСерия,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументНомер,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументДатаВыдачи
	|ИЗ
	|	РегистрСведений.ПаспортныеДанныеФизЛиц.СрезПоследних КАК ПаспортныеДанныеФизЛицСрезПоследних
	|ГДЕ
	|	ПаспортныеДанныеФизЛицСрезПоследних.ФизЛицо = &ФизЛицо
	|	И ПаспортныеДанныеФизЛицСрезПоследних.ДокументВид = &ДокументВид";
	
	Запрос.УстановитьПараметр("ДокументВид", Справочники.ДокументыУдостоверяющиеЛичность.ВодительскоеУдостоверение);  
	Запрос.УстановитьПараметр("ФизЛицо", Водитель);  
	
	Выборка = Запрос.Выполнить().Выбрать();   
	
	Если Выборка.Следующий() Тогда
		
		СтруктураВодителя.Вставить("СерияВУ", Выборка.ДокументСерия); 
		СтруктураВодителя.Вставить("НомерВУ", Выборка.ДокументНомер); 
		СтруктураВодителя.Вставить("ДатаВУ", Выборка.ДокументДатаВыдачи);
		
	КонецЕсли;    	
	
	Если ЗначениеЗаполнено(Водитель.ИНН) Тогда
		СтруктураВодителя.Вставить("ИНН", Водитель.ИНН);
	ИначеЕсли ЗначениеЗаполнено(ОбъектЗаполнения.ЗаказЗаявка) Тогда
		СтруктураВодителя.Вставить("ИНН", ОбъектЗаполнения.ЗаказЗаявка.Контрагент.ИНН);
	КонецЕсли;    

	МассивВозврата = Новый Массив;
	МассивВозврата.Добавить(СтруктураВодителя);
	
	Возврат МассивВозврата;
		
//-Белов А. 17.06.2026 #UT10-5921
КонецФункции   

