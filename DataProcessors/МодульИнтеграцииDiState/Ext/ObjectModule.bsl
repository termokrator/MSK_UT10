	Если ТипЗнч(ИнфоСооб) = Тип("Соответствие") Тогда
		
		Если ИнфоСооб.Получить("success") <> Неопределено Тогда
			
			Если ИнфоСооб.Получить("success") = Истина Тогда
				Результат = ИнфоСооб.Получить("content");
			Иначе
				ВывестиУведомлениеПользователю(ИнфоСооб.Получить("codeDescription") );
			КонецЕсли;	
			
		КонецЕсли;
		
	КонецЕсли;
	
	ЗаписатьЖурналВФайл();
	Возврат Результат;

