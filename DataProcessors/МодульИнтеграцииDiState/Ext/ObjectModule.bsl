Функция ФОД_ПолучитьАдресКомпании(Знач ОбъектЗаполнения, Документ = Неопределено, ВидКонтактнойИнформации = Неопределено)
	//Changelog
	//
	//22.03.2019 - добавлено логирование незаполненности структуры адреса в базе 1С
	//18.04.2019 - заполнение фактическим адресом
	
	ЗагрузитьДанныеИзЭДО = Ложь;
	
	Если ТипЗнч(ОбъектЗаполнения) = Тип("СправочникСсылка.Контрагенты") Тогда
		
		Филиал = Неопределено;
		
		Если ТипЗнч(Документ) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
			
			Если ТипЗнч(Документ.ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
				Филиал = Документ.ДокументОснование.Грузополучатель;	
			ИначеЕсли ТипЗнч(Документ.ДокументОснование) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
				Филиал = Документ.ДокументОснование.Грузополучатель;
			КонецЕсли;
			
		КонецЕсли; 

		Если ЗначениеЗаполнено(Филиал) И УФилиалаЗаполненАдресОП(Филиал) И (ТипЗнч(Документ) = Тип("ДокументСсылка.СчетФактураВыданный") 
			И ТипЗнч(Документ.ДокументОснование) = Тип("ДокументСсылка.КорректировкаРеализации")) Тогда
			
			ОбъектЗаполнения = Филиал; 
			ВидКонтактнойИнформации = Справочники.ВидыКонтактнойИнформации.ЮрАдресОбособленногоПодразделения; 

		ИначеЕсли ЗначениеЗаполнено(Филиал) 
			И УФилиалаЗаполненАдрес(Филиал) И (НЕ ТипЗнч(Документ.ДокументОснование) = Тип("ДокументСсылка.КорректировкаРеализации")) Тогда 
			
			ОбъектЗаполнения = Филиал; 
			ВидКонтактнойИнформации = МОП_ПолучитьВидКИФактАдреса(ОбъектЗаполнения, КНП_ИмяКонфигурации()); 
			
		Иначе            
			
			Если Документ <> Неопределено Тогда
				ОбъектЗаполнения = Документ.ДокументОснование.Контрагент;
			КонецЕсли;
			 
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипЗнч(ОбъектЗаполнения) = Тип("СправочникСсылка.Организации") Тогда
		ВидКонтактнойИнформации = МОП_ПолучитьВидКИФактАдреса(ОбъектЗаполнения, КНП_ИмяКонфигурации());
	Иначе
		
		Если Не ЗначениеЗаполнено(ВидКонтактнойИнформации) Тогда
			ВидКонтактнойИнформации = МОП_ПолучитьВидКИЮрАдреса(ОбъектЗаполнения, КНП_ИмяКонфигурации()); 	
		КонецЕсли;   	
		
	КонецЕсли;
	
	СтруктураАдреса = КЗП_ПолучитьСтруктуруАдресаИзБазы(ОбъектЗаполнения, КНП_ИмяКонфигурации(), ВидКонтактнойИнформации );
	
	Если СтруктураАдреса.ТипАдреса <> "text" И НЕ ЗначениеЗаполнено(СтруктураАдреса.КодРегиона) Тогда
		
		ДобавитьВЖурнал("Не заполнен код региона в адресе компании " + ОбъектЗаполнения, "ПолучитьАдресКомпании");
		ЗагрузитьДанныеИзЭДО = Истина;
		
	КонецЕсли;     
	
	Если СтруктураАдреса.ТипАдреса <> "text" И НЕ ЗначениеЗаполнено(СтруктураАдреса.Индекс) Тогда
		
		ДобавитьВЖурнал("Не заполнен индекс в адресе компании " + ОбъектЗаполнения, "ПолучитьАдресКомпании");
		ЗагрузитьДанныеИзЭДО = Истина;
		
	КонецЕсли;            
	
	Если ЗагрузитьДанныеИзЭДО Тогда
		
		ДанныеКонтрагента = ПолучитьДанныеКонтрагентаПоИНН(ОбъектЗаполнения.ИНН);
		
		Если ТипЗнч(ДанныеКонтрагента) = Тип("Соответствие") Тогда
			
			СоответствиеАдреса = ДанныеКонтрагента.Получить("address");
			СтруктураАдреса = КНП_КонвертироватьАдресИзСоответствия(СоответствиеАдреса);
			
		КонецЕсли;
		
	КонецЕсли;    
	
	Возврат СтруктураАдреса;

КонецФункции

