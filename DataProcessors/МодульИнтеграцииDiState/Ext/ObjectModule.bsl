Функция МОП_ПолучитьБанковскийСчетИзДокумента(ДокументСсылка)
	
	Если КНП_ЕстьРеквизит(ДокументСсылка, "СтруктурнаяЕдиница") Тогда
		СсылкаНаБанк = ДокументСсылка.СтруктурнаяЕдиница.Банк;
	ИначеЕсли КНП_ЕстьРеквизит(ДокументСсылка, "БанковскийСчетОрганизации") Тогда
		СсылкаНаБанк = ДокументСсылка.БанковскийСчетОрганизации.Банк;
	ИначеЕсли КНП_ЕстьРеквизит(ДокументСсылка, "БанковскийСчет") Тогда
		СсылкаНаБанк = ДокументСсылка.БанковскийСчет.Банк;
	КонецЕсли;	

КонецФункции

Функция МОП_ПолучитьБанковскийСчетОрганизации(СсылкаНаОрганизацию)
	
	Результат = Неопределено;	
	
	Если КНП_ЕстьРеквизит(СсылкаНаОрганизацию, "ОсновнойБанковскийСчет") Тогда
		Результат = СсылкаНаОрганизацию.ОсновнойБанковскийСчет;
	ИначеЕсли КНП_ЕстьОбъектМетаданных("БанковскиеСчетаОрганизаций") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	БанковскиеСчетаОрганизаций.Ссылка
		|ИЗ
		|	Справочник.БанковскиеСчетаОрганизаций КАК БанковскиеСчетаОрганизаций
		|ГДЕ
		|	БанковскиеСчетаОрганизаций.Владелец = &Владелец
		|	И БанковскиеСчетаОрганизаций.Закрыт = ЛОЖЬ
		|	И БанковскиеСчетаОрганизаций.ПометкаУдаления = ЛОЖЬ"; 
		
		Запрос.УстановитьПараметр("Владелец", СсылкаНаОрганизацию);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Результат = Выборка.Ссылка;
		КонецЕсли;	
		
	Иначе
		ДобавитьВЖурнал("Неподдерживаемая конфигурация", "МОП_ПолучитьБанковскийСчетОрганизации");
	КонецЕсли;
	
	Возврат Результат;	

КонецФункции

Функция МОП_ПолучитьБанковскийСчетКонтрагента(СсылкаНаКонтрагента, СсылкаНаДокумент = Неопределено)
	
	Результат = Неопределено;	
	
	Если КНП_ЕстьРеквизит(СсылкаНаКонтрагента, "ОсновнойБанковскийСчет") Тогда
		Результат = СсылкаНаКонтрагента.ОсновнойБанковскийСчет;
	ИначеЕсли КНП_ЕстьРеквизит(СсылкаНаКонтрагента, "БанковскийСчетПоУмолчанию") Тогда
		Результат = СсылкаНаКонтрагента.БанковскийСчетПоУмолчанию;
	ИначеЕсли КНП_ЕстьОбъектМетаданных("БанковскиеСчетаКонтрагентов") Тогда
		
		Если ЗначениеЗаполнено(СсылкаНаДокумент) Тогда
			
			Если КНП_ЕстьРеквизит(СсылкаНаДокумент, "БанковскийСчетКонтрагента") Тогда
				Результат = СсылкаНаДокумент.БанковскийСчетКонтрагента;	
			ИначеЕсли КНП_ЕстьРеквизит(СсылкаНаДокумент, "ДокументОснование") И ЗначениеЗаполнено(СсылкаНаДокумент.ДокументОснование) Тогда
				
				Если КНП_ЕстьРеквизит(СсылкаНаДокумент.ДокументОснование, "БанковскийСчетКонтрагента") Тогда
					Результат = СсылкаНаДокумент.ДокументОснование.БанковскийСчетКонтрагента;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Результат) Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	БанковскиеСчетаКонтрагентов.Ссылка
			|ИЗ
			|	Справочник.БанковскиеСчетаКонтрагентов КАК БанковскиеСчетаКонтрагентов
			|ГДЕ
			|	БанковскиеСчетаКонтрагентов.Владелец = &Владелец
			|	И БанковскиеСчетаКонтрагентов.Закрыт = ЛОЖЬ
			|	И БанковскиеСчетаКонтрагентов.ПометкаУдаления = ЛОЖЬ"; 
			
			Запрос.УстановитьПараметр("Владелец", СсылкаНаКонтрагента);
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Выборка.Следующий() Тогда
				Результат = Выборка.Ссылка;
			КонецЕсли;
			
			Если Результат = Неопределено Тогда
				Результат = Справочники.БанковскиеСчетаКонтрагентов.ПустаяСсылка();
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли КНП_ЕстьОбъектМетаданных("БанковскиеИКазначейскиеСчета") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	БанковскиеСчетаКонтрагентов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.БанковскиеИКазначейскиеСчета КАК БанковскиеСчетаКонтрагентов
		|ГДЕ
		|	БанковскиеСчетаКонтрагентов.Владелец = &Владелец
		|	И БанковскиеСчетаКонтрагентов.ПометкаУдаления = ЛОЖЬ
		|	И БанковскиеСчетаКонтрагентов.ТипЛицевогоСчета = ЗНАЧЕНИЕ(Перечисление.ТипыЛицевыхСчетов.Банковский)"; 
		
		Запрос.УстановитьПараметр("Владелец", СсылкаНаКонтрагента);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Результат = Выборка.Ссылка;
		КонецЕсли;
		
		Если Результат = Неопределено Тогда
			Результат = Справочники.БанковскиеИКазначейскиеСчета.ПустаяСсылка();
		КонецЕсли;
		
	Иначе
		ДобавитьВЖурнал("Неподдерживаемая конфигурация", "МОП_ПолучитьБанковскийСчетКонтрагента");
	КонецЕсли;
	
	Возврат Результат;	

КонецФункции

Функция МОП_ПолучитьБанковскийСчетПоБикуНомеруСчета(БИК, НомерСчета)
	
	Результат = Неопределено;	
	Банк = МОП_ПолучитьБанкПоБИКу(БИК);
	Запрос = Новый Запрос;
	
	Если КНП_ЕстьОбъектМетаданных("БанковскиеСчетаКонтрагентов") Тогда
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	БанковскиеСчетаКонтрагентов.Ссылка
		|ИЗ
		|	Справочник.БанковскиеСчетаКонтрагентов КАК БанковскиеСчетаКонтрагентов
		|ГДЕ
		|	БанковскиеСчетаКонтрагентов.Банк = &Банк
		|	И БанковскиеСчетаКонтрагентов.Закрыт = ЛОЖЬ
		|	И БанковскиеСчетаКонтрагентов.ПометкаУдаления = ЛОЖЬ
		|	И БанковскиеСчетаКонтрагентов.НомерСчета = &НомерСчета"; 
	ИначеЕсли КНП_ЕстьОбъектМетаданных("БанковскиеСчета") Тогда
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	БанковскиеСчетаКонтрагентов.Ссылка
		|ИЗ
		|	Справочник.БанковскиеСчета КАК БанковскиеСчетаКонтрагентов
		|ГДЕ
		|	БанковскиеСчетаКонтрагентов.Банк = &Банк
		|	И БанковскиеСчетаКонтрагентов.ПометкаУдаления = ЛОЖЬ
		|	И БанковскиеСчетаКонтрагентов.НомерСчета = &НомерСчета";
	Иначе
		
		ДобавитьВЖурнал("Неподдерживаемая конфигурация", "КЗП_ПолучитьБанковскийСчетПоБикуНомеруСчета");
		Возврат Результат;
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Банк", Банк);
	Запрос.УстановитьПараметр("НомерСчета", НомерСчета);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция МОП_ПолучитьДоговорПоДокументу(ДокументСсылка)
	
	Если КНП_ЕстьРеквизит(ДокументСсылка, "Договор") И ЗначениеЗаполнено(ДокументСсылка.Договор) Тогда
		Возврат ДокументСсылка.Договор;
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ДокументСсылка, "Соглашение") И ЗначениеЗаполнено(ДокументСсылка.Соглашение) Тогда
		Возврат ДокументСсылка.Соглашение;
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ДокументСсылка, "ДоговорКонтрагента") И ЗначениеЗаполнено(ДокументСсылка.ДоговорКонтрагента) Тогда
		Возврат ДокументСсылка.ДоговорКонтрагента;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Получить контрагента
// *Поддержка БП 3.0, УТ 11, КА 2.4, БП 2.0, УТ 10.3, КА 1.1, УПП 1.3
//
// Параметры:
//  ИНН	 - Строка	 - 
//  КПП	 - Строка	 - 
//  ОГРН - Строка	 - 
// 
// Возвращаемое значение:
// СправочникСсылка.Контрагент  - 
//
Функция МОП_ПолучитьКонтрагента(ИНН, КПП = Неопределено, ОГРН = Неопределено) 
	
	Результат = Неопределено;
	УстановитьПривилегированныйРежим(Истина);
	ТекКонф = КНП_ИмяКонфигурации();
	Результат = Справочники.Контрагенты.ПустаяСсылка();
	
	Если НЕ ЗначениеЗаполнено(ИНН) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИНН", ИНН);
	ТекстЗапроса = "ВЫБРАТЬ
	|	Контрагенты.Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ИНН = &ИНН
	|	И НЕ Контрагенты.ПометкаУдаления";
	
	Если ЗначениеЗаполнено(КПП) Тогда
		
		ТекстЗапроса = ТекстЗапроса + "	И Контрагенты.КПП = &КПП";
		Запрос.УстановитьПараметр("КПП", КПП);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОГРН) И КНП_ЕстьРеквизит(Справочники.Контрагенты.ПустаяСсылка(), "РегистрационныйНомер") Тогда
		
		ТекстЗапроса = ТекстЗапроса  + "	И Контрагенты.РегистрационныйНомер = &ОГРН";
		Запрос.УстановитьПараметр("ОГРН", ОГРН);
		
	КонецЕсли;	
	
	Запрос.Текст = ТекстЗапроса;
	
	Попытка
		
		ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();		
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			Результат = ВыборкаДетальныеЗаписи.Ссылка;
		КонецЕсли;
		
	Исключение
		ДобавитьВЖурнал("Не удалось выполнить запрос. " + ОписаниеОшибки(), "МОП_ПолучитьКонтрагента");	
	КонецПопытки;
	
	Если Результат = Неопределено Тогда
		
		Запрос.Текст = СтрЗаменить(ТекстЗапроса, "И НЕ Контрагенты.ПометкаУдаления", "");
		
		Попытка
			
			ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();		
			
			Если ВыборкаДетальныеЗаписи.Следующий() Тогда
				Результат = ВыборкаДетальныеЗаписи.Ссылка;
			КонецЕсли;
			
		Исключение
			ДобавитьВЖурнал("Не удалось выполнить запрос. " + ОписаниеОшибки(), "МОП_ПолучитьКонтрагента");	
		КонецПопытки;
		
	КонецЕсли;	
	
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Результат;

КонецФункции

// Получить организацию
// *Поддержка БП 3.0, УТ 11, КА 2.4, БП 2.0, УТ 10.3, КА 1.1, УПП 1.3
//
// Параметры:
//  ИНН	 - Строка	 - 
//  ОГРН - Строка	 - 
// 
// Возвращаемое значение:
// СправочникСсылка.Организации, Неопределено  - Результат поиска организации
//
Функция МОП_ПолучитьОрганизацию(ИНН, ОГРН, КПП = Неопределено, ВернутьМассив = Ложь)
	
	Результат = Неопределено;
	
	Результат = Справочники.Организации.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Организации.Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ";
	
	ТекстЗапроса = ТекстЗапроса + " (Организации.ИНН = &ИНН И Организации.ОГРН = &ОГРН)";
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Запрос.УстановитьПараметр("ОГРН", ОГРН);
	Запрос.УстановитьПараметр("КПП", КПП);
	
	Попытка
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Количество() > 1 И НЕ ВернутьМассив Тогда
			ДобавитьВЖурнал("Внимание! В системе имеется несколько организаций с одинаковым ИНН и ОГРН", "МОП_ПолучитьОрганизацию");
		КонецЕсли;
		
		Если ВернутьМассив Тогда
			
			МассивОрганизаций = Новый Массив;
			
			Пока Выборка.Следующий() Цикл
				МассивОрганизаций.Добавить(Выборка.Ссылка);
			КонецЦикла;
			
			Возврат МассивОрганизаций;
			
		Иначе
			
			Если Выборка.Следующий() Тогда
				Результат = Выборка.Ссылка;
			КонецЕсли;
			
		КонецЕсли;
		
	Исключение
		ДобавитьВЖурнал("Не удалось выполнить запрос. " + ОписаниеОшибки(), "МОП_ПолучитьОрганизацию");	
	КонецПопытки;
	
	Возврат Результат;	

КонецФункции

Функция МОП_ПолучитьСтруктуруТаблицыКорректировкиТоваров(ДокументСсылка)
	
	ТаблицаТоваров = Новый ТаблицаЗначений;
	ТаблицаТоваров.Колонки.Добавить("НомерСтроки");
	ТаблицаТоваров.Колонки.Добавить("Номенклатура");
	ТаблицаТоваров.Колонки.Добавить("Содержание");
	ТаблицаТоваров.Колонки.Добавить("Количество");
	ТаблицаТоваров.Колонки.Добавить("КоличествоДоИзменения");
	ТаблицаТоваров.Колонки.Добавить("Цена");
	ТаблицаТоваров.Колонки.Добавить("ЦенаДоИзменения");
	ТаблицаТоваров.Колонки.Добавить("Сумма");
	ТаблицаТоваров.Колонки.Добавить("СуммаДоИзменения");
	ТаблицаТоваров.Колонки.Добавить("СтавкаНДС");
	ТаблицаТоваров.Колонки.Добавить("СтавкаНДСДоИзменения");
	ТаблицаТоваров.Колонки.Добавить("СуммаНДС");
	ТаблицаТоваров.Колонки.Добавить("СуммаНДСДоИзменения");
	ТаблицаТоваров.Колонки.Добавить("ЕдиницаИзмерения");
	ТаблицаТоваров.Колонки.Добавить("СерияНоменклатуры"); //
	
	Если КНП_ЕстьТабЧасть(ДокументСсылка, "Товары") Тогда
		
		Для Каждого СтрокаТЧ Из ДокументСсылка.Товары Цикл 
			
			Если СтрокаТЧ.СуммаДоКорректировки = СтрокаТЧ.Сумма Тогда
				Продолжить;				
			КонецЕсли;
			
			СтрокаТТ = ТаблицаТоваров.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТТ, СтрокаТЧ); 
			
			Если КНП_ЕстьТабЧасть(ДокументСсылка, "Расхождения") Тогда //Разница в отдельной таблице
				
				СтрокаРасхождений = ДокументСсылка.Расхождения.Найти(СтрокаТТ.Номенклатура, "Номенклатура");
				
				Если СтрокаРасхождений <> Неопределено Тогда
					
					СтрокаТТ.КоличествоДоИзменения = СтрокаТТ.Количество - СтрокаРасхождений.Количество;
					СтрокаТТ.СуммаДоИзменения = СтрокаТТ.Сумма - СтрокаРасхождений.Сумма;
					
					Если СтрокаТТ.КоличествоДоИзменения = 0 Тогда
						СтрокаТТ.ЦенаДоИзменения = СтрокаТТ.СуммаДоИзменения;	
					Иначе
						СтрокаТТ.ЦенаДоИзменения = СтрокаТТ.СуммаДоИзменения / СтрокаТТ.КоличествоДоИзменения;
					КонецЕсли;
					
					СтрокаТТ.СтавкаНДСДоИзменения = СтрокаРасхождений.СтавкаНДС;
					СтрокаТТ.СуммаНДСДоИзменения = СтрокаТТ.СуммаНДС - СтрокаРасхождений.СуммаНДС;
					
				Иначе
					
					СтрокаТТ.КоличествоДоИзменения = СтрокаТТ.Количество;
					СтрокаТТ.ЦенаДоИзменения = СтрокаТТ.Цена;
					СтрокаТТ.СуммаДоИзменения = СтрокаТТ.Сумма;
					СтрокаТТ.СтавкаНДСДоИзменения = СтрокаТТ.СтавкаНДС;
					СтрокаТТ.СуммаНДСДоИзменения = СтрокаТТ.СуммаНДС;
					
				КонецЕсли;
				
			Иначе //Разница в одной таблице	
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если КНП_ЕстьТабЧасть(ДокументСсылка, "Услуги") Тогда
		
		Для Каждого СтрокаТЧ Из ДокументСсылка.Услуги Цикл
			
			СтрокаТТ = ТаблицаТоваров.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТТ, СтрокаТЧ); 
			
			Если КНП_ЕстьТабЧасть(ДокументСсылка, "Расхождения") Тогда //Разница в отдельной таблице
				
				СтрокаРасхождений = ДокументСсылка.Расхождения.Найти(СтрокаТТ.Номенклатура, "Номенклатура");
				
				Если СтрокаРасхождений <> Неопределено Тогда
					
					СтрокаТТ.КоличествоДоИзменения = СтрокаТТ.Количество + СтрокаРасхождений.Количество;
					СтрокаТТ.СуммаДоИзменения = СтрокаТТ.Сумма + СтрокаРасхождений.Сумма;
					СтрокаТТ.ЦенаДоИзменения = СтрокаТТ.СуммаДоИзменения / СтрокаТТ.КоличествоДоИзменения;	
					СтрокаТТ.СтавкаНДСДоИзменения = СтрокаРасхождений.СтавкаНДС;
					СтрокаТТ.СуммаНДСДоИзменения = СтрокаТТ.СуммаНДС + СтрокаРасхождений.СуммаНДС;
					
				Иначе
					
					СтрокаТТ.КоличествоДоИзменения = СтрокаТТ.Количество;
					СтрокаТТ.ЦенаДоИзменения = СтрокаТТ.Цена;
					СтрокаТТ.СуммаДоИзменения = СтрокаТТ.Сумма;
					СтрокаТТ.СтавкаНДСДоИзменения = СтрокаТТ.СтавкаНДС;
					СтрокаТТ.СуммаНДСДоИзменения = СтрокаТТ.СуммаНДС;
					
				КонецЕсли;
				
			Иначе //Разница в одной таблице	
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ТаблицаТоваров;

КонецФункции

Функция МОП_ПолучитьСчетФактуруДокумента(ДокументСсылка)
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументОснование", ДокументСсылка);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СчетФактураВыданныйДокументыОснования.Ссылка
	|ИЗ
	|	Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
	|ГДЕ
	|	(СчетФактураВыданныйДокументыОснования.ДокументОснование = &ДокументОснование
	|	ИЛИ СчетФактураВыданныйДокументыОснования.Ссылка.ДокументОснование = &ДокументОснование)
	|	И СчетФактураВыданныйДокументыОснования.Ссылка.Проведен"; //Белов Добавил условие на проведенную сф 	
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;	
	
	Возврат Результат;

КонецФункции

Функция МОП_ПолучитьСтруктуруДанныхКонтрагента(СсылкаНаКонтрагента)
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("Наименование", СсылкаНаКонтрагента.Наименование);
	
	Если ТипЗнч(СсылкаНаКонтрагента) = Тип("СправочникСсылка.Контрагенты") Тогда
		
		СтруктураДанных.Вставить("ИНН", СсылкаНаКонтрагента.ИНН);
		СтруктураДанных.Вставить("КПП", СсылкаНаКонтрагента.КПП);
		СтруктураДанных.Вставить("ОГРН", МОП_ПолучитьОГРНКонтрагента(СсылкаНаКонтрагента) );
		БанковскийСчет = МОП_ПолучитьБанковскийСчетКонтрагента(СсылкаНаКонтрагента);
		
		Если БанковскийСчет <> Неопределено Тогда
			
			СтруктураДанных.Вставить("БИК", МОП_ПолучитьБИКБанкаПоСчету(БанковскийСчет) );
			СтруктураДанных.Вставить("НомерСчета", МОП_ПолучитьНомерБанковскогоСчета(БанковскийСчет) );
			
		Иначе
			
			СтруктураДанных.Вставить("БИК", "");
			СтруктураДанных.Вставить("НомерСчета");
			
		КонецЕсли;
		
	Иначе     
		
		СтруктураДанных.Вставить("ИНН", "");
		СтруктураДанных.Вставить("КПП", "");
		СтруктураДанных.Вставить("ОГРН", "");
		СтруктураДанных.Вставить("БИК", "");
		СтруктураДанных.Вставить("НомерСчета");
		
	КонецЕсли;
	
	Возврат СтруктураДанных;

КонецФункции

Функция МОП_ПолучитьОГРНКонтрагента(СсылкаНаКонтрагента)
	
	Если НЕ ЗначениеЗаполнено(СсылкаНаКонтрагента) Тогда
		Возврат "";
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(СсылкаНаКонтрагента, "ОГРН") Тогда
		Возврат СсылкаНаКонтрагента.ОГРН;
	ИначеЕсли КНП_ЕстьРеквизит(СсылкаНаКонтрагента, "РегистрационныйНомер") Тогда
		Возврат СсылкаНаКонтрагента.РегистрационныйНомер;
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(СсылкаНаКонтрагента, "ЮридическоеФизическоеЛицо") Тогда
		
		Если СсылкаНаКонтрагента.Метаданные().Реквизиты.ЮридическоеФизическоеЛицо.Тип.СодержитТип(Тип("СправочникСсылка.ЮридическиеЛица") ) Тогда //спец. для БГУ
			Возврат МОП_ПолучитьОГРНКонтрагента(СсылкаНаКонтрагента.ЮридическоеФизическоеЛицо);	
		КонецЕсли;
		
	КонецЕсли;

КонецФункции

