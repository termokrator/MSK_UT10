Функция КНП_Формат(Источник, Ключ)
	
	Если ТипЗнч(Источник) = Тип("Дата") Тогда
		Возврат КНП_ДатаВФормате(Источник);
	КонецЕсли;
	
	Если ТипЗнч(Источник) = Тип("Число") И Источник > 999 Тогда
		
		Если ФОД_ЭтоСтрогоЧисло(Ключ) Тогда
			Возврат Источник;
		КонецЕсли;
		
		Возврат КНП_ЧислоВФормате(Источник);
		
	КонецЕсли;
	
	Возврат Источник;

КонецФункции

//		Функции проверки
Функция КНП_ЭтоЧисло(Знач Строка, ИгнорироватьРазделители = Ложь)
	
	ДлинаСтроки = СтрДлина(Строка);
	
	Если ДлинаСтроки = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для итер = 1 По ДлинаСтроки Цикл
		
		КодСимвола = КодСимвола(Строка, итер); 
		
		Если ИгнорироватьРазделители И (Символ(КодСимвола) = "." ИЛИ Символ(КодСимвола) = ",") Тогда
			Продолжить;
		КонецЕсли;
		
		Если КодСимвола < 48 ИЛИ КодСимвола > 57 Тогда
			Возврат Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;

КонецФункции

