Функция ФОД_ПолучитьВалютуДокумента(Знач ОбъектЗаполнения)
	
	//Changelog
	//
	//12.12.2019 - определяется что нужно рассчитывать в валюте.
	Если КонвертацияВалютПоКурсуДокумента Тогда
		Валюта = МОП_ПолучитьВалютуДоговораДокумента(ОбъектЗаполнения);	
	Иначе
		Валюта = МОП_ПолучитьВалютуДокумента(ОбъектЗаполнения);
	КонецЕсли;
	
	Возврат Валюта;

КонецФункции

Функция ФОД_ПолучитьЕдиницуИзмеренияТовара(Знач ОбъектЗаполнения)
	
	Если ОбъектЗаполнения.Свойство("Упаковка") И ЗначениеЗаполнено(ОбъектЗаполнения.Упаковка) Тогда
		Возврат ОбъектЗаполнения.Упаковка;
	КонецЕсли;
	
	Если ОбъектЗаполнения.Свойство("ЕдиницаИзмерения") И ЗначениеЗаполнено(ОбъектЗаполнения.ЕдиницаИзмерения) Тогда
		Возврат ОбъектЗаполнения.ЕдиницаИзмерения;
	КонецЕсли;
	
	Если ОбъектЗаполнения.Свойство("Номенклатура") И ЗначениеЗаполнено(ОбъектЗаполнения.Номенклатура) Тогда
		
		Если КНП_ЕстьРеквизит(ОбъектЗаполнения.Номенклатура, "ЕдиницаИзмерения") Тогда
			Возврат ОбъектЗаполнения.Номенклатура.ЕдиницаИзмерения;
		КонецЕсли;
		
		Если КНП_ЕстьРеквизит(ОбъектЗаполнения.Номенклатура, "БазоваяЕдиницаИзмерения") Тогда
			Возврат ОбъектЗаполнения.Номенклатура.БазоваяЕдиницаИзмерения;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Новый Структура("Код,Наименование,Ссылка",Неопределено, Неопределено, ОбъектЗаполнения.Ссылка);

КонецФункции

Функция ФОД_ПолучитьТабличнуюЧастьТоваровПоРеализации(ОбъектЗаполнения)
	
	Возврат ОбъектЗаполнения.Товары;	
	
КонецФункции

Функция ФОД_ПолучитьНаименованиеСтраныПроисхождения(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	
	Если НомерГТДЗаполнен(ОбъектЗаполнения) Тогда
		Возврат ОбъектЗаполнения.СерияНоменклатуры.СтранаПроисхождения.Наименование;	
	КонецЕсли;
	
	Возврат "-";
	
КонецФункции


Функция ФОД_ПолучитьКодСтраныПроисхождения(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	
	Если НомерГТДЗаполнен(ОбъектЗаполнения) Тогда
		Возврат СокрЛП(ОбъектЗаполнения.СерияНоменклатуры.СтранаПроисхождения.Код);	
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ФОД_ПолучитьНомерГТД(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	
	Если НомерГТДЗаполнен(ОбъектЗаполнения) Тогда
		Возврат Лев(СокрЛП(ОбъектЗаполнения.СерияНоменклатуры.НомерГТД.Код), 29);	
	КонецЕсли;
	
	Возврат "";
	
КонецФункции   

Функция НомерГТДЗаполнен(ОбъектЗаполнения)
	
	Если ОбъектЗаполнения.Свойство("СерияНоменклатуры") 
		И ЗначениеЗаполнено(ОбъектЗаполнения.СерияНоменклатуры.НомерГТД) 
		И СтрДлина(Лев(СокрЛП(ОбъектЗаполнения.СерияНоменклатуры.НомерГТД.Код), 29)) >= 10
		И ЗначениеЗаполнено(ОбъектЗаполнения.СерияНоменклатуры.СтранаПроисхождения)
		И СтрДлина(СокрЛП(ОбъектЗаполнения.СерияНоменклатуры.СтранаПроисхождения.Код)) >= 3
		И Найти(ОбъектЗаполнения.СерияНоменклатуры.СтранаПроисхождения.Код, "-") = 0 Тогда
		Возврат Истина;	
	КонецЕсли;         
	
	Возврат Ложь;
	
КонецФункции

Функция ФОД_ПолучитьСтрокуАналитикиДокументаОснования(Номенклатура,		ВидыЗапасов)
	
	СтрокаАналитики = Неопределено;
	
	Для каждого стр из ВидыЗапасов Цикл
		
		Если Стр. АналитикаУчетаНоменклатуры.Номенклатура = Номенклатура Тогда
			
			СтрокаАналитики = Стр;
			Прервать;
			
		КонецЕсли;	
		
	КонецЦикла;	
	
	Возврат СтрокаАналитики;

КонецФункции


Функция ФОД_ПолучитьНомерГТДИзУПД(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	
	НомерГТДВУПД = "";
	
	Если ЗначениеЗаполнено(ОбъектЗаполнения.Ссылка.ДокументОснование) Тогда
		
		СтрокаДокументаОснования = ФОД_ПолучитьСтрокуАналитикиДокументаОснования (ОбъектЗаполнения.Номенклатура,ОбъектЗаполнения.Ссылка.ДокументОснование.ВидыЗапасов); 
		
		Если СтрокаДокументаОснования <> Неопределено И ЗначениеЗаполнено(СтрокаДокументаОснования.НомерГТД)  Тогда
			НомерГТДВУПД = Лев(СокрЛП(СтрокаДокументаОснования.НомерГТД.Код), 29);	
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат НомерГТДВУПД;

КонецФункции


Функция ФОД_ПолучитьТовар(Знач ОбъектЗаполнения, Знач Вложенный = Ложь)
	
	МассивСтруктур = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(ОбъектЗаполнения) Тогда
		
		ДобавитьВЖурнал("Не определен объект заполнения!", "ПолучитьТовар");
		Возврат МассивСтруктур;
		
	КонецЕсли;
	
	Если МОП_ЭтоРеализацияТоваров(ОбъектЗаполнения) ИЛИ МОП_ЭтоСчетНаОплату(ОбъектЗаполнения) Тогда
		
		Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "Товары") Тогда
			
			ДобавитьВЖурнал("Отладка: Сбор данных по табчасти ""Товары""", "ПолучитьТовар");
			
			ТабЧасть = ФОД_ПолучитьТабличнуюЧастьТоваровПоРеализации(ОбъектЗаполнения);
			
			//+Белов А. 17.02.2026 #UT10-5696			
			Если Константы.ЭДО_ВыгружатьКодыМаркировки.Получить() 
				И ОбъектЗаполнения.Метаданные().Имя = "РеализацияТоваровУслуг"
				//+Белов А. 03.03.2026 #UT10-5730
				И Перечисления.УсловияРаботыСЧЗ.УсловиеВыгрузкиЧЗВЭДО(ОбъектЗаполнения.ДоговорКонтрагента.УсловияРаботыСЧЗ) Тогда  
				//-Белов А. 03.03.2026 #UT10-5730
				БуферКодовМаркировкиТоваров = Справочники.ШтрихкодыНоменклатуры.ПолучитьКодыМаркировкиПоДокументу(ОбъектЗаполнения);
			Иначе
				БуферКодовМаркировкиТоваров.Очистить();
			КонецЕсли; 
			//-Белов А. 17.02.2026 #UT10-5696
			
			ФиксированнаяСтруктураДанных = КНП_СтруктураНаОснованииКолонокТЧ(ТабЧасть);
			
			//+Белов А. 17.02.2026 #UT10-5706                            
			МассивКолонокИсключения = Новый Массив; 
			МассивКолонокИсключения.Добавить("НомерСтроки");
			МассивКолонокИсключения.Добавить("Назначение");
			МассивКолонокИсключения.Добавить("КлючСтроки");
			МассивКолонокИсключения.Добавить("КлючСвязи");       
			МассивКолонокИсключения.Добавить("Комментарий");       
			
			МассивКолонокСуммирования = Новый Массив;
			МассивКолонокСуммирования.Добавить("Количество");
			МассивКолонокСуммирования.Добавить("КоличествоМест");
			МассивКолонокСуммирования.Добавить("Сумма");
			МассивКолонокСуммирования.Добавить("СуммаНДС");
			
			ТабЧастьСвернутая = ТабЧасть.Выгрузить();
			СтруктураКолонок = КолонкиВСтроку(ТабЧастьСвернутая, МассивКолонокИсключения, МассивКолонокСуммирования);
			ТабЧастьСвернутая.Свернуть(СтруктураКолонок.КолонкиГруппировки, СтруктураКолонок.КолонкиСуммирования);
			//-Белов А. 17.02.2026 #UT10-5706
			
			Для Каждого Товар Из ТабЧастьСвернутая Цикл
				
				СтруктураДанных = Новый Структура(ФиксированнаяСтруктураДанных);
				ЗаполнитьЗначенияСвойств(СтруктураДанных, Товар);
				СтруктураДанных.Вставить("Ссылка", ОбъектЗаполнения);
				МассивСтруктур.Добавить(СтруктураДанных);
				
			КонецЦикла;		
			
		КонецЕсли;   
		
		//+Гавриленков В. 15.11.2024 #UT10-4901
		Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "Услуги") Тогда
			
			ДобавитьВЖурнал("Отладка: Сбор данных по табчасти ""Услуги""", "ПолучитьТовар");
			ФиксированнаяСтруктураДанных = КНП_СтруктураНаОснованииКолонокТЧ(ОбъектЗаполнения.Услуги);
			
			Для Каждого Услуга Из ОбъектЗаполнения.Услуги Цикл
				
				СтруктураДанных = Новый Структура(ФиксированнаяСтруктураДанных);
				ЗаполнитьЗначенияСвойств(СтруктураДанных, Услуга);
				СтруктураДанных.Вставить("Ссылка", ОбъектЗаполнения);
				МассивСтруктур.Добавить(СтруктураДанных);
				
			КонецЦикла;		
			
		КонецЕсли;
		//-Гавриленков В. 15.11.2024 #UT10-4901
		
		Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "Запасы") Тогда
			
			ДобавитьВЖурнал("Отладка: Сбор данных по табчасти ""Запасы""", "ПолучитьТовар");
			ФиксированнаяСтруктураДанных = КНП_СтруктураНаОснованииКолонокТЧ(ОбъектЗаполнения.Запасы);
			
			Для Каждого Товар Из ОбъектЗаполнения.Запасы Цикл
				
				СтруктураДанных = Новый Структура(ФиксированнаяСтруктураДанных);
				ЗаполнитьЗначенияСвойств(СтруктураДанных, Товар);
				СтруктураДанных.Вставить("Ссылка", ОбъектЗаполнения);
				МассивСтруктур.Добавить(СтруктураДанных);
				
			КонецЦикла;		
			
		КонецЕсли;
		
		Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "Номенклатура") Тогда
			
			ДобавитьВЖурнал("Отладка: Сбор данных по табчасти ""Номенклатура""", "ПолучитьТовар");
			ФиксированнаяСтруктураДанных = КНП_СтруктураНаОснованииКолонокТЧ(ОбъектЗаполнения.Номенклатура);
			
			Для Каждого Товар Из ОбъектЗаполнения.Номенклатура Цикл
				
				СтруктураДанных = Новый Структура(ФиксированнаяСтруктураДанных);
				ЗаполнитьЗначенияСвойств(СтруктураДанных, Товар);
				СтруктураДанных.Вставить("Ссылка", ОбъектЗаполнения);
				МассивСтруктур.Добавить(СтруктураДанных);
				
			КонецЦикла;		
			
		КонецЕсли;
		
		Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "Материалы") Тогда
			
			ДобавитьВЖурнал("Отладка: Сбор данных по табчасти ""Материалы""", "ПолучитьТовар");
			ФиксированнаяСтруктураДанных = КНП_СтруктураНаОснованииКолонокТЧ(ОбъектЗаполнения.Материалы);
			
			Для Каждого Товар Из ОбъектЗаполнения.Материалы Цикл
				
				СтруктураДанных = Новый Структура(ФиксированнаяСтруктураДанных);
				ЗаполнитьЗначенияСвойств(СтруктураДанных, Товар);
				СтруктураДанных.Вставить("Ссылка", ОбъектЗаполнения);
				МассивСтруктур.Добавить(СтруктураДанных);
				
			КонецЦикла;		
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если МОП_ЭтоСчетНаОплату(ОбъектЗаполнения) Тогда
		
		//+Гавриленков В. 15.11.2024 #UT10-4901  Перенесено в блок условий выше
		//Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "Услуги") Тогда
		//	
		//	ДобавитьВЖурнал("Отладка: Сбор данных по табчасти ""Услуги""", "ПолучитьТовар");
		//	ФиксированнаяСтруктураДанных = КНП_СтруктураНаОснованииКолонокТЧ(ОбъектЗаполнения.Услуги);
		//	
		//	Для Каждого Услуга Из ОбъектЗаполнения.Услуги Цикл
		//		
		//		СтруктураДанных = Новый Структура(ФиксированнаяСтруктураДанных);
		//		ЗаполнитьЗначенияСвойств(СтруктураДанных, Услуга);
		//		СтруктураДанных.Вставить("Ссылка", ОбъектЗаполнения);
		//		МассивСтруктур.Добавить(СтруктураДанных);
		//		
		//	КонецЦикла;		
		//	
		//КонецЕсли;
		//+Гавриленков В. 15.11.2024 #UT10-4901
		
		Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "ОсновныеСредства") Тогда
			
			ДобавитьВЖурнал("Отладка: Сбор данных по табчасти ""ОсновныеСредства""", "ПолучитьТовар");
			ФиксированнаяСтруктураДанных = КНП_СтруктураНаОснованииКолонокТЧ(ОбъектЗаполнения.ОсновныеСредства);
			
			Для Каждого Товар Из ОбъектЗаполнения.ОсновныеСредства Цикл
				
				СтруктураДанных = Новый Структура(ФиксированнаяСтруктураДанных);
				ЗаполнитьЗначенияСвойств(СтруктураДанных, Товар);
				СтруктураДанных.Вставить("Ссылка", ОбъектЗаполнения);
				МассивСтруктур.Добавить(СтруктураДанных);
				
			КонецЦикла;		
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если МОП_ЭтоАктВыполненныхРабот(ОбъектЗаполнения) Тогда
		
		Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "Услуги") Тогда
			
			ДобавитьВЖурнал("Отладка: Сбор данных по табчасти ""Услуги""", "ПолучитьТовар");
			ФиксированнаяСтруктураДанных = КНП_СтруктураНаОснованииКолонокТЧ(ОбъектЗаполнения.Услуги);
			
			Для Каждого Услуга Из ОбъектЗаполнения.Услуги Цикл
				
				СтруктураДанных = Новый Структура(ФиксированнаяСтруктураДанных);
				ЗаполнитьЗначенияСвойств(СтруктураДанных, Услуга);
				СтруктураДанных.Вставить("Ссылка", ОбъектЗаполнения);
				МассивСтруктур.Добавить(СтруктураДанных);
				
			КонецЦикла;		
			
		КонецЕсли;
		
		Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "УслугиОказанные") Тогда
			
			ДобавитьВЖурнал("Отладка: Сбор данных по табчасти ""УслугиОказанные""", "ПолучитьТовар");
			ФиксированнаяСтруктураДанных = КНП_СтруктураНаОснованииКолонокТЧ(ОбъектЗаполнения.УслугиОказанные);
			
			Для Каждого Услуга Из ОбъектЗаполнения.УслугиОказанные Цикл
				
				СтруктураДанных = Новый Структура(ФиксированнаяСтруктураДанных);
				ЗаполнитьЗначенияСвойств(СтруктураДанных, Услуга);
				СтруктураДанных.Вставить("Ссылка", ОбъектЗаполнения);
				МассивСтруктур.Добавить(СтруктураДанных);
				
			КонецЦикла;		
			
		КонецЕсли;
		
		Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "РаботыИУслуги") Тогда
			
			ДобавитьВЖурнал("Отладка: Сбор данных по табчасти ""РаботыИУслуги""", "ПолучитьТовар");
			ФиксированнаяСтруктураДанных = КНП_СтруктураНаОснованииКолонокТЧ(ОбъектЗаполнения.РаботыИУслуги);
			
			Для Каждого Услуга Из ОбъектЗаполнения.РаботыИУслуги Цикл
				
				СтруктураДанных = Новый Структура(ФиксированнаяСтруктураДанных);
				ЗаполнитьЗначенияСвойств(СтруктураДанных, Услуга);
				СтруктураДанных.Вставить("Ссылка", ОбъектЗаполнения);
				МассивСтруктур.Добавить(СтруктураДанных);
				
			КонецЦикла;		
			
		КонецЕсли;
		
		Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "Доходы") Тогда
			
			ДобавитьВЖурнал("Отладка: Сбор данных по табчасти ""Доходы""", "ПолучитьТовар");
			ФиксированнаяСтруктураДанных = КНП_СтруктураНаОснованииКолонокТЧ(ОбъектЗаполнения.Доходы);
			
			Для Каждого Услуга Из ОбъектЗаполнения.Доходы Цикл
				
				СтруктураДанных = Новый Структура(ФиксированнаяСтруктураДанных);
				ЗаполнитьЗначенияСвойств(СтруктураДанных, Услуга);
				СтруктураДанных.Вставить("Ссылка", ОбъектЗаполнения);
				МассивСтруктур.Добавить(СтруктураДанных);
				
			КонецЦикла;		
			
		КонецЕсли;
		
	КонецЕсли;
	
	
	Если МОП_ЭтоСчетФактура(ОбъектЗаполнения) ИЛИ МОП_ЭтоСчетНаОплату(ОбъектЗаполнения) Тогда
		
		Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "Авансы") И ОбъектЗаполнения.Авансы.Количество() > 0 Тогда
			
			ДобавитьВЖурнал("Отладка: Сбор данных по табчасти ""Авансы""", "ПолучитьТовар");
			ФиксированнаяСтруктураДанных = КНП_СтруктураНаОснованииКолонокТЧ(ОбъектЗаполнения.Авансы);
			
			Для Каждого Товар Из ОбъектЗаполнения.Авансы Цикл
				
				СтруктураДанных = Новый Структура(ФиксированнаяСтруктураДанных);
				ЗаполнитьЗначенияСвойств(СтруктураДанных, Товар);
				СтруктураДанных.Вставить("Ссылка", ОбъектЗаполнения);
				МассивСтруктур.Добавить(СтруктураДанных);
				
			КонецЦикла;		
			
		Иначе
			
			ОснованиеОбъектаЗаполнения = МОП_ПолучитьОснованиеДокумента(ОбъектЗаполнения);
			
			Если ЗначениеЗаполнено(ОснованиеОбъектаЗаполнения) 
				И 
				(
				МОП_ЭтоРеализацияТоваров(ОснованиеОбъектаЗаполнения) 
				ИЛИ 
				МОП_ЭтоАктВыполненныхРабот(ОснованиеОбъектаЗаполнения)
				) 
				Тогда
				МассивСтруктур = ФОД_ПолучитьТовар(ОснованиеОбъектаЗаполнения, Истина);	
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	
	Если МассивСтруктур.Количество() = 0 Тогда
		
		//Последний удар - ищем хоть по какой-нибудь табличной части, где есть хоть намек на ставку НДС
		Для Каждого ТабЧасть Из ОбъектЗаполнения.Метаданные().ТабличныеЧасти Цикл
			
			Если ТабЧасть.Реквизиты.Найти("СтавкаНДС") <> Неопределено Тогда
				
				ТабЧастьОбъектаЗаполнения = Неопределено;
				Выполнить("ТабЧастьОбъектаЗаполнения = ОбъектЗаполнения." + ТабЧасть.Имя);
				
				Если ТабЧастьОбъектаЗаполнения <> Неопределено Тогда
					
					ДобавитьВЖурнал("Обработка табличной части " + ТабЧасть.Имя + " объекта " + Строка(ОбъектЗаполнения), "ПолучитьТовар");
					
					Попытка
						
						Для Каждого СтрокаТЧ Из ТабЧастьОбъектаЗаполнения Цикл
							
							СтруктураДанных = Новый Структура(ФиксированнаяСтруктураДанных);
							ЗаполнитьЗначенияСвойств(СтруктураДанных, СтрокаТЧ);
							СтруктураДанных.Вставить("Ссылка", ОбъектЗаполнения);
							МассивСтруктур.Добавить(СтруктураДанных);	
							
						КонецЦикла;
						
						Прервать;
						
					Исключение
						ДобавитьВЖурнал(ОписаниеОшибки(), "ПолучитьТовар");
					КонецПопытки;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если КонвертацияВалютПоКурсуДокумента И НЕ Вложенный Тогда
		
		Для Каждого ОбъектЗаполнения Из МассивСтруктур Цикл
			
			ВалютаДокумента = МОП_ПолучитьВалютуДокумента(ОбъектЗаполнения.Ссылка);
			ВалютаДоговора = МОП_ПолучитьВалютуДоговораДокумента(ОбъектЗаполнения.Ссылка);
			
			Если ВалютаДоговора <> ВалютаДокумента Тогда //Требуется перерасчет
				
				СтруктураПараметров = МОП_ПолучитьПараметрыВалютДокумента(ОбъектЗаполнения.Ссылка);
				Курс = СтруктураПараметров.Курс;
				Кратность = СтруктураПараметров.Кратность;
				
				Если ОбъектЗаполнения.Свойство("Цена") Тогда
					ОбъектЗаполнения.Цена = Окр(ОбъектЗаполнения.Цена * Курс / Кратность, 2); //Конвертация из валюты в рубли
				КонецЕсли;
				
				Если ОбъектЗаполнения.Свойство("СуммаБезНДС") Тогда
					ОбъектЗаполнения.СуммаБезНДС = Окр(ОбъектЗаполнения.СуммаБезНДС * Курс / Кратность, 2); //Конвертация из валюты в рубли
				КонецЕсли;
				
				Если ОбъектЗаполнения.Свойство("Сумма") Тогда
					ОбъектЗаполнения.Сумма = Окр(ОбъектЗаполнения.Сумма * Курс / Кратность, 2); //Конвертация из валюты в рубли
				КонецЕсли;
				
				Если ОбъектЗаполнения.Свойство("НДС") Тогда
					ОбъектЗаполнения.НДС = Окр(ОбъектЗаполнения.НДС * Курс / Кратность, 2); //Конвертация из валюты в рубли
				КонецЕсли;
				
				Если ОбъектЗаполнения.Свойство("СуммаНДС") Тогда
					ОбъектЗаполнения.СуммаНДС = Окр(ОбъектЗаполнения.СуммаНДС * Курс / Кратность, 0); //Конвертация из валюты в рубли
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат МассивСтруктур;

КонецФункции

Функция ФОД_ПолучитьСтрокуРезультатаПриемки(Знач ОбъектЗаполнения)
	
	//+Макрушин Е. 07.04.2026 #UT10-5800	
	МассивСтруктур = Новый Массив;
	Если НЕ ЗначениеЗаполнено(ОбъектЗаполнения) Тогда
		ДобавитьВЖурнал("Не определен объект заполнения!", "ПолучитьСтрокуРезультатаПриемки");
		Возврат МассивСтруктур;
	КонецЕсли;
	
	Если МОП_ЭтоАктОРасхожденияхПослеПриемки(ОбъектЗаполнения) Тогда
		
		ДобавитьВЖурнал("Отладка: Сбор данных по табчасти ""Товары""", "ПолучитьСтрокуРезультатаПриемки");
		
		РеквизитыАкта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОбъектЗаполнения, "ДокументОснование, СуммаВключаетНДС, Товары, РасхожденияКМ");
		
		// Товары
		ТабЧасть = РеквизитыАкта.Товары.Выгрузить();
		ТабЧасть.Свернуть("Номенклатура, ЕдиницаИзмерения, Цена, СтавкаНДС, Брак", 
			"Количество, КоличествоПоДокументу, СуммаНДС, СуммаНДСПоДокументу, Сумма, СуммаПоДокументу");
		
		
		
		ТабЧасть.Колонки.Добавить("КоличествоНедостача", ОбщегоНазначения.ОписаниеТипаЧисло(15,3));
		ТабЧасть.Колонки.Добавить("КоличествоИзлишек", ОбщегоНазначения.ОписаниеТипаЧисло(15,3));
		ТабЧасть.Колонки.Добавить("КоличествоБрак", ОбщегоНазначения.ОписаниеТипаЧисло(15,3));
		
		ТабЧасть.Колонки.Добавить("ЦенаСНДС", ОбщегоНазначения.ОписаниеТипаЧисло(15,4));
		
		ТабЧасть.Колонки.Добавить("СуммаСНДС", ОбщегоНазначения.ОписаниеТипаЧисло(15,2));
		ТабЧасть.Колонки.Добавить("СуммаСНДСПоДокументу", ОбщегоНазначения.ОписаниеТипаЧисло(15,2));
		
		ТабЧасть.Колонки.Добавить("СуммаСНДСНедостача", ОбщегоНазначения.ОписаниеТипаЧисло(15,2));
		ТабЧасть.Колонки.Добавить("СуммаСНДСИзлишек", ОбщегоНазначения.ОписаниеТипаЧисло(15,2));
		ТабЧасть.Колонки.Добавить("СуммаСНДСБрак", ОбщегоНазначения.ОписаниеТипаЧисло(15,2));
		
		ТабЧасть.Колонки.Добавить("СуммаНДСНедостача", ОбщегоНазначения.ОписаниеТипаЧисло(15,2));
		ТабЧасть.Колонки.Добавить("СуммаНДСИзлишек", ОбщегоНазначения.ОписаниеТипаЧисло(15,2));
		ТабЧасть.Колонки.Добавить("СуммаНДСБрак", ОбщегоНазначения.ОписаниеТипаЧисло(15,2));
		
		Для Каждого СтрокаТовары Из ТабЧасть Цикл
			
			Если РеквизитыАкта.СуммаВключаетНДС Тогда
				
				СтрокаТовары.СуммаСНДС = СтрокаТовары.Сумма;
				СтрокаТовары.СуммаСНДСПоДокументу = СтрокаТовары.СуммаПоДокументу;
				
			Иначе
				
				СтрокаТовары.СуммаСНДС = СтрокаТовары.Сумма + СтрокаТовары.СуммаНДС;
				СтрокаТовары.СуммаСНДСПоДокументу = СтрокаТовары.СуммаПоДокументу + СтрокаТовары.СуммаНДС;
				
			КонецЕсли;
			
			Если СтрокаТовары.Брак Тогда
				
				// брак
				НайденныеСтрокиНеБрак = ТабЧасть.НайтиСтроки(Новый Структура("Номенклатура, Брак", СтрокаТовары.Номенклатура, Ложь));
				
				Если НайденныеСтрокиНеБрак.Количество() > 0 Тогда
					
					СтрокаТовары.Цена = НайденныеСтрокиНеБрак[0].Цена;
					СтрокаТовары.СтавкаНДС = НайденныеСтрокиНеБрак[0].СтавкаНДС;
					                            
					СтрокаТовары.СуммаСНДС =  0; // общий пересчет сумм чуть позже
					СтрокаТовары.СуммаНДС =  0;
					
				КонецЕсли;
				
				СтрокаТовары.КоличествоБрак = СтрокаТовары.Количество;
				СтрокаТовары.КоличествоНедостача = -СтрокаТовары.Количество; // это не недостача, а брак
				
			Иначе	
				
				Если СтрокаТовары.КоличествоПоДокументу > СтрокаТовары.Количество Тогда
					СтрокаТовары.КоличествоНедостача = СтрокаТовары.КоличествоПоДокументу - СтрокаТовары.Количество;
				ИначеЕсли СтрокаТовары.КоличествоПоДокументу < СтрокаТовары.Количество Тогда
					СтрокаТовары.КоличествоИзлишек = СтрокаТовары.Количество - СтрокаТовары.КоличествоПоДокументу;
					СтрокаТовары.Количество = СтрокаТовары.Количество - СтрокаТовары.КоличествоИзлишек;	// излишек исключаем из фактически
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		ТабЧасть.Свернуть("Номенклатура, ЕдиницаИзмерения, Цена, ЦенаСНДС, СтавкаНДС", 
			"Количество, КоличествоПоДокументу, КоличествоНедостача, КоличествоИзлишек, КоличествоБрак, "+ 
			"СуммаСНДС, СуммаСНДСПоДокументу, СуммаСНДСНедостача, СуммаСНДСИзлишек, СуммаСНДСБрак," +
			"СуммаНДС, СуммаНДСПоДокументу, СуммаНДСНедостача, СуммаНДСИзлишек, СуммаНДСБрак");
		
		ТабЧасть.Сортировать("Номенклатура, Цена");
		
		ТабЧасть.Колонки.Добавить("мКодыМаркировкиПоДокументу");
		ТабЧасть.Колонки.Добавить("мКодыМаркировкиФактически");
		ТабЧасть.Колонки.Добавить("мКодыМаркировкиНедостача");
		ТабЧасть.Колонки.Добавить("мКодыМаркировкиИзлишек");
		ТабЧасть.Колонки.Добавить("мКодыМаркировкиБрак");		

		// Коды маркировки
		Запрос = Новый Запрос;          
		Запрос.УстановитьПараметр("ПТУ", РеквизитыАкта.ДокументОснование);
		Запрос.УстановитьПараметр("Номенклатура", Справочники.Номенклатура.ПустаяСсылка());
		//Запрос.УстановитьПараметр("ТаблицаРасхожденияКМ", РеквизитыАкта.РасхожденияКМ.Выгрузить());
		Запрос.УстановитьПараметр("ТаблицаИзлишковИзАкта", РеквизитыАкта.РасхожденияКМ.Выгрузить().Скопировать(Новый Структура("Излишек", Истина),"КодМаркировки"));
		
		Запрос.Текст = Документы.АктОРасхожденияхПослеПриемки.ПолучитьТекстЗапросаПоКодамМаркировки();
		РезультатЗапроса = Запрос.ВыполнитьПакет();
		тзКодыМаркировкиПолная = РезультатЗапроса[2].Выгрузить();
		
		НДСВСумме = МОП_ДокументВключаетНДСВСумму(ОбъектЗаполнения.Ссылка);
		
		ФиксированнаяСтруктураДанных = КНП_СтруктураНаОснованииКолонокТЧ(ТабЧасть);
		
	    Для Каждого СтрокаТовары Из ТабЧасть Цикл
			
			// распределение по кодам маркировки происходит в любом случае по всем строкам
			мКодыМаркировкиПоДокументу = Новый Массив;
			мКодыМаркировкиФактически = Новый Массив;
			мКодыМаркировкиНедостача = Новый Массив;
			мКодыМаркировкиИзлишек = Новый Массив;
			мКодыМаркировкиБрак = Новый Массив;
			
			//Принято
			ТребуетсяКоличествоКодовПринято = Мин(СтрокаТовары.Количество, СтрокаТовары.КоличествоПоДокументу);
			НайденныеСтрокиКодыМаркировкиПринято = тзКодыМаркировкиПолная.НайтиСтроки(Новый Структура("Номенклатура, Принято", СтрокаТовары.Номенклатура, Истина));
			
			Для Каждого СтрокаКодов Из НайденныеСтрокиКодыМаркировкиПринято Цикл
				
				Если ТребуетсяКоличествоКодовПринято = 0 Тогда
					Прервать;
				КонецЕсли;
					
				мКодыМаркировкиПоДокументу.Добавить(СтрокаКодов.КодМаркировки);
				мКодыМаркировкиФактически.Добавить(СтрокаКодов.КодМаркировки);
				
				ТребуетсяКоличествоКодовПринято = ТребуетсяКоличествоКодовПринято - 1;
				
				тзКодыМаркировкиПолная.Удалить(СтрокаКодов);
				
			КонецЦикла;

			// в результате запоминаем только те строки где есть отклонения
			Если СтрокаТовары.КоличествоНедостача = 0 И СтрокаТовары.КоличествоИзлишек = 0 И СтрокаТовары.КоличествоБрак = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			// подбиваем цены, суммы НДС, суммы с НДС
			НДСНаЕдиницуТовара = 0;
			
			Если СтрокаТовары.КоличествоПоДокументу > 0 Тогда
				
				СтрокаТовары.ЦенаСНДС = Окр(СтрокаТовары.СуммаСНДСПоДокументу / СтрокаТовары.КоличествоПоДокументу, 4);
				СтрокаТовары.СуммаСНДС = Окр(СтрокаТовары.Количество * СтрокаТовары.СуммаСНДСПоДокументу / СтрокаТовары.КоличествоПоДокументу, 2);
				
				НДСНаЕдиницуТовара = СтрокаТовары.СуммаНДСПоДокументу / СтрокаТовары.КоличествоПоДокументу;
				СтрокаТовары.СуммаНДС = Окр(СтрокаТовары.Количество * НДСНаЕдиницуТовара, 2);

				
			ИначеЕсли СтрокаТовары.Количество + СтрокаТовары.КоличествоИзлишек > 0 Тогда
				
				СтрокаТовары.ЦенаСНДС = Окр(СтрокаТовары.СуммаСНДС / (СтрокаТовары.Количество + СтрокаТовары.КоличествоИзлишек), 4);
				СтрокаТовары.СуммаСНДСПоДокументу = СтрокаТовары.ЦенаСНДС * СтрокаТовары.КоличествоПоДокументу;
				СтрокаТовары.СуммаСНДС = СтрокаТовары.ЦенаСНДС * СтрокаТовары.Количество;
				
				НДСНаЕдиницуТовара = СтрокаТовары.СуммаНДС / (СтрокаТовары.Количество + СтрокаТовары.КоличествоИзлишек);
				СтрокаТовары.СуммаНДС = Окр(СтрокаТовары.Количество * НДСНаЕдиницуТовара, 2);
				
			КонецЕсли;
			
			СтрокаТовары.СуммаСНДСНедостача = СтрокаТовары.ЦенаСНДС * СтрокаТовары.КоличествоНедостача;
			СтрокаТовары.СуммаСНДСИзлишек = СтрокаТовары.ЦенаСНДС * СтрокаТовары.КоличествоИзлишек;
			СтрокаТовары.СуммаСНДСБрак = СтрокаТовары.ЦенаСНДС * СтрокаТовары.КоличествоБрак;
			
			СтрокаТовары.СуммаНДСНедостача = Окр(СтрокаТовары.КоличествоНедостача * НДСНаЕдиницуТовара, 2);
			СтрокаТовары.СуммаНДСИзлишек = Окр(СтрокаТовары.КоличествоИзлишек * НДСНаЕдиницуТовара, 2);
			СтрокаТовары.СуммаНДСБрак = Окр(СтрокаТовары.КоличествоБрак * НДСНаЕдиницуТовара, 2);
				
		
			СтруктураДанных = Новый Структура(ФиксированнаяСтруктураДанных);
			ЗаполнитьЗначенияСвойств(СтруктураДанных, СтрокаТовары);
			СтруктураДанных.Вставить("Ссылка", ОбъектЗаполнения);
			
			// брак и недостача встают в раздел КМ по документу, а излишки в раздел по факту
			
			Если СтрокаТовары.КоличествоБрак > 0 Тогда
				
				// брак
			    ТребуетсяКоличествоКодовБрак = СтрокаТовары.КоличествоБрак;
				
				// КМ по браку должны быть с отметкой Недостача, т.к. ситуация брака у нас проходит двумя строчками 1.недостача -, 2.брак +
				НайденныеСтрокиКодыМаркировкиБрак = тзКодыМаркировкиПолная.НайтиСтроки(Новый Структура("Номенклатура, Недостача", СтрокаТовары.Номенклатура, Истина));
				
				Для Каждого СтрокаКодов Из НайденныеСтрокиКодыМаркировкиБрак Цикл
					
					Если ТребуетсяКоличествоКодовБрак = 0 Тогда
						Прервать;
					КонецЕсли;
					
					мКодыМаркировкиБрак.Добавить(СтрокаКодов.КодМаркировки);
					
					Если СтрокаКодов.Передано И мКодыМаркировкиПоДокументу.Найти(СтрокаКодов.КодМаркировки) = Неопределено Тогда
						мКодыМаркировкиПоДокументу.Добавить(СтрокаКодов.КодМаркировки);
					КонецЕсли;
					
					Если мКодыМаркировкиФактически.Найти(СтрокаКодов.КодМаркировки) = Неопределено Тогда
						мКодыМаркировкиФактически.Добавить(СтрокаКодов.КодМаркировки);
					КонецЕсли;
					
					ТребуетсяКоличествоКодовБрак = ТребуетсяКоличествоКодовБрак - 1;
					
					тзКодыМаркировкиПолная.Удалить(СтрокаКодов);
					
				КонецЦикла;	
				
			КонецЕсли;
			
			Если СтрокаТовары.КоличествоНедостача > 0 Тогда 
				
				// недостача
			    ТребуетсяКоличествоКодовНедостача = СтрокаТовары.КоличествоНедостача;
				НайденныеСтрокиКодыМаркировкиНедостача = тзКодыМаркировкиПолная.НайтиСтроки(Новый Структура("Номенклатура, Недостача", СтрокаТовары.Номенклатура, Истина));
				
				Для Каждого СтрокаКодов Из НайденныеСтрокиКодыМаркировкиНедостача Цикл
					
					Если ТребуетсяКоличествоКодовНедостача = 0 Тогда
						Прервать;
					КонецЕсли;
					
					мКодыМаркировкиНедостача.Добавить(СтрокаКодов.КодМаркировки);
					
					Если СтрокаКодов.Передано И мКодыМаркировкиПоДокументу.Найти(СтрокаКодов.КодМаркировки) = Неопределено Тогда
						мКодыМаркировкиПоДокументу.Добавить(СтрокаКодов.КодМаркировки);
					КонецЕсли;
					
					ТребуетсяКоличествоКодовНедостача = ТребуетсяКоличествоКодовНедостача - 1;
					
					тзКодыМаркировкиПолная.Удалить(СтрокаКодов);
					
				КонецЦикла;
				
			КонецЕсли;
				
			Если СтрокаТовары.КоличествоИзлишек > 0 Тогда
				
				// излишек
			    ТребуетсяКоличествоКодовИзлишек = СтрокаТовары.КоличествоИзлишек;
		        НайденныеСтрокиКодыМаркировкиИзлишек = тзКодыМаркировкиПолная.НайтиСтроки(Новый Структура("Номенклатура, Излишек", СтрокаТовары.Номенклатура, Истина));
				
				Для Каждого СтрокаКодов Из НайденныеСтрокиКодыМаркировкиИзлишек Цикл
					
					Если ТребуетсяКоличествоКодовИзлишек = 0 Тогда
						Прервать;
					КонецЕсли;
					
					мКодыМаркировкиИзлишек.Добавить(СтрокаКодов.КодМаркировки);
					
					Если мКодыМаркировкиФактически.Найти(СтрокаКодов.КодМаркировки) = Неопределено Тогда
						мКодыМаркировкиФактически.Добавить(СтрокаКодов.КодМаркировки);
					КонецЕсли;
					
					ТребуетсяКоличествоКодовИзлишек = ТребуетсяКоличествоКодовИзлишек - 1;
					
					тзКодыМаркировкиПолная.Удалить(СтрокаКодов);
					
				КонецЦикла;
				
			КонецЕсли;
			
			СтруктураДанных.Вставить("мКодыМаркировкиПоДокументу", мКодыМаркировкиПоДокументу);
			СтруктураДанных.Вставить("мКодыМаркировкиФактически", мКодыМаркировкиФактически);
			СтруктураДанных.Вставить("мКодыМаркировкиНедостача", мКодыМаркировкиНедостача);
			СтруктураДанных.Вставить("мКодыМаркировкиИзлишек", мКодыМаркировкиИзлишек);
			СтруктураДанных.Вставить("мКодыМаркировкиБрак", мКодыМаркировкиБрак);
			
			МассивСтруктур.Добавить(СтруктураДанных);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если КонвертацияВалютПоКурсуДокумента Тогда
		
		//Конвертация из валюты в рубли
		СтруктураПараметров = МОП_ПолучитьПараметрыВалютДокумента(ОбъектЗаполнения.Ссылка);
		Курс = СтруктураПараметров.Курс;
		Кратность = СтруктураПараметров.Кратность;
				
		Для Каждого ОбъектЗаполнения Из МассивСтруктур Цикл
			
			ВалютаДокумента = МОП_ПолучитьВалютуДокумента(ОбъектЗаполнения.Ссылка);
			ВалютаДоговора = МОП_ПолучитьВалютуДоговораДокумента(ОбъектЗаполнения.Ссылка);
			
			Если ВалютаДоговора <> ВалютаДокумента Тогда //Требуется перерасчет
				
				ОбъектЗаполнения.ЦенаСНДС = Окр(ОбъектЗаполнения.ЦенаСНДС * Курс / Кратность, 4); 
				
				ОбъектЗаполнения.СуммаСНДС = Окр(ОбъектЗаполнения.СуммаСНДС * Курс / Кратность, 2); 
				ОбъектЗаполнения.СуммаСНДСПоДокументу = Окр(ОбъектЗаполнения.СуммаСНДСПоДокументу * Курс / Кратность, 2); 
				ОбъектЗаполнения.СуммаСНДСНедостача = Окр(ОбъектЗаполнения.СуммаСНДСНедостача * Курс / Кратность, 2); 
				ОбъектЗаполнения.СуммаСНДСИзлишек = Окр(ОбъектЗаполнения.СуммаСНДСИзлишек * Курс / Кратность, 2); 
				ОбъектЗаполнения.СуммаСНДСБрак = Окр(ОбъектЗаполнения.СуммаСНДСБрак * Курс / Кратность, 2);
				
				ОбъектЗаполнения.СуммаНДС = Окр(ОбъектЗаполнения.СуммаНДС * Курс / Кратность, 2); 
				ОбъектЗаполнения.СуммаНДСПоДокументу = Окр(ОбъектЗаполнения.СуммаНДСПоДокументу * Курс / Кратность, 2); 
				ОбъектЗаполнения.СуммаНДСНедостача = Окр(ОбъектЗаполнения.СуммаНДСНедостача * Курс / Кратность, 2); 
				ОбъектЗаполнения.СуммаНДСИзлишек = Окр(ОбъектЗаполнения.СуммаНДСИзлишек * Курс / Кратность, 2); 
				ОбъектЗаполнения.СуммаНДСБрак = Окр(ОбъектЗаполнения.СуммаНДСБрак * Курс / Кратность, 2);
				
				
			КонецЕсли;
					
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат МассивСтруктур;
	//-Макрушин Е. 07.04.2026 #UT10-5800

КонецФункции

Функция ФОД_ПолучитьЗначениеПоНаименованиюСвойства(ВерсияЗаполнения, Знач ОбъектЗаполнения, НаименованиеСвойства = Неопределено, ПустоеЗначениеПоУмолчанию = Неопределено)
	
	//+Макрушин Е. 08.04.2026 #UT10-5800
	Результат = ПустоеЗначениеПоУмолчанию;

	Если ЗначениеЗаполнено(НаименованиеСвойства) И ОбъектЗаполнения.Свойство(НаименованиеСвойства) И ЗначениеЗаполнено(ОбъектЗаполнения[НаименованиеСвойства]) Тогда
		Результат = ОбъектЗаполнения[НаименованиеСвойства];
	КонецЕсли;

	Возврат Результат;
