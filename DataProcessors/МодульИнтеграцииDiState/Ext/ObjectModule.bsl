Процедура РС_ПривязатьИдентификаторПодразделенияВ1С(Объект, Идентификатор, Знач Переписывать = Ложь)
	
	СвойствоИдентификатора = МОП_ПолучитьРеквизит("DS_Подразделение_ID");	
	НаборЗаписейЗначенияСвойств = МОП_ПолучитьНовыйНаборЗаписейДопСведений();
	НаборЗаписейЗначенияСвойств.Отбор.Объект.Установить(Объект.Ссылка);
	НаборЗаписейЗначенияСвойств.Отбор.Свойство.Установить(СвойствоИдентификатора);
	НаборЗаписейЗначенияСвойств.Прочитать();
	
	Если НаборЗаписейЗначенияСвойств.Количество() = 0 Тогда		
		
		Запись = НаборЗаписейЗначенияСвойств.Добавить();
		Переписывать = Истина;
		
	ИначеЕсли НаборЗаписейЗначенияСвойств.Количество() > 0 Тогда
		Запись = НаборЗаписейЗначенияСвойств[0];
	КонецЕсли;
	
	Если Переписывать Тогда
		
		Запись.Объект = Объект;
		Запись.Свойство = СвойствоИдентификатора;
		Запись.Значение = Идентификатор;
		
		УстановитьПривилегированныйРежим(Истина);
		НаборЗаписейЗначенияСвойств.Записать();
		УстановитьПривилегированныйРежим(Ложь);
		ДобавитьВЖурнал("Привязка " + Строка(Объект) + " с идентификатором " + Идентификатор, "ПривязатьИдентификаторПодразделенияВ1С");	
		
	КонецЕсли;
	

