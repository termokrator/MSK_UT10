Функция ФОД_ПолучитьСопроводительныеДокументы(Знач ОбъектЗаполнения)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СчетФактураВыданныйДокументыОснования.Ссылка КАК Ссылка,
	|	ТранспортнаяНакладнаяДокументыОснования.ДокументОснование.Организация.ИНН КАК ИННОтправителя,
	|	ТранспортнаяНакладнаяДокументыОснования.ДокументОснование.Контрагент.ИНН КАК ИННПолучателя,
	|	СчетФактураВыданныйДокументыОснования.Ссылка.Дата,
	|	СчетФактураВыданныйДокументыОснования.Ссылка.Номер
	|ИЗ
	|	Документ.ТранспортнаяНакладная.ДокументыОснования КАК ТранспортнаяНакладнаяДокументыОснования
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
	|		ПО ТранспортнаяНакладнаяДокументыОснования.ДокументОснование = СчетФактураВыданныйДокументыОснования.ДокументОснование
	|			И (СчетФактураВыданныйДокументыОснования.Ссылка.Проведен)
	|ГДЕ
	|	ТранспортнаяНакладнаяДокументыОснования.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ОбъектЗаполнения);  
	
	Рез = Запрос.Выполнить().Выгрузить();
	
	Для каждого Стр Из Рез Цикл
		Стр.Номер = ОбщегоНазначения.ПолучитьНомерНаПечать(Стр.Ссылка);
	КонецЦикла;
		
	Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(Рез);
		
