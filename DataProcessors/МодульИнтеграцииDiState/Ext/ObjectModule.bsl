Функция ЗарегистрироватьсяВЭДО(СтруктураДанных, Подпись) 						Экспорт
	
	Контент = ЭДО_СформироватьЗапросНаРегистрацию(СтруктураДанных);
	Контент.Вставить("signature", КНП_ОбработатьСтрокуBase64(Подпись));
	Контент.Вставить("content", "please give me a sign");
	
	СтрокаКонтента = КНП_ЗаписатьJSONНаСервере(Контент);
	Результат = API_Регистрация(СтрокаКонтента);	
	
	Если ТипЗнч(Результат) <> Тип("Соответствие") Тогда
		Результат = Неопределено;
	КонецЕсли;
	
	ЗаписатьЖурналВФайл();
	Возврат Результат;

КонецФункции

