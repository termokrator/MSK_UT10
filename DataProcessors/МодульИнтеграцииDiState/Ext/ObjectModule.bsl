Функция ЭДО_ПолучитьДанныеПакетаДокументов(ИдентификаторПакета)
	
	Результат = Новый Массив;
	
	ДанныеПакета = API_ПолучитьДанныеПакета(ИдентификаторПакета);
	
	Если ТипЗнч(ДанныеПакета) <> Тип("Соответствие") Тогда
		
		ЗаписатьЖурналВФайл();
		Возврат Результат;
		
	КонецЕсли;
	
	Если ДанныеПакета.Получить("success") <> Неопределено И ДанныеПакета.Получить("success") Тогда
		
		МассивДокументов = ДанныеПакета.Получить("documents");
		
		Для Каждого Документ Из МассивДокументов Цикл
			
			СтруктураДок = Новый Структура("ИдентификаторДокумента,Тип,Контент,Подпись,ИмяФайла,СистемноеИмя");
			СтруктураДок.ИдентификаторДокумента = Документ.Получить("id");
			СистемноеИмяДокумента = Документ.Получить("typeSystemName");
			ГруппаПроцессинга = Документ.Получить("packageFlowSystemName");
			СтруктураДок.Тип = ЭДО_РазобратьТипДокумента(СистемноеИмяДокумента, ГруппаПроцессинга, Документ.Получить("typeName") );
			СтруктураДок.Контент = Документ.Получить("content");
			СтруктураДок.ИмяФайла = Документ.Получить("clientFileName");
			СтруктураДок.Подпись = Документ.Получить("signature");
			СтруктураДок.СистемноеИмя = СистемноеИмяДокумента;
			Результат.Добавить(СтруктураДок);
			
		КонецЦикла;
		
	Иначе
		ДобавитьВЖурнал("Сообщение от сервера: " + ДанныеПакета.Получить("codeDescription"), "ПолучитьДанныеПакетаДокументов" );
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

