Функция ФОД_ПолучитьКодТовара(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	
	Если ОбъектЗаполнения.Свойство("Ссылка") И ЗначениеЗаполнено(ОбъектЗаполнения.Ссылка) Тогда
		
		Если МОП_ЭтоСчетФактураНаАванс(ОбъектЗаполнения.Ссылка) Тогда
			Возврат "-";
		КонецЕсли;
		
	КонецЕсли;
	
	Если ОбъектЗаполнения.Свойство("Номенклатура") И ЗначениеЗаполнено(ОбъектЗаполнения.Номенклатура) Тогда
		
		Если МОП_ЭтоУслуга(ОбъектЗаполнения.Номенклатура) Тогда
			
			Если КНП_ЕстьРеквизит(ОбъектЗаполнения.Номенклатура, "КодОКВЭД2") И ЗначениеЗаполнено(ОбъектЗаполнения.Номенклатура.КодОКВЭД2) Тогда
				Возврат ОбъектЗаполнения.Номенклатура.КодОКВЭД2.Код;
			ИначеЕсли КНП_ЕстьРеквизит(ОбъектЗаполнения.Номенклатура, "КодОКВЭД") И ЗначениеЗаполнено(ОбъектЗаполнения.Номенклатура.КодОКВЭД) Тогда
				Возврат ОбъектЗаполнения.Номенклатура.КодОКВЭД.Код;
			Иначе
				Возврат ОбъектЗаполнения.Номенклатура.Код;
			КонецЕсли;
			
		Иначе
			
			Если КНП_ЕстьРеквизит(ОбъектЗаполнения.Номенклатура, "КодПроизводителя") И ЗначениеЗаполнено(ОбъектЗаполнения.Номенклатура.КодПроизводителя) Тогда
				Возврат ОбъектЗаполнения.Номенклатура.КодПроизводителя;
			Иначе
				Возврат ОбъектЗаполнения.Номенклатура.Код;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат "-";		

КонецФункции

Функция ФОД_ПолучитьИдентификаторОтправителя(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	
