	ЧасовойПояс = ПолучитьТаймЗону();              
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МАКСИМУМ(ПогрузкаВАвто.Дата) КАК Дата
	|ИЗ
