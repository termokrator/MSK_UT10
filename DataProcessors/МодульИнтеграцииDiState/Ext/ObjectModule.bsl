Функция ФОД_ПолучитьПогрузчика(Знач ОбъектЗаполнения)
//+Белов А. 17.06.2026 #UT10-5921

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПогрузкаВАвто.Ответственный
	|ИЗ
	|	Документ.ПогрузкаВАвто КАК ПогрузкаВАвто
	|ГДЕ
	|	ПогрузкаВАвто.ЗаданиеНаДоставку = &ЗаданиеНаДоставку
	|	И ПогрузкаВАвто.Проведен";
	
	Запрос.УстановитьПараметр("ЗаданиеНаДоставку", ОбъектЗаполнения.ЗаданиеНаДоставку);  
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Погрузчик = Выборка.Ответственный;
	Иначе
		Погрузчик = ОбъектЗаполнения.ЗаданиеНаДоставку.Водитель;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Пользователи.Ссылка
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.ФизЛицо = &ФизЛицо
	|	И НЕ Пользователи.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ФизЛицо", Погрузчик);  
	
	Пользователь = Неопределено;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Пользователь = Выборка.Ссылка;
	КонецЕсли;	
	
	СтруктураФИО = Новый Структура("Фамилия, Имя, Отчество");
	СтруктураФИОМассив = КНП_РазобратьНаименованиеИПНаМассив(Погрузчик.Наименование);
	
	Если СтруктураФИОМассив.Количество() > 0 Тогда
		СтруктураФИО.Фамилия = СтруктураФИОМассив[0];
	КонецЕсли;
	
	Если СтруктураФИОМассив.Количество() > 1 Тогда
		СтруктураФИО.Имя = СтруктураФИОМассив[1];
	КонецЕсли;
	
	Если СтруктураФИОМассив.Количество() > 2 Тогда
		СтруктураФИО.Отчество = СтруктураФИОМассив[2];
	КонецЕсли;
	
	Возврат Новый Структура("Погрузчик, Пользователь, ФИО", Погрузчик, Пользователь, СтруктураФИО);
		
//-Белов А. 17.06.2026 #UT10-5921
КонецФункции  

