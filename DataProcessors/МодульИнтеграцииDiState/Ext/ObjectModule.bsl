// У документа есть СФ
// *Поддержка БП 3.0, УТ 11, КА 2.4, БП 2.0, УТ 10.3
//
// Параметры:
//  ДокументСсылка	 - ДокументСсылка	 - 
// 
// Возвращаемое значение:
// Булево  - 
//
Функция КЗП_УДокументаЕстьСФ(ДокументСсылка)
	
	Результат = Ложь;
	ТекКонф = КНП_ИмяКонфигурации();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументОснование", ДокументСсылка);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СчетФактураВыданныйДокументыОснования.Ссылка
	|ИЗ
	|	Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
	|ГДЕ
	|	СчетФактураВыданныйДокументыОснования.ДокументОснование = &ДокументОснование
	|	ИЛИ СчетФактураВыданныйДокументыОснования.Ссылка.ДокументОснование = &ДокументОснование";
	
	Если ТекКонф = "УНФ" Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИЛИ СчетФактураВыданныйДокументыОснования.Ссылка.ДокументОснование = &ДокументОснование", "");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "СчетФактураВыданный", "СчетФактура");	 
		
	КонецЕсли;
	
	Если ТекКонф = "БГУ" Тогда
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1 
		|	СчетФактураВыданный.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
		|ГДЕ
		|	СчетФактураВыданный.ДокументОснование = &ДокументОснование";
	КонецЕсли;
	
	Результат = НЕ Запрос.Выполнить().Пустой();
	
	Возврат Результат;

КонецФункции

