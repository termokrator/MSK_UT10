Функция ПФ_СформироватьПечатнуюФормуСлужебногоСообщенияXML(ОбъектXML, Подписан = Ложь, ИмяДокумента = "")
	
	СтруктураДанных = XML_ПрочитатьВСтруктуру(ОбъектXML);
	
	Если СтруктураДанных = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтруктураДокумента = ПФ_ПолучитьСтруктуруСлужебногоСообщения(); 
	ПФ_ДополнитьСтруктуруСведениямиОбЭД(СтруктураДанных);
	
	//Переменные
	ТипДокумента = ИмяДокумента;
	ИдентификаторЭД = "";
	ОператорЭДО = "ДиСтэйт";
	ВерсияФормата = "1.0";
	Содержание = "";
	ПредставлениеОтправителя = "";
	ПредставлениеПолучателя = "";
	ИдентификаторОтправителя = "";
	ИдентификаторПолучателя = "";
	КНД = "";
	СтатусПодписиОтправителя = "Не подписан";
	СтатусПодписиПолучателя = ?(Подписан, "Подписан", "Не подписан");
	
	
	/////////////////////////////////////////////////////////
	//			Парсинг
	СтруктураДанных = КНП_БезопасноПрочитатьЗначение(СтруктураДанных, "Файл");
	
	Если ЗначениеЗаполнено(СтруктураДанных) Тогда
		
		ВерсияФормата = КНП_БезопасноПрочитатьЗначение(СтруктураДанных, "ВерсФорм");
		ИдентификаторЭД = КНП_БезопасноПрочитатьЗначение(СтруктураДанных, "ИдФайл");
		
		ДанныеДокумента = КНП_БезопасноПрочитатьЗначение(СтруктураДанных, "Документ");
		
		Если ЗначениеЗаполнено(ДанныеДокумента) Тогда
			
			КНД = КНП_БезопасноПрочитатьЗначение(ДанныеДокумента, "КНД");
			
			Если ДанныеДокумента.Свойство("ОперЭДО") Тогда
				ОператорЭДО = КНП_БезопасноПрочитатьЗначение(ДанныеДокумента.ОперЭДО, "НаимОрг")
				+ " " + КНП_БезопасноПрочитатьЗначение(ДанныеДокумента.ОперЭДО, "ИННЮЛ");
			КонецЕсли;
			
			Если ДанныеДокумента.Свойство("ОтпрДок") Тогда
				
				ИдентификаторОтправителя = КНП_БезопасноПрочитатьЗначение(ДанныеДокумента.ОтпрДок, "ИдУчастЭДО");
				ДанныеЮЛ = КНП_БезопасноПрочитатьЗначение(ДанныеДокумента.ОтпрДок, "ЮЛ");
				
				Если ЗначениеЗаполнено(ДанныеЮЛ) Тогда
					ПредставлениеОтправителя = ДанныеЮЛ.НаимОрг + ", ИНН " + ДанныеЮЛ.ИННЮЛ + " \ КПП " + ДанныеЮЛ.КПП;	
				КонецЕсли;
				
				ОперЭДО = КНП_БезопасноПрочитатьЗначение(ДанныеДокумента.ОтпрДок, "ОперЭДО");
				
				Если ЗначениеЗаполнено(ОперЭДО) Тогда
					ПредставлениеОтправителя = КНП_БезопасноПрочитатьЗначение(ОперЭДО, "НаимОрг")
					+ " " + КНП_БезопасноПрочитатьЗначение(ОперЭДО, "ИННЮЛ");	
				КонецЕсли;
				
			КонецЕсли;
			
			Если ДанныеДокумента.Свойство("СвОтпрДок") Тогда
				
				ИдентификаторОтправителя = КНП_БезопасноПрочитатьЗначение(ДанныеДокумента.СвОтпрДок, "ИдУчастЭДО");
				ДанныеЮЛ = КНП_БезопасноПрочитатьЗначение(ДанныеДокумента.СвОтпрДок, "ОтпрЮЛ");
				
				Если ЗначениеЗаполнено(ДанныеЮЛ) Тогда
					ПредставлениеОтправителя = ДанныеЮЛ.НаимОрг + ", ИНН " + ДанныеЮЛ.ИННЮЛ + " \ КПП " + ДанныеЮЛ.КПП;	
				КонецЕсли;
				
				ОперЭДО = КНП_БезопасноПрочитатьЗначение(ДанныеДокумента.СвОтпрДок, "ОперЭДО");
				
				Если ЗначениеЗаполнено(ОперЭДО) Тогда
					ОператорЭДО = КНП_БезопасноПрочитатьЗначение(ОперЭДО, "НаимОрг")
					+ " " + КНП_БезопасноПрочитатьЗначение(ОперЭДО, "ИННЮЛ");	
				КонецЕсли;	
				
			КонецЕсли;
			
			Если ДанныеДокумента.Свойство("ПолДок") Тогда
				
				ИдентификаторПолучателя = КНП_БезопасноПрочитатьЗначение(ДанныеДокумента.ПолДок, "ИдУчастЭДО");
				ДанныеЮЛ = КНП_БезопасноПрочитатьЗначение(ДанныеДокумента.ПолДок, "ЮЛ");
				
				Если ЗначениеЗаполнено(ДанныеЮЛ) Тогда
					ПредставлениеПолучателя = ДанныеЮЛ.НаимОрг + ", ИНН " + ДанныеЮЛ.ИННЮЛ + " \ КПП " + ДанныеЮЛ.КПП;	
				КонецЕсли;
				
			КонецЕсли;
			
			Если ДанныеДокумента.Свойство("СвПолДок") Тогда
				
				ИдентификаторПолучателя = КНП_БезопасноПрочитатьЗначение(ДанныеДокумента.СвПолДок, "ИдУчастЭДО");
				ДанныеЮЛ = КНП_БезопасноПрочитатьЗначение(ДанныеДокумента.СвПолДок, "ОтпрЮЛ");
				
				Если ЗначениеЗаполнено(ДанныеЮЛ) Тогда
					ПредставлениеПолучателя = ДанныеЮЛ.НаимОрг + ", ИНН " + ДанныеЮЛ.ИННЮЛ + " \ КПП " + ДанныеЮЛ.КПП;	
				КонецЕсли;
				
			КонецЕсли;
			
			Если ДанныеДокумента.Свойство("УчастЭДО") Тогда
				
				ИдентификаторПолучателя = КНП_БезопасноПрочитатьЗначение(ДанныеДокумента.УчастЭДО, "ИдУчастЭДО");
				ДанныеЮЛ = КНП_БезопасноПрочитатьЗначение(ДанныеДокумента.УчастЭДО, "ЮЛ");
				
				Если ЗначениеЗаполнено(ДанныеЮЛ) Тогда
					ПредставлениеПолучателя = ДанныеЮЛ.НаимОрг + ", ИНН " + ДанныеЮЛ.ИННЮЛ + " \ КПП " + ДанныеЮЛ.КПП;	
				КонецЕсли;
				
			КонецЕсли;
			
			
			//Сведения о подтверждении
			Если ДанныеДокумента.Свойство("СведПодтв") Тогда
				
				СведенияДокумента = ДанныеДокумента.СведПодтв;
				
				Если СведенияДокумента.Свойство("ДатаОтпр") Тогда
					
					Содержание = ?(ЗначениеЗаполнено(Содержание), Содержание + Символы.ПС, "") + "Дата отправки: " + СведенияДокумента.ДатаОтпр;
					
					Если СведенияДокумента.Свойство("ВремяОтпр") Тогда
						Содержание = Содержание + " " + СведенияДокумента.ВремяОтпр;
					КонецЕсли;
					
				КонецЕсли;
				
				СведОтпрФайл = КНП_БезопасноПрочитатьЗначение(СведенияДокумента, "СведОтпрФайл");
				
				Если ЗначениеЗаполнено(СведОтпрФайл) Тогда
					
					Содержание = ?(ЗначениеЗаполнено(Содержание), Содержание + Символы.ПС, "") + "подтверждение файла " 
					+ КНП_БезопасноПрочитатьЗначение(СведОтпрФайл, "ИмяПостФайла") ;
					СведенияЭЦП = КНП_БезопасноПрочитатьЗначение(СведОтпрФайл, "ЭЦППолФайл");
					
					Если ЗначениеЗаполнено(СведенияЭЦП) И ЗначениеЗаполнено(КНП_БезопасноПрочитатьЗначение(СведенияЭЦП, "Значение") ) Тогда
						СтатусПодписиОтправителя = "Подписан";
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
			//Извещение о получении
			Если ДанныеДокумента.Свойство("СвИзвПолуч") Тогда
				
				СведенияДокумента = ДанныеДокумента.СвИзвПолуч;
				
				Если СведенияДокумента.Свойство("ДатаПол") Тогда
					
					Содержание = ?(ЗначениеЗаполнено(Содержание), Содержание + Символы.ПС, "") + "Дата отправки: " + СведенияДокумента.ДатаПол;
					
					Если СведенияДокумента.Свойство("ВремяПол") Тогда
						Содержание = Содержание + " " + СведенияДокумента.ВремяПол;
					КонецЕсли;
					
				КонецЕсли;
				
				СведПолФайл = КНП_БезопасноПрочитатьЗначение(СведенияДокумента, "СведПолФайл");
				ИмяПостФайла = КНП_БезопасноПрочитатьЗначение(СведПолФайл, "ИмяПостФайла");
				
				Если ЗначениеЗаполнено(СведПолФайл) Тогда
					
					Содержание = ?(ЗначениеЗаполнено(Содержание), Содержание + Символы.ПС, "") + "Получен файл " 
					+ ИмяПостФайла ;
					СведенияЭЦП = КНП_БезопасноПрочитатьЗначение(СведПолФайл, "ЭЦППолФайл");
					
					Если ЗначениеЗаполнено(СведенияЭЦП) И ЗначениеЗаполнено(КНП_БезопасноПрочитатьЗначение(СведенияЭЦП, "Значение") ) Тогда
						СтатусПодписиОтправителя = "Подписан";
					КонецЕсли;
					
				КонецЕсли;	
				
				Если Лев(ИмяПостФайла, 2) = "ON" Тогда
					
					Врем = ИдентификаторОтправителя;
					ИдентификаторОтправителя = ИдентификаторПолучателя;
					ИдентификаторПолучателя = Врем;
					Врем = ПредставлениеОтправителя;
					ПредставлениеОтправителя = ПредставлениеПолучателя;
					ПредставлениеПолучателя = Врем;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "ТипДокумента", ТипДокумента);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "ИдентификаторЭД", ИдентификаторЭД);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "ПредставлениеОператора", ОператорЭДО);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "ВерсияФормата", ВерсияФормата);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "КНД", КНД);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "СодержаниеДокумента", Содержание);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "ПредставлениеОтправителя", ПредставлениеОтправителя);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "ПредставлениеПолучателя", ПредставлениеПолучателя);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "ИдентификаторОтправителя", ИдентификаторОтправителя);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "ИдентификаторПолучателя", ИдентификаторПолучателя);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "СтатусПодписиОтправителя", СтатусПодписиОтправителя);
	КНП_БезопасноЗаписатьЗначение(СтруктураДокумента, "СтатусПодписиПолучателя", СтатусПодписиПолучателя);
	Возврат ПФ_СформироватьПФСлужебногоСообщения(СтруктураДокумента);
	
	
КонецФункции

Процедура ПФ_ДополнитьСтруктуруСведениямиОбЭД(СтруктураДанных)
	
	СтруктураДанных.Вставить("ПредставлениеОператора");
	СтруктураДанных.Вставить("ИдентификаторЭД");
	СтруктураДанных.Вставить("ИдентификаторОтправителя");
	СтруктураДанных.Вставить("ИдентификаторПолучателя");

КонецПроцедуры

Функция ПФ_РазобратьИзСтруктурыПредставлениеОрганизации(Структура)
	
	СтрокаПредставления = "";
	ИмяПодразделения = КНП_БезопасноПрочитатьЗначение(Структура, "СтруктПодр");
	СвОрг = КНП_БезопасноПрочитатьЗначение(Структура.ИдСв, "СвОрг"); 
	СвИп = КНП_БезопасноПрочитатьЗначение(Структура.ИдСв, "СвИП");
	
	Если ЗначениеЗаполнено(СвОрг) Тогда
		
		СвЮЛ = КНП_БезопасноПрочитатьЗначение(СвОрг, "СвЮЛ");
		
		Если ЗначениеЗаполнено(СвЮЛ) Тогда
			
			Если СвЮЛ.Свойство("НаимОрг") Тогда
				СтрокаПредставления = СвЮЛ.НаимОрг;
			КонецЕсли;
			
		КонецЕсли;  
		
	ИначеЕсли ЗначениеЗаполнено(СвИп) Тогда
		
		СвФИО = КНП_БезопасноПрочитатьЗначение(СвИп, "ФИО");
		
		Если ЗначениеЗаполнено(СвФИО) Тогда
			
			Если СвФИО.Свойство("Фамилия") Тогда
				СтрокаПредставления = СвФИО.Фамилия + " ";
			КонецЕсли; 
			
			Если СвФИО.Свойство("Имя") Тогда
				СтрокаПредставления = СтрокаПредставления + СвФИО.Имя;
			КонецЕсли;
			
		КонецЕсли; 
		
	Иначе
		
		СвЮЛУч = КНП_БезопасноПрочитатьЗначение(Структура.ИдСв, "СвЮЛУч");
		
		Если ЗначениеЗаполнено(СвЮЛУч) Тогда
			
			Если СвЮЛУч.Свойство("НаимОрг") Тогда
				СтрокаПредставления = СвЮЛУч.НаимОрг;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяПодразделения) И ИмяПодразделения <> "Основной офис" Тогда
		СтрокаПредставления = СтрокаПредставления + " (" + ИмяПодразделения + ")";
	КонецЕсли;
	
	Возврат СтрокаПредставления;

КонецФункции

Функция ПФ_РазобратьИзСтруктурыАдресОрганизации(Структура)
	
	СтрокаАдреса = "";
	
	Если Структура.Свойство("Адрес") Тогда
		
		АдрРФ = КНП_БезопасноПрочитатьЗначение(Структура.Адрес, "АдрРФ");
		АдрИнф = КНП_БезопасноПрочитатьЗначение(Структура.Адрес, "АдрИнф");
		
		Если ЗначениеЗаполнено(АдрРФ) Тогда
			
			Если АдрРФ.Свойство("Индекс") Тогда
				СтрокаАдреса = ?(СтрокаАдреса = "", "", СтрокаАдреса + ", ") + АдрРФ.Индекс;
			КонецЕсли;
			
			Если АдрРФ.Свойство("КодРегион") Тогда
				
				Регион = СправочникРегионы.Найти(Число(АдрРФ.КодРегион), "КодРегиона");
				
				Если ЗначениеЗаполнено(Регион) Тогда
					СтрокаАдреса = ?(СтрокаАдреса = "", "", СтрокаАдреса + ", ") + Регион.ИмяРегиона;
				КонецЕсли;
				
			КонецЕсли;
			
			Если АдрРФ.Свойство("Город") Тогда
				
				Если Найти(АдрРФ.Город, "Москва") ИЛИ Найти(АдрРФ.Город, "Санкт") Тогда
					
				Иначе
					СтрокаАдреса = ?(СтрокаАдреса = "", "", СтрокаАдреса + ", ") + АдрРФ.Город;
				КонецЕсли;
				
			КонецЕсли;
			
			Если АдрРФ.Свойство("Район") Тогда
				СтрокаАдреса = ?(СтрокаАдреса = "", "", СтрокаАдреса + ", ") + КНП_ПолучитьСокращениеРеквАдреса("Район", АдрРФ.Район);
			КонецЕсли;
			
			Если АдрРФ.Свойство("НаселПункт") Тогда
				СтрокаАдреса = ?(СтрокаАдреса = "", "", СтрокаАдреса + ", ") + КНП_ПолучитьСокращениеРеквАдреса("НаселПункт", АдрРФ.НаселПункт);
			КонецЕсли;
			
			Если АдрРФ.Свойство("Улица") Тогда
				СтрокаАдреса = ?(СтрокаАдреса = "", "", СтрокаАдреса + ", ") + КНП_ПолучитьСокращениеРеквАдреса("Улица", АдрРФ.Улица);
			КонецЕсли;
			
			Если АдрРФ.Свойство("Дом") Тогда
				СтрокаАдреса = ?(СтрокаАдреса = "", "", СтрокаАдреса + ", ") + КНП_ПолучитьСокращениеРеквАдреса("Дом", АдрРФ.Дом);
			КонецЕсли;
			
			Если АдрРФ.Свойство("Корпус") Тогда
				СтрокаАдреса = ?(СтрокаАдреса = "", "", СтрокаАдреса + ", ") + ?(Найти(нрег(СтрокаАдреса),"Строение") > 0, 
				           КНП_ПолучитьСокращениеРеквАдреса("Строение", АдрРФ.Корпус),КНП_ПолучитьСокращениеРеквАдреса("Корпус", АдрРФ.Корпус));
			КонецЕсли;
			
			Если АдрРФ.Свойство("Кварт") Тогда
				СтрокаАдреса = ?(СтрокаАдреса = "", "", СтрокаАдреса + ", ") + КНП_ПолучитьСокращениеРеквАдреса("Квартира", АдрРФ.Кварт);
			КонецЕсли;
			
		ИначеЕсли ЗначениеЗаполнено(АдрИнф) Тогда
			
			Возврат АдрИнф.АдрТекст;	
			
		КонецЕсли;
		
	ИначеЕсли Структура.Свойство("region") Тогда
		
		//Это счет на оплату - свой формат
		Если Структура.Свойство("postalCode") И ЗначениеЗаполнено(Структура.postalCode) Тогда
			СтрокаАдреса = ?(СтрокаАдреса = "", "", СтрокаАдреса + ", ") + Структура.postalCode;	
		КонецЕсли;
		
		Если Структура.Свойство("country") И ЗначениеЗаполнено(Структура.country) Тогда
			СтрокаАдреса = ?(СтрокаАдреса = "", "", СтрокаАдреса + ", ") + Структура.country;	
		КонецЕсли;
		
		Если Структура.Свойство("region") И ЗначениеЗаполнено(Структура.region) Тогда
			СтрокаАдреса = ?(СтрокаАдреса = "", "", СтрокаАдреса + ", ") + Структура.region;	
		КонецЕсли;
		
		Если Структура.Свойство("city") И ЗначениеЗаполнено(Структура.city) Тогда
			СтрокаАдреса = ?(СтрокаАдреса = "", "", СтрокаАдреса + ", ") + Структура.city;	
		КонецЕсли;
		
		Если Структура.Свойство("street") И ЗначениеЗаполнено(Структура.street) Тогда
			СтрокаАдреса = ?(СтрокаАдреса = "", "", СтрокаАдреса + ", ") + КНП_ПолучитьСокращениеРеквАдреса("Улица", Структура.street);	
		КонецЕсли;
		
		Если Структура.Свойство("house") И ЗначениеЗаполнено(Структура.house) Тогда
			СтрокаАдреса = ?(СтрокаАдреса = "", "", СтрокаАдреса + ", ") + КНП_ПолучитьСокращениеРеквАдреса("Дом", Структура.house);	
		КонецЕсли;
		
		Если Структура.Свойство("building") И ЗначениеЗаполнено(Структура.building) Тогда
			СтрокаАдреса = ?(СтрокаАдреса = "", "", СтрокаАдреса + ", ") + КНП_ПолучитьСокращениеРеквАдреса("Корпус", Структура.building);	
		КонецЕсли;
		
		Если Структура.Свойство("room") И ЗначениеЗаполнено(Структура.room) Тогда
			СтрокаАдреса = ?(СтрокаАдреса = "", "", СтрокаАдреса + ", ") + КНП_ПолучитьСокращениеРеквАдреса("Квартира", Структура.room);	
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СтрокаАдреса;

КонецФункции

