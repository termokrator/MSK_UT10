Функция ПолучитьДанныеНеформализованногоДокумента(СсылкаНаДокумент) 			Экспорт
	
	СтруктураДанных = Новый Структура("title,number,date,originFileName,content,typeTitle");
	ТипДокумента = ЭДО_ОпределелитьТипНеформализованного(СсылкаНаДокумент);
	СтруктураДанных.typeTitle = ТипДокумента;
	СтруктураДанных.title = ТипДокумента;
	СтруктураДанных.number = СсылкаНаДокумент.Номер;
	СтруктураДанных.date = Формат(СсылкаНаДокумент.Дата, "ДФ=dd.MM.yyyy");
	СтруктураДанных.originFileName = СтрЗаменить(ТипДокумента, " ", "_") + ".pdf";
	
	Если ТипДокумента = "Акт сверки" Тогда
		
		ТабДок = КЗП_ПолучитьПФАктаСверки(СсылкаНаДокумент);
		СтруктураДанных.content = РС_ПодготовитьВложениеКНеформализованномуДокументу(ТабДок);
		
	КонецЕсли;
	
	ЗаписатьЖурналВФайл();
	Возврат СтруктураДанных;

КонецФункции

