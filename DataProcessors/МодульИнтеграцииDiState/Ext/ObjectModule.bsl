Функция ФОД_ПолучитьПодписантаДокумента(Знач ОбъектЗаполнения)
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ДолжностьПодписанта", 		СтрПолучитьСтроку(ДанныеПодписанта, 1) );	
	СтруктураДанных.Вставить("ФамилияПодписанта", 			СтрПолучитьСтроку(ДанныеПодписанта, 2) );
	СтруктураДанных.Вставить("ИмяПодписанта", 				СтрПолучитьСтроку(ДанныеПодписанта, 3) );
	СтруктураДанных.Вставить("ОтчествоПодписанта", 			СтрПолучитьСтроку(ДанныеПодписанта, 4) );
	СтруктураДанных.Вставить("ТипПодписанта", 				СтрПолучитьСтроку(ДанныеПодписанта, 5) );
	СтруктураДанных.Вставить("ОбластьПолномочийПодписанта", Число(СтрПолучитьСтроку(ДанныеПодписанта, 6) ) );
	СтруктураДанных.Вставить("ОГРНИП", 						СтрПолучитьСтроку(ДанныеПодписанта, 7) );
	СтруктураДанных.Вставить("СтатусПодписанта", ?(Найти(СтруктураДанных.ТипПодписанта, "IP"), 4, 1) );
	Возврат СтруктураДанных;

КонецФункции

Функция ФОД_ПолучитьПлатежныйДокумент(Знач ОбъектЗаполнения) 
	
	СтруктураДанных = Новый  Структура;
	СтруктураПД = МОП_ПолучитьСтруктуруПлатежногоДокумента(ОбъектЗаполнения);
	
	Если ЗначениеЗаполнено(СтруктураПД) Тогда
		
