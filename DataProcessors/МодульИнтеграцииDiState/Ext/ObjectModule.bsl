Функция ФОД_ПолучитьТочкиМаршрута(Знач ОбъектЗаполнения)
//+Белов А. 17.06.2026 #UT10-5921

	ЧасовойПояс = ПолучитьТаймЗону();
	МассивВозврата = Новый Массив; 
	
	СтруктураТочки = Новый Структура("Вид, Номер, Дата, Время, Адрес, Документ", Неопределено, Неопределено, Неопределено, Неопределено, Неопределено, ОбъектЗаполнения);	
	СтруктураТочки.Номер = 1; 
	СтруктураТочки.Вид = "Погрузка";
	     
	Если ЗначениеЗаполнено(ОбъектЗаполнения.ЗаданиеНаДоставку) Тогда
		
		СтруктураТочки.Дата = ПолучитьДатуВВидеСтрокиДляЛогистики(ПолучитьНачалоЧасаПоДате(ОбъектЗаполнения.ЗаданиеНаДоставку.Дата), ЧасовойПояс);
		СтруктураТочки.Время = ПолучитьВремяВВидеСтрокиДляЛогистики(ПолучитьНачалоЧасаПоДате(ОбъектЗаполнения.ЗаданиеНаДоставку.Дата), ЧасовойПояс);
		
	Иначе 
	//+Белов А. 02.09.2026 #UT10-6021
		
		СтруктураТочки.Дата = ПолучитьДатуВВидеСтрокиДляЛогистики(ПолучитьНачалоЧасаПоДате(ОбъектЗаполнения.ДатаПогрузки), ЧасовойПояс);
		СтруктураТочки.Время = ПолучитьВремяВВидеСтрокиДляЛогистики(ПолучитьНачалоЧасаПоДате(ОбъектЗаполнения.ДатаПогрузки), ЧасовойПояс);
		
	//-Белов А. 02.09.2026 #UT10-6021
	КонецЕсли;
	
	СтруктураТочки.Адрес = ФОД_ПолучитьАдресДоставки(Новый Структура("Документ", ОбъектЗаполнения));
	
	МассивВозврата.Добавить(СтруктураТочки);	
	
	Инд = 1; 
	
	Если ЗначениеЗаполнено(ОбъектЗаполнения.ЗаданиеНаДоставку) Тогда
		
		ТаблицаМаршрута = Документы.ЗаданиеНаДоставку.ПолучитьТаблицуМаршрутаДляОтправкиВЭДО(ОбъектЗаполнения.ЗаданиеНаДоставку);
		
		Для каждого Стр Из ТаблицаМаршрута Цикл
			
			Инд = Инд + 1;
			
			СтруктураТочки = Новый Структура("Вид, Номер, Дата, Время, Адрес, Документ", Неопределено, Неопределено, Неопределено, Неопределено, Неопределено, ОбъектЗаполнения);	
			СтруктураТочки.Номер = Инд; 
			СтруктураТочки.Вид = "Выгрузка";
			СтруктураТочки.Дата = ПолучитьДатуВВидеСтрокиДляЛогистики(ОбъектЗаполнения.ЗаданиеНаДоставку.Дата, ЧасовойПояс);
			СтруктураТочки.Время = ПолучитьВремяВВидеСтрокиДляЛогистики(ОбъектЗаполнения.ЗаданиеНаДоставку.Дата, ЧасовойПояс);
			СтруктураТочки.Адрес = ФОД_ПолучитьАдресДоставки(Стр.Контрагент); 
			
			МассивВозврата.Добавить(СтруктураТочки);
			
		КонецЦикла;	
		
	Иначе  
		//+Белов А. 02.09.2026 #UT10-6021
		
		Для каждого Стр Из ОбъектЗаполнения.Грузополучатели Цикл
			
			Инд = Инд + 1;
			
			СтруктураТочки = Новый Структура("Вид, Номер, Дата, Время, Адрес, Документ", Неопределено, Неопределено, Неопределено, Неопределено, Неопределено, ОбъектЗаполнения);	
			СтруктураТочки.Номер = Инд; 
			СтруктураТочки.Вид = "Выгрузка";
			СтруктураТочки.Дата = ПолучитьДатуВВидеСтрокиДляЛогистики(ОбъектЗаполнения.ДатаПогрузки, ЧасовойПояс);
			СтруктураТочки.Время = ПолучитьВремяВВидеСтрокиДляЛогистики(ОбъектЗаполнения.ДатаПогрузки, ЧасовойПояс);
			СтруктураТочки.Адрес = ФОД_ПолучитьАдресДоставки(Стр.Контрагент); 
			
			МассивВозврата.Добавить(СтруктураТочки);
			
		КонецЦикла;	             
		
		//-Белов А. 02.09.2026 #UT10-6021
	КонецЕсли;
		
	Возврат МассивВозврата;
		
//-Белов А. 17.06.2026 #UT10-5921
КонецФункции

