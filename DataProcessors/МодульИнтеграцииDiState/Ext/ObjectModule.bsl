// Функция - Отправить get запрос
//
// Параметры:
//  СтрокаGetЗапроса - Строка	 - Строка, передаваемая на сервер. Строка запроса НЕ содержит имя сервера до первого /
//  ЗаголовкиЗапроса - Соответствие	- Соответствие, хранящее значения параметров запроса 
// 
// Возвращаемое значение:
// Структура  - Структура данных, содержащая Ответ и Заголовки
//
Функция ОтправитьGetЗапрос(ПолныйАдресЗапроса, ЗаголовкиЗапроса)
	
	ЗафиксироватьСобытиеКоннектора("Вход в процедуру", "ОтправитьGetЗапрос");
	СтруктураURI = СтруктураURI(ПолныйАдресЗапроса);
	
	СтрокаЗаголовка = "";
	
	Для Каждого ТипЗначения Из ЗаголовкиЗапроса Цикл
		СтрокаЗаголовка = СтрокаЗаголовка + ТипЗначения.Ключ + ": " + ТипЗначения.Значение + Символы.ПС;	
	КонецЦикла;
	
	ЗафиксироватьСобытиеКоннектора("Параметры процедуры: СтрокаGetЗапроса " + ПолныйАдресЗапроса + "; ЗаголовкиЗапроса " + СтрокаЗаголовка, "ОтправитьGetЗапрос");
	
	Попытка
		
		ОбъектСоединения = СоздатьHTTPКоннектор(СтруктураURI);
		
		Если ТипЗнч(ОбъектСоединения) = Тип("COMОбъект") Тогда
			
			///Работаем через WinHTTP
			СтрокаСоединения = СтруктураURI.Схема + "://" + СтруктураURI.ИмяСервера 
			+ ?(Лев(СтруктураURI.ПутьНаСервере, 1) = "/", "", "/") + СтруктураURI.ПутьНаСервере;
			
			ТаймаутВСекундах = 5;
			
			ОбъектСоединения.SetTimeouts(ТаймаутВСекундах * 1000, ТаймаутВСекундах * 1000, ТаймаутВСекундах * 1000, ТаймаутВСекундах * 1000);
			ОбъектСоединения.Open("GET",СтрокаСоединения,0);
			
			ЗафиксироватьСобытиеКоннектора("Открыто соединение GET по адресу " + СтрокаСоединения, "ОтправитьGetЗапрос");			
			ОбъектСоединения.SetRequestHeader("Accept-Language", "ru");
			ОбъектСоединения.SetRequestHeader("Accept-Charset","utf-8");
			ОбъектСоединения.setRequestHeader("Content-Language", "ru");
			ОбъектСоединения.setRequestHeader("Content-Charset", "utf-8");
			
			Если ЗаголовкиЗапроса.Получить("Content-type") = Неопределено Тогда
				ОбъектСоединения.setRequestHeader("Content-type", "application/x-www-form-urlencoded; charset=utf-8");
			КонецЕсли;
			
			Для Каждого ТипПараметра Из ЗаголовкиЗапроса Цикл
				
				Если ЗначениеЗаполнено(ТипПараметра.Ключ) И ЗначениеЗаполнено(ТипПараметра.Значение) Тогда
					ОбъектСоединения.setRequestHeader(ТипПараметра.Ключ, ТипПараметра.Значение);
				КонецЕсли;
				
			КонецЦикла;
			
			ЗафиксироватьСобытиеКоннектора("Попытка отправки GET запроса", "ОтправитьGetЗапрос");			
			ЗаписьЖурналаРегистрации("DS_ЗамерВремени.ОтправкаЗапроса.Начало",,,ТекущаяУниверсальнаяДатаВМиллисекундах(),ПолныйАдресЗапроса);
			
			ОбъектСоединения.Send();	
			
			Возврат ОбработатьОтветОтСервера(ОбъектСоединения);		
			
		Иначе
			
			ЗаголовкиHTTPЗапроса = Новый Соответствие;
			ЗаголовкиHTTPЗапроса.Вставить("Accept-Language", "ru");
			ЗаголовкиHTTPЗапроса.Вставить("Accept-Charset","utf-8");
			ЗаголовкиHTTPЗапроса.Вставить("Content-Language", "ru");
			ЗаголовкиHTTPЗапроса.Вставить("Content-Charset", "utf-8");;
			ЗаголовкиHTTPЗапроса.Вставить("Content-type", "application/x-www-form-urlencoded; charset=utf-8");
			
			Для Каждого ТипПараметра Из ЗаголовкиЗапроса Цикл
				ЗаголовкиHTTPЗапроса.Вставить(ТипПараметра.Ключ, ТипПараметра.Значение);	
			КонецЦикла;
			
			ЗапросHTTP = Новый HTTPЗапрос(СтруктураURI.ПутьНаСервере, ЗаголовкиHTTPЗапроса);
			ЗафиксироватьСобытиеКоннектора("Попытка отправки GET запроса", "ОтправитьGetЗапрос");
			ЗаписьЖурналаРегистрации("DS_ЗамерВремени.ОтправкаЗапроса.Начало",,,ТекущаяУниверсальнаяДатаВМиллисекундах(),ПолныйАдресЗапроса);
			
			Возврат ОбработатьОтветОтСервера(ОбъектСоединения.Получить(ЗапросHTTP) );	
			
		КонецЕсли;
		
	Исключение
		
		ЗафиксироватьСобытиеКоннектора(ОписаниеОшибки(), "ОтправитьGetЗапрос");
		Возврат Новый Структура("Заголовки,Ответ,КодОтвета", ,ОписаниеОшибки(), "");
		
	КонецПопытки;		
	
	Возврат Новый Структура("Заголовки,Ответ,КодОтвета", "");

КонецФункции

// Функция - Отправить post запрос
//
// Параметры:
//  АдресЗапроса	 - Строка	 - Адресная строка запроса БЕЗ указания имени сервера
//  ЗаголовкиЗапроса - Соответствие	 - Соответствие Заголовков запроса
//	ТелоЗапроса 	 - Соответствие, Строка  - Структура ключ-значение для тела запроса ИЛИ строка
// 
// Возвращаемое значение:
// Структура  - Структура данных, содержащая Ответ и Заголовки 
//
Функция ОтправитьPostЗапрос(ПолныйАдресЗапроса, ЗаголовкиЗапроса, ТелоЗапроса)
	
	СтруктураURI = СтруктураURI(ПолныйАдресЗапроса);
	ЗафиксироватьСобытиеКоннектора("Вход в процедуру", "ОтправитьPostЗапрос");
	
	Если ТипЗнч(ЗаголовкиЗапроса) = Тип("Соответствие") Тогда
		
		СтрокаЗаголовка = "";
		
		Для Каждого ТипЗначения Из ЗаголовкиЗапроса Цикл
			СтрокаЗаголовка = СтрокаЗаголовка + ТипЗначения.Ключ + ": " + ТипЗначения.Значение + Символы.ПС;	
		КонецЦикла;
		
	Иначе
		
		ЗафиксироватьСобытиеКоннектора("Некорректный формат заголовков", "ОтправитьPostЗапрос");
		Возврат Новый Структура("Заголовки,Ответ,КодОтвета", "");
		
	КонецЕсли;
	
	СтрокаТелаЗапроса = "";
	
	Если ТипЗнч(ТелоЗапроса) = Тип("Соответствие") Тогда
		
		Для Каждого ПараметрТела Из ТелоЗапроса Цикл
			
			Если ЗначениеЗаполнено(СтрокаТелаЗапроса) Тогда
				СтрокаТелаЗапроса = СтрокаТелаЗапроса + "&" + ПараметрТела.Ключ + "=" + ПараметрТела.Значение;
			Иначе
				СтрокаТелаЗапроса = ПараметрТела.Ключ + "=" + ПараметрТела.Значение;
			КонецЕсли;
			
		КонецЦикла;	
		
	Иначе
		СтрокаТелаЗапроса = ТелоЗапроса;	
	КонецЕсли;
	
	
	Попытка
		
		ОбъектСоединения = СоздатьHTTPКоннектор(СтруктураURI);
		
		Если ТипЗнч(ТелоЗапроса) = Тип("Соответствие") Тогда
			
			Если ТелоЗапроса.Получить("password") <> Неопределено Тогда
				ЗафиксироватьСобытиеКоннектора("Параметры процедуры: АдресЗапроса " + ПолныйАдресЗапроса + "; ЗаголовкиЗапроса " + СтрокаЗаголовка + "; Тело запроса - скрыто", "ОтправитьPostЗапрос")
			Иначе
				ЗафиксироватьСобытиеКоннектора("Параметры процедуры: АдресЗапроса " + ПолныйАдресЗапроса + "; ЗаголовкиЗапроса " + СтрокаЗаголовка + "; Тело запроса " + СтрокаТелаЗапроса, "ОтправитьPostЗапрос");
			КонецЕсли;
			
		Иначе
			ЗафиксироватьСобытиеКоннектора("Параметры процедуры: АдресЗапроса " + ПолныйАдресЗапроса + "; ЗаголовкиЗапроса " + СтрокаЗаголовка + "; Тело запроса " + СтрокаТелаЗапроса, "ОтправитьPostЗапрос");
		КонецЕсли;
		
		
		Если ТипЗнч(ОбъектСоединения) = Тип("COMОбъект") Тогда
			
			///Работаем через WinHTTP
			СтрокаСоединения = СтруктураURI.Схема + "://" + СтруктураURI.ИмяСервера 
			+ ?(Лев(СтруктураURI.ПутьНаСервере, 1) = "/", "", "/") + СтруктураURI.ПутьНаСервере;
			
			ОбъектСоединения.Open("POST", СтрокаСоединения,0);
			ЗафиксироватьСобытиеКоннектора("Открыто соединение POST по адресу " + СтрокаСоединения, "ОтправитьPostЗапрос");			
			
			ОбъектСоединения.SetRequestHeader("Accept-Language", "ru");
			ОбъектСоединения.SetRequestHeader("Accept-Charset","utf-8");
			ОбъектСоединения.setRequestHeader("Content-Language", "ru");
			ОбъектСоединения.setRequestHeader("Content-Charset", "utf-8");
			
			Если ЗаголовкиЗапроса.Получить("Content-type") = Неопределено Тогда
				ОбъектСоединения.setRequestHeader("Content-type", "application/x-www-form-urlencoded; charset=utf-8");
			КонецЕсли;
			
			ОбъектСоединения.setRequestHeader("X-Requested-With", "XMLHttpRequest");
			
			Для Каждого ТипПараметра Из ЗаголовкиЗапроса Цикл
				
				Если ЗначениеЗаполнено(ТипПараметра.Ключ) И ЗначениеЗаполнено(ТипПараметра.Значение) Тогда
					ОбъектСоединения.setRequestHeader(ТипПараметра.Ключ, ТипПараметра.Значение);
				КонецЕсли;	
				
			КонецЦикла;
			
			ЗафиксироватьСобытиеКоннектора("Попытка отправки запроса на сервер", "ОтправитьPostЗапрос");
			ЗаписьЖурналаРегистрации("DS_ЗамерВремени.ОтправкаЗапроса.Начало",,,ТекущаяУниверсальнаяДатаВМиллисекундах(),ПолныйАдресЗапроса);
			
			ОбъектСоединения.Send(СтрокаТелаЗапроса);
			
			Возврат ОбработатьОтветОтСервера(ОбъектСоединения);
			
		Иначе
			
			ЗаголовкиHTTPЗапроса = Новый Соответствие;
			ЗаголовкиHTTPЗапроса.Вставить("Accept-Language", "ru");
			ЗаголовкиHTTPЗапроса.Вставить("Accept-Charset","utf-8");
			ЗаголовкиHTTPЗапроса.Вставить("Content-Language", "ru");
			ЗаголовкиHTTPЗапроса.Вставить("Content-Charset", "utf-8");
			
			Если ЗаголовкиHTTPЗапроса.Получить("Content-type") = Неопределено Тогда
				ЗаголовкиHTTPЗапроса.Вставить("Content-type", "application/x-www-form-urlencoded; charset=utf-8");				
			КонецЕсли;
			
			ЗаголовкиHTTPЗапроса.Вставить("X-Requested-With", "XMLHttpRequest");
			
			Для Каждого ТипПараметра Из ЗаголовкиЗапроса Цикл
				ЗаголовкиHTTPЗапроса.Вставить(ТипПараметра.Ключ, ТипПараметра.Значение);	
			КонецЦикла;
			
			ЗапросHTTP = Новый HTTPЗапрос(СтруктураURI.ПутьНаСервере, ЗаголовкиHTTPЗапроса);
			
			ЗафиксироватьСобытиеКоннектора("Формируется запрос HTTP по адресу " + ПолныйАдресЗапроса, "ОтправитьPostЗапрос");
			
			ЗапросHTTP.УстановитьТелоИзСтроки(ТелоЗапроса, "utf-8", ИспользованиеByteOrderMark.НеИспользовать);
			
			ЗафиксироватьСобытиеКоннектора("Попытка отправки запроса на сервер", "ОтправитьPostЗапрос");
			ЗаписьЖурналаРегистрации("DS_ЗамерВремени.ОтправкаЗапроса.Начало",,, ТекущаяУниверсальнаяДатаВМиллисекундах(), ПолныйАдресЗапроса);
			
			Возврат ОбработатьОтветОтСервера(ОбъектСоединения.ВызватьHTTPМетод("POST", ЗапросHTTP) );
			
		КонецЕсли;
		
	Исключение
		
		ЗафиксироватьСобытиеКоннектора(ОписаниеОшибки(), "ОтправитьPostЗапрос");
		Возврат Новый Структура("Заголовки,Ответ,КодОтвета", "", ОписаниеОшибки() );
		
	КонецПопытки;
	
КонецФункции 

// Функция - Создать HTTPКоннектор
// 
// Возвращаемое значение:
// COM-объект  - СОМ-соединение с объектом WinHttpRequest
// HTTPСоединение - Встроенный объект для соединения по HTTP(S)
//
Функция СоздатьHTTPКоннектор(СтруктураURI)
	
	ЗафиксироватьСобытиеКоннектора("Вход в процедуру", "СоздатьHTTPКоннектор");
	HTTPСоединение = Неопределено;
	СисИнфо = Новый СистемнаяИнформация;
	
	Если Строка(Метаданные.РежимСовместимости) = "Версия8_2_16" ИЛИ
		
		Строка(Метаданные.РежимСовместимости) = "Версия8_2_13" Тогда
		РежимСовместимости82 = Ложь;
		
	Иначе
		РежимСовместимости82 = Ложь;
	КонецЕсли;
	
	Если Лев(СисИнфо.ВерсияПриложения, 3) = "8.2" ИЛИ РежимСовместимости82 Тогда
		
		ЗафиксироватьСобытиеКоннектора("Попытка создать объект WinHTTP", "СоздатьHTTPКоннектор");
		HTTPСоединение = Новый COMОбъект("WinHttp.WinHttpRequest.5.1");
		HTTPСоединение.Option(2,"utf-8");	
		ЗафиксироватьСобытиеКоннектора("Объект WinHTTP создан", "СоздатьHTTPКоннектор");	
		
	Иначе
		
		ЗафиксироватьСобытиеКоннектора("Попытка создать объект HTTPСоединение", "СоздатьHTTPКоннектор");
		ЭтоSSL = ?(СтруктураURI.Схема = "https", Истина, Ложь);
		
		Если ЭтоSSL Тогда
			СоединениеSSL = Новый ЗащищенноеСоединениеOpenSSL();
		Иначе
			СоединениеSSL = Неопределено;
		КонецЕсли;					
		
		HTTPСоединение = Новый HTTPСоединение(СтруктураURI.ИмяСервера,,,,,, СоединениеSSL);
		ЗафиксироватьСобытиеКоннектора("Объект HTTPСоединение создан", "СоздатьHTTPКоннектор");
		
	КонецЕсли;
	
	Возврат HTTPСоединение;

КонецФункции

// Функция - Структура URI
//
// Параметры:
//  СтрокаURI	 - Строка	 - Строка с путем, который нужно разобрать в структуру
// 
// Возвращаемое значение:
// Структура  - 
//
Функция СтруктураURI(Знач СтрокаURI)
	
	СтрокаURI = СокрЛП(СтрокаURI);
	
	// схема
	Схема = "";
	Позиция = Найти(СтрокаURI, "://");
	
	Если Позиция > 0 Тогда
		
		Схема = НРег(Лев(СтрокаURI, Позиция - 1));
		СтрокаURI = Сред(СтрокаURI, Позиция + 3);
		
	КонецЕсли;
	
	// строка соединения и путь на сервере
	СтрокаСоединения = СтрокаURI;
	ПутьНаСервере = "";
	Позиция = Найти(СтрокаСоединения, "/");
	
	Если Позиция > 0 Тогда
		
		ПутьНаСервере = Сред(СтрокаСоединения, Позиция + 1);
		СтрокаСоединения = Лев(СтрокаСоединения, Позиция - 1);
		
	КонецЕсли;
	
	// информация пользователя и имя сервера
	СтрокаАвторизации = "";
	ИмяСервера = СтрокаСоединения;
	Позиция = Найти(СтрокаСоединения, "@");
	
	Если Позиция > 0 Тогда
		
		СтрокаАвторизации = Лев(СтрокаСоединения, Позиция - 1);
		ИмяСервера = Сред(СтрокаСоединения, Позиция + 1);
		
	КонецЕсли;
	
	// логин и пароль
	СтрокаЛогинаПользователя = СтрокаАвторизации;
	СтрокаПароляПользователя = "";
	Позиция = Найти(СтрокаАвторизации, ":");
	
	Если Позиция > 0 Тогда
		
		СтрокаЛогинаПользователя = Лев(СтрокаАвторизации, Позиция - 1);
		СтрокаПароляПользователя = Сред(СтрокаАвторизации, Позиция + 1);
		
	КонецЕсли;
	
	// хост и порт
	Хост = ИмяСервера;
	Порт = "";
	Позиция = Найти(ИмяСервера, ":");
	
	Если Позиция > 0 Тогда
		
		Хост = Лев(ИмяСервера, Позиция - 1);
		Порт = Сред(ИмяСервера, Позиция + 1);
		
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Схема", Схема);
	Результат.Вставить("Login", СтрокаЛогинаПользователя);
	Результат.Вставить("Password", СтрокаПароляПользователя);
	Результат.Вставить("ИмяСервера", ИмяСервера);
	Результат.Вставить("Хост", Хост);
	Результат.Вставить("Порт", ?(Порт <> "", Число(Порт), Неопределено));
	Результат.Вставить("ПутьНаСервере", ПутьНаСервере);
	
	Возврат Результат;	

КонецФункции

// Функция - Обработать ответ от сервера
//
// Параметры:
//  ОбъектСоединения - COMОбъект, HTTPОтвет	 - Объект соединения с HTTP 
// 
// Возвращаемое значение:
// Структура  - Структура с данными Ответ и Заголовки 
//
Функция ОбработатьОтветОтСервера(ОбъектСоединения)
	
	ЗаписьЖурналаРегистрации("DS_ЗамерВремени.ОтправкаЗапроса.Конец",,, ТекущаяУниверсальнаяДатаВМиллисекундах() );
	ЗафиксироватьСобытиеКоннектора("Вход в процедуру", "ОбработатьОтветОтСервера");
	СтруктураОтвета = Новый Структура("Заголовки,КодОтвета,Ответ", "");
	
	Попытка
		
		Если ТипЗнч(ОбъектСоединения) = Тип("COMОбъект") Тогда
			
			СтрокаЗаголовковОтвета = ОбъектСоединения.getAllResponseHeaders();
			ЗафиксироватьСобытиеКоннектора("Заголовки от сервера: " + СтрокаЗаголовковОтвета, "ОбработатьОтветОтСервера");
			СоответствиеЗаголовков = Новый Соответствие;
			
			Для Индекс = 1 По СтрЧислоСтрок(СтрокаЗаголовковОтвета) Цикл
				
				СтрокаЗаголовка = СтрПолучитьСтроку(СтрокаЗаголовковОтвета, Индекс);
				Разделитель = Найти(СтрокаЗаголовка, ":");
				КлючЗаголовка = СокрЛП(Лев(СтрокаЗаголовка, Разделитель - 1) );
				ЗначениеЗаголовка = СокрЛП(Прав(СтрокаЗаголовка, СтрДлина(СтрокаЗаголовка) - Разделитель) );
				СоответствиеЗаголовков.Вставить(КлючЗаголовка, ЗначениеЗаголовка);
				
			КонецЦикла;
			
			ЗаголовокКонтента = СоответствиеЗаголовков.Получить("Content-Disposition");
			
			Если ЗаголовокКонтента <> Неопределено И Найти(ЗаголовокКонтента, "attach") Тогда //Это прикрепленный файл
				
				СтруктураОтвета.Ответ = СохранитьДвоичныйБуфер(ОбъектСоединения.ResponseBody);
				ЗафиксироватьСобытиеКоннектора("Ответ от сервера: Файл", "ОбработатьОтветОтСервера");
				
			Иначе
				
				СтруктураОтвета.Ответ = ОбъектСоединения.ResponseText();
				ЗафиксироватьСобытиеКоннектора("Ответ от сервера: " + СтруктураОтвета.Ответ, "ОбработатьОтветОтСервера");
				
			КонецЕсли;
			
			СтруктураОтвета.КодОтвета = 200;
			
		ИначеЕсли ТипЗнч(ОбъектСоединения) = Тип("HTTPОтвет") Тогда
			
			СоответствиеЗаголовков = ОбъектСоединения.Заголовки;
			СтрокаЗаголовка = "";
			
			Для Каждого ТипЗначения Из СоответствиеЗаголовков Цикл
				СтрокаЗаголовка = СтрокаЗаголовка + ТипЗначения.Ключ + ": " + ТипЗначения.Значение + Символы.ПС;	
			КонецЦикла;
			
			ЗафиксироватьСобытиеКоннектора("Заголовки от сервера: " + СтрокаЗаголовка, "ОбработатьОтветОтСервера");
			ЗаголовокКонтента = СоответствиеЗаголовков.Получить("Content-Disposition");
			
			Если ЗаголовокКонтента <> Неопределено И Найти(ЗаголовокКонтента, "attach") Тогда //Это прикрепленный файл
				
				СтруктураОтвета.Ответ = ОбъектСоединения.ПолучитьТелоКакДвоичныеДанные();
				ЗафиксироватьСобытиеКоннектора("Ответ от сервера: Файл", "ОбработатьОтветОтСервера");
				
			Иначе
				
				СтруктураОтвета.Ответ = ОбъектСоединения.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
				ЗафиксироватьСобытиеКоннектора("Ответ от сервера: " + СтруктураОтвета.Ответ, "ОбработатьОтветОтСервера");
				
			КонецЕсли;
			
		КонецЕсли;
		
		СтруктураОтвета.Заголовки = СоответствиеЗаголовков;
		
		Если ТипЗнч(ОбъектСоединения) = Тип("COMОбъект") Тогда
			СтруктураОтвета.КодОтвета = ОбъектСоединения.Status;
		Иначе
			СтруктураОтвета.КодОтвета = ОбъектСоединения.КодСостояния;
		КонецЕсли;
		
	Исключение
		ЗафиксироватьСобытиеКоннектора(ОписаниеОшибки(), "ОбработатьОтветОтСервера");	
	КонецПопытки;
	
	Возврат СтруктураОтвета;

КонецФункции

Функция СохранитьДвоичныйБуфер(Буфер)
	
	ИмяФайла = ПолучитьИмяВременногоФайла();
	
	Поток = Новый COMОбъект("ADODB.Stream");
	Поток.Type = 1;  //Бинарный
	Поток.Mode = 3; 
	Поток.Open();
	Поток.Write(Буфер);
	Поток.SaveToFile(ИмяФайла);
	Поток.Close();
	
	ДвоичныеДанные = Новый ДвоичныеДанные(ИмяФайла);
	УдалитьФайлы(ИмяФайла);
	
	Возврат ДвоичныеДанные;

КонецФункции

// Функция - Обмен HTTPJSON
//
// Параметры:
//  Адрес			 - Строка	 - Полный адрес отправки запроса
//  ЗаголовкиЗапроса - Соответствие	 - Соответствие заголовков запроса
//  POSTЗапрос		 - Булево	 - Признак отправки POST-запроса
//  ТелоЗапроса		 - Соответствие, Строка	 - Содержимое запроса, помещаемое в тело
// 
// Возвращаемое значение:
// Соответствие, Строка  - Возвращаемый ответ, полученный при парсинге JSON. В случае ошибки - текст ошибки
//
Функция ОбменHTTPJSON(Адрес, ЗаголовкиЗапроса, POSTЗапрос = Ложь, ТелоЗапроса = "")
	
	Результат = Неопределено;
	
	Если POSTЗапрос Тогда
		СтруктураОтвета = ОтправитьPostЗапрос(Адрес, ЗаголовкиЗапроса, ТелоЗапроса);
	Иначе
		СтруктураОтвета = ОтправитьGetЗапрос(Адрес, ЗаголовкиЗапроса);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураОтвета.Заголовки) И (СтруктураОтвета.КодОтвета <> 404 или СтруктураОтвета.КодОтвета <> 500) Тогда
		
		Попытка
			Результат = КНП_ПрочитатьJSONОтСервера(СтруктураОтвета.Ответ);	
		Исключение
			
			СообщитьОСобытииКоннектора(ИнформацияОбОшибке().Причина.Описание);
			Результат = "Не удалось разобрать ответ от сервера: " + СтруктураОтвета.Ответ;
			
		КонецПопытки;
		
	ИначеЕсли ЗначениеЗаполнено(СтруктураОтвета.Заголовки) Тогда
		
		Результат = "Ошибка " + СтруктураОтвета.КодОтвета;	
		СообщитьОСобытииКоннектора("Ошибка " + СтруктураОтвета.КодОтвета, "ОбменHTTPJSON");
		
	Иначе
		
		СообщитьОСобытииКоннектора("Не удалось подключиться к серверу " + Адрес, "ОбменHTTPJSON");
		Результат = "Не удалось подключиться к серверу";
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Процедура фиксации событий коннектора
// * Является интерфейсной прокладкой между коннектором и системой журналирования
//
// Параметры:
//  Событие		 - Строка	 - Текст события коннектора
//  ИмяМетода	 - Строка	 - Имя метода, вызвавшего событие
//
Процедура ЗафиксироватьСобытиеКоннектора(Событие, ИмяМетода = "", УровеньЖурналирования = 1)
	
	ДобавитьВЖурнал(Событие, ИмяМетода);	

КонецПроцедуры

Процедура СообщитьОСобытииКоннектора(Событие, ИмяМетода = "")
	
	ВывестиУведомлениеПользователю(Событие);

КонецПроцедуры

