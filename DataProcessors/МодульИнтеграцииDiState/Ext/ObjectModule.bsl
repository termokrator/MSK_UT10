Процедура ЛИЦ_СохранитьТокенВСистеме(Токен, ОрганизацияРегистрации)
	
	Попытка
		
		ПараметрИдентификатора = МОП_ПолучитьРеквизит("DS_Токен");
		НаборЗаписейЗначенияСвойств = МОП_ПолучитьНовыйНаборЗаписейДопСведений();
		НаборЗаписейЗначенияСвойств.Отбор.Объект.Установить(ОрганизацияРегистрации);
		НаборЗаписейЗначенияСвойств.Отбор.Свойство.Установить(ПараметрИдентификатора);
		НаборЗаписейЗначенияСвойств.Прочитать();
		
		Если НаборЗаписейЗначенияСвойств.Количество() = 0 Тогда
			Запись = НаборЗаписейЗначенияСвойств.Добавить();
		Иначе
			Запись = НаборЗаписейЗначенияСвойств[0];
		КонецЕсли; 
		
		Запись.Объект = ОрганизацияРегистрации;
		Запись.Свойство = ПараметрИдентификатора;
		Запись.Значение = Токен;
		НаборЗаписейЗначенияСвойств.Записать();
		ДобавитьВЖурнал("ПинКод привязан к организации " + Строка(ОрганизацияРегистрации), "СохранитьПинКодВСистеме");
		
	Исключение
		ДобавитьВЖурнал("Возникла ошибка " + ОписаниеОшибки(), "СохранитьПинКодВСистеме");
	КонецПопытки;

КонецПроцедуры

Функция ЛИЦ_ПрочитатьТокенВСистеме()
	
	Результат = "";
	ПараметрИдентификатора = МОП_ПолучитьРеквизит("DS_Токен");
	НаборЗаписейЗначенияСвойств = МОП_ПолучитьНовыйНаборЗаписейДопСведений();
	НаборЗаписейЗначенияСвойств.Отбор.Свойство.Установить(ПараметрИдентификатора);
	НаборЗаписейЗначенияСвойств.Прочитать();
	
	Если НаборЗаписейЗначенияСвойств.Количество() > 0 Тогда
		
		Запись = НаборЗаписейЗначенияСвойств[0];
		Результат = Запись.Значение;
		
	КонецЕсли;	
	
	Возврат Результат;

КонецФункции

Функция ЛИЦ_ПолучитьТокенЛицензии(ПинКод, ОрганизацияРегистрации)
	
	Заголовки = Новый Соответствие;
	СтруктураЗапроса = Новый Структура("pin,inn,ogrn,ibname");
	СтруктураЗапроса.pin = ПинКод;
	СтруктураЗапроса.inn = ОрганизацияРегистрации.ИНН;
	СтруктураЗапроса.ogrn = МОП_ПолучитьОГРНКонтрагента(ОрганизацияРегистрации); 
	СтруктураЗапроса.ibname = Метаданные.Синоним;
	ТелоЗапроса = КНП_ЗаписатьJSONНаСервере(СтруктураЗапроса);
	
	СтруктураВозврата = Новый Структура("Токен,ДатаДействия,ПричинаОшибки");
	Результат = ОбменHTTPJSON(АдресСервисаПоддержки + "lic/reg", Заголовки, Истина, ТелоЗапроса);
	
	Если ТипЗнч(Результат) = Тип("Строка") Тогда
		Возврат СтруктураВозврата;
	КонецЕсли;
	
	Если Результат <> Неопределено И Результат.Получить("success") = Истина Тогда
		
		ЛИЦ_СохранитьТокенВСистеме(Результат.Получить("token"), ОрганизацияРегистрации );
		СтруктураВозврата.Токен = Результат.Получить("token");
		СтруктураВозврата.ДатаДействия = КНП_ПривестиКДате(Результат.Получить("expiredAt") );
		
	ИначеЕсли Результат <> Неопределено И Результат.Получить("success") = Ложь Тогда
		СтруктураВозврата.ПричинаОшибки = Результат.Получить("reason");
	КонецЕсли;
	
	Возврат СтруктураВозврата;

КонецФункции

Функция ЛИЦ_ПроверитьТокенЛицензии() 
	
	СтруктураВозврата = Новый Структура("Токен,ДатаДействия");
	
	Если НЕ ИспользоватьЛицензирование Тогда
		
		СтруктураВозврата.Токен = "Некий токен";
		СтруктураВозврата.ДатаДействия = ТекущаяДата() + 86400 * 7; 
		
	Иначе
		
		СтруктураВозврата.Токен = ЛИЦ_ПрочитатьТокенВСистеме();
		СтруктураВозврата.ДатаДействия = ТекущаяДата() + 86400;
		
		Заголовки = Новый Соответствие;
		Заголовки.Вставить("token", СтруктураВозврата.Токен);
		Результат = ОбменHTTPJSON(АдресСервисаПоддержки + "lic/check", Заголовки, Истина, "");
		
		Если ТипЗнч(Результат) = Тип("Соответствие") Тогда
			СтруктураВозврата.ДатаДействия = КНП_ПривестиКДате(Результат.Получить("expiredAt") );
		ИначеЕсли Результат <> Неопределено Тогда
			СтруктураВозврата.Токен = "";
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СтруктураВозврата;

КонецФункции

Функция ЛИЦ_ПолучитьСписокДоступныхМодулей()
	//Changelog
	//
	//27.08.2019 - отключен запрос при отключенной системе лицензирования
	
	ТаблицаВозврата = ЛИЦ_ПолучитьТаблицуВозвратаСпискаМодулей();
	
	Если НЕ ИспользоватьЛицензирование Тогда
		Возврат ТаблицаВозврата;
	КонецЕсли;
	
	Заголовки = Новый Соответствие;
	Токен = ЛИЦ_ПрочитатьТокенВСистеме();
	Заголовки.Вставить("token", Токен);
	Результат = ОбменHTTPJSON(АдресСервисаПоддержки + "techsupp/modules/list?branchName=" + ВеткаРазработки + "&releaseDate=" + ДатаРелиза, Заголовки);
	
	Если ТипЗнч(Результат) = Тип("Соответствие") И Результат.Получить("success") = Истина Тогда
		
		МассивРезультатов = Результат.Получить("releases");
		
		Если ТипЗнч(МассивРезультатов) = Тип("Массив") Тогда
			
			Для Каждого ЭлементМассива Из МассивРезультатов Цикл
				
				СтрТаблицы = ТаблицаВозврата.Добавить();
				СтрТаблицы.ИмяВерсии = ЭлементМассива.Получить("releaseName");
				СтрТаблицы.ДатаРелиза = КНП_ПривестиКДате(ЭлементМассива.Получить("releaseDate") );
				СтрТаблицы.ХешСумма = ЭлементМассива.Получить("releaseHash");
				
			КонецЦикла;
			
		Иначе
			ДобавитьВЖурнал("Не определен ответ с сервера лицензирования", "ПолучитьСписокДоступныхМодулей()");
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Результат) = Тип("Соответствие") И  Результат.Получить("success") = Ложь Тогда
		ДобавитьВЖурнал(Результат.Получить("reason"), "ПолучитьСписокДоступныхМодулей()"); 	
	Иначе
	КонецЕсли;
	
	Возврат ТаблицаВозврата;	

КонецФункции

Функция ЛИЦ_ПолучитьНовуюВерсиюМодуля(ХешЗначение) 
	
	Заголовки = Новый Соответствие;
	Токен = ЛИЦ_ПрочитатьТокенВСистеме();
	Заголовки.Вставить("token", Токен);
	Результат = ОбменHTTPJSON(АдресСервисаПоддержки + "techsupp/modules/get?hash=" + ХешЗначение, Заголовки);
	
	ДанныеВозврата = Неопределено;
	
	Если ТипЗнч(Результат) = Тип("Соответствие") И Результат.Получить("success") = Истина Тогда
		
		ДанныеВBase64 = Результат.Получить("data");
		
		Попытка
			ДанныеВозврата = Base64Значение(ДанныеВBase64);
		Исключение
		КонецПопытки;
		
	ИначеЕсли ТипЗнч(Результат) = Тип("Соответствие") И  Результат.Получить("success") = Ложь Тогда
		ДобавитьВЖурнал(Результат.Получить("reason"), "ПолучитьНовуюВерсиюМодуля()"); 	
	Иначе
	КонецЕсли;
	
	Возврат ДанныеВозврата;	

КонецФункции

Функция ЛИЦ_ПолучитьТаблицуВозвратаСпискаМодулей()
	
	ТаблицаВозврата = Новый ТаблицаЗначений;
	ТаблицаВозврата.Колонки.Добавить("ИмяВерсии");
	ТаблицаВозврата.Колонки.Добавить("ДатаРелиза");
	ТаблицаВозврата.Колонки.Добавить("ХешСумма");
	Возврат ТаблицаВозврата;

КонецФункции

Функция ЛИЦ_ПолучитьДатуРелиза()
	
	Возврат ДатаРелиза;	

КонецФункции

Функция ЛИЦ_ЛицензияДействительна()
	
	Если НЕ ИспользоватьЛицензирование Тогда
		Возврат Истина;
	КонецЕсли;
	
	СтруктураДанных = ЛИЦ_ПроверитьТокенЛицензии();
	
	Если ЗначениеЗаполнено(СтруктураДанных.Токен) И СтруктураДанных.ДатаДействия > ТекущаяДата() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции

