Функция ФОД_ПолучитьАкцизРост(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	
	ЗначениеПосле 	= ФОД_ПолучитьАкцизТовара(ВерсияЗаполнения, ОбъектЗаполнения);
	ЗначениеДо 		= ФОД_ПолучитьАкцизДо(ВерсияЗаполнения, ОбъектЗаполнения);
	
	Попытка
		
		Если ЗначениеПосле >= ЗначениеДо Тогда
			Возврат ЗначениеПосле - ЗначениеДо;
		Иначе
			Возврат Неопределено;
		КонецЕсли;	
		
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

