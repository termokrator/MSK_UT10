Функция МОП_НДСВСуммеПоСтавке(СтавкаНДС)
	
	Если Метаданные.Справочники.Найти("СтавкиНДС") <> Неопределено Тогда
		
		Если КНП_ЕстьРеквизит(СтавкаНДС, "Расчетная") Тогда
			Возврат СтавкаНДС.Расчетная;	
		КонецЕсли;
		
	ИначеЕсли Метаданные.Перечисления.Найти("СтавкиНДС") <> Неопределено Тогда
		
		Если 
			СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС10_110") 
			ИЛИ
			СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС18_118")
			ИЛИ
			СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20_120") 
			ИЛИ
			СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20")
			//+Гавриленков В. 11.12.2025 #UT10-5574
			ИЛИ
			СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС22")
			ИЛИ 
			СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС22_122")
			//-Гавриленков В. 11.12.2025 #UT10-5574
			Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции

