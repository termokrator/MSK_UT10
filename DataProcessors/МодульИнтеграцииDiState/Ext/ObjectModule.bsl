//		Методы чтения данных
Функция МОП_ПолучитьМенеджераДопСведений()
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Метаданные.ПланыВидовХарактеристик.Найти("ДополнительныеРеквизитыИСведения") <> Неопределено Тогда
		МенеджерДопСведений = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения;	
	Иначе
		МенеджерДопСведений = ПланыВидовХарактеристик.СвойстваОбъектов;
	КонецЕсли;	
	
	УстановитьПривилегированныйРежим(Ложь);
	Возврат МенеджерДопСведений;

КонецФункции

// Получение набора записей доп.сведений для дальнейшей манипуляции
// *Поддержка БП 3.0, УТ 11, КА 2.4, БП 2.0, УТ 10.3, КА 1.1, УПП 1.3
// 
// Возвращаемое значение:
// РегистрыСведенийНаборЗаписей  - набор записей
//
Функция МОП_ПолучитьНовыйНаборЗаписейДопСведений()
	
	НаборЗаписейЗначенияСвойств = Неопределено; 
	УстановитьПривилегированныйРежим(Истина);
	
	Если Метаданные.ПланыВидовХарактеристик.Найти("ДополнительныеРеквизитыИСведения") <> Неопределено Тогда
		Выполнить("НаборЗаписейЗначенияСвойств = РегистрыСведений.ДополнительныеСведения.СоздатьНаборЗаписей();	");
	Иначе
		Выполнить("НаборЗаписейЗначенияСвойств = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей(); ");	
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	Возврат НаборЗаписейЗначенияСвойств;

КонецФункции

// Функция - Получить реквизит
// *Поддержка БП 3.0, УТ 11, КА 2.4, БП 2.0, УТ 10.3, КА 1.1, УПП 1.3
//
// Параметры:
//  ИмяРеквизита - Строка	 - Название доп.реквизита DiState. Варианты:
//	*DS_Контрагент_ID
//	*DS_Подразделение_ID
//	*DS_Документ_ID
//	*DS_ДатаВремяОтправки
//  *DS_ПинКод
// 
// Возвращаемое значение:
// ПланыВидовХарактеристикСсылка  - Ссылка на свойство доп.реквизита
//
Функция МОП_ПолучитьРеквизит(ИмяРеквизита)
	
	УстановитьПривилегированныйРежим(Истина);
	ВозвращаемоеЗначение = Неопределено;
	
	Если Метаданные.ПланыВидовХарактеристик.Найти("ДополнительныеРеквизитыИСведения") <> Неопределено Тогда
		ВозвращаемоеЗначение = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию(ИмяРеквизита);	
	Иначе
		ВозвращаемоеЗначение = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию(ИмяРеквизита);
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	Возврат ВозвращаемоеЗначение;

КонецФункции

Функция МОП_ПолучитьСсылкуНаКорректировку(ДокументСсылка)
	
	Если ЗначениеЗаполнено(ДокументСсылка) Тогда
		
		Если КНП_ЕстьРеквизит(ДокументСсылка, "ДокументРеализации") И ЗначениеЗаполнено(ДокументСсылка.ДокументРеализации) Тогда
			Возврат ДокументСсылка.ДокументРеализации;
		КонецЕсли;
		
		Если КНП_ЕстьРеквизит(ДокументСсылка, "ДокументОснование") И ЗначениеЗаполнено(ДокументСсылка.ДокументОснование) Тогда
			Возврат ДокументСсылка.ДокументОснование;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Неопределено;

КонецФункции

// Получить валюту документа (метаданно-ориентированный метод)
//
// Параметры:
//  ДокОбъект	 - ДокументСсылка, ДокументОбъект	 - Ссылка или сам объект документа
// 
// Возвращаемое значение:
// СправочникСсылка, Неопределено  - Валюта документа 
//
Функция МОП_ПолучитьВалютуДокумента(ДокОбъект)
	
	Валюта = Неопределено;
	
	Если КНП_ЕстьРеквизит(ДокОбъект, "ВалютаДокумента") Тогда
		Валюта = ДокОбъект.ВалютаДокумента;
	ИначеЕсли КНП_ЕстьРеквизит(ДокОбъект, "Валюта") Тогда
		Валюта = ДокОбъект.Валюта;
	ИначеЕсли КНП_ЕстьРеквизит(ДокОбъект, "ВалютаВзаиморасчетов") Тогда
		Валюта = ДокОбъект.ВалютаВзаиморасчетов;
	КонецЕсли;
	
	Если Валюта = Неопределено И НЕ МОП_ЭтоДоговор(ДокОбъект) Тогда
		
		ДокОснование = МОП_ПолучитьОснованиеДокумента(ДокОбъект);
		
		Если ЗначениеЗаполнено(ДокОснование) И ДокОснование <> ДокОбъект Тогда
			Валюта = МОП_ПолучитьВалютуДокумента(ДокОснование);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Валюта;	

КонецФункции

Функция МОП_ПолучитьВалютуДоговораДокумента(ДокОбъект)
	
	Валюта = Неопределено;
	Договор = МОП_ПолучитьДоговорПоДокументу(ДокОбъект);
	
	Если ЗначениеЗаполнено(Договор) Тогда
		
		ОплатаВВалюте = МОП_ПолучитьПризнакОплатаВВалютеПоДоговору(Договор);
		
		Если НЕ ОплатаВВалюте Тогда
			
			Валюта = МОП_ПолучитьВалютуПоКоду("643");
			Возврат Валюта;
			
		КонецЕсли;
		
		Валюта = МОП_ПолучитьВалютуДокумента(Договор);
		
		Если НЕ ЗначениеЗаполнено(Валюта) Тогда
			
			Если КНП_ЕстьРеквизит(ДокОбъект, "ВалютаДокумента") Тогда
				Валюта = ДокОбъект.ВалютаДокумента;
			ИначеЕсли КНП_ЕстьРеквизит(ДокОбъект, "Валюта") Тогда
				Валюта = ДокОбъект.Валюта;
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли КНП_ЕстьРеквизит(ДокОбъект, "ВалютаДокумента") Тогда
		Валюта = ДокОбъект.ВалютаДокумента;
	ИначеЕсли КНП_ЕстьРеквизит(ДокОбъект, "Валюта") Тогда
		Валюта = ДокОбъект.Валюта;
	КонецЕсли;
	
	Возврат Валюта;

КонецФункции

// Получить структуру ответственного лица гл.буха. Если его нет - то ответственного за ЭДО
// *Поддержка БП 3.0, УТ 11, КА 2.4, БП 2.0, УТ 10.3, КА 1.1, УПП 1.3
// 
// Возвращаемое значение:
// Структура  - Структура с полями Фамилия, Имя, Отчество, Должность 
//
Функция МОП_ПолучитьСтруктуруОтветственногоЛицаГлБуха()
	
	ТекКонф = КНП_ИмяКонфигурации();
	ФизЛицо = Неопределено;
	ГлавБух = ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер");
	
	Если НЕ ЗначениеЗаполнено(ГлавБух) Тогда
		ГлавБух = ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизации.ГлавныйБухгалтер");
	КонецЕсли;
	
	ФизЛицо = КЗП_ПолучитьОтветственноеЛицо(ГлавБух);
	
	Если ЗначениеЗаполнено(ФизЛицо) Тогда
		Возврат МОП_СформироватьСтруктуруОтветственныеЛицаОрганизации(ФизЛицо);
	КонецЕсли;
	
	Возврат МОП_СформироватьСтруктуруОтветственныеЛицаОрганизации();

КонецФункции

// Получить идентификатор гос контракта
// *Поддержка БП 3.0, УТ 11, КА 2.4, БП 2.0, УТ 10.3, КА 1.1, УПП 1.3
//
// Параметры:
//  СсылкаНаРеализацию	 - ДокументСсылка	 - Ссылка на документ основания счет-фактуры
// 
// Возвращаемое значение:
// Строка  - Значение идентификатора гос.контракта. Если такого поля нет в СФ - то пустая строка
//
Функция МОП_ПолучитьИдентификаторГосКонтракта(СсылкаНаРеализацию)
	
	Запрос = Новый Запрос;
	ТекКонф = КНП_ИмяКонфигурации();
	Запрос.УстановитьПараметр("ДокументОснование", СсылкаНаРеализацию);
	
	Если КНП_ЕстьОбъектМетаданных("СчетФактураВыданный") Тогда
		
		Запрос.Текст =
		"ВЫБРАТЬ                                                                                                                                   
		|	СчетФактураВыданный.ИдентификаторГосКонтракта
		|ИЗ
		|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
		|ГДЕ
		|	СчетФактураВыданный.ДокументОснование = &ДокументОснование";
		
		Если НЕ КНП_ЕстьРеквизит(Документы.СчетФактураВыданный.ПустаяСсылка(), "ИдентификаторГосКонтракта") Тогда
			Возврат "";
		КонецЕсли;
		
	КонецЕсли;
	
	Если КНП_ЕстьОбъектМетаданных("СчетФактура") Тогда
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	СчетФактураДокументыОснования.Ссылка.ИдентификаторГосКонтракта КАК ИдентификаторГосКонтракта
		|ИЗ
		|	Документ.СчетФактура.ДокументыОснования КАК СчетФактураДокументыОснования
		|ГДЕ
		|	СчетФактураДокументыОснования.ДокументОснование = &ДокументОснование";
		
		Если НЕ КНП_ЕстьРеквизит(Документы.СчетФактура.ПустаяСсылка(), "ИдентификаторГосКонтракта") Тогда
			Возврат "";
		КонецЕсли;
		
	КонецЕсли;
	
	Попытка
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Возврат Выборка.ИдентификаторГосКонтракта;
		КонецЕсли;                                
		
	Исключение
		ДобавитьВЖурнал(ОписаниеОшибки(), "ПолучитьИдентификаторГосКонтракта");
	КонецПопытки;                                       
	
	Возврат "";

КонецФункции

Функция МОП_ПолучитьВидКИЮрАдреса(Владелец, ТекКонф)
	
	Если ТипЗнч(Владелец) = Тип("СправочникСсылка.Организации") Тогда
		Возврат Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации;	
	ИначеЕсли ТипЗнч(Владелец) = Тип("СправочникСсылка.Контрагенты") Тогда
		
		Попытка
			Возврат Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента;
		Исключение КонецПопытки;
		
		Попытка
			Возврат Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты;
		Исключение КонецПопытки;
		
		Возврат Справочники.ВидыКонтактнойИнформации.ПустаяСсылка();
		
	КонецЕсли;
	
	ДобавитьВЖурнал("Неподдерживаемая конфигурация " + ТекКонф, "МОП_ПолучитьВидКИЮрАдреса");
	Возврат Неопределено;		

КонецФункции

