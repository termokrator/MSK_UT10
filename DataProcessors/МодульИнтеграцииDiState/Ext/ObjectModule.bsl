Функция МОП_СоздатьБанк(БИК, ПолноеНаименование, СокрНаименование, КоррСчет = Неопределено)
	
	СправочникМенеджер = Неопределено;
	
	Если КНП_ЕстьОбъектМетаданных("Банки") Тогда
		СправочникМенеджер = Справочники.Банки;
	ИначеЕсли КНП_ЕстьОбъектМетаданных("КлассификаторБанков") Тогда
		СправочникМенеджер = Справочники.КлассификаторБанков;
	ИначеЕсли КНП_ЕстьОбъектМетаданных("КлассификаторБанковРФ") Тогда
		СправочникМенеджер = Справочники.КлассификаторБанковРФ;
	КонецЕсли;
	
	Если СправочникМенеджер = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка	
		
		ЭлементБанка = СправочникМенеджер.СоздатьЭлемент();
		ЭлементБанка.Код = БИК;
		ЭлементБанка.Наименование = ПолноеНаименование;
		
		Если НЕ ЗначениеЗаполнено(ЭлементБанка.Наименование) Тогда
			ЭлементБанка.Наименование = СокрЛП(СокрНаименование);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(КоррСчет) И КНП_ЕстьРеквизит(ЭлементБанка, "КоррСчет") Тогда
			ЭлементБанка.КоррСчет = КоррСчет;
		КонецЕсли;
		
		ЭлементБанка.Записать();
	Исключение
		
		ДобавитьВЖурнал(ОписаниеОшибки(), "МОП_СоздатьБанк");
		Возврат СправочникМенеджер.ПустаяСсылка();
		
	КонецПопытки;
	
	Возврат ЭлементБанка.Ссылка;
	
КонецФункции

Функция МОП_СоздатьЕдиницуИзмерения(КодОКЕИ, Название, СокрНазвание)
	
	СправочникМенеджер = Неопределено;
	
	Если КНП_ЕстьОбъектМетаданных("КлассификаторЕдиницИзмерения") Тогда
		СправочникМенеджер = Справочники.КлассификаторЕдиницИзмерения;
	ИначеЕсли КНП_ЕстьОбъектМетаданных("УпаковкиЕдиницыИзмерения") Тогда
		СправочникМенеджер = Справочники.УпаковкиЕдиницыИзмерения;
	КонецЕсли;
	
	Если СправочникМенеджер = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СокрНазвание) Тогда
		Возврат СправочникМенеджер.ПустаяСсылка();
	КонецЕсли;
	
	Попытка	
		
		ЭлементСправочника = СправочникМенеджер.СоздатьЭлемент();
		ЭлементСправочника.Код = КодОКЕИ;
		ЭлементСправочника.Наименование = СокрНазвание;
		
		Если КНП_ЕстьРеквизит(ЭлементСправочника, "НаименованиеПолное") Тогда
			ЭлементСправочника.НаименованиеПолное = Название;
		Иначе
			ЭлементСправочника.Наименование = Название;
		КонецЕсли;                                      
		
		ЭлементСправочника.Записать();
		
	Исключение
		
		ДобавитьВЖурнал(ОписаниеОшибки(), "МОП_СоздатьЕдиницуИзмерения");
		Возврат СправочникМенеджер.ПустаяСсылка();
		
	КонецПопытки;
	
	Возврат ЭлементСправочника.Ссылка;
	
КонецФункции

