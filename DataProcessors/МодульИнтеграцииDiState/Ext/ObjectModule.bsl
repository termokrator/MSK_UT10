		ДопРеквизитХранилищеСтатьиРасходов 				= МенеджерДопСведений.СоздатьЭлемент();
		ДопРеквизитХранилищеСтатьиРасходов.Наименование 	= "DS_СопоставлениеСтатейРасходов";
		
		Если ДопРеквизитХранилищеСтатьиРасходов.Метаданные().Реквизиты.Найти("Заголовок") <> Неопределено Тогда
			ДопРеквизитХранилищеСтатьиРасходов.Заголовок 	= "DS_СопоставлениеСтатейРасходов";	
		КонецЕсли;
		
		ДопРеквизитХранилищеСтатьиРасходов.ТипЗначения 	= Новый ОписаниеТипов("СправочникСсылка.ЗначенияСвойствОбъектов" );
		ДопРеквизитХранилищеСтатьиРасходов.ОбменДанными.Загрузка = Истина;
		ДопРеквизитХранилищеСтатьиРасходов.Записать();
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Функция КНП_РазобратьСтрокуВМассивСтруктур(Знач СтрокаДанных)
	
	/////////////
	//Разделителем строк является символ ;
	//Разделителем элементов является символ ,
	//Данные должны быть записаны в формате <ключ>=<значение>
	МассивДанных = СтрЗаменить(СтрокаДанных, ";", Символы.ПС);
	МассивСтрокТаблицы = Новый Массив;
	КоличествоСтрок = СтрЧислоСтрок(МассивДанных);
	
	Для Индекс = 1 По КоличествоСтрок Цикл
		
		СтруктураЭлементов = Новый Структура;
		СтрокаМассиваДанных = СтрПолучитьСтроку(МассивДанных, Индекс);
		МассивЭлементов = СтрЗаменить(СтрокаМассиваДанных, ",", Символы.ПС);
		
		Для НомерЭлемента = 1 По СтрЧислоСтрок(МассивЭлементов) Цикл
			
			СтрокаЭлемента = СтрПолучитьСтроку(МассивЭлементов, НомерЭлемента); 
			Разделитель = Найти(СтрокаЭлемента, "=");
			СтруктураЭлементов.Вставить(Лев(СтрокаЭлемента, Разделитель - 1), Сред(СтрокаЭлемента, Разделитель + 1) );
			
		КонецЦикла;
		
		МассивСтрокТаблицы.Добавить(СтруктураЭлементов);
		
	КонецЦикла;
	
	Возврат МассивСтрокТаблицы;

КонецФункции

