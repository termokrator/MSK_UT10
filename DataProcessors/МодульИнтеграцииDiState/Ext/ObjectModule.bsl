Функция ФОД_ПолучитьКорректируемуюСчетФактуру(Знач ОбъектЗаполнения)
	
	Если КНП_ЕстьРеквизит(ОбъектЗаполнения, "ИсправляемыйСчетФактура") Тогда
		Возврат ОбъектЗаполнения.ИсправляемыйСчетФактура;
	КонецЕсли;
	
	Если КНП_ЕстьРеквизит(ОбъектЗаполнения, "СчетФактураОснование") Тогда
		
		Если ЗначениеЗаполнено(ОбъектЗаполнения.СчетФактураОснование) Тогда
			Возврат ОбъектЗаполнения.СчетФактураОснование;
		Иначе

			Для каждого Стр ИЗ ОбъектЗаполнения.ДокументыОснования Цикл
				
				Если ЗначениеЗаполнено(Стр.ИсходныйДокумент) И ТипЗнч(Стр.ИсходныйДокумент) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
					Возврат Стр.ИсходныйДокумент;
				КонецЕсли;
				
			КонецЦикла;

		КонецЕсли;
		
	КонецЕсли;

КонецФункции

Функция ФОД_ПолучитьКорректируемыйТовар(Знач ОбъектЗаполнения)
	
	МассивСтруктур = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(ОбъектЗаполнения) Тогда
		Возврат МассивСтруктур;
	КонецЕсли;
	
	Если МОП_ЭтоКорректировкаРеализации(ОбъектЗаполнения) Тогда
		
		//+Доработка: загрузка кодов маркировки для УКД
		Если Константы.ЭДО_ВыгружатьКодыМаркировки.Получить() 
			И Перечисления.УсловияРаботыСЧЗ.УсловиеВыгрузкиЧЗВЭДО(ОбъектЗаполнения.ДоговорКонтрагента.УсловияРаботыСЧЗ) Тогда
			БуферКодовМаркировкиТоваров = Справочники.ШтрихкодыНоменклатуры.ПолучитьКодыМаркировкиПоДокументу(ОбъектЗаполнения);
		Иначе
			БуферКодовМаркировкиТоваров.Очистить();
		КонецЕсли;
		//-Доработка: загрузка кодов маркировки для УКД
		
		ТаблицаТоваров = МОП_ПолучитьСтруктуруТаблицыКорректировкиТоваров(ОбъектЗаполнения);
		ФиксированнаяСтруктураДанных = КНП_СтруктураНаОснованииКолонокТЧ(ТаблицаТоваров);
		
		Для Каждого Товар Из ТаблицаТоваров Цикл
			
			СтруктураДанных = Новый Структура(ФиксированнаяСтруктураДанных);
			ЗаполнитьЗначенияСвойств(СтруктураДанных, Товар);
			СтруктураДанных.Вставить("Ссылка", ОбъектЗаполнения);
			МассивСтруктур.Добавить(СтруктураДанных);
			
		КонецЦикла;		
		
	КонецЕсли;
	
	Если МОП_ЭтоСчетФактура(ОбъектЗаполнения) ИЛИ МОП_ЭтоСчетНаОплату(ОбъектЗаполнения) Тогда
		
		ОснованиеОбъектаЗаполнения = МОП_ПолучитьОснованиеДокумента(ОбъектЗаполнения);
		
		Если ЗначениеЗаполнено(ОснованиеОбъектаЗаполнения) 
			И МОП_ЭтоКорректировкаРеализации(ОснованиеОбъектаЗаполнения) Тогда
			МассивСтруктур = ФОД_ПолучитьКорректируемыйТовар(ОснованиеОбъектаЗаполнения);
			
		Иначе //Предположительно это авансовая СФ
			
			Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "Авансы") Тогда
				
				ФиксированнаяСтруктураДанных = КНП_СтруктураНаОснованииКолонокТЧ(ОбъектЗаполнения.Авансы);
				
				Для Каждого Товар Из ОбъектЗаполнения.Авансы Цикл
					
					СтруктураДанных = Новый Структура(ФиксированнаяСтруктураДанных);
					ЗаполнитьЗначенияСвойств(СтруктураДанных, Товар);
					СтруктураДанных.Вставить("Ссылка", ОбъектЗаполнения);
					МассивСтруктур.Добавить(СтруктураДанных);
					
				КонецЦикла;		
				
			КонецЕсли;		
			
		КонецЕсли;
		
	КонецЕсли;
	
	
	Возврат МассивСтруктур;	

КонецФункции

