Функция КНП_ОбновитьРеквизитыЭлементСправочника(СтруктураДанных, СсылкаНаЭлемент)
	
	ОбъектСправочника = СсылкаНаЭлемент.ПолучитьОбъект();
	
	Для Каждого Элемент Из СтруктураДанных Цикл
		
		Если КНП_ЕстьРеквизит(ОбъектСправочника, Элемент.Ключ) ИЛИ Элемент.Ключ = "Наименование" Тогда
			
			Попытка
				Выполнить("ОбъектСправочника." + Элемент.Ключ + " = Элемент.Значение");	
			Исключение		
			КонецПопытки;
			
		КонецЕсли;
		
		Если Элемент.Ключ = "ОГРН" И КНП_ЕстьРеквизит(ОбъектСправочника, "РегистрационныйНомер") Тогда
			
			Попытка
				Выполнить("ОбъектСправочника.РегистрационныйНомер = Элемент.Значение");	
			Исключение		
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Попытка
		
		ОбъектСправочника.Записать();
		Возврат Истина;
		
	Исключение
		
		ВывестиУведомлениеПользователю(ОписаниеОшибки() );
		Возврат Ложь;
		
	КонецПопытки;

КонецФункции

