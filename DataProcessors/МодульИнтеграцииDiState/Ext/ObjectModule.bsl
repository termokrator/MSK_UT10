Функция ЭДО_СинхронизацияКонтрагентов(ПолнаяЗагрузка = Ложь);
	
	ТаблицаДанных = СправочникКонтрагенты.Выгрузить();
	ТаблицаДанных.Очистить();
	
	ДанныеЭДО = API_ПолучитьСписокКонтрагентов(ПолнаяЗагрузка);
	ЗаписатьЖурналВФайл();
	ТаблицаКонтрагентов = РС_ПолучитьСписокОбъектовСИдентификаторами("Контрагент");
	ТаблицаКонтрагентов.Очистить();  
	ТаблицаПодразделений = РС_ПолучитьСписокОбъектовСИдентификаторами("Подразделение");
	ТаблицаПодразделений.Очистить(); 
	ЗаписатьЖурналВФайл();
	
	Итер = 0;
	
	Для Каждого ЭлементМассива Из ДанныеЭДО Цикл
		
		Итер = Итер + 1;
		ДобавитьВЖурналОтладочнуюИнформацию("Анализ элемента №" + Итер, "ЭДО_СинхронизацияКонтрагентов");
		
		Попытка
			
			ИД 				= ЭлементМассива.Получить("divisionId");
			Наименование	= ЭлементМассива.Получить("name");
			ИНН				= ЭлементМассива.Получить("inn");
			ОГРН			= ЭлементМассива.Получить("ogrn");
			КПП				= ЭлементМассива.Получить("kpp");
			ИДПодразделения = ЭлементМассива.Получить("divisionId");
			НазваниеПодразд = ЭлементМассива.Получить("title");
			Статус			= ЭлементМассива.Получить("relation");
			
			Если Статус <> Неопределено Тогда
				Статус = Статус.Получить("statusName");	
			КонецЕсли;
			
			ДобавитьВЖурналОтладочнуюИнформацию("Анализ элемента №" + Итер + ": получены значения", "ЭДО_СинхронизацияКонтрагентов");
			
			
			МассивПодразделений = ЭлементМассива.Получить("divisions");
			
			Если МассивПодразделений = Неопределено Тогда
				
				ДобавитьВЖурналОтладочнуюИнформацию("Добавление элемента №" + Итер + " в список", "ЭДО_СинхронизацияКонтрагентов");
				
				НоваяСтрока = ТаблицаДанных.Добавить();
				НоваяСтрока.ИНН = ИНН;
				НоваяСтрока.КПП = КПП;
				НоваяСтрока.ОГРН = ОГРН;
				НоваяСтрока.Название = Наименование + " (" + НазваниеПодразд + ")";
				НоваяСтрока.ИдентификаторКомпании = КНП_ЧислоБезГруппВВидеСтроки(ИД);
				НоваяСтрока.ИдентификаторПодразделения = КНП_ЧислоБезГруппВВидеСтроки(ИДПодразделения);
				
				ДобавитьВЖурналОтладочнуюИнформацию("Поиск элемента №" + Итер + " по идентификатору", "ЭДО_СинхронизацияКонтрагентов");
				
				СтрокаТаблицыКонтрагентов = ТаблицаКонтрагентов.Найти(НоваяСтрока.ИдентификаторКомпании, "Значение");
				
				Если СтрокаТаблицыКонтрагентов = Неопределено Тогда
					
					ДобавитьВЖурналОтладочнуюИнформацию("Поиск элемента №" + Итер + ": не нашли по идентификатору", "ЭДО_СинхронизацияКонтрагентов");
					НоваяСтрока.Ссылка = ПолучитьКонтагентаПартнераПоИдентификатору(НоваяСтрока.ИдентификаторКомпании, НоваяСтрока.ИдентификаторПодразделения); 

					Если НоваяСтрока.Ссылка = Неопределено ИЛИ НоваяСтрока.Ссылка.Пустая() Тогда
						Продолжить;
					КонецЕсли;
					
				Иначе
					НоваяСтрока.Ссылка = СтрокаТаблицыКонтрагентов.Объект;
				КонецЕсли;
				
				НоваяСтрока.НазваниеПодразделения = НазваниеПодразд;
				
				Если ВерсияAPI = "v1.3" Тогда
					НоваяСтрока.СтатусВзаимодействия = Статус;	
				КонецЕсли;
				
				Если ЗначениеЗаполнено(НоваяСтрока.ИдентификаторПодразделения) Тогда
					
					СтрокаТаблицыПодразделений = ТаблицаПодразделений.Найти(НоваяСтрока.ИдентификаторПодразделения, "Значение");
					
					Если СтрокаТаблицыПодразделений = Неопределено Тогда
						РС_ПривязатьИдентификаторПодразделенияВ1С(НоваяСтрока.Ссылка, НоваяСтрока.ИдентификаторПодразделения);
					КонецЕсли;
					
				КонецЕсли;
				
			Иначе
				
				ДобавитьВЖурналОтладочнуюИнформацию("Найдены подразделения у элемента №" + Итер, "ЭДО_СинхронизацияКонтрагентов");
				
				Для Каждого Подразделение Из МассивПодразделений Цикл
					
					ДобавитьВЖурналОтладочнуюИнформацию("Добавление подразделения элемента №" + Итер + " в список", "ЭДО_СинхронизацияКонтрагентов");
					
					НоваяСтрока = ТаблицаДанных.Добавить();
					НоваяСтрока.ИНН = ИНН;
					НоваяСтрока.КПП = Подразделение.Получить("kpp");
					НоваяСтрока.ОГРН = ОГРН;
					
					Если Подразделение.Получить("title") <> Неопределено Тогда
						НоваяСтрока.Название = Наименование + " (" + Подразделение.Получить("title") + ")";
					Иначе
						
						ДобавитьВЖурнал("Не заполнено название подразделения у организации с ID = " + ИД, "API_ПолучитьСписокКонтрагентов");	
						
						Попытка
							НоваяСтрока.Название = Наименование + " (Ошибка! Не заполнен титул подразделения!)";
						Исключение
						КонецПопытки;
						
					КонецЕсли;
					
					НоваяСтрока.ИдентификаторКомпании = КНП_ЧислоБезГруппВВидеСтроки(ИД);
					НоваяСтрока.ИдентификаторПодразделения = КНП_ЧислоБезГруппВВидеСтроки(Подразделение.Получить("id"));
					НоваяСтрока.НазваниеПодразделения = Подразделение.Получить("title");
					
					Если ВерсияAPI = "v1.3" Тогда
						НоваяСтрока.СтатусВзаимодействия = Статус;	
					КонецЕсли;
					
					ДобавитьВЖурналОтладочнуюИнформацию("Поиск элемента №" + Итер + " по идентификатору", "ЭДО_СинхронизацияКонтрагентов");
					СтрокаТаблицыКонтрагентов = ТаблицаКонтрагентов.Найти(НоваяСтрока.ИдентификаторКомпании, "Значение");
					
					Если СтрокаТаблицыКонтрагентов = Неопределено Тогда
						
						ДобавитьВЖурналОтладочнуюИнформацию("Поиск подразделения элемента №" + Итер + ": не нашли по идентификатору", "ЭДО_СинхронизацияКонтрагентов");
						НоваяСтрока.Ссылка = ПолучитьКонтагентаПартнераПоИдентификатору(НоваяСтрока.ИдентификаторКомпании, НоваяСтрока.ИдентификаторПодразделения);

						Если НоваяСтрока.Ссылка = Неопределено ИЛИ НоваяСтрока.Ссылка.Пустая() Тогда
							Продолжить;
						КонецЕсли;

					Иначе
						НоваяСтрока.Ссылка = СтрокаТаблицыКонтрагентов.Объект;
					КонецЕсли;
					
					Если ЗначениеЗаполнено(НоваяСтрока.ИдентификаторПодразделения) Тогда
						
						ДобавитьВЖурналОтладочнуюИнформацию("Поиск подразделения элемента №" + Итер + " по идентификатору", "ЭДО_СинхронизацияКонтрагентов");
						СтрокаТаблицыПодразделений = ТаблицаПодразделений.Найти(НоваяСтрока.ИдентификаторПодразделения, "Значение");
						
					КонецЕсли;	
					
				КонецЦикла;
				
			КонецЕсли;
			
		Исключение
			
			ДобавитьВЖурнал("Ошибка обработки: " + ОписаниеОшибки(), "ЭДО_СинхронизацияКонтрагентов");
			ДобавитьВЖурналОтладочнуюИнформацию("Фиксация ошибки для отладки", "ЭДО_СинхронизацияКонтрагентов");
			
		КонецПопытки;
		
	КонецЦикла;
	
	ДобавитьВЖурналОтладочнуюИнформацию("Выход из процедуры", "ЭДО_СинхронизацияКонтрагентов");	
	Возврат ТаблицаДанных;	

КонецФункции

Функция ПолучитьКонтагентаПартнераПоИдентификатору(Идентификатор, ИдентификаторПодразделения)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Ссылка
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.DS_Подразделение_ID = &DS_Подразделение_ID
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Контрагенты.Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.DS_Подразделение_ID = &DS_Подразделение_ID";
	
	Запрос.УстановитьПараметр("DS_Подразделение_ID", ИдентификаторПодразделения);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() > 1 Тогда
		
		Сообщить("В системе присутствует: " + Выборка.Количество() + " с идентификатором: " + Идентификатор + ". Сопоставление невозможно");
		Возврат Неопределено;
		
	КонецЕсли;
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ЭДО_СинхронизацияБанков(БИКБанка = Неопределено)
	
	ТаблицаДанных = СправочникБанки.Выгрузить();
	ТаблицаДанных.Очистить();
	МассивЭлементов = API_ПолучитьСписокБанков(БИКБанка);
	
	Для Каждого ЭлементМассива Из МассивЭлементов Цикл
		
		Попытка
			
			Название 					= ЭлементМассива.Получить("shortTitle");
			СокрНазвание 				= ЭлементМассива.Получить("fullTitle");
			БИК 						= ЭлементМассива.Получить("bik");
			КоррСчет					= ЭлементМассива.Получить("correspondentAccount");
			
			НоваяСтрока 				= ТаблицаДанных.Добавить();
			НоваяСтрока.Название 		= Название;
			НоваяСтрока.СокрНазвание 	= СокрНазвание;
			НоваяСтрока.БИК 			= БИК;
			НоваяСтрока.Ссылка 			= МОП_ПолучитьБанкПоБИКу(БИК);
			НоваяСтрока.КоррСчетБанка 	= КоррСчет;
			
			Если НЕ ЗначениеЗаполнено(НоваяСтрока.Ссылка) И СоздаватьСправочникиПоДаннымЭДО Тогда
				НоваяСтрока.Ссылка 		= МОП_СоздатьБанк(БИК, НоваяСтрока.Название, НоваяСтрока.СокрНазвание, НоваяСтрока.КоррСчетБанка);
			КонецЕсли;
			
		Исключение
			ДобавитьВЖурнал("Ошибка обработки: " + ОписаниеОшибки(), "ЭДО_СинхронизацияБанков");
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат ТаблицаДанных;

КонецФункции

Функция ЭДО_СинхронизацияЕдиницИзмерения()
	
	ТаблицаДанных = СправочникЕдиницыИзмерения.Выгрузить();
	ТаблицаДанных.Очистить();
	МассивЭлементов = API_ПолучитьСписокЕдиницИзмерения();
	
	Для Каждого ЭлементМассива Из МассивЭлементов Цикл
		
		Попытка
			
			Название 					= ЭлементМассива.Получить("title");
			СокращенноеНаименование 	= ЭлементМассива.Получить("localDesignation");
			КодЕдиницы 					= ЭлементМассива.Получить("code");
			
			НоваяСтрока 				= ТаблицаДанных.Добавить();
			НоваяСтрока.Название 		= Название;
			НоваяСтрока.СокрНазвание 	= СокращенноеНаименование;
			НоваяСтрока.КодОКЕИ 		= КодЕдиницы;
			НоваяСтрока.Ссылка 			= МОП_ПолучитьЕдиницуИзмененияПоОКЕИ(КодЕдиницы);
			
			Если НЕ ЗначениеЗаполнено(НоваяСтрока.Ссылка) И СоздаватьСправочникиПоДаннымЭДО Тогда
				НоваяСтрока.Ссылка 		= МОП_СоздатьЕдиницуИзмерения(КодЕдиницы, НоваяСтрока.Название, НоваяСтрока.СокрНазвание);
			КонецЕсли;
			
		Исключение
			ДобавитьВЖурнал("Ошибка обработки: " + ОписаниеОшибки(), "API_ПолучитьСписокЕдиницИзмерения");
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат ТаблицаДанных;	

