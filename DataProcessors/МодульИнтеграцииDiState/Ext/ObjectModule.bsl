КонецФункции

Функция ФОД_ПолучитьКППКомпании(ВерсияЗаполнения, Знач ОбъектЗаполнения, Документ = Неопределено)
	
	Если ТипЗнч(ОбъектЗаполнения) = Тип("СправочникСсылка.Организации") ИЛИ ТипЗнч(ОбъектЗаполнения) = Тип("СправочникСсылка.Контрагенты") Тогда
		
		Если КНП_ЕстьРеквизит(ОбъектЗаполнения, "КПП") Тогда
			
			Если ТипЗнч(ОбъектЗаполнения) = Тип("СправочникСсылка.Контрагенты") И ЗначениеЗаполнено(Документ) Тогда
				
				Партнер = Неопределено;
				
				Если ТипЗнч(Документ) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
					
					Если ТипЗнч(Документ.ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
						Партнер = Документ.ДокументОснование.Грузополучатель;	
					ИначеЕсли ТипЗнч(Документ.ДокументОснование) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
						Партнер = Документ.ДокументОснование.Грузополучатель;
					КонецЕсли;   
					
				ИначеЕсли КНП_ЕстьРеквизит(Документ, "Грузополучатель") Тогда
					Партнер = Документ.Грузополучатель;					
				КонецЕсли;
				
				Если ЗначениеЗаполнено(Партнер) И ЗначениеЗаполнено(Партнер.Кпп) Тогда
					Возврат Партнер.Кпп;
				Иначе   
					
					Если ЗначениеЗаполнено(ОбъектЗаполнения.КПП) Тогда
						Возврат ОбъектЗаполнения.КПП;
					//+Белов А. 17.08.2026 #UT10-6007	
					ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.ТранспортнаяНакладная") Тогда
						
						Если ЗначениеЗаполнено(ОбъектЗаполнения.ГоловнойКонтрагент) И ОбъектЗаполнения <> ОбъектЗаполнения.ГоловнойКонтрагент Тогда
							Возврат ОбъектЗаполнения.ГоловнойКонтрагент.Кпп; 
						КонецЕсли;
						
					//-Белов А. 17.08.2026 #UT10-6007
					Иначе
						Возврат ?(ЗначениеЗаполнено(Документ.ДокументОснование.Контрагент.КПП), Документ.ДокументОснование.Контрагент.КПП, Неопределено);
					КонецЕсли;
					
				КонецЕсли;
				
			Иначе
				Возврат ?(ЗначениеЗаполнено(ОбъектЗаполнения.КПП), ОбъектЗаполнения.КПП, Неопределено);
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ОбъектЗаполнения) = Тип("Структура") Тогда
		
		Если ОбъектЗаполнения.Свойство("КПП") Тогда
			Возврат ?(ЗначениеЗаполнено(ОбъектЗаполнения.КПП), ОбъектЗаполнения.КПП, Неопределено);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ФОД_ПолучитьОКПОКомпании(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	
	Если ТипЗнч(ОбъектЗаполнения) = Тип("СправочникСсылка.Организации")
		ИЛИ
		ТипЗнч(ОбъектЗаполнения) = Тип("СправочникСсылка.Контрагенты") 
		Тогда
		
		Если КНП_ЕстьРеквизит(ОбъектЗаполнения, "ОКПО") И ЗначениеЗаполнено(ОбъектЗаполнения.ОКПО) Тогда
			Возврат ОбъектЗаполнения.ОКПО;
		ИначеЕсли КНП_ЕстьРеквизит(ОбъектЗаполнения, "КодПоОКПО") И ЗначениеЗаполнено(ОбъектЗаполнения.КодПоОКПО) Тогда
			Возврат ОбъектЗаполнения.КодПоОКПО;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ОбъектЗаполнения) = Тип("Структура") Тогда
		
		Если ОбъектЗаполнения.Свойство("ОКПО") Тогда
			Возврат ОбъектЗаполнения.ОКПО;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Неопределено;

КонецФункции

Функция ФОД_ПолучитьИмяПодразделенияКомпании(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	
	СтрокаКонтрагента = СправочникКонтрагенты.Найти(ОбъектЗаполнения, "НазваниеПодразделения");
	
	Если СтрокаКонтрагента <> Неопределено Тогда
		Возврат СтрокаКонтрагента.НазваниеПодразделения;
	КонецЕсли;
	
	Возврат "Основной офис";

КонецФункции

Функция ФОД_ПолучитьНомерСчета(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	
	Если ТипЗнч(ОбъектЗаполнения) = Тип("СправочникСсылка.Организации") Тогда
		
		БанковскийСчет = МОП_ПолучитьБанковскийСчетОрганизации(ОбъектЗаполнения);
		
		Если ЗначениеЗаполнено(БанковскийСчет) Тогда
			Возврат СокрЛП(МОП_ПолучитьНомерБанковскогоСчета(БанковскийСчет) );
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ОбъектЗаполнения) = Тип("СправочникСсылка.Контрагенты") Тогда
		
		БанковскийСчет = МОП_ПолучитьБанковскийСчетКонтрагента(ОбъектЗаполнения);
		
		Если ЗначениеЗаполнено(БанковскийСчет) Тогда
			Возврат СокрЛП(МОП_ПолучитьНомерБанковскогоСчета(БанковскийСчет) );
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ОбъектЗаполнения) = Тип("Структура") Тогда
		
		Если ОбъектЗаполнения.Свойство("НомерСчета") И ЗначениеЗаполнено(ОбъектЗаполнения.НомерСчета) Тогда
			Возврат ОбъектЗаполнения.НомерСчета;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат " ";
КонецФункции

