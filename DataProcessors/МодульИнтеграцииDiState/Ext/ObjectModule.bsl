//#Область КонфигурационноЗависимыеПроцедуры

// Процедура - Заполнить доп параметры документа по умолчанию в зависимости от конфигурации
//
// Параметры:
//  ДокОбъект		 - ДокументОбъект	 - Объект документа
//  ТекКонфигурация	 - Строка	 - Наименование конфигурации
//  ТипДокумента	 - Строка	 - Тип документа из входящих документов
//
Процедура КЗП_ЗаполнитьДопПараметрыДокумента(ДокОбъект, ТипДокумента)
	
	ТекКонфигурация = КНП_ИмяКонфигурации();
	
	Если ТекКонфигурация = "БП3" Тогда
		
		ИмяТЧ = "Товары";
		
		Если ТипДокумента = "Акт" Тогда
			ИмяТЧ = "Услуги";	
		КонецЕсли;
		
		МодульСчетаУчета = КНП_ОбщийМодуль("СчетаУчетаВДокументах");
		МодульСчетаУчета.ЗаполнитьСчетаУчетаРасчетов(ДокОбъект);
		МодульСчетаУчета.ЗаполнитьСчетаУчетаВТабличнойЧасти(ДокОбъект, ИмяТЧ);
		
	ИначеЕсли ТекКонфигурация = "БП" Тогда
		
		Попытка
			
			ДокОбъект.ЗаполнитьСчетаУчетаВТабЧасти(ДокОбъект.Товары, "Товары", Истина, Истина);
			ДокОбъект.ЗаполнитьСчетаУчетаВТабЧасти(ДокОбъект.Услуги, "Услуги", Истина, Истина);
			ДокОбъект.ЗаполнитьСчетаУчетаРасчетов();
			
		Исключение
			ДобавитьВЖурнал(ОписаниеОшибки() + " " + ТекКонфигурация, "ЗаполнитьДопПараметрыДокумента");
		КонецПопытки;
		
	ИначеЕсли ТекКонфигурация = "УТ11" Тогда
		
		ИмяТЧ = "Товары";
		
		Если ТипДокумента = "Акт" Тогда
			ИмяТЧ = "Услуги";	
		КонецЕсли;
		
	ИначеЕсли ТекКонфигурация = "УНФ" Тогда
		
		ИмяТЧ = "Запасы";
		
		Если ТипДокумента = "Акт" Тогда
			ИмяТЧ = "Расходы";	
		КонецЕсли;
		
	ИначеЕсли ТекКонфигурация = "БГУ" Тогда
		
	Иначе
		ДобавитьВЖурнал("Неподдерживаемая конфигурация " + ТекКонфигурация, "ЗаполнитьДопПараметрыДокумента");		
	КонецЕсли;
	
КонецПроцедуры

// Найти СФПоставщика
// *Поддержка БП 3.0, УТ 11, КА 2.4, БП 2.0, УТ 10.3, КА 1.1, УПП 1.3
//
// Параметры:
//  Номер		 - Строка	 - 
//  Дата		 - Дата	 - 
//  Контрагент	 - СправочникСсылка	 - 
// 
// Возвращаемое значение:
// ДокументСсылка  - 
//
Функция КЗП_НайтиОснованиеСчетФактурыПоставщика(Номер, Дата, Контрагент)
	
	Результат = Неопределено;
	ТекКонф = КНП_ИмяКонфигурации();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НомерВходящегоДокумента", Номер);
	Запрос.УстановитьПараметр("ДатаВходящегоДокумента", Дата);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	
	Если ТекКонф = "БП3" ИЛИ ТекКонф = "БП" ИЛИ ТекКонф = "УТ" ИЛИ ТекКонф = "КА" ИЛИ ТекКонф = "УПП" ИЛИ ТекКонф = "УНФ" Тогда	
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	СчетФактураПолученный.ДокументОснование КАК Ссылка
		|ИЗ
		|	Документ.СчетФактураПолученный КАК СчетФактураПолученный
		|ГДЕ
		|	СчетФактураПолученный.Контрагент = &Контрагент
		|	И СчетФактураПолученный.НомерВходящегоДокумента = &НомерВходящегоДокумента
		|	И СчетФактураПолученный.ДатаВходящегоДокумента = &ДатаВходящегоДокумента";
	ИначеЕсли ТекКонф = "БГУ" Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	СчетФактураПолученныйДокументыОснования.ДокументОснование КАК ДокументОснование
		|ИЗ
		|	Документ.СчетФактураПолученный.ДокументыОснования КАК СчетФактураПолученныйДокументыОснования
		|ГДЕ
		|	СчетФактураПолученныйДокументыОснования.Ссылка.НомерПервичногоДокумента = &НомерВходящегоДокумента
		|	И СчетФактураПолученныйДокументыОснования.Ссылка.ДатаПервичногоДокумента = &ДатаВходящегоДокумента";	
	ИначеЕсли ТекКонф = "УТ11" Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ПоступлениеТоваровУслуг.Ссылка
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
		|ГДЕ
		|	ПоступлениеТоваровУслуг.Контрагент = &Контрагент
		|	И ПоступлениеТоваровУслуг.НомерВходящегоДокумента = &НомерВходящегоДокумента
		|	И ПоступлениеТоваровУслуг.ДатаВходящегоДокумента = &ДатаВходящегоДокумента
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПоступлениеУслугПрочихАктивов.Ссылка
		|ИЗ
		|	Документ.ПоступлениеУслугПрочихАктивов КАК ПоступлениеУслугПрочихАктивов
		|ГДЕ
		|	ПоступлениеУслугПрочихАктивов.Контрагент = &Контрагент
		|	И ПоступлениеУслугПрочихАктивов.НомерВходящегоДокумента = &НомерВходящегоДокумента
		|	И ПоступлениеУслугПрочихАктивов.ДатаВходящегоДокумента = &ДатаВходящегоДокумента";
	ИначеЕсли ТекКонф = "КА24" Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ПоступлениеТоваровУслуг.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПоступлениеТоваров КАК ПоступлениеТоваровУслуг
		|ГДЕ
		|	ПоступлениеТоваровУслуг.Контрагент = &Контрагент
		|	И ПоступлениеТоваровУслуг.НомерВходящегоДокумента = &НомерВходящегоДокумента
		|	И ПоступлениеТоваровУслуг.ДатаВходящегоДокумента = &ДатаВходящегоДокумента
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПриобретениеТоваровУслуг.Ссылка
		|ИЗ
		|	Документ.ПриобретениеТоваровУслуг КАК ПриобретениеТоваровУслуг
		|ГДЕ
		|	ПриобретениеТоваровУслуг.Контрагент = &Контрагент
		|	И ПриобретениеТоваровУслуг.НомерВходящегоДокумента = &НомерВходящегоДокумента
		|	И ПриобретениеТоваровУслуг.ДатаВходящегоДокумента = &ДатаВходящегоДокумента
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПоступлениеУслугПрочихАктивов.Ссылка
		|ИЗ
		|	Документ.ПриобретениеУслугПрочихАктивов КАК ПоступлениеУслугПрочихАктивов
		|ГДЕ
		|	ПоступлениеУслугПрочихАктивов.Контрагент = &Контрагент
		|	И ПоступлениеУслугПрочихАктивов.НомерВходящегоДокумента = &НомерВходящегоДокумента
		|	И ПоступлениеУслугПрочихАктивов.ДатаВходящегоДокумента = &ДатаВходящегоДокумента";
	Иначе
		ДобавитьВЖурнал("Неподдерживаемая конфигурация " + ТекКонф, "КЗП_НайтиСФПоставщика");	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Запрос.Текст) Тогда
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Результат = Выборка.Ссылка;
		КонецЕсли;	
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

// Получить договор контрагента с организацией
// *Поддержка БП 3.0, УТ 11, КА 2.4, БП 2.0, УТ 10.3, КА 1.1, УПП 1.3
//
// Параметры:
//  КонтрагентСсылка	 - СправочникСсылка.Контрагенты	 - 
//  ОрганизацияСсылка	 - СправочникСсылка.Организации	 - 
//  НомерДоговора		 - Строка	 - 
//  ДатаДоговора		 - Дата	 - 
// 
// Возвращаемое значение:
// СправочникСсылка, Неопределено  - Ссылка на договор
//
Функция КЗП_ПолучитьДоговорКонтрагентаСОрганизацией(КонтрагентСсылка, ОрганизацияСсылка, 
	НомерДоговора = Неопределено, ДатаДоговора = Неопределено)
	
	Запрос = Новый Запрос;
	ТекКонф = КНП_ИмяКонфигурации();
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Ссылка КАК Ссылка,
	|	ДоговорыКонтрагентов.Номер КАК Номер,
	|	ДоговорыКонтрагентов.Дата КАК Дата
	|ИЗ
	|	Справочник.{ДоговорыКонтрагентов} КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.{ВладелецКонтрагента} = &Контрагент
	|	И ДоговорыКонтрагентов.Организация = &Организация";
	
	Если ТекКонф = "БП3" ИЛИ ТекКонф = "БП" ИЛИ ТекКонф = "УТ" ИЛИ ТекКонф = "КА" ИЛИ ТекКонф = "УПП" Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "{ДоговорыКонтрагентов}", "ДоговорыКонтрагентов");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "{ВладелецКонтрагента}", "Владелец");
		
	ИначеЕсли ТекКонф = "УТ11" ИЛИ ТекКонф = "КА24" ИЛИ ТекКонф = "ERP" Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "{ДоговорыКонтрагентов}", "ДоговорыКонтрагентов");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "{ВладелецКонтрагента}", "Контрагент");
		
	ИначеЕсли ТекКонф = "УНФ" Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "{ДоговорыКонтрагентов}", "ДоговорыКонтрагентов");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "{ВладелецКонтрагента}", "Владелец");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ДоговорыКонтрагентов.Номер", "ДоговорыКонтрагентов.НомерДоговора");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ДоговорыКонтрагентов.Дата", "ДоговорыКонтрагентов.ДатаДоговора");
		
	ИначеЕсли ТекКонф = "БГУ" Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "{ДоговорыКонтрагентов}", "Договоры");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "{ВладелецКонтрагента}", "Контрагент");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ДоговорыКонтрагентов.Номер", "ДоговорыКонтрагентов.НомерДоговора");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ДоговорыКонтрагентов.Дата", "ДоговорыКонтрагентов.ДатаДоговора");
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Контрагент", КонтрагентСсылка);
	Запрос.УстановитьПараметр("Организация", ОрганизацияСсылка);
	
	Если НЕ ЗначениеЗаполнено(Запрос.Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	ПоследнийДоговор = Неопределено;
	
	Пока Выборка.Следующий() Цикл
		
		Если ЗначениеЗаполнено(ДатаДоговора) Тогда
			
			Если ЗначениеЗаполнено(НомерДоговора) Тогда
				
				Если Выборка.Номер = НомерДоговора И Выборка.Дата = ДатаДоговора Тогда
					Возврат Выборка.Ссылка;
				КонецЕсли;
				
			КонецЕсли;
			
			Если Выборка.Дата = ДатаДоговора Тогда
				Возврат Выборка.Ссылка
			КонецЕсли;
			
		КонецЕсли;
		
		ПоследнийДоговор = Выборка.Ссылка;
		
	КонецЦикла;
	
	Возврат ПоследнийДоговор;

КонецФункции

// Получить должность физ лица
// *Поддержка БП 3.0, УТ 11, КА 2.4, БП 2.0, УТ 10.3, КА 1.1, УПП 1.3
//
// Параметры:
//  ФизЛицо	 - СправочникСсылка	 - Ссылка на элемент справочника физлиц
// 
// Возвращаемое значение:
// СправочникСсылка  - Ссылка на должность
//
Функция КЗП_ПолучитьДолжностьФизЛица(ФизЛицо)
	
	ТекКонф = КНП_ИмяКонфигурации();
	Запрос = Новый Запрос;
	
	Если ТекКонф = "БП3" ИЛИ ТекКонф = "БП" ИЛИ ТекКонф = "КА" ИЛИ ТекКонф = "УПП" Тогда
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОтветственныеЛица.Должность КАК Должность
		|ИЗ
		|	РегистрСведений.ОтветственныеЛицаОрганизаций.СрезПоследних КАК ОтветственныеЛица
		|ГДЕ
		|	ОтветственныеЛица.ФизическоеЛицо = &ФизическоеЛицо
		|	И ОтветственныеЛица.СтруктурнаяЕдиница = &Организация";
	ИначеЕсли ТекКонф = "УТ" Тогда //Вся тупость в том, что отличие БП от УТ - в наличии \ отсутствии Й в конце наименования регистра
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОтветственныеЛица.Должность КАК Должность
		|ИЗ
		|	РегистрСведений.ОтветственныеЛицаОрганизации.СрезПоследних КАК ОтветственныеЛица  
		|ГДЕ
		|	ОтветственныеЛица.ФизическоеЛицо = &ФизическоеЛицо
		|	И ОтветственныеЛица.СтруктурнаяЕдиница = &Организация";	
	ИначеЕсли ТекКонф = "УТ11" ИЛИ ТекКонф = "КА24" ИЛИ ТекКонф = "ERP" Тогда
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ОтветственныеЛица.Должность КАК Должность
		|ИЗ
		|	Справочник.ОтветственныеЛицаОрганизаций КАК ОтветственныеЛица
		|ГДЕ
		|	ОтветственныеЛица.Владелец = &Организация
		|	И ОтветственныеЛица.ФизическоеЛицо = &ФизическоеЛицо
		|	И ОтветственныеЛица.ДатаНачала <= &ТекущаяДата
		|	И (ОтветственныеЛица.ДатаОкончания >= &ТекущаяДата
		|			ИЛИ ОтветственныеЛица.ДатаОкончания ЕСТЬ NULL)";
	ИначеЕсли ТекКонф = "БГУ" Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ДанныеСотрудниковСрезПоследних.Должность КАК Должность
		|ИЗ
		|	РегистрСведений.ДанныеСотрудников.СрезПоследних КАК ДанныеСотрудниковСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
		|		ПО ДанныеСотрудниковСрезПоследних.Сотрудник.Контрагент = Контрагенты.Ссылка
		|ГДЕ
		|	Контрагенты.ЮридическоеФизическоеЛицо = &ФизическоеЛицо
		|	И ДанныеСотрудниковСрезПоследних.Организация = &Организация";
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Запрос.Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ФизическоеЛицо", ФизЛицо);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата() );
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Должность;
	КонецЕсли;
	
	Возврат Неопределено;
	
	
КонецФункции

// Получить ответственное лицо по роли
// *Поддержка БП 3.0, УТ 11, КА 2.4, БП 2.0, УТ 10.3, КА 1.1, УПП 1.3
//
// Параметры:
//  Роль - ПеречислениеСсылка 	 - Вид ответственного лица
// 
// Возвращаемое значение:
// СправочникСсылка  - Ссылка на справочник физлиц
//
Функция КЗП_ПолучитьОтветственноеЛицо(Роль = Неопределено)
	
	ТекКонф = КНП_ИмяКонфигурации();
	Запрос = Новый Запрос;
	
	Если ТекКонф = "БП3" ИЛИ ТекКонф = "БП" ИЛИ ТекКонф = "КА" ИЛИ ТекКонф = "УПП" Тогда
		Запрос.Текст = "ВЫБРАТЬ
		|	ОтветственныеЛица.ФизическоеЛицо
		|ИЗ
		|	РегистрСведений.ОтветственныеЛицаОрганизаций.СрезПоследних КАК ОтветственныеЛица
		|ГДЕ
		|	ОтветственныеЛица.СтруктурнаяЕдиница = &Организация
		|	И ОтветственныеЛица.ОтветственноеЛицо = &Роль";
	ИначеЕсли ТекКонф = "УТ" Тогда
		Запрос.Текст = "ВЫБРАТЬ
		|	ОтветственныеЛица.ФизическоеЛицо
		|ИЗ
		|	РегистрСведений.ОтветственныеЛицаОрганизации.СрезПоследних КАК ОтветственныеЛица
		|ГДЕ
		|	ОтветственныеЛица.СтруктурнаяЕдиница = &Организация
		|	И ОтветственныеЛица.ОтветственноеЛицо = &Роль";	
	ИначеЕсли ТекКонф = "УТ11" ИЛИ ТекКонф = "КА24" ИЛИ ТекКонф = "ERP" Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ОтветственныеЛица.ФизическоеЛицо
		|ИЗ
		|	Справочник.ОтветственныеЛицаОрганизаций КАК ОтветственныеЛица
		|ГДЕ
		|	ОтветственныеЛица.Владелец = &Организация
		|	И ОтветственныеЛица.ОтветственноеЛицо = &Роль
		|	И ОтветственныеЛица.ДатаНачала <= &ТекущаяДата
		|	И (ОтветственныеЛица.ДатаОкончания >= &ТекущаяДата
		|			ИЛИ ОтветственныеЛица.ДатаОкончания ЕСТЬ NULL)";
	ИначеЕсли ТекКонф = "БГУ" Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Контрагенты.ЮридическоеФизическоеЛицо КАК ЮридическоеФизическоеЛицо
		|ИЗ
		|	РегистрСведений.ОтветственныеЛицаОрганизаций.СрезПоследних КАК ОтветственныеЛица
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
		|		ПО ОтветственныеЛица.ОтветственноеЛицо = Контрагенты.Ссылка
		|			И (ТИПЗНАЧЕНИЯ(Контрагенты.ЮридическоеФизическоеЛицо) = ТИП(Справочник.ФизическиеЛица))
		|ГДЕ
		|	ОтветственныеЛица.Организация = &Организация
		|	И ОтветственныеЛица.ОтветственноеЛицо = &Роль";
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата() );
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Если ЗначениеЗаполнено(Роль) Тогда
		Запрос.УстановитьПараметр("Роль", Роль);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ОтветственныеЛица.ОтветственноеЛицо = &Роль", ""); 	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Запрос.Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ФизическоеЛицо;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция КЗП_ПолучитьПФАктаСверки(СсылкаНаДокумент)
	
	ТекКонф = КНП_ИмяКонфигурации();
	ТабДок = Неопределено;
	
	Если ТекКонф = "БП3" ИЛИ ТекКонф = "БГУ" Тогда
		
		МассивДокументов = Новый Массив;
		МассивДокументов.Добавить(СсылкаНаДокумент);
		
		ИменаМакетов = Новый Массив;
		ИменаМакетов.Добавить("АктСверки");
		
		МодульПечати = КНП_ОбщийМодуль("УправлениеПечатью");
		КоллекцияПФ = МодульПечати.СформироватьПечатныеФормы("Документ.АктСверкиВзаиморасчетов", ИменаМакетов, МассивДокументов, Новый Структура).КоллекцияПечатныхФорм;
		
		Если КоллекцияПФ.Количество() > 0 Тогда
			ТабДок = КоллекцияПФ[0].ТабличныйДокумент;
		КонецЕсли;
		
	ИначеЕсли ТекКонф = "УТ11" ИЛИ ТекКонф = "КА24" ИЛИ ТекКонф = "ERP" Тогда
		
		МассивДокументов = Новый Массив;
		МассивДокументов.Добавить(СсылкаНаДокумент);
		
		ИменаМакетов = Новый Массив;
		ИменаМакетов.Добавить("АктСверкиВзаимныхРасчетов");
		
		МодульПечати = КНП_ОбщийМодуль("УправлениеПечатью");
		КоллекцияПФ = МодульПечати.СформироватьПечатныеФормы("Документ.СверкаВзаиморасчетов", ИменаМакетов, МассивДокументов, Новый Структура).КоллекцияПечатныхФорм;
		
		Если КоллекцияПФ.Количество() > 0 Тогда
			ТабДок = КоллекцияПФ[0].ТабличныйДокумент;
		КонецЕсли;
		
	ИначеЕсли ТекКонф = "УТ" Тогда
		ТабДок = КЗП_Служебный_ПечатьАктаСверкиУТ103(СсылкаНаДокумент);
	ИначеЕсли ТекКонф = "УНФ" Тогда
		
		МассивДокументов = Новый Массив;
		МассивДокументов.Добавить(СсылкаНаДокумент);
		
		ИменаМакетов = "АктСДаннымиКонтрагента";
		
		МодульПечати = КНП_ОбщийМодуль("УправлениеПечатью");
		КоллекцияПФ = МодульПечати.СформироватьПечатныеФормы("Документ.СверкаВзаиморасчетов", ИменаМакетов, МассивДокументов, Новый Структура).КоллекцияПечатныхФорм;
		
		Если КоллекцияПФ.Количество() > 0 Тогда
			ТабДок = КоллекцияПФ[0].ТабличныйДокумент;
		КонецЕсли;	
		
	КонецЕсли;
	
	Возврат ТабДок;

КонецФункции

// Получить представление контрагента
// *Поддержка БП 3.0, УТ 11, КА 2.4, БП 2.0, УТ 10.3, КА 1.1, УПП 1.3
//
// Параметры:
//  Контрагент		 - СправочникСсылка.Контрагенты	 - 
//  ТипПредставления - Строка	 - Указатель какое представление нужно получить
// 
// Возвращаемое значение:
// Строка  - Представление контрагента
//
Функция КЗП_ПолучитьПредставлениеКонтрагента(Контрагент, ТипПредставления = "")
	
	Результат = "";
	ТекКонф = КНП_ИмяКонфигурации();
	
	Если ТекКонф = "БП3" Тогда
		
		МодульБухПереопределяемый = КНП_ОбщийМодуль("БухгалтерскийУчетПереопределяемый");
		МодульОбщегоНазначения = КНП_ОбщийМодуль("ОбщегоНазначенияБПВызовСервера");
		Результат = МодульОбщегоНазначения.ОписаниеОрганизации(МодульБухПереопределяемый.СведенияОЮрФизЛице(Контрагент), ТипПредставления );			
		
	ИначеЕсли ТекКонф = "УТ11" ИЛИ ТекКонф = "КА24" ИЛИ ТекКонф = "ERP" Тогда
		
		МодульФормированиеПечатныхФорм = КНП_ОбщийМодуль("ФормированиеПечатныхФорм");
		Результат = МодульФормированиеПечатныхФорм.ОписаниеОрганизации(МодульФормированиеПечатныхФорм.СведенияОЮрФизЛице(Контрагент, ТекущаяДата() ), ТипПредставления );
		
	ИначеЕсли ТекКонф = "БП" ИЛИ ТекКонф = "УТ" ИЛИ ТекКонф = "КА" ИЛИ ТекКонф = "УПП" Тогда
		
		МодульФормированиеПечатныхФорм = КНП_ОбщийМодуль("ФормированиеПечатныхФорм");
		МодульКонтактнойИнформации = КНП_ОбщийМодуль("УправлениеКонтактнойИнформацией");
		Результат = МодульФормированиеПечатныхФорм.ОписаниеОрганизации(МодульКонтактнойИнформации.СведенияОЮрФизЛице(Контрагент, ТекущаяДата() ), ТипПредставления);	
		
	ИначеЕсли ТекКонф = "БГУ" Тогда
		
		Если ТипЗнч(Контрагент.ЮридическоеФизическоеЛицо) = Тип("СправочникСсылка.ЮридическиеЛица") Тогда
			Результат = Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное;
		Иначе
			Результат = Контрагент.Наименование;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

// Возвращает структуру адреса, используя методы типовой конфигурации
// *Поддержка БП 3.0, УТ 11, КА 2.4, БП 2.0, УТ 10.3, КА 1.1, УПП 1.3
// 
// Параметры:
// 	Владелец - СправочникСсылка.Организации, СправочникСсылка.Контрагенты - Ссылка на элемент справочника
// 	ТекущаяКонфигурация - Строка - Краткое название текущей конфигурации. См. ПолучитьИмяКонфигурации()
// Возвращаемое значение:
// 	Структура, Неопределено - Структура адреса или неопределено, если произошла какая-то ошибка
Функция КЗП_ПолучитьСтруктуруАдресаИзБазы(Владелец, ТекКонф, ВидКонтактнойИнформации = Неопределено)
	
	МодульУправленияКонтактнойИнформацией = Неопределено;
	АдресСтруктурой = Неопределено;
	
	Если ВидКонтактнойИнформации = Неопределено Тогда
		ВидКонтактнойИнформации = МОП_ПолучитьВидКИЮрАдреса(Владелец, ТекКонф);
	КонецЕсли;
	
	Если ВидКонтактнойИнформации = Неопределено Тогда
		Возврат АдресСтруктурой;
	КонецЕсли;
	
	Если ТекКонф = "БП3" Тогда
		
		МодульУправленияКонтактнойИнформацией = КНП_ОбщийМодуль("УправлениеКонтактнойИнформациейБП");
		АдресСтруктурой = МодульУправленияКонтактнойИнформацией.АдресСтруктурой(Владелец, ВидКонтактнойИнформации);	 
		
	ИначеЕсли ТекКонф = "БП" ИЛИ ТекКонф = "УТ" ИЛИ ТекКонф = "КА" ИЛИ ТекКонф = "УПП" Тогда
		
		МодульУправленияКонтактнойИнформацией = КНП_ОбщийМодуль("УправлениеКонтактнойИнформацией");
		
		НаборЗаписейКИ = РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей();
		НаборЗаписейКИ.Отбор.Объект.Установить(Владелец);
		НаборЗаписейКИ.Отбор.Вид.Установить(ВидКонтактнойИнформации);
		НаборЗаписейКИ.Прочитать();
		
		Если НаборЗаписейКИ.Количество() > 0 Тогда
			
			КИ = НаборЗаписейКИ[0]; 
			
			ПредставлениеАдреса = МодульУправленияКонтактнойИнформацией.ПолучитьПолныйАдрес(НаборЗаписейКИ[0]);
			
			Если НЕ ЗначениеЗаполнено(ПредставлениеАдреса) Тогда
				Возврат Неопределено;
			КонецЕсли;    
			
			ЧислоВхожденийЗапятойВАдрес = СтрЧислоВхождений(ПредставлениеАдреса, ","); 
			
			Если ЧислоВхожденийЗапятойВАдрес > 9 Тогда
				
				АдресСтруктурой = Новый Структура;
				АдресСтруктурой.Вставить("Страна","");
				АдресСтруктурой.Вставить("Индекс","");
				АдресСтруктурой.Вставить("Регион","");
				АдресСтруктурой.Вставить("Район","");
				АдресСтруктурой.Вставить("Город","");
				АдресСтруктурой.Вставить("НаселенныйПункт","");
				АдресСтруктурой.Вставить("Улица","");
				АдресСтруктурой.Вставить("Дом","");
				АдресСтруктурой.Вставить("Корпус","");
				АдресСтруктурой.Вставить("Квартира","");
				
				АдресСтруктурой.Индекс = КИ.Поле1;
				АдресСтруктурой.Регион = КИ.Поле2;
				АдресСтруктурой.Район  = КИ.Поле3;
				АдресСтруктурой.Город  = КИ.Поле4;
				АдресСтруктурой.НаселенныйПункт = КИ.Поле5;
				АдресСтруктурой.Улица  = КИ.Поле6;
				АдресСтруктурой.Дом    = ?(ЗначениеЗаполнено(КИ.Поле7), ПолучитьТипДляКИКратко(КИ.ТипДома), "") + КИ.Поле7;
				АдресСтруктурой.Корпус = ?(ЗначениеЗаполнено(КИ.Поле8), ПолучитьТипДляКИКратко(КИ.ТипКорпуса), "") + КИ.Поле8;
				АдресСтруктурой.Квартира = ?(ЗначениеЗаполнено(КИ.Поле9), ПолучитьТипДляКИКратко(КИ.ТипКвартиры), "") + КИ.Поле9; 
				
			Иначе
				
				АдресСтруктурой = МодульУправленияКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(ПредставлениеАдреса);
				
				Если НЕ (АдресСтруктурой.Свойство("ЗаПределамиРФ") И АдресСтруктурой.ЗаПределамиРФ) Тогда
					
					АдресСтруктурой.Дом    = ?(ЗначениеЗаполнено(АдресСтруктурой.Дом), ПолучитьТипДляКИКратко(КИ.ТипДома), "") + АдресСтруктурой.Дом;
					АдресСтруктурой.Корпус = ?(ЗначениеЗаполнено(АдресСтруктурой.Корпус), ПолучитьТипДляКИКратко(КИ.ТипКорпуса), "") + АдресСтруктурой.Корпус;
					АдресСтруктурой.Квартира = ?(ЗначениеЗаполнено(АдресСтруктурой.Квартира), ПолучитьТипДляКИКратко(КИ.ТипКвартиры), "") + АдресСтруктурой.Квартира;
					
				КонецЕсли;
				
			КонецЕсли;   
			
			АдресСтруктурой.Вставить("Представление", КИ.Представление);
			АдресСтруктурой.Вставить("ТипАдреса", "text");
			
		КонецЕсли;
		
	ИначеЕсли ТекКонф = "УТ11" ИЛИ ТекКонф = "КА24" ИЛИ ТекКонф = "УНФ" ИЛИ ТекКонф = "БГУ"
		ИЛИ ТекКонф = "БП3" И НЕ (ЗначениеЗаполнено(АдресСтруктурой.Индекс) И ЗначениеЗаполнено(АдресСтруктурой.КодРегиона) ) Тогда
		
		МодульУправленияКонтактнойИнформацией = КНП_ОбщийМодуль("УправлениеКонтактнойИнформацией");
		
		МассивОбъектов = Новый Массив;
		МассивОбъектов.Добавить(Владелец);
		XMLСтрока = Неопределено;
		КонтактнаяИнформацияОбъекта = МодульУправленияКонтактнойИнформацией.КонтактнаяИнформацияОбъектов(МассивОбъектов,, ВидКонтактнойИнформации, ТекущаяДата() );
		
		Если КонтактнаяИнформацияОбъекта.Количество() > 0 Тогда
			XMLСтрока = КонтактнаяИнформацияОбъекта[0].ЗначенияПолей;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(XMLСтрока) Тогда
			Возврат МодульУправленияКонтактнойИнформацией.СведенияОбАдресе("");
		КонецЕсли;
		
		АдресСтруктурой = МодульУправленияКонтактнойИнформацией.СведенияОбАдресе(XMLСтрока);
		
		Если НЕ АдресСтруктурой.Свойство("Дом") Тогда
			АдресСтруктурой.Вставить("Дом", АдресСтруктурой.Здание.Номер);
		ИначеЕсли НЕ ЗначениеЗаполнено(АдресСтруктурой.Дом) И ЗначениеЗаполнено(АдресСтруктурой.Здание.Номер) Тогда
			АдресСтруктурой.Дом = АдресСтруктурой.Здание.Номер;	
		КонецЕсли;
		
		Если НЕ АдресСтруктурой.Свойство("Корпус") Тогда
			
			АдресСтруктурой.Вставить("Корпус", ?(АдресСтруктурой.Корпуса.Количество() > 0, АдресСтруктурой.Корпуса[0], "") );
			
			Если ТипЗнч(АдресСтруктурой.Корпус) = Тип("Структура") Тогда
				АдресСтруктурой.Корпус = КНП_БезопасноПрочитатьЗначение(АдресСтруктурой.Корпус, "ТипКорпуса") + " " + КНП_БезопасноПрочитатьЗначение(АдресСтруктурой.Корпус, "Номер");
			КонецЕсли;
			
		ИначеЕсли НЕ ЗначениеЗаполнено(АдресСтруктурой.Корпус) Тогда
			
			АдресСтруктурой.Корпус = ?(АдресСтруктурой.Корпуса.Количество() > 0, АдресСтруктурой.Корпуса[0], "");
			
			Если ТипЗнч(АдресСтруктурой.Корпус) = Тип("Структура") Тогда
				АдресСтруктурой.Корпус = КНП_БезопасноПрочитатьЗначение(АдресСтруктурой.Корпус, "ТипКорпуса") + " " + КНП_БезопасноПрочитатьЗначение(АдресСтруктурой.Корпус, "Номер");
			КонецЕсли;
			
		КонецЕсли;
		
		Если НЕ АдресСтруктурой.Свойство("Здание") Тогда
			
			АдресСтруктурой.Вставить("Здание", ?(АдресСтруктурой.Здания.Количество() > 0, АдресСтруктурой.Здания[0], "") );
			
			Если ТипЗнч(АдресСтруктурой.Здание) = Тип("Структура") Тогда
				АдресСтруктурой.Здание = КНП_БезопасноПрочитатьЗначение(АдресСтруктурой.Здание, "ТипКорпуса") + " " + КНП_БезопасноПрочитатьЗначение(АдресСтруктурой.Здание, "Номер");
			КонецЕсли;
			
		ИначеЕсли НЕ ЗначениеЗаполнено(АдресСтруктурой.Здание) Тогда
			
			АдресСтруктурой.Здание = ?(АдресСтруктурой.Здания.Количество() > 0, АдресСтруктурой.Здания[0], "");
			
			Если ТипЗнч(АдресСтруктурой.Здание) = Тип("Структура") Тогда
				АдресСтруктурой.Здание = КНП_БезопасноПрочитатьЗначение(АдресСтруктурой.Здание, "ТипКорпуса") + " " + КНП_БезопасноПрочитатьЗначение(АдресСтруктурой.Здание, "Номер");
			КонецЕсли;
			
		КонецЕсли;
		
		Если НЕ АдресСтруктурой.Свойство("Квартира") Тогда
			
			Если АдресСтруктурой.Помещения.Количество() > 0 Тогда 
				
				Если нрег(АдресСтруктурой.Помещения[0].типпомещения) = "квартира" Тогда
					
					АдресСтруктурой.Вставить("Квартира", ?(АдресСтруктурой.Помещения.Количество() > 0, АдресСтруктурой.Помещения[0], "") );
					
					Если ТипЗнч(АдресСтруктурой.Квартира) = Тип("Структура") Тогда
						АдресСтруктурой.Квартира = КНП_БезопасноПрочитатьЗначение(АдресСтруктурой.Квартира, "ТипПомещения") + " " + КНП_БезопасноПрочитатьЗначение(АдресСтруктурой.Квартира, "Номер");
					КонецЕсли;
					
				Иначе
					АдресСтруктурой.Вставить(АдресСтруктурой.Помещения[0].ТипПомещения,Строка(АдресСтруктурой.Помещения[0].Номер));
				КонецЕсли;
				
			КонецЕсли;
			
		ИначеЕсли НЕ ЗначениеЗаполнено(АдресСтруктурой.Квартира) Тогда
			
			АдресСтруктурой.Квартира = ?(АдресСтруктурой.Помещения.Количество() > 0, АдресСтруктурой.Помещения[0], "") ;
			
			Если ТипЗнч(АдресСтруктурой.Квартира) = Тип("Структура") Тогда
				АдресСтруктурой.Квартира = КНП_БезопасноПрочитатьЗначение(АдресСтруктурой.Квартира, "ТипПомещения") + " " + КНП_БезопасноПрочитатьЗначение(АдресСтруктурой.Квартира, "Номер");
			КонецЕсли;
			
		КонецЕсли;
		
		Если АдресСтруктурой.Помещения.Количество() > 1 Тогда
			
			Для Индекс = 1 По АдресСтруктурой.Помещения.Количество() - 1 Цикл
				
				Если НЕ АдресСтруктурой.Свойство(АдресСтруктурой.Помещения[Индекс].ТипПомещения) Тогда
					АдресСтруктурой.Вставить(АдресСтруктурой.Помещения[Индекс].ТипПомещения,Строка(АдресСтруктурой.Помещения[Индекс].Номер));
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	Иначе
		
		ДобавитьВЖурнал("Неподдерживаемая конфигурация " + ТекКонф, "ЗаполнитьСтруктуруАдреса");
		Возврат Неопределено;
		
	КонецЕсли;
	
	Если АдресСтруктурой = Неопределено Тогда
		Возврат АдресСтруктурой;
	КонецЕсли;
	
	
	
	Если НЕ АдресСтруктурой.Свойство("Регион") Тогда
		АдресСтруктурой.Вставить("Регион", "");
	КонецЕсли;
	
	Если НЕ АдресСтруктурой.Свойство("КодРегиона") Тогда
		
		АдресСтруктурой.Вставить("КодРегиона", "");
		
		Если ЗначениеЗаполнено(АдресСтруктурой.Регион) Тогда
			
			ИмяРегиона = АдресСтруктурой.Регион;
			
			Если Найти(ИмяРегиона, " г") > 0 Тогда
				
				Поз = Найти(ИмяРегиона, " г");
				ИмяРегиона = Лев(АдресСтруктурой.Регион, Поз - 1);
				
			КонецЕсли;
			
			Если Найти(ИмяРегиона, "Респ") > 0 И Найти(ИмяРегиона, "Республика") = 0 Тогда
				
				Поз = Найти(ИмяРегиона, "Респ");
				ИмяРегиона = Лев(ИмяРегиона, Поз - 1) + "Республика" + Сред(ИмяРегиона, Поз + 4);
				
			КонецЕсли;
			
			Если Найти(ИмяРегиона, "обл") > 0 И Найти(ИмяРегиона, "область") = 0 Тогда
				
				Поз = Найти(ИмяРегиона, "обл");
				ИмяРегиона = Лев(ИмяРегиона, Поз - 1) + "область" + Сред(ИмяРегиона, Поз + 3);
				
			КонецЕсли;
			
			Если Найти(ИмяРегиона, "АО") > 0 Тогда
				
				Поз = Найти(ИмяРегиона, "АО");
				ИмяРегиона = Лев(ИмяРегиона, Поз - 1) + Сред(ИмяРегиона, Поз + 2);	
				
			КонецЕсли;
			
			СтрокаРегиона = СправочникРегионы.Найти(ИмяРегиона, "ИмяРегиона");
			
			Если СтрокаРегиона <> Неопределено Тогда
				АдресСтруктурой.КодРегиона = СтрокаРегиона.КодРегиона;
			ИначеЕсли Найти(ИмяРегиона, "Республика") Тогда
				
				Поз = Найти(ИмяРегиона, "Республика");
				ИмяРегиона = СокрП("Республика " + Лев(ИмяРегиона, Поз - 1) );
				СтрокаРегиона = СправочникРегионы.Найти(ИмяРегиона, "ИмяРегиона");
				
				Если СтрокаРегиона <> Неопределено Тогда
					АдресСтруктурой.КодРегиона = СтрокаРегиона.КодРегиона;
				КонецЕсли; 
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ АдресСтруктурой.Свойство("Индекс") Тогда
		АдресСтруктурой.Вставить("Индекс", "");
	КонецЕсли;
	
	Если НЕ АдресСтруктурой.Свойство("Район") Тогда
		АдресСтруктурой.Вставить("Район", "");
	КонецЕсли;
	
	Если НЕ АдресСтруктурой.Свойство("Город") Тогда
		АдресСтруктурой.Вставить("Город", "");
	КонецЕсли;
	
	Возврат АдресСтруктурой;

КонецФункции

Функция ПолучитьТипДляКИКратко(Тип)
	
	Если Тип = Перечисления.ТипыДомов.Дом Тогда
		Возврат "д."  
	ИначеЕсли Тип = Перечисления.ТипыДомов.Домовладение Тогда
		Возврат "домовладение "
	ИначеЕсли Тип = Перечисления.ТипыДомов.Здание Тогда
		Возврат "зд. " 
	ИначеЕсли Тип = Перечисления.ТипыКорпусов.Корпус Тогда
		Возврат "к."
	ИначеЕсли Тип = Перечисления.ТипыКорпусов.Литера Тогда
		Возврат "лит."
	ИначеЕсли Тип = Перечисления.ТипыКорпусов.Сооружение Тогда
		Возврат "сооружение "   
	ИначеЕсли Тип = Перечисления.ТипыКорпусов.Строение Тогда
		Возврат "стр."      
	ИначеЕсли Тип = Перечисления.ТипыКорпусов.Участок Тогда
		Возврат "участок "
	ИначеЕсли Тип = Перечисления.ТипыКвартир.Бокс Тогда
		Возврат "бокс "
	ИначеЕсли Тип = Перечисления.ТипыКвартир.Квартира Тогда
		Возврат "кв."   
	ИначеЕсли Тип = Перечисления.ТипыКвартир.Комната Тогда
		Возврат "ком." 
	ИначеЕсли Тип = Перечисления.ТипыКвартир.Офис Тогда
		Возврат "офис "          
	ИначеЕсли Тип = Перечисления.ТипыКвартир.Помещение Тогда
		Возврат "пом."      
	ИначеЕсли Тип = Перечисления.ТипыКвартир.Этаж Тогда
		Возврат "эт."
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Получить структуру ФИО из справочника физлица
// *Поддержка БП 3.0, УТ 11, КА 2.4, БП 2.0, УТ 10.3, КА 1.1, УПП 1.3
//
// Параметры:
//  ФизЛицо	 - СправочникСсылка	 - 
// 
// Возвращаемое значение:
// Структура  - Структура с полями Фамилия, Имя, Отчество
//
Функция КЗП_ПолучитьСтруктуруФИОФизЛица(ФизЛицо)
	
	СтруктураФИО = Новый Структура("Фамилия,Имя,Отчество");
	ТекКонф = КНП_ИмяКонфигурации();
	
	Если ТекКонф = "БП3" Тогда
		ЗаполнитьЗначенияСвойств(СтруктураФИО, ФизЛицо);
	ИначеЕсли ТекКонф = "УТ11" ИЛИ ТекКонф = "КА24" ИЛИ ТекКонф = "ERP" ИЛИ ТекКонф = "БГУ" Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ФИОФизическихЛицСрезПоследних.Фамилия КАК Фамилия,
		|	ФИОФизическихЛицСрезПоследних.Имя КАК Имя,
		|	ФИОФизическихЛицСрезПоследних.Отчество КАК Отчество
		|ИЗ
		|	РегистрСведений.ФИОФизическихЛиц.СрезПоследних КАК ФИОФизическихЛицСрезПоследних
		|ГДЕ
		|	ФИОФизическихЛицСрезПоследних.ФизическоеЛицо = &ФизическоеЛицо";
		
		Запрос.УстановитьПараметр("ФизическоеЛицо", ФизЛицо);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			ЗаполнитьЗначенияСвойств(СтруктураФИО, Выборка);
		КонецЕсли;
		
	ИначеЕсли ТекКонф = "БП" ИЛИ ТекКонф = "УТ" ИЛИ ТекКонф = "КА" ИЛИ ТекКонф = "УПП" Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ФИОФизЛицСрезПоследних.Фамилия,
		|	ФИОФизЛицСрезПоследних.Имя,
		|	ФИОФизЛицСрезПоследних.Отчество
		|ИЗ
		|	РегистрСведений.ФИОФизЛиц.СрезПоследних КАК ФИОФизЛицСрезПоследних
		|ГДЕ
		|	ФИОФизЛицСрезПоследних.ФизЛицо = &ФизЛицо";
		
		Запрос.УстановитьПараметр("ФизЛицо", ФизЛицо);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			ЗаполнитьЗначенияСвойств(СтруктураФИО, Выборка);
		КонецЕсли;		
		
	КонецЕсли;
	
	Возврат СтруктураФИО;
	
КонецФункции

// Получить текст запроса для получения исходящих документов
// *Поддержка БП 3.0, УТ11, КА 2.4, БП 2.0, УТ 10.3, КА 1.1, УПП 1.3
//
// Параметры:
//  ОтборПоДате			 - Булево - 
//  ОтборОтправленные	 - Булево - 
//  ОтборКомментарий	 - Булево - 
// 
// Возвращаемое значение:
// Строка  - Текст запроса
//
Функция КЗП_ПолучитьТекстЗапросаИсходящиеДокументы(ОтборПоДате = Ложь, ОтборОтправленные = Ложь, ОтборКомментарий = Ложь)
	
	ТекКонф = КНП_ИмяКонфигурации();
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(""Торг-12"" КАК СТРОКА(50) ) КАК Тип,
	|	Реализация.Номер,
	|	Реализация.Дата,
	|	ВЫБОР КОГДА Реализация.Грузополучатель.DS_Подразделение_ID > 0 ТОГДА Реализация.Грузополучатель ИНАЧЕ Реализация.Контрагент КОНЕЦ КАК Контрагент,
	|	Реализация.СуммаДокумента,
	|	Реализация.Ссылка,
	|	МАКСИМУМ(ЕСТЬNULL(СчетФактураВыданныйДокументыОснования.Ссылка, НЕОПРЕДЕЛЕНО)) КАК СФ
	|ПОМЕСТИТЬ ВТДокументы
	|ИЗ
	|	Документ.{КЗП_РеализацияТоваровУслуг} КАК Реализация
	|ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
	|	ПО (СчетФактураВыданныйДокументыОснования.ДокументОснование = Реализация.Ссылка
	|			И СчетФактураВыданныйДокументыОснования.Ссылка.Проведен)
	//+Белов А. 18.02.2026 #UT10-5696
	|ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК СвойствоСтатусДоставки
	|	ПО Реализация.Ссылка = СвойствоСтатусДоставки.Объект
	|		И (СвойствоСтатусДоставки.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СвойстваОбъектов.СтатусДоставки))
	|	ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|	ПО Реализация.Ссылка = РеализацияТоваровУслугТовары.Ссылка
	//-Белов А. 18.02.2026 #UT10-5696
	|ГДЕ
	|	Реализация.Организация = &Организация
	|	И Реализация.Проведен = ИСТИНА
	|	И (ВЫБОР КОГДА Реализация.Грузополучатель.DS_Подразделение_ID > 0 ТОГДА Реализация.Грузополучатель В (&Контрагент) ИНАЧЕ Реализация.ДоговорКонтрагента В (&Договор) КОНЕЦ)
	|	И (Реализация.Дата >= Реализация.ДоговорКонтрагента.ДатаНачалаОбменаЭДО)
	//+Сёмин Р.И. 10.06.2026 #UT10-5917
	|	И НЕ Реализация.ДоговорКонтрагента.ЛицевойСчет
	|	И НЕ Реализация.ДоговорКонтрагента.РозничнаяПродажа
	//-Сёмин Р.И. 10.06.2026 #UT10-5917
	|	{ТоварыУслугиДата}
	|	{ТоварыУслугиКомментарий}
	|   {ОтборПоСтатусуДоставкиДляСамовывоза}
	|
	|СГРУППИРОВАТЬ ПО
	|	Реализация.Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|	{ТЕКСТ_ЗАПРОСА_АКТА}
	|
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(""Счет на оплату"" КАК СТРОКА(50) ),
	|	СчетНаОплату.Номер,
	|	СчетНаОплату.Дата,
	|	СчетНаОплату.Контрагент,
	|	СчетНаОплату.СуммаДокумента,
	|	СчетНаОплату.Ссылка,
	|	Неопределено
	|ИЗ
	|	Документ.{КЗП_СчетКлиенту} КАК СчетНаОплату
	|ГДЕ
	|	СчетНаОплату.Организация = &Организация
	|	И СчетНаОплату.Проведен = ИСТИНА
	|	И СчетНаОплату.Контрагент В (&Контрагент)
	|	И СчетНаОплату.{РеквизитВалюта} = &Валюта
	|	{СчетНаОплатуДата}
	|	{СчетНаОплатуКомментарий}
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|	{ТЕКСТ_ЗАПРОСА_КОРРЕКТИРОВКА}
	|
	|
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(""Акт сверки"" КАК СТРОКА(50) ),
	|	АктСверки.Номер,
	|	АктСверки.Дата,
	|	АктСверки.Контрагент,
	|	0,
	|	АктСверки.Ссылка,
	|	Неопределено
	|ИЗ
	|	Документ.{КЗП_АктСверки} КАК АктСверки
	|ГДЕ
	|	АктСверки.Организация = &Организация
	|	И АктСверки.Проведен = ИСТИНА
	|	И АктСверки.Контрагент В (&Контрагент)
	|	{АктСверкиДата}
	|	{АктСверкиКомментарий}

//+Макрушин Е. 07.04.2026 #UT10-5800
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|	{ТЕКСТ_ЗАПРОСА_АктОРасхожденияхПослеПриемки}
//-Макрушин Е. 07.04.2026 #UT10-5800  
	//+Белов А. 17.06.2026 #UT10-5921
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|	{ТЕКСТ_ЗАПРОСА_ТранспортнаяНакладная}
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|	{ТЕКСТ_ЗАПРОСА_ЗаказЗаявка}
	//-Белов А. 17.06.2026 #UT10-5921
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТДокументы.Тип,
	|	ВТДокументы.Номер,
	|	ВТДокументы.Дата,
	|	ВТДокументы.Контрагент,
	|	ВЫБОР
	|		КОГДА ДопРеквизиты.Значение ЕСТЬ NULL
	|			ТОГДА ""Не отправлен""
	|		ИНАЧЕ ""Документ отправлен""
	|	КОНЕЦ КАК Статус,
	|	ВТДокументы.СуммаДокумента,
	|	ВТДокументы.Ссылка,
	|	ДопРеквизиты.Значение КАК Идентификатор,
	|	ВТДокументы.СФ
	|ИЗ
	|	ВТДокументы КАК ВТДокументы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.{КЗП_РегистрДопСведений} КАК ДопРеквизиты
	|		ПО ВТДокументы.Ссылка = ДопРеквизиты.Объект
	|		и ДопРеквизиты.Свойство = &Свойство
	|	{ОтправленныеОтбор}
	|	УПОРЯДОЧИТЬ ПО
	|	ВТДокументы.Дата УБЫВ";
	
	//+Белов А. 18.02.2026 #UT10-5696
	Если Константы.ЭДО_ВыгружатьКодыМаркировки.Получить() Тогда
		
		ТекстОтбораПоСтатусуДоставки = "
		|И ВЫБОР
		|	КОГДА РеализацияТоваровУслугТовары.ЗаказПокупателя.СпособДоставки = ЗНАЧЕНИЕ(Перечисление.СпособДоставки.Самовывоз)
		|		ТОГДА ЕСТЬNULL(СвойствоСтатусДоставки.Значение, Неопределено)  = Значение(Перечисление.СтатусыДоставки.ТоварПередан)
		|	ИНАЧЕ ИСТИНА
		|КОНЕЦ";
		
