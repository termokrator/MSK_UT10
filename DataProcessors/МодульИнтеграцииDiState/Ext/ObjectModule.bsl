// Получить банк по БИКу (метаданно-ориентированный метод)
// *Поддержка БП 3.0, УТ 11, КА 2.4, БП 2.0, УТ 10.3, КА 1.1, УПП 1.3
//
// Параметры:
//  БИКБанка - Строка	 - Строка БИК банка. Обычно это код справочника
// 
// Возвращаемое значение:
// СправочникСсылка, Неопределено  - Ссылка на банк
//
Функция МОП_ПолучитьБанкПоБИКу(БИКБанка)
	
	МенеджерСправочника = Неопределено;
	СсылкаНаЭлементСправочника = Неопределено;
	
	Если КНП_ЕстьОбъектМетаданных("Банки") Тогда	
		МенеджерСправочника = Справочники.Банки;	
	ИначеЕсли КНП_ЕстьОбъектМетаданных("КлассификаторБанковРФ") Тогда	
		МенеджерСправочника = Справочники.КлассификаторБанковРФ;
	ИначеЕсли КНП_ЕстьОбъектМетаданных("КлассификаторБанков") Тогда
		МенеджерСправочника = Справочники.КлассификаторБанков;
	Иначе
		ДобавитьВЖурнал("Неподдерживаемая конфигурация " + КНП_ИмяКонфигурации(), "МОП_ПолучитьБанкПоБИКу");
	КонецЕсли;
	
	Попытка
		
		СсылкаНаЭлементСправочника = МенеджерСправочника.НайтиПоКоду(БИКБанка);
		
		Если СсылкаНаЭлементСправочника.Пустая() И КНП_ЕстьОбъектМетаданных("КлассификаторБанковРФ") Тогда
			СсылкаНаЭлементСправочника = Справочники.КлассификаторБанковРФ.НайтиПоКоду(БИКБанка);
		КонецЕсли;
		
		Если СсылкаНаЭлементСправочника.Пустая() И КНП_ЕстьОбъектМетаданных("КлассификаторБанков") Тогда
			СсылкаНаЭлементСправочника = Справочники.КлассификаторБанков.НайтиПоКоду(БИКБанка);
		КонецЕсли;
		
	Исключение
		
		СсылкаНаЭлементСправочника = Неопределено;
		ДобавитьВЖурнал(ОписаниеОшибки(), "МОП_ПолучитьБанкПоБИКу");
		
	КонецПопытки;
	
	Возврат СсылкаНаЭлементСправочника;
	
КонецФункции

// Получить страну по коду (метаданно-ориентированный метод)
// *Поддержка БП 3.0, УТ 11, КА 2.4, БП 2.0, УТ 10.3
//
// Параметры:
//  КодСтраны	 - Строка	 - Код страны
// 
// Возвращаемое значение:
// СправочникСсылка  - элемент справочника 
//
Функция МОП_ПолучитьСтрануПоКоду(КодСтраны)
	
	ТекущаяКонфигурация = КНП_ИмяКонфигурации();
	МенеджерСправочника = Неопределено;
	СсылкаНаЭлементСправочника = Неопределено;
	
	Если КНП_ЕстьОбъектМетаданных("СтраныМира") Тогда	
		МенеджерСправочника = Справочники.СтраныМира;
	ИначеЕсли КНП_ЕстьОбъектМетаданных("КлассификаторСтранМира") Тогда
		МенеджерСправочника = Справочники.КлассификаторСтранМира;
	Иначе
		ДобавитьВЖурнал("Неподдерживаемая конфигурация " + ТекущаяКонфигурация, "МОП_ПолучитьСтрануПоКоду");
	КонецЕсли;
	
	Попытка
		СсылкаНаЭлементСправочника = МенеджерСправочника.НайтиПоКоду(КодСтраны);	
	Исключение
		
		СсылкаНаЭлементСправочника = Неопределено;
		ДобавитьВЖурнал(ОписаниеОшибки(), "МОП_ПолучитьСтрануПоКоду");
		
	КонецПопытки;
	
	Возврат СсылкаНаЭлементСправочника;	

КонецФункции

