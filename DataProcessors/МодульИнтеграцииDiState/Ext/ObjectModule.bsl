Процедура API_ПолучитьВерсиюАПИ()
	
	ВерсияAPI = "v1.2";
	ВерсияDiFlow = "6.2";
	Адрес = HostAddress + "/api/info/";
	
	ЗаголовкиЗапроса = Новый Соответствие;
	ТекстJSON = ОбменHTTPJSON(Адрес, ЗаголовкиЗапроса);
	
	Если ТипЗнч(ТекстJSON) = Тип("Соответствие") Тогда
		
		Если ТекстJSON.Получить("current_version") <> Неопределено Тогда
			ВерсияAPI = ТекстJSON.Получить("current_version");
		КонецЕсли;
		
		Если ТекстJSON.Получить("diflow_version") <> Неопределено Тогда
			ВерсияDiFlow = ТекстJSON.Получить("diflow_version");	
		КонецЕсли;
		
	Иначе
		ДобавитьВЖурнал("Не удалось прочитать версию API. Используется минимально возможная версия", "API_ПолучитьВерсиюАПИ");	
	КонецЕсли;

КонецПроцедуры

Функция СформироватьЗаголовкиДляАПИ()	
	
	Заголовки = Новый Соответствие;
	
	Заголовки.Вставить("Api-Version", ВерсияAPI);
	
	Если ЗначениеЗаполнено(ТокенАвторизации) Тогда
		Заголовки.Вставить("Api-Token", ТокенАвторизации);	
	КонецЕсли;
	
	Заголовки.Вставить("Content-type", "application/json");
	
	Возврат Заголовки;	

КонецФункции

Функция API_ПолучитьСписокДоступныхСертификатов(СписокСертификатов)
	
	API_ПолучитьВерсиюАПИ();
	ЗаголовкиЗапроса = СформироватьЗаголовкиДляАПИ();
	
	СтруктураЗапроса = Новый Структура("thumbprints", СписокСертификатов);
	ТелоЗапроса = КНП_ЗаписатьJSONНаСервере(СтруктураЗапроса);
	
	Адрес = "";
	
	Если ВерсияAPI = "v1.2" ИЛИ ВерсияAPI = "v1.3" Тогда
		Адрес = HostAddress + "api/security/certificate/status";	
	КонецЕсли;
	
	ТекстJSON = ОбменHTTPJSON(Адрес, ЗаголовкиЗапроса, Истина, ТелоЗапроса);
	Возврат ТекстJSON;		

КонецФункции

Функция API_АвторизацияПоСертификату(ДанныеАвторизации)
	
	API_ПолучитьВерсиюАПИ();
	ЗаголовкиЗапроса = СформироватьЗаголовкиДляАПИ();
	ТелоЗапроса = КНП_ЗаписатьJSONНаСервере(ДанныеАвторизации);
	Адрес = HostAddress + "/api/security/token";	
	
	ПараметрыВозврата = ЭДО_ПолучитьСтруктуруВозвратаАвторизацииССервером();
	
	ТекстJSON = ОбменHTTPJSON(Адрес, ЗаголовкиЗапроса, Истина, ТелоЗапроса);
	
	Если ТипЗнч(ТекстJSON) = Тип("Соответствие") Тогда
		
		УспехАвторизации = ТекстJSON.Получить("success");
		
		Если УспехАвторизации = Неопределено ИЛИ УспехАвторизации = Ложь Тогда
			
			Если УспехАвторизации = Ложь Тогда
				СообщениеОшибки = ТекстJSON.Получить("codeDescription") + ". Код ошибки: " + ТекстJSON.Получить("code");
			Иначе
				СообщениеОшибки = "Некорректный ответ от сервера!";
			КонецЕсли;
			
			ПараметрыВозврата.ОшибкаАвторизации = Истина;
			ПараметрыВозврата.ТекстОшибки = "Авторизация не удалась: " + СообщениеОшибки;
			Возврат ПараметрыВозврата;
			
		Иначе
			
			ПараметрыВозврата.Вставить("ЗашифрованныйТокен", ТекстJSON.Получить("token").Получить("value") );	
			ВремяПоследнейАвторизации = МестноеВремя(КНП_ПривестиКДате(ТекстJSON.Получить("token").Получить("expireAt") ) ) - 600;
			
		КонецЕсли;
		
	Иначе
		
		ПараметрыВозврата.ОшибкаАвторизации = Истина;
		ПараметрыВозврата.ТекстОшибки = ТекстJSON;
		Возврат ПараметрыВозврата;	
		
	КонецЕсли;
	
	ПараметрыВозврата.Login = СокрЛП("");
	ПараметрыВозврата.Password = СокрЛП("");
	ПараметрыВозврата.Cookie = "";
	ПараметрыВозврата.ВремяПоследнейАвторизации = ВремяПоследнейАвторизации;
	
	Возврат ПараметрыВозврата;

КонецФункции

Функция API_АвторизацияПоПаролю(ДанныеАвторизации)
	
	API_ПолучитьВерсиюАПИ();
	ПараметрыВозврата = ЭДО_ПолучитьСтруктуруВозвратаАвторизацииССервером();
	СтрокаLoginа = "";
	СтрокаПароля = "";
	ЗаголовкиЗапроса = СформироватьЗаголовкиДляАПИ();
	
	ТелоЗапроса = "";		
	
	Если ДанныеАвторизации.Свойство("Login") И ДанныеАвторизации.Свойство("Password") Тогда
		
		СтрокаLoginа = ДанныеАвторизации.Login;
		СтрокаПароля = ДанныеАвторизации.Password;
		Адрес = HostAddress + "/api/security/token";
		СтруктураТела = Новый Структура("email,password", СтрокаLoginа, СтрокаПароля);
		ТелоЗапроса = КНП_ЗаписатьJSONНаСервере(СтруктураТела);	
		
	КонецЕсли;
	
	ТекстJSON = ОбменHTTPJSON(Адрес, ЗаголовкиЗапроса, Истина, ТелоЗапроса);
	
	Если ТипЗнч(ТекстJSON) = Тип("Соответствие") Тогда
		
		УспехАвторизации = ТекстJSON.Получить("success");
		
		Если УспехАвторизации = Неопределено ИЛИ УспехАвторизации = Ложь Тогда
			
			Если УспехАвторизации = Ложь Тогда
				СообщениеОшибки = ТекстJSON.Получить("codeDescription") + ". Код ошибки: " + ТекстJSON.Получить("code");
			Иначе
				СообщениеОшибки = "Некорректный ответ от сервера!";
			КонецЕсли;
			
			ПараметрыВозврата.ОшибкаАвторизации = Истина;
			ПараметрыВозврата.ТекстОшибки = "Авторизация не удалась: " + СообщениеОшибки;
			Возврат ПараметрыВозврата;
			
		Иначе
			
			ТокенАвторизации = ТекстJSON.Получить("token").Получить("value");	
			ВремяПоследнейАвторизации = МестноеВремя(КНП_ПривестиКДате(ТекстJSON.Получить("token").Получить("expireAt") ) ) - 600;
			
		КонецЕсли;
		
	Иначе
		
		ПараметрыВозврата.ОшибкаАвторизации = Истина;
		ПараметрыВозврата.ТекстОшибки = ТекстJSON;
		Возврат ПараметрыВозврата;
		
	КонецЕсли;
	
	ПараметрыВозврата.Login = СокрЛП(СтрокаLoginа);
	ПараметрыВозврата.Password = СокрЛП(СтрокаПароля);
	ПараметрыВозврата.Cookie = Cookie;
	ПараметрыВозврата.ВремяПоследнейАвторизации = ВремяПоследнейАвторизации;
	
	Возврат ПараметрыВозврата;

КонецФункции

Процедура API_ЗакончитьАвторизацию(ПараметрыВозврата)
	//Changelog
	//
	//18.10.2019 - отключена проверка активности компании в случаях, когда версия ДиФлоу старше 6.2
	API_ПолучитьВерсиюАПИ();
	
	
	ДанныеПользователя = API_ПолучитьТекущегоПользователя();
	
	Если ТипЗнч(ДанныеПользователя) <> Тип("Соответствие") Тогда
		
		ДобавитьВЖурнал("Не удалось авторизоваться. Не удалось получить текущего пользователя", "ОсуществитьСоединениеССервером");
		ПараметрыВозврата.ОшибкаАвторизации = Истина;
		ПараметрыВозврата.ТекстОшибки = "Не удалось авторизоваться";
		Возврат;		
		
	КонецЕсли;
	
	Если ДанныеПользователя.Получить("success") <> Неопределено Тогда
		
		СообщениеОшибки = ДанныеПользователя.Получить("codeDescription") + ". Код ошибки: " + ДанныеПользователя.Получить("code");
		ПараметрыВозврата.ОшибкаАвторизации = Истина;
		ПараметрыВозврата.ТекстОшибки = "Авторизация не удалась: " + СообщениеОшибки;
		Возврат;
		
	КонецЕсли;
	
	Попытка
		
		Если ДанныеПользователя.Получить("certificate") <> Неопределено Тогда
			СертификатПользователя 	= ДанныеПользователя.Получить("certificate")	.Получить("thumbprint");
		КонецЕсли;
		
		ДолжностьПодписанта 	= ДанныеПользователя.Получить("employee")		.Получить("position");
		
		Если НЕ ЗначениеЗаполнено(ДолжностьПодписанта) Тогда
			ДолжностьПодписанта = "";
		КонецЕсли;
		
		ФамилияПодписанта 		= ДанныеПользователя.Получить("person")			.Получить("surname");
		
		Если НЕ ЗначениеЗаполнено(ФамилияПодписанта) Тогда
			ФамилияПодписанта = "";
		КонецЕсли;
		
		ИмяПодписанта 			= ДанныеПользователя.Получить("person")			.Получить("name");
		
		Если НЕ ЗначениеЗаполнено(ИмяПодписанта) Тогда
			ИмяПодписанта = "";
		КонецЕсли;
		
		ОтчествоПодписанта 		= ДанныеПользователя.Получить("person")			.Получить("patronymic");
		
		Если НЕ ЗначениеЗаполнено(ОтчествоПодписанта) Тогда
			ОтчествоПодписанта = "";
		КонецЕсли;
		
		ОГРНИП = "";
		
		Если ДанныеПользователя.Получить("company").Получить("type").Получить("systemName") = "IP" Тогда
			ОГРНИП 					= ДанныеПользователя.Получить("company")	.Получить("ogrn");
		КонецЕсли;
		
		ТипПодписанта 			= ДанныеПользователя.Получить("company")		.Получить("type").Получить("systemName") + "-signor";
		ДанныеПодписанта 		= ДолжностьПодписанта 	+ Символы.ПС 
		+ ФамилияПодписанта 	+ Символы.ПС
		+ ИмяПодписанта 		+ Символы.ПС 
		+ ОтчествоПодписанта 	+ Символы.ПС
		+ ТипПодписанта 		+ Символы.ПС
		+ "3"					+ Символы.ПС
		+ ОГРНИП;
		
	Исключение
		СертификатПользователя = "";	
	КонецПопытки;
	
	
	Если ДанныеПользователя.Получить("company") <> Неопределено Тогда
		ТекстJSON = ДанныеПользователя.Получить("company");
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ТекстJSON) Тогда
		ТекстJSON =  API_ПолучитьТекущуюОрганизацию();
	КонецЕсли;
	
	Если ТипЗнч(ТекстJSON) <> Тип("Соответствие") Тогда
		
		ДобавитьВЖурнал("Не удалось авторизоваться. Не удалось получить текущую организацию", "ОсуществитьСоединениеССервером");
		ПараметрыВозврата.ОшибкаАвторизации = Истина;
		ПараметрыВозврата.ТекстОшибки = "Не удалось авторизоваться";
		Возврат;
		
	КонецЕсли;
	
	Если ТекстJSON.Получить("success") <> Неопределено Тогда
		
		СообщениеОшибки = ТекстJSON.Получить("codeDescription") + ". Код ошибки: " + ТекстJSON.Получить("code");
		ПараметрыВозврата.ОшибкаАвторизации = Истина;
		ПараметрыВозврата.ТекстОшибки = "Авторизация не удалась: " + СообщениеОшибки;
		Возврат;
		
	КонецЕсли;
	
	КомпанияАктивирована = ТекстJSON.Получить("infsoobBeenSent");
	
	Если ВерсияDiFlow <> "6.2" Тогда
		КомпанияАктивирована = Истина;
	КонецЕсли;
	
	ИмяОрганизации = ТекстJSON.Получить("name");
	ИНН = ТекстJSON.Получить("inn");
	КПП = ТекстJSON.Получить("division").Получить("kpp");
	ОГРН  = ТекстJSON.Получить("ogrn");
	Организация = МОП_ПолучитьОрганизацию(ИНН, ОГРН, КПП);	
	ИдентификаторКомпании = ТекстJSON.Получить("division").Получить("id");
	
	Если ДанныеПользователя.Получить("employee") <> Неопределено И ДанныеПользователя.Получить("employee").Получить("defaultDivision") <> Неопределено Тогда
		ИдентификаторПодразделения = ДанныеПользователя.Получить("employee").Получить("defaultDivision").Получить("id");	
	Иначе
		ИдентификаторПодразделения = ИдентификаторКомпании;
	КонецЕсли;
	
	ПараметрыВозврата.ИмяОрганизации = ИмяОрганизации;
	ПараметрыВозврата.ИНН = ИНН;
	ПараметрыВозврата.ОГРН = ОГРН;
	ПараметрыВозврата.КПП = КПП;
	ПараметрыВозврата.HostAddress = HostAddress;
	ПараметрыВозврата.ИдентификаторКомпании = ИдентификаторКомпании;
	ПараметрыВозврата.ТекстJSON = ТекстJSON; 
	ПараметрыВозврата.ИдентификаторПодразделения = ИдентификаторПодразделения;
	ПараметрыВозврата.ТокенАвторизации = ТокенАвторизации;
	ПараметрыВозврата.ВерсияAPI = ВерсияAPI;
	ПараметрыВозврата.ОтпечатокСертификата = СертификатПользователя;
	ПараметрыВозврата.ДанныеПодписанта = ДанныеПодписанта;
	ПараметрыВозврата.КомпанияАктивирована = КомпанияАктивирована
	
КонецПроцедуры

