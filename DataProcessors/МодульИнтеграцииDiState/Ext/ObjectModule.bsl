Функция ПФ_СформироватьПечатнуюФормуСчетаНаОплатуXML(ОбъектXML, Подписан = Ложь)
	
	СтруктураДокумента = ПФ_ПолучитьСтруктуруПФСчетНаОплатуПокупателю();
	ПФ_ДополнитьСтруктуруСведениямиОбЭД(СтруктураДокумента);
	ПФ_РазобратьXMLДляПечатнойФормы(СтруктураДокумента, ОбъектXML);
	
	Если СтруктураДокумента = Неопределено Тогда
		Возврат Новый ТабличныйДокумент;
	КонецЕсли;
	
	Если Подписан Тогда 
		СтруктураДокумента.Вставить("ВидПодписи", "Электронная подпись") 
	КонецЕсли;
	
	ТабДок = ПФ_СформироватьПФСчетНаОплатуПокупателю(СтруктураДокумента);
	Возврат ТабДок;	

