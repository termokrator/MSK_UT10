// Получить грузополучателя (метаданно-ориентированный метод)
// *Поддержка БП 3.0, УТ 11, КА 2.4, БП 2.0, УТ 10.3
//
// Параметры:
//  СсылкаНаДокумент - ДокументСсылка	 - Анализируемый документ
// 
// Возвращаемое значение:
// Булево  - 
//
Функция МОП_ПолучитьГрузополучателя(СсылкаНаДокумент)
	
	Результат = Неопределено;
	
	ЕстьРеквизитКонтрагента = КНП_ЕстьРеквизит(СсылкаНаДокумент, "Контрагент");
	
	Если КНП_ЕстьРеквизит(СсылкаНаДокумент, "Грузополучатель") Тогда
		
		Если ЗначениеЗаполнено(СсылкаНаДокумент.Грузополучатель) Тогда
			Результат = СсылкаНаДокумент.Грузополучатель;		
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Результат) И ЕстьРеквизитКонтрагента Тогда

		Если КНП_ЕстьРеквизит(СсылкаНаДокумент, "ДокументОснование") Тогда
			
			Если КНП_ЕстьРеквизит(СсылкаНаДокумент.ДокументОснование, "Грузополучатель") Тогда
				
				Если ЗначениеЗаполнено(СсылкаНаДокумент.ДокументОснование.Грузополучатель) Тогда
					Результат = СсылкаНаДокумент.ДокументОснование.Грузополучатель;		
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Результат) Тогда
			Результат = СсылкаНаДокумент.Контрагент;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция МОП_ПолучитьПокупателя(СсылкаНаДокумент)
	Результат = Неопределено;
	
	ЕстьРеквизитКонтрагента = КНП_ЕстьРеквизит(СсылкаНаДокумент, "Контрагент");
	
