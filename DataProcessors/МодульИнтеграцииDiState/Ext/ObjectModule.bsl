Функция ФОД_ПолучитьСуммуТовара(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	//Changelog
	//
	//22.03.2019 - для счетов-фактур на аванс принудительно НДС в сумме
	//05.04.2019 - исключение расчета НДС в сумме для счетов на оплату
	
	НДСВСумме = Ложь;
	
	Если ТипЗнч(ОбъектЗаполнения) = Тип("Структура") Тогда
		
		Если ОбъектЗаполнения.Свойство("Ссылка") И МОП_ЭтоСчетНаОплату(ОбъектЗаполнения.Ссылка) Тогда
			НДСВСумме = Ложь;	
		ИначеЕсли ОбъектЗаполнения.Свойство("Ссылка") И МОП_ЭтоСчетФактураНаАванс(ОбъектЗаполнения.Ссылка) Тогда
			Возврат Неопределено;	
		ИначеЕсли ОбъектЗаполнения.Свойство("Ссылка") И НЕ МОП_ЭтоСчетФактура(ОбъектЗаполнения.Ссылка) Тогда
			
			НДСВСумме = МОП_ДокументВключаетНДСВСумму(ОбъектЗаполнения.Ссылка, Истина);
			
			Если НДСВСумме = Неопределено Тогда
				НДСВСумме = МОП_НДСВСуммеПоСтавке(ОбъектЗаполнения.СтавкаНДС);
			КонецЕсли;
			
		Иначе
			НДСВСумме = МОП_НДСВСуммеПоСтавке(ОбъектЗаполнения.СтавкаНДС);
		КонецЕсли;
		
		Если НДСВСумме Тогда
			
			Если ОбъектЗаполнения.Свойство("СуммаБезНДС") Тогда
				Возврат ОбъектЗаполнения.СуммаБезНДС - ФОД_ПолучитьСуммуНДСТовара(ВерсияЗаполнения, ОбъектЗаполнения);
			ИначеЕсли ОбъектЗаполнения.Свойство("Сумма") Тогда
				Возврат ОбъектЗаполнения.Сумма - ФОД_ПолучитьСуммуНДСТовара(ВерсияЗаполнения, ОбъектЗаполнения);
			КонецЕсли;
			
		Иначе
			
			Если ОбъектЗаполнения.Свойство("СуммаБезНДС") Тогда
				Возврат ОбъектЗаполнения.СуммаБезНДС;
			ИначеЕсли ОбъектЗаполнения.Свойство("Сумма") Тогда
				Возврат ОбъектЗаполнения.Сумма;
			КонецЕсли;	
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат 0;

КонецФункции

Функция ФОД_ПолучитьСуммуНДСТовара(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	
	Если ТипЗнч(ОбъектЗаполнения) = Тип("Структура") Тогда
		
		Если ОбъектЗаполнения.Свойство("НДС") Тогда
			Возврат ОбъектЗаполнения.НДС;
		ИначеЕсли ОбъектЗаполнения.Свойство("СуммаНДС") Тогда
			Возврат ОбъектЗаполнения.СуммаНДС;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат 0;

КонецФункции

Функция ФОД_ПолучитьСуммуСНДСТовара(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	//Changelog
	//
	//05.04.2019 - исключение для счетов на оплату
	Если МОП_ЭтоСчетФактураНаАванс(ОбъектЗаполнения.Ссылка) Тогда
		
		Если ОбъектЗаполнения.Свойство("СуммаБезНДС") Тогда
			Возврат ОбъектЗаполнения.СуммаБезНДС;
		ИначеЕсли ОбъектЗаполнения.Свойство("Сумма") Тогда
			Возврат ОбъектЗаполнения.Сумма;
		КонецЕсли;		
		
	ИначеЕсли МОП_ЭтоСчетНаОплату(ОбъектЗаполнения.Ссылка) Тогда
		
		НДСВСумме = МОП_ДокументВключаетНДСВСумму(ОбъектЗаполнения.Ссылка, Истина);
		
		Если НДСВСумме Тогда
			Возврат ФОД_ПолучитьСуммуТовара(ВерсияЗаполнения, ОбъектЗаполнения);
		Иначе
			Возврат ФОД_ПолучитьСуммуТовара(ВерсияЗаполнения, ОбъектЗаполнения) + ФОД_ПолучитьСуммуНДСТовара(ВерсияЗаполнения, ОбъектЗаполнения);
		КонецЕсли;
		
	Иначе
		Возврат ФОД_ПолучитьСуммуТовара(ВерсияЗаполнения, ОбъектЗаполнения) + ФОД_ПолучитьСуммуНДСТовара(ВерсияЗаполнения, ОбъектЗаполнения);
	КонецЕсли;

КонецФункции

