Функция ФОД_ЭтоИП(Знач ОбъектЗаполнения)
	
	Если ТипЗнч(ОбъектЗаполнения) = Тип("Структура") Тогда
		
		Если ОбъектЗаполнения.Свойство("ОГРНИП") И ЗначениеЗаполнено(ОбъектЗаполнения.ОГРНИП) Тогда
			Возврат Истина;
		КонецЕсли;
		
	Иначе
		
		Если КНП_ЕстьРеквизит(ОбъектЗаполнения, "ИНН") И ЗначениеЗаполнено(ОбъектЗаполнения.ИНН) Тогда
			Возврат СтрДлина(ОбъектЗаполнения.ИНН) > 10;  
		ИначеЕсли КНП_ЕстьРеквизит(ОбъектЗаполнения, "ГоловнойКонтрагент") И ЗначениеЗаполнено(ОбъектЗаполнения.ГоловнойКонтрагент) Тогда
			Возврат СтрДлина(ОбъектЗаполнения.ГоловнойКонтрагент.ИНН) > 10;
		КонецЕсли;	
		
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции

Функция ФОД_ПолучитьТипКомпании(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	
	Возврат ?(ФОД_ЭтоИП(ОбъектЗаполнения), "IP", "UL");  
	
КонецФункции

Функция ФОД_ПолучитьИмяКомпании(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	
	Если ФОД_ЭтоИП(ОбъектЗаполнения) Тогда
		
		//СтруктураНаименования = КЗП_СформироватьСтруктуруИП(ОбъектЗаполнения);   
		НаименованиеПолное = ОбъектЗаполнения.НаименованиеПолное;
		НаименованиеПолное = СтрЗаменить(НаименованиеПолное, "ИП ", "");
		НаименованиеПолное = СтрЗаменить(НаименованиеПолное, " ИП", "");
		НаименованиеПолное = СтрЗаменить(НаименованиеПолное, "Индивидуальный предприниматель ", ""); 
		НаименованиеПолное = СтрЗаменить(НаименованиеПолное, " Индивидуальный предприниматель", ""); 
		
		Возврат НаименованиеПолное;   
		
	Иначе
		
		Если КНП_ЕстьРеквизит(ОбъектЗаполнения, "НаименованиеПолное") И ЗначениеЗаполнено(ОбъектЗаполнения.НаименованиеПолное) Тогда
			Возврат ОбъектЗаполнения.НаименованиеПолное;
		КонецЕсли;  
		
		Возврат ОбъектЗаполнения.Наименование; 
		
	КонецЕсли;
	
КонецФункции

Функция ФОД_ПолучитьИмяКомпанииГрузоотправитель(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	
	Если ФОД_ЭтоИП(ОбъектЗаполнения) Тогда
		
		//СтруктураНаименования = КЗП_СформироватьСтруктуруИП(ОбъектЗаполнения);   
		НаименованиеПолное = ОбъектЗаполнения.НаименованиеПолное;
		НаименованиеПолное = СтрЗаменить(НаименованиеПолное, "ИП ", "");
		НаименованиеПолное = СтрЗаменить(НаименованиеПолное, " ИП", "");
		НаименованиеПолное = СтрЗаменить(НаименованиеПолное, "Индивидуальный предприниматель ", ""); 
		НаименованиеПолное = СтрЗаменить(НаименованиеПолное, " Индивидуальный предприниматель", ""); 
		
		Возврат НаименованиеПолное;   
		
	Иначе
		
		//+Белов А. 11.03.2024 #UT10-4321
		Если ТипЗнч(ОбъектЗаполнения) = Тип("СправочникСсылка.Организации") 
			И ЗначениеЗаполнено(ОбъектЗаполнения.НаименованиеПодразделения) Тогда
			Возврат ОбъектЗаполнения.НаименованиеПодразделения;	
		КонецЕсли;				
		//-Белов А. 11.03.2024 #UT10-4321
		
		Если КНП_ЕстьРеквизит(ОбъектЗаполнения, "НаименованиеПолное") И ЗначениеЗаполнено(ОбъектЗаполнения.НаименованиеПолное) Тогда
			Возврат ОбъектЗаполнения.НаименованиеПолное;
		КонецЕсли;  
		
		Возврат ОбъектЗаполнения.Наименование; 
		
