Функция ФОД_ПолучитьИдентификаторПолучателя(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	
	Результат = 0;
	
	//+Белов А. 22.07.2026 #UT10-5921 добавил  ИЛИ ТипЗнч(ОбъектЗаполнения) = Тип("ДокументСсылка.ТранспортнаяНакладная")
	Если КНП_ЕстьРеквизит(ОбъектЗаполнения, "Контрагент") ИЛИ ТипЗнч(ОбъектЗаполнения) = Тип("ДокументСсылка.ТранспортнаяНакладная") Тогда
		
		Контрагент = ПолучитьКонтрагентаПоОбъектуЗаполнения(ОбъектЗаполнения); 
		
		Попытка
			
			ИдентификаторыКонтрагента = РС_ПолучитьИдентификаторыКонтрагента(Контрагент);
			
			Если ЗначениеЗаполнено(ИдентификаторыКонтрагента) И ИдентификаторыКонтрагента.Свойство("ИдентификаторПодразделения") Тогда
				Результат = Цел(ИдентификаторыКонтрагента.ИдентификаторПодразделения);
			КонецЕсли;
			
		Исключение
			ДобавитьВЖурнал(ОписаниеОшибки(), "ФОД_ПолучитьИдентификаторПолучателя");	
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция ПолучитьКонтрагентаПоОбъектуЗаполнения(Знач ОбъектЗаполнения) Экспорт
	
	Если ТипЗнч(ОбъектЗаполнения) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		
		ДокументОснование = ОбъектЗаполнения.ДокументОснование; 
		
		Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			
			Если ЗначениеЗаполнено(ДокументОснование.Грузополучатель.DS_Подразделение_ID) Тогда
				Возврат ДокументОснование.Грузополучатель;
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
			
			Если ЗначениеЗаполнено(ДокументОснование.Грузополучатель.DS_Подразделение_ID) Тогда
				Возврат ДокументОснование.Грузополучатель;
			КонецЕсли;
			
		КонецЕсли;
		
		Возврат ДокументОснование.ДоговорКонтрагента;
		
	ИначеЕсли ТипЗнч(ОбъектЗаполнения) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		
		Если ЗначениеЗаполнено(ОбъектЗаполнения.Грузополучатель.DS_Подразделение_ID) Тогда
			Возврат ОбъектЗаполнения.Грузополучатель;
		Иначе
			Возврат ОбъектЗаполнения.ДоговорКонтрагента;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ОбъектЗаполнения) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		
		Если ЗначениеЗаполнено(ОбъектЗаполнения.Грузополучатель.DS_Подразделение_ID) Тогда
			Возврат ОбъектЗаполнения.Грузополучатель;
		Иначе
			Возврат ОбъектЗаполнения.ДоговорКонтрагента;
		КонецЕсли;      
		
	//+Белов А. 22.06.2026 #UT10-5921
	ИначеЕсли ТипЗнч(ОбъектЗаполнения) = Тип("ДокументСсылка.ТранспортнаяНакладная") Тогда
		
		Если ЗначениеЗаполнено(ОбъектЗаполнения.Грузополучатель.DS_Подразделение_ID) Тогда
			Возврат ОбъектЗаполнения.Грузополучатель;
		Иначе
			Возврат ОбъектЗаполнения.ДоговорГрузополучателя;
		КонецЕсли;      
		
	ИначеЕсли ТипЗнч(ОбъектЗаполнения) = Тип("ДокументСсылка.ЗаказЗаявка") Тогда
		
		Если ЗначениеЗаполнено(ОбъектЗаполнения.Контрагент.DS_Подразделение_ID) Тогда
			Возврат ОбъектЗаполнения.Контрагент;
		Иначе
			Возврат ОбъектЗаполнения.ДоговорКонтрагента;
		КонецЕсли;  
		
	//-Белов А. 22.06.2026 #UT10-5921
	Иначе
		
		Возврат ОбъектЗаполнения.ДоговорКонтрагента; 
		
	КонецЕсли;
	
	Возврат Справочники.Контрагенты.ПустаяСсылка();
	
КонецФункции

Функция ФОД_ПолучитьНомерДокумента(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	
	НомерДокумента = "";
	
	Если ТипЗнч(ОбъектЗаполнения) = Тип("Структура") Тогда
		
		Если ОбъектЗаполнения.Свойство("Номер") Тогда
			НомерДокумента = ОбъектЗаполнения.Номер;
		КонецЕсли; 
		
		Если ОбрезатьПрефиксыНомеров Тогда
			
			Если Найти(НомерДокумента, "-") Тогда //Это префиксация по форме БП 3.0 
				
				Поз = Найти(НомерДокумента, "-");
				НомерДокумента = Сред(НомерДокумента, Поз + 1);
				
			ИначеЕсли КНП_ЕстьРеквизит(Организация, "Префикс") И ЗначениеЗаполнено(Организация.Префикс) Тогда
				НомерДокумента = СтрЗаменить(НомерДокумента, Организация.Префикс, "");
			КонецЕсли;
			
			НомерДокумента = КНП_УдалениеВедущихНулей(НомерДокумента);
			
		КонецЕсли;
		
	Иначе
		НомерДокумента = ОбщегоНазначения.ПолучитьНомерНаПечать(ОбъектЗаполнения);
	КонецЕсли;
	
	Возврат НомерДокумента; 
	
КонецФункции 

Функция ФОД_ПолучитьНомерДокументаСПрефиксом(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	
	Организация = Неопределено;     
	УдалятьВедущиеНули = Истина;
	
	Если ОбщегоНазначения.ЕстьРеквизитДокумента("Организация", ОбъектЗаполнения.Метаданные()) Тогда
		Организация = ОбъектЗаполнения.Организация;
	КонецЕсли;
	
	МассивПрефиксовДляОбхода = ОбщегоНазначения.СформироватьМассивПрефиксовПоОрганизации(Организация);
	
	Номер = СокрЛП(ОбъектЗаполнения.Номер);
	Префикс = "";
	
	Для каждого ПрефиксМассива Из МассивПрефиксовДляОбхода Цикл
		
		Если Найти(Номер, ПрефиксМассива) = 1 Тогда 
			
			Номер = Сред(Номер, СтрДлина(ПрефиксМассива) + 1);
			Префикс = Префикс + ПрефиксМассива;
			
		КонецЕсли;
		
	КонецЦикла;  
	
	// удаление ведущих нулей
	Если УдалятьВедущиеНули Тогда 
		
		Пока Лев(Номер, 1) = "0" Цикл
			Номер = Сред(Номер, 2);
		КонецЦикла;
		
	КонецЕсли;
	
	Номер = Префикс + Номер;
	
	Возврат Номер; 
	
КонецФункции


Функция ФОД_ПолучитьДатуДокумента(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	
	Если ТипЗнч(ОбъектЗаполнения) = Тип("Структура") Тогда
		
		Если ОбъектЗаполнения.Свойство("Дата") И ЗначениеЗаполнено(ОбъектЗаполнения.Дата) Тогда
			Возврат Формат(ОбъектЗаполнения.Дата, "ДФ=дд.ММ.гггг");
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(ОбъектЗаполнения.Дата) Тогда
		Возврат Формат(ОбъектЗаполнения.Дата, "ДФ=дд.ММ.гггг");
	КонецЕсли;
	
	Возврат Неопределено;

КонецФункции

Функция ФОД_ПолучитьСуммуДокумента(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	//Changelog
	//
	//22.03.2019 - добавлен обработчик ТЧ Авансы для счетов-фактур
	//18.10.2019 - добавлен учет что объект заполнения - структура
	//12.12.2019 - добавлена конвертация валют
	
	НДСВСумме = Неопределено;
	СуммаДокумента = 0;
	
	Если ТипЗнч(ОбъектЗаполнения) = Тип("Структура") Тогда
		Возврат СуммаДокумента;
	КонецЕсли;
	
	Если МОП_ЭтоСчетФактура(ОбъектЗаполнения) Тогда
		
		Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "Авансы") И ОбъектЗаполнения.Авансы.Количество() > 0 Тогда
			Возврат 0;
		Иначе
			ОбъектЗаполнения = МОП_ПолучитьОснованиеДокумента(ОбъектЗаполнения);
		КонецЕсли;
		
	КонецЕсли;
	
	Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "Товары") И ОбъектЗаполнения.Товары.Количество() > 0 Тогда
		
		Если ОбъектЗаполнения.Товары.Выгрузить().Колонки.Найти("СуммаБезНДС") <> Неопределено Тогда
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Товары.Итог("СуммаБезНДС");	
		Иначе
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Товары.Итог("Сумма");	
		КонецЕсли;
		
	КонецЕсли;
	
	Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "Номенклатура") И ОбъектЗаполнения.Номенклатура.Количество() > 0 Тогда
		
		Если ОбъектЗаполнения.Номенклатура.Выгрузить().Колонки.Найти("СуммаБезНДС") <> Неопределено Тогда
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Номенклатура.Итог("СуммаБезНДС");	
		Иначе
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Номенклатура.Итог("Сумма");	
		КонецЕсли;
		
	КонецЕсли;
	
	Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "Запасы") И ОбъектЗаполнения.Запасы.Количество() > 0 Тогда
		
		Если ОбъектЗаполнения.Запасы.Выгрузить().Колонки.Найти("СуммаБезНДС") <> Неопределено Тогда
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Запасы.Итог("СуммаБезНДС");	
		Иначе
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Запасы.Итог("Сумма");	
		КонецЕсли;
		
	КонецЕсли;
	
	Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "Услуги") И ОбъектЗаполнения.Услуги.Количество() > 0 Тогда
		
		Если ОбъектЗаполнения.Услуги.Выгрузить().Колонки.Найти("СуммаБезНДС") <> Неопределено Тогда
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Услуги.Итог("СуммаБезНДС");	
		Иначе
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Услуги.Итог("Сумма");	
		КонецЕсли;
		
	КонецЕсли;
	
	Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "УслугиОказанные") И ОбъектЗаполнения.УслугиОказанные.Количество() > 0 Тогда
		
		Если ОбъектЗаполнения.УслугиОказанные.Выгрузить().Колонки.Найти("СуммаБезНДС") <> Неопределено Тогда
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.УслугиОказанные.Итог("СуммаБезНДС");	
		Иначе
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.УслугиОказанные.Итог("Сумма");	
		КонецЕсли;
		
	КонецЕсли;
	
	Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "РаботыИУслуги") И ОбъектЗаполнения.РаботыИУслуги.Количество() > 0 Тогда
		
		Если ОбъектЗаполнения.РаботыИУслуги.Выгрузить().Колонки.Найти("СуммаБезНДС") <> Неопределено Тогда
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.РаботыИУслуги.Итог("СуммаБезНДС");	
		Иначе
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.РаботыИУслуги.Итог("Сумма");	
		КонецЕсли;
		
	КонецЕсли;
	
	Если КНП_ЕстьТабЧасть(ОбъектЗаполнения, "Доходы") И ОбъектЗаполнения.Доходы.Количество() > 0 Тогда
		
		Если ОбъектЗаполнения.Доходы.Выгрузить().Колонки.Найти("СуммаБезНДС") <> Неопределено Тогда
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Доходы.Итог("СуммаБезНДС");	
		Иначе
			СуммаДокумента = СуммаДокумента + ОбъектЗаполнения.Доходы.Итог("Сумма");	
		КонецЕсли;
		
	КонецЕсли;
	
	Если НДСВСумме = Неопределено Тогда
		НДСВСумме = МОП_ДокументВключаетНДСВСумму(ОбъектЗаполнения);
	КонецЕсли;
	
	Если КонвертацияВалютПоКурсуДокумента Тогда
		
		ВалютаДокумента = МОП_ПолучитьВалютуДокумента(ОбъектЗаполнения.Ссылка);
		ВалютаДоговора = МОП_ПолучитьВалютуДоговораДокумента(ОбъектЗаполнения.Ссылка);
		
		Если ВалютаДоговора <> ВалютаДокумента Тогда //Требуется перерасчет
			
			СтруктураПараметров = МОП_ПолучитьПараметрыВалютДокумента(ОбъектЗаполнения.Ссылка);
			Курс = СтруктураПараметров.Курс;
			Кратность = СтруктураПараметров.Кратность;
			СуммаДокумента = СуммаДокумента * Курс / Кратность;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если НДСВСумме Тогда
		СуммаДокумента = СуммаДокумента - ФОД_ПолучитьСуммуНДСДокумента(ВерсияЗаполнения, ОбъектЗаполнения);	
	КонецЕсли;
	
	Возврат СуммаДокумента;

КонецФункции

