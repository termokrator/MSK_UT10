Функция ФОД_ПолучитьОГРНИП(ВерсияЗаполнения, Знач ОбъектЗаполнения)
	//Changelog
	//
	//23.10.2019 - добавлена установка в null огрнип при его отсутствии для ИП в случае версии 6.3
	
	Результат = "";	
	Если ФОД_ЭтоИП(ОбъектЗаполнения) Тогда
		
		Если ТипЗнч(ОбъектЗаполнения) = Тип("Структура") И ОбъектЗаполнения.Свойство("ОГРНИП") Тогда
			Результат = ОбъектЗаполнения.ОГРНИП;	
		ИначеЕсли 
			ТипЗнч(ОбъектЗаполнения) = Тип("СправочникСсылка.Организации")
			ИЛИ
			ТипЗнч(ОбъектЗаполнения) = Тип("СправочникСсылка.Контрагенты")
			Тогда
			Результат = МОП_ПолучитьОГРНКонтрагента(ОбъектЗаполнения);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ВерсияЗаполнения = "6.3" И НЕ ЗначениеЗаполнено(Результат) Тогда
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;	

КонецФункции

