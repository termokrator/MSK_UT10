			Возврат "{}";
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Массивы.
	Если ВспомогательныеДанные.Массивы.СодержитТип(Тип) Тогда
		
		Если Значение.Количество() Тогда
			
			// форматирование.
			СледующееСмещение = Смещение + Табуляция;
			
			Первый = Истина; 
			
			Для Каждого Элемент Из Значение Цикл
				
				Если Первый Тогда
					
					Результат = ПереносСтроки + СледующееСмещение + jsonЗаписать(Элемент, Стандарт, ПредставленияСсылок, ВспомогательныеДанные, Неопределено, 
					    СледующееСмещение, Отступ, Табуляция, ПереносСтроки, ПолноеМаскированиеСимволов, МаскированиеКириллицы); 
