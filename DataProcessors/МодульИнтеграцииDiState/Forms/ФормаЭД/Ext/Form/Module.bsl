Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Объект.ВерсияAPI = "v1.2" Тогда
		Элементы.СписокДокументовВЦепочкеИмяФайла.Видимость = Ложь;
	КонецЕсли;
	ОбработатьПараметры(Параметры);
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивДанныхПоДокументу()
	ОбработкаОбъект = ПолучитьОбъектОбработки();
	ДанныеПоПакету = ОбработкаОбъект.ПолучитьДанныеПакетаДокументов(ИдентификаторДокумента);
	Возврат ДанныеПоПакету;	
КонецФункции


&НаСервере
Процедура ПросмотретьДанныеДокумента(Заголовок, Знач ДанныеДокумента, СтатусПодписи, ИмяФайла = Неопределено)
	ОбработкаОбъект = ПолучитьОбъектОбработки();
		
	Если ЗначениеЗаполнено(СсылкаНаДокумент) И ЗначениеЗаполнено(ИмяФайла) Тогда
		ТабДокДокумента = ОбработкаОбъект.ПолучитьПечатнуюФормуНеформализованногоДокумента(СсылкаНаДокумент);
	Иначе
		ДанныеДокумента = ПрочитатьXMLИзBase64(ДанныеДокумента);
		ТабДокДокумента = ОбработкаОбъект.СформироватьПечатнуюФормуXML(ДанныеДокумента, Заголовок, СтатусПодписи);
	КонецЕсли;
КонецПроцедуры


&НаКлиентеНаСервереБезКонтекста
Функция ПрочитатьXMLИзBase64(Знач Base64Строка)
	Base64Строка = СтрЗаменить(Base64Строка, "\/", "/");
	Попытка
		ДвоичныеДанные = Base64Значение(Base64Строка);
	Исключение
		Сообщить("ПрочитатьXMLИзBase64: " + ОписаниеОшибки() );
	КонецПопытки;
	Попытка
		ВременныйФайл = ПолучитьИмяВременногоФайла("xml");
		ДвоичныеДанные.Записать(ВременныйФайл);
		ТекстовыйДокумент = Новый ТекстовыйДокумент;
		ТекстовыйДокумент.Прочитать(ВременныйФайл,"windows-1251");
		Результат = ТекстовыйДокумент.ПолучитьТекст();
		УдалитьФайлы(ВременныйФайл);
		Возврат Результат;
	Исключение
		Сообщить("ПрочитатьXMLИзBase64: " + ОписаниеОшибки() );
		УдалитьФайлы(ВременныйФайл);
	КонецПопытки;
	Возврат "";
КонецФункции

&НаСервере
Процедура ОбработатьПараметры(Знач ПараметрыФормы)
	//Общие параметры формы
	Если ПараметрыФормы.Свойство("КриптоПровайдер") Тогда
		КриптоПровайдер = ПараметрыФормы.КриптоПровайдер;
	КонецЕсли;
	Если ПараметрыФормы.Свойство("СсылкаНаДокумент") Тогда
		СсылкаНаДокумент = ПараметрыФормы.СсылкаНаДокумент;
	КонецЕсли;
	Если ПараметрыФормы.Свойство("ДанныеОВложении") Тогда
		ДанныеОВложении = ПараметрыФормы.ДанныеОВложении;
	КонецЕсли;
	Если Параметры.Свойство("ЭтоСвязанныйКонтейнер") Тогда
		ЭтоСвязанныйКонтейнер = ПараметрыФормы.ЭтоСвязанныйКонтейнер;
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(Объект, ПараметрыФормы,,"СправочникВалюты,СправочникРегионы,СправочникЕдиницыИзмерения");
	Объект.СправочникВалюты.Загрузить(ПараметрыФормы.СправочникВалюты.Выгрузить() );
	Объект.СправочникРегионы.Загрузить(ПараметрыФормы.СправочникРегионы.Выгрузить() );
	Объект.СправочникЕдиницыИзмерения.Загрузить(ПараметрыФормы.СправочникЕдиницыИзмерения.Выгрузить() );
	
	//Параметры контейнера
	Если ПараметрыФормы.Свойство("СписокКонтейнера") Тогда
		
		МассивДанныхКонтейнера = ПараметрыФормы.СписокКонтейнера;
		Для Каждого ЭлементДК Из МассивДанныхКонтейнера Цикл
			СтрокаКонтейнера = СписокКонтейнера.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаКонтейнера, ЭлементДК);
			ТипНовогоДокумента = СтрокаКонтейнера.Тип;
		КонецЦикла;
		Если СписокКонтейнера.Количество() = 1 Тогда
			Элементы.СписокКонтейнера.Видимость = Ложь
		КонецЕсли;
		УстановитьПараметрыКарточки(СписокКонтейнера[0]);
	Иначе
		Элементы.СписокКонтейнера.Видимость = Ложь;
		Если ПараметрыФормы.Свойство("СтатусДокумента") Тогда
			СтатусДокумента = ПараметрыФормы.СтатусДокумента;
		КонецЕсли;
		Если ПараметрыФормы.Свойство("Тип") Тогда
			Элементы.ДекорацияНаименованиеДокумента.Заголовок = ПараметрыФормы.Тип;
			ТипНовогоДокумента = ПараметрыФормы.Тип;
		КонецЕсли;
		Если ПараметрыФормы.Свойство("ИдентификаторДокумента") Тогда
			ИдентификаторДокумента = ПараметрыФормы.ИдентификаторДокумента;
		КонецЕсли;
		Если ПараметрыФормы.Свойство("ИдентификаторПакета") Тогда
			ИдентификаторПакета = ПараметрыФормы.ИдентификаторПакета;
		КонецЕсли;
		Если ПараметрыФормы.Свойство("ПредварительныеДанные") Тогда
			ПредварительныеДанные = ПараметрыФормы.ПредварительныеДанные;
		КонецЕсли;
		Если ПараметрыФормы.Свойство("ТребуемыеДействия") Тогда
			ТребуемыеДействия = ПараметрыФормы.ТребуемыеДействия;
		КонецЕсли;
		Если ПараметрыФормы.Свойство("Контрагент") Тогда
			Контрагент = ПараметрыФормы.Контрагент;
		КонецЕсли;
		
		Если ПараметрыФормы.Свойство("ГруппаПроцессинга") Тогда
			ГруппаПроцессинга = ПараметрыФормы.ГруппаПроцессинга;
		КонецЕсли;
		
	КонецЕсли;

	
	
КонецПроцедуры



