&НаКлиенте
Процедура АнализТребуемыхДействий()
	Элементы.ФормаПодписать.Видимость = Ложь;
	Элементы.ФормаПринять.Видимость = Ложь;
	Элементы.ФормаОтклонить.Видимость = Ложь;
	Элементы.ФормаАннулировать.Видимость = Ложь;
	Если Найти(ГруппаПроцессинга, "bilateral") Тогда
		ТребуемыеДействия = "Необходимо принять или отклонить документ";
	КонецЕсли;
	Если ЕстьНеподписанныеДокументы() И НЕ Найти(ТребуемыеДействия, "подписать")  Тогда
		ТребуемыеДействия = "Необходимо подписать документы";
	КонецЕсли;

	Если Найти(ТребуемыеДействия, "подписать") Тогда
		Элементы.ФормаПодписать.Видимость = Истина;
	КонецЕсли;
	Если Найти(ТребуемыеДействия, "принять") Тогда
		Элементы.ФормаПринять.Видимость = Истина;
		Элементы.ФормаОтклонить.Видимость = Истина;
	КонецЕсли;
	Если Найти(ТребуемыеДействия, "ответ") Тогда
		Элементы.ФормаАннулировать.Видимость = Истина;
	КонецЕсли;
	Если Найти(ТребуемыеДействия, "завершен") Тогда
		Элементы.ФормаАннулировать.Видимость = Истина;
	КонецЕсли;
	
	
	Если ЗначениеЗаполнено(СтатусДокумента) Тогда
		Элементы.СтатусДокумента.Видимость = Истина;
		Элементы.ТребуемыеДействия.Заголовок = "Ожидаемые действия";
		Элементы.ТребуемыеДействия.Шрифт = Новый Шрифт("Arial", 10); 
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ТребуемыеДействия) Тогда
		Элементы.ТребуемыеДействия.Видимость = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ЕстьНеподписанныеДокументы()
	Для Каждого Док Из СписокДокументовВЦепочке Цикл
		Если НЕ Док.Подписан Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

