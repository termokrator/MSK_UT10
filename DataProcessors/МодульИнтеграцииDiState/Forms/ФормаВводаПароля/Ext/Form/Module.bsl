
&НаКлиенте
Процедура Да(Команда)
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗапомнитьПароль", Объект.ЗапомнитьПароль);
	Оповестить("DS_ПередачаДанныхПароля", ПараметрыФормы);

	Закрыть(Пароль);
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	АвтоЗаголовок = Ложь;
КонецПроцедуры
