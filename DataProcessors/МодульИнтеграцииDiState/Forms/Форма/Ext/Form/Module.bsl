&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ОкноАвторизацииНаСервисе" Тогда
		Объект.HostAddress 		= Параметр.HostAddress;
		Объект.Login 			= Параметр.Login;
		Объект.ВерсияСервера 	= Параметр.ВерсияСервера;
		Если Параметр.Свойство("Password") Тогда
			Объект.Password 		= Параметр.Password;
		КонецЕсли;
		Если Параметр.ОшибкаАвторизации Тогда	
			Если Параметр.Свойство("ТекстОшибки") Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В процессе авторизации, возникли ошибки. " + Параметр.ТекстОшибки);
			КонецЕсли;
			УстановитьДоступностьЭлементов(Ложь);
			ЭтаФорма.Заголовок = "";
			Элементы.СтатусАвторизации.Заголовок = "Не авторизован";
			Элементы.СтатусАвторизации.ЦветТекста = Новый Цвет(240,15,15);
			Возврат;
		КонецЕсли;
		Если Параметр.Свойство("ОтпечатокСертификата") Тогда
			Объект.ОтпечатокСертификата = Параметр.ОтпечатокСертификата;
			Если Параметр.Свойство("КриптоПровайдер") Тогда
				КриптоПровайдер = Параметр.КриптоПровайдер;
				Элементы.СтатусАвторизации.Заголовок = "Авторизован по сертификату " + Символы.ПС
				+ СформироватьИмяПоСертификату(ПолучитьСертификатПоОтпечатку(Объект.ОтпечатокСертификата) );
			КонецЕсли;
		КонецЕсли;
		//Белов ОбработатьНаличиеСертификата();
		УстановитьДоступностьЭлементов(Истина);
		ЗаполнитьЗначенияСвойств(Объект, Параметр);
		
		ЭтаФорма.Заголовок = "Организация: " + Строка(Объект.Организация); 
		Если ЗначениеЗаполнено(Объект.Login) Тогда
			Элементы.СтатусАвторизации.Заголовок = "Авторизован по логину" + Символы.ПС + Объект.Login;
		КонецЕсли;
		Элементы.СтатусАвторизации.ЦветТекста = Новый Цвет(51,153,102);
		Если ЗначениеЗаполнено(Параметр.ПоследняяКоманда) Тогда
			Выполнить(Параметр.ПоследняяКоманда + "()")
		ИначеЕсли Объект.КомпанияАктивирована Тогда
			//КонтрагентыЗагрузитьЗаново(Элементы.СправочникКонтрагентыКонтрагентыЗагрузитьЗаново);
			//Белов СинхронизацияКонтрагентов();
			//Белов СинхронизацияСправочников(); 
			СинхронизацияРегионов(); //Белов    
			СинхронизацияВалют(); 
			ВыполнитьПроверкуКорректностиРеквизитов();
			//+Белов А. 17.02.2026 #UT10-5706 - занимаем много времени и абсолютно не нужно
			//ОбработкаОбновитьСписок();
			//-Белов А. 17.02.2026 #UT10-5706			
			ИнтервалОбновленияДанныхПриИзменении();
		ИначеЕсли НЕ Объект.КомпанияАктивирована Тогда
			ПолучитьИнфоСообщениеОРегистрации();	
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяСобытия = "ИзменениеСостоянияИсходящихДокументов" Тогда
		ОбновитьСписокИсходящихДокументов();	
	КонецЕсли;
	Если ИмяСобытия = "ИзменениеСостоянияДокументовВОбработке" Тогда
		ОбработкаОбновитьСписок();
	КонецЕсли;
	Если ИмяСобытия = "DS_ПередачаДанныхПароля" Тогда
		ЗаполнитьЗначенияСвойств(Объект, Параметр);		
	КонецЕсли;
	Если ИмяСобытия = "ОбновлениеСпискаКонтрагентов" Тогда
		СинхронизацияКонтрагентов();	
	КонецЕсли;
	
	Элементы.ПодписыватьКвитанцииАвтоматически.Доступность = Объект.ЗапомнитьПароль;
	Если ПодписыватьКвитанцииАвтоматически И НЕ Объект.ЗапомнитьПароль Тогда
		ПодписыватьКвитанцииАвтоматически = Ложь;
	КонецЕсли;
	Элементы.ПриглашенияКонтрагентовКонтрагентыНайтиПоИНН.Видимость = Объект.ВерсияAPI <> "v1.2";
	Элементы.СправочникКонтрагентыСтатусВзаимодействия.Видимость 	= Объект.ВерсияAPI <> "v1.2";
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьРазрешениеСтроки(Элемент)
	РезультатПроверки = ПроверитьРазрешениеСтрокиНаСервере(Элемент.Имя);
	Если ЗначениеЗаполнено(РезультатПроверки) Тогда
		Сообщить(РезультатПроверки);
	КонецЕсли;
	
	//Проверка на уже отправленность
	Если Найти(Элемент.Имя ,"Отправлять") И ДокументБылОтправлен() Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ПроверитьРазрешениеСтрокиЗавершение", ЭтаФорма, Элемент.Имя);
		ПоказатьВопрос(ОписаниеОповещения, "Данный документ уже был отправлен. Хотите продолжить?", РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
	
	//Проверка на запрос от пользователя
	Если Найти(Элемент.Имя ,"Создавать") И ДокументБылСоздан() Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ПроверитьРазрешениеСтрокиЗавершение", ЭтаФорма, Элемент.Имя);
		ПоказатьВопрос(ОписаниеОповещения, "Для данного документа уже есть ссылка в 1С. Хотите продолжить? Предыдущий документ будет помечен на удаление", РежимДиалогаВопрос.ДаНет);
	КонецЕсли;	
КонецПроцедуры
&НаКлиенте
Процедура ПроверитьРазрешениеСтрокиЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		Если Найти(ДополнительныеПараметры, "Отправлять") Тогда
			ОтметитьСтрокуПринудительно();
		КонецЕсли;
		Если Найти(ДополнительныеПараметры, "Создавать") Тогда
			ЗапретитьСозданиеДокумента();
		КонецЕсли;

	Иначе //Ответ да
		
	КонецЕсли;		
КонецПроцедуры
&НаКлиенте
Процедура ВходящиеИсходящиеДокументыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Если НЕ Объект.Отладка Тогда
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры
&НаСервере
Функция МожноОтметитьСтроку(СтрокаТЧ, Признак)
	Если Объект.Отладка Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		Если НЕ СтрокаТЧ.Отправлять Тогда
			Возврат "";
		КонецЕсли;
	Исключение
	КонецПопытки;
	Результат = "";
	Если Признак = "СоздаватьВ1С" Тогда
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.Контрагент) Тогда
			Результат = "Для данного документа не определен контрагент в базе";
		КонецЕсли;
	ИначеЕсли Признак = "СоздаватьВ1С" ИЛИ Признак = "УПД" ИЛИ Признак = "Отправлять" Тогда	
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.Контрагент) Тогда
			Результат = "Для данного документа не определен контрагент в базе";
		ИначеЕсли СтрокаТЧ.Тип <> ОтборПоВидуДокумента И ОтборПоВидуДокумента <> "Все документы" Тогда
			Результат = "Данный документ не соответствует отбору по типу";
		ИначеЕсли СтрокаТЧ.Контрагент <> ОтборПоКонтрагенту И ЗначениеЗаполнено(ОтборПоКонтрагенту) Тогда
			//Результат = "Данный документ не соответствует отбору по контрагенту";
		КонецЕсли;		
	КонецЕсли;
	
	Возврат Результат;
КонецФункции
&НаСервере
Процедура ИзменитьПризнакиСтрок(ИмяКоманды)
	
	Если ИмяКоманды = "ИзменитьСтатусОтправки" Тогда
		Состояние = Истина;
		Если Найти(Элементы.ИсходящиеДокументыИзменитьСтатусОтправки.Заголовок, "Отметить") Тогда
			Состояние = Истина;
			Элементы.ИсходящиеДокументыИзменитьСтатусОтправки.Заголовок = "Снять с отправки";
		Иначе
			Состояние = Ложь;
			Элементы.ИсходящиеДокументыИзменитьСтатусОтправки.Заголовок = "Отметить к отправке";
		КонецЕсли;
		
		
		МассивВыделенныхСтрок = Элементы.ИсходящиеДокументы.ВыделенныеСтроки;
		Если МассивВыделенныхСтрок.Количество() > 0 Тогда
			МассивСтрок = Новый Массив;
			Для Каждого ВыделеннаяСтрока Из МассивВыделенныхСтрок Цикл
				МассивСтрок.Добавить(Объект.ИсходящиеДокументы.НайтиПоИдентификатору(ВыделеннаяСтрока) );	
			КонецЦикла;	
		Иначе
			МассивСтрок = Объект.ИсходящиеДокументы;
		КонецЕсли;
		Для Каждого СтрокаТЧ Из МассивСтрок Цикл
			Если НЕ ЗначениеЗаполнено(МожноОтметитьСтроку(СтрокаТЧ, "Отправлять") ) И НЕ ЗначениеЗаполнено(СтрокаТЧ.Идентификатор) Тогда
				СтрокаТЧ.Отправлять = Состояние;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;   
	
	Если ИмяКоманды = "ИзменитьПризнакУПД" Тогда
		Состояние = Истина;
		Если Найти(Элементы.ИсходящиеДокументыИзменитьПризнакУПД.Заголовок, "Установить") Тогда
			Состояние = Истина;
			Элементы.ИсходящиеДокументыИзменитьПризнакУПД.Заголовок = "Снять признак УПД";
		Иначе
			Состояние = Ложь;
			Элементы.ИсходящиеДокументыИзменитьПризнакУПД.Заголовок = "Установить признак УПД";
		КонецЕсли;
		
		
		МассивВыделенныхСтрок = Элементы.ИсходящиеДокументы.ВыделенныеСтроки;
		Если МассивВыделенныхСтрок.Количество() > 0 Тогда
			МассивСтрок = Новый Массив;
			Для Каждого ВыделеннаяСтрока Из МассивВыделенныхСтрок Цикл
				МассивСтрок.Добавить(Объект.ИсходящиеДокументы.НайтиПоИдентификатору(ВыделеннаяСтрока) );	
			КонецЦикла;	
		Иначе
			МассивСтрок = Объект.ИсходящиеДокументы;
		КонецЕсли;
		Для Каждого СтрокаТЧ Из МассивСтрок Цикл
			Если НЕ ЗначениеЗаполнено(МожноОтметитьСтроку(СтрокаТЧ, "УПД") ) Тогда
				СтрокаТЧ.УПД = Состояние;
			КонецЕсли;
		КонецЦикла;

	КонецЕсли;
	
	Если ИмяКоманды = "ПометитьНаСоздание" Тогда
		
		МассивВыделенныхСтрок = Элементы.ВходящиеДокументы.ВыделенныеСтроки;
		Если МассивВыделенныхСтрок.Количество() > 0 Тогда
			МассивСтрок = Новый Массив;
			Для Каждого ВыделеннаяСтрока Из МассивВыделенныхСтрок Цикл
				МассивСтрок.Добавить(Объект.ВходящиеДокументы.НайтиПоИдентификатору(ВыделеннаяСтрока) );	
			КонецЦикла;	
		Иначе
			МассивСтрок = Объект.ВходящиеДокументы;
		КонецЕсли;
		
		Для Каждого СтрокаТЧ Из МассивСтрок Цикл
			Если ЗначениеЗаполнено(МожноОтметитьСтроку(СтрокаТЧ, "СоздаватьВ1С") ) И ДокументБылСоздан() Тогда
				СтрокаТЧ.СоздаватьВ1С = Ложь;
			Иначе
				СтрокаТЧ.СоздаватьВ1С = Истина;	
			КонецЕсли;
		КонецЦикла;

	КонецЕсли;
КонецПроцедуры
&НаСервере
Функция ПроверитьРазрешениеСтрокиНаСервере(ИмяЭлемента)
	Попытка
		РезультатПроверки = "";
		Если Найти(ИмяЭлемента, "СоздаватьВ1С") Тогда
			СтрокаТЧ = Объект.ВходящиеДокументы.НайтиПоИдентификатору(Элементы.ВходящиеДокументы.ТекущаяСтрока); 
			РезультатПроверки = МожноОтметитьСтроку(СтрокаТЧ, "СоздаватьВ1С");
			Если ЗначениеЗаполнено(РезультатПроверки) Тогда
				СтрокаТЧ.СоздаватьВ1С = Ложь;	
			КонецЕсли;	
		ИначеЕсли Найти(ИмяЭлемента, "УПД") Тогда
			СтрокаТЧ = Объект.ИсходящиеДокументы.НайтиПоИдентификатору(Элементы.ИсходящиеДокументы.ТекущаяСтрока); 
			РезультатПроверки = МожноОтметитьСтроку(СтрокаТЧ, "УПД");
			Если ЗначениеЗаполнено(РезультатПроверки) Тогда
				СтрокаТЧ.УПД = Ложь;	
			КонецЕсли;
		ИначеЕсли Найти(ИмяЭлемента, "Отправлять") Тогда
			СтрокаТЧ = Объект.ИсходящиеДокументы.НайтиПоИдентификатору(Элементы.ИсходящиеДокументы.ТекущаяСтрока); 
			РезультатПроверки = МожноОтметитьСтроку(СтрокаТЧ, "Отправлять");
			Если ЗначениеЗаполнено(РезультатПроверки) Тогда
				СтрокаТЧ.Отправлять = Ложь;	
			КонецЕсли;
		ИначеЕсли Найти(ИмяЭлемента, "УстановитьСоответствиеС1С") Тогда
			СтрокаТЧ = Объект.ВходящиеДокументы.НайтиПоИдентификатору(Элементы.ВходящиеДокументы.ТекущаяСтрока);
			Если НЕ ЗначениеЗаполнено(СтрокаТЧ.Ссылка) Тогда
				РезультатПроверки = "Не определена ссылка на документ, который необходимо привязать к идентификатору документа в ЭДО";
			КонецЕсли;
		КонецЕсли;
		Возврат РезультатПроверки;
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции


