&НаКлиенте
Процедура СохранитьПакетНаДиск(Команда = Неопределено)
	
	Если Объект.ВходящиеДокументы.Количество() = 0 Тогда
		Сообщить("Пустой список входящих документов!");
		Возврат;
	КонецЕсли;
	
	Если ТекущаяДата() - Объект.ВремяПоследнейАвторизации > 600 Тогда //Больше 10 минут прошло - надо переавторизоваться
		ОткрытьОкноАвторизации("СохранитьПакетНаДиск");
		Возврат;
	КонецЕсли;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = "Укажите каталог для сохранения пакета документов";
	ОписаниеОповещения = Новый ОписаниеОповещения("СохранитьПакетНаДискЗавершение", ЭтаФорма);
	Диалог.Показать(ОписаниеОповещения);

КонецПроцедуры
&НаКлиенте
Процедура СохранитьПакетНаДискЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПутьККаталогу = ВыбранныеФайлы[0];
	ДанныеАрхива = ПолучитьМассивДокументовПакетаНаСервере();
	Если НЕ ЗначениеЗаполнено(ДанныеАрхива) Тогда
		Возврат;
	КонецЕсли;
	ИмяАрхива = ПутьККаталогу + "\df_package_" + Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd") + ".zip";
	
	Если ТипЗнч(ДанныеАрхива) = Тип("ДвоичныеДанные") Тогда
		ДанныеАрхива.Записать(ИмяАрхива);
	ИначеЕсли ТипЗнч(ДанныеАрхива) = Тип("СписокЗначений") Тогда
		ЗаписьАрхива = Новый ЗаписьZipФайла(ИмяАрхива);
		Для Каждого ДанныеПакета Из ДанныеАрхива Цикл
			ИмяФайла = ПутьККаталогу + "\" + ДанныеПакета.Представление + ".zip";
			ДанныеПакета.Значение.Записать(ИмяФайла);
			ЗаписьАрхива.Добавить(ИмяФайла);
		КонецЦикла;
		ЗаписьАрхива.Записать();
		Для Каждого ДанныеПакета Из ДанныеАрхива Цикл
			ИмяФайла = ПутьККаталогу + "\" + ДанныеПакета.Представление + ".zip";
			УдалитьФайлы(ИмяФайла);
		КонецЦикла;

		
	Иначе
		Если Найти(ДанныеАрхива, "html") Тогда
			Возврат;
		КонецЕсли;
		ФайлАрхива = Новый ТекстовыйДокумент();
		ФайлАрхива.ДобавитьСтроку(ДанныеАрхива);
		ФайлАрхива.Записать(ИмяАрхива);
	КонецЕсли;
КонецПроцедуры
// Получение массива документов по идентификатору пакета
//
// Возвращаемое значение:
// Строка,ДвоичныеДанные  - Данные файла архива
//
&НаСервере
Функция ПолучитьМассивДокументовПакетаНаСервере()
	ДанныеАрхива = Неопределено;
	МассивПакетов = Новый Массив;
	Попытка
		Для Каждого СтрокаТЧ Из Объект.ВходящиеДокументы Цикл
			Если НЕ СтрокаТЧ.СоздаватьВ1С Тогда
				Продолжить;
			КонецЕсли;
			Если Объект.ВерсияСервера >= 6 Тогда
				МассивПакетов.Добавить(СтрокаТЧ.ИдентификаторДокумента);
			Иначе
				МассивПакетов.Добавить(СтрокаТЧ.ИдентификаторПакета);
			КонецЕсли;
		КонецЦикла;
	Исключение
		ВывестиУведомлениеПользователю(ИнформацияОбОшибке().Причина.Описание);
		Возврат Неопределено;
	КонецПопытки;
	Если МассивПакетов.Количество() = 0 Тогда
		Сообщить("Не выбраны документы для сохранения");
	КонецЕсли;
	ДанныеАрхива = ПолучитьОбъектОбработки().ПолучитьДанныеАрхиваДокументов(МассивПакетов);
	Возврат ДанныеАрхива;
КонецФункции

