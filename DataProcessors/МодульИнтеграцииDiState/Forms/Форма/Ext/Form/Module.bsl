&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если НЕ ЗначениеЗаполнено(Объект.ВерсияСервера) Тогда
		Объект.ВерсияСервера = 6;
	КонецЕсли;
	УстановитьНадписьДатыРелиза();
	
	ЗаполнитьСпискиВыборов();
	ЗаполнитьМетаданныеСсылок();
	УстановитьЗначенияПоУмолчанию();
	ИзменитьВидимостьИдентификаторов();
	ВерсияСервераПриИзменении();
	СтруктураДанных = ПолучитьТокенССервера();
	//Тут - точка взлома лицензии. Предупреждение - будете ломать, сломаются другие функции работы с сервисами, хотя API будет работать. Наверное :)
	Если ЗначениеЗаполнено(СтруктураДанных.Токен) И СтруктураДанных.ДатаДействия > ТекущаяДата() Тогда
		Элементы.СтатусЛицензииТекст.Заголовок = "Лицензия активирована. Срок действия лицензии: " + Формат(СтруктураДанных.ДатаДействия, "ДФ=dd.MM.yyyy");
		ПодключитьОбработчикОжидания("Подключаемый_ПроверитьНаличиеОбновлений", 90, Истина);
		ПодключитьОбработчикОжидания("Подключаемый_ОткрытьОкноАвторизации", 0.5, Истина);	
	Иначе
		Элементы.СтатусЛицензииТекст.Заголовок = "Лицензия не активирована или истекла";
		ПодключитьОбработчикОжидания("Подключаемый_ОткрытьОкноВводаПинкода", 0.5, Истина);
	КонецЕсли;
КонецПроцедуры

