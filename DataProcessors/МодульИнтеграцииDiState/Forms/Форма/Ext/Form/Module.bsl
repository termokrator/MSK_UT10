Функция ПолучитьКонтрагентаДоговора(СсылкаНаКонтрагента)
	
	Возврат СсылкаНаКонтрагента.Владелец;
	
КонецФункции
//Белов

&НаСервере
Функция СоздатьИВернутьДляПодписиДокумент(НомерДокумента)
	ОбъектОбработки = ПолучитьОбъектОбработки();
	Если ЗначениеЗаполнено(НомерДокумента) Тогда
		СтрокаТаблицы = Объект.ИсходящиеДокументы[НомерДокумента-1];
		СтруктураСтрокиТЧ = Новый Структура("Ссылка,УПД, СФ");
		ЗаполнитьЗначенияСвойств(СтруктураСтрокиТЧ, СтрокаТаблицы);
		Возврат ОбъектОбработки.СоздатьXMLДокументаИВернутьДляПодписания(СтруктураСтрокиТЧ);
	КонецЕсли;
КонецФункции
&НаСервере
Функция ОтправитьПодписанныйНовыйДокумент(НомерДокумента, СтрокаКонтента, СтрокаПодписи)
	СтрокаДанных = Объект.ИсходящиеДокументы.Получить(НомерДокумента - 1);
	ОбработкаОбъект = ПолучитьОбъектОбработки();
	ТипДокумента = ВыдатьКорректныйТипДокумента(СтрокаДанных);
	РезультатОтправки = ОбработкаОбъект.ОтправитьПодписанныйДокумент(СтрокаДанных.Контрагент, ТипДокумента, СтрокаКонтента, СтрокаПодписи, СтрокаДанных.Ссылка);
	Если ЗначениеЗаполнено(РезультатОтправки) Тогда
		Если РезультатОтправки.Получить("success") = Истина Тогда
			СтрокаДанных.Статус = РезультатОтправки.Получить("message");
			СтрокаДанных.Идентификатор = РезультатОтправки.Получить("documentId");
		ИначеЕсли РезультатОтправки.Получить("success") = Ложь Тогда
			СтрокаДанных.ОписаниеОшибки = РезультатОтправки.Получить("codeDescription") 
										+ Символы.ПС + ВернутьРазобранныйСписокПроблем(РезультатОтправки.Получить("violations") );
		КонецЕсли;
	КонецЕсли;
КонецФункции
&НаСервере
Функция ПодготовитьСтруктуруЗапросаНаСоздание(НомерДокумента, Контент, Подпись)
	СтрокаДанных = Объект.ИсходящиеДокументы.Получить(НомерДокумента - 1);
	ТипДокумента = ВыдатьКорректныйТипДокумента(СтрокаДанных);
	СтруктураЗапроса = Новый Структура("Контрагент,ТипДокумента,Контент,Подпись,СсылкаНаДокумент");
	
	//Белов
	ОбработкаОбъект = ПолучитьОбъектОбработки();
	
	СтруктураЗапроса.Контрагент = ОбработкаОбъект.ПолучитьКонтрагентаПоОбъектуЗаполнения(СтрокаДанных.Ссылка);//Белов СтрокаДанных.Контрагент;
	СтруктураЗапроса.ТипДокумента = ТипДокумента;
	СтруктураЗапроса.Контент = Контент;
	СтруктураЗапроса.Подпись = Подпись;
	СтруктураЗапроса.СсылкаНаДокумент = СтрокаДанных.Ссылка;
	
	Возврат СтруктураЗапроса;
КонецФункции
&НаСервере
Функция ОтправитьМассивНовыхДокументов(МассивДокументов)
	ОбработкаОбъект = ПолучитьОбъектОбработки();
	РезультатОбработки = ОбработкаОбъект.МассовоСоздатьДокументыВЭДО(МассивДокументов);
	Если ТипЗнч(РезультатОбработки) = Тип("Массив") Тогда
		Для Каждого ЭлементОшибка Из РезультатОбработки Цикл
			РезультатОтправки = ЭлементОшибка.Результат;
			МассивСтрокТаблицы = Объект.ИсходящиеДокументы.НайтиСтроки(Новый Структура("Ссылка", ЭлементОшибка.Ссылка) );
			Если МассивСтрокТаблицы.Количество() = 1 Тогда
				СтрокаДанных = МассивСтрокТаблицы[0];
				Если РезультатОтправки.Получить("success") = Истина Тогда
					СтрокаДанных.Статус = "Документ отправлен";
					СтрокаДанных.Идентификатор = РезультатОтправки.Получить("documentId");
					
					ЗаписатьИсториюОбменаЭДО(СтрокаДанных.Ссылка, ПредопределенноеЗначение("Перечисление.СтатусыОбменаЭДО.Отправка"),, "Документ успешно отправлен: " + Символы.ПС + "Идентификатор документа: " + СтрокаДанных.Идентификатор); //Белов
			
					
				ИначеЕсли РезультатОтправки.Получить("success") = Ложь Тогда
					СтрокаДанных.ОписаниеОшибки = РезультатОтправки.Получить("codeDescription") 
										+ Символы.ПС + ВернутьРазобранныйСписокПроблем(РезультатОтправки.Получить("details") );
										
					ЗаписатьИсториюОбменаЭДО(СтрокаДанных.Ссылка, ПредопределенноеЗначение("Перечисление.СтатусыОбменаЭДО.Отправка"), СтрокаДанных.ОписаниеОшибки, "Ошибка при отправке документа"); //Белов
					
	           КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецФункции

&НаКлиенте
Функция ПрочитатьМассивКонтрагентовИзФайла()
	МассивКонтрагентов = Новый Массив;
	ДанныеПоКонтрагентам = Новый ТекстовыйДокумент;
	ДанныеПоКонтрагентам.Прочитать(ПутьКФайлуДанных);
	Шапка = ДанныеПоКонтрагентам.ПолучитьСтроку(1);
	Если Найти(Шапка, "ИНН") Тогда
		
		Для НомерСтроки = 2 По ДанныеПоКонтрагентам.КоличествоСтрок() Цикл
			КонтрагентСсылка = НайтиКонтрагентаПоИНН(ДанныеПоКонтрагентам.ПолучитьСтроку(НомерСтроки) );
			Если ЗначениеЗаполнено(КонтрагентСсылка) Тогда
				МассивКонтрагентов.Добавить(КонтрагентСсылка);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	Возврат МассивКонтрагентов;
КонецФункции
&НаСервере
Функция НайтиКонтрагентаПоИНН(ИНН)
	Возврат Справочники.Контрагенты.НайтиПоРеквизиту("ИНН", ИНН);	
КонецФункции

&НаСервере
Функция ПолучитьКоличествоДокументовКОтправке()
	Количество = 0;
	Для Каждого СтрокаТЧ Из Объект.ИсходящиеДокументы Цикл
		Если СтрокаТЧ.Отправлять Тогда
			Количество = Количество + 1;	
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;
КонецФункции

&НаКлиенте
Процедура ОткрытьНовыйДокументПроцессинга(НомерСтроки = Неопределено) 
	Если ТекущаяДата() - Объект.ВремяПоследнейАвторизации > 600 Тогда //Больше 10 минут прошло - надо переавторизоваться
		ОткрытьОкноАвторизации("ОткрытьНовыйДокументПроцессинга");
		Возврат;
	КонецЕсли;
	Если НомерСтроки = Неопределено Тогда
		НомерСтроки = Элементы.ИсходящиеДокументы.ТекущиеДанные.НомерСтроки;
	КонецЕсли;

	СтрокаТЧ = Объект.ИсходящиеДокументы.Получить(НомерСтроки - 1);
	
	ПараметрыФормы = Новый Структура;

	КонтентДляПодписи = СоздатьИВернутьДляПодписиДокумент(НомерСтроки);
	Если ТипЗнч(КонтентДляПодписи) = Тип("Соответствие") Тогда
		Если КонтентДляПодписи.Получить("success") <> Неопределено И КонтентДляПодписи.Получить("success") Тогда
			СтрокаКонтента = КонтентДляПодписи.Получить("content");
		ИначеЕсли КонтентДляПодписи.Получить("success") <> Неопределено Тогда
			КонтентОшибки = КонтентДляПодписи.Получить("violations");       
			codeDescription = КонтентДляПодписи.Получить("codeDescription");
			
			Если КонтентОшибки = Неопределено Тогда
				
				error = КонтентДляПодписи.Получить("error");
				Объект.ИсходящиеДокументы.Получить(НомерСтроки - 1).ОписаниеОшибки = ?(ЗначениеЗаполнено(codeDescription), codeDescription, "Ошибка:") + Символы.ПС + ?(ЗначениеЗаполнено(error), error, "");	
				
			Иначе			
				Объект.ИсходящиеДокументы.Получить(НомерСтроки - 1).ОписаниеОшибки = ?(ЗначениеЗаполнено(codeDescription), codeDescription, "Ошибка:") + Символы.ПС + ?(ЗначениеЗаполнено(КонтентОшибки), ВернутьРазобранныйСписокПроблем(КонтентДляПодписи.Получить("violations") ), КонтентДляПодписи.Получить("violation"));	     
			КонецЕсли;
						 
			Возврат;
		КонецЕсли;
	ИначеЕсли ТипЗнч(КонтентДляПодписи) = Тип("Структура") Тогда
		Если КонтентДляПодписи.Свойство("content") Тогда
			СтрокаКонтента = КонтентДляПодписи.content;
			Если КонтентДляПодписи.Свойство("originFileName") Тогда
				ПараметрыФормы.Вставить("ДанныеОВложении", КонтентДляПодписи.originFileName);
			КонецЕсли;
		Иначе
			Объект.ИсходящиеДокументы.Получить(НомерСтроки - 1).ОписаниеОшибки = "Не удалось получить печатную форму неформализованного документа";
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ТипДока = ВыдатьКорректныйТипДокумента(СтрокаТЧ); 
	
	//+Белов А. 14.07.2026 #UT10-5954
	Если ТипДока = "Транспортная накладная" ИЛИ ТипДока = "Заказ-заявка" Тогда
		
		Сообщить("Документ был предварительно сформирован успешно, но для этого вида документа еще не готова печатная форма предварительного просмотра");
		Возврат;
		
	КонецЕсли;
	//-Белов А. 14.07.2026 #UT10-5954
	
	ПараметрыФормы.Вставить("КриптоПровайдер", КриптоПровайдер);
	ПараметрыФормы.Вставить("СтатусДокумента", СтрокаТЧ.Статус);
	Если ЗначениеЗаполнено(СтрокаТЧ.Идентификатор) Тогда
		ПараметрыФормы.Вставить("ТребуемыеДействия", "Можно повторно подписать и отправить документ");
	Иначе
		ПараметрыФормы.Вставить("ТребуемыеДействия", "Требуется подписать документ");
	КонецЕсли;
	ПараметрыФормы.Вставить("Тип", ТипДока);
	ПараметрыФормы.Вставить("СправочникВалюты", Объект.СправочникВалюты);
	ПараметрыФормы.Вставить("СправочникРегионы", Объект.СправочникРегионы);
	ПараметрыФормы.Вставить("СправочникЕдиницыИзмерения", Объект.СправочникЕдиницыИзмерения);
	ПараметрыФормы.Вставить("ВерсияСервера", Объект.ВерсияСервера);
	ПараметрыФормы.Вставить("ВерсияAPI", Объект.ВерсияAPI);
	ПараметрыФормы.Вставить("HostAddress", Объект.HostAddress);
	ПараметрыФормы.Вставить("ОтпечатокСертификата", Объект.ОтпечатокСертификата);
	ПараметрыФормы.Вставить("ТокенАвторизации", Объект.ТокенАвторизации);
	ПараметрыФормы.Вставить("ПредварительныеДанные", СтрокаКонтента);
	ПараметрыФормы.Вставить("Контрагент", СтрокаТЧ.Контрагент);
	ПараметрыФормы.Вставить("СсылкаНаДокумент", СтрокаТЧ.Ссылка);
	ПараметрыФормы.Вставить("ИдентификаторОрганизации", Объект.ИдентификаторОрганизации);
	ПараметрыФормы.Вставить("ИдентификаторПодразделения", Объект.ИдентификаторПодразделения);
	ПараметрыФормы.Вставить("ДанныеПодписанта", Объект.ДанныеПодписанта);
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	ПараметрыФормы.Вставить("СессионныйПароль", Объект.СессионныйПароль);
	ПараметрыФормы.Вставить("ЗапомнитьПароль", Объект.ЗапомнитьПароль);
	ОткрытьФорму(ПолучитьПутьКОбработке() + "ФормаЭД",ПараметрыФормы,ЭтаФорма,Истина,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ВыдатьКорректныйТипДокумента(СтрокаДанных)
	
	ТипДокумента = СтрокаДанных.Тип;
	Если СтрокаДанных.УПД И НЕ Найти(ТипДокумента, "Счет на оплату") Тогда
		Если ТипДокумента <> "Акт сверки" Тогда
			Если НЕ Найти(Строка(СтрокаДанных.Ссылка), "фактур")  Тогда
				Если Найти(ТипДокумента, "коррект") Тогда
					ТипДокумента = "УКД";  
				//+Белов А. 14.07.2026 #UT10-5954
				ИначеЕсли ТипДокумента = "Транспортная накладная" Тогда
					ТипДокумента = "Транспортная накладная";
				ИначеЕсли ТипДокумента = "Заказ-заявка" Тогда
					ТипДокумента = "Заказ-заявка";
				//-Белов А. 14.07.2026 #UT10-5954
				Иначе
					ТипДокумента = "УПД";
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат ТипДокумента;
	
КонецФункции

#КонецОбласти

#Область РегистрацияИнфоСообы

&НаКлиенте
Процедура ПолучитьИнфоСообщениеОРегистрации() 
	ТекстИнфоСооба = ПолучитьИнфоСообщениеОРегистрацииНаСервере();
	Если ТипЗнч(ТекстИнфоСооба) = Тип("Строка") Тогда
		ПараметрыФормы = Новый Структура("Контент", ТекстИнфоСооба);
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершитьРегистрацию", ЭтаФорма, ПараметрыФормы);
		ОткрытьОкноВопроса("Необходимо подписать информационное сообщение о согласии на ЭДО. Подписать?", ОписаниеОповещения);
	КонецЕсли;
КонецПроцедуры
&НаКлиенте
Процедура ЗавершитьРегистрацию(Ответ, ПараметрыФормы) Экспорт
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Если Объект.ЗапомнитьПароль Тогда
		ЗавершитьРегистрациюПродолжение(Объект.СессионныйПароль, ПараметрыФормы);	
	Иначе	
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершитьРегистрациюПродолжение", ЭтаФорма, ПараметрыФормы);
		ОткрытьФорму("ВнешняяОбработка.МодульИнтеграцииDiState.Форма.ФормаВводаПароля",,ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;		
КонецПроцедуры
&НаКлиенте
Процедура ЗавершитьРегистрациюПродолжение(СтрокаПароля, ПараметрыФормы) Экспорт
	Если СтрокаПароля = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	Объект.СессионныйПароль = СтрокаПароля;
	Попытка
		ДвоичныеДанныеДокумента = Base64Значение(ПараметрыФормы.Контент);
		Если Объект.ОтпечатокСертификата = Неопределено Тогда
			Возврат;
		КонецЕсли;
		СтрокаПодписи = ПодписатьДокументЭП(ДвоичныеДанныеДокумента, СтрокаПароля);
		Если ПроверитьПодписьДокумента(ПараметрыФормы.Контент, СтрокаПодписи) Тогда
			ОтправитьИнфоСообщениеНаСервере(ПараметрыФормы.Контент, СтрокаПодписи);
		КонецЕсли;
	Исключение
		ВывестиУведомлениеПользователю(ИнформацияОбОшибке().Описание);
	КонецПопытки;
КонецПроцедуры
&НаСервере
Функция ПолучитьИнфоСообщениеОРегистрацииНаСервере()
	ОбработкаОбъект = ПолучитьОбъектОбработки();
	Контент = ОбработкаОбъект.ПолучитьИнфоСообщение();
	Возврат Контент;
КонецФункции
&НаСервере
Функция ОтправитьИнфоСообщениеНаСервере(Контент, Подпись)
	ОбработкаОбъект = ПолучитьОбъектОбработки();
	Результат = ОбработкаОбъект.ОтправитьПодписанноеИнфоСообщение(Контент, Подпись);	
КонецФункции


#КонецОбласти

#Область РазделДокументыВОбработке

#Область __ОбновлениеСпискаДокументов
	

&НаКлиенте
Процедура ОбработкаОбновитьСписок(Команда = Неопределено)	
	Если ТекущаяДата() - Объект.ВремяПоследнейАвторизации > 600 Тогда //Больше 10 минут прошло - надо переавторизоваться
		ОткрытьОкноАвторизации("ОбработкаОбновитьСписок");
		Возврат;
	КонецЕсли;
	
	Если ПодписыватьКвитанцииАвтоматически Тогда
		ПодписатьКвитанции(Команда);	
	Иначе
		
		//ТекстСообщения = "Обновление информации о документах в обработке";
		//ФормаДлительнойОперации = ОткрытьФорму("ОбщаяФорма.ДлительнаяОперация",
		//Новый Структура("ИдентификаторЗадания, ТекстСообщения", УникальныйИдентификатор, ТекстСообщения), 
		//ВладелецФормы);
		ОбработкаОбновитьСписокНаСервере();
		//ФормаДлительнойОперации.Закрыть();
		
	КонецЕсли;
КонецПроцедуры
&НаКлиенте
Процедура ОбновитьСписокДокументов() Экспорт
	ОбработкаОбновитьСписокНаСервере();	
	ПоказатьОповещениеПользователя("Обновление списка",,"Обновлен список документов к обработке");
КонецПроцедуры
&НаКлиенте
Процедура ОбновитьСписокДокументовАвтоматически() Экспорт
	Если ПодписыватьКвитанцииАвтоматически Тогда
		ПодписатьКвитанции();	
	Иначе
		ОбновитьСписокДокументов();		
	КонецЕсли;	
КонецПроцедуры
&НаСервере
Процедура ОбработкаОбновитьСписокНаСервере()
	ОбработкаОбъект = ПолучитьОбъектОбработки();
	ТаблицаДанных = ОбработкаОбъект.ПолучитьДокументыВОбработке(НачалоПериода, КонецПериода);
	Объект.ДокументыВОбработке.Загрузить(ТаблицаДанных);
	Если Объект.ДокументыВОбработке.Количество() > 0 Тогда
		Элементы.РазделДокументыВОбработке.Заголовок = "В обработке (" + Объект.ДокументыВОбработке.Количество() + ")";
	Иначе
		Элементы.РазделДокументыВОбработке.Заголовок = "В обработке";
	КонецЕсли;
	СформироватьТабличныйДокументВОбработке();
КонецПроцедуры
&НаСервере
Процедура СформироватьТабличныйДокументВОбработке()
	ТабличныйДокументВОбработке.Очистить();
	ОбработкаОбъект = ПолучитьОбъектОбработки();
	Макет = ОбработкаОбъект.ПолучитьМакет("МАКЕТ_ТабличныйДокументВОбработке");
	
	ОбластьШапки = Макет.ПолучитьОбласть("ОбластьШапка" + ?(ПоказыватьИдентификаторы, "Служебный", "") );
	ОбластьСтроки = Макет.ПолучитьОбласть("ОбластьСтрока" + ?(ПоказыватьИдентификаторы, "Служебный", "") );
	ТабличныйДокументВОбработке.ФиксацияСверху = ?(ПоказыватьИдентификаторы, 2, 1);
	
	МассивВыведенныхСтрок = Новый Массив;
	СтруктураДанныхСтроки = ПолучитьСтруктуруДанныхСтрокиВОбработке();
	ТабличныйДокументВОбработке.Вывести(ОбластьШапки);
	Для Каждого СтрокаДанных Из Объект.ДокументыВОбработке Цикл
		Если МассивВыведенныхСтрок.Найти(СтрокаДанных) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ОбластьСтроки.Области[0].ГраницаСверху = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);
		ОбластьСтроки.Области[0].ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);
			
		
		Если ЗначениеЗаполнено(СтрокаДанных.ИДКонтейнера) Тогда
			ПараметрыПоиска = Новый Структура("ИДКонтейнера", СтрокаДанных.ИДКонтейнера);
			МассивСтрок = Объект.ДокументыВОбработке.НайтиСтроки(ПараметрыПоиска);
			ЭтоПервыйЭлемент = Истина;
			Для Каждого СтрокаКонтейнера Из МассивСтрок Цикл
				ЗаполнитьСтруктуруДанных(СтруктураДанныхСтроки, СтрокаКонтейнера);
				СтруктураДанныхСтроки.ЭтоКонтейнер = "К";
				ОбластьСтроки.Области[0].ГраницаСверху = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
				ОбластьСтроки.Области[0].ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
				Если НЕ ЭтоПервыйЭлемент Тогда
					СтруктураДанныхСтроки.Направление = "";
				Иначе
					ОбластьСтроки.Области[0].ГраницаСверху = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);	
				КонецЕсли;
				
				ЗаполнитьЗначенияСвойств(ОбластьСтроки.Параметры, СтруктураДанныхСтроки);
				ТабличныйДокументВОбработке.Вывести(ОбластьСтроки);
				МассивВыведенныхСтрок.Добавить(СтрокаКонтейнера);
				ЭтоПервыйЭлемент = Ложь;
			КонецЦикла;
			
		Иначе //Выводим и заполняем строку
			ЗаполнитьСтруктуруДанных(СтруктураДанныхСтроки, СтрокаДанных);
			ЗаполнитьЗначенияСвойств(ОбластьСтроки.Параметры, СтруктураДанныхСтроки);
			ТабличныйДокументВОбработке.Вывести(ОбластьСтроки);
			МассивВыведенныхСтрок.Добавить(СтрокаДанных);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
&НаСервере
Функция ПолучитьСтруктуруДанныхСтрокиВОбработке()
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("Направление");
	СтруктураДанных.Вставить("ЭтоКонтейнер");
	СтруктураДанных.Вставить("ТипДокумента");
	СтруктураДанных.Вставить("Номер");
	СтруктураДанных.Вставить("Дата");
	СтруктураДанных.Вставить("ИДДокумента");
	СтруктураДанных.Вставить("СтатусДокумента");
	СтруктураДанных.Вставить("ОтправительКонтрагент");
	СтруктураДанных.Вставить("ПолучательКонтрагент");
	СтруктураДанных.Вставить("ИДОтправителя");
	СтруктураДанных.Вставить("ИДПолучателя");
	СтруктураДанных.Вставить("НомерСтроки");
	Возврат СтруктураДанных;
КонецФункции
&НаСервере
Процедура ЗаполнитьСтруктуруДанных(СтруктураДанных, СтрокаДанных)
	СтруктураДанных.Направление = ?(СтрокаДанных.Исходящий, "OUT", "IN");
	СтруктураДанных.ЭтоКонтейнер = "";
	СтруктураДанных.ТипДокумента = СтрокаДанных.Тип;
	СтруктураДанных.Номер = СтрокаДанных.Номер;
	СтруктураДанных.Дата = Формат(СтрокаДанных.Дата, "ДФ=dd.MM.yyyy");
	СтруктураДанных.ИДДокумента = СтрокаДанных.ИдентификаторДокумента;
	СтруктураДанных.СтатусДокумента = СтрокаДанных.ОжидаемыеДействия;
	СтруктураДанных.ОтправительКонтрагент = Строка(СтрокаДанных.Отправитель);
	СтруктураДанных.ПолучательКонтрагент = Строка(СтрокаДанных.Получатель);
	СтруктураДанных.ИДОтправителя = СтрокаДанных.ИдентификаторОтправителя;
	СтруктураДанных.ИДПолучателя = СтрокаДанных.ИдентификаторПолучателя;
	СтруктураДанных.НомерСтроки = СтрокаДанных.НомерСтроки;	
КонецПроцедуры

	
#КонецОбласти

#Область __ОткрытиеДокумента

&НаКлиенте
Процедура ТабличныйДокументВОбработкеОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	СтандартнаяОбработка = Ложь;
	ОткрытьДокументПроцессинга(Расшифровка);
КонецПроцедуры
&НаКлиенте
Процедура ДокументыВОбработкеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ОткрытьДокументПроцессинга(Элемент.ТекущиеДанные.НомерСтроки);		
КонецПроцедуры
&НаКлиенте
Процедура ОткрытьДокументПроцессинга(НомерСтроки = Неопределено)
	Если ТекущаяДата() - Объект.ВремяПоследнейАвторизации > 600 Тогда //Больше 10 минут прошло - надо переавторизоваться
		ОткрытьОкноАвторизации("ОткрытьДокументПроцессинга");
		Возврат;
	КонецЕсли;
	Если НомерСтроки = Неопределено Тогда
		НомерСтроки = Элементы.ДокументыВОбработке.ТекущиеДанные.НомерСтроки;
	КонецЕсли;
	ЭтоСвязанныйКонтейнер = Ложь;
	СтрокаТЧ = Объект.ДокументыВОбработке.Получить(НомерСтроки - 1);
	МассивСтрокТЧ = Новый Массив;
	Если ЗначениеЗаполнено(СтрокаТЧ.ИДКонтейнера) И СтрокаТЧ.СвязныйКонтейнер Тогда
		ПараметрыОтбора = Новый Структура("ИДКонтейнера", СтрокаТЧ.ИДКонтейнера);
		МассивСтрокТЧ = Объект.ДокументыВОбработке.НайтиСтроки(ПараметрыОтбора);
		ЭтоСвязанныйКонтейнер = Истина;
	Иначе
		МассивСтрокТЧ.Добавить(СтрокаТЧ);
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("КриптоПровайдер", 				КриптоПровайдер);
	ПараметрыФормы.Вставить("СправочникВалюты", 			Объект.СправочникВалюты);
	ПараметрыФормы.Вставить("СправочникРегионы", 			Объект.СправочникРегионы);
	ПараметрыФормы.Вставить("СправочникЕдиницыИзмерения", 	Объект.СправочникЕдиницыИзмерения);
	ПараметрыФормы.Вставить("ВерсияСервера", 				Объект.ВерсияСервера);
	ПараметрыФормы.Вставить("ВерсияAPI", 					Объект.ВерсияAPI);
	ПараметрыФормы.Вставить("ВерсияDiFlow", 				Объект.ВерсияDiFlow);
	ПараметрыФормы.Вставить("HostAddress", 					Объект.HostAddress);
	ПараметрыФормы.Вставить("ОтпечатокСертификата", 		Объект.ОтпечатокСертификата);
	ПараметрыФормы.Вставить("ТокенАвторизации", 			Объект.ТокенАвторизации);
	ПараметрыФормы.Вставить("ИдентификаторОрганизации", 	Объект.ИдентификаторОрганизации);
	ПараметрыФормы.Вставить("ИдентификаторПодразделения", 	Объект.ИдентификаторПодразделения);
	ПараметрыФормы.Вставить("ДанныеПодписанта", 			Объект.ДанныеПодписанта);
	ПараметрыФормы.Вставить("Организация", 					Объект.Организация);
	ПараметрыФормы.Вставить("СессионныйПароль", 			Объект.СессионныйПароль);
	ПараметрыФормы.Вставить("ЗапомнитьПароль", 				Объект.ЗапомнитьПароль);
	ПараметрыФормы.Вставить("ЭтоСвязанныйКонтейнер",		ЭтоСвязанныйКонтейнер);
	
	МассивДанныхКонтейнера = Новый Массив;
	Для Каждого СтрокаТЧ Из МассивСтрокТЧ Цикл
		СтруктураДК = Новый Структура("Контрагент,ГруппаПроцессинга,СтатусДокумента,ТребуемыеДействия,Тип,ИдентификаторДокумента,СистемноеИмя");
		СтруктураДК.Контрагент 								= ?(СтрокаТЧ.Исходящий, СтрокаТЧ.Получатель, СтрокаТЧ.Отправитель);
		СтруктураДК.ГруппаПроцессинга 						= СтрокаТЧ.ГруппаПроцессинга;
		СтруктураДК.СтатусДокумента 						= СтрокаТЧ.СтатусДокумента;
		СтруктураДК.ТребуемыеДействия					 	= СтрокаТЧ.ОжидаемыеДействия;
		СтруктураДК.Тип 									= СтрокаТЧ.Тип;
		СтруктураДК.ИдентификаторДокумента 					= СтрокаТЧ.ИдентификаторДокумента;
		СтруктураДК.СистемноеИмя							= СтрокаТЧ.СистемноеИмя;
		СтруктураДК.Вставить("Номер", СтрокаТЧ.Номер);
		СтруктураДК.Вставить("Дата", СтрокаТЧ.Дата);
		МассивДанныхКонтейнера.Добавить(СтруктураДК);
	КонецЦикла;
	ПараметрыФормы.Вставить("СписокКонтейнера", МассивДанныхКонтейнера);
	ОткрытьФорму(ПолучитьПутьКОбработке() + "ФормаЭД",ПараметрыФормы,ЭтаФорма,Истина,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
КонецПроцедуры

#КонецОбласти

#Область __ПодписаниеДокументов

&НаКлиенте
Процедура ПодписатьКвитанции(Команда = Неопределено)
	Если ТекущаяДата() - Объект.ВремяПоследнейАвторизации > 600 Тогда //Больше 10 минут прошло - надо переавторизоваться
		ОткрытьОкноАвторизации("ПодписатьКвитанции");
		Возврат;
	КонецЕсли;
	
	Если Объект.ЗапомнитьПароль Тогда
		ПодписатьКвитанцииЗавершение(Объект.СессионныйПароль);	
	Иначе	
		ОписаниеОповещения = Новый ОписаниеОповещения("ПодписатьКвитанцииЗавершение", ЭтаФорма);
		ОткрытьФорму("ВнешняяОбработка.МодульИнтеграцииDiState.Форма.ФормаВводаПароля",,ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;	
КонецПроцедуры
&НаКлиенте
Процедура ПодписатьКвитанцииСЗадержкой() Экспорт
	ПодписатьКвитанцииЗавершение(Объект.СессионныйПароль);	
КонецПроцедуры
&НаКлиенте
Процедура ПодписатьКвитанцииЗавершение(СтрокаПароля, ДополнительныеПараметры = Неопределено) Экспорт
	ЗакрыватьПоОкончании = Истина;
	Если СтрокаПароля = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	Объект.СессионныйПароль = СтрокаПароля;
	
	МассивСтруктурНаПодпись = ПолучитьДокументыНаПодписьНаСервере();
	КоличествоНаПодпись = МассивСтруктурНаПодпись.Количество();
	СчетчикВыгруженных = 0;
	
	ФормаСтатуса = Неопределено;
	Если ФормаСтатуса = Неопределено Тогда
		ФормаСтатуса = ПолучитьФорму(ПолучитьПутьКОбработке() + "ФормаСтатусаОтправки",, ВладелецФормы);
		ФормаСтатуса.ПоказатьСтатусСозданияДокументов(Ложь);
		ФормаСтатуса.ПоказатьСтатусОтправкиДокументов(Ложь);
	КонецЕсли;
	ФормаСтатуса.ОбновитьСтатусСозданияКвитанций("Подписано квитанций: 0 из " + КоличествоНаПодпись);
	
	Если КоличествоНаПодпись > 0 Тогда
		
		
		
		Если Объект.ВерсияAPI = "v1.2" Тогда
			
			ИДЗадания = Новый УникальныйИдентификатор;
			ТекстСообщения = "Осуществляется подписание квитанций";
			ФормаДлительнойОперации = ПолучитьФорму("ОбщаяФорма.ДлительнаяОперация",
			Новый Структура("ИдентификаторЗадания, ТекстСообщения", ИДЗадания, ТекстСообщения), 
			ВладелецФормы);
			ФормаДлительнойОперации.Открыть();
			
			
			Для Каждого ДокСтруктура Из МассивСтруктурНаПодпись Цикл
				Попытка
					СтрокаКонтента = ДокСтруктура.Контент;
					ДвоичныеДанныеДокумента = Base64Значение(СтрокаКонтента);
					Если Объект.ОтпечатокСертификата = Неопределено Тогда
						Возврат;
					КонецЕсли;
					СтрокаПодписи = ПодписатьДокументЭП(ДвоичныеДанныеДокумента, СтрокаПароля);
					ОтправитьПодписаннуюКвитанцию(ДокСтруктура.ИдентификаторДокумента, СтрокаКонтента, СтрокаПодписи);
					
					СчетчикВыгруженных = СчетчикВыгруженных + 1;
					ТекстСообщения = "Подписано квитанций: " + СчетчикВыгруженных + " из " + КоличествоНаПодпись;
					ФормаДлительнойОперации.Элементы.ДекорацияПоясняющийТекстДлительнойОперации.Заголовок = ТекстСообщения;
					ФормаДлительнойОперации.ОбновитьОтображениеДанных();
					
				Исключение
					ВывестиУведомлениеПользователю(ИнформацияОбОшибке().Описание);
					Объект.ЗапомнитьПароль = Ложь;
				КонецПопытки;
			КонецЦикла;
			ФормаДлительнойОперации.Закрыть();
			
		Иначе //Метод быстрого массового подписания	 
			ФормаСтатуса.Открыть();
			МассивПодписанных = Новый Массив;
			
			Для Каждого ДокСтруктура Из МассивСтруктурНаПодпись Цикл
				Попытка
					СтрокаКонтента = ДокСтруктура.Контент;
					ДвоичныеДанныеДокумента = Base64Значение(СтрокаКонтента);
					Если Объект.ОтпечатокСертификата = Неопределено Тогда
						Возврат;
					КонецЕсли;
					СтрокаПодписи = ПодписатьДокументЭП(ДвоичныеДанныеДокумента, СтрокаПароля);
					МассивПодписанных.Добавить(ПодготовитьСтруктуруЗапросаНаПодписание(ДокСтруктура.ИдентификаторДокумента, СтрокаКонтента, СтрокаПодписи) );
					СчетчикВыгруженных = СчетчикВыгруженных + 1;
					Если СчетчикВыгруженных % ПорцияОтправки = 0 ИЛИ СчетчикВыгруженных = КоличествоНаПодпись Тогда					
						ФормаСтатуса.ОбновитьСтатусСозданияКвитанций("Подписано квитанций: " + СчетчикВыгруженных + " из " + КоличествоНаПодпись);
						ФормаСтатуса.ОбновитьОтображениеДанных();
						ОтправитьМассивПодписанныхДокументов(МассивПодписанных);
						ФормаСтатуса.ОбновитьСтатусОтправкиКвитанций("Отправлено квитанций: " + СчетчикВыгруженных + " из " + КоличествоНаПодпись);
						ФормаСтатуса.ОбновитьОтображениеДанных();
						МассивПодписанных.Очистить();
					КонецЕсли;
				Исключение
					ВывестиУведомлениеПользователю(ИнформацияОбОшибке().Описание);
					Объект.ЗапомнитьПароль = Ложь;
				КонецПопытки;
			КонецЦикла;	
			
		КонецЕсли;
		
		Если СчетчикВыгруженных = 0 Тогда
			ФормаСтатуса.ОбновитьСтатусСозданияКвитанций("Не удалось создать ни одного документа!",,Истина);
		Иначе
			ФормаСтатуса.ОбновитьСтатусСозданияКвитанций(,Истина);	
		КонецЕсли;
		ФормаСтатуса.ОбновитьОтображениеДанных();
		Если МассивПодписанных.Количество() > 0 Тогда
			ОтправитьМассивПодписанныхДокументов(МассивПодписанных);
			ФормаСтатуса.ОбновитьСтатусОтправкиКвитанций("Квитанции отправлены", Истина);
			ФормаСтатуса.ОбновитьОтображениеДанных();
		КонецЕсли;
	КонецЕсли;
	
	
	
	Если ЗакрыватьПоОкончании Тогда
		Если ФормаСтатуса.Открыта() Тогда ФормаСтатуса.Закрыть() КонецЕсли;
	КонецЕсли;
	ОбновитьСписокДокументов();
	
КонецПроцедуры
&НаСервере
Функция ПолучитьДокументыНаПодписьНаСервере() 
	ОбработкаОбъект = ПолучитьОбъектОбработки();
	Возврат ОбработкаОбъект.ПолучитьДокументыНаПодпись();
КонецФункции
&НаСервере
Функция ОтправитьПодписаннуюКвитанцию(ИДДокумента, СтрокаКонтента, СтрокаПодписи)
	ОбработкаОбъект = ПолучитьОбъектОбработки();
	РезультатОтправки = ОбработкаОбъект.ПодписатьДокумент(ИДДокумента, СтрокаКонтента, СтрокаПодписи);
КонецФункции
&НаКлиенте
Функция ПодготовитьСтруктуруЗапросаНаПодписание(ИдентификаторДокумента, Контент, Подпись)
	СтруктураЗапроса = Новый Структура("ИдентификаторДокумента,Контент,Подпись");
	СтруктураЗапроса.ИдентификаторДокумента = ИдентификаторДокумента;
	СтруктураЗапроса.Контент = Контент;
	СтруктураЗапроса.Подпись = Подпись;
	
	Возврат СтруктураЗапроса;
КонецФункции
&НаСервере
Функция ОтправитьМассивПодписанныхДокументов(МассивДокументов)
	ОбработкаОбъект = ПолучитьОбъектОбработки();
	РезультатОбработки = ОбработкаОбъект.МассовоОтправитьПодписанныеДокументы(МассивДокументов);	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область РазделВходящиеДокументы

&НаКлиенте
Процедура ПолучитьДокументы(Команда = Неопределено)
	
	Если ТекущаяДата() - Объект.ВремяПоследнейАвторизации > 600 Тогда //Больше 10 минут прошло - надо переавторизоваться
		ОткрытьОкноАвторизации("ПолучитьДокументы");
		Возврат;
	КонецЕсли;

	
	ТекстСообщения = "Осуществляется загрузка документов из ЭДО";
	ФормаДлительнойОперации = ОткрытьФорму("ОбщаяФорма.ДлительнаяОперация",
		Новый Структура("ИдентификаторЗадания, ТекстСообщения", Новый УникальныйИдентификатор, ТекстСообщения), 
		ВладелецФормы);
		
	ПолучитьДокументыНаСервере();
	
	Если НЕ ОтборПоОбработанным Тогда
		МассивУдаляемых = Новый Массив;
		Для Каждого СтрокаВД Из Объект.ВходящиеДокументы Цикл
			Если ЗначениеЗаполнено(СтрокаВД.Ссылка) Тогда
				МассивУдаляемых.Добавить(СтрокаВД);	
			КонецЕсли;
		КонецЦикла;
		Для Каждого УдаляемаяСтрока Из МассивУдаляемых Цикл
			Объект.ВходящиеДокументы.Удалить(УдаляемаяСтрока);	
		КонецЦикла;
		ОбновитьОтображениеДанных();
	КонецЕсли;
	
	ФормаДлительнойОперации.Закрыть();
	Элементы.РазделыДокументов.ТекущаяСтраница = Элементы.РазделДокументыВходящие;
КонецПроцедуры
&НаСервере
Процедура ПолучитьДокументыНаСервере()
	ОбъектОбработки = ПолучитьОбъектОбработки();
	Результат = ОбъектОбработки.ЗагрузкаДокументов(НачалоПериода, КонецПериода);
	Если ТипЗнч(Результат) = Тип("Строка") Тогда
		ВывестиУведомлениеПользователю(Результат);
	ИначеЕсли ТипЗнч(Результат) = Тип("ТаблицаЗначений") Тогда
		Объект.ВходящиеДокументы.Загрузить(Результат); 
	КонецЕсли;
	Объект.ВремяПоследнейАвторизации = ОбъектОбработки.ВремяПоследнейАвторизации;	
	
	//2018.10.09 Проверка на заполненность ссылок и вывод сообщения клиенту если есть незаполненные
	ВсеКонтрагентыЗаполнены = Истина;
	Для Каждого СтрокаВД Из Объект.ВходящиеДокументы Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаВД.Контрагент) Тогда
			ВсеКонтрагентыЗаполнены = Ложь;
			Прервать;
		КонецЕсли;	
	КонецЦикла;
	Если НЕ ВсеКонтрагентыЗаполнены Тогда
		ВывестиУведомлениеПользователю("Не все контрагенты из ЭДО были найдены в 1С. 
									   |Пожалуйста, выполните синхронизацию контрагентов на закладке ""Справочники""");
	КонецЕсли;
	//2018.10.09
КонецПроцедуры

&НаКлиенте
Процедура СоздатьВ1С(Команда)
	Если Объект.ВходящиеДокументы.Количество() = 0 Тогда
		Сообщить("Пустой список входящих документов!");
		Возврат;
	КонецЕсли;
	Если ПолучитьКоличествоДокументовКСозданию() = 0 Тогда
		Сообщить("Нет выбранных документов к созданию!");
		Возврат;
	КонецЕсли;
	
	
	//Прежде чем создавать документы в 1С - осуществляем сопоставление номенклатур. Для этого необходимо
	//прочитать табличные части, после этого вывести форму для сопоставления, если все ок - продолжить
	Если Объект.СопоставлятьНоменклатурыПередЗагрузкой Тогда
		ПрочитатьДанныеТЧДокументовДляНоменклатуры();
	Иначе
		СоздатьВ1СПроверкаСтатейЗатрат();
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура СоздатьВ1СПроверкаСтатейЗатрат(Результат = Неопределено, ДопПараметры = Неопределено) Экспорт
	//Прежде чем создавать документы в 1С - осуществляем сопоставление статей затрат. Для этого необходимо
	//прочитать табличные части, после этого вывести форму для сопоставления, если все ок - продолжить
	Если Объект.СопоставлятьСтатьиЗатратПередЗагрузкой Тогда
		ПрочитатьДанныеТЧДокументовДляСтатей();
	Иначе
		СоздатьВ1СПродолжение();
	КонецЕсли;
КонецПроцедуры
&НаКлиенте
Функция ПрочитатьДанныеТЧДокументовДляНоменклатуры()
	КоличествоДокументовКСозданию = Объект.ВходящиеДокументы.Количество();
	МассивНомеров = Новый Массив;
	Для НомерДокумента = 1 По КоличествоДокументовКСозданию Цикл
		Если Объект.ВходящиеДокументы.Получить(НомерДокумента - 1).СоздаватьВ1С Тогда
			МассивНомеров.Добавить(НомерДокумента);		
		КонецЕсли;
	КонецЦикла;		
	МассивСтруктурДанных = ПолучитьСтруктуруНесопоставленныхНоменклатур(МассивНомеров);
	Если МассивСтруктурДанных.Количество() > 0 Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("СоздатьВ1СПроверкаСтатейЗатрат", ЭтаФорма);
		ПараметрыФормы = Новый Структура("Организация,СопоставлениеПриЗагрузке,ДанныеСопоставления", Объект.Организация, Истина, МассивСтруктурДанных);
		ОткрытьФорму(ПолучитьПутьКОбработке() + "ФормаСопоставленияНоменклатур",ПараметрыФормы,ЭтаФорма,Истина,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		СоздатьВ1СПроверкаСтатейЗатрат();
	КонецЕсли;
КонецФункции
&НаКлиенте
Функция ПрочитатьДанныеТЧДокументовДляСтатей()
	КоличествоДокументовКСозданию = Объект.ВходящиеДокументы.Количество();
	МассивНомеров = Новый Массив;
	Для НомерДокумента = 1 По КоличествоДокументовКСозданию Цикл
		Если Объект.ВходящиеДокументы.Получить(НомерДокумента - 1).СоздаватьВ1С Тогда
			МассивНомеров.Добавить(НомерДокумента);		
		КонецЕсли;
	КонецЦикла;		
	МассивСтруктурДанных = ПолучитьСтруктуруНесопоставленныхСтатей(МассивНомеров);
	Если МассивСтруктурДанных.Количество() > 0 Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("СоздатьВ1СПродолжение", ЭтаФорма);
		ПараметрыФормы = Новый Структура("Организация,СопоставлениеПриЗагрузке,ДанныеСопоставления", Объект.Организация, Истина, МассивСтруктурДанных);
		ОткрытьФорму(ПолучитьПутьКОбработке() + "ФормаСопоставленияСтатейРасходов",ПараметрыФормы,ЭтаФорма,Истина,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		СоздатьВ1СПродолжение();
	КонецЕсли;
КонецФункции

&НаСервере
Функция ПолучитьСтруктуруНесопоставленныхНоменклатур(МассивНомеров)
	ОбъектОбработки = ПолучитьОбъектОбработки();
	МассивДанных = Новый Массив;
	Для Каждого НомерДокумента Из МассивНомеров Цикл
		СтрокаТаблицы = Объект.ВходящиеДокументы[НомерДокумента-1];
		СтруктураСтрокиТЧ = Новый Структура("Тип,ИдентификаторДокумента,Ссылка,ДанныеДокумента,ОписаниеОшибки,Контрагент");
		ЗаполнитьЗначенияСвойств(СтруктураСтрокиТЧ, СтрокаТаблицы);
		СтруктураСтрокиТЧ.ДанныеДокумента = ПрочитатьXMLИзBase64(СтруктураСтрокиТЧ.ДанныеДокумента);
		МассивСтруктурДанных = ОбъектОбработки.НайтиНесопоставленнуюНоменклатуру(СтруктураСтрокиТЧ);
		Для Каждого СтруктураДанных Из МассивСтруктурДанных Цикл  //Дополняем итоговый массив
			МассивДанных.Добавить(СтруктураДанных);
		КонецЦикла;
	КонецЦикла;
	Возврат МассивДанных;	
КонецФункции
&НаСервере
Функция ПолучитьСтруктуруНесопоставленныхСтатей(МассивНомеров)
	ОбъектОбработки = ПолучитьОбъектОбработки();
	МассивДанных = Новый Массив;
	Для Каждого НомерДокумента Из МассивНомеров Цикл
		СтрокаТаблицы = Объект.ВходящиеДокументы[НомерДокумента-1];
		СтруктураСтрокиТЧ = Новый Структура("Тип,ИдентификаторДокумента,Ссылка,ДанныеДокумента,ОписаниеОшибки,Контрагент");
		ЗаполнитьЗначенияСвойств(СтруктураСтрокиТЧ, СтрокаТаблицы);
		СтруктураСтрокиТЧ.ДанныеДокумента = ПрочитатьXMLИзBase64(СтруктураСтрокиТЧ.ДанныеДокумента);
		МассивСтруктурДанных = ОбъектОбработки.НайтиНесопоставленныеСтатьи(СтруктураСтрокиТЧ);
		Для Каждого СтруктураДанных Из МассивСтруктурДанных Цикл  //Дополняем итоговый массив
			МассивДанных.Добавить(СтруктураДанных);
		КонецЦикла;
	КонецЦикла;
	Возврат МассивДанных;	
КонецФункции


&НаКлиенте
Процедура СоздатьВ1СПродолжение(Результат = Неопределено, ДопПараметры = Неопределено) Экспорт
	Счетчик = 0;	
	ИДЗадания = Новый УникальныйИдентификатор;
	ТекстСообщения = "Осуществляется создание документов 1С";
	ФормаДлительнойОперации = ПолучитьФорму("ОбщаяФорма.ДлительнаяОперация",
		Новый Структура("ИдентификаторЗадания, ТекстСообщения", ИДЗадания, ТекстСообщения), 
		ВладелецФормы);
	ФормаДлительнойОперации.Открыть();
	КоличествоДокументовКСозданию = Объект.ВходящиеДокументы.Количество();
	Для НомерДокумента = 1 По КоличествоДокументовКСозданию Цикл
		Если Объект.ВходящиеДокументы.Получить(НомерДокумента - 1).СоздаватьВ1С Тогда
			СоздатьВ1СНаСервере(НомерДокумента);
			Счетчик = Счетчик + 1;
			ТекстСообщения = "Обработано " + Счетчик + " из " + ПолучитьКоличествоДокументовКСозданию() + " документов";
			
			ФормаДлительнойОперации.Элементы.ДекорацияПоясняющийТекстДлительнойОперации.Заголовок = ТекстСообщения;
			ФормаДлительнойОперации.ОбновитьОтображениеДанных();
		КонецЕсли;
	КонецЦикла; 
	ФормаДлительнойОперации.Закрыть();	
КонецПроцедуры
&НаСервере
Процедура СоздатьВ1СНаСервере(НомерДокумента = Неопределено)
	ОбъектОбработки = ПолучитьОбъектОбработки();
	Если ЗначениеЗаполнено(НомерДокумента) Тогда
		СтрокаТаблицы = Объект.ВходящиеДокументы[НомерДокумента-1];
		СтруктураСтрокиТЧ = Новый Структура("Тип,ИдентификаторДокумента,Ссылка,ДанныеДокумента,ОписаниеОшибки,Контрагент");
		ЗаполнитьЗначенияСвойств(СтруктураСтрокиТЧ, СтрокаТаблицы);
		СтруктураСтрокиТЧ.ДанныеДокумента = ПрочитатьXMLИзBase64(СтруктураСтрокиТЧ.ДанныеДокумента);
		ОбъектОбработки.СоздатьДокументВ1С(СтруктураСтрокиТЧ);
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтруктураСтрокиТЧ,,"ДанныеДокумента");
		СтрокаТаблицы.СоздаватьВ1С = Ложь;
	КонецЕсли;
КонецПроцедуры
&НаКлиентеНаСервереБезКонтекста
Функция ПрочитатьXMLИзBase64(Знач Base64Строка)
	Base64Строка = СтрЗаменить(Base64Строка, "\/", "/");
	Попытка
		ДвоичныеДанные = Base64Значение(Base64Строка);
	Исключение
		Сообщить("ПрочитатьXMLИзBase64: " + ОписаниеОшибки() );
	КонецПопытки;
	Попытка
		ВременныйФайл = ПолучитьИмяВременногоФайла("xml");
		ДвоичныеДанные.Записать(ВременныйФайл);
		ТекстовыйДокумент = Новый ТекстовыйДокумент;
		ТекстовыйДокумент.Прочитать(ВременныйФайл,"windows-1251");
		Результат = ТекстовыйДокумент.ПолучитьТекст();
		УдалитьФайлы(ВременныйФайл);
		Возврат Результат;
	Исключение
		Сообщить("ПрочитатьXMLИзBase64: " + ОписаниеОшибки() );
		УдалитьФайлы(ВременныйФайл);
	КонецПопытки;
	Возврат "";
КонецФункции

&НаКлиенте
Процедура УстановитьСоответствиеС1С(Команда)
	Для Каждого СтрокаТЧ Из Объект.ВходящиеДокументы Цикл
		Если НЕ СтрокаТЧ.СоздаватьВ1С Тогда
			Продолжить;
		КонецЕсли;
		РезультатПроверки = ПроверитьРазрешениеСтрокиНаСервере(Команда.Имя);
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.Ссылка) Тогда
			Сообщить("Нельзя привязать документ " + СтрокаТЧ.ИдентификаторДокумента + " к пустой ссылке");
		Иначе
			УстановитьСоответствиеС1СНаСервере();	
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
&НаСервере
Процедура УстановитьСоответствиеС1СНаСервере()
	Попытка
		СтрокаТЧ = Объект.ВходящиеДокументы.НайтиПоИдентификатору(Элементы.ВходящиеДокументы.ТекущаяСтрока);
		ПолучитьОбъектОбработки().ПривязатьИдентификаторКОбъекту1С(СтрокаТЧ.Ссылка, СтрокаТЧ.ИдентификаторДокумента, Истина);
	Исключение
	КонецПопытки;
КонецПроцедуры

