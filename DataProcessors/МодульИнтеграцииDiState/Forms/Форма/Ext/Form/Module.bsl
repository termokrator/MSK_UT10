Процедура ОткрытьФормуДокумента(Команда = Неопределено)
	ЗаголовокФормы = "";
	Попытка
		ОткрытьОбработанныйДокументПроцессинга(Элементы.ВходящиеДокументы.ТекущиеДанные.НомерСтроки);	
	Исключение
	КонецПопытки;		
