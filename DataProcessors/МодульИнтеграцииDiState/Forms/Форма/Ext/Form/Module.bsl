КонецПроцедуры
&НаСервере
Процедура ПриЗакрытииНаСервере()
	ПолучитьОбъектОбработки().ЗаписатьЖурналВФайл();
КонецПроцедуры
&НаСервере
Процедура ОтладчикНаСервере()
	Объект.Отладка = НЕ Объект.Отладка;
	Элементы.ФормаОтладчик.Заголовок = ?(Объект.Отладка, "Отключить отладку", "Включить отладку");
	Элементы.РежимОтладки.Заголовок = ?(Объект.Отладка, "Включен режим отладки", "");
	//Элементы.Организация.ТолькоПросмотр	= НЕ Объект.Отладка;
	Если Объект.Отладка Тогда
		Выборка = Справочники.Организации.Выбрать();
		Выборка.Следующий();
		Объект.Организация = Выборка.Ссылка;
		ЭтаФорма.Заголовок = "Организация: " + Строка(Объект.Организация);
	КонецЕсли;
КонецПроцедуры
&НаКлиенте
Процедура Подключаемый_ОткрытьОкноАвторизации()
	ОткрытьОкноАвторизации();	
КонецПроцедуры
&НаКлиенте
Процедура ОткрытьОкноАвторизации(ПоследняяКоманда = Неопределено) 
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("HostAddress", Объект.HostAddress);
	ПараметрыФормы.Вставить("Login", Объект.Login); 
	ПараметрыФормы.Вставить("Password", Объект.Password); 
	ПараметрыФормы.Вставить("ПоследняяКоманда", ПоследняяКоманда);
	ПараметрыФормы.Вставить("ВерсияСервера", Объект.ВерсияСервера);
	ОткрытьФорму(ПолучитьПутьКОбработке() + "ФормаАвторизации",ПараметрыФормы,ЭтаФорма,Истина,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры
&НаКлиенте
Процедура ОбработатьНаличиеСертификата()
	Элементы.РазделДокументыИсходящие.Доступность = Ложь;
	Если ЗначениеЗаполнено(Объект.ОтпечатокСертификата) Тогда
		Сертификат = ПолучитьСертификатПоОтпечатку(Объект.ОтпечатокСертификата);
		Если Сертификат = Неопределено Тогда
			ВывестиУведомлениеПользователю("Зарегистрированный сертификат недоступен в вашей системе.
										| Система будет работать в ограниченном режиме!");
		Иначе
			Элементы.РазделДокументыИсходящие.Доступность = Истина;
		Конецесли;
	Иначе
		ВывестиУведомлениеПользователю("На текущего пользователя не зарегистрирован ни один сертификат.
										| Система будет работать в ограниченном режиме!");
	КонецЕсли;
КонецПроцедуры
&НаСервере
Функция ПрочитатьЖурналРегистрации()
	ОбработкаОбъект = ПолучитьОбъектОбработки();
	Возврат ОбработкаОбъект.ПрочитатьЖурналИзФайла();	
КонецФункции
&НаСервере
Процедура ОчиститьЖурнал()
	ОбработкаОбъект = ПолучитьОбъектОбработки();
	ОбработкаОбъект.ОчиститьЖурналВФайле();	
КонецПроцедуры

&НаСервере
Функция СформироватьИсториюИзменений()
	ТабДок = Новый ТабличныйДокумент;
	Обработка = ПолучитьОбъектОбработки();
	Макет = Обработка.ПолучитьМакет("ОписаниеИзмененийВерсии");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.НомерВерсии = "2.3.2";
	ОбластьШапка.Параметры.ДатаВыпуска = "22.10.2019";
	ТабДок.Вывести(ОбластьШапка);
	ТабДок.Вывести(Макет.ПолучитьОбласть("ИзмененияВерсии23") );
	ТабДок.Вывести(Макет.ПолучитьОбласть("ИзмененияВерсии22") );
	ТабДок.Вывести(Макет.ПолучитьОбласть("ИзмененияВерсии21") );
	ТабДок.Вывести(Макет.ПолучитьОбласть("ИзмененияВерсии20") );
	ТабДок.ОтображатьСетку = Ложь;
	Возврат ТабДок;
КонецФункции

&НаКлиенте
Процедура ОтправитьПредложение(Команда)
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("КриптоПровайдер", КриптоПровайдер);
	ПараметрыФормы.Вставить("Организация", Объект.Организация); 
	ПараметрыФормы.Вставить("ОтпечатокСертификата", Объект.ОтпечатокСертификата);
	ПараметрыФормы.Вставить("ВерсияСервера", Объект.ВерсияСервера);
	ПараметрыФормы.Вставить("HostAddress", Объект.HostAddress);
	ОткрытьФорму(ПолучитьПутьКОбработке() + "ФормаОбратнойСвязи",ПараметрыФормы,ЭтаФорма,Истина,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры


#КонецОбласти

#Область РазделИсходящиеДокументы

&НаКлиенте
Процедура КомандаОтметкаОтправкаПриИзменении(Элемент)
	ИзменитьПризнакОтправки();
КонецПроцедуры
&НаСервере
Процедура ИзменитьПризнакОтправки()
	Для Каждого СтрокаТЧ Из Объект.ИсходящиеДокументы Цикл
		Если КомандаОтметкаОтправка Тогда
			Если НЕ ЗначениеЗаполнено(МожноОтметитьСтроку(СтрокаТЧ, "Отправлять") ) И НЕ ЗначениеЗаполнено(СтрокаТЧ.Идентификатор) Тогда
				СтрокаТЧ.Отправлять = КомандаОтметкаОтправка;
			КонецЕсли;
		Иначе
			СтрокаТЧ.Отправлять = КомандаОтметкаОтправка;	
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры
&НаСервере
Функция ДокументБылОтправлен()
	СтрокаТЧ = Объект.ИсходящиеДокументы.НайтиПоИдентификатору(Элементы.ИсходящиеДокументы.ТекущаяСтрока);
	Возврат ЗначениеЗаполнено(СтрокаТЧ.Идентификатор);
КонецФункции
&НаСервере
Процедура ОтметитьСтрокуПринудительно()
	СтрокаТЧ = Объект.ИсходящиеДокументы.НайтиПоИдентификатору(Элементы.ИсходящиеДокументы.ТекущаяСтрока);
	СтрокаТЧ.Отправлять = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокИсходящихДокументов(Команда = Неопределено)

	Если ПроверкаНаличияВФайлеДанных Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбновитьСписокИсходящихФайловЗавершение", ЭтаФорма);
		
		Если ЗначениеЗаполнено(ПутьКФайлуДанных) Тогда
			НачатьПомещениеФайла(ОписаниеОповещения,, ПутьКФайлуДанных, НЕ ЗначениеЗаполнено(ПутьКФайлуДанных), ЭтаФорма.УникальныйИдентификатор);
		Иначе
			ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
			ДиалогВыбора.Фильтр = "Файл CSV (*.csv)|*.csv";
			НачатьПомещениеФайла(ОписаниеОповещения,, ДиалогВыбора, НЕ ЗначениеЗаполнено(ПутьКФайлуДанных), ЭтаФорма.УникальныйИдентификатор);
		КонецЕсли;
	Иначе
		ОбновитьСписокИсходящихДокументовНаСервере();
	КонецЕсли;
	Элементы.РазделыДокументов.ТекущаяСтраница = Элементы.РазделДокументыИсходящие;
КонецПроцедуры
&НаКлиенте
Процедура ОбновитьСписокИсходящихФайловЗавершение(Результат, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт
	ПутьКФайлуДанных = ВыбранноеИмяФайла;
	КонтрагентПараметрОтбора = Неопределено;
	Если Найти(ПутьКФайлуДанных, ".csv") < 1 Тогда
		ВывестиУведомлениеПользователю("Этот файл не является CSV. Он не подходит для обработки отбора");
	Иначе
		МассивКонтрагентов = ПрочитатьМассивКонтрагентовИзФайла();
		Если МассивКонтрагентов.Количество() > 0 Тогда
			КонтрагентПараметрОтбора = МассивКонтрагентов;
		КонецЕсли;
	КонецЕсли;
	
	ОбновитьСписокИсходящихДокументовНаСервере(Адрес, КонтрагентПараметрОтбора);

КонецПроцедуры
&НаСервере
Процедура ОбновитьСписокИсходящихДокументовНаСервере(АдресВременногоХранилища = "", ОтборКонтрагентов = Неопределено)
	Если ЗначениеЗаполнено(НачалоПериода) И НЕ ЗначениеЗаполнено(КонецПериода) Тогда
		КонецПериода = ТекущаяДата();
	КонецЕсли;
	Если ЗначениеЗаполнено(КонецПериода) И НЕ ЗначениеЗаполнено(НачалоПериода) Тогда
		ВывестиУведомлениеПользователю("Не заполнено начало периода отбора с заполненным концом! Отбор по периоду не применяется");
	КонецЕсли;
		
	ТаблицаДанных = ПолучитьОбъектОбработки().ПолучитьДокументы(
																?(ОтборПоВидуДокумента = "Все документы", "", ОтборПоВидуДокумента), 
																?(ЗначениеЗаполнено(ОтборКонтрагентов), ОтборКонтрагентов, ОтборПоКонтрагенту), 
																НачалоПериода, 
																КонецПериода,
																НЕ ОтборОтправленные,
																ОтборПоКомментарию,
																КомандаОтметкаУПД);
	Если ТипЗнч(ТаблицаДанных) = Тип("Строка") Тогда
		ВывестиУведомлениеПользователю("Внутренняя ошибка работы. " + ТаблицаДанных);
		Возврат;
	КонецЕсли;
	Если ТаблицаДанных.Количество() = 0 Тогда
		ВывестиУведомлениеПользователю("Нет данных для выгрузки из 1С по установленным отборам");
	КонецЕсли;
	Объект.ИсходящиеДокументы.Загрузить(ТаблицаДанных);
	
	КомандаОтметкаОтправка = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура ПредварительныйПросмотр(Команда)
	
	Если Объект.ВерсияСервера >= 6 Тогда
		Попытка
			ОткрытьНовыйДокументПроцессинга(Элементы.ИсходящиеДокументы.ТекущиеДанные.НомерСтроки);	
		Исключение
			Сообщить(ОписаниеОшибки() );
		КонецПопытки;
	Иначе
		ЗаголовокФормы = "";
		ТабДок = ПолучитьФормуПредварительногоПросмотра(ЗаголовокФормы);
		Если ТипЗнч(ТабДок) = Тип("Строка") Тогда
			ВывестиУведомлениеПользователю(ТабДок);
		ИначеЕсли ТабДок <> Неопределено Тогда
			ТабДок.Показать("Форма электронного документа " + ЗаголовокФормы,,Истина);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
&НаСервере
Функция ПолучитьФормуПредварительногоПросмотра(ЗаголовокФормы = Неопределено)
	Попытка
		СтрокаТЧ = Объект.ИсходящиеДокументы.НайтиПоИдентификатору(Элементы.ИсходящиеДокументы.ТекущаяСтрока);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Если ЗаголовокФормы <> Неопределено Тогда
		ЗаголовокФормы = СтрокаТЧ.Тип + " №" + СтрокаТЧ.Номер + " от " + Формат(СтрокаТЧ.Дата, "ДФ=dd.MM.yyyy"); 	
	КонецЕсли;
	ОбработкаОбъект = ПолучитьОбъектОбработки();
	СтрокаJSON = ОбработкаОбъект.СформироватьЭД(СтрокаТЧ.Ссылка, КомандаОтметкаУПД, Истина).ТелоЗапроса;
	ТипДока = СтрокаТЧ.Тип;
	Если Найти(СтрокаТЧ.Тип, "Торг") ИЛИ Найти(СтрокаТЧ.Тип, "Акт") Тогда
		Если КомандаОтметкаУПД Тогда
			ТипДока = "Универсальный передаточный документ";
		КонецЕсли;
	КонецЕсли;
	ТабДок = ОбработкаОбъект.СформироватьПредварительнуюПФ(СтрокаJSON, ТипДока);
	Если ТипЗнч(ТабДок) = Тип("ТабличныйДокумент") Тогда
		ТабДок.ОтображатьСетку = Ложь;
		Возврат ТабДок;
	КонецЕсли;
	Если ТипЗнч(ТабДок) = Тип("Строка") Тогда
		Возврат ТабДок;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Процедура СоздатьИПодписатьДокументы(Команда = Неопределено)
	Если ТекущаяДата() - Объект.ВремяПоследнейАвторизации > 600 Тогда //Больше 10 минут прошло - надо переавторизоваться
		ОткрытьОкноАвторизации("СоздатьИПодписатьДокументы");
		Возврат;
	КонецЕсли;

	
	Если Объект.ИсходящиеДокументы.Количество() = 0 Тогда
		Сообщить("Пустой список исходящих документов!");
		Возврат;
	КонецЕсли;
	Если ПолучитьКоличествоДокументовКОтправке() = 0 Тогда
		Сообщить("Нет выбранных документов к отправке!");
		Возврат;
	КонецЕсли;
	
	Если Объект.ЗапомнитьПароль Тогда
		СоздатьИПодписатьДокументыПродолжение(Объект.СессионныйПароль);
	Иначе
		ОписаниеОповещения = Новый ОписаниеОповещения("СоздатьИПодписатьДокументыПродолжение", ЭтаФорма);
		ОткрытьФорму(ПолучитьПутьКОбработке() + "ФормаВводаПароля",,ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;		
КонецПроцедуры
&НаКлиенте
Процедура СоздатьИПодписатьДокументыПродолжение(СтрокаПароля = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	Если СтрокаПароля = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	Объект.СессионныйПароль = СтрокаПароля;
	
	КоличествоДокументовКОтправке = Объект.ИсходящиеДокументы.Количество();
	СписокДокументовКОчистке = Новый Массив;	
	МаксКоличествоКОтправке = ПолучитьКоличествоДокументовКОтправке();
	СчетчикВыгруженных = 0;	
			
	Если Объект.ВерсияAPI = "v1.2" Тогда
		//Старый механизм отправки документов по одному. Долгий
		
		ИДЗадания = Новый УникальныйИдентификатор;
		ТекстСообщения = "Осуществляется выгрузка документов в ЭДО";
		ФормаДлительнойОперации = ПолучитьФорму("ОбщаяФорма.ДлительнаяОперация",
		Новый Структура("ИдентификаторЗадания, ТекстСообщения", ИДЗадания, ТекстСообщения), 
		ВладелецФормы);
		ФормаДлительнойОперации.Открыть();
		
		
		Для НомерДокумента = 1 По КоличествоДокументовКОтправке Цикл
			Если Объект.ИсходящиеДокументы.Получить(НомерДокумента - 1).Отправлять Тогда
				КонтентДляПодписи = СоздатьИВернутьДляПодписиДокумент(НомерДокумента);
				Если КонтентДляПодписи.Получить("success") <> Неопределено И КонтентДляПодписи.Получить("success") Тогда
					Попытка
						СтрокаКонтента = КонтентДляПодписи.Получить("content");
						ДвоичныеДанныеДокумента = Base64Значение(СтрокаКонтента);
						Если Объект.ОтпечатокСертификата = Неопределено Тогда
							Возврат;
						КонецЕсли;
						СтрокаПодписи = ПодписатьДокументЭП(ДвоичныеДанныеДокумента, СтрокаПароля);
						ОтправитьПодписанныйНовыйДокумент(НомерДокумента, СтрокаКонтента, СтрокаПодписи);
					Исключение
						ВывестиУведомлениеПользователю(ИнформацияОбОшибке().Описание);
						Объект.ЗапомнитьПароль = Ложь;
					КонецПопытки;
					
					СчетчикВыгруженных = СчетчикВыгруженных + 1;
					ТекстСообщения = "Выгружено документов: " + СчетчикВыгруженных + " из " + МаксКоличествоКОтправке;
					
					ФормаДлительнойОперации.Элементы.ДекорацияПоясняющийТекстДлительнойОперации.Заголовок = ТекстСообщения;
					ФормаДлительнойОперации.ОбновитьОтображениеДанных();
					
				ИначеЕсли КонтентДляПодписи.Получить("success") <> Неопределено Тогда
					Объект.ИсходящиеДокументы.Получить(НомерДокумента - 1).ОписаниеОшибки = КонтентДляПодписи.Получить("codeDescription")
					+ Символы.ПС + ВернутьРазобранныйСписокПроблем(КонтентДляПодписи.Получить("violations") );	
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
			
		ФормаДлительнойОперации.Закрыть();
		
	Иначе //Быстрый метод работы 
		
		ФормаСтатуса = ПолучитьФорму(ПолучитьПутьКОбработке() + "ФормаСтатусаОтправки",, ВладелецФормы);
		ФормаСтатуса.ОбновитьСтатусСозданияДокументов("Создано первичных документов: 0 из " + МаксКоличествоКОтправке);
		ФормаСтатуса.ПоказатьСтатусСозданияКвитанций(Ложь);
		ФормаСтатуса.ПоказатьСтатусОтправкиКвитанций(Ложь);
		ФормаСтатуса.Открыть();
		
		МассивДокументов = Новый Массив;
		
		Для НомерДокумента = 1 По КоличествоДокументовКОтправке Цикл
			
			СтрокаТаблицы = Объект.ИсходящиеДокументы.Получить(НомерДокумента - 1);
			
			Если Объект.ИсходящиеДокументы.Получить(НомерДокумента - 1).Отправлять Тогда
				
				КонтентДляПодписи = СоздатьИВернутьДляПодписиДокумент(НомерДокумента);
				
				Если ТипЗнч(КонтентДляПодписи) = Тип("Соответствие") Тогда
					
					Если КонтентДляПодписи.Получить("success") <> Неопределено И КонтентДляПодписи.Получить("success") Тогда
						
						СтрокаКонтента = КонтентДляПодписи.Получить("content");	
						ЗаписатьИсториюОбменаЭДО(СтрокаТаблицы.Ссылка, ПредопределенноеЗначение("Перечисление.СтатусыОбменаЭДО.Подготовка"),,"Документ успешно подготовлен"); //Белов
						
					ИначеЕсли КонтентДляПодписи.Получить("success") <> Неопределено Тогда
						Объект.ИсходящиеДокументы.Получить(НомерДокумента - 1).ОписаниеОшибки = КонтентДляПодписи.Получить("codeDescription")
						+ Символы.ПС + ВернутьРазобранныйСписокПроблем(КонтентДляПодписи.Получить("violations") );
						
						ЗаписатьИсториюОбменаЭДО(СтрокаТаблицы.Ссылка, ПредопределенноеЗначение("Перечисление.СтатусыОбменаЭДО.Подготовка"), СтрокаТаблицы.ОписаниеОшибки, "Ошибка при подготовке документа к отправке"); //Белов
						
						Продолжить;
					КонецЕсли;
					
				Иначе
					
					СтрокаКонтента = КонтентДляПодписи.content;	
					ЗаписатьИсториюОбменаЭДО(СтрокаТаблицы.Ссылка, ПредопределенноеЗначение("Перечисление.СтатусыОбменаЭДО.Подготовка"),,"Документ успешно подготовлен"); //Белов
					
				КонецЕсли;
				
				Попытка
					ДвоичныеДанныеДокумента = Base64Значение(СтрокаКонтента);
					Если Объект.ОтпечатокСертификата = Неопределено Тогда
						Возврат;
					КонецЕсли;
					//Белов
					СтрокаПодписи = "";
					//СтрокаПодписи = ПодписатьДокументЭП(ДвоичныеДанныеДокумента, СтрокаПароля);
					МассивДокументов.Добавить(ПодготовитьСтруктуруЗапросаНаСоздание(НомерДокумента, СтрокаКонтента, СтрокаПодписи) );
					СчетчикВыгруженных = СчетчикВыгруженных + 1;
					Если СчетчикВыгруженных % ПорцияОтправки = 0 ИЛИ СчетчикВыгруженных = МаксКоличествоКОтправке Тогда
						ФормаСтатуса.ОбновитьСтатусСозданияДокументов("Создано первичных документов: " + СчетчикВыгруженных + " из " + МаксКоличествоКОтправке);
						ФормаСтатуса.ОбновитьОтображениеДанных();
						
						ОтправитьМассивНовыхДокументов(МассивДокументов);
						ФормаСтатуса.ОбновитьСтатусОтправкиДокументов("Отправлено документов: " + СчетчикВыгруженных + " из " + МаксКоличествоКОтправке);
						ФормаСтатуса.ОбновитьОтображениеДанных();
						МассивДокументов.Очистить();
					КонецЕсли;
				Исключение
					ВывестиУведомлениеПользователю(ИнформацияОбОшибке().Описание);
					Объект.ЗапомнитьПароль = Ложь;
				КонецПопытки;

			КонецЕсли;
			
		КонецЦикла;
		Если СчетчикВыгруженных = 0 Тогда
			ФормаСтатуса.ОбновитьСтатусСозданияДокументов("Не удалось создать ни одного документа!",,Истина);
		Иначе
			ФормаСтатуса.ОбновитьСтатусСозданияДокументов(,Истина);	
		КонецЕсли;
		Если МассивДокументов.Количество() > 0 Тогда
			ОтправитьМассивНовыхДокументов(МассивДокументов);
			ФормаСтатуса.ОбновитьСтатусОтправкиДокументов("Отправлено документов: " + СчетчикВыгруженных + " из " + МаксКоличествоКОтправке);
			ФормаСтатуса.ОбновитьОтображениеДанных();
			МассивДокументов.Очистить();
		КонецЕсли;
		ФормаСтатуса.ОбновитьСтатусОтправкиДокументов("Отправлено документов: " + СчетчикВыгруженных + " из " + МаксКоличествоКОтправке, Истина);
		ФормаСтатуса.ОбновитьОтображениеДанных();
		
		
				
		
	КонецЕсли;
	
	Если НЕ ОтборОтправленные Тогда	
		Для Каждого Документ Из Объект.ИсходящиеДокументы Цикл
			Если ЗначениеЗаполнено(Документ.Идентификатор) Тогда
				СписокДокументовКОчистке.Добавить(Документ);	
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Для Каждого Документ Из СписокДокументовКОчистке Цикл
		Объект.ИсходящиеДокументы.Удалить(Документ);	
	КонецЦикла;
	
	ФормаСтатуса.Закрыть();
КонецПроцедуры

