Процедура СинхронизацияКонтрагентовНаСервере(ПолнаяЗагрузка = Ложь)
	Объект.СправочникКонтрагенты.Очистить();
	Если  Не (ЗначениеЗаполнено(Объект.Cookie) ИЛИ ЗначениеЗаполнено(Объект.ТокенАвторизации) ) Тогда
		ВывестиУведомлениеПользователю("Ошибка синхронизации контрагентов - авторизация не осуществлена");
		Возврат;
	КонецЕсли;
	ДанныеСинхронизации = ПолучитьОбъектОбработки().ВыполнитьСинхронизациюКонтрагентов(ПолнаяЗагрузка);
	Если ТипЗнч(ДанныеСинхронизации) <> Тип("ТаблицаЗначений") Тогда
		Если ТипЗнч(ДанныеСинхронизации) = Тип("Строка") Тогда
			ВывестиУведомлениеПользователю("Ошибка синхронизации контрагентов: " + ДанныеСинхронизации);
			Возврат;
		Иначе
			ВывестиУведомлениеПользователю("Произошла внутренняя ошибка. Пожалуйста, обратитесь к администратору или разработчику");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Если ДанныеСинхронизации.Количество() = 0 Тогда
		ВывестиУведомлениеПользователю("Ошибка синхронизации контрагентов - в системе отсутствуют данные.");
		Возврат;
	КонецЕсли;
	Объект.СправочникКонтрагенты.Загрузить(ДанныеСинхронизации); 
	
	Для каждого Стр Из Объект.СправочникКонтрагенты Цикл
		
		Если ЗначениеЗаполнено(Стр.Ссылка) И ТипЗнч(Стр.Ссылка) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
			Стр.Контрагент = Стр.Ссылка.Владелец;			
		КонецЕсли;
		
	КонецЦикла; 
	
КонецПроцедуры


&НаКлиенте
Процедура КонтрагентыНайтиПоИНН(Команда)
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("СправочникСсылка.Контрагенты") );
	ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
	ОписаниеОповещения = Новый ОписаниеОповещения("КонтрагентыНайтиПоИННЗавершение", ЭтаФорма);
	ПоказатьВводЗначения(ОписаниеОповещения, Неопределено ,"Выберите контрагента из списка",ОписаниеТипов);		
КонецПроцедуры
&НаКлиенте
Процедура КонтрагентыНайтиПоИННЗавершение(СсылкаНаКонтрагента, ДополнительныеПараметры = Неопределено) Экспорт
	Если ТипЗнч(СсылкаНаКонтрагента) = Тип("СправочникСсылка.Контрагенты") И НЕ СсылкаНаКонтрагента.Пустая() Тогда
		ДанныеОКонтрагенте = ПолучитьДанныеОКонтрагентеПоИНН(СсылкаНаКонтрагента);
		Если ДанныеОКонтрагенте <> Неопределено Тогда
			ОткрытьФормуКонтрагента(ДанныеОКонтрагенте, СсылкаНаКонтрагента, ДанныеОКонтрагенте.Получить("divisionId") );	
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
&НаСервере
Функция ПолучитьДанныеОКонтрагентеПоИНН(СсылкаНаКонтрагента)
	Если ТипЗнч(СсылкаНаКонтрагента) = Тип("Строка") Тогда
		СтрокаИНН = СсылкаНаКонтрагента;
	Иначе
		СтрокаИНН = СсылкаНаКонтрагента.ИНН;
	КонецЕсли;
	ОбработкаОбъект = ПолучитьОбъектОбработки();
	ДанныеКонтрагента = ОбработкаОбъект.ПолучитьДанныеКонтрагентаПоИНН(СтрокаИНН);
	Если ТипЗнч(ДанныеКонтрагента) = Тип("Строка") Тогда
		ВывестиУведомлениеПользователю(ДанныеКонтрагента);
		Возврат Неопределено;
	КонецЕсли;
	Возврат ДанныеКонтрагента;
КонецФункции
&НаСервере
Функция ПолучитьДанныеОКонтрагентеПоИД(ИДКонтрагента)
	ОбработкаОбъект = ПолучитьОбъектОбработки();
	ДанныеКонтрагента = ОбработкаОбъект.ПолучитьДанныеКонтрагентаПоИД(ИДКонтрагента);
	Если ТипЗнч(ДанныеКонтрагента) = Тип("Строка") Тогда
		ВывестиУведомлениеПользователю(ДанныеКонтрагента);
		Возврат Неопределено;
	КонецЕсли;
	Возврат ДанныеКонтрагента;
КонецФункции


&НаКлиенте
Процедура СправочникКонтрагентыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекущаяСтрока = Элементы.СправочникКонтрагенты.ТекущиеДанные;
	ДанныеОКонтрагенте = ПолучитьДанныеОКонтрагентеПоИД(ТекущаяСтрока.ИдентификаторПодразделения);
	Если ДанныеОКонтрагенте <> Неопределено Тогда   
		СсылкаНаКонтрагента = ТекущаяСтрока.Ссылка;
		Если ТипЗнч(СсылкаНаКонтрагента) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
			СсылкаНаКонтрагента = ПолучитьКонтрагентаДоговора(СсылкаНаКонтрагента);	
		КонецЕсли;
		ОткрытьФормуКонтрагента(ДанныеОКонтрагенте, СсылкаНаКонтрагента, ТекущаяСтрока.ИдентификаторПодразделения);	
	КонецЕсли;		
КонецПроцедуры
&НаКлиенте
Процедура ОткрытьФормуКонтрагента(ДанныеКонтрагента, СсылкаНаКонтрагента, ИдПодразделения)
	
	ДанныеСтатуса = ДанныеКонтрагента.Получить("relation");
	ДанныеПоАдресу = ДанныеКонтрагента.Получить("address");
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СсылкаНаКонтрагента", СсылкаНаКонтрагента);
	ПараметрыФормы.Вставить("КриптоПровайдер", КриптоПровайдер);
	ПараметрыФормы.Вставить("НаименованиеКонтрагента", 		ДанныеКонтрагента.Получить("name") );
	ПараметрыФормы.Вставить("ИНН", 							ДанныеКонтрагента.Получить("inn") );
	ПараметрыФормы.Вставить("ОГРН", 						ДанныеКонтрагента.Получить("ogrn") );
	ПараметрыФормы.Вставить("БИК",							ДанныеКонтрагента.Получить("bik") );
	ПараметрыФормы.Вставить("НомерСчета",					ДанныеКонтрагента.Получить("accountNumber") );

	Если ДанныеСтатуса <> Неопределено Тогда
		ПараметрыФормы.Вставить("Статус",					ДанныеСтатуса.Получить("statusSystemName") );
		ПараметрыФормы.Вставить("ПредставлениеСтатуса",		ДанныеСтатуса.Получить("statusName") );
	КонецЕсли;
	ПараметрыФормы.Вставить("ИдентификаторКонтрагента", 	ДанныеКонтрагента.Получить("id") );
	ПараметрыФормы.Вставить("ИдПодразделения",				ИдПодразделения);
	Если ИдПодразделения <> 0 Тогда
		МассивПодр = ДанныеКонтрагента.Получить("divisions");
		ПараметрыФормы.Вставить("КПП",							ДанныеКонтрагента.Получить("kpp") );
		Для Каждого Подразделение Из МассивПодр Цикл
			Если Подразделение.Получить("id") = ИдПодразделения Тогда
				ПараметрыФормы.КПП =							Подразделение.Получить("kpp");
				Если Подразделение.Получить("title") <> "Основной офис" Тогда 
					ПараметрыФормы.НаименованиеКонтрагента = ПараметрыФормы.НаименованиеКонтрагента + " (" + Подразделение.Получить("title") + ")";
				КонецЕсли;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		ПараметрыФормы.Вставить("КПП",							ДанныеКонтрагента.Получить("kpp") );
	КонецЕсли;
	
	Если ДанныеПоАдресу <> Неопределено Тогда
		ПараметрыФормы.Вставить("КодСтраны",				ДанныеПоАдресу.Получить("country").Получить("code") );
		ПараметрыФормы.Вставить("КодРегиона",				?(ДанныеПоАдресу.Получить("region") = Неопределено, "", ДанныеПоАдресу.Получить("region").Получить("code")));
		ПараметрыФормы.Вставить("ПочтовыйИндекс", 			ДанныеПоАдресу.Получить("postalCode") );
	КонецЕсли;
	
	ПараметрыФормы.Вставить("ВерсияСервера", Объект.ВерсияСервера);
	ПараметрыФормы.Вставить("ВерсияAPI", Объект.ВерсияAPI);
	ПараметрыФормы.Вставить("HostAddress", Объект.HostAddress);
	ПараметрыФормы.Вставить("ОтпечатокСертификата", Объект.ОтпечатокСертификата);
	ПараметрыФормы.Вставить("ТокенАвторизации", Объект.ТокенАвторизации);
	ПараметрыФормы.Вставить("ИдентификаторОрганизации", Объект.ИдентификаторОрганизации);
	ПараметрыФормы.Вставить("ИдентификаторПодразделения", Объект.ИдентификаторПодразделения);
	ПараметрыФормы.Вставить("ДанныеПодписанта", Объект.ДанныеПодписанта);
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	ПараметрыФормы.Вставить("СессионныйПароль", Объект.СессионныйПароль);
	ПараметрыФормы.Вставить("ЗапомнитьПароль", Объект.ЗапомнитьПароль);
	
	ОткрытьФорму(ПолучитьПутьКОбработке() + "ФормаКарточкиКонтрагента",ПараметрыФормы,ЭтаФорма,Истина,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);		
КонецПроцедуры

