&НаСервере
Функция ПолучитьТокенССервера()
	ОбработкаОбъект = ПолучитьОбъектОбработки();
	Возврат ОбработкаОбъект.ПроверитьТокенЛицензии();	
КонецФункции
&НаСервере
Функция ЗарегистрироватьОбработку(ПинКод, ОрганизацияРегистрация)
	ОбработкаОбъект = ПолучитьОбъектОбработки();
	Возврат ОбработкаОбъект.ПолучитьТокенЛицензии(ПинКод, ОрганизацияРегистрация);
КонецФункции
&НаКлиенте
Процедура ВвестиПинКодЗавершение(СтруктураВозврата, ДопПараметры = Неопределено) Экспорт
	Если ТипЗнч(СтруктураВозврата) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Если СтруктураВозврата.Свойство("ПинКод") И СтруктураВозврата.Свойство("ОрганизацияРегистрации") Тогда
		Результат = ЗарегистрироватьОбработку(СтруктураВозврата.ПинКод, СтруктураВозврата.ОрганизацияРегистрации);
		Если ЗначениеЗаполнено(Результат.Токен) Тогда
			Элементы.СтатусЛицензииТекст.Заголовок = "Лицензия активирована. Срок действия лицензии: " + Формат(Результат.ДатаДействия, "ДФ=dd.MM.yyyy");
			ПодключитьОбработчикОжидания("Подключаемый_ОткрытьОкноАвторизации", 0.5, Истина);	
		Иначе
			Сообщить(Результат.ПричинаОшибки);	
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
&НаКлиенте
Процедура Подключаемый_ОткрытьОкноВводаПинкода() Экспорт
	Форма = ПолучитьФорму(ПолучитьПутьКОбработке() + "ФормаЛицензирования",,ЭтаФорма);
	ОписаниеОповещения = Новый ОписаниеОповещения("ВвестиПинКодЗавершение", ЭтаФорма);
	Форма.ОписаниеОповещенияОЗакрытии = ОписаниеОповещения;
	Форма.РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
	Форма.Открыть();
КонецПроцедуры
&НаКлиенте
Процедура ВвестиПинКодАвторизации(Команда)
	Подключаемый_ОткрытьОкноВводаПинкода();
КонецПроцедуры


