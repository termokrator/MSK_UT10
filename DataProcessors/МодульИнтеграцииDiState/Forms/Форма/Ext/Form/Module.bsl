&НаКлиенте
Процедура ЗаполнитьСпискиВыборов()
	СписокДействий = Новый Массив();
	СписокДействий.Добавить("Все документы");		
	СписокДействий.Добавить("Счет-фактура");		
	СписокДействий.Добавить("Торг-12");		
	СписокДействий.Добавить("Акт сдачи-приема");
	СписокДействий.Добавить("Счет на оплату");
	СписокДействий.Добавить("Универсальный передаточный документ");
	Если Объект.ВерсияСервера >= 6 Тогда
		СписокДействий.Добавить("Корректировка реализации");
		СписокДействий.Добавить("Корректировочный счет-фактура");
		СписокДействий.Добавить("Универсальный корректировочный документ");
		СписокДействий.Добавить("Акт сверки");
		СписокДействий.Добавить("УПД / СЧФ (на аванс)");
		СписокДействий.Добавить("УПД / СЧФ (к оплате)");
	КонецЕсли;

	//+Макрушин Е. 09.04.2026 #UT10-5800
	СписокДействий.Добавить("Торг-2");
	//-Макрушин Е. 09.04.2026 #UT10-5800
	
	//+Белов А. 17.06.2026 #UT10-5921
	СписокДействий.Добавить("Транспортная накладная");
	СписокДействий.Добавить("Заказ-заявка");
	//-Белов А. 17.06.2026 #UT10-5921
	
	Элементы.ОтборПоВидуДокумента.СписокВыбора.ЗагрузитьЗначения(СписокДействий);
КонецПроцедуры
&НаСервере
Процедура ЗаполнитьМетаданныеСсылок()
	Попытка
		
		СписокТипов = Новый Массив;
		СписокТипов.Добавить(Тип("СправочникСсылка.Контрагенты"));
		
		ОписаниеТипов = Новый ОписаниеТипов(СписокТипов);
		Элементы.ОтборПоКонтрагенту.ОграничениеТипа = ОписаниеТипов;
	Исключение 
		Сообщить(ОписаниеОШибки());
	КонецПопытки;
	
	Попытка
		ОписаниеТипов = Новый ОписаниеТипов("СправочникСсылка.СтруктураПредприятия");
		Элементы.ПодразделениеЗатрат.ОграничениеТипа = ОписаниеТипов;
	Исключение 
		Элементы.ПодразделениеЗатрат.Видимость = Ложь;
		Элементы.СвязиСтатейЗатрат.Видимость = Ложь;
		Элементы.СопоставлятьСтатьиЗатратПередЗагрузкой.Видимость = Ложь;
	КонецПопытки;
	
	Попытка
		ОписаниеТипов = Новый ОписаниеТипов("СправочникСсылка.Склады");
		Элементы.СкладПоУмолчанию.ОграничениеТипа = ОписаниеТипов;
	Исключение
		Попытка
			ОписаниеТипов = Новый ОписаниеТипов("СправочникСсылка.СтруктурныеЕдиницы");
			Элементы.СкладПоУмолчанию.ОграничениеТипа = ОписаниеТипов;
		Исключение	
			Элементы.СкладПоУмолчанию.Видимость = Ложь;	
		КонецПопытки;	
	КонецПопытки;
КонецПроцедуры
&НаКлиенте
Процедура УстановитьЗначенияПоУмолчанию()
	//Changelog
	//
	//21.03.2019 - добавлено принудительная установка префиксов номеров
	Если НЕ ЗначениеЗаполнено(НачалоПериода) Тогда
		НачалоПериода = НачалоМесяца(ТекущаяДата() );
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(КонецПериода) Тогда
		КонецПериода = КонецМесяца(НачалоПериода);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ОтборПоВидуДокумента) Тогда
		ОтборПоВидуДокумента = "Все документы";
	КонецЕсли;
	Объект.ОбрезатьПрефиксыНомеров = Истина;	
	Элементы.СтатусАвторизации.Заголовок = "Не авторизован";
	Элементы.СтатусАвторизации.ЦветТекста = Новый Цвет(255,0,0);
	
	Элементы.КомандаОтметкаУПД.ТриСостояния = Ложь;
	//По стандарту эти опции недоступны
	Элементы.ПриглашенияКонтрагентовКонтрагентыНайтиПоИНН.Видимость = Ложь;
	Элементы.СправочникКонтрагентыСтатусВзаимодействия.Видимость = Ложь;
		
	//Для сокрытия всех записей
	Объект.Отладка = Истина;
	ОтладчикНаСервере();
	
	ЗагрузкаЛоготипа();
	
	СписокПровайдеров = ПолучитьСписокКриптоПровайдеровWindows();
	Для Каждого Провайдер Из СписокПровайдеров Цикл
		Элементы.КриптоПровайдер.СписокВыбора.Добавить(Провайдер.Значение, Провайдер.Представление);
	КонецЦикла;
	Если ПорцияОтправки = 0 Тогда
		ПорцияОтправки = 10;
	КонецЕсли;
	
	
	
КонецПроцедуры
&НаКлиенте
Процедура ИзменитьВидимостьИдентификаторов()
	Если ПоказыватьИдентификаторы Тогда
		Элементы.ПоказИдентификаторов.Заголовок = "Скрывать служебные ID";
	Иначе
		Элементы.ПоказИдентификаторов.Заголовок = "Показывать служебные ID";	
	КонецЕсли;
	Элементы.СправочникКонтрагентыИдентификаторКомпании.Видимость 		= Ложь;
	Элементы.СправочникКонтрагентыИдентификаторПодразделения.Видимость 	= ПоказыватьИдентификаторы;
	Элементы.ИсходящиеДокументыИдентификатор.Видимость 					= ПоказыватьИдентификаторы;
	Элементы.ВходящиеДокументыИдентификаторДокумента.Видимость 			= ПоказыватьИдентификаторы;
	Элементы.ВходящиеДокументыИдентификаторКонтрагента.Видимость 		= ПоказыватьИдентификаторы;
	Элементы.ВходящиеДокументыИдентификаторПакета.Видимость 			= ПоказыватьИдентификаторы;
	Элементы.ВходящиеДокументыИдентификаторПодразделения.Видимость 		= ПоказыватьИдентификаторы;
	Элементы.ДокументыВОбработкеГруппаИдентификаторы.Видимость 			= ПоказыватьИдентификаторы;
	Элементы.ДокументыВОбработкеИдентификаторОтправителя.Видимость		= ПоказыватьИдентификаторы;
	Элементы.ДокументыВОбработкеИдентификаторПолучателя.Видимость		= ПоказыватьИдентификаторы;

КонецПроцедуры
