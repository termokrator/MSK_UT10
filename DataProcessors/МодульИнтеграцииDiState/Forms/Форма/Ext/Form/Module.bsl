	ОбработкаОбъект = ПолучитьОбъектОбработки();
	ДатаРелиза = ОбработкаОбъект.ПолучитьДатуРелиза();
	Элементы.ДекорацияВерсия.Заголовок = "Версия от " + ДатаРелиза;
