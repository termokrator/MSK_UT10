&НаКлиенте
Процедура Подключаемый_ПроверитьНаличиеОбновлений() Экспорт
	Если ПроверитьНаличиеОбновленийНаСервере() Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ОткрытьФормуЗагрузкиОбновлений", ЭтаФорма);
		ПоказатьОповещениеПользователя("Обновления модуля", ОписаниеОповещения, "Доступны новые обновления модуля"); 		
	КонецЕсли;
КонецПроцедуры
&НаСервере
Функция ПроверитьНаличиеОбновленийНаСервере()
	Результат = Ложь;
	ОбработкаОбъект = ПолучитьОбъектОбработки();
	ТаблицаДанных = ОбработкаОбъект.ПолучитьСписокДоступныхМодулей();
	Если ТаблицаДанных.Количество() > 0 Тогда
		Результат = Истина;
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуЗагрузкиОбновлений(ПараметрОткрытия = Неопределено) Экспорт
	ОткрытьФорму(ПолучитьПутьКОбработке() + "ФормаОбновлений",,ЭтаФорма,Истина,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);		
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуОбновлений(Команда)
	ОткрытьФормуЗагрузкиОбновлений();
КонецПроцедуры
