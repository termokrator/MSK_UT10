&НаКлиентеНаСервереБезКонтекста
Функция ВернутьРазобранныйСписокПроблем(МассивОшибок)
	СтрокаТекста = "";
	Если НЕ ЗначениеЗаполнено(МассивОшибок) Тогда
		Возврат СтрокаТекста;
	КонецЕсли;
	
	Если ТипЗнч(МассивОшибок) = Тип("Массив") Тогда
		Для Каждого Ошибка Из МассивОшибок Цикл
			Если ЗначениеЗаполнено(СтрокаТекста) Тогда
				СтрокаТекста = СтрокаТекста + Символы.ПС;
			КонецЕсли;
			Если ТипЗнч(Ошибка) = Тип("Строка") Тогда
				СтрокаТекста = СтрокаТекста + Ошибка;	
			Иначе
				Если Ошибка.Получить("propertyPath") <> Неопределено Тогда
					СтрокаТекста = СтрокаТекста + Ошибка.Получить("propertyPath") + ": ";
				КонецЕсли;
				Если Ошибка.Получить("violation") <> Неопределено Тогда
					СтрокаТекста = СтрокаТекста + Ошибка.Получить("violation");
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(МассивОшибок) = Тип("Соответствие") Тогда
		Если МассивОшибок.Получить("violations") <> Неопределено Тогда
			СтрокаТекста = ВернутьРазобранныйСписокПроблем(МассивОшибок.Получить("violations") );
		КонецЕсли;
	КонецЕсли;
	Возврат СтрокаТекста;
КонецФункции
&НаСервере
Процедура ВыполнитьПроверкуКорректностиРеквизитов()
	Результат = ПолучитьОбъектОбработки().ПроверитьКорректностьЗаполненияРеквизитов();	
	Если Результат <> "" Тогда
		ВывестиУведомлениеПользователю(Результат);
	КонецЕсли;
КонецПроцедуры
&НаКлиенте
Функция НайтиТекущееОкноСтатусаОтправки()
	ОкнаПриложения = ПолучитьОкна();
	Для Каждого ОкноПриложения Из ОкнаПриложения Цикл
		Если ОкноПриложения.Содержимое.Количество() > 0 Тогда
			Если Найти(ОкноПриложения.Содержимое.Получить(0).ИмяФормы, "ФормаСтатусаОтправки") Тогда
				Возврат ОкноПриложения.Содержимое.Получить(0);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции


