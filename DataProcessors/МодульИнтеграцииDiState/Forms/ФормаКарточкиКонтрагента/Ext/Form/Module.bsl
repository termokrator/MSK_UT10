&НаКлиенте
Процедура СоздатьОбновитьКонтрагента(Команда)
	СоздатьОбновитьКонтрагентаНаСервере();
КонецПроцедуры
&НаСервере
Процедура СоздатьОбновитьКонтрагентаНаСервере()
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Если ЗначениеЗаполнено(СсылкаНаКонтрагента) Тогда //Обновление реквизитов
		СтруктураДанных = Новый Структура;
		
		Для Каждого ЭлементРеквизитов Из ТаблицаДанныхКонтрагента Цикл
			Если ЭлементРеквизитов.ОбновитьРеквизит Тогда
				СтруктураДанных.Вставить(ЭлементРеквизитов.ВидРеквизита, ЭлементРеквизитов.ЗначениеВЭДО);
			КонецЕсли;
		КонецЦикла;	
		Результат = ОбработкаОбъект.ОбновитьРеквизитыКонтрагента(СтруктураДанных, СсылкаНаКонтрагента);
		Если Результат = Ложь Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Не удалось записать изменения в объект";
			Сообщение.Сообщить();
		КонецЕсли;
	Иначе //Создание нового
		СтруктураДанных = Новый Структура;
		
		Для Каждого ЭлементРеквизитов Из ТаблицаДанныхКонтрагента Цикл
			СтруктураДанных.Вставить(ЭлементРеквизитов.ВидРеквизита, ЭлементРеквизитов.ЗначениеВЭДО);	
		КонецЦикла;
		
		СсылкаНаКонтрагента = ОбработкаОбъект.СоздатьНовогоКонтрагента(СтруктураДанных);
		ОбработкаОбъект.ПривязатьИдентификаторКОбъекту1С(СсылкаНаКонтрагента, ИдентификаторКонтрагента);
		Если ЗначениеЗаполнено(ИдентификаторПодразделения) Тогда
			ОбработкаОбъект.ПривязатьИдентификаторПодразделенияВ1С(СсылкаНаКонтрагента, ИдентификаторПодразделения);	
		КонецЕсли;
	КонецЕсли;
	ЗаполнитьЗначенияИз1С();
КонецПроцедуры
&НаСервере
Процедура ЗаполнитьЗначенияИз1С()
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");	
	СтруктураДанныхКонтрагента = ОбработкаОбъект.ПолучитьСтруктуруКонтрагента(СсылкаНаКонтрагента);
	Для Каждого ЭлементРеквизитов Из ТаблицаДанныхКонтрагента Цикл
		ЭлементРеквизитов.ЗначениеВ1С = БезопасноПрочитатьЗначение(СтруктураДанныхКонтрагента, ЭлементРеквизитов.ВидРеквизита);	
	КонецЦикла;
КонецПроцедуры
&НаСервере
Функция БезопасноПрочитатьЗначение(Структура, Имя)
	Результат = Неопределено;
	Если ТипЗнч(Структура) = Тип("Структура") Тогда
		Если Структура.Свойство(Имя) Тогда
			Выполнить("Результат = Структура." + Имя);
		КонецЕсли;
	Иначе
		Результат = Структура;
	КонецЕсли;
	Возврат Результат;
КонецФункции





#КонецОбласти
