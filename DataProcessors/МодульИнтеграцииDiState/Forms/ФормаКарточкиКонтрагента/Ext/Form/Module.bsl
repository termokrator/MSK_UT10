	УстановитьДоступностьПоСтатусу();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПараметрыФормы()
	
	ЗаполнитьЗначенияСвойств(Объект, Параметры);
	СтруктураДанныхКонтрагента = Неопределено;	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
			
	Если Параметры.Свойство("КриптоПровайдер") Тогда
		КриптоПровайдер = Параметры.КриптоПровайдер;
	КонецЕсли;
	Если Параметры.Свойство("НаименованиеКонтрагента") Тогда
		НаименованиеКонтрагента = Параметры.НаименованиеКонтрагента;	
	КонецЕсли;
	Если Параметры.Свойство("ИдентификаторКонтрагента") Тогда
		ИдентификаторКонтрагента = Параметры.ИдентификаторКонтрагента;	
	КонецЕсли;
	Если Параметры.Свойство("ИдПодразделения") Тогда
		ИдентификаторПодразделения = Параметры.ИдПодразделения;	
	КонецЕсли;
	Если Параметры.Свойство("Статус") Тогда
		Статус = Параметры.Статус;	
	КонецЕсли;
	Если Параметры.Свойство("ПредставлениеСтатуса") Тогда
		ПредставлениеСтатуса = Параметры.ПредставлениеСтатуса;	
	КонецЕсли;
	Если Параметры.Свойство("КодСтраны") Тогда
		КодСтраны = Параметры.КодСтраны;	
	КонецЕсли;
	Если Параметры.Свойство("КодРегиона") Тогда
		КодРегиона = Параметры.КодРегиона;	
	КонецЕсли;


	Если Параметры.Свойство("СсылкаНаКонтрагента") Тогда
		СсылкаНаКонтрагента = Параметры.СсылкаНаКонтрагента;
		СтруктураДанныхКонтрагента = ОбработкаОбъект.ПолучитьСтруктуруКонтрагента(СсылкаНаКонтрагента);
	КонецЕсли;
	
	
	СтрокаНаименования = ТаблицаДанныхКонтрагента.Добавить();
	СтрокаНаименования.ВидРеквизита = "Наименование";
	СтрокаНаименования.ЗначениеВЭДО = НаименованиеКонтрагента;
	Если ЗначениеЗаполнено(СтруктураДанныхКонтрагента) Тогда
		СтрокаНаименования.ЗначениеВ1С = СтруктураДанныхКонтрагента.Наименование;
	КонецЕсли;
	
	СтрокаИНН = ТаблицаДанныхКонтрагента.Добавить();
	СтрокаИНН.ВидРеквизита = "ИНН";
	Если Параметры.Свойство("ИНН") Тогда
		СтрокаИНН.ЗначениеВЭДО = Параметры.ИНН;
	КонецЕсли;
	Если ЗначениеЗаполнено(СтруктураДанныхКонтрагента) Тогда
		СтрокаИНН.ЗначениеВ1С = СтруктураДанныхКонтрагента.ИНН;
	КонецЕсли;
	
	СтрокаКПП = ТаблицаДанныхКонтрагента.Добавить();
	СтрокаКПП.ВидРеквизита = "КПП";
	Если Параметры.Свойство("КПП") Тогда
		СтрокаКПП.ЗначениеВЭДО = Параметры.КПП;
	КонецЕсли;
	Если ЗначениеЗаполнено(СтруктураДанныхКонтрагента) Тогда
		СтрокаКПП.ЗначениеВ1С = СтруктураДанныхКонтрагента.КПП;
	КонецЕсли;
	
	СтрокаОГРН = ТаблицаДанныхКонтрагента.Добавить();
	СтрокаОГРН.ВидРеквизита = "ОГРН";
	Если Параметры.Свойство("ОГРН") Тогда
		СтрокаОГРН.ЗначениеВЭДО = Параметры.ОГРН;
	КонецЕсли;
	Если ЗначениеЗаполнено(СтруктураДанныхКонтрагента) Тогда
		СтрокаОГРН.ЗначениеВ1С = СтруктураДанныхКонтрагента.ОГРН;
	КонецЕсли;
	
	СтрокаБИК = ТаблицаДанныхКонтрагента.Добавить();
	СтрокаБИК.ВидРеквизита = "БИК";
	Если Параметры.Свойство("БИК") Тогда
		СтрокаБИК.ЗначениеВЭДО = Параметры.БИК;
	КонецЕсли;
	Если ЗначениеЗаполнено(СтруктураДанныхКонтрагента) Тогда
		СтрокаБИК.ЗначениеВ1С = СтруктураДанныхКонтрагента.БИК;
	КонецЕсли;
	
	СтрокаНомерСчета = ТаблицаДанныхКонтрагента.Добавить();
	СтрокаНомерСчета.ВидРеквизита = "НомерСчета";
	Если Параметры.Свойство("НомерСчета") Тогда
		СтрокаНомерСчета.ЗначениеВЭДО = Параметры.НомерСчета;
	КонецЕсли;
	Если ЗначениеЗаполнено(СтруктураДанныхКонтрагента) Тогда
		СтрокаНомерСчета.ЗначениеВ1С = СтруктураДанныхКонтрагента.НомерСчета;
	КонецЕсли;


	
	
КонецПроцедуры

Процедура УстановитьДоступностьПоСтатусу()
	Элементы.Пригласить.Видимость = Ложь;
	Элементы.ПринятьПриглашение.Видимость = Ложь;
	Элементы.ОтклонитьПриглашение.Видимость = Ложь;
	Элементы.УдалитьОбмен.Видимость = Ложь;
	Если Статус = "active" Тогда
		Элементы.УдалитьОбмен.Видимость = Истина;
	КонецЕсли;
	Если Статус = "offered" Тогда
		Элементы.ПринятьПриглашение.Видимость = Истина;
		Элементы.ОтклонитьПриглашение.Видимость = Истина;
	КонецЕсли;
	Если Статус = "archived" Тогда
		Элементы.Пригласить.Видимость = Истина;
	КонецЕсли;
	Если Статус = "" Тогда
		Элементы.Пригласить.Видимость = Истина;
	КонецЕсли;
КонецПроцедуры


#Область ОбработчикиОбмена

&НаКлиенте
Процедура Пригласить(Команда)
	Если ПригласитьНаСервере() Тогда
		Оповестить("ОбновлениеСпискаКонтрагентов");
		Закрыть();
	КонецЕсли;
КонецПроцедуры
&НаСервере
Функция ПригласитьНаСервере()
	Если НЕ ЗначениеЗаполнено(ИдентификаторКонтрагента) Тогда
		Возврат Ложь;
	КонецЕсли;
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Если Статус = "archived" Тогда
		Результат = ОбработкаОбъект.ВосстановитьКонтрагентаИзАрхива(ИдентификаторКонтрагента);
	Иначе
		Результат = ОбработкаОбъект.ОтправитьЗапросНаОбменСКонтрагентом(ИдентификаторКонтрагента);	
	КонецЕсли;
	Если Результат.Получить("success") <> Неопределено Тогда
		Если Результат.Получить("success") = Истина Тогда
			Возврат Истина;		
		Иначе
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = Результат.Получить("codeDescription");
			Сообщение.Сообщить();
			Возврат Ложь;	
		КонецЕсли;
	КонецЕсли;
	Возврат Ложь;

КонецФункции


