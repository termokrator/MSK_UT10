			ОбластьМакета.Параметры.ИННКПППродавца = ""
			+ ФормированиеПечатныхФорм.ОписаниеОрганизации(СведенияОПоставщике, "ИНН,", Ложь) + КПП;
			
		Иначе
			ОбластьМакета.Параметры.ИННКПППродавца = "--"
		КонецЕсли;
		
