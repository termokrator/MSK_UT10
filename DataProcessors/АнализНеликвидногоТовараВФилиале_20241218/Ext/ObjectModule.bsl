		Если ГруппаПроцентов1 > 0 Тогда 			
			
			УстановитьЗначениеABC(Стр.НомерСтроки, "НомерСтроки", "A", "ABCКоличествоРеализации", ГруппаПроцентов1, Стр.КоличествоРеализаций); 			
			Продолжить;
			
		КонецЕсли;
		
		Если ГруппаПроцентов2 > 0 Тогда 
			
			УстановитьЗначениеABC(Стр.НомерСтроки, "НомерСтроки", "B", "ABCКоличествоРеализации", ГруппаПроцентов2, Стр.КоличествоРеализаций);			
			Продолжить;
			
		КонецЕсли;
		
		Если ГруппаПроцентов3 > 0 Тогда 
			
			УстановитьЗначениеABC(Стр.НомерСтроки, "НомерСтроки", "C", "ABCКоличествоРеализации", ГруппаПроцентов3, Стр.КоличествоРеализаций);						
			Продолжить;
			
		КонецЕсли;
		
		Если ГруппаПроцентов3 <= 0 И ГруппаПроцентов2 <= 0 И ГруппаПроцентов1 <= 0 Тогда
			
			УстановитьЗначениеABC(Стр.НомерСтроки, "НомерСтроки", "C", "ABCКоличествоРеализации", ГруппаПроцентов3, Стр.КоличествоРеализаций);						
			Продолжить;
			
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры

Процедура РассчитатьМинимальныйИМаксимальнойОстаток(НоваяСтрока, Стр)
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
	
	// Теперь минимальный остаток...
	МО = Окр(НоваяСтрока.СреднееКоличествоПродано * (СкоростьОприходования + 1), 0, 1);
	СредГлубПродаж = Окр(НоваяСтрока.СредняяГлубинаПродаж, 0, 1);
	НужнаяОкругленнаяШтука = НайтиБлижайщую(МО, СредГлубПродаж);
	Кратность = Окр(НоваяСтрока.Кратность, 0, 1);
	НужнаяОкругленнаяШтука = НайтиБлижайщую(НужнаяОкругленнаяШтука, Кратность);
	
	Если НужнаяОкругленнаяШтука <= НоваяСтрока.Кратность Тогда 				
		НоваяСтрока.МинОстаток = НоваяСтрока.Кратность;
	Иначе 
		НоваяСтрока.МинОстаток = НайтиБлижайщую(НужнаяОкругленнаяШтука, Кратность, 1);
	КонецЕсли;
	
	// Теперь максимальный остаток...
	Если ЗначениеЗаполнено(Стр.КоличествоДнейВПродаже) Тогда
		
		Если Стр.КоличествоДнейВПродаже >= 100 Тогда
			МО = Окр(НоваяСтрока.СреднееКоличествоПроданоВариант2 * (ГлубинаЗаказа * 7 + СкоростьОприходования), 0, 1);	
		Иначе
			МО = Окр(НоваяСтрока.СреднееКоличествоПродано * (ГлубинаЗаказа * 7 + СкоростьОприходования), 0, 1);
		КонецЕсли;
		
	КонецЕсли;
	
	НужнаяОкругленнаяШтука = МО;
	
	Если НужнаяОкругленнаяШтука <= НоваяСтрока.Кратность Тогда 					
		НоваяСтрока.МаксОстаток = НоваяСтрока.Кратность;
	Иначе 
		
		Кратность = Окр(НоваяСтрока.Кратность, 0, 1);
		НоваяСтрока.МаксОстаток = НайтиБлижайщую(НужнаяОкругленнаяШтука, Кратность, 2);
		
	КонецЕсли;

КонецПроцедуры
	
Процедура РасчитатьABCКоличествоПродажи(ТЗ, ГруппаПроцентов1, ГруппаПроцентов2, ГруппаПроцентов3) Экспорт
	
	Для каждого Стр Из ТЗ Цикл   
		
		НоваяСтрока = Товары.Добавить();
		
		Стр.НомерСтроки = НоваяСтрока.НомерСтроки; 

		// Расчет xyz
		СреднееКоличествоПроданоВМесяц = (Стр.КоличествоПродано - Стр.КоличествоВозвращенногоТовара) / КоличествоПериодов;
		
		Если СреднееКоличествоПроданоВМесяц <= 0 Тогда 
			
			СреднееКоличествоПроданоВМесяц = 0;
			НоваяСтрока.КоэффициентВариации = 0;
			
		Иначе	
			
			СтандартноеОтклонениеОбъемаПродаж = 0;
			
			Для сч = 1 по КоличествоПериодов Цикл
				
				СтандартноеОтклонениеОбъемаПродаж = СтандартноеОтклонениеОбъемаПродаж +
				(Стр["КоличествоОборот" + сч] - СреднееКоличествоПроданоВМесяц) * (Стр["КоличествоОборот" + сч] - СреднееКоличествоПроданоВМесяц);
				
			КонецЦикла;
			
			СтандартноеОтклонениеОбъемаПродаж = СтандартноеОтклонениеОбъемаПродаж / КоличествоПериодов;
			СтандартноеОтклонениеОбъемаПродаж = Sqrt(СтандартноеОтклонениеОбъемаПродаж);
			
			НоваяСтрока.КоэффициентВариации = Окр(СтандартноеОтклонениеОбъемаПродаж/СреднееКоличествоПроданоВМесяц * 100, 2, РежимОкругления.Окр15как20);
			
			Если НоваяСтрока.КоэффициентВариации >= 0 и НоваяСтрока.КоэффициентВариации <= Xпараметр Тогда 
				НоваяСтрока.XYZ = "X";
			ИначеЕсли НоваяСтрока.КоэффициентВариации > Xпараметр и НоваяСтрока.КоэффициентВариации <= Yпараметр Тогда
				НоваяСтрока.XYZ = "Y";					
			Иначе
				НоваяСтрока.XYZ = "Z";	
			КонецЕсли;
			
		КонецЕсли;
		
		Если ГруппаПроцентов1 > 0 Тогда 
			
			НоваяСтрока.Класс = "A";
			
			РассчитатьМинимальныйИМаксимальнойОстаток(НоваяСтрока, Стр);
			
			ГруппаПроцентов1 = ГруппаПроцентов1 - МИН(ГруппаПроцентов1, Стр.КоличествоПродано);
			Продолжить;
			
		КонецЕсли;
		
		Если ГруппаПроцентов2 > 0 Тогда 
			
			НоваяСтрока.Класс = "B";
			
			РассчитатьМинимальныйИМаксимальнойОстаток(НоваяСтрока, Стр);
			
			ГруппаПроцентов2 = ГруппаПроцентов2 - МИН(ГруппаПроцентов2, Стр.КоличествоПродано);
			Продолжить;
			
		КонецЕсли;
		
		Если ГруппаПроцентов3 > 0 Тогда 
			
			НоваяСтрока.Класс = "C";
			
			РассчитатьМинимальныйИМаксимальнойОстаток(НоваяСтрока, Стр);
			
			ГруппаПроцентов3 = ГруппаПроцентов3 - МИН(ГруппаПроцентов3, Стр.КоличествоПродано);
			Продолжить;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция НайтиБлижайщую(МО,СредГлубПродаж,Признак = 0) Экспорт
	
	Если Признак = 0 Тогда 
		
		КолЦифр = СтрДлина(МО);
		К = Pow(10, КолЦифр - 1);
		
		ППП = Окр(МО / К, 0, 1);           
		ППП = ППП * К;     // 109 -> 100;   находим ППП, равное округленному до старшего разряда МО
		
		Если СредГлубПродаж = 0 ИЛИ СредГлубПродаж > МО Тогда   // если МО маленькое, или СредГлубПродаж нулевое, то возврат МО без всяких преобразований
			Возврат МО;
		КонецЕсли;
		
		Если (ППП - СредГлубПродаж ) > СредГлубПродаж * 2 - ППП Тогда 
			
			//+Шульман А. 01.04.2024 #К
			//~М:
			//Промежуток1 = МО / СредГлубПродаж;
			//Промежуток2 = Окр(Промежуток1, 0, 1);
			//
			//Если Промежуток1 = Промежуток2 Тогда 
			//	Возврат МО;
			//Иначе 
			//	МО = МО + 1;
			//	Перейти ~М;
			//КонецЕсли; 
			
			Промежуток1 = МО / СредГлубПродаж;
			Промежуток2 = Окр(Промежуток1, 0, 1);
			
			Пока Не Промежуток1 = Промежуток2 Цикл
			
				МО = МО + 1;
				Промежуток1 = МО / СредГлубПродаж;
				Промежуток2 = Окр(Промежуток1, 0, 1);
				
			КонецЦикла;
			
			Возврат МО;
			//-Шульман А. 01.04.2024 #К
			
		Иначе 
			
			//+Шульман А. 01.04.2024 #К
			//~М1:
			//Промежуток1 = МО / СредГлубПродаж;
			//Промежуток2 = Окр(Промежуток1, 0, 1);
			//
			//Если Промежуток1 = Промежуток2 Тогда 
			//	Возврат МО;
			//Иначе 
			//	МО = МО - 1;
			//	Перейти ~М1;
			//КонецЕсли;	
			
			Промежуток1 = МО / СредГлубПродаж;
			Промежуток2 = Окр(Промежуток1, 0, 1);   
			
			Пока Не Промежуток1 = Промежуток2 Цикл
			
				МО = МО - 1;
				Промежуток1 = МО / СредГлубПродаж;
				Промежуток2 = Окр(Промежуток1, 0, 1);   
				
			КонецЦикла;
			
			Возврат МО;
			//-Шульман А. 01.04.2024 #К
			
		КонецЕсли;
		
	Иначе 
		
		КолЦифр = СтрДлина(МО);
		К = Pow(10, КолЦифр - 1);
		
		ППП = Окр(МО / К, 0, 1);
		ППП = ППП * К;
		
		Если СредГлубПродаж = 0 ИЛИ СредГлубПродаж > МО Тогда 
			Возврат МО;
		КонецЕсли;
		
		//+Шульман А. 01.04.2024 #К
		//~М3:
		//Промежуток1 = МО / СредГлубПродаж;
		//Промежуток2 = Окр(Промежуток1, 0, 1);
		//
		//Если Промежуток1 = Промежуток2 Тогда 
		//	Возврат МО;
		//Иначе 
		//	Если Признак = 1 Тогда 
		//		МО = МО - 1;
		//	ИначеЕсли Признак = 2 Тогда 
		//		МО = МО + 1;
		//	Иначе
		//		МО = МО + 1;
		//	КонецЕсли;
		//	Перейти ~М3;
		//КонецЕсли;
		
		Промежуток1 = МО / СредГлубПродаж;
		Промежуток2 = Окр(Промежуток1, 0, 1);
		
		Пока Не Промежуток1 = Промежуток2 Цикл
		
			Если Признак = 1 Тогда 
				МО = МО - 1;
			Иначе
				МО = МО + 1;
			КонецЕсли;
			
			Промежуток1 = МО / СредГлубПродаж;
			Промежуток2 = Окр(Промежуток1, 0, 1);
		
		КонецЦикла;

		Возврат МО;
		//-Шульман А. 01.04.2024 #К
		
	КонецЕсли;                                    

КонецФункции

Функция ПроверкаНаДваПервыхСимволаА(АВС_Москва) Экспорт 
	
	ДваПервыхСимволаА = Лев(АВС_Москва, 2);
	ДваПервыхСимволаА2 = Лев(АВС_Москва, 1);
	
	Если Врег(ДваПервыхСимволаА) = ВРег("aa") или Врег(ДваПервыхСимволаА) = ВРег("ab")
		или Врег(ДваПервыхСимволаА) = ВРег("nn") или Врег(ДваПервыхСимволаА2) = ВРег("a") Тогда 
		Возврат Истина;
	Иначе 
		Возврат Ложь;
	КонецЕсли;

КонецФункции

Функция ПроверкаНаДваПервыхСимвола(АВС_Москва) Экспорт
	
	ТретийСимвол = ВРег(Прав(Лев(АВС_Москва, 3), 1));
	ДваПервыхСимвола2 = ВРег(Лев(АВС_Москва, 1));
	ПодстрокаПервыхСимволов = "ZRES";
	ПодстрокаТретьихСимволов = "ABCND";
	
	Если Найти(ПодстрокаПервыхСимволов, ДваПервыхСимвола2) = 0 И Найти(ПодстрокаТретьихСимволов, ТретийСимвол) <> 0 Тогда 
		Возврат Истина;
	Иначе 
		Возврат Ложь;
	КонецЕсли;

КонецФункции

Функция ПроверкаНаПервыйСимвол(АВС_Москва) Экспорт
	
	ПервыйСимвол = Лев(АВС_Москва, 1);
	
	Если Врег(ПервыйСимвол) <> ВРег("z") или Врег(ПервыйСимвол) <> ВРег("r")
		или Врег(ПервыйСимвол) <> ВРег("e") или Врег(ПервыйСимвол) <> ВРег("s") Тогда 
		Возврат Ложь;
	Иначе 
		Возврат Истина;
	КонецЕсли;

КонецФункции

Функция ПроверкаНаДваПервыхСимволаВ(АВС_Москва) Экспорт
	
	ДваПервыхСимволаВ = Лев(АВС_Москва, 2);
	ДваПервыхСимволаВ2 = Лев(АВС_Москва, 1);
	
	Если Врег(ДваПервыхСимволаВ) = ВРег("aa") или Врег(ДваПервыхСимволаВ) = ВРег("ab")
		или Врег(ДваПервыхСимволаВ) = ВРег("bb") или Врег(ДваПервыхСимволаВ) = ВРег("nn") 
		или Врег(ДваПервыхСимволаВ2) = ВРег("c") или Врег(ДваПервыхСимволаВ2) = ВРег("a") или Врег(ДваПервыхСимволаВ2) = ВРег("b") Тогда 
		Возврат Истина;
	Иначе 
		Возврат Ложь;
	КонецЕсли;

КонецФункции

Процедура ЗаполнитьОтборПостроителя(ПостроительОтчета) Экспорт
КонецПроцедуры // ЗаполнитьОтборПостроителя()

// Создать и заполнить построитель для отбора
Процедура ИнициироватьПостроительДляОтбора(ПостроительОтчета) Экспорт
	
	ПостроительОтчета.ИсточникДанных = Новый ОписаниеИсточникаДанных(Товары.Выгрузить());
	ПостроительОтчета.ЗаполнитьНастройки();
	СтруктураПредставлениеПолей = Новый Структура;
	ЗаполнитьОтборПостроителя(ПостроительОтчета);

КонецПроцедуры

Процедура ВосстановитьНастройкиРегламентаИзСтруктуры(СохраненнаяНастройка) Экспорт
	
	СохраненнаяНастройка.Свойство("АКласс"					          , АКласс);
	СохраненнаяНастройка.Свойство("БКласс"					          , БКласс);		
	СохраненнаяНастройка.Свойство("СКласс"					          , СКласс);
	СохраненнаяНастройка.Свойство("ГлубинаЗаказа"				      , ГлубинаЗаказа);
	СохраненнаяНастройка.Свойство("СкоростьОприходования"		      , СкоростьОприходования);
	СохраненнаяНастройка.Свойство("КолСтрок"					      , КолСтрок);
	СохраненнаяНастройка.Свойство("Xпараметр"					      , Xпараметр);
	СохраненнаяНастройка.Свойство("Yпараметр"					      , Yпараметр);
	СохраненнаяНастройка.Свойство("КоличествоНедельВПериоде"          , КоличествоНедельВПериоде);
	СохраненнаяНастройка.Свойство("КоличествоПериодов"			      , КоличествоПериодов);
	СохраненнаяНастройка.Свойство("КоличествоДнейПериода"             , КоличествоДнейПериода);
	СохраненнаяНастройка.Свойство("КоличествоРеализацийБолее"	      , КоличествоРеализацийБолее);	
	СохраненнаяНастройка.Свойство("ПриводитьКМинимальнымУпаковкам"    , ПриводитьКМинимальнымУпаковкам);
	СохраненнаяНастройка.Свойство("Отсев"							  , Отсев);
	СохраненнаяНастройка.Свойство("ДокументыПровести"				  , ДокументыПровести);
	СохраненнаяНастройка.Свойство("ИсключатьНегабарит"			      , ИсключатьНегабарит);
	СохраненнаяНастройка.Свойство("ПрямойКонтракт"			          , ПрямойКонтракт);
	СохраненнаяНастройка.Свойство("Покупатель"			              , Покупатель);
	
	ВрБрендыОтборВключить = Неопределено;
	
	Если СохраненнаяНастройка.Свойство("БрендыОтборВключить"		  , ВрБрендыОтборВключить) Тогда
		БрендыОтборВключить.Загрузить(ВрБрендыОтборВключить);
	КонецЕсли;
	
	ВрБрендыОтборИсключить = Неопределено;
	
	Если СохраненнаяНастройка.Свойство("БрендыОтборИсключить"		  , ВрБрендыОтборИсключить) Тогда
		БрендыОтборИсключить.Загрузить(ВрБрендыОтборИсключить);
	КонецЕсли;
	
	ВрНоменклатурныеГруппыОтборВключить = Неопределено;
	
	Если СохраненнаяНастройка.Свойство("НоменклатурныеГруппыОтборВключить" , ВрНоменклатурныеГруппыОтборВключить) Тогда
		НоменклатурныеГруппыОтборВключить.Загрузить(ВрНоменклатурныеГруппыОтборВключить);
	КонецЕсли;
	
	ВрНоменклатурныеГруппыОтборИсключить = Неопределено;
	
	Если СохраненнаяНастройка.Свойство("НоменклатурныеГруппыОтборИсключить"		  , ВрНоменклатурныеГруппыОтборИсключить) Тогда
		НоменклатурныеГруппыОтборИсключить.Загрузить(ВрНоменклатурныеГруппыОтборИсключить);
	КонецЕсли;
	
	ВрПостроительОтчета = Неопределено;
	
	Если СохраненнаяНастройка.Свойство("НастройкаПостроителя"		          , ВрПостроительОтчета) Тогда	
		
		НастройкаПостроителя = ВрПостроительОтчета;
		ИнициироватьПостроительДляОтбора(ПостроительОтчета);
		ПостроительОтчета.УстановитьНастройки(НастройкаПостроителя);
		
	КонецЕсли;
	
	СохраненнаяНастройка.Свойство("ДатаДокумента"					          , ДатаДокумента);

КонецПроцедуры

Процедура СохранитьНастройкиРегламентаВСтруктуру(СохраненнаяНастройка) Экспорт
	
	СохраненнаяНастройка.Вставить("АКласс"						      , АКласс);
	СохраненнаяНастройка.Вставить("БКласс"						      , БКласс);
	СохраненнаяНастройка.Вставить("СКласс"   					      , СКласс);	
	СохраненнаяНастройка.Вставить("ГлубинаЗаказа"   			      , ГлубинаЗаказа);
	СохраненнаяНастройка.Вставить("СкоростьОприходования"   	      , СкоростьОприходования);
	СохраненнаяНастройка.Вставить("КолСтрок"   					      , КолСтрок);
	СохраненнаяНастройка.Вставить("Xпараметр"   				      , Xпараметр);
	СохраненнаяНастройка.Вставить("Yпараметр"   				      , Yпараметр);
	СохраненнаяНастройка.Вставить("КоличествоНедельВПериоде"   	      , КоличествоНедельВПериоде);
	СохраненнаяНастройка.Вставить("КоличествоПериодов"   		      , КоличествоПериодов); 	
	СохраненнаяНастройка.Вставить("КоличествоДнейПериода"             , КоличествоДнейПериода);
	СохраненнаяНастройка.Вставить("КоличествоРеализацийБолее"	      , КоличествоРеализацийБолее);
	СохраненнаяНастройка.Вставить("ПриводитьКМинимальнымУпаковкам"    , ПриводитьКМинимальнымУпаковкам);
	СохраненнаяНастройка.Вставить("ИсключатьНегабарит"			      , ИсключатьНегабарит);
	СохраненнаяНастройка.Вставить("Отсев"							  , Отсев);
	СохраненнаяНастройка.Вставить("ДокументыПровести"				  , ДокументыПровести);
	СохраненнаяНастройка.Вставить("БрендыОтборВключить"			      , БрендыОтборВключить.Выгрузить());
	СохраненнаяНастройка.Вставить("БрендыОтборИсключить"		      , БрендыОтборИсключить.Выгрузить());
	СохраненнаяНастройка.Вставить("НоменклатурныеГруппыОтборВключить" , НоменклатурныеГруппыОтборВключить.Выгрузить());
	СохраненнаяНастройка.Вставить("НоменклатурныеГруппыОтборИсключить", НоменклатурныеГруппыОтборИсключить.Выгрузить());
	СохраненнаяНастройка.Вставить("НастройкаПостроителя"			  , ПостроительОтчета.ПолучитьНастройки());
	СохраненнаяНастройка.Вставить("ДатаДокумента"					  , ДатаДокумента);
	СохраненнаяНастройка.Вставить("ПрямойКонтракт"					  , ПрямойКонтракт);
	СохраненнаяНастройка.Вставить("Покупатель"					      , Покупатель);

КонецПроцедуры

Процедура РегламентноеВыполнение() Экспорт
	
	СтруктураНастройки = Новый Структура;
	СтруктураНастройки.Вставить("Пользователь", Справочники.Пользователи.НайтиПоКоду("webadmin"));
	СтруктураНастройки.Вставить("ИмяОбъекта", "ОбработкаОбъект.АнализНеликвидногоТовараВФилиале");	
	СтруктураНастройки.Вставить("НаименованиеНастройки", "АнализНеликвидногоТовараРегламентное");
	
	Если УниверсальныеМеханизмы.ПолучитьНастройку(СтруктураНастройки) Тогда
		
		ЭтотОбъект.мТекущаяНастройка = СтруктураНастройки;
		ВосстановитьНастройкиРегламентаИзСтруктуры(СтруктураНастройки.СохраненнаяНастройка);
		
		КонПериода	  = ТекущаяДата();		
		НачПериода    = КонПериода - 86400 * (КоличествоДнейПериода - 1);
		
		ИнициироватьПостроительДляОтбора(ПостроительОтчета);
		ВыполнитьЗапрос();
		
		ЗаполнитьКолонкуВЗаказМодуль();
		МассивНовыхДокументов = Новый Массив;
		
		Если Не ПрямойКонтракт Тогда
			
			Если Константы.ГорючиеЖидкостиВОтдельныйЗаказ.Получить() Тогда
				
				Если ИсключатьНегабарит Тогда
					
					СоздатьДокументыМодуль(Ложь, МассивНовыхДокументов, Истина, Ложь);
					СоздатьДокументыМодуль(Ложь, МассивНовыхДокументов, Истина, Истина);
					СоздатьДокументыМодуль(Истина, МассивНовыхДокументов, Истина); 
					
				Иначе
					
					СоздатьДокументыМодуль(Неопределено, МассивНовыхДокументов, Истина, Ложь);
					СоздатьДокументыМодуль(Неопределено, МассивНовыхДокументов, Истина, Истина);
					
				КонецЕсли;		
				
			Иначе		
				
				Если ИсключатьНегабарит Тогда
					
					СоздатьДокументыМодуль(Ложь, МассивНовыхДокументов, Истина);
					СоздатьДокументыМодуль(Истина, МассивНовыхДокументов, Истина); 
					
				Иначе
					СоздатьДокументыМодуль(Неопределено, МассивНовыхДокументов, Истина);
				КонецЕсли; 
				
			КонецЕсли;  		
			
		Иначе
			
			Если ИсключатьНегабарит Тогда
				
				СоздатьДокументыМодуль(Ложь, МассивНовыхДокументов);
				СоздатьДокументыМодуль(Истина, МассивНовыхДокументов); 
				
			Иначе
				СоздатьДокументыМодуль(Неопределено,МассивНовыхДокументов);
			КонецЕсли;					
			
		КонецЕсли; 
		
	КонецЕсли; 	

КонецПроцедуры

Процедура СоздатьДокументыМодуль(мНегабарит = Неопределено,МассивНовыхДокументов,ЭтоРегламент = Ложь,ЗаказНаГорючиеЖидкости = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	*
	|ПОМЕСТИТЬ ТаблицаТовары
	|ИЗ
	|	&ТаблицаТовары КАК ТаблицаТовары
	|ГДЕ
	|	ТаблицаТовары.ВЗаказ > 0 ";

	Если НЕ мНегабарит = Неопределено Тогда
		
		Запрос.Текст = Запрос.Текст +
		"  И ТаблицаТовары.Негабарит = &Негабарит ";
		Запрос.УстановитьПараметр("Негабарит", мНегабарит);
		
	КонецЕсли; 		
	
	Запрос.Текст = Запрос.Текст + "	
	|
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	*
	|ИЗ
	|	ТаблицаТовары КАК ТаблицаТовары";
	
	Запрос.УстановитьПараметр("ТаблицаТовары", Товары.Выгрузить());
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		
		#Если Клиент Тогда
		Предупреждение("Нет строк для переноса в документ!", 20);
		#КонецЕсли
		Возврат;
		
	Иначе	
		
		ДатаДокумента = ?(ДатаДокумента = Дата(1, 1, 1), ТекущаяДата(), ДатаДокумента);
		Грузополучатель = Покупатель;
		Контрагент = Покупатель.ГоловнойКонтрагент;

		ЗапросДоговора = Новый Запрос;
		ЗапросДоговора.Текст =
		"ВЫБРАТЬ
		|	Константы.ОсновнаяОрганизация
		|ПОМЕСТИТЬ КонстОснОрганизация
		|ИЗ
		|	Константы КАК Константы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДоговорыКонтрагентов.Ссылка КАК Договор
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов,
		|	КонстОснОрганизация КАК КонстОснОрганизация
		|ГДЕ
		|	ДоговорыКонтрагентов.Владелец = &Владелец
		|	И ДоговорыКонтрагентов.Организация = КонстОснОрганизация.ОсновнаяОрганизация
		|	И ДоговорыКонтрагентов.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПокупателем)
		|	И НЕ ДоговорыКонтрагентов.ПометкаУдаления";
		
		ЗапросДоговора.УстановитьПараметр("Владелец", Контрагент);
		РезультатЗапросаДоговора = ЗапросДоговора.Выполнить().Выгрузить();
		
		Если НЕ РезультатЗапросаДоговора.Количество() = 0 Тогда
			ДоговорКонтагента = РезультатЗапросаДоговора[0].Договор;
		Иначе			 
			ДоговорКонтагента 	= Контрагент.ОсновнойДоговорКонтрагента;
		КонецЕсли;
		
	    Если ДоговорКонтагента.Пустая() Или НЕ ДоговорКонтагента.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем Тогда
			
			#Если Клиент Тогда
			Сообщить("Договор вида ""С Ппокупателем"" у контрагента " + """" + Контрагент + """ отсутствует или не выбран.", СтатусСообщения.ОченьВажное);			
			#КонецЕсли
			Возврат;
			
		КонецЕсли; 
		
		//+Шульман А. 16.12.2024 #UT10-4991
		ИспользоватьПроцессПеремещениеНеликвидаТОХвГП = Справочники.МТ_ПредопределенныеЗначения.ИспользоватьПроцессПеремещениеНеликвидаТОХвГП.Значение = Истина;
		//-Шульман А. 16.12.2024 #UT10-4991	
		
		Склад 				= Константы.ОсновнойСклад.Получить();
		СтрокВДокументе 	= 0; 
		ТекТовар 			= 0;
		
		Выборка = Результат.Выбрать();
		НовыйДокумент = Документы.ЗаказПокупателя.СоздатьДокумент();
	
		Пока Выборка.Следующий() Цикл
			
			ТекТовар 		= ТекТовар + 1;
			СтрокВДокументе	= СтрокВДокументе + 1;
			
			НоваяСтрокаТЧ 					= НовыйДокумент.Товары.Добавить();
			НоваяСтрокаТЧ.Номенклатура 		= Выборка.Номенклатура;
			НоваяСтрокаТЧ.ЕдиницаИзмерения 	= НоваяСтрокаТЧ.Номенклатура.ЕдиницаХраненияОстатков;
			НоваяСтрокаТЧ.Количество 		= Выборка.ВЗаказ;
			НоваяСтрокаТЧ.Коэффициент 		= НоваяСтрокаТЧ.ЕдиницаИзмерения.Коэффициент;
			//+Гавриленков В. 18.12.2025 #UT10-5598 Временное решение
			//НоваяСтрокаТЧ.СтавкаНДС 		= НоваяСтрокаТЧ.Номенклатура.СтавкаНДС;
			НоваяСтрокаТЧ.СтавкаНДС 		= УчетНДС.ПолучитьСтавкуНДСПоНоменклатуре(НоваяСтрокаТЧ.Номенклатура, ДатаДокумента);
			//-Гавриленков В. 18.12.2025 #UT10-5598
			СтавкаНДС = УчетНДС.ПолучитьСтавкуНДС(НоваяСтрокаТЧ.СтавкаНДС);
			НоваяСтрокаТЧ.Цена 				= Выборка.ЗакупочнаяЦена;			
			
			Если СтрокВДокументе = КолСтрок ИЛИ ТекТовар= Выборка.Количество() Тогда 
				
				НовыйДокумент.Дата 					= ДатаДокумента;
				НовыйДокумент.Контрагент  			= Контрагент;
				НовыйДокумент.Грузополучатель       = Грузополучатель;
				НовыйДокумент.СпособДоставки        = Грузополучатель.СпособДоставки;  
				//+Пашкин О. 21.05.2025 #UT10-5188 
				Если ВидПроцесса = Перечисления.ВидыПроцессов.ВозвратТОХИзГППоставщику Тогда
					
					НовыйДокумент.ВидПроцесса = ВидПроцесса;  
					НовыйДокумент.ДоговорПоставщикаТОХ = ДоговорПоставщикаТОХ;
					
					Если ЗначениеЗаполнено(СпособДоставки) Тогда
						НовыйДокумент.СпособДоставки        = СпособДоставки;  
					КонецЕсли;
					
				КонецЕсли;	
				//-Пашкин О. 21.05.2025 #UT10-5188 
				НовыйДокумент.ИсточникЗаказа        = Справочники.ИсточникиЗаказов.НайтиПоРеквизиту("КодИсточника", 5);
				НовыйДокумент.ДоговорКонтрагента 	= ДоговорКонтагента; 
				НовыйДокумент.ВалютаДокумента 		= ДоговорКонтагента.ВалютаВзаиморасчетов;
				НовыйДокумент.КурсВзаиморасчетов 	= 1;
				НовыйДокумент.КратностьВзаиморасчетов = 1;
				НовыйДокумент.Организация 			= ДоговорКонтагента.Организация;
				НовыйДокумент.СуммаВключаетНДС 		= Истина;
				НовыйДокумент.УчитыватьНДС 			= Истина;
				НовыйДокумент.СкладГруппа			= Склад;
				НовыйДокумент.Ответственный         = ПараметрыСеанса.ТекущийПользователь;     
				
				//+Шульман А. 16.12.2024 #UT10-4991    
				Если ИспользоватьПроцессПеремещениеНеликвидаТОХвГП Тогда
					
					НовыйДокумент.ВидПроцесса = ВидПроцесса;  
					НовыйДокумент.ДоговорПоставщикаТОХ = ДоговорПоставщикаТОХ;
					
					//+Кабанов А.В. 23.06.2025 # UT10-5295 
					НовыйДокумент.ВозвратПоставщикуБезРазбораВГП = ВозвратПоставщикуБезРазбораВГП;
					//-Кабанов А.В. 23.06.2025 # UT10-5295     
					
				КонецЕсли;
				//-Шульман А. 16.12.2024 #UT10-4991
				
				Для Каждого СтрокаТЧ Из НовыйДокумент.Товары Цикл
					
					Если СтрокаТЧ.Цена = 0 Тогда
						СтрокаТЧ.Цена = 1;						
					КонецЕсли;
					
					ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(СтрокаТЧ, НовыйДокумент);
					ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(СтрокаТЧ, НовыйДокумент);	
					
				КонецЦикла;				
				
				Если ЭтоРегламент Тогда
					НовыйДокумент.Комментарий = "Документ создан регламентным заданием Анализ неликвидного товара";
				КонецЕсли;
				
				//_Заполнить и провести
				ВидимостьСерии = Истина;
				Авторезервирование = Истина;
				Авторазмещение = Ложь;
				СтратегияАвторезервированияПоЗаказам = Перечисления.СтратегииАвторезервированияНоменклатуры.СначалаНаСкладахПотомВЗаказахПоставщикам;				
				
				СтруктураПараметров = Новый Структура;
				СтруктураПараметров.Вставить("ВидимостьСерии",     ВидимостьСерии);
				СтруктураПараметров.Вставить("Авторезервирование", Авторезервирование);
				СтруктураПараметров.Вставить("Авторазмещение",     Авторазмещение);
				СтруктураПараметров.Вставить("СтратегияАвторезервированияПоЗаказам", СтратегияАвторезервированияПоЗаказам);
				НовыйДокумент.ЗаполнитьТабличныеЧастиПередПроведениемУпр(СтруктураПараметров);
				
				//+Гавриленков В. 21.08.2025 #UT10-5390 
				сч = 0;
				Пока сч < НовыйДокумент.Товары.Количество() Цикл 
					
					ТекСтрока = НовыйДокумент.Товары.Получить(сч);
					
					Если Не ЗначениеЗаполнено(ТекСтрока.Размещение) Тогда
						НовыйДокумент.Товары.Удалить(ТекСтрока);
					Иначе
						сч = сч + 1;
					КонецЕсли;
					
				КонецЦикла;
				
				Если ТекущаяДата() >= Константы.РезервированиеЗаказовСУчетомЯчеек.Получить() Тогда      
					
					ТЗ = НовыйДокумент.Товары.Выгрузить();
					ТЗ.Свернуть("Номенклатура,Размещение", "Количество");
					
					Запрос = Новый Запрос;
					Запрос.Текст =
					"ВЫБРАТЬ
					|	Константы.ИспользоватьАлгоритмПроверкиКратностиФилиала КАК ЗначениеКонстанты
					|ПОМЕСТИТЬ КонстКратности
					|ИЗ
					|	Константы КАК Константы
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ
					|	ТЗ.Номенклатура КАК Номенклатура,
					|	ТЗ.Количество КАК Количество,
					|	ТЗ.Размещение КАК Размещение
					|ПОМЕСТИТЬ ТаблицаНоменклатура
					|ИЗ
					|	&ТЗ КАК ТЗ
					|ГДЕ
					|	ТЗ.Размещение <> НЕОПРЕДЕЛЕНО
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ
					|	ТоварыВЯчейкахОстатки.Номенклатура,
					|	ТоварыВЯчейкахОстатки.КоличествоОстаток КАК Остаток,
					|	1 КАК Поле1
					|ПОМЕСТИТЬ Остатки
					|ИЗ
					|	ТаблицаНоменклатура КАК ТаблицаНоменклатура
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках.Остатки(, НЕ Ячейка.НеУчитыватьВОперативномУчете) КАК ТоварыВЯчейкахОстатки
					|		ПО ТаблицаНоменклатура.Номенклатура = ТоварыВЯчейкахОстатки.Номенклатура
					|ГДЕ
					|	ТоварыВЯчейкахОстатки.Ячейка.НеУчитыватьВОперативномУчете = ЛОЖЬ
					|
					|ОБЪЕДИНИТЬ ВСЕ
					|
					|ВЫБРАТЬ
					|	ТоварыГотовыеКСборкеОстатки.Номенклатура,
					|	-ТоварыГотовыеКСборкеОстатки.КоличествоОстаток,
					|	3
					|ИЗ
					|	ТаблицаНоменклатура КАК ТаблицаНоменклатура
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыГотовыеКСборке.Остатки(, ) КАК ТоварыГотовыеКСборкеОстатки
					|		ПО ТаблицаНоменклатура.Номенклатура = ТоварыГотовыеКСборкеОстатки.Номенклатура
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ
					|	Остатки.Номенклатура,
					|	СУММА(Остатки.Остаток) КАК Остаток,
					|	МАКСИМУМ(ВЫБОР
					|			КОГДА КонстКратности.ЗначениеКонстанты
					|				ТОГДА ВЫБОР
					|						КОГДА НЕ Остатки.Номенклатура.КратностьФилиала = 0
					|							ТОГДА Остатки.Номенклатура.КратностьФилиала
					|						ИНАЧЕ ВЫБОР
					|								КОГДА Остатки.Номенклатура.Кратность = 0
					|									ТОГДА 1
					|								ИНАЧЕ Остатки.Номенклатура.Кратность
					|							КОНЕЦ
					|					КОНЕЦ
					|			ИНАЧЕ Остатки.Номенклатура.Кратность
					|		КОНЕЦ) КАК Кратность
					|ПОМЕСТИТЬ ОстаткиГруппа
					|ИЗ
					|	Остатки КАК Остатки,
					|	КонстКратности КАК КонстКратности
					|
					|СГРУППИРОВАТЬ ПО
					|	Остатки.Номенклатура
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ
					|	ОстаткиГруппа.Номенклатура,
					|	СУММА(ОстаткиГруппа.Остаток) КАК Остаток,
					|	СУММА(ВЫБОР
					|			КОГДА ОстаткиГруппа.Остаток > 0
					|				ТОГДА ВЫБОР
					|						КОГДА ОстаткиГруппа.Кратность > ОстаткиГруппа.Остаток
					|							ТОГДА 0
					|						ИНАЧЕ ВЫБОР
					|								КОГДА (ВЫРАЗИТЬ(ОстаткиГруппа.Остаток / ОстаткиГруппа.Кратность - 0.5 КАК ЧИСЛО(15, 0))) * ОстаткиГруппа.Кратность <= ОстаткиГруппа.Остаток
					|									ТОГДА (ВЫРАЗИТЬ(ОстаткиГруппа.Остаток / ОстаткиГруппа.Кратность - 0.5 КАК ЧИСЛО(15, 0))) * ОстаткиГруппа.Кратность
					|								ИНАЧЕ ВЫРАЗИТЬ(ОстаткиГруппа.Остаток / ОстаткиГруппа.Кратность - 0.5 КАК ЧИСЛО(15, 0))
					|							КОНЕЦ
					|					КОНЕЦ
					|			ИНАЧЕ ВЫБОР
					|					КОГДА (ВЫРАЗИТЬ(ОстаткиГруппа.Остаток / ОстаткиГруппа.Кратность + 0.5 КАК ЧИСЛО(15, 0))) * ОстаткиГруппа.Кратность <= ОстаткиГруппа.Остаток
					|						ТОГДА (ВЫРАЗИТЬ(ОстаткиГруппа.Остаток / ОстаткиГруппа.Кратность + 0.5 КАК ЧИСЛО(15, 0))) * ОстаткиГруппа.Кратность
					|					ИНАЧЕ ВЫРАЗИТЬ(ОстаткиГруппа.Остаток / ОстаткиГруппа.Кратность + 0.5 КАК ЧИСЛО(15, 0))
					|				КОНЕЦ
					|		КОНЕЦ) КАК ОстатокПоКратности,
					|	ОстаткиГруппа.Кратность
					|ПОМЕСТИТЬ ОстаткиИтог
					|ИЗ
					|	ОстаткиГруппа КАК ОстаткиГруппа
					|ГДЕ
					|	ОстаткиГруппа.Остаток > 0
					|
					|СГРУППИРОВАТЬ ПО
					|	ОстаткиГруппа.Номенклатура,
					|	ОстаткиГруппа.Кратность
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ
					|	ТаблицаНоменклатура.Номенклатура,
					|	ВЫБОР
					|		КОГДА ТаблицаНоменклатура.Количество - ЕСТЬNULL(ОстаткиИтог.Остаток, 0) > ТаблицаНоменклатура.Количество
					|			ТОГДА ТаблицаНоменклатура.Количество
					|		ИНАЧЕ ТаблицаНоменклатура.Количество - ЕСТЬNULL(ОстаткиИтог.Остаток, 0)
					|	КОНЕЦ КАК Нехватка_,
					|	ВЫБОР
					|		КОГДА ТаблицаНоменклатура.Количество - ЕСТЬNULL(ОстаткиИтог.ОстатокПоКратности, 0) > ТаблицаНоменклатура.Количество
					|			ТОГДА ТаблицаНоменклатура.Количество
					|		ИНАЧЕ ВЫБОР
					|				КОГДА ТаблицаНоменклатура.Количество < ОстаткиИтог.Кратность
					|					ТОГДА ТаблицаНоменклатура.Количество
					|				ИНАЧЕ ВЫБОР
					|						КОГДА ТаблицаНоменклатура.Количество < ЕСТЬNULL(ОстаткиИтог.ОстатокПоКратности, 0)
					|							ТОГДА ТаблицаНоменклатура.Количество - (ВЫРАЗИТЬ(ТаблицаНоменклатура.Количество / ОстаткиИтог.Кратность - 0.5 КАК ЧИСЛО(15, 0))) * ОстаткиИтог.Кратность
					|						ИНАЧЕ ТаблицаНоменклатура.Количество - ЕСТЬNULL(ОстаткиИтог.ОстатокПоКратности, 0)
					|					КОНЕЦ
					|			КОНЕЦ
					|	КОНЕЦ КАК Нехватка
					|ПОМЕСТИТЬ Рез
					|ИЗ
					|	ТаблицаНоменклатура КАК ТаблицаНоменклатура
					|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиИтог КАК ОстаткиИтог
					|		ПО ТаблицаНоменклатура.Номенклатура = ОстаткиИтог.Номенклатура
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ
					|	Рез.Номенклатура,
					|	Рез.Нехватка
					|ИЗ
					|	Рез КАК Рез
					|ГДЕ
					|	Рез.Нехватка > 0";         
					
					Запрос.УстановитьПараметр("ТЗ", ТЗ);
					Табл = Запрос.Выполнить().Выгрузить();    
					
					Для каждого стр из Табл Цикл          
						
						Отбор = Новый Структура;
						Отбор.Вставить("Номенклатура", Стр.Номенклатура);
						НайдСтроки = НовыйДокумент.Товары.НайтиСтроки(Отбор);
						КУменьшению = Стр.Нехватка;          
						
						Для каждого Строка из НайдСтроки Цикл   
														
							Если КУменьшению > 0 Тогда          
								
								Если Строка.Количество > КУменьшению Тогда   
									
									Строка.Количество = Строка.Количество - КУменьшению;
									СтрСумма = Строка.Количество * Строка.Цена;
									Строка.Сумма = СтрСумма;
									ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(Строка, НовыйДокумент);  
									
									КУменьшению = 0;
									
								Иначе                                             
									
									КУменьшению = КУменьшению - Строка.Количество; 
									
									НовыйДокумент.Товары.Удалить(Строка);
									
								КонецЕсли;
								
							КонецЕсли;   
							
						КонецЦикла;
						
					КонецЦикла;
					
				КонецЕсли;
				
				Если НовыйДокумент.Товары.Количество() > 0 Тогда 
				//-Гавриленков В. 21.08.2025 #UT10-5390
					Если ДокументыПровести  Тогда 
						НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
					Иначе 
						НовыйДокумент.Записать();
					КонецЕсли;  
					
					МассивНовыхДокументов.Добавить(НовыйДокумент);
				//+Гавриленков В. 21.08.2025 #UT10-5390
				КонецЕсли;
				//-Гавриленков В. 21.08.2025 #UT10-5390
				
				СтрокВДокументе = 0;
				
				Если ТекТовар <> Выборка.Количество() Тогда 
					НовыйДокумент = Документы.ЗаказПокупателя.СоздатьДокумент();
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

Процедура ВыполнитьЗапрос() Экспорт
	
	КоличествоДнейВВыбраномПериоде = (КонецДня(КонПериода) + 1 - НачалоДня(НачПериода)) / 86400;
	СредннейКоличествоДнейВПериоде = Окр(КоличествоДнейВВыбраномПериоде, 0, 1);
	
	// Запрос на продажи за период с сортировкой по убыванию
	Товары.Очистить();
	
	Запрос = Новый Запрос;
	
	Если Отсев Тогда 
		ТекстЗапросаОграничениеПоНоменклатуре = " 
		|			 Номенклатура В
		|					(ВЫБРАТЬ
		|						Номенклатура.Ссылка
		|						ИЗ
		|							Справочник.Номенклатура КАК Номенклатура
		|						ГДЕ
		|					НЕ Номенклатура.НеЗаказыватьАвтоматом )";
	Иначе
		ТекстЗапросаОграничениеПоНоменклатуре = "";
	КонецЕсли;
	
	Если БрендыОтборВключить.Количество()> 0 Тогда
		
		МассивБрендов = БрендыОтборВключить.ВыгрузитьКолонку("Бренд");
		Запрос.УстановитьПараметр("МассивБрендов", МассивБрендов);
		
		Если ТекстЗапросаОграничениеПоНоменклатуре = "" Тогда
			
			ТекстЗапросаОграничениеПоНоменклатуре = " 
			|			Номенклатура.Родитель В (&МассивБрендов) ";
			
		Иначе
			ТекстЗапросаОграничениеПоНоменклатуре = ТекстЗапросаОграничениеПоНоменклатуре
			+ " И Номенклатура.Родитель В (&МассивБрендов) ";
		КонецЕсли;
		
	КонецЕсли;
	
	Если НоменклатурныеГруппыОтборВключить.Количество() > 0 Тогда
		
		МассивНГ = НоменклатурныеГруппыОтборВключить.ВыгрузитьКолонку("НоменклатурнаяГруппа");
		Запрос.УстановитьПараметр("МассивНГ", МассивНГ);
		
		Если ТекстЗапросаОграничениеПоНоменклатуре = "" Тогда
			
			ТекстЗапросаОграничениеПоНоменклатуре = " 
			|			Номенклатура.НоменклатурнаяГруппа В (&МассивНГ) ";
			
		Иначе
			ТекстЗапросаОграничениеПоНоменклатуре = ТекстЗапросаОграничениеПоНоменклатуре
			+ " И Номенклатура.НоменклатурнаяГруппа В (&МассивНГ) ";
		КонецЕсли;
		
	КонецЕсли;
	
	Если БрендыОтборИсключить.Количество() > 0 Тогда
		
		МассивБрендовИсключить = БрендыОтборИсключить.ВыгрузитьКолонку("Бренд");
		Запрос.УстановитьПараметр("МассивБрендовИсключить", МассивБрендовИсключить);
		
		Если ТекстЗапросаОграничениеПоНоменклатуре = "" Тогда
			
			ТекстЗапросаОграничениеПоНоменклатуре = " 
			|			Номенклатура.Родитель НЕ В (&МассивБрендовИсключить) ";
			
		Иначе
			ТекстЗапросаОграничениеПоНоменклатуре = ТекстЗапросаОграничениеПоНоменклатуре
			+" И Номенклатура.Родитель НЕ В (&МассивБрендовИсключить) ";
		КонецЕсли;
		
	КонецЕсли;
	
	Если НоменклатурныеГруппыОтборИсключить.Количество() > 0 Тогда
		
		МассивНГИсключить = НоменклатурныеГруппыОтборИсключить.ВыгрузитьКолонку("НоменклатурнаяГруппа");
		Запрос.УстановитьПараметр("МассивНГИсключить", МассивНГИсключить);
		
		Если ТекстЗапросаОграничениеПоНоменклатуре = "" Тогда
			
			ТекстЗапросаОграничениеПоНоменклатуре = " 
			|			Номенклатура.НоменклатурнаяГруппа НЕ В (&МассивНГИсключить) ";
			
		Иначе
			ТекстЗапросаОграничениеПоНоменклатуре = ТекстЗапросаОграничениеПоНоменклатуре
			+ " И Номенклатура.НоменклатурнаяГруппа НЕ В (&МассивНГИсключить) ";
		КонецЕсли;
		
	КонецЕсли;
	
	ГруппаНоменклатурыУценка = Константы.ГруппаНоменклатурыУценка.Получить(); 
	
	Если Константы.ИспользоватьГруппуНоменклатурыУценка.Получить() и ЗначениеЗаполнено(ГруппаНоменклатурыУценка) Тогда
		
		Если ТекстЗапросаОграничениеПоНоменклатуре = "" Тогда
			ТекстЗапросаУценка = "
			|			НЕ Номенклатура В ИЕРАРХИИ(&Уценка) ";
		Иначе 
			ТекстЗапросаУценка = "
			|			И НЕ Номенклатура В ИЕРАРХИИ(&Уценка) "; 				
		КонецЕсли;
		
		Запрос.УстановитьПараметр("Уценка", ГруппаНоменклатурыУценка);
		
	Иначе
		ТекстЗапросаУценка = "";
	КонецЕсли;
	
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ПродажиОбороты.Номенклатура КАК Номенклатура,
