Функция ОбработатьТаблицу() 
	
	ПостроительОтчета.ИсточникДанных = новый ОписаниеИсточникаДанных(Товары.Выгрузить());
	
	ПостроительОтчета.Выполнить();
	Рез = ПостроительОтчета.Результат;
	Таб	= Рез.Выгрузить();
	
	Возврат Таб;
	
