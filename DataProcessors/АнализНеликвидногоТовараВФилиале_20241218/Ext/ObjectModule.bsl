Процедура ЗаполнитьКолонкуВЗаказМодуль(ТаблицаТоварыКоличество = Неопределено) Экспорт
	
	Для каждого ТекСтр Из Товары Цикл
		ТекСтр.ВЗаказ = 0;
	КонецЦикла;
	
	//+Шульман А. 16.12.2024 #UT10-4991 
	УчитыватьОстатокТОХ = Ложь;
	
	//+Пашкин О. 21.05.2025 #UT10-5188 
	//Если ВидПроцесса = Перечисления.ВидыПроцессов.ПеремещениеНеликвидаТОХвГП 
	Если (ВидПроцесса = Перечисления.ВидыПроцессов.ПеремещениеНеликвидаТОХвГП ИЛИ ВидПроцесса = Перечисления.ВидыПроцессов.ВозвратТОХИзГППоставщику)
	//-Пашкин О. 21.05.2025 #UT10-5188 
	   И Справочники.МТ_ПредопределенныеЗначения.ИспользоватьПроцессПеремещениеНеликвидаТОХвГП.Значение = Истина Тогда
		УчитыватьОстатокТОХ = Истина;
	КонецЕсли;
	//-Шульман А. 16.12.2024 #UT10-4991
	
	Для каждого ТекСтр Из Товары Цикл
		
		Если Отсев и ТекСтр.Номенклатура.НеЗаказыватьАвтоматом Тогда 
			Продолжить;
		КонецЕсли;

		Если ТекСтр.СвободныйОстаток < ТекСтр.Кратность Тогда
			//+Сёмин Р. 20.11.2025 #UT10-5531
			Сообщить("Свободный статок товара '" + ТекСтр.Номенклатура + "'(" + ТекСтр.СвободныйОстаток + ") меньше кратности(" + ТекСтр.Кратность + ").");
			//-Сёмин Р. 20.11.2025 #UT10-5531
			Продолжить;		
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТекСтр.ЗакупочнаяЦена) Тогда
			Продолжить;
		КонецЕсли;		
		
		//+Шульман А. 16.12.2024 #UT10-4991 
		Если УчитыватьОстатокТОХ Тогда
			ТекСтр.ВЗаказ = НайтиБлижайщую(МИН(ТекСтр.СвободныйОстаток, ТекСтр.ОстатокТОХ), ТекСтр.Кратность);  
		//-Шульман А. 16.12.2024 #UT10-4991 
		Иначе
			ТекСтр.ВЗаказ = НайтиБлижайщую(ТекСтр.СвободныйОстаток, ТекСтр.Кратность);
		КонецЕсли;
		
		//+Сёмин Р. 19.11.2025 #UT10-5531
		Если ТаблицаТоварыКоличество <> Неопределено Тогда
			
			СтрокаТаблицаТоварыКоличество = ТаблицаТоварыКоличество.Найти(ТекСтр.Номенклатура, "Номенклатура");
			
			Если СтрокаТаблицаТоварыКоличество <> Неопределено Тогда
				
				Если СтрокаТаблицаТоварыКоличество.Количество = 0 Тогда
					Продолжить;
				ИначеЕсли СтрокаТаблицаТоварыКоличество.Количество > ТекСтр.СвободныйОстаток Тогда
					Сообщить("Количество товара '" + ТекСтр.Номенклатура + "' в файле(" + СтрокаТаблицаТоварыКоличество.Количество + ") больше свободного остатка(" + ТекСтр.СвободныйОстаток + "). Он добавлен в количестве " + ТекСтр.ВЗаказ + " шт.");
				ИначеЕсли СтрокаТаблицаТоварыКоличество.Количество < ТекСтр.Кратность Тогда
					
					ТекСтр.ВЗаказ = 0;
					Сообщить("Количество товара '" + ТекСтр.Номенклатура + "' в файле(" + СтрокаТаблицаТоварыКоличество.Количество + ") меньше кратности(" + ТекСтр.Кратность + ").");
					
				Иначе
					ТекСтр.ВЗаказ = НайтиБлижайщую(СтрокаТаблицаТоварыКоличество.Количество, ТекСтр.Кратность);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		//-Сёмин Р. 19.11.2025 #UT10-5531
		
	КонецЦикла;

КонецПроцедуры

Функция ОкруглитьДоКратностиМашиноклмплекта(СВОС, ПЗЗ, МАШ) Экспорт
	
	ВЗаказОкругленный =	ПЗЗ;
	
	Если НЕ МАШ = 0 Тогда
		ВЗаказОкругленный = ?(СВОС=1 И ПЗЗ=0, ПЗЗ + МАШ - СВОС, 
		?((НЕ СВОС = 1) и ПЗЗ = 0, 0 ,
		МАШ * (ЦЕЛ(ПЗЗ + МАШ)/МАШ) + ?( (ПЗЗ + МАШ)%МАШ = 0, 0, МАШ - (ПЗЗ + МАШ)%МАШ)
		)
		);
	КонецЕсли;
	
	Возврат ВЗаказОкругленный

КонецФункции

Функция ПолучитьДоговорКонтрагента(Контрагент)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Владелец,
	|	ДоговорыКонтрагентов.Ссылка
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.Владелец = &Владелец
	|	И ДоговорыКонтрагентов.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком)
	|	И НЕ ДоговорыКонтрагентов.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Владелец", Контрагент);
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Количество() > 1 Тогда 
		
		ФормаВыбора = Справочники.ДоговорыКонтрагентов.ПолучитьФормуВыбора("ФормаВыбора", ,);
		ФормаВыбора.Отбор.Владелец.ВидСравнения = ВидСравнения.Равно;
		ФормаВыбора.Отбор.Владелец.Значение = Контрагент;
		ФормаВыбора.Отбор.Владелец.Использование = Истина;
		
		ФормаВыбора.Отбор.ВидДоговора.ВидСравнения = ВидСравнения.Равно;
		ФормаВыбора.Отбор.ВидДоговора.Значение = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком;
		ФормаВыбора.Отбор.ВидДоговора.Использование = Истина;
		
		Результат = ФормаВыбора.ОткрытьМодально();
		
		Если Результат = Неопределено Тогда
			Результат = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();	
		КонецЕсли; 		

	ИначеЕсли РезультатЗапроса.Количество() = 1 Тогда
		
		РезультатЗапроса.Следующий();
		Результат = РезультатЗапроса.Ссылка;
		
	КонецЕсли; 
	
	Возврат Результат;	  
	
КонецФункции

