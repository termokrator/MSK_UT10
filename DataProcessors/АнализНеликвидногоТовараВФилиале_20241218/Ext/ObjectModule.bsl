	Запрос.УстановитьПараметр("Контрагент", 	Константы.ОсновнойПоставщик.Получить());	
	
	Запрос.УстановитьПараметр("Д1", НачалоДня(НачПериода));
	Запрос.УстановитьПараметр("Д2", КонецДня(КонПериода));
	Запрос.УстановитьПараметр("Склад", Константы.ОсновнойСклад.Получить());
	Запрос.УстановитьПараметр("ПустойЗаказПокупателя", Документы.ЗаказПокупателя.ПустаяСсылка());
	
	Запрос.УстановитьПараметр("СредннейКоличествоДнейВПериоде", СредннейКоличествоДнейВПериоде);
	
	МассивРезультатов       = Запрос.ВыполнитьПакет();
	ИтогиПоГруппамТоваровТЗ = МассивРезультатов[ МассивРезультатов.Количество() - 2].Выгрузить();
	ТЗ					    = МассивРезультатов[ МассивРезультатов.Количество() - 1].Выгрузить();	
	
	ТЗ.Колонки.Добавить("НомерСтроки", ОбщегоНазначения.ПолучитьОписаниеТиповЧисла(10));
	
	ВсегоПродано = ТЗ.Итог("КоличествоПродано");               
	ТЗ.Сортировать("КоличествоПродано Убыв");
	
	ГруппаПроцентов1 = Окр(ВсегоПродано * АКласс / 100, 0,0);
	ГруппаПроцентов2 = Окр(ВсегоПродано * БКласс / 100, 0,0);
	ГруппаПроцентов3 = Окр(ВсегоПродано * СКласс / 100, 0,0);	
	
	РасчитатьABCКоличествоПродажи(ТЗ, ГруппаПроцентов1, ГруппаПроцентов2, ГруппаПроцентов3);
	
	ВсегоРеализаций =   ТЗ.Итог("КоличествоРеализаций");               
	
	ГруппаПроцентов1 = Окр(ВсегоРеализаций * АКласс / 100, 0,0);
	ГруппаПроцентов2 = Окр(ВсегоРеализаций * БКласс / 100, 0,0);           
	ГруппаПроцентов3 = Окр(ВсегоРеализаций * СКласс / 100, 0,0);	
	
	РасчитатьABCКоличествоРеализаций(ТЗ, ГруппаПроцентов1, ГруппаПроцентов2, ГруппаПроцентов3);
	
	ВсегоКлиентов =   ТЗ.Итог("КоличествоКлиентов");               
	
	ГруппаПроцентов1 = Окр(ВсегоКлиентов * АКласс / 100, 0,0);
	ГруппаПроцентов2 = Окр(ВсегоКлиентов * БКласс / 100, 0,0);
	ГруппаПроцентов3 = Окр(ВсегоКлиентов * СКласс / 100, 0,0);	
	
	РасчитатьABCКоличествоКлиентов(ТЗ, ГруппаПроцентов1, ГруппаПроцентов2, ГруппаПроцентов3);
	
	РассчитатьABCВнутриПроизводителя(ТЗ, ИтогиПоГруппамТоваровТЗ);
	РезультатПримененияОтбора = ОбработатьТаблицу();
	Товары.Загрузить(РезультатПримененияОтбора); 

КонецПроцедуры

Процедура ВыполнитьЗапросНеликвид(МассивТоваров = Неопределено) Экспорт   
	
	//+Гавриленков В. 25.06.2025 #UT10-5303 
	Попытка
		ВестиУчетТоваровОрганизацийВРазрезеСкладов = РегистрыСведений.УчетнаяПолитика.СрезПоследних(ТекущаяДата(),)[0].ВестиУчетТоваровОрганизацийВРазрезеСкладов;
	Исключение   
		ВестиУчетТоваровОрганизацийВРазрезеСкладов = Истина;
	КонецПопытки;
	//-Гавриленков В. 25.06.2025 #UT10-5303
	
	Товары.Очистить();
	Запрос = Новый Запрос; 
	
	//+Белов А. 13.10.2025 #UT10-5462
	Запрос.УстановитьПараметр("МассивТоваров", МассивТоваров); 
	
	Если МассивТоваров = Неопределено Тогда
		//-Белов А. 13.10.2025 #UT10-5462
		
		Если Отсев Тогда 
			ТекстЗапросаОграничениеПоНоменклатуре = " 
			|			 Номенклатура В
			|					(ВЫБРАТЬ
			|						Номенклатура.Ссылка
			|						ИЗ
			|							Справочник.Номенклатура КАК Номенклатура
			|						ГДЕ
			|					НЕ Номенклатура.НеЗаказыватьАвтоматом )";
		Иначе
			ТекстЗапросаОграничениеПоНоменклатуре = "";
		КонецЕсли;
		
		Если БрендыОтборВключить.Количество()> 0 Тогда
			
			МассивБрендов = БрендыОтборВключить.ВыгрузитьКолонку("Бренд");
			Запрос.УстановитьПараметр("МассивБрендов", МассивБрендов);
			
			Если ТекстЗапросаОграничениеПоНоменклатуре = "" Тогда
				ТекстЗапросаОграничениеПоНоменклатуре = " 
				|			Номенклатура.Родитель В (&МассивБрендов) ";
				
			Иначе
				ТекстЗапросаОграничениеПоНоменклатуре = ТекстЗапросаОграничениеПоНоменклатуре
				+ " И Номенклатура.Родитель В (&МассивБрендов) ";
			КонецЕсли;
			
		КонецЕсли;
		
		Если НоменклатурныеГруппыОтборВключить.Количество()> 0 Тогда
			
			МассивНГ = НоменклатурныеГруппыОтборВключить.ВыгрузитьКолонку("НоменклатурнаяГруппа");
			Запрос.УстановитьПараметр("МассивНГ", МассивНГ);
			
			Если ТекстЗапросаОграничениеПоНоменклатуре = "" Тогда
				ТекстЗапросаОграничениеПоНоменклатуре = " 
				|			Номенклатура.НоменклатурнаяГруппа В (&МассивНГ) ";
				
			Иначе
				ТекстЗапросаОграничениеПоНоменклатуре = ТекстЗапросаОграничениеПоНоменклатуре
				+ " И Номенклатура.НоменклатурнаяГруппа В (&МассивНГ) ";
			КонецЕсли;
			
		КонецЕсли;
		
		Если БрендыОтборИсключить.Количество()> 0 Тогда
			
			МассивБрендовИсключить = БрендыОтборИсключить.ВыгрузитьКолонку("Бренд");
			Запрос.УстановитьПараметр("МассивБрендовИсключить", МассивБрендовИсключить);
			
			Если ТекстЗапросаОграничениеПоНоменклатуре = "" Тогда
				ТекстЗапросаОграничениеПоНоменклатуре = " 
				|			Номенклатура.Родитель НЕ В (&МассивБрендовИсключить) ";
				
			Иначе
				ТекстЗапросаОграничениеПоНоменклатуре = ТекстЗапросаОграничениеПоНоменклатуре
				+ " И Номенклатура.Родитель НЕ В (&МассивБрендовИсключить) ";
			КонецЕсли;
			
		КонецЕсли;
		
		Если НоменклатурныеГруппыОтборИсключить.Количество()> 0 Тогда
			
			МассивНГИсключить = НоменклатурныеГруппыОтборИсключить.ВыгрузитьКолонку("НоменклатурнаяГруппа");
			Запрос.УстановитьПараметр("МассивНГИсключить", МассивНГИсключить);
			
			Если ТекстЗапросаОграничениеПоНоменклатуре = "" Тогда
				ТекстЗапросаОграничениеПоНоменклатуре = " 
				|			Номенклатура.НоменклатурнаяГруппа НЕ В (&МассивНГИсключить) ";
				
			Иначе
				ТекстЗапросаОграничениеПоНоменклатуре = ТекстЗапросаОграничениеПоНоменклатуре
				+ " И Номенклатура.НоменклатурнаяГруппа НЕ В (&МассивНГИсключить) ";
			КонецЕсли;
			
		КонецЕсли;
		
		
		ТекстЗапросаОграничениеПоНоменклатуре = "Склад = &Склад" + ?(ТекстЗапросаОграничениеПоНоменклатуре = "", "", " И ") + ТекстЗапросаОграничениеПоНоменклатуре;
		ГруппаНоменклатурыУценка = Константы.ГруппаНоменклатурыУценка.Получить(); 
		
		Если Константы.ИспользоватьГруппуНоменклатурыУценка.Получить() и ЗначениеЗаполнено(ГруппаНоменклатурыУценка) Тогда
			
			Если ТекстЗапросаОграничениеПоНоменклатуре = "" Тогда
				ТекстЗапросаУценка = "
				|			НЕ Номенклатура В ИЕРАРХИИ(&Уценка) ";
			Иначе 
				ТекстЗапросаУценка = "
				|			И НЕ Номенклатура В ИЕРАРХИИ(&Уценка) "; 				
			КонецЕсли;
			
			Запрос.УстановитьПараметр("Уценка", ГруппаНоменклатурыУценка);
			
		Иначе
			ТекстЗапросаУценка = "";
		КонецЕсли;
		
		//+Шульман А. 16.12.2024 #UT10-4991    
		ТекстЗапросаОграничениеПоНоменклатуреТОХ = СтрЗаменить(ТекстЗапросаОграничениеПоНоменклатуре, "Склад = &Склад", "");
		ТекстУсловияТОХ = ТекстЗапросаОграничениеПоНоменклатуреТОХ + " " + ТекстЗапросаУценка;
		//-Шульман А. 16.12.2024 #UT10-4991 
		
	Иначе
		                   
		ТекстЗапросаОграничениеПоНоменклатуре = " Номенклатура в (&МассивТоваров)"; 
		ТекстУсловияТОХ = " И Номенклатура в (&МассивТоваров)"; 
		
	КонецЕсли;
	
	Запрос.Текст = 
	//+Шульман А. 16.12.2024 #UT10-4991 
	"ВЫБРАТЬ
	|	ТОХОстатки.Номенклатура КАК Номенклатура,
	|	СУММА(ТОХОстатки.КоличествоОстаток) КАК КоличествоОстаток
	|ПОМЕСТИТЬ ОстаткиКонецТОХ
	|ИЗ
	|	РегистрНакопления.ТоварыОтветственногоХранения.Остатки(
	|			&ДатаКон,
	|			(Контрагент = &КонтрагентТОХ
	|				ИЛИ &КонтрагентТОХПустой)
	|					И (ДоговорКонтрагента = &ДоговорПоставщикаТОХ
	|						ИЛИ &ДоговорПоставщикаТОХПустой) " + ТекстУсловияТОХ + ") КАК ТОХОстатки
	|
	|ГДЕ
	|	ТОХОстатки.КоличествоОстаток > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ТОХОстатки.Номенклатура
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;             
	//-Шульман А. 16.12.2024 #UT10-4991 
    //+Пашкин О. 21.05.2025 #UT10-5188 
	|ВЫБРАТЬ
	|	ТОХОстатки.Номенклатура КАК Номенклатура,
	|	СУММА(ТОХОстатки.КоличествоОстаток) КАК КоличествоОстаток
	|ПОМЕСТИТЬ ОстаткиКонецТОХПереданные
	|ИЗ
	|	РегистрНакопления.ТоварыОтветственногоХраненияПереданные.Остатки(
	|			&ДатаКон,
	|			(Контрагент = &КонтрагентТОХ
	|				ИЛИ &КонтрагентТОХПустой)
	|					И (ДоговорКонтрагента = &ДоговорПоставщикаТОХ
	|						ИЛИ &ДоговорПоставщикаТОХПустой) " + ТекстУсловияТОХ + ") КАК ТОХОстатки
	|
	|ГДЕ
	|	ТОХОстатки.КоличествоОстаток > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ТОХОстатки.Номенклатура
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;             
    //-Пашкин О. 21.05.2025 #UT10-5188 
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТоварыНаСкладахОстатки.Склад КАК Склад,
	|	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
	|	ТоварыНаСкладахОстатки.КоличествоОстаток
	|ПОМЕСТИТЬ ОстаткиКонец
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(&ДатаКон, " + ТекстЗапросаОграничениеПоНоменклатуре + " " + ТекстЗапросаУценка + ") КАК ТоварыНаСкладахОстатки
	|ГДЕ
	|	ТоварыНаСкладахОстатки.КоличествоОстаток > 0
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Склад,
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|
	|ВЫБРАТЬ
	|	ОстаткиКонец.Склад,
	|	ОстаткиКонец.Номенклатура,
	|	ОстаткиКонец.КоличествоОстаток КАК ОстатокКонец,
	|	ТоварыНаСкладахОстатки.КоличествоОстаток КАК ОстатокНачало
	|ПОМЕСТИТЬ ТоварыСОстатками
	|ИЗ
	|	ОстаткиКонец КАК ОстаткиКонец
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки(
	|				&ДатаНач,
	|				Склад = &Склад
	|					И (Номенклатура, Склад) В
	|						(ВЫБРАТЬ
	|							ОстаткиКонец.Номенклатура КАК Номенклатура,
	|							ОстаткиКонец.Склад КАК Склад
	|						ИЗ
	|							ОстаткиКонец КАК ОстаткиКонец)) КАК ТоварыНаСкладахОстатки
	|		ПО ОстаткиКонец.Номенклатура = ТоварыНаСкладахОстатки.Номенклатура
	|			И ОстаткиКонец.Склад = ТоварыНаСкладахОстатки.Склад
	|ГДЕ
	|	ТоварыНаСкладахОстатки.КоличествоОстаток > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыСОстатками.Склад КАК Склад,
	|	ТоварыСОстатками.Номенклатура КАК Номенклатура,
	|	ТоварыСОстатками.ОстатокНачало,
	|	ТоварыСОстатками.ОстатокКонец,
	|	ЕСТЬNULL(ТаблПродаж.Продажи, 0) КАК Продажи
	|ПОМЕСТИТЬ ТоварыСОстаткамиБезПродаж
	|ИЗ
	|	ТоварыСОстатками КАК ТоварыСОстатками
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ПродажиОбороты.Номенклатура КАК Номенклатура,
	|			СУММА(ВЫБОР
	|					КОГДА ПродажиОбороты.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг
	|						ТОГДА 1
	|					ИНАЧЕ 0
	|				КОНЕЦ) КАК Регистратор,
	|			СУММА(ЕСТЬNULL(ПродажиОбороты.КоличествоОборот, 0)) КАК Продажи
	|		ИЗ
	|			РегистрНакопления.Продажи.Обороты(
	|					&ДатаНач,
	|					&ДатаКон,
	|					Авто,
	|					Номенклатура В
	|						(ВЫБРАТЬ
	|							ТоварыСОстатками.Номенклатура
	|						ИЗ
	|							ТоварыСОстатками КАК ТоварыСОстатками)) КАК ПродажиОбороты
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ПродажиОбороты.Номенклатура) КАК ТаблПродаж
	|		ПО ТоварыСОстатками.Номенклатура = ТаблПродаж.Номенклатура
	|ГДЕ
	|	ЕСТЬNULL(ТаблПродаж.Регистратор, 0) = 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблПродаж.Номенклатура,
	|	ТоварыСОстатками.Склад,
	|	ТоварыСОстатками.Номенклатура,
	|	ТоварыСОстатками.ОстатокНачало,
	|	ТоварыСОстатками.ОстатокКонец,
	|	ЕСТЬNULL(ТаблПродаж.Продажи, 0)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Склад,
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РегламентированныйПроизводственныйКалендарь.ДатаКалендаря
	|ПОМЕСТИТЬ Календарь
	|ИЗ
	|	РегистрСведений.РегламентированныйПроизводственныйКалендарь КАК РегламентированныйПроизводственныйКалендарь
	|ГДЕ
	|	РегламентированныйПроизводственныйКалендарь.ДатаКалендаря МЕЖДУ &ДатаНач И &ДатаКон
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыОрганизацийОстаткиИОбороты.Период,
	|	ТоварыОрганизацийОстаткиИОбороты.Номенклатура,
	|	ТоварыОрганизацийОстаткиИОбороты.КоличествоНачальныйОстаток,
	|	ТоварыОрганизацийОстаткиИОбороты.КоличествоКонечныйОстаток
	|ПОМЕСТИТЬ ТаблицаОстатковЗаПериод
	|ИЗ
	|	РегистрНакопления.ТоварыОрганизаций.ОстаткиИОбороты(
	|			&ДатаНач,
	|			&ДатаКон,
	|			День,
	|			,
	//+Гавриленков В. 25.06.2025 #UT10-5303  Добавлено условие по Складу
	|			" + ?(ВестиУчетТоваровОрганизацийВРазрезеСкладов, "Склад = &Склад
	|				И ", "") + "Номенклатура В
	|					(ВЫБРАТЬ
	|						ТоварыСОстаткамиБезПродаж.Номенклатура
	|					ИЗ
	|						ТоварыСОстаткамиБезПродаж КАК ТоварыСОстаткамиБезПродаж)) КАК ТоварыОрганизацийОстаткиИОбороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Календарь.ДатаКалендаря,
	|	МАКСИМУМ(ТаблицаОстатковЗаПериод.Период) КАК Период,
	|	ТаблицаОстатковЗаПериод.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ТаблицаОстатковЗаПериодСДатами
	|ИЗ
