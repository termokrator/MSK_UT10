	|ПОМЕСТИТЬ Отправленные
	|ИЗ
	|	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	|ГДЕ
	|	ЗначенияСвойствОбъектов.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СвойстваОбъектов.ДокументОтправленЧерезЭДО)
	|	И ЗначенияСвойствОбъектов.Значение = ИСТИНА
	|	И ЗначенияСвойствОбъектов.Объект ССЫЛКА Документ.РеализацияТоваровУслуг
	|	И ЗначенияСвойствОбъектов.Объект.ДоговорКонтрагента В
	|			(ВЫБРАТЬ
	|				Договоры.Ссылка
	|			ИЗ
	|				Договоры КАК Договоры)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РеализацияТоваровУслуг.Ссылка
	|ПОМЕСТИТЬ Реализации
	|ИЗ
	|	Договоры КАК Договоры
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|		ПО (РеализацияТоваровУслуг.ДоговорКонтрагента = Договоры.Ссылка)
	|			И (РеализацияТоваровУслуг.Дата >= Договоры.ДатаНачалаОбменаЭДО)
	|ГДЕ
	|	РеализацияТоваровУслуг.Проведен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Реализации.Ссылка
	|ИЗ
	|	Реализации КАК Реализации
	|		ЛЕВОЕ СОЕДИНЕНИЕ Отправленные КАК Отправленные
	|		ПО Реализации.Ссылка = Отправленные.Ссылка
	|ГДЕ
	|	Отправленные.Ссылка ЕСТЬ NULL";  
	
	РезультатЗапроса	=	Запрос.Выполнить();
	Выб					=	РезультатЗапроса.Выбрать();
	
	Пока Выб.Следующий() Цикл
		
		//Формируем печатную форму и отправляем документ
		ПараметрыПечати = Новый Структура;
		ПараметрКоманды = Новый Массив;
		ПараметрКоманды.Добавить(Выб.Ссылка);
		
		Рез = СформироватьФайлыДляОтправкиПоЭП("Документ.РеализацияТоваровУслуг", "ВнешняяПечатнаяФорма.ЭлОбменДокументами", ПараметрКоманды,ПараметрыПечати);
		
		Для каждого строка из Рез Цикл
			
			ТабДокумент = строка.Значение;
					                 
//				ИмяВременногоФайла = "\\Vm-tc-node2\сбис коннект\Отправляемые\"+Выб.Ссылка.УникальныйИдентификатор()+".xls";
				ИмяВременногоФайла = ИмяКаталогаДляВыгрузки + "Отправляемые\" + Выб.Ссылка.УникальныйИдентификатор() + ".xls";
					
				ТабДокумент.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.XLS);
				
				УстановитьСтатусОтправлено(Выб.Ссылка);
				
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ФорматироватьСтроку(КодАварда)
	
	Возврат СтрЗаменить(Строка(КодАварда), " ", "");

КонецФункции

Функция ПоместитьТабличныеДокументыВоВременноеХранилище(ТабличныеДокументы)
	
	Результат = Новый Соответствие;
	
	// Каталог временных файлов
	ИмяВременнойПапки = ПолучитьИмяВременногоФайла();
	СоздатьКаталог(ИмяВременнойПапки);
	ПолныйПутьКФайлу = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ИмяВременнойПапки);
	УИД = Новый УникальныйИдентификатор;
	
	// Сохранение табличных документов.
	Для Каждого ТабличныйДокумент Из ТабличныеДокументы Цикл
		
		Если ТабличныйДокумент.Значение.Вывод = ИспользованиеВывода.Запретить Тогда
			Продолжить;
		КонецЕсли;
		
			ИмяФайла = ТабличныйДокумент.Представление + ".xls";
			ПолноеИмяФайла = ПолныйПутьКФайлу + ИмяФайла;
			
			ТабличныйДокумент.Значение.Записать(ПолноеИмяФайла, ТипФайлаТабличногоДокумента.XLS);
						
			Результат.Вставить(ИмяФайла, ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПолноеИмяФайла), УИД));
		
	КонецЦикла;
	
	
	УдалитьФайлы(ИмяВременнойПапки);
	
	Возврат Результат;
	
КонецФункции

Функция СформироватьФайлыДляОтправкиПоЭП(ИмяМенеджераПечати, ИменаМакетов, МассивОбъектов, ПараметрыПечати = Неопределено) 

	// Проверим количество объектов.
	Если НЕ ПроверитьКоличествоПереданныхОбъектов(МассивОбъектов) Тогда
		Возврат неопределено;
	КонецЕсли;
	
	// Сформируем табличные документы.
	ПечатныеФормы	=	Неопределено;
	
	ПечатныеФормы = СформироватьПечатныеФормыДляБыстройПечатиОбычноеПриложение(
			ИмяМенеджераПечати, ИменаМакетов, МассивОбъектов, ПараметрыПечати);
			
	Если НЕ ПечатныеФормы.Отказ Тогда
		
		ОбъектыПечати = Новый СписокЗначений;
		ТабличныеДокументы = ПолучитьИзВременногоХранилища(ПечатныеФормы.Адрес);
		
		Для Каждого ОбъектПечати Из ПечатныеФормы.ОбъектыПечати Цикл
			ОбъектыПечати.Добавить(ОбъектПечати.Значение, ОбъектПечати.Ключ);
		КонецЦикла;
		
		ПечатныеФормы.ОбъектыПечати = ОбъектыПечати;
		
	КонецЕсли;
	
	Если ПечатныеФормы.Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Нет прав для вывода печатной формы на принтер, обратитесь к администратору.'"));
		Возврат Неопределено;
	Иначе
		Возврат ТабличныеДокументы;
	КонецЕсли;
	
	
КонецФункции

Функция ПроверитьКоличествоПереданныхОбъектов(ПараметрКоманды)
	
	Если ТипЗнч(ПараметрКоманды) = Тип("Массив") И ПараметрКоманды.Количество() = 0 Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции
