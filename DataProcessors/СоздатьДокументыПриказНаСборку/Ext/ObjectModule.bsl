	Запрос.УстановитьПараметр("СтрокаФильтрДнейНедели",СтрокаФильтрДнейНедели);
	Запрос.УстановитьПараметр("ЛюбоеРасписание", НЕ ЗначениеЗаполнено(СтрокаФильтрДнейНедели) ИЛИ ТипДоставки = Перечисления.СпособДоставки.Самовывоз);
	
	Запрос.УстановитьПараметр("Организация", Организация);
