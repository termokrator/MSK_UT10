КонецФункции 

Процедура ВыполнитьИзРегламентногоЗадания() Экспорт 
	
	Отказ = Ложь;
	МаксимальноеКоличествоНесобранныхСборок = Константы.МаксимальноеКоличествоНесобранныхСборок.Получить();
	СоздатьДокументовШтук = 0;
	
	Если МаксимальноеКоличествоНесобранныхСборок > 0 Тогда 
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СборкаЗаказовПокупателя.Ссылка) КАК КоличествоНезакрытыхСборок
		|ИЗ
		|	Документ.СборкаЗаказовПокупателя КАК СборкаЗаказовПокупателя
		|ГДЕ
		|	СборкаЗаказовПокупателя.Проведен
		|	И СборкаЗаказовПокупателя.Дата >= &НачалоТекущегоДня
		|	И НЕ СборкаЗаказовПокупателя.ДокументСобранИУпакован
		|	И НЕ СборкаЗаказовПокупателя.ПолностьюОткорректирована";
		
		Запрос.УстановитьПараметр("НачалоТекущегоДня", НачалоДня(ТекущаяДата()));
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Если ВыборкаДетальныеЗаписи.КоличествоНезакрытыхСборок >= МаксимальноеКоличествоНесобранныхСборок Тогда 
				Отказ = Истина;
			Иначе
				СоздатьДокументовШтук = МаксимальноеКоличествоНесобранныхСборок - ВыборкаДетальныеЗаписи.КоличествоНезакрытыхСборок;
			КонецЕсли;
			
			Прервать;
			
		КонецЦикла;

	КонецЕсли;		  
	
	Если НЕ Отказ Тогда
		
		Запрос = Новый Запрос;
		
		Если ВыполнитьПроверку(Запрос, Ложь, Истина,Ложь,Ложь) = Ложь Тогда 
			Возврат;
		КонецЕсли;			
		
		Пакет = Запрос.ВыполнитьПакет();
		
		//документы отгрузки
		ТабДокументов = Пакет[10].Выгрузить();
		ТабДокументов.Колонки.Добавить("Принудительно", Новый ОписаниеТипов("Булево"));
		
		Если ТабДокументов.Количество() <> 0 Тогда 
			СоздатьДокументы(ТабДокументов, Истина, СоздатьДокументовШтук);
		КонецЕсли;

		ПараметрТекущееВремя = Дата('00010101') + (ТекущаяДата()-НачалоДня(ТекущаяДата()));
		НачинаемСобиратьНаЗавтра = Ложь;
		ПромВремяНачалаДоставкиНаЗавтра = Константы.ВремяНачалаДоставкиНаЗавтра.Получить();
		ПромВремяНачалаДоставкиНаЗавтраДляСубботы = Константы.ВремяНачалаДоставкиНаЗавтраДляСубботы.Получить();

		//+Гавриленков В. 31.10.2024 #UT10-4855
		//пДеньНедели = ДеньНедели(ТекущаяДата());
		//
		//Если пДеньНедели = 6 Тогда
		//	пДеньНедели = ПроверитьСубботу(ТекущаяДата());
		//КонецЕсли;
		
		пДеньНедели = МСК.ПолучитьДеньПоКалендарю(ТекущаяДата());
		//-Гавриленков В. 31.10.2024 #UT10-4855		

		Если пДеньНедели = 6 Тогда
			
			Если   ЗначениеЗаполнено(ПромВремяНачалаДоставкиНаЗавтраДляСубботы) И ПромВремяНачалаДоставкиНаЗавтраДляСубботы < ПараметрТекущееВремя Тогда 
				НачинаемСобиратьНаЗавтра = Истина;
			КонецЕсли;
			// воскресенье	  
			
		//+Гавриленков В. 24.11.2023 #UT10-4077
		//ИначеЕсли пДеньНедели = 7 Тогда	
		//	НачинаемСобиратьНаЗавтра = Истина;
		//-Гавриленков В. 24.11.2023 #UT10-4077	
			
		Иначе
			
			Если ЗначениеЗаполнено(ПромВремяНачалаДоставкиНаЗавтра) И ПромВремяНачалаДоставкиНаЗавтра < ПараметрТекущееВремя Тогда 
				НачинаемСобиратьНаЗавтра = Истина;
			КонецЕсли;
			
		КонецЕсли;

		Если НЕ НачинаемСобиратьНаЗавтра Тогда  			
			
			ЗапросМаршрутов = Новый Запрос;
			ЗапросМаршрутов.Текст = 
			"ВЫБРАТЬ
			|	МаршрутыДоставки.Ссылка
			|ИЗ
			|	Справочник.МаршрутыДоставки КАК МаршрутыДоставки
			|ГДЕ
			|	МаршрутыДоставки.ВремяНачалаСозданияСборокНаЗавтра <= &ТекущееВремя
			|	И НЕ МаршрутыДоставки.ВремяНачалаСозданияСборокНаЗавтра = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)";

			Если пДеньНедели = 6 Тогда
				
				ЗапросМаршрутов.Текст = СтрЗаменить(ЗапросМаршрутов.Текст, "МаршрутыДоставки.ВремяНачалаСозданияСборокНаЗавтра <= &ТекущееВремя", "МаршрутыДоставки.ВремяНачалаСозданияСборокНаЗавтраДляСубботы <= &ТекущееВремя");
				ЗапросМаршрутов.Текст = СтрЗаменить(ЗапросМаршрутов.Текст, "И НЕ МаршрутыДоставки.ВремяНачалаСозданияСборокНаЗавтра = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)", "И НЕ МаршрутыДоставки.ВремяНачалаСозданияСборокНаЗавтраДляСубботы = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)");
				
			КонецЕсли;
			
			ЗапросМаршрутов.УстановитьПараметр("ТекущееВремя", ПараметрТекущееВремя);
			РезультатЗапросаМаршрутов = ЗапросМаршрутов.Выполнить();
			НачинаемСобиратьНаЗавтра = НЕ РезультатЗапросаМаршрутов.Пустой();
			
		КонецЕсли;

		Если НачинаемСобиратьНаЗавтра Тогда
			
			Запрос = Новый Запрос;
			
			Если ВыполнитьПроверку(Запрос, Ложь, Истина,Ложь,Истина) = Ложь Тогда 
				Возврат;
			КонецЕсли;			
			
			Пакет = Запрос.ВыполнитьПакет();
			
			//документы отгрузки
			ТабДокументов = Пакет[10].Выгрузить();
			ТабДокументов.Колонки.Добавить("Принудительно", Новый ОписаниеТипов("Булево"));
			
			Если ТабДокументов.Количество() <> 0 Тогда 
				СоздатьДокументы(ТабДокументов, Истина, СоздатьДокументовШтук, Ложь, Истина);
			КонецЕсли;
			
		КонецЕсли;

	КонецЕсли;
	
КонецПроцедуры // ВыполнитьИзРегламентногоЗадания()

Процедура ОтправитьПисьмоСошибкой(ПромДокСборка, ОписаниеОшибки = "") Экспорт
	
	Возврат;
	
	УчетнаяЗапись = Константы.ОсновнаяУчетнаяЗаписьЭлектроннойПочты.Получить();
	Профиль = УправлениеЭлектроннойПочтой.ПолучитьИнтернетПочтовыйПрофиль(УчетнаяЗапись);
	
	Почта = Новый ИнтернетПочта; 
	УдалосьПодключиться = Ложь;
	
	Попытка
		Почта.Подключиться(Профиль);
		УдалосьПодключиться = Истина;
	Исключение
	КонецПопытки;
	
	Если УдалосьПодключиться Тогда
		
		Сообщение = Новый ИнтернетПочтовоеСообщение;
		Сообщение.Тема = "Ошибка создания сборки";
		Сообщение.Получатели.Добавить(УчетнаяЗапись.АдресЭлектроннойПочты); 
		Сообщение.Отправитель = УчетнаяЗапись.АдресЭлектроннойПочты;
		ТекстСообщенияПисьма = "Не удалось создать докумиент сборка для "+СокрЛП(ПромДокСборка.Грузополучатель.Наименование)+" на дату "+Формат(ПромДокСборка.Грузополучатель,"ДФ=dd.MM.yyyy")+"";
		ТекстСообщенияПисьма = ТекстСообщенияПисьма+Символы.ПС+СокрЛП(ОписаниеОшибки);
		Сообщение.Тексты.Добавить(ТекстСообщенияПисьма);
		
		Попытка
			Почта.Послать(Сообщение);
		Исключение
		КонецПопытки; 		
		
		Сообщение.Получатели.Очистить();
		Сообщение.Вложения.Очистить(); 		
		
	КонецЕсли;	

КонецПроцедуры

Процедура СоздатьДокументы(ТаблПоле, ЭтоРегламент, СоздатьДокументовШтук = 0, Биллинг = Ложь, НачинаемСобиратьНаЗавтра = Ложь,
	//+Шульман А. 24.02.2025 #UT10-5103 
	МассивСборок = Неопределено
	//-Шульман А. 24.02.2025 #UT10-5103
	) Экспорт 
	
	ЯчейкаДоВыяснения = Константы.ЯчейкаДоВыяснения.Получить();
	
	ИспользоватьДатуОтгрузкиИзЗаказа = Константы.ИспользоватьДатуОтгрузкиИзЗаказа.Получить(); 
	
	СозданоДокументов = 0;   
	
	//+Шульман А. 24.02.2025 #UT10-5103 
	МассивСборок = Новый Массив;
	//-Шульман А. 24.02.2025 #UT10-5103
	
	
	Для каждого ТекСтр Из ТаблПоле Цикл
		
		Если НЕ ЭтоРегламент И НЕ ТекСтр.Отметка Тогда 
			Продолжить; 
		КонецЕсли;
		
		Если СоздатьДокументовШтук > 0 Тогда 
			Если СоздатьДокументовШтук <= СозданоДокументов Тогда 
				Прервать;
			КонецЕсли;
		КонецЕсли;
		
		ПараметрВремяОчереди = ТекущаяДата();
		ПараметрТекущееВремя = Дата('00010101') + (ТекущаяДата()-НачалоДня(ТекущаяДата())); 

		ЗапросМаксимальногоВремениОчереди = Новый Запрос;
		ЗапросМаксимальногоВремениОчереди.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	МАКСИМУМ(ОчередьДоставки.ВремяОкончанияОтправки) КАК ВремяОкончанияОтправки
		|ИЗ
		|	Справочник.ОчередьДоставки КАК ОчередьДоставки
		|ГДЕ
		|	НЕ ОчередьДоставки.ПометкаУдаления
		|	И ОчередьДоставки.ВремяНачалаОтправки <= &ТекущееВремя
		|	И ОчередьДоставки.ВремяОкончанияОтправки >= &ТекущееВремя
		|
		|СГРУППИРОВАТЬ ПО
		|	ОчередьДоставки.Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВремяОкончанияОтправки УБЫВ";
		
		ЗапросМаксимальногоВремениОчереди.УстановитьПараметр("ТекущееВремя", ПараметрТекущееВремя);
		
		Результат = ЗапросМаксимальногоВремениОчереди.Выполнить();
		
		Если НЕ Результат.Пустой() Тогда
			
			Выборка = Результат.Выбрать();
			Выборка.Следующий();
			ПараметрВремяОчереди = НачалоДня(ТекущаяДата()) + Час(Выборка.ВремяОкончанияОтправки) * 60 * 60 + Минута(Выборка.ВремяОкончанияОтправки) * 60;
			
		КонецЕсли;
		
		Если ЭтоРегламент Тогда
			
			//+Гавриленков В. 31.10.2024 #UT10-4855
			//пДеньНедели = ДеньНедели(ТекущаяДата());
			//
			//Если пДеньНедели = 6 Тогда
			//	пДеньНедели = ПроверитьСубботу(ТекущаяДата());
			//КонецЕсли;
			
			пДеньНедели = МСК.ПолучитьДеньПоКалендарю(ТекущаяДата());
			//-Гавриленков В. 31.10.2024 #UT10-4855	
			
		Иначе
			пДеньНедели = ДеньНеделиЧисло;
		КонецЕсли;

		ВремяОтправкиНаСамовывоз = ТекущаяДата() + (Константы.ВремяОтправкиНаСамовывоз.Получить() * 60);

		Для Н = 1 По 2 Цикл
			
			Запрос = Новый Запрос;		  
			Запрос.Текст ="
			|ВЫБРАТЬ
			|	Контрагенты.СоздаватьСборки,
			|	МинимальнаяОчередь.ОчередьВремяОкончанияОтправки,
			|	ТекущаяОчередь.ОчередьВремяОкончанияОтправки КАК ТекущееВремяОкончанияОтправки
			|ПОМЕСТИТЬ СпособСборки
			|ИЗ
			|	Справочник.Контрагенты КАК Контрагенты,
			|	(ВЫБРАТЬ
			|		МИНИМУМ(КонтрагентыОчередиДоставки.Очередь.ВремяОкончанияОтправки) КАК ОчередьВремяОкончанияОтправки
			|	ИЗ
			|		Справочник.Контрагенты.ОчередиДоставки КАК КонтрагентыОчередиДоставки
			|	ГДЕ
			|		КонтрагентыОчередиДоставки.Ссылка = &Грузополучатель) КАК МинимальнаяОчередь,
			|	(ВЫБРАТЬ
			|		МАКСИМУМ(КонтрагентыОчередиДоставки.Очередь.ВремяОкончанияОтправки) КАК ОчередьВремяОкончанияОтправки
			|	ИЗ
			|		Справочник.Контрагенты.ОчередиДоставки КАК КонтрагентыОчередиДоставки
			|	ГДЕ
			|		КонтрагентыОчередиДоставки.Ссылка = &Грузополучатель
			|		И КонтрагентыОчередиДоставки.Очередь.ВремяНачалаОтправки <= &ТекущееВремя
			|		И КонтрагентыОчередиДоставки.Очередь.ВремяОкончанияОтправки >= &ТекущееВремя) КАК ТекущаяОчередь
			|ГДЕ
			|	Контрагенты.Ссылка = &Грузополучатель
			|
			|СГРУППИРОВАТЬ ПО
			|	Контрагенты.СоздаватьСборки,
			|	МинимальнаяОчередь.ОчередьВремяОкончанияОтправки,
			|	ТекущаяОчередь.ОчередьВремяОкончанияОтправки
			|;
			|   			
			|//////////////////////////////////////////////////////////////////////////////// 			
			|
			|ВЫБРАТЬ
			|	ТоварыГотовыеКСборкеОстатки.ЗаказПокупателя КАК Заказ,
			|	ТоварыГотовыеКСборкеОстатки.ЗаказПокупателя.СкладГруппа КАК Склад,
			|	ТоварыГотовыеКСборкеОстатки.Номенклатура КАК Номенклатура,
			|	ВЫБОР
			|		КОГДА ЕСТЬNULL(ЗаказыПокупателейОстатки.КоличествоОстаток, 0) - (ЕСТЬNULL(ТоварыВСборкеОстатки.СобраноОстаток, 0) + ЕСТЬNULL(ТоварыВСборкеОстатки.КСборкеОстаток, 0)) <> 0
			|			ТОГДА ВЫБОР
			|					КОГДА ЕСТЬNULL(ЗаказыПокупателейОстатки.КоличествоОстаток, 0) - (ЕСТЬNULL(ТоварыВСборкеОстатки.СобраноОстаток, 0) + ЕСТЬNULL(ТоварыВСборкеОстатки.КСборкеОстаток, 0)) < ТоварыГотовыеКСборкеОстатки.КоличествоОстаток
			|						ТОГДА ЕСТЬNULL(ЗаказыПокупателейОстатки.КоличествоОстаток, 0) - (ЕСТЬNULL(ТоварыВСборкеОстатки.СобраноОстаток, 0) + ЕСТЬNULL(ТоварыВСборкеОстатки.КСборкеОстаток, 0))
			|					ИНАЧЕ ТоварыГотовыеКСборкеОстатки.КоличествоОстаток
			|				КОНЕЦ
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК Количество,
			|	ТоварыГотовыеКСборкеОстатки.Назначение
			|ПОМЕСТИТЬ НоменклатураПоЗаказам
			|ИЗ
			|	РегистрНакопления.ТоварыГотовыеКСборке.Остатки(
			|			,
			|				&УсловиеПоРегистрам = Истина) КАК ТоварыГотовыеКСборкеОстатки
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыПокупателей.Остатки(
			|				,
			|				НЕ ТолькоРезерв И 
			|				 &УсловиеПоРегистрам = Истина) КАК ЗаказыПокупателейОстатки
			|		ПО ТоварыГотовыеКСборкеОстатки.ЗаказПокупателя = ЗаказыПокупателейОстатки.ЗаказПокупателя
			|			И ТоварыГотовыеКСборкеОстатки.Номенклатура = ЗаказыПокупателейОстатки.Номенклатура
			|           И ТоварыГотовыеКСборкеОстатки.Назначение = ЗаказыПокупателейОстатки.Назначение
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВСборке.Остатки(
			|				,
			|				&УсловиеПоРегистрам = Истина) КАК ТоварыВСборкеОстатки
			|		ПО ТоварыГотовыеКСборкеОстатки.ЗаказПокупателя = ТоварыВСборкеОстатки.ЗаказПокупателя
			|			И ТоварыГотовыеКСборкеОстатки.Номенклатура = ТоварыВСборкеОстатки.Номенклатура
			|			И ТоварыГотовыеКСборкеОстатки.Назначение = ТоварыВСборкеОстатки.Назначение,
			|		СпособСборки КАК СпособСборки
			|ГДЕ
			|   &УсловиеВидаОплаты = Истина
			|	И ТоварыГотовыеКСборкеОстатки.КоличествоОстаток > 0
			|	И ЗаказыПокупателейОстатки.КоличествоОстаток > 0
			|	И ВЫБОР
			|		КОГДА &ИспользоватьДатуОтгрузкиИзЗаказа = ИСТИНА
			|		ТОГДА ВЫБОР
			|		КОГДА ТоварыГотовыеКСборкеОстатки.ЗаказПокупателя.СпособДоставки = ЗНАЧЕНИЕ(Перечисление.СпособДоставки.НашаДоставка)
			|		ТОГДА ВЫБОР
			|		КОГДА &НачинаемСобиратьНаЗавтра = ИСТИНА
			|		ТОГДА ВЫБОР
			|		КОГДА &ДеньНеделиЧисло = 7
			|		ТОГДА НАЧАЛОПЕРИОДА(ТоварыГотовыеКСборкеОстатки.ЗаказПокупателя.ДатаОтгрузки, ДЕНЬ) <= ДОБАВИТЬКДАТЕ(&ОкончаниеСегодняшнегоДня, ДЕНЬ, &ДобавитьДней)
			|	ИНАЧЕ НАЧАЛОПЕРИОДА(ТоварыГотовыеКСборкеОстатки.ЗаказПокупателя.ДатаОтгрузки, ДЕНЬ) <= ДОБАВИТЬКДАТЕ(&ОкончаниеСегодняшнегоДня, ДЕНЬ, &ДобавитьДней)
			|		И (ТоварыГотовыеКСборкеОстатки.ЗаказПокупателя.ДатаОтгрузки >= &ОкончаниеСегодняшнегоДня
			|		И СпособСборки.ОчередьВремяОкончанияОтправки >= ДОБАВИТЬКДАТЕ(ДОБАВИТЬКДАТЕ(ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0), ЧАС, ЧАС(ТоварыГотовыеКСборкеОстатки.ЗаказПокупателя.ДатаОтгрузки)), МИНУТА, МИНУТА(ТоварыГотовыеКСборкеОстатки.ЗаказПокупателя.ДатаОтгрузки)))
			|		ИЛИ ТоварыГотовыеКСборкеОстатки.ЗаказПокупателя.ДатаОтгрузки < &ТекущаяДата
			|		КОНЕЦ
			|	ИНАЧЕ ВЫБОР
			|		КОГДА &ЭтоРегламент = ИСТИНА
			|		ТОГДА СпособСборки.ТекущееВремяОкончанияОтправки >= ДОБАВИТЬКДАТЕ(ДОБАВИТЬКДАТЕ(ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0), ЧАС, ЧАС(ТоварыГотовыеКСборкеОстатки.ЗаказПокупателя.ДатаОтгрузки)), МИНУТА, МИНУТА(ТоварыГотовыеКСборкеОстатки.ЗаказПокупателя.ДатаОтгрузки))
			|				И ТоварыГотовыеКСборкеОстатки.ЗаказПокупателя.ДатаОтгрузки < &ОкончаниеСегодняшнегоДня
			|			  ИЛИ ТоварыГотовыеКСборкеОстатки.ЗаказПокупателя.ДатаОтгрузки <= &ТекущаяДата	
			|	ИНАЧЕ ИСТИНА
			|		КОНЕЦ
			|		КОНЕЦ
			|	ИНАЧЕ ВЫБОР
			|		КОГДА &ЭтоРегламент = ИСТИНА
			|		ТОГДА ТоварыГотовыеКСборкеОстатки.ЗаказПокупателя.ДатаОтгрузки <= &ВремяОтправкиНаСамовывоз
			|	ИНАЧЕ ИСТИНА
			|		КОНЕЦ
			|		КОНЕЦ
			|	ИНАЧЕ ИСТИНА
			|		КОНЕЦ   			
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ТоварыВЯчейкахОстатки.Склад КАК Склад,
			|	ТоварыВЯчейкахОстатки.Номенклатура КАК Номенклатура,
			|	ТоварыВЯчейкахОстатки.Ячейка,
			|	ТоварыВЯчейкахОстатки.ГМ,
			|	ВЫБОР
			|		КОГДА СпособСборки.СоздаватьСборки = ЗНАЧЕНИЕ(Перечисление.СоздаватьСборки.БезРазбивки)
			|			ТОГДА 0
			|		ИНАЧЕ ВЫБОР
			|		КОГДА СпособСборки.СоздаватьСборки = ЗНАЧЕНИЕ(Перечисление.СоздаватьСборки.РазбиватьПоСекциям)
			|			ТОГДА ТоварыВЯчейкахОстатки.Ячейка.НаименованиеЭтажа
			|		ИНАЧЕ ТоварыВЯчейкахОстатки.Ячейка.Этаж
			|		КОНЕЦ
			|	КОНЕЦ КАК Этаж,
			|	ТоварыВЯчейкахОстатки.Ячейка.ПриоритетСписывания КАК ПриоритетСписывания,
			|	ТоварыВЯчейкахОстатки.КоличествоОстаток КАК Количество
			|ПОМЕСТИТЬ ОстаткиПоЯчейкам
			|ИЗ
			|	РегистрНакопления.ТоварыВЯчейках.Остатки(
			|			,
			|			(Номенклатура, Склад) В
			|				(ВЫБРАТЬ
			|					НоменклатураПоЗаказам.Номенклатура,
			|					НоменклатураПоЗаказам.Склад
			|				ИЗ
			|					НоменклатураПоЗаказам КАК НоменклатураПоЗаказам
			|				ГДЕ
			|					НоменклатураПоЗаказам.Количество > 0)) КАК ТоварыВЯчейкахОстатки,
			|	СпособСборки КАК СпособСборки
			|ГДЕ
			|	ТоварыВЯчейкахОстатки.Ячейка.Этаж <> 0
			|	И ТоварыВЯчейкахОстатки.Ячейка <> &ЯчейкаДоВыяснения
			|	И ТоварыВЯчейкахОстатки.КоличествоОстаток > 0
			|	И ТоварыВЯчейкахОстатки.Ячейка.НеУчитыватьВОперативномУчете = ЛОЖЬ
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	НоменклатураПоЗаказам.Склад КАК Склад,
			|	НоменклатураПоЗаказам.Заказ КАК Заказ,
			|	НоменклатураПоЗаказам.Номенклатура КАК Номенклатура,
			|	НоменклатураПоЗаказам.Количество КАК Количество,
			|	НоменклатураПоЗаказам.Назначение
			|ИЗ
			|	НоменклатураПоЗаказам КАК НоменклатураПоЗаказам
			|
			|СГРУППИРОВАТЬ ПО
			|	НоменклатураПоЗаказам.Заказ,
			|	НоменклатураПоЗаказам.Назначение,
			|	НоменклатураПоЗаказам.Номенклатура,
			|	НоменклатураПоЗаказам.Склад,
			|	НоменклатураПоЗаказам.Количество
			|
			|УПОРЯДОЧИТЬ ПО
			|	Склад,
			|	Назначение,
			|	Заказ,
			|	Номенклатура
			|АВТОУПОРЯДОЧИВАНИЕ
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ОстаткиПоЯчейкам.Склад,
			|	ОстаткиПоЯчейкам.Этаж КАК Этаж,
			|	ОстаткиПоЯчейкам.Номенклатура КАК Номенклатура,
			|	ОстаткиПоЯчейкам.Ячейка,
			|	ОстаткиПоЯчейкам.ГМ,
			|	ОстаткиПоЯчейкам.ПриоритетСписывания КАК ПриоритетСписывания,
			|	ОстаткиПоЯчейкам.Количество
			|ИЗ
			|	ОстаткиПоЯчейкам КАК ОстаткиПоЯчейкам
			|
			|УПОРЯДОЧИТЬ ПО
			|	Номенклатура,
			|	ПриоритетСписывания УБЫВ,
			|	Этаж
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ОстаткиПоЯчейкам.Этаж) КАК Этаж
			|ИЗ
			|	ОстаткиПоЯчейкам КАК ОстаткиПоЯчейкам";
			
			УсловиеВидаОплаты = "ТоварыГотовыеКСборкеОстатки.ЗаказПокупателя.ОплатаНаличными = " + ?(н = 1, "ИСТИНА", "ЛОЖЬ");
			
			//+Белов А. 15.12.2025 #UT10-5582
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеВидаОплаты = Истина", УсловиеВидаОплаты);
			//-Белов А. 15.12.2025 #UT10-5582
			
			Если НЕ ЭтоРегламент И ЗначениеЗаполнено(ТекСтр.ЗаказНаСборку) Тогда
				
				Запрос.УстановитьПараметр("ЗаказНаСборку", ТекСтр.ЗаказНаСборку);
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоРегистрам = Истина", " ЗаказПокупателя В(&ЗаказНаСборку)");
				
			Иначе
				
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоРегистрам = Истина", " ЗаказПокупателя.ДоговорКонтрагента = &ДоговорКонтрагента И ЗаказПокупателя.Грузополучатель = &Грузополучатель И ЗаказПокупателя.СпособДоставки = &СпособДоставки");
				Запрос.УстановитьПараметр("ДоговорКонтрагента", 	ТекСтр.ДоговорКонтрагента);				
				Запрос.УстановитьПараметр("СпособДоставки", 		ТипДоставки);		  
				
			КонецЕсли;
			
			Запрос.УстановитьПараметр("Грузополучатель", 		ТекСтр.Грузополучатель);
			Запрос.УстановитьПараметр("ЯчейкаДоВыяснения",   	 	ЯчейкаДоВыяснения);
			Запрос.УстановитьПараметр("ИспользоватьДатуОтгрузкиИзЗаказа",  	ИспользоватьДатуОтгрузкиИзЗаказа);
			Запрос.УстановитьПараметр("НачинаемСобиратьНаЗавтра",       	НачинаемСобиратьНаЗавтра);			
			Запрос.УстановитьПараметр("ТекущаяДата",						ТекущаяДата());
			Запрос.УстановитьПараметр("НачалоСегодняшнегоДня",				НачалоДня(ТекущаяДата()));	
			Запрос.УстановитьПараметр("ДеньНеделиЧисло", пДеньНедели); 
			//+Гавриленков В. 01.11.2024 #UT10-4855
			//Запрос.УстановитьПараметр("ДобавитьДней", ?(пДеньНедели = 6, 2, 1));
			Запрос.УстановитьПараметр("ДобавитьДней", ?(ДеньНедели(ТекущаяДата()) = 6, 2, 1));
			//-Гавриленков В. 01.11.2024 #UT10-4855
			Запрос.УстановитьПараметр("ВремяОтправкиНаСамовывоз", ВремяОтправкиНаСамовывоз);
			Запрос.УстановитьПараметр("ОкончаниеСегодняшнегоДня", КонецДня(ТекущаяДата()));
			Запрос.УстановитьПараметр("ЭтоРегламент", ЭтоРегламент);
			Запрос.УстановитьПараметр("ПараметрВремяОчереди", ПараметрВремяОчереди);			
			Запрос.УстановитьПараметр("ТекущееВремя", ПараметрТекущееВремя);
						
			Пакет = Запрос.ВыполнитьПакет();  
			ТЗТоваров = Пакет[3].Выгрузить();
			ТЗЯчейки = Пакет[4].Выгрузить();
			
			Если ТЗТоваров.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			КоличествоВозможныхЭтажей = Пакет[5].Выгрузить()[0].Этаж;
			
			ТЗ = Новый ТаблицаЗначений;
			ТЗ.Колонки.Добавить("Этаж");
			ТЗ.Колонки.Добавить("Заказ");
			ТЗ.Колонки.Добавить("Номенклатура");
			ТЗ.Колонки.Добавить("Ячейка");
			ТЗ.Колонки.Добавить("Количество");
			ТЗ.Колонки.Добавить("Склад"); 
			ТЗ.Колонки.Добавить("Назначение");
			ТЗ.Колонки.Добавить("ГМ");
						
			ТЗ_ПерваяОчередь = Новый ТаблицаЗначений;
			ТЗ_ПерваяОчередь.Колонки.Добавить("Склад");
			ТЗ_ПерваяОчередь.Колонки.Добавить("Этаж");
			ТЗ_ПерваяОчередь.Колонки.Добавить("Номенклатура");
			ТЗ_ПерваяОчередь.Колонки.Добавить("Ячейка");
			ТЗ_ПерваяОчередь.Колонки.Добавить("ПриоритетСписывания");
			ТЗ_ПерваяОчередь.Колонки.Добавить("Количество");
			ТЗ_ПерваяОчередь.Колонки.Добавить("ИндексСтроки");
			ТЗ_ПерваяОчередь.Колонки.Добавить("ГМ");
			
			ТЗ_ВтораяОчередь = ТЗ_ПерваяОчередь.Скопировать();
			
			ФлагСоздаватьДокументы = Истина;
			
			ПроверятьНаКратность = НачалоДня(Константы.ДатаНачалаПроверкиКратностиНоменклатуры.Получить()) <= НачалоДня(ТекущаяДата()); ; 
			
			Для Каждого СтрТоваров Из ТЗТоваров Цикл
				
				Если НЕ Константы.НеПроверятьКратностьНоменклатурыПриФормированииПриказовНаСборку.Получить() Тогда
					
					Если ПроверятьНаКратность И НЕ ЗначениеЗаполнено(СтрТоваров.Заказ.IDСклада_СтороннийСклад) И МСК.ПроверкаНоменклатурыНаКратность(СтрТоваров.Номенклатура,СтрТоваров.Количество) = Ложь 
						//+Марков И. 18.04.2024 #UT10-4347
						И НЕ СтрТоваров.Заказ.ОбособленнаяОтгрузкаГМИзСтороннегоФилиала Тогда
						//-Марков И. 18.04.2024 #UT10-4347
						#Если Клиент Тогда
							Сообщить("В заказе : " + СтрТоваров.Заказ + "  для  номенклатуры : " + СтрТоваров.Номенклатура + " НАРУШЕНИЕ КРАТНОСТИ!!", СтатусСообщения.Внимание);
						#КонецЕсли
						Продолжить;
						
					КонецЕсли;
					
				КонецЕсли;
				
				МассивГрузомест = Неопределено;
				
				Если СтрТоваров.Заказ.ОбособленнаяОтгрузкаГМИзСтороннегоФилиала Тогда
					МассивГрузомест = Справочники.СобственныеСклады.ПолучитьМассивГрузоместПоЗаказу(СтрТоваров.Заказ);				
				КонецЕсли;
				
				СтруктураПоиска = Новый Структура("Номенклатура,Склад");
				СтруктураПоиска.Номенклатура 	= СтрТоваров.Номенклатура;
				СтруктураПоиска.Склад 			= СтрТоваров.Склад;  
				
				ТЗ_ПерваяОчередь.Очистить();
				ТЗ_ВтораяОчередь.Очистить();
				
				НайденныеСтроки = ТЗЯчейки.НайтиСтроки(СтруктураПоиска); 
				
				Для Каждого СтрПоиска Из НайденныеСтроки Цикл
					
					Если СтрТоваров.Заказ.ОбособленнаяОтгрузкаГМИзСтороннегоФилиала Тогда
						
						Если МассивГрузомест.Найти(СтрПоиска.ГМ) = Неопределено Тогда
							Продолжить;							
						КонецЕсли; 
						
					Иначе
						
						Если ЗначениеЗаполнено(СтрПоиска.ГМ) Тогда
							Продолжить;	
						КонецЕсли;
						
					КонецЕсли;
					
					Если СтрПоиска.Количество = 0 Тогда 
						Продолжить;
					КонецЕсли;
					
					Если СтрПоиска.Количество >= СтрТоваров.Количество Тогда 
						
						НоваяСтрокаПоиска = ТЗ_ПерваяОчередь.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрокаПоиска, СтрПоиска);
						
					ИначеЕсли СтрПоиска.Количество < СтрТоваров.Количество И СтрПоиска.Количество > 0 Тогда 
						
						НоваяСтрокаПоиска = ТЗ_ВтораяОчередь.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрокаПоиска, СтрПоиска);
						
					КонецЕсли; 
					
					НоваяСтрокаПоиска.ИндексСтроки = ТЗЯчейки.Индекс(СтрПоиска);
					
				КонецЦикла;
				
				ТЗ_ПерваяОчередь.Сортировать("ПриоритетСписывания,Этаж");
				ТЗ_ВтораяОчередь.Сортировать("ПриоритетСписывания,Этаж");
				
				// сначала списываем с ячеек, в которых лежит подходящее нам количество товара
				Для Каждого Стр Из ТЗ_ПерваяОчередь Цикл  
					
					Если Стр.Количество = 0 Тогда 
						Продолжить;
					КонецЕсли;					  
					
					СписатьИзЯчейки = Мин(Стр.Количество,СтрТоваров.Количество);  
					
					НоваяСтрока = ТЗ.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока,Стр,, "Количество"); 
					НоваяСтрока.Количество = СписатьИзЯчейки;
					НоваяСтрока.Заказ = СтрТоваров.Заказ;
					
					СтрТоваров.Количество = СтрТоваров.Количество - СписатьИзЯчейки;  
					НоваяСтрока.Назначение = СтрТоваров.Назначение;  
										
					ТЗЯчейки[Стр.ИндексСтроки].Количество = ТЗЯчейки[Стр.ИндексСтроки].Количество - СписатьИзЯчейки;
					
					Если СтрТоваров.Количество <= 0 Тогда
						Прервать;
					КонецЕсли;
					
				КонецЦикла;
				
				// теперь списываем с ячеек, товара в которых полностью нам не хватает
				Если СтрТоваров.Количество > 0 Тогда 
					
					Для Каждого Стр Из ТЗ_ВтораяОчередь Цикл  
						
						Если Стр.Количество = 0 Тогда 
							Продолжить;
						КонецЕсли;					  
						
						СписатьИзЯчейки = Мин(Стр.Количество, СтрТоваров.Количество);  
						
						НоваяСтрока = ТЗ.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр,, "Количество"); 
						НоваяСтрока.Количество = СписатьИзЯчейки;
						НоваяСтрока.Заказ = СтрТоваров.Заказ;
						Стр.Количество = Стр.Количество - СписатьИзЯчейки;
						СтрТоваров.Количество = СтрТоваров.Количество - СписатьИзЯчейки; 
						НоваяСтрока.Назначение = СтрТоваров.Назначение;
												
						ТЗЯчейки[Стр.ИндексСтроки].Количество = ТЗЯчейки[Стр.ИндексСтроки].Количество - СписатьИзЯчейки;
						
						Если СтрТоваров.Количество <= 0 Тогда
							Прервать;
						КонецЕсли;
						
					КонецЦикла;
					
					Если СтрТоваров.Количество > 0 Тогда
						
						Если НЕ ЭтоРегламент Тогда
							Сообщить("Для контрагента : " +  ТекСтр.Контрагент + ", по складу '" + СтрТоваров.Склад + "', по " + СтрТоваров.Заказ 
							+ " товара:" + СтрТоваров.Номенклатура.Артикул + " " + СтрТоваров.Номенклатура + 
							" недостаточно в доступных для списания ячейках. " + Символы.ПС + "Не хватает " + СтрТоваров.Количество + " ед. ", СтатусСообщения.Внимание);
						КонецЕсли;	  
						
						Если НЕ Константы.НеПроверятьКратностьНоменклатурыПриФормированииПриказовНаСборку.Получить() Тогда 
							
							// еще раз проверим на кратность недосписанный остаток
							Если ПроверятьНаКратность И НЕ ЗначениеЗаполнено(СтрТоваров.Заказ.IDСклада_СтороннийСклад) 
								//+Марков И. 18.04.2024 #UT10-4347
								И НЕ СтрТоваров.Заказ.ОбособленнаяОтгрузкаГМИзСтороннегоФилиала
								//-Марков И. 18.04.2024 #UT10-4347
								И МСК.ПроверкаНоменклатурыНаКратность(СтрТоваров.Номенклатура, СтрТоваров.Количество) = Ложь Тогда
								
								Если НЕ ЭтоРегламент Тогда
									
									Сообщить("В заказе : " +  СтрТоваров.Заказ + "  для  номенклатуры : " +  СтрТоваров.Номенклатура + " НАРУШЕНИЕ КРАТНОСТИ!!", СтатусСообщения.Внимание);
									Сообщить("Сборка создана не будет!",СтатусСообщения.Внимание);
									
								КонецЕсли;
								
								СтрНоменклатураКУдалению = ТЗ.НайтиСтроки(Новый Структура("Номенклатура", СтрТоваров.Номенклатура));
								
								Для каждого ЭлМассива Из СтрНоменклатураКУдалению Цикл
									ТЗ.Удалить(ЭлМассива);
								КонецЦикла;						  
								
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли; 
				
			КонецЦикла;  			
			
			КоличествоСтрокВДокументе = Константы.МаксимальноеЧислоСтрокВДокументеСборка.Получить();
			РежимПроведения = РежимЗаписиДокумента.Проведение; 
				
			УпаковатьСамовывоз = ТекСтр.Грузополучатель.УпаковыватьСамовывоз;  
			ТЗ.Колонки.Добавить("УпаковыватьСамовывоз", Новый ОписаниеТипов("Булево"));
			ТЗ.Колонки.Добавить("ТаксиДоставка", Новый ОписаниеТипов("Булево"));
			ТЗ.Колонки.Добавить("ОбособленнаяОтгрузка", Новый ОписаниеТипов("Булево"));
			ТЗ.Колонки.Добавить("ДоговорПоставщикаТОХ", Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"));
			//+Белов А. 15.12.2025 #UT10-5582
			ТЗ.Колонки.Добавить("Маркировка", Новый ОписаниеТипов("Булево"));
			//-Белов А. 15.12.2025 #UT10-5582

			Для Каждого СтрокаТЗ Из ТЗ Цикл
				
				СтрокаТЗ.УпаковыватьСамовывоз = СтрокаТЗ.Заказ.УпаковыватьСамовывоз;
				СтрокаТЗ.ТаксиДоставка = СтрокаТЗ.Заказ.ТаксиДоставка;	
				СтрокаТЗ.ОбособленнаяОтгрузка = СтрокаТЗ.Заказ.ОбособленнаяОтгрузкаГМИзСтороннегоФилиала; 
				СтрокаТЗ.ДоговорПоставщикаТОХ = СтрокаТЗ.Заказ.ДоговорПоставщикаТОХ;   
				
				//+Белов А. 15.12.2025 #UT10-5582
				СтрокаТЗ.Маркировка = ?(ТекСтр.Грузополучатель.РазделятьРТУПоМаркировке, СтрокаТЗ.Номенклатура.ТребуетсяМаркировка, Ложь);	
				//-Белов А. 15.12.2025 #UT10-558 
	
			КонецЦикла;				
			
			Если ТекСтр.Грузополучатель.НеОбъединятьЗаказы Тогда
				//+Белов А. 15.12.2025 #UT10-5582 - добавил Маркировка
				ТЗ.Сортировать("Этаж, Склад, Назначение, Маркировка, ОбособленнаяОтгрузка, Заказ, Номенклатура"); 				
			Иначе 
				
				Если УпаковатьСамовывоз Тогда
					//+Белов А. 15.12.2025 #UT10-5582 - добавил Маркировка
					ТЗ.Сортировать("Этаж, Склад, Назначение, Маркировка, ОбособленнаяОтгрузка, УпаковыватьСамовывоз, ТаксиДоставка, Номенклатура");	
