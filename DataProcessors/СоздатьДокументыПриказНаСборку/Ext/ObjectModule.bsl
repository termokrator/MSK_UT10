Функция ВыполнитьПроверку(Запрос, СтрогаяПроверка = Истина, ЭтоРегламент = Ложь, ДляБиллинга = Ложь, НачинаемСобиратьНаЗавтра = Ложь) Экспорт
	
	СписокФильтрМаршрутов  = Новый СписокЗначений;
	СписокОчередейДоставки = Новый СписокЗначений;

	Если СтрогаяПроверка Тогда 
		
		Для Каждого Стр Из Маршруты Цикл
			
			Если Стр.Отметка Тогда
				СписокФильтрМаршрутов.Добавить(Стр.Маршрут,Стр.Маршрут);
			КонецЕсли;		  
			
		КонецЦикла;
		
		Если СписокФильтрМаршрутов.Количество() = 0 И ТипДоставки = Перечисления.СпособДоставки.НашаДоставка и НЕ ЭтоРегламент Тогда
			
			#Если Клиент Тогда
				Предупреждение("Нет выбранных Маршрутов !",5);
			#КонецЕсли
			Возврат Ложь;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЭтоРегламент Тогда
		
		//+Гавриленков В. 31.10.2024 #UT10-4855
		//пДеньНедели = ДеньНедели(ТекущаяДата());		
		//
		//Если пДеньНедели = 6 Тогда
		//	пДеньНедели = ПроверитьСубботу(ТекущаяДата());
		//КонецЕсли;
		
		пДеньНедели = МСК.ПолучитьДеньПоКалендарю(ТекущаяДата());
		//-Гавриленков В. 31.10.2024 #UT10-4855		
		
	Иначе
		пДеньНедели = ДеньНеделиЧисло; 
	КонецЕсли;     
	
	//+Гавриленков В. 31.10.2024 #UT10-4855
	ДеньНеделиК = ДеньНедели(ТекущаяДата());   
	//-Гавриленков В. 31.10.2024 #UT10-4855
	
	СтрокаФильтрДнейНедели = "";

	Если НачинаемСобиратьНаЗавтра Тогда
		
		Если ДеньНедели(ТекущаяДата()) = 5 Тогда 
			РабочаяСуббота =  ПроверитьСубботу(ТекущаяДата() + 86400) = 1;
		Иначе
			РабочаяСуббота = Ложь;	
		КонецЕсли;
		
		//+Гавриленков В. 01.11.2024 #UT10-4855
		//ПромДеньНеделиЧисло = ?(пДеньНедели = 6  ИЛИ пДеньНедели = 7 ИЛИ РабочаяСуббота,1 ,пДеньНедели+1);  
		Если ЭтоРегламент Тогда
			ПромДеньНеделиЧисло = ?(ДеньНеделиК = 6  ИЛИ ДеньНеделиК = 7 ИЛИ РабочаяСуббота, 1 , ДеньНеделиК + 1); 
		Иначе
			ПромДеньНеделиЧисло = ?(пДеньНедели = 6  ИЛИ пДеньНедели = 7 ИЛИ РабочаяСуббота, 1 , пДеньНедели + 1);
		КонецЕсли;
		//-Гавриленков В. 01.11.2024 #UT10-4855
		
	Иначе   
		
		//+Гавриленков В. 01.11.2024 #UT10-4855
		Если ЭтоРегламент Тогда 
			ПромДеньНеделиЧисло = ДеньНеделиК;
		Иначе
			ПромДеньНеделиЧисло = пДеньНедели; 
		КонецЕсли;
		//-Гавриленков В. 01.11.2024 #UT10-4855
		
	КонецЕсли; 

	Для ДН = 1 По 7 Цикл 
		
		//+Гавриленков В. 01.11.2024 #UT10-4855
		//Если ПромДеньНеделиЧисло = ДН ИЛИ (НЕ НачинаемСобиратьНаЗавтра И пДеньНедели = ДН)  Тогда
		Если ПромДеньНеделиЧисло = ДН Тогда
			СтрокаФильтрДнейНедели = СтрокаФильтрДнейНедели + "1;"; 
		Иначе
			СтрокаФильтрДнейНедели = СтрокаФильтрДнейНедели + "%;";
		КонецЕсли;  		   
		
	КонецЦикла; 	

	ПараметрТекущееВремя = Дата('00010101') + (ТекущаяДата() - НачалоДня(ТекущаяДата()));
	ПараметрВремяОчереди = ТекущаяДата();

	ЗапросМаксимальногоВремениОчереди = Новый Запрос;
	ЗапросМаксимальногоВремениОчереди.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	МАКСИМУМ(ОчередьДоставки.ВремяОкончанияОтправки) КАК ВремяОкончанияОтправки
	|ИЗ
	|	Справочник.ОчередьДоставки КАК ОчередьДоставки
	|ГДЕ
	|	НЕ ОчередьДоставки.ПометкаУдаления
	|	И ОчередьДоставки.ВремяНачалаОтправки <= &ТекущееВремя
	|	И ОчередьДоставки.ВремяОкончанияОтправки >= &ТекущееВремя
	|
	|СГРУППИРОВАТЬ ПО
	|	ОчередьДоставки.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВремяОкончанияОтправки УБЫВ";
	
	ЗапросМаксимальногоВремениОчереди.УстановитьПараметр("ТекущееВремя", ПараметрТекущееВремя);
	
	Результат = ЗапросМаксимальногоВремениОчереди.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		ПараметрВремяОчереди = НачалоДня(ТекущаяДата()) + Час(Выборка.ВремяОкончанияОтправки) * 60 * 60 + Минута(Выборка.ВремяОкончанияОтправки) * 60;
		
	КонецЕсли;

	Если ЭтоРегламент Тогда
		
		Если НачинаемСобиратьНаЗавтра И ТипДоставки = Перечисления.СпособДоставки.НашаДоставка Тогда
			
			ПараметрТекущееВремя = Дата('00010101') + (ТекущаяДата() - НачалоДня(ТекущаяДата()));
			ФильтрМаршрутовНаЗавтра = Новый Массив;
			ПромНачинаемСобиратьНаЗавтра = Ложь;
			ПромВремяНачалаДоставкиНаЗавтра = Константы.ВремяНачалаДоставкиНаЗавтра.Получить();
			ПромВремяНачалаДоставкиНаЗавтраДляСубботы = Константы.ВремяНачалаДоставкиНаЗавтраДляСубботы.Получить();

			Если пДеньНедели = 6 Тогда        

				Если ЗначениеЗаполнено(ПромВремяНачалаДоставкиНаЗавтраДляСубботы) И ПромВремяНачалаДоставкиНаЗавтраДляСубботы < ПараметрТекущееВремя Тогда 
					ПромНачинаемСобиратьНаЗавтра = Истина;
				КонецЕсли;

			ИначеЕсли  пДеньНедели = 6 Тогда
				ПромНачинаемСобиратьНаЗавтра = Истина;
			Иначе
				
				Если ЗначениеЗаполнено(ПромВремяНачалаДоставкиНаЗавтра) И ПромВремяНачалаДоставкиНаЗавтра < ПараметрТекущееВремя Тогда 
					ПромНачинаемСобиратьНаЗавтра = Истина;
				КонецЕсли;
				
			КонецЕсли;
			
			Если НЕ ПромНачинаемСобиратьНаЗавтра Тогда
				
				ЗапросМаршрутов = Новый Запрос;
				ЗапросМаршрутов.Текст = 
				"ВЫБРАТЬ
				|	МаршрутыДоставки.Ссылка КАК Маршрут
				|ИЗ
				|	Справочник.МаршрутыДоставки КАК МаршрутыДоставки
				|ГДЕ
				|	МаршрутыДоставки.ВремяНачалаСозданияСборокНаЗавтра <= &ТекущееВремя
				|	И НЕ МаршрутыДоставки.ВремяНачалаСозданияСборокНаЗавтра = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)";

				Если пДеньНедели = 6 Тогда         
					
					ЗапросМаршрутов.Текст = СтрЗаменить(ЗапросМаршрутов.Текст, "МаршрутыДоставки.ВремяНачалаСозданияСборокНаЗавтра <= &ТекущееВремя","МаршрутыДоставки.ВремяНачалаСозданияСборокНаЗавтраДляСубботы <= &ТекущееВремя");
					ЗапросМаршрутов.Текст = СтрЗаменить(ЗапросМаршрутов.Текст, "И НЕ МаршрутыДоставки.ВремяНачалаСозданияСборокНаЗавтра = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)","И НЕ МаршрутыДоставки.ВремяНачалаСозданияСборокНаЗавтраДляСубботы = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)");
					
				КонецЕсли;
				
				ЗапросМаршрутов.УстановитьПараметр("ТекущееВремя", ПараметрТекущееВремя);
				РезультатЗапросаМаршрутов = ЗапросМаршрутов.Выполнить().Выгрузить();
				
				Если НЕ РезультатЗапросаМаршрутов.Количество() = 0 Тогда
					ФильтрМаршрутовНаЗавтра = РезультатЗапросаМаршрутов.ВыгрузитьКолонку("Маршрут");
				КонецЕсли;
				
			КонецЕсли;

			ЗапросМаршрутовИОчередей = Новый Запрос;
			ЗапросМаршрутовИОчередей.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
			ЗапросМаршрутовИОчередей.Текст =
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ЗаказПокупателя.Грузополучатель
			|ПОМЕСТИТЬ ДоставкаНаЗавтра
			|ИЗ
			|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
			|ГДЕ
			|	ЗаказПокупателя.СпособДоставки = ЗНАЧЕНИЕ(Перечисление.СпособДоставки.НашаДоставка)
			|	И 
			|        ВЫБОР
			|			КОГДА ЗаказПокупателя.ДатаОтгрузки = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
			|				ТОГДА ВЫРАЗИТЬ(ЗаказПокупателя.Грузополучатель.РасписаниеРаботыСтрокой КАК СТРОКА(15)) ПОДОБНО &СтрокаФильтрДнейНедели
			|             И НАЧАЛОПЕРИОДА(ЗаказПокупателя.Дата,ДЕНЬ) = НАЧАЛОПЕРИОДА(&ТекущаяДата)
			|			ИНАЧЕ 
			|       ЗаказПокупателя.ДатаОтгрузки >= &НачалоЗавтрашнегоДня
			|					И ЗаказПокупателя.ДатаОтгрузки <= ДОБАВИТЬКДАТЕ(&КонецЗавтрашнегоДня, ДЕНЬ, &ДобавитьДней)
			|		КОНЕЦ
			|";
			
			Если НЕ ФильтрМаршрутовНаЗавтра.Количество() = 0 Тогда
				
				ЗапросМаршрутовИОчередей.УстановитьПараметр("СписокМаршрутов",ФильтрМаршрутовНаЗавтра);
				ЗапросМаршрутовИОчередей.Текст = ЗапросМаршрутовИОчередей.Текст + "
				| И ЗаказПокупателя.Грузополучатель.МаршрутДоставки В (&СписокМаршрутов) ";
				
			КонецЕсли;

			ЗапросМаршрутовИОчередей.Текст = ЗапросМаршрутовИОчередей.Текст + "
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ДоставкаНаЗавтра.Грузополучатель.МаршрутДоставки КАК МаршрутДоставки,
			|	КонтрагентыОчередиДоставки.Очередь
			|ПОМЕСТИТЬ МаршрутыСОчередями
			|ИЗ
			|	ДоставкаНаЗавтра КАК ДоставкаНаЗавтра
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты.ОчередиДоставки КАК КонтрагентыОчередиДоставки
			|		ПО ДоставкаНаЗавтра.Грузополучатель = КонтрагентыОчередиДоставки.Ссылка
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	МаршрутыСОчередями.МаршрутДоставки,
			|	МИНИМУМ(МаршрутыСОчередями.Очередь.ВремяОкончанияОтправки) КАК ОчередьВремяОкончанияОтправки
			|ПОМЕСТИТЬ МаршрутыИВремя
			|ИЗ
			|	МаршрутыСОчередями КАК МаршрутыСОчередями
			|
			|СГРУППИРОВАТЬ ПО
			|	МаршрутыСОчередями.МаршрутДоставки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	МаршрутыИВремя.МаршрутДоставки КАК МаршрутДоставки,
			|	МаршрутыСОчередями.Очередь КАК Очередь
			|ИЗ
			|	МаршрутыИВремя КАК МаршрутыИВремя
			|		ЛЕВОЕ СОЕДИНЕНИЕ МаршрутыСОчередями КАК МаршрутыСОчередями
			|		ПО МаршрутыИВремя.МаршрутДоставки = МаршрутыСОчередями.МаршрутДоставки
			|			И МаршрутыИВремя.ОчередьВремяОкончанияОтправки = МаршрутыСОчередями.Очередь.ВремяОкончанияОтправки";
			
			ЗапросМаршрутовИОчередей.УстановитьПараметр("НачалоЗавтрашнегоДня", КонецДня(ТекущаяДата()) + 1);
			ЗапросМаршрутовИОчередей.УстановитьПараметр("КонецЗавтрашнегоДня", КонецДня(КонецДня(ТекущаяДата()) + 1));
			ЗапросМаршрутовИОчередей.УстановитьПараметр("ДобавитьДней", ?(ДеньНедели(ТекущаяДата()) = 6, 1, 0));
			ЗапросМаршрутовИОчередей.УстановитьПараметр("СтрокаФильтрДнейНедели", СтрокаФильтрДнейНедели);
			ЗапросМаршрутовИОчередей.УстановитьПараметр("ТекущаяДата", ТекущаяДата());

			РезультатЗапроса = ЗапросМаршрутовИОчередей.Выполнить();
			
			Если НЕ РезультатЗапроса.Пустой() Тогда
				
				ТаблРезультат = РезультатЗапроса.Выгрузить();
				СписокФильтрМаршрутов.ЗагрузитьЗначения(ТаблРезультат.ВыгрузитьКолонку("МаршрутДоставки"));
				СписокОчередейДоставки.ЗагрузитьЗначения(ТаблРезультат.ВыгрузитьКолонку("Очередь"));
				
			КонецЕсли;
			
			Если СписокФильтрМаршрутов.Количество() = 0 И СписокОчередейДоставки.Количество() = 0 Тогда
				Возврат Ложь;
			КонецЕсли;			
			
		Иначе

			ЗапросМаршрутов = Новый Запрос;
			ЗапросМаршрутов.Текст = 
			"ВЫБРАТЬ
			|	МаршрутыДоставки.Ссылка КАК Маршрут
			|ИЗ
			|	Справочник.МаршрутыДоставки КАК МаршрутыДоставки
			|ГДЕ
			|	НЕ МаршрутыДоставки.ПометкаУдаления
			|	И МаршрутыДоставки.ВремяНачала <= &ТекущееВремя
			|	И МаршрутыДоставки.ВремяОкончания >= &ТекущееВремя
			|
			|УПОРЯДОЧИТЬ ПО
			|	МаршрутыДоставки.Наименование";
			
			Если НачинаемСобиратьНаЗавтра Тогда 
				
				// собираем на завтра, маршруты не учитываем , нам нужны все маршруты
				ЗапросМаршрутов.Текст = СтрЗаменить(ЗапросМаршрутов.Текст, "И МаршрутыДоставки.ВремяНачала <= &ТекущееВремя","");
				ЗапросМаршрутов.Текст = СтрЗаменить(ЗапросМаршрутов.Текст, "И МаршрутыДоставки.ВремяОкончания >= &ТекущееВремя","");
				
			Иначе
				
				Если пДеньНедели = 6 Тогда         
					ЗапросМаршрутов.Текст = СтрЗаменить(ЗапросМаршрутов.Текст, "И МаршрутыДоставки.ВремяОкончания >= &ТекущееВремя","И МаршрутыДоставки.ВремяОкончанияВСубботу >= &ТекущееВремя");
				КонецЕсли;
				
				ЗапросМаршрутов.УстановитьПараметр("ТекущееВремя", ПараметрТекущееВремя);
				
			КонецЕсли; 
			
			Результат = ЗапросМаршрутов.Выполнить();
			
			Если НЕ Результат.Пустой() Тогда
				
				Выборка = Результат.Выбрать();
				
				Пока Выборка.Следующий() Цикл
					СписокФильтрМаршрутов.Добавить(Выборка.Маршрут, Выборка.Маршрут);
				КонецЦикла;		  
				
			КонецЕсли;
			
			ЗапросОчередей = Новый Запрос;
			
			Если НачинаемСобиратьНаЗавтра Тогда
				
				ЗапросОчередей.Текст = 
				"ВЫБРАТЬ
				|	ОчередьДоставки.Ссылка КАК Очередь
				|ИЗ
				|	Справочник.ОчередьДоставки КАК ОчередьДоставки
				|ГДЕ
				|	НЕ ОчередьДоставки.ПометкаУдаления
				|
				|УПОРЯДОЧИТЬ ПО
				|	Очередь
				|АВТОУПОРЯДОЧИВАНИЕ";
				
			Иначе
				
				ЗапросОчередей.Текст = 
				"ВЫБРАТЬ
				|	ОчередьДоставки.Ссылка КАК Очередь
				|ИЗ
				|	Справочник.ОчередьДоставки КАК ОчередьДоставки
				|ГДЕ
				|	НЕ ОчередьДоставки.ПометкаУдаления
				|	И ОчередьДоставки.ВремяНачалаОтправки <= &ТекущееВремя
				|	И ОчередьДоставки.ВремяОкончанияОтправки >= &ТекущееВремя";
				
				ЗапросОчередей.УстановитьПараметр("ТекущееВремя", ПараметрТекущееВремя);
				
			КонецЕсли;
			
			Результат = ЗапросОчередей.Выполнить();
			
			Если НЕ Результат.Пустой() Тогда
				
				Выборка = Результат.Выбрать();
				
				Пока Выборка.Следующий() Цикл
					СписокОчередейДоставки.Добавить(Выборка.Очередь,Выборка.Очередь);
				КонецЦикла;		  
				
			КонецЕсли;
			
		КонецЕсли;

		ВремяОтправкиНаСамовывоз = ТекущаяДата() + (Константы.ВремяОтправкиНаСамовывоз.Получить() * 60);

	Иначе
		
		Если ЗначениеЗаполнено(Очередь) тогда 
			СписокОчередейДоставки.Добавить(Очередь);
		КонецЕсли;
		
	КонецЕсли;             
	
	//+Гавриленков В. 25.07.2025 #UT10-5354 В таблице Документы убрал "разрешающее" условие - ИЛИ ДокументыПредв.Грузополучатель.ОбособленнаяОтгрузкаГМИзСтороннегоФилиала
	//-Гавриленков В. 22.01.2026 #UT10-5608 В таблицу с индексом 13 добавил в условие ДоговорКонтрагента.КонтролироватьВзаиморасчетыЧерезСистемуБиллинг
	Запрос.Текст =
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ТоварыГотовыеКСборкеОстатки.ЗаказПокупателя.Грузополучатель КАК Грузополучатель,
			|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ТоварыГотовыеКСборкеОстатки.Номенклатура) КАК КоличествоТоваров
			|ПОМЕСТИТЬ ВтТоварыКоличество
			|ИЗ
			|	РегистрНакопления.ТоварыГотовыеКСборке.Остатки КАК ТоварыГотовыеКСборкеОстатки
			|ГДЕ
			|	ВЫБОР
			|			КОГДА &ИспользоватьДатуОтгрузкиИзЗаказа
			|				ТОГДА ВЫБОР
			|						КОГДА ТоварыГотовыеКСборкеОстатки.ЗаказПокупателя.СпособДоставки = ЗНАЧЕНИЕ(Перечисление.СпособДоставки.НашаДоставка)
			|							ТОГДА ВЫБОР
			|									КОГДА &НачинаемСобиратьНаЗавтра
			|										ТОГДА НАЧАЛОПЕРИОДА(ТоварыГотовыеКСборкеОстатки.ЗаказПокупателя.ДатаОтгрузки, ДЕНЬ) <= ДОБАВИТЬКДАТЕ(&ОкончаниеСегодняшнегоДня, ДЕНЬ, &ДобавитьДней)
			|												И (ТоварыГотовыеКСборкеОстатки.ЗаказПокупателя.ДатаОтгрузки >= &ОкончаниеСегодняшнегоДня
			|													ИЛИ ВЫБОР
			|														КОГДА &ДеньНеделиЧисло = 7
			|															ТОГДА ТоварыГотовыеКСборкеОстатки.ЗаказПокупателя.ДатаОтгрузки < &ОкончаниеСегодняшнегоДня
			|														ИНАЧЕ ТоварыГотовыеКСборкеОстатки.ЗаказПокупателя.ДатаОтгрузки < &ТекущаяДата
			|													КОНЕЦ)
			|									ИНАЧЕ ВЫБОР
			|											КОГДА &ЭтоРегламент
			|												ТОГДА ТоварыГотовыеКСборкеОстатки.ЗаказПокупателя.ДатаОтгрузки <= &ПараметрВремяОчереди
			|											ИНАЧЕ ИСТИНА
			|										КОНЕЦ
			|								КОНЕЦ
			|						ИНАЧЕ ВЫБОР
			|								КОГДА &ЭтоРегламент
			|									ТОГДА ТоварыГотовыеКСборкеОстатки.ЗаказПокупателя.ДатаОтгрузки <= &ВремяОтправкиНаСамовывоз
			|								ИНАЧЕ ИСТИНА
			|							КОНЕЦ
			|					КОНЕЦ
			|			ИНАЧЕ ИСТИНА
			|		КОНЕЦ
			|	И ТоварыГотовыеКСборкеОстатки.КоличествоОстаток > 0
			|
			|СГРУППИРОВАТЬ ПО
			|	ТоварыГотовыеКСборкеОстатки.ЗаказПокупателя.Грузополучатель
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	Грузополучатель
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	Заказы.ЗаказПокупателя.ДоговорКонтрагента.Владелец КАК Контрагент,
