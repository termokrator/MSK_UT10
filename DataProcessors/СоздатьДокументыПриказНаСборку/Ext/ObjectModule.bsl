			|		КОНЕЦ * Заказы.КоличествоОстаток) КАК СуммаПоЗаказам,
			|	Заказы.ЗаказПокупателя,
			|	Заказы.ЗаказПокупателя.ТолькоРезерв КАК ТолькоРезерв,
			|	МАКСИМУМ(Заказы.ЗаказПокупателя.Грузополучатель.ИнтервалДоОкончанияОчереди) КАК ИнтервалДоОкончанияОчереди,
			|	МАКСИМУМ(Заказы.ЗаказПокупателя.Грузополучатель.МинимальноеКоличествоТваровГотовыхКСборке) КАК КоличествоТоваровМинимум,
			|	МАКСИМУМ(КолТоваровГотовыхКСборке.КоличествоТоваров) КАК КоличествоТоваровГотово,
			|	МАКСИМУМ(ДОБАВИТЬКДАТЕ(ДОБАВИТЬКДАТЕ(ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0), ЧАС, ЧАС(Заказы.ЗаказПокупателя.ДатаОтгрузки)), МИНУТА, МИНУТА(Заказы.ЗаказПокупателя.ДатаОтгрузки))) КАК ВремяОтгрузки
			|ПОМЕСТИТЬ ДокументыПредв
			|ИЗ
			|	РегистрНакопления.ТоварыГотовыеКСборке.Остатки(
			|			,
			|			(ЗаказПокупателя.СпособДоставки = &СпособДоставки
			|				ИЛИ &ЛюбойСпособДоставки = ИСТИНА)
			|				И (ЗаказПокупателя.Грузополучатель.МаршрутДоставки В (&СписокФильтрМаршрутов)
			|					ИЛИ &ЛюбойМаршрут = ИСТИНА)
			|				И (ПОДСТРОКА(ЗаказПокупателя.Грузополучатель.РасписаниеРаботыСтрокой, 0, 200) = """"
			|					ИЛИ ВЫРАЗИТЬ(ЗаказПокупателя.Грузополучатель.РасписаниеРаботыСтрокой КАК СТРОКА(15)) ПОДОБНО &СтрокаФильтрДнейНедели
			|					ИЛИ &ЛюбоеРасписание = ИСТИНА)
			|				И (ЗаказПокупателя.Организация = &Организация
			|					ИЛИ &ЛюбаяОрганизация = ИСТИНА)
			|				И (НЕ ЗаказПокупателя.Грузополучатель.НеСоздаватьСборкуВАвтоматическомРежиме
			|					ИЛИ &ЭтоРучнойРежим = ИСТИНА)
			|				И (НЕ &ЭтоРегламент
			|					ИЛИ (ЗаказПокупателя.СпособДоставки = ЗНАЧЕНИЕ(Перечисление.СпособДоставки.НашаДоставка)
			|							И НЕ ЗаказПокупателя.Грузополучатель.НеСоздаватьСборкуВАвтоматическомРежимеПриДоставке
			|						ИЛИ ЗаказПокупателя.СпособДоставки = ЗНАЧЕНИЕ(Перечисление.СпособДоставки.Самовывоз)
			|							И НЕ ЗаказПокупателя.Грузополучатель.НеСоздаватьСборкуВАвтоматическомРежимеПриСамовывозе))) КАК Заказы
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыПокупателей.Остатки(, НЕ ТолькоРезерв) КАК ЗаказыПокупателей
			|		ПО Заказы.ЗаказПокупателя = ЗаказыПокупателей.ЗаказПокупателя
			|			И Заказы.Номенклатура = ЗаказыПокупателей.Номенклатура
			|		ЛЕВОЕ СОЕДИНЕНИЕ ВтТоварыКоличество КАК КолТоваровГотовыхКСборке
			|		ПО Заказы.ЗаказПокупателя.Грузополучатель = КолТоваровГотовыхКСборке.Грузополучатель
			|ГДЕ
			|	Заказы.КоличествоОстаток > 0
			|	И ВЫБОР
			|			КОГДА &ИспользоватьДатуОтгрузкиИзЗаказа
			|				ТОГДА ВЫБОР
			|						КОГДА Заказы.ЗаказПокупателя.СпособДоставки = ЗНАЧЕНИЕ(Перечисление.СпособДоставки.НашаДоставка)
			|							ТОГДА ВЫБОР
			|									КОГДА &НачинаемСобиратьНаЗавтра
			|										ТОГДА НАЧАЛОПЕРИОДА(Заказы.ЗаказПокупателя.ДатаОтгрузки, ДЕНЬ) <= ДОБАВИТЬКДАТЕ(&ОкончаниеСегодняшнегоДня, ДЕНЬ, &ДобавитьДней)
			|												И (Заказы.ЗаказПокупателя.ДатаОтгрузки >= &ОкончаниеСегодняшнегоДня
			|													ИЛИ ВЫБОР
			|														КОГДА &ДеньНеделиЧисло = 7
			|															ТОГДА Заказы.ЗаказПокупателя.ДатаОтгрузки < &ОкончаниеСегодняшнегоДня
			|														ИНАЧЕ Заказы.ЗаказПокупателя.ДатаОтгрузки < &ТекущаяДата
			|													КОНЕЦ)
			|									ИНАЧЕ ВЫБОР
			|											КОГДА &ЭтоРегламент
			|												ТОГДА Заказы.ЗаказПокупателя.ДатаОтгрузки <= &ПараметрВремяОчереди
			|											ИНАЧЕ ИСТИНА
			|										КОНЕЦ
			|								КОНЕЦ
			|						ИНАЧЕ ВЫБОР
			|								КОГДА &ЭтоРегламент
			|									ТОГДА Заказы.ЗаказПокупателя.ДатаОтгрузки <= &ВремяОтправкиНаСамовывоз
			|								ИНАЧЕ ИСТИНА
			|							КОНЕЦ
			|					КОНЕЦ
			|			ИНАЧЕ ИСТИНА
			|		КОНЕЦ
			|	И ЗаказыПокупателей.КоличествоОстаток > 0
			|
			|СГРУППИРОВАТЬ ПО
			|	Заказы.ЗаказПокупателя.Грузополучатель,
			|	Заказы.ЗаказПокупателя.ДоговорКонтрагента,
			|	Заказы.ЗаказПокупателя.СпособДоставки,
			|	Заказы.ЗаказПокупателя.ДоговорКонтрагента.Владелец,
			|	Заказы.ЗаказПокупателя.Грузополучатель.МаршрутДоставки,
			|	Заказы.ЗаказПокупателя.Грузополучатель.МенеджерМСК,
			|	Заказы.ЗаказПокупателя,
			|	Заказы.ЗаказПокупателя.ТолькоРезерв
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ДокументыПредв.Контрагент,
			|	ДокументыПредв.Грузополучатель,
			|	ДокументыПредв.ДоговорКонтрагента,
			|	ДокументыПредв.СпособДоставки,
			|	ДокументыПредв.МаршрутДоставки,
			|	ДокументыПредв.Менеджер,
			|	ДокументыПредв.МинимальнаяСуммаДоставки,
			|	ДокументыПредв.СуммаПоЗаказам,
			|	ДокументыПредв.ЗаказПокупателя,
			|	ДокументыПредв.ТолькоРезерв,
			|	ДокументыПредв.ВремяОтгрузки
			|ПОМЕСТИТЬ Документы
			|ИЗ
			|	ДокументыПредв КАК ДокументыПредв
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты.ОчередиДоставки КАК КонтрагентыОчередиДоставки
			|		ПО ДокументыПредв.Грузополучатель = КонтрагентыОчередиДоставки.Ссылка
			|ГДЕ
			|	ВЫБОР
			|			КОГДА КонтрагентыОчередиДоставки.Очередь В (&СписокОчередейДоставки)
			|					ИЛИ КонтрагентыОчередиДоставки.Очередь ЕСТЬ NULL
			|					ИЛИ &ЛюбаяОчередьДоставки
			|				ТОГДА ВЫБОР
			|						КОГДА &ЭтоРегламент
			|							ТОГДА ВЫБОР
			|									КОГДА ВЫБОР
			|											КОГДА ДокументыПредв.КоличествоТоваровМинимум > 0
			|												ТОГДА ДокументыПредв.КоличествоТоваровМинимум <= ДокументыПредв.КоличествоТоваровГотово
			|											ИНАЧЕ ВЫБОР
			|													КОГДА &НачинаемСобиратьНаЗавтра
			|														ТОГДА ВЫБОР
			|																КОГДА КонтрагентыОчередиДоставки.Очередь В (&СписокОчередейДоставки)
			|																	ТОГДА ДокументыПредв.ВремяОтгрузки <= КонтрагентыОчередиДоставки.Очередь.ВремяОкончанияОтправки
			|																			ИЛИ ДокументыПредв.ЗаказПокупателя.ДатаОтгрузки < &ТекущаяДата
			|																ИНАЧЕ ЛОЖЬ
			|															КОНЕЦ
			|													ИНАЧЕ ВЫБОР
			|															КОГДА ДокументыПредв.ЗаказПокупателя.ДатаОтгрузки = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
			|																ТОГДА ИСТИНА
			|															ИНАЧЕ ВЫБОР
			|																	КОГДА ДокументыПредв.ЗаказПокупателя.СпособДоставки = ЗНАЧЕНИЕ(Перечисление.СпособДоставки.НашаДоставка)
			|																		ТОГДА ВЫБОР
			|																				КОГДА ДЕНЬ(ДокументыПредв.ЗаказПокупателя.ДатаОтгрузки) = ДЕНЬ(&ТекущаяДата)
			|																					ТОГДА ДокументыПредв.ВремяОтгрузки <= ЕСТЬNULL(КонтрагентыОчередиДоставки.Очередь.ВремяОкончанияОтправки, &ТекущаяДата)
			|																				ИНАЧЕ ИСТИНА
			|																			КОНЕЦ
			|																	ИНАЧЕ ИСТИНА
			|																КОНЕЦ
			|														КОНЕЦ
			|												КОНЕЦ
			|										КОНЕЦ
			|										ТОГДА ИСТИНА
			|									ИНАЧЕ ВЫБОР
			|											КОГДА КонтрагентыОчередиДоставки.Очередь В (&СписокОчередейДоставки)
			|												ТОГДА ВЫБОР
			|														КОГДА &НачинаемСобиратьНаЗавтра
			|															ТОГДА РАЗНОСТЬДАТ(&ТекущееВремя, ВЫБОР
			|																			КОГДА &ДеньНеделиЧисло = 6
			|																				ТОГДА ДокументыПредв.МаршрутДоставки.ВремяОкончанияВСубботу
			|																			ИНАЧЕ ДокументыПредв.МаршрутДоставки.ВремяОкончания
			|																		КОНЕЦ, МИНУТА) <= ДокументыПредв.ИнтервалДоОкончанияОчереди
			|																	И (ДокументыПредв.ВремяОтгрузки <= КонтрагентыОчередиДоставки.Очередь.ВремяОкончанияОтправки
			|																		ИЛИ ДокументыПредв.ЗаказПокупателя.ДатаОтгрузки < &ТекущаяДата)
			|														ИНАЧЕ РАЗНОСТЬДАТ(&ТекущееВремя, КонтрагентыОчередиДоставки.Очередь.ВремяОкончанияОтправки, МИНУТА) <= ДокументыПредв.ИнтервалДоОкончанияОчереди
			|													КОНЕЦ
			|											ИНАЧЕ РАЗНОСТЬДАТ(&ТекущееВремя, ВЫБОР
			|														КОГДА &ДеньНеделиЧисло = 6
			|															ТОГДА ДокументыПредв.МаршрутДоставки.ВремяОкончанияВСубботу
			|														ИНАЧЕ ДокументыПредв.МаршрутДоставки.ВремяОкончания
			|													КОНЕЦ, МИНУТА) <= ДокументыПредв.ИнтервалДоОкончанияОчереди
			|										КОНЕЦ
			|								КОНЕЦ
			|						ИНАЧЕ ИСТИНА
			|					КОНЕЦ
			|			ИНАЧЕ ЛОЖЬ
			|		КОНЕЦ
			|	И ВЫБОР
			|			КОГДА &ЭтоРегламент
			|					И &НачинаемСобиратьНаЗавтра
			|				ТОГДА (ДокументыПредв.МаршрутДоставки, КонтрагентыОчередиДоставки.Очередь) В
			|						(ВЫБРАТЬ
			|							Маршруты.МаршрутДоставки,
			|							Маршруты.Очередь
			|						ИЗ
			|							вт_Маршруты КАК Маршруты)
			|			ИНАЧЕ ИСТИНА
			|		КОНЕЦ
			|	И ВЫБОР
			|			КОГДА ДокументыПредв.Грузополучатель.ЗаказыватьТоварыДляХозДеятельностиФилиала
			//|					ИЛИ ДокументыПредв.Грузополучатель.ОбособленнаяОтгрузкаГМИзСтороннегоФилиала
			|					ИЛИ ДокументыПредв.ДоговорКонтрагента.Организация = &УправленческаяОрганизация
			|				ТОГДА ИСТИНА
			|			ИНАЧЕ НЕ(НЕ ДокументыПредв.ЗаказПокупателя.ДоговорКонтрагента.ЛицевойСчет
			|						И НЕ ДокументыПредв.ЗаказПокупателя.ДоговорКонтрагента.Подарки
			|						И НЕ ДокументыПредв.ЗаказПокупателя.ДоговорКонтрагента.РозничнаяПродажа
			|						И НЕ ДокументыПредв.ЗаказПокупателя.Контрагент.СтатусФНСКонтрагента = ЗНАЧЕНИЕ(Справочник.СтатусыФНСКонтрагента.КонтрагентЕстьВБазеФНС))
			|		КОНЕЦ
			//+Сёмин Р.И. 17.07.2026 #UT10-5955
			|	И НЕ ДокументыПредв.ЗаказПокупателя В
			|		(ВЫБРАТЬ
			|			ЗаказыСМаркировкойПоУпрОрганизации.ЗаказПокупателяМарк
