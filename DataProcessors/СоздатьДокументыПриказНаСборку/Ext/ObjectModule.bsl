	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	Запрос.УстановитьПараметр("НачалоСегодняшнегоДня", НачалоДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("ОкончаниеСегодняшнегоДня", КонецДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("КонтролироватьМинСуммуДоставки", КонтролироватьМинСуммуДоставки И ТипДоставки = Перечисления.СпособДоставки.НашаДоставка);
