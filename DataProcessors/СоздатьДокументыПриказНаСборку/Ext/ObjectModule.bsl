	ГУИД = Новый УникальныйИдентификатор();
	РезСсылка = Документы.СборкаЗаказовПокупателя.ПолучитьСсылку(ГУИД);
	Объект = РезСсылка.ПолучитьОбъект();
	ДокСборка = Документы.СборкаЗаказовПокупателя.СоздатьДокумент();
	
	Если Объект = Неопределено Тогда
		ДокСборка.УстановитьСсылкуНового(РезСсылка);
	КонецЕсли;
	
	Если Константы.ОтправкаНаСборкуБезПредоплатыДляСамовывоза.Получить() И ТекСтр.СпособДоставки = Перечисления.СпособДоставки.Самовывоз Тогда
		
		ДокСборка.ДокументСобранИУпакован = Истина; 
		ДокСборка.КоличествоУпаковочныхМест = 1;
		
	КонецЕсли;
	
	ДокСборка.Назначение = Назначение;
	ДокСборка.Контрагент 		   = ТекСтр.Контрагент;
	ДокСборка.Грузополучатель 	   = ТекСтр.Грузополучатель; 
	ДокСборка.Договор 			   = ТекСтр.ДоговорКонтрагента;
	ДокСборка.СпособДоставки 	   = ТекСтр.СпособДоставки;
	ДокСборка.МаршрутДоставки 	   = ?(ТекСтр.СпособДоставки = Перечисления.СпособДоставки.Самовывоз, Справочники.МаршрутыДоставки.ПустаяСсылка(), ДокСборка.Грузополучатель.МаршрутДоставки);	
	ДокСборка.Дата 				   = ТекущаяДата();
	ДокСборка.ВремяНачалаСборки    = ТекущаяДата();
	ДокСборка.ДатаДоставкиКлиенту  = ?(ЗначениеЗаполнено(ДатаОтгрузки), ДатаОтгрузки, ТекущаяДата());
	ДокСборка.Организация 		   = ТекСтр.ДоговорКонтрагента.Организация; 
	ДокСборка.УпаковыватьСамовывоз = мУпаковыватьСамовывоз;
	ДокСборка.ТаксиДоставка = мТаксиДоставка;  
	
	//+Пашкин О. 21.05.2025 #UT10-5188 
	Если ЗначениеЗаполнено(ДоговорПоставщикаТОХ) Тогда 
		ДокСборка.ДоговорПоставщикаТОХ = ДоговорПоставщикаТОХ;
	КонецЕсли;
	//-Пашкин О. 21.05.2025 #UT10-5188
	
	//+Белов А. 15.12.2025 #UT10-5582
	ДокСборка.ТребуетсяМаркировка = Маркировка;
	//-Белов А. 15.12.2025 #UT10-5582
	
	Возврат ДокСборка;
	
КонецФункции 

Функция ПроверитьИЗаписатьДокументСборки(ДокСборка, Принудительно, РежимПроведения, ЭтоРегламент) Экспорт

	Если ДокСборка.СпособДоставки = Перечисления.СпособДоставки.Самовывоз Тогда
		ДокСборка.ДатаДоставкиКлиенту = ТекущаяДата();
	Иначе
		
		КопияТЗ = ДокСборка.Заказано.Выгрузить(, "Заказ");
		КопияТЗ.Свернуть("Заказ");
		КопияТЗ.Колонки.Добавить("ДатаОтгрузки");
		
		Для Каждого СтрокаТЗДат Из КопияТЗ Цикл
			СтрокаТЗДат.ДатаОтгрузки = СтрокаТЗДат.Заказ.ДатаОтгрузки;
		КонецЦикла;				
		
		КопияТЗ.Сортировать("ДатаОтгрузки Возр");
		
		Если КопияТЗ.Количество()> 0 Тогда
			ДокСборка.ДатаДоставкиКлиенту = КопияТЗ[0].ДатаОтгрузки;
		КонецЕсли; 
		
		Если НЕ ЗначениеЗаполнено(ДокСборка.ДатаДоставкиКлиенту) Тогда 
			ДокСборка.ДатаДоставкиКлиенту = ТекущаяДата(); 
		КонецЕсли;
		
	КонецЕсли;
	
	ОтправлятьВБиллинг = Константы.AMQP_ВыгружатьДанные.Получить() И ДокСборка.Договор.ВыгружаетсяВБиллинг; 	
	ПроверятьЧерезБиллинг = Константы.AMQP_ПроверятьВзаиморасчетыЧерезБиллинг.Получить() И ДокСборка.Договор.КонтролироватьВзаиморасчетыЧерезСистемуБиллинг;  

	Если ОтправлятьВБиллинг Тогда
		
		СборкаУспешна = Ложь;
		Принудительно = НЕ ПроверятьЧерезБиллинг Или Принудительно;
		РезПроверка = AMQP_РаботаСДокументами.ПроверкаДокументаВБиллинге(ДокСборка, Принудительно);	

		Если РезПроверка.Результат = 0 Тогда
			
			Попытка
				
				ДокСборка.Записать(РежимПроведения); 
				
				// см. определение переменной ПредДоговор в модуле обеъекта документа СборкаЗаказовПокупателя
				ДокСборкаСсылка = ДокСборка.Ссылка;
				ДокСборка = ДокСборкаСсылка.ПолучитьОбъект();
				
				СоздатьГрузоместаДляСборкиПоОбособленнымОтгрузкам(ДокСборка);
				СборкаУспешна = Истина;
				
			Исключение
				
				Если ЭтоРегламент Тогда
					
					ОтправитьПисьмоСошибкой(ДокСборка, СокрЛП(ОписаниеОшибки()));
					ЗаписьЖурналаРегистрации("Создание сборок. Ошибка", УровеньЖурналаРегистрации.Предупреждение, , , 
					"Не удалось провести документ сборка: " + Строка(ДокСборка) + Символы.ПС + ОписаниеОшибки());
					
				КонецЕсли;
				
			КонецПопытки;

		ИначеЕсли РезПроверка.Результат = 2 И НЕ ПроверятьЧерезБиллинг Тогда

			Попытка
				
				ДокСборка.Записать(РежимПроведения); 
				СоздатьГрузоместаДляСборкиПоОбособленнымОтгрузкам(ДокСборка);
				СборкаУспешна = Истина;
				
			Исключение
				
				Если ЭтоРегламент Тогда
					ОтправитьПисьмоСошибкой(ДокСборка,РезПроверка.Сообщение); 
					ЗаписьЖурналаРегистрации("Создание сборок. Ошибка", УровеньЖурналаРегистрации.Предупреждение, , ,
					"Не удалось провести документ сборка: " + Строка(ДокСборка) + Символы.ПС + ОписаниеОшибки());
				КонецЕсли;
				
			КонецПопытки;	
			
		Иначе
			
			Если НЕ ЭтоРегламент Тогда
				Сообщить("Проверка сборки - "+РезПроверка.Сообщение); 
			Иначе
				ЗаписьЖурналаРегистрации("Создание сборок. Ошибка", УровеньЖурналаРегистрации.Предупреждение, , ,
				"Документ не прошел проверку в Биллинге ." + Символы.ПС + РезПроверка.Сообщение);
			КонецЕсли;
			
		КонецЕсли;
		
		Если СборкаУспешна Тогда
			
			РезПодтверждение = AMQP_РаботаСДокументами.ПодтверждениеДокументаВБиллинге(ДокСборка); 
			
			Если НЕ РезПодтверждение.Результат = 0 Тогда
				
				Попытка
					
					ДокСборка.УстановитьПометкуУдаления(Истина);					
					
					Если ЭтоРегламент Тогда
						
						ОтправитьПисьмоСошибкой(ДокСборка,РезПодтверждение.Сообщение);
						ЗаписьЖурналаРегистрации("Создание сборок. Ошибка", УровеньЖурналаРегистрации.Предупреждение, , ,
						"Не получено подтверждение от Биллинга , документ помечен на удаление: " + Строка(ДокСборка) + Символы.ПС + РезПодтверждение.Сообщение);
						
					Иначе
						Сообщить("Подтверждение сборки - "+РезПроверка.Сообщение);
					КонецЕсли;					
					
				Исключение		
				КонецПопытки;
				
			КонецЕсли;

		КонецЕсли;

	Иначе
		
		Попытка
			
			ДокСборка.Записать(РежимПроведения);  
			СоздатьГрузоместаДляСборкиПоОбособленнымОтгрузкам(ДокСборка);
			
		Исключение
			
			Если ЭтоРегламент Тогда
				ОтправитьПисьмоСошибкой(ДокСборка);
			КонецЕсли;
			
		КонецПопытки;		
		
	КонецЕсли;

	Если НЕ ЭтоРегламент И ЗначениеЗаполнено(ДокСборка.ВерсияДанных) Тогда
		Сообщить("Создан и проведен документ : " + ДокСборка);
	КонецЕсли;       

КонецФункции

Процедура СоздатьГрузоместаДляСборкиПоОбособленнымОтгрузкам(ДокСборка) 
		
	МассивГМ = Новый Массив;
	
	КопияЗаказано = ДокСборка.Заказано.Выгрузить(,"ГМ, Заказ"); 
	КопияЗаказано.Свернуть("ГМ, Заказ");  
	
	Для Каждого СтрЗаказано Из КопияЗаказано Цикл
		
		Если ЗначениеЗаполнено(СтрЗаказано.ГМ) Тогда
			МассивГМ.Добавить(Новый Структура("ГМ, Заказ", СтрЗаказано.ГМ, СтрЗаказано.Заказ));			
		КонецЕсли;	 
		
	КонецЦикла;
	
	Если МассивГМ.Количество() = 0 Тогда
		Возврат;		
	КонецЕсли;    
	
	ДатаСборкиИКомплектовки = ТекущаяДата();
	
	ДокСборка.ВремяНачалаКомплектации = ДатаСборкиИКомплектовки;
	ДокСборка.ВремяОкончанияКомплектации = ДатаСборкиИКомплектовки;      
	ДокСборка.Ответственный = Справочники.ФизическиеЛица.Автосборка;
	ДокСборка.Комплектовщик = Справочники.ФизическиеЛица.Автосборка;
	ДокСборка.ВремяОкончанияСборки = ДатаСборкиИКомплектовки;
	
	СоответствиеГМ = Новый Соответствие;
	
	Для каждого СтруктураГМ Из МассивГМ Цикл
		
		НовыйГМ = Документы.ГрузовоеМесто.СоздатьДокумент();
		НовыйГМ.Сборка = ДокСборка.Ссылка;
		НовыйГМ.ШКОбособленного = СтруктураГМ.ГМ;
		НовыйГМ.Дата = ТекущаяДата();    
		НовыйГМ.Ответственный = Справочники.ФизическиеЛица.Автосборка;
		
		ТаблицаТоваров = ПолучитьТоварыПоГМ(СтруктураГМ.ГМ, СтруктураГМ.Заказ); 
		
		Для Каждого СтрТовара Из ТаблицаТоваров Цикл
			
			НСтр = НовыйГМ.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НСтр, СтрТовара);
			
		КонецЦикла; 
		
		НовыйГМ.Записать(РежимЗаписиДокумента.Проведение);
		
		СоответствиеГМ.Вставить(СтруктураГМ.ГМ, НовыйГМ.Ссылка);
		
	КонецЦикла; 	
	          
	Для Каждого Стр Из ДокСборка.Заказано Цикл  
		
		Если Не ЗначениеЗаполнено(Стр.ГМ) Тогда
			Продолжить;			
		КонецЕсли;     
		
		СозданныйГМ = СоответствиеГМ.Получить(Стр.ГМ); 
		
		Если СозданныйГМ <> Неопределено Тогда
			Стр.ГрузовоеМесто = "Место " + ОбщегоНазначения.ПолучитьНомерНаПечать(СозданныйГМ,,,Истина);	
		КонецЕсли;
		
	КонецЦикла;  
	
	ДокСборка.КоличествоУпаковочныхМест = СоответствиеГМ.Количество(); 
	
	СборкаПолностьюСобрана = Истина;
	
	Для Каждого Стр Из ДокСборка.Заказано Цикл 
		
		Если Стр.Подборка <> Перечисления.ПодборкаНоменклатуры.Собрано Тогда
			СборкаПолностьюСобрана = Ложь;	
		КонецЕсли;
		
	КонецЦикла; 
	
	ДокСборка.ДокументСобранИУпакован = СборкаПолностьюСобрана;
	
	ДокСборка.Записать(РежимЗаписиДокумента.Проведение);
	
	МСК.ЗафиксироватьПечатьДокумента(ДокСборка.Ссылка, "Ячейки", "Номенклатура по ячейкам с корректировкой");		

КонецПроцедуры

Функция ПолучитьТоварыПоГМ(ГМ, Заказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПоступлениеТоваровУслугТовары.Номенклатура,
	|	ПоступлениеТоваровУслугТовары.Количество,
	|	ПоступлениеТоваровУслугТовары.Заказ
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.Товары КАК ПоступлениеТоваровУслугТовары
	|ГДЕ
	|	ПоступлениеТоваровУслугТовары.Заказ = &Заказ
	|	И ПоступлениеТоваровУслугТовары.ГМ = &ГМ
	|	И ПоступлениеТоваровУслугТовары.Ссылка.Проведен";
	
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("ГМ", ГМ);
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Возврат ТЗ;
	
КонецФункции

Функция ПроверитьСубботу(ПромДата)
	
	ЗапросПроверкиСубботы = Новый Запрос;
	ЗапросПроверкиСубботы.УстановитьПараметр("ДатаКалендаря",НачалоДня(ПромДата));
	ЗапросПроверкиСубботы.Текст = 
	"ВЫБРАТЬ
	|	РегламентированныйПроизводственныйКалендарь.ДатаКалендаря,
	|	РегламентированныйПроизводственныйКалендарь.ВидДня
	|ИЗ
	|	РегистрСведений.РегламентированныйПроизводственныйКалендарь КАК РегламентированныйПроизводственныйКалендарь
	|ГДЕ
	|	РегламентированныйПроизводственныйКалендарь.ДатаКалендаря = &ДатаКалендаря
	|	И НЕ РегламентированныйПроизводственныйКалендарь.ВидДня = ЗНАЧЕНИЕ(Перечисление.ВидыДнейПроизводственногоКалендаря.Суббота)"; 
	
	РезультатПроверкиСубботы = ЗапросПроверкиСубботы.Выполнить();
	
	Если РезультатПроверкиСубботы.Пустой() Тогда
		Возврат 6;	
	Иначе
		Возврат 1;
	КонецЕсли;

КонецФункции

