Перем  СозданоЗаказовМоих;



Процедура ПолучитьИмяСервераИИмяКаталогаОбмена(Знач ПолныйFTPАдрес, ИмяСервера, ИмяКаталога) Экспорт
	
	АдресОбмена = НормализоватьFTPАдрес(ПолныйFTPАдрес);
	
	// принцип получения адреса такой, все что до первой черты / или \ - это имя сервера, потом каталог
	АдресОбмена = СтрЗаменить(АдресОбмена, "\", "/");
	
	ПозицияПрямогоСлеша = Найти(АдресОбмена, "/");
	
	Если ПозицияПрямогоСлеша = 0 Тогда
		
		ИмяСервера = АдресОбмена;
		ИмяКаталога = "";
		
		
	Иначе
		
		ИмяСервера = Сред(АдресОбмена, 1, ПозицияПрямогоСлеша - 1);
		ИмяКаталога = Сред(АдресОбмена, ПозицияПрямогоСлеша);
		
		// последний должен быть слеш у имени каталога
		Если Сред(ИмяКаталога, СтрДлина(ИмяКаталога)) <> "/" Тогда
			ИмяКаталога = ИмяКаталога + "/";
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция УстановитьСоединениеСFTP(ИмяFTPСервера,ИмяКаталогаСервера) Экспорт
	
	ИмяКаталогаСервера = "";
	ИмяFTPСервера = "";
	
	// нужно по полному имени получить имя сервера и имя каталога
	ПолучитьИмяСервераИИмяКаталогаОбмена(НастройкаОбмена.FTPАдресОбмена, ИмяFTPСервера, ИмяКаталогаСервера);
	
	// если не задано имя сервера или каталога то невозможно обмениваться данными
	Если ПустаяСтрока(ИмяFTPСервера) Тогда
		
		ОписаниеОшибки = "Не задан сервер обмена информацией через FTP.";
		СоздатьЗаписьПротокола(ОписаниеОшибки,Перечисления.бит_ОперацияОбменаСПорталом.УстановкаСоединения);
		Возврат Ложь;
		
	КонецЕсли;
	
	// соединение
	Соединение = ВыполнитьFTPПодключениеКСерверу(ИмяFTPСервера, НастройкаОбмена);
	
	Если Соединение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// каталог проверяем
	НаличиеКаталога = ПроверитьНаличиеКаталогаНаFTPСервере(Соединение, ИмяКаталогаСервера);
	
	Если Не НаличиеКаталога Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	// Проверим подкаталог out
	НаличиеКаталога = ПроверитьНаличиеКаталогаНаFTPСервере(Соединение, ИмяКаталогаСервера + "/" + ИмяКаталогаФайлаДляМосквы + "/");
	
	Если Не НаличиеКаталога Тогда 
		
		Сообщить("Не найден каталог на FTP с именем " + ИмяКаталогаФайлаДляМосквы,СтатусСообщения.ОченьВажное);
		Возврат Ложь;
		
	КонецЕсли;
	
	// Проверим подкаталог in
	//НаличиеКаталога = ПроверитьНаличиеКаталогаНаFTPСервере(Соединение, ИмяКаталогаСервера+"/FromMoscwow_Vladimir/");
	//Если Не НаличиеКаталога Тогда 
	//	Возврат Ложь;
	//КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// функция выполняет FTP подключение к серверу
Функция ВыполнитьFTPПодключениеКСерверу(Знач ИмяFTPСервера, НастройкиОбмена)       
	
	#Если Клиент Тогда
		Состояние("Выполняется подключение к FTP: " + ИмяFTPСервера);
		СоздатьЗаписьПротокола("Выполняется подключение к FTP: " + ИмяFTPСервера, Перечисления.бит_ОперацияОбменаСПорталом.УстановкаСоединения, Ложь);
	#КонецЕсли
	
	Попытка
		
		Соединение = Новый FTPСоединение(ИмяFTPСервера, НастройкиОбмена.ПортFTPСоединения, 
		НастройкиОбмена.ПользовательFTPСоединения, НастройкиОбмена.ПарольFTPСоединения, , НастройкиОбмена.ПассивноеFTPСоединение);						
		
	Исключение
		
		// ошибка при подключении к ftp
		СоздатьЗаписьПротокола("Ошибка при подключении к FTP : " + ИмяFTPСервера + " ! " + ОписаниеОшибки(), Перечисления.бит_ОперацияОбменаСПорталом.УстановкаСоединения);
		Возврат Неопределено;
		
	КонецПопытки;
	
	СоздатьЗаписьПротокола("Соединение установлено: " + ИмяFTPСервера, Перечисления.бит_ОперацияОбменаСПорталом.УстановкаСоединения,Ложь);
	
	Возврат Соединение;
	
КонецФункции

// функция проверяет наличие катаога на FTP сервере
Функция ПроверитьНаличиеКаталогаНаFTPСервере(Соединение, Знач ИмяКаталогаСервера)
	
	Если ПустаяСтрока(ИмяКаталогаСервера) Тогда
		Возврат Истина;
	КонецЕсли;
	
	//надо сначала проверить что сам каталог доступа есть
	Попытка
		
		МассивНайденныхКаталогов = Соединение.НайтиФайлы(ИмяКаталогаСервера, "");
		
	Исключение
		
		// ошибка при подключении к ftp
		СоздатьЗаписьПротокола("Ошибка при соединении с FTP : " + ИмяКаталогаСервера + " ! " + ОписаниеОшибки(), Перечисления.бит_ОперацияОбменаСПорталом.УстановкаСоединения);
		Возврат Ложь;
		
	КонецПопытки;
	
	Для Каждого НайденныйКаталог Из МассивНайденныхКаталогов Цикл
		
		// если не каталог - то дальше ищем
		Если НЕ НайденныйКаталог.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;
		
		// большие и маленькие буквы считаются различными
		Если НайденныйКаталог.ПолноеИмя + "/" <> ИмяКаталогаСервера Тогда
			Продолжить;
		КонецЕсли;
		
		Возврат Истина;
		
	КонецЦикла;
	
	// если не найден каталог для обмена
	СоздатьЗаписьПротокола("Не найден FTP каталог обмена информацией: " + ИмяКаталогаСервера, Перечисления.бит_ОперацияОбменаСПорталом.УстановкаСоединения);
	
	Возврат Ложь;
	
КонецФункции

// функция нормализует ftp адрес (отрезает не нужное)
Функция НормализоватьFTPАдрес(Знач FTPАдрес) Экспорт
	
	ИтоговыйАдрес = СокрЛП(FTPАдрес);
	ПозицияFTP = Найти(Врег(ИтоговыйАдрес), "FTP://");
	
	Если ПозицияFTP = 1 Тогда
		
		ИтоговыйАдрес = Сред(ИтоговыйАдрес, 7);	
		
	КонецЕсли;
	
	Возврат ИтоговыйАдрес;
	
КонецФункции

Процедура СоздатьЗаписьПротокола(Описание, ОперацияОбменаСПорталом,ЭтоОшибка = Истина) Экспорт
	
	Если ЗначениеЗаполнено(Описание) Тогда
		
		Если ФормаОбработки <> Неопределено Тогда
			ФормаОбработки.ЭлементыФормы.ПолеПротокола.ДобавитьСтроку(Строка(ОперацияОбменаСПорталом) + ": " + Описание);
		КонецЕсли;
		
		Если НастройкаОбмена.СохранятьПротоколОбмена Тогда
			
			НомерСообщенияПротокола = НомерСообщенияПротокола + 1;
			МенеджерЗаписи = РегистрыСведений.бит_ПротоколОбмена.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.ИД_обмена = ИДТекущегоОбмена;
			МенеджерЗаписи.ОперацияОбмена = ОперацияОбменаСПорталом;
			МенеджерЗаписи.НомерСообщения = НомерСообщенияПротокола;
			МенеджерЗаписи.Ошибка = ЭтоОшибка;
			МенеджерЗаписи.Описание = Описание;
			МенеджерЗаписи.Дата = ДатаОбмена;
			МенеджерЗаписи.Записать();
			
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры

Процедура ЗаписатьФайлы(Файл, Входящий = Истина) Экспорт
	
	Попытка
		
		НомерФайла = НомерФайла + 1;
		МенеджерЗаписи = РегистрыСведений.бит_ФайлыОбмена.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ИД_обмена = ИДТекущегоОбмена;
		МенеджерЗаписи.ВходящиеИсходящие = Входящий;
		МенеджерЗаписи.НомерФайла = НомерФайла;
		МенеджерЗаписи.ИмяФайла = Файл.ИмяФайла;
		МенеджерЗаписи.Файл =  Новый ХранилищеЗначения(Новый ДвоичныеДанные(Файл.ПолноеИмяФайла), Новый СжатиеДанных);
		МенеджерЗаписи.ДатаОбмена = ДатаОбмена;
		МенеджерЗаписи.Записать();
		
	Исключение
		Сообщить("" + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры	

Процедура ВыполнитьОбмен(РежимРаботы) Экспорт
	
	Перем ИмяFTPСервера, ИмяКаталогаСервера;
	
	ВыгруженоЗаказов = 0;
	
	//Очистим таблицу заданий;
	ТаблицаОтветаПоЗаданиям.Очистить();
	ТаблицаОтработанныхДокументовКЗаказу = Неопределено;
	ТаблицаРазмещенияЗаказов = Неопределено;
	ТаблицаЗаданий100 = Неопределено;
	ТаблицаЗаданий103 = Неопределено;
	
	//Подключение к ftp
	ДатаОбмена = ТекущаяДата();
	ИДТекущегоОбмена = Новый УникальныйИдентификатор();
	НомерСообщенияПротокола = 0;
	НомерФайла = 0;
	
	ПроверитьНастройкиПодключения = УстановитьСоединениеСFTP(ИмяFTPСервера,ИмяКаталогаСервера);
	
	Если Не ПроверитьНастройкиПодключения Тогда
		Возврат;
	КонецЕсли; 
	
	// Здесь надо положить в каталог данные о текущих контрагентах и договорах!! (процедура описана в кнопке
	// формы списка справочника "Контрагенты"
	Текст = Новый ТекстовыйДокумент; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДоговорыКонтрагентов.Код КАК КодДоговора,
	               |	ДоговорыКонтрагентов.Наименование КАК НаименованиеДоговора,
	               |	ДоговорыКонтрагентов.Владелец.Код КАК КодКонтрагента,
	               |	ДоговорыКонтрагентов.Владелец.ИНН КАК ИНН,
	               |	ДоговорыКонтрагентов.Владелец.ИсточникКонтакта КАК ИсточникКонтакта,
	               |	ДоговорыКонтрагентов.Владелец.IDАварда КАК IDАварда,
	               |	ДоговорыКонтрагентов.Подарки,
	               |	ДоговорыКонтрагентов.Дата,
	               |	ДоговорыКонтрагентов.Номер,
	               |	ДоговорыКонтрагентов.СрокДействия
	               |ИЗ
	               |	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	               |ГДЕ
	               |	ДоговорыКонтрагентов.ПометкаУдаления = ЛОЖЬ
	               |	И ДоговорыКонтрагентов.ВидДоговора = &ВидДоговора
	               |	И ДоговорыКонтрагентов.Владелец.Ссылка = ДоговорыКонтрагентов.Владелец.ГоловнойКонтрагент
	               |	И ДоговорыКонтрагентов.Организация = &Организация";
	
	
	Запрос.УстановитьПараметр("ВидДоговора", Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
	Запрос.УстановитьПараметр("Организация", Константы.ОсновнаяОрганизация.Получить());
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если ПустаяСтрока(Выборка.ИНН) Тогда 
			Продолжить;
		КонецЕсли;
		
		КодДоговора = Выборка.КодДоговора;    
		НаименованиеДоговора = Выборка.НаименованиеДоговора;    
		КодКонтрагента = Выборка.КодКонтрагента;  
		ИНН = Выборка.ИНН;      
		Дата = Выборка.Дата;
		Номер = Выборка.Номер;
		СрокДействия = Выборка.СрокДействия;
		
		Текст.ДобавитьСтроку(СокрЛП(КодДоговора) + "@" + СокрЛП(НаименованиеДоговора) + "@" + Дата + "@" + Номер + "@" + СрокДействия + 
		"@" + СокрЛП(КодКонтрагента) + "@" + СокрЛП(ИНН) + "@" + СокрЛП(Выборка.ИсточникКонтакта) + "@" + СокрЛП(Выборка.IDАварда) + "@" + СокрЛП(Выборка.Подарки));
		
	КонецЦикла;
	
	ИмяВременногоКаталога = СокрЛП(Новый УникальныйИдентификатор);
	СоздатьКаталог(КаталогВременныхФайлов() + ИмяВременногоКаталога);
	ВременныйКаталог = КаталогВременныхФайлов() + ИмяВременногоКаталога + "\";
	Текст.Записать(ВременныйКаталог + "Sverka.txt");
	
	Если РежимРаботы = 1 Тогда
		
		Соединение.Записать(ВременныйКаталог + "Sverka.txt", ИмяКаталогаСервера + "/" + ИмяКаталогаФайлаДляМосквы + "/Sverka.txt");
		Возврат;
		
	Иначе      
		
		// Отправка по эл. почте
		
		УчетнаяЗапись = Константы.ОсновнаяУчетнаяЗаписьЭлектроннойПочты.Получить();
		
		Если НЕ Константы.НеОтправлятьПочту.Получить() И ЗначениеЗаполнено(УчетнаяЗапись) И Текст.КоличествоСтрок() > 0 Тогда 
			
			Профиль = УправлениеЭлектроннойПочтой.ПолучитьИнтернетПочтовыйПрофиль(УчетнаяЗапись);
			
			Сообщение = Новый ИнтернетПочтовоеСообщение;
			Сообщение.Тема = "Сверка контрагентов с Самарой";
			
			МылоКонтрагента = "";
			МылоКонтрагента = "buh@moskvorechie.ru";
			
			Почта = Новый ИнтернетПочта; 
			Почта.Подключиться(Профиль);
			
			Попытка
				Почта.Подключиться(Профиль);
			Исключение
				
				Сообщить("Не сумел подключиться к почтовому серверу!");
				Возврат;
				
			КонецПопытки;
			
			Сообщение.Получатели.Добавить(МылоКонтрагента);   
			Сообщение.Отправитель = УчетнаяЗапись.АдресЭлектроннойПочты;
			Сообщение.Вложения.Добавить(ВременныйКаталог + "Sverka.txt", ТипФайлаТабличногоДокумента.TXT);
			
			Почта.Послать(Сообщение);
			
			Сообщение.Получатели.Очистить();
			Сообщение.Вложения.Очистить();
			Почта.Отключиться();
			Сообщить("Сверка в Москву отослана",СтатусСообщения.Информация);
			
			Если Прав(ВременныйКаталог,1) = "\" Тогда
				ВременныйКаталог = Сред(ВременныйКаталог, 1, СтрДлина(ВременныйКаталог) - 1);
			КонецЕсли;			
			
			УдалитьФайлы(ВременныйКаталог);

		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	

КонецПроцедуры

Процедура СоздатьЗаказПоставщику(Постащик, Организация) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказыПокупателейОстатки.ЗаказПокупателя.Поставщик КАК Поставщик,
	|	ЗаказыПокупателейОстатки.ЗаказПокупателя КАК ЗаказПокупателя,
	|	ЗаказыПокупателейОстатки.Номенклатура КАК Номенклатура,
	|	ЗаказыПокупателейОстатки.КоличествоОстаток - ЕСТЬNULL(РазмещениеЗаказовПокупателейОстатки.КоличествоОстаток, 0) - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0) КАК Количество,
	|	ЕСТЬNULL(бит_СоставЗаказа.ЦенаПоставщика, 0) КАК ЦенаПоставщика
	|ИЗ
	|	РегистрНакопления.ЗаказыПокупателей.Остатки(
	|			,
	|			ЗаказПокупателя.Поставщик В (&Поставщик)
	|				И ЗаказПокупателя.Организация = &Организация) КАК ЗаказыПокупателейОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РазмещениеЗаказовПокупателей.Остатки(
	|				,
	|				ЗаказПоставщику.Контрагент В (&Поставщик)
	|					И ЗаказПокупателя.Организация = &Организация) КАК РазмещениеЗаказовПокупателейОстатки
	|		ПО ЗаказыПокупателейОстатки.ЗаказПокупателя = РазмещениеЗаказовПокупателейОстатки.ЗаказПокупателя
	|			И ЗаказыПокупателейОстатки.Номенклатура = РазмещениеЗаказовПокупателейОстатки.Номенклатура
	|			И ЗаказыПокупателейОстатки.ДоговорКонтрагента = РазмещениеЗаказовПокупателейОстатки.ЗаказПокупателя.ДоговорКонтрагента
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(
	|				,
	|				ДокументРезерва.Поставщик =&Поставщик
	|					И ДокументРезерва.Организация = &Организация) КАК ТоварыВРезервеНаСкладахОстатки
	|		ПО ЗаказыПокупателейОстатки.ЗаказПокупателя = ТоварыВРезервеНаСкладахОстатки.ДокументРезерва
	|			И ЗаказыПокупателейОстатки.Номенклатура = ТоварыВРезервеНаСкладахОстатки.Номенклатура
	|			И ЗаказыПокупателейОстатки.ДоговорКонтрагента = ТоварыВРезервеНаСкладахОстатки.ДокументРезерва.ДоговорКонтрагента
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СоставЗаказа КАК бит_СоставЗаказа
	|		ПО ЗаказыПокупателейОстатки.Номенклатура = бит_СоставЗаказа.Номенклатура
	|			И ЗаказыПокупателейОстатки.ЗаказПокупателя.Поставщик = бит_СоставЗаказа.Поставщик
	|			И ЗаказыПокупателейОстатки.ЗаказПокупателя = бит_СоставЗаказа.Заказ
	|ИТОГИ
	|	СУММА(Количество),
	|	МАКСИМУМ(ЦенаПоставщика)
	|ПО
	|	Поставщик,
	|	ЗаказПокупателя,
	|	Номенклатура";
	
	Запрос.УстановитьПараметр("Поставщик", Постащик);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Результат = Запрос.Выполнить();
	ВыборкаПоставщиков = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Если ВыборкаПоставщиков.Количество() > 0 Тогда
		
		Пока ВыборкаПоставщиков.Следующий() Цикл
			
			Если ВыборкаПоставщиков.Количество <= 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ЗаказПоставщику = Документы.ЗаказПоставщику.СоздатьДокумент();
			ЗаказПоставщику.Склад = Константы.ОсновнойСклад.Получить();		
			
			Если Не ЗначениеЗаполнено(ЗаказПоставщику.Склад) Тогда
				ЗаказПоставщику.Склад = Справочники.бит_НастройкиОбменаСПорталом.Москворечье.СкладПортала;	
			КонецЕсли;	
			
			ЗаказПоставщику.Дата = ТекущаяДата();
			
			ЗаказПоставщику.Контрагент = ВыборкаПоставщиков.Поставщик;
			ЗаказПоставщику.ДоговорКонтрагента = ЗаказПоставщику.Контрагент.ОсновнойДоговорКонтрагента;
			ЗаказПоставщику.Организация = Организация;
			
			ЗаказПоставщику.СтруктурнаяЕдиница = ВыборкаПоставщиков.Поставщик.ОсновнойБанковскийСчет;
			ЗаказПоставщику.СуммаВключаетНДС   = Истина;
			ЗаказПоставщику.УчитыватьНДС       = Истина;
			
			ЗаказПоставщику.ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
			ЗаказПоставщику.КратностьВзаиморасчетов = 1;
			ЗаказПоставщику.КурсВзаиморасчетов = 1;
			
			ВыборкаЗаказов = ВыборкаПоставщиков.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаЗаказов.Следующий() Цикл
				
				Если ВыборкаЗаказов.Количество <= 0 Тогда
					Продолжить;
				КонецЕсли;
				
				ВыборкаНоменклатуры = ВыборкаЗаказов.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				
				Пока ВыборкаНоменклатуры.Следующий()  Цикл
					
					Если ВыборкаНоменклатуры.Количество <= 0 Тогда
						Продолжить;
					КонецЕсли;
					
					НоваяСтрока = ЗаказПоставщику.Товары.Добавить();
					
					НоваяСтрока.Номенклатура = ВыборкаНоменклатуры.Номенклатура;
					
					//+Гавриленков В. 18.12.2025 #UT10-5598 Временное решение
					//НоваяСтрока.СтавкаНДС = ВыборкаНоменклатуры.Номенклатура.СтавкаНДС;
					НоваяСтрока.СтавкаНДС = УчетНДС.ПолучитьСтавкуНДСПоНоменклатуре(ВыборкаНоменклатуры.Номенклатура, ЗаказПоставщику.Дата);
					//-Гавриленков В. 18.12.2025 #UT10-5598
					НоваяСтрока.ЕдиницаИзмерения = ВыборкаНоменклатуры.Номенклатура.ЕдиницаХраненияОстатков;
					НоваяСтрока.Коэффициент = НоваяСтрока.ЕдиницаИзмерения.Коэффициент;
					НоваяСтрока.Цена = ВыборкаНоменклатуры.ЦенаПоставщика;
					
					Если ЗначениеЗаполнено(ВыборкаЗаказов.ЗаказПокупателя) Тогда
						НоваяСтрока.Заказ = ВыборкаЗаказов.ЗаказПокупателя;
					КонецЕсли;
					
					НоваяСтрока.Количество = ВыборкаНоменклатуры.Количество;
					
					ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(НоваяСтрока, ЗаказПоставщику);
					ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НоваяСтрока, ЗаказПоставщику);
					
				КонецЦикла;	
				
			КонецЦикла;	

			ЗаказПоставщику.Товары.Сортировать("Номенклатура");
			ЗаказПоставщику.СуммаДокумента = ЗаказПоставщику.Товары.Итог("Сумма");

			Попытка

				ЗаказПоставщику.Записать(РежимЗаписиДокумента.Проведение);
				ЗаказСозданИПроведен = Истина;

			Исключение					

				ЗаказПоставщику.Записать(РежимЗаписиДокумента.Запись);
				ЗаказСозданИПроведен = Ложь;
				
				Сообщить("Не удалось провести документ: " + ЗаказПоставщику);
			
			КонецПопытки;
			
			// Теперь надо этот документ послать в Смартэк
			Если ЗаказСозданИПроведен Тогда
				
				Фрм = Обработки.ПослатьЗаказПоставщику.ПолучитьФорму("Отчет");
				Фрм.ВнешнееОткрытие = Истина;
				Фрм.ЗаказПоставщику =ЗаказПоставщику.Ссылка;
				Фрм.ПослатьПоПочте = Истина;
				Фрм.Открыть();
			
			КонецЕсли;
		
		КонецЦикла;			
	
	КонецЕсли;
		
КонецПроцедуры

Функция ПолучитьТаблицуЗаданий(ИмяФайла) Экспорт
	
	//будем возвращать структуру заданий
	Таблица100 = Новый ТаблицаЗначений;
