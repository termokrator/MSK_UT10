	Таблица100.Колонки.Добавить("НомерСкладаПоставщика");
	Таблица100.Колонки.Добавить("IDКлиента");
	Таблица100.Колонки.Добавить("IDДоговора");
	Таблица100.Колонки.Добавить("НазваниеКлиента");
	Таблица100.Колонки.Добавить("НомерДоговора");
	Таблица100.Колонки.Добавить("ИНН");
	Таблица100.Колонки.Добавить("ВидОплаты");
	Таблица100.Колонки.Добавить("ТипРезерва");
	Таблица100.Колонки.Добавить("ОписаниеЗаказа");
	
	Таблица103 = Новый ТаблицаЗначений;
	Таблица103.Колонки.Добавить("НомерЗадания");
	Таблица103.Колонки.Добавить("КодЗадания");
	Таблица103.Колонки.Добавить("НомерЗаказа");	
	Таблица103.Колонки.Добавить("Действие");
	Таблица103.Колонки.Добавить("НомерНовогоЗаказа");
	
	Текст = Новый ЧтениеТекста(ИмяФайла,КодировкаТекста.ANSI);
	СтрокаТекст = Текст.Прочитать();
	ПозицияРазделителяСтроки = Найти(СтрокаТекст, "|#|");
	
	Если ПозицияРазделителяСтроки > 0 Тогда
		
		Стр = Сред(СтрокаТекст, 1, ПозицияРазделителяСтроки - 1);
		СтрокаТекст = Сред(СтрокаТекст,ПозицияРазделителяСтроки + 3, СтрДлина(СтрокаТекст));
		
	Иначе
		Стр = Неопределено;
	КонецЕсли;
	
	Пока Стр <> Неопределено Цикл
		
		МассивСтроки = РазобратьСтроку(Стр);
		
		Попытка
			
			Если МассивСтроки[2] = "100" Тогда
				
				НоваяСтрока = Таблица100.Добавить();
				НоваяСтрока.НомерЗадания = МассивСтроки[1]; 
				НоваяСтрока.КодЗадания = МассивСтроки[2];
				НоваяСтрока.НомерЗаказа = МассивСтроки[3]; 
				НоваяСтрока.ПримечаниеЗаказа = МассивСтроки[4];
				НоваяСтрока.НомерСкладаПоставщика = МассивСтроки[5];
				НоваяСтрока.IDКлиента = МассивСтроки[6];
				НоваяСтрока.IDДоговора = МассивСтроки[7];
				НоваяСтрока.НазваниеКлиента = МассивСтроки[8];
				НоваяСтрока.НомерДоговора = МассивСтроки[9];
				НоваяСтрока.ИНН = МассивСтроки[10];
				НоваяСтрока.ВидОплаты = МассивСтроки[11];
				НоваяСтрока.ТипРезерва = МассивСтроки[12];
				НоваяСтрока.ОписаниеЗаказа = МассивСтроки[14];
				
			ИначеЕсли МассивСтроки[2] = "103" Тогда
				
				НоваяСтрока = Таблица103.Добавить();
				НоваяСтрока.НомерЗадания = МассивСтроки[1]; 
				НоваяСтрока.КодЗадания = МассивСтроки[2];
				НоваяСтрока.НомерЗаказа = МассивСтроки[3]; 
				НоваяСтрока.Действие = МассивСтроки[4];
				НоваяСтрока.НомерНовогоЗаказа = МассивСтроки[5];	
				
			КонецЕсли;
			
			ПозицияРазделителяСтроки = Найти(СтрокаТекст, "|#|");
			
			Если ПозицияРазделителяСтроки > 0 Тогда
				
				Стр = Сред(СтрокаТекст, 1, ПозицияРазделителяСтроки - 1);
				СтрокаТекст = Сред(СтрокаТекст, ПозицияРазделителяСтроки + 3, СтрДлина(СтрокаТекст));
				
			Иначе
				Стр = Неопределено;
			КонецЕсли;
			
		Исключение
			
			Стр = Неопределено;
			Таблица100.Очистить();
			ОписаниеОшибки = "Не правильный формат файла 'task.dat'";
			Прервать;
			
		КонецПопытки;
		
	КонецЦикла;
	
	Задания = Новый Структура;
	Задания.Вставить("Таблица100", Таблица100);
	Задания.Вставить("Таблица103", Таблица103);
	
	Возврат Задания;
	
КонецФункции

