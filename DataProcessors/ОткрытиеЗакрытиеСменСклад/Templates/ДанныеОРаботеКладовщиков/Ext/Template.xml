		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗЛИЧНЫЕ
	УчетРабочегоВремени.Период,
	УчетРабочегоВремени.Сотрудник,
	УчетРабочегоВремени.СтатусСмены,
	КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(УчетРабочегоВремени.Период, ДЕНЬ, 2), ДЕНЬ) КАК ДатаЗакрытия
ПОМЕСТИТЬ ВТ_Открытия
ИЗ
	РегистрСведений.УчетРабочегоВремени КАК УчетРабочегоВремени
ГДЕ
	УчетРабочегоВремени.Период МЕЖДУ &amp;НачПериода И &amp;КонПериода
	И УчетРабочегоВремени.СтатусСмены = ЗНАЧЕНИЕ(Перечисление.СтатусыСмен.Открытие)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	УчетРабочегоВремени.Период,
	УчетРабочегоВремени.Сотрудник,
	УчетРабочегоВремени.СтатусСмены
ПОМЕСТИТЬ ВТ_Закрытия
ИЗ
	РегистрСведений.УчетРабочегоВремени КАК УчетРабочегоВремени
ГДЕ
	УчетРабочегоВремени.Период МЕЖДУ &amp;НачПериода И &amp;КонПериода
	И УчетРабочегоВремени.СтатусСмены = ЗНАЧЕНИЕ(Перечисление.СтатусыСмен.Закрытие)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	ВТ_Открытия.Сотрудник,
	ВТ_Открытия.Период КАК ПериодОткрытия,
	МИНИМУМ(ВТ_Закрытия.Период) КАК ПериодЗакрытие
ПОМЕСТИТЬ ВТ_ОткрытияЗакрытия
ИЗ
	ВТ_Открытия КАК ВТ_Открытия
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Закрытия КАК ВТ_Закрытия
		ПО ВТ_Открытия.Сотрудник = ВТ_Закрытия.Сотрудник
			И ВТ_Открытия.ДатаЗакрытия &gt;= ВТ_Закрытия.Период
			И ВТ_Открытия.Период &lt; ВТ_Закрытия.Период

СГРУППИРОВАТЬ ПО
	ВТ_Открытия.Период,
	ВТ_Открытия.Сотрудник,
	ВТ_Открытия.СтатусСмены
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ОткрытияЗакрытия.Сотрудник,
	ВТ_ОткрытияЗакрытия.ПериодОткрытия,
	ЕСТЬNULL(ВТ_ОткрытияЗакрытия.ПериодЗакрытие, &amp;ПустаяДата) КАК ПериодЗакрытия,
	ЕСТЬNULL(РАЗНОСТЬДАТ(ВТ_ОткрытияЗакрытия.ПериодОткрытия, ВТ_ОткрытияЗакрытия.ПериодЗакрытие, МИНУТА), 0) / 60 КАК ПродолжительностьСмены
ПОМЕСТИТЬ ВТ_Итог
ИЗ
	ВТ_ОткрытияЗакрытия КАК ВТ_ОткрытияЗакрытия
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_Итог.Сотрудник,
	НАЧАЛОПЕРИОДА(ВТ_Итог.ПериодОткрытия, ДЕНЬ) КАК ДатаСмены,
	ВТ_Итог.ПериодОткрытия КАК ДатаОткрытия,
	ВТ_Итог.ПериодЗакрытия КАК ДатаЗакрытия,
	ВТ_Итог.ПродолжительностьСмены КАК ОтработаноЧасов,
	ВЫБОР
		КОГДА ВТ_Итог.ПродолжительностьСмены &gt; 1
			ТОГДА ВТ_Итог.ПродолжительностьСмены - 1
		ИНАЧЕ ВТ_Итог.ПродолжительностьСмены
	КОНЕЦ КАК УчтеноЧасов,
	НАЧАЛОПЕРИОДА(ВТ_Итог.ПериодЗакрытия, ДЕНЬ) = НАЧАЛОПЕРИОДА(ВТ_Итог.ПериодОткрытия, ДЕНЬ) КАК ЗакрытиеДеньВДень
ИЗ
	ВТ_Итог КАК ВТ_Итог</query>
