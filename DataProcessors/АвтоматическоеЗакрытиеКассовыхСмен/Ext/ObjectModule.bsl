
Процедура РегламентноеВыполнение() Экспорт 
	ЗакрытьКассовыеСмены();	
КонецПроцедуры

Процедура ЗакрытьКассовыеСмены() Экспорт 
	
	ЗапросОткрытыхСмен = Новый Запрос;
	ЗапросОткрытыхСмен.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СтатусыКассСрезПоследних.Касса,
	|	СтатусыКассСрезПоследних.Период,
	|	СтатусыКассСрезПоследних.СтатусСмены
	|ПОМЕСТИТЬ ВТ_Срез
	|ИЗ
	|	РегистрСведений.СтатусыКасс.СрезПоследних(&ТекДата, ) КАК СтатусыКассСрезПоследних
	|ГДЕ
	|	СтатусыКассСрезПоследних.Касса.ОбновлятьСтатусКассыССервера
	|	И НЕ СтатусыКассСрезПоследних.Касса.ИД = """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Срез.Касса
	|ИЗ
	|	ВТ_Срез КАК ВТ_Срез
	|ГДЕ
	|	(ВТ_Срез.СтатусСмены = ""opened""
	|			ИЛИ ВТ_Срез.СтатусСмены = ""expired"")"; 
	
	ЗапросОткрытыхСмен.УстановитьПараметр("ТекДата",ТекущаяДата());
		
	РезультатЗапросаОткрытыхСмен = ЗапросОткрытыхСмен.Выполнить(); 
	
	Если НЕ РезультатЗапросаОткрытыхСмен.Пустой() Тогда
		
		ВыборкаОткрытыхСмен = РезультатЗапросаОткрытыхСмен.Выбрать();
		
		Пока ВыборкаОткрытыхСмен.Следующий() Цикл
			
			КассаЗапроса = ВыборкаОткрытыхСмен.Касса;
			
			Кассир = Чеки.ПолучитьПользователяЗакрытияОткрытияСмены(КассаЗапроса);
			
			Если НЕ ЗначениеЗаполнено(Кассир) Тогда
				Кассир = ПараметрыСеанса.ТекущийПользователь;
			КонецЕсли;
			
			СтруктураВозврата = Чеки.ОткрытьЗакрытьСмену(КассаЗапроса, Истина, Кассир);
			
			Если СтруктураВозврата.Результат Тогда
				ЗаписьЖурналаРегистрации("Автоматическое закрытие кассовой смены", УровеньЖурналаРегистрации.Информация, , ,
				"Смена по кассе "+СокрЛП(КассаЗапроса)+" успешно закрыта."); 			
			Иначе
				ЗаписьЖурналаРегистрации("Автоматическое закрытие кассовой смены", УровеньЖурналаРегистрации.Ошибка, , ,
				"При закрытии смены по кассе "+СокрЛП(КассаЗапроса)+" произошла ошибка "+ СтруктураВозврата.Сообщение);  			
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;	
	
КонецПроцедуры
