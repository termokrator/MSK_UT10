		НастройкаОбмена.ПользовательFTPСоединения, НастройкаОбмена.ПарольFTPСоединения, ,НастройкаОбмена.ПассивноеFTPСоединение);						
		//Соединение = Новый FTPСоединение(ИмяFTPСервера, "21", 
		//"Buh_Samara", "<e[_Cfvfhf@2013", ,Ложь);	
	Исключение
		
