	СтрокаТЗ.Имя = "120; нет на складе";
	
	СтрокаТЗ = СтатусТЗ.Добавить();
	СтрокаТЗ.Имя = "120; не отгружено";
	
	СтрокаТЗ = СтатусТЗ.Добавить();
	СтрокаТЗ.Имя = "130; аннулирован";
	
	СтрокаТЗ = СтатусТЗ.Добавить();
