Процедура ЗаполнитьСписокОтмененыхЗаказовПоставщика(РезультатЗапроса, Статус)
	
	НоваяСтрока = СписокОтмененыхЗаказовПоставщика.Добавить();
	НоваяСтрока.ЗаказПоставщика = РезультатЗапроса.ЗП_ЗаказПоставщикуСсылка;
	НоваяСтрока.Номенклатура = РезультатЗапроса.ЗП_Товары_Номенклатура;
	НоваяСтрока.КодСтроки 	= РезультатЗапроса.ВТ_КодСтроки;
	НоваяСтрока.Статус = Статус;

КонецПроцедуры
 
Функция ОписаниеОшибкиОбработкиДанных(МассивОшибок)
	
	ОписаниеДокумента = МассивОшибок[0] + МассивОшибок[1] + МассивОшибок[2] + МассивОшибок[3];
	Возврат ОписаниеДокумента;

КонецФункции

Процедура ПолучитьСтатусыИзСтороннейБазы(ДатаНачала, ДатаКонец, УТ11 = Ложь, ВидОперации = "", Склад = Неопределено) Экспорт 

	ОписаниеТиповСтрока = новый ОписаниеТипов("Строка", новый КвалификаторыСтроки(80, ДопустимаяДлина.Переменная));
	ОписаниеТиповДата = новый ОписаниеТипов("Дата", новый КвалификаторыДаты(ЧастиДаты.ДатаВремя));
	ОписаниеТиповЧисло = новый ОписаниеТипов("Число", новый Квалификаторычисла(12));
	ОписаниеТиповЗаказПоставщика = Новый ОписаниеТипов("ДокументСсылка.ЗаказПоставщику");		
	ОписаниеТиповНоменклатура = Новый ОписаниеТипов("СправочникСсылка.Номенклатура");
	ОписаниеТиповЗаказПокупателя = Новый ОписаниеТипов("ДокументСсылка.ЗаказПокупателя");		
	
	СписокЗаказов = Новый ТаблицаЗначений;		
	СписокЗаказов.Колонки.Добавить("ЗаказПоставщика", ОписаниеТиповЗаказПоставщика);
	СписокЗаказов.Колонки.Добавить("Номенклатура", ОписаниеТиповНоменклатура);
	СписокЗаказов.Колонки.Добавить("Количество", ОписаниеТиповЧисло);
	СписокЗаказов.Колонки.Добавить("КоличествоПоЗаказу", ОписаниеТиповЧисло);
	СписокЗаказов.Колонки.Добавить("Статус", ОписаниеТиповСтрока);
	СписокЗаказов.Колонки.Добавить("КодСтроки", ОписаниеТиповЧисло);
	СписокЗаказов.Колонки.Добавить("ЗаказПокупателя", ОписаниеТиповЗаказПокупателя);
	СписокЗаказов.Колонки.Добавить("ПлановаяДатаПоступления", ОписаниеТиповДата);
	СписокЗаказов.Колонки.Добавить("Назначение", ОписаниеТиповСтрока); 
	
	Если НЕ ЗначениеЗаполнено(ДатаНачала) Или Не ЗначениеЗаполнено(ДатаКонец) Тогда
		
		//+Гавриленков В. 22.08.2025 #UT10-5394  
		КоличествоДней = Справочники.МТ_ПредопределенныеЗначения.ПолучитьЗначениеПоСвойству(Справочники.МТ_ПредопределенныеЗначения.НастройкиКоличестваДней, "Количество дней для получения статусов заказов");
		ДатаНТ = НачалоДня(ТекущаяДата()) - (?(ЗначениеЗаполнено(КоличествоДней), КоличествоДней, 9) * 24 * 60 * 60);
		//ДатаНТ = НачалоДня(ТекущаяДата()) - 9*24*60*60;
		//-Гавриленков В. 22.08.2025 #UT10-5394
		ДатаКТ = КонецДня(ТекущаяДата());
		
	Иначе
		
		ДатаНТ = НачалоДня(ДатаНачала);
		ДатаКТ = КонецДня(ДатаКонец);
		
	КонецЕсли;
	
	Результат = МСКWEB.ПолучитьСтатусыИзСтороннейБазы(ДатаНТ, ДатаКТ, УТ11, ВидОперации,Склад); 
	
	//Обработка таблицы с ответом 
	Если НЕ Склад = Неопределено И ЗначениеЗаполнено(Склад.ДнейВПути) Тогда
		ДобавитьДнейКДатаПоступления = Склад.ДнейВПути;
	Иначе
		ДобавитьДнейКДатаПоступления = 0;	
	КонецЕсли; 

	Если Результат.Загружен Тогда
		
		СписокДанных = Результат.СписокДанных;
		
		Для Каждого Элем Из СписокДанных Цикл
			
			НовСтрока = СписокЗаказов.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока,Элем);

			Если УТ11 Тогда
				
				НовСтрока.Номенклатура = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", Элем.Артикул);				
				НовСтрока.ЗаказПоставщика = Документы.ЗаказПоставщику.НайтиПоРеквизиту("ГУИДЗаказаПокупателя", Элем.Заказ);
				
			Иначе
				
				НовСтрока.Номенклатура = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", Элем.Артикул); 
				НовСтрока.ЗаказПоставщика = Документы.ЗаказПоставщику.НайтиПоРеквизиту("ГУИДЗаказаПокупателя", Элем.ЗаказПокупателя);
				
			КонецЕсли;

		КонецЦикла;
		
	Иначе
		Возврат;
	КонецЕсли;
			
	СписокОтмененыхЗаказовПоставщика = Новый ТаблицаЗначений;		
	СписокОтмененыхЗаказовПоставщика.Колонки.Добавить("ЗаказПоставщика", ОписаниеТиповЗаказПоставщика);
	СписокОтмененыхЗаказовПоставщика.Колонки.Добавить("Номенклатура", ОписаниеТиповНоменклатура);
	СписокОтмененыхЗаказовПоставщика.Колонки.Добавить("КодСтроки", ОписаниеТиповЧисло);
	СписокОтмененыхЗаказовПоставщика.Колонки.Добавить("Статус", ОписаниеТиповСтрока);
			
	ЗаказПоставщикаТекущий = Неопределено;
	ТзЗаказов = СписокЗаказов.Скопировать();
	ТзЗаказов.Очистить();
	
	//Установка кодов строк по фифо для пришедших статусов товаров и лифо для отказов
	Для Каждого СтрЗаказов Из СписокЗаказов Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрЗаказов.ЗаказПоставщика) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ВидОперации = "СторонниеСклады" И СтрЗаказов.ЗаказПоставщика.IDСклада.ОтправлятьЗаказыПоСкладуВУТ11 = Ложь Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗаказПоставщикаТекущий <> СтрЗаказов.ЗаказПоставщика Тогда
			ЗаказПоставщикаТекущий = СтрЗаказов.ЗаказПоставщика;			
		КонецЕсли;
										
		Отбор = Новый Структура();
		Отбор.Вставить("Номенклатура", СтрЗаказов.Номенклатура);		
		
		Если ЗначениеЗаполнено(СтрЗаказов.Назначение) Тогда
			
			ТекНазнач = СтрЗаменить(СокрЛП(СтрЗаказов.Назначение), "/", Символы.ПС);			
			НомерЗаказа = СтрПолучитьСтроку(ТекНазнач, 2);
			ДатаЗаказа = СтрЗаменить(СтрПолучитьСтроку(ТекНазнач, 3), ".", Символы.ПС);
			
			Попытка
				ДатаЗаказа = Дата(СтрПолучитьСтроку(ДатаЗаказа, 3) + СтрПолучитьСтроку(ДатаЗаказа, 2) + СтрПолучитьСтроку(ДатаЗаказа, 1));
			Исключение
				ДатаЗаказа = Дата(1,1,1);
			КонецПопытки;			
			
			ТекЗаказПокупателя = Документы.ЗаказПокупателя.НайтиПоНомеру(НомерЗаказа, ДатаЗаказа); 
			
			Если ЗначениеЗаполнено(ТекЗаказПокупателя) Тогда
				Отбор.Вставить("Заказ", ТекЗаказПокупателя);
			КонецЕсли;			
			
		КонецЕсли;		
		
		Рез = ЗаказПоставщикаТекущий.Товары.НайтиСтроки(Отбор);
		
		Сч = ?(СтрЗаказов.Статус <> "120; нет на складе", 0, Рез.Количество()-1);
		Граница = ?(СтрЗаказов.Статус <> "120; нет на складе", Рез.Количество(), -1);
		
		Пока Сч <> Граница Цикл 
			
			СтрРез = Рез[Сч];			
			КолвоРаспределить = СтрЗаказов.Количество; 
			КолвоПоСтроке = СтрРез.Количество;
			
			Если Не ЗначениеЗаполнено(СтрЗаказов.Назначение) И (ЗначениеЗаполнено(СтрРез.Заказ)
				И ТипЗнч(СтрРез.Заказ) = Тип("ДокументСсылка.ЗаказПокупателя") И СтрРез.Заказ.ОбособленнаяОтгрузкаГМИзСтороннегоФилиала) Тогда
				
				Сч = ?(СтрЗаказов.Статус <> "120; нет на складе", Сч+1, Сч-1);
				Продолжить;
				
			КонецЕсли;			
			
			//Минусуем уже распределенное колво по статусу
			ОтборТаб = Новый Структура();
			ОтборТаб.Вставить("Номенклатура", СтрРез.Номенклатура);			
			ОтборТаб.Вставить("Статус", СтрЗаказов.Статус);
			ОтборТаб.Вставить("ЗаказПоставщика", СтрЗаказов.ЗаказПоставщика);
			ОтборТаб.Вставить("Назначение", СтрЗаказов.Назначение); 			
			
			СтрокиТаб = ТзЗаказов.НайтиСтроки(ОтборТаб);
			
			Для Каждого СтрТаб Из СтрокиТаб Цикл
				КолвоРаспределить = КолвоРаспределить - СтрТаб.Количество;				
			КонецЦикла;
			
			Если СтрЗаказов.Статус <> "120; нет на складе" Тогда
				
				//Минусуем уже распределенное колво по коду строки
				ОтборТаб = Новый Структура();
				ОтборТаб.Вставить("Номенклатура", СтрРез.Номенклатура);
				ОтборТаб.Вставить("КодСтроки" ,СтрРез.УИД);			
				ОтборТаб.Вставить("ЗаказПоставщика", СтрЗаказов.ЗаказПоставщика);
				СтрокиТаб = ТзЗаказов.НайтиСтроки(ОтборТаб);
				
				Для Каждого СтрТаб Из СтрокиТаб Цикл
					КолвоПоСтроке = КолвоПоСтроке - СтрТаб.Количество;				
				КонецЦикла;
				
			КонецЕсли;
			
			Если КолвоРаспределить <= 0 Или КолвоПоСтроке <= 0 Тогда
				
				Сч = ?(СтрЗаказов.Статус <> "120; нет на складе", Сч+1, Сч-1);
				Продолжить;
				
			КонецЕсли;
			
			НовСтр = ТзЗаказов.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр, СтрЗаказов);
			НовСтр.КодСтроки = СтрРез.УИД;
			НовСтр.КоличествоПоЗаказу = СтрРез.Количество;
			НовСтр.ЗаказПокупателя = СтрРез.Заказ;
			НовСтр.Количество = Мин(КолвоРаспределить, КолвоПоСтроке, СтрРез.Количество);
									
			Сч = ?(СтрЗаказов.Статус <> "120; нет на складе", Сч+1, Сч-1);
			
		КонецЦикла;
								
	КонецЦикла;
	
	СписокЗаказов.Очистить();
	
	Запрос = Новый Запрос;	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТЗ.ЗаказПоставщика,
	               |	ТЗ.Номенклатура,
	               |	ВЫБОР
	               |		КОГДА ТЗ.Статус = ""120; нет на складе""
	               |			ТОГДА 0
	               |		ИНАЧЕ ТЗ.Количество
	               |	КОНЕЦ КАК Количество,
	               |	ТЗ.КоличествоПоЗаказу,
	               |	ТЗ.Статус,
	               |	ТЗ.КодСтроки,
	               |	ТЗ.ЗаказПокупателя,
	               |	ТЗ.ПлановаяДатаПоступления,
	               |	ТЗ.Назначение
	               |ПОМЕСТИТЬ ВТ
	               |ИЗ
	               |	&ТЗ КАК ТЗ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ.ЗаказПоставщика,
	               |	ВТ.Номенклатура,
	               |	ВТ.Количество,
	               |	ВТ.КоличествоПоЗаказу,
	               |	ВТ.Статус,
	               |	ВТ.КодСтроки,
	               |	ВТ.ЗаказПокупателя,
	               |	-1 * ЕСТЬNULL(ВложенныйЗапрос.Количество, 0) КАК КоличествоКорЗакПост,
	               |	ВТ.ПлановаяДатаПоступления,
	               |	ВТ.Назначение
	               |ПОМЕСТИТЬ ВТСписокЗП
	               |ИЗ
	               |	ВТ КАК ВТ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			КорректировкаЗаказаПоставщику.ЗаказПоставщику КАК ЗаказПоставщику,
	               |			КорректировкаЗаказаПоставщикуТовары.Номенклатура КАК Номенклатура,
	               |			СУММА(КорректировкаЗаказаПоставщикуТовары.Количество) КАК Количество
	               |		ИЗ
	               |			Документ.КорректировкаЗаказаПоставщику.Товары КАК КорректировкаЗаказаПоставщикуТовары
	               |				ЛЕВОЕ СОЕДИНЕНИЕ Документ.КорректировкаЗаказаПоставщику КАК КорректировкаЗаказаПоставщику
	               |				ПО КорректировкаЗаказаПоставщикуТовары.Ссылка = КорректировкаЗаказаПоставщику.Ссылка
	               |		ГДЕ
	               |			КорректировкаЗаказаПоставщику.ПометкаУдаления = ЛОЖЬ
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			КорректировкаЗаказаПоставщику.ЗаказПоставщику,
	               |			КорректировкаЗаказаПоставщикуТовары.Номенклатура) КАК ВложенныйЗапрос
	               |		ПО ВТ.ЗаказПоставщика = ВложенныйЗапрос.ЗаказПоставщику
	               |			И ВТ.Номенклатура = ВложенныйЗапрос.Номенклатура
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТСписокЗП.ЗаказПоставщика КАК ЗП_ЗаказПоставщикуСсылка,
	               |	ВТСписокЗП.Номенклатура КАК ЗП_Товары_Номенклатура,
	               |	ВТСписокЗП.Количество КАК ВТ_Количество,
	               |	ВТСписокЗП.КоличествоПоЗаказу КАК ЗП_Товары_Количество,
	               |	ВТСписокЗП.Статус КАК ВТ_Статус,
	               |	ВТСписокЗП.КодСтроки КАК ВТ_КодСтроки,
	               |	ВТСписокЗП.ЗаказПокупателя КАК ЗП_Товары_ЗаказПокупателя,
	               |	ВТСписокЗП.КоличествоКорЗакПост,
	               |	ЕСТЬNULL(ЗаказыПоставщикамОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток,
	               |	ВТСписокЗП.ПлановаяДатаПоступления,
	               |	ВТСписокЗП.Назначение
	               |ИЗ
	               |	ВТСписокЗП КАК ВТСписокЗП
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыПоставщикам.Остатки(
	               |				,
	               |				(ЗаказПоставщику, Номенклатура) В
	               |					(ВЫБРАТЬ
	               |						ВТСписокЗП.ЗаказПоставщика,
	               |						ВТСписокЗП.Номенклатура
	               |					ИЗ
	               |						ВТСписокЗП КАК ВТСписокЗП)) КАК ЗаказыПоставщикамОстатки
	               |		ПО ВТСписокЗП.ЗаказПоставщика = ЗаказыПоставщикамОстатки.ЗаказПоставщику
	               |			И ВТСписокЗП.Номенклатура = ЗаказыПоставщикамОстатки.Номенклатура
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЗП_ЗаказПоставщикуСсылка,
	               |	ЗП_Товары_Номенклатура";	
	
	Запрос.УстановитьПараметр("ТЗ", ТзЗаказов);
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	СтатусТЗ = СписокОтмененыхСтатусов();
	ЗаказаПоставщикаТекущий = Неопределено;
	НоменклатураТекущий = Неопределено;
	КодСтрокиТекущий = Неопределено;
	ОписаниеДокумента = "";
	
	СписокЗПДляКорректировкиДаты = Новый ТаблицаЗначений;		
	СписокЗПДляКорректировкиДаты.Колонки.Добавить("ЗаказПокупателя", ОписаниеТиповЗаказПокупателя);
	СписокЗПДляКорректировкиДаты.Колонки.Добавить("ПлановаяДатаПоступления", ОписаниеТиповДата);
	
	//Запись таблицы в регистр
	Пока РезультатЗапроса.Следующий() Цикл	
			
		Если ЗначениеЗаполнено(ОписаниеДокумента) Тогда
			
			ОшибкаЗагрузки("", "Невозможно создать документы. " + ОписаниеДокумента);				
			ОписаниеДокумента = "";
			
		КонецЕсли; 
		
		Если НЕ ЗначениеЗаполнено(РезультатЗапроса.ЗП_ЗаказПоставщикуСсылка) Или РезультатЗапроса.ВТ_КодСтроки = Неопределено Тогда
			Продолжить;
		КонецЕсли; 
		
		КорректировкаЗаказаПоставщика = Документы.КорректировкаЗаказаПоставщику.ПустаяСсылка();
		КорректировкаЗаказаПокупателя = Документы.КорректировкаЗаказаПокупателя.ПустаяСсылка();
		
		Если ЗаказаПоставщикаТекущий <> РезультатЗапроса.ЗП_ЗаказПоставщикуСсылка Тогда
						
			НаборЗаписейИстория = РегистрыСведений.ИсторияХраненияИзмененийЗагружСтатусов.СоздатьНаборЗаписей();
			// Очищаем определенный набор записей
			НаборЗаписейИстория.Отбор.Документ.Установить(РезультатЗапроса.ЗП_ЗаказПоставщикуСсылка);			
			НаборЗаписейИстория.Прочитать();
			НаборЗаписейИстория.Очистить();												                  
			НаборЗаписейИстория.Записать(Истина);			
			
		КонецЕсли; 			
		
		Если ЗаказаПоставщикаТекущий <> РезультатЗапроса.ЗП_ЗаказПоставщикуСсылка ИЛИ
			НоменклатураТекущий <>  РезультатЗапроса.ЗП_Товары_Номенклатура Тогда
			
			ЗаказаПоставщикаТекущий = РезультатЗапроса.ЗП_ЗаказПоставщикуСсылка;
			НоменклатураТекущий = РезультатЗапроса.ЗП_Товары_Номенклатура;

		КонецЕсли; 
		
		МенеджерЗаписейИстория = РегистрыСведений.ИсторияХраненияИзмененийЗагружСтатусов.СоздатьМенеджерЗаписи();
		
		МенеджерЗаписейИстория.Документ     = РезультатЗапроса.ЗП_ЗаказПоставщикуСсылка;
		МенеджерЗаписейИстория.Номенклатура = РезультатЗапроса.ЗП_Товары_Номенклатура;
		МенеджерЗаписейИстория.КодСтроки 	= РезультатЗапроса.ВТ_КодСтроки;
		МенеджерЗаписейИстория.Статус 		= РезультатЗапроса.ВТ_Статус;
		
		МенеджерЗаписейИстория.КоличествоAvarda 		     = РезультатЗапроса.ВТ_Количество;
		МенеджерЗаписейИстория.КоличествоЗаказПоставщика     = РезультатЗапроса.ЗП_Товары_Количество;
		МенеджерЗаписейИстория.КоличествоКорЗаказаПоставщика = РезультатЗапроса.КоличествоКорЗакПост;
		МенеджерЗаписейИстория.КоличествоОстатокПоСкладу     = РезультатЗапроса.КоличествоОстаток;
		МенеджерЗаписейИстория.ЗаказПокупателя               = РезультатЗапроса.ЗП_Товары_ЗаказПокупателя;
		МенеджерЗаписейИстория.ДатаЗагрузки					 = ТекущаяДата();		
		МенеджерЗаписейИстория.Назначение					 = РезультатЗапроса.Назначение; 
		
		МенеджерЗаписейИстория.ПлановаяДатаПоступленияНаСкладФилиала = РезультатЗапроса.ПлановаяДатаПоступления;		
		
		Если ЗначениеЗаполнено(РезультатЗапроса.ПлановаяДатаПоступления) И ЗначениеЗаполнено(РезультатЗапроса.ЗП_Товары_ЗаказПокупателя) Тогда

			ПромДатаЗаказа = РезультатЗапроса.ЗП_Товары_ЗаказПокупателя.ДатаОтгрузки;  
			
			//+Гавриленков В. 18.03.2026 #UT10-5773
			////+Гавриленков В. 11.06.2025 #UT10-5279
			////ПромДатаЗаказаСПортала = ?(ЗначениеЗаполнено(РезультатЗапроса.ЗП_Товары_ЗаказПокупателя.ДатаОтгрузкиСПортала), 
			////                     РезультатЗапроса.ЗП_Товары_ЗаказПокупателя.ДатаОтгрузкиСПортала,
			////					 РезультатЗапроса.ЗП_Товары_ЗаказПокупателя.ДатаОтгрузки); 
			////-Гавриленков В. 11.06.2025 #UT10-5279

			//Если НЕ Склад = Неопределено Тогда
			//	
			//	Если НЕ ДобавитьДнейКДатаПоступления = 0 Тогда
			//		ПромДатаДоставки = НачалоДня(РезультатЗапроса.ПлановаяДатаПоступления) + 86400*ДобавитьДнейКДатаПоступления; 
			//	Иначе
			//		ПромДатаДоставки = Дата(1,1,1);
			//	КонецЕсли;
			//	
			//Иначе
			//	ПромДатаДоставки = РезультатЗапроса.ПлановаяДатаПоступления;   
			//КонецЕсли;   
			//
			////+Гавриленков В. 11.06.2025 #UT10-5279
			////Если НачалоДня(ПромДатаДоставки) >= НачалоДня(ПромДатаЗаказаСПортала) Тогда  
			////	
			////	ПредполагаемаяДатаОтгрузки = НачалоДня(ПромДатаДоставки) + 3600; 
			////	
			////	Если ПредполагаемаяДатаОтгрузки = ПромДатаЗаказа Тогда					
			////		ПромДатаДоставки = Дата(1,1,1); 
			////	Иначе
			////		ПромДатаДоставки = ПредполагаемаяДатаОтгрузки;
			////	КонецЕсли;
			////	
			////Иначе  						

			////	Если ЗначениеЗаполнено(РезультатЗапроса.ЗП_Товары_ЗаказПокупателя.IDСклада_СтороннийСклад) Тогда 
			////		
			////		Если ПромДатаЗаказа > ПромДатаЗаказаСПортала Тогда
			////			ПромДатаДоставки = ПромДатаЗаказаСПортала;
			////		КонецЕсли;					
			////		
			////	Иначе
			////		ПромДатаДоставки = Дата(1,1,1);	
			////	КонецЕсли;

			////КонецЕсли; 
			//			
			//Если НачалоДня(ПромДатаДоставки) > НачалоДня(ПромДатаЗаказа) Тогда 				
			//	ПромДатаДоставки = НачалоДня(ПромДатаДоставки) + 3600;
			//Иначе
			//	ПромДатаДоставки = Дата(1,1,1);
			//КонецЕсли; 
			////-Гавриленков В. 11.06.2025 #UT10-5279 
			
			ПромДатаЗаказаСПортала = ?(ЗначениеЗаполнено(РезультатЗапроса.ЗП_Товары_ЗаказПокупателя.ДатаОтгрузкиСПортала), 
			                     РезультатЗапроса.ЗП_Товары_ЗаказПокупателя.ДатаОтгрузкиСПортала,
								 РезультатЗапроса.ЗП_Товары_ЗаказПокупателя.ДатаОтгрузки); 

			Если НЕ Склад = Неопределено Тогда
				
				Если НЕ ДобавитьДнейКДатаПоступления = 0 Тогда
					ПромДатаДоставки = НачалоДня(РезультатЗапроса.ПлановаяДатаПоступления) + 86400*ДобавитьДнейКДатаПоступления; 
				Иначе
					ПромДатаДоставки = Дата(1,1,1);
				КонецЕсли;
				
			Иначе
				ПромДатаДоставки = РезультатЗапроса.ПлановаяДатаПоступления;   
			КонецЕсли;   
			
			Если НачалоДня(ПромДатаДоставки) >= НачалоДня(ПромДатаЗаказаСПортала) Тогда  
				
				//+Гавриленков В. 08.05.2026 #UT10-5849
				//ПредполагаемаяДатаОтгрузки = НачалоДня(ПромДатаДоставки) + 3600;
				ПредполагаемаяДатаОтгрузки = Макс(НачалоДня(ПромДатаДоставки) + 3600, ПромДатаЗаказаСПортала);
				//-Гавриленков В. 08.05.2026 #UT10-5849
				
				Если ПредполагаемаяДатаОтгрузки = ПромДатаЗаказа Тогда					
					ПромДатаДоставки = Дата(1,1,1); 
				Иначе
					ПромДатаДоставки = ПредполагаемаяДатаОтгрузки;
				КонецЕсли;
				
			Иначе  						
					
				Если ПромДатаЗаказа = ПромДатаЗаказаСПортала Тогда
					ПромДатаДоставки = Дата(1,1,1);
				Иначе
					ПромДатаДоставки = ПромДатаЗаказаСПортала;
				КонецЕсли;					
					
			КонецЕсли;  
			//-Гавриленков В. 18.03.2026 #UT10-5773
			
			Если НЕ ПромДатаДоставки = Дата(1,1,1) Тогда 
				
				СтрЗаказа = СписокЗПДляКорректировкиДаты.Добавить();
				СтрЗаказа.ЗаказПокупателя = РезультатЗапроса.ЗП_Товары_ЗаказПокупателя; 
				СтрЗаказа.ПлановаяДатаПоступления = ПромДатаДоставки;
				
			КонецЕсли;
			
		КонецЕсли;

		// Создаем корректировку ЗаказаПоставщика, корректировку заказа покупателя.
		Если СтатусТЗ.Найти(РезультатЗапроса.ВТ_Статус, "Имя") <> Неопределено  Тогда
			
			Если (РезультатЗапроса.КоличествоОстаток = 0) Или (РезультатЗапроса.ВТ_Статус = "120; нет на складе") Тогда
				
				МенеджерЗаписейИстория.Записать();					
				
				Если РезультатЗапроса.ВТ_Статус = "120; нет на складе" Тогда
					ЗаполнитьСписокОтмененыхЗаказовПоставщика(РезультатЗапроса, "120; нет на складе");	
				КонецЕсли; 
				
				Продолжить;					
				
			КонецЕсли; 
			
			Если РезультатЗапроса.КоличествоКорЗакПост < РезультатЗапроса.ВТ_Количество И РезультатЗапроса.ВТ_Количество > 0  Тогда					
				
				КоличествоКорректировки = РезультатЗапроса.ВТ_Количество - РезультатЗапроса.КоличествоКорЗакПост;
				
				МассивОшибок = Новый Массив;
				
				МассивОшибок.Добавить("Заказ поставщика:" +РезультатЗапроса.ЗП_ЗаказПоставщикуСсылка.Номер + " "  + Строка(РезультатЗапроса.ЗП_ЗаказПоставщикуСсылка.Дата) + " ; ");
				МассивОшибок.Добавить("Номенклатура: " + РезультатЗапроса.ЗП_Товары_Номенклатура.Код + " " + РезультатЗапроса.ЗП_Товары_Номенклатура.Наименование + " ; ");
				МассивОшибок.Добавить("Код строки: " + РезультатЗапроса.ВТ_КодСтроки + " ; ");
				МассивОшибок.Добавить("Статус: " + РезультатЗапроса.ВТ_Статус + " ; ");
				
				МенеджерЗаписейИстория.Записать();												
				
				Попытка
					//////
					//НачатьТранзакцию();																		
					
					СоздатьКорректировкуЗаказаПоставщика(РезультатЗапроса, КоличествоКорректировки);																		
					
					//ЗафиксироватьТранзакцию();										
					
					МенеджерЗаписейИстория.КоличествоДопКорЗаказаПоставщика = КоличествоКорректировки;												
					МенеджерЗаписейИстория.КорректировкаЗаказаПоставщика = КорректировкаЗаказаПоставщика;
					МенеджерЗаписейИстория.КорректировкаЗаказаПокупателя = КорректировкаЗаказаПокупателя;						
					МенеджерЗаписейИстория.Записать();												
					
					Продолжить;
					
				Исключение
					
					//ОтменитьТранзакцию();	
					ОписаниеДокумента = ОписаниеОшибкиОбработкиДанных(МассивОшибок);
					Ошибка = ИнформацияОбОшибке();
					ОписаниеДокумента = ОписаниеДокумента + "; " + Ошибка.Причина.Описание; 
					Продолжить;
					
				КонецПопытки; 
				
			КонецЕсли; 	
			
		Иначе
			
			МенеджерЗаписейИстория.Записать();
			Продолжить;
			
		КонецЕсли; 
		
	КонецЦикла;					
	                                                
	ОбработатьСтатус120НетНаскладе(СтатусТЗ);
	
	Если НЕ СписокЗПДляКорректировкиДаты.Количество() = 0 Тогда
		КорректировкаДатыОтгрузкиВЗаказахПокупателя(СписокЗПДляКорректировкиДаты); 	
	КонецЕсли;    

КонецПроцедуры

Процедура КорректировкаДатыОтгрузкиВЗаказахПокупателя(СписокЗПДляКорректировкиДаты)

	Если СписокЗПДляКорректировкиДаты.Количество() = 0 Тогда 
		Возврат;
	КонецЕсли;	
	
	СписокЗПДляКорректировкиДаты.Свернуть("ЗаказПокупателя, ПлановаяДатаПоступления");
	СписокЗПДляКорректировкиДаты.Сортировать("ЗаказПокупателя, ПлановаяДатаПоступления");
	
	Для Каждого СтрСписка Из СписокЗПДляКорректировкиДаты Цикл		 
		
		ТекЗаказ = СтрСписка.ЗаказПокупателя;
		ЗаказПоставщикуОбъект = ТекЗаказ.ПолучитьОбъект();			
		ЗаказПоставщикуОбъект.ДатаОтгрузки = СтрСписка.ПлановаяДатаПоступления; 
		ЗаказПоставщикуОбъект.Записать(РежимЗаписиДокумента.Проведение);			

	КонецЦикла;	

КонецПроцедуры

Функция ПроверитьРезерв(ЗаказПокупателя)

	Ответ = Новый Структура("ЕстьРезерв", Ложь);
	Ответ.Вставить("ДатаОтгрузки", Дата(1,1,1));
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва,
	|	СУММА(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток) КАК КоличествоОстаток
	|ПОМЕСТИТЬ ОстатокПоРезерву
	|ИЗ
	|	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(, ДокументРезерва = &ДокументРезерва) КАК ТоварыВРезервеНаСкладахОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстатокПоРезерву.ДокументРезерва,
	|	СУММА(ОстатокПоРезерву.КоличествоОстаток) КАК КоличествоОстаток,
	|	МАКСИМУМ(ТоварыВРезервеНаСкладах.Период) КАК Период
	|ИЗ
	|	ОстатокПоРезерву КАК ОстатокПоРезерву
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах КАК ТоварыВРезервеНаСкладах
	|		ПО ОстатокПоРезерву.ДокументРезерва = ТоварыВРезервеНаСкладах.ДокументРезерва
	|			И (ТоварыВРезервеНаСкладах.Регистратор ССЫЛКА Документ.ПоступлениеТоваровУслуг)
	|
	|СГРУППИРОВАТЬ ПО
	|	ОстатокПоРезерву.ДокументРезерва");
	
	Запрос.Параметры.Вставить("ДокументРезерва", ЗаказПокупателя);
	РезЗапроса = Запрос.Выполнить();
	
	Если РезЗапроса.Пустой() Тогда
		Возврат Ответ;
