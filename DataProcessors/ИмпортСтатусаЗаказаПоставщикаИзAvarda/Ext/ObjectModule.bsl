КонецФункции
 
Функция Соединение(Подключение) Экспорт 
	
	#Если Клиент Тогда
		Стр = "Provider=MSDASQL;Password=54321;Persist Security Info=True;User ID=TWUSER;Data Source=" + ПолучитьИмяАварды() + "32;Initial Catalog=" + ПолучитьИмяАварды() + "32";
	#ИначеЕсли Сервер Тогда
		Стр = "Provider=MSDASQL;Password=54321;Persist Security Info=True;User ID=TWUSER;Data Source=" + ПолучитьИмяАварды() + ";Initial Catalog=" + ПолучитьИмяАварды();
	#КонецЕсли 
	
	Попытка		
		
		Подключение.ConnectionTimeout = 30;
		Подключение.Open(Стр);                                                    
		Возврат Истина;
		
	Исключение
		
		#Если Клиент Тогда
			глОшибкаАДО("Ошибка подключения ...", Подключение);
		#КонецЕсли
		Возврат Ложь;
		
	КонецПопытки; 	

КонецФункции

Функция СформироватьЗапрос(СтрокаЗапроса,Подключение) Экспорт
	
	Попытка               
		
		Код = Новый ComObject("ADODB.Recordset");   
		Код.Open(СтрокаЗапроса,Подключение, 2, 3, 1);	
		Возврат Код;
		
	Исключение
		
		глОшибкаАДО("", Подключение); 
		Возврат Неопределено;
		
	КонецПопытки;	

КонецФункции

Процедура глОшибкаАДО(стрФункция = "", Подключение) Экспорт 
	
	Если Подключение.Errors.Count() <> 0 Тогда
		
		Для Ин = 0 По Подключение.Errors.Count() - 1 Цикл
			
			чКод = Подключение.Errors(Ин).Number();
			сОписание = Подключение.Errors(Ин).Description();
			сИсточник = Подключение.Errors(Ин).Source();
			Сообщить("ADO Error: " + чКод + " | " + стрФункция + " | " + сОписание + " | " + Подключение.Errors.Item);
			
		КонецЦикла;
		
		Подключение.Errors.Clear();
		
	Иначе
		Сообщить("Ошибка: " + ОписаниеОшибки());
	КонецЕсли;	

КонецПроцедуры 

