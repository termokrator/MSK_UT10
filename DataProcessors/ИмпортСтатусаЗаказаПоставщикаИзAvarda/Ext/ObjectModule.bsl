Перем СписокОтмененыхЗаказовПоставщика;
Перем КорректировкаЗаказаПоставщика, КорректировкаЗаказаПокупателя;

Процедура ИмпортСтатусовЗаказаПоставщикуИзAVARDA(ДатаНачала, ДатаКонец) Экспорт 

	ЗАпросИсключаемыхИзЭкспрессаСкладов = Новый Запрос;
	ЗАпросИсключаемыхИзЭкспрессаСкладов.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СобственныеСклады.Ссылка КАК Склад,
	|	СобственныеСклады.ВэбСервисУТ11
	|ИЗ
	|	Справочник.СобственныеСклады КАК СобственныеСклады
	|ГДЕ
	|	СобственныеСклады.ИсключитьИзОбщегоЭкспресса
	|	И НЕ (ВЫРАЗИТЬ(СобственныеСклады.АдресВебСервиса КАК СТРОКА(256))) = """"
	|	И НЕ СобственныеСклады.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	СобственныеСклады.Идентификатор";
	
	РезультатЗапросаИсключаемыхИзЭкспрессаСкладов = ЗАпросИсключаемыхИзЭкспрессаСкладов.Выполнить();
	
	Если НЕ РезультатЗапросаИсключаемыхИзЭкспрессаСкладов.Пустой() Тогда
		
		ВыборкаСкладов = РезультатЗапросаИсключаемыхИзЭкспрессаСкладов.Выбрать();
		
		Пока ВыборкаСкладов.Следующий() Цикл
			ПолучитьСтатусыИзСтороннейБазы(ДатаНачала, ДатаКонец, ВыборкаСкладов.ВэбСервисУТ11, "", ВыборкаСкладов.Склад);
		КонецЦикла;		
		
	КонецЕсли;

	Если Константы.ОтправлятьЗаказыВСтророннююУТ.Получить() Тогда
		
		ПолучитьСтатусыИзСтороннейБазы(ДатаНачала, ДатаКонец);

		Если Константы.ПополнениеДляОбособленногоПодразделенияЮЛ.Получить() Тогда
			ПолучитьСтатусыИзСтороннейБазы(ДатаНачала, ДатаКонец, Ложь, "ПополнениеОП");
		КонецЕсли;

	КонецЕсли;	
	
	Если Константы.ОтправлятьЗаказыВСтророннююУТ11.Получить() Тогда
		ПолучитьСтатусыИзСтороннейБазы(ДатаНачала, ДатаКонец, Истина);		
	КонецЕсли;	
	
	Если Константы.ГорючиеЖидкостиВОтдельныйЗаказ.Получить() И НЕ Константы.ОтправлятьЗаказыНаГорючиеЖидкостиВУТ11.Получить() Тогда
		ПолучитьСтатусыИзСтороннейБазы(ДатаНачала, ДатаКонец, Ложь, "ГорючиеЖидкости");                                                        
	КонецЕсли;
	
	Если Константы.ОтправлятьЭкспрессыВ.Получить() Тогда
		
		Если Константы.ПриоритетОтправкиЭкспрессов.Получить() = Перечисления.ПриоритетыОтправкиЭкспрессов.УТ10 Тогда
			ПолучитьСтатусыИзСтороннейБазы(ДатаНачала, ДатаКонец, Ложь, "Экспрессы");
		ИначеЕсли Константы.ПриоритетОтправкиЭкспрессов.Получить() = Перечисления.ПриоритетыОтправкиЭкспрессов.УТ11 Тогда
			ПолучитьСтатусыИзСтороннейБазы(ДатаНачала, ДатаКонец, Истина, "Экспрессы");
		КонецЕсли;		
		
	КонецЕсли;	
	
	Если Константы.ВыборочнаяОтправкаЗаказовСторСкладовВУТ11.Получить() Тогда
		ПолучитьСтатусыИзСтороннейБазы(ДатаНачала, ДатаКонец, Истина, "СторонниеСклады");
	КонецЕсли;
	                                                    
	Сообщить("Данные загружены.");
	
КонецПроцедуры

Процедура ОбработатьСтатус120НетНаскладе(Знач СтатусТЗ, ОтмененныеСтрокиЗаказа = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Т1.ЗаказПоставщика,
	|	Т1.Номенклатура,
	|	Т1.КодСтроки ,
	|   Т1.Статус
	|ПОМЕСТИТЬ СписокЗаказовПоставщика
	|ИЗ
	|	&СписокОтмененыхЗаказовПоставщика КАК Т1
	|   
	|ИНДЕКСИРОВАТЬ ПО
	|	Т1.ЗаказПоставщика,
	|	Т1.Номенклатура,
	|	Т1.КодСтроки	
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т1.Документ,
	|	Т1.Номенклатура,
	|	Т1.КодСтроки,
	|	СУММА(ВЫБОР
	|			КОГДА Т1.Статус = ""120; нет на складе""
	|				ТОГДА Т1.КоличествоAvarda
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоОтменено_1,
	|	СУММА(ВЫБОР
	|			КОГДА Т1.Статус <> ""120; нет на складе""
	|				ТОГДА Т1.КоличествоAvarda
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоОтменено_2,
	|	МАКСИМУМ(Т1.КоличествоОстатокПоСкладу) КАК КоличествоОстатокПоСкладу,
	|	МАКСИМУМ(Т1.КоличествоЗаказПоставщика) КАК КоличествоЗаказаПоставщика,
	|	МАКСИМУМ(Т1.КоличествоКорЗаказаПоставщика) КАК КоличествоКорЗаказаПоставщика,
	|	МАКСИМУМ(Т1.ЗаказПокупателя) КАК ЗаказПокупателя
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	РегистрСведений.ИсторияХраненияИзмененийЗагружСтатусов КАК Т1
	|ГДЕ
	|	Т1.Статус В(&Статус)
	|	И Т1.Документ <> ЗНАЧЕНИЕ(Документ.ЗаказПоставщику.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	Т1.Документ,
	|	Т1.Номенклатура,
	|	Т1.КодСтроки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Т1.Документ,
	|	Т1.Номенклатура,
	|	Т1.КодСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Документ КАК ЗП_ЗаказПоставщикуСсылка,
	|	ВТ.Номенклатура,
	|	ВТ.КодСтроки КАК ВТ_КодСтроки,
	|	МАКСИМУМ(ВТ.КоличествоОтменено_1) КАК КоличествоОтменено_1,
	|	МАКСИМУМ(ВТ.КоличествоОтменено_2) КАК КоличествоОтменено_2,
	|	МАКСИМУМ(ВТ.КоличествоОстатокПоСкладу) КАК КоличествоОстатокПоСкладу,
	|	МАКСИМУМ(ВТ.КоличествоЗаказаПоставщика) КАК КоличествоЗаказаПоставщика,
	|	МАКСИМУМ(ВТ.КоличествоКорЗаказаПоставщика) КАК КоличествоКорЗаказаПоставщика,
	|	МАКСИМУМ(ВТ.ЗаказПокупателя) КАК ЗП_Товары_ЗаказПокупателя,
	|	СУММА(ЕСТЬNULL(Т1.КоличествоAvarda, 0)) КАК КоличествоЗаказаноAvarda
	|ИЗ
	|	СписокЗаказовПоставщика КАК СписокЗаказовПоставщика
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ КАК ВТ
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсторияХраненияИзмененийЗагружСтатусов КАК Т1
	|			ПО ВТ.Документ = Т1.Документ
	|				И ВТ.Номенклатура = Т1.Номенклатура
	|				И ВТ.КодСтроки = Т1.КодСтроки
	|				И (НЕ Т1.Статус В (&Статус2))
	|		ПО СписокЗаказовПоставщика.ЗаказПоставщика = ВТ.Документ
	|			И СписокЗаказовПоставщика.Номенклатура = ВТ.Номенклатура
	|			И СписокЗаказовПоставщика.КодСтроки = ВТ.КодСтроки
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ.Документ,
	|	ВТ.Номенклатура,
	|	ВТ.КодСтроки";
	
	//Поле КоличествоЗаказаноAvarda определяет суммароное количество у которых статус не отменено.
	ОтмененныеСтрокиЗаказа = ?(ОтмененныеСтрокиЗаказа = Неопределено, СписокОтмененыхЗаказовПоставщика, ОтмененныеСтрокиЗаказа); 
	Запрос.УстановитьПараметр("СписокОтмененыхЗаказовПоставщика", ОтмененныеСтрокиЗаказа);	
	МассивЗначений = СтатусТЗ.ВыгрузитьКолонку("Имя");
	Запрос.УстановитьПараметр("Статус", МассивЗначений );
	Запрос.УстановитьПараметр("ДатаЗагрузки", НачалоДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("Статус2", МассивЗначений );
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();	
	ОписаниеДокумента = "";
	
	Пока РезультатЗапроса.Следующий() Цикл
		
		Если ЗначениеЗаполнено(ОписаниеДокумента) Тогда
			
			ОшибкаЗагрузки("", "Невозможно создать документы. " + ОписаниеДокумента);
			ОписаниеДокумента = "";
			
		КонецЕсли; 
		
		КорректировкаЗаказаПоставщика = Документы.КорректировкаЗаказаПоставщику.ПустаяСсылка();
		КорректировкаЗаказаПокупателя = Документы.КорректировкаЗаказаПокупателя.ПустаяСсылка();
		                                                              
		Если РезультатЗапроса.КоличествоОстатокПоСкладу = 0 Тогда
			Продолжить;
		КонецЕсли; 				
		
		Если РезультатЗапроса.КоличествоОтменено_1 = 0 Тогда 
			
			КоличествоКорректировки = РезультатЗапроса.КоличествоЗаказаПоставщика 									 
									 - РезультатЗапроса.КоличествоЗаказаноAvarda
									 - РезультатЗапроса.КоличествоКорЗаказаПоставщика;												 			
		КонецЕсли; 			
		
		Если КоличествоКорректировки > 0  Тогда
			
			МассивОшибок = Новый Массив;
			МассивОшибок.Добавить( "Заказ поставщику: " + РезультатЗапроса.ЗП_ЗаказПоставщикуСсылка.Номер + " "  + Строка(РезультатЗапроса.ЗП_ЗаказПоставщикуСсылка.Дата ) + " ; ");
			МассивОшибок.Добавить( "Номенклатура: " + РезультатЗапроса.Номенклатура.Код + " " + РезультатЗапроса.Номенклатура.Наименование + " ; ");
			МассивОшибок.Добавить( "Код строки:" + РезультатЗапроса.ВТ_КодСтроки + " ; ");
			МассивОшибок.Добавить( "Статус: 120; нет на складе");
			//////////////////////////////////////////////////////////////////
			МенеджерЗаписи = РегистрыСведений.ИсторияХраненияИзмененийЗагружСтатусов.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Документ = РезультатЗапроса.ЗП_ЗаказПоставщикуСсылка;
			МенеджерЗаписи.Номенклатура = РезультатЗапроса.Номенклатура;
			МенеджерЗаписи.КодСтроки =  РезультатЗапроса.ВТ_КодСтроки;
			МенеджерЗаписи.Статус =  "120; нет на складе";	
			
			МенеджерЗаписи.Прочитать();				
			
			Если МенеджерЗаписи.Выбран() Тогда
				МенеджерЗаписи.КорректировкаЗаказаПоставщика = КорректировкаЗаказаПоставщика;
				МенеджерЗаписи.Записать(Истина);
			КонецЕсли; 
			///////////////////////////////////////////////////
				
			Попытка				
				//НачатьТранзакцию();
				СоздатьКорректировкуЗаказаПоставщика(РезультатЗапроса, КоличествоКорректировки);												
				//ЗафиксироватьТранзакцию();
				
				МенеджерЗаписи.КорректировкаЗаказаПокупателя = КорректировкаЗаказаПокупателя;
				МенеджерЗаписи.КорректировкаЗаказаПоставщика = КорректировкаЗаказаПоставщика;
				МенеджерЗаписи.КоличествоДопКорЗаказаПоставщика = КоличествоКорректировки;
								
				МенеджерЗаписи.Записать(Истина);
				
			Исключение
				
				//ОтменитьТранзакцию();				
				ОписаниеДокумента = ОписаниеОшибкиОбработкиДанных(МассивОшибок);
				Ошибка = ИнформацияОбОшибке();
				ОписаниеДокумента = ОписаниеДокумента + "; " + Ошибка.Причина.Описание; 
				
				Продолжить;								
				
			КонецПопытки;
			
		КонецЕсли; 
		
	КонецЦикла; 
	
КонецПроцедуры	

Процедура СоздатьКорректировкуЗаказаПоставщика(СтрокаРезультатаЗапроса, КоличествоКорректировки)	
	
	КорректЗаказаПоставщику = Документы.КорректировкаЗаказаПоставщику.СоздатьДокумент();	
	ЗаказПоставщика = СтрокаРезультатаЗапроса.ЗП_ЗаказПоставщикуСсылка.ПолучитьОбъект();	
	
	ЗаказПоставщикаТоварыСтрока = ЗаказПоставщика.Товары.Найти( СтрокаРезультатаЗапроса.ВТ_КодСтроки, "УИД");
	
	КорректЗаказаПоставщику.Заполнить( СтрокаРезультатаЗапроса.ЗП_ЗаказПоставщикуСсылка );
	КорректЗаказаПоставщику.Дата = ТекущаяДата();
	
	ТабЧастьТовары = КорректЗаказаПоставщику.Товары;                                      
	ТабЧастьТовары.Очистить();
	
	НоваяСтрока = ТабЧастьТовары.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ЗаказПоставщикаТоварыСтрока); 
	
	НоваяСтрока.Количество = -1 * КоличествоКорректировки;
	ОбработкаТабличныхЧастей.РассчитатьКоличествоМестТабЧасти(НоваяСтрока, КорректЗаказаПоставщику);
	ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(НоваяСтрока, КорректЗаказаПоставщику);
	ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НоваяСтрока, КорректЗаказаПоставщику);

	НоваяСтрока.Заказ = СтрокаРезультатаЗапроса.ЗП_Товары_ЗаказПокупателя;
	КорректЗаказаПоставщику.Комментарий = "Документ создан автоматич. обработкой ""ИмпортСтатусаЗаказаПоставщикаИзАварда"" ";

	КорректЗаказаПоставщику.Записать( РежимЗаписиДокумента.Проведение );
	
	Если ЗначениеЗаполнено(СтрокаРезультатаЗапроса.ЗП_Товары_ЗаказПокупателя) Тогда
		СоздатьКорректировкуЗаказаПокупателя( КорректЗаказаПоставщику.Товары[0], СтрокаРезультатаЗапроса.ЗП_Товары_ЗаказПокупателя, Истина);			
	КонецЕсли; 
	
	КорректировкаЗаказаПоставщика = КорректЗаказаПоставщику.Ссылка;
	
КонецПроцедуры
 
Процедура СоздатьКорректировкуЗаказаПокупателя(СтрокаТовары, ЗаказПокупателяСсылка, Проведение ) 
	
	НовыйДок = Документы.КорректировкаЗаказаПокупателя.СоздатьДокумент();
	НовыйДок.Дата = ТекущаяДата();
	НовыйДок.ЗаказПокупателя = ЗаказПокупателяСсылка;
	НовыйДок.Заполнить(ЗаказПокупателяСсылка);
	
	ТабЧастьТовары = НовыйДок.Товары;
	ТабЧастьТовары.Очистить();
	
	НоваяСтрока = ТабЧастьТовары.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТовары); 
	
	// Получаем среднюю цену закупки
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказПокупателяТовары.Номенклатура,
	|	СУММА(ЗаказПокупателяТовары.Количество * ЗаказПокупателяТовары.Цена) КАК СуммаПодсчит,
	|	СУММА(ЗаказПокупателяТовары.Количество) КАК Количество,
	|	МАКСИМУМ(ЗаказПокупателяТовары.ТолькоРезерв) КАК ТолькоРезерв
	|ИЗ
	|	Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары
	|ГДЕ
	|	ЗаказПокупателяТовары.Ссылка = &Ссылка
	|	И ЗаказПокупателяТовары.Номенклатура = &Номенклатура
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказПокупателяТовары.Номенклатура";
	
	Запрос.УстановитьПараметр("Ссылка", ЗаказПокупателяСсылка);
	Запрос.УстановитьПараметр("Номенклатура", НоваяСтрока.Номенклатура);	
	                                            
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаЗапроса = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаЗапроса.Следующий() Цикл
		
		ЦенаЗакупкиЗаЕдиницу = Окр(ВыборкаЗапроса.СуммаПодсчит / ВыборкаЗапроса.Количество, 2, 1); 
		НоваяСтрока.ТолькоРезерв = ВыборкаЗапроса.ТолькоРезерв;
		
	КонецЦикла;	 			
	
	НоваяСтрока.Цена = ЦенаЗакупкиЗаЕдиницу;
	
	ОбработкаТабличныхЧастей.РассчитатьКоличествоМестТабЧасти(НоваяСтрока, НовыйДок);
	ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(НоваяСтрока, НовыйДок);
	ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НоваяСтрока, НовыйДок);
	
	НоваяСтрока.ОтказПоставщика = Справочники.ПричиныЗакрытияЗаказов.ОтказПоставщика;
	НоваяСтрока.Причина = Перечисления.ПричиныКорректировкиСборки.ОтказПоставщика;
	
	НовыйДок.Записать(РежимЗаписиДокумента.Проведение);
	
	КорректировкаЗаказаПокупателя = НовыйДок.Ссылка;

КонецПроцедуры

