|		ПО РеализацияТоваровУслугТовары.Ссылка = ТабВозвращаемойНоменклатуры.Реализация
|			И РеализацияТоваровУслугТовары.Номенклатура = ТабВозвращаемойНоменклатуры.Номенклатура
|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары
|		ПО РеализацияТоваровУслугТовары.Номенклатура = ЗаказПокупателяТовары.Номенклатура
|			И РеализацияТоваровУслугТовары.ЗаказПокупателя = ЗаказПокупателяТовары.Ссылка
|
|СГРУППИРОВАТЬ ПО
|	РеализацияТоваровУслугТовары.Номенклатура,
|	РеализацияТоваровУслугТовары.СерияНоменклатуры,
|	РеализацияТоваровУслугТовары.Ссылка,
|	ТабВозвращаемойНоменклатуры.IDСклада,
|	ЗаказПокупателяТовары.Размещение
|;
|
|////////////////////////////////////////////////////////////////////////////////
|ВЫБРАТЬ ПЕРВЫЕ 1
|	ПоступлениеТоваровУслугТовары.Ссылка.Контрагент КАК Поставщик
|ИЗ
|	Документ.ПоступлениеТоваровУслуг.Товары КАК ПоступлениеТоваровУслугТовары
|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТабРеализованнойНоменклатуры КАК ТабРеализованнойНоменклатуры
|		ПО ПоступлениеТоваровУслугТовары.Номенклатура = ТабРеализованнойНоменклатуры.Номенклатура
|			И ПоступлениеТоваровУслугТовары.СерияНоменклатуры = ТабРеализованнойНоменклатуры.СерияНоменклатуры
|			И ПоступлениеТоваровУслугТовары.Ссылка.Дата <= ТабРеализованнойНоменклатуры.Ссылка.Дата
|			И (ВЫБОР
|				КОГДА ПоступлениеТоваровУслугТовары.ЗаказПоставщику = ЗНАЧЕНИЕ(Документ.ЗаказПоставщику.ПустаяСсылка)
|					ТОГДА ТабРеализованнойНоменклатуры.IDСклада = ЗНАЧЕНИЕ(Справочник.СторонниеСклады.ПустаяСсылка)
|				ИНАЧЕ ПоступлениеТоваровУслугТовары.ЗаказПоставщику.IDСклада = ТабРеализованнойНоменклатуры.IDСклада
|			КОНЕЦ)
|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
|		ПО ПоступлениеТоваровУслугТовары.ЗаказПоставщику = ЗаказПоставщикуТовары.Ссылка
|			И ПоступлениеТоваровУслугТовары.Номенклатура = ЗаказПоставщикуТовары.Номенклатура
|			И ПоступлениеТоваровУслугТовары.УИД = ЗаказПоставщикуТовары.УИД
|ГДЕ
|	ПоступлениеТоваровУслугТовары.Ссылка.Проведен
|
|УПОРЯДОЧИТЬ ПО
|	ПоступлениеТоваровУслугТовары.Ссылка.Дата УБЫВ";

ЗапросПоставщикаПоЗаказу = Новый Запрос;
ЗапросПоставщикаПоЗаказу.Текст =
"ВЫБРАТЬ РАЗЛИЧНЫЕ
|	ЗаявкаНаВозвратТовары.Ссылка.Реализация,
|	ЗаявкаНаВозвратТовары.Номенклатура
|ПОМЕСТИТЬ ВТ_ЗаявкаНаВозврат
|ИЗ
|	Документ.ЗаявкаНаВозврат.Товары КАК ЗаявкаНаВозвратТовары
|ГДЕ
|	ЗаявкаНаВозвратТовары.Ссылка = &ЗаявкаНаВозврат
|;
|
