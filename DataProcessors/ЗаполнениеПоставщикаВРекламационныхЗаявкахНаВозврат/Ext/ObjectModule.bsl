Перем ЗапросПоставщика;
Перем ЗапросПоставщикаПоЗаказу;

Процедура РегламентноеВыполнение() Экспорт 
	
	ЗапросЗаявокДляЗаполнения = Новый Запрос;
	ЗапросЗаявокДляЗаполнения.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаявкаНаВозвратТовары.Ссылка КАК Заявка
	|ИЗ
	|	Документ.ЗаявкаНаВозврат.Товары КАК ЗаявкаНаВозвратТовары
	|ГДЕ
	|	НЕ ЗаявкаНаВозвратТовары.Ссылка.Проведен
	|	И НЕ ЗаявкаНаВозвратТовары.Ссылка.ПометкаУдаления
	|	И ЗаявкаНаВозвратТовары.Ссылка.Статус = ""На согласовании""
	|	И ЗаявкаНаВозвратТовары.Тип = ""Рекламация""
	|	И ЗаявкаНаВозвратТовары.Ссылка.Поставщик = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)";
	
	РезультатЗапросаЗаявок = ЗапросЗаявокДляЗаполнения.Выполнить();
	
	Если НЕ РезультатЗапросаЗаявок.Пустой() Тогда
		
		ВыборкаЗаявок = РезультатЗапросаЗаявок.Выбрать();
		
		Пока ВыборкаЗаявок.Следующий() Цикл
			
			Если Константы.ПоискПоставщикаСОпоройНаЗаказПокупателя.Получить() Тогда
				
				ЗапросПоставщикаПоЗаказу.УстановитьПараметр("ЗаявкаНаВозврат", ВыборкаЗаявок.Заявка);
				РезультатЗапросаПостащикаПоЗаказу = ЗапросПоставщикаПоЗаказу.Выполнить();
				
				Если НЕ РезультатЗапросаПостащикаПоЗаказу.Пустой() Тогда
					
					ЗаявкаОбъект = ВыборкаЗаявок.Заявка.ПолучитьОбъект();
					ЗаявкаОбъект.Поставщик = Константы.ОсновнойПоставщик.Получить();
					
					Попытка
						ЗаявкаОбъект.Записать();
						ТекстСообщения = "В заявку " + СокрЛП(ЗаявкаОбъект.Ссылка) + " установлен поставщик " + СокрЛП(ЗаявкаОбъект.Поставщик) + "";
						
						#Если Клиент Тогда
							Сообщить(ТекстСообщения);
						#Иначе
							
							ЗаписьЖурналаРегистрации("Заполнение поставщика в рекламационных заявках на возврат", УровеньЖурналаРегистрации.Информация, , ,
							ТекстСообщения);
							
						#КонецЕсли 
						
					Исключение
					Конецпопытки;				
					
					Продолжить;
					
				КонецЕсли;				
				
			КонецЕсли;
			
			ЗапросПоставщика.УстановитьПараметр("ЗаявкаНаВозврат",ВыборкаЗаявок.Заявка);
			
			РезультатЗапросаПоставщика = ЗапросПоставщика.Выполнить().Выгрузить();
			
			Если НЕ РезультатЗапросаПоставщика.Количество() = 0 Тогда
				
				ЗаявкаОбъект = ВыборкаЗаявок.Заявка.ПолучитьОбъект();
				ЗаявкаОбъект.Поставщик = РезультатЗапросаПоставщика[0].Поставщик;
				
				Попытка
					
					ЗаявкаОбъект.Записать();
					ТекстСообщения = "В заявку " + СокрЛП(ЗаявкаОбъект.Ссылка) + " установлен поставщик " + СокрЛП(РезультатЗапросаЗаявок[0].Поставщик) + "";
					
					#Если Клиент Тогда
						Сообщить(ТекстСообщения);
					#Иначе
						
						ЗаписьЖурналаРегистрации("Заполнение поставщика в рекламационных заявках на возврат", УровеньЖурналаРегистрации.Информация, , ,
						ТекстСообщения);
						
					#КонецЕсли 
					
				Исключение
				Конецпопытки;				
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#Область ПеременныеМодуля

ЗапросПоставщика = Новый Запрос;
ЗапросПоставщика.Текст =
"ВЫБРАТЬ
|	ЗаявкаНаВозвратТовары.Ссылка.Реализация,
|	ЗаявкаНаВозвратТовары.Номенклатура,
|	СУММА(ЗаявкаНаВозвратТовары.Количество) КАК Количество,
|	ЗаявкаНаВозвратТовары.Комментарий,
|	ЗаявкаНаВозвратТовары.IDСклада_СтороннийСклад КАК IDСклада
|ПОМЕСТИТЬ ТабВозвращаемойНоменклатуры
|ИЗ
|	Документ.ЗаявкаНаВозврат.Товары КАК ЗаявкаНаВозвратТовары
|ГДЕ
|	ЗаявкаНаВозвратТовары.Ссылка = &ЗаявкаНаВозврат
|
|СГРУППИРОВАТЬ ПО
|	ЗаявкаНаВозвратТовары.Ссылка.Реализация,
|	ЗаявкаНаВозвратТовары.Номенклатура,
|	ЗаявкаНаВозвратТовары.Комментарий,
|	ЗаявкаНаВозвратТовары.IDСклада_СтороннийСклад
|;
|
|////////////////////////////////////////////////////////////////////////////////
|ВЫБРАТЬ
|	РеализацияТоваровУслугТовары.Номенклатура,
|	РеализацияТоваровУслугТовары.СерияНоменклатуры,
|	СУММА(РеализацияТоваровУслугТовары.Количество) КАК Количество,
|	РеализацияТоваровУслугТовары.Ссылка,
|	ВЫБОР
|		КОГДА ЕСТЬNULL(ЗаказПокупателяТовары.Размещение, НЕОПРЕДЕЛЕНО) = НЕОПРЕДЕЛЕНО
|			ТОГДА ТабВозвращаемойНоменклатуры.IDСклада
|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.СторонниеСклады.ПустаяСсылка)
|	КОНЕЦ КАК IDСклада
|ПОМЕСТИТЬ ТабРеализованнойНоменклатуры
|ИЗ
