	Иначе         		
		
		Объект.ТекСумма = Число(Объект.ВводимаяСумма);
		ПерейтиНаСтраницу("Страница_ПодтверждениеПокупкиКорр");
		Элементы.ДекорацияСумма4.Заголовок = "" + Объект.ТекСумма + " руб.";		
		
	КонецЕсли;

