&НаКлиенте
Процедура СписокТоваров_УстановитьПервуюСтроку()
	
	Объект.СписокТоваров_ТекСтрока = 1;
	Элементы.СписокТоваров.ТекущаяОбласть = СписокТоваров.Область(2, 1, 2, 5);
	СписокТоваров_ВыделитьСтроку(1);

КонецПроцедуры

&НаКлиенте
Функция СписокТоваров_ПолучитьКоличествоСтрокНаСтранице()
	
	Если Объект.СписокТоваров_ТекСтраница = Объект.СписокТоваров_КоличествоСтраниц Тогда
		Возврат КоличествоСтрокТоваров - (Объект.СписокТоваров_КоличествоСтраниц * КоличествоСтрокТоваров - Объект.СписокТоваров_КоличествоСтрок);
	Иначе
		Возврат КоличествоСтрокТоваров;
	КонецЕсли;	

КонецФункции

&НаКлиенте
Процедура СписокТоваров_Больше(Команда)
	
	Объект.СписокТоваров_ТекСтраница = Объект.СписокТоваров_ТекСтраница + 1;
	СписокТоваров_Вывести();
	СписокТоваров_УстановитьПервуюСтроку();

КонецПроцедуры

&НаКлиенте
Процедура СписокТоваров_Меньше(Команда)
	
	Объект.СписокТоваров_ТекСтраница = Объект.СписокТоваров_ТекСтраница - 1;
	СписокТоваров_Вывести();
	СписокТоваров_УстановитьПервуюСтроку();

КонецПроцедуры

&НаКлиенте
Процедура СписокТоваров_ВыделитьСтроку(НомерСтроки)
	
	ОбластьТекущейСтроки = СписокТоваров.Область(НомерСтроки + 1, 1, НомерСтроки + 1, 5);
	ОбластьТекущейСтроки.ЦветФона = ?(Объект.РежимРедактирования, WebЦвета.Голубой, WebЦвета.Желтый);
	
	Если СписокТоваров_ПредОбласть = Неопределено Тогда
		СписокТоваров_ПредОбласть = ОбластьТекущейСтроки;
	ИначеЕсли НЕ СписокТоваров_ПредОбласть.Имя = ОбластьТекущейСтроки.Имя Тогда
		СписокТоваров_ПредОбласть.ЦветФона = WebЦвета.Белый;
		СписокТоваров_ПредОбласть = ОбластьТекущейСтроки;
	КонецЕсли; 	
	
	Если Объект.РежимРедактирования Тогда
		
		Объект.ТекРеализация = ОбластьТекущейСтроки.Расшифровка.Реализация;
		Объект.ТекНомерСтроки = ОбластьТекущейСтроки.Расшифровка.НомерСтрокиСч;
		Объект.ТекНоменклатура = ОбластьТекущейСтроки.Расшифровка.Номенклатура;
				
		Структура = Новый Структура;
		Структура.Вставить("Реализация", Объект.ТекРеализация);
		Структура.Вставить("НомерСтрокиСч", Объект.ТекНомерСтроки);
		Структура.Вставить("Номенклатура", Объект.ТекНоменклатура);
		Стр = Объект.СписокТоваров_Таблица.НайтиСтроки(Структура)[0];
				
		Элементы.СписокТоваров_УменьшитьКоличество.Доступность = НЕ Стр.ВводимоеКоличество = 0 И НЕ Стр.ЭтоСтороннийСклад;
		Элементы.СписокТоваров_УвеличитьКоличество.Доступность = НЕ Стр.ВводимоеКоличество = Стр.Количество И НЕ Стр.ЭтоСтороннийСклад;
		Элементы.СписокТоваров_Очистить.Доступность = Не Стр.ЭтоСтороннийСклад
	
	КонецЕсли;
	
	УстановитьВидимостьГруппНаСервере(Объект.РежимРедактирования)
	
КонецПроцедуры

&НаКлиенте
Процедура СписокТоваровОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь; 

КонецПроцедуры

&НаКлиенте
Процедура СписокТоваровПриАктивизацииОбласти(Элемент)
	
	Объект.СписокТоваров_ТекСтрока = СписокТоваров.ТекущаяОбласть.Верх - 1;
	
	Если Объект.СписокТоваров_ТекСтрока < 1 Или Объект.СписокТоваров_ТекСтрока > СписокТоваров_ПолучитьКоличествоСтрокНаСтранице() Тогда
		СписокТоваров_УстановитьПервуюСтроку();
	Иначе
		СписокТоваров_ВыделитьСтроку(Объект.СписокТоваров_ТекСтрока);	
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СписокТоваров_ПодтвердитьПоставку(Команда)
	
	Элементы.Страницы.ТекущаяСтраница = Элементы.Страница_ПодтверждениеПокупки;
	Элементы.ДекорацияСумма1.Заголовок = "" + Объект.ТекСумма + " руб.";
	Элементы.ДекорацияСумма7.Заголовок = "" + Объект.ТекОстатокВзаиморасчетов + " руб.";

КонецПроцедуры

&НаКлиенте
Процедура СписокТоваров_ИзменитьПоставку(Команда)
	
	Объект.РежимРедактирования = Истина;
	СписокТоваров_ВыделитьСтроку(Объект.СписокТоваров_ТекСтрока);

КонецПроцедуры

&НаКлиенте
Процедура СписокТоваров_ОтменитьПоставку(Команда)
	
	Элементы.ДекорацияСумма5.Заголовок = "" + Объект.ТекСумма + " руб.";
	Элементы.Страницы.ТекущаяСтраница = Элементы.Страница_Отказ;

КонецПроцедуры

&НаКлиенте
Процедура СписокТоваров_УвеличитьКоличество(Команда)
	
	Если Объект.РежимРедактирования Тогда	
		
		Структура = Новый Структура;
		Структура.Вставить("Реализация", Объект.ТекРеализация);
		Структура.Вставить("НомерСтрокиСч", Объект.ТекНомерСтроки);
		Структура.Вставить("Номенклатура", Объект.ТекНоменклатура);
		
		Кратность = ПолучитьКратностьТовара(Объект.ТекНоменклатура);
		НаСколькоУвеличить = 1 * Кратность;
		
		Стр = Объект.СписокТоваров_Таблица.НайтиСтроки(Структура)[0];
		
		СколькоВИтогеПолучится =  Стр.ВводимоеКоличество + НаСколькоУвеличить;
		
		Если СколькоВИтогеПолучится > Стр.Количество Тогда
			Возврат;
		КонецЕсли;
		
		Стр.ВводимоеКоличество = СколькоВИтогеПолучится;
		
		Элементы.СписокТоваров_УменьшитьКоличество.Доступность = НЕ Стр.ВводимоеКоличество = 0;
		Элементы.СписокТоваров_УвеличитьКоличество.Доступность = НЕ Стр.ВводимоеКоличество = Стр.Количество;
		СписокТоваров_Вывести();
		ОбластьТекущейСтроки = СписокТоваров.Область(Объект.ТекНомерСтроки + 1, 1, Объект.ТекНомерСтроки + 1, 5);
		ОбластьТекущейСтроки.ЦветФона = WebЦвета.Голубой;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокТоваров_УменьшитьКоличество(Команда)
	
	Если Объект.РежимРедактирования Тогда
		
		Структура = Новый Структура;
		Структура.Вставить("Реализация", Объект.ТекРеализация);
		Структура.Вставить("НомерСтрокиСч", Объект.ТекНомерСтроки);
		Структура.Вставить("Номенклатура", Объект.ТекНоменклатура);
		
		Кратность = ПолучитьКратностьТовара(Объект.ТекНоменклатура);
		НаСколькоУменьшить = 1 * Кратность;
		
		Стр = Объект.СписокТоваров_Таблица.НайтиСтроки(Структура)[0];
		
		СколькоВИтогеПолучится =  Стр.ВводимоеКоличество - НаСколькоУменьшить;
		
		Если СколькоВИтогеПолучится < 0 Тогда
			Возврат;
		КонецЕсли;
		
		Стр.ВводимоеКоличество = СколькоВИтогеПолучится;
		
		Элементы.СписокТоваров_УменьшитьКоличество.Доступность = НЕ Стр.ВводимоеКоличество = 0;
		Элементы.СписокТоваров_УвеличитьКоличество.Доступность = НЕ Стр.ВводимоеКоличество = Стр.Количество;
		СписокТоваров_Вывести();
		ОбластьТекущейСтроки = СписокТоваров.Область(Объект.ТекНомерСтроки + 1, 1, Объект.ТекНомерСтроки + 1, 5);
		ОбластьТекущейСтроки.ЦветФона = WebЦвета.Голубой;
		
	КонецЕсли;

КонецПроцедуры

