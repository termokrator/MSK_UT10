КонецПроцедуры

&НаСервере
Процедура СписокТоваров_ПолучитьТаблицу()
	
	РезультатЗапроса = ПолучитьИзВременногоХранилища(Объект.ДанныеНакладных_Адрес);
	СписокТоваров_Темп = РезультатЗапроса[5].Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СписокТоваров.ЗаданиеНаДоставку,
	|	СписокТоваров.Контрагент,
	|	СписокТоваров.Реализация,
	|	СписокТоваров.НомерНакладной,
	|	СписокТоваров.НомерСтрокиСч,
	|	СписокТоваров.Номенклатура,
	|	СписокТоваров.Количество,
	|	СписокТоваров.Сумма,
	|	СписокТоваров.ЭтоСтороннийСклад
	|ПОМЕСТИТЬ СписокТоваров
	|ИЗ
	|	&СписокТоваров КАК СписокТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СписокТоваров.Реализация,
	|	СписокТоваров.НомерНакладной,
	|	СписокТоваров.НомерСтрокиСч,
	|	СписокТоваров.Номенклатура,
	|	СписокТоваров.Количество,
	|	СписокТоваров.Количество КАК ВводимоеКоличество,
	|	СписокТоваров.Сумма,
	|	СписокТоваров.ЭтоСтороннийСклад
	|ИЗ
	|	СписокТоваров КАК СписокТоваров
	|ГДЕ
	|	СписокТоваров.ЗаданиеНаДоставку = &ЗаданиеНаДоставку
	|	И СписокТоваров.Контрагент = &Контрагент
	|	И СписокТоваров.Реализация = &Реализация";
	
	Запрос.УстановитьПараметр("СписокТоваров", СписокТоваров_Темп);
	Запрос.УстановитьПараметр("ЗаданиеНаДоставку", Объект.ТекЗадание);
	Запрос.УстановитьПараметр("Контрагент", Объект.ТекКонтрагент);
	Запрос.УстановитьПараметр("Реализация", Объект.ТекРеализация);
	
	СписокТоваров_Таблица = Запрос.Выполнить().Выгрузить();
	
	Объект.СписокТоваров_Таблица.Загрузить(СписокТоваров_Таблица);
	Объект.СписокТоваров_Адрес = ПоместитьВоВременноеХранилище(СписокТоваров_Таблица, Новый УникальныйИдентификатор); 
	Объект.СписокТоваров_ТекСтрока = 1;
	Объект.СписокТоваров_ТекСтраница = 1;
	Объект.СписокТоваров_КоличествоСтрок = СписокТоваров_Таблица.Количество();
	Объект.СписокТоваров_КоличествоСтраниц = Цел(Объект.СписокТоваров_КоличествоСтрок / КоличествоСтрокТоваров);	
	
	Если Цел(Объект.СписокТоваров_КоличествоСтрок / КоличествоСтрокТоваров) < Объект.СписокТоваров_КоличествоСтрок / КоличествоСтрокТоваров Тогда
		Объект.СписокТоваров_КоличествоСтраниц = Объект.СписокТоваров_КоличествоСтраниц + 1;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура СписокТоваров_Вывести()
	
	СписокТоваров.Очистить();
	СписокТоваров_Таблица = ПолучитьИзВременногоХранилища(Объект.СписокТоваров_Адрес);		
	
	Макет = Обработки.АРМ_Водитель.ПолучитьМакет("СписокТоваров");
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	СписокТоваров.Вывести(ОбластьМакета);
	
	Если Объект.СписокТоваров_ТекСтраница > Объект.СписокТоваров_КоличествоСтраниц Тогда
		Объект.СписокТоваров_ТекСтраница = 1;
	ИначеЕсли Объект.СписокТоваров_ТекСтраница < 1 Тогда
		Объект.СписокТоваров_ТекСтраница = Объект.СписокТоваров_КоличествоСтраниц;
	КонецЕсли;
	
	Элементы.СписокТоваров_ТекСтраницаПредставление.Заголовок = "" + Объект.СписокТоваров_ТекСтраница + " из " + Объект.СписокТоваров_КоличествоСтраниц;
	Элементы.СписокТоваров_Меньше.Доступность = НЕ (Объект.СписокТоваров_КоличествоСтраниц = 1 Или Объект.СписокТоваров_ТекСтраница = 1);
	Элементы.СписокТоваров_Больше.Доступность = НЕ (Объект.СписокТоваров_КоличествоСтраниц = 1 Или Объект.СписокТоваров_ТекСтраница = Объект.СписокТоваров_КоличествоСтраниц);
	
	Сч = (Объект.СписокТоваров_ТекСтраница - 1) * КоличествоСтрокТоваров;
	
	Для Сч = (Объект.СписокТоваров_ТекСтраница - 1) * КоличествоСтрокТоваров По Мин(Объект.СписокТоваров_КоличествоСтрок - 1, (Объект.СписокТоваров_ТекСтраница * КоличествоСтрокТоваров - 1)) Цикл
		
		ОбластьМакета = Макет.ПолучитьОбласть("Строка");
		ОбластьМакета.Параметры.Заполнить(СписокТоваров_Таблица[Сч]);
		ОбластьМакета.Параметры.НомерСтрокиСч = Сч + 1;
		
		Структура = Новый Структура;
		Структура.Вставить("Реализация", СписокТоваров_Таблица[Сч].Реализация);
		Структура.Вставить("НомерСтрокиСч", СписокТоваров_Таблица[Сч].НомерСтрокиСч);
		Структура.Вставить("Номенклатура", СписокТоваров_Таблица[Сч].Номенклатура);
		
		Стр = Объект.СписокТоваров_Таблица.НайтиСтроки(Структура)[0];
		ОбластьМакета.Параметры.Количество = Стр.ВводимоеКоличество;
		
		Если Стр.Количество = Стр.ВводимоеКоличество Тогда
			Стр.Сумма = СписокТоваров_Таблица[Сч].Сумма;
		Иначе
			Стр.Сумма = СписокТоваров_Таблица[Сч].Сумма * Стр.ВводимоеКоличество / СписокТоваров_Таблица[Сч].Количество; 
		КонецЕсли;
		
		ОбластьМакета.Параметры.Артикул = ОбластьМакета.Параметры.Номенклатура.Артикул;
		ОбластьМакета.Параметры.Сумма = Стр.Сумма;
		ОбластьМакета.Параметры.Структура = Структура;
		СписокТоваров.Вывести(ОбластьМакета);
		
	КонецЦикла;
	
	Объект.ТекСумма = Объект.СписокТоваров_Таблица.Итог("Сумма");
	
	Если Объект.СписокТоваров_ТекСтраница = Объект.СписокТоваров_КоличествоСтраниц Тогда
		
		ОбластьМакета = Макет.ПолучитьОбласть("Итого");
		ОбластьМакета.Параметры.Сумма = Объект.СписокТоваров_Таблица.Итог("Сумма");
		СписокТоваров.Вывести(ОбластьМакета);
		
	КонецЕсли;
	 
КонецПроцедуры

&НаСервере
Процедура ГрузовыеМеста_ПолучитьТаблицу()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РеализацияТоваровУслугДокументыСборкиЗаказов.ДокументСборки
		|ПОМЕСТИТЬ ДокументыСборки
