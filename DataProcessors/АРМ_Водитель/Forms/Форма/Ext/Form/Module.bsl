	|						ТОГДА АдресДоставки.Представление
	|					ИНАЧЕ АдресДоставки.Поле4 + "" "" + АдресДоставки.Поле6 + "" ул, дом № "" + АдресДоставки.Поле7 + "" "" + ВЫБОР
	|							КОГДА ПОДСТРОКА(АдресДоставки.Поле8, 1, 100) = """"
	|								ТОГДА """"
	|							ИНАЧЕ "" корпус "" + АдресДоставки.Поле8
	|						КОНЕЦ + "" "" + ВЫБОР
	|							КОГДА ПОДСТРОКА(АдресДоставки.Поле9, 1, 100) = """"
	|								ТОГДА """"
	|							ИНАЧЕ "" оф."" + АдресДоставки.Поле9
	|						КОНЕЦ + """"
	|				КОНЕЦ
	|		КОНЕЦ КАК СТРОКА(999)),
	|	ЗаданияНаДоставку.ЗаданиеНаДоставку,
	|	ЗаданияНаДоставку.Реализация.СуммаДокумента,
	|	ЗаданияНаДоставку.Реализация,
	|	ЕСТЬNULL(Оплаты.ЕстьОплата, ЛОЖЬ),
	|	ЗаданияНаДоставку.ОплатаНаличными,
	|	ЗаданияНаДоставку.Контрагент.ВремяПриемкиТовара
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПриоритетВМаршруте,
	|	Контрагент
	|АВТОУПОРЯДОЧИВАНИЕ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаданияНаДоставку.ЗаданиеНаДоставку,
	|	ЗаданияНаДоставку.Контрагент,
	|	ЗаданияНаДоставку.Реализация,
	|	ЗаданияНаДоставку.ОплатаНаличными КАК ОплатаНаличными
	|ИЗ
	|	ЗаданияНаДоставку КАК ЗаданияНаДоставку
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.ЗаданиеНаДоставку,
	|	Товары.Контрагент,
	|	Товары.Реализация КАК Реализация,
	|	Товары.НомерНакладной,
	|	Товары.НомерСтрокиСч КАК НомерСтрокиСч,
	|	Товары.Номенклатура,
	|	Товары.Количество,
	|	Товары.Сумма,
	|	Товары.ЭтоСтороннийСклад
	|ИЗ
	|	Товары КАК Товары
	|
	|УПОРЯДОЧИТЬ ПО
	|	Реализация,
	|	НомерСтрокиСч
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаданияНаДоставку.ЗаданиеНаДоставку
	|ИЗ
	|	ЗаданияНаДоставку КАК ЗаданияНаДоставку
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаданияНаДоставку.ЗаданиеНаДоставку";
	
	Запрос.УстановитьПараметр("ОрганизацияДляПриемаНаличных", Константы.ОсновнаяОрганизацияДляОплатыНаличнымиДляВодителей.Получить());
	Запрос.УстановитьПараметр("ТекущаяДата", Объект.ТекДата);
	Запрос.УстановитьПараметр("ТекущийВодитель", Объект.ТекВодитель);
	Запрос.УстановитьПараметр("СтатусДоставки", ПланыВидовХарактеристик.СвойстваОбъектов.СтатусДоставки);
	//-Кабанов А.В. 02.04.2024 # UT10-4391
	//Запрос.УстановитьПараметр("НеДоставлен", Перечисления.СтатусыДоставки.ТоварНеДоставлен);
	СписокСтатусовНеДоставлен = Новый СписокЗначений;
	СписокСтатусовНеДоставлен.Добавить(Перечисления.СтатусыДоставки.ТоварНеДоставлен);
	СписокСтатусовНеДоставлен.Добавить(Перечисления.СтатусыДоставки.ПереносДоставки);
	Запрос.УстановитьПараметр("НеДоставлен", СписокСтатусовНеДоставлен);
	//-Кабанов А.В. 02.04.2024 # UT10-4391

	УстановитьПривилегированныйРежим(Истина);	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	Объект.ДанныеНакладных_Адрес = ПоместитьВоВременноеХранилище(РезультатЗапроса, Новый УникальныйИдентификатор); 
	УстановитьПривилегированныйРежим(Ложь);
					
КонецПроцедуры

&НаСервере
Процедура СписокЗаданий_ПолучитьТаблицу()
	
	РезультатЗапроса = ПолучитьИзВременногоХранилища(Объект.ДанныеНакладных_Адрес);
	
	СтрокиДляУдаления = Новый Массив;
	
	СписокЗаданий_Таблица = РезультатЗапроса[3].Выгрузить();
	
	Для каждого Сп Из СписокЗаданий_Таблица Цикл
		
		Если Сп.ЗаданиеНаДоставку <> Объект.Задание Тогда
			СтрокиДляУдаления.Добавить(Сп);
		КонецЕсли;
		
	КонецЦикла;
	
	Для каждого Уд Из СтрокиДляУдаления Цикл
		СписокЗаданий_Таблица.Удалить(Уд);	
	КонецЦикла;
	
	Объект.СписокЗаданий_Адрес = ПоместитьВоВременноеХранилище(СписокЗаданий_Таблица, Новый УникальныйИдентификатор);
	Объект.СписокЗаданий_ТекСтрока = 1;
	Объект.СписокЗаданий_ТекСтраница = 1;
	Объект.СписокЗаданий_КоличествоСтрок = СписокЗаданий_Таблица.Количество();
	Объект.СписокЗаданий_КоличествоСтраниц = Цел(Объект.СписокЗаданий_КоличествоСтрок / КоличествоСтрокЗаданий);
	
	Если Цел(Объект.СписокЗаданий_КоличествоСтрок / КоличествоСтрокЗаданий) < Объект.СписокЗаданий_КоличествоСтрок / КоличествоСтрокЗаданий Тогда
		Объект.СписокЗаданий_КоличествоСтраниц = Объект.СписокЗаданий_КоличествоСтраниц + 1;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СписокЗаданий_Вывести()
	
	СписокЗаданий.Очистить();
	СписокЗаданий_Таблица = ПолучитьИзВременногоХранилища(Объект.СписокЗаданий_Адрес);		
	
	Макет = Обработки.АРМ_Водитель.ПолучитьМакет("СписокЗаданий");
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	СписокЗаданий.Вывести(ОбластьМакета);
	
	Если Объект.СписокЗаданий_ТекСтраница > Объект.СписокЗаданий_КоличествоСтраниц Тогда
		Объект.СписокЗаданий_ТекСтраница = 1;
	ИначеЕсли Объект.СписокЗаданий_ТекСтраница < 1 Тогда
		Объект.СписокЗаданий_ТекСтраница = Объект.СписокЗаданий_КоличествоСтраниц;
	КонецЕсли;
	
	Элементы.СписокЗаданий_ТекСтраницаПредставление.Заголовок = "" + Объект.СписокЗаданий_ТекСтраница + " из " + Объект.СписокЗаданий_КоличествоСтраниц;
	Элементы.СписокЗаданий_Меньше.Доступность = НЕ (Объект.СписокЗаданий_КоличествоСтраниц = 1 Или Объект.СписокЗаданий_ТекСтраница = 1);
	Элементы.СписокЗаданий_Больше.Доступность = НЕ (Объект.СписокЗаданий_КоличествоСтраниц = 1 Или Объект.СписокЗаданий_ТекСтраница = Объект.СписокЗаданий_КоличествоСтраниц);
	
		
	Сч = (Объект.СписокЗаданий_ТекСтраница - 1) * КоличествоСтрокЗаданий;
	
	Для Сч = (Объект.СписокЗаданий_ТекСтраница - 1) * КоличествоСтрокЗаданий По Мин(Объект.СписокЗаданий_КоличествоСтрок - 1, (Объект.СписокЗаданий_ТекСтраница * КоличествоСтрокЗаданий - 1)) Цикл	
		
		ТекЗадание = СписокЗаданий_Таблица[Сч];
		
		ОтменаПоставки = ТекЗадание.Отмена;
		ОплатаНаличными = ТекЗадание.ОплатаНаличными;
		ПриемДенег = ТекЗадание.Деньги;
		НеДоставлен = ТекЗадание.НеДоставлен;
		
		Если ТекЗадание.ЕстьОплата ИЛИ (ТекЗадание.Реализация = NULL И ПриемДенег) ИЛИ НеДоставлен Тогда
			ОбластьМакета = Макет.ПолучитьОбласть("СтрокаОплата");	
		Иначе
			ОбластьМакета = Макет.ПолучитьОбласть(?(ОплатаНаличными, "СтрокаНал","Строка"));
		КонецЕсли;
		
		ОбластьМакета.Параметры.Заполнить(ТекЗадание);
		
		Если ЗначениеЗаполнено(ТекЗадание.ВремяПриемкиТовара) Тогда
			ОбластьМакета.Параметры.Контрагент = Строка(ОбластьМакета.Параметры.Контрагент) + Символы.ПС + "(" + ТекЗадание.ВремяПриемкиТовара + ")"; 
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекЗадание.СуммаПринятоДенег) Тогда
			ОбластьМакета.Параметры.Сумма = Строка(ОбластьМакета.Параметры.Сумма) + Символы.ПС + "(" + ТекЗадание.СуммаПринятоДенег + ")"; 
		КонецЕсли;
		
		Структура = Новый Структура;
		Структура.Вставить("ЗаданиеНаДоставку", ТекЗадание.ЗаданиеНаДоставку);
		Структура.Вставить("Контрагент", ТекЗадание.Контрагент);
		Структура.Вставить("Реализация", ТекЗадание.Реализация);
		Структура.Вставить("Сумма", ТекЗадание.Сумма);
		Структура.Вставить("ЕстьОплата", ТекЗадание.ЕстьОплата);
		Структура.Вставить("ОплатаНаличными", ОплатаНаличными);
		Структура.Вставить("ПриемДенег", ПриемДенег);
		Структура.Вставить("НеДоставлен", НеДоставлен);
		
		Если ТекЗадание.ЕстьОплата Тогда
			
			Если ОтменаПоставки Тогда
				ОбластьМакета.Параметры.Статус = "Поставка была отменена" + ?(ПриемДенег, Символы.ПС + "Деньги приняты", "");
			Иначе
				ОбластьМакета.Параметры.Статус = ?(ОплатаНаличными, "Оплата произведена и передан товар", "Товар передан") + ?(ПриемДенег, Символы.ПС + "Деньги приняты", "");
			КонецЕсли;
			
		ИначеЕсли ТекЗадание.Реализация = NULL Тогда
			ОбластьМакета.Параметры.Статус = ?(ПриемДенег, "Деньги приняты", "Ожидание приема денег");	
		Иначе
			ОбластьМакета.Параметры.Статус = ?(ПриемДенег, "Деньги приняты", ?(НеДоставлен, "Товар не доставлен", "")); 
		КонецЕсли;   		
		
		ОбластьМакета.Параметры.Структура = Структура;
		СписокЗаданий.Вывести(ОбластьМакета);
		
	КонецЦикла;
	
	Если Объект.СписокЗаданий_ТекСтраница = Объект.СписокЗаданий_КоличествоСтраниц Тогда
		
		ОбластьМакета = Макет.ПолучитьОбласть("Итого");
		ОбластьМакета.Параметры.Сумма = СписокЗаданий_Таблица.Итог("СуммаПринятоДенег");
		СписокЗаданий.Вывести(ОбластьМакета);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СписокЗаданий_УстановитьПервуюСтроку()
	
	Объект.СписокЗаданий_ТекСтрока = 1;
	Элементы.СписокЗаданий.ТекущаяОбласть = СписокЗаданий.Область(2, 1, 2, 5);
	СписокЗаданий_ВыделитьСтроку(1);

КонецПроцедуры

&НаКлиенте
Функция СписокЗаданий_ПолучитьКоличествоСтрокНаСтранице()
	
	Если Объект.СписокЗаданий_ТекСтраница = Объект.СписокЗаданий_КоличествоСтраниц Тогда
		Возврат КоличествоСтрокЗаданий - (Объект.СписокЗаданий_КоличествоСтраниц * КоличествоСтрокЗаданий - Объект.СписокЗаданий_КоличествоСтрок);
	Иначе
		Возврат КоличествоСтрокЗаданий;
	КонецЕсли;	

КонецФункции

&НаКлиенте
Процедура СписокЗаданий_Больше(Команда)
	
	Объект.СписокЗаданий_ТекСтраница = Объект.СписокЗаданий_ТекСтраница + 1;
	СписокЗаданий_Вывести();
	СписокЗаданий_УстановитьПервуюСтроку();

КонецПроцедуры

&НаКлиенте
Процедура СписокЗаданий_Меньше(Команда)
	
	Объект.СписокЗаданий_ТекСтраница = Объект.СписокЗаданий_ТекСтраница - 1;
	СписокЗаданий_Вывести();
	СписокЗаданий_УстановитьПервуюСтроку();

КонецПроцедуры

&НаКлиенте
Процедура СписокЗаданий_ВыделитьСтроку(НомерСтроки)	
	
	ОбластьТекущейСтроки = СписокЗаданий.Область(НомерСтроки + 1, 1, НомерСтроки + 1, 6);
	ОбластьТекущейСтроки.ЦветФона = WebЦвета.Желтый; 
	
	Если СписокЗаданий_ПредОбласть = Неопределено Тогда
		СписокЗаданий_ПредОбласть = ОбластьТекущейСтроки;
	ИначеЕсли НЕ СписокЗаданий_ПредОбласть.Имя = ОбластьТекущейСтроки.Имя Тогда  		
		
		Если ОбластьТекущейСтроки.Расшифровка <> Неопределено Тогда
			
			Расш = СписокЗаданий_ПредОбласть.Расшифровка; 		
			
			Если Расш <> Неопределено Тогда
				
				ОплатаНаличными = Расш.ОплатаНаличными;
				СписокЗаданий_ПредОбласть.ЦветФона = ?(Расш.ЕстьОплата ИЛИ (Расш.Реализация = NULL И Расш.ПриемДенег) 
				            ИЛИ Расш.НеДоставлен, WebЦвета.СветлоСерый, ?(ОплатаНаличными, WebЦвета.БледноЗеленый,WebЦвета.Белый));
				
			Иначе
				СписокЗаданий_ПредОбласть.ЦветФона = WebЦвета.Белый;
			КонецЕсли;
			
		Иначе
			СписокЗаданий_ПредОбласть.ЦветФона = WebЦвета.Белый;
		КонецЕсли;	
		
		СписокЗаданий_ПредОбласть = ОбластьТекущейСтроки;
		
	КонецЕсли; 
	
	Если ОбластьТекущейСтроки.Расшифровка <> Неопределено Тогда
		
		Если ОбластьТекущейСтроки.Расшифровка.ЕстьОплата 
			ИЛИ (ОбластьТекущейСтроки.Расшифровка.Реализация = NULL И ОбластьТекущейСтроки.Расшифровка.ПриемДенег) 
			ИЛИ ОбластьТекущейСтроки.Расшифровка.НеДоставлен Тогда
			ОбластьТекущейСтроки.ЦветФона = WebЦвета.СветлоСерый;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры
	
&НаКлиенте
Процедура СписокЗаданийПриАктивизацииОбласти(Элемент)
	
	Объект.СписокЗаданий_ТекСтрока = СписокЗаданий.ТекущаяОбласть.Верх - 1;
	
	Если Объект.СписокЗаданий_ТекСтрока < 1 Или Объект.СписокЗаданий_ТекСтрока > СписокЗаданий_ПолучитьКоличествоСтрокНаСтранице() Тогда
		СписокЗаданий_УстановитьПервуюСтроку();
	Иначе
		СписокЗаданий_ВыделитьСтроку(Объект.СписокЗаданий_ТекСтрока);	
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СписокЗаданийОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Расшифровка.НеДоставлен Тогда
		Возврат;
	ИначеЕсли Расшифровка.ЕстьОплата Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.Страница_ЕстьОплата;
	Иначе  		
				
		Объект.ТекЗадание = Расшифровка.ЗаданиеНаДоставку;
		Объект.ТекКонтрагент = Расшифровка.Контрагент;
		Объект.ТекРеализация = Расшифровка.Реализация;
		Объект.ТекСумма = Расшифровка.Сумма;
		Объект.ТекОстатокВзаиморасчетов = ПолучитьОстатокВзаиморасчетов(Расшифровка.Контрагент, ПолучитьОрганизацию(Расшифровка.Реализация));
		
		УстановитьВидимостьЭлементов();
		
		Если Расшифровка.Реализация = NULL Тогда
			
			Объект.ПриемДенег = Истина;
			ПредСтраница = Элементы.Страница_СписокЗаданий; 
			ОткрытьКлавиатуру(Истина);
			
		Иначе
			
			Объект.РежимРедактирования = Ложь;
			СписокТоваров_ПолучитьТаблицу();
			Элементы.СписокТоваров_ОтменитьПоставку.Доступность = Не ЕстьТоварыСоСтороннегоСклада();
			ПерейтиНаСтраницу("Страница_СписокТоваров");
			СписокТоваров_Вывести();		
			СписокТоваров_ВыделитьСтроку(1);
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

//Список товаров
&НаКлиенте
Процедура СписокТоваров_Назад(Команда)
	
	Элементы.Страницы.ТекущаяСтраница = Элементы.Страница_СписокЗаданий;

КонецПроцедуры

&НаКлиенте
Процедура СписокТоваров_Далее(Команда)
	
	Элементы.ДекорацияСумма3.Заголовок = "" + Объект.ТекСумма + " руб.";
	Объект.КорректировкаРеализации = Истина;      
	
	ПредСтраница = Элементы.Страница_СписокТоваров;
	
	Если Не ОплатаНаличнымиПоКонтрагенту(Объект.ТекРеализация) Тогда
		
		Элементы.Страницы.ТекущаяСтраница = Элементы.Страница_ПодтверждениеПокупкиКорр;
		Элементы.ДекорацияСумма4.Заголовок = "" + Объект.ТекСумма + " руб."
		
	Иначе
		ОткрытьКлавиатуру();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОткрытьКлавиатуру(Деньги = Ложь)

	Объект.ВводимаяСумма = "";  	
	Элементы.Группа11.Видимость = Не Деньги;	
