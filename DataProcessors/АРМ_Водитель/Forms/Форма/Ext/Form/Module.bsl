&НаКлиенте
Процедура ПриИзмененииВводимойСуммы(Цифра = "")
	
	Если Цифра = "" Тогда
		Объект.ВводимаяСумма = "";
	ИначеЕсли Цифра = "," Тогда
		
		Если НЕ Найти(Объект.ВводимаяСумма, ",") Тогда 
			Объект.ВводимаяСумма = Объект.ВводимаяСумма + Цифра;
		КонецЕсли;
		
	ИначеЕсли НЕ Сред(Прав(Объект.ВводимаяСумма, 3), 1, 1) = "," Тогда
		
		Объект.ВводимаяСумма = Объект.ВводимаяСумма + Цифра;
		Объект.ВводимаяСумма = Строка(Число(Объект.ВводимаяСумма));
		
	КонецЕсли;
	
КонецПроцедуры

