	Элементы.ГруппаНаличнаяОплата.Видимость = ОплатаНаличными;
	Элементы.ГруппаБезналичнаяОплата.Видимость = Не ОплатаНаличными;
	
	Элементы.ПодтверждениеПокупкиКорр_Чек.Видимость = ОплатаНаличными;
	Элементы.ПодтверждениеПокупкиКорр.Видимость = Не ОплатаНаличными;
	
	Элементы.ПоказатьГрузовыеМеста.Видимость	=	Истина;
	Элементы.СписокТоваров_ПринятьДеньги.Видимость = ОплатаНаличными;
	
КонецПроцедуры

&НаСервере
Функция ОплатаНаличнымиПоКонтрагенту(Реализация)
	
	Если Реализация = NULL Тогда
		Возврат Ложь;
	Иначе
		
		ОплатаНаличными = (Реализация.Организация = Константы.ОсновнаяОрганизацияДляОплатыНаличнымиДляВодителей.Получить());
		
		Если Не ОплатаНаличными Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
			               |	ЕСТЬNULL(ПродажиОбороты.ЗаказПокупателя.ОплатаНаличными, ЛОЖЬ) КАК ОплатаНаличными
			               |ИЗ
			               |	РегистрНакопления.Продажи.Обороты(, , , ДокументПродажи = &Реализация) КАК ПродажиОбороты";
			
			Запрос.УстановитьПараметр("Реализация", Реализация);
			
			УстановитьПривилегированныйРежим(Истина);
			Выборка = Запрос.Выполнить().Выбрать();
			УстановитьПривилегированныйРежим(Ложь);
			
			Если Выборка.Следующий() Тогда
				ОплатаНаличными = Выборка.ОплатаНаличными;
			Иначе
				ОплатаНаличными = Ложь;
			КонецЕсли;
			
		КонецЕсли;
		
		Возврат ОплатаНаличными;
		
	КонецЕсли;
	
КонецФункции

