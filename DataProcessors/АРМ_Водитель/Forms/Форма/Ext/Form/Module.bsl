&НаКлиенте
Перем ПредСтраница, СписокЗаданий_ПредОбласть, СписокТоваров_ПредОбласть;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	КоличествоСтрокЗаданий = 5;
	КоличествоСтрокТоваров = 5;
	
	Если ЗначениеЗаполнено(ПараметрыСеанса.ТекущийПользователь.ФизЛицо) Тогда
		Объект.ТекВодитель = ПараметрыСеанса.ТекущийПользователь.ФизЛицо;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДанныеИВывестиВТаблицы()
	
	ПолучитьТаблицы();
	
	Если ЗначениеЗаполнено(Объект.Задание) Тогда
		
		СписокЗаданий_ПолучитьТаблицу();
		СписокЗаданий_Вывести();
		
	КонецЕсли;

КонецПроцедуры


&НаСервере
Процедура ПолучитьТаблицы()
	
	Если Не ЗначениеЗаполнено(Объект.ТекДата) Тогда
		Объект.ТекДата = ТекущаяДата();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаданиеНаДоставкуДоставка.Ссылка КАК ЗаданиеНаДоставку,
	|	ЗаданиеНаДоставкуДоставка.Контрагент,
	|	СУММА(ЗаданиеНаДоставкуДоставка.Количество) КАК КоличествоМест,
	|	РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка КАК Реализация,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка.Организация = &ОрганизацияДляПриемаНаличных
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЕСТЬNULL(Реализации_ОплатаНаличными.ОплатаНаличными, ЛОЖЬ)
	|		КОНЕЦ) КАК ОплатаНаличными,
	|	МАКСИМУМ(ЕСТЬNULL(ОчередьПечатиККМ.Отмена, ЛОЖЬ)) КАК Отмена,
	|	МАКСИМУМ(ЕСТЬNULL(ОчередьПечатиККМ.Деньги, ЛОЖЬ)) КАК Деньги,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА НЕ ОчередьПечатиККМ.ДокументЧек ЕСТЬ NULL
	|					И ОчередьПечатиККМ.ДокументЧек <> ЗНАЧЕНИЕ(Документ.ПриходныйКассовыйОрдер.ПустаяСсылка)
	|				ТОГДА ОчередьПечатиККМ.ТекСумма
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СуммаПринятоДенег,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА НЕ НеДоставленныеРеализации.Объект ЕСТЬ NULL
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК НеДоставлен
	|ПОМЕСТИТЬ ЗаданияНаДоставку
	|ИЗ
	|	Документ.ЗаданиеНаДоставку.Доставка КАК ЗаданиеНаДоставкуДоставка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.ДокументыСборкиЗаказов КАК РеализацияТоваровУслугДокументыСборкиЗаказов
	|			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|				ЗначенияСвойствОбъектов.Объект КАК Объект
	|			ИЗ
	|				РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	|			ГДЕ
	|				ЗначенияСвойствОбъектов.Значение В (&НеДоставлен)
	|				И ЗначенияСвойствОбъектов.Свойство = &СтатусДоставки
	|			
	|			СГРУППИРОВАТЬ ПО
	|				ЗначенияСвойствОбъектов.Объект) КАК НеДоставленныеРеализации
	|			ПО РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка = НеДоставленныеРеализации.Объект
	|			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка КАК Реализация,
	|				МАКСИМУМ(ВЫБОР
	|						КОГДА РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка.Организация = &ОрганизацияДляПриемаНаличных
	|							ТОГДА ИСТИНА
	|						ИНАЧЕ ЕСТЬNULL(ПродажиОбороты.ЗаказПокупателя.ОплатаНаличными, ЛОЖЬ)
	|					КОНЕЦ) КАК ОплатаНаличными
	|			ИЗ
	|				Документ.ЗаданиеНаДоставку.Доставка КАК ЗаданиеНаДоставкуДоставка
