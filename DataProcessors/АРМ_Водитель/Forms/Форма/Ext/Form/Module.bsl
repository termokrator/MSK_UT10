&НаСервере
Процедура ЗаполнитьЗаданияДляВыбора()
	
	РезультатЗапроса = ПолучитьИзВременногоХранилища(Объект.ДанныеНакладных_Адрес);
	СписокЗаданий_Таблица = РезультатЗапроса[6].Выгрузить();
	
	НетЗаданий = СписокЗаданий_Таблица.Количество() = 0;
	
	Элементы.ДекорацияОтсутствуютЗадания.Видимость = НетЗаданий;
	Элементы.ДекорацияВыберитеЗадание.Видимость = Не НетЗаданий;
	Элементы.ТаблицаЗаданий.Видимость = НЕ НетЗаданий;
	Элементы.Ок.Видимость = НЕ НетЗаданий;
	
	Если СписокЗаданий_Таблица.Количество() = 1 Тогда
		
		Объект.Задание = СписокЗаданий_Таблица[0].ЗаданиеНаДоставку;
		СписокЗаданий_ПолучитьТаблицу();
		СписокЗаданий_Вывести();
		Элементы.Страницы.ТекущаяСтраница = Элементы.Страница_СписокЗаданий;
		
	ИначеЕсли СписокЗаданий_Таблица.Количество() > 1 Тогда
		
		Для каждого Стр Из СписокЗаданий_Таблица Цикл
			
			НоваяСтрока = ТаблицаЗаданий.Добавить();
			НоваяСтрока.Задание = Стр.ЗаданиеНаДоставку;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

