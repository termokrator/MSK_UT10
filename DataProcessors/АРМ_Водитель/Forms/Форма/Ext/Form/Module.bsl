Процедура СписокТоваров_Вернуть(Команда)
	
	Если Объект.РежимРедактирования Тогда	
		
		Структура = Новый Структура;
		Структура.Вставить("Реализация", Объект.ТекРеализация);
		Структура.Вставить("НомерСтрокиСч", Объект.ТекНомерСтроки);
		Структура.Вставить("Номенклатура", Объект.ТекНоменклатура);
		Стр = Объект.СписокТоваров_Таблица.НайтиСтроки(Структура)[0];
		Стр.ВводимоеКоличество = Стр.Количество;
		
		Элементы.СписокТоваров_УменьшитьКоличество.Доступность = НЕ Стр.ВводимоеКоличество = 0 И НЕ Стр.ЭтоСтороннийСклад;
		Элементы.СписокТоваров_УвеличитьКоличество.Доступность = НЕ Стр.ВводимоеКоличество = Стр.Количество И НЕ Стр.ЭтоСтороннийСклад;
		Элементы.СписокТоваров_Очистить.Доступность = Не Стр.ЭтоСтороннийСклад;
		
		СписокТоваров_Вывести();
		ОбластьТекущейСтроки = СписокТоваров.Область(Объект.ТекНомерСтроки + 1, 1, Объект.ТекНомерСтроки + 1, 5);
		ОбластьТекущейСтроки.ЦветФона = WebЦвета.Голубой;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьГрузовыеМеста(Команда)
	
	Если Элементы.СписокЗаданий.ТекущаяОбласть = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Элементы.СписокЗаданий.ТекущаяОбласть.Расшифровка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Расшифровка	=	Элементы.СписокЗаданий.ТекущаяОбласть.Расшифровка;
	
	Объект.ТекЗадание = Расшифровка.ЗаданиеНаДоставку;
	Объект.ТекКонтрагент = Расшифровка.Контрагент;
	Объект.ТекРеализация = Расшифровка.Реализация;
	Объект.ТекСумма = Расшифровка.Сумма;
	Объект.ТекОстатокВзаиморасчетов = ПолучитьОстатокВзаиморасчетов(Расшифровка.Контрагент, ПолучитьОрганизацию(Расшифровка.Реализация));
	
	Объект.РежимРедактирования = Ложь;
	ГрузовыеМеста_ПолучитьТаблицу();
	ПерейтиНаСтраницу("Страница_ГрузовыеМеста");			
	ГрузовыеМеста_Вывести();		
	
КонецПроцедуры

//Подтверждение покупки
&НаСервере
Процедура ЗаписатьДействие(Безнал = Ложь, Отмена = Ложь, Деньги = Ложь) 
	
	МЗ = РегистрыСведений.ОчередьПечатиККМ.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МЗ, Объект);
	МЗ.ДатаПостановкиВОчередь = ТекущаяДата();
	
	Если Деньги Тогда
		
		МЗ.ДокументЧек = ПолныеПрава.СоздатьПриемДенег(Объект.ТекКонтрагент, Объект.ВводимаяСумма);
		МЗ.ТекСумма = Объект.ВводимаяСумма;
		
	Иначе
		
		МЗ.ДокументЧек = ПолныеПрава.СоздатьРКО(Объект.ТекРеализация, Объект.ТекСумма, Объект.РКО, Объект.КорректировкаРеализации, Объект.СписокТоваров_Таблица, Объект.ТекКонтрагент, Безнал);
		МЗ.ТекСумма = Объект.ТекСумма;	
		
	КонецЕсли;
	
	МЗ.Отмена = Отмена;
	МЗ.Деньги = Деньги;
	
	Если Деньги ИЛИ Объект.РКО Тогда
		МЗ.Обработано = Истина;	
	КонецЕсли;
	
	МЗ.Записать();
	
КонецПроцедуры

