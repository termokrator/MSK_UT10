Процедура ВосстановитьНастройкиРегламентаИзСтруктуры(СохраненнаяНастройка) Экспорт 
	
	СохраненнаяНастройка.Свойство("АКласс"					          , АКласс);
	СохраненнаяНастройка.Свойство("БКласс"					          , БКласс);		
