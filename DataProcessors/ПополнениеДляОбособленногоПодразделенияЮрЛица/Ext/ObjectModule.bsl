Процедура ЗаполнитьКолонкуВЗаказМодуль() Экспорт
	
	КатегорияФилиалаЕ = Справочники.АВСКлассификацияНоменклатуры.E_филиал;
	
	Для Каждого ТекСтр Из Товары Цикл
		ТекСтр.ВЗаказ = 0;
	КонецЦикла;
	
	Для каждого ТекСтр Из Товары Цикл
		
		Если Отсев и ТекСтр.Номенклатура.НеЗаказыватьАвтоматом  Тогда 
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТекСтр.АВС_Москва) Тогда 
			Продолжить;
		КонецЕсли;
		
		Если  Не НеУчитыватьМосковскиеОстатки И (НЕ ЗначениеЗаполнено(ТекСтр.ОстатокДопПоставщика) или ТекСтр.ОстатокДопПоставщика < ТекСтр.Кратность) Тогда
			Продолжить;		
		КонецЕсли; 
		
		Если НеУчитыватьМосковскиеОстатки  Тогда
			ТекСтр.ОстатокДопПоставщика = 10000;
		КонецЕсли; 		
		
		Если ТекСтр.ОставшеесяКоличествоДнейДоПоступления > СкоростьОприходования Тогда
			УжеЗаказаноДляПроверки	=	ТекСтр.УжеЗаказано;
		Иначе
			УжеЗаказаноДляПроверки	=	ТекСтр.УжеЗаказано + ТекСтр.УжеЗаказаноКонтракт;
		КонецЕсли;                                                                                                       
		
		УжеЗаказаноДляПроверки = УжеЗаказаноДляПроверки + ТекСтр.КоличествоНаПриемке; 
		
		A = ТекСтр.Класс = "A";
		B = ТекСтр.Класс = "B";
		C = ТекСтр.Класс = "C";
		D = (ТекСтр.КоличествоРеализаций - ТекСтр.КоличествоВозвратов >= 2);
		
		Если D Тогда	
			
			E = ТекСтр.ОстатокДопПоставщика <= (ТекСтр.МаксОстаток + ТекСтр.МинОстаток) / 2;
			F = (ТекСтр.СвободныйОстаток + УжеЗаказаноДляПроверки) <= (ТекСтр.МаксОстаток + ТекСтр.МинОстаток) / 2;
			G = ТекСтр.СвободныйОстаток <= ТекСтр.МинОстаток;
			H = УжеЗаказаноДляПроверки + ТекСтр.СвободныйОстаток < ТекСтр.МаксОстаток;
			I = ТекСтр.Взаказ > УжеЗаказаноДляПроверки;
			J = НЕ ТекСтр.АВС_Филиал = КатегорияФилиалаЕ; 
			
			K = ((ТекСтр.СвободныйОстаток + УжеЗаказаноДляПроверки) <= ТекСтр.МинОстаток);
			
			Если (A ИЛИ ((B ИЛИ C) и J)) И ((G и H и I) ИЛИ K) Тогда
				ТекСтр.ВЗаказ = МИН(НайтиБлижайщую(ТекСтр.МаксОстаток - УжеЗаказаноДляПроверки - ТекСтр.СвободныйОстаток, ТекСтр.Кратность), ТекСтр.ОстатокДопПоставщика);
			КонецЕсли;
			
		КонецЕсли;		
		
		Если ТекСтр.КратностьМашинокомплекта > 1 И ЗначениеЗаполнено(ТекСтр.УжеЗаказано + ТекСтр.КоличествоНаПриемке) Тогда
			
			ТекСтр.ВЗаказ =	0;
			Продолжить;
			
		КонецЕсли;
		
		Если ПриводитьКМинимальнымУпаковкам И ТекСтр.УпаковкаОтгрузки > 0 И ТекСтр.ВЗаказ > 0 Тогда
			
			Если ТекСтр.ВЗаказ < ТекСтр.УпаковкаОтгрузки Тогда
				
				ТекСтр.ВЗаказ =	ТекСтр.УпаковкаОтгрузки;
				Продолжить;
				
			КонецЕсли;
			
			ТекСтр.ВЗаказ =	?(ТекСтр.ВЗаказ/ТекСтр.УпаковкаОтгрузки - Цел(ТекСтр.ВЗаказ / ТекСтр.УпаковкаОтгрузки) <= 0.2, 
			ТекСтр.УпаковкаОтгрузки * Цел(ТекСтр.ВЗаказ / ТекСтр.УпаковкаОтгрузки) , 
			ТекСтр.УпаковкаОтгрузки * (Цел(ТекСтр.ВЗаказ / ТекСтр.УпаковкаОтгрузки) + 1));
			
		Иначе

			Если НЕ ТекСтр.КратностьМашинокомплекта = 0 Тогда
				
				Если ТекСтр.ВЗаказ <= ТекСтр.МаксОстаток Тогда
					
					ТекСтр.ВЗаказ =	ОкруглитьДоКратностиМашиноклмплекта(ТекСтр.СвободныйОстаток, 
					ТекСтр.ВЗаказ,
					ТекСтр.КратностьМашинокомплекта);
					
				КонецЕсли;
				
				Если ТекСтр.ВЗаказ >=  ТекСтр.МаксОстаток Тогда
					
					ТекСтр.ВЗаказ = ОкруглитьДоКратностиМашиноклмплектаНовыйВариант(ТекСтр.СвободныйОстаток, 
					ТекСтр.ВЗаказ, 
					ТекСтр.УжеЗаказано, 
					ТекСтр.КоличествоНаПриемке, 
					ТекСтр.КратностьМашинокомплекта,
					ТекСтр.МаксОстаток);
					
				КонецЕсли;
				
			КонецЕсли;

		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ОкруглитьДоКратностиМашиноклмплекта(СВОС, ПЗЗ, МАШ) Экспорт 

	ВЗаказОкругленный =	ПЗЗ;
	
	Если НЕ МАШ = 0 Тогда
		
		ВЗаказОкругленный = ?(СВОС = 1 И ПЗЗ = 0, ПЗЗ + МАШ - СВОС, 
		?((НЕ СВОС = 1) и ПЗЗ = 0, 0,
		МАШ * (ЦЕЛ(ПЗЗ + МАШ)/МАШ) + ?((ПЗЗ + МАШ) % МАШ = 0, 0, МАШ - (ПЗЗ + МАШ) % МАШ)
		)
		);
		
	КонецЕсли;
	
	Возврат ВЗаказОкругленный  

КонецФункции

Функция ОкруглитьДоКратностиМашиноклмплектаНовыйВариант(СвободныйОстаток, ВЗаказ, УжеЗаказано, КоличествоНаПриемке, КратностьМашинокомплекта, МаксОстаток) Экспорт

	КратностьМаксОстатка = МаксОстаток / КратностьМашинокомплекта; 
	МаксОстатокКратноМакшинокомплекту  = ?(Цел(КратностьМаксОстатка) = КратностьМаксОстатка, КратностьМаксОстатка, Цел(КратностьМаксОстатка) + 1) * КратностьМашинокомплекта;
	ПромКолВPаказ  = МаксОстатокКратноМакшинокомплекту - СвободныйОстаток - УжеЗаказано - КоличествоНаПриемке;
	Возврат ?(ПромКолВPаказ < 0, 0, ПромКолВPаказ);

КонецФункции

Функция ПолучитьДоговорКонтрагента(Контрагент)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Владелец,
	|	ДоговорыКонтрагентов.Ссылка
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.Владелец = &Владелец
	|	И ДоговорыКонтрагентов.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком)
	|	И НЕ ДоговорыКонтрагентов.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Владелец", Контрагент);
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Количество() > 1 Тогда 
		
		ФормаВыбора = Справочники.ДоговорыКонтрагентов.ПолучитьФормуВыбора("ФормаВыбора", ,);
		ФормаВыбора.Отбор.Владелец.ВидСравнения = ВидСравнения.Равно;
		ФормаВыбора.Отбор.Владелец.Значение = Контрагент;
		ФормаВыбора.Отбор.Владелец.Использование = Истина;
		
		ФормаВыбора.Отбор.ВидДоговора.ВидСравнения = ВидСравнения.Равно;
		ФормаВыбора.Отбор.ВидДоговора.Значение = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком;
		ФормаВыбора.Отбор.ВидДоговора.Использование = Истина;
		
		Результат = ФормаВыбора.ОткрытьМодально();
		
		Если Результат = Неопределено Тогда
			Результат = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();	
		КонецЕсли; 		
		
	ИначеЕсли РезультатЗапроса.Количество() = 1 Тогда
		
		РезультатЗапроса.Следующий();
		Результат = РезультатЗапроса.Ссылка;
		
	КонецЕсли; 
	
	Возврат Результат;	  

КонецФункции

Процедура ЗаполнитьСекциюВТаблицеМодуль() Экспорт  

	ПромТовары = Товары.Выгрузить();
	
	Если СозданиеЗаказовГруппыИСекции.Количество() > 0 И СозданиеЗаказовНастройкиСекций.Количество() > 0 И НЕ ПрямойКонтракт Тогда
		
		Для Каждого СтрокаТовары Из ПромТовары Цикл
			
			Если СтрокаТовары.ГорючиеЖидкости Тогда 
				СтрокаТовары.Секция = "Def";
			Иначе
				
				ЕстьНастройкаДляГруппыАВС = СозданиеЗаказовГруппыИСекции.Найти(СтрокаТовары.АВС_Филиал, "ГруппаАВСФилиала");
				
				Если НЕ ЕстьНастройкаДляГруппыАВС = Неопределено Тогда
					СтрокаТовары.Секция = ЕстьНастройкаДляГруппыАВС.Секция;
				Иначе
					СтрокаТовары.Секция = "Def"; 
				КонецЕсли;
				
			КонецЕсли;

		КонецЦикла;
		
	Иначе
		ПромТовары.ЗаполнитьЗначения("Def", "Секция");		
	КонецЕсли;	
	
	Товары.Загрузить(ПромТовары);

КонецПроцедуры