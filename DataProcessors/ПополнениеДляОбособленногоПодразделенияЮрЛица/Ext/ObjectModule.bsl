
Процедура УстановитьЗначениеABC(НомерСтроки, ИмяПоляПоиска, ЗначениеABC, ИмяКолонкиТабПоля, ГруппаПроцентов, ТекущееКоличество)

	ТоварыСтрока = Товары.Найти(НомерСтроки, ИмяПоляПоиска);			
	
	Если ЗначениеЗаполнено(ТоварыСтрока) Тогда
		ТоварыСтрока[ИмяКолонкиТабПоля] = ЗначениеABC;				
	КонецЕсли; 
	
	ГруппаПроцентов = ГруппаПроцентов - МИН(ГруппаПроцентов, ТекущееКоличество);

КонецПроцедуры

Процедура РассчитатьABCВнутриПроизводителя(ТЗ, ИтогиПоГруппамТоваровТЗ) Экспорт

	ТЗ.Сортировать("ГруппаТоваров Возр,  КоличествоПродано Убыв");	
	
	Для каждого СтрокаИтоги Из ИтогиПоГруппамТоваровТЗ Цикл
		
		ГруппаПроцентов1 = Окр(СтрокаИтоги.КоличествоПродано * АКласс / 100,0,0);
		ГруппаПроцентов2 = Окр(СтрокаИтоги.КоличествоПродано * БКласс / 100,0,0);
		ГруппаПроцентов3 = Окр(СтрокаИтоги.КоличествоПродано * СКласс / 100,0,0);							
		
		Отбор = Новый Структура;
		Отбор.Вставить("ГруппаТоваров", СтрокаИтоги.ГруппаТоваров);
		ОтборСтроки = ТЗ.НайтиСтроки(Отбор);
		
		Для каждого Стр Из ОтборСтроки Цикл
			
			Если ГруппаПроцентов1 > 0 Тогда 			
				
				УстановитьЗначениеABC(Стр.НомерСтроки, "НомерСтроки", "A", "ABCВнутриПроизводителя", ГруппаПроцентов1, Стр.КоличествоПродано); 			
				Продолжить;
				
			КонецЕсли;
			
			Если ГруппаПроцентов2 > 0 Тогда 
				
				УстановитьЗначениеABC(Стр.НомерСтроки, "НомерСтроки", "B", "ABCВнутриПроизводителя", ГруппаПроцентов2, Стр.КоличествоПродано);			
				Продолжить;
				
			КонецЕсли;
			
			Если ГруппаПроцентов3 > 0 Тогда 
				
				УстановитьЗначениеABC(Стр.НомерСтроки, "НомерСтроки", "C", "ABCВнутриПроизводителя", ГруппаПроцентов3, Стр.КоличествоПродано);						
				Продолжить;
				
			КонецЕсли;
			
			Если ГруппаПроцентов3 <= 0 И ГруппаПроцентов2  <= 0 И ГруппаПроцентов1  <= 0 Тогда
				
				УстановитьЗначениеABC(Стр.НомерСтроки, "НомерСтроки", "C", "ABCВнутриПроизводителя", ГруппаПроцентов3, Стр.КоличествоПродано);						
				Продолжить;
				
			КонецЕсли; 
			
		КонецЦикла; 
		
	КонецЦикла; 

КонецПроцедуры

