Процедура РегламентноеВыполнение() Экспорт
	
	СтруктураНастройки = Новый Структура;
	СтруктураНастройки.Вставить("Пользователь", Справочники.Пользователи.НайтиПоКоду("webadmin"));
	СтруктураНастройки.Вставить("ИмяОбъекта", "ОбработкаОбъект.ПополнениеДляОбособленногоПодразделенияЮрЛица");	
	СтруктураНастройки.Вставить("НаименованиеНастройки", "ПополнениеДляОбособленногоПодразделенияЮрЛицаРегламентное");
	
	Если УниверсальныеМеханизмы.ПолучитьНастройку(СтруктураНастройки) Тогда
		
		ЭтотОбъект.мТекущаяНастройка = СтруктураНастройки;
		ВосстановитьНастройкиРегламентаИзСтруктуры(СтруктураНастройки.СохраненнаяНастройка);
		
		КонПериода	  = ТекущаяДата();		
		НачПериода    = КонПериода - 86400 * (КоличествоДнейПериода - 1);
		
		ИнициироватьПостроительДляОтбора(ПостроительОтчета);
		
		ВыполнитьЗапрос();
		
		ЗаполнитьКолонкуВЗаказМодуль();
		
		МассивНовыхДокументов = Новый Массив;
		
		Если Не ПрямойКонтракт Тогда
			
			Если Константы.ГорючиеЖидкостиВОтдельныйЗаказ.Получить() Тогда
				
				Если ИсключатьНегабарит Тогда
					
					СоздатьДокументыМодуль(Ложь, МассивНовыхДокументов, Истина, Ложь);
					СоздатьДокументыМодуль(Ложь, МассивНовыхДокументов, Истина, Истина);
					СоздатьДокументыМодуль(Истина, МассивНовыхДокументов, Истина); 
					
				Иначе
					
					СоздатьДокументыМодуль(Неопределено, МассивНовыхДокументов, Истина, Ложь);
					СоздатьДокументыМодуль(Неопределено, МассивНовыхДокументов, Истина, Истина);
					
				КонецЕсли;		
				
			Иначе		
				
				Если ИсключатьНегабарит Тогда
					
					СоздатьДокументыМодуль(Ложь, МассивНовыхДокументов);
					СоздатьДокументыМодуль(Истина, МассивНовыхДокументов); 
					
				Иначе
					СоздатьДокументыМодуль(Неопределено, МассивНовыхДокументов);
				КонецЕсли; 
				
			КонецЕсли; 
			
			Если НЕ МассивНовыхДокументов.Количество() = 0 Тогда
				
				Для Каждого СтрокаМассиваНовыхДокументов Из МассивНовыхДокументов Цикл
					
					Если СтрокаМассиваНовыхДокументов.Проведен Тогда
						РаботаСАвардой.ОтправитьЗаказВЦСВАварду(СтрокаМассиваНовыхДокументов.Ссылка);	
					КонецЕсли; 
					
				КонецЦикла;
				
			КонецЕсли;
			
		Иначе
			
			Если ИсключатьНегабарит Тогда
				
				СоздатьДокументыМодуль(Ложь, МассивНовыхДокументов);
				СоздатьДокументыМодуль(Истина, МассивНовыхДокументов); 
				
			Иначе
				СоздатьДокументыМодуль(Неопределено,МассивНовыхДокументов);
			КонецЕсли;					
			
		КонецЕсли;

	Иначе
		
		ЗаписьЖурналаРегистрации("Обработка.Заказ поставщику об.подр.", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Не заполнены настройки для регламентного выполнения"); 
		
	КонецЕсли;

КонецПроцедуры

Процедура СоздатьДокументыМодуль(мНегабарит = Неопределено, МассивНовыхДокументов, ЭтоРегламент = Ложь, ЗаказНаГорючиеЖидкости = Ложь) Экспорт
	
	ЗаполнитьСекциюВТаблицеМодуль();  
	
	Если КолСтрок = 0 Тогда 
		КолСтрок = 200;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Если Не ПрямойКонтракт Тогда
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	*
		|ПОМЕСТИТЬ ТаблицаТовары
		|ИЗ
		|	&ТаблицаТовары КАК ТаблицаТовары
		|ГДЕ
		|	ТаблицаТовары.ВЗаказ > 0 ";
		
		Если Константы.ГорючиеЖидкостиВОтдельныйЗаказ.Получить() И НЕ ЗаказНаГорючиеЖидкости Тогда
			
			Запрос.Текст = Запрос.Текст +
			"  И НЕ ТаблицаТовары.ГорючиеЖидкости "; 
			
			Если НЕ мНегабарит = Неопределено Тогда
				
				Запрос.Текст = Запрос.Текст +
				"  И ТаблицаТовары.Негабарит = &Негабарит ";
				Запрос.УстановитьПараметр("Негабарит", мНегабарит);
				
			КонецЕсли; 
			
		ИначеЕсли Константы.ГорючиеЖидкостиВОтдельныйЗаказ.Получить() И ЗаказНаГорючиеЖидкости Тогда
			
			Запрос.Текст = Запрос.Текст +
			"  И ТаблицаТовары.ГорючиеЖидкости ";
			
		Иначе
			
			Если НЕ мНегабарит = Неопределено Тогда
				
				Запрос.Текст = Запрос.Текст +
				"  И ТаблицаТовары.Негабарит = &Негабарит ";
				Запрос.УстановитьПараметр("Негабарит",мНегабарит);
				
			КонецЕсли; 		
			
		КонецЕсли; 
		
	Иначе
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	*
		|ПОМЕСТИТЬ ТаблицаТовары
		|ИЗ
		|	&ТаблицаТовары КАК ТаблицаТовары
		|ГДЕ
		|	ТаблицаТовары.ВЗаказ > 0 ";
		
		Если НЕ мНегабарит = Неопределено Тогда
			
			Запрос.Текст = Запрос.Текст +
			"  И ТаблицаТовары.Негабарит = &Негабарит ";
			Запрос.УстановитьПараметр("Негабарит",мНегабарит);
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	Запрос.Текст = Запрос.Текст + "	
	|
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	*
	|ИЗ
	|	ТаблицаТовары КАК ТаблицаТовары";
	
	Запрос.УстановитьПараметр("ТаблицаТовары",	Товары.Выгрузить());
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		
		#Если Клиент Тогда
			Предупреждение("Нет строк для переноса в документ!", 20);
		#КонецЕсли
		
		Возврат;
		
	Иначе	
		
		ПромТаблСекций = СозданиеЗаказовНастройкиСекций.Выгрузить();
		НоваяСтрокаПромТаблСекций						   = ПромТаблСекций.Добавить();
		НоваяСтрокаПромТаблСекций.Секция				   = "Def";
		НоваяСтрокаПромТаблСекций.КоличествоСтрокВЗаказе   = КолСтрок;
		НоваяСтрокаПромТаблСекций.КоэффициентОкругления	   = 0.5;
	
		ДатаДокумента = ?(ДатаДокумента=Дата(1, 1, 1), ТекущаяДата(), ДатаДокумента);
		
		Если ПрямойКонтракт И Не Поставщик.Пустая() Тогда
			Контрагент = Поставщик;
		Иначе
			Контрагент = Константы.ДопПоставщик.Получить();
		КонецЕсли; 
		
		ДоговорКонтагента = Контрагент.ОсновнойДоговорКонтрагента;
		
		
		Если ДоговорКонтагента.Пустая() ИЛИ НЕ ДоговорКонтагента.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком Тогда
			ДоговорКонтагента = ПолучитьДоговорКонтрагента(Контрагент);
		КонецЕсли;
		
		Если ДоговорКонтагента.Пустая() Или НЕ ДоговорКонтагента.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком Тогда
			
			#Если Клиент Тогда
				Сообщить("Договор вида ""С Поставщиком"" у контрагента " + """" + Контрагент + """ отсутствует или не выбран.", СтатусСообщения.ОченьВажное);			
			#КонецЕсли
			
			Возврат;
			
		КонецЕсли; 
		
		Склад = Константы.ОсновнойСклад.Получить();

		ВыборкаЗапроса = Результат.Выгрузить();
		
		Для Каждого СтрокаТаблСекций Из ПромТаблСекций Цикл
			
			СтрокВДокументе 	= 0; 
			ТекТовар 			= 0;
			
			ВыборкаПоСекции = ВыборкаЗапроса.НайтиСтроки(Новый Структура("Секция", СтрокаТаблСекций.Секция));
			
			КоличествоТоваровВВыборке = ВыборкаПоСекции.Количество();
			КолСтрокДляСекции		  = СтрокаТаблСекций.КоличествоСтрокВЗаказе;
			ПромКолСтрокДляСекции	  = КоличествоТоваровВВыборке / ?(СтрокаТаблСекций.КоличествоСтрокВЗаказе = 0, КолСтрок, СтрокаТаблСекций.КоличествоСтрокВЗаказе);  		
			ДробнаяЧастьКолСтрок  	  = ПромКолСтрокДляСекции - Цел(ПромКолСтрокДляСекции);
			
			Если ДробнаяЧастьКолСтрок < СтрокаТаблСекций.КоэффициентОкругления Тогда
				КолСтрокДляСекции = Окр(КоличествоТоваровВВыборке / ?(Цел(ПромКолСтрокДляСекции) = 0, 1, Цел(ПромКолСтрокДляСекции)), 0, РежимОкругления.Окр15как20); 
			Иначе
				КолСтрокДляСекции = Окр(КоличествоТоваровВВыборке / Окр(ПромКолСтрокДляСекции, 0, РежимОкругления.Окр15как20), 0, РежимОкругления.Окр15как20);
			КонецЕсли;

			НовыйДокумент = Документы.ЗаказПоставщику.СоздатьДокумент();
			
			Если Константы.ГорючиеЖидкостиВОтдельныйЗаказ.Получить() И ЗаказНаГорючиеЖидкости Тогда
				НовыйДокумент.ГорючиеЖидкости = Истина;
			КонецЕсли;		
			
			Для Каждого Выборка Из ВыборкаПоСекции Цикл 
				
				ТекТовар 		= ТекТовар+1;
				СтрокВДокументе	= СтрокВДокументе+1;
				
				НоваяСтрокаТЧ 					= НовыйДокумент.Товары.Добавить();
				НоваяСтрокаТЧ.Номенклатура 		= Выборка.Номенклатура;
				НоваяСтрокаТЧ.ЕдиницаИзмерения 	= НоваяСтрокаТЧ.Номенклатура.ЕдиницаХраненияОстатков;
				НоваяСтрокаТЧ.Количество 		= Выборка.ВЗаказ;
				НоваяСтрокаТЧ.Коэффициент 		= НоваяСтрокаТЧ.ЕдиницаИзмерения.Коэффициент;
				//+Гавриленков В. 19.12.2025 #UT10-5598
				//НоваяСтрокаТЧ.СтавкаНДС 		= НоваяСтрокаТЧ.Номенклатура.СтавкаНДС;
				НоваяСтрокаТЧ.СтавкаНДС 		= УчетНДС.ПолучитьСтавкуНДСПоНоменклатуре(НоваяСтрокаТЧ.Номенклатура, НовыйДокумент.Дата);
				//-Гавриленков В. 19.12.2025 #UT10-5598
				
				СтавкаНДС = УчетНДС.ПолучитьСтавкуНДС(НоваяСтрокаТЧ.СтавкаНДС);			
				
				Если СтрокВДокументе = КолСтрокДляСекции ИЛИ ТекТовар = КоличествоТоваровВВыборке Тогда 
					
					НовыйДокумент.Дата 					= ?(ЭтоРегламент, ТекущаяДата(), ДатаДокумента);
					НовыйДокумент.Контрагент  			= Контрагент;
					НовыйДокумент.ДоговорКонтрагента 	= ДоговорКонтагента; 
					НовыйДокумент.ВалютаДокумента 		= ДоговорКонтагента.ВалютаВзаиморасчетов;
					НовыйДокумент.КурсВзаиморасчетов 	= 1;
					НовыйДокумент.КратностьВзаиморасчетов = 1;
					НовыйДокумент.Организация 			= ДоговорКонтагента.Организация;
					НовыйДокумент.СуммаВключаетНДС 		= Истина;
					НовыйДокумент.УчитыватьНДС 			= Истина;
					НовыйДокумент.Склад 				= Склад;
					
					// применим цену "Закупочная Москворечье " ко всему документу 
					СтруктураЗначений = Новый Структура();
					СтруктураЗначений.Вставить("ТекущийТипЦен"                 , Справочники.ТипыЦенНоменклатурыКонтрагентов.ПустаяСсылка());
					СтруктураЗначений.Вставить("ТекущийВалютаДокумента"        , НовыйДокумент.ВалютаДокумента);
					СтруктураЗначений.Вставить("ТекущийВалютаВзаиморасчетов"   , НовыйДокумент.ВалютаДокумента);
					СтруктураЗначений.Вставить("ТекущийКурсДокумента"          , 1);
					СтруктураЗначений.Вставить("ТекущийКурсВзаиморасчетов"     , 1);
					СтруктураЗначений.Вставить("ТекущийУчитыватьНДС"           , Истина);
					СтруктураЗначений.Вставить("ТекущийСуммаВключаетНДС"       , Истина);
					СтруктураЗначений.Вставить("ПерезаполнитьЦеныПоТипу"       , Истина);
					СтруктураЗначений.Вставить("НовыйТипЦен"                   , Справочники.ТипыЦенНоменклатурыКонтрагентов.НайтиПоКоду("000000001"));
					СтруктураЗначений.Вставить("ПересчитатьЦеныПоВалюте"       , Ложь);
					СтруктураЗначений.Вставить("НовыйВалютаДокумента"          , НовыйДокумент.ВалютаДокумента);
					СтруктураЗначений.Вставить("НовыйКурсДокумента"            , 1);
					СтруктураЗначений.Вставить("НовыйКурсВзаиморасчетов"       , 1);
					СтруктураЗначений.Вставить("НовыйУчитыватьНДС"             , Справочники.ТипыЦенНоменклатурыКонтрагентов.НайтиПоКоду("000000001").ЦенаВключаетНДС);
					СтруктураЗначений.Вставить("НовыйСуммаВключаетНДС"         , Истина);
					
					СпособЗаполненияЦен = Перечисления.СпособыЗаполненияЦен.ПоЦенамНоменклатурыКонтрагентов;
					СтруктураРеквизитовДокумента = Ценообразование.ПолучитьСтруктуруРеквизитовДокументаДляЦенообразования(НовыйДокумент);
					ЗаполнениеДокументов.ИзменитьЦеныВалюту(НовыйДокумент, СпособЗаполненияЦен, СтруктураРеквизитовДокумента, , "Товары", 
					                    Константы.ВалютаРегламентированногоУчета.Получить(), , СтруктураЗначений);
					
					Для Каждого СтрокаТЧ Из НовыйДокумент.Товары Цикл
						
						Если СтрокаТЧ.Цена = 0 Тогда
							
							СтрокаТЧ.Цена = 1 ;
							ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(СтрокаТЧ, НовыйДокумент);
							ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(СтрокаТЧ, НовыйДокумент);						
							
						КонецЕсли;					
						
					КонецЦикла;				
					
					Если ЭтоРегламент Тогда
						НовыйДокумент.Комментарий = "Регламентное пополнение (обособленного подразделения)";
					КонецЕсли;	
					
					Если ДокументыПровести  Тогда
						НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
					Иначе 
						НовыйДокумент.Записать();
					КонецЕсли;
					
					МассивНовыхДокументов.Добавить(НовыйДокумент);
					
					СтрокВДокументе = 0;
					
					Если ТекТовар <> КоличествоТоваровВВыборке Тогда 
						
						НовыйДокумент = Документы.ЗаказПоставщику.СоздатьДокумент();
						
						Если Константы.ГорючиеЖидкостиВОтдельныйЗаказ.Получить() И ЗаказНаГорючиеЖидкости Тогда
							НовыйДокумент.ГорючиеЖидкости = Истина;
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;	
		
	КонецЕсли; 
	
КонецПроцедуры

Процедура ВыполнитьЗапрос() Экспорт 
	
	КоличествоДнейВВыбраномПериоде = (КонецДня(КонПериода) + 1 - НачалоДня(НачПериода)) / 86400;
	СредннейКоличествоДнейВПериоде = Окр(КоличествоДнейВВыбраномПериоде, 0, 1);
	
	// Запрос на продажи за период с сортировкой по убыванию
	Товары.Очистить();
	Запрос = Новый Запрос;
	
	//+Гавриленков В. 18.03.2026 #UT10-5774
	Если УчитыватьВнутренниеПеремещения Тогда
		ТекстЗапросаОграничениеПоНоменклатуре = "";
	Иначе
		ТекстЗапросаОграничениеПоНоменклатуре = " НЕ ДокументПродажи.Грузополучатель.ОформлятьРеализацииКакВнутреннееПеремещение ";
	КонецЕсли;
	//-Гавриленков В. 18.03.2026 #UT10-5774

	Если ГрузополучателиОтборВключить.Количество() > 0 Тогда
		
		МассивГрузополучателей = ГрузополучателиОтборВключить.ВыгрузитьКолонку("Грузополучатель");
		Запрос.УстановитьПараметр("МассивГрузополучателей",МассивГрузополучателей);
		
		Если ТекстЗапросаОграничениеПоНоменклатуре = "" Тогда
			
			ТекстЗапросаОграничениеПоНоменклатуре = " 
			| ДокументПродажи.Грузополучатель В (&МассивГрузополучателей) ";
			
		Иначе
			ТекстЗапросаОграничениеПоНоменклатуре = ТекстЗапросаОграничениеПоНоменклатуре
			+ " И ДокументПродажи.Грузополучатель В (&МассивГрузополучателей) ";
		КонецЕсли;
		
	КонецЕсли;
	
	Если ГрузополучателиОтборИсключить.Количество() > 0 Тогда
		
		МассивГрузополучателейИсключить = ГрузополучателиОтборИсключить.ВыгрузитьКолонку("Грузополучатель");
		Запрос.УстановитьПараметр("МассивГрузополучателейИсключить", МассивГрузополучателейИсключить);
		
		Если ТекстЗапросаОграничениеПоНоменклатуре = "" Тогда
			
			ТекстЗапросаОграничениеПоНоменклатуре = " 
			|			ДокументПродажи.Грузополучатель НЕ В (&МассивГрузополучателейИсключить) ";
			
		Иначе
			ТекстЗапросаОграничениеПоНоменклатуре = ТекстЗапросаОграничениеПоНоменклатуре
			+ " И ДокументПродажи.Грузополучатель НЕ В (&МассивГрузополучателейИсключить) ";
		КонецЕсли;
		
	КонецЕсли;

	Если Отсев Тогда 
		
		//+Гавриленков В. 18.03.2026 #UT10-5774
		Если ТекстЗапросаОграничениеПоНоменклатуре = "" Тогда 
			
			ТекстЗапросаОграничениеПоНоменклатуре = "
			|			 Номенклатура В
			|					(ВЫБРАТЬ
			|						Номенклатура.Ссылка
			|						ИЗ
			|							Справочник.Номенклатура КАК Номенклатура
			|						ГДЕ
			|					НЕ Номенклатура.НеЗаказыватьАвтоматом )";
			
		Иначе
			
			ТекстЗапросаОграничениеПоНоменклатуре = ТекстЗапросаОграничениеПоНоменклатуре +"
			|	         И 
			|			 Номенклатура В
			|					(ВЫБРАТЬ
			|						Номенклатура.Ссылка
			|						ИЗ
			|							Справочник.Номенклатура КАК Номенклатура
			|						ГДЕ
			|					НЕ Номенклатура.НеЗаказыватьАвтоматом )";  
			
		КонецЕсли;
		
	КонецЕсли;
		
	Если БрендыОтборВключить.Количество()> 0 Тогда
		
		МассивБрендов = БрендыОтборВключить.ВыгрузитьКолонку("Бренд");
		Запрос.УстановитьПараметр("МассивБрендов", МассивБрендов);
		
		Если ТекстЗапросаОграничениеПоНоменклатуре = "" Тогда
			
			ТекстЗапросаОграничениеПоНоменклатуре = " 
			|			Номенклатура.Родитель В (&МассивБрендов) ";
			
		Иначе
			
			ТекстЗапросаОграничениеПоНоменклатуре = ТекстЗапросаОграничениеПоНоменклатуре
			+ " И Номенклатура.Родитель В (&МассивБрендов) ";
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если НоменклатурныеГруппыОтборВключить.Количество()> 0 Тогда
		
		МассивНГ = НоменклатурныеГруппыОтборВключить.ВыгрузитьКолонку("НоменклатурнаяГруппа");
		Запрос.УстановитьПараметр("МассивНГ", МассивНГ);
		
		Если ТекстЗапросаОграничениеПоНоменклатуре = "" Тогда
			
			ТекстЗапросаОграничениеПоНоменклатуре = " 
			|			Номенклатура.НоменклатурнаяГруппа В (&МассивНГ) ";
			
		Иначе
			
			ТекстЗапросаОграничениеПоНоменклатуре = ТекстЗапросаОграничениеПоНоменклатуре
			+" И Номенклатура.НоменклатурнаяГруппа В (&МассивНГ) ";
			
		КонецЕсли;

	КонецЕсли;

	
	Если БрендыОтборИсключить.Количество()> 0 Тогда
		
		МассивБрендовИсключить = БрендыОтборИсключить.ВыгрузитьКолонку("Бренд");
		Запрос.УстановитьПараметр("МассивБрендовИсключить", МассивБрендовИсключить);
		
		Если ТекстЗапросаОграничениеПоНоменклатуре = "" Тогда
			
			ТекстЗапросаОграничениеПоНоменклатуре = " 
			|			Номенклатура.Родитель НЕ В (&МассивБрендовИсключить) ";
			
		Иначе
			
			ТекстЗапросаОграничениеПоНоменклатуре = ТекстЗапросаОграничениеПоНоменклатуре
			+" И Номенклатура.Родитель НЕ В (&МассивБрендовИсключить) ";
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если НоменклатурныеГруппыОтборИсключить.Количество()> 0 Тогда
		
		МассивНГИсключить = НоменклатурныеГруппыОтборИсключить.ВыгрузитьКолонку("НоменклатурнаяГруппа");
		Запрос.УстановитьПараметр("МассивНГИсключить", МассивНГИсключить);
		
		Если ТекстЗапросаОграничениеПоНоменклатуре = "" Тогда
			
			ТекстЗапросаОграничениеПоНоменклатуре = " 
			|			Номенклатура.НоменклатурнаяГруппа НЕ В (&МассивНГИсключить) ";
			
		Иначе
			
			ТекстЗапросаОграничениеПоНоменклатуре = ТекстЗапросаОграничениеПоНоменклатуре
			+" И Номенклатура.НоменклатурнаяГруппа НЕ В (&МассивНГИсключить) ";
			
		КонецЕсли;

	КонецЕсли;
	
	ГруппаНоменклатурыУценка = Константы.ГруппаНоменклатурыУценка.Получить(); 
	
	Если Константы.ИспользоватьГруппуНоменклатурыУценка.Получить() и ЗначениеЗаполнено(ГруппаНоменклатурыУценка) Тогда
		
		Если ТекстЗапросаОграничениеПоНоменклатуре = "" Тогда
			ТекстЗапросаУценка = "
			|			НЕ Номенклатура В ИЕРАРХИИ(&Уценка) ";
		Иначе 
			ТекстЗапросаУценка = "
			|			И НЕ Номенклатура В ИЕРАРХИИ(&Уценка) "; 				
		КонецЕсли;
		
		Запрос.УстановитьПараметр("Уценка", ГруппаНоменклатурыУценка);
		
	Иначе
		ТекстЗапросаУценка = "";
	КонецЕсли;
	
	//+Сёмин Р.И. 31.07.2026 #UT10-5981
	Если ГруппыЧЗОтборВключить.Количество() > 0 Тогда
		
		МассивГруппЧЗ = ГруппыЧЗОтборВключить.ВыгрузитьКолонку("ГруппаЧЗ");
		Запрос.УстановитьПараметр("МассивГруппЧЗ", МассивГруппЧЗ);
		
		Если ТекстЗапросаОграничениеПоНоменклатуре = "" Тогда
			
			ТекстЗапросаОграничениеПоНоменклатуре = " 
			|			Номенклатура.ТоварнаяГруппаЧестногоЗнака В (&МассивГруппЧЗ) ";
			
		Иначе
			ТекстЗапросаОграничениеПоНоменклатуре = ТекстЗапросаОграничениеПоНоменклатуре
			+ " И Номенклатура.ТоварнаяГруппаЧестногоЗнака В (&МассивГруппЧЗ) ";
		КонецЕсли;
		
	КонецЕсли;
	
	Если ГруппыЧЗОтборИсключить.Количество() > 0 Тогда
		
		МассивГруппЧЗИсключить = ГруппыЧЗОтборИсключить.ВыгрузитьКолонку("ГруппаЧЗ");
		Запрос.УстановитьПараметр("МассивГруппЧЗИсключить", МассивГруппЧЗИсключить);
		
		Если ТекстЗапросаОграничениеПоНоменклатуре = "" Тогда
			
			ТекстЗапросаОграничениеПоНоменклатуре = " 
			|			Номенклатура.ТоварнаяГруппаЧестногоЗнака НЕ В (&МассивГруппЧЗИсключить) ";
			
		Иначе
			ТекстЗапросаОграничениеПоНоменклатуре = ТекстЗапросаОграничениеПоНоменклатуре
			+ " И Номенклатура.ТоварнаяГруппаЧестногоЗнака НЕ В (&МассивГруппЧЗИсключить) ";
		КонецЕсли;
		
	КонецЕсли;
	//-Сёмин Р.И. 31.07.2026 #UT10-5981
	
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ПродажиОбороты.Номенклатура КАК Номенклатура,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР
	|			КОГДА ПродажиОбороты.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг
	|				ТОГДА ПродажиОбороты.Регистратор.Грузополучатель
	|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|		КОНЕЦ) КАК КоличествоКлиентов
	|ПОМЕСТИТЬ ПродажиКоличествоКлиентов
