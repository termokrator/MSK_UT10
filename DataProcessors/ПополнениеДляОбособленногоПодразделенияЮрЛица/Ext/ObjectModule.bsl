	СохраненнаяНастройка.Свойство("КоличествоРеализацийБолее"	      , КоличествоРеализацийБолее);	
	СохраненнаяНастройка.Свойство("ПриводитьКМинимальнымУпаковкам"    , ПриводитьКМинимальнымУпаковкам);
	СохраненнаяНастройка.Свойство("Отсев"							  , Отсев);
	СохраненнаяНастройка.Свойство("ДокументыПровести"				  , ДокументыПровести);
	СохраненнаяНастройка.Свойство("ИсключатьНегабарит"			      , ИсключатьНегабарит);
	СохраненнаяНастройка.Свойство("ПрямойКонтракт"			          , ПрямойКонтракт);
	СохраненнаяНастройка.Свойство("Поставщик"			              , Поставщик);
	//+Гавриленков В. 18.03.2026 #UT10-5774
	СохраненнаяНастройка.Свойство("УчитыватьВнутренниеПеремещения"    , УчитыватьВнутренниеПеремещения);
	//-Гавриленков В. 18.03.2026 #UT10-5774
	
	ВрБрендыОтборВключить = Неопределено;
	
	Если СохраненнаяНастройка.Свойство("БрендыОтборВключить"		  , ВрБрендыОтборВключить) Тогда
		БрендыОтборВключить.Загрузить(ВрБрендыОтборВключить);
	КонецЕсли;
	
	ВрБрендыОтборИсключить = Неопределено;
	
	Если СохраненнаяНастройка.Свойство("БрендыОтборИсключить"		  , ВрБрендыОтборИсключить) Тогда
		БрендыОтборИсключить.Загрузить(ВрБрендыОтборИсключить);
	КонецЕсли;
	
	ВрНоменклатурныеГруппыОтборВключить = Неопределено;
	
	Если СохраненнаяНастройка.Свойство("НоменклатурныеГруппыОтборВключить" , ВрНоменклатурныеГруппыОтборВключить) Тогда
		НоменклатурныеГруппыОтборВключить.Загрузить(ВрНоменклатурныеГруппыОтборВключить);
	КонецЕсли;
	
	ВрНоменклатурныеГруппыОтборИсключить = Неопределено;
	
	Если СохраненнаяНастройка.Свойство("НоменклатурныеГруппыОтборИсключить"		  , ВрНоменклатурныеГруппыОтборИсключить) Тогда
		НоменклатурныеГруппыОтборИсключить.Загрузить(ВрНоменклатурныеГруппыОтборИсключить);
	КонецЕсли;
	
	ВрПостроительОтчета = Неопределено;
	
	Если СохраненнаяНастройка.Свойство("НастройкаПостроителя"		          , ВрПостроительОтчета) Тогда	
		
		НастройкаПостроителя = ВрПостроительОтчета;
		ИнициироватьПостроительДляОтбора(ПостроительОтчета);
		ПостроительОтчета.УстановитьНастройки(НастройкаПостроителя);
		
	КонецЕсли;
	
	СохраненнаяНастройка.Свойство("ДатаДокумента"					          , ДатаДокумента); 
	
	ВрСозданиеЗаказовГруппыИСекции= Неопределено;
	
	Если СохраненнаяНастройка.Свойство("СозданиеЗаказовГруппыИСекции"		  , ВрСозданиеЗаказовГруппыИСекции) Тогда
		СозданиеЗаказовГруппыИСекции.Загрузить(ВрСозданиеЗаказовГруппыИСекции);
	КонецЕсли;
	
	ВрСозданиеЗаказовНастройкиСекций = Неопределено;
	
	Если СохраненнаяНастройка.Свойство("СозданиеЗаказовНастройкиСекций"		  , ВрСозданиеЗаказовНастройкиСекций) Тогда
		СозданиеЗаказовНастройкиСекций.Загрузить(ВрСозданиеЗаказовНастройкиСекций);
	КонецЕсли;
	
	ВрГрузополучателиОтборВключить = Неопределено;
	
	Если СохраненнаяНастройка.Свойство("ГрузополучателиОтборВключить" , ВрГрузополучателиОтборВключить) Тогда
		ГрузополучателиОтборВключить.Загрузить(ВрГрузополучателиОтборВключить);
	КонецЕсли;
	
	ВрГрузополучателиОтборИсключить = Неопределено;
	
	Если СохраненнаяНастройка.Свойство("ГрузополучателиОтборИсключить"	  , ВрГрузополучателиОтборИсключить) Тогда
		ГрузополучателиОтборИсключить.Загрузить(ВрГрузополучателиОтборИсключить);
	КонецЕсли;
	
	//+Сёмин Р.И. 31.07.2026 #UT10-5981
	ВрГруппыЧЗОтборВключить = Неопределено;
	
	Если СохраненнаяНастройка.Свойство("ГруппыЧЗОтборВключить", ВрГруппыЧЗОтборВключить) Тогда
		ГруппыЧЗОтборВключить.Загрузить(ВрГруппыЧЗОтборВключить);
	КонецЕсли;
	
	ВрГруппыЧЗОтборИсключить = Неопределено;
	
	Если СохраненнаяНастройка.Свойство("ГруппыЧЗОтборИсключить", ВрГруппыЧЗОтборИсключить) Тогда
		ГруппыЧЗОтборИсключить.Загрузить(ВрГруппыЧЗОтборИсключить);
	КонецЕсли;
	//-Сёмин Р.И. 31.07.2026 #UT10-5981
	
КонецПроцедуры

