Процедура РассчитатьМинимальныйИМаксимальнойОстаток(НоваяСтрока, Стр)

	ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
	
	// Теперь минимальный остаток...
	МО = Окр(НоваяСтрока.СреднееКоличествоПродано * (СкоростьОприходования + 1), 0, 1);
	СредГлубПродаж =  Окр(НоваяСтрока.СредняяГлубинаПродаж, 0, 1);
	НужнаяОкругленнаяШтука =  НайтиБлижайщую(МО,СредГлубПродаж);
	Кратность = Окр(НоваяСтрока.Кратность, 0, 1);
	НужнаяОкругленнаяШтука =  НайтиБлижайщую(НужнаяОкругленнаяШтука, Кратность);
	
	Если НужнаяОкругленнаяШтука <= НоваяСтрока.Кратность Тогда 				
		НоваяСтрока.МинОстаток = НоваяСтрока.Кратность;
	Иначе 
		НоваяСтрока.МинОстаток = НайтиБлижайщую(НужнаяОкругленнаяШтука, Кратность, 1);
	КонецЕсли;
	
	// Теперь максимальный остаток...
	Если ЗначениеЗаполнено(Стр.КоличествоДнейВПродаже) Тогда
		
		Если Стр.КоличествоДнейВПродаже >= 100 Тогда
			МО = Окр(НоваяСтрока.СреднееКоличествоПроданоВариант2 * (ГлубинаЗаказа * 7 + СкоростьОприходования), 0, 1);	
		Иначе
			МО = Окр(НоваяСтрока.СреднееКоличествоПродано * (ГлубинаЗаказа * 7 + СкоростьОприходования), 0, 1);
		КонецЕсли;
		
	КонецЕсли;
	
	НужнаяОкругленнаяШтука = МО;
	
	Если НужнаяОкругленнаяШтука <= НоваяСтрока.Кратность Тогда 					
		НоваяСтрока.МаксОстаток = НоваяСтрока.Кратность;
	Иначе 
		
		Кратность = Окр(НоваяСтрока.Кратность, 0, 1);
		НоваяСтрока.МаксОстаток =   НайтиБлижайщую(НужнаяОкругленнаяШтука,Кратность, 2);
		
	КонецЕсли;

КонецПроцедуры

Процедура РасчитатьABCКоличествоПродажи(ТЗ, ГруппаПроцентов1, ГруппаПроцентов2, ГруппаПроцентов3) Экспорт

	Для каждого Стр Из ТЗ Цикл   
		
		НоваяСтрока = Товары.Добавить();
		
		Стр.НомерСтроки = НоваяСтрока.НомерСтроки; 
		
		///-------------------------
		// Расчет xyz
		СреднееКоличествоПроданоВМесяц = (Стр.КоличествоПродано - Стр.КоличествоВозвращенногоТовара) / КоличествоПериодов;
		
		Если СреднееКоличествоПроданоВМесяц <= 0 Тогда 
			
			СреднееКоличествоПроданоВМесяц = 0;
			НоваяСтрока.КоэффициентВариации = 0;
			
		Иначе	
			
			СтандартноеОтклонениеОбъемаПродаж = 0;
			
			Для сч =1 по КоличествоПериодов Цикл
				
				СтандартноеОтклонениеОбъемаПродаж = СтандартноеОтклонениеОбъемаПродаж +
				(Стр["КоличествоОборот" + сч] - СреднееКоличествоПроданоВМесяц) * (Стр["КоличествоОборот" + сч] - СреднееКоличествоПроданоВМесяц);
				
			КонецЦикла;
			
			СтандартноеОтклонениеОбъемаПродаж = СтандартноеОтклонениеОбъемаПродаж / КоличествоПериодов;
			СтандартноеОтклонениеОбъемаПродаж = Sqrt(СтандартноеОтклонениеОбъемаПродаж);
			НоваяСтрока.КоэффициентВариации = Окр(СтандартноеОтклонениеОбъемаПродаж / СреднееКоличествоПроданоВМесяц * 100, 2, РежимОкругления.Окр15как20);
			
			Если НоваяСтрока.КоэффициентВариации  >= 0 и НоваяСтрока.КоэффициентВариации <= Xпараметр Тогда 
				НоваяСтрока.XYZ = "X";
			ИначеЕсли НоваяСтрока.КоэффициентВариации  > Xпараметр и НоваяСтрока.КоэффициентВариации <= Yпараметр Тогда
				НоваяСтрока.XYZ = "Y";					
			Иначе
				НоваяСтрока.XYZ = "Z";	
			КонецЕсли;
			
		КонецЕсли;
		
		// Расчет xyz
		///-------------------------
		
		Если ГруппаПроцентов1 > 0 Тогда 
			
			НоваяСтрока.Класс = "A";
			
			РассчитатьМинимальныйИМаксимальнойОстаток(НоваяСтрока, Стр);
			
			ГруппаПроцентов1 = ГруппаПроцентов1 - МИН(ГруппаПроцентов1, Стр.КоличествоПродано);
			Продолжить;
			
		КонецЕсли;
		
		Если ГруппаПроцентов2 > 0 Тогда 
			
			НоваяСтрока.Класс = "B";
			
			РассчитатьМинимальныйИМаксимальнойОстаток(НоваяСтрока, Стр);
			
			ГруппаПроцентов2 = ГруппаПроцентов2 - МИН(ГруппаПроцентов2, Стр.КоличествоПродано);
			Продолжить;
			
		КонецЕсли;
		
		Если ГруппаПроцентов3 > 0 Тогда 
			
			НоваяСтрока.Класс = "C";
			
			РассчитатьМинимальныйИМаксимальнойОстаток(НоваяСтрока, Стр);
			
			ГруппаПроцентов3 = ГруппаПроцентов3 - МИН(ГруппаПроцентов3, Стр.КоличествоПродано);
			Продолжить;
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Функция НайтиБлижайщую(МО,СредГлубПродаж,Признак = 0) Экспорт
	
	// пояснение на примере:
	// к примеру, МО = 109, СредГлубПродаж = 70, Признак = 0
	// Тогда
	
	Если Признак = 0 Тогда 
		
		КолЦифр = СтрДлина(МО);
		К = Pow(10, КолЦифр - 1);
		
		ППП = Окр(МО /К, 0, 1);           
		ППП = ППП * К;     // 109 -> 100;   находим ППП, равное округленному до старшего разряда МО
		
		Если СредГлубПродаж = 0 ИЛИ СредГлубПродаж > МО Тогда   // если МО маленькое, или СредГлубПродаж нулевое, то возврат МО без всяких преобразований
			Возврат МО;
		КонецЕсли;
		
		
		Если (ППП - СредГлубПродаж ) > СредГлубПродаж * 2 - ППП Тогда 
			
			// Если ППП > 1.5 СредГлубПродаж  // - равносильная запись 
			
			// - округляем МО вверх до минимального кратного СредГлубПродаж числа
			// -140 -70 0 70 (109)-> 140 210 280 350  
			
			Промежуток1 = МО / СредГлубПродаж;
			Промежуток2 = Окр(Промежуток1, 0, 1);
			
			Пока Не Промежуток1 = Промежуток2 Цикл
			
				МО = МО + 1;  
				Промежуток1 = МО / СредГлубПродаж;
				Промежуток2 = Окр(Промежуток1, 0, 1);
				
			КонецЦикла;
			
			Возврат МО;
			
		Иначе 
			
			// If (округленное до старшего разряда МО) <= 1.5 СредГлубПродаж
			
			// - округляем МО вниз до максимального кратного СредГлубПродаж числа
			// -140 -70 0 70 <-(109) 140 210 280 350 - округляем вниз
			
			Промежуток1 = МО / СредГлубПродаж;
			Промежуток2 = Окр(Промежуток1, 0, 1);
			
			Пока Не Промежуток1 = Промежуток2 Цикл
			
				МО = МО - 1;  
				Промежуток1 = МО / СредГлубПродаж;
				Промежуток2 = Окр(Промежуток1, 0, 1);
				
			КонецЦикла;
			
			Возврат МО;
			
		КонецЕсли;
		
	Иначе 
		
		КолЦифр = СтрДлина(МО);
		К = Pow(10, КолЦифр - 1);
		
		ППП = Окр(МО / К, 0, 1);
		ППП = ППП * К;
		
		//Если (	ППП -  СредГлубПродаж ) >   СредГлубПродаж*2-ППП   Тогда 
		
		Если СредГлубПродаж = 0 ИЛИ СредГлубПродаж > МО Тогда 
			Возврат МО;
		КонецЕсли;  
		
		Промежуток1 = МО / СредГлубПродаж;
		Промежуток2 = Окр(Промежуток1, 0, 1); 
		
		Пока Не Промежуток1 = Промежуток2 Цикл
		
			Если Признак = 1 Тогда 
				МО = МО - 1;
			Иначе
				МО = МО + 1;
			КонецЕсли;
			
			Промежуток1 = МО / СредГлубПродаж;
			Промежуток2 = Окр(Промежуток1, 0, 1); 
		
		КонецЦикла;
		
		Возврат МО;
		
	КонецЕсли;                                    
	
КонецФункции

Функция ПроверкаНаДваПервыхСимволаА(АВС_Москва) Экспорт 
	
	ДваПервыхСимволаА = Лев(АВС_Москва, 2);
	ДваПервыхСимволаА2 = Лев(АВС_Москва, 1);
	
	Если Врег(ДваПервыхСимволаА) = ВРег("aa") или Врег(ДваПервыхСимволаА) = ВРег("ab")
		или  Врег(ДваПервыхСимволаА)  = ВРег("nn") или Врег(ДваПервыхСимволаА2) = ВРег("a") Тогда 
		Возврат Истина;
	Иначе 
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция ПроверкаНаДваПервыхСимвола(АВС_Москва) Экспорт
	
	ТретийСимвол = ВРег(Прав(Лев(АВС_Москва, 3), 1));
	ДваПервыхСимвола2 = ВРег(Лев(АВС_Москва, 1));
	
	ПодстрокаПервыхСимволов = "ZRES";
	ПодстрокаТретьихСимволов = "ABCND";
	
	Если Найти(ПодстрокаПервыхСимволов,ДваПервыхСимвола2) = 0 И Найти(ПодстрокаТретьихСимволов,ТретийСимвол) <> 0 Тогда 
		Возврат Истина;
	Иначе 
		Возврат Ложь;
	КонецЕсли;
	
	
КонецФункции

Функция ПроверкаНаПервыйСимвол(АВС_Москва) Экспорт
	
	ПервыйСимвол = Лев(АВС_Москва, 1);
	
	Если Врег(ПервыйСимвол) <> ВРег("z") или Врег(ПервыйСимвол) <> ВРег("r")
		или Врег(ПервыйСимвол) <> ВРег("e") или Врег(ПервыйСимвол) <> ВРег("s") Тогда 
		Возврат Ложь;
	Иначе 
		Возврат Истина;
	КонецЕсли;        
	
КонецФункции

Функция ПроверкаНаДваПервыхСимволаВ(АВС_Москва) Экспорт
	
	ДваПервыхСимволаВ = Лев(АВС_Москва, 2);
	ДваПервыхСимволаВ2 = Лев(АВС_Москва, 1);
	
	Если Врег(ДваПервыхСимволаВ) = ВРег("aa") или Врег(ДваПервыхСимволаВ) = ВРег("ab")
		или Врег(ДваПервыхСимволаВ) = ВРег("bb") или Врег(ДваПервыхСимволаВ) = ВРег("nn") 
		или Врег(ДваПервыхСимволаВ2) = ВРег("c") или Врег(ДваПервыхСимволаВ2) = ВРег("a") или Врег(ДваПервыхСимволаВ2) = ВРег("b") Тогда 
		Возврат Истина;
	Иначе 
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

