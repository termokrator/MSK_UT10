Функция УстановитьСоединениеСFTP(ИмяFTPСервера,ИмяКаталогаСервера) Экспорт
	
	ИмяКаталогаСервера = "";
	ИмяFTPСервера = "";
	ИмяFTPСервера    = НастройкаОбмена.FTPАдресОбмена;
	ИмяКаталогаСервера= "/"+СокрЛП(НастройкаОбмена.ПапкаФайловИзМосквы)+"/";
	Если ПустаяСтрока(ИмяFTPСервера) Тогда
		Возврат "Не задан сервер обмена информацией через FTP";
	КонецЕсли;
	
	Соединение = ВыполнитьFTPПодключениеКСерверу(ИмяFTPСервера);
	Если Соединение = Неопределено Тогда
		Возврат "Не выполнено подключение";
	КонецЕсли;
	
	НаличиеКаталога = ПроверитьНаличиеКаталогаНаFTPСервере(Соединение, ИмяКаталогаСервера);
	Если Не НаличиеКаталога Тогда 
		Возврат "Не найден каталог обмена с Москвой по имени :"+ИмяКаталогаФайлаДляМосквы;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ПроверитьНаличиеКаталогаНаFTPСервере(Соединение, Знач ИмяКаталогаСервера)
	
	Если ПустаяСтрока(ИмяКаталогаСервера) Тогда
		Возврат Истина;
	КонецЕсли;
	
	//надо сначала проверить что сам каталог доступа есть
	Попытка
		
		МассивНайденныхКаталогов = Соединение.НайтиФайлы(ИмяКаталогаСервера, "");
		
	Исключение
		Сообщить("Ошибка при соединении с FTP : " + ИмяКаталогаСервера + " ! ",СтатусСообщения.ОченьВажное);
		// ошибка при подключении к ftp
		//СоздатьЗаписьПротокола("Ошибка при соединении с FTP : " + ИмяКаталогаСервера + " ! " + ОписаниеОшибки(), Перечисления.бит_ОперацияОбменаСПорталом.УстановкаСоединения);
		Возврат Ложь;
		
	КонецПопытки;
	
	Для Каждого НайденныйКаталог Из МассивНайденныхКаталогов Цикл
		
		// если не каталог - то дальше ищем
		Если НЕ НайденныйКаталог.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;
		
		// большие и маленькие буквы считаются различными
		Если НайденныйКаталог.ПолноеИмя + "/" <> ИмяКаталогаСервера Тогда
			Продолжить;
		КонецЕсли;
		
		Возврат Истина;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Процедура ЗаписатьОшибкуВЖурналРЕгистрации(СсылкаОшибки,ТекстОшибки)
	ЗаписьЖурналаРегистрации("Ошибка загрузки банка из Москвы",УровеньЖурналаРегистрации.Ошибка,ЭтотОбъект.Метаданные(),СсылкаОшибки,ТекстОшибки,);
КонецПроцедуры

Функция  Сверка2() Экспорт 
	
	Перем ИмяFTPСервера, ИмяКаталогаСервера;
	
	ОшибкиПодключения = УстановитьСоединениеСFTP(ИмяFTPСервера,ИмяКаталогаСервера);
	Если ОшибкиПодключения <>"" Тогда
		ЗаписатьОшибкуВЖурналРЕгистрации(ЭтотОбъект,"Не удалось подключиться к FTP : "+ОшибкиПодключения);
		Возврат "Не удалось подключиться к FTP : "+ОшибкиПодключения;		
	КонецЕсли; 
	
	МассивНайденныхФайловНаСервере = Соединение.НайтиФайлы(ИмяКаталогаСервера, "Bank_NEW.txt");	
	Для Каждого Файл Из МассивНайденныхФайловНаСервере Цикл
		
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла("txt");
		Попытка
			Соединение.Получить(ИмяКаталогаСервера+"Bank_NEW.txt", ИмяВременногоФайла);
			ПутьКФайлу =  ИмяВременногоФайла;
			РезультатРаботы = Сверка1();
			Возврат РезультатРаботы;
		Исключение 
			ЗаписатьОшибкуВЖурналРЕгистрации(ЭтотОбъект,"Ошибка при копировании файла c FTP ресурса");
			Возврат "Ошибка при копировании файла c FTP ресурса";
		КонецПопытки;
	КонецЦикла;
КонецФункции

