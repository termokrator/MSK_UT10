	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЗ.Дата КАК Дата,
	|	ТЗ.ДатаОкончания КАК ДатаОкончания,
	|	ТЗ.Контрагент КАК Контрагент,
	|	ТЗ.Договор КАК Договор,
	|	ТЗ.Сумма КАК Сумма,
	|	ТЗ.НомерВх КАК НомерВх,
	|	ТЗ.ДатаВх КАК ДатаВх,
	|	ТЗ.НазначениеПлатежа
	|ПОМЕСТИТЬ ТЗ
	|ИЗ
	|	&ТЗ КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТЗ.Дата,
	|	ТЗ.ДатаОкончания,
	|	ТЗ.Контрагент,
	|	ТЗ.Договор,
	|	ТЗ.Сумма,
	|	ТЗ.НомерВх,
	|	ТЗ.ДатаВх,
	|	ТЗ.НазначениеПлатежа
	|ПОМЕСТИТЬ ТЗГрупп
	|ИЗ
	|	ТЗ КАК ТЗ
	|
	|СГРУППИРОВАТЬ ПО
	|	ТЗ.Дата,
	|	ТЗ.ДатаОкончания,
	|	ТЗ.Контрагент,
	|	ТЗ.Сумма,
	|	ТЗ.ДатаВх,
	|	ТЗ.Договор,
	|	ТЗ.НомерВх,
	|	ТЗ.НазначениеПлатежа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТЗГрупп.Дата,
	|	ТЗГрупп.Контрагент,
	|	ТЗГрупп.Договор,
	|	ТЗГрупп.Сумма,
	|	ТЗГрупп.НомерВх,
	|	ТЗГрупп.ДатаВх,
	|	ЕСТЬNULL(ПлатежноеПоручениеВходящее.Ссылка, ЗНАЧЕНИЕ(Документ.ПлатежноеПоручениеВходящее.ПустаяСсылка)) КАК ПлатежноеПоручениеВходящее,
	|	ТЗГрупп.НазначениеПлатежа
	|ПОМЕСТИТЬ Итоговая
	|ИЗ
	|	ТЗГрупп КАК ТЗГрупп
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПлатежноеПоручениеВходящее КАК ПлатежноеПоручениеВходящее
	|		ПО ТЗГрупп.Контрагент = ПлатежноеПоручениеВходящее.Контрагент
	|			И ТЗГрупп.Дата <= ПлатежноеПоручениеВходящее.Дата
	|			И ТЗГрупп.ДатаОкончания >= ПлатежноеПоручениеВходящее.Дата
	|			И ТЗГрупп.Договор = ПлатежноеПоручениеВходящее.ДоговорКонтрагента
	|			И ТЗГрупп.НомерВх = ПлатежноеПоручениеВходящее.НомерВходящегоДокумента
	|			И ТЗГрупп.ДатаВх = ПлатежноеПоручениеВходящее.ДатаВходящегоДокумента
	|			И (ПлатежноеПоручениеВходящее.СозданРуками)
	|			И (ПлатежноеПоручениеВходящее.Проведен)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Итоговая.Дата,
	|	Итоговая.Контрагент,
	|	Итоговая.Договор,
	|	Итоговая.Сумма,
	|	Итоговая.НомерВх,
	|	Итоговая.ДатаВх,
	|	Итоговая.ПлатежноеПоручениеВходящее,
	|	Итоговая.НазначениеПлатежа
	|ИЗ
	|	Итоговая КАК Итоговая
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПлатежноеПоручениеВходящее.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПлатежноеПоручениеВходящее КАК ПлатежноеПоручениеВходящее
	|ГДЕ
	|	НЕ ПлатежноеПоручениеВходящее.ПометкаУдаления
	|	И ПлатежноеПоручениеВходящее.Дата >= &ДатаНачалаВыборки
	|	И ПлатежноеПоручениеВходящее.Дата <= &ДатаОкончанияВыборки
	|	И ПлатежноеПоручениеВходящее.СозданРуками
	|	И НЕ ПлатежноеПоручениеВходящее.Ссылка В
	|				(ВЫБРАТЬ
	|					Итоговая.ПлатежноеПоручениеВходящее
	|				ИЗ
	|					Итоговая КАК Итоговая)";
	
	Запрос.УстановитьПараметр("ТЗ", ТЗ);
	Запрос.УстановитьПараметр("ДатаНачалаВыборки", ДатаНачалаВыборки);
	Запрос.УстановитьПараметр("ДатаОкончанияВыборки", ДатаОкончанияВыборки);
	Результат = Запрос.ВыполнитьПакет();
	
	БылВывод = Ложь;
	
	ДокументыКИзменению = Результат[3].Выгрузить();
	ДокументыКУдалению = Результат[4].Выгрузить();
	Попытка
		ПараметрыСеанса.ГраницыЗапретаИзмененияДанных = Новый ХранилищеЗначения(Неопределено, Новый СжатиеДанных(0));
	Исключение
		ЗаписатьОшибкуВЖурналРЕгистрации(ЭтотОбъект,"Не удалось сдвинуть границу запрета изменения данных . Начало процедуры");
	КонецПопытки;
	
	Для каждого Стр Из ДокументыКУдалению Цикл
		ТекущийОбъект = Стр.Ссылка.ПолучитьОбъект();
		Попытка
			ТекущийОбъект.УстановитьПометкуУдаления(Истина);
			Если Не БылВывод тогда
				БылВывод = Истина;
				
				ЗаписатьОшибкуВЖурналРЕгистрации(ЭтотОбъект,Текст.ПолучитьТекст());
				
			КонецЕсли;
		Исключение
			ЗаписатьОшибкуВЖурналРЕгистрации(ТекущийОбъект.Ссылка,"Пометка на удаление документа "+ОписаниеОшибки());
		КонецПопытки; 		
	КонецЦикла;
	
	
	Для каждого ТекСтр Из ДокументыКИзменению Цикл
		
		Если ЗначениеЗаполнено(ТекСтр.ПлатежноеПоручениеВходящее) Тогда 
			НовыйДокумент = ТекСтр.ПлатежноеПоручениеВходящее.ПолучитьОбъект();
			Если НовыйДокумент.Проведен Тогда
				Попытка
					НовыйДокумент.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				Исключение
					ЗаписатьОшибкуВЖурналРЕгистрации(НовыйДокумент.Ссылка,"Отмена проведения документа "+ОписаниеОшибки());
				КонецПопытки; 
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Для каждого ТекСтр Из ДокументыКИзменению Цикл
		
		Если ЗначениеЗаполнено(ТекСтр.ПлатежноеПоручениеВходящее) Тогда 
			НовыйДокумент = ТекСтр.ПлатежноеПоручениеВходящее.ПолучитьОбъект();
		Иначе
			НовыйДокумент = Документы.ПлатежноеПоручениеВходящее.СоздатьДокумент();
		КонецЕсли;
		
		НовыйДокумент.РасшифровкаПлатежа.Очистить();
		
		НовыйДокумент.Дата 					= КонецДня(ТекСтр.Дата);
		НовыйДокумент.Организация 			= Организация;
		НовыйДокумент.ОтраженоВОперУчете 	= Истина;
		НовыйДокумент.Контрагент 			=  ТекСтр.Контрагент;
		НовыйДокумент.ДоговорКонтрагента 	=  ТекСтр.Договор;
		НовыйДокумент.Оплачено 				= Истина;
		НовыйДокумент.ВалютаДокумента 		= Константы.ВалютаРегламентированногоУчета.Получить();
		НовыйДокумент.КурсДокумента 		= 1;
		НовыйДокумент.КратностьДокумента 	= 1;
		НовыйДокумент.Ответственный 		= ПараметрыСеанса.ТекущийПользователь;
		НовыйДокумент.ДатаОплаты 			= НовыйДокумент.Дата;
		НовыйДокумент.ВидОперации 			= Перечисления.ВидыОперацийПоступлениеБезналичныхДенежныхСредств.ОплатаПокупателя;
		НовыйДокумент.СчетОрганизации 		= Организация.ОсновнойБанковскийСчет;
		НовыйДокумент.СуммаДокумента 		= ТекСтр.Сумма;
		НовыйДокумент.СозданРуками 			= Истина;
		НовыйДокумент.НомерВходящегоДокумента = ТекСтр.НомерВх;
		НовыйДокумент.НазначениеПлатежа = ТекСтр.НазначениеПлатежа ;
		Если Не ПустаяСтрока(ТекСтр.ДатаВх) Тогда 
			НовыйДокумент.ДатаВходящегоДокумента = ТекСтр.ДатаВх;
		Иначе 
			НовыйДокумент.ДатаВходящегоДокумента = НовыйДокумент.Дата;
		КонецЕсли;
		
		Если НЕ ЗаполнятьРасшифровку  ИЛи НЕ ТекСтр.договор.ВестиПоДокументамРасчетовСКонтрагентом Тогда 
			НоваяСтрокаТЧ = НовыйДокумент.РасшифровкаПлатежа.Добавить();
			НоваяСтрокаТЧ.ДоговорКонтрагента 	= ТекСтр.Договор;
			НоваяСтрокаТЧ.СуммаПлатежа 			= ТекСтр.Сумма;
			НоваяСтрокаТЧ.СуммаВзаиморасчетов 	= ТекСтр.Сумма; 
			//+Гавриленков В. 10.12.2025 #UT10-5574
			//НоваяСтрокаТЧ.СтавкаНДС  			= ?(НовыйДокумент.Дата>= Дата("20190101000000"),Перечисления.СтавкиНДС.НДС20,Перечисления.СтавкиНДС.НДС18);
			НоваяСтрокаТЧ.СтавкаНДС  			= ?(НовыйДокумент.Дата >= Дата("20260101000000"), Перечисления.СтавкиНДС.НДС22, ?(НовыйДокумент.Дата >= Дата("20190101000000"), Перечисления.СтавкиНДС.НДС20, Перечисления.СтавкиНДС.НДС18));
			//ЗначениеСтавкиНДС = ?(НоваяСтрокаТЧ.СтавкаНДС = Перечисления.СтавкиНДС.НДС18,18,20); 
			ЗначениеСтавкиНДС = УчетНДС.ПолучитьСтавкуНДС(НоваяСтрокаТЧ.СтавкаНДС);
			//-Гавриленков В. 10.12.2025 #UT10-5574
			НоваяСтрокаТЧ.СуммаНДС  			= НоваяСтрокаТЧ.СуммаПлатежа*ЗначениеСтавкиНДС/(100+ЗначениеСтавкиНДС);
			НоваяСтрокаТЧ.СтатьяДвиженияДенежныхСредств = Справочники.СтатьиДвиженияДенежныхСредств.ОплатаПокупателя;
			НоваяСтрокаТЧ.КурсВзаиморасчетов 	= 1;
			НоваяСтрокаТЧ.КратностьВзаиморасчетов = 1;				
			
		ИначеЕсли  ЗаполнятьРасшифровку  Тогда 
			
			Если ЗначениеЗаполнено(ТекСтр.Договор)  
				И ТекСтр.Договор.ВестиПоДокументамРасчетовСКонтрагентом Тогда 
				
				НовыйДокумент.РасшифровкаПлатежа.Очистить();
				
				СтруктураПараметров = Новый Структура;
				
				СтруктураПараметров.Вставить("Организация"					,НовыйДокумент.Организация);
				СтруктураПараметров.Вставить("Контрагент"					,НовыйДокумент.Контрагент);
				СтруктураПараметров.Вставить("ВалютаДокумента"				,НовыйДокумент.ВалютаДокумента);
				СтруктураПараметров.Вставить("СуммаДокумента"				,НовыйДокумент.СуммаДокумента);
				СтруктураПараметров.Вставить("ДатаДок"						,НовыйДокумент.Дата);
				СтруктураПараметров.Вставить("ВидОперацииДок"				,НовыйДокумент.ВидОперации);
				СтруктураПараметров.Вставить("РасшифровкаПлатежа"			,НовыйДокумент.РасшифровкаПлатежа);
				СтруктураПараметров.Вставить("КурсДокумента"				,1);
				СтруктураПараметров.Вставить("КратностьДокумента"			,1);
				СтруктураПараметров.Вставить("ТипЗадолженности"				,">0");
				СтруктураПараметров.Вставить("Интерактивно"					,Ложь);
				СтруктураПараметров.Вставить("ПлатежПоСуммеВзаиморасчетов"	,Ложь);
				
				СтруктураПараметровАвто = Новый Структура;
				СтруктураПараметровАвто.Вставить("УчитыватьФактическиеЗадолженности" ,Истина);
				СтруктураПараметровАвто.Вставить("УчитыватьОперативныеЗадолженности" ,Ложь);
				СтруктураПараметровАвто.Вставить("ПодбиратьСумму"			    ,Истина);
				СтруктураПараметровАвто.Вставить("ПодборПоСуммеПлатежа"			,Истина);
				СтруктураПараметровАвто.Вставить("СуммаДляПодбора"			    ,НовыйДокумент.СуммаДокумента);
				СтруктураПараметровАвто.Вставить("СпособЗаполнения"			    ,"ФИФО");
				СтруктураПараметровАвто.Вставить("ПоЗаявкам"				    ,Ложь);
				СтруктураПараметровАвто.Вставить("ПодбиратьПланируемыеДвижения"	,Ложь);
				СтруктураПараметровАвто.Вставить("НеПревышатьЗапланированныхЗначений",Ложь);
				СтруктураПараметровАвто.Вставить("ВключенныеВПлатежныйКалендарь",Ложь);
				
				//отбор по конкретному договору 
				Построитель = Новый ПостроительОтчета;
				Построитель.Текст = "ВЫБРАТЬ
				|    ВзаиморасчетыСКонтрагентамиОстатки.ДоговорКонтрагента,
				|    ВзаиморасчетыСКонтрагентамиОстатки.СуммаВзаиморасчетовОстаток,
				|    ВзаиморасчетыСКонтрагентамиОстатки.СуммаУпрОстаток
				|ИЗ
				|    РегистрНакопления.ВзаиморасчетыСКонтрагентами.Остатки(, Контрагент = &Контрагент {(ДоговорКонтрагента).*}) КАК ВзаиморасчетыСКонтрагентамиОстатки";    
				
				ПолеДоговора = Построитель.Отбор.Добавить("ДоговорКонтрагента");
				ПолеДоговора.ВидСравнения = ВидСравнения.Равно;
				ПолеДоговора.Использование = Истина;
				ПолеДоговора.Значение = ТекСтр.Договор;
				ОтборПоДоговорам = Построитель.ПолучитьНастройки();
				
				СтруктураПараметровАвто.Вставить("ОтборПоДоговорам", ОтборПоДоговорам);		
				//**
				
				СтруктураПараметров.Вставить("СтруктураПараметровАвто"		,СтруктураПараметровАвто);
				СтруктураПараметров.Вставить("ФормаОплаты"					,Перечисления.ВидыДенежныхСредств.Безналичные);
				СтруктураПараметров.Вставить("ВидОперацииПлан"				,УправлениеДенежнымиСредствами.ОпределитьВидОперацииПлан(НовыйДокумент.ВидОперации));
				СтруктураПараметров.Вставить("ИмяРегистраПлан"				,"ЗаявкиНаРасходованиеСредств");
				СтруктураПараметров.Вставить("БанковскийСчетКасса"			,НовыйДокумент.СчетОрганизации);
				СтруктураПараметров.Вставить("СсылкаНаДокумент"				,?(НовыйДокумент.Проведен, НовыйДокумент.Ссылка, НовыйДокумент));
				
				УправлениеДенежнымиСредствами.ЗаполнитьРасшифровкуПлатежей(СтруктураПараметров);
				
				Для Каждого СтрокаДокумента Из НовыйДокумент.РасшифровкаПлатежа   Цикл
					
					//+Гавриленков В. 10.12.2025 #UT10-5574
					//СтрокаДокумента.СтавкаНДС= ?(НовыйДокумент.Дата>= Дата("20190101000000"),Перечисления.СтавкиНДС.НДС20,Перечисления.СтавкиНДС.НДС18)  ; 
					СтрокаДокумента.СтавкаНДС = ?(НовыйДокумент.Дата >= Дата("20260101000000"), Перечисления.СтавкиНДС.НДС22, ?(НовыйДокумент.Дата >= Дата("20190101000000"), Перечисления.СтавкиНДС.НДС20 ,Перечисления.СтавкиНДС.НДС18));
					//-Гавриленков В. 10.12.2025 #UT10-5574
					УправлениеДенежнымиСредствами.ЗаполнитьРеквизитыРеглУчета(НовыйДокумент.Ссылка,СтрокаДокумента,СтрокаДокумента.СтавкаНДС);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		НовыйДокумент.Записать(РежимЗаписиДокумента.Запись);		
		Попытка
			НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ЗаписатьОшибкуВЖурналРЕгистрации(НовыйДокумент.Ссылка,"Проведение документа "+ОписаниеОшибки());
		КонецПопытки; 		
	КонецЦикла;
	
	
	Попытка
		ПолныеПрава.УстановитьПараметрГраницыЗапретаИзмененияДанных();  
	Исключение
		ЗаписатьОшибкуВЖурналРЕгистрации(ЭтотОбъект,"Не удалось сдвинуть границу запрета изменения данных . Конец процедуры");
	КонецПопытки;
	
	
	Возврат ТекстОшибки;
	
КонецФункции
