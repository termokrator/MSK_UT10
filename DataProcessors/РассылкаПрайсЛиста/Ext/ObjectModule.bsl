	КонецЦикла;
	
	ТекстЛога = ТекстЛога+Символы.ПС+"Окончание работы обработки : "+ТекущаяДата();
	
КонецПроцедуры	

Процедура ОтправитьКлиенту(ДатаОтчет, ПараметрыОтправки, ДокументКОтправке, УчетнаяЗаписьЭлектроннойПочты, ТекущийКонтрагент, ТекстЛога, Комментарий = "")
	
	Если  НЕ ПараметрыОтправки[0].РассылатьНаФТП  И  НЕ ПараметрыОтправки[0].РассылатьНаПочту Тогда 
		
		ТекстСообщения = "Для клиента "+ТекущийКонтрагент+" на "+ДатаОтчет+" отправка цен не требуется.";
		
		#Если Клиент Тогда
			ТекстЛога = ТекстЛога+Символы.ПС+ТекстСообщения;
		#Иначе
			ЗаписьЖурналаРегистрации("ОбработкаРассылкаПрайсЛистов",УровеньЖурналаРегистрации.Информация,,,ТекстСообщения);
		#КонецЕсли 		
		
		Возврат;
		
	КонецЕсли;
	
	ФорматФайлаПрайсЛиста = ПараметрыОтправки[0].ФорматФайлаПрайса;
		
	Если ЗначениеЗаполнено(ТекущийКонтрагент.СтатичноеИмяДляПрайса) Тогда
		
		ИмяТекущегоФайлаБезРасширения = СокрЛП(ТекущийКонтрагент.СтатичноеИмяДляПрайса);
		ИмяТекущегоФайла = ИмяТекущегоФайлаБезРасширения + ФорматФайлаПрайсЛиста;
		
	Иначе
		
		Если мЭтоКазань Тогда
			
			ИмяТекущегоФайлаБезРасширения = "Price_Moskvorechie_" + Формат(Год(ДатаОтчет), "ЧГ=0") + Прав("0" + Месяц(ДатаОтчет), 2) + Прав("0" + День(ДатаОтчет), 2); 
			ИмяТекущегоФайла = ИмяТекущегоФайлаБезРасширения  +  ФорматФайлаПрайсЛиста;
			
		Иначе
			
			ИмяТекущегоФайлаБезРасширения = "Price_Moskvorechie_" + ?(НЕ мЭтоКазань, ТекущийКонтрагент.Код + "_", "") 
			                   + Формат(Год(ДатаОтчет), "ЧГ=0") + Прав("0" + Месяц(ДатаОтчет), 2) + Прав("0" + День(ДатаОтчет), 2);
			ИмяТекущегоФайла = ИмяТекущегоФайлаБезРасширения + ФорматФайлаПрайсЛиста;
			
		КонецЕсли;
		
	КонецЕсли;

	ИмяТекущегоФайла =СтрЗаменить(ИмяТекущегоФайла, ":", "_");
	ПолноеИмяФайла = КаталогВременныхФайлов() + ИмяТекущегоФайла;
	ПолноеИмяОтправляемогоФайла = ПолноеИмяФайла;
	
	Попытка
		
		Если ПараметрыОтправки[0].ФорматФайлаПрайса = Перечисления.ТипыФайловРассылок.XLSx ИЛИ ПараметрыОтправки[0].ФорматФайлаПрайса = Перечисления.ТипыФайловРассылок.XLS Тогда 
			ДокументКОтправке.Записать(ПолноеИмяФайла, ?(ПараметрыОтправки[0].ФорматФайлаПрайса = Перечисления.ТипыФайловРассылок.XLSx, ТипФайлаТабличногоДокумента.XLSX, ТипФайлаТабличногоДокумента.XLS));   
		ИначеЕсли ПараметрыОтправки[0].ФорматФайлаПрайса = Перечисления.ТипыФайловРассылок.TXT ИЛИ ПараметрыОтправки[0].ФорматФайлаПрайса = Перечисления.ТипыФайловРассылок.CSV Тогда 
			ДокументКОтправке.Записать(ПолноеИмяФайла);
		КонецЕсли;
		
	Исключение
		Возврат;
	КонецПопытки;

	ОтправкаВАрхиве = Ложь;
	
	// архивируем
	Если ПараметрыОтправки.Количество()> 0 Тогда 
		
		Если ПараметрыОтправки[0].АрхивироватьПрайс Тогда

			ПолноеИмяОтправляемогоФайлаОригинал = ПолноеИмяОтправляемогоФайла;
			ОтправкаВАрхиве = Истина;
			ФорматФайлаПрайсЛиста = ".zip";
			ПолноеИмяОтправляемогоФайла = ПолучитьИмяВременногоФайла("zip");
			
			АрхиваФайла = Новый ЗаписьZipФайла(ПолноеИмяОтправляемогоФайла);
			АрхиваФайла.Добавить(ПолноеИмяФайла, РежимСохраненияПутейZIP.СохранятьОтносительныеПути, РежимОбработкиПодкаталоговZIP.НеОбрабатывать);
			АрхиваФайла.Записать();

		КонецЕсли;	
		
	КонецЕсли;
	
	// пытаемся отправить
	Если ПараметрыОтправки[0].АдресЭлектроннойПочтыКонтрагентаДляРассылкиПрайса <>"" Тогда 
		
		Если  НЕ ПараметрыОтправки[0].РассылатьНаПочту Тогда 
			
			ТекстСообщения = "Для клиента "+ТекущийКонтрагент+" на "+ДатаОтчет+" файл с ценами уже был сформирован и отправлен на e-mail.";
			#Если Клиент Тогда
				ТекстЛога = ТекстЛога+Символы.ПС+ТекстСообщения;
			#Иначе
				ЗаписьЖурналаРегистрации("ОбработкаРассылкаПрайсЛистов",УровеньЖурналаРегистрации.Информация,,,ТекстСообщения);
			#КонецЕсли 
			
		Иначе
			
			Профиль = УправлениеЭлектроннойПочтой.ПолучитьИнтернетПочтовыйПрофиль(УчетнаяЗаписьЭлектроннойПочты);
			Почта = Новый ИнтернетПочта; 
			УдалосьПодключиться = Ложь;
			
			Попытка
				
				Почта.Подключиться(Профиль);
				УдалосьПодключиться = Истина;
				
			Исключение
				
				ТекстСообщения = "Не удалось подключиться к учетной записи электронной почты " + УчетнаяЗаписьЭлектроннойПочты;
				#Если Клиент Тогда
					ТекстЛога = ТекстЛога + Символы.ПС + " ERR: " + ТекстСообщения;
				#Иначе
					ЗаписьЖурналаРегистрации("ОбработкаРассылкаПрайсЛистов", УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
				#КонецЕсли 
				
			КонецПопытки;
			
			Сообщение = Новый ИнтернетПочтовоеСообщение;
			Сообщение.Тема = "Прайс-лист(Москворечье) на " + ДатаОтчет;
			МассивАдресов = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(ПараметрыОтправки[0].АдресЭлектроннойПочтыКонтрагентаДляРассылкиПрайса, ";");
			
			Для каждого ТекАдрес Из МассивАдресов Цикл
				Сообщение.Получатели.Добавить(ТекАдрес); 
			КонецЦикла;
			
			Сообщение.Отправитель = УчетнаяЗаписьЭлектроннойПочты.АдресЭлектроннойПочты;
			
			УспешноОтправленПоПочте = Ложь;
			
			Попытка
				
				Файл = Новый Файл(ПолноеИмяОтправляемогоФайла);
				
				Если Файл.Существует() Тогда

					Сообщение.Вложения.Добавить(Новый ДвоичныеДанные(ПолноеИмяОтправляемогоФайла), ИмяТекущегоФайлаБезРасширения + ФорматФайлаПрайсЛиста);
					ЗаписьЖурналаРегистрации("ОбработкаРассылкаПрайсЛистов",УровеньЖурналаРегистрации.Информация,,, "Успешное прикрепление файла: " 
					+ ПолноеИмяОтправляемогоФайла + " формат: " + ПараметрыОтправки[0].ФорматФайлаПрайса);
					Почта.Послать(Сообщение);
					ТекстСообщения = "Отправлено письмо c ценами на дату " + ДатаОтчет + 
					" контрагенту :" + ТекущийКонтрагент + " на адрес " + ПараметрыОтправки[0].АдресЭлектроннойПочтыКонтрагентаДляРассылкиПрайса 
					+ "( формат отравки :" + ПараметрыОтправки[0].ФорматФайлаПрайса + ")";
					
					#Если Клиент Тогда
						ТекстЛога = ТекстЛога + Символы.ПС + " ОК : " + ТекстСообщения;
					#Иначе
						ЗаписьЖурналаРегистрации("ОбработкаРассылкаПрайсЛистов", УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
					#КонецЕсли
					
					УспешноОтправленПоПочте = Истина;
					
				Иначе
					ЗаписьЖурналаРегистрации("ОбработкаРассылкаПрайсЛистов", УровеньЖурналаРегистрации.Ошибка,,,"Отсутствует файл: " + ПолноеИмяОтправляемогоФайла 
					+ " формат: " + ПараметрыОтправки[0].ФорматФайлаПрайса);	
				КонецЕсли; 				
				
			Исключение
				
				ТекстСообщения = "Не удалось отправить письмо с ценами на дату " + ДатаОтчет +
				" контрагенту :" + ТекущийКонтрагент + " на адрес " + ПараметрыОтправки[0].АдресЭлектроннойПочтыКонтрагентаДляРассылкиПрайса + " ошибка:" + ОписаниеОшибки();
				#Если Клиент Тогда
				#Иначе
					ЗаписьЖурналаРегистрации("ОбработкаРассылкаПрайсЛистов", УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
				#КонецЕсли 
				
			КонецПопытки; 			
			
			// фиксируем успешную отправку
			Если УспешноОтправленПоПочте Тогда 
				
				НоваяЗаписьРассылкаДокументов 					= РегистрыСведений.РассылкаДокументов.СоздатьМенеджерЗаписи();
				НоваяЗаписьРассылкаДокументов.Период 			= ТекущаяДата();
				НоваяЗаписьРассылкаДокументов.Контрагент 		= ТекущийКонтрагент;
				НоваяЗаписьРассылкаДокументов.ТипРассылки 		= Перечисления.ТипыРассылокЭлектроннойПочты.ПрайсЛист;
				НоваяЗаписьРассылкаДокументов.ВремяОтправки 	= ТекущаяДата();
				НоваяЗаписьРассылкаДокументов.Комментарий 		= Комментарий;	
				НоваяЗаписьРассылкаДокументов.Записать();		
				
			КонецЕсли;	
			
		КонецЕсли;	
		
	Иначе
		#Если Клиент Тогда
		#Иначе
			ТекстСообщения = "У контрагента " + ТекущийКонтрагент + " не указан e-mail для отправки электронной почты. Письмо отправлено не будет";
			ЗаписьЖурналаРегистрации("ОбработкаРассылкаПрайсЛистов", УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
		#КонецЕсли 		
	КонецЕсли;
	
	// ФТП
	Если ПараметрыОтправки[0].ВыкладыватьПрайсНаФТП Тогда 
		
		Если  НЕ ПараметрыОтправки[0].РассылатьНаФТП Тогда 
			
			ТекстСообщения = "Для клиента " + ТекущийКонтрагент + " на " + ДатаОтчет + " файл с ценами уже был сформирован и отправлен на FTP";
			#Если Клиент Тогда
				ТекстЛога = ТекстЛога + Символы.ПС + ТекстСообщения;
			#Иначе
				ЗаписьЖурналаРегистрации("ОбработкаРассылкаПрайсЛистов", УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
			#КонецЕсли 
			
		Иначе
			
			УдалосьСоединитьсяСФТП = Ложь;
			
			Попытка
				
				СоединениеСFTP = Новый FTPСоединение(ПараметрыОтправки[0].ФТПАдресДляПрайса, Строка(ПараметрыОтправки[0].ФТППортДляПрайса), 
				ПараметрыОтправки[0].ФТПЛогинДляПрайса, ПараметрыОтправки[0].ФТППарольДляПрайса, , Истина);
				УдалосьСоединитьсяСФТП = Истина;
				
			Исключение
				
				ТекстСообщения = "Не удалось подключиться к FTP со следующими параметрами подключения: " + ПараметрыОтправки[0].ФТПАдресДляПрайса + ":" 
				+ ПараметрыОтправки[0].ФТППортДляПрайса + "; login:" + ПараметрыОтправки[0].ФТПЛогинДляПрайса + 
				"; password: " + ПараметрыОтправки[0].ФТППарольДляПрайса + ")";
				
				#Если Клиент Тогда
					ТекстЛога = ТекстЛога + Символы.ПС + " ERR: " + ТекстСообщения;
				#Иначе
					ЗаписьЖурналаРегистрации("ОбработкаРассылкаПрайсЛистов", УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
				#КонецЕсли 			
				
			КонецПопытки;
			
			Если УдалосьСоединитьсяСФТП Тогда 
				
				УспешноОтправленПоФТП = Ложь;
				КаталогНаСервере = ПараметрыОтправки[0].ФТПКаталогДляПрайса;

				Попытка

					СоединениеСFTP.Записать(ПолноеИмяОтправляемогоФайла, ?(ЗначениеЗаполнено(КаталогНаСервере), КаталогНаСервере + "\", "") + ИмяТекущегоФайла);
					ТекстСообщения = "Файл " + ПолноеИмяОтправляемогоФайла + " успешно сохранен на FTP ( параметры подключения к FTP:" 
					+ ПараметрыОтправки[0].ФТПАдресДляПрайса + ":" + ПараметрыОтправки[0].ФТППортДляПрайса 
					+ ?(ЗначениеЗаполнено(КаталогНаСервере), "; каталог: " + КаталогНаСервере, "") 
					+ "; login:" + ПараметрыОтправки[0].ФТПЛогинДляПрайса  
					+ "; password: " + ПараметрыОтправки[0].ФТППарольДляПрайса + ")";
					
					#Если Клиент Тогда
						ТекстЛога = ТекстЛога + Символы.ПС + " ОК : " + ТекстСообщения;
					#Иначе
						ЗаписьЖурналаРегистрации("ОбработкаРассылкаПрайсЛистов", УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
					#КонецЕсли 
					
					УспешноОтправленПоФТП = Истина;
					
				Исключение

					ТекстСообщения = "Не удалось сохранить файл на FTP! ( параметры подключения к FTP:" + ПараметрыОтправки[0].ФТПАдресДляПрайса 
					+ ":" + ПараметрыОтправки[0].ФТППортДляПрайса + ?(ЗначениеЗаполнено(КаталогНаСервере), "; каталог: " + КаталогНаСервере, "")  
					+ "; login:" + ПараметрыОтправки[0].ФТПЛогинДляПрайса 
					+ "; password: " + ПараметрыОтправки[0].ФТППарольДляПрайса + ")";
					
					#Если Клиент Тогда
						ТекстЛога = ТекстЛога + Символы.ПС + " ERR: " + ТекстСообщения;
					#Иначе
						ЗаписьЖурналаРегистрации("ОбработкаРассылкаПрайсЛистов", УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
					#КонецЕсли 			
					
				КонецПопытки;
				
				Если УспешноОтправленПоФТП Тогда 
					
					НоваяЗаписьРассылкаДокументов 					= РегистрыСведений.РассылкаДокументов.СоздатьМенеджерЗаписи();
					НоваяЗаписьРассылкаДокументов.Период 			= ТекущаяДата();
					НоваяЗаписьРассылкаДокументов.Контрагент 		= ТекущийКонтрагент;
					НоваяЗаписьРассылкаДокументов.ТипРассылки 		= Перечисления.ТипыРассылокЭлектроннойПочты.ПрайсЛистНаФТП;
					НоваяЗаписьРассылкаДокументов.ВремяОтправки 	= ТекущаяДата();
					НоваяЗаписьРассылкаДокументов.Записать();
					
				КонецЕсли;				
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Попытка
		УдалитьФайлы(ПолноеИмяОтправляемогоФайла);
	Исключение
	КонецПопытки;

	Если ОтправкаВАрхиве Тогда
		
		Попытка
			УдалитьФайлы(ПолноеИмяОтправляемогоФайлаОригинал);
		Исключение
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры	

Процедура ЗаполнитьТаблицуНастроекКонтрагентов(ОчищатьТаблицу = Истина) Экспорт 
	
	Если ОчищатьТаблицу Тогда 
		НастройкиКонтрагентов.Очистить();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Контрагенты.Ссылка КАК КонтрагентСсылка,
	|	Контрагенты.Наименование КАК КонтрагентНаименование,
	|	Контрагенты.ТипЦеныПрайса,
	|	ЛОЖЬ КАК Изменен,
	|	Контрагенты.ВыкладыватьПрайсНаФТП КАК ВыкладыватьПрайсНаФТП,
	|	Контрагенты.ФТПАдресДляПрайса,
	|	Контрагенты.ФТПКаталогДляПрайса,
	|	Контрагенты.ФТППортДляПрайса,
	|	Контрагенты.ФТПЛогинДляПрайса,
	|	Контрагенты.ФТППарольДляПрайса,
	|	Контрагенты.ФорматФайлаПрайса,
	|	Контрагенты.АрхивироватьПрайс,
	|	Контрагенты.МаксимальныйОстатокДляПрайса,
	|	Контрагенты.РассылатьПрайс,
	|	ЕСТЬNULL(КонтактнаяИнформация.Представление, """") КАК АдресЭлектроннойПочтыКонтрагентаДляРассылкиПрайса,
	|	ИСТИНА КАК СоздатьПрайсИОтослать,
	|	Контрагенты.МаксимальноеКоличествоПрайсовВДень
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|		ПО (КонтактнаяИнформация.Объект = Контрагенты.Ссылка)
	|			И (КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты))
	|			И (КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыКонтрагентаДляРассылкиПрайса))
	|ГДЕ
	|	Контрагенты.РассылатьПрайс
	|
	|УПОРЯДОЧИТЬ ПО
	|	КонтрагентНаименование";
	
	ТаблицаНастроек = Запрос.Выполнить().Выгрузить();
	
	Для каждого Стр Из ТаблицаНастроек Цикл

		НоваяСтрока = ЭтотОбъект.НастройкиКонтрагентов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Стр);

	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьТаблицуОтправленныхПрайсов(ОчищатьТаблицу = Истина) Экспорт 
	
	Если НЕ ЗначениеЗаполнено(НаДату) Тогда 
		Возврат;
	КонецЕсли;	
	
	Если ОчищатьТаблицу Тогда 
		ОтправленныеПрайсы.Очистить();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РассылкаДокументов.Контрагент,
	|	РассылкаДокументов.ТипРассылки,
	|	РассылкаДокументов.ВремяОтправки КАК ВремяОтправки,
	|	РассылкаДокументов.Комментарий
	|ИЗ
	|	РегистрСведений.РассылкаДокументов КАК РассылкаДокументов
	|ГДЕ
	|	РассылкаДокументов.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И (РассылкаДокументов.ТипРассылки = ЗНАЧЕНИЕ(Перечисление.ТипыРассылокЭлектроннойПочты.ПрайсЛист)
	|			ИЛИ РассылкаДокументов.ТипРассылки = ЗНАЧЕНИЕ(Перечисление.ТипыРассылокЭлектроннойПочты.ПрайсЛистНаФТП))
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВремяОтправки";
	
	Запрос.УстановитьПараметр("ДатаНачала",		НачалоДня(НаДату));
	Запрос.УстановитьПараметр("ДатаОкончания",	КонецДня(НаДату));
	
	ТаблицаНастроек = Запрос.Выполнить().Выгрузить();
	
	
	Для каждого Стр Из ТаблицаНастроек Цикл
		
		НоваяСтрока = ЭтотОбъект.ОтправленныеПрайсы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Стр);
		
	КонецЦикла;
	
КонецПроцедуры


