					ПараметрыОтправки.Добавить(СтрКонтрагент);
					
					Если СтрКонтрагент.ФорматФайлаПрайса = Перечисления.ТипыФайловРассылок.XLSx ИЛИ СтрКонтрагент.ФорматФайлаПрайса = Перечисления.ТипыФайловРассылок.XLS Тогда 
						
						ДокументКОтправке = Новый ТабличныйДокумент;
						Макет= ПолучитьМакет("ШаблонПрайса");
						ОбластьМакетаШапка = Макет.ПолучитьОбласть("ШапкаПрайса");
						ОбластьМакетаШапка.Параметры.ЗаголовокПрайса = "Все цены актуальны на " + ДатаОтчет;   
						ДокументКОтправке.Вывести(ОбластьМакетаШапка);
						
					КонецЕсли;
					
					Если СтрКонтрагент.ФорматФайлаПрайса = Перечисления.ТипыФайловРассылок.TXT ИЛИ СтрКонтрагент.ФорматФайлаПрайса = Перечисления.ТипыФайловРассылок.CSV Тогда 
						
						ДокументКОтправке = Новый ТекстовыйДокумент;
						ДокументКОтправке.ДобавитьСтроку("Прайс-лист. Цены актуальны на " + ДатаОтчет);
						ДокументКОтправке.ДобавитьСтроку(
						"Родитель" + Разделитель + 
						"Код производителя" + Разделитель + 
						"Номенклатура" + Разделитель + 
						"Мин.партия(Кратность)" + Разделитель + 
						"Количество" + Разделитель + 
						"Цена, руб" + Разделитель);
						
					КонецЕсли;
					
				КонецЕсли;
				
				Если СтрКонтрагент.РассылатьНаФТП  ИЛИ  СтрКонтрагент.РассылатьНаПочту Тогда 
					
					Если СтрКонтрагент.ФорматФайлаПрайса = Перечисления.ТипыФайловРассылок.XLSx ИЛИ СтрКонтрагент.ФорматФайлаПрайса = Перечисления.ТипыФайловРассылок.XLS Тогда 
						
						ОбластьМакетаСтрока = Макет.ПолучитьОбласть("СтрокаПрайса");
						ОбластьМакетаСтрока.Параметры.Заполнить(СтрКонтрагент);
						
						Если ОтправлятьЦеныМК Тогда
							ОбластьМакетаСтрока.Параметры.Количество =  СтрКонтрагент.КоличествоДляДоговоровСМК;
						КонецЕсли;
						
						Если ОбластьМакетаСтрока.Параметры.Количество > 0 Тогда 
							ДокументКОтправке.Вывести(ОбластьМакетаСтрока);
						КонецЕсли;
						
					КонецЕсли;
					
					Если СтрКонтрагент.ФорматФайлаПрайса = Перечисления.ТипыФайловРассылок.TXT ИЛИ СтрКонтрагент.ФорматФайлаПрайса = Перечисления.ТипыФайловРассылок.CSV Тогда 
						
						ТекКоличество = СтрКонтрагент.Количество;
						
						Если ОтправлятьЦеныМК Тогда
							ТекКоличество = СтрКонтрагент.КоличествоДляДоговоровСМК;
						КонецЕсли;
						
						Если ТекКоличество > 0 Тогда 
							
							ДокументКОтправке.ДобавитьСтроку(
