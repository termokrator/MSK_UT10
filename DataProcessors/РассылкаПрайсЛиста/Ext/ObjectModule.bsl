Перем мЭтоКазань; 

Процедура СформироватьИОтправитьПрайсыМодуль(ТекстЛога, Комментарий = "") Экспорт;
	
	// проверяем, все ли строки сохранены
	ОтборИзмененныхСтрок = Новый Структура("Изменен", Истина);
	НайденныеСтроки = НастройкиКонтрагентов.НайтиСтроки(ОтборИзмененныхСтрок);
	
	Если НайденныеСтроки.Количество()> 0 Тогда
		
		ТекстСообщения = "Имеются несохраненные настройки контрагентов. Необходимо сохранить настройки!";
		#Если Клиент Тогда
			Сообщить(ТекстСообщения,СтатусСообщения.Важное);
		#Иначе
			ЗаписьЖурналаРегистрации("ОбработкаРассылкаПрайсЛистов",УровеньЖурналаРегистрации.Информация,,,ТекстСообщения);
		#КонецЕсли 
		
		Возврат;
		
	КонецЕсли;	
	
	УчетнаяЗаписьЭлектроннойПочты = Константы.ОсновнаяУчетнаяЗаписьЭлектроннойПочты.Получить();
	
	Если НЕ ЗначениеЗаполнено(УчетнаяЗаписьЭлектроннойПочты) Тогда 
		
		ТекстСообщения = "Не заполнена константа основной записи электронной почты!";
		
		#Если Клиент Тогда
			Сообщить(ТекстСообщения,СтатусСообщения.Важное);
		#Иначе
			ЗаписьЖурналаРегистрации("ОбработкаРассылкаПрайсЛистов",УровеньЖурналаРегистрации.Информация,,,ТекстСообщения);
		#КонецЕсли 
		
		Возврат;
		
	КонецЕсли;	
	
	// переменные
	ТекстЛога = "Начало - >> " + ТекущаяДата();
	Разделитель = ";";
	ДатаОтчет = ТекущаяДата(); 
	
	ОтборОтсылаемыхСтрок = Новый Структура("СоздатьПрайсИОтослать", Истина);
	НайденныеСтроки = ЭтотОбъект.НастройкиКонтрагентов.НайтиСтроки(ОтборОтсылаемыхСтрок);
	
	ТабКонтрагентов = НастройкиКонтрагентов.Выгрузить(НайденныеСтроки,
	"КонтрагентСсылка, ТипЦеныПрайса, ВыкладыватьПрайсНаФТП,ФТПАдресДляПрайса,ФТПКаталогДляПрайса,ФТПЛогинДляПрайса,ФТППортДляПрайса,ФТППарольДляПрайса, ФорматФайлаПрайса, АрхивироватьПрайс, МаксимальныйОстатокДляПрайса, АдресЭлектроннойПочтыКонтрагентаДляРассылкиПрайса, МаксимальноеКоличествоПрайсовВДень");
	
	Если ТабКонтрагентов.Количество() = 0 Тогда 
		
		ТекстЛога = ТекстЛога + Символы.ПС + "Нет клиентов для формирования прайс-листов" + Символы.ПС + "Окончание : " + ТекущаяДата();
		Возврат;
		
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц();
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	ОрганизацияМК = Справочники.Организации.ПустаяСсылка();	
	ОрганизацияМСК = Справочники.Организации.ПустаяСсылка();
	
	Если мЭтоКазань Тогда
		
		ОрганизацияМК 	= Константы.ОсновнаяОрганизация.Получить();	
		ОрганизацияМСК 	= Константы.ОсновнаяОрганизацияДляОплатыНаличнымиДляВодителей.Получить();
		
		Запрос.УстановитьПараметр("ОрганизацияМК", ОрганизацияМК);
		Запрос.УстановитьПараметр("ОрганизацияМСК", ОрганизацияМСК);
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТабЗагрузки.КонтрагентСсылка,
		|	ТабЗагрузки.ТипЦеныПрайса КАК ТипЦеныПрайса,
		|	ТабЗагрузки.ВыкладыватьПрайсНаФТП,
		|	ТабЗагрузки.ФТПАдресДляПрайса,
		|	ТабЗагрузки.ФТПКаталогДляПрайса,
		|	ТабЗагрузки.ФТПЛогинДляПрайса,
		|	ТабЗагрузки.ФТППортДляПрайса,
		|	ТабЗагрузки.ФТППарольДляПрайса,
		|	ТабЗагрузки.ФорматФайлаПрайса,
		|	ТабЗагрузки.АрхивироватьПрайс,
		|	ТабЗагрузки.МаксимальныйОстатокДляПрайса,
		|	ТабЗагрузки.АдресЭлектроннойПочтыКонтрагентаДляРассылкиПрайса,
		|	ВЫБОР
		|		КОГДА ТабЗагрузки.МаксимальноеКоличествоПрайсовВДень = 0
		|			ТОГДА 1
		|		ИНАЧЕ ТабЗагрузки.МаксимальноеКоличествоПрайсовВДень
		|	КОНЕЦ КАК МаксимальноеКоличествоПрайсовВДень
		|ПОМЕСТИТЬ Таб
		|ИЗ
		|	&ТабЗагрузки КАК ТабЗагрузки
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ТипЦеныПрайса
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТипыЦенНоменклатуры.Ссылка КАК ТипЦеныПрайса
		|ПОМЕСТИТЬ ТипыВидовЦен
		|ИЗ
		|	Таб КАК Таб
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТипыЦенНоменклатуры КАК ТипыЦенНоменклатуры
		|		ПО Таб.ТипЦеныПрайса = ТипыЦенНоменклатуры.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
		|	ТоварыНаСкладахОстатки.КоличествоОстаток - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0) КАК Остаток,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ТоварыОрганизацииМКОстатки.КоличествоОстаток, 0) - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0) < 0
		|			ТОГДА 0
		|		ИНАЧЕ ЕСТЬNULL(ТоварыОрганизацииМКОстатки.КоличествоОстаток, 0) - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0)
		|	КОНЕЦ КАК ОстатокДляДоговоровМК,
		|	ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0) КАК ВРезерве
		|ПОМЕСТИТЬ ПромОстаткиТоваров
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Остатки(, Склад = &Склад) КАК ТоварыНаСкладахОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыОрганизаций.Остатки(
		|				,
		|				Склад = &Склад
		|					И Организация = &ОрганизацияМК) КАК ТоварыОрганизацииМКОстатки
		|		ПО ТоварыНаСкладахОстатки.Номенклатура = ТоварыОрганизацииМКОстатки.Номенклатура
		|			И ТоварыНаСкладахОстатки.ХарактеристикаНоменклатуры = ТоварыОрганизацииМКОстатки.ХарактеристикаНоменклатуры
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(, Склад = &Склад) КАК ТоварыВРезервеНаСкладахОстатки
		|		ПО ТоварыНаСкладахОстатки.Склад = ТоварыВРезервеНаСкладахОстатки.Склад
		|			И ТоварыНаСкладахОстатки.Номенклатура = ТоварыВРезервеНаСкладахОстатки.Номенклатура
		|ГДЕ
		|	ТоварыНаСкладахОстатки.КоличествоОстаток - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0) > 0
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОстаткиТоваров.Номенклатура КАК Номенклатура,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ТоварыВЯчейкахОстатки.КоличествоОстаток, 0) - ОстаткиТоваров.ВРезерве < ЕСТЬNULL(ОстаткиТоваров.Остаток, 0)
		|			ТОГДА ЕСТЬNULL(ТоварыВЯчейкахОстатки.КоличествоОстаток, 0) - ОстаткиТоваров.ВРезерве
		|		ИНАЧЕ ЕСТЬNULL(ОстаткиТоваров.Остаток, 0)
		|	КОНЕЦ КАК Остаток,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ТоварыВЯчейкахОстатки.КоличествоОстаток, 0) - ОстаткиТоваров.ВРезерве < ЕСТЬNULL(ОстаткиТоваров.ОстатокДляДоговоровМК, 0)
		|			ТОГДА ЕСТЬNULL(ТоварыВЯчейкахОстатки.КоличествоОстаток, 0) - ОстаткиТоваров.ВРезерве
		|		ИНАЧЕ ЕСТЬNULL(ОстаткиТоваров.ОстатокДляДоговоровМК, 0)
		|	КОНЕЦ КАК ОстатокДляДоговоровМК
		|ПОМЕСТИТЬ ОстаткиТоваров
		|ИЗ
		|	ПромОстаткиТоваров КАК ОстаткиТоваров
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках.Остатки(
		|				,
		|				Склад = &Склад
		|					И НЕ Ячейка.НеУчитыватьВОперативномУчете) КАК ТоварыВЯчейкахОстатки
		|		ПО ОстаткиТоваров.Номенклатура = ТоварыВЯчейкахОстатки.Номенклатура
		|ГДЕ
		|	ВЫБОР
		|			КОГДА ЕСТЬNULL(ТоварыВЯчейкахОстатки.КоличествоОстаток, 0) - ОстаткиТоваров.ВРезерве < ЕСТЬNULL(ОстаткиТоваров.Остаток, 0)
		|				ТОГДА ЕСТЬNULL(ТоварыВЯчейкахОстатки.КоличествоОстаток, 0) - ОстаткиТоваров.ВРезерве
		|			ИНАЧЕ ЕСТЬNULL(ОстаткиТоваров.Остаток, 0)
		|		КОНЕЦ > 0
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЦеныНоменклатурыСрезПоследних.Период,
		|	ЦеныНоменклатурыСрезПоследних.Регистратор,
		|	ЦеныНоменклатурыСрезПоследних.НомерСтроки,
		|	ЦеныНоменклатурыСрезПоследних.Активность,
		|	ЦеныНоменклатурыСрезПоследних.ТипЦен,
		|	ЦеныНоменклатурыСрезПоследних.Номенклатура,
		|	ЦеныНоменклатурыСрезПоследних.ХарактеристикаНоменклатуры,
		|	ЦеныНоменклатурыСрезПоследних.Валюта,
		|	ЦеныНоменклатурыСрезПоследних.Цена,
		|	ЦеныНоменклатурыСрезПоследних.ЕдиницаИзмерения,
		|	ЦеныНоменклатурыСрезПоследних.ПроцентСкидкиНаценки,
		|	ЦеныНоменклатурыСрезПоследних.СпособРасчетаЦены
		|ПОМЕСТИТЬ ЦеныНоменклатурыСрезПоследних
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
		|			,
		|			ТипЦен В
		|				(ВЫБРАТЬ
		|					ТипыВидовЦен.ТипЦеныПрайса
		|				ИЗ
		|					ТипыВидовЦен КАК ТипыВидовЦен
		|				ГДЕ
		|					НЕ ТипыВидовЦен.ТипЦеныПрайса.Рассчитывается)) КАК ЦеныНоменклатурыСрезПоследних
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЦеныНоменклатурыСрезПоследних.Период,
		|	ЦеныНоменклатурыСрезПоследних.Регистратор,
		|	ЦеныНоменклатурыСрезПоследних.НомерСтроки,
		|	ЦеныНоменклатурыСрезПоследних.Активность,
		|	ТипыВидовЦен.ТипЦеныПрайса,
		|	ЦеныНоменклатурыСрезПоследних.Номенклатура,
		|	ЦеныНоменклатурыСрезПоследних.ХарактеристикаНоменклатуры,
		|	ЦеныНоменклатурыСрезПоследних.Валюта,
		|	ЦеныНоменклатурыСрезПоследних.Цена * (1 + ТипыВидовЦен.ТипЦеныПрайса.ПроцентСкидкиНаценки / 100),
		|	ЦеныНоменклатурыСрезПоследних.ЕдиницаИзмерения,
		|	ТипыВидовЦен.ТипЦеныПрайса.ПроцентСкидкиНаценки,
		|	ЦеныНоменклатурыСрезПоследних.СпособРасчетаЦены
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(, ) КАК ЦеныНоменклатурыСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТипыВидовЦен КАК ТипыВидовЦен
		|		ПО ЦеныНоменклатурыСрезПоследних.ТипЦен = ТипыВидовЦен.ТипЦеныПрайса.БазовыйТипЦен
		|ГДЕ
		|	ТипыВидовЦен.ТипЦеныПрайса.Рассчитывается
		|	И ТипыВидовЦен.ТипЦеныПрайса.СпособРасчетаЦены = ЗНАЧЕНИЕ(Перечисление.СпособыРасчетаЦены.ПоПроцентнойНаценкеНаБазовыйТип)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СправочникНоменклатура.Родитель КАК НоменклатураРодитель,
		|	ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура,
		|	ОстаткиТоваров.Остаток КАК Количество,
		|	ОстаткиТоваров.ОстатокДляДоговоровМК КАК КоличествоДляДоговоровСМК,
		|	ВЫБОР
		|		КОГДА ЦеныНоменклатурыСрезПоследних.Валюта = &ВалютаРубли
		|			ТОГДА ЦеныНоменклатурыСрезПоследних.Цена
		|		ИНАЧЕ ВЫБОР
		|				КОГДА ЕСТЬNULL(КурсыВалютСрезПоследних.Кратность, 0) > 0
		|						И ЕСТЬNULL(КурсыВалютСрезПоследних.Курс, 0) > 0
		|					ТОГДА ЦеныНоменклатурыСрезПоследних.Цена * (КурсыВалютСрезПоследних.Курс / КурсыВалютСрезПоследних.Кратность)
		|				ИНАЧЕ 0
		|			КОНЕЦ
		|	КОНЕЦ КАК Цена,
		|	ЦеныНоменклатурыСрезПоследних.ТипЦен КАК ТипЦен,
		|	СправочникНоменклатура.КодПроизводителя КАК КодПроизводителя,
		|	СправочникНоменклатура.ЕдиницаХраненияОстатков,
		|	ВЫБОР
		|		КОГДА СправочникНоменклатура.Кратность = 0
		|			ТОГДА 1
		|		ИНАЧЕ СправочникНоменклатура.Кратность
		|	КОНЕЦ КАК Кратность
		|ПОМЕСТИТЬ ТабЦен
		|ИЗ
		|	ЦеныНоменклатурыСрезПоследних КАК ЦеныНоменклатурыСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(, ) КАК КурсыВалютСрезПоследних
		|		ПО ЦеныНоменклатурыСрезПоследних.Валюта = КурсыВалютСрезПоследних.Валюта
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОстаткиТоваров КАК ОстаткиТоваров
		|		ПО (ОстаткиТоваров.Номенклатура = ЦеныНоменклатурыСрезПоследних.Номенклатура)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
		|		ПО ЦеныНоменклатурыСрезПоследних.Номенклатура = СправочникНоменклатура.Ссылка
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ТипЦен
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РассылкаДокументов.Контрагент,
		|	КОЛИЧЕСТВО(РассылкаДокументов.Контрагент) КАК КоличествоОтправленных
		|ПОМЕСТИТЬ ТабРассылкаДокументовПоПочте
		|ИЗ
		|	РегистрСведений.РассылкаДокументов КАК РассылкаДокументов
		|ГДЕ
		|	РассылкаДокументов.Период МЕЖДУ &ПериодНачало И &ПериодОкончание
		|	И РассылкаДокументов.ТипРассылки = ЗНАЧЕНИЕ(Перечисление.ТипыРассылокЭлектроннойПочты.ПрайсЛист)
		|
		|СГРУППИРОВАТЬ ПО
		|	РассылкаДокументов.Контрагент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РассылкаДокументов2.Контрагент,
		|	КОЛИЧЕСТВО(РассылкаДокументов2.Контрагент) КАК КоличествоОтправленных
		|ПОМЕСТИТЬ ТабРассылкаДокументовПоФТП
		|ИЗ
		|	РегистрСведений.РассылкаДокументов КАК РассылкаДокументов2
