		Запрос.УстановитьПараметр("ТипЦен", Стр.ТипЦеныПрайса); 
		
		ПакетЗапросов = Запрос.ВыполнитьПакет();
		ТЗЦен = ПакетЗапросов[4].Выгрузить();
		
		ТекущийКонтрагент = "!!!";
		ПараметрыОтправки= Новый Массив;
		ДокументКОтправке = Новый ТабличныйДокумент;
