
Функция ОтправитьЗаказыВSI(СтороннийСклад = Неопределено) Экспорт
	
	КодОшибки = "";
	
	Запрос = Новый Запрос();
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ЗаказПоставщику.Ссылка
	|ИЗ
	|	Документ.ЗаказПоставщику КАК ЗаказПоставщику
	|ГДЕ
	|	ЗаказПоставщику.Проведен = ИСТИНА
	|	И ЗаказПоставщику.СтатусЗаказаПоставщику = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПоставщикам.Создан)
	|	И ВЫБОР
	|			КОГДА &ОтборПоСкладу
	|				ТОГДА ЗаказПоставщику.IDСклада В (&СтороннийСклад)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ЗаказПоставщику.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|	И ЗаказПоставщику.IDСклада.СтороннийСкладФилиала = ИСТИНА
	|	И ЗаказПоставщику.IDСклада.НеОтправлятьЗаказыВSI = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЗаказПоставщику.Экспресс УБЫВ";
	
	Запрос.Параметры.Вставить("ОтборПоСкладу", ?(СтороннийСклад = Неопределено, Ложь, Истина));
	Запрос.Параметры.Вставить("СтороннийСклад", СтороннийСклад);
	Запрос.Параметры.Вставить("ДатаНач", НачалоДня(ДатаОтбора));
	Запрос.Параметры.Вставить("ДатаКон", КонецДня(ДатаОтбора));
	
	РезЗапроса = Запрос.Выполнить();
	
	Если РезЗапроса.Пустой() Тогда
		Возврат КодОшибки;
	КонецЕсли;
	
	Выборка = РезЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Попытка
			
			Результат = Документы.ЗаказПоставщику.ОтправитьвSI(Выборка.Ссылка);
			
			Если Результат.Статус = "OK" Тогда
				
				Документобъект = Выборка.Ссылка.ПолучитьОбъект();
				Документобъект.СтатусЗаказаПоставщику = Перечисления.СтатусыЗаказовПоставщикам.ОтправленПоставщику;
				Документобъект.Записать(РежимЗаписиДокумента.Проведение);				
				
			ИначеЕсли Результат.Статус = "NO_COMMAND" Тогда
			Иначе
				КодОшибки = КодОшибки + "Ошибка отправки документа:" + Выборка.Ссылка + Символы.ПС + Результат.Сообщение + Символы.ПС;
			КонецЕсли;
			
		Исключение
			КодОшибки = КодОшибки + "Не удалось отправить в SI документ: " + Выборка.Ссылка + Символы.ПС + ОписаниеОшибки() + Символы.ПС;
		КонецПопытки;	
		
	КонецЦикла;
	
	Возврат КодОшибки;
			
КонецФункции

Функция ВыполнитьДействия(ЗапущеноРегламентом = Ложь) Экспорт 
	
	КодОшибки = "";

	Запрос = Новый  Запрос;
	Запрос.УстановитьПараметр("ТекДата",             НачалоДня(ДатаОтбора));
	Запрос.УстановитьПараметр("РабочийДень",         Перечисления.ВидыДнейПроизводственногоКалендаря.Рабочий);
	Запрос.УстановитьПараметр("ПредпраздничныйДень", Перечисления.ВидыДнейПроизводственногоКалендаря.Предпраздничный);
	
	Запрос.Текст = "ВЫБРАТЬ
	|	РегламентированныйПроизводственныйКалендарь.ДатаКалендаря,
	|	РегламентированныйПроизводственныйКалендарь.ВидДня
	|ИЗ
	|	РегистрСведений.РегламентированныйПроизводственныйКалендарь КАК РегламентированныйПроизводственныйКалендарь
	|ГДЕ
	|	РегламентированныйПроизводственныйКалендарь.ДатаКалендаря = &ТекДата";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда 
		КодОшибки = "Не заполнен регламентированны календарь на " + НачалоДня(ТекущаяДата());
	Иначе
		
		Выборка = РезультатЗапроса.Выбрать(); 
		
		Пока Выборка.Следующий() Цикл
			
			Если Выборка.ВидДня = Перечисления.ВидыДнейПроизводственногоКалендаря.Рабочий Тогда
				
				ПолеОтбора = "ОтправлятьПоРабочмДням";
				ВремяОтбора = "ВремяОтправкиРабочийДень";
				
			ИначеЕсли Выборка.ВидДня = Перечисления.ВидыДнейПроизводственногоКалендаря.Суббота Тогда 				
				ПолеОтбора = "ОтправлятьПоСубботам";
				ВремяОтбора = "ВремяОтправкиСуббота";
			ИначеЕсли Выборка.ВидДня = Перечисления.ВидыДнейПроизводственногоКалендаря.Воскресенье Тогда 
				
				ПолеОтбора = "ОтправлятьПоВоскресеньям";
				ВремяОтбора = "ВремяОтправкиВоскресенье";
				
			ИначеЕсли Выборка.ВидДня = Перечисления.ВидыДнейПроизводственногоКалендаря.Предпраздничный Тогда 
				
				ПолеОтбора = "ОтправлятьВПредраздничныеДни";
				ВремяОтбора = "ВремяОтправкиПредпрздничныйДень";
				
			ИначеЕсли Выборка.ВидДня = Перечисления.ВидыДнейПроизводственногоКалендаря.Праздник Тогда 
				
				ПолеОтбора = "ОтправлятьВПраздничныеДни";
				ВремяОтбора = "ВремяОтправкиПраздничныйДень";
				
			КонецЕсли;
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	СторонниеСклады.Ссылка
			|ИЗ
			|	Справочник.СторонниеСклады КАК СторонниеСклады
			|ГДЕ
			|	СторонниеСклады.ОтправлятьВАварду
			|	И СторонниеСклады.ОтправлятьПоРабочмДням
			|	И (СторонниеСклады.ВремяОтправкиРабочийДень <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
			|				И РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(СторонниеСклады.ВремяОтправкиРабочийДень, ДЕНЬ), СторонниеСклады.ВремяОтправкиРабочийДень, СЕКУНДА) <= РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ), &ТекущаяДата, СЕКУНДА)
			|				И РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(СторонниеСклады.ВремяОтправкиРабочийДень, ДЕНЬ), СторонниеСклады.ВремяОтправкиРабочийДень, СЕКУНДА) >= РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ), &ТекущаяДата, СЕКУНДА) - 10 * 60
			|			ИЛИ СторонниеСклады.ВремяОтправкиРабочийДень2 <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
			|				И РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(СторонниеСклады.ВремяОтправкиРабочийДень2, ДЕНЬ), СторонниеСклады.ВремяОтправкиРабочийДень2, СЕКУНДА) <= РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ), &ТекущаяДата, СЕКУНДА)
			|				И РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(СторонниеСклады.ВремяОтправкиРабочийДень2, ДЕНЬ), СторонниеСклады.ВремяОтправкиРабочийДень2, СЕКУНДА) >= РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ), &ТекущаяДата, СЕКУНДА) - 10 * 60
			|			ИЛИ СторонниеСклады.ВремяОтправкиРабочийДень3 <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
			|				И РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(СторонниеСклады.ВремяОтправкиРабочийДень3, ДЕНЬ), СторонниеСклады.ВремяОтправкиРабочийДень3, СЕКУНДА) <= РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ), &ТекущаяДата, СЕКУНДА)
			|				И РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(СторонниеСклады.ВремяОтправкиРабочийДень3, ДЕНЬ), СторонниеСклады.ВремяОтправкиРабочийДень3, СЕКУНДА) >= РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ), &ТекущаяДата, СЕКУНДА) - 10 * 60)";
			
			Запрос.УстановитьПараметр("ТекущаяДата", ДатаОтбора);
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ОтправлятьПоРабочмДням", ПолеОтбора);
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВремяОтправкиРабочийДень", ВремяОтбора);
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ РАЗЛИЧНЫЕ
				|	ЗаказыПокупателейОстатки.ЗаказПокупателя
				|ПОМЕСТИТЬ ТЗаказов
				|ИЗ
				|	РегистрНакопления.ЗаказыПокупателей.Остатки КАК ЗаказыПокупателейОстатки
				|ГДЕ
				|	ЗаказыПокупателейОстатки.КоличествоОстаток > 0
				|	И ЗаказыПокупателейОстатки.ЗаказПокупателя.IDСклада_СтороннийСклад = &IDСклада_СтороннийСклад
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗЛИЧНЫЕ
				|	ТЗаказов.ЗаказПокупателя  КАК Ссылка
				|ИЗ
				|	ТЗаказов КАК ТЗаказов
				|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары
				|		ПО ТЗаказов.ЗаказПокупателя = ЗаказПокупателяТовары.Ссылка
				|ГДЕ
				|	ЗаказПокупателяТовары.ЦенаЗакупки = 0";
				
				Запрос.УстановитьПараметр("IDСклада_СтороннийСклад", ВыборкаДетальныеЗаписи.Ссылка);
				
				РезультатЗапроса = Запрос.Выполнить();
				ВыборкаЗаказ = РезультатЗапроса.Выбрать();
				
				Пока ВыборкаЗаказ.Следующий() Цикл
					
					НоваяКорректировкаЗаказаПокупателя = Документы.КорректировкаЗаказаПокупателя.СоздатьДокумент();
					НоваяКорректировкаЗаказаПокупателя.Дата = Макс(ВыборкаЗаказ.Ссылка.Дата + 1, ТекущаяДата() - 121);
					НоваяКорректировкаЗаказаПокупателя.Заполнить(ВыборкаЗаказ.Ссылка);
					
					Если НоваяКорректировкаЗаказаПокупателя.Товары.Количество() <> 0 Тогда 
						
						Для Каждого ТекСтрока Из НоваяКорректировкаЗаказаПокупателя.Товары Цикл 
							ТекСтрока.Причина = Перечисления.ПричиныКорректировкиСборки.ОтказПоставщика; 
						КонецЦикла;
						
						НоваяКорректировкаЗаказаПокупателя.Комментарий = "Создан автоматически обработкой создания и отправки заказов сторонним складам.";
						
						Попытка
							НоваяКорректировкаЗаказаПокупателя.Записать(РежимЗаписиДокумента.Проведение);
						Исключение
						КонецПопытки;
						
					КонецЕсли;
					
				КонецЦикла;
				
				// создаем заказы  поставщику
				НовыйОтчет = Отчеты.АнализЗаказовПокупателей.Создать();
				НовыйОтчет.УстановитьНачальныеНастройки_Сервер();
				НовыйОтчет.ЗаказПоставщику(Ложь, Неопределено, ВыборкаДетальныеЗаписи.Ссылка, ЗапущеноРегламентом);
				
			КонецЦикла;
			
			Прервать;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат КодОшибки;
	
КонецФункции