				Рез = ДокЗаказ.Товары.НайтиСтроки(Отбор);						
			Иначе			
				Рез = Новый Массив;			
			КонецЕсли;
			
			КолвоСтрок = Рез.Количество();
			ТекСтрока = 0;
			
			Если Рез.Количество() = 0 Тогда
				
				//Излишек
				НовСтрока = ДокПоступление.Товары.Добавить();
