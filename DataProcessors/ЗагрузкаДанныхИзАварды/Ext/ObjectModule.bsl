							НовСтрока.ЗаказПоставщику = Документы.ЗаказПоставщику.ПустаяСсылка();
							НовСтрока.Количество = НужноОприходовать;					
							
						КонецЕсли;  
						
						НовСтрока.ГМ = ГМ;
						
						ОбработкаТабличныхЧастей.РассчитатьКоличествоМестТабЧасти(НовСтрока, ДокПоступление);
						ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(НовСтрока, ДокПоступление);
						
						ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НовСтрока, ДокПоступление);					
						НужноОприходовать = НужноОприходовать - НовСтрока.Количество;
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;                      
	
	//Запишем документы для последней строки таблицы
	Если ДокПоступление <> Неопределено Тогда		
		
		ДокПоступление.Экспресс = ЗаказПоставщикуЕстьЭкспресс;
		ПроверитьСуммуСНДСУТ10(ТЗНоменклатуры, ДокПоступление.Товары, ДокПоступление.ИДДокументаВСмежнойБазе); 
		
		ТранзитнаяПоставкаЧерезСкладWMS = Ложь;
		
		Если ДокПоступление.Товары.Количество() > 0 Тогда
			
			Для Каждого Строка Из ДокПоступление.Товары Цикл
				
				Если ЗначениеЗаполнено(Строка.ЗаказПоставщику) и Строка.ЗаказПоставщику.ТранзитнаяПоставкаЧерезСкладWMS Тогда
					
					ТранзитнаяПоставкаЧерезСкладWMS = Истина;
					Прервать;
					
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе
			
			Если ЗначениеЗаполнено(ДокПоступление.Сделка) и ДокПоступление.Сделка.ТранзитнаяПоставкаЧерезСкладWMS Тогда
				ТранзитнаяПоставкаЧерезСкладWMS	= Истина;
			КонецЕсли;
			
		КонецЕсли;
		
		УстановитьПривилегированныйРежим(Истина);
		ДокПоступление.Записать(РежимЗаписиДокумента.Запись); 
		
		//+Кабанов А.В. 12.11.2024 #UT10-4872	
		Попытка			
			ДокПоступление.Записать(РежимЗаписиДокумента.Проведение,РежимПроведенияДокумента.Неоперативный);
		Исключение
		КонецПопытки;
		//-Кабанов А.В. 12.11.2024 #UT10-4872
		
		УстановитьПривилегированныйРежим(Ложь);
		
		//+Сёмин Р.И. 05.06.2026 #UT10-5899
		ПроверитьУстановитьСтатусПТУОжидаетПодтвержденияЭДО(ДокПоступление);
		//-Сёмин Р.И. 05.06.2026 #UT10-5899
		
		Если ТранзитнаяПоставкаЧерезСкладWMS Тогда
			
			Попытка
				Результат = МСКWEB.ОтправитьПТУВУТ11(ДокПоступление.Ссылка);
			Исключение
				ЗаписьЖурналаРегистрации("GoodsReserve.СоздатьИнвойсПо4Транзиту", УровеньЖурналаРегистрации.Ошибка,,,
				"Ошибка получения ответа после отправки ПТУ в стороннюю УТ11: " + ОписаниеОшибки());
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗаказОбъект <> Неопределено Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		ЗаказОбъект.Записать(РежимЗаписиДокумента.Запись);
		УстановитьПривилегированныйРежим(Ложь);
		
	КонецЕсли;
	
	Если НЕ ДокПоступлениеТОХ = Неопределено Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		ДокПоступлениеТОХ.Записать(РежимЗаписиДокумента.Запись);
		
		//+Кабанов А.В. 12.11.2024 #UT10-4872	
		Попытка			
			ДокПоступлениеТОХ.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
		Исключение
		КонецПопытки;
		//-Кабанов А.В. 12.11.2024 #UT10-4872
		
		УстановитьПривилегированныйРежим(Ложь);
		
	КонецЕсли;
	
КонецПроцедуры

Функция НайтиПоступлениеПоИДДокументаВСмежнойБазе(ИДДокументаВСмежнойБазе)
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ПоступлениеТоваровУслуг.Ссылка
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
	|ГДЕ
	|	ПоступлениеТоваровУслуг.ПометкаУдаления = ЛОЖЬ
	|	И ПоступлениеТоваровУслуг.ИДДокументаВСмежнойБазе = &ИДДокументаВСмежнойБазе");
	
	Запрос.Параметры.Вставить("ИДДокументаВСмежнойБазе", ИДДокументаВСмежнойБазе);	
	
	РезЗапроса = Запрос.Выполнить();
	
	Если РезЗапроса.Пустой() Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;	
	
КонецФункции

Процедура ПроверитьСуммуСНДС(ТЗНоменклатуры , ТоварыПоступления , ИДДокументаВСмежнойБазе);
	
	ВремТаблица = ТЗНоменклатуры.Скопировать();
	ВремТаблица.Свернуть("ИДДокументаВСмежнойБазе, Номенклатура, КодСтрокиУТ11, СуммаСНДС, СуммаНДС");
	
	Отбор = Новый Структура("ИДДокументаВСмежнойБазе", ИДДокументаВСмежнойБазе);	
	ВремТаблица = ВремТаблица.НайтиСтроки(Отбор);
	
	ТоварыПоступления.Сортировать("КодСтрокиУТ11 Возр, Сумма Убыв");
	
	Для Каждого СтрВрем Из ВремТаблица Цикл
		
		Отбор = Новый Структура("Номенклатура", СтрВрем.Номенклатура);
		Отбор.Вставить("КодСтрокиУТ11", СтрВрем.КодСтрокиУТ11);		
		СтрокиДок = ТоварыПоступления.НайтиСтроки(Отбор);
		
		Если СтрокиДок.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ПервСтрока = СтрокиДок[0];		
		СуммаПоКодуСтроки = 0;
		СуммаНДСПоКодуСтроки = 0;
		
		Для Каждого СтрДок Из СтрокиДок Цикл
			
			СуммаПоКодуСтроки = СуммаПоКодуСтроки + СтрДок.Сумма;
			СуммаНДСПоКодуСтроки = СуммаНДСПоКодуСтроки + СтрДок.СуммаНДС;
			
		КонецЦикла;
		
		РасхождСумма = СтрВрем.СуммаСНДС - СуммаПоКодуСтроки;
		РасхождСуммаНДС = СтрВрем.СуммаНДС - СуммаНДСПоКодуСтроки;
		
		ПервСтрока.Сумма = ПервСтрока.Сумма + РасхождСумма;
		ПервСтрока.СуммаНДС = ПервСтрока.СуммаНДС + РасхождСуммаНДС;		
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьСуммуСНДСУТ10(ТЗНоменклатуры, ТоварыПоступления, ИДДокументаВСмежнойБазе);  
	
	ВремТаблица = ТЗНоменклатуры.Скопировать();
	ВремТаблица.Свернуть("ИДДокументаВСмежнойБазе, Номенклатура, Назначение, ГМ", "Сумма, СуммаНДС");
	
	СуммаРаспределения = 0;
	СуммаНДСРаспределения = 0;
	
	Для Каждого СтрВрем из ВремТаблица Цикл
		
		СуммаРаспределения = СуммаРаспределения + СтрВрем.Сумма;
		СуммаНДСРаспределения = СуммаНДСРаспределения + СтрВрем.СуммаНДС;  
		
	КонецЦикла;
	
	МассивНоменклатуры = ТоварыПоступления.ВыгрузитьКолонку("Номенклатура"); 
	ОбщегоНазначения.УдалитьПовторяющиесяЭлементыМассива(МассивНоменклатуры); 
	
	Для Каждого ТекНоменклатура Из МассивНоменклатуры Цикл  
		
		Отбор = Новый Структура("Номенклатура, ИДДокументаВСмежнойБазе", ТекНоменклатура, ИДДокументаВСмежнойБазе);
		МассивТоварыВрем = ВремТаблица.НайтиСтроки(Отбор); 
		
		СуммаРаспределения = 0;
		СуммаНДСРаспределения = 0;
		
		Для Каждого Эл Из МассивТоварыВрем Цикл
			
			СуммаРаспределения = СуммаРаспределения + Эл.Сумма;
			СуммаНДСРаспределения = СуммаНДСРаспределения + Эл.СуммаНДС;  
			
		КонецЦикла;	 
		
		ОтборТовары = Новый Структура("Номенклатура", ТекНоменклатура);
		МассивТовары = ТоварыПоступления.НайтиСтроки(ОтборТовары);
		
		МассивКоэф = Новый Массив;
		
		Для Каждого ТекТовар Из МассивТовары Цикл
			МассивКоэф.Добавить(ТекТовар.Количество);
		КонецЦикла;
		
		МассивСумм = ОбщегоНазначения.РаспределитьПропорционально(СуммаРаспределения, МассивКоэф, 2);
		МассивСуммНДС = ОбщегоНазначения.РаспределитьПропорционально(СуммаНДСРаспределения, МассивКоэф, 2);	 
		
		Для сч = 0 По МассивТовары.ВГраница() Цикл
			
			МассивТовары[сч].Сумма = МассивСумм[сч];
			МассивТовары[сч].СуммаНДС = МассивСуммНДС[сч];
			
		КонецЦикла;	
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузкаПоступленийПоДаннымИзСтороннейУТ11(ВидОперации = "", НомерЗаказаАварды = Неопределено, Склад = Неопределено)
	
	ТЗНоменклатуры = Новый ТаблицаЗначений;
	ТЗНоменклатуры.Колонки.Добавить("НомерДокумента");
	ТЗНоменклатуры.Колонки.Добавить("ДатаДокумента");
	ТЗНоменклатуры.Колонки.Добавить("Номенклатура");
	ТЗНоменклатуры.Колонки.Добавить("Артикул");				
	ТЗНоменклатуры.Колонки.Добавить("Количество");
	ТЗНоменклатуры.Колонки.Добавить("Комментарий");
	ТЗНоменклатуры.Колонки.Добавить("Цена");	
	ТЗНоменклатуры.Колонки.Добавить("НомерГТДКод");
	ТЗНоменклатуры.Колонки.Добавить("СтранаПроисхожденияКод");
	ТЗНоменклатуры.Колонки.Добавить("НомерWMS"); 
	ТЗНоменклатуры.Колонки.Добавить("ЗаказПоставщика");
	ТЗНоменклатуры.Колонки.Добавить("Экспресс");
	ТЗНоменклатуры.Колонки.Добавить("РасходныйОрдер");
	ТЗНоменклатуры.Колонки.Добавить("УпакЛистНомерWMS");
	ТЗНоменклатуры.Колонки.Добавить("КроссДокинг");
	ТЗНоменклатуры.Колонки.Добавить("ГУИДЗаказа");
	ТЗНоменклатуры.Колонки.Добавить("ТранзитнаяПоставка",Новый ОписаниеТипов("Булево"));
	ТЗНоменклатуры.Колонки.Добавить("ИДДокументаВСмежнойБазе",Новый ОписаниеТипов("Строка"));
	ТЗНоменклатуры.Колонки.Добавить("КодСтрокиУТ11",Новый ОписаниеТипов("Число"));
	ТЗНоменклатуры.Колонки.Добавить("СуммаСНДС");
	ТЗНоменклатуры.Колонки.Добавить("СуммаНДС");
	ТЗНоменклатуры.Колонки.Добавить("ПрямаяПоставка");
	ТЗНоменклатуры.Колонки.Добавить("КодМДМОрганизацииВСмежнойБазе",Новый ОписаниеТипов("Строка"));	 
	//+Шульман А. 23.04.2025 #UT10-5210  
	ТЗНоменклатуры.Колонки.Добавить("ПремиальнаяПерекупка",Новый ОписаниеТипов("Булево"));
	//-Шульман А. 23.04.2025 #UT10-5210 
	
	Результат = МСКWEB.ПолучитьРеализацииВСтороннейБазе(Истина, ВидОперации, Склад); 
	
	//Обработка таблицы с ответом
	Если Результат.Загружен Тогда
		
		СписокДанных = Результат.СписокДанных;
		
		Для Каждого Элем Из СписокДанных Цикл
			
			Если ЗначениеЗаполнено(НомерЗаказаАварды) И СокрЛП(НомерЗаказаАварды) <> СокрЛП(Элем.НомерWMS) Тогда
				Продолжить;
			КонецЕсли;			
			
			НовСтрока = ТЗНоменклатуры.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока,Элем);			
			НовСтрока.Номенклатура = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", Элем.Артикул);
			
			Если НЕ ЗначениеЗаполнено(НовСтрока.Номенклатура) И Прав(Элем.Артикул,3) = "DMG" Тогда 				
				
				НовСтрока.Номенклатура = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", Сред(Элем.Артикул, 1, СтрДлина(Элем.Артикул) - 3));
				НовСтрока.СтранаПроисхожденияКод = "";
				НовСтрока.НомерГТДКод = "--";
				
			КонецЕсли;
			
			Если Элем.КроссДокинг Тогда 
				
				Если ЗначениеЗаполнено(Элем.ГУИДЗаказа) Тогда 				
					НовСтрока.ЗаказПоставщика = Документы.ЗаказПоставщику.НайтиПоРеквизиту("ГУИДЗаказаПокупателя", Элем.ГУИДЗаказа);
				КонецЕсли;
				
			Иначе 
				
				Если ЗначениеЗаполнено(Элем.ЗаказПокупателя) Тогда
					НовСтрока.ЗаказПоставщика = Документы.ЗаказПоставщику.НайтиПоРеквизиту("ГУИДЗаказаПокупателя", Элем.ЗаказПокупателя); 
				КонецЕсли;
				
			КонецЕсли;			
			
		КонецЦикла;		
		
	КонецЕсли;
	
	Если ТЗНоменклатуры.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	//+Макрушин Е. 24.09.2025 #UT10-5430
	Если Результат.Свойство("ДополнительныеДанные") И Результат.ДополнительныеДанные.Свойство("КодыМаркировки") Тогда
		тзКодыМаркировки = ОбщегоНазначения.ПреобразоватьМассивВТаблицуЗначений(Результат.ДополнительныеДанные.КодыМаркировки);
	Иначе
		тзКодыМаркировки = Неопределено;
	КонецЕсли;
	//-Макрушин Е. 24.09.2025 #UT10-5430
	
	НомерДокумента = "";
	ДокПоступление = Неопределено;	
	ДокЗаказ = Неопределено;
	ЗаказОбъект = Неопределено;
	ЕстьДокумент = Ложь;
	УпакЛистНомерWMS = "";
	ПрямаяПоставка = Ложь;
	
	Для Каждого СтрТЗ Из ТЗНоменклатуры Цикл
		
		Если Не ЗначениеЗаполнено(СтрТЗ.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		
		Если НомерДокумента <> СтрТЗ.НомерДокумента Тогда
			
			НомерДокумента = СтрТЗ.НомерДокумента;
			ДатаДокумента = Дата(СтрТЗ.ДатаДокумента);
			ИДДокументаВСмежнойБазе = СокрЛП(СтрТЗ.ИДДокументаВСмежнойБазе); 
			ПрямаяПоставка = СтрТЗ.ПрямаяПоставка; 
			
			Если ДокПоступление <> Неопределено Тогда
				
				ДокПоступление.УпаковочныеЛисты.Свернуть("НомерWMS");
				
				Если ПрямаяПоставка Тогда
					ПроверитьСуммуСНДС(ТЗНоменклатуры, ДокПоступление.Товары, ДокПоступление.ИДДокументаВСмежнойБазе);	
				КонецЕсли;
				
				УстановитьПривилегированныйРежим(Истина);				
				ДокПоступление.Записать(РежимЗаписиДокумента.Запись);
				
				//+Кабанов А.В. 12.11.2024 #UT10-4872	
				Попытка			
					ДокПоступление.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
				Исключение
				КонецПопытки;
				//-Кабанов А.В. 12.11.2024 #UT10-4872
				
				УстановитьПривилегированныйРежим(Ложь);
				
				//+Сёмин Р.И. 05.06.2026 #UT10-5899
				ПроверитьУстановитьСтатусПТУОжидаетПодтвержденияЭДО(ДокПоступление);
				//-Сёмин Р.И. 05.06.2026 #UT10-5899
				
			КонецЕсли;			
			
			ЕстьДокумент = НайтиПоступлениеПоИДДокументаВСмежнойБазе(ИДДокументаВСмежнойБазе);
			
			Если ЕстьДокумент Тогда
				Продолжить;
			КонецЕсли;
			
			ЕстьДокумент = НайтиПоступлениеПоНомеруВходящегоДокумента(НомерДокумента, ДатаДокумента);
			
			Если ЕстьДокумент Тогда
				Продолжить;
			КонецЕсли;
			
			ДокПоступление = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент();
			ДокПоступление.Организация = Константы.ОсновнаяОрганизация.Получить();
			ДокПоступление.ВидПоступления = Перечисления.ВидыПоступленияТоваров.НаСклад;
			ДокПоступление.СкладОрдер = Константы.ОсновнойСклад.Получить(); 
			
			Если НЕ Склад = Неопределено Тогда
				ДокПоступление.Контрагент = Склад.Поставщик; 
			Иначе				
				ДокПоступление.Контрагент = Константы.ОсновнойПоставщик.Получить();
			КонецЕсли; 
			
			Если Не Склад = Неопределено И ЗначениеЗаполнено(Склад.ДоговорКонтрагента) Тогда
				ДокПоступление.ДоговорКонтрагента =	Склад.ДоговорКонтрагента; 
			Иначе
				ДокПоступление.ДоговорКонтрагента = ДокПоступление.Контрагент.ОсновнойДоговорКонтрагента;
			КонецЕсли;
			
			ДокПоступление.ВалютаДокумента = ДокПоступление.ДоговорКонтрагента.ВалютаВзаиморасчетов; 
			//+Кабанов А.В. 13.11.2024 #UT10-4872	
			//ДокПоступление.Дата = НачалоДня(ТекущаяДата() + 60 * 60 * 24);
			ДокПоступление.Дата = ТекущаяДата();				
			//+Кабанов А.В. 13.11.2024 #UT10-4872
			ДокПоступление.КратностьВзаиморасчетов = 1;
			ДокПоступление.КурсВзаиморасчетов  = 1;	
			ДокПоступление.ОтражатьВУправленческомУчете = Истина;
			ДокПоступление.ОтражатьВБухгалтерскомУчете = Истина;
			ДокПоступление.ОтражатьВНалоговомУчете = Истина;
			ДокПоступление.УчитыватьНДС = Истина;
			ДокПоступление.СуммаВключаетНДС = Истина;
			ДокПоступление.НомерВходящегоДокумента = НомерДокумента;
			ДокПоступление.ДатаВходящегоДокумента = ДатаДокумента;
			ДокПоступление.ИДДокументаВСмежнойБазе = ИДДокументаВСмежнойБазе; 
			ДокПоступление.КодМДМОрганизацииВСмежнойБазе = СтрТЗ.КодМДМОрганизацииВСмежнойБазе;	
			
			Если СтрТЗ.КроссДокинг Тогда
				ДокПоступление.НомерСкладскогоДокумента = ?(ЗначениеЗаполнено(СтрТЗ.УпакЛистНомерWMS), Лев(Прав(СтрТЗ.УпакЛистНомерWMS, 10), 9), СокрЛП(СтрТЗ.НомерWMS));
			Иначе
				ДокПоступление.НомерСкладскогоДокумента = ?(ЗначениеЗаполнено(СтрТЗ.НомерWMS), СтрТЗ.НомерWMS, НомерДокумента); 
			КонецЕсли;			
			
			ДокПоступление.Ответственный = глЗначениеПеременной("глТекущийПользователь");
			ДокПоступление.Экспресс = СтрТЗ.Экспресс;    
			//+Шульман А. 23.04.2025 #UT10-5210  
			ДокПоступление.ПремиальнаяПерекупка = СтрТЗ.ПремиальнаяПерекупка;    
			//-Шульман А. 23.04.2025 #UT10-5210 
			ДокПоступление.Комментарий = СокрЛП(СтрТЗ.Комментарий) + " Создан автоматически на основе документа в сторонней базе " + ТекущаяДата();			
			
			Если СтрТЗ.ТранзитнаяПоставка  Тогда
				
				ДокПоступление.Статус = Перечисления.СтатусыПТУ.КПоступлению;
				ДокПоступление.ТранзитнаяПоставка = Истина;				
				
			КонецЕсли;
			
			Если УпакЛистНомерWMS <> СтрТЗ.УпакЛистНомерWMS Тогда
				
				УпакЛистНомерWMS = СтрТЗ.УпакЛистНомерWMS;
				МассивСтрок = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(УпакЛистНомерWMS, ";");
				
				Для Сч = 0 По МассивСтрок.Количество()-1 Цикл 
					
					ТекСтрока = МассивСтрок[Сч];
					
					Если ЗначениеЗаполнено(ТекСтрока) Тогда
						СтрУпакЛист = ДокПоступление.УпаковочныеЛисты.Добавить();
						СтрУпакЛист.НомерWMS = СокрЛП(ТекСтрока);
					КонецЕсли;					
					
				КонецЦикла;
				
			КонецЕсли;			
			
			//+Макрушин Е. 24.09.2025 #UT10-5430
			ДополнитьДокументКодамиМаркировки(ДокПоступление, ИДДокументаВСмежнойБазе, тзКодыМаркировки);
			//-Макрушин Е. 24.09.2025 #UT10-5430
			
		КонецЕсли;				
		
		Если ЕстьДокумент Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрТЗ.ЗаказПоставщика) И (ДокЗаказ = Неопределено Или ДокЗаказ <> СтрТЗ.ЗаказПоставщика) Тогда 
			
			Если ЗаказОбъект <> Неопределено Тогда
				
				УстановитьПривилегированныйРежим(Истина);
				ЗаказОбъект.Записать(РежимЗаписиДокумента.Запись);
				УстановитьПривилегированныйРежим(Ложь);
				
			КонецЕсли;			
			
			ДокЗаказ = СтрТЗ.ЗаказПоставщика;
			ЗаказОбъект = ДокЗаказ.ПолучитьОбъект();
			ЗаказОбъект.ОбменДанными.Загрузка = Истина;
			ЗаказОбъект.ЗагруженоПоступление = Истина;
			НомСклДок = ДокПоступление.НомерСкладскогоДокумента; 
			
			Если ЗначениеЗаполнено(НомСклДок) И Найти(ЗаказОбъект.Комментарий, НомСклДок) = 0 Тогда 
				ЗаказОбъект.Комментарий = ЗаказОбъект.Комментарий + ", "+НомСклДок;
			КонецЕсли;			
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрТЗ.НомерГТДКод) Тогда
			СтрТЗ.НомерГТДКод = "--";
		КонецЕсли;		
		
		СерияНоменклатуры = Справочники.СерииНоменклатуры.НайтиПоНаименованию(СтрТЗ.НомерГТДКод,Истина,,СтрТЗ.Номенклатура);
		
		Если СерияНоменклатуры.Пустая() Тогда
			
			НомерГТДСсылка = Справочники.НомераГТД.НайтиПоКоду(СтрТЗ.НомерГТДКод);
			Страна = Справочники.КлассификаторСтранМира.НайтиПоКоду(СтрТЗ.СтранаПроисхожденияКод);
			СерияНоменклатуры = СоздатьСерию(СтрТЗ.Номенклатура, СтрТЗ.НомерГТДКод, Страна, НомерГТДСсылка);
			
		КонецЕсли;
		
		//ЗаполнениеТЧ
		НужноОприходовать = СтрТЗ.Количество; 
		Отбор = Новый Структура();
		Отбор.Вставить("Номенклатура",СтрТЗ.Номенклатура);
		Рез = ?(ДокЗаказ = Неопределено, Новый Массив, ДокЗаказ.Товары.НайтиСтроки(Отбор)); 
		КолвоСтрок = Рез.Количество();
		ТекСтрока = 0;
		
		Если Рез.Количество() = 0 Тогда			
			
			//Излишек
			НовСтрока = ДокПоступление.Товары.Добавить();
			НовСтрока.Номенклатура = СтрТЗ.Номенклатура; 
			НовСтрока.СерияНоменклатуры = СерияНоменклатуры; 
			НовСтрока.Количество = НужноОприходовать;
			НовСтрока.Цена = СтрТЗ.Цена;
			НовСтрока.ЕдиницаИзмерения = НовСтрока.Номенклатура.ЕдиницаХраненияОстатков;  
			НовСтрока.Коэффициент = НовСтрока.ЕдиницаИзмерения.Коэффициент; 
			//+Гавриленков В. 18.12.2025 #UT10-5598 Временное решение
			//НовСтрока.СтавкаНДС =  НовСтрока.Номенклатура.СтавкаНДС;
			НовСтрока.СтавкаНДС = УчетНДС.ПолучитьСтавкуНДСПоНоменклатуре(НовСтрока.Номенклатура, ДокПоступление.Дата);
			//-Гавриленков В. 18.12.2025 #UT10-5598
			НовСтрока.КодСтрокиУТ11 = СтрТЗ.КодСтрокиУТ11;
			ОбработкаТабличныхЧастей.РассчитатьКоличествоМестТабЧасти(НовСтрока, ДокПоступление);
			ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(НовСтрока, ДокПоступление);
			ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НовСтрока, ДокПоступление);			
			НужноОприходовать = 0;
			
		Иначе		
			
			Для Каждого СтрРез Из Рез Цикл				
				
				Если НужноОприходовать <= 0 Тогда
					Продолжить;
				КонецЕсли;				
				
				ТекСтрока = ТекСтрока+1;				
				//Получение остатка по заказам
				Ответ = ПолучитьОстатокПоЗаказу(СтрТЗ.Номенклатура, ДокЗаказ, СтрРез.Заказ);
				
				Если Ответ = 0 Тогда
					
					ОстатокПоЗакПоставщику = 0;
					ОстатокПоЗакПокупателя = 0;
					
				Иначе
					
					ОстатокПоЗакПоставщику = Ответ.ОстатокПоЗакПоставщику;
					ОстатокПоЗакПокупателя = Ответ.ОстатокПоЗакПокупателя;
					
				КонецЕсли;				
				
				//Минусуем уже распределенное колво по заказам в рамках документа
				ОтборДок = Новый Структура();
				ОтборДок.Вставить("Номенклатура",СтрРез.Номенклатура);
				СтрокиДок = ДокПоступление.Товары.НайтиСтроки(ОтборДок);
				
				Для Каждого СтрДок Из СтрокиДок Цикл
					
					Если СтрДок.Заказ = СтрРез.Заказ Тогда
						ОстатокПоЗакПокупателя = ОстатокПоЗакПокупателя - СтрДок.Количество;
					КонецЕсли;
					
					Если СтрДок.ЗаказПоставщику = ДокЗаказ.Ссылка Тогда 
						ОстатокПоЗакПоставщику = ОстатокПоЗакПоставщику - СтрДок.Количество;
					КонецЕсли;					
					
				КонецЦикла;
				
				Если ТекСтрока = КолвоСтрок Тогда
					
					//Распределяем весь приход в цикле на последнюю строку
					Пока НужноОприходовать > 0 Цикл						
						
						НовСтрока = ДокПоступление.Товары.Добавить();
						ЗаполнитьЗначенияСвойств(НовСтрока,СтрРез);
						НовСтрока.Цена = СтрТЗ.Цена; 
						//+Гавриленков В. 18.12.2025 #UT10-5598 Временное решение
						//НовСтрока.СтавкаНДС =  НовСтрока.Номенклатура.СтавкаНДС;
						НовСтрока.СтавкаНДС = УчетНДС.ПолучитьСтавкуНДСПоНоменклатуре(НовСтрока.Номенклатура, ДокПоступление.Дата);
						//-Гавриленков В. 18.12.2025 #UT10-5598
						//+Сёмин Р.И. 29.06.2026 #UT10-5931
						НовСтрока.КодСтрокиУТ11 = СтрТЗ.КодСтрокиУТ11;
						//-Сёмин Р.И. 29.06.2026 #UT10-5931
						НовСтрока.СерияНоменклатуры = СерияНоменклатуры;
						
						Если ОстатокПоЗакПокупателя > 0 Тогда 
							
							НовСтрока.Заказ = СтрРез.Заказ;
							НовСтрока.ЗаказПоставщику = ДокЗаказ.Ссылка; 
							НовСтрока.Количество = Мин(ОстатокПоЗакПокупателя,НужноОприходовать);
							ОстатокПоЗакПокупателя = ОстатокПоЗакПокупателя - НовСтрока.Количество;
							ОстатокПоЗакПоставщику = ОстатокПоЗакПоставщику - НовСтрока.Количество;
							
						ИначеЕсли ОстатокПоЗакПоставщику > 0 Тогда
							
							НовСтрока.Заказ = Документы.ЗаказПокупателя.ПустаяСсылка();
							НовСтрока.ЗаказПоставщику = ДокЗаказ.Ссылка;
							НовСтрока.Количество = Мин(ОстатокПоЗакПоставщику, НужноОприходовать);
							ОстатокПоЗакПоставщику = ОстатокПоЗакПоставщику - НовСтрока.Количество;
							
						Иначе
							
							НовСтрока.Заказ = Документы.ЗаказПокупателя.ПустаяСсылка();
							НовСтрока.ЗаказПоставщику = Документы.ЗаказПоставщику.ПустаяСсылка();
							НовСтрока.Количество = НужноОприходовать;					
							
						КонецЕсли;
						
						ОбработкаТабличныхЧастей.ПриИзмененииЕдиницыТабЧасти(НовСтрока, ДокПоступление);
						ОбработкаТабличныхЧастей.РассчитатьКоличествоМестТабЧасти(НовСтрока, ДокПоступление);
						ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(НовСтрока, ДокПоступление);
						ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НовСтрока, ДокПоступление);					
						НужноОприходовать = НужноОприходовать - НовСтрока.Количество;
						
					КонецЦикла;
					
				ИначеЕсли НужноОприходовать > 0 Тогда
					
					Если ОстатокПоЗакПокупателя = 0 И ТекСтрока < КолвоСтрок Тогда
						Продолжить;
					КонецЕсли;
					
					//Один проход распределения
					НовСтрока = ДокПоступление.Товары.Добавить();
					ЗаполнитьЗначенияСвойств(НовСтрока, СтрРез);
					НовСтрока.Цена = СтрТЗ.Цена; 
					//+Гавриленков В. 18.12.2025 #UT10-5598 Временное решение
					//НовСтрока.СтавкаНДС =  НовСтрока.Номенклатура.СтавкаНДС;
					НовСтрока.СтавкаНДС = УчетНДС.ПолучитьСтавкуНДСПоНоменклатуре(НовСтрока.Номенклатура, ДокПоступление.Дата);
					//-Гавриленков В. 18.12.2025 #UT10-5598
					//+Сёмин Р.И. 29.06.2026 #UT10-5931
					НовСтрока.КодСтрокиУТ11 = СтрТЗ.КодСтрокиУТ11;
					//-Сёмин Р.И. 29.06.2026 #UT10-5931
					НовСтрока.СерияНоменклатуры = СерияНоменклатуры;
					
					Если ОстатокПоЗакПокупателя > 0 Тогда 
						
						НовСтрока.Заказ = СтрРез.Заказ;
						НовСтрока.ЗаказПоставщику = ДокЗаказ.Ссылка; 
						НовСтрока.Количество = Мин(ОстатокПоЗакПокупателя, НужноОприходовать);
						
					ИначеЕсли ОстатокПоЗакПоставщику > 0 Тогда						
						
						НовСтрока.Заказ = Документы.ЗаказПокупателя.ПустаяСсылка();
						НовСтрока.ЗаказПоставщику = ДокЗаказ.Ссылка;
						НовСтрока.Количество = Мин(ОстатокПоЗакПоставщику, НужноОприходовать);
						
					Иначе
						
						НовСтрока.Заказ = Документы.ЗаказПокупателя.ПустаяСсылка();
						НовСтрока.ЗаказПоставщику = Документы.ЗаказПоставщику.ПустаяСсылка();
						НовСтрока.Количество = НужноОприходовать;					
						
					КонецЕсли;
					
					ОбработкаТабличныхЧастей.ПриИзмененииЕдиницыТабЧасти(НовСтрока, ДокПоступление); 
					ОбработкаТабличныхЧастей.РассчитатьКоличествоМестТабЧасти(НовСтрока, ДокПоступление);
					ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(НовСтрока, ДокПоступление);
					ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НовСтрока, ДокПоступление);					
					НужноОприходовать = НужноОприходовать - НовСтрока.Количество;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;		
		
	КонецЦикла;
	
	//Запишем документы для последней строки таблицы
	Если ДокПоступление <> Неопределено Тогда
		
		ДокПоступление.УпаковочныеЛисты.Свернуть("НомерWMS");
		
		Если ПрямаяПоставка Тогда
			ПроверитьСуммуСНДС(ТЗНоменклатуры, ДокПоступление.Товары, ДокПоступление.ИДДокументаВСмежнойБазе);
		КонецЕсли;
		
		УстановитьПривилегированныйРежим(Истина);		
		ДокПоступление.Записать(РежимЗаписиДокумента.Запись); 
		
		//+Кабанов А.В. 12.11.2024 #UT10-4872	
		Попытка			
			ДокПоступление.Записать(РежимЗаписиДокумента.Проведение,РежимПроведенияДокумента.Неоперативный);
		Исключение
		КонецПопытки;
		//-Кабанов А.В. 12.11.2024 #UT10-4872
		
		УстановитьПривилегированныйРежим(Ложь);
		
		//+Сёмин Р.И. 05.06.2026 #UT10-5899
		ПроверитьУстановитьСтатусПТУОжидаетПодтвержденияЭДО(ДокПоступление);
		//-Сёмин Р.И. 05.06.2026 #UT10-5899
		
	КонецЕсли;
	
	Если ЗаказОбъект <> Неопределено Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		ЗаказОбъект.Записать(РежимЗаписиДокумента.Запись);
		УстановитьПривилегированныйРежим(Ложь);
		
	КонецЕсли;	
	
КонецПроцедуры

Функция СоздатьНовуюСтрочкуВДокументе(СтруктураСтроки)
	
	НоваяСтрокаДокумента =  СтруктураСтроки.Документ.Товары.Добавить();
	НоваяСтрокаДокумента.Номенклатура 		= СтруктураСтроки.Номенклатура ;
	НоваяСтрокаДокумента.ЕдиницаИзмерения  	= НоваяСтрокаДокумента.Номенклатура.ЕдиницаХраненияОстатков;
	НоваяСтрокаДокумента.Коэффициент 		= НоваяСтрокаДокумента.ЕдиницаИзмерения.Коэффициент;
	НоваяСтрокаДокумента.Склад              = СтруктураСтроки.Документ.СкладОрдер;
	
	Если СтруктураСтроки.ЗаказПокупателяУказан И СтруктураСтроки.ТекСтрока <> Неопределено Тогда 
		НоваяСтрокаДокумента.Заказ = СтруктураСтроки.ТекСтрока.ЗаказПокупателя;
	КонецЕсли;
	
	Если СтруктураСтроки.БратьУказанноеКоличество Тогда 
		НоваяСтрокаДокумента.Количество = СтруктураСтроки.КоличествоЭксель;
	Иначе
		НоваяСтрокаДокумента.Количество = Мин(СтруктураСтроки.ТекСтрока.КоличествоЗаказаноПокупателем, СтруктураСтроки.КоличествоЭксель);
	КонецЕсли;
	
	Если СтруктураСтроки.ЗаказПоставщикуУказан Тогда 
		НоваяСтрокаДокумента.ЗаказПоставщику = СтруктураСтроки.ЗаказПоставщику;
	КонецЕсли;
	
	НоваяСтрокаДокумента.СерияНоменклатуры 	= СтруктураСтроки.СерияНоменклатуры;
	//+Гавриленков В. 19.12.2025 #UT10-5598
	//НоваяСтрокаДокумента.СтавкаНДС 			= СтруктураСтроки.Номенклатура.СтавкаНДС;
	НоваяСтрокаДокумента.СтавкаНДС 			= УчетНДС.ПолучитьСтавкуНДСПоНоменклатуре(СтруктураСтроки.Номенклатура, СтруктураСтроки.Документ.Дата);
	//-Гавриленков В. 19.12.2025 #UT10-5598
	
	//+Гавриленков В. 21.01.2026 #UT10-5645
	ЗначениеСтавки = УчетНДС.ПолучитьСтавкуНДС(НоваяСтрокаДокумента.СтавкаНДС);
	ЗначениеДляРасчета = ЗначениеСтавки / (100 + ЗначениеСтавки);
	//-Гавриленков В. 21.01.2026 #UT10-5645
	
	НоваяСтрокаДокумента.Цена 			= СтруктураСтроки.ЦенаБезНДС;
	НоваяСтрокаДокумента.Сумма 			= НоваяСтрокаДокумента.Цена * НоваяСтрокаДокумента.Количество;
	//+Гавриленков В. 21.01.2026 #UT10-5645
	//НоваяСтрокаДокумента.СуммаНДС 		= ?(ТекущаяДата() >= Дата("20190101000000"), НоваяСтрокаДокумента.Сумма * 20/120, НоваяСтрокаДокумента.Сумма * 18/118); 
	НоваяСтрокаДокумента.СуммаНДС 		= НоваяСтрокаДокумента.Сумма * ЗначениеДляРасчета;
	//-Гавриленков В. 21.01.2026 #UT10-5645
	
	Возврат НоваяСтрокаДокумента; 
	
КонецФункции	

Функция ПолучитьСписокДоговоров()
	
	Рез = "(";
	СторСклад = Константы.КодДоговораСторонниеСклады.Получить();
	ЭкспрессДост = Константы.КодДоговораЭкспрессДоставка.Получить();
	ЭкспрессСам = Константы.КодДоговораЭкспрессСамовывоз.Получить();
	ПопДост = Константы.КодДоговораПополнениеДоставка.Получить();
	ПопСам = Константы.КодДоговораПополнениеСамовывоз.Получить();
	
	Если ЗначениеЗаполнено(СторСклад) тогда
		Рез = Рез+СторСклад+",";
	КонецЕсли;
	
	Если Константы.ЗагружатьЭкспрессИПополнение.Получить() тогда
		
		Если ЗначениеЗаполнено(ЭкспрессДост) тогда
			Рез = Рез + ЭкспрессДост + ",";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЭкспрессСам) тогда
			Рез = Рез + ЭкспрессСам + ",";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПопДост) тогда
			Рез = Рез + ПопДост + ",";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПопСам) тогда
			Рез = Рез + ПопСам + ",";
		КонецЕсли;
		
	КонецЕсли;
	
	Если Прав(Рез,1) = "," тогда
		Рез = Лев(Рез,СтрДлина(Рез) - 1);
	КонецЕсли;
	
	Рез = Рез + ")";
	Возврат Рез;    
	
КонецФункции

Процедура ДополнитьДокументКодамиМаркировки(ДокументДляОбработки, ИДДокументаВСмежнойБазе, тзКодыМаркировки)
	
	//+Макрушин Е. 24.09.2025 #UT10-5430
	Если НЕ ЗначениеЗаполнено(тзКодыМаркировки) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ОбщегоНазначения.ЕстьТабЧастьДокумента("КодыМаркировки", ДокументДляОбработки.Метаданные()) Тогда
		Возврат;
	КонецЕсли;
	
	ДокументДляОбработки.КодыМаркировки.Очистить();
	
	СтруктураПоиска = Новый Структура("ИДДокумента", ИДДокументаВСмежнойБазе);
	мСтрокиПоДокументу = тзКодыМаркировки.НайтиСтроки(СтруктураПоиска);
	
	Для Каждого СтрокаТаблицыКодыМаркировки Из мСтрокиПоДокументу Цикл
		
		ПодходящийКодМаркировки = Справочники.ШтрихкодыНоменклатуры.НайтиПоРеквизиту("КодМаркировки", СтрокаТаблицыКодыМаркировки.КодМаркировки);
		ПодходящаяНоменклатура = Справочники.Номенклатура.НайтиПоРеквизиту("КодМДМ", СтрокаТаблицыКодыМаркировки.КодМДМНоменклатуры);	
				
		Если ЗначениеЗаполнено(ПодходящаяНоменклатура) И НЕ ЗначениеЗаполнено(ПодходящийКодМаркировки) Тогда
			
			ПодходящийКодМаркировки = Справочники.ШтрихкодыНоменклатуры.СоздатьЭлемент();
			ПодходящийКодМаркировки.КодМаркировки = СтрокаТаблицыКодыМаркировки.КодМаркировки;
			ПодходящийКодМаркировки.Номенклатура = ПодходящаяНоменклатура;
			ПодходящийКодМаркировки.ТипПоступления = СтрокаТаблицыКодыМаркировки.ТипПоступления;
			
			//+Марков И. 06.04.2026 #UT10-5805
			Если ЗначениеЗаполнено(СтрокаТаблицыКодыМаркировки.ПолныйКодМаркировки) Тогда
				
				ПолныйКодМаркировкиСоЗнаками = СтрЗаменить(СтрокаТаблицыКодыМаркировки.ПолныйКодМаркировки , "<GS>" , Символ(29));
				ПодходящийКодМаркировки.ПолныйКодМаркировки = Новый ХранилищеЗначения(ПолныйКодМаркировкиСоЗнаками);
				
			КонецЕсли;
			//-Марков И. 06.04.2026 #UT10-5805
			
			Если ЗначениеЗаполнено(СтрокаТаблицыКодыМаркировки.ТипУпаковки) Тогда
				ПодходящийКодМаркировки.ТипУпаковки = Перечисления.ТипУпаковкиМаркировки[СтрокаТаблицыКодыМаркировки.ТипУпаковки];
			КонецЕсли;	
			
			Если ЗначениеЗаполнено(СтрокаТаблицыКодыМаркировки.ДатаПроизводства) Тогда
				ПодходящийКодМаркировки.ДатаПроизводства = СтрокаВДату(СтрокаТаблицыКодыМаркировки.ДатаПроизводства);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаТаблицыКодыМаркировки.СрокГодности) Тогда
				ПодходящийКодМаркировки.СрокГодности = СтрокаВДату(СтрокаТаблицыКодыМаркировки.СрокГодности);
			КонецЕсли;
			
			ПодходящийКодМаркировки.Записать();
			
		КонецЕсли;	
		
		СтрокаДокументаКодыМаркировки = ДокументДляОбработки.КодыМаркировки.Добавить();
		СтрокаДокументаКодыМаркировки.КодМаркировки = ПодходящийКодМаркировки.Ссылка;
		
	КонецЦикла;
	//-Макрушин Е. 24.09.2025 #UT10-5430
	
КонецПроцедуры

Процедура ПроверитьУстановитьСтатусПТУОжидаетПодтвержденияЭДО(ДокПоступление)
	
	//+Сёмин Р.И. 05.06.2026 #UT10-5899
	Если ДокПоступление.Контрагент.ИНН <> Константы.ОсновнаяОрганизация.Получить().ИНН Тогда
		
		Если МСКWEB.ЗначениеДопСвойства(ДокПоступление.Ссылка, ПланыВидовХарактеристик.СвойстваОбъектов.СтатусПодтвержденияЭДОПТУ) <> Перечисления.СтатусыПодтвержденияЭДОПТУ.Подтверждено Тогда
			МСКWEB.УстановитьЗначениеДопСвойства(ДокПоступление.Ссылка, ПланыВидовХарактеристик.СвойстваОбъектов.СтатусПодтвержденияЭДОПТУ, Перечисления.СтатусыПодтвержденияЭДОПТУ.ОжидаетПодтверждения);
		КонецЕсли;
		
	КонецЕсли;
	//-Сёмин Р.И. 05.06.2026 #UT10-5899
	
КонецПроцедуры

Функция СтрокаВДату(Знач ДатаСтрока) Экспорт
	
	//+Макрушин Е. 24.09.2025 #UT10-5430
	ДатаСтрока = Лев(СОКРЛП(ДатаСтрока), 10);
	
	СначалаГод = Найти("0123456789", Сред(ДатаСтрока, 3, 1)) > 0;
	
	ДатаСтрока = СокрЛП(СтрЗаменить(ДатаСтрока, ".", "")); 
	ДатаСтрока = СтрЗаменить(ДатаСтрока, "-", "");
	ДатаСтрока = СтрЗаменить(ДатаСтрока, "/", "");
	ДатаСтрока = СтрЗаменить(ДатаСтрока, "\", "");
	
	Если СначалаГод Тогда 
		ДатаСтрока = Лев(ДатаСтрока, 4) + Сред(ДатаСтрока, 5, 2) + Прав(ДатаСтрока, 2);  
	Иначе
		
		ДатаСтрока = Сред(ДатаСтрока, 5) + Сред(ДатаСтрока, 3, 2) + Лев(ДатаСтрока, 2);  
	
		Если СтрДлина(ДатаСтрока) = 6 Тогда
			ДатаСтрока = "20" + ДатаСтрока;
		КонецЕсли;    
		
	КонецЕсли;
	
	ОписаниеТипа = Новый ОписаниеТипов("Дата");
	Результат    = ОписаниеТипа.ПривестиЗначение(ДатаСтрока);
	
	Возврат Результат;
	//-Макрушин Е. 24.09.2025 #UT10-5430
	
КонецФункции 

