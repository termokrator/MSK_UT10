							НужноОприходовать = НужноОприходовать - НовСтрока.Количество;
							
						КонецЦикла;
						
					ИначеЕсли НужноОприходовать > 0 Тогда
						
						//Один проход распределения
						НовСтрока = ДокПоступление.Товары.Добавить();
						ЗаполнитьЗначенияСвойств(НовСтрока, СтрРез);
						НовСтрока.Цена = СтрТЗ.Цена;
