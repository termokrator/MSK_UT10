Функция ПолучитьОстатокПоЗаказу(Номенклатура, ЗаказПоставщику, ЗаказПокупателя)
	
	ТекДата = ТекущаяДата();
	ДатаКон = КонецДня(КонецДня(ТекДата) + 2);
	//+Гавриленков В. 22.08.2025 #UT10-5394  
	КоличествоДней = Справочники.МТ_ПредопределенныеЗначения.ПолучитьЗначениеПоСвойству(Справочники.МТ_ПредопределенныеЗначения.НастройкиКоличестваДней, "Количество дней для получения поступлений по заказам");
	ДатаНач = НачалоДня(ТекДата) - (?(ЗначениеЗаполнено(КоличествоДней), КоличествоДней, 5) * 24 * 60 * 60);
	//ДатаНач = НачалоДня(ТекДата) - (5*24*60*60);
	//-Гавриленков В. 22.08.2025 #UT10-5394
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	РазмещениеЗаказовПокупателейОстатки.Номенклатура КАК Номенклатура,
	|	СУММА(РазмещениеЗаказовПокупателейОстатки.КоличествоОстаток) КАК КоличествоОстаток,
	|	РазмещениеЗаказовПокупателейОстатки.ЗаказПокупателя,
	|	РазмещениеЗаказовПокупателейОстатки.ЗаказПоставщику
	|ПОМЕСТИТЬ ОстатокРегистр
	|ИЗ
	|	РегистрНакопления.РазмещениеЗаказовПокупателей.Остатки(
	|			&ДатаКон,
	|			ЗаказПоставщику = &ЗаказПоставщику
	|				И ЗаказПокупателя = &ЗаказПокупателя
	|				И Номенклатура = &Номенклатура) КАК РазмещениеЗаказовПокупателейОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	РазмещениеЗаказовПокупателейОстатки.Номенклатура,
	|	РазмещениеЗаказовПокупателейОстатки.ЗаказПокупателя,
	|	РазмещениеЗаказовПокупателейОстатки.ЗаказПоставщику
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстатокРегистр.Номенклатура,
	|	СУММА(ЕСТЬNULL(ПоступлениеТоваровУслугТовары.Количество, 0)) КАК ПоступилоПоЗакПок,
	|	ОстатокРегистр.ЗаказПокупателя,
	|	ОстатокРегистр.ЗаказПоставщику,
	|	МАКСИМУМ(ОстатокРегистр.КоличествоОстаток) КАК ОстатокПоЗакПок
	|ПОМЕСТИТЬ ПоступилоПоЗаказуПокупателя
	|ИЗ
	|	ОстатокРегистр КАК ОстатокРегистр
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг.Товары КАК ПоступлениеТоваровУслугТовары
	|		ПО ОстатокРегистр.Номенклатура = ПоступлениеТоваровУслугТовары.Номенклатура
	|			И ОстатокРегистр.ЗаказПоставщику = ПоступлениеТоваровУслугТовары.ЗаказПоставщику
	|			И ОстатокРегистр.ЗаказПокупателя = ПоступлениеТоваровУслугТовары.Заказ
	|			И (ПоступлениеТоваровУслугТовары.Ссылка.Проведен = ЛОЖЬ)
	|			И (ПоступлениеТоваровУслугТовары.Ссылка.ПометкаУдаления = ЛОЖЬ)
	|			И (ПоступлениеТоваровУслугТовары.Ссылка.Дата МЕЖДУ &ДатаНач И &ДатаКон)
	|
	|СГРУППИРОВАТЬ ПО
	|	ОстатокРегистр.Номенклатура,
	|	ОстатокРегистр.ЗаказПокупателя,
	|	ОстатокРегистр.ЗаказПоставщику
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказыПоставщикамОстатки.Номенклатура,
	|	ЗаказыПоставщикамОстатки.ЗаказПоставщику,
	|	СУММА(ЗаказыПоставщикамОстатки.КоличествоОстаток) КАК КоличествоОстаток
	|ПОМЕСТИТЬ ОстатокПоЗаказуПоставщику
	|ИЗ
	|	РегистрНакопления.ЗаказыПоставщикам.Остатки(
	|			&ДатаКон,
	|			ЗаказПоставщику = &ЗаказПоставщику
	|				И Номенклатура = &Номенклатура) КАК ЗаказыПоставщикамОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказыПоставщикамОстатки.Номенклатура,
	|	ЗаказыПоставщикамОстатки.ЗаказПоставщику
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстатокПоЗаказуПоставщику.Номенклатура,
	|	СУММА(ЕСТЬNULL(ПоступлениеТоваровУслугТовары.Количество, 0)) КАК ПоступилоПоЗакПост,
	|	ОстатокПоЗаказуПоставщику.ЗаказПоставщику,
	|	МАКСИМУМ(ОстатокПоЗаказуПоставщику.КоличествоОстаток) КАК ОстатокПоЗакПост
	|ПОМЕСТИТЬ ПоступилоПоЗаказуПоставщику
	|ИЗ
	|	ОстатокПоЗаказуПоставщику КАК ОстатокПоЗаказуПоставщику
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг.Товары КАК ПоступлениеТоваровУслугТовары
	|		ПО ОстатокПоЗаказуПоставщику.Номенклатура = ПоступлениеТоваровУслугТовары.Номенклатура
	|			И ОстатокПоЗаказуПоставщику.ЗаказПоставщику = ПоступлениеТоваровУслугТовары.ЗаказПоставщику
	|			И (ПоступлениеТоваровУслугТовары.Ссылка.ПометкаУдаления = ЛОЖЬ)
	|			И (ПоступлениеТоваровУслугТовары.Ссылка.Проведен = ЛОЖЬ)
	|			И (ПоступлениеТоваровУслугТовары.Ссылка.Дата МЕЖДУ &ДатаНач И &ДатаКон)
	|
	|СГРУППИРОВАТЬ ПО
	|	ОстатокПоЗаказуПоставщику.Номенклатура,
	|	ОстатокПоЗаказуПоставщику.ЗаказПоставщику
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПоступилоПоЗаказуПоставщику.Номенклатура,
	|	ПоступилоПоЗаказуПоставщику.ОстатокПоЗакПост,
	|	ПоступилоПоЗаказуПоставщику.ПоступилоПоЗакПост,
	|	МАКСИМУМ(ПоступилоПоЗаказуПоставщику.ОстатокПоЗакПост - ПоступилоПоЗаказуПоставщику.ПоступилоПоЗакПост) КАК ОстатокПоЗакПоставщику,
	|	ПоступилоПоЗаказуПокупателя.ОстатокПоЗакПок,
	|	ПоступилоПоЗаказуПокупателя.ПоступилоПоЗакПок,
	|	МАКСИМУМ(ЕСТЬNULL(ПоступилоПоЗаказуПокупателя.ОстатокПоЗакПок - ПоступилоПоЗаказуПокупателя.ПоступилоПоЗакПок, 0)) КАК ОстатокПоЗакПокупателя
	|ИЗ
	|	ПоступилоПоЗаказуПоставщику КАК ПоступилоПоЗаказуПоставщику
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПоступилоПоЗаказуПокупателя КАК ПоступилоПоЗаказуПокупателя
	|		ПО ПоступилоПоЗаказуПоставщику.Номенклатура = ПоступилоПоЗаказуПокупателя.Номенклатура
	|			И ПоступилоПоЗаказуПоставщику.ЗаказПоставщику = ПоступилоПоЗаказуПокупателя.ЗаказПоставщику
	|
	|СГРУППИРОВАТЬ ПО
	|	ПоступилоПоЗаказуПоставщику.Номенклатура,
	|	ПоступилоПоЗаказуПокупателя.ПоступилоПоЗакПок,
	|	ПоступилоПоЗаказуПокупателя.ОстатокПоЗакПок,
	|	ПоступилоПоЗаказуПоставщику.ПоступилоПоЗакПост,
	|	ПоступилоПоЗаказуПоставщику.ОстатокПоЗакПост");
	
	Запрос.Параметры.Вставить("ДатаНач", ДатаНач);
	Запрос.Параметры.Вставить("ДатаКон", ДатаКон);
	Запрос.Параметры.Вставить("ЗаказПоставщику", ЗаказПоставщику);
	Запрос.Параметры.Вставить("ЗаказПокупателя", ЗаказПокупателя);
	Запрос.Параметры.Вставить("Номенклатура", Номенклатура);
	
	РезЗапроса = Запрос.Выполнить();
	
	Выборка = РезЗапроса.Выбрать();
	
	Ответ = Новый Структура;
	
	Если Выборка.Следующий() Тогда
		
		Ответ.Вставить("ОстатокПоЗакПоставщику", Выборка.ОстатокПоЗакПоставщику);
		Ответ.Вставить("ОстатокПоЗакПокупателя", Выборка.ОстатокПоЗакПокупателя);
		Возврат Ответ;
		
	Иначе
		Возврат 0;
	КонецЕсли;	
	
КонецФункции

Функция НайтиПоступлениеПоНомеруВходящегоДокумента(НомерВходящегоДокумента, ДатаВходящегоДокумента, ПроверятьНомерБезпробелов = Ложь)
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ПоступлениеТоваровУслуг.Ссылка
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
	|ГДЕ
	|	ПоступлениеТоваровУслуг.ПометкаУдаления = ЛОЖЬ
	|	И (ПоступлениеТоваровУслуг.НомерВходящегоДокумента = &НомерВходящегоДокумента
	|     ИЛИ ПоступлениеТоваровУслуг.НомерВходящегоДокумента = &НомерВходящегоДокументаБезПробелов) 
	|	И ПоступлениеТоваровУслуг.ДатаВходящегоДокумента = &ДатаВходящегоДокумента");
	
	Запрос.Параметры.Вставить("НомерВходящегоДокумента", НомерВходящегоДокумента);
	Запрос.Параметры.Вставить("ДатаВходящегоДокумента", НачалоДня(ДатаВходящегоДокумента));
	Запрос.Параметры.Вставить("НомерВходящегоДокументаБезПробелов", ?(ПроверятьНомерБезпробелов, СокрЛП(НомерВходящегоДокумента), НомерВходящегоДокумента));
    
	РезЗапроса = Запрос.Выполнить();
	
	Если РезЗапроса.Пустой() Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;	
	
КонецФункции

Функция НайтиПоступлениеТОХПоНомеруВходящегоДокумента(НомерВходящегоДокумента, ДатаВходящегоДокумента, ПроверятьНомерБезпробелов = Ложь)
	
