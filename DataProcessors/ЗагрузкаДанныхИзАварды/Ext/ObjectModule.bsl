				ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НовСтрока, ДокПоступление);
				НужноОприходовать = 0;          
				
			Иначе		
				
				Для Каждого СтрРез Из Рез Цикл  
					
					ТекСтрока = ТекСтрока + 1;
					
					Если ЗначениеЗаполнено(СтрТЗ.НазначениеСтруктура) И ТипЗнч(СтрТЗ.НазначениеСтруктура) = Тип("Структура") И ЗначениеЗаполнено(СтрРез.Заказ) Тогда 
						
						Если (СтрРез.Заказ.Номер <> СтрТЗ.НазначениеСтруктура.НомерЗаказа) Тогда
							Продолжить;
						КонецЕсли;     
						
					Иначе 
						
						Если ЗначениеЗаполнено(СтрРез.Заказ) И СтрРез.Заказ.ОбособленнаяОтгрузкаГМИзСтороннегоФилиала Тогда
