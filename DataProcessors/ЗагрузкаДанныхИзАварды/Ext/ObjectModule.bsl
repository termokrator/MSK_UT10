Перем Подключение,RS;
Перем ОписаниеТиповСтрока, ОписаниеТиповДата, ОписаниеТиповЧисло, ОписаниеТиповЧислоСРазрядами; 

Процедура ВыполнитьРаботу(НомерЗаказаАварды = Неопределено) Экспорт
	
	ЗапросИсключаемыхИзЭкспрессаСкладов = Новый Запрос;
	ЗапросИсключаемыхИзЭкспрессаСкладов.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СобственныеСклады.Ссылка КАК Склад
	|ИЗ
	|	Справочник.СобственныеСклады КАК СобственныеСклады
	|ГДЕ
	|	СобственныеСклады.ИсключитьИзОбщегоЭкспресса
	|	И НЕ (ВЫРАЗИТЬ(СобственныеСклады.АдресВебСервиса КАК СТРОКА(256))) = """"
	|	И НЕ СобственныеСклады.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	СобственныеСклады.Идентификатор";
	
	РезультатЗапросаИсключаемыхИзЭкспрессаСкладов = ЗапросИсключаемыхИзЭкспрессаСкладов.Выполнить();
	
	Если НЕ РезультатЗапросаИсключаемыхИзЭкспрессаСкладов.Пустой() Тогда
		
		ВыборкаСкладов = РезультатЗапросаИсключаемыхИзЭкспрессаСкладов.Выбрать();
		
		Пока ВыборкаСкладов.Следующий() Цикл
			
			Если ВыборкаСкладов.Склад.ВэбСервисУТ11 Тогда
				
				//+Белов А. 14.04.2026 #UT10-5816 - добавил условие СоздаватьПоступленияЧерезЭДО
				Если Не ВыборкаСкладов.Склад.СоздаватьПоступленияЧерезЭДО Тогда
					ЗагрузкаПоступленийПоДаннымИзСтороннейУТ11(, НомерЗаказаАварды,ВыборкаСкладов.Склад);	
				КонецЕсли;
				
			Иначе				
				ЗагрузкаПоступленийПоДаннымИзСтороннейБазы(,ВыборкаСкладов.Склад);
			КонецЕсли;
			
		КонецЦикла;		
		
	КонецЕсли;	
	
	Если Константы.ОтправлятьЗаказыВСтророннююУТ.Получить() Тогда
		ЗагрузкаПоступленийПоДаннымИзСтороннейБазы();
	КонецЕсли;	
	
	Если Константы.ОтправлятьЗаказыВСтророннююУТ11.Получить() Тогда
		ЗагрузкаПоступленийПоДаннымИзСтороннейУТ11(, НомерЗаказаАварды);
	КонецЕсли;
	
	Если Константы.ГорючиеЖидкостиВОтдельныйЗаказ.Получить() Тогда
		ЗагрузкаПоступленийПоДаннымИзСтороннейУТ11("ГорючиеЖидкости", НомерЗаказаАварды);                                                        
	КонецЕсли;
	
	Если Константы.ОтправлятьЭкспрессыВ.Получить() Тогда
		
		Если Константы.ПриоритетОтправкиЭкспрессов.Получить() = Перечисления.ПриоритетыОтправкиЭкспрессов.УТ10 Тогда
			ЗагрузкаПоступленийПоДаннымИзСтороннейБазы("Экспрессы");
		ИначеЕсли Константы.ПриоритетОтправкиЭкспрессов.Получить() = Перечисления.ПриоритетыОтправкиЭкспрессов.УТ11 Тогда
			ЗагрузкаПоступленийПоДаннымИзСтороннейУТ11("Экспрессы", НомерЗаказаАварды); 
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры

Функция ПолучитьТаблицуАварды(НомерЗаказаАварды = Неопределено)
	
	Подключение = Неопределено;
	RS = Неопределено;
	Подключение = Новый COMObject("ADODB.Connection");	
	
	Если НЕ РаботаСАвардой.Соединение(Подключение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДатаНТ = ПолучитьДату(ТекущаяДата() - 100 * 24 * 60 * 60);
	ДатаКТ = ПолучитьДату(ТекущаяДата() + 10 * 24 * 60 * 60);
	
	Если ЗначениеЗаполнено(НомерЗаказаАварды) Тогда
		
		ТекстЗапроса = "SELECT did, did7, dconcept, dcode, dstate, ddate1, dnum1, did1, did10, dnum3, did5, did4,
		|dname, dtext1, datainvoice, did6, did3, datascheta, ddate, dogid, kpp_1c
		| FROM az_get_6051_6001(null, '" + ДатаНТ + "', '" + ДатаКТ + "',6051, null, 2401, null, null, null)  
		| WHERE dogid in " + ПолучитьСписокДоговоров() + "
		|       and dcode = " + НомерЗаказаАварды + "";
		
	Иначе	
		
		ТекстЗапроса = "SELECT did, did7, dconcept, dcode, dstate, ddate1, dnum1, did1, did10, dnum3, did5, did4,
		|dname, dtext1, datainvoice, did6, did3, datascheta, ddate, dogid, kpp_1c
		| FROM az_get_6051_6001(null, '" + ДатаНТ + "', '" + ДатаКТ + "',6051, 163100002, 2401, null, null, null)  
		| WHERE dogid in " + ПолучитьСписокДоговоров();
		
	КонецЕсли;
	
	RS = РаботаСАвардой.СформироватьЗапрос(ТекстЗапроса, Подключение);
	
	ТаблицаАварды = Новый ТаблицаЗначений;
	
	Если RS <> Неопределено Тогда
		
		Для Счетчик = 1 По RS.Fields.Count Цикл
			
			Поле = RS.Fields.Item(Счетчик - 1);
			ИмяПоля = НРег(СокрЛП(Поле.Name));
			
			Если ИмяПоля = "did" ИЛИ ИмяПоля = "did7" ИЛИ ИмяПоля = "dconcept" ИЛИ ИмяПоля = "dstate" ИЛИ ИмяПоля = "did1" 
				ИЛИ ИмяПоля = "did10" ИЛИ ИмяПоля = "did5" ИЛИ ИмяПоля = "did4" ИЛИ ИмяПоля = "did6" ИЛИ ИмяПоля = "did3" ИЛИ ИмяПоля = "dogid" Тогда
				Колонка = ТаблицаАварды.Колонки.Добавить(ИмяПоля, ОписаниеТиповЧисло, ИмяПоля); 					
			ИначеЕсли ИмяПоля = "dnum1" ИЛИ ИмяПоля = "dnum3" Тогда
				Колонка = ТаблицаАварды.Колонки.Добавить(ИмяПоля, ОписаниеТиповДата, ИмяПоля); 					
			ИначеЕсли ИмяПоля = "ddate1" ИЛИ ИмяПоля = "datascheta" ИЛИ ИмяПоля = "datainvoice" ИЛИ ИмяПоля = "ddate"Тогда
				Колонка = ТаблицаАварды.Колонки.Добавить(ИмяПоля,ОписаниеТиповДата, Поле.Name); 					
			Иначе					
				Колонка = ТаблицаАварды.Колонки.Добавить(ИмяПоля, ОписаниеТиповСтрока, ИмяПоля);
			КонецЕсли;
			
		КонецЦикла;
		
		Пока RS.EOF() = 0 Цикл		
			
			НоваяСтрока = ТаблицаАварды.Добавить();           		
			
			Для Счетчик = 1 По RS.Fields.Count Цикл 
				
				Поле = RS.Fields.Item(Счетчик - 1);
				НоваяСтрока[Поле.Name] = Поле.Value;			
				
			КонецЦикла;    		
			
			RS.MoveNext(); 		
			
		КонецЦикла;
		
		RS.Close(); 
		RS = Неопределено;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НомерЗаказаАварды) Тогда
		
		ТекстЗапроса = "SELECT did, did7, dconcept, dcode, dstate, ddate1, dnum1, did1, did10, dnum3, did5, did4,
		|dname, dtext1, datainvoice, did6, did3, datascheta, ddate, dogid, kpp_1c
		| FROM az_get_6051_6001(null, '" + ДатаНТ + "', '" + ДатаКТ + "',6051, 20163, 2401, null, null, null) 
		| WHERE dogid in " + ПолучитьСписокДоговоров();
		
		RS = РаботаСАвардой.СформироватьЗапрос(ТекстЗапроса, Подключение);
		
		Если RS <> Неопределено Тогда
			
			Если ТаблицаАварды.Колонки.Количество() = 0 тогда
				
				Для Счетчик = 1 По RS.Fields.Count Цикл
					
					Поле = RS.Fields.Item(Счетчик - 1);
					ИмяПоля = НРег(СокрЛП(Поле.Name));
					
					Если ИмяПоля = "did" ИЛИ ИмяПоля = "did7" ИЛИ ИмяПоля = "dconcept" ИЛИ ИмяПоля = "dstate" ИЛИ ИмяПоля = "did1" 
						ИЛИ ИмяПоля = "did10" ИЛИ ИмяПоля = "did5" ИЛИ ИмяПоля = "did4" ИЛИ ИмяПоля = "did6" ИЛИ ИмяПоля = "did3" ИЛИ ИмяПоля = "dogid" Тогда
						Колонка = ТаблицаАварды.Колонки.Добавить(ИмяПоля, ОписаниеТиповЧисло, ИмяПоля); 					
					ИначеЕсли ИмяПоля = "dnum1" ИЛИ ИмяПоля = "dnum3" Тогда
						Колонка = ТаблицаАварды.Колонки.Добавить(ИмяПоля, ОписаниеТиповДата, ИмяПоля); 					
					ИначеЕсли ИмяПоля = "ddate1" ИЛИ ИмяПоля = "datascheta" ИЛИ ИмяПоля = "datainvoice" ИЛИ ИмяПоля = "ddate"Тогда
						Колонка = ТаблицаАварды.Колонки.Добавить(ИмяПоля,ОписаниеТиповДата, Поле.Name); 					
					Иначе					
						Колонка = ТаблицаАварды.Колонки.Добавить(ИмяПоля, ОписаниеТиповСтрока, ИмяПоля);
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
			Пока RS.EOF() = 0 Цикл		
				
				НоваяСтрока = ТаблицаАварды.Добавить();           		
				
				Для Счетчик = 1 По RS.Fields.Count Цикл 
					
					Поле = RS.Fields.Item(Счетчик - 1);
					НоваяСтрока[Поле.Name] = Поле.Value;			
					
				КонецЦикла;    		
				
				RS.MoveNext(); 		
				
			КонецЦикла;
			
			RS.Close(); 
			RS = Неопределено;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТаблицаАварды.Количество() > 0 И НомерЗаказаАварды = Неопределено Тогда
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("did4", 62375063);
		Рез = ТаблицаАварды.НайтиСтроки(ПараметрыОтбора);
		
		Для Каждого СтрРез Из Рез Цикл
			ТаблицаАварды.Удалить(СтрРез);
		КонецЦикла;		
		
	КонецЕсли;
	
	Возврат ?(ТаблицаАварды.Количество(), ТаблицаАварды, Неопределено);
	
КонецФункции

Функция ПолучитьТаблицуГТД(ТаблицаДокументов)
	
	ТаблицаГТД = Новый ТаблицаЗначений;
	
	Попытка	                                                                                                    
		
		Прокси = WSСсылки.GetGTD.СоздатьWSПрокси("http://1c-ut.moskvorechie.ru/ut11","GetGTD", "GetGTDSoap", ,300);
		ХЗ = Прокси.ПолучитьТаблицуГТД(ЗначениеВХранилище(ТаблицаДокументов)); 	
		ТаблицаГТД = ЗначениеИзХранилища(ХЗ);
		
	Исключение
		ОшибкаЗагрузки("Ошибка подключения к веб-сервису", ОписаниеОшибки());
	КонецПопытки;
	
	Возврат ?(ТаблицаГТД.Количество(), ТаблицаГТД, Неопределено);
	
КонецФункции

Функция ПолучитьТаблицуСтрок(ТаблицаДокументов)
	
	ТаблицаСтрок = Новый ТаблицаЗначений;
	ТаблицаСтрок.Колонки.Добавить("dcode", ОписаниеТиповСтрока, "dcode");
	ТаблицаСтрок.Колонки.Добавить("ddate", ОписаниеТиповДата, "ddate");
	ТаблицаСтрок.Колонки.Добавить("НомерЗаказа", ОписаниеТиповСтрока);
	ТаблицаСтрок.Колонки.Добавить("ДатаЗаказа", ОписаниеТиповДата);
	ТаблицаСтрок.Колонки.Добавить("НомерСтрокиЗаказа", ОписаниеТиповЧисло);
	
	Для Каждого Стр Из ТаблицаДокументов Цикл
		ВыбратьСтрокиДокумента(Стр, ТаблицаСтрок);
	КонецЦикла;
	
	Возврат ?(ТаблицаСтрок.Количество(), ТаблицаСтрок, Неопределено);
	
КонецФункции

Процедура ВыбратьСтрокиДокумента(Выборка, ТаблицаСтрок)   
	
	НПП = 1;
	
	Запрос = "SELECT L.etext1 AS UID, LB.ltext2 AS InvNum, LB.LCODE AS CODE, LB.LID AS LID , LB.ltext1 AS ART ,(L.ENUM1*L.ENUM2) AS Q, (L.ENUM11*L.ENUM2) AS Q2, L.ENUM4 AS PRICE, L.ENUM14 AS Summa, RS.VAL AS SUMMNDS, L.ECODE AS ECODE, LB.LID3 AS LID3, L.EID AS EID, L.ENUM7 AS NDS, lb1.lname as name FROM LIN L LEFT JOIN LIB LB ON (LB.LID = L.EID1) LEFT JOIN xecnum RS ON RS.owner = L.eid AND RS.concept = 75001800 AND RS.node = 75001805 AND RS.parent = 75001801 LEFT JOIN xecint x on x.owner = l.eid and x.CONCEPT = 75001800 AND x.NODE = 75001804 left join lib lb1 on lb1.lid = x.val WHERE L.EIDDOC ="+ФорматироватьСтроку(Выборка.did);
	
	РСТС = Неопределено;
	РСТС = РаботаСАвардой.СформироватьЗапрос(Запрос,Подключение);
	
	Если РСТС = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Счетчик = 1 По РСТС.Fields.Count Цикл
		
		Поле = РСТС.Fields.Item(Счетчик - 1);
		ИмяПоля = НРег(СокрЛП(Поле.Name));
		
		Если ТаблицаСтрок.Колонки.Найти(ИмяПоля) = Неопределено Тогда
			
			Если ИмяПоля = "ddate1" ИЛИ ИмяПоля = "datascheta" ИЛИ ИмяПоля = "datainvoice" ИЛИ ИмяПоля = "ddate"Тогда
				Колонка = ТаблицаСтрок.Колонки.Добавить(ИмяПоля, ОписаниеТиповДата, ИмяПоля);
			ИначеЕсли ИмяПоля = "q" ИЛИ ИмяПоля = "price" ИЛИ ИмяПоля = "summa" Тогда
				Колонка = ТаблицаСтрок.Колонки.Добавить(ИмяПоля, ОписаниеТиповЧислоСРазрядами, ИмяПоля);
			Иначе					
				Колонка = ТаблицаСтрок.Колонки.Добавить(ИмяПоля, ОписаниеТиповСтрока, ИмяПоля);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Пока РСТС.EOF() = 0 Цикл		
		
		НоваяСтрока = ТаблицаСтрок.Добавить(); 
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		Для Счетчик = 1 По РСТС.Fields.Count Цикл 
			
			Поле = РСТС.Fields.Item(Счетчик - 1);
			НоваяСтрока[Поле.Name] = Поле.Value;
			
			Если Поле.Name = "UID" Тогда
				
				ДанныеЗаказа = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(Поле.Value, "/");
				
				Если НЕ ДанныеЗаказа = Неопределено Тогда
					
					Если ДанныеЗаказа.Количество() = 3 Тогда
						
						НоваяСтрока.НомерЗаказа = ДанныеЗаказа[0];
						ДатаЗаказа = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(ДанныеЗаказа[1], ".");
						НоваяСтрока.НомерСтрокиЗаказа = Число(ДанныеЗаказа[2]);
						
						Если НЕ ДатаЗаказа = Неопределено Тогда
							
							Если ДатаЗаказа.Количество() = 3 Тогда
								НоваяСтрока.ДатаЗаказа = Дата(ДатаЗаказа[2], ДатаЗаказа[1], ДатаЗаказа[0]);
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;  
		
		РСТС.MoveNext(); 		
		
	КонецЦикла;
	
	РСТС.Close(); 			
	РСТС = Неопределено;
	
КонецПроцедуры

Функция НайтиНоменклатуру(НаименованиеНоменклатуры, КодНоменклатурыВМоскве, ЕдИзм)
	
	Номенклатура = Справочники.Номенклатура.НайтиПоРеквизиту("КодПоБазеМоскоречье", КодНоменклатурыВМоскве);
	
	Возврат Номенклатура;
	
	Если Номенклатура = Справочники.Номенклатура.ПустаяСсылка() Тогда
		
	Иначе 
		Возврат Номенклатура;
	КонецЕсли;     
	
КонецФункции

Функция СоздатьСерию(Номенклатура, НомерГТД, Страна, НомерГТДСсылка)
	
	Серия = Справочники.СерииНоменклатуры.НайтиПоНаименованию(НомерГТД, Истина,, Номенклатура);
	
	Если ЗначениеЗаполнено(Серия) тогда
		Возврат Серия
	КонецЕсли;
	
	СерияНоменклатуры = Справочники.СерииНоменклатуры.СоздатьЭлемент();
	СерияНоменклатуры.Владелец = Номенклатура;
	СерияНоменклатуры.Наименование = НомерГТД;
	СерияНоменклатуры.СтранаПроисхождения = Страна;
	СерияНоменклатуры.Комментарий = "Создан регламентным заданием загрузки из аварды " + ТекущаяДата();
	
	Если ЗначениеЗаполнено(НомерГТДСсылка) Тогда
		СерияНоменклатуры.НомерГТД = НомерГТДСсылка;
	Иначе
		
		Номер = Справочники.НомераГТД.НайтиПоКоду(НомерГТД);
		
		Если Не ЗначениеЗаполнено(Номер) тогда
			
			НомерГТДОбъект = Справочники.НомераГТД.СоздатьЭлемент();
			НомерГТДОбъект.Код = НомерГТД;
			НомерГТДОбъект.Комментарий = "Создан регламентным заданием загрузки из аварды " + ТекущаяДата();
			НомерГТДОбъект.Записать();
			СерияНоменклатуры.НомерГТД = НомерГТДОбъект.Ссылка;
			
		Иначе
			СерияНоменклатуры.НомерГТД = Номер;
		КонецЕсли;
		
	КонецЕсли;
	
	СерияНоменклатуры.Записать(); 
	
	Возврат СерияНоменклатуры.Ссылка; 
	
КонецФункции

Процедура ОшибкаЗагрузки(ТекстОшибки , ОписаниеОшибки)
	
	ЗаписьЖурналаРегистрации("Загрузка данных из аварды", УровеньЖурналаРегистрации.Ошибка, , ,
	ТекстОшибки + ":" + ОписаниеОшибки); 		
	
	МЗ = РегистрыСведений.ОшибкиЗагрузкиДанныхИзАварды.СоздатьМенеджерЗаписи();
	МЗ.МоментОшибки = ТекущаяДата();
	МЗ.ТекстОшибки = ТекстОшибки;
	МЗ.ОписаниеОшибки = ОписаниеОшибки;
	МЗ.Записать();
	
