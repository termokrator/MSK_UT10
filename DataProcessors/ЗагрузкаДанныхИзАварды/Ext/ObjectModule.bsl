				ГМ = Формат(ДатаГМ,"ДФ=ddMMyyyyЧЧммсс") + "1" + Формат(Число(СтрТЗ.ГМСтруктура.Номер),"ЧЦ=10; ЧВН=; ЧГ=0"); 
				
