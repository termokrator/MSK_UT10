	Иначе
		Возврат Истина;
	КонецЕсли;	
	
КонецФункции

Процедура ЗагрузкаПоступленийПоДаннымИзСтороннейБазы(ВидОперации = "", Склад = Неопределено) 
	
	ТЗНоменклатуры = Новый ТаблицаЗначений;
	ТЗНоменклатуры.Колонки.Добавить("НомерДокумента");
	ТЗНоменклатуры.Колонки.Добавить("ДатаДокумента");
	ТЗНоменклатуры.Колонки.Добавить("Номенклатура");
	ТЗНоменклатуры.Колонки.Добавить("Артикул"); //НормализованныйКод				
	ТЗНоменклатуры.Колонки.Добавить("Количество");
	ТЗНоменклатуры.Колонки.Добавить("Комментарий");
	ТЗНоменклатуры.Колонки.Добавить("Цена");
	ТЗНоменклатуры.Колонки.Добавить("НомерГТДКод");
	ТЗНоменклатуры.Колонки.Добавить("СтранаПроисхожденияКод");
	ТЗНоменклатуры.Колонки.Добавить("СФНомер");
	ТЗНоменклатуры.Колонки.Добавить("СФДата");
	ТЗНоменклатуры.Колонки.Добавить("ЗаказПоставщика");
	ТЗНоменклатуры.Колонки.Добавить("ИДДокументаВСмежнойБазе");
	ТЗНоменклатуры.Колонки.Добавить("Сумма");
	ТЗНоменклатуры.Колонки.Добавить("СуммаНДС");
	ТЗНоменклатуры.Колонки.Добавить("НазначениеСтруктура");
	ТЗНоменклатуры.Колонки.Добавить("Назначение");
	ТЗНоменклатуры.Колонки.Добавить("ГМСтруктура");
	ТЗНоменклатуры.Колонки.Добавить("ГМ");
	ТЗНоменклатуры.Колонки.Добавить("ДоговорПоставщикаТОХКодМДМ");
	ТЗНоменклатуры.Колонки.Добавить("НомерСкладскогоДокумента");
	
	//+Шульман А. 16.12.2024 #UT10-4995 
	ТЗНоменклатуры.Колонки.Добавить("ВидПроцесса", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыПроцессов"));
	ТЗНоменклатуры.Колонки.Добавить("Филиал");
	
	//+Кабанов А.В. 23.06.2025 # UT10-5295
	ТЗНоменклатуры.Колонки.Добавить("ВозвратПоставщикуБезРазбораВГП");
	//-Кабанов А.В. 23.06.2025 # UT10-5295
	
	//+Белов А. 11.01.2025 #UT10-5006
	ТЗНоменклатуры.Колонки.Добавить("МассивТЕ");
	//-Белов А. 11.01.2025 #UT10-5006
	
	СоотвВидПроцесса = Новый Соответствие;
	СоотвВидПроцесса.Вставить("Возврат неликвида ТОХ через WMS", Перечисления.ВидыПроцессов.ВозвратНеликвидаТОХчерезWMS);
	СоотвВидПроцесса.Вставить("Перемещение неликвида ТОХ в ГП", Перечисления.ВидыПроцессов.ПеремещениеНеликвидаТОХвГП);
	//-Шульман А. 16.12.2024 #UT10-4995 
	
	Результат = МСКWEB.ПолучитьРеализацииВСтороннейБазе(Ложь, ВидОперации,Склад);
	
	//Обработка таблицы с ответом
	Если Результат.Загружен Тогда
		
		СписокДанных = Результат.СписокДанных;    
		
		Для Каждого Элем Из СписокДанных Цикл
			
			НовСтрока = ТЗНоменклатуры.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока,Элем);
			НовСтрока.Номенклатура = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул",Элем.Артикул); //НормализованныйКод 
			
			Если ЗначениеЗаполнено(Элем.ЗаказПокупателя) Тогда
				НовСтрока.ЗаказПоставщика = Документы.ЗаказПоставщику.НайтиПоРеквизиту("ГУИДЗаказаПокупателя",Элем.ЗаказПокупателя);
			КонецЕсли;
			
			//+Шульман А. 16.12.2024 #UT10-4995  
			НовСтрока.ВидПроцесса = СоотвВидПроцесса.Получить(Элем.ВидПроцесса);       
			
			Если Не ПустаяСтрока(Элем.КодМДМФилиала) Тогда
				//И НовСтрока.ВидПроцесса = Перечисления.ВидыПроцессов.ПеремещениеНеликвидаТОХвГП Тогда
				НовСтрока.Филиал = Справочники.Контрагенты.НайтиПоРеквизиту("КодМДМ", Элем.КодМДМФилиала);
			КонецЕсли;
			//-Шульман А. 16.12.2024 #UT10-4995 
			
			//+Кабанов А.В. 23.06.2025 # UT10-5295
			Если Элем.Свойство("ВозвратПоставщикуБезРазбораВГП") Тогда
				НовСтрока.ВозвратПоставщикуБезРазбораВГП = Элем.ВозвратПоставщикуБезРазбораВГП;
			КонецЕсли;
			//-Кабанов А.В. 23.06.2025 # UT10-5295
			
		КонецЦикла;		
		
	КонецЕсли;
	
	Если ТЗНоменклатуры.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	//+Макрушин Е. 24.09.2025 #UT10-5441
	Если Результат.Свойство("ДополнительныеДанные") И Результат.ДополнительныеДанные.Свойство("КодыМаркировки") Тогда
		тзКодыМаркировки = ОбщегоНазначения.ПреобразоватьМассивВТаблицуЗначений(Результат.ДополнительныеДанные.КодыМаркировки);
	Иначе
		тзКодыМаркировки = Неопределено;
	КонецЕсли;
	//-Макрушин Е. 24.09.2025 #UT10-5441
	
	НомерДокумента = "";
	ДокПоступление = Неопределено;
	//+Гавриленков В. 05.02.2026 #UT10-5682
	//ДокЗаказ = Неопределено;      
	//-Гавриленков В. 05.02.2026 #UT10-5682
	ЗаказОбъект = Неопределено;
	ЕстьДокумент = Ложь;
	ЗаказПоставщикуЕстьЭкспресс = Ложь;
	ДоговорПоставщикаТОХКодМДМ = "";  
	ЭтоПополнениеТОХ = Ложь; 
	ДокПоступлениеТОХ = Неопределено;
	НомерСкладскогоДокументаТОХ = "";
	
	Для Каждого СтрТЗ Из ТЗНоменклатуры Цикл
		
		Если Не ЗначениеЗаполнено(СтрТЗ.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;		
		
		Если НомерДокумента <> СтрТЗ.НомерДокумента Тогда 
			
			//+Гавриленков В. 05.02.2026 #UT10-5682
			ДокЗаказ = Неопределено;      
			//-Гавриленков В. 05.02.2026 #UT10-5682
			
			НомерДокумента = СтрТЗ.НомерДокумента;
			ДатаДокумента  = Дата(СтрТЗ.ДатаДокумента);    
			
			//+Шульман А. 16.12.2024 #UT10-4995 
			Филиал = СтрТЗ.Филиал;
			ВидПроцесса = СтрТЗ.ВидПроцесса;
			//-Шульман А. 16.12.2024 #UT10-4995
			
			//+Кабанов А.В. 23.06.2025 # UT10-5295
			мВозвратПоставщикуБезРазбораВГП = СтрТЗ.ВозвратПоставщикуБезРазбораВГП;
			//-Кабанов А.В. 23.06.2025 # UT10-5295
			
			Если НЕ ТЗНоменклатуры.Колонки.Найти("НомерСкладскогоДокумента") = Неопределено Тогда				
				НомерСкладскогоДокументаТОХ  = СтрТЗ.НомерСкладскогоДокумента;
			Иначе
				НомерСкладскогоДокументаТОХ = "";
			КонецЕсли;

			Если НЕ ДокПоступление = Неопределено Тогда
				
				ДокПоступление.Экспресс = ЗаказПоставщикуЕстьЭкспресс;
				ПроверитьСуммуСНДСУТ10(ТЗНоменклатуры, ДокПоступление.Товары, ДокПоступление.ИДДокументаВСмежнойБазе); 
				
				ТранзитнаяПоставкаЧерезСкладWMS = Ложь;
				
				Если ДокПоступление.Товары.Количество() > 0 Тогда
					
					Для Каждого Строка Из ДокПоступление.Товары Цикл
						
						Если ЗначениеЗаполнено(Строка.ЗаказПоставщику) и Строка.ЗаказПоставщику.ТранзитнаяПоставкаЧерезСкладWMS Тогда
							
							ТранзитнаяПоставкаЧерезСкладWMS = Истина;
							Прервать;
							
						КонецЕсли;
						
					КонецЦикла;
					
				Иначе
					
					Если ЗначениеЗаполнено(ДокПоступление.Сделка) и ДокПоступление.Сделка.ТранзитнаяПоставкаЧерезСкладWMS Тогда
						ТранзитнаяПоставкаЧерезСкладWMS = Истина;
					КонецЕсли;
					
				КонецЕсли;
				
				УстановитьПривилегированныйРежим(Истина);
				
				ДокПоступление.Записать(РежимЗаписиДокумента.Запись); 
				
				//+Кабанов А.В. 12.11.2024 #UT10-4872	
				Попытка			
					ДокПоступление.Записать(РежимЗаписиДокумента.Проведение,РежимПроведенияДокумента.Неоперативный);
				Исключение
				КонецПопытки;
				//-Кабанов А.В. 12.11.2024 #UT10-4872
				
				//+Сёмин Р.И. 25.06.2026 #UT10-5899
				ПроверитьУстановитьСтатусПТУОжидаетПодтвержденияЭДО(ДокПоступление);
				//-Сёмин Р.И. 25.06.2026 #UT10-5899
				
				УстановитьПривилегированныйРежим(Ложь);
				
				Если ТранзитнаяПоставкаЧерезСкладWMS Тогда
					
					Попытка
						Результат = МСКWEB.ОтправитьПТУВУТ11(ДокПоступление.Ссылка);
					Исключение
						ЗаписьЖурналаРегистрации("GoodsReserve.СоздатьИнвойсПо4Транзиту", УровеньЖурналаРегистрации.Ошибка,,,
						"Ошибка получения ответа после отправки ПТУ в стороннюю УТ11: " + ОписаниеОшибки());
					КонецПопытки;
					
				КонецЕсли;
				
			КонецЕсли; 
			
			Если НЕ ДокПоступлениеТОХ = Неопределено Тогда
				
				УстановитьПривилегированныйРежим(Истина);
				ДокПоступлениеТОХ.Записать(РежимЗаписиДокумента.Запись); 
				
				//+Кабанов А.В. 12.11.2024 #UT10-4872	
				Попытка			
					ДокПоступлениеТОХ.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
				Исключение
				КонецПопытки;
				//-Кабанов А.В. 12.11.2024 #UT10-4872

				УстановитьПривилегированныйРежим(Ложь);
				
			КонецЕсли;  
			
			Если НЕ ТЗНоменклатуры.Колонки.Найти("ДоговорПоставщикаТОХКодМДМ") = Неопределено Тогда				
				ДоговорПоставщикаТОХКодМДМ = СтрТЗ.ДоговорПоставщикаТОХКодМДМ;
			Иначе
				ДоговорПоставщикаТОХКодМДМ = "";
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ДоговорПоставщикаТОХКодМДМ) Тогда
				
				ЕстьДоговорПоставщикаТОХ = Справочники.ДоговорыКонтрагентов.НайтиПоРеквизиту("КодМДМ", ДоговорПоставщикаТОХКодМДМ);
				
				Если Не ЕстьДоговорПоставщикаТОХ.Пустая() Тогда
					
					ПоставщикТОХ = Справочники.ПоставщикиТОХ.НайтиПоРеквизиту("ДоговорКонтрагента", ЕстьДоговорПоставщикаТОХ);
					
					Если НЕ ПоставщикТОХ.Пустая() Тогда
						ЭтоПополнениеТОХ = Истина; 
					Иначе
						
						ЗаписьЖурналаРегистрации("GoodsReserve.СоздатьПополнениеТОХ", УровеньЖурналаРегистрации.Ошибка,,, "Не найден поставщик ТОХ с договором "
						+ СокрЛП(ЕстьДоговорПоставщикаТОХ.Наименование));
						Возврат;
						
					КонецЕсли;
					
				Иначе
					
					ЗаписьЖурналаРегистрации("GoodsReserve.СоздатьПополнениеТОХ", УровеньЖурналаРегистрации.Ошибка,,, "Не найден договор поставщика ТОХ с кодом МДМ "
					+ СокрЛП(ДоговорПоставщикаТОХКодМДМ));
					Возврат;
					
				КонецЕсли;  
				
			Иначе
				ЭтоПополнениеТОХ = Ложь;					
			КонецЕсли; 

			Если ЭтоПополнениеТОХ Тогда  
						
					ЕстьДокумент = НайтиПоступлениеТОХПоНомеруВходящегоДокумента(НомерДокумента, ДатаДокумента, Истина);
					
					Если ЕстьДокумент Тогда
						Продолжить;
					КонецЕсли;
					
					ДокПоступлениеТОХ = Документы.ПоступлениеТоваровНаОтветственноеХранение.СоздатьДокумент(); 
					ДокПоступлениеТОХ.Ответственный	           = ПараметрыСеанса.ТекущийПользователь;
					ДокПоступлениеТОХ.Дата			           = ТекущаяДата();
					ДокПоступлениеТОХ.ВалютаДокумента          = Справочники.Валюты.НайтиПоКоду("643");
					ДокПоступлениеТОХ.Контрагент               = ПоставщикТОХ.Контрагент;
					ДокПоступлениеТОХ.ДоговорКонтрагента       = ПоставщикТОХ.ДоговорКонтрагента;
					ДокПоступлениеТОХ.КратностьВзаиморасчетов  = 1;
					ДокПоступлениеТОХ.КурсВзаиморасчетов       = 1;
					ДокПоступлениеТОХ.Организация              = ПоставщикТОХ.ДоговорКонтрагента.Организация;
					ДокПоступлениеТОХ.Склад                    = Константы.ОсновнойСклад.Получить();
					ДокПоступлениеТОХ.ДатаВходящегоДокумента   = ДатаДокумента; 
					ДокПоступлениеТОХ.НомерВходящегоДокумента  = СокрЛП(НомерДокумента);
					ДокПоступлениеТОХ.НомерСкладскогоДокумента = ?(ЗначениеЗаполнено(НомерСкладскогоДокументаТОХ), НомерСкладскогоДокументаТОХ, СокрЛП(НомерДокумента));  
					
					//+Шульман А. 16.12.2024 #UT10-4995 
					//ДокПоступлениеТОХ.Комментарий 			   = "Создан авт. по реализации в стор.базе " + ТекущаяДата();
					ДокПоступлениеТОХ.Филиал = Филиал;
					ДокПоступлениеТОХ.ВидПроцесса = ВидПроцесса; 
					
					//+Кабанов А.В. 23.06.2025 # UT10-5295
					ДокПоступлениеТОХ.ВозвратПоставщикуБезРазбораВГП = мВозвратПоставщикуБезРазбораВГП;
					//-Кабанов А.В. 23.06.2025 # UT10-5295
					
					ДокПоступлениеТОХ.Комментарий 	   = "Создан авт. по реализации в стор.базе " + Строка(Филиал) + " " + ТекущаяДата();
					//-Шульман А. 16.12.2024 #UT10-4995 
					
			Иначе
				
				Если ЗаказОбъект <> Неопределено И ТипЗнч(ЗаказОбъект) = Тип("ДокументОбъект.ЗаказПоставщику") Тогда
					ЗаказПоставщикуЕстьЭкспресс = ЗаказОбъект.Экспресс;	 
				Иначе
					ЗаказПоставщикуЕстьЭкспресс = Ложь;
				КонецЕсли; 
				
				ЕстьДокумент = НайтиПоступлениеПоИДДокументаВСмежнойБазе(СтрТЗ.ИДДокументаВСмежнойБазе);
				
				Если ЕстьДокумент Тогда
					
					ЕстьДокументПТУ = Документы.ПоступлениеТоваровУслуг.НайтиПоРеквизиту("ИДДокументаВСмежнойБазе", СтрТЗ.ИДДокументаВСмежнойБазе);
					
					Если НЕ ЕстьДокументПТУ.НомерВходящегоДокумента = СокрЛП(НомерДокумента) 
						ИЛИ НЕ ЕстьДокументПТУ.НомерСкладскогоДокумента = ?(СтрТЗ.СФНомер = "", СокрЛП(НомерДокумента), СтрТЗ.СФНомер) Тогда
						
						ДокПоступлениеОбъект = ЕстьДокументПТУ.ПолучитьОбъект();						
						ДокПоступлениеОбъект.НомерВходящегоДокумента  = СокрЛП(НомерДокумента);
						ДокПоступлениеОбъект.НомерСкладскогоДокумента = ?(СтрТЗ.СФНомер = "", СокрЛП(НомерДокумента), СтрТЗ.СФНомер);  
						
						УстановитьПривилегированныйРежим(Истина);
						ДокПоступлениеОбъект.Записать(РежимЗаписиДокумента.Запись);
						
						//+Кабанов А.В. 12.11.2024 #UT10-4872	
						Попытка			
							ДокПоступлениеОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
						Исключение
						КонецПопытки;
						//-Кабанов А.В. 12.11.2024 #UT10-4872
						
						УстановитьПривилегированныйРежим(Ложь);
						
						//+Сёмин Р.И. 05.06.2026 #UT10-5899
						ПроверитьУстановитьСтатусПТУОжидаетПодтвержденияЭДО(ДокПоступление);
						//-Сёмин Р.И. 05.06.2026 #UT10-5899
						
					КонецЕсли;
					
					Продолжить; 
					
				КонецЕсли;
				
				ЕстьДокумент = НайтиПоступлениеПоНомеруВходящегоДокумента(НомерДокумента, ДатаДокумента, Истина);
				
				Если ЕстьДокумент Тогда
					Продолжить;
				КонецЕсли;
				
				ДокПоступление = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент();
				ДокПоступление.Организация = Константы.ОсновнаяОрганизация.Получить();
				ДокПоступление.ВидПоступления = Перечисления.ВидыПоступленияТоваров.НаСклад;
				ДокПоступление.СкладОрдер = Константы.ОсновнойСклад.Получить();
				
				Если НЕ Склад = Неопределено Тогда
					
					ДокПоступление.Контрагент = Склад.Поставщик;
					
					Если ЗначениеЗаполнено(Склад.ДоговорКонтрагента) Тогда
						ДокПоступление.ДоговорКонтрагента =	Склад.ДоговорКонтрагента;
					КонецЕсли;
					
				Иначе				
					ДокПоступление.Контрагент = Константы.ДопПоставщик.Получить();
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(ДокПоступление.ДоговорКонтрагента) Тогда 
					ДокПоступление.ДоговорКонтрагента = ДокПоступление.Контрагент.ОсновнойДоговорКонтрагента;
				КонецЕсли; 
				
				Если НЕ ДокПоступление.ДоговорКонтрагента.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком Тогда
					
					СтруктураПараметровДляПолученияДоговора = Новый Структура();
					СписокДопустимыхВидовДоговоров = Новый СписокЗначений();
					СписокДопустимыхВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);
					СтруктураПараметровДляПолученияДоговора.Вставить("СписокДопустимыхВидовДоговоров", СписокДопустимыхВидовДоговоров);
					ДокПоступление.ДоговорКонтрагента = ЗаполнениеДокументов.ПолучитьДоговорПоОрганизацииИКонтрагенту(ДокПоступление.Организация, 
					                       ДокПоступление.Контрагент, СтруктураПараметровДляПолученияДоговора);
					
					Если ДокПоступление.ДоговорКонтрагента.Пустая() Тогда
						ДокПоступление.ДоговорКонтрагента = ДокПоступление.Контрагент.ОсновнойДоговорКонтрагента; 
					КонецЕсли;				
					
				КонецЕсли;
				
				ДокПоступление.ВалютаДокумента = ДокПоступление.ДоговорКонтрагента.ВалютаВзаиморасчетов;
				//+Кабанов А.В. 13.11.2024 #UT10-4872	
				//ДокПоступление.Дата = НачалоДня(ТекущаяДата() + 60 * 60 * 24);
				ДокПоступление.Дата = ТекущаяДата();				
				//+Кабанов А.В. 13.11.2024 #UT10-4872	
				ДокПоступление.КратностьВзаиморасчетов = 1;
				ДокПоступление.КурсВзаиморасчетов  = 1;	
				ДокПоступление.ОтражатьВУправленческомУчете = Истина;
				ДокПоступление.ОтражатьВБухгалтерскомУчете = Истина;
				ДокПоступление.ОтражатьВНалоговомУчете = Истина;
				ДокПоступление.УчитыватьНДС = Истина;
				ДокПоступление.СуммаВключаетНДС = Истина;
				ДокПоступление.Комментарий = ?(НЕ Склад = Неопределено, СокрЛП(Склад.Наименование) + " ", "") + "Создан авт. по реализации в стор.базе " + ТекущаяДата(); 
				ДокПоступление.НомерВходящегоДокумента  = СокрЛП(НомерДокумента);
				ДокПоступление.НомерСкладскогоДокумента = ?(СтрТЗ.СФНомер = "", СокрЛП(НомерДокумента), СтрТЗ.СФНомер);  
				ДокПоступление.ДатаВходящегоДокумента = ДатаДокумента;
				ДокПоступление.Ответственный = глЗначениеПеременной("глТекущийПользователь");
				ДокПоступление.ИДДокументаВСмежнойБазе = СтрТЗ.ИДДокументаВСмежнойБазе;
				
				//+Марков И. 09.06.2026 #UT10-5916
				Если ТипЗнч(СтрТЗ.МассивТЕ) = Тип("Массив") Тогда
					
					ТаблицаТЕ = Новый ТаблицаЗначений();
					ТаблицаТЕ.Колонки.Добавить("ТранспортнаяЕдиница", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
					ТаблицаТЕ.Колонки.Добавить("Вес", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,3,ДопустимыйЗнак.Любой)));
					
					Для Каждого ЭлементМассива Из СтрТЗ.МассивТЕ Цикл
						
						НоваяСтрокаТЕ = ТаблицаТЕ.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрокаТЕ, ЭлементМассива);
						
					КонецЦикла;	
					
					Запрос = Новый Запрос();
					Запрос.Текст = 
					"ВЫБРАТЬ
					|	ВТ_МассивТЕ.ТранспортнаяЕдиница КАК ТранспортнаяЕдиница,
					|	ВТ_МассивТЕ.Вес КАК Вес
					|ПОМЕСТИТЬ ВТ_МассивТЕ
					|ИЗ
					|	&ТаблицаТЕ КАК ВТ_МассивТЕ
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ
					|	ВТ_МассивТЕ.ТранспортнаяЕдиница,
					|	ВТ_МассивТЕ.Вес
					|ИЗ
					|	ВТ_МассивТЕ КАК ВТ_МассивТЕ
					|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг.УпаковочныеЛисты КАК ПоступлениеТоваровУслугУпаковочныеЛисты
					|		ПО ВТ_МассивТЕ.ТранспортнаяЕдиница = ПоступлениеТоваровУслугУпаковочныеЛисты.НомерWMS
					|			И (ПоступлениеТоваровУслугУпаковочныеЛисты.Ссылка.Дата >= НАЧАЛОПЕРИОДА(&Дата, ГОД))
					|			И (ПоступлениеТоваровУслугУпаковочныеЛисты.Ссылка.Проведен)
					|ГДЕ
					|	ПоступлениеТоваровУслугУпаковочныеЛисты.Ссылка ЕСТЬ NULL";
					
					Запрос.УстановитьПараметр("Дата", ТекущаяДата());
					Запрос.УстановитьПараметр("ТаблицаТЕ", ТаблицаТЕ);
					
					Выборка = Запрос.Выполнить().Выбрать();
					
					Пока Выборка.Следующий() Цикл
						
						НСтр = ДокПоступление.УпаковочныеЛисты.Добавить();
						НСтр.НомерWMS = Выборка.ТранспортнаяЕдиница;
						НСтр.Вес = Выборка.Вес;
						
					КонецЦикла;
										
				КонецЕсли;
				//-Марков И. 09.06.2026 #UT10-5916
				
				//+Макрушин Е. 24.09.2025 #UT10-5430
