
Функция ПолучитьЗапросCоответствиеРегистровТоварыТОХиТоварыТОХпоставщиков() Экспорт 
	
	Текст = "ВЫБРАТЬ
	        |	ТЗ_Выкуп.Организация,
	        |	ТЗ_Выкуп.Контрагент,
	        |	ТЗ_Выкуп.ДоговорКонтрагента,
	        |	ТЗ_Выкуп.Номенклатура,
	        |	ВЫБОР
	        |		КОГДА &УчитыватьВыкуп
	        |			ТОГДА ТЗ_Выкуп.КоличествоТОХПоставщики
	        |		ИНАЧЕ 0
	        |	КОНЕЦ КАК КоличествоТОХПоставщики
			//+ Кривова З. 06.11.2024 #UT10-4884
	        //|ПОМЕСТИТЬ ВТ_ТоварыКВыкупу
	        |ПОМЕСТИТЬ ВТ_ТоварыКВыкупу0
			//- Кривова З. 06.11.2024 #UT10-4884
	        |ИЗ
	        |	&ТЗ_Выкуп КАК ТЗ_Выкуп
	        |;
			//+ Кривова З. 06.11.2024 #UT10-4884
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	ТЗ_Выкуп.Организация,
	        |	ТЗ_Выкуп.Контрагент,
	        |	ТЗ_Выкуп.ДоговорКонтрагента,
	        |	ТЗ_Выкуп.Номенклатура,
	        |	СУММА(ТЗ_Выкуп.КоличествоТОХПоставщики) КАК КоличествоТОХПоставщики
	        |ПОМЕСТИТЬ ВТ_ТоварыКВыкупу
	        |ИЗ
	        |	ВТ_ТоварыКВыкупу0 КАК ТЗ_Выкуп
	        |
	        |СГРУППИРОВАТЬ ПО
	        |	ТЗ_Выкуп.ДоговорКонтрагента,
	        |	ТЗ_Выкуп.Контрагент,
	        |	ТЗ_Выкуп.Номенклатура,
	        |	ТЗ_Выкуп.Организация
	        |;
	        |
			//- Кривова З. 06.11.2024 #UT10-4884
	        |
	        |//////////////////////////// ////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	ВТ_ТоварыКВыкупу.Организация,
	        |	ВТ_ТоварыКВыкупу.Контрагент,
	        |	ВТ_ТоварыКВыкупу.ДоговорКонтрагента,
	        |	ВТ_ТоварыКВыкупу.Номенклатура,
	        |	0 КАК КоличествоТОХ,
	        |	ВТ_ТоварыКВыкупу.КоличествоТОХПоставщики КАК КоличествоТОХПоставщики,
	        |	0 КАК КоличествоТОХПереданные
	        |ПОМЕСТИТЬ ВТ_НаборДанных
	        |ИЗ
	        |	ВТ_ТоварыКВыкупу КАК ВТ_ТоварыКВыкупу
	        |
	        |ОБЪЕДИНИТЬ ВСЕ
	        |
	        |ВЫБРАТЬ
	        |	ТоварыОтветственногоХраненияОстатки.Организация,
	        |	ТоварыОтветственногоХраненияОстатки.Контрагент,
	        |	ТоварыОтветственногоХраненияОстатки.ДоговорКонтрагента,
	        |	ТоварыОтветственногоХраненияОстатки.Номенклатура,
	        |	СУММА(ЕСТЬNULL(ТоварыОтветственногоХраненияОстатки.КоличествоОстаток, 0)),
	        |	СУММА(0),
	        |	СУММА(0)
	        |ИЗ
	        |	РегистрНакопления.ТоварыОтветственногоХранения.Остатки(
	        |			&Дата,
	        |			Контрагент = &Контрагент
	        |				И ДоговорКонтрагента = &ДоговорКонтрагента) КАК ТоварыОтветственногоХраненияОстатки
	        |
	        |СГРУППИРОВАТЬ ПО
	        |	ТоварыОтветственногоХраненияОстатки.ДоговорКонтрагента,
	        |	ТоварыОтветственногоХраненияОстатки.Номенклатура,
	        |	ТоварыОтветственногоХраненияОстатки.Контрагент,
	        |	ТоварыОтветственногоХраненияОстатки.Организация
	        |
	        |ОБЪЕДИНИТЬ ВСЕ
	        |
	        |ВЫБРАТЬ
	        |	ТоварыТОХпоДаннымПоставщиковОстатки.Организация,
	        |	ТоварыТОХпоДаннымПоставщиковОстатки.Контрагент,
	        |	ТоварыТОХпоДаннымПоставщиковОстатки.Договор,
	        |	ТоварыТОХпоДаннымПоставщиковОстатки.Номенклатура,
	        |	СУММА(0),
	        |	СУММА(ЕСТЬNULL(ТоварыТОХпоДаннымПоставщиковОстатки.КоличествоОстаток, 0)),
	        |	СУММА(0)
	        |ИЗ
	        |	РегистрНакопления.ТоварыТОХпоДаннымПоставщиков.Остатки(
	        |			&Дата,
	        |			Контрагент = &Контрагент
	        |				И Договор = &ДоговорКонтрагента) КАК ТоварыТОХпоДаннымПоставщиковОстатки
	        |
	        |СГРУППИРОВАТЬ ПО
	        |	ТоварыТОХпоДаннымПоставщиковОстатки.Договор,
	        |	ТоварыТОХпоДаннымПоставщиковОстатки.Контрагент,
	        |	ТоварыТОХпоДаннымПоставщиковОстатки.Номенклатура,
	        |	ТоварыТОХпоДаннымПоставщиковОстатки.Организация
	        |
	        |ОБЪЕДИНИТЬ ВСЕ
	        |
	        |ВЫБРАТЬ
	        |	ТоварыОтветственногоХраненияПереданныеОстатки.Организация,
	        |	ТоварыОтветственногоХраненияПереданныеОстатки.Контрагент,
	        |	ТоварыОтветственногоХраненияПереданныеОстатки.ДоговорКонтрагента,
	        |	ТоварыОтветственногоХраненияПереданныеОстатки.Номенклатура,
	        |	СУММА(0),
	        |	СУММА(0),
	        |	СУММА(ТоварыОтветственногоХраненияПереданныеОстатки.КоличествоОстаток)
	        |ИЗ
	        |	РегистрНакопления.ТоварыОтветственногоХраненияПереданные.Остатки(
	        |			&Дата,
	        |			Контрагент = &Контрагент
	        |				И ДоговорКонтрагента = &ДоговорКонтрагента) КАК ТоварыОтветственногоХраненияПереданныеОстатки
	        |
	        |СГРУППИРОВАТЬ ПО
	        |	ТоварыОтветственногоХраненияПереданныеОстатки.Организация,
	        |	ТоварыОтветственногоХраненияПереданныеОстатки.Контрагент,
	        |	ТоварыОтветственногоХраненияПереданныеОстатки.ДоговорКонтрагента,
	        |	ТоварыОтветственногоХраненияПереданныеОстатки.Номенклатура
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	ВТ_НаборДанных.Контрагент,
	        |	ВТ_НаборДанных.ДоговорКонтрагента,
	        |	ВТ_НаборДанных.Номенклатура,
	        |	СУММА(ВТ_НаборДанных.КоличествоТОХ) КАК КоличествоТОХ,
	        |	СУММА(ВТ_НаборДанных.КоличествоТОХПоставщики) КАК КоличествоТОХПоставщики,
	        |	СУММА(ВТ_НаборДанных.КоличествоТОХПоставщики - ВТ_НаборДанных.КоличествоТОХ) КАК Разница,
	        |	СУММА(ВТ_НаборДанных.КоличествоТОХПереданные) КАК КоличествоТОХПереданные,
	        |	МАКСИМУМ(ТоварыНаСкладахОстатки.КоличествоОстаток) КАК СкладОстаток,
	        |	МАКСИМУМ(ТоварыОрганизацийМТОстатки.КоличествоОстаток) КАК МТОстаток,
	        |	МАКСИМУМ(ВТ_ТоварыКВыкупу.КоличествоТОХПоставщики) КАК КоличествоВыкупа
	        |ПОМЕСТИТЬ ВТ_Итоговая
	        |ИЗ
	        |	ВТ_НаборДанных КАК ВТ_НаборДанных
	        |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки(&Дата, ) КАК ТоварыНаСкладахОстатки
	        |		ПО ВТ_НаборДанных.Номенклатура = ТоварыНаСкладахОстатки.Номенклатура
	        |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыОрганизацийМТ.Остатки(&Дата, ) КАК ТоварыОрганизацийМТОстатки
	        |		ПО ВТ_НаборДанных.Номенклатура = ТоварыОрганизацийМТОстатки.Номенклатура
	        |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТоварыКВыкупу КАК ВТ_ТоварыКВыкупу
	        |		ПО ВТ_НаборДанных.Организация = ВТ_ТоварыКВыкупу.Организация
	        |			И ВТ_НаборДанных.Контрагент = ВТ_ТоварыКВыкупу.Контрагент
	        |			И ВТ_НаборДанных.ДоговорКонтрагента = ВТ_ТоварыКВыкупу.ДоговорКонтрагента
	        |			И ВТ_НаборДанных.Номенклатура = ВТ_ТоварыКВыкупу.Номенклатура
	        |
	        |СГРУППИРОВАТЬ ПО
	        |	ВТ_НаборДанных.Номенклатура,
	        |	ВТ_НаборДанных.Контрагент,
	        |	ВТ_НаборДанных.ДоговорКонтрагента
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	ВТ_Итоговая.Контрагент,
	        |	ВТ_Итоговая.ДоговорКонтрагента,
	        |	ВТ_Итоговая.Номенклатура,
	        |	ВТ_Итоговая.КоличествоВыкупа,
	        |	ВТ_Итоговая.СкладОстаток КАК КоличествоСклад,
			//+ Кривова З. 06.11.2024 #UT10-4884
	        //|	ВТ_Итоговая.МТОстаток + ВТ_Итоговая.КоличествоВыкупа КАК КоличествоМТ,
	        |	ВТ_Итоговая.МТОстаток - ВТ_Итоговая.КоличествоВыкупа КАК КоличествоМТ,
			//- Кривова З. 06.11.2024 #UT10-4884
	        |	ВТ_Итоговая.КоличествоТОХ,
	        |	ВТ_Итоговая.КоличествоТОХПереданные,
	        |	ВТ_Итоговая.КоличествоТОХПоставщики,
			//+ Кривова З. 06.11.2024 #UT10-4884
	        //|	ВТ_Итоговая.МТОстаток + ВТ_Итоговая.КоличествоВыкупа КАК Метрика_1,
	        |	ВТ_Итоговая.МТОстаток - ВТ_Итоговая.КоличествоВыкупа КАК Метрика_1,
	        //|	ВТ_Итоговая.СкладОстаток - (ВТ_Итоговая.МТОстаток + ВТ_Итоговая.КоличествоВыкупа) - ВТ_Итоговая.КоличествоТОХПоставщики + ВТ_Итоговая.КоличествоТОХПереданные КАК Метрика_2,
	        |	ВТ_Итоговая.СкладОстаток - (ВТ_Итоговая.МТОстаток - ВТ_Итоговая.КоличествоВыкупа) - ВТ_Итоговая.КоличествоТОХПоставщики + ВТ_Итоговая.КоличествоТОХПереданные КАК Метрика_2,
			//- Кривова З. 06.11.2024 #UT10-4884
	        |	ВТ_Итоговая.Разница КАК Метрика_3,
			//+ Кривова З. 11.11.2024 #UT10-4880
	        |	ВТ_Итоговая.КоличествоТОХ - ВТ_Итоговая.КоличествоТОХПереданные КАК Метрика_5
			//- Кривова З. 11.11.2024 #UT10-4880
	        |ПОМЕСТИТЬ ВТ_Метрики
	        |ИЗ
	        |	ВТ_Итоговая КАК ВТ_Итоговая
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	ВТ_Метрики.Контрагент,
	        |	ВТ_Метрики.ДоговорКонтрагента,
	        |	ВТ_Метрики.Номенклатура,
	        |	-ВТ_Метрики.КоличествоВыкупа КАК КоличествоВыкупа,
	        |	ВТ_Метрики.КоличествоСклад,
	        |	ВТ_Метрики.КоличествоМТ,
	        |	ВТ_Метрики.КоличествоТОХ,
	        |	ВТ_Метрики.КоличествоТОХПереданные,
	        |	ВТ_Метрики.КоличествоТОХПоставщики,
	        |	ВТ_Метрики.Метрика_1,
	        |	ВТ_Метрики.Метрика_2,
	        |	ВТ_Метрики.Метрика_3,
			//+ Кривова З. 11.11.2024 #UT10-4880
	        |	ВТ_Метрики.Метрика_5
			//- Кривова З. 11.11.2024 #UT10-4880
	        |ИЗ
	        |	ВТ_Метрики КАК ВТ_Метрики
	        |ГДЕ
	        |	(ВТ_Метрики.Метрика_1 < 0
	        |			ИЛИ ВТ_Метрики.Метрика_2 <> 0
	        |			ИЛИ ВТ_Метрики.Метрика_3 <> 0
	        |			ИЛИ ВТ_Метрики.Метрика_5 < 0)";
	
	Возврат Текст;
	
КонецФункции

Функция ПолучитьТоварыТОХДляВыкупа(НачПериода, КонПериода, ПоставщикТОХ, ВыбКонтрагент, ВыбДоговор) Экспорт  
	
	//+Шульман А. 21.06.2024 #UT10-4521
	мТоварыКВыкупу = Неопределено;
	мТоварыКВыкупуСРегистраторами = Неопределено;   
	
	ЗапросПроданныхТоваров = Новый Запрос;
	
	Если Константы.ДобавлятьОтрицательныйОстатокМТкВыкупу.Получить() Тогда
		
		ЗапросПроданныхТоваров.Текст =
		"ВЫБРАТЬ
		|	ТоварыОтветственногоХраненияОстаткиИОбороты.Номенклатура,
		|	ТоварыОтветственногоХраненияОстаткиИОбороты.Номенклатура.Артикул КАК Артикул,
		|	ТоварыОтветственногоХраненияОстаткиИОбороты.Номенклатура.Родитель КАК Производитель,
		|	ТоварыОтветственногоХраненияОстаткиИОбороты.Номенклатура.КодПроизводителя КАК КодПроизводителя,
		|	ТоварыОтветственногоХраненияОстаткиИОбороты.СерияНоменклатуры,
		|	СУММА(ТоварыОтветственногоХраненияОстаткиИОбороты.КоличествоРасход) КАК КоличествоТОХ,
		|	ЕСТЬNULL(ЦеныНоменклатурыКонтрагентовСрезПоследних.Цена, 1) КАК Цена,
		|	СУММА(ЕСТЬNULL(ЦеныНоменклатурыКонтрагентовСрезПоследних.Цена, 1) * ТоварыОтветственногоХраненияОстаткиИОбороты.КоличествоРасход) КАК Сумма,
		|	ВЫБОР
		|		КОГДА &РазделятьВыкупы
		|			ТОГДА ВЫБОР
		|					КОГДА ТИПЗНАЧЕНИЯ(ТоварыОтветственногоХраненияОстаткиИОбороты.Регистратор.Ссылка) = ТИП(Документ.ВыкупСОтветственногоХранения)
		|							И ТоварыОтветственногоХраненияОстаткиИОбороты.Регистратор.Филиал.НеОбъединятьВОбщемВыкупе
		|						ТОГДА ТоварыОтветственногоХраненияОстаткиИОбороты.Регистратор.Филиал
		|					ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|				КОНЕЦ
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|	КОНЕЦ КАК Филиал
		|ПОМЕСТИТЬ ОстаткиТОХсЦенами
		|ИЗ
		|	РегистрНакопления.ТоварыОтветственногоХранения.ОстаткиИОбороты(
		|			&ДатаНачала,
		|			&ДатаОкончания,
		|			Регистратор,
		|			,
		|			Контрагент = &Контрагент
		|				И ДоговорКонтрагента = &Договор) КАК ТоварыОтветственногоХраненияОстаткиИОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатурыКонтрагентов.СрезПоследних(, ТипЦен = &ТипЦен) КАК ЦеныНоменклатурыКонтрагентовСрезПоследних
		|		ПО ТоварыОтветственногоХраненияОстаткиИОбороты.Номенклатура = ЦеныНоменклатурыКонтрагентовСрезПоследних.Номенклатура
		|ГДЕ
		|	(ТИПЗНАЧЕНИЯ(ТоварыОтветственногоХраненияОстаткиИОбороты.Регистратор.Ссылка) = ТИП(Документ.РеализацияТоваровУслуг)
		//+Шульман А. 16.12.2024 #UT10-4992    
		|     И &УсловиеПеремещениеНеликвидаТОХвГП 
		//-Шульман А. 16.12.2024 #UT10-4992
		|			ИЛИ ТИПЗНАЧЕНИЯ(ТоварыОтветственногоХраненияОстаткиИОбороты.Регистратор.Ссылка) = ТИП(Документ.ТребованиеНакладная)
		|			ИЛИ ТИПЗНАЧЕНИЯ(ТоварыОтветственногоХраненияОстаткиИОбороты.Регистратор.Ссылка) = ТИП(Документ.СписаниеТоваров)
		|			ИЛИ ТИПЗНАЧЕНИЯ(ТоварыОтветственногоХраненияОстаткиИОбороты.Регистратор.Ссылка) = ТИП(Документ.ПеремещениеТоваров)   
		|			ИЛИ ТИПЗНАЧЕНИЯ(ТоварыОтветственногоХраненияОстаткиИОбороты.Регистратор.Ссылка) = ТИП(Документ.КорректировкаПоступления)
		|			ИЛИ ТИПЗНАЧЕНИЯ(ТоварыОтветственногоХраненияОстаткиИОбороты.Регистратор.Ссылка) = ТИП(Документ.ВыкупСОтветственногоХранения)
		|				И НЕ ТоварыОтветственногоХраненияОстаткиИОбороты.Регистратор.Филиал = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|				И НЕ ТоварыОтветственногоХраненияОстаткиИОбороты.Регистратор.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыТОХ.ВозвратПоБраку))
		|
		|СГРУППИРОВАТЬ ПО
		|	ТоварыОтветственногоХраненияОстаткиИОбороты.Номенклатура,
		|	ТоварыОтветственногоХраненияОстаткиИОбороты.СерияНоменклатуры,
		|	ЕСТЬNULL(ЦеныНоменклатурыКонтрагентовСрезПоследних.Цена, 1),
		|	ТоварыОтветственногоХраненияОстаткиИОбороты.Номенклатура.Артикул,
