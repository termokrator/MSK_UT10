	|	И ТоварыОтветственногоХранения.ДоговорКонтрагента = &Договор
	|	И ТоварыОтветственногоХранения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	И ТоварыОтветственногоХранения.Период МЕЖДУ &ДатаНачала И &ДатаОкончания";
	
	ЗапросПроданныхТоваров.УстановитьПараметр("ДатаНачала", НачалоДня(НачПериода));
	ЗапросПроданныхТоваров.УстановитьПараметр("ДатаОкончания", КонецДня(КонПериода));
	ЗапросПроданныхТоваров.УстановитьПараметр("Контрагент", ВыбКонтрагент);
	ЗапросПроданныхТоваров.УстановитьПараметр("Договор", ВыбДоговор); 
	ЗапросПроданныхТоваров.УстановитьПараметр("ТипЦен", ВыбДоговор.ТипЦен);
	ЗапросПроданныхТоваров.УстановитьПараметр("РазделятьВыкупы", ПоставщикТОХ.РазделятьВыкупы);
	
	//+Шульман А. 16.12.2024 #UT10-4992
	Если Справочники.МТ_ПредопределенныеЗначения.ИспользоватьПроцессПеремещениеНеликвидаТОХвГП.Значение = Истина Тогда
		
		ЗапросПроданныхТоваров.Текст = СтрЗаменить(ЗапросПроданныхТоваров.Текст, "&УсловиеПеремещениеНеликвидаТОХвГП", 
		"      НЕ ВЫРАЗИТЬ(ТоварыОтветственногоХранения.Регистратор КАК Документ.РеализацияТоваровУслуг).ВидПроцесса = ЗНАЧЕНИЕ(Перечисление.ВидыПроцессов.ПеремещениеНеликвидаТОХвГП) 
		|     И ВЫРАЗИТЬ(ТоварыОтветственногоХранения.Регистратор КАК Документ.РеализацияТоваровУслуг).ДоговорПоставщикаТОХ = ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)" );
		
	Иначе
		ЗапросПроданныхТоваров.Текст = СтрЗаменить(ЗапросПроданныхТоваров.Текст, "И &УсловиеПеремещениеНеликвидаТОХвГП", " ");
	КонецЕсли;	
	//-Шульман А. 16.12.2024 #UT10-4992
	
	РезультатЗапросаПроданных = ЗапросПроданныхТоваров.Выполнить();
	
	Если НЕ РезультатЗапросаПроданных.Пустой() Тогда
		мТоварыКВыкупуСРегистраторами = РезультатЗапросаПроданных.Выгрузить();
	КонецЕсли;
	
    Результат = Новый Структура("ТоварыКВыкупу, ТоварыКВыкупуСРегистраторами", мТоварыКВыкупу, мТоварыКВыкупуСРегистраторами);
	
	Возврат Результат;
	
КонецФункции

Процедура СоздатьДокументыВыкупа(НачПериода, КонПериода, ВыбКонтрагент, ВыбДоговор, ТоварыКВыкупу, ТоварыКВыкупуСРегистраторами, ЭтоРегЗадание) Экспорт
	
	КомментарийРегЗадание = "Сформирован регламентным заданием " + СокрЛП(ТекущаяДата()) + " ";
	
	СписокФилиалов = ТоварыКВыкупу.Скопировать(,"Филиал");
	СписокФилиалов.Свернуть("Филиал");
	СписокФилиалов.Сортировать("Филиал Возр");
	
	Для Каждого СтрокаСпискаФилиалов Из СписокФилиалов Цикл
		
		НовыйВыкуп = Документы.ВыкупСОтветственногоХранения.СоздатьДокумент();
		НовыйВыкуп.Дата = КонецДня(КонПериода);		
		НовыйВыкуп.Контрагент = ВыбКонтрагент; 
		НовыйВыкуп.ДоговорКонтрагента = ВыбДоговор;
		НовыйВыкуп.ВалютаДокумента = ВыбДоговор.ВалютаВзаиморасчетов; 
		НовыйВыкуп.КурсВзаиморасчетов = 1;
		НовыйВыкуп.КратностьВзаиморасчетов = 1;
		НовыйВыкуп.Организация = ВыбДоговор.Организация;
		НовыйВыкуп.Склад = Константы.ОсновнойСклад.Получить();			
		НовыйВыкуп.Статус = Перечисления.СтатусыТОХ.Подготовлен;
		НовыйВыкуп.Ответственный = ПараметрыСеанса.ТекущийПользователь;
		НовыйВыкуп.НачалоПериода = НачалоДня(НачПериода);
		НовыйВыкуп.КонецПериода = КонецДня(КонПериода); 
		
		НовыйВыкуп.Комментарий = ?(ЭтоРегЗадание, КомментарийРегЗадание, "");
		
		Если ЗначениеЗаполнено(СтрокаСпискаФилиалов.Филиал) Тогда
			НовыйВыкуп.Комментарий = НовыйВыкуп.Комментарий + "По филиалу " + СокрЛП(СтрокаСпискаФилиалов.Филиал.Наименование);
		КонецЕсли;				
		
		СтрокиТоваровКВыкупуПоФилиалу = ТоварыКВыкупу.НайтиСтроки(Новый Структура("Филиал", СтрокаСпискаФилиалов.Филиал));		
		
		Для Каждого СтрокаОтобранныхТоваров Из СтрокиТоваровКВыкупуПоФилиалу Цикл
			
			НоваяСтрокаВыкуп = НовыйВыкуп.Товары.Добавить();
			НоваяСтрокаВыкуп.Номенклатура = СтрокаОтобранныхТоваров.Номенклатура;
			НоваяСтрокаВыкуп.ЕдиницаИзмерения = НоваяСтрокаВыкуп.Номенклатура.ЕдиницаХраненияОстатков;
			НоваяСтрокаВыкуп.Коэффициент =  НоваяСтрокаВыкуп.ЕдиницаИзмерения.Коэффициент;
			НоваяСтрокаВыкуп.СерияНоменклатуры = СтрокаОтобранныхТоваров.СерияНоменклатуры;
			НоваяСтрокаВыкуп.ХарактеристикаНоменклатуры = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
			НоваяСтрокаВыкуп.Количество = СтрокаОтобранныхТоваров.Количество;
			НоваяСтрокаВыкуп.Цена = СтрокаОтобранныхТоваров.Цена;
			НоваяСтрокаВыкуп.Сумма = НоваяСтрокаВыкуп.Количество*НоваяСтрокаВыкуп.Цена;
			
		КонецЦикла;   
		
		СтрокиТоваровКВыкупуСРегистраторамиПоФилиалу = ТоварыКВыкупуСРегистраторами.Скопировать(Новый Структура("Филиал", СтрокаСпискаФилиалов.Филиал));		
		
		Для Каждого Стр Из СтрокиТоваровКВыкупуСРегистраторамиПоФилиалу Цикл
			
			НоваяСтрокаОснований = НовыйВыкуп.ДокументыОснованияВыкупаТОХ.Добавить();
			НоваяСтрокаОснований.ДокументОснование = Стр.Регистратор;
			НоваяСтрокаОснований.Номенклатура = Стр.Номенклатура;
			НоваяСтрокаОснований.СерияНоменклатуры = Стр.СерияНоменклатуры;
			НоваяСтрокаОснований.Количество = Стр.Количество;
			
		КонецЦикла;
		
		НовыйВыкуп.Записать(РежимЗаписиДокумента.Запись);      
		ЗаписьВРегистрИсторияОфромленияТОХ(НовыйВыкуп.Ссылка, НачПериода, КонПериода, ВыбКонтрагент, СтрокиТоваровКВыкупуСРегистраторамиПоФилиалу);
		
		Попытка
			
			НовыйВыкуп.Записать(РежимЗаписиДокумента.Проведение);   
			
			Если ЭтоРегЗадание Тогда
				ЗаписьЖурналаРегистрации("Формирование выкупов ТОХ", УровеньЖурналаРегистрации.Информация, , ,
				"Создан выкуп для контрагента  " + СокрЛП(ВыбКонтрагент.Наименование));
			КонецЕсли;
			
		Исключение  
			
			//+Гавриленков В. 26.09.2024 #UT10-4793
			Если ЭтоРегЗадание Тогда
				ЗаписьЖурналаРегистрации("Формирование выкупов ТОХ", УровеньЖурналаРегистрации.Ошибка, , ,
				"Ошибка проведения выкуп для контрагента  " + СокрЛП(ВыбКонтрагент.Наименование) + ". " + ОписаниеОшибки());
			КонецЕсли; 
			//-Гавриленков В. 26.09.2024 #UT10-4793
			
		КонецПопытки; 
		
	КонецЦикла;
	
КонецПроцедуры       

Процедура ЗаписьВРегистрИсторияОфромленияТОХ(НовыйВыкуп, НачПериода, КонПериода, ВыбКонтрагент, СтрокиТоваровКВыкупуСРегистраторамиПоФилиалу)
	
	ЗаписьИОТ = РегистрыСведений.ИсторияОфромленияТОХ.СоздатьМенеджерЗаписи();
	ЗаписьИОТ.Документ    	   = НовыйВыкуп;
	СтруктураТоваров 		   = Новый Структура("СписокТоваров", СтрокиТоваровКВыкупуСРегистраторамиПоФилиалу); 
	ЗаписьИОТ.СписокТоваров    = Новый ХранилищеЗначения(СтруктураТоваров, Новый СжатиеДанных(9));
	ЗаписьИОТ.Поставщик        = ВыбКонтрагент;
	ЗаписьИОТ.НачалоПериода    = НачПериода;
	ЗаписьИОТ.ОкончаниеПериода = КонПериода;
	ЗаписьИОТ.ДатаФормированияДокументов = ТекущаяДата();
	ЗаписьИОТ.Записать();
	
КонецПроцедуры

