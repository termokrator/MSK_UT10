Функция ПолучитьДанныеПоЗаказам(Запрос) 
	
	Ответ = Новый HTTPСервисОтвет(200);     
	
	Если Запрос.Заголовки.Получить("Api-Token") = Неопределено Тогда 
		СтруктураОтвета = Новый Структура("Результат, Данные, Сообщение", Ложь, Неопределено, "Не указан ""Api-Token"" подключения к ресурсу"); 
	Иначе
		
		ТокенДоступа 	= СокрЛП(Запрос.Заголовки.Получить("Api-Token"));   		
		ДанныеПроверки 	= МодульИнтеграцииСПорталом.ПроверитьТокенДоступа(ТокенДоступа); 
		
		Если ДанныеПроверки.СообщениеОшибки = "" Тогда  
						
			Если ЗначениеЗаполнено(Запрос.ПараметрыЗапроса) Тогда 
				СтруктураОтвета = МодульИнтеграцииСПорталом.ПолучитьДанныеПоЗаказамСервер(Запрос.ПараметрыЗапроса);	
			Иначе 	
				СтруктураОтвета = Новый Структура("Результат, Данные, Сообщение", Ложь, Неопределено, 
				"Данные заказов не получены. Причина: не указаны обязательные параметры запроса "
				+ " - ИдентификаторДокумента или ИдентификаторКонтрагента, ДатаНачала, ДатаОкончания"); 
			КонецЕсли;	                                   
			
		Иначе  
			СтруктураОтвета = Новый Структура("Результат, Данные, Сообщение", Ложь, Неопределено, ДанныеПроверки.СообщениеОшибки); 
		КонецЕсли;
		
	КонецЕсли;   
	
	ТелоОтвета = ОбщегоНазначения.ВернутьJSON(СтруктураОтвета);
	Ответ.УстановитьТелоИзСтроки(ТелоОтвета);
	
	Возврат Ответ;
	
КонецФункции

