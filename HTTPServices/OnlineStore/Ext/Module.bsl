Функция СоздатьЗаказ(Запрос)
			
	Ответ = Новый HTTPСервисОтвет(200);
	
	Если Запрос.Заголовки.Получить("Api-Token") = Неопределено Тогда 
				
		СтруктураОтвета = Новый Структура("Результат, Данные, Сообщение", Ложь, Неопределено, "Не указан ""Api-Token"" подключения к ресурсу"); 
		ТелоОтвета 		= ОбщегоНазначения.ВернутьJSON(СтруктураОтвета);
		
	Иначе
		
		ТокенДоступа 	= СокрЛП(Запрос.Заголовки.Получить("Api-Token"));   		
		ДанныеПроверки 	= МодульИнтеграцииСПорталом.ПроверитьТокенДоступа(ТокенДоступа); 
		
		Если ДанныеПроверки.СообщениеОшибки = "" Тогда  
						
			ТекстЗапроса = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);  
			
			Если ЗначениеЗаполнено(ТекстЗапроса) Тогда
				
				СтруктураОтвета = Новый Структура("Результат, Сообщение", Ложь, "");
				
				МассивЗапросов = РазбитьТекстЗапроса(ТекстЗапроса);
				
				Для каждого ТекущийЗапрос Из МассивЗапросов Цикл
					
					ТелоОтвета = МодульИнтеграцииСПорталом.СозданиеЗаказаСервер(ТекущийЗапрос);	 
					
					ТекущийОтветСтруктура = ОбщегоНазначения.ВернутьСтруктуруИзJSON(ТелоОтвета); 
					
					//Если хотя бы один заказ был создан
					Если ТекущийОтветСтруктура.Результат Тогда
						СтруктураОтвета.Результат = Истина;	
					КонецЕсли; 
					
					СтруктураОтвета.Сообщение = СтруктураОтвета.Сообщение + ?(ЗначениеЗаполнено(СтруктураОтвета.Сообщение), Символы.ПС, "") + ТекущийОтветСтруктура.Сообщение;
					
				КонецЦикла;  
				
				ТелоОтвета = ОбщегоНазначения.ВернутьJSON(СтруктураОтвета);
				
			Иначе 	
				
				СтруктураОтвета = Новый Структура("Результат, Данные, Сообщение", Ложь, Неопределено, "Не указан Текст запроса к ресурсу"); 
				ТелоОтвета 		= ОбщегоНазначения.ВернутьJSON(СтруктураОтвета);
				
			КонецЕсли;	                                   
			
		Иначе  
			
			СтруктураОтвета = Новый Структура("Результат, Данные, Сообщение", Ложь, Неопределено, ДанныеПроверки.СообщениеОшибки); 
			ТелоОтвета 		= ОбщегоНазначения.ВернутьJSON(СтруктураОтвета);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Ответ.УстановитьТелоИзСтроки(ТелоОтвета);                
	
	Возврат Ответ;  
	
КонецФункции

Функция РазбитьТекстЗапроса(ТекстЗапроса)

	МассивТекстов = Новый Массив;
	
	СтруктураЗапроса = ОбщегоНазначения.ВернутьСтруктуруИзJSON(ТекстЗапроса);
		
	МассивИдентификаторов = Новый Массив;
	
	Для каждого СтрокаТовара Из СтруктураЗапроса.Строки Цикл
		
		Если МассивИдентификаторов.Найти(СтрокаТовара.ИдентификаторСклад) = Неопределено Тогда
			МассивИдентификаторов.Добавить(СтрокаТовара.ИдентификаторСклад);		
		КонецЕсли;
		
	КонецЦикла;              
	
	МассивКлючейИсключения = Новый Массив;
	МассивКлючейИсключения.Добавить("Строки");
	
	Для каждого ИдентификаторСклад Из МассивИдентификаторов Цикл                
		
		СтруктураЗапросаРазбитая = СкопироватьСтруктуру(СтруктураЗапроса, МассивКлючейИсключения);
		СтруктураЗапросаРазбитая.Шапка.Вставить("ИдентификаторСклад", ИдентификаторСклад);
		СтруктураЗапросаРазбитая.Вставить("Строки", Новый Массив());
		
		Для каждого СтрокаТовара Из СтруктураЗапроса.Строки Цикл
			
			Если СтрокаТовара.ИдентификаторСклад <> ИдентификаторСклад Тогда
				Продолжить;
			КонецЕсли;     
			
			СтруктураСтроки = СкопироватьСтруктуру(СтрокаТовара);			
			СтруктураЗапросаРазбитая.Строки.Добавить(СтруктураСтроки);
			
		КонецЦикла;
		
		МассивТекстов.Добавить(ОбщегоНазначения.ВернутьJSON(СтруктураЗапросаРазбитая));
		
	КонецЦикла;	
	
	Возврат МассивТекстов;

КонецФункции

Функция СкопироватьСтруктуру(Структура, МассивКлючейИсключения = Неопределено)
	
	СкопированнаяСтруктура = Новый Структура;
	
	Для каждого Свойство Из Структура Цикл
		
		Если МассивКлючейИсключения <>Неопределено И МассивКлючейИсключения.Найти(Свойство.Ключ) <> Неопределено Тогда
			Продолжить;	
		КонецЕсли;   
		
		СкопированнаяСтруктура.Вставить(Свойство.Ключ, Свойство.Значение);
		
	КонецЦикла;
	
	Возврат СкопированнаяСтруктура;
		
КонецФункции

