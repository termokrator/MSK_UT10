	ЗаписьЖурналаРегистрации(ИмяРегЗадания+".Завершение", УровеньЖурналаРегистрации.Информация,,,);      
	
КонецПроцедуры

Процедура ЗагрузкаЦенНоменклатурыЕдиныйПрайсЛистЧастично() Экспорт
	
	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда   
		
		ЗаписьЖурналаРегистрации("Загрузка цен единый прайс-лист ЧАСТИЧНО", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Отменена работа регламентного задания из-за несоответствия параметров подключения к ИБ");
		Возврат;          
		
	КонецЕсли;
	
	ИмяРегЗадания = "Загрузка цен единый прайс-лист ЧАСТИЧНО";
	МассивОшибок = Новый Массив;
	ИмяКаталогаСервера = "PartialPriceUpdates/";
	ИмяFTPСервера = Константы.FTPЗагрузкаЦенАдрес.Получить();
	
	Попытка
		Соединение = Новый FTPСоединение(ИмяFTPСервера, "21", Константы.FTPЗагрузкаЦенЛогин.Получить(),  Константы.FTPЗагрузкаЦенПароль.Получить(), , Истина);
	Исключение            
		
		ЗаписьЖурналаРегистрации(ИмяРегЗадания+".Ошибка", УровеньЖурналаРегистрации.Ошибка,,, "Ошибка соединения с сервером ftp: " + ИмяFTPСервера + Символы.ПС + ОписаниеОшибки());
		МассивОшибок.Добавить("Ошибка соединения с сервером ftp: " + ИмяFTPСервера + Символы.ПС + ОписаниеОшибки());
		ОтправитьЭлПисьмоОбОшибкахСозданияДокументаЕдиныйПрайсЛист(ИмяРегЗадания, МассивОшибок);
		Возврат;  
		
	КонецПопытки;  
	
	Попытка
		МассивНайденныхФайловНаСервере = Соединение.НайтиФайлы(ИмяКаталогаСервера, "*.txt");
	Исключение       
		
		ЗаписьЖурналаРегистрации(ИмяРегЗадания+".Ошибка", УровеньЖурналаРегистрации.Ошибка,,, "Ошибка при вызове метода Найти файлы" + Символы.ПС + ОписаниеОшибки());
		МассивОшибок.Добавить("Ошибка при вызове метода Найти файлы" + Символы.ПС + ОписаниеОшибки());
		ОтправитьЭлПисьмоОбОшибкахСозданияДокументаЕдиныйПрайсЛист(ИмяРегЗадания, МассивОшибок);
		Возврат; 
		
	КонецПопытки;
	
	//Сортируем по наименованию и оставляем только файлы текущего дня
	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(МассивНайденныхФайловНаСервере);
	Список.СортироватьПоЗначению(НаправлениеСортировки.Возр);
	МассивНайденныхФайловНаСервере = Список.ВыгрузитьЗначения();
	
	ТекущаяДата = Формат(ТекущаяДата(), "ДФ=yyyyMMdd");
	
	н = МассивНайденныхФайловНаСервере.Количество() - 1;  
	
	Пока н >= 0 Цикл          
		
		ИмяФайла = МассивНайденныхФайловНаСервере[н].Имя; 
		
		Если Найти(ИмяФайла,ТекущаяДата) = 0 или Найти(ИмяФайла, "PricePM2") = 0
			//Данные из этого файла уже загружали
			Или Документы.УстановкаЦенНоменклатуры.НайтиПоРеквизиту("ИмяФайлазагрузки", ИмяФайла) <> Документы.УстановкаЦенНоменклатуры.ПустаяСсылка() Тогда
			МассивНайденныхФайловНаСервере.Удалить(н);
		КонецЕсли;             
		
		н = н - 1;     
		
	КонецЦикла;
	
	Если МассивНайденныхФайловНаСервере.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации(ИмяРегЗадания+".Начало", УровеньЖурналаРегистрации.Информация,,,);
	
	Для Каждого ТекСтр ИЗ МассивНайденныхФайловНаСервере Цикл  
		
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла("txt");    
		
		Попытка
		
			ЗаписьЖурналаРегистрации(ИмяРегЗадания+".Обработка", УровеньЖурналаРегистрации.Информация,,, "Начало обработки файла: " + ТекСтр.Имя);
			Соединение.Получить(ИмяКаталогаСервера+ТекСтр.Имя, ИмяВременногоФайла);
			СозданиеДокументаЕдиныйПрайсЛист(ИмяВременногоФайла, Ложь, ТекСтр.Имя, Истина, Соединение);   
			
		Исключение            
			
			ЗаписьЖурналаРегистрации(ИмяРегЗадания+".Ошибка", УровеньЖурналаРегистрации.Ошибка,,, ОписаниеОшибки());
			МассивОшибок.Добавить("Не удалось выполнить рег задание" + Символы.ПС + ОписаниеОшибки());
			ОтправитьЭлПисьмоОбОшибкахСозданияДокументаЕдиныйПрайсЛист(ИмяРегЗадания, МассивОшибок);
			Прервать;  
			
		КонецПопытки;
	КонецЦикла;
	
	ЗаписьЖурналаРегистрации(ИмяРегЗадания+".Завершение", УровеньЖурналаРегистрации.Информация,,,); 
	
КонецПроцедуры

Процедура СозданиеДокумента_Новый(Файл, УдалятьПредыдущиеДокументы = Истина, ДопТаблицаОстатков)   
	
	Если Не ЗначениеЗаполнено(Файл) Тогда 
		Возврат;
	КонецЕсли;
	
	КоличествоСтрокВДокументе = 25000;
	Робот = Справочники.Пользователи.НайтиПоКоду("robot");
	//Удаление предыдущих перенесем после загрузки
	
	МассивТиповЦен =  Новый Массив;
	
	ЗакупочнаяЦена 	= Константы.ЗакупочнаяЦена.Получить();
	Базовая 		= Константы.БазоваяЦена.Получить();
	Скидка35 		= Константы.Скидка35.Получить();
	Скидка36 		= Константы.Скидка36.Получить();
	Скидка37 		= Константы.Скидка37.Получить();
	Скидка38		= Константы.Скидка38.Получить();	
	СпецЦена        = Константы.СпецЦена.Получить();
	
	АДУрал			= Константы.АДУрал.Получить();
	ЗагружатьАДУрал = ЗначениеЗаполнено(АДУрал);
	ТекущаяБаза     = Константы.База.Получить();       
	
	ЗагружатьЗакупочнуюЦену = Истина; //(ТекущаяБаза = Перечисления.НазваниеБазы.Казань Или ТекущаяБаза = Перечисления.НазваниеБазы.Воронеж)
	ЗагружатьЦенуДляРекламнойПродукции = Истина;
	
	МассивТиповЦен.Добавить(Скидка35);
	МассивТиповЦен.Добавить(Базовая); 
	
	Если ЗагружатьЗакупочнуюЦену Тогда 
		МассивТиповЦен.Добавить(ЗакупочнаяЦена);
	КонецЕсли;                        
	
	МассивТиповЦен.Добавить(Скидка36);
	МассивТиповЦен.Добавить(Скидка37);
	МассивТиповЦен.Добавить(Скидка38);
	
	МассивТиповЦен.Добавить(СпецЦена);
	
	Если ЗагружатьАДУрал Тогда
		МассивТиповЦен.Добавить(АДУрал);
	КонецЕсли;
	
	// ТаблицаЗагрузки
	ТабЗагрузки = Новый ТаблицаЗначений;
	ТабЗагрузки.Колонки.Добавить("Артикул"				,Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(25)));
	ТабЗагрузки.Колонки.Добавить("ЦенаСкидка35"			,Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	ТабЗагрузки.Колонки.Добавить("ЦенаБазовая"			,Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	
	// закупочная цена для Самары и Владимира не актуальна
	Если ЗагружатьЗакупочнуюЦену Тогда 
		ТабЗагрузки.Колонки.Добавить("ЦенаЗакупочная"	,Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	КонецЕсли;
	
	ТабЗагрузки.Колонки.Добавить("ЦенаСкидка36"			,Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	ТабЗагрузки.Колонки.Добавить("ЦенаСкидка37"			,Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	ТабЗагрузки.Колонки.Добавить("ЦенаСкидка38"			,Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	ТабЗагрузки.Колонки.Добавить("ЦенаСпециальная"		,Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	
	Если ЗагружатьАДУрал Тогда
		ТабЗагрузки.Колонки.Добавить("ЦенаАДУрал"		,Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	КонецЕсли;
	
	ТабЗагрузки.Колонки.Добавить("ОстатокВМоскве"		,Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	ТабЗагрузки.Колонки.Добавить("КодНоменклатурнойГруппы",Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(9)));
	ТабЗагрузки.Колонки.Добавить("ИмяНоменклатурнойГруппы",Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(100)));
	ТабЗагрузки.Колонки.Добавить("КатегорияАВС"			,Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(4)));
	ТабЗагрузки.Колонки.Добавить("КоэфНоменклатуры"		,Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));	
	
	ТабЗакупки = Новый ТаблицаЗначений;
	ТабЗакупки.Колонки.Добавить("Артикул"				,Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(25)));
	ТабЗакупки.Колонки.Добавить("Цена"			,Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	
	Текст = Новый ТекстовыйДокумент; 
	Текст.Прочитать(Файл); 
	
	ЗаписьЖурналаРегистрации("Загрузка цен.Обработка", УровеньЖурналаРегистрации.Информация,,, "Количество строк файла: " + Строка(Текст.КоличествоСтрок()));
	
	//КоличествоСтрок = 3000;
	Для НомерСтроки = 1 По Текст.КоличествоСтрок() Цикл  
		
		Стр = Текст.ПолучитьСтроку(НомерСтроки);
		
		// Для отладки
		//Если НомерСтроки = 300 Тогда
		//	Прервать;
		//КонецЕсли;
		
		Попытка
			
			//ID
			НомерСобаки = Найти(Стр, "@"); 
			
			Если НомерСобаки > 0 Тогда
				Стр = Сред(Стр, НомерСобаки + 1);
			Иначе 
				Продолжить;
			КонецЕсли;
			
			//Inv
			НомерСобаки = Найти(Стр, "@"); 
			
			Если НомерСобаки > 0 Тогда 
				
				НС = ТабЗагрузки.Добавить();
				НС.Артикул = Лев(Стр, НомерСобаки-1);
				НСЗ = ТабЗакупки.Добавить();
				НСЗ.Артикул = Лев(Стр, НомерСобаки-1);
				
				Стр = Сред(Стр, НомерСобаки + 1); 
				
			Иначе 
				Продолжить;
			КонецЕсли;
			
			//BREND(Производитель) , ARTICUL(Номер товара)  , TOV_NAME(Наименование)
			Для  Х = 1  по 3 Цикл        
				
				НомерСобаки = Найти(Стр, "@"); 
				
				Если НомерСобаки > 0 Тогда 
					Стр = Сред(Стр, НомерСобаки + 1);
				Иначе 
					Продолжить;
				КонецЕсли;      
				
			КонецЦикла;
			
			//GRUPPA  (Группа)
			НомерСобаки = Найти(Стр, "@");
			
			Если НомерСобаки > 0 Тогда     
				
				НС.КатегорияАВС = Лев(Стр, НомерСобаки-1);
				Стр = Сред(Стр, НомерСобаки + 1);  
				
			Иначе 
				Продолжить;
			КонецЕсли;
			
			//PACK_NAME(ЕдИзм МИНИУПАКОВКА)
			НомерСобаки = Найти(Стр, "@");
			Стр = Сред(Стр, НомерСобаки + 1);
			
			//PACK (Коэфф МИНИУПАКОВКИ)
			НомерСобаки = Найти(Стр, "@");  
			
			Если НомерСобаки > 1 Тогда 
				КоэфНоменклатуры = Число(Лев(Стр,  НомерСобаки - 1));
			Иначе 
				КоэфНоменклатуры = 0;
			КонецЕсли;  
			
			НС.КоэфНоменклатуры = КоэфНоменклатуры;
			Стр = Сред(Стр, НомерСобаки + 1);
			
			//VALUTA_NAME(Валюта)
			НомерСобаки = Найти(Стр, "@");
			Стр = Сред(Стр, НомерСобаки + 1);
			
			//AD_URAL(АД Урал)
			НомерСобаки = Найти(Стр, "@"); 
			
			Если НомерСобаки > 0 Тогда      
				
				Если ТекущаяБаза = Перечисления.НазваниеБазы.Воронеж Или ТекущаяБаза = Перечисления.НазваниеБазы.Казань 
					Или ТекущаяБаза = Перечисления.НазваниеБазы.Ростов 
					Или ТекущаяБаза = Перечисления.НазваниеБазы.Краснодар Тогда 
					
					КолЗнаков = СтрДлина(Лев(Стр, НомерСобаки - 1));  
					
					Если КолЗнаков = 0 Тогда
						ЦенаЗакупочная = 0;
					Иначе
						ЦенаЗакупочная = Окр(Число(Лев(Стр, НомерСобаки - 1)), 2, 1);
					КонецЕсли;                
					
					Стр = Сред(Стр, НомерСобаки + 1);  
					
					Если ЗагружатьЗакупочнуюЦену Тогда 
						НС.ЦенаЗакупочная = ЦенаЗакупочная;
					КонецЕсли;   
					
				ИначеЕсли ЗагружатьАДУрал Тогда		
					
					КолЗнаков = СтрДлина(Лев(Стр, НомерСобаки - 1)); 
					
					Если КолЗнаков = 0 Тогда
						ЦенаАДУрал = 0;
					Иначе
						ЦенаАДУрал = Окр(Число(Лев(Стр, НомерСобаки - 1)), 2, 1);
					КонецЕсли;                     
					
					Стр = Сред(Стр, НомерСобаки + 1);
					НС.ЦенаАДУрал = ЦенаАДУрал;  
					
				Иначе					
					// пропускаем эту цену
					Стр = Сред(Стр, НомерСобаки + 1);
				КонецЕсли;
			Иначе 
				Продолжить;
			КонецЕсли;
			
			//AUTOEUROPE (АвтоЕвропа)
			НомерСобаки = Найти(Стр, "@");  
			
			Если НомерСобаки > 0 Тогда
				Стр = Сред(Стр, НомерСобаки + 1);
			Иначе 
				Продолжить;
			КонецЕсли;
			
			//VIP BMW
			НомерСобаки = Найти(Стр, "@");   
			
			Если НомерСобаки > 1 Тогда 
				ЦенаСкидка35 = Окр(Число(Лев(Стр, НомерСобаки - 1)), 2, 1);
			Иначе 
				ЦенаСкидка35 = 0;
			КонецЕсли;                     
			
			НС.ЦенаСкидка35 = ЦенаСкидка35;
			Стр = Сред(Стр, НомерСобаки + 1);
			
			//БАЗА 0%
			НомерСобаки = Найти(Стр, "@");
			
			Если НомерСобаки > 1 Тогда 
				ЦенаБазовая = Окр(Число(Лев(Стр, НомерСобаки - 1)), 2, 1);
			Иначе 
				ЦенаБазовая =  0;
			КонецЕсли;                 
			
			НС.ЦенаБазовая = ЦенаБазовая;
			Стр = Сред(Стр, НомерСобаки + 1);
			
			//MSKNN
			НомерСобаки = Найти(Стр, "@"); 
			
			Если НомерСобаки > 0 Тогда
				Стр = Сред(Стр, НомерСобаки + 1);
			Иначе 
				Продолжить;
			КонецЕсли;
			
			//MSKKAZ
			НомерСобаки = Найти(Стр, "@"); 
			
			Если НомерСобаки > 0 Тогда     
				
				Если НомерСобаки > 1 Тогда 
					ЦенаБазовая = Окр(Число(Лев(Стр, НомерСобаки - 1)), 2, 1);
				Иначе 
					ЦенаБазовая =  0;
				КонецЕсли;          
				
				НСЗ.Цена = ЦенаБазовая;
				
				Если ТекущаяБаза <> Перечисления.НазваниеБазы.Казань И ТекущаяБаза <> Перечисления.НазваниеБазы.Воронеж 
				   И ТекущаяБаза <> Перечисления.НазваниеБазы.Ростов
					Или ТекущаяБаза = Перечисления.НазваниеБазы.Краснодар Тогда 
					
					КолЗнаков = СтрДлина(Лев(Стр, НомерСобаки - 1));  
					
					Если КолЗнаков = 0 Тогда
						ЦенаЗакупочная = 0;
					Иначе
						ЦенаЗакупочная = Окр(Число(Лев(Стр, НомерСобаки - 1)), 2, 1);
					КонецЕсли;            
					
					Стр = Сред(Стр, НомерСобаки + 1);    
					
					Если ЗагружатьЗакупочнуюЦену Тогда 
						НС.ЦенаЗакупочная = ЦенаЗакупочная;
					КонецЕсли;     
					
				Иначе
					// пропускаем эту цену
					Стр = Сред(Стр, НомерСобаки + 1);
				КонецЕсли;
			Иначе 
				Продолжить;
			КонецЕсли;
			
			//ОП КОРЕЯ
			НомерСобаки = Найти(Стр, "@");
			Стр = Сред(Стр, НомерСобаки + 1);
			
			//36% (ОП ЯПОНИЯ)
			НомерСобаки = Найти(Стр, "@");
			
			Если НомерСобаки > 1 Тогда 
				ЦенаСкидка36 = Окр(Число(Лев(Стр, НомерСобаки - 1)), 2, 1);
			Иначе 
				ЦенаСкидка36  = 0 ;
			КонецЕсли;             
			
			НС.ЦенаСкидка36 = ЦенаСкидка36;
			Стр = Сред(Стр, НомерСобаки + 1);
			
			// 37% (VIP/VIP LADA)
			НомерСобаки = Найти(Стр, "@");
			Если НомерСобаки > 1 Тогда 
