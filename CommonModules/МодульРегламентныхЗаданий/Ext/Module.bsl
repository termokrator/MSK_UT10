Процедура ЗагрузкаОстатковЦС() Экспорт
	
	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда 
		
		ЗаписьЖурналаРегистрации("Загрузка остатков ЦС", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Отменена работа регламентного задания из-за несоответствия параметров подключения к ИБ");
		Возврат;
		
	КонецЕсли;
	
	ИмяКаталогаСервера = "";
	ИмяFTPСервера = Константы.FTPЗагрузкаЦенАдрес.Получить();
	//ИмяFTPСервера = "ftp.moskvorechie.ru";
	
	Попытка
		Соединение = Новый FTPСоединение(ИмяFTPСервера, "21", Константы.FTPЗагрузкаЦенЛогин.Получить(),  Константы.FTPЗагрузкаЦенПароль.Получить(), , Истина);
		//Соединение = Новый FTPСоединение(ИмяFTPСервера, "21", "avarda", "Mei@3AJx", ,Ложь);
	Исключение
		Возврат;
	КонецПопытки;
	
	
	МассивНайденныхФайловНаСервере = Соединение.НайтиФайлы(ИмяКаталогаСервера, "*.txt");
	
	ТаблицаОстатков = Неопределено;
	
	Для Каждого ТекСтр ИЗ МассивНайденныхФайловНаСервере Цикл
		
		Если ВРег(ТекСтр.Имя) = ВРег("price.file.txt") Тогда 			
			
			ИмяВременногоФайла = ПолучитьИмяВременногоФайла("txt");
			Соединение.Получить("price.file.txt", ИмяВременногоФайла); 		
			
			Текст = Новый ТекстовыйДокумент; 
			Текст.Прочитать(ИмяВременногоФайла); 
			
			ТаблицаТоваров = Новый ТаблицаЗначений;
			ТаблицаТоваров.Колонки.Добавить("Артикул", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(25)));
			ТаблицаТоваров.Колонки.Добавить("Остаток", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
			
			Для НомерСтроки = 1 По Текст.КоличествоСтрок() Цикл 
				
				Стр = Текст.ПолучитьСтроку(НомерСтроки);
				МассивСтрок = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(Стр, Символы.Таб);   				
				
				Если МассивСтрок.Количество() >= 7 Тогда
					
					Если МассивСтрок[6] = "0" Тогда
						Продолжить;
					КонецЕсли;
					
					НоваяСтрока = ТаблицаТоваров.Добавить();
					НоваяСтрока.Артикул = МассивСтрок[1];
					НоваяСтрока.Остаток = МассивСтрок[6];
					
				КонецЕсли;
				
			КонецЦикла;
			
			Запрос = Новый Запрос;
			МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц();
			Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
			Запрос.УстановитьПараметр("ТаблицаТоваров", ТаблицаТоваров);
			
			Запрос.Текст = "ВЫБРАТЬ
			|	ТаблицаТоваров.Остаток,
			|	ТаблицаТоваров.Артикул КАК Артикул
			|ПОМЕСТИТЬ ТаблицаТоваров
			|ИЗ
			|	&ТаблицаТоваров КАК ТаблицаТоваров
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	Артикул
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	МАКСИМУМ(ТаблицаТоваров.Остаток) КАК Количество,
			|	Номенклатура.Ссылка КАК Номенклатура
			|ИЗ
			|	ТаблицаТоваров КАК ТаблицаТоваров
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
			|		ПО ТаблицаТоваров.Артикул = Номенклатура.Артикул
			|
			|СГРУППИРОВАТЬ ПО
			|	Номенклатура.Ссылка";
			
			ТаблицаОстатков = Запрос.Выполнить().Выгрузить();
			ТаблицаОстатков.Свернуть("Номенклатура", "Количество");
			
			НаборЗаписей = РегистрыСведений.МосковскиеОстаткиНоменклатуры.СоздатьНаборЗаписей(); 
			НаборЗаписей.Загрузить(ТаблицаОстатков);
			НаборЗаписей.Записать();	
			
			КонстантаВыгрузкаЦенЛогин  = Константы.FTPВыгрузкаЦенЛогин.Получить();
			КонстантаВыгрузкаЦенПароль = Константы.FTPВыгрузкаЦенПароль.Получить();
			
			Если ЗначениеЗаполнено(КонстантаВыгрузкаЦенЛогин) И ЗначениеЗаполнено(КонстантаВыгрузкаЦенПароль) Тогда
				
				Попытка
					
					СоединениеОстатки = Новый FTPСоединение(ИмяFTPСервера, "21", КонстантаВыгрузкаЦенЛогин, КонстантаВыгрузкаЦенПароль, , Истина); 
					СоединениеОстатки.Записать(ИмяВременногоФайла, "price.file.txt");
					
				Исключение                
				КонецПопытки; 
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	
КонецПроцедуры

