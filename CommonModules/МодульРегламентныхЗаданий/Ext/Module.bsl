	|						ВТ_ТоварыИТипыЦен.ТипЦен
	|					ИЗ
	|						ВТ_ТоварыИТипыЦен)) КАК ЦеныНоменклатурыСрезПоследних
	|		ПО ВТ_ТоварыИТипыЦен.Ссылка = ЦеныНоменклатурыСрезПоследних.Номенклатура
	|			И ВТ_ТоварыИТипыЦен.ТипЦен = ЦеныНоменклатурыСрезПоследних.ТипЦен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	""Ц_"" + ВТ_ТипыЦен.ТипЦен.Код КАК ТипЦен,
	|	ВТ_ТипыЦен.ТипЦен.КодМДМ КАК ТипЦенКодМДМ
	|ИЗ
	|	ВТ_ТипыЦен КАК ВТ_ТипыЦен
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_ТипыЦен.ТипЦен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Итог.Номенклатура.КодМДМ КАК Номенклатура,
	|	МАКСИМУМ(ВТ_Итог.Номенклатура.КратностьФилиала) КАК КратностьФилиала,
	|	""Ц_"" + ВТ_Итог.ТипЦен.Код КАК ТипЦен,
	|	МАКСИМУМ(ВТ_Итог.Цена) КАК Цена
	|ИЗ
	|	ВТ_Итог КАК ВТ_Итог
	|ГДЕ
	|	НЕ ВТ_Итог.Номенклатура ЕСТЬ NULL
	|	И НЕ ВТ_Итог.ТипЦен ЕСТЬ NULL
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Итог.Номенклатура.КодМДМ,
	|	""Ц_"" + ВТ_Итог.ТипЦен.Код
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура,
	|	ТипЦен
	|ИТОГИ
	|	МАКСИМУМ(КратностьФилиала),
	|	МАКСИМУМ(Цена)
	|ПО
	|	Номенклатура,
	|	ТипЦен";
	
	ЗапросДанныхПоЦенам.УстановитьПараметр("ВидНоменклатуры", Константы.ВидНоменклатурыПоУмолчанию.Получить());
	
	ПакетЗапроса = ЗапросДанныхПоЦенам.ВыполнитьПакет();
	
	ПакетТипыЦен = ПакетЗапроса[4].Выгрузить();
	ПакетТовары  = ПакетЗапроса[5]; 
	
	ТаблицаДанныхПоЦенам = Новый ТаблицаЗначений;
	ТаблицаДанныхПоЦенам.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(36)));
	ТаблицаДанныхПоЦенам.Колонки.Добавить("КратностьФилиала", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(3, 0)));
	
	Для Каждого СтрокаТиповЦен Из ПакетТипыЦен Цикл
		 ТаблицаДанныхПоЦенам.Колонки.Добавить(СокрЛП(СтрокаТиповЦен.ТипЦен), Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	КонецЦикла;
	
	ВыборкаНоменклатура = ПакетТовары.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаНоменклатура.Следующий() Цикл		
		
		ЕстьСтрокаСНоменклатурой                  = ТаблицаДанныхПоЦенам.Добавить();
		ЕстьСтрокаСНоменклатурой.Номенклатура     = ВыборкаНоменклатура.Номенклатура;
		ЕстьСтрокаСНоменклатурой.КратностьФилиала = ВыборкаНоменклатура.КратностьФилиала; 
		
		ВыборкаЦен = ВыборкаНоменклатура.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаЦен.Следующий() Цикл 			
			ЕстьСтрокаСНоменклатурой[ВыборкаЦен.ТипЦен] = ВыборкаЦен.Цена;
		КонецЦикла;
		
	КонецЦикла;
	
	МассивСтрокДляЗаписиВТекстовыйДокумент = Новый Массив;
	МаксимальноеКоличествоИтераций = 20000;
	
	СтрокаЗаголовок = "Номенклатура" + Символы.Таб + "КратностьФилиала";
	
	Для Каждого СтрокаТиповЦен Из ПакетТипыЦен Цикл
        СтрокаЗаголовок = СтрокаЗаголовок + Символы.Таб + СокрЛП(СтрокаТиповЦен.ТипЦенКодМДМ); 
	КонецЦикла;
	
	МассивСтрокДляЗаписиВТекстовыйДокумент.Добавить(СтрокаЗаголовок);
	
	ДанныеПоЦенамСтрока = "";
	
	Инд = 0;         
	
	Для Каждого СтрокаТаблицы Из ТаблицаДанныхПоЦенам Цикл	
		
		Если Инд = МаксимальноеКоличествоИтераций Тогда
			
			МассивСтрокДляЗаписиВТекстовыйДокумент.Добавить(ДанныеПоЦенамСтрока);	
			Инд = 0;  
			ДанныеПоЦенамСтрока = "";
			
		КонецЕсли; 
		
		ВременнаяСтрока = СокрЛП(СтрокаТаблицы.Номенклатура) + Символы.Таб + СтрЗаменить(СтрокаТаблицы.КратностьФилиала, Символы.НПП, "");
		
		Для Каждого СтрокаТиповЦен Из ПакетТипыЦен Цикл
			ВременнаяСтрока = ВременнаяСтрока + Символы.Таб + СтрЗаменить(СтрокаТаблицы[СтрокаТиповЦен.ТипЦен], Символы.НПП,""); 
		КонецЦикла;
		
		ДанныеПоЦенамСтрока = ДанныеПоЦенамСтрока + ?(Инд > 0, Символы.ПС, "")+ ВременнаяСтрока;
		
		Инд = Инд + 1;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ДанныеПоЦенамСтрока) Тогда
		МассивСтрокДляЗаписиВТекстовыйДокумент.Добавить(ДанныеПоЦенамСтрока);	
	КонецЕсли;
	
	ИтоговыеДанныеПоЦенамСтрока = "";
	
	Сч = 0;
	
	Для Каждого СтрокаДобавления Из МассивСтрокДляЗаписиВТекстовыйДокумент Цикл
		
		ИтоговыеДанныеПоЦенамСтрока = ИтоговыеДанныеПоЦенамСтрока + ?(Сч > 0, Символы.ПС, "") + СтрокаДобавления; 			
		Сч = Сч + 1;
		
	КонецЦикла;
	
	ИтоговыеДанныеПоЦенамСтрока = ИтоговыеДанныеПоЦенамСтрока + Символы.ПС;
	
	Текст.УстановитьТекст(ИтоговыеДанныеПоЦенамСтрока);
	
	ИмяВременногоКаталога = СокрЛП(Новый УникальныйИдентификатор);
	СоздатьКаталог(КаталогВременныхФайлов() + ИмяВременногоКаталога);
	ВременныйКаталог = КаталогВременныхФайлов() + ИмяВременногоКаталога + "\";
	Текст.Записать(ВременныйКаталог + "PriceGF.txt");
	
	Попытка
		
		Соединение.Записать(ВременныйКаталог + "PriceGF.txt","PriceGF.txt");		
		ЗаписьЖурналаРегистрации("Запись данных на FTP прошла успешно!");
		
	Исключение
		ЗаписьЖурналаРегистрации("Блокировки НЕ БЫЛО. Но запись данных на FTP НЕ СОСТОЯЛАСЬ!");
	КонецПопытки;
	
	Соединение.Удалить("connect.lock");
	
	УдалитьФайлы(КаталогВременныхФайлов() + ВремИмя);
	УдалитьФайлы(ВременныйКаталог);
	
КонецПроцедуры

Процедура МанипуляцииСКатегорией(КатегорияАВС,Артикул)
	
	ЗаписатьБезУсловий = 0;
	
	Элемент = Справочники.АВСКлассификацияНоменклатуры.НайтиПоКоду(КатегорияАВС);
	
	Если Элемент = Справочники.АВСКлассификацияНоменклатуры.ПустаяСсылка() Тогда
		
		НовыйЭлемент = Справочники.АВСКлассификацияНоменклатуры.СоздатьЭлемент();
		НовыйЭлемент.Код =   КатегорияАВС ;
		НовыйЭлемент.Записать();
		ЗаписатьБезУсловий = 1;
		
	КонецЕсли;
	
	ЭлементНоменклатуры = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", Артикул);
	
	Если ЭлементНоменклатуры <> Справочники.Номенклатура.ПустаяСсылка() Тогда
		
		Если ЗаписатьБезУсловий = 1 Тогда 
			
			Об = ЭлементНоменклатуры.ПолучитьОбъект();
			Об.ГруппаАВС = НовыйЭлемент.Ссылка;
			Об.Записать();
			
		Иначе
			
			Если ЭлементНоменклатуры.ГруппаАВС <> Элемент Тогда 
				
				Об = ЭлементНоменклатуры.ПолучитьОбъект();
				Об.ГруппаАВС = Элемент;
				Об.Записать();
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

