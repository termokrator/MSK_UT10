Процедура ПолучениеДанныхИзУТ11ОПодписиПТУВЭДО() Экспорт
	
	//+Сёмин Р.И. 14.07.2026 #UT10-5945
	ИмяСобытия = "Получение данных из УТ11 о подписи ПТУ в ЭДО";
	
	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда 
		
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			"Отменена работа регламентного задания из-за несоответствия параметров подключения к ИБ"
		);
		
		Возврат;
		
	КонецЕсли;	
	
	ЗаписьЖурналаРегистрации(
		ИмяСобытия,
		УровеньЖурналаРегистрации.Информация,
		,
		,
		"Начато регламентное задание Получение данных из УТ 11 о подписи ПТУ в ЭДО"
	);
	
	ГУИДыПТУ = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВЫБОР
		|		КОГДА ЗначенияСвойствОбъектов.Объект ССЫЛКА Документ.ПоступлениеТоваровУслуг
		|			ТОГДА ВЫРАЗИТЬ(ЗначенияСвойствОбъектов.Объект КАК Документ.ПоступлениеТоваровУслуг)
		|	КОНЕЦ КАК Документ
		|ИЗ
		|	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
		|ГДЕ
		|	ЗначенияСвойствОбъектов.Объект ССЫЛКА Документ.ПоступлениеТоваровУслуг
		|	И ЗначенияСвойствОбъектов.Объект.Дата >= &Дата
		|	И ЗначенияСвойствОбъектов.Свойство = &Свойство
		|	И ЗначенияСвойствОбъектов.Значение = &Значение";
	
	Запрос.УстановитьПараметр("Дата", ДобавитьМесяц(НачалоДня(ТекущаяДата()), -1));
	Запрос.УстановитьПараметр("Свойство", ПланыВидовХарактеристик.СвойстваОбъектов.СтатусПриемки);
	Запрос.УстановитьПараметр("Значение", Перечисления.СтатусыПриемки.НеНайденВЭДО);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ГУИДыПТУ.Добавить(Строка(ВыборкаДетальныеЗаписи.Документ.УникальныйИдентификатор()));
	КонецЦикла;
	
	Если ГУИДыПТУ.Количество() > 0 Тогда
		
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,
			УровеньЖурналаРегистрации.Информация,
			,
			,
			"Выполняется запрос на получение данных в УТ 11 по ПТУ с ГУИДами:" + Символы.ПС + МодульРегламентныхЗаданий.СтрСоединить(ГУИДыПТУ, Символы.ПС)
		);
		
		Результат = МСКWEB.ПолучитьДанныеИзУТ11ОПодписиПТУВЭДО(ГУИДыПТУ);
		
		ПолученныеГУИДыПТУ = Новый Массив;
		
		Для Каждого Стр Из Результат.МассивНайденныхПоступлений Цикл
			
			ПолученныеГУИДыПТУ.Добавить(Стр.КодИсточника);
			
			ПТУ = Документы.ПоступлениеТоваровУслуг.ПолучитьСсылку(Новый УникальныйИдентификатор(Стр.КодИсточника));
			
			Если ДобавитьДокументВРегистрДокументыЭДОТребующиеОбработки(ПТУ) Тогда
				
				МенеджерЗаписи = РегистрыСведений.ДокументыЭДОТребующиеОбработки.СоздатьМенеджерЗаписи();
				
				Если ЗначениеЗаполнено(Стр.Идентификатор) Тогда
					МенеджерЗаписи.Идентификатор = Стр.Идентификатор;
				Иначе
					МенеджерЗаписи.Идентификатор = ПолучитьИдентификаторДляРегистраДокументыЭДОТребующиеОбработки(9000000000);
				КонецЕсли;
				
				МенеджерЗаписи.ВидДокумента = "Поступление";
				МенеджерЗаписи.Документ = ПТУ;
				МенеджерЗаписи.Контрагент = ПТУ.Контрагент;
				МенеджерЗаписи.Договор = ПТУ.ДоговорКонтрагента;
				МенеджерЗаписи.Дата = ТекущаяДата();
				МенеджерЗаписи.Отработан = Истина;
				
				МенеджерЗаписи.Записать(Истина);
				
			КонецЕсли;
			
		КонецЦикла;
		
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,
			УровеньЖурналаРегистрации.Информация,
			,
			,
			"Получение данных из УТ 11 о подписи ПТУ в ЭДО. Из УТ11 получены данные по ПТУ с ГУИДами:" + Символы.ПС + МодульРегламентныхЗаданий.СтрСоединить(ПолученныеГУИДыПТУ, Символы.ПС)
		);
		
	Иначе
		
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,
			УровеньЖурналаРегистрации.Информация,
			,
			,
			"В УТ10 не найдены ПТУ, по которым надо получать информацию о подписи в УТ 11"
		);
		
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации(
		ИмяСобытия,
		УровеньЖурналаРегистрации.Информация,
		,
		,
		"Закончено регламентное задание Получение данных из УТ 11 о подписи ПТУ в ЭДО"
	);
	//-Сёмин Р.И. 14.07.2026 #UT10-5945
	
КонецПроцедуры

Процедура АвтоматическоеФормированиеИРассылкаДокументовВыкуп() Экспорт
	
