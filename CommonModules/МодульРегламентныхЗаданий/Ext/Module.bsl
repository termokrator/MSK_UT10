Процедура УдалениеПомеченныхОбъектов() Экспорт 
	
	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда 
		
		ЗаписьЖурналаРегистрации("Удаление помеченных объектов", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Отменена работа регламентного задания из-за несоответствия параметров подключения к ИБ");
		Возврат;
		
	КонецЕсли;
	
	// Очищаю записи регистра, чтобы не мешали удалению
	ОбработкаУдаления = Обработки.УдалениеПомеченныхОбъектов.Создать();
	ОбработкаУдаления.вКонтроль();
	
КонецПроцедуры

Процедура ОчисткаОбъектов() Экспорт
	
	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда 
		
		ЗаписьЖурналаРегистрации("Очистка объектов", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Отменена работа регламентного задания из-за несоответствия параметров подключения к ИБ");
		Возврат;
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	Тема = "Счет на оплату";   
	КоличествоДней = Справочники.МТ_ПредопределенныеЗначения.ПолучитьЗначениеПоСвойству(Справочники.МТ_ПредопределенныеЗначения.НастройкиКоличестваДней, "Количество дней хранения электронных писем");
	Дата = ТекущаяДата() - ?(ЗначениеЗаполнено(КоличествоДней), КоличествоДней, 14) * 24 * 60 * 60;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЭлектронноеПисьмо.Ссылка,
	|	ВложенияЭлектронныхПисем.Ссылка КАК СсылкаВложения
	|ИЗ
	|	Документ.ЭлектронноеПисьмо КАК ЭлектронноеПисьмо
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВложенияЭлектронныхПисем КАК ВложенияЭлектронныхПисем
	|		ПО ЭлектронноеПисьмо.Ссылка = ВложенияЭлектронныхПисем.Объект
	|			И (ЭлектронноеПисьмо.Тема = &Тема)
	|			И (ЭлектронноеПисьмо.ДатаТранспорта <= &Дата)
	|ГДЕ
	|	ЭлектронноеПисьмо.Тема = &Тема
	|	И ЭлектронноеПисьмо.ДатаТранспорта <= &Дата";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Тема", Тема);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.СсылкаВложения) Тогда         
			
			ОбъектВложения = ВыборкаДетальныеЗаписи.СсылкаВложения.ПолучитьОбъект();   
			
			Попытка 
				
				Если Не ОбъектВложения = Неопределено Тогда
					ОбъектВложения.Удалить();
				КонецЕсли;
				
			Исключение
				ОбъектВложения.УстановитьПометкуУдаления(Истина);
			КонецПопытки;       
			
		КонецЕсли;
		
	КонецЦикла;
	
	ВыборкаДетальныеЗаписи.Сбросить();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Объект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		
		Попытка 
			
			Если Не Объект = Неопределено Тогда
				
				Объект.УстановитьПометкуУдаления(Истина);
				Объект.Удалить();
				
			КонецЕсли;
			
		Исключение
			Объект.УстановитьПометкуУдаления(Истина);
		КонецПопытки;
		
	КонецЦикла;
	
	МассивРегистров = Новый Массив;
	МассивРегистров.Добавить(РегистрыСведений.ВерсииОбъектов);
	МассивРегистров.Добавить(РегистрыСведений.ИсторияХраненияИзмененийЗагружСтатусов);
	МассивРегистров.Добавить(РегистрыСведений.ОткорректированныеРегламентомСобранныеСборки);
	МассивРегистров.Добавить(РегистрыСведений.ЗапросыИзмененияКоличестваВЗаказах);

	Для к = 0 По МассивРегистров.ВГраница() Цикл 
		
		Регистр = МассивРегистров[к];
		
		Если ТипЗнч(Регистр) = Тип(РегистрыСведений.ОткорректированныеРегламентомСобранныеСборки) Тогда  
			
			КоличествоДней = Справочники.МТ_ПредопределенныеЗначения.ПолучитьЗначениеПоСвойству(Справочники.МТ_ПредопределенныеЗначения.НастройкиКоличестваДней, "Количество дней хранения данных в регистре откорректированных сборок");
			ПериодПо = ТекущаяДата() - ?(ЗначениеЗаполнено(КоличествоДней), КоличествоДней, 90) * 24 * 60 * 60;
			
			Выборка = РегистрыСведений.ОткорректированныеРегламентомСобранныеСборки.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				Если Выборка.ДатаЗаписи < ПериодПо Тогда
					
					Запись = Выборка.ПолучитьМенеджерЗаписи();
					Запись.Удалить();
					
				КонецЕсли; 
				
			КонецЦикла;
			
		ИначеЕсли ТипЗнч(Регистр) = Тип(РегистрыСведений.ИсторияХраненияИзмененийЗагружСтатусов) Тогда  
			
			КоличествоДней = Справочники.МТ_ПредопределенныеЗначения.ПолучитьЗначениеПоСвойству(Справочники.МТ_ПредопределенныеЗначения.НастройкиКоличестваДней, "Количество дней хранения данных в регистре загруженных статусов");
			ПериодПо = ТекущаяДата() - ?(ЗначениеЗаполнено(КоличествоДней), КоличествоДней, 90) * 24 * 60 * 60;
			
			Выборка = РегистрыСведений.ИсторияХраненияИзмененийЗагружСтатусов.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				Если Выборка.ДатаЗагрузки < ПериодПо Тогда
					
					Запись = Выборка.ПолучитьМенеджерЗаписи();
					Запись.Удалить();
					
				КонецЕсли; 
				
			КонецЦикла; 
			
		ИначеЕсли ТипЗнч(Регистр) = Тип(РегистрыСведений.ВерсииОбъектов) Тогда
			
			Выборка = РегистрыСведений.ВерсииОбъектов.Выбрать(); 
			
			КоличествоДней = Справочники.МТ_ПредопределенныеЗначения.ПолучитьЗначениеПоСвойству(Справочники.МТ_ПредопределенныеЗначения.НастройкиКоличестваДней, "Количество дней хранения данных в регистре версий объектов");
			ПериодПоВерсии = НачалоДня(ТекущаяДата()) - ?(ЗначениеЗаполнено(КоличествоДней), КоличествоДней, 365) * 24 * 60 * 60;
			
			Пока Выборка.Следующий() Цикл
				
				Если Выборка.ДатаВерсии < ПериодПоВерсии Тогда
					
					Запись = Выборка.ПолучитьМенеджерЗаписи();
					Запись.Удалить();
					
				КонецЕсли; 
				
			КонецЦикла;
			
		ИначеЕсли ТипЗнч(Регистр) = Тип(РегистрыСведений.ЗапросыИзмененияКоличестваВЗаказах) Тогда  
			
			КоличествоДней = Справочники.МТ_ПредопределенныеЗначения.ПолучитьЗначениеПоСвойству(Справочники.МТ_ПредопределенныеЗначения.НастройкиКоличестваДней, "Количество дней хранения данных в регистре изменений количества в заказах");
			ПериодПо = ТекущаяДата() - ?(ЗначениеЗаполнено(КоличествоДней), КоличествоДней, 90) * 24 * 60 * 60;
			
			Выборка = РегистрыСведений.ЗапросыИзмененияКоличестваВЗаказах.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				Если Выборка.ДатаЗапроса < ПериодПо Тогда
					
					Запись = Выборка.ПолучитьМенеджерЗаписи();
					Запись.Удалить();
					
				КонецЕсли; 
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Попытка   
		
		Если Справочники.МТ_ПредопределенныеЗначения.НастройкаОчисткиИсходящихСообщений.Список.Количество() = 0 Тогда  
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	ИсходящиеСообщения.Ссылка
			|ИЗ
			|	Справочник.ИсходящиеСообщения КАК ИсходящиеСообщения
			|ГДЕ
			|	ИсходящиеСообщения.ДатаВремяОтправки <= &Дата
			|	И ИсходящиеСообщения.ДатаВремяОтправки >= &Дата1";   
			
			Запрос.УстановитьПараметр("Дата", Дата);
			Запрос.УстановитьПараметр("Дата1", Дата("20100101000000"));
			
			Выб = Запрос.Выполнить().Выбрать();   
			
			Пока Выб.Следующий() Цикл           
				
				Спр = Выб.Ссылка.ПолучитьОбъект();
				Спр.Удалить();                 
				
			КонецЦикла;  
			
		Иначе
			
			// 1. Удаление сообщений по настройкам  
			ТаблицаТипов = Справочники.МТ_ПредопределенныеЗначения.НастройкаОчисткиИсходящихСообщений.Список.Выгрузить(); 
			ТаблицаТипов.Колонки.Добавить("Тип");   
			
			МассивТипов = Новый Массив; 
			МассивСтроковыхТипов = Новый Массив;
			
			сч = 0;
			Пока сч < ТаблицаТипов.Количество() Цикл 
				
				ТекСтрока = ТаблицаТипов.Получить(сч);
				
				ИсключитьСтроку = (Не ЗначениеЗаполнено(ТекСтрока.Свойство)) ИЛИ (Не ТипЗнч(ТекСтрока.Свойство) = Тип("Строка"));
				
				Если ИсключитьСтроку Тогда
					
					ТаблицаТипов.Удалить(ТекСтрока);
					Продолжить;
					
				КонецЕсли; 
				
				ТекСвойство = СокрЛП(ТекСтрока.Свойство);
				
				ЭтоСправочник = Ложь;
				НайденныйОбъектМетаданных = Метаданные.Документы.Найти(ТекСвойство); 
				Если НайденныйОбъектМетаданных = Неопределено Тогда  
					
					ЭтоСправочник = Истина;
					НайденныйОбъектМетаданных = Метаданные.Справочники.Найти(ТекСвойство); 
					
				КонецЕсли; 
				
				Если НайденныйОбъектМетаданных <> Неопределено Тогда 
					
					НайденныйТип = Тип(?(ЭтоСправочник, "СправочникСсылка.", "ДокументСсылка.") + ТекСвойство);
					ТекСтрока.Тип = НайденныйТип; 
					МассивТипов.Добавить(НайденныйТип);
					
				Иначе
					МассивСтроковыхТипов.Добавить(ТекСвойство);
				КонецЕсли;
				
				сч = сч + 1;
				
			КонецЦикла;  
			
			
			ЗапросПоНастройкам = Новый Запрос; 
			ЗапросПоНастройкам.Текст = "";
			
			сч = 0;
			Пока сч < ТаблицаТипов.Количество() Цикл  
				
				СтрокаТаблицы = ТаблицаТипов.Получить(сч); 
				
				Если ЗначениеЗаполнено(СтрокаТаблицы.Тип) Тогда
					
					НовыйБлок = "
					|ВЫБРАТЬ
					|	ИсходящиеСообщения.Ссылка
					|ИЗ
					|	Справочник.ИсходящиеСообщения КАК ИсходящиеСообщения
					|ГДЕ
					|	ТИПЗНАЧЕНИЯ(ИсходящиеСообщения.Объект) = &Тип" + Формат(сч + 1, "ЧГ=0") + "
					|	И ИсходящиеСообщения.ДатаВремяОтправки <= &Дата" + Формат(сч + 1, "ЧГ=0") + "
					|	И ИсходящиеСообщения.ДатаВремяОтправки >= &Дата0
					|
					|ОБЪЕДИНИТЬ ВСЕ
					|";   
					
					ЗапросПоНастройкам.УстановитьПараметр("Тип" + Формат(сч + 1, "ЧГ=0"), СтрокаТаблицы.Тип);
					ЗапросПоНастройкам.УстановитьПараметр("Дата" + Формат(сч + 1, "ЧГ=0"), ТекущаяДата() - СтрокаТаблицы.Значение * 24 * 60 * 60); 
					
				Иначе
					
					НовыйБлок = "
					|ВЫБРАТЬ
					|	ИсходящиеСообщения.Ссылка
					|ИЗ
					|	Справочник.ИсходящиеСообщения КАК ИсходящиеСообщения
					|ГДЕ
					|	ИсходящиеСообщения.Объект = &Свойство" + Формат(сч + 1, "ЧГ=0") + "
					|	И ИсходящиеСообщения.ДатаВремяОтправки <= &Дата" + Формат(сч + 1, "ЧГ=0") + "
					|	И ИсходящиеСообщения.ДатаВремяОтправки >= &Дата0
					|
					|ОБЪЕДИНИТЬ ВСЕ
					|";   
					
					ЗапросПоНастройкам.УстановитьПараметр("Свойство" + Формат(сч + 1, "ЧГ=0"), СтрокаТаблицы.Свойство);
					ЗапросПоНастройкам.УстановитьПараметр("Дата" + Формат(сч + 1, "ЧГ=0"), ТекущаяДата() - СтрокаТаблицы.Значение * 24 * 60 * 60); 
					
				КонецЕсли;  
				
				ЗапросПоНастройкам.УстановитьПараметр("Дата0", Дата("20100101000000"));
				
				ЗапросПоНастройкам.Текст = ЗапросПоНастройкам.Текст + НовыйБлок;
				
				сч = сч + 1;
				
			КонецЦикла;
			
			ЗапросПоНастройкам.Текст = Лев(ЗапросПоНастройкам.Текст, СтрДлина(ЗапросПоНастройкам.Текст) - 16);
			
			ВыборкаПоНастройкам = ЗапросПоНастройкам.Выполнить().Выбрать(); 
			
			Пока ВыборкаПоНастройкам.Следующий() Цикл
				
				Спр = ВыборкаПоНастройкам.Ссылка.ПолучитьОбъект();
				Спр.Удалить();                 
				
			КонецЦикла;
			
			
			// 2. Удаление сообщений по общим правилами  
			
			Запрос = Новый Запрос; 
			Запрос.Текст = "
			|ВЫБРАТЬ
			|	ИсходящиеСообщения.Ссылка
			|ИЗ
			|	Справочник.ИсходящиеСообщения КАК ИсходящиеСообщения
			|ГДЕ
			|	НЕ ТИПЗНАЧЕНИЯ(ИсходящиеСообщения.Объект) В (&МассивТипов) 
			|	И НЕ ИсходящиеСообщения.Объект В (&МассивСтроковыхТипов)
			|	И ИсходящиеСообщения.ДатаВремяОтправки <= &Дата
			|	И ИсходящиеСообщения.ДатаВремяОтправки >= &Дата0";
			
			
