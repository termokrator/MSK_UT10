	//+Сёмин Р.И. 24.06.2026 #UT10-5914
	ОбработатьСтарыеВходящиеСообщения(ДобавитьМесяц(ТекущаяДата(), -1));
	//-Сёмин Р.И. 24.06.2026 #UT10-5914
	
