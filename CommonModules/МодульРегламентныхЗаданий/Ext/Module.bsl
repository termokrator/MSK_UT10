Функция ЗапуститьОбработкуСообщения(ВФоне = Истина, ТипСообщения, ТолькоСообщенияСОшибкой = Ложь) Экспорт
	
	МассивПотоков = ПолучитьМассивПотоков(ТипСообщения); 
	
	Если МассивПотоков.Количество() = 0 Тогда
		Возврат Неопределено;			
	КонецЕсли;
	
	Если ВФоне Тогда 
		
		Для каждого СтруктураПотока Из МассивПотоков Цикл
			
			ИмяЗадания = "Запуск обработки сообщений с типом '" + Строка(СтруктураПотока.ТипСообщения) + "' Поток №" + Строка(СтруктураПотока.КодПотока) + ?(ТолькоСообщенияСОшибкой, "_errors", "");
			
			Если ЕстьЗапущенноеФоновоеЗадание(ИмяЗадания, Истина, 3600) Тогда
				Продолжить;	
			КонецЕсли; 
			
			УникальныйИдентификатор = Новый УникальныйИдентификатор;
			
		    ПараметрыВыполнения = Новый Массив;  
			ПараметрыВыполнения.Добавить(СтруктураПотока.МассивИмен);
			ПараметрыВыполнения.Добавить(СтруктураПотока.ТипСообщения);
			ПараметрыВыполнения.Добавить(ТолькоСообщенияСОшибкой);
			
			//+Гавриленков В. 14.07.2026 #UT10-5952
			//ФоновыеЗадания.Выполнить("МодульРегламентныхЗаданий.ОбработатьВходящиеСообщения", ПараметрыВыполнения, УникальныйИдентификатор);
			ФоновыеЗадания.Выполнить("МодульРегламентныхЗаданий.ОбработатьВходящиеСообщения", ПараметрыВыполнения, УникальныйИдентификатор, ИмяЗадания);
			//-Гавриленков В. 14.07.2026 #UT10-5952

		КонецЦикла;
		
	Иначе    
	
		Для каждого СтруктураПотока Из МассивПотоков Цикл
			ОбработатьВходящиеСообщения(СтруктураПотока.МассивИмен, СтруктураПотока.ТипСообщения, ТолькоСообщенияСОшибкой);
		КонецЦикла;
		
	КонецЕсли;
		
КонецФункции 

Функция ЕстьЗапущенноеФоновоеЗадание(ИмяЗадания, ЗавершатьЗависшие = Ложь, МаксимальноеВремяВыполнения = 3600) Экспорт
	
	Задания = ФоновыеЗадания.ПолучитьФоновыеЗадания(Новый Структура("Состояние", СостояниеФоновогоЗадания.Активно));
	
	ЕстьЗадание = Ложь;
	
	Для каждого Задание Из Задания Цикл
		
		Если Найти(Задание.Наименование, ИмяЗадания) > 0 Тогда
			
			ЕстьЗадание = Истина;	
			
			Если ЗавершатьЗависшие И (ТекущаяДата() - Задание.Начало) > МаксимальноеВремяВыполнения Тогда   
				
				ТекстЗаписиВЖурнал = "Отменено фоновое задание: " + Задание.Наименование + " начало: " + Формат(Задание.Начало, "ДЛФ=DT");  
				
				Задание.Отменить();			
				
				ЗаписьЖурналаРегистрации("Фоновое задание.Отмена", УровеньЖурналаРегистрации.Информация,,, ТекстЗаписиВЖурнал);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;     
	
	Возврат ЕстьЗадание;
	
КонецФункции     

Функция ЗапуститьОбработкуСообщений() Экспорт
	
	ЗапуститьОбработкуСообщения(Истина, Перечисления.Р_ТипыВходящихСообщений.Документ);
	
КонецФункции  

Процедура ОбработатьВходящиеСообщения(СписокИменМетаданных, ТипСообщения, ТолькоСообщенияСОшибкой) Экспорт
	
	Таблица = ПолучитьНеОбработанныеСообщения(ТипСообщения, СписокИменМетаданных, ТолькоСообщенияСОшибкой); 
	
	ЗаблокироватьРазблокироватьСообщения(Таблица);   
	
	СтрокаИменМетаданных = "";
	
	Для каждого ИмяМетаданных Из СписокИменМетаданных Цикл
		СтрокаИменМетаданных = СтрокаИменМетаданных + ?(ЗначениеЗаполнено(СтрокаИменМетаданных), ", ", "") + ИмяМетаданных;	
	КонецЦикла;
	
	ЗаписьЖурналаРегистрации("Обработка входящих сообщений.Начало", УровеньЖурналаРегистрации.Информация,,, "Получено: " + Строка(Таблица.Количество()) + " сообщений для обработки с типом сообщения '" + Строка(ТипСообщения) + "'" + Символы.ПС + "Имена метаданных: " + СтрокаИменМетаданных);
	
	УспешноОбработано = 0;
	СОшибкойОбработано = 0;
	
	Для каждого Строка Из Таблица Цикл
		
		Сообщение = Строка.Сообщение;
		СообщениеОб = Сообщение.ПолучитьОбъект();                       
		
		ИмяОчереди = Сообщение.Подписка.ИмяОчереди;  
		
		Попытка
			
			Если ТипСообщения = Перечисления.Р_ТипыВходящихСообщений.Документ Тогда
				
				ЭтоОчередьПоМаркировке = Маркировка.ЭтоОчередьПоМаркировке(ИмяОчереди);    
				
				Если ЭтоОчередьПоМаркировке Тогда  
					
					Отказ = ЛОЖЬ;    
					МСК.ОбработатьСообщениеJSON(Сообщение, Отказ);
					Продолжить;          
					
				КонецЕсли;  
				
				Если МСК.ЭтоОчередьПрайсПМ(ИмяОчереди) Тогда 
					
					Отказ = Ложь;   
					МСК.ОбработатьСообщениеJSON(Сообщение, Отказ); 
					
				//+Белов А. 14.09.2026 #UT10-6038
				ИначеЕсли МСК.ЭтоОчередьУТ10ВУТ10(ИмяОчереди) Тогда
					
					Отказ = Ложь;     
					МСК.ОбработатьСообщениеJSON(Сообщение, Отказ); 
				//-Белов А. 14.09.2026 #UT10-6038  				
				Иначе	
				
					Отказ = Ложь;      
					ТекстСообщения = Сообщение.Данные;
					ЭтоСообщениеJSON = Найти(ТекстСообщения, "/json");    
					
					Если ЭтоСообщениеJSON Тогда
						МСК.ОбработатьСообщениеJSON(Сообщение, Отказ);   
					Иначе
						МСК.ОбработатьСообщениеИзОчереди(ИмяОчереди, Сообщение.Данные, Отказ, Сообщение.КоличествоПопытокПовторнойОбработки);    
					КонецЕсли;

				КонецЕсли;
				
			КонецЕсли;		

		Исключение  
						
			ТекстОшибки = ОписаниеОшибки();    		
			
			Если СообщениеОб.ОбработаноСОшибкой Тогда
				СообщениеОб.КоличествоПопытокПовторнойОбработки = СообщениеОб.КоличествоПопытокПовторнойОбработки + 1;				
			КонецЕсли;
			
			СообщениеОб.ОбработаноСОшибкой = Истина; 
			СообщениеОб.ТекстОшибки = ТекстОшибки;	
			СообщениеОб.Записать();
			
			СОшибкойОбработано = СОшибкойОбработано + 1;
			
			ЗаписьЖурналаРегистрации("Обработка входящих сообщений.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, "Возникла ошибка при обработке сообщения: " + СообщениеОб.Код + Символы.ПС + ТекстОшибки);
			
		КонецПопытки;

	КонецЦикла; 
	
	ЗаписьЖурналаРегистрации("Обработка входящих сообщений.Окончание", УровеньЖурналаРегистрации.Информация,,, "Обработано успешно: " + Строка(УспешноОбработано) + ", с ошибкой: " + Строка(СОшибкойОбработано));
	
	ЗаблокироватьРазблокироватьСообщения(Таблица, Ложь);
	
КонецПроцедуры

Процедура УдалитьСтарыеВходящиеСообщения() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1000
	|	Р_ВходящиеСообщения.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Р_ВходящиеСообщения КАК Р_ВходящиеСообщения
	|ГДЕ
	|	Р_ВходящиеСообщения.Дата < &Дата
	|
	|УПОРЯДОЧИТЬ ПО
	|	Р_ВходящиеСообщения.Дата,
	|	Р_ВходящиеСообщения.НомерПоПорядку";
	
	Запрос.УстановитьПараметр("Дата", ТекущаяДата() - Константы.AMQP_КоличествоДнейХраненияСообщений.Получить() * 86400);  
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Об = Выборка.Ссылка.ПолучитьОбъект();
		Об.Удалить();
		
	КонецЦикла;	
	
КонецПроцедуры

Функция ПолучитьНеОбработанныеСообщения(ТипСообщения, СписокИменМетаданных, ТолькоСообщенияСОшибкой) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 10000
	|	Р_ВходящиеСообщения.Ссылка КАК Сообщение,
	|	Р_ВходящиеСообщения.КоличествоПопытокПовторнойОбработки КАК КоличествоПопытокПовторнойОбработки
	|ИЗ
	|	Справочник.Р_ВходящиеСообщения КАК Р_ВходящиеСообщения
	|ГДЕ
	|	НЕ Р_ВходящиеСообщения.Обработано
	|	И НЕ Р_ВходящиеСообщения.ПометкаУдаления
	|	И Р_ВходящиеСообщения.ТипСообщения = &ТипСообщения
	|	И ВЫБОР
	|			КОГДА &ТолькоСообщенияСОшибкой
	|				ТОГДА Р_ВходящиеСообщения.ОбработаноСОшибкой
	|						И Р_ВходящиеСообщения.КоличествоПопытокПовторнойОбработки < 5
	|			ИНАЧЕ НЕ Р_ВходящиеСообщения.ОбработаноСОшибкой
	|		КОНЕЦ
	|	И Р_ВходящиеСообщения.ИмяОбъектаМетаданных В(&СписокИменМетаданных)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Р_ВходящиеСообщения.Дата,
	|	Р_ВходящиеСообщения.НомерПоПорядку";
	
	Запрос.УстановитьПараметр("ТипСообщения", ТипСообщения);
	Запрос.УстановитьПараметр("СписокИменМетаданных", СписокИменМетаданных);
	Запрос.УстановитьПараметр("ТолькоСообщенияСОшибкой", ТолькоСообщенияСОшибкой);
	
	Результат = Запрос.Выполнить().Выгрузить();  
	
	СтрокиУдаления = Новый Массив;
	
	Для каждого Стр Из Результат Цикл
		
		Если Стр.Сообщение.ПолучитьОбъект().Заблокирован() Тогда
			СтрокиУдаления.Добавить(Стр);	
		КонецЕсли;
		
	КонецЦикла; 
	
	Для каждого СтрУдаления Из СтрокиУдаления Цикл
		Результат.Удалить(СтрУдаления);	
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьМассивПотоков(ТипСообщения)
	
	Потоки = Новый Массив;
	
	ИмяСправочника = "AMQP_СправочникиЗагрузки"; 
	ИмяРеквизита = "ИмяСправочника"; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Р_ОбъектыЗагрузки.ИмяСправочника КАК ИмяОбъектаМетаданных
	|ИЗ
	|	Справочник.AMQP_СправочникиЗагрузки КАК Р_ОбъектыЗагрузки
	|ГДЕ
	|	Р_ОбъектыЗагрузки.Загружать";
	
	ВыборкаИмениОбъекта = Запрос.Выполнить().Выбрать();
	
	СтруктураПотока = Новый Структура;
	СтруктураПотока.Вставить("ТипСообщения", ТипСообщения);
	
	МассивИмен = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ИмяОбъектаМетаданных");
	
	СтруктураПотока.Вставить("МассивИмен", МассивИмен);   
	СтруктураПотока.Вставить("КодПотока", 1);
	
	Потоки.Добавить(СтруктураПотока);
	
	Возврат Потоки;
	
КонецФункции

Процедура ЗаблокироватьРазблокироватьСообщения(ТаблицаСообщений, Заблокировать = Истина)
	
	Для каждого Строка Из ТаблицаСообщений Цикл  
		
		Сообщение = Строка.Сообщение;
		СообщениеОб = Сообщение.ПолучитьОбъект(); 
		
		Если Заблокировать Тогда
			СообщениеОб.Заблокировать();  
		Иначе
			СообщениеОб.Разблокировать();	
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьИдентификаторДляРегистраДокументыЭДОТребующиеОбработки(МинИдентификатор)
	
	//+Сёмин Р.И. 15.07.2026 #UT10-5945
	НовыйИдентификатор = МинИдентификатор;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕСТЬNULL(МАКСИМУМ(ДокументыЭДОТребующиеОбработки.Идентификатор), &Идентификатор) КАК Идентификатор
		|ИЗ
		|	РегистрСведений.ДокументыЭДОТребующиеОбработки КАК ДокументыЭДОТребующиеОбработки
		|ГДЕ
		|	ДокументыЭДОТребующиеОбработки.Идентификатор >= &Идентификатор";
	
	Запрос.УстановитьПараметр("Идентификатор", МинИдентификатор);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НовыйИдентификатор = ВыборкаДетальныеЗаписи.Идентификатор + 1;
	КонецЦикла;
	
	Возврат НовыйИдентификатор;
	//-Сёмин Р.И. 15.07.2026 #UT10-5945
	
КонецФункции

Функция ДобавитьДокументВРегистрДокументыЭДОТребующиеОбработки(Документ)
	
	//+Сёмин Р.И. 15.07.2026 #UT10-5945
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДокументыЭДОТребующиеОбработки.Документ
		|ИЗ
		|	РегистрСведений.ДокументыЭДОТребующиеОбработки КАК ДокументыЭДОТребующиеОбработки
		|ГДЕ
		|	ДокументыЭДОТребующиеОбработки.Документ = &Документ
		|	И ДокументыЭДОТребующиеОбработки.Отработан";
	
	Запрос.УстановитьПараметр("Документ", Документ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Пустой();
	//-Сёмин Р.И. 15.07.2026 #UT10-5945
	
КонецФункции
