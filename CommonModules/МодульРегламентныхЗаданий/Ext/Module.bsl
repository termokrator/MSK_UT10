Процедура ОбновлениеОстатковИЦен_Казань() Экспорт 
	
	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда 
		ЗаписьЖурналаРегистрации("Обновление остатков и цен Казань", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Отменена работа регламентного задания из-за несоответствия параметров подключения к ИБ");
		Возврат;
	КонецЕсли;
	
	ИмяКаталогаСервера = "";
	ИмяFTPСервера = Константы.FTPВыгрузкаОстатковАдрес2.Получить();	
	
	ЗаданаПапкаДляFTP = СокрЛП(Константы.FTPВыгрузкаОстатковКаталог1.Получить());
	ИмяКаталогаСервера = ИмяКаталогаСервера + ?(ЗначениеЗаполнено(ЗаданаПапкаДляFTP), ""+ЗаданаПапкаДляFTP + "/", "");
	
	Попытка
		Соединение = Новый FTPСоединение(ИмяFTPСервера, "21", Константы.FTPВыгрузкаОстатковЛогин2.Получить(),  Константы.FTPВыгрузкаОстатковПароль2.Получить(), , Истина);
	Исключение
		
		ЗаписьЖурналаРегистрации("Не удалось установить соединение с FTP. Запись данных на FTP не выполнена.");
		Возврат;
		
	КонецПопытки;
	
	Отказ = Ложь;
	
	МассивНайденныхФайловНаСервере = Соединение.НайтиФайлы(ИмяКаталогаСервера + "daemon.lock");	
	
	Для Каждого ТекСтр Из МассивНайденныхФайловНаСервере Цикл
		
		Если ВРег(ТекСтр.Имя) = ВРег("daemon.locK") Тогда
			
			Отказ = Истина;
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;	
	
	Если Отказ Тогда
		
		ЗаписьЖурналаРегистрации("Запись данных на FTP НЕ СОСТОЯЛАСЬ из-за БЛОКИРОВКИ");
