Процедура ТоварыБезЦенДляГоловногоФилиала() Экспорт 

	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда 
		
		ЗаписьЖурналаРегистрации("Товары без цен для головного филиала", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Отменена работа регламентного задания из-за несоответствия параметров подключения в ИБ");
		Возврат;
		
	КонецЕсли;
	
	//Заполненние соответствия типов цен и колонок
	СписокТиповЦен = Новый СписокЗначений; 
	
	Если ЗначениеЗаполнено(Константы.БазоваяЦена.Получить()) Тогда 
		СписокТиповЦен.Добавить(Константы.БазоваяЦена.Получить()); 
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Константы.Скидка35.Получить()) Тогда 
		СписокТиповЦен.Добавить(Константы.Скидка35.Получить()); 
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Константы.Скидка36.Получить()) Тогда 
		СписокТиповЦен.Добавить(Константы.Скидка36.Получить()); 
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Константы.Скидка37.Получить()) Тогда 
		СписокТиповЦен.Добавить(Константы.Скидка37.Получить()); 
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Константы.Скидка38.Получить()) Тогда 
		СписокТиповЦен.Добавить(Константы.Скидка38.Получить()); 
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Константы.СпецЦена.Получить()) Тогда 
		СписокТиповЦен.Добавить(Константы.СпецЦена.Получить()); 
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Константы.Акция.Получить()) Тогда 
		СписокТиповЦен.Добавить(Константы.Акция.Получить()); 
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Константы.Резерв4.Получить()) Тогда 
		СписокТиповЦен.Добавить(Константы.Резерв4.Получить()); 
	КонецЕсли;
	
	Если НЕ СписокТиповЦен.Количество() = 0 Тогда
		
		ЗапросТоваровБезЦен = Новый Запрос;
		ЗапросТоваровБезЦен.Текст =
		"ВЫБРАТЬ
		|	ТипыЦенНоменклатуры.Ссылка КАК ТипЦены
		|ПОМЕСТИТЬ ВТ_СписокТиповЦен
		|ИЗ
		|	Справочник.ТипыЦенНоменклатуры КАК ТипыЦенНоменклатуры
		|ГДЕ
		|	ТипыЦенНоменклатуры.Ссылка В(&СписокТиповЦен)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
		|	ТоварыНаСкладахОстатки.КоличествоОстаток - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0) КАК СвободныйОстатокНаСкладах
		|ПОМЕСТИТЬ ВТ_НеНулевыеОстаткиНаСкладах
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Остатки(
		|			,
		|			Склад = &Склад
		|				И НЕ Номенклатура.КодМДМ = """") КАК ТоварыНаСкладахОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(, Склад = &Склад) КАК ТоварыВРезервеНаСкладахОстатки
		|		ПО ТоварыНаСкладахОстатки.Номенклатура = ТоварыВРезервеНаСкладахОстатки.Номенклатура
		|			И ТоварыНаСкладахОстатки.Склад = ТоварыВРезервеНаСкладахОстатки.Склад
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_НеНулевыеОстаткиНаСкладах.Номенклатура КАК Номенклатура,
		|	ВЫБОР
		|		КОГДА ВТ_НеНулевыеОстаткиНаСкладах.СвободныйОстатокНаСкладах <= ТоварыВЯчейкахОстатки.КоличествоОстаток - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0) + ЕСТЬNULL(ТоварыВСборкеОстатки.СобраноОстаток, 0) + ЕСТЬNULL(ТоварыВСборкеОстатки.КСборкеОстаток, 0)
		|			ТОГДА ВТ_НеНулевыеОстаткиНаСкладах.СвободныйОстатокНаСкладах
		|		ИНАЧЕ ЕСТЬNULL(ТоварыВЯчейкахОстатки.КоличествоОстаток, 0) - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0) + ЕСТЬNULL(ТоварыВСборкеОстатки.СобраноОстаток, 0) + ЕСТЬNULL(ТоварыВСборкеОстатки.КСборкеОстаток, 0)
		|	КОНЕЦ КАК СвободныйОстаток
		|ПОМЕСТИТЬ ВТ_СвободныеОстатки
		|ИЗ
		|	ВТ_НеНулевыеОстаткиНаСкладах КАК ВТ_НеНулевыеОстаткиНаСкладах
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(, Склад = &Склад) КАК ТоварыВРезервеНаСкладахОстатки
		|		ПО ВТ_НеНулевыеОстаткиНаСкладах.Номенклатура = ТоварыВРезервеНаСкладахОстатки.Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВСборке.Остатки(, ) КАК ТоварыВСборкеОстатки
		|		ПО ВТ_НеНулевыеОстаткиНаСкладах.Номенклатура = ТоварыВСборкеОстатки.Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках.Остатки(, Склад = &Склад) КАК ТоварыВЯчейкахОстатки
		|		ПО ВТ_НеНулевыеОстаткиНаСкладах.Номенклатура = ТоварыВЯчейкахОстатки.Номенклатура
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_СвободныеОстатки.Номенклатура
		|ПОМЕСТИТЬ ВТ_ТоварыСОстатком
		|ИЗ
		|	ВТ_СвободныеОстатки КАК ВТ_СвободныеОстатки
		|ГДЕ
		|	ВТ_СвободныеОстатки.СвободныйОстаток > 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура,
		|	ЦеныНоменклатурыСрезПоследних.Цена
		|ПОМЕСТИТЬ ВТ_ТоварыССебестоимостью
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
		|			,
		|			Номенклатура В
		|					(ВЫБРАТЬ
		|						ВТ_ТоварыСОстатком.Номенклатура
		|					ИЗ
		|						ВТ_ТоварыСОстатком)
		|				И ТипЦен = &Себестоимость) КАК ЦеныНоменклатурыСрезПоследних
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ТоварыССебестоимостью.Номенклатура КАК Номенклатура,
		|	ВТ_ТоварыССебестоимостью.Цена КАК Себестоимость
		|ПОМЕСТИТЬ ВТ_Товары
		|ИЗ
		|	ВТ_ТоварыССебестоимостью КАК ВТ_ТоварыССебестоимостью
		|ГДЕ
		|	НЕ ВТ_ТоварыССебестоимостью.Цена = 0
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_Товары.Номенклатура КАК Номенклатура,
		|	ВТ_СписокТиповЦен.ТипЦены КАК ТипЦены
		|ПОМЕСТИТЬ ВТ_ТоварыСТипамиЦен
		|ИЗ
		|	ВТ_Товары КАК ВТ_Товары,
		|	ВТ_СписокТиповЦен КАК ВТ_СписокТиповЦен
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура,
		|	ЦеныНоменклатурыСрезПоследних.ТипЦен,
		|	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена
		|ПОМЕСТИТЬ ВТ_ЦеныНоменклатуры
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
		|			,
		|			Номенклатура В
		|					(ВЫБРАТЬ
		|						ВТ_Товары.Номенклатура
		|					ИЗ
		|						ВТ_Товары)
		|				И ТипЦен В
		|					(ВЫБРАТЬ
		|						ВТ_СписокТиповЦен.ТипЦены
		|					ИЗ
		|						ВТ_СписокТиповЦен)) КАК ЦеныНоменклатурыСрезПоследних
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_ТоварыСТипамиЦен.Номенклатура КАК Номенклатура,
		|	ВТ_ТоварыСТипамиЦен.ТипЦены КАК ТипЦены,
		|	ВТ_ЦеныНоменклатуры.Цена
		|ПОМЕСТИТЬ ВТ_ПромИтог
		|ИЗ
		|	ВТ_ТоварыСТипамиЦен КАК ВТ_ТоварыСТипамиЦен
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЦеныНоменклатуры КАК ВТ_ЦеныНоменклатуры
		|		ПО ВТ_ТоварыСТипамиЦен.Номенклатура = ВТ_ЦеныНоменклатуры.Номенклатура
		|			И ВТ_ТоварыСТипамиЦен.ТипЦены = ВТ_ЦеныНоменклатуры.ТипЦен
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура,
		|	ТипЦены
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_ПромИтог.Номенклатура КАК Номенклатура
		|ПОМЕСТИТЬ ВТ_Итог
		|ИЗ
		|	ВТ_ПромИтог КАК ВТ_ПромИтог
		|ГДЕ
		|	ВТ_ПромИтог.Цена ЕСТЬ NULL
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ Первые 1000 
		|	ВТ_Итог.Номенклатура.КодМДМ КАК НоменклатураКодМДМ,
		|	ВТ_Товары.Себестоимость
		|ИЗ
		|	ВТ_Итог КАК ВТ_Итог
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Товары КАК ВТ_Товары
		|		ПО ВТ_Итог.Номенклатура = ВТ_Товары.Номенклатура";
		
		ЗапросТоваровБезЦен.УстановитьПараметр("Себестоимость"  , Константы.ЦенаСебестоимость.Получить());
		ЗапросТоваровБезЦен.УстановитьПараметр("Склад"          , Константы.ОсновнойСклад.Получить());
		ЗапросТоваровБезЦен.УстановитьПараметр("СписокТиповЦен" , СписокТиповЦен);
		
		РезультатЗапросаТоваровБезЦен = ЗапросТоваровБезЦен.Выполнить();
		
		Если НЕ РезультатЗапросаТоваровБезЦен.Пустой() Тогда
			
			Товары = РезультатЗапросаТоваровБезЦен.Выгрузить();
			
			НовоеСообщение = Справочники.ИсходящиеСообщения.СоздатьЭлемент();
			НовоеСообщение.ОбменДанными.Загрузка = Истина;
			НовоеСообщение.ДатаВремяСобытия = ТекущаяДата();
			НовоеСообщение.Объект = "ТоварыБезЦенДляГоловногоФилиала";
			НовоеСообщение.ТочкаПубликации = Константы.AMQP_Exchange.Получить();
			
			ID = Новый УникальныйИдентификатор();     	
			НовоеСообщение.УстановитьСсылкуНового(Справочники.ИсходящиеСообщения.ПолучитьСсылку(ID));
			
			СтруктураДокумента = Новый Структура;
			
			СтруктураДокумента.Вставить("ВидДокумента"   , "ТоварыБезЦенДляГоловногоФилиала");
			СтруктураДокумента.Вставить("ТипСодержимого" , "application/json");
			СтруктураДокумента.Вставить("ДатаВыгрузки"   , Формат(ТекущаяДата(), "ДЛФ=DT"));
			СтруктураДокумента.Вставить("ИмяБазы"        , СокрЛП(Константы.База.Получить())); 
			СтруктураДокумента.Вставить("Товары"         , МодульРегламентныхЗаданий.ТаблицуВМассив(Товары));
			
			ЗаписьJSON = Новый ЗаписьJSON();
			ПараметрыЗаписиJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет , , Истина);
			ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписиJSON);
			ЗаписатьJSON(ЗаписьJSON, СтруктураДокумента);
			JsonСтрока = ЗаписьJSON.Закрыть();   
			
			НовоеСообщение.Сообщение = JsonСтрока;	
			
			ЗаголовкиСообщения = Новый СписокЗначений;
			ЗаголовкиСообщения.Добавить("document_type" , "ТоварыБезЦенДляГоловногоФилиала");
			ЗаголовкиСообщения.Добавить("content_type"  , "application/json");
			ЗаголовкиСообщения.Добавить("base_name"     , Константы.База.Получить());
			
			Свойства = Новый СписокЗначений;
			Свойства.Добавить("ТипСодержимого" , "application/json"); 
			Свойства.Добавить("ОтметкаВремени" , AMQP_РаботаСДокументами.ДатуВTimestamp(НовоеСообщение.ДатаВремяСобытия));   	
			Свойства.Добавить("Тип"            , "status"); 
			Свойства.Добавить("ИмяПриложения"  , Константы.AMQP_ИдентификаторИнформацСистемы.Получить());
			Свойства.Добавить("РежимДоставки"  , 2);
			Свойства.Добавить("НомерСообщения" , Строка(ID));
			
			Для Каждого Свойство Из Свойства Цикл
				
				НоваяСтрока              = НовоеСообщение.Свойства.Добавить();
				НоваяСтрока.Наименование = Свойство.Значение;
				НоваяСтрока.Значение    = Свойство.Представление;
				
			КонецЦикла;   	
			
			Если ЗначениеЗаполнено(ЗаголовкиСообщения) Тогда
				
				Для Каждого Заголовок Из ЗаголовкиСообщения Цикл
					
					НоваяСтрока              = НовоеСообщение.Заголовки.Добавить();
					НоваяСтрока.Наименование = Заголовок.Значение;
					НоваяСтрока.Значение     = Заголовок.Представление;
					
				КонецЦикла;   
				
			КонецЕсли;      
			
			НовоеСообщение.Записать();
			
		Иначе
			
			ЗаписьЖурналаРегистрации("Товары без цен для головного филиала", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Отстутствуют товары с незаполненными ценами");
			Возврат;
			
		КонецЕсли;
		
	Иначе
		
		ЗаписьЖурналаРегистрации("Товары без цен для головного филиала", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Не заполнены константы типы цен");
		Возврат;
		
	КонецЕсли;	
	
КонецПроцедуры

Процедура КонтрольСроковВозвратов() Экспорт
	
	СрокДействияЗаявкиНаВозврат = Константы.СрокДействияЗаявкиНаВозврат.Получить(); 
	КоличествоДнейВозврата = Константы.КоличествоДнейВозврата.Получить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаявкаНаВозвратТовары.Ссылка,
	|	МАКСИМУМ(ЗаявкаНаВозвратТовары.Ссылка.Реализация.ДоговорКонтрагента.СрокВозврата) КАК СрокВозврата,
	|	ЗаявкаНаВозвратТовары.Ссылка.Реализация.Дата
	|ИЗ
	|	Документ.ЗаявкаНаВозврат.Товары КАК ЗаявкаНаВозвратТовары
	|ГДЕ
	|	ЗаявкаНаВозвратТовары.Ссылка.Проведен
	|	И ЗаявкаНаВозвратТовары.Тип = ""Возврат""
	|	И ЗаявкаНаВозвратТовары.Ссылка.Дата >= &Дата
	|	И ЗаявкаНаВозвратТовары.Ссылка.Статус В(&МассивСтатусов)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаявкаНаВозвратТовары.Ссылка,
	|	ЗаявкаНаВозвратТовары.Ссылка.Реализация.Дата";
	
	Запрос.УстановитьПараметр("Дата", ДобавитьМесяц(ТекущаяДата(), -6)); 
	
	МассивСтатусов = Новый Массив; 
	МассивСтатусов.Добавить("На согласовании");
	МассивСтатусов.Добавить("Согласован");
	МассивСтатусов.Добавить("На доставке");  
	
	Запрос.УстановитьПараметр("МассивСтатусов", МассивСтатусов);
	
	Выборка = Запрос.Выполнить().Выбрать(); 
	
	Пока Выборка.Следующий() Цикл
		
		СрокВозврата = Выборка.СрокВозврата;
		
		Если Не ЗначениеЗаполнено(СрокВозврата) Тогда
			СрокВозврата = КоличествоДнейВозврата;	
		КонецЕсли;                                     
		
		Если Не ЗначениеЗаполнено(СрокВозврата) Тогда
			Продолжить;
		КонецЕсли;   
		
		ИтоговыйСрок = СрокВозврата + СрокДействияЗаявкиНаВозврат; 
		
		ДатаСравнения = Выборка.РеализацияДата + 86400*ИтоговыйСрок;
		
		Если ТекущаяДата() > ДатаСравнения Тогда
			
			ЗаявкаОб = Выборка.Ссылка.ПолучитьОбъект();
			ЗаявкаОб.Статус = "Отказ в возврате";  
			ЗаявкаОб.Комментарий = "Истек период для возврата" + ?(ЗначениеЗаполнено(ЗаявкаОб.Комментарий), ". " + ЗаявкаОб.Комментарий, "");
			
			Для каждого Стр Из ЗаявкаОб.Товары Цикл
				
				Стр.Статус = "Отказ в возврате"; 
				Стр.Комментарий = "Истек период для возврата" + ?(ЗначениеЗаполнено(Стр.Комментарий), ". " + Стр.Комментарий, "");
				
			КонецЦикла;                                                                                                             
			
			ЗаявкаОб.Записать();
			
		КонецЕсли;		
		
	КонецЦикла;             	
	
КонецПроцедуры

Процедура ПроверкаПоДублямЧеков() Экспорт
	
	ДатаПроверки = НачалоДня(ТекущаяДата());
	
	Чеки.ПроверитьНаДублиВПределахДня(ДатаПроверки);
	
КонецПроцедуры

Процедура ЗакрытиеРегистраТоварыГотовыеКСборке() Экспорт 

	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда 
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТоварыГотовыеКСборкеОстатки.ЗаказПокупателя КАК ЗаказПокупателя,
	|	ТоварыГотовыеКСборкеОстатки.Номенклатура КАК Номенклатура,
	|	ТоварыГотовыеКСборкеОстатки.КоличествоОстаток
	|ПОМЕСТИТЬ ВТ_ТоварыВСборке
	|ИЗ
	|	РегистрНакопления.ТоварыГотовыеКСборке.Остатки(, ) КАК ТоварыГотовыеКСборкеОстатки
	|ГДЕ
	|	ТоварыГотовыеКСборкеОстатки.КоличествоОстаток > 0
	|	И НЕ ТоварыГотовыеКСборкеОстатки.ЗаказПокупателя = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_ТоварыВСборке.ЗаказПокупателя КАК ЗаказПокупателя
	|ПОМЕСТИТЬ ВТ_ЗаказыПокупателя
	|ИЗ
	|	ВТ_ТоварыВСборке КАК ВТ_ТоварыВСборке
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(, ) КАК ТоварыВРезервеНаСкладахОстатки
	|		ПО ВТ_ТоварыВСборке.ЗаказПокупателя = ТоварыВРезервеНаСкладахОстатки.ДокументРезерва
	|			И ВТ_ТоварыВСборке.Номенклатура = ТоварыВРезервеНаСкладахОстатки.Номенклатура
	|ГДЕ
	|	НЕ ВТ_ТоварыВСборке.КоличествоОстаток = ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаказыПокупателей.Регистратор КАК КорректировкаЗаказаПокупателя
	|ИЗ
	|	РегистрНакопления.ЗаказыПокупателей КАК ЗаказыПокупателей
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ЗаказыПокупателя КАК ВТ_ЗаказыПокупателя
	|		ПО ЗаказыПокупателей.ЗаказПокупателя = ВТ_ЗаказыПокупателя.ЗаказПокупателя
	|ГДЕ
	|	ЗаказыПокупателей.Регистратор ССЫЛКА Документ.КорректировкаЗаказаПокупателя";
	
    Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		КорректировкаОбъект = Выборка.КорректировкаЗаказаПокупателя.ПолучитьОбъект();
		
		Попытка
			КорректировкаОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение  
			#Если Клиент Тогда
				Сообщить("Ошибка при проведении документа " + Строка(Выборка.КорректировкаЗаказаПокупателя) + ". " + Символы.ПС + ОписаниеОшибки());
			#КонецЕсли
		КонецПопытки;
		
	КонецЦикла
	
КонецПроцедуры

Процедура СозданиеКорПТУНаОсновеКорРТУВСтороннейБазе() Экспорт

	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда 
		Возврат;
	КонецЕсли; 
	
	ЗаписьЖурналаРегистрации("Регламентное : Создание КорПТУ на основе КорРТУ в сторонней базе", УровеньЖурналаРегистрации.Информация, , ,"Запуск");

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СобственныеСклады.Ссылка
	|ИЗ
	|	Справочник.СобственныеСклады КАК СобственныеСклады
	|ГДЕ
	|	НЕ СобственныеСклады.ПометкаУдаления
	|	И СобственныеСклады.ИсключитьИзОбщегоЭкспресса
	|	И СобственныеСклады.Поставщик.ИНН <> &ИНН";  
	
	Запрос.УстановитьПараметр("ИНН", Константы.ОсновнаяОрганизация.Получить().ИНН);
	
	КоличествоДней = Константы.ЧислоДнейДляСозданияКорПТУ.Получить();
	
	Выборка = Запрос.Выполнить().Выбрать();  
	
	Пока Выборка.Следующий() Цикл   
		
		СобственныйСклад = Выборка.Ссылка;
		
		//+Гавриленков В. 19.05.2026 #UT10-5868
		Если ЗначениеЗаполнено(Выборка.Ссылка.ВебСервис) Тогда
			
			ТаблицаАдресов =  МСКWEB.ПолучитьАдресаСервиса(Выборка.Ссылка.ВебСервис);
			
			Если ТаблицаАдресов.Количество() = 0 Тогда
				
				ЗаписьЖурналаРегистрации("Регламентное : Создание КорПТУ на основе КорРТУ в сторонней базе", УровеньЖурналаРегистрации.Ошибка,,, "Не установлены веб-сервисы для склада " + Строка(Выборка.Ссылка));
				Продолжить;
				
			Иначе
				
				ОтветПолучен = Ложь;
				
				Для Каждого СтрокаАдрес Из ТаблицаАдресов Цикл
					
					Если ОтветПолучен Тогда
						Прервать;
					КонецЕсли;
					
					СоздатьКорректировку(СобственныйСклад, СтрокаАдрес.АдресСервиса, КоличествоДней, ОтветПолучен);
					
				КонецЦикла; 
				
				Если Не ОтветПолучен Тогда
					ЗаписьЖурналаРегистрации("Регламентное : Создание КорПТУ на основе КорРТУ в сторонней базе", УровеньЖурналаРегистрации.Ошибка,,, "Склад " + Строка(Выборка.Ссылка) + ". Нет ответа ни по одному адресу.");
				КонецЕсли;	
									
			КонецЕсли;
		//-Гавриленков В. 19.05.2026 #UT10-5868
			
		Иначе // алгоритм без изменений
			
			АдресВебСервиса = "http://" + СобственныйСклад.АдресВебСервиса + "/ws/GoodsReserve.1cws?wsdl";
			
			Попытка
				ВСОпределение = Новый WSОпределения(АдресВебСервиса, , ,, 30);	
			Исключение
				
				ЗаписьЖурналаРегистрации("Регламентное : Создание КорПТУ на основе КорРТУ в сторонней базе", УровеньЖурналаРегистрации.Ошибка,,, "Получена ошибка при создании объекта веб сервиса: " + ОписаниеОшибки());
				Продолжить;
				
			КонецПопытки;
			
			ВСПрокси = Новый WSПрокси(ВСОпределение, "Data", "GoodsReserve", "GoodsReserveSoap");    
			
			Парам = Новый Структура;
			Парам.Вставить("ДатаНачала", НачалоДня(ТекущаяДата()) - 86400*КоличествоДней);
			Парам.Вставить("КодМДМГрузополучателя", СобственныйСклад.КодКонтрагента);
			Парам.Вставить("КодМДМДоговора", СобственныйСклад.КодДоговора);
			
			Ответ = ВСПрокси.ПолучитьКорректировки(МСКWEB.ДанныеВJSONХранилище(Парам)); 
			
			ОтветСтруктура = МСКWEB.ХранилищеJSONВСтруктуру(Ответ);
			
			Если ОтветСтруктура.Результат Тогда
				
				Для каждого Документ Из ОтветСтруктура.Данные Цикл
					
					Попытка
						
						СтруктураВозврата = Документы.КорректировкаПоступления.СоздатьКорректировкуПТУ(Документ);
						
						Если СтруктураВозврата.Результат Тогда
							ВСПрокси.КорректировкаЗагружена(Документ.ГУИД); 	
						Иначе
							ЗаписьЖурналаРегистрации("Регламентное : Создание КорПТУ на основе КорРТУ в сторонней базе", УровеньЖурналаРегистрации.Ошибка,,, "Получена ошибка при создании корректировки: " + СтруктураВозврата.Сообщение);
						КонецЕсли;
						
					Исключение
						ЗаписьЖурналаРегистрации("Регламентное : Создание КорПТУ на основе КорРТУ в сторонней базе", УровеньЖурналаРегистрации.Ошибка,,, "Получена ошибка при создании корректировки: " + ОписаниеОшибки());
					КонецПопытки;
					
				КонецЦикла;
				
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЦикла;   
	
	ЗаписьЖурналаРегистрации("Регламентное : Создание КорПТУ на основе КорРТУ в сторонней базе", УровеньЖурналаРегистрации.Информация, , ,"Окончание");

КонецПроцедуры

Процедура СоздатьКорректировку(СобственныйСклад, Адрес, КоличествоДней, ОтветПолучен = Ложь)
//+Гавриленков В. 19.05.2026 #UT10-5868
	
	АдресВебСервиса = "http://" + Адрес + "/ws/GoodsReserve.1cws?wsdl";
	
	Попытка
		ВСОпределение = Новый WSОпределения(АдресВебСервиса, , ,, 30);	
	Исключение
		
		ЗаписьЖурналаРегистрации("Регламентное : Создание КорПТУ на основе КорРТУ в сторонней базе", УровеньЖурналаРегистрации.Ошибка,,, "Получена ошибка при создании объекта веб сервиса: " + ОписаниеОшибки());
		Возврат;
		
	КонецПопытки;
	
	ВСПрокси = Новый WSПрокси(ВСОпределение, "Data", "GoodsReserve", "GoodsReserveSoap");    
	
	Парам = Новый Структура;
	Парам.Вставить("ДатаНачала", НачалоДня(ТекущаяДата()) - 86400*КоличествоДней);
	Парам.Вставить("КодМДМГрузополучателя", СобственныйСклад.КодКонтрагента);
	Парам.Вставить("КодМДМДоговора", СобственныйСклад.КодДоговора);
	
	Попытка
		
		Ответ = ВСПрокси.ПолучитьКорректировки(МСКWEB.ДанныеВJSONХранилище(Парам));
		ОтветПолучен = Истина;
		
	Исключение
		
		ОтветПолучен = Ложь;
		Возврат;
		
	КонецПопытки;
	
	ОтветСтруктура = МСКWEB.ХранилищеJSONВСтруктуру(Ответ);
	
	Если ОтветСтруктура.Результат Тогда
		
		Для каждого Документ Из ОтветСтруктура.Данные Цикл
			
			Попытка
				
				СтруктураВозврата = Документы.КорректировкаПоступления.СоздатьКорректировкуПТУ(Документ);
				
				Если СтруктураВозврата.Результат Тогда
					ВСПрокси.КорректировкаЗагружена(Документ.ГУИД); 	
				Иначе
					ЗаписьЖурналаРегистрации("Регламентное : Создание КорПТУ на основе КорРТУ в сторонней базе", УровеньЖурналаРегистрации.Ошибка,,, "Получена ошибка при создании корректировки: " + СтруктураВозврата.Сообщение);
				КонецЕсли;
				
			Исключение
				ЗаписьЖурналаРегистрации("Регламентное : Создание КорПТУ на основе КорРТУ в сторонней базе", УровеньЖурналаРегистрации.Ошибка,,, "Получена ошибка при создании корректировки: " + ОписаниеОшибки());
			КонецПопытки;
			
		КонецЦикла;
		
	КонецЕсли;	
	
//-Гавриленков В. 19.05.2026 #UT10-5868	
КонецПроцедуры

Процедура СверкаКорректировокПоступленийИРеализаций() Экспорт
//+Гавриленков В. 30.01.2026 #UT10-5671	

	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда 
		Возврат;
	КонецЕсли; 
	
	ЗаписьЖурналаРегистрации("Сверка КорПТУ с КорРТУ в сторонней базе", УровеньЖурналаРегистрации.Информация, , ,"Запуск");  
	
	// Если нет адреса получателя, то выполнять сверку нет смысла
	Получатель = Справочники.МТ_ПредопределенныеЗначения.ПолучитьЗначениеПоСвойству(Справочники.МТ_ПредопределенныеЗначения.Рассылки, "Адрес для оповещения о расхождениях корректировок ПТУ и РТУ"); 
	Если Получатель = Неопределено Тогда  
		ЗаписьЖурналаРегистрации("Сверка КорПТУ с КорРТУ в сторонней базе", УровеньЖурналаРегистрации.Предупреждение,,, "Нет получателя сообщения. Завершение");
		Возврат;
	КонецЕсли;    
	
	УчетнаяЗапись = Константы.ОсновнаяУчетнаяЗаписьЭлектроннойПочты.Получить();
	
	Если  Константы.НеОтправлятьПочту.Получить() ИЛИ НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		Возврат;
	КонецЕсли;
	
	НачалоПериода = ДобавитьМесяц(НачалоДня(ТекущаяДата()), -1);
	
	ИДСтороннихБаз = Новый ТаблицаЗначений;
	ИДСтороннихБаз.Колонки.Добавить("ИДДокументаВСмежнойБазе", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(36)));
	ИДСтороннихБаз.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.СобственныеСклады"));

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СобственныеСклады.Ссылка
	|ИЗ
	|	Справочник.СобственныеСклады КАК СобственныеСклады
	|ГДЕ
	|	НЕ СобственныеСклады.ПометкаУдаления
	|	И СобственныеСклады.ИсключитьИзОбщегоЭкспресса
	|	И СобственныеСклады.Поставщик.ИНН <> &ИНН";  
	
	Запрос.УстановитьПараметр("ИНН", Константы.ОсновнаяОрганизация.Получить().ИНН);
	
	КоличествоДней = Константы.ЧислоДнейДляСозданияКорПТУ.Получить();
	
	Выборка = Запрос.Выполнить().Выбрать();	 
	
	Пока Выборка.Следующий() Цикл                     
		
		СобственныйСклад = Выборка.Ссылка;
		
		//+Гавриленков В. 19.05.2026 #UT10-5868
		Если ЗначениеЗаполнено(Выборка.Ссылка.ВебСервис) Тогда
			
			ТаблицаАдресов =  МСКWEB.ПолучитьАдресаСервиса(Выборка.Ссылка.ВебСервис);
			
			Если ТаблицаАдресов.Количество() = 0 Тогда
				
				ЗаписьЖурналаРегистрации("Сверка КорПТУ с КорРТУ в сторонней базе", УровеньЖурналаРегистрации.Ошибка,,, "Не установлены веб-сервисы для склада " + Строка(Выборка.Ссылка));
				Продолжить;
				
			Иначе
				
				ОтветПолучен = Ложь;
				
				Для Каждого СтрокаАдрес Из ТаблицаАдресов Цикл
					
					Если ОтветПолучен Тогда
						Прервать;
					КонецЕсли;
					
					ВыполнитьСверку(СобственныйСклад, СтрокаАдрес.АдресСервиса, НачалоПериода, ИДСтороннихБаз, ОтветПолучен);
					
				КонецЦикла; 
				
				Если Не ОтветПолучен Тогда
					ЗаписьЖурналаРегистрации("Сверка КорПТУ с КорРТУ в сторонней базе", УровеньЖурналаРегистрации.Ошибка,,, "Склад " + Строка(Выборка.Ссылка) + ". Нет ответа ни по одному адресу.");
				КонецЕсли;	
									
			КонецЕсли;
		//-Гавриленков В. 19.05.2026 #UT10-5868	
			
		Иначе // Алгоритм без изменений
			
			АдресВебСервиса = "http://" + СобственныйСклад.АдресВебСервиса + "/ws/GoodsReserve.1cws?wsdl";
			
			Попытка
				ВСОпределение = Новый WSОпределения(АдресВебСервиса, , ,, 30);	
			Исключение
				
				ЗаписьЖурналаРегистрации("Сверка КорПТУ с КорРТУ в сторонней базе", УровеньЖурналаРегистрации.Ошибка,,, "Получена ошибка при создании объекта веб сервиса: " + ОписаниеОшибки());
				Продолжить;
				
			КонецПопытки;
			
			ВСПрокси = Новый WSПрокси(ВСОпределение, "Data", "GoodsReserve", "GoodsReserveSoap");    
			
			Парам = Новый Структура;
			Парам.Вставить("ДатаНачала", НачалоПериода);
			Парам.Вставить("КодМДМГрузополучателя", СобственныйСклад.КодКонтрагента);
			Парам.Вставить("КодМДМДоговора", СобственныйСклад.КодДоговора);
			Парам.Вставить("ВсеДокументы", Истина);
			
			Ответ = ВСПрокси.ПолучитьКорректировки(МСКWEB.ДанныеВJSONХранилище(Парам)); 
			
			ОтветСтруктура = МСКWEB.ХранилищеJSONВСтруктуру(Ответ);
			
			Если ОтветСтруктура.Результат Тогда 			
				
				Для каждого Документ Из ОтветСтруктура.Данные Цикл 
					
					Если Не ЗначениеЗаполнено(Документ.ГУИД) Тогда
						Продолжить;
					КонецЕсли;
					
					НовСтрока =	ИДСтороннихБаз.Добавить();
					НовСтрока.ИДДокументаВСмежнойБазе = Документ.ГУИД;
					НовСтрока.Склад = СобственныйСклад;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;  
	
	Если ИДСтороннихБаз.Количество() > 0 Тогда   
		
		ТекстСообщения = "";
		
		ЗапросСверка = Новый Запрос;
		ЗапросСверка.Текст = 
		"ВЫБРАТЬ
		|	Таблица.ИДДокументаВСмежнойБазе КАК ИДДокументаВСмежнойБазе,
		|	Таблица.Склад КАК Склад
		|ПОМЕСТИТЬ ВТ_ГуидыСтороннихБаз
		|ИЗ
		|	&Таблица КАК Таблица
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КорректировкаПоступления.ИДДокументаВСмежнойБазе
		|ПОМЕСТИТЬ ВТ_ЗагруженныеИД
		|ИЗ
		|	Документ.КорректировкаПоступления КАК КорректировкаПоступления
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ГуидыСтороннихБаз КАК ВТ_ГуидыСтороннихБаз
		|		ПО КорректировкаПоступления.ИДДокументаВСмежнойБазе = ВТ_ГуидыСтороннихБаз.ИДДокументаВСмежнойБазе
		|ГДЕ
		|	КорректировкаПоступления.Проведен
		|	И КорректировкаПоступления.Дата > &ДатаНач
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ГуидыСтороннихБаз.Склад КАК Склад,
		|	ВТ_ГуидыСтороннихБаз.ИДДокументаВСмежнойБазе
		|ИЗ
		|	ВТ_ГуидыСтороннихБаз КАК ВТ_ГуидыСтороннихБаз
		|ГДЕ
		|	НЕ ВТ_ГуидыСтороннихБаз.ИДДокументаВСмежнойБазе В
		|				(ВЫБРАТЬ
		|					Таб.ИДДокументаВСмежнойБазе
		|				ИЗ
		|					ВТ_ЗагруженныеИД КАК Таб)
		|ИТОГИ ПО
		|	Склад";
		
		ЗапросСверка.УстановитьПараметр("ДатаНач", НачалоПериода);
		ЗапросСверка.УстановитьПараметр("Таблица", ИДСтороннихБаз); 
		
		ВыборкаСклад = ЗапросСверка.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
		
		Пока ВыборкаСклад.Следующий() Цикл 
			
			ТекстСообщения = ТекстСообщения + "По складу " + Строка(ВыборкаСклад.Склад) + ": " + Символы.ПС;
			
			Выборка = ВыборкаСклад.Выбрать();
			
			Пока Выборка.Следующий() Цикл 
				ТекстСообщения = ТекстСообщения + "ID (ГУИД Корректирвки реализации): "  + Выборка.ИДДокументаВСмежнойБазе + Символы.ПС;	
			КонецЦикла;    
			
			ТекстСообщения = ТекстСообщения + Символы.ПС;
			
		КонецЦикла; 
		
		Если ЗначениеЗаполнено(ТекстСообщения) Тогда  

			ТекстСообщения = "Обнаружены незагруженные Корректировки поступлений: " + Символы.ПС + Символы.ПС + ТекстСообщения;
			
			Профиль = УправлениеЭлектроннойПочтой.ПолучитьИнтернетПочтовыйПрофиль(УчетнаяЗапись);
			
			Сообщение = Новый ИнтернетПочтовоеСообщение;
			Сообщение.Тема = "Расхождения при сверке корректировок ПТУ и РТУ";
						
			МассивАдресов = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(Получатель, ";");
			
			Почта = Новый ИнтернетПочта; 
			
			Попытка
				Почта.Подключиться(Профиль);
			Исключение
				
				ЗаписьЖурналаРегистрации("Отправка электронной почты.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, "Не удалось подключиться к почтовому серверу. " 
				+ Символы.ПС + ОписаниеОшибки());
				Возврат; 
				
			КонецПопытки;
			
			Для каждого ТекАдрес Из МассивАдресов Цикл
				Сообщение.Получатели.Добавить(ТекАдрес); 
			КонецЦикла;
			
			Сообщение.Отправитель = УчетнаяЗапись.АдресЭлектроннойПочты;
			
			Сообщение.Тексты.Добавить(ТекстСообщения, ТипТекстаПочтовогоСообщения.ПростойТекст);
			
			Попытка
				
				Почта.Послать(Сообщение);
				ЗаписьЖурналаРегистрации("Отправка электронной почты.Успешно", УровеньЖурналаРегистрации.Информация,,, Сообщение); 
				
			Исключение
				
				ЗаписьЖурналаРегистрации("Отправка электронной почты.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, "Не отправлено письмо на адрес " 
				+ МассивАдресов[0] + Символы.ПС + ОписаниеОшибки());
				
			Конецпопытки;
			
			Сообщение.Получатели.Очистить();
			Сообщение.Вложения.Очистить();
			Почта.Отключиться();
			
		КонецЕсли;
		
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации("Сверка КорПТУ с КорРТУ в сторонней базе", УровеньЖурналаРегистрации.Информация, , ,"Окончание");

