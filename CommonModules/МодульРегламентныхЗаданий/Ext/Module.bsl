Процедура ВыполнитьСверку(СобственныйСклад, Адрес, НачалоПериода, ИДСтороннихБаз, ОтветПолучен)
//+Гавриленков В. 19.05.2026 #UT10-5868
	
	АдресВебСервиса = "http://" + Адрес + "/ws/GoodsReserve.1cws?wsdl";
	
	Попытка
		ВСОпределение = Новый WSОпределения(АдресВебСервиса, , ,, 30);	
	Исключение
		
		ЗаписьЖурналаРегистрации("Сверка КорПТУ с КорРТУ в сторонней базе", УровеньЖурналаРегистрации.Ошибка,,, "Получена ошибка при создании объекта веб сервиса: " + ОписаниеОшибки());
		Возврат;
		
	КонецПопытки;
	
	ВСПрокси = Новый WSПрокси(ВСОпределение, "Data", "GoodsReserve", "GoodsReserveSoap");    
	
	Парам = Новый Структура;
	Парам.Вставить("ДатаНачала", НачалоПериода);
	Парам.Вставить("КодМДМГрузополучателя", СобственныйСклад.КодКонтрагента);
	Парам.Вставить("КодМДМДоговора", СобственныйСклад.КодДоговора);
	Парам.Вставить("ВсеДокументы", Истина);
	
	Попытка
		
		Ответ = ВСПрокси.ПолучитьКорректировки(МСКWEB.ДанныеВJSONХранилище(Парам));
		ОтветПолучен = Истина;
		
	Исключение
		
		ОтветПолучен = Ложь;
		Возврат;
		
	КонецПопытки;
	
	ОтветСтруктура = МСКWEB.ХранилищеJSONВСтруктуру(Ответ);
	
	Если ОтветСтруктура.Результат Тогда 			
		
		Для каждого Документ Из ОтветСтруктура.Данные Цикл 
			
			Если Не ЗначениеЗаполнено(Документ.ГУИД) Тогда
				Продолжить;
			КонецЕсли;
			
			НовСтрока =	ИДСтороннихБаз.Добавить();
			НовСтрока.ИДДокументаВСмежнойБазе = Документ.ГУИД;
			НовСтрока.Склад = СобственныйСклад;
			
		КонецЦикла;
		
	КонецЕсли;	
	
//-Гавриленков В. 19.05.2026 #UT10-5868
КонецПроцедуры

Функция ПолучитьТаблицуGTINНоменклатур()
	
	GTINНоменклатур = Новый ТаблицаЗначений;
	GTINНоменклатур.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	GTINНоменклатур.Колонки.Добавить("GTIN", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(1000)));
	
	ЗапросGTIN = Новый Запрос;
	ЗапросGTIN.Текст = 
		"ВЫБРАТЬ
		|	ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура,
		|	СпрGTIN.GTIN
		|ИЗ
		|	Справочник.GTIN КАК СпрGTIN
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
		|				,
		|				Номенклатура.ТоварнаяГруппаЧестногоЗнака.ОтображатьВПрайсЛистах
		|					И ТипЦен = &ТипЦен) КАК ЦеныНоменклатурыСрезПоследних
		|		ПО СпрGTIN.Владелец = ЦеныНоменклатурыСрезПоследних.Номенклатура
		|ГДЕ
		|	НЕ СпрGTIN.ПометкаУдаления
		|ИТОГИ ПО
		|	Номенклатура";
	
	ЗапросGTIN.УстановитьПараметр("ТипЦен", Константы.Скидка38.Получить());
	
	РезультатЗапросаGTIN = ЗапросGTIN.Выполнить();
	
	ВыборкаНоменклатура = РезультатЗапросаGTIN.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаНоменклатура.Следующий() Цикл
		
		НовСтр = GTINНоменклатур.Добавить();
		НовСтр.Номенклатура = ВыборкаНоменклатура.Номенклатура;
	
		ВыборкаДетальныеЗаписи = ВыборкаНоменклатура.Выбрать();
	
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Если ЗначениеЗаполнено(НовСтр.GTIN) Тогда
				НовСтр.GTIN = НовСтр.GTIN + ";";
			КонецЕсли;
			
			НовСтр.GTIN = НовСтр.GTIN + СокрЛП(ВыборкаДетальныеЗаписи.GTIN);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат GTINНоменклатур;
	
КонецФункции

Функция ПолучитьТаблицуСертификатыНоменклатуры()
	
	//+Макрушин Е. 03.09.2026 #UT11-6041
	СертификатыНоменклатуры = Новый ТаблицаЗначений;
	СертификатыНоменклатуры.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	СертификатыНоменклатуры.Колонки.Добавить("СсылкаНаРеестрСертификатов", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(1000)));
	
	Запрос = Новый Запрос;
	// в запросе сделано не через виртуальную таблицу среза, т.к. по физической таблице отрабатывает быстрее буквально в 100 раз
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЦеныНоменклатуры.Номенклатура
		|ПОМЕСТИТЬ ВТ_Номенклатура
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры КАК ЦеныНоменклатуры
		|ГДЕ
		|	НЕ ЦеныНоменклатуры.Номенклатура.Артикул = """"""""
		|	И ЦеныНоменклатуры.ТипЦен = &ТипЦен
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОбластиДействияСертификатовНоменклатуры.Номенклатура КАК Номенклатура,
		|	ВЫБОР
		|		КОГДА ОбластиДействияСертификатовНоменклатуры.СертификатНоменклатуры.ТипСертификата = ""Не подлежит обязательной сертификации""
		|			ТОГДА ""NSMC""
		|		ИНАЧЕ ОбластиДействияСертификатовНоменклатуры.СертификатНоменклатуры.СсылкаНаРеестрСертификатов
		|	КОНЕЦ КАК СсылкаНаРеестрСертификатов
		|ИЗ
		|	ВТ_Номенклатура КАК ВТ_Номенклатура
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОбластиДействияСертификатовНоменклатуры КАК ОбластиДействияСертификатовНоменклатуры
		|		ПО ВТ_Номенклатура.Номенклатура = ОбластиДействияСертификатовНоменклатуры.Номенклатура
		|ГДЕ
		|	НЕ ОбластиДействияСертификатовНоменклатуры.СертификатНоменклатуры.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Номенклатура,
		|	ОбластиДействияСертификатовНоменклатуры.СертификатНоменклатуры.ДатаНачалаСрокаДействия
		|ИТОГИ ПО
		|	Номенклатура
		|АВТОУПОРЯДОЧИВАНИЕ";
	
    Запрос.УстановитьПараметр("ТипЦен", Константы.Скидка38.Получить());
	
	РезультатЗапросаПакет = Запрос.ВыполнитьПакет();
	РезультатЗапроса = РезультатЗапросаПакет[1];
	
	ВыборкаНоменклатура = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаНоменклатура.Следующий() Цикл
		
		НовСтр = СертификатыНоменклатуры.Добавить();
		НовСтр.Номенклатура = ВыборкаНоменклатура.Номенклатура;
	
		ВыборкаДетальныеЗаписи = ВыборкаНоменклатура.Выбрать();
	
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Если ЗначениеЗаполнено(НовСтр.СсылкаНаРеестрСертификатов) Тогда
				НовСтр.СсылкаНаРеестрСертификатов = НовСтр.СсылкаНаРеестрСертификатов + ";";
			КонецЕсли;
			
			НовСтр.СсылкаНаРеестрСертификатов = НовСтр.СсылкаНаРеестрСертификатов + СокрЛП(ВыборкаДетальныеЗаписи.СсылкаНаРеестрСертификатов);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат СертификатыНоменклатуры;
	//-Макрушин Е. 03.09.2026 #UT11-6041
	
КонецФункции

Процедура ОбработкаОчередиЗагрузкиСсылокS3() Экспорт
//+Белов А. 13.03.2026 #UT10-5722
	
	// 1. Выбираем записи, которые еще не обработаны и количество попыток < 3
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |   ОчередьЗагрузкиСсылокS3.Идентификатор КАК Идентификатор,
        |   ОчередьЗагрузкиСсылокS3.Ссылка КАК СсылкаS3,
        |   ОчередьЗагрузкиСсылокS3.Документ КАК Документ,
        |   ОчередьЗагрузкиСсылокS3.КоличествоПопыток КАК КоличествоПопыток
        |ИЗ
        |   РегистрСведений.ОчередьЗагрузкиСсылокS3 КАК ОчередьЗагрузкиСсылокS3
        |ГДЕ
        |   ОчередьЗагрузкиСсылокS3.Обработано = ЛОЖЬ
        |   И ОчередьЗагрузкиСсылокS3.КоличествоПопыток < 3";
        
    РезультатЗапроса = Запрос.Выполнить();
    Выборка = РезультатЗапроса.Выбрать();
    
    Пока Выборка.Следующий() Цикл
        
        ТекстОшибкиСкачивания = "";
        СсылкаНаСозданныйФайл = Неопределено;
        
        // 2. Пытаемся скачать файл из S3 в хранилище 1С
        Попытка
            СсылкаНаСозданныйФайл = СкачатьФайлИзS3ВХранилище(
                Выборка.СсылкаS3, 
                Выборка.Документ
            );
        Исключение
            ТекстОшибкиСкачивания = ОписаниеОшибки();
            СсылкаНаСозданныйФайл = Неопределено;
        КонецПопытки;
        
        // 3. Обновляем статус записи в регистре сведений с помощью Менеджера Записи
        МенеджерЗаписи = РегистрыСведений.ОчередьЗагрузкиСсылокS3.СоздатьМенеджерЗаписи();
        МенеджерЗаписи.Идентификатор = Выборка.Идентификатор;
        
        // Читаем текущее состояние записи из базы
        МенеджерЗаписи.Прочитать();
        
        Если МенеджерЗаписи.Выбран() Тогда
            
            // Записываем дату обработки в любом случае
            МенеджерЗаписи.ДатаОбработки = ТекущаяДата();
            
            Если СсылкаНаСозданныйФайл <> Неопределено Тогда
                // УСПЕШНАЯ ЗАГРУЗКА
                МенеджерЗаписи.Обработано = Истина;
                МенеджерЗаписи.Файл = СсылкаНаСозданныйФайл;
                МенеджерЗаписи.ТекстОшибки = ""; // Очищаем текст ошибки, если были прошлые неудачные попытки
                
            Иначе
                // ОШИБКА ЗАГРУЗКИ
                МенеджерЗаписи.КоличествоПопыток = Выборка.КоличествоПопыток + 1;
                
                Если Не ПустаяСтрока(ТекстОшибкиСкачивания) Тогда
                    МенеджерЗаписи.ТекстОшибки = ТекстОшибкиСкачивания;
                Иначе
                    МенеджерЗаписи.ТекстОшибки = "Не удалось скачать файл. Функция вернула Неопределено (проверьте URL или доступ к S3).";
                КонецЕсли;
                
            КонецЕсли;
            
            // Фиксируем изменения в регистре
            МенеджерЗаписи.Записать();
            
        КонецЕсли;
        
	КонецЦикла;
	
//-Белов А. 13.03.2026 #UT10-5722
КонецПроцедуры

Функция СкачатьФайлИзS3ВХранилище(Знач СсылкаНаФайлS3, Знач ОбъектВладелец) Экспорт
	
	ИмяФайла = ПолучитьИмяФайлаИзURL(СсылкаНаФайлS3); 
	
	Защищенное = Найти(СсылкаНаФайлS3, "https://") > 0;
	
	 // Очищаем протокол для извлечения адреса сервера и пути
	УРЛ = СтрЗаменить(СсылкаНаФайлS3, "https://", "");
	УРЛ = СтрЗаменить(УРЛ, "http://", "");
	
	ПозицияПервогоСлеша = Найти(УРЛ, "/");
	Если ПозицияПервогоСлеша = 0 Тогда
		
		Сообщить("Некорректная ссылка S3");
	    Возврат Неопределено;
		
	КонецЕсли;
	
	Сервер = Лев(УРЛ, ПозицияПервогоСлеша - 1);
	
	Если Не Защищенное Тогда
		Сервер = "http://" + Сервер;	
	КонецЕсли;
	
	ПутьКОбъекту = Сред(УРЛ, ПозицияПервогоСлеша + 1); 
	
	Бакет = Лев(ПутьКОбъекту, Найти(ПутьКОбъекту, "/") - 1); 
    AccessKey = Константы.S3ВыгрузкаЦенЛогин.Получить();
    SecretKey = Константы.S3ВыгрузкаЦенПароль.Получить();
    Region    = "BTC";

    ОсновныеДанные = OPI_S3.ПолучитьСтруктуруДанных(Сервер, AccessKey, SecretKey, Region); 
	
	ВременныйФайл = ПолучитьИмяВременногоФайла(); 
	СсылкаНаСозданныйФайл = Неопределено;
	
	Попытка
			
		// Получение двоичных данных
		Результат = OPI_S3.ПолучитьОбъект(ИмяФайла, Бакет, ОсновныеДанные, , , ВременныйФайл, Истина);
		
		// Читаем файл в двоичные данные для помещения в базу
		ДвоичныеДанные = Новый ДвоичныеДанные(Результат);
		
		// Создаем элемент справочника ХранилищеДополнительнойИнформации
		НовыйФайл = Справочники.ХранилищеДополнительнойИнформации.СоздатьЭлемент();
		НовыйФайл.Наименование = ИмяФайла;
		НовыйФайл.ИмяФайла     = ИмяФайла;
		НовыйФайл.Объект       = ОбъектВладелец;
		НовыйФайл.ВидДанных    = Перечисления.ВидыДополнительнойИнформацииОбъектов.Файл;
		
		Если Справочники.ОбъектыСВнешнимФайловымХранением.ПрименимоКОбъекту(ОбъектВладелец) Тогда
			
			КаталогФайлов = Константы.ТомХраненияФайлов.Получить();
			РасширениеФайла = РаботаСФайлами.ПолучитьРасширениеФайла(ИмяФайла);
			НовоеИмяФайла = Формат(ТекущаяДата(), "ДФ=yyyyMMdd") + "\" + СтрЗаменить(ИмяФайла,"." + РасширениеФайла,"") + "_" + Строка(Новый УникальныйИдентификатор()) + "." + РасширениеФайла;
			ПолныйПутьКФайлу = РаботаСФайлами.ПолучитьИмяФайла(КаталогФайлов,НовоеИмяФайла);
			ДвоичныеДанные.Записать(ПолныйПутьКФайлу);                                      		
			
			Если РаботаСФайлами.СжатьИзображениеНаДиске(ПолныйПутьКФайлу) = Ложь Тогда
				//ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось выполнить сжатие изображения");
			КонецЕсли;
			
			НовыйФайл.ПутьКФайлу = НовоеИмяФайла; 
			НовыйФайл.Хранилище = Неопределено;
		
		Иначе
			// Сохраняем двоичные данные с максимальным сжатием (9)
			НовыйФайл.Хранилище = Новый ХранилищеЗначения(ДвоичныеДанные, Новый СжатиеДанных(9));  		
		КонецЕсли;
		
		НовыйФайл.Записать();
		СсылкаНаСозданныйФайл = НовыйФайл.Ссылка; 
		
		// Блок очистки: удаляем временный файл в любом случае (успех или ошибка)
		Попытка
			УдалитьФайлы(ВременныйФайл);
		Исключение
		КонецПопытки;
		
	Исключение
		Сообщить("Возникла ошибка при загрузке: " + ОписаниеОшибки());
	КонецПопытки;			
    
    Возврат СсылкаНаСозданныйФайл;
	    
КонецФункции

Функция ПолучитьИмяФайлаИзURL(Знач СсылкаS3) Экспорт
    
    // 1. Отсекаем GET-параметры (всё, что идет после символа "?")
    ПозицияВопроса = Найти(СсылкаS3, "?");
    Если ПозицияВопроса > 0 Тогда
        ПутьДоФайла = Лев(СсылкаS3, ПозицияВопроса - 1);
    Иначе
        ПутьДоФайла = СсылкаS3;
    КонецЕсли;
    
    // 2. Ищем последний слеш "/", чтобы забрать только само имя файла
    ПозицияСлеша = Найти(ПутьДоФайла, "/");
    Пока ПозицияСлеша > 0 Цикл
        ПутьДоФайла = Сред(ПутьДоФайла, ПозицияСлеша + 1);
        ПозицияСлеша = Найти(ПутьДоФайла, "/");
    КонецЦикла;
    
    ИмяФайла = ПутьДоФайла;
    
    // 3. Декодируем URL кириллицу и спецсимволы через COM-объект (обход ограничения 8.2)
	ИмяФайла = РаскодироватьСтроку(ИмяФайла, СпособКодированияСтроки.URLВКодировкеURL, "UTF-8");
        
    Возврат ИмяФайла;
    
КонецФункции 

Процедура ВыгрузкаСтатусовЗаказовЗаПериод() Экспорт
	
	//+Сёмин Р.И. 04.03.2026 #UT10-5727
	ИмяРегламента = "Выгрузка статусов заказов за период";
	
	ЗаписьЖурналаРегистрации(ИмяРегламента, УровеньЖурналаРегистрации.Информация, , ,"Запуск");
	ВыполнитьЗадание = Истина;
	
	РегламентВыгрузкиСтатусовЗаказовДатаНачала = Константы.РегламентВыгрузкиСтатусовЗаказовДатаНачала.Получить();
	РегламентВыгрузкиСтатусовЗаказовДатаОкончания = Константы.РегламентВыгрузкиСтатусовЗаказовДатаОкончания.Получить();
	
	КоличествоЗаказовВСутки = Константы.РегламентВыгрузкиСтатусовЗаказовКоличествоВСутки.Получить();
	ТекущееКоличествоЗаказовВСутки = 0;
	
	КоличествоЗаказовВПорции = 20;
	ТекущееКоличествоЗаказовВПорции = 0;
	
	ЗадержкаПоВремени = 30;
	
	ПоследнийОбработанныйЗаказ = Документы.ЗаказПокупателя.ПустаяСсылка();
	
	Если НЕ ЗначениеЗаполнено(РегламентВыгрузкиСтатусовЗаказовДатаНачала) Тогда
		
		ОбщегоНазначения.СообщитьИнформациюПользователю("Необходимо заполнить константу ""Регламент выгрузки статусов заказов дата начала""");
		ЗаписьЖурналаРегистрации(ИмяРегламента, УровеньЖурналаРегистрации.Ошибка, , ,"Не заполнена константа ""Регламент выгрузки статусов заказов дата начала""");
		ВыполнитьЗадание = Ложь;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(РегламентВыгрузкиСтатусовЗаказовДатаОкончания) Тогда
		
		ОбщегоНазначения.СообщитьИнформациюПользователю("Необходимо заполнить константу ""Регламент выгрузки статусов заказов дата окончания""");
		ЗаписьЖурналаРегистрации(ИмяРегламента, УровеньЖурналаРегистрации.Ошибка, , ,"Не заполнена константа ""Регламент выгрузки статусов заказов дата окончания""");
		ВыполнитьЗадание = Ложь;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(КоличествоЗаказовВСутки) Тогда
		
		ОбщегоНазначения.СообщитьИнформациюПользователю("Необходимо заполнить константу ""Регламент выгрузки статусов заказов количество за сутки""");
		ЗаписьЖурналаРегистрации(ИмяРегламента, УровеньЖурналаРегистрации.Ошибка, , ,"Не заполнена константа ""Регламент выгрузки статусов количество за сутки""");
		ВыполнитьЗадание = Ложь;
		
	КонецЕсли;
	
	Если НЕ ВыполнитьЗадание Тогда
		Возврат;
	КонецЕсли;
	
	
	ЗапросПодготовительный = Новый Запрос;
	ЗапросПодготовительный.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	РегламентВыгрузкиСтатусовЗаказов.ЗаказПокупателя КАК ЗаказПокупателя
		|ИЗ
		|	РегистрСведений.РегламентВыгрузкиСтатусовЗаказов КАК РегламентВыгрузкиСтатусовЗаказов";
	
	РезультатЗапросаПодготовительный = ЗапросПодготовительный.Выполнить();
	
	Если РезультатЗапросаПодготовительный.Пустой() Тогда
		ПоследнийВыгруженныйЗаказВПрошлыйЗапуск = Документы.ЗаказПокупателя.ПустаяСсылка();
	Иначе
		
		ВыборкаДетальныеЗаписи = РезультатЗапросаПодготовительный.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий();
		
		ПоследнийВыгруженныйЗаказВПрошлыйЗапуск = ВыборкаДетальныеЗаписи.ЗаказПокупателя;
	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 100
		|	ЗаказПокуп.Ссылка КАК ЗаказПокупателя
		|ИЗ
		|	Документ.ЗаказПокупателя КАК ЗаказПокуп
		|ГДЕ
		|	ЗаказПокуп.Дата МЕЖДУ &ДатаНач И &ДатаКон
		|	И ЗаказПокуп.Проведен
		|	И ЗаказПокуп.Ссылка <> &ПоследнийВыгруженныйЗаказВПрошлыйЗапуск
		|	И ЗаказПокуп.Дата >= &ДатаПоследнегоВыгруженногоЗаказа
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЗаказПокуп.Дата";
	
	Запрос.УстановитьПараметр("ДатаНач", РегламентВыгрузкиСтатусовЗаказовДатаНачала);
	Запрос.УстановитьПараметр("ДатаКон", КонецДня(РегламентВыгрузкиСтатусовЗаказовДатаОкончания));
	Запрос.УстановитьПараметр("ПоследнийВыгруженныйЗаказВПрошлыйЗапуск", ПоследнийВыгруженныйЗаказВПрошлыйЗапуск);
	Запрос.УстановитьПараметр("ДатаПоследнегоВыгруженногоЗаказа", ПоследнийВыгруженныйЗаказВПрошлыйЗапуск.Дата);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВЫБРАТЬ ПЕРВЫЕ 100", "ВЫБРАТЬ ПЕРВЫЕ " + КоличествоЗаказовВСутки + " ");
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ТекущееКоличествоЗаказовВСутки >= КоличествоЗаказовВСутки Тогда
			Прервать;
		КонецЕсли;
		
		Если ТекущееКоличествоЗаказовВПорции = КоличествоЗаказовВПорции Тогда
			
			AMQP_РаботаСДокументами.ПаузаИсполнения(ЗадержкаПоВремени);
			ТекущееКоличествоЗаказовВПорции = 0;
			
		КонецЕсли;
		
		Попытка
			
			СтатусыЗаказов.ПоместитьВОчередьВФоне(ВыборкаДетальныеЗаписи.ЗаказПокупателя);
			
			ТекущееКоличествоЗаказовВСутки = ТекущееКоличествоЗаказовВСутки + 1;
			ТекущееКоличествоЗаказовВПорции = ТекущееКоличествоЗаказовВПорции + 1;
			
			ПоследнийОбработанныйЗаказ = ВыборкаДетальныеЗаписи.ЗаказПокупателя;
			
		Исключение
			
			ЗаписьЖурналаРегистрации(ИмяРегламента, УровеньЖурналаРегистрации.Ошибка, , ,"Ошибка помещения в очередь выгрузки статусов заказа покупателя " + ВыборкаДетальныеЗаписи.ЗаказПокупателя);
			Прервать;
			
		КонецПопытки;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ПоследнийОбработанныйЗаказ) Тогда
		
		НаборЗаписей = РегистрыСведений.РегламентВыгрузкиСтатусовЗаказов.СоздатьНаборЗаписей();
		
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.ЗаказПокупателя = ПоследнийОбработанныйЗаказ;
		НоваяЗапись.Дата = ТекущаяДата();
		НоваяЗапись.КоличествоОбработанных = ТекущееКоличествоЗаказовВСутки;
		
		НаборЗаписей.Записать();
		
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации(ИмяРегламента, УровеньЖурналаРегистрации.Информация, , ,"Завершение");
	//-Сёмин Р.И. 04.03.2026 #UT10-5727
	
КонецПроцедуры

Процедура ОбновлениеОстатковПорталS3() Экспорт
	
	//+Сёмин Р.И. 20.03.2026 #UT10-5759
	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда 
		
		ЗаписьЖурналаРегистрации(
			"Обновление остатков портал (через S3)",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			"Отменена работа регламентного задания из-за несоответствия параметров подключения в ИБ"
		);
		
		Возврат;
		
	КонецЕсли;
	
	ИмяS3Сервера       = Константы.S3ВыгрузкаЦенАдрес.Получить();
	ПортS3Сервера      = Константы.S3ВыгрузкаЦенПорт.Получить();
	ЗаданаПапкаДляS3   = СокрЛП(Константы.S3ВыгрузкаЦенКаталог.Получить());
	
	Если НЕ ЗначениеЗаполнено(ИмяS3Сервера) Тогда        
		
		ЗаписьЖурналаРегистрации(
			"Обновление остатков портал (через S3).Ошибка", 
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"Отменена попытка соединения с S3: не заполнен адрес S3 сервера в константах."
		);
		
		Возврат;     
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ТоварыВРезервеНаСкладахОстатки.Номенклатура,
		|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва КАК ЗаказПокупателя
		|ПОМЕСТИТЬ ТоварыВРезерке
		|ИЗ
		|	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(
		|			,
		|			Склад = &Склад
		|				И ДокументРезерва ССЫЛКА Документ.ЗаказПокупателя) КАК ТоварыВРезервеНаСкладахОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва,
		|	ТоварыВРезервеНаСкладахОстатки.Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТоварыНаСкладахОстатки.КоличествоОстаток - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0) КАК СвободныйОстатокСклад,
		|	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура
		|ПОМЕСТИТЬ НеНулевыеСвободныеОстаткиСклад
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Остатки(, Склад = &Склад) КАК ТоварыНаСкладахОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(, Склад = &Склад) КАК ТоварыВРезервеНаСкладахОстатки
		|		ПО ТоварыНаСкладахОстатки.Номенклатура = ТоварыВРезервеНаСкладахОстатки.Номенклатура
		|ГДЕ
		|	ТоварыНаСкладахОстатки.КоличествоОстаток - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0) > 0
		|	И ТоварыНаСкладахОстатки.Номенклатура.Родитель.НеПоказыватьНаПортале = ЛОЖЬ
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НеНулевыеСвободныеОстаткиСклад.СвободныйОстатокСклад,
		|	НеНулевыеСвободныеОстаткиСклад.Номенклатура КАК Номенклатура,
		|	ТоварыВЯчейкахОстатки.КоличествоОстаток - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0) + ЕСТЬNULL(ТоварыВСборкеОстатки.СобраноОстаток, 0) + ЕСТЬNULL(ТоварыВСборкеОстатки.КСборкеОстаток, 0) КАК СвободныйОстатокЯчейки,
		|	ВЫБОР
		|		КОГДА НеНулевыеСвободныеОстаткиСклад.СвободныйОстатокСклад <= ТоварыВЯчейкахОстатки.КоличествоОстаток - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0) + ЕСТЬNULL(ТоварыВСборкеОстатки.СобраноОстаток, 0) + ЕСТЬNULL(ТоварыВСборкеОстатки.КСборкеОстаток, 0)
		|			ТОГДА НеНулевыеСвободныеОстаткиСклад.СвободныйОстатокСклад
		|		ИНАЧЕ ЕСТЬNULL(ТоварыВЯчейкахОстатки.КоличествоОстаток, 0) - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0) + ЕСТЬNULL(ТоварыВСборкеОстатки.СобраноОстаток, 0) + ЕСТЬNULL(ТоварыВСборкеОстатки.КСборкеОстаток, 0)
		|	КОНЕЦ КАК СвободныйОстаток
		|ПОМЕСТИТЬ НеНулевыеСвободныеОстатки
		|ИЗ
		|	НеНулевыеСвободныеОстаткиСклад КАК НеНулевыеСвободныеОстаткиСклад
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках.Остатки(
		|				,
		|				Склад = &Склад
		|					И Ячейка.НеУчитыватьВОперативномУчете = ЛОЖЬ) КАК ТоварыВЯчейкахОстатки
		|		ПО НеНулевыеСвободныеОстаткиСклад.Номенклатура = ТоварыВЯчейкахОстатки.Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(, Склад = &Склад) КАК ТоварыВРезервеНаСкладахОстатки
		|		ПО (ТоварыВЯчейкахОстатки.Номенклатура = ТоварыВРезервеНаСкладахОстатки.Номенклатура)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВСборке.Остатки(
		|				,
		|				(ЗаказПокупателя, Номенклатура) В
		|					(ВЫБРАТЬ
		|						ТоварыВРезерке.ЗаказПокупателя КАК ЗаказПокупателя,
		|						ТоварыВРезерке.Номенклатура
		|					ИЗ
		|						ТоварыВРезерке КАК ТоварыВРезерке)) КАК ТоварыВСборкеОстатки
		|		ПО (ТоварыВЯчейкахОстатки.Номенклатура = ТоварыВСборкеОстатки.Номенклатура)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Таб.Номенклатура
		|ПОМЕСТИТЬ ОборотСегодня
		|ИЗ
		|	(ВЫБРАТЬ
		|		ТоварыНаСкладахОбороты.Номенклатура КАК Номенклатура
		|	ИЗ
		|		РегистрНакопления.ТоварыНаСкладах.Обороты(
		|				&НачалоСегодняшнегоДня,
		|				,
		|				,
		|				Склад = &Склад
		|					И НЕ Номенклатура В
		|							(ВЫБРАТЬ
		|								НеНулевыеСвободныеОстатки.Номенклатура
		|							ИЗ
		|								НеНулевыеСвободныеОстатки КАК НеНулевыеСвободныеОстатки)) КАК ТоварыНаСкладахОбороты
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		ТоварыВРезервеНаСкладахОбороты.Номенклатура
		|	ИЗ
		|		РегистрНакопления.ТоварыВРезервеНаСкладах.Обороты(
		|				&НачалоСегодняшнегоДня,
		|				,
		|				,
		|				Склад = &Склад
		|					И НЕ Номенклатура В
		|							(ВЫБРАТЬ
		|								НеНулевыеСвободныеОстатки.Номенклатура
		|							ИЗ
		|								НеНулевыеСвободныеОстатки КАК НеНулевыеСвободныеОстатки)) КАК ТоварыВРезервеНаСкладахОбороты) КАК Таб
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	""item"" КАК type,
		|	СправочникНоменклатура.КодМДМ КАК mdm_id,
		|	Т.СвободныйОстаток КАК quantity
		|ИЗ
		|	(ВЫБРАТЬ
		|		НеНулевыеСвободныеОстатки.Номенклатура КАК Номенклатура,
		|		НеНулевыеСвободныеОстатки.СвободныйОстаток КАК СвободныйОстаток
		|	ИЗ
		|		НеНулевыеСвободныеОстатки КАК НеНулевыеСвободныеОстатки
		|	ГДЕ
		|		НеНулевыеСвободныеОстатки.СвободныйОстаток > 0
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ОборотСегодня.Номенклатура,
		|		0
		|	ИЗ
		|		ОборотСегодня КАК ОборотСегодня) КАК Т
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
		|		ПО Т.Номенклатура = СправочникНоменклатура.Ссылка
		|ГДЕ
		|	Т.СвободныйОстаток > 0";
	
	
	Запрос.УстановитьПараметр("Склад", Константы.ОсновнойСклад.Получить());
	Запрос.УстановитьПараметр("НачалоСегодняшнегоДня", ТекущаяДата());
	
	Текст = Новый ТекстовыйДокумент;
	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда  
		
		Путь        = ПолучитьИмяВременногоФайла("jsonl");
		ДатаСобытия = ТекущаяДата();
		
		СтруктураЗаголовка =  Новый Структура;
		СтруктураЗаголовка.Вставить("type"              , "header");
		СтруктураЗаголовка.Вставить("date"              , Формат(ДатаСобытия, "ДФ=dd.MM.yyyy ЧЧ:мм:сс"));
		СтруктураЗаголовка.Вставить("price_list_mdm_id" , Константы.ОсновнойСклад.Получить().КодМДМПрайсЛиста); 	
		
		МСКWEB.ЗаписатьРезультатЗапросаВJSONLines(Результат, Путь, СтруктураЗаголовка);
		
		ИмяФайлаПередать = СокрЛП(Константы.База.Получить()) + "_" + Формат(ДатаСобытия, "ДФ=dd.MM.yyyy") + "_" + Формат(ДатаСобытия, "ДФ=ЧЧммсс") + ".jsonl"; 
		
		СсылкаНаФайл = "";
		
		Попытка
			
			Соединение = Новый FTPСоединение(ИмяS3Сервера, ?(ЗначениеЗаполнено(ПортS3Сервера), ПортS3Сервера, "21"), Константы.S3ВыгрузкаЦенЛогин.Получить(), Константы.S3ВыгрузкаЦенПароль.Получить(), , Истина); 
			Соединение.Записать(Путь, ?(ЗначениеЗаполнено(ЗаданаПапкаДляS3), ЗаданаПапкаДляS3 + "\", "") + ИмяФайлаПередать);
			
			СсылкаНаФайл = "http://" + СокрЛП(ИмяS3Сервера) + ?(ЗначениеЗаполнено(ПортS3Сервера) , ":" + ПортS3Сервера ,"") + ?(ЗначениеЗаполнено(ЗаданаПапкаДляS3) , СтрЗаменить(ЗаданаПапкаДляS3, "\", "/") + "/" , "") + ИмяФайлаПередать;

			ЗаписьЖурналаРегистрации(
				"Обновление остатков портал (через S3)",
				УровеньЖурналаРегистрации.Информация,
				,
				,
				"Файл записан на FTP: " + ИмяS3Сервера + " в каталог: " + ЗаданаПапкаДляS3
			);
			
		Исключение
			
			ЗаписьЖурналаРегистрации(
				"Обновление остатков портал (через S3)",
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				"Блокировки НЕ БЫЛО. Но запись данных на S3: " + ИмяS3Сервера + " НЕ СОСТОЯЛАСЬ!" + Символы.ПС + ОписаниеОшибки()
			);
			
		КонецПопытки;
		
		УдалитьФайлы(Путь);
		
		Если ЗначениеЗаполнено(СсылкаНаФайл) Тогда 
			
			НовоеСообщение = Справочники.ИсходящиеСообщения.СоздатьЭлемент();
			НовоеСообщение.ОбменДанными.Загрузка = Истина;
			НовоеСообщение.ДатаВремяСобытия = ТекущаяДата();
			НовоеСообщение.Объект = "ОбновлениеОстатковПортал";
			НовоеСообщение.ТочкаПубликации = Константы.AMQP_Exchange.Получить();
			
			ID = Новый УникальныйИдентификатор();     	
			НовоеСообщение.УстановитьСсылкуНового(Справочники.ИсходящиеСообщения.ПолучитьСсылку(ID));
			
			СтруктураДокумента = Новый Структура;
			СтруктураДокумента.Вставить("link", СсылкаНаФайл);
			
			ЗаписьJSON = Новый ЗаписьJSON();
			ПараметрыЗаписиJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет, , Истина);
			
			ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписиJSON);
			ЗаписатьJSON(ЗаписьJSON, СтруктураДокумента);
			JsonСтрока = ЗаписьJSON.Закрыть();
			
			НовоеСообщение.Сообщение = JsonСтрока;
			
			Свойства = Новый СписокЗначений;
			Свойства.Добавить("ТипСодержимого" , "application/json"); 
			Свойства.Добавить("ОтметкаВремени" , AMQP_РаботаСДокументами.ДатуВTimestamp(НовоеСообщение.ДатаВремяСобытия));   	
			Свойства.Добавить("Тип"            , "status"); 
			Свойства.Добавить("ИмяПриложения"  , Константы.AMQP_ИдентификаторИнформацСистемы.Получить());
			Свойства.Добавить("РежимДоставки"  , 2);
			Свойства.Добавить("НомерСообщения" , Строка(ID));
			
			Заголовки = Новый СписокЗначений;
			Заголовки.Добавить("status_type"  , "ОбновлениеОстатковПортал");
			Заголовки.Добавить("content_type" , "application/json");
			Заголовки.Добавить("warehouse_id" , Константы.ОсновнойСклад.Получить().КодМДМ);
			Заголовки.Добавить("price_id"     , Константы.FTPВыгрузкаОстатковКаталог.Получить());
			Заголовки.Добавить("price_mdmid"  , Константы.ОсновнойСклад.Получить().КодМДМПрайсЛиста);
			
			Для Каждого Свойство Из Свойства Цикл
				
				НоваяСтрока = НовоеСообщение.Свойства.Добавить();
				НоваяСтрока.Наименование = Свойство.Значение;
				НоваяСтрока.Значение = Свойство.Представление;
				
			КонецЦикла;   	
			
			Если ЗначениеЗаполнено(Заголовки) Тогда
				
				Для Каждого Заголовок Из Заголовки Цикл
					
					НоваяСтрока = НовоеСообщение.Заголовки.Добавить();
					НоваяСтрока.Наименование = Заголовок.Значение;
					НоваяСтрока.Значение = Заголовок.Представление;
					
				КонецЦикла;   
				
			КонецЕсли;      
			
			НовоеСообщение.Записать();
			
		КонецЕсли;
		
	КонецЕсли;
	//-Сёмин Р.И. 20.03.2026 #UT10-5759
	
КонецПроцедуры

Процедура СформироватьВыводыИзОборота() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РеализацияТоваровУслуг.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_Реализации
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	|		ПО РеализацияТоваровУслуг.Ссылка = ЗначенияСвойствОбъектов.Объект
	|			И (ЗначенияСвойствОбъектов.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СвойстваОбъектов.СтатусДоставки))
	|			И (ЗначенияСвойствОбъектов.Значение = ЗНАЧЕНИЕ(Перечисление.СтатусыДоставки.ТоварПередан))
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВыводИзОборотаКИЗ КАК ВыводИзОборотаКИЗ
	|		ПО РеализацияТоваровУслуг.Ссылка = ВыводИзОборотаКИЗ.Основание
	|			И (ВыводИзОборотаКИЗ.Проведен)
	|ГДЕ
	|	РеализацияТоваровУслуг.Дата >= &ДатаНачала
	|	И (РеализацияТоваровУслуг.ДоговорКонтрагента.УсловияРаботыСЧЗ = ЗНАЧЕНИЕ(Перечисление.УсловияРаботыСЧЗ.ПокупкаДляСобственныхНужд)
	|			ИЛИ РеализацияТоваровУслуг.ДоговорКонтрагента.УсловияРаботыСЧЗ = ЗНАЧЕНИЕ(Перечисление.УсловияРаботыСЧЗ.ТорговляСНовымиРегионами))
	|	И НЕ ЕСТЬNULL(РеализацияТоваровУслуг.Грузополучатель.СобственныйФилиал, ЛОЖЬ)
	|	И ЕСТЬNULL(РеализацияТоваровУслуг.Грузополучатель.DS_Подразделение_ID, 0) = 0
	|	И РеализацияТоваровУслуг.ДоговорКонтрагента.DS_Подразделение_ID = 0
	|	И РеализацияТоваровУслуг.Проведен
	|	И ВыводИзОборотаКИЗ.Ссылка ЕСТЬ NULL
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Реализации.Ссылка КАК Реализация,
	|	РеализацияТоваровУслугКодыМаркировки.КодМаркировки
	|ПОМЕСТИТЬ ВТ_РеализацииСКодамиМаркировки
	|ИЗ
	|	ВТ_Реализации КАК ВТ_Реализации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.КодыМаркировки КАК РеализацияТоваровУслугКодыМаркировки
	|		ПО ВТ_Реализации.Ссылка = РеализацияТоваровУслугКодыМаркировки.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Реализации.Ссылка,
	|	РеализацияТоваровУслугКодыМаркировки.КодМаркировки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Реализация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_РеализацииСКодамиМаркировки.Реализация КАК Реализация,
	|	ВТ_РеализацииСКодамиМаркировки.КодМаркировки.Номенклатура.ТоварнаяГруппаЧестногоЗнака КАК ТоварнаяГруппаЧестногоЗнака,
	|	ВТ_РеализацииСКодамиМаркировки.КодМаркировки КАК КодМаркировки,
	|	МАКСИМУМ(РеализацияТоваровУслугТовары.Цена) КАК Цена
	|ИЗ
	|	ВТ_РеализацииСКодамиМаркировки КАК ВТ_РеализацииСКодамиМаркировки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|		ПО ВТ_РеализацииСКодамиМаркировки.Реализация = РеализацияТоваровУслугТовары.Ссылка
	|			И ВТ_РеализацииСКодамиМаркировки.КодМаркировки.Номенклатура = РеализацияТоваровУслугТовары.Номенклатура
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_РеализацииСКодамиМаркировки.Реализация,
	|	ВТ_РеализацииСКодамиМаркировки.КодМаркировки.Номенклатура.ТоварнаяГруппаЧестногоЗнака,
	|	ВТ_РеализацииСКодамиМаркировки.КодМаркировки
	|ИТОГИ
	|	МАКСИМУМ(Цена)
	|ПО
	|	Реализация,
	|	ТоварнаяГруппаЧестногоЗнака";
	
	Запрос.УстановитьПараметр("ДатаНачала", ДобавитьМесяц(ТекущаяДата(), -1));
	
	ВыборкаРеализация = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);; 
	
	Пока ВыборкаРеализация.Следующий() Цикл 
		
		Реализация = ВыборкаРеализация.Реализация;
		
		ВыборкаТоварнаяГруппаЧестногоЗнака = ВыборкаРеализация.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
		
		Пока ВыборкаТоварнаяГруппаЧестногоЗнака.Следующий() Цикл
			
			ТоварнаяГруппаЧестногоЗнака = ВыборкаТоварнаяГруппаЧестногоЗнака.ТоварнаяГруппаЧестногоЗнака;
			
			НовыйДокумент = Документы.ВыводИзОборотаКИЗ.СоздатьДокумент();
			НовыйДокумент.Дата = ТекущаяДата();
			НовыйДокумент.Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Реализация, "Организация");
			НовыйДокумент.ВидПродукции = ТоварнаяГруппаЧестногоЗнака;
			НовыйДокумент.Основание = Реализация;
			НовыйДокумент.Комментарий = "Создан регламентным заданием";
			НовыйДокумент.Статус = Перечисления.СтатусыВыводИзОборотаКИЗ.Отправлен;
			НовыйДокумент.Ответственный = Пользователи.ТекущийПользователь();
			
			ВыборкаКодыМаркировки = ВыборкаТоварнаяГруппаЧестногоЗнака.Выбрать();
			
			Пока ВыборкаКодыМаркировки.Следующий() Цикл 
				
				Номенклатура = ВыборкаКодыМаркировки.КодМаркировки.Номенклатура;
				
				НСтр = НовыйДокумент.Товары.Добавить(); 
				НСтр.Номенклатура = Номенклатура;
				НСтр.ШтрихКодМаркировки = ВыборкаКодыМаркировки.КодМаркировки;
				НСтр.Цена = ВыборкаКодыМаркировки.Цена; 
				
			КонецЦикла; 
			
			НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
			  			
		КонецЦикла;
		
	КонецЦикла;
	
	//+Сёмин Р.И. 21.04.2026 #UT10-5815
	СформироватьВыводыИзОборотаПоТН();
	//-Сёмин Р.И. 21.04.2026 #UT10-5815
	
