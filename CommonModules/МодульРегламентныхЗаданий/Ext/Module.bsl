	|АВТОУПОРЯДОЧИВАНИЕ";
	
	ЗакупочнаяЦена 	= Константы.ЗакупочнаяЦена.Получить();
	Базовая 		= Константы.БазоваяЦена.Получить();
	Скидка35 		= Константы.Скидка35.Получить();
	Скидка36 		= Константы.Скидка36.Получить();
	Скидка37 		= Константы.Скидка37.Получить();
	Скидка38		= Константы.Скидка38.Получить();
	СпецЦена        = Константы.СпецЦена.Получить();                       
	АДУрал          = Константы.АДУрал.Получить();
	Акция           = Константы.Акция.Получить();
	АвтоЕвропа      = Константы.АвтоЕвропа.Получить();
	Резерв4         = Константы.Резерв4.Получить();  
	
	ЗаменятьРодителяДляГруппыУценка = 
	Константы.ИспользоватьГруппуНоменклатурыУценка.Получить()
	и ЗначениеЗаполнено(Константы.ГруппаНоменклатурыУценка.Получить());
	
	Запрос.УстановитьПараметр("БазоваяценаМоскворечье", Базовая);   
	Запрос.УстановитьПараметр("Скидка35", 				Скидка35);  
	Запрос.УстановитьПараметр("Скидка36", 				Скидка36);  
	Запрос.УстановитьПараметр("Скидка37", 				Скидка37);  
	Запрос.УстановитьПараметр("Скидка38", 				Скидка38);  
	Запрос.УстановитьПараметр("СпецЦена", 				СпецЦена);  
	Запрос.УстановитьПараметр("АДУрал", 				АДУрал);   
	Запрос.УстановитьПараметр("Акция", 				    Акция);
	Запрос.УстановитьПараметр("АвтоЕвропа", 		    АвтоЕвропа);
	Запрос.УстановитьПараметр("Резерв4",                Резерв4);
	
	СписокТиповЦен = Новый СписокЗначений;
	СписокТиповЦен.Добавить(Базовая);
	СписокТиповЦен.Добавить(Скидка35);
	СписокТиповЦен.Добавить(Скидка36);
	СписокТиповЦен.Добавить(Скидка37);
	СписокТиповЦен.Добавить(Скидка38);
	СписокТиповЦен.Добавить(СпецЦена);
	СписокТиповЦен.Добавить(АДУрал);
	СписокТиповЦен.Добавить(Акция); 
	СписокТиповЦен.Добавить(АвтоЕвропа);
	СписокТиповЦен.Добавить(Резерв4);
	
	Запрос.УстановитьПараметр("СписокТиповЦен", 	СписокТиповЦен);
	Запрос.УстановитьПараметр("Ответственный",      Справочники.Пользователи.НайтиПоКоду("robot"));
	
	ДатаПерехода = Константы.ДатаНачалаЗагрузкиИВыгрузкиЦенВРублях.Получить();
	
	Если ЗначениеЗаполнено(ДатаПерехода) И ТекущаяДата() > ДатаПерехода Тогда 
		Запрос.УстановитьПараметр("Евро", Константы.ВалютаРегламентированногоУчета.Получить());
	Иначе
		Запрос.УстановитьПараметр("Евро", Справочники.Валюты.НайтиПоКоду("978"));
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ВидНоменклатуры", 	Константы.ВидНоменклатурыПоУмолчанию.Получить());
	Запрос.УстановитьПараметр("Склад",   			Константы.ОсновнойСклад.Получить());      
	Текст = Новый ТекстовыйДокумент;
	
	Результат = Запрос.Выполнить(); 
	
	Если НЕ Результат.Пустой() Тогда  
		
		Выборка = Результат.Выбрать(); 
		
		ЗаписьЖурналаРегистрации("Полное обновление остатков и цен единый прайс-лист.Обработка", УровеньЖурналаРегистрации.Информация,,, 
		"Количество строк в запросе: " + Строка(Выборка.Количество()));
		
		МассивСтрокДляЗаписиВТекстовыйДокумент = Новый Массив;
		МаксимальноеКоличествоИтераций = 20000;
		ДанныеПоОстаткамСтрока = "";
		
		Инд = 0;         
		
		Пока Выборка.Следующий() Цикл	
			
			Если Инд = МаксимальноеКоличествоИтераций Тогда       
				
				МассивСтрокДляЗаписиВТекстовыйДокумент.Добавить(ДанныеПоОстаткамСтрока);	
				Инд = 0;  
				ДанныеПоОстаткамСтрока = "";  
				
			КонецЕсли; 
			
			ВременнаяСтрока =  
			Выборка.ЗаменяемыйРодитель + Символы.Таб
			 + Выборка.Артикул + Символы.Таб
			 + Выборка.КодПроизводителя + Символы.Таб
			 + Выборка.Номенклатура + Символы.Таб
			 + Выборка.ЕдИзм + Символы.Таб
			 + Строка(Выборка.Кратность) + Символы.Таб
			 + Строка(СтрЗаменить(?(Выборка.СвободныйОстаток < 0, 0, Выборка.СвободныйОстаток), Символы.НПП, "")) + Символы.Таб 
			 + Строка(СтрЗаменить(Выборка.БазоваяценаМоскворечье, Символы.НПП, "")) + Символы.Таб 
			 + Строка(СтрЗаменить(Выборка.Скидка35, Символы.НПП, "")) + Символы.Таб
			 + Строка(СтрЗаменить(Выборка.Скидка36, Символы.НПП, "")) + Символы.Таб
			 + Строка(СтрЗаменить(Выборка.Скидка37, Символы.НПП, "")) + Символы.Таб			
			 + Строка(СтрЗаменить(Выборка.Скидка38, Символы.НПП, "")) + Символы.Таб			
			 + Строка(СтрЗаменить(Выборка.СпецЦена, Символы.НПП, "")) + Символы.Таб			
			 + Строка(СтрЗаменить(Выборка.АДУрал, Символы.НПП, "")) + Символы.Таб					
			 + СокрЛП(Выборка.КодМДМ)  + Символы.Таб                           
			 + Строка(СтрЗаменить(Выборка.Акция, Символы.НПП, "")) + Символы.Таб
			 + Строка(СтрЗаменить(Выборка.АвтоЕвропа, Символы.НПП, "")) + Символы.Таб
			 + Строка(СтрЗаменить(Выборка.Резерв4, Символы.НПП, "")
			 //+Сёмин Р.И. 02.04.2026 #UT10-5793
			 + Символы.Таб + Строка(СтрЗаменить(Выборка.ЗначениеМаскиНедоступныхТоваров, Символы.НПП, ""))
			 //-Сёмин Р.И. 02.04.2026 #UT10-5793
			 );
			
			ДанныеПоОстаткамСтрока = ДанныеПоОстаткамСтрока + ?(Инд > 0, Символы.ПС, "") + ВременнаяСтрока;
			
			Инд = Инд + 1;
			
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ДанныеПоОстаткамСтрока) Тогда
			МассивСтрокДляЗаписиВТекстовыйДокумент.Добавить(ДанныеПоОстаткамСтрока);	
		КонецЕсли;
		
		ИтоговыеДанныеПоОстаткамСтрока = "" + Символы.ПС; 
		
		Сч = 0;
		
		Для Каждого СтрокаДобавления Из МассивСтрокДляЗаписиВТекстовыйДокумент Цикл  
			
			ИтоговыеДанныеПоОстаткамСтрока = ИтоговыеДанныеПоОстаткамСтрока + ?(Сч > 0, Символы.ПС, "") + СтрокаДобавления; 			
			Сч = Сч + 1;  
			
		КонецЦикла;
		
		ИтоговыеДанныеПоОстаткамСтрока = ИтоговыеДанныеПоОстаткамСтрока + Символы.ПС;
		
		Текст.УстановитьТекст(ИтоговыеДанныеПоОстаткамСтрока);
		
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации("Полное обновление остатков и цен единый прайс-лист.Обработка", УровеньЖурналаРегистрации.Информация,,, 
	"Количество строк во временном документе: " + Строка(Текст.КоличествоСтрок()));
	
	
	ИмяВременногоКаталога = СокрЛП(Новый УникальныйИдентификатор);
	СоздатьКаталог(КаталогВременныхФайлов() + ИмяВременногоКаталога);
	
	ВременныйКаталог = КаталогВременныхФайлов() + ИмяВременногоКаталога + "\";
	ВремИмя = "TempPrice";
	Текст.Записать(ВременныйКаталог + ВремИмя,КодировкаТекста.ANSI);
	
	ЗаписьЖурналаРегистрации("Полное обновление остатков и цен единый прайс-лист.Обработка", УровеньЖурналаРегистрации.Информация,,, "Документ записан во временный каталог");
	
	Для Каждого СтрокаСпискаКаталогов Из СписокКаталоговСервера Цикл
		
		ЗаданаПапкаДляFTP  = СокрЛП(СтрокаСпискаКаталогов.Значение);
		ИмяКаталогаСервера = СокрЛП(СтрокаСпискаКаталогов.Представление);
		
		Попытка
			Соединение = Новый FTPСоединение(ИмяFTPСервера, "21", Константы.FTPВыгрузкаОстатковЛогин.Получить(), Константы.FTPВыгрузкаОстатковПароль.Получить(), , Истина);
		Исключение
			
			ЗаписьЖурналаРегистрации("Полное обновление остатков и цен единый прайс-лист.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
			"Не удалось установить соединение с FTP. Запись данных на FTP не выполнена.");
			
			ЗаписатьОшибкуВыгрузкиОстатковЦен("ПолноеОбновлениеОстатковЦен", Набор, УдалитьЗаписи, Истина);
			Возврат;
			
		КонецПопытки;
		
		Отказ = Ложь;
		
		МассивНайденныхФайловНаСервере = Соединение.НайтиФайлы(ИмяКаталогаСервера + "daemon.lock");
		
		Для Каждого ТекСтр Из МассивНайденныхФайловНаСервере Цикл  
			
			Если ВРег(ТекСтр.Имя) = ВРег("daemon.lock") Тогда   
				
				Отказ = Истина;
				Прервать;     
				
			КонецЕсли; 
			
		КонецЦикла;	    
		
		Если Отказ Тогда
			
			ЗаписьЖурналаРегистрации("Полное обновление остатков и цен единый прайс-лист.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
			"Запись данных на FTP НЕ СОСТОЯЛАСЬ из-за БЛОКИРОВКИ (daemon.lock).");
			
			ЗаписатьОшибкуВыгрузкиОстатковЦен("ПолноеОбновлениеОстатковЦен", Набор, УдалитьЗаписи, Истина);
			Возврат;
			
		КонецЕсли;
		
		// Записать файлик блокировки
		Файлик = Новый ТекстовыйДокумент;
		ВремИмяФайлаБлокировки = Строка(Новый УникальныйИдентификатор);
		Файлик.Записать(КаталогВременныхФайлов() + ВремИмяФайлаБлокировки); 	
		
		Попытка
			
			Соединение.Записать(КаталогВременныхФайлов() + ВремИмяФайлаБлокировки, ИмяКаталогаСервера + "connect.lock");		
			ЗаписьЖурналаРегистрации("Полное обновление остатков и цен единый прайс-лист.Обработка", УровеньЖурналаРегистрации.Информация,,, 
			"Файл connect.lock записан в каталог: " + ЗаданаПапкаДляFTP);
			
		Исключение 
			
			ЗаписьЖурналаРегистрации("Полное обновление остатков и цен единый прайс-лист.Ошибка", УровеньЖурналаРегистрации.Информация,,, 
			"Ошибка записи файла connect.lock в каталог: " + ЗаданаПапкаДляFTP + Символы.ПС + ОписаниеОшибки());	
			
			ЗаписатьОшибкуВыгрузкиОстатковЦен("ПолноеОбновлениеОстатковЦен", Набор, УдалитьЗаписи, Истина);
			Возврат;
			
		КонецПопытки;
		
		ВременныйФайлЗаписанНаСервере = Истина; 
		
		Попытка
			
			ЗаписыватьВременныйФайл = Истина;
			МассивНайденныхФайловНаСервере = Соединение.НайтиФайлы(ИмяКаталогаСервера + "TempPrice");
			
			Для Каждого ТекСтр Из МассивНайденныхФайловНаСервере Цикл     
				
				Если ВРег(ТекСтр.Имя) = ВРег("TempPrice") Тогда
					
