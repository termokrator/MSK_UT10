Процедура ЗаполнитьИнвентариныеНомера() Экспорт
	
	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда 
		
		ЗаписьЖурналаРегистрации("Заполнить инвентарные номера", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Отменена работа регламентного задания из-за несоответствия параметров подключения к ИБ");
		Возврат;
		
	КонецЕсли;
	
	Подключение = Неопределено;
	RS = Неопределено;
	Подключение = Новый COMObject("ADODB.Connection");	
	
	Если РаботаСАвардой.Соединение(Подключение) Тогда 
		
		ДатаНТ = ПолучитьДату(ТекущаяДата() - 30*24*60*60*12*10);
		ДатаКТ = ПолучитьДату(КонецГода(ТекущаяДата()));
		Запросadd = "Select INV,ARTICLE,PROIZV From ({call RA_GET_TOV_FOR_ORA(null,null,null,null,'" + ДатаНТ + "','" + ДатаКТ + "',null,null,null,null,null,null)})";
		РСТ = РаботаСАвардой.СформироватьЗапрос(Запросadd,Подключение);
		
		//Подключение.CommitTrans();
		Если РСТ = Неопределено Тогда
			ЗаписьЖурналаРегистрации("Обновление инвентарных номеров", УровеньЖурналаРегистрации.Ошибка,,, "Ошибка обновления номенклатуры " + Запросadd);
		Иначе	
			
			ПромТаблица = Новый ТаблицаЗначений;
			ОписаниеТиповСтрока = новый ОписаниеТипов("строка", Новый квалификаторыстроки(80, ДопустимаяДлина.Переменная));
			ПромТаблица.Очистить();
			
			Для Счетчик = 1 По РСТ.Fields.Count Цикл
				
				Поле = РСТ.Fields.Item(Счетчик - 1);
				Колонка = ПромТаблица.Колонки.Добавить(Поле.Name, ОписаниеТиповСтрока, Поле.Name);
				
			КонецЦикла;
			
			Пока РСТ.EOF() = 0 Цикл		
				
				НоваяСтрока = ПромТаблица.Добавить();           		
				
				Для Счетчик = 1 По РСТ.Fields.Count Цикл 
					
					Поле = РСТ.Fields.Item(Счетчик - 1);
					НоваяСтрока[Поле.Name] = Поле.Value;			
					
				КонецЦикла;    		
				
				РСТ.MoveNext(); 		
				
			КонецЦикла;
			
			РСТ.Close(); 			
			РСТ = Неопределено;
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	Номенклатура.Ссылка
			|ПОМЕСТИТЬ Ном
			|ИЗ
			|	Справочник.Номенклатура КАК Номенклатура
			|ГДЕ
			|	Номенклатура.Артикул = """"
			|	И Номенклатура.ВидНоменклатуры = &ВидНоменклатуры
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	TOV.Inv КАК Инв,
			|	TOV.Proizv,
			|	TOV.Article
			|ПОМЕСТИТЬ Тов
			|ИЗ
			|	&TOV КАК TOV
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Ном.Ссылка,
			|	Тов.Инв,
			|	Тов.Proizv,
			|	Тов.Article,
			|	Ном.Ссылка.Родитель.Наименование,
			|	Ном.Ссылка.Артикул
			|ИЗ
			|	Ном КАК Ном
			|		ЛЕВОЕ СОЕДИНЕНИЕ Тов КАК Тов
			|		ПО Ном.Ссылка.КодПроизводителя = Тов.Article
			|			И Ном.Ссылка.Родитель.Наименование = Тов.Proizv";
			
			Запрос.УстановитьПараметр("TOV", ПромТаблица);
			Запрос.УстановитьПараметр("ВидНоменклатуры", Константы.ВидНоменклатурыПоУмолчанию.Получить());

			Выб = Запрос.Выполнить().Выбрать();
			
			Пока Выб.Следующий() Цикл
				
				Если ЗначениеЗаполнено(Выб.Инв) тогда
					Спр = Выб.Ссылка.ПолучитьОбъект();
					Спр.Артикул = Выб.Инв;
					Спр.КодПоБазеМоскоречье = Выб.Инв;
					
					Попытка
						Спр.Записать();
					Исключение
						ЗаписьЖурналаРегистрации("Обновление инвентарных номеров", УровеньЖурналаРегистрации.Ошибка,,, 
						"Ошибка обновления номенклатуры " + Выб.Ссылка.НаименованиеПолное);
					КонецПопытки;
					
				КонецЕсли;
				
			КонецЦикла; 
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

