	КоличествоДней = Справочники.МТ_ПредопределенныеЗначения.ПолучитьЗначениеПоСвойству(Справочники.МТ_ПредопределенныеЗначения.НастройкиКоличестваДней, "Количество дней хранения данных в регистре статусов касс");
	Дата = ТекущаяДата() - ?(ЗначениеЗаполнено(КоличествоДней), КоличествоДней, 30) * 24 * 60 * 60;
	
