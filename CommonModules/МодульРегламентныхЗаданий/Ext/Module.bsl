Процедура СнятиеФлагаНоменклатурыНеЗагружатьЦены() Экспорт
	
	НаименованиеРегЗадания = "Снятие флага номенклатуры Не загружать цены";
	
	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда   
		
		ЗаписьЖурналаРегистрации(НаименованиеРегЗадания + ". Предупреждение", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Отменена работа регламентного задания из-за несоответствия параметров подключения к ИБ");
		Возврат;                          
		
	КонецЕсли; 
	
	ЗаписьЖурналаРегистрации(НаименованиеРегЗадания + ". Начало", УровеньЖурналаРегистрации.Информация, , ,
	"Начато " + НаименованиеРегЗадания);                   
	
	Запрос = Новый Запрос; 
	Запрос.Текст =	
	"ВЫБРАТЬ
	|	ПоступлениеТоваровУслуг.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_Документы
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
	|ГДЕ
	|	НЕ ПоступлениеТоваровУслуг.ПометкаУдаления
	|	И ПоступлениеТоваровУслуг.Дата >= &ДатаНач
	|	И ПоступлениеТоваровУслуг.Дата <= &ДатаКон
	|	И НЕ ПоступлениеТоваровУслуг.Экспресс
	|	И ПоступлениеТоваровУслуг.Контрагент = &ОсновнойПоставщик
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПоступлениеТоваровУслугТовары.Номенклатура,
	|	ПоступлениеТоваровУслугТовары.Номенклатура.КодПроизводителя КАК КодПроизводителя
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.Товары КАК ПоступлениеТоваровУслугТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Документы КАК ВТ_Документы
	|		ПО ПоступлениеТоваровУслугТовары.Ссылка = ВТ_Документы.Ссылка
	|ГДЕ
	|	ПоступлениеТоваровУслугТовары.Номенклатура.НеЗагружатьЦеныЕслиЕстьОстатокТовара" ;     
	
	Запрос.УстановитьПараметр("ДатаНач",           НачалоДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("ДатаКон",           КонецДня(ТекущаяДата() + 86400));  
	Запрос.УстановитьПараметр("ОсновнойПоставщик", Константы.ОсновнойПоставщик.Получить());
	
	РезультатЗапроса = Запрос.Выполнить();    
	
	Если НЕ РезультатЗапроса.Пустой() Тогда         
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл   
			
			СпрОбъект = Выборка.Номенклатура.ПолучитьОбъект();
			СпрОбъект.НеЗагружатьЦеныЕслиЕстьОстатокТовара = Ложь;     
			
			Попытка
				СпрОбъект.Записать(); 
			Исключение        
				ЗаписьЖурналаРегистрации(НаименованиеРегЗадания + ". Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
				"Ошибка при записи номенклатуры: " + Строка(Выборка.Номенклатура)
				+ ", код производителя " + Выборка.КодПроизводителя + ": " + ОписаниеОшибки());
			КонецПопытки;
			
		КонецЦикла;               
		
	КонецЕсли;	 
	
	ЗаписьЖурналаРегистрации(НаименованиеРегЗадания + ". Конец", УровеньЖурналаРегистрации.Информация, , ,
	"Закончено " + НаименованиеРегЗадания);
	
КонецПроцедуры

