Процедура ОбработкаЗаказовВыгруженныхВУТ11() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НеобработанныеОтветыИзУТ11ПоОтправленнымЗаказам.ЗаказПоставщику КАК ЗаказПоставщику,
		|	НеобработанныеОтветыИзУТ11ПоОтправленнымЗаказам.ГУИДЗаказаПокупателя КАК ГУИДЗаказаПокупателя,
		|	НеобработанныеОтветыИзУТ11ПоОтправленнымЗаказам.КодОтправкиАварда КАК КодОтправкиАварда,
		|	НеобработанныеОтветыИзУТ11ПоОтправленнымЗаказам.Комментарий КАК Комментарий,
		|	НеобработанныеОтветыИзУТ11ПоОтправленнымЗаказам.Обработан,
		|	НеобработанныеОтветыИзУТ11ПоОтправленнымЗаказам.НомерСтрокиТовары - 1 КАК НомерСтрокиТовары,
		|	НеобработанныеОтветыИзУТ11ПоОтправленнымЗаказам.Номенклатура,
		|	НеобработанныеОтветыИзУТ11ПоОтправленнымЗаказам.Количество,
		|	НеобработанныеОтветыИзУТ11ПоОтправленнымЗаказам.УИД,
		|	НеобработанныеОтветыИзУТ11ПоОтправленнымЗаказам.КомментарийСтрокаТовар,
		|	НеобработанныеОтветыИзУТ11ПоОтправленнымЗаказам.УспешноОтправленаВАварду
		|ИЗ
		|	РегистрСведений.НеобработанныеОтветыИзУТ11ПоОтправленнымЗаказам КАК НеобработанныеОтветыИзУТ11ПоОтправленнымЗаказам
		|ГДЕ
		|	НЕ НеобработанныеОтветыИзУТ11ПоОтправленнымЗаказам.Обработан
		|ИТОГИ ПО
		|	ЗаказПоставщику,
		|	ГУИДЗаказаПокупателя,
		|	КодОтправкиАварда,
		|	Комментарий";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаЗаказПоставщику = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаЗаказПоставщику.Следующий() Цикл
		
		ЗаказОб = ВыборкаЗаказПоставщику.ЗаказПоставщику.ПолучитьОбъект();
	
		ВыборкаГУИДЗаказаПокупателя = ВыборкаЗаказПоставщику.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
		Пока ВыборкаГУИДЗаказаПокупателя.Следующий() Цикл
			
			ЗаказОб.ГУИДЗаказаПокупателя = ВыборкаГУИДЗаказаПокупателя.ГУИДЗаказаПокупателя;
	
			ВыборкаКодОтправкиАварда = ВыборкаГУИДЗаказаПокупателя.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
			Пока ВыборкаКодОтправкиАварда.Следующий() Цикл
				
				ЗаказОб.КодОтправкиАварда = ВыборкаКодОтправкиАварда.КодОтправкиАварда;
	
				ВыборкаКомментарий = ВыборкаКодОтправкиАварда.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
				Пока ВыборкаКомментарий.Следующий() Цикл
					
					ЗаказОб.Комментарий = ВыборкаКомментарий.Комментарий;
	
					ВыборкаДетальныеЗаписи = ВыборкаКомментарий.Выбрать();
	
					Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
						
						ЗаказОб.Товары[ВыборкаДетальныеЗаписи.НомерСтрокиТовары].Комментарий = ВыборкаДетальныеЗаписи.КомментарийСтрокаТовар;
						ЗаказОб.Товары[ВыборкаДетальныеЗаписи.НомерСтрокиТовары].УспешноОтправленаВАварду = ВыборкаДетальныеЗаписи.УспешноОтправленаВАварду;
						
					КонецЦикла;
					
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЦикла;
		
		НачатьТранзакцию();
		
		Попытка
			
			ЗаказОб.Записать(РежимЗаписиДокумента.Проведение);
			
			НаборЗаписей = РегистрыСведений.НеобработанныеОтветыИзУТ11ПоОтправленнымЗаказам.СоздатьНаборЗаписей();
			
			НаборЗаписей.Отбор.ЗаказПоставщику.Установить(ЗаказОб.Ссылка);
			НаборЗаписей.Прочитать();
			
			Для Каждого Стр Из НаборЗаписей Цикл
				Стр.Обработан = Истина;
			КонецЦикла;
			
			НаборЗаписей.Записать(Истина);
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстОшибки = ИнформацияОбОшибке();
			ЗаписьЖурналаРегистрации("Не удалось обновить документ """ + ЗаказОб + """ данными из регистра ""Необработанные ответы из УТ 11 по отправленным заказам""", УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
			
		КонецПопытки;
		
	КонецЦикла; 
	
	//+Гавриленков В. 20.08.2026 #UT10-6016
	// Отправка транзитов для создания Инвойсов
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДокПоступление.Ссылка КАК ДокПоступление
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК ДокПоступление
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг.Товары КАК ПоступлениеТовары
	|		ПО (ПоступлениеТовары.Ссылка = ДокПоступление.Ссылка)
	|			И (ПоступлениеТовары.ЗаказПоставщику.ТранзитнаяПоставкаЧерезСкладWMS = ИСТИНА)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику КАК ЗаказИзСделки
	|		ПО ДокПоступление.Сделка = ЗаказИзСделки.Ссылка
	|			И (ЗаказИзСделки.ТранзитнаяПоставкаЧерезСкладWMS = ИСТИНА)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК СвойстваИнвойса
	|		ПО (СвойстваИнвойса.Объект = ДокПоступление.Ссылка)
	|			И (СвойстваИнвойса.Свойство = &СвойствоIDИнвойса)
	|ГДЕ
	|	ДокПоступление.Дата >= &Дата
	|	И ДокПоступление.Проведен
	|	И (ПоступлениеТовары.Ссылка ЕСТЬ НЕ NULL 
	|			ИЛИ ЗаказИзСделки.Ссылка ЕСТЬ НЕ NULL )
	|	И (СвойстваИнвойса.Значение ЕСТЬ NULL
	|			ИЛИ СвойстваИнвойса.Значение = """")";
	
	Запрос.УстановитьПараметр("Дата", ТекущаяДата() - 86400); 
	//+Гавриленков В. 28.08.2026 #UT10-6026
	Запрос.УстановитьПараметр("СвойствоIDИнвойса", ПланыВидовХарактеристик.СвойстваОбъектов.IDИнвойса); 
	//-Гавриленков В. 28.08.2026 #UT10-6026
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		МСКWEB.ОтправитьПТУВУТ11(Выборка.ДокПоступление);
	КонецЦикла;
	//-Гавриленков В. 20.08.2026 #UT10-6016
	
КонецПроцедуры

Процедура ТоварыГруппыZДляГоловногоФилиала() Экспорт

	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда
		
		ЗаписьЖурналаРегистрации("Товары группы Z для головного филиала", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Отменена работа регламентного задания из-за несоответствия параметров подключения в ИБ");
		Возврат;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТоварыНаСкладахОстатки.Номенклатура.КодМДМ
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Остатки(
		|			,
		|			Склад = &ОсновнойСклад
		|				И Номенклатура.ГруппаАВС.Наименование ПОДОБНО ""Z%"") КАК ТоварыНаСкладахОстатки
		|		ПОЛНОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(, ТипЦен = &Скидка38) КАК ЦеныНоменклатурыСрезПоследних
		|		ПО ТоварыНаСкладахОстатки.Номенклатура = ЦеныНоменклатурыСрезПоследних.Номенклатура
		|ГДЕ
		|	ТоварыНаСкладахОстатки.КоличествоОстаток > 0
		|	И ЦеныНоменклатурыСрезПоследних.Цена > 0";
	
	Запрос.УстановитьПараметр("ОсновнойСклад", Константы.ОсновнойСклад.Получить());
	Запрос.УстановитьПараметр("Скидка38", Константы.Скидка38.Получить());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		Товары = РезультатЗапроса.Выгрузить();
		
		НовоеСообщение = Справочники.ИсходящиеСообщения.СоздатьЭлемент();
		НовоеСообщение.ОбменДанными.Загрузка = Истина;
		НовоеСообщение.ДатаВремяСобытия = ТекущаяДата();
		НовоеСообщение.Объект = "ТоварыГруппыZДляГоловногоФилиала";
		НовоеСообщение.ТочкаПубликации = Константы.AMQP_Exchange.Получить();
		
		ID = Новый УникальныйИдентификатор();     	
		НовоеСообщение.УстановитьСсылкуНового(Справочники.ИсходящиеСообщения.ПолучитьСсылку(ID));
		
		СтруктураДокумента = Новый Структура;
		
		СтруктураДокумента.Вставить("ВидДокумента"   , "ТоварыГруппыZДляГоловногоФилиала");
		СтруктураДокумента.Вставить("ТипСодержимого" , "application/json");
		СтруктураДокумента.Вставить("ДатаВыгрузки"   , Формат(ТекущаяДата(), "ДЛФ=DT"));
		СтруктураДокумента.Вставить("ИмяБазы"        , СокрЛП(Константы.База.Получить())); 
		СтруктураДокумента.Вставить("Товары"         , МодульРегламентныхЗаданий.ТаблицуВМассив(Товары));
		
		ЗаписьJSON = Новый ЗаписьJSON();
		ПараметрыЗаписиJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет , , Истина);
		ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписиJSON);
		ЗаписатьJSON(ЗаписьJSON, СтруктураДокумента);
		JsonСтрока = ЗаписьJSON.Закрыть();   
		
		НовоеСообщение.Сообщение = JsonСтрока;	
		
		ЗаголовкиСообщения = Новый СписокЗначений;
		ЗаголовкиСообщения.Добавить("document_type" , "ТоварыГруппыZДляГоловногоФилиала");
		ЗаголовкиСообщения.Добавить("content_type"  , "application/json");
		ЗаголовкиСообщения.Добавить("base_name"     , Константы.База.Получить());
		
		Свойства = Новый СписокЗначений;
		Свойства.Добавить("ТипСодержимого" , "application/json"); 
		Свойства.Добавить("ОтметкаВремени" , AMQP_РаботаСДокументами.ДатуВTimestamp(НовоеСообщение.ДатаВремяСобытия));   	
		Свойства.Добавить("Тип"            , "status"); 
		Свойства.Добавить("ИмяПриложения"  , Константы.AMQP_ИдентификаторИнформацСистемы.Получить());
		Свойства.Добавить("РежимДоставки"  , 2);
		Свойства.Добавить("НомерСообщения" , Строка(ID));
		
		Для Каждого Свойство Из Свойства Цикл
			
			НоваяСтрока              = НовоеСообщение.Свойства.Добавить();
			НоваяСтрока.Наименование = Свойство.Значение;
			НоваяСтрока.Значение     = Свойство.Представление;
			
		КонецЦикла;   	
		
		Если ЗначениеЗаполнено(ЗаголовкиСообщения) Тогда
			
			Для Каждого Заголовок Из ЗаголовкиСообщения Цикл
				
				НоваяСтрока              = НовоеСообщение.Заголовки.Добавить();
				НоваяСтрока.Наименование = Заголовок.Значение;
				НоваяСтрока.Значение     = Заголовок.Представление;
				
			КонецЦикла;   
			
		КонецЕсли;
		
		НовоеСообщение.Записать();
		
	Иначе
		
		ЗаписьЖурналаРегистрации("Товары группы Z для головного филиала", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Отстутствуют товары группы Z с ненулевыми свободными остатками");
		Возврат;
		
	КонецЕсли; 
	
КонецПроцедуры


Процедура ЗаписатьОшибкуВыгрузкиОстатковЦен(Задание , Набор , УдалитьЗаписи , ЕстьОшибка)
	
	Если УдалитьЗаписи Тогда
		Набор.Очистить();		
	КонецЕсли;
	
	Запись = Набор.Добавить();
	Запись.ДатаВыполнения = ТекущаяДата();
	Запись.Ошибка = ЕстьОшибка;
	Запись.Задание = Задание;
	
	Набор.Записать();

КонецПроцедуры

Процедура УдалениеConnectLockНаСервере() Экспорт
	
	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда 
		
		ЗаписьЖурналаРегистрации("Поиск и удаление connect lock на сервере", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Отменена работа регламентного задания из-за несоответствия параметров подключения к ИБ");
		Возврат;
		
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации("Удаление файла connect lock.Начало", УровеньЖурналаРегистрации.Информация,,,);
	
	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда 
		
		ЗаписьЖурналаРегистрации("Удаление файла connect lock.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
		"Отменена работа регламентного задания из-за несоответствия параметров подключения в ИБ");
		Возврат;
		
	КонецЕсли;	
	
	ИмяКаталогаСервера = "";
	ИмяFTPСервера = Константы.FTPВыгрузкаОстатковАдрес.Получить();
	
	Если Не ЗначениеЗаполнено(ИмяFTPСервера) Тогда
		
		ЗаписьЖурналаРегистрации("Удаление файла connect lock.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
		"Отменена попытка соединения с FTP: не заполнен адрес FTP сервера в константах.");
		Возврат;
		
	КонецЕсли;
	
	ЛогинFTPСервера = Константы.FTPВыгрузкаОстатковЛогин.Получить();
	ПарольFTPСервера = Константы.FTPВыгрузкаОстатковПароль.Получить();
	
	ЗаданаПапкаДляFTP = СокрЛП(Константы.FTPВыгрузкаОстатковКаталог.Получить());
	ИмяКаталогаСервера = ИмяКаталогаСервера + ?(ЗначениеЗаполнено(ЗаданаПапкаДляFTP), "" + ЗаданаПапкаДляFTP + "/", "");
	
	Попытка
		Соединение = Новый FTPСоединение(ИмяFTPСервера, "21", ЛогинFTPСервера,  ПарольFTPСервера, , Истина);
	Исключение
		
		ЗаписьЖурналаРегистрации("Удаление файла connect lock.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
		"Не удалось установить соединение с FTP. Удаление файла connect.lock не выполнено.");
		Возврат;
		
	КонецПопытки;
	
	ФайлНайден = Ложь;
	
	МассивНайденныхФайловНаСервере = Соединение.НайтиФайлы(ИмяКаталогаСервера + "connect.lock");
	
	Для Каждого ТекСтр Из МассивНайденныхФайловНаСервере Цикл
		
		Если ВРег(ТекСтр.Имя) = ВРег("connect.lock") Тогда
			
			ФайлНайден = Истина;
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ФайлНайден Тогда
		
		ЗаписьЖурналаРегистрации("Удаление файла connect lock.Завершение", УровеньЖурналаРегистрации.Информация,,, "Файл connect lock не найден на сервере.");
		Возврат;
		
	КонецЕсли;
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Метаданные", Метаданные.РегламентныеЗадания.ОбновлениеОстатковИЦенПолное);
	МассивРегЗаданий = РегламентныеЗадания.ПолучитьРегламентныеЗадания(СтруктураОтбора);
	
	Если МассивРегЗаданий.Количество() = 0 Тогда
		
		ЗаписьЖурналаРегистрации("Удаление файла connect lock.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
		"Регламентное задание ""Полное обновление остатков и цен"" не найдено." + Символы.ПС + ОписаниеОшибки());
		Возврат;
		
	КонецЕсли;
	
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ИмяМетода", МассивРегЗаданий[0].Метаданные.ИмяМетода);
	СтруктураПоиска.Вставить("Состояние", СостояниеФоновогоЗадания.Активно);
	МассивЗаданий = ФоновыеЗадания.ПолучитьФоновыеЗадания(СтруктураПоиска);
	
	Если МассивЗаданий.Количество() > 0 Тогда
		
		ЗаписьЖурналаРегистрации("Удаление файла connect lock.Завершение", УровеньЖурналаРегистрации.Информация,,, 
		"Файл connect.lock НЕ БЫЛ удален по причине активного фонового задания");
		Возврат;
		
	КонецЕсли;
	
	Попытка
		
		Соединение.Удалить(?(ЗначениеЗаполнено(ЗаданаПапкаДляFTP), ЗаданаПапкаДляFTP + "/", "") + "connect.lock");
		ЗаписьЖурналаРегистрации("Удаление файла connect lock.Обработка", УровеньЖурналаРегистрации.Информация,,, "Файл connect.lock успешно удален");
		
	Исключение
		ЗаписьЖурналаРегистрации("Удаление файла connect lock.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, "Ошибка при удалении файла connect.lock" + Символы.ПС + ОписаниеОшибки());
	КонецПопытки;
	
	ЗаписьЖурналаРегистрации("Удаление файла connect lock.Завершение", УровеньЖурналаРегистрации.Информация,,,);

КонецПроцедуры

Процедура ЗагрузкаОстатковДопПоставщика() Экспорт
	
	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда 
		
		ЗаписьЖурналаРегистрации("Загрузка остатков доп поставщика", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Отменена работа регламентного задания из-за несоответствия параметров подключения к ИБ");
		Возврат;
		
	КонецЕсли;	
	
	Если НЕ Константы.ПополнениеДляОбособленногоПодразделенияЮЛ.Получить() Тогда
		
		ЗаписьЖурналаРегистрации("Загрузка остатков доп поставщика", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Не установлена константа Пополнение для обособленного подразделения юр.лица");
		Возврат; 		
		
	КонецЕсли;	
	
	ЗаписьЖурналаРегистрации("Загрузка остатков доп поставщика", УровеньЖурналаРегистрации.Информация, , ,
	"Начата регламентная Загрузка остатков доп поставщика");
	
	Попытка		
		
		ВСПрокси = МСКWEB.СоздатьПодключение(Ложь, "");
		Ответ = ВСПрокси.GetRemainsDetachedDivision();
		
		Если ТипЗнч(Ответ) = Тип("ХранилищеЗначения") Тогда		
			
			Данные = МСКWEB.ХранилищеJSONВСтруктуру(Ответ);		
			
			Если ТипЗнч(Данные) = Тип("Структура") Тогда			
				
				ТаблицаОстатков = Данные.СписокДанных;
				
				Если ТаблицаОстатков.Количество() >= 0 Тогда
					
					Для Каждого СтрокаТаблОстатков ИЗ ТаблицаОстатков Цикл
						
						Если СтрокаТаблОстатков.СвободныйОстаток > 0
							ИЛИ СтрокаТаблОстатков.СвободныйОстатокТОХ > 0 Тогда										
							
							Если ЗначениеЗаполнено(СтрокаТаблОстатков.КодМДМ) Тогда
								
								ЕстьНоменклатура = Справочники.Номенклатура.НайтиПоРеквизиту("КодМДМ", СтрокаТаблОстатков.КодМДМ);
								
								Если ЕстьНоменклатура.Пустая() Тогда
									
									Если ЗначениеЗаполнено(СтрокаТаблОстатков.КодМДМ) Тогда
										ЕстьНоменклатура = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", СтрокаТаблОстатков.Артикул); 										
									КонецЕсли;
									
								КонецЕсли;
								
							КонецЕсли;
							
							Если НЕ ЕстьНоменклатура.Пустая() Тогда
								
								ЕстьЗаписьВРегистре = РегистрыСведений.МосковскиеОстаткиНоменклатуры.Получить(Новый Структура("Номенклатура", ЕстьНоменклатура));
								МенеджерЗаписи = РегистрыСведений.МосковскиеОстаткиНоменклатуры.СоздатьМенеджерЗаписи();
								
								Если ЕстьЗаписьВРегистре.Количество()<1 Тогда                                           									
									
									МенеджерЗаписи.Номенклатура = ЕстьНоменклатура;
									МенеджерЗаписи.Количество   = 0 ;
									МенеджерЗаписи.КоличествоДопПоставщика = СтрокаТаблОстатков.СвободныйОстаток;
									МенеджерЗаписи.КоличествоДопПоставщикаТОХ = СтрокаТаблОстатков.СвободныйОстатокТОХ; 
									
								Иначе
									
									МенеджерЗаписи.Номенклатура = ЕстьНоменклатура;
									МенеджерЗаписи.Количество   = ЕстьЗаписьВРегистре.Количество ;
									МенеджерЗаписи.КоличествоДопПоставщика = СтрокаТаблОстатков.СвободныйОстаток;
									МенеджерЗаписи.КоличествоДопПоставщикаТОХ = СтрокаТаблОстатков.СвободныйОстатокТОХ; 
									
								КонецЕсли;		
								
								МенеджерЗаписи.Записать();	
								
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЦикла;					
					
				КонецЕсли;			
				
			КонецЕсли;		
			
		КонецЕсли;
		
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
	
	ЗаписьЖурналаРегистрации("Загрузка остатков доп поставщика", УровеньЖурналаРегистрации.Информация, , ,
	"Закончена регламентная Загрузка остатков доп поставщика");	

КонецПроцедуры

Процедура ПоискНоменклатурыБезЕдиницИзмерения() Экспорт

	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда 
		
		ЗаписьЖурналаРегистрации("Номенклатура без единиц измерения.Предупреждение", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Отменена работа регламентного задания из-за несоответствия параметров подключения к ИБ");
		Возврат;
		
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации("Номенклатура без единиц измерения.Начало", УровеньЖурналаРегистрации.Информация, , ,
	"Начат поиск номенклатуры без единиц измерения");
	
	ЗапросНоменклатуры = Новый Запрос; 
	ЗапросНоменклатуры.Текст =	
	"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 100
	|	Номенклатура.Артикул
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	(Номенклатура.ЕдиницаХраненияОстатков = ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
	|			ИЛИ Номенклатура.ЕдиницаДляОтчетов = ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка))
	|	И Номенклатура.ПометкаУдаления = ЛОЖЬ
	|	И НЕ Номенклатура.Артикул ПОДОБНО ""%DMG""";
	
	РезультатЗапросаНоменклатуры = ЗапросНоменклатуры.Выполнить();
	
	Если НЕ РезультатЗапросаНоменклатуры.Пустой() Тогда
		
		ВыборкаЗапросаНоменклатуры = РезультатЗапросаНоменклатуры.Выбрать();
		СписокТоваров = "";
		
		Пока ВыборкаЗапросаНоменклатуры.Следующий() Цикл
			СписокТоваров = СписокТоваров + ?(СписокТоваров = "", "", ";") + СокрЛП(ВыборкаЗапросаНоменклатуры.Артикул);
		КонецЦикла;
		
		Если НЕ СписокТоваров = "" Тогда
			ЗаписьЖурналаРегистрации("Номенклатура без единиц измерения.Ошибка", УровеньЖурналаРегистрации.Ошибка, , , 
			"Список товаров без единиц измерения :"+ Символы.ПС+ СокрЛП(СписокТоваров) + "");
		КонецЕсли;		
		
	КонецЕсли;	
	
	ЗаписьЖурналаРегистрации("Номенклатура без единиц измерения.Конец", УровеньЖурналаРегистрации.Информация, , ,
	"Закончен поиск номенклатуры без единиц измерения");

КонецПроцедуры

