Процедура МониторингФоновыхЗаданий() Экспорт 

	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("Состояние", СостояниеФоновогоЗадания.Активно); 
	
	МассивЗаданий = ФоновыеЗадания.ПолучитьФоновыеЗадания(СтруктураПоиска); 
	
	Если МассивЗаданий.Количество() > 0 Тогда 
		
		ЗапросНастроек = Новый Запрос;
		ЗапросНастроек.Текст =
		"ВЫБРАТЬ
		|	НастройкиМониторингаРегламентныхЗаданий.РегламентноеЗадание,
		|	НастройкиМониторингаРегламентныхЗаданий.МаксимальноеВремяВыполнения
		|ИЗ
		|	РегистрСведений.НастройкиМониторингаРегламентныхЗаданий КАК НастройкиМониторингаРегламентныхЗаданий
		|ГДЕ
		|	НастройкиМониторингаРегламентныхЗаданий.МаксимальноеВремяВыполнения <> 0"; 
		
		ТаблицаНастроек = ЗапросНастроек.Выполнить().Выгрузить();
		
	КонецЕсли;
	
	СтандартноеВремяВыполнения = 60*40;
	
	Для Каждого ФонЗадание Из МассивЗаданий Цикл 
		
		НайденнаяСтрока = ?(ФонЗадание.РегламентноеЗадание = Неопределено, Неопределено, ТаблицаНастроек.Найти(ФонЗадание.РегламентноеЗадание.Метаданные.Имя, "РегламентноеЗадание")); 		
		
		МаксВремяВыполнения = ?(НайденнаяСтрока = Неопределено, СтандартноеВремяВыполнения, НайденнаяСтрока.МаксимальноеВремяВыполнения);
		
		ПревышеноВремяВыполнения = (ФонЗадание.Начало + МаксВремяВыполнения) < ТекущаяДата();
		
		Если ПревышеноВремяВыполнения Тогда
			
			СтруктураЗависшего = Новый Структура("Идентификатор, Наименование, ИмяМетода, ДатаНачала, МаксимальноеВремяВыполнения");
			
			СтруктураЗависшего.Идентификатор = Строка(ФонЗадание.УникальныйИдентификатор);
			СтруктураЗависшего.Наименование = ФонЗадание.Наименование;
			СтруктураЗависшего.ИмяМетода = ФонЗадание.ИмяМетода;
			СтруктураЗависшего.ДатаНачала = Формат(ФонЗадание.Начало, "ДЛФ=DT");  
			СтруктураЗависшего.МаксимальноеВремяВыполнения = МаксВремяВыполнения;
			
			ЗаписьЖурналаРегистрации("Мониторинг фоновых заданий.Зависшие", УровеньЖурналаРегистрации.Предупреждение,,, Чеки.ВернутьJSON(СтруктураЗависшего));
			
		КонецЕсли; 			
		
	КонецЦикла;  
	
КонецПроцедуры

Процедура ОтправкаЗаказовПоставщикамВSI() Экспорт

	ЗаписьЖурналаРегистрации("Отправка заказов поставшиков в SI", УровеньЖурналаРегистрации.Информация, , ,
	"Начата регламентная отправка закадов поставщиков в SI");
	
	ОбработкаОтправки = Обработки.СозданиеИОтправкаЗаказовСтороннимСкладам.Создать();
	
	ОбработкаОтправки.ДатаОтбора = ТекущаяДата();
	
	Результат = ОбработкаОтправки.ОтправитьЗаказыВSI();
	Если Не Результат = "" Тогда 
		ЗаписьЖурналаРегистрации("Отправка заказов поставшиков в SI", УровеньЖурналаРегистрации.Ошибка, , ,
		"" + Результат);
