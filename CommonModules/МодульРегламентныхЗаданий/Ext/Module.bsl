Процедура УстановкаЦенНоменклатурыСебестоимость() Экспорт    
	
	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда 
		
		ЗаписьЖурналаРегистрации("Установка цен номенклатуры себестоимость", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Отменена работа регламентного задания из-за несоответствия параметров подключения к ИБ");
		Возврат;
		
	КонецЕсли;
	
	КоличествоСтрокВДокументе = 25000;
	УдалятьПредыдущиеДокументы = Истина;
	Ответственный = Справочники.Пользователи.НайтиПоКоду("webadmin");
	
	//Удаление предыдущих перенесем после загрузки
	МассивТиповЦен =  Новый Массив;
	
	ЦенаСебестоимость = Константы.ЦенаСебестоимость.Получить();
	
	Если Не ЗначениеЗаполнено(ЦенаСебестоимость) Или Не ЗначениеЗаполнено(Ответственный) Тогда
		Возврат;
	КонецЕсли;	
	
	МассивТиповЦен.Добавить(ЦенаСебестоимость);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Склад", Константы.ОсновнойСклад.Получить());  
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТоварыОтветственногоХраненияОстатки.Номенклатура,
	|	СУММА(ТоварыОтветственногоХраненияОстатки.КоличествоОстаток - ЕСТЬNULL(ТоварыОтветственногоХраненияПереданныеОстатки.КоличествоОстаток, 0)) КАК ОстатокТОХ,
	|	СУММА(ЕСТЬNULL(ЦеныНоменклатурыКонтрагентовСрезПоследних.Цена, 0) * ТоварыОтветственногоХраненияОстатки.КоличествоОстаток) КАК СуммаТОХ,
	|	ТоварыОтветственногоХраненияОстатки.КоличествоОстаток КАК ОстатокДляЦены
	|ПОМЕСТИТЬ ВТ_ОстаткиТОХ
	|ИЗ
	|	РегистрНакопления.ТоварыОтветственногоХранения.Остатки(, ) КАК ТоварыОтветственногоХраненияОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыОтветственногоХраненияПереданные.Остатки(, ) КАК ТоварыОтветственногоХраненияПереданныеОстатки
	|		ПО ТоварыОтветственногоХраненияОстатки.Номенклатура = ТоварыОтветственногоХраненияПереданныеОстатки.Номенклатура
	|			И ТоварыОтветственногоХраненияОстатки.ХарактеристикаНоменклатуры = ТоварыОтветственногоХраненияПереданныеОстатки.ХарактеристикаНоменклатуры
	|			И ТоварыОтветственногоХраненияОстатки.ДоговорКонтрагента = ТоварыОтветственногоХраненияПереданныеОстатки.ДоговорКонтрагента
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатурыКонтрагентов.СрезПоследних(, ) КАК ЦеныНоменклатурыКонтрагентовСрезПоследних
	|		ПО ТоварыОтветственногоХраненияОстатки.Номенклатура = ЦеныНоменклатурыКонтрагентовСрезПоследних.Номенклатура
	|			И ТоварыОтветственногоХраненияОстатки.ДоговорКонтрагента.ТипЦен = ЦеныНоменклатурыКонтрагентовСрезПоследних.ТипЦен
	|ГДЕ
	|	ТоварыОтветственногоХраненияОстатки.КоличествоОстаток - ЕСТЬNULL(ТоварыОтветственногоХраненияПереданныеОстатки.КоличествоОстаток, 0) > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыОтветственногоХраненияОстатки.Номенклатура,
	|	ТоварыОтветственногоХраненияОстатки.КоличествоОстаток
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТоварыНаСкладахОстатки.Номенклатура,
	|	СУММА(ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0) - ЕСТЬNULL(ВТ_ОстаткиТОХ.ОстатокТОХ, 0)) КАК ОстатокНаСкладе
	|ПОМЕСТИТЬ ВТ_ОстаткиНаСкладах
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(, Склад = &Склад) КАК ТоварыНаСкладахОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОстаткиТОХ КАК ВТ_ОстаткиТОХ
	|		ПО ТоварыНаСкладахОстатки.Номенклатура = ВТ_ОстаткиТОХ.Номенклатура
	|ГДЕ
	|	ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0) - ЕСТЬNULL(ВТ_ОстаткиТОХ.ОстатокТОХ, 0) > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыНаСкладахОстатки.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПартииТоваровНаСкладахОстатки.Номенклатура,
	|	ПартииТоваровНаСкладахОстатки.Номенклатура.ЕдиницаХраненияОстатков КАК ЕдиницаХраненияОстатков,
	|	СУММА(ПартииТоваровНаСкладахОстатки.СтоимостьОстаток) КАК СтоимостьОстаток,
	|	СУММА(ПартииТоваровНаСкладахОстатки.КоличествоОстаток) КАК КоличествоОстаток
	|ПОМЕСТИТЬ ВТ_ОстаткиПоПартиям
	|ИЗ
	|	РегистрНакопления.ПартииТоваровНаСкладах.Остатки(
	|			,
	|			Склад = &Склад
	|				И Номенклатура В
	|					(ВЫБРАТЬ
	|						ОстаткиНаСкладах.Номенклатура
	|					ИЗ
	|						ВТ_ОстаткиНаСкладах КАК ОстаткиНаСкладах)) КАК ПартииТоваровНаСкладахОстатки
	|ГДЕ
	|	ПартииТоваровНаСкладахОстатки.КоличествоОстаток > 0
	|	И ПартииТоваровНаСкладахОстатки.СтоимостьОстаток > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ПартииТоваровНаСкладахОстатки.Номенклатура,
	|	ПартииТоваровНаСкладахОстатки.Номенклатура.ЕдиницаХраненияОстатков
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОстаткиПоПартиям.Номенклатура,
	|	ВТ_ОстаткиПоПартиям.СтоимостьОстаток / ВТ_ОстаткиПоПартиям.КоличествоОстаток КАК ЦенаПоПартиям
	|ПОМЕСТИТЬ ВТ_ЦеныПоПартиям
	|ИЗ
	|	ВТ_ОстаткиПоПартиям КАК ВТ_ОстаткиПоПартиям
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_ОстаткиНаСкладах.Номенклатура,
	|	СУММА(ВТ_ОстаткиНаСкладах.ОстатокНаСкладе) КАК Остаток,
	|	СУММА(ВТ_ОстаткиНаСкладах.ОстатокНаСкладе * ВТ_ЦеныПоПартиям.ЦенаПоПартиям) КАК Сумма
	|ПОМЕСТИТЬ ВТ_ОстаткиСкладИТОХ
	|ИЗ
	|	ВТ_ОстаткиНаСкладах КАК ВТ_ОстаткиНаСкладах
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЦеныПоПартиям КАК ВТ_ЦеныПоПартиям
	|		ПО ВТ_ОстаткиНаСкладах.Номенклатура = ВТ_ЦеныПоПартиям.Номенклатура
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ОстаткиНаСкладах.Номенклатура
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_ОстаткиТОХ.Номенклатура,
	|	СУММА(ЕСТЬNULL(ВТ_ОстаткиТОХ.ОстатокДляЦены, 0)),
	|	СУММА(ЕСТЬNULL(ВТ_ОстаткиТОХ.СуммаТОХ, 0))
	|ИЗ
	|	ВТ_ОстаткиТОХ КАК ВТ_ОстаткиТОХ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ОстаткиТОХ.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_ОстаткиСкладИТОХ.Номенклатура,
	|	СУММА(ВТ_ОстаткиСкладИТОХ.Сумма) КАК Сумма,
	|	СУММА(ВТ_ОстаткиСкладИТОХ.Остаток) КАК Остаток
	|ПОМЕСТИТЬ ВТ_Итог
	|ИЗ
	|	ВТ_ОстаткиСкладИТОХ КАК ВТ_ОстаткиСкладИТОХ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ОстаткиСкладИТОХ.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Итог.Номенклатура,
	|	ВТ_Итог.Номенклатура.ЕдиницаХраненияОстатков КАК ЕдиницаХраненияОстатков,
	|	ВЫРАЗИТЬ(ВТ_Итог.Сумма / ВТ_Итог.Остаток КАК ЧИСЛО(15, 2)) КАК Цена
	|ИЗ
	|	ВТ_Итог КАК ВТ_Итог
	|ГДЕ 
	|	ВТ_Итог.Остаток > 0
	|	И ВТ_Итог.Сумма / ВТ_Итог.Остаток > 0";
	
	РезЗапроса = Запрос.Выполнить();
	
	ТаблицаЦен = РезЗапроса.Выгрузить();
	
	//Создание документов Цен
	ДатаНачалаУдаления = ТекущаяДата() - 1;
	МаксимальнаяДатаДокумента = КонецДня(ТекущаяДата());
	ВалютаРубль = Константы.ВалютаРегламентированногоУчета.Получить();
	
	НовыйДокумент = СоздатьНовыйДокументЦен(МассивТиповЦен,Ответственный,МаксимальнаяДатаДокумента);
	СчетчикСтрокВДокументе = 0;
	
	Для Каждого ТекСтр Из ТаблицаЦен Цикл
		
		Для Сч = 0 По МассивТиповЦен.Количество() - 1 Цикл			
			
			НоваяСтрокаДокумента 						= НовыйДокумент.Товары.Добавить();
			НоваяСтрокаДокумента.Номенклатура 			= ТекСтр.Номенклатура;
			НоваяСтрокаДокумента.ЕдиницаИзмерения  		= ТекСтр.ЕдиницаХраненияОстатков;
			НоваяСтрокаДокумента.Цена 					= ТекСтр.Цена;
			ТекТипЦен									= МассивТиповЦен[Сч];
			НоваяСтрокаДокумента.ТипЦен 				= ТекТипЦен ;
			НоваяСтрокаДокумента.Валюта 		    	= ВалютаРубль;
			НоваяСтрокаДокумента.ИндексСтрокиТаблицыЦен = ТаблицаЦен.Индекс(ТекСтр);
			
			СчетчикСтрокВДокументе = СчетчикСтрокВДокументе + 1;			
			
		КонецЦикла;
		
		Если СчетчикСтрокВДокументе >= КоличествоСтрокВДокументе Тогда
			
			Попытка
				НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				
				НовыйДокумент.Записать();
				УдалятьПредыдущиеДокументы = Ложь;
				
			КонецПопытки;
			
			НовыйДокумент = СоздатьНовыйДокументЦен(МассивТиповЦен, Ответственный,МаксимальнаяДатаДокумента);
			СчетчикСтрокВДокументе = 0;
			
		КонецЕсли;
		
	КонецЦикла; 
	
	Если НовыйДокумент.Товары.Количество()> 0 Тогда
		
		Попытка
			НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			
			НовыйДокумент.Записать();
			УдалятьПредыдущиеДокументы = Ложь;
			
		КонецПопытки;
		
	КонецЕсли;
	
	
	//Удаление старых документов
	Если УдалятьПредыдущиеДокументы И ЗначениеЗаполнено(Ответственный) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	УстановкаЦенНоменклатурыТипыЦен.Ссылка
		|ИЗ
		|	Документ.УстановкаЦенНоменклатуры.ТипыЦен КАК УстановкаЦенНоменклатурыТипыЦен
		|ГДЕ
		|	УстановкаЦенНоменклатурыТипыЦен.Ссылка.Ответственный = &Ответственный
		|	И УстановкаЦенНоменклатурыТипыЦен.Ссылка.Дата < &Дата
		|
		|СГРУППИРОВАТЬ ПО
		|	УстановкаЦенНоменклатурыТипыЦен.Ссылка";
		
		Запрос.УстановитьПараметр("Дата", ДатаНачалаУдаления);
		Запрос.УстановитьПараметр("Ответственный", Ответственный);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Об = Выборка.Ссылка.ПолучитьОбъект();
			
			Попытка
				Об.Удалить();
			Исключение
				Об.УстановитьПометкуУдаления(Истина);
			КонецПопытки;
			
		КонецЦикла;		
		
	КонецЕсли;	
	
КонецПроцедуры

Функция ПолучитьНормализованныйКод(СтрТЗ)
	
	СтрТЗ.Производитель = СокрЛП(СтрТЗ.Производитель); 
	СтрокаПроверки = ВРег(СтрТЗ.Производитель);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 1
	|	Номенклатура.Ссылка,
	|	Номенклатура.Наименование КАК ИмяГруппы
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.ЭтоГруппа = ИСТИНА
	|	И Номенклатура.Наименование ПОДОБНО &ИмяПроизводителя
	|	И Номенклатура.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("ИмяПроизводителя", СтрокаПроверки);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		СтрокаПроверки = ВРег(СокрЛП(Выборка.ИмяГруппы));		
		СтрТЗ.Производитель = СокрЛП(Выборка.ИмяГруппы);
		
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 1
		|	СинонимыПроизводителей.Производитель КАК Производитель,
		|	СинонимыПроизводителей.СинонимПроизводителя
		|ИЗ
		|	РегистрСведений.СинонимыПроизводителей КАК СинонимыПроизводителей
		|ГДЕ
		|	СинонимыПроизводителей.СинонимПроизводителя = &СинонимПроизводителя";
		
		Запрос.УстановитьПараметр("СинонимПроизводителя",СтрокаПроверки);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			
			СтрокаПроверки = ВРег(СокрЛП(Выборка.Производитель));		
			СтрТЗ.Производитель = СокрЛП(Выборка.Производитель);
			
		КонецЕсли;
		
	КонецЕсли;
	
	ОчищенныйПроизводитель = "";	
	Длина = СтрДлина(СтрокаПроверки);  
	
	Для а = 1 По Длина Цикл
		
		Если Найти("0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyzАБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯабвгдеёжзийклмнопрстуфхцчшщъыьэюя", Сред(СтрокаПроверки, а, 1)) <> 0 Тогда
			ОчищенныйПроизводитель = ОчищенныйПроизводитель + Сред(СтрокаПроверки, а, 1);
		КонецЕсли; 
		
	КонецЦикла;	
	
	ОчищенныйКодПроизводителя = "";
	СтрокаПроверки = СокрЛП(СтрТЗ.Артикул);
	Длина = СтрДлина(СтрокаПроверки); 
	
	
	Для а = 1 По Длина Цикл
		
		Если Найти("0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyzАБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯабвгдеёжзийклмнопрстуфхцчшщъыьэюя", Сред(СтрокаПроверки, а, 1)) <> 0 Тогда
			ОчищенныйКодПроизводителя = ОчищенныйКодПроизводителя + Сред(СтрокаПроверки, а, 1);
		КонецЕсли;     
		
	КонецЦикла;
	
	НормализованныйКод = ОчищенныйПроизводитель+ОчищенныйКодПроизводителя;
	
	Возврат НормализованныйКод;
	
КонецФункции

Процедура СинхронизацияКодаАвардыСМДМ() Экспорт
	
	Запрос = Новый Запрос();
	
	Запрос.Текст = "ВЫБРАТЬ
	|	НеСозданныеЗаказыПокупателейТовары.Ссылка КАК НеСозданныйЗаказ,
	|	НеСозданныеЗаказыПокупателейТовары.Articul КАК Артикул,
	|	НеСозданныеЗаказыПокупателейТовары.Name КАК Наименование,
	|	НеСозданныеЗаказыПокупателейТовары.Brand КАК Производитель,
	|	НеСозданныеЗаказыПокупателейТовары.NumberInv КАК ИнвентарныйНомер,
	|	НеСозданныеЗаказыПокупателейТовары.Ссылка.ЗаказПокупателяСсылка
	|ПОМЕСТИТЬ НеСозданныеЗаказы
	|ИЗ
	|	Справочник.НеСозданныеЗаказыПокупателей.Товары КАК НеСозданныеЗаказыПокупателейТовары
	|ГДЕ
	|	НеСозданныеЗаказыПокупателейТовары.Ссылка.ЗапросОтправленВМДМ = ИСТИНА
	|	И НеСозданныеЗаказыПокупателейТовары.НеНайденаНоменклатура = ИСТИНА
	|	И НеСозданныеЗаказыПокупателейТовары.СинхронизированСМДМ = ЛОЖЬ
	|	И НеСозданныеЗаказыПокупателейТовары.Ссылка.ПометкаУдаления = ЛОЖЬ
	|	И НеСозданныеЗаказыПокупателейТовары.Ссылка.ЗаказПокупателяСсылка <> ЗНАЧЕНИЕ(Справочник.НеСозданныеЗаказыПокупателей.ПустаяСсылка)
	|	И НеСозданныеЗаказыПокупателейТовары.Ссылка.Дата МЕЖДУ &НачПериода И &КонПериода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПРЕДСТАВЛЕНИЕ(ЗаказПокупателяТовары.Номенклатура) КАК Номенклатура,
	|	ЗаказПокупателяТовары.Номенклатура.КодАварда КАК КодАварда,
	|	ЗаказПокупателяТовары.Номенклатура.КодМДМ КАК КодМДМ,
	|	ЗаказПокупателяТовары.Номенклатура.Артикул КАК ИнвНомер,
	|	НеСозданныеЗаказы.НеСозданныйЗаказ
	|ИЗ
	|	НеСозданныеЗаказы КАК НеСозданныеЗаказы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары
	|		ПО НеСозданныеЗаказы.ЗаказПокупателяСсылка = ЗаказПокупателяТовары.Ссылка
	|			И НеСозданныеЗаказы.Артикул = ЗаказПокупателяТовары.Номенклатура.КодПроизводителя
	|			И НеСозданныеЗаказы.Наименование = ЗаказПокупателяТовары.Номенклатура.Наименование
	|ГДЕ
	|	ЗаказПокупателяТовары.Номенклатура.КодАварда <> 0
	|	И ЗаказПокупателяТовары.Номенклатура.Артикул <> """"
	|	И ЗаказПокупателяТовары.Номенклатура.КодМДМ <> """"";
	
	Запрос.Параметры.Вставить("НачПериода",НачалоДня(ТекущаяДата()) - 864000);
	Запрос.Параметры.Вставить("КонПериода",КонецДня(ТекущаяДата()));
	
	РезЗапроса = Запрос.Выполнить(); 
	
	Если РезЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ТЗНоменклатуры = РезЗапроса.Выгрузить();	
	
	Ответ = МСКWEB.СинхронизироватьКодАвардыСМДМ(ТЗНоменклатуры);	
	
	Если Ответ = Истина Тогда      
		
		ТЗНоменклатуры.Свернуть("НеСозданныйЗаказ");
		
		Для Каждого СтрТЗ Из ТЗНоменклатуры Цикл
			
			НеСозданныйЗаказ = СтрТЗ.НеСозданныйЗаказ.ПолучитьОбъект();
			
			Для Каждого СтрТовары Из НеСозданныйЗаказ.Товары Цикл
				
				Если СтрТовары.НеНайденаНоменклатура = Истина Тогда
					СтрТовары.СинхронизированСМДМ = Истина;
				КонецЕсли;				
				
			КонецЦикла;			
			
			НеСозданныйЗаказ.Записать();
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПоискПоНормализованномуКоду(НормализованныйКод)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.НормализованныйКод = &НормализованныйКод
	|	И НЕ Номенклатура.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("НормализованныйКод", НормализованныйКод);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе 
		Возврат Неопределено;	
	КонецЕсли;
	
КонецФункции

Процедура ПроверитьНаличиеНоменклатуры()
	
	Запрос = Новый Запрос();
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НеСозданныеЗаказыПокупателейТовары.Ссылка КАК НеСозданныйЗаказ,
	|	НеСозданныеЗаказыПокупателейТовары.Articul КАК Артикул,
	|	НеСозданныеЗаказыПокупателейТовары.Name КАК Наименование,
	|	НеСозданныеЗаказыПокупателейТовары.Brand КАК Производитель,
	|	НеСозданныеЗаказыПокупателейТовары.NumberInv КАК ИнвентарныйНомер,
	|	НеСозданныеЗаказыПокупателейТовары.НеНайденаНоменклатура
	|ИЗ
	|	Справочник.НеСозданныеЗаказыПокупателей.Товары КАК НеСозданныеЗаказыПокупателейТовары
	|ГДЕ
	|	НеСозданныеЗаказыПокупателейТовары.Ссылка.ЗапросОтправленВМДМ = ИСТИНА
	|	И НеСозданныеЗаказыПокупателейТовары.Ссылка.НеНайденаНоменклатура = ИСТИНА
	|	И НеСозданныеЗаказыПокупателейТовары.НеНайденаНоменклатура = ИСТИНА
	|	И НеСозданныеЗаказыПокупателейТовары.Ссылка.ЗаказПокупателяСсылка = &ПустаяСсылка
	|	И НеСозданныеЗаказыПокупателейТовары.Ссылка.ПометкаУдаления = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	НеСозданныйЗаказ,
	|	Артикул";
	
	Запрос.Параметры.Вставить("ПустаяСсылка", Документы.ЗаказПокупателя.ПустаяСсылка());
	
	РезЗапроса = Запрос.Выполнить();
	
	Если РезЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ТЗНоменклатуры = РезЗапроса.Выгрузить();	
	ТЗНоменклатуры.Колонки.Добавить("НормализованныйКод");	
	
	Для Каждого СтрТЗ Из ТЗНоменклатуры Цикл 
		
		СтрТЗ.НормализованныйКод = ПолучитьНормализованныйКод(СтрТЗ);
		Ном = ПоискПоНормализованномуКоду(СтрТЗ.НормализованныйКод);
		
		Если ЗначениеЗаполнено(Ном) Тогда
			СтрТЗ.НеНайденаНоменклатура = Ложь;
		КонецЕсли;			
		
	КонецЦикла;
	
	НеСозданныйЗаказ = Неопределено;
	ТЗНоменклатуры.Свернуть("НеСозданныйЗаказ,НеНайденаНоменклатура");
	
	Для Каждого СтрТЗ Из ТЗНоменклатуры Цикл
		
		Отбор = Новый Структура("НеСозданныйЗаказ", СтрТЗ.НеСозданныйЗаказ);
		Рез = ТЗНоменклатуры.НайтиСтроки(Отбор);
		
		Если Рез.Количество() = 1 И Рез[0].НеНайденаНоменклатура = Ложь Тогда
			
			СпрОбъект = СтрТЗ.НеСозданныйЗаказ.ПолучитьОбъект();
			НомерЗаказа = СпрОбъект.Код; 
			Результат = СпрОбъект.СоздатьЗаказ();
			
			Если Результат = "" Тогда
				
				НомерЗаказа = СпрОбъект.ЗаказПокупателяСсылка.Номер; 
				СпрОбъект.НеНайденаНоменклатура = Ложь;				
				СпрОбъект.Записать();
				ЗаписьЖурналаРегистрации("НеСозданныйЗаказ.создание_заказа", УровеньЖурналаРегистрации.Информация,,, "Заказ " + НомерЗаказа + " успешно создан!");
				
			Иначе
				ЗаписьЖурналаРегистрации("НеСозданныйЗаказ.создание_заказа", УровеньЖурналаРегистрации.Ошибка,,, "Заказ " + НомерЗаказа 
				+ " не был создан по причине: " + Результат + "!");
			КонецЕсли;	
			
		КонецЕсли;	
		
	КонецЦикла;			
	
КонецПроцедуры

Процедура ОтправкаНоменклатурыВМДМ() Экспорт
	
	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда    
		
		ЗаписьЖурналаРегистрации("Отправка номенклатуры в МДМ", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Отменена работа регламентного задания из-за несоответствия параметров подключения к ИБ");
		Возврат;   
		
	КонецЕсли;   
	
	ОтправкаНоменклатурыВМДМ_Запуск();		
	                    
	ПроверитьСкидкиНаБрендыВНесозданныхЗаказах();   
		
КонецПроцедуры

Процедура ОтправкаНоменклатурыВМДМ_Запуск()
	
	Запрос = Новый Запрос();
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НеСозданныеЗаказыПокупателейТовары.Ссылка КАК НеСозданныйЗаказ,
	|	НеСозданныеЗаказыПокупателейТовары.Articul КАК Артикул,
	|	НеСозданныеЗаказыПокупателейТовары.Name КАК Наименование,
	|	НеСозданныеЗаказыПокупателейТовары.Brand КАК Производитель,
	|	НеСозданныеЗаказыПокупателейТовары.NumberInv КАК ИнвентарныйНомер,
	|	НеСозданныеЗаказыПокупателейТовары.Ссылка.SkladID КАК SkladID,
	|	Константы.AMQP_ИдентификаторИнформацСистемы КАК База,
	|	ВЫБОР
	|		КОГДА ВложенныйЗапрос.Идентификатор ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК Поле1
	|ИЗ
	|	Справочник.НеСозданныеЗаказыПокупателей.Товары КАК НеСозданныеЗаказыПокупателейТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			СторонниеСклады.Ссылка КАК Ссылка,
	|			СторонниеСклады.Идентификатор КАК Идентификатор
	|		ИЗ
	|			Справочник.СторонниеСклады КАК СторонниеСклады
	|		
	|		ОБЪЕДИНИТЬ ВСЕ
	|		
	|		ВЫБРАТЬ
	|			СобственныеСклады.Ссылка,
	|			СобственныеСклады.Идентификатор
	|		ИЗ
	|			Справочник.СобственныеСклады КАК СобственныеСклады
	|		ГДЕ
	|			СобственныеСклады.СоздаватьНоменклатуруВМДМ) КАК ВложенныйЗапрос
	|		ПО НеСозданныеЗаказыПокупателейТовары.Ссылка.SkladID = ВложенныйЗапрос.Идентификатор,
	|	Константы КАК Константы
	|ГДЕ
	|	НеСозданныеЗаказыПокупателейТовары.Ссылка.ЗапросОтправленВМДМ = ЛОЖЬ
	|	И НеСозданныеЗаказыПокупателейТовары.Ссылка.НеНайденаНоменклатура = ИСТИНА
	|	И НеСозданныеЗаказыПокупателейТовары.Ссылка.ЗаказПокупателяСсылка = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	|	И НеСозданныеЗаказыПокупателейТовары.Ссылка.ПометкаУдаления = ЛОЖЬ
	|	И ВЫБОР
	|			КОГДА ВложенныйЗапрос.Идентификатор ЕСТЬ NULL
	|				ТОГДА ЛОЖЬ
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ = ИСТИНА
	|
	|УПОРЯДОЧИТЬ ПО
	|	НеСозданныйЗаказ,
	|	Артикул";
	
	РезЗапроса = Запрос.Выполнить();  
	
	Если РезЗапроса.Пустой() Тогда    
		
		ПроверитьНаличиеНоменклатуры();
		СинхронизацияКодаАвардыСМДМ();
		ПерезаписатьНоменклатуруВМДМ();
		Возврат;     
		
	КонецЕсли;
	
	ПерезаписатьНоменклатуруВМДМ();
	
	ТЗНоменклатуры = РезЗапроса.Выгрузить();	
	ТЗНоменклатуры.Колонки.Добавить("НормализованныйКод");	
	
	МассивСтрок = Новый Массив;
	
	Для Каждого СтрТЗ Из ТЗНоменклатуры Цикл  
		
		СтрТЗ.НормализованныйКод = ПолучитьНормализованныйКод(СтрТЗ);		
		Ном = ПоискПоНормализованномуКоду(СтрТЗ.НормализованныйКод); 
		
		Если ЗначениеЗаполнено(Ном) Тогда
			//Заполним массив уже созданных номенклатур
			МассивСтрок.Добавить(СтрТЗ);
		КонецЕсли;      
		
	КонецЦикла;	
	
	//Удалим из таблицы существующую номенклатуру перед отправкой
	Для Сч = 0 По МассивСтрок.Количество()-1 Цикл   
		
		ТекСтр = МассивСтрок[Сч];
		НеСозданныйЗаказСсылка = ТекСтр.НеСозданныйЗаказ;
		ТЗНоменклатуры.Удалить(ТекСтр);
		
		Отбор = Новый Структура("НеСозданныйЗаказ", НеСозданныйЗаказСсылка);
		Рез = ТЗНоменклатуры.НайтиСтроки(Отбор);  
		
		Если Рез.Количество() = 0 Тогда         
			
			//Если в заказе вся номенклатура уже существует, то помечаем документ как отправленный в МДМ
			НеСозданныйЗаказ = НеСозданныйЗаказСсылка.ПолучитьОбъект();
			НеСозданныйЗаказ.ЗапросОтправленВМДМ = Истина;
			НеСозданныйЗаказ.Записать();     
			
		КонецЕсли;	
		
	КонецЦикла;
	
	Если ТЗНоменклатуры.Количество() = 0 Тогда 
		
		ПроверитьНаличиеНоменклатуры();
		СинхронизацияКодаАвардыСМДМ();
		Возврат;     
		
	КонецЕсли;	
	
	Ответ = МСКWEB.ОтправитьНоменклатуруВМДМ(ТЗНоменклатуры);
	
	Если Ответ = Истина Тогда  
		
		ТЗНоменклатуры.Свернуть("НеСозданныйЗаказ");  
		
		Для Каждого СтрТЗ Из ТЗНоменклатуры Цикл   
			
			НеСозданныйЗаказ = СтрТЗ.НеСозданныйЗаказ.ПолучитьОбъект();
			НеСозданныйЗаказ.ЗапросОтправленВМДМ = Истина;
			НеСозданныйЗаказ.Записать(); 
			
		КонецЦикла;      
		
	КонецЕсли;
	
	ПроверитьНаличиеНоменклатуры();
	СинхронизацияКодаАвардыСМДМ();
	
КонецПроцедуры

Процедура ПроверитьСкидкиНаБрендыВНесозданныхЗаказах() Экспорт

	Запрос = Новый Запрос();
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НеСозданныеЗаказыПокупателейТовары.Ссылка КАК НеСозданныйЗаказ,
	|	НеСозданныеЗаказыПокупателейТовары.Brand КАК Производитель,
	|	НеСозданныеЗаказыПокупателейТовары.НомерСтроки КАК НомерСтроки,
	|	НеСозданныеЗаказыПокупателейТовары.Price КАК Цена,
	|	НеСозданныеЗаказыПокупателейТовары.ЦенаОтгрузки КАК МинимальнаяЦена,
	|	НеСозданныеЗаказыПокупателейТовары.Кратность
	|ИЗ
	|	Справочник.НеСозданныеЗаказыПокупателей.Товары КАК НеСозданныеЗаказыПокупателейТовары
	|ГДЕ
	|	НеСозданныеЗаказыПокупателейТовары.Ссылка.ЗаказПокупателяСсылка = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	|	И НеСозданныеЗаказыПокупателейТовары.Ссылка.ПометкаУдаления = ЛОЖЬ
	|	И НЕ НеСозданныеЗаказыПокупателейТовары.ПроверенаСкидкаНаБренд
	|	И НеСозданныеЗаказыПокупателейТовары.Причина = ""Откл. цены""
	|	И НеСозданныеЗаказыПокупателейТовары.Ссылка.EMailЗаказ
	|
	|УПОРЯДОЧИТЬ ПО
	|	НеСозданныйЗаказ
	|ИТОГИ
	|	МАКСИМУМ(Производитель),
	|	МАКСИМУМ(НомерСтроки),
	|	МАКСИМУМ(Цена),
	|	МАКСИМУМ(МинимальнаяЦена)
	|ПО
	|	НеСозданныйЗаказ";
	
	ВыборкаЗаказы = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
	
	Пока ВыборкаЗаказы.Следующий() Цикл
		
		НеСозданныйЗаказ = ВыборкаЗаказы.НеСозданныйЗаказ;
		
		РезультатЗапросаСкидок = МСКWEB.ПолучитьДанныеПоСкидкамНаБренды(НеСозданныйЗаказ.DogovorID);
		
		Если Не РезультатЗапросаСкидок.Результат Тогда
			
			ЗаписьЖурналаРегистрации("Проверка скидок на бренды в несозданных заказах", УровеньЖурналаРегистрации.Ошибка, ,НеСозданныйЗаказ, РезультатЗапросаСкидок.Сообщение);
			Продолжить;
			
		КонецЕсли; 
		
		СкидкиНаБренды = РезультатЗапросаСкидок.Данные;
		
		ОбЗаказ = НеСозданныйЗаказ.ПолучитьОбъект();
		
		ВыборкаСтроки = ВыборкаЗаказы.Выбрать(); 		
		
		Пока ВыборкаСтроки.Следующий() Цикл
			
			СтрокаПроверки = ОбЗаказ.Товары[ВыборкаСтроки.НомерСтроки - 1]; 
			СтрокаПроверки.ПроверенаСкидкаНаБренд = Истина;
			
			Скидка = 0;
			
			Для каждого СкидкаСтруктура Из СкидкиНаБренды Цикл
				
				Если НРег(ВыборкаСтроки.Производитель) = НРег(СкидкаСтруктура.Бренд) Тогда
					
					Скидка = СкидкаСтруктура.Скидка;
					Прервать;
					
				КонецЕсли;
				
			КонецЦикла;
			
			Если ЗначениеЗаполнено(Скидка) Тогда
				
				Цена = ВыборкаСтроки.Цена;           
				МинимальнаяЦена = ВыборкаСтроки.МинимальнаяЦена * (1 - Скидка/100);
								
				Если Цена >= МинимальнаяЦена Тогда
					
					Если ЗначениеЗаполнено(СтрокаПроверки.Кратность) Тогда
						
						РезультатДеления = СтрокаПроверки.Count/СтрокаПроверки.Кратность; 
						
						ЦелаяЧасть = Цел(РезультатДеления);
						Если РезультатДеления = ЦелаяЧасть Тогда
							ПромКоличество = СтрокаПроверки.Count; 
						Иначе
							ПромКоличество = ЦелаяЧасть*СтрокаПроверки.Кратность;
						КонецЕсли;
						
						Если НЕ ПромКоличество = 0 Тогда
							СтрокаПроверки.РазрешеноКОтгрузке = ПромКоличество; 
						КонецЕсли;
						
					Иначе
						СтрокаПроверки.РазрешеноКОтгрузке = СтрокаПроверки.Count; 
					КонецЕсли;
					
					
				КонецЕсли;                   		                         			
				
			КонецЕсли;
			
		КонецЦикла; 
		
		ОбЗаказ.Записать();
		
		//Создаем заказ если все разрешено к отгрузке
		Если ОбЗаказ.Товары.НайтиСтроки(Новый Структура("РазрешеноКОтгрузке", 0)).Количество() = 0 Тогда			
			ОбЗаказ.СоздатьЗаказ(Ложь, "Создан регламентным заданием из справочника несозданных заказов");                                                                     					
		КонецЕсли;
			
	КонецЦикла;
	
КонецПроцедуры

Процедура ПерезаписатьНоменклатуруВМДМ()
	
	КонстантаАдрес = Константы.АдресВебСервисаМДМ.Получить();
	
	Если ЗначениеЗаполнено(КонстантаАдрес) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	НеСозданныеЗаказыПокупателей.Ссылка
		|ИЗ
		|	Справочник.НеСозданныеЗаказыПокупателей КАК НеСозданныеЗаказыПокупателей
		|ГДЕ
		|	НеСозданныеЗаказыПокупателей.ЗапросОтправленВМДМ
		|	И НеСозданныеЗаказыПокупателей.КоличествоПовторныхЗапросовВМДМ < 1
		|	И НеСозданныеЗаказыПокупателей.НеНайденаНоменклатура
		|	И НеСозданныеЗаказыПокупателей.ЗаказПокупателяСсылка = &ПустойЗаказ
		|	И НеСозданныеЗаказыПокупателей.Дата <= &Дата
		|	И НЕ НеСозданныеЗаказыПокупателей.ПометкаУдаления";
		
		Запрос.УстановитьПараметр("ПустойЗаказ", Документы.ЗаказПокупателя.ПустаяСсылка());
		Запрос.УстановитьПараметр("Дата", ТекущаяДата() - 60*30);
		
		АдресВебСервиса = "http://" + КонстантаАдрес + "/ws/NomenclatureCreation.1cws?wsdl";
		ВСОпределение = Новый WSОпределения(АдресВебСервиса,,,, 10);
		ВСПрокси = Новый WSПрокси(ВСОпределение, "Data", "NomenclatureCreation", "NomenclatureCreationSoap");
		
		Выборка = Запрос.Выполнить().Выбрать(); 
		
		МассивЗаказов = Новый Массив;
		МассивНоменклатуры = Новый Массив;
		
		Пока Выборка.Следующий() Цикл
			
			Заказ = Выборка.Ссылка;
			
			ТоварыПоиска = Заказ.Товары.НайтиСтроки(Новый Структура("НеНайденаНоменклатура", Истина)); 
			
			Для каждого Стр Из ТоварыПоиска Цикл
				
				НормализованныйКод = ПолучитьНормализованныйКод(Новый Структура("Артикул,Производитель", Стр.Articul, Стр.Brand));
				
				МассивНоменклатуры.Добавить(Новый Структура("Артикул,НормализованныйКод", Стр.Articul, НормализованныйКод));
				
			КонецЦикла; 
			
			ЗаказОб = Заказ.ПолучитьОбъект();
			ЗаказОб.КоличествоПовторныхЗапросовВМДМ = ЗаказОб.КоличествоПовторныхЗапросовВМДМ + 1;
			
			МассивЗаказов.Добавить(ЗаказОб);
					
		КонецЦикла; 
		
		Если МассивНоменклатуры.Количество() > 0 Тогда
			
			Попытка		
				
				ЗаписьЖурналаРегистрации("Перезапись номенклатуры в МДМ.Начало", УровеньЖурналаРегистрации.Информация,,, "NomenclatureCreation.ПерезаписатьНоменклатуру");
				
				ОтветJSON = ВСПрокси.ПерезаписатьНоменклатуру(ОбщегоНазначения.ВернутьJSON(МассивНоменклатуры));  
				
				ОтветСтруктура = ОбщегоНазначения.ВернутьСтруктуруИзJSON(ОтветJSON);
				
				ЗаписьЖурналаРегистрации("Перезапись номенклатуры в МДМ.Окончание", УровеньЖурналаРегистрации.Информация,,, 
				"NomenclatureCreation.ПерезаписатьНоменклатуру.получение_ответа" + Символы.ПС + ОтветСтруктура.Сообщение);	
				
				Для каждого ЗаказОб Из МассивЗаказов Цикл
					ЗаказОб.Записать();	
				КонецЦикла;
				
			Исключение
				
				ЗаписьЖурналаРегистрации("Перезапись номенклатуры в МДМ.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
				"GoodsReserve.ПерезаписатьНоменклатуру.получение_ответа " + ОписаниеОшибки());
				Сообщить(ОписаниеОшибки());		
				
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры  

