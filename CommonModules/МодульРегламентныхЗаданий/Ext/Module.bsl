Процедура ОтправкаЗаказовЭкспресс() Экспорт
	
	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда 
		
		ЗаписьЖурналаРегистрации("Отправка заказов Экспресс", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Отменена работа регламентного задания из-за несоответствия параметров подключения к ИБ");
		Возврат;
		
	КонецЕсли;
	
	Если Не Константы.ОтправлятьЭкспрессАвтоматически.Получить() тогда
		Возврат;
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации("Отправка заказов Экспресс", УровеньЖурналаРегистрации.Информация, , ,
	"Начато регламентное создание закадов Экспресс и отправка их в Аварду");
	
	НовыйОтчет = Отчеты.АнализЗаказовПокупателей.Создать();
	НовыйОтчет.УстановитьНачальныеНастройки_Сервер(); 
	
	//ПоОсновномуПоставщику,Форма,IDСклада,ЗапущеноРегламентом,РекламнаяПродукция,СкладскиеЗаказы,ПоСкладамИсключениям,РежимГорючиеЖидкости(0 не фильтруем , 
	//1 не горючие жидкости , 2 горючие жидкости) 
	НовыйОтчет.ЗаказПоставщику(Истина, Неопределено, , Истина,       , Ложь   ,Ложь, 1); // По негорючим жидкостям
	НовыйОтчет.ЗаказПоставщику(Истина, Неопределено, , Истина,       , Ложь   ,Ложь, 2); // по горючим жидкостям
	НовыйОтчет.ЗаказПоставщику(Истина, Неопределено, , Истина, 		 , Истина ,Ложь);   // по складам исключениям
	НовыйОтчет.ЗаказПоставщику(Истина, Неопределено, , Истина, Истина,        ,Ложь);   // Создание заказов по рекламной номенклатуре
    
	Запрос = Новый запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗаказПоставщику.Ссылка
	|ИЗ
	|	Документ.ЗаказПоставщику КАК ЗаказПоставщику
	|ГДЕ
	|	ЗаказПоставщику.Дата >= &Дата
	|	И ЗаказПоставщику.Проведен = ИСТИНА
	|	И ЗаказПоставщику.Экспресс = ИСТИНА
	|	И ЗаказПоставщику.IDСклада = &IDСклада
	|	И ЗаказПоставщику.ГУИДЗаказаПокупателя = """"
	|	И ЗаказПоставщику.КодОтправкиАварда = """"
	|	И ЗаказПоставщику.Контрагент = &ОсновнойПоставщик
	|	И ЗаказПоставщику.IDСкладаСобственныйСклад = &IDСкладаСобственныйСклад";   
	
	Запрос.УстановитьПараметр("IDСкладаСобственныйСклад", Справочники.СобственныеСклады.ПустаяСсылка());
	Запрос.УстановитьПараметр("Дата", ТекущаяДата() - 300);
	Запрос.УстановитьПараметр("IDСклада", Справочники.СторонниеСклады.ПустаяСсылка());
	Запрос.УстановитьПараметр("ОсновнойПоставщик",Константы.ОсновнойПоставщик.Получить()); 
	
	Выб = Запрос.Выполнить().Выбрать();   
	
	Пока Выб.Следующий() Цикл
		РаботаСАвардой.ОтправитьЗаказВЦСВАварду(Выб.Ссылка);
	КонецЦикла;                      
	
	Запрос.УстановитьПараметр("Дата", НачалоДня(ТекущаяДата()));	
	
	Выб = Запрос.Выполнить().Выбрать();    
	
	Пока Выб.Следующий() Цикл
		РаботаСАвардой.ОтправитьЗаказВЦСВАварду(Выб.Ссылка);
	КонецЦикла;               
	
	Запрос.УстановитьПараметр("Дата", НачалоДня(ТекущаяДата()));	 
	Выб = Запрос.Выполнить().Выбрать();        
	
	Пока Выб.Следующий() Цикл
		РаботаСАвардой.ОтправитьЗаказВЦСВАварду(Выб.Ссылка);
	КонецЦикла;
	
	Если ТекущаяДата() - Константы.ВремяПоследнейОтправкиВАварду.Получить() > 3600 тогда     
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ВремяОтправкиЭкспрессаВремена.Время КАК Время
		|ИЗ
		|	Справочник.ВремяОтправкиЭкспресса.Времена КАК ВремяОтправкиЭкспрессаВремена
		|
		|УПОРЯДОЧИТЬ ПО
		|	Время";       
		
		Выб = Запрос.Выполнить().Выбрать();
		Отправлять = Ложь;
		Откл = Константы.ДопустимоеОтклонениеОтВремениОтправки.Получить(); 
		
		Пока Выб.Следующий() Цикл       
			
			Время = Дата(Формат(ТекущаяДата(), "ДФ=""ггггММдд""") + Формат(Выб.Время, "ДФ=""ЧЧммсс"""));
			
			Если ТекущаяДата() > Время - Откл * 60 И ТекущаяДата() < Время + Откл * 60 тогда
				
				Отправлять = Истина;
				Прервать;
				
			КонецЕсли;     
			
		КонецЦикла;        
		
		Если Отправлять Тогда 
			
			Запрос = Новый запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	ЗаказПоставщику.Ссылка
			|ИЗ
			|	Документ.ЗаказПоставщику КАК ЗаказПоставщику
			|ГДЕ
			|	ЗаказПоставщику.Дата >= &Дата
			|	И ЗаказПоставщику.Проведен = ИСТИНА
			|	И ЗаказПоставщику.Экспресс = ИСТИНА
			|	И ЗаказПоставщику.IDСклада = &IDСклада
			|	И ПОДСТРОКА(ЗаказПоставщику.КодОтправкиАварда, 0, 3) = ""ЗПп""
			|
			|УПОРЯДОЧИТЬ ПО
			|	ЗаказПоставщику.Дата УБЫВ";   
			
			Запрос.УстановитьПараметр("Дата", НачалоДня(ТекущаяДата()));
			Запрос.УстановитьПараметр("IDСклада", Справочники.СторонниеСклады.ПустаяСсылка());
			
			Выб = Запрос.Выполнить().Выбрать();
			СписОтправленных = Новый СписокЗначений;
			
			Пока Выб.Следующий() Цикл
				
				Если СписОтправленных.НайтиПоЗначению(Выб.Ссылка.IDАварда) = Неопределено тогда
					
					РаботаСАвардой.ОтправитьЗаказВРаботу(Выб.Ссылка);
					СписОтправленных.Добавить(Выб.Ссылка.IDАварда);
					Константы.ВремяПоследнейОтправкиВАварду.Установить(ТекущаяДата());
					
				КонецЕсли;
				
			Конеццикла;
			
		КонецЕсли;
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации("Отправка заказов Экспресс", УровеньЖурналаРегистрации.Информация, , ,
	"Закончено регламентное создание закадов Экспресс и отправка их в Аварду");
	
КонецПроцедуры

