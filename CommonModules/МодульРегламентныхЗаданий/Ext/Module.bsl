	ВременныйКаталог = КаталогВременныхФайлов() + ИмяВременногоКаталога + "\";
	Текст.Записать(ВременныйКаталог + "update.price");

	ПолноеИмяФайлаАрхива = ПолучитьИмяВременногоФайла("zip");
