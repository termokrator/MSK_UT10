	Заголовки.Добавить("price_id"     , Константы.FTPВыгрузкаОстатковКаталог.Получить());
	Заголовки.Добавить("price_mdmid"  , Константы.ОсновнойСклад.Получить().КодМДМПрайсЛиста);
	
	
	Свойства = Новый СписокЗначений;
	Свойства.Добавить("ТипСодержимого" , "application/json"); 
