Процедура ПеренестиНоменклатуруСНулевымиОстаткамиИзУценки() Экспорт
	
	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда 
		
		ЗаписьЖурналаРегистрации("Перенос номенклатуры из уценки", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Отменена работа регламентного задания из-за несоответствия параметров подключения к ИБ");
		Возврат;
		
	КонецЕсли;	
	
	ЗаписьЖурналаРегистрации("Перенос номенклатуры из уценки", УровеньЖурналаРегистрации.Информация, , ,
	"Начат регламентный перенос номенклатуры с нулевыми остатками из уценки");
	
	Если Константы.ИспользоватьГруппуНоменклатурыУценка.Получить() И 
		ЗначениеЗаполнено(Константы.ГруппаНоменклатурыУценка.Получить()) Тогда 
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка,
		|	Номенклатура.ПредыдущийРодитель
		|ПОМЕСТИТЬ НоменклатураУценка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	НЕ Номенклатура.ЭтоГруппа
		|	И Номенклатура.Ссылка В ИЕРАРХИИ (&Уценка)
		|	И НЕ Номенклатура.ПометкаУдаления
		|	И Номенклатура.ПредыдущийРодитель <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	НоменклатураУценка.Ссылка,
		|	НоменклатураУценка.ПредыдущийРодитель
		|ИЗ
		|	НоменклатураУценка КАК НоменклатураУценка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки(
		|				,
		|				Номенклатура В
		|						(ВЫБРАТЬ
		|							НоменклатураУценка.Ссылка
		|						ИЗ
		|							НоменклатураУценка КАК НоменклатураУценка)
		|					И Склад = &ОсновнойСклад) КАК ТоварыНаСкладахОстатки
		|		ПО НоменклатураУценка.Ссылка = ТоварыНаСкладахОстатки.Номенклатура
		|ГДЕ
		|	ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0) = 0";
		
		Запрос.УстановитьПараметр("ОсновнойСклад", Константы.ОсновнойСклад.Получить());
		Запрос.УстановитьПараметр("Уценка", Константы.ГруппаНоменклатурыУценка.Получить());
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			ТекОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
			ТекОбъект.Родитель = ВыборкаДетальныеЗаписи.ПредыдущийРодитель;
			ТекОбъект.Записать();
			
		КонецЦикла;
		
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации("Перенос номенклатуры из уценки", УровеньЖурналаРегистрации.Информация, , ,
	"Закончен регламентный перенос номенклатуры с нулевыми остатками из уценки");
	
КонецПроцедуры

