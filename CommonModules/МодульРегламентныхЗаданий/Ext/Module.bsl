Процедура СформироватьВыводыИзОборотаПоТН()
	
	//+Сёмин Р.И. 21.04.2026 #UT10-5815
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТребованиеНакладная.Ссылка
		|ПОМЕСТИТЬ ВТ_ТребованияНакладные
		|ИЗ
		|	Документ.ТребованиеНакладная КАК ТребованиеНакладная
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВыводИзОборотаКИЗ КАК ВыводИзОборотаКИЗ
		|		ПО ТребованиеНакладная.Ссылка = ВыводИзОборотаКИЗ.Основание
		|			И (ВыводИзОборотаКИЗ.Проведен)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
		|		ПО ТребованиеНакладная.Ссылка = ЗначенияСвойствОбъектов.Объект
		|			И (ЗначенияСвойствОбъектов.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СвойстваОбъектов.ТоварПередан))
		|			И (ЗначенияСвойствОбъектов.Значение = ИСТИНА)
		|ГДЕ
		|	ТребованиеНакладная.Дата >= &ДатаНачала
		|	И ТребованиеНакладная.Проведен
		|	И ТребованиеНакладная.СборкаЗаказовПокупателя.Договор.УсловияРаботыСЧЗ = ЗНАЧЕНИЕ(Перечисление.УсловияРаботыСЧЗ.ПокупкаДляСобственныхНужд)
		|	И ВыводИзОборотаКИЗ.Ссылка ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ТребованияНакладные.Ссылка КАК ТребованиеНакладная,
		|	ТребованиеНакладнаяКодыМаркировки.КодМаркировки
		|ПОМЕСТИТЬ ВТ_ТребованияНакладныеСКодамиМаркировки
		|ИЗ
		|	ВТ_ТребованияНакладные КАК ВТ_ТребованияНакладные
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ТребованиеНакладная.КодыМаркировки КАК ТребованиеНакладнаяКодыМаркировки
		|		ПО ВТ_ТребованияНакладные.Ссылка = ТребованиеНакладнаяКодыМаркировки.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ТребованияНакладныеСКодамиМаркировки.ТребованиеНакладная КАК ТребованиеНакладная,
		|	ВТ_ТребованияНакладныеСКодамиМаркировки.КодМаркировки.Номенклатура.ТоварнаяГруппаЧестногоЗнака КАК ТоварнаяГруппаЧестногоЗнака,
		|	ВТ_ТребованияНакладныеСКодамиМаркировки.КодМаркировки КАК КодМаркировки,
		|	ТоварыВСборкеОбороты.СуммаСобраноОборот / ТоварыВСборкеОбороты.СобраноОборот КАК Цена
		|ИЗ
		|	ВТ_ТребованияНакладныеСКодамиМаркировки КАК ВТ_ТребованияНакладныеСКодамиМаркировки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВСборке.Обороты(, , Регистратор, ) КАК ТоварыВСборкеОбороты
		|		ПО ВТ_ТребованияНакладныеСКодамиМаркировки.ТребованиеНакладная = ТоварыВСборкеОбороты.Регистратор
		|			И ВТ_ТребованияНакладныеСКодамиМаркировки.КодМаркировки.Номенклатура = ТоварыВСборкеОбороты.Номенклатура
		|ИТОГИ
		|	МАКСИМУМ(Цена)
		|ПО
		|	ТребованиеНакладная,
		|	ТоварнаяГруппаЧестногоЗнака";
	
	Запрос.УстановитьПараметр("ДатаНачала", ДобавитьМесяц(ТекущаяДата(), -1));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаТребованиеНакладная = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаТребованиеНакладная.Следующий() Цикл
		
		ТребованиеНакладная = ВыборкаТребованиеНакладная.ТребованиеНакладная;
	
		ВыборкаТоварнаяГруппаЧестногоЗнака = ВыборкаТребованиеНакладная.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
		Пока ВыборкаТоварнаяГруппаЧестногоЗнака.Следующий() Цикл
			
			ТоварнаяГруппаЧестногоЗнака = ВыборкаТоварнаяГруппаЧестногоЗнака.ТоварнаяГруппаЧестногоЗнака;
			
			НовыйДокумент = Документы.ВыводИзОборотаКИЗ.СоздатьДокумент();
			НовыйДокумент.Дата = ТекущаяДата();
			НовыйДокумент.Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТребованиеНакладная, "Организация");
			НовыйДокумент.ВидПродукции = ТоварнаяГруппаЧестногоЗнака;
			НовыйДокумент.Основание = ТребованиеНакладная;
			НовыйДокумент.Комментарий = "Создан регламентным заданием";
			НовыйДокумент.Статус = Перечисления.СтатусыВыводИзОборотаКИЗ.Отправлен;
			НовыйДокумент.Ответственный = Пользователи.ТекущийПользователь();
	
			ВыборкаКодыМаркировки = ВыборкаТоварнаяГруппаЧестногоЗнака.Выбрать();
	
			Пока ВыборкаКодыМаркировки.Следующий() Цикл
				
				Номенклатура = ВыборкаКодыМаркировки.КодМаркировки.Номенклатура;
				
				НСтр = НовыйДокумент.Товары.Добавить(); 
				НСтр.Номенклатура = Номенклатура;
				НСтр.ШтрихКодМаркировки = ВыборкаКодыМаркировки.КодМаркировки;
				НСтр.Цена = ВыборкаКодыМаркировки.Цена; 
				
			КонецЦикла;
			
			НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
			
		КонецЦикла;
		
	КонецЦикла;
	//-Сёмин Р.И. 21.04.2026 #UT10-5815
	
КонецПроцедуры

Процедура СформироватьВводыВОборот() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КорректировкаРеализации.Ссылка КАК Корректировка,
	|	КорректировкаРеализации.ДоговорКонтрагента
	|ПОМЕСТИТЬ ВТ_Корректировки
	|ИЗ
	|	Документ.КорректировкаРеализации КАК КорректировкаРеализации
	|ГДЕ
	|	КорректировкаРеализации.Дата >= &ДатаНачала
	|	И (КорректировкаРеализации.ДоговорКонтрагента.УсловияРаботыСЧЗ = ЗНАЧЕНИЕ(Перечисление.УсловияРаботыСЧЗ.ПокупкаДляСобственныхНужд)
	|			ИЛИ КорректировкаРеализации.ДоговорКонтрагента.УсловияРаботыСЧЗ = ЗНАЧЕНИЕ(Перечисление.УсловияРаботыСЧЗ.ТорговляСНовымиРегионами))
	|	И НЕ КорректировкаРеализации.Грузополучатель.СобственныйФилиал
	|	И КорректировкаРеализации.Проведен
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Корректировка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПродажиОбороты.ДокументПродажи КАК Реализация,
	|	ПродажиОбороты.Регистратор КАК Корректировка
	|ПОМЕСТИТЬ ВТ_КорректировкиРеализации
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(
	|			&ДатаНачала,
	|			,
	|			Регистратор,
	|			ДокументПродажи ССЫЛКА Документ.РеализацияТоваровУслуг
	|				И ДоговорКонтрагента В
	|					(ВЫБРАТЬ
	|						ВТ_Корректировки.ДоговорКонтрагента
	|					ИЗ
	|						ВТ_Корректировки)) КАК ПродажиОбороты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВыводИзОборотаКИЗ КАК ВыводИзОборотаКИЗ
	|		ПО ПродажиОбороты.ДокументПродажи = ВыводИзОборотаКИЗ.Основание
	|			И (ВыводИзОборотаКИЗ.Проведен)
	|			И (ВыводИзОборотаКИЗ.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыВыводИзОборотаКИЗ.Обработан))
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводВОборотКИЗ КАК ВводВОборотКИЗ
	|		ПО ПродажиОбороты.Регистратор = ВводВОборотКИЗ.Основание
	|ГДЕ
	|	ПродажиОбороты.Регистратор В
	|			(ВЫБРАТЬ
	|				ВТ_Корректировки.Корректировка
	|			ИЗ
	|				ВТ_Корректировки)
	|	И ВводВОборотКИЗ.Ссылка ЕСТЬ NULL
	|
	|СГРУППИРОВАТЬ ПО
	|	ПродажиОбороты.ДокументПродажи,
	|	ПродажиОбороты.Регистратор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_КорректировкиРеализации.Корректировка КАК Корректировка,
	|	КорректировкаРеализацииКодыМаркировки.КодМаркировки,
	|	КорректировкаРеализацииКодыМаркировки.КодМаркировки.Номенклатура.ТоварнаяГруппаЧестногоЗнака КАК ТоварнаяГруппаЧестногоЗнака
	|ИЗ
	|	ВТ_КорректировкиРеализации КАК ВТ_КорректировкиРеализации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КорректировкаРеализации.КодыМаркировки КАК КорректировкаРеализацииКодыМаркировки
	|		ПО ВТ_КорректировкиРеализации.Корректировка = КорректировкаРеализацииКодыМаркировки.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_КорректировкиРеализации.Корректировка,
	|	КорректировкаРеализацииКодыМаркировки.КодМаркировки,
	|	КорректировкаРеализацииКодыМаркировки.КодМаркировки.Номенклатура.ТоварнаяГруппаЧестногоЗнака
	|ИТОГИ ПО
	|	Корректировка,
	|	ТоварнаяГруппаЧестногоЗнака";
	
	Запрос.УстановитьПараметр("ДатаНачала", ДобавитьМесяц(ТекущаяДата(), -1));  
		
	ВыборкаКорректировки = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);; 
	
	Пока ВыборкаКорректировки.Следующий() Цикл 
		
		Корректировка = ВыборкаКорректировки.Корректировка;
		
		ВыборкаТоварнаяГруппаЧестногоЗнака = ВыборкаКорректировки.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
		
		Пока ВыборкаТоварнаяГруппаЧестногоЗнака.Следующий() Цикл
			
			ТоварнаяГруппаЧестногоЗнака = ВыборкаТоварнаяГруппаЧестногоЗнака.ТоварнаяГруппаЧестногоЗнака;
			
			НовыйДокумент = Документы.ВводВОборотКИЗ.СоздатьДокумент();
			НовыйДокумент.Дата = ТекущаяДата();
			НовыйДокумент.Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Корректировка, "Организация");
			НовыйДокумент.ВидПродукции = ТоварнаяГруппаЧестногоЗнака;
			НовыйДокумент.Основание = Корректировка;
			НовыйДокумент.Комментарий = "Создан регламентным заданием";
			НовыйДокумент.Статус = Перечисления.СтатусыОтчетОНанесенииКИЗ.Отправлен;
			НовыйДокумент.СпособИзготовления = Перечисления.ВидыСервисПровайдеровСУЗ.Самостоятельно;
			НовыйДокумент.СпособВводаВОборот = Перечисления.СпособВводаВОборот.ВозвратОтПокупателя;
			НовыйДокумент.Ответственный = Пользователи.ТекущийПользователь();
			
			ВыборкаКодыМаркировки = ВыборкаТоварнаяГруппаЧестногоЗнака.Выбрать();
			
			Пока ВыборкаКодыМаркировки.Следующий() Цикл 
				
				Номенклатура = ВыборкаКодыМаркировки.КодМаркировки.Номенклатура;
				
				НСтр = НовыйДокумент.Товары.Добавить(); 
				НСтр.Номенклатура = Номенклатура;
				НСтр.ШтрихКодМаркировки = ВыборкаКодыМаркировки.КодМаркировки;
					
			КонецЦикла; 
			
			НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
			  			
		КонецЦикла;
		
	КонецЦикла; 
	
	
