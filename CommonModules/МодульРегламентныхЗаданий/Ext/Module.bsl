	ДатаПерехода = Константы.ДатаНачалаЗагрузкиИВыгрузкиЦенВРублях.Получить();  
	
	Если ЗначениеЗаполнено(ДатаПерехода) И ТекущаяДата() > ДатаПерехода Тогда 
		Запрос.УстановитьПараметр("Евро", Константы.ВалютаРегламентированногоУчета.Получить());
	Иначе
		Запрос.УстановитьПараметр("Евро", Справочники.Валюты.НайтиПоКоду("978"));
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ВидНоменклатуры", 	Константы.ВидНоменклатурыПоУмолчанию.Получить());
	Запрос.УстановитьПараметр("Склад",   			Константы.ОсновнойСклад.Получить());      
	Запрос.УстановитьПараметр("ОрганизацияМК",		Константы.ОсновнаяОрганизация.Получить());
	Запрос.УстановитьПараметр("ОрганизацияМСК",		Константы.ОсновнаяОрганизацияДляОплатыНаличнымиДляВодителей.Получить());
	Текст = Новый ТекстовыйДокумент;
	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда  
		
		Выборка = Результат.Выбрать();
		
		МассивСтрокДляЗаписиВТекстовыйДокумент = Новый Массив;
		МаксимальноеКоличествоИтераций = 20000;
		ДанныеПоОстаткамСтрока = "";
		
		Инд = 0;         
		
		Пока Выборка.Следующий() Цикл	
			
			Если Инд = МаксимальноеКоличествоИтераций Тогда   
				
				МассивСтрокДляЗаписиВТекстовыйДокумент.Добавить(ДанныеПоОстаткамСтрока);	
				Инд = 0;  
				ДанныеПоОстаткамСтрока = "";    
				
			КонецЕсли; 
			
			ВременнаяСтрока =  
			Выборка.Производитель + Символы.Таб
			 + Выборка.Артикул + Символы.Таб
			 + Выборка.КодПроизводителя + Символы.Таб
			 + Выборка.Номенклатура + Символы.Таб
			 + Выборка.ЕдИзм + Символы.Таб
			 + Строка(Выборка.Кратность) + Символы.Таб
			 + Строка(СтрЗаменить(?(Выборка.СвободныйОстаток < 0, 0, Выборка.СвободныйОстаток),  Символы.НПП, "")) + Символы.Таб 
			 + Строка(СтрЗаменить(Выборка.БазоваяценаМоскворечье, Символы.НПП, "")) + Символы.Таб 
			 + Строка(СтрЗаменить(Выборка.Скидка35, Символы.НПП, "")) + Символы.Таб
			 + Строка(СтрЗаменить(Выборка.Скидка36, Символы.НПП, "")) + Символы.Таб
			 + Строка(СтрЗаменить(Выборка.Скидка37, Символы.НПП, "")) + Символы.Таб			
			 + Строка(СтрЗаменить(Выборка.Скидка38, Символы.НПП, "")) + Символы.Таб			
			 + Строка(СтрЗаменить(Выборка.СпецЦена, Символы.НПП, "")) + Символы.Таб					
			 + СокрЛП(Выборка.КодМДМ) + Символы.Таб
			 + Строка(СтрЗаменить(Выборка.Акция, Символы.НПП, "")) + Символы.Таб
			 + Строка(СтрЗаменить(Выборка.АвтоЕвропа, Символы.НПП, ""));
			
			ДанныеПоОстаткамСтрока = ДанныеПоОстаткамСтрока + ?(Инд > 0, Символы.ПС, "") + ВременнаяСтрока;
			
			Инд = Инд + 1;
			
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ДанныеПоОстаткамСтрока) Тогда
			МассивСтрокДляЗаписиВТекстовыйДокумент.Добавить(ДанныеПоОстаткамСтрока);	
		КонецЕсли;
		
		ИтоговыеДанныеПоОстаткамСтрока = "" + Символы.ПС; 
		
		Сч = 0;
		
		Для каждого СтрокаДобавления Из МассивСтрокДляЗаписиВТекстовыйДокумент Цикл 
			
			ИтоговыеДанныеПоОстаткамСтрока = ИтоговыеДанныеПоОстаткамСтрока + ?(Сч > 0, Символы.ПС, "") + СтрокаДобавления; 			
			Сч = Сч + 1;          
			
		КонецЦикла;
		
		ИтоговыеДанныеПоОстаткамСтрока = ИтоговыеДанныеПоОстаткамСтрока + Символы.ПС;
		
		Текст.УстановитьТекст(ИтоговыеДанныеПоОстаткамСтрока);
		
	КонецЕсли;
	
	ИмяВременногоКаталога = СокрЛП(Новый УникальныйИдентификатор);
	СоздатьКаталог(КаталогВременныхФайлов() + ИмяВременногоКаталога); 
	
	ВременныйКаталог = КаталогВременныхФайлов() + ИмяВременногоКаталога + "\";
	ВремИмя = Строка(Новый УникальныйИдентификатор);
	Текст.Записать(ВременныйКаталог + ВремИмя,КодировкаТекста.ANSI);
	
	Попытка
		Соединение = Новый FTPСоединение(ИмяFTPСервера, "21", Константы.FTPВыгрузкаОстатковЛогин2.Получить(), Константы.FTPВыгрузкаОстатковПароль2.Получить(), , Истина);
	Исключение
		
		ЗаписьЖурналаРегистрации("Полное обновление остатков и цен Казань единый прайс-лист", УровеньЖурналаРегистрации.Ошибка, , ,
		"Не удалось установить соединение с FTP. Запись данных на FTP  не выполнена.");
		Возврат;
		
	КонецПопытки;
	
	Отказ = Ложь;
	
	МассивНайденныхФайловНаСервере = Соединение.НайтиФайлы(ИмяКаталогаСервера + "*.lock");	
	
	Для Каждого ТекСтр Из МассивНайденныхФайловНаСервере Цикл      
		
		Если ВРег(ТекСтр.Имя) = ВРег("daemon.locK") 
			Или ВРег(ТекСтр.Имя) = ВРег("connect.lock") Тогда 
			
			Отказ = Истина;
			Прервать; 
			
		КонецЕсли;  
		
	КонецЦикла;	  
	
	Если Отказ Тогда  
		
		ЗаписьЖурналаРегистрации("Запись данных на FTP НЕ СОСТОЯЛАСЬ из-за БЛОКИРОВКИ");
		Возврат;  
		
	КонецЕсли; 	
	
	// Записать файлик блокировки
	Файлик = Новый ТекстовыйДокумент;
	ВремИмяФайлаБлокировки = Строка(Новый УникальныйИдентификатор);
	Файлик.Записать(КаталогВременныхФайлов() + ВремИмяФайлаБлокировки);
	
	Попытка
		
		Соединение.Записать(КаталогВременныхФайлов() + ВремИмяФайлаБлокировки, ?(ЗначениеЗаполнено(ЗаданаПапкаДляFTP), ЗаданаПапкаДляFTP + "\", "") + "connect.lock");		
		ЗаписьЖурналаРегистрации("Полное обновление остатков и цен Казань", УровеньЖурналаРегистрации.Информация,,, 
		"Файл connect.lock записан в каталог: " + ЗаданаПапкаДляFTP);
		
	Исключение 
		
		Попытка
			
			Соединение = Новый FTPСоединение(ИмяFTPСервера, "21", Константы.FTPВыгрузкаОстатковЛогин2.Получить(),  
			Константы.FTPВыгрузкаОстатковПароль2.Получить(), , Истина);		
			Соединение.Записать(КаталогВременныхФайлов() + ВремИмяФайлаБлокировки, ?(ЗначениеЗаполнено(ЗаданаПапкаДляFTP),
			ЗаданаПапкаДляFTP + "\", "") + "connect.lock");                 
			
			ЗаписьЖурналаРегистрации("Полное обновление остатков и цен Казань", УровеньЖурналаРегистрации.Информация,,, 
			"Файл connect.lock записан в каталог: " + ЗаданаПапкаДляFTP);
			
		Исключение
			
			ЗаписьЖурналаРегистрации("Полное обновление остатков и цен Казань", УровеньЖурналаРегистрации.Информация,,, 
			"Ошибка записи файла connect.lock записан в каталог: " + ЗаданаПапкаДляFTP + Символы.ПС + ОписаниеОшибки());	
			Возврат;
			
		КонецПопытки;
		
	КонецПопытки;
	
	ФайлЗаписанНаСервере = Истина; 
	
	Попытка
		
		Соединение.Записать(ВременныйКаталог + ВремИмя, ?(ЗначениеЗаполнено(ЗаданаПапкаДляFTP), ЗаданаПапкаДляFTP + "\", "") + ВремИмя);		
		ЗаписьЖурналаРегистрации("Полное обновление остатков и цен Казань", УровеньЖурналаРегистрации.Информация,,,
		"Документ записан под временным имененм на FTP: " + ИмяFTPСервера + " в каталог: " + ЗаданаПапкаДляFTP);
		
	Исключение
		
		Попытка
			
			Соединение = Новый FTPСоединение(ИмяFTPСервера, "21", Константы.FTPВыгрузкаОстатковЛогин2.Получить(), 
			Константы.FTPВыгрузкаОстатковПароль2.Получить(), , Истина);
			Соединение.Записать(ВременныйКаталог + ВремИмя, ?(ЗначениеЗаполнено(ЗаданаПапкаДляFTP), ЗаданаПапкаДляFTP + "\", "") + ВремИмя);		  
			
			ЗаписьЖурналаРегистрации("Полное обновление остатков и цен Казань", УровеньЖурналаРегистрации.Информация,,, 
			"Документ записан под временным имененм на FTP: " + ИмяFTPСервера + " в каталог: " + ЗаданаПапкаДляFTP);
			
		Исключение
			
			ЗаписьЖурналаРегистрации("Полное обновление остатков и цен Казань", УровеньЖурналаРегистрации.Ошибка,,, 
			"Блокировки НЕ БЫЛО. Но запись данных под временным имененм на FTP: " + ИмяFTPСервера + " НЕ СОСТОЯЛАСЬ!" + Символы.ПС + ОписаниеОшибки());
			ФайлЗаписанНаСервере = Ложь;
			
		КонецПопытки;
		
	КонецПопытки;
	
	Если ФайлЗаписанНаСервере Тогда
		
		Попытка
			
			Соединение.Переместить(?(ЗначениеЗаполнено(ЗаданаПапкаДляFTP), ЗаданаПапкаДляFTP + "\", "")  
			+ ВремИмя, ?(ЗначениеЗаполнено(ЗаданаПапкаДляFTP), ЗаданаПапкаДляFTP + "\", "") + "price.file");		
			ЗаписьЖурналаРегистрации("Полное обновление остатков и цен Казань", УровеньЖурналаРегистрации.Информация,,, 
			"Документ записан на FTP: " + ИмяFTPСервера + " в каталог: " + ЗаданаПапкаДляFTP);
			
		Исключение     		
			
			Попытка
				
				Соединение = Новый FTPСоединение(ИмяFTPСервера, "21", Константы.FTPВыгрузкаОстатковЛогин2.Получить(),  
				Константы.FTPВыгрузкаОстатковПароль2.Получить(), , Истина);
				Соединение.Переместить(?(ЗначениеЗаполнено(ЗаданаПапкаДляFTP), ЗаданаПапкаДляFTP + "\", "") + ВремИмя,
				?(ЗначениеЗаполнено(ЗаданаПапкаДляFTP), ЗаданаПапкаДляFTP + "\", "") + "price.file");		
				
				ЗаписьЖурналаРегистрации("Полное обновление остатков и цен Казань", УровеньЖурналаРегистрации.Информация,,, 
				"Документ записан на FTP: " + ИмяFTPСервера + " в каталог: " + ЗаданаПапкаДляFTP);
				
			Исключение
				ЗаписьЖурналаРегистрации("Полное обновление остатков и цен Казань", УровеньЖурналаРегистрации.Ошибка,,, 
				"Блокировки НЕ БЫЛО. Но запись данных на FTP: " + ИмяFTPСервера + " НЕ СОСТОЯЛАСЬ!" + Символы.ПС + ОписаниеОшибки());
			КонецПопытки;
			
		КонецПопытки;
		
	КонецЕсли; // ФайлЗаписанНаСервере
	
	// Удалить файлик
	Попытка
		
		Соединение.Удалить(?(ЗначениеЗаполнено(ЗаданаПапкаДляFTP), ЗаданаПапкаДляFTP + "/", "") + "connect.lock");
		ЗаписьЖурналаРегистрации("Полное обновление остатков и цен Казань", УровеньЖурналаРегистрации.Информация, , , "Файл connect.lock успешно удален");
		
	Исключение
		
		Попытка
			
			Соединение = Новый FTPСоединение(ИмяFTPСервера, "21", Константы.FTPВыгрузкаОстатковЛогин2.Получить(), Константы.FTPВыгрузкаОстатковПароль2.Получить(), , Истина);
			Соединение.Удалить(?(ЗначениеЗаполнено(ЗаданаПапкаДляFTP), ЗаданаПапкаДляFTP + "/", "") + "connect.lock");
			
			ЗаписьЖурналаРегистрации("Полное обновление остатков и цен Казань", УровеньЖурналаРегистрации.Информация, , , "Файл connect.lock успешно удален");
			
		Исключение
			ЗаписьЖурналаРегистрации("Полное обновление остатков и цен Казань", УровеньЖурналаРегистрации.Ошибка, , ,
			"Ошибка при удалении файла connect.lock" + Символы.ПС + ОписаниеОшибки());
		КонецПопытки;
		
	КонецПопытки;  
	
	УдалитьФайлы(КаталогВременныхФайлов() + ВремИмя);
	УдалитьФайлы(КаталогВременныхФайлов() + ВремИмяФайлаБлокировки);
	УдалитьФайлы(ВременныйКаталог);
	
КонецПроцедуры

Процедура ПолноеОбновлениеОстатковИЦен() Экспорт
	
	ЗаписьЖурналаРегистрации("Полное обновление остатков и цен.Начало", УровеньЖурналаРегистрации.Информация,,,);
	
	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда
		
		ЗаписьЖурналаРегистрации("Полное обновление остатков и цен.Ошибка", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Отменена работа регламентного задания из-за несоответствия параметров подключения в ИБ");
		Возврат;
		
	КонецЕсли;	
	
	ИмяFTPСервера = Константы.FTPВыгрузкаОстатковАдрес.Получить();
	
	ЗаданаПапкаДляFTP = СокрЛП(Константы.FTPВыгрузкаОстатковКаталог.Получить());
	ИмяКаталогаСервера = ?(ЗначениеЗаполнено(ЗаданаПапкаДляFTP), "" + ЗаданаПапкаДляFTP + "/", "");
	
	Если Не ЗначениеЗаполнено(ИмяFTPСервера) Тогда
		
		ЗаписьЖурналаРегистрации("Полное обновление остатков и цен.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
		"Отменена попытка соединения с FTP: не заполнен адрес FTP сервера в константах.");
		Возврат;
		
	КонецЕсли;
	
	ВыполнятьВыгрузку = Истина;
	ОшибкаПрошлойВыгрузки = Ложь;
	УдалитьЗаписи = Ложь;   
	
	Набор = РегистрыСведений.ЖурналОбновленияОстатковЦен.СоздатьНаборЗаписей();
	Набор.Отбор.Задание.Установить("ПолноеОбновлениеОстатковЦен");
	Набор.Прочитать();    
	
	Если Набор.Количество() > 0 Тогда   
		
		ДатаВыполнения = Набор[0].ДатаВыполнения;
		ОшибкаПрошлойВыгрузки = Набор[0].Ошибка;
		УдалитьЗаписи = Истина;                 
		
		Если ЗначениеЗаполнено(ДатаВыполнения) Тогда  
			
			Если (Не ОшибкаПрошлойВыгрузки) И ((ТекущаяДата() - Набор[0].ДатаВыполнения) < 21600) Тогда
				
				ВыполнятьВыгрузку = Ложь;
				ЗаписьЖурналаРегистрации("Полное обновление остатков и цен.Завершение", УровеньЖурналаРегистрации.Информация,,, 
				"Отмена запуска регламентного задания: прошло меньше 6 часов с момента прошлого запуска (РС ""Журнал обновления остатков и цен"").");
				
			КонецЕсли;  
			
		КонецЕсли;		
		
	КонецЕсли;
	
	Если Не ВыполнятьВыгрузку Тогда
		Возврат;
	КонецЕсли;
	
	ВремяНач = ТекущаяДата();
	
	Запрос = Новый Запрос; 	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Номенклатура,
	|	ПРЕДСТАВЛЕНИЕССЫЛКИ(Номенклатура.Родитель) КАК Производитель,
	|	Номенклатура.Артикул,
	|	Номенклатура.КодПроизводителя,
	|	ПРЕДСТАВЛЕНИЕССЫЛКИ(Номенклатура.Наименование),
	|	Номенклатура.БазоваяЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА НЕ Номенклатура.КратностьФилиала = 0
	|				И НЕ Номенклатура.КратностьФилиала = Номенклатура.Кратность
	|			ТОГДА Номенклатура.КратностьФилиала
	|		ИНАЧЕ ВЫБОР
	|				КОГДА Номенклатура.Кратность = 0
	|					ТОГДА 1
	|				ИНАЧЕ Номенклатура.Кратность
	|			КОНЕЦ
	|	КОНЕЦ КАК Кратность,
	|	ВЫБОР
	|		КОГДА Константы.ИспользоватьГруппуНоменклатурыУценка
	|				И Константы.ГруппаНоменклатурыУценка <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА ВЫБОР
	|					КОГДА Номенклатура.Родитель = Константы.ГруппаНоменклатурыУценка
	|						ТОГДА ВЫБОР
	|								КОГДА Номенклатура.ПредыдущийРодитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|									ТОГДА ПРЕДСТАВЛЕНИЕССЫЛКИ(Номенклатура.Родитель)
	|								ИНАЧЕ ПРЕДСТАВЛЕНИЕССЫЛКИ(Номенклатура.ПредыдущийРодитель)
	|							КОНЕЦ
	|					ИНАЧЕ ПРЕДСТАВЛЕНИЕССЫЛКИ(Номенклатура.Родитель)
