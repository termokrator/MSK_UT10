Процедура ОбновлениеОстатковИЦенВер2() Экспорт
	
	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда 
		
		ЗаписьЖурналаРегистрации("Обновление остатков", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Отменена работа регламентного задания из-за несоответствия параметров подключения в ИБ");
		Возврат;
		
	КонецЕсли;	
	
	Если Константы.База.Получить() = Перечисления.НазваниеБазы.Казань Тогда
		
		ОбновлениеОстатковИЦен_КазаньВер2();
		Возврат;
		
	КонецЕсли;
	
	ИмяКаталогаСервера = "";
	ИмяFTPСервера = Константы.FTPВыгрузкаОстатковАдрес.Получить();	
	
	ЗаданаПапкаДляFTP = СокрЛП(Константы.FTPВыгрузкаОстатковКаталог.Получить());
	ИмяКаталогаСервера = ИмяКаталогаСервера + ?(ЗначениеЗаполнено(ЗаданаПапкаДляFTP), "" + ЗаданаПапкаДляFTP + "/", "");
	
	Попытка
		Соединение = Новый FTPСоединение(ИмяFTPСервера, "21", Константы.FTPВыгрузкаОстатковЛогин.Получить(), Константы.FTPВыгрузкаОстатковПароль.Получить(), , Истина);
	Исключение
		
		ЗаписьЖурналаРегистрации("Не удалось установить соединение с FTP. Запись данных на FTP не выполнена.");
		Возврат;
		
	КонецПопытки;
	
	Отказ = Ложь;
	
	МассивНайденныхФайловНаСервере = Соединение.НайтиФайлы(ИмяКаталогаСервера + "daemon.lock");	
	
	Для Каждого ТекСтр Из МассивНайденныхФайловНаСервере Цикл
		
		Если ВРег(ТекСтр.Имя) = ВРег("daemon.locK") Тогда
			
			Отказ = Истина;
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Отказ Тогда
		
		ЗаписьЖурналаРегистрации("Запись данных на FTP НЕ СОСТОЯЛАСЬ из-за БЛОКИРОВКИ");
		Возврат;
		
	КонецЕсли;  	
	
	// Записать файлик блокировки
	Файлик = Новый ТекстовыйДокумент;
	ВремИмя = Строка(Новый УникальныйИдентификатор);
