	|								НеНулевыеСвободныеОстатки.Номенклатура
	|							ИЗ
	|								НеНулевыеСвободныеОстатки_ИТОГ КАК НеНулевыеСвободныеОстатки)) КАК ТоварыНаСкладахОбороты
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ РАЗЛИЧНЫЕ
	|		ТоварыВРезервеНаСкладахОбороты.Номенклатура
	|	ИЗ
	|		РегистрНакопления.ТоварыВРезервеНаСкладах.Обороты(
	|				&НачалоСегодняшнегоДня,
	|				,
	|				,
	|				Склад = &Склад
	|					И НЕ Номенклатура В
	|							(ВЫБРАТЬ
	|								НеНулевыеСвободныеОстатки.Номенклатура
	|							ИЗ
	|								НеНулевыеСвободныеОстатки_ИТОГ КАК НеНулевыеСвободныеОстатки)) КАК ТоварыВРезервеНаСкладахОбороты) КАК Таб
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.СвободныйОстаток КАК Количество,
	|	СправочникНоменклатура.КодМДМ
	|ИЗ
	|	(ВЫБРАТЬ
	|		НеНулевыеСвободныеОстатки.Номенклатура КАК Номенклатура,
	|		НеНулевыеСвободныеОстатки.ОстатокКВыгрузке КАК СвободныйОстаток
	|	ИЗ
	|		НеНулевыеСвободныеОстатки_ИТОГ КАК НеНулевыеСвободныеОстатки
	|	ГДЕ
	|		НеНулевыеСвободныеОстатки.ОстатокКВыгрузке > 0
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ОборотСегодня.Номенклатура,
	|		0
	|	ИЗ
	|		ОборотСегодня КАК ОборотСегодня) КАК Т
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	|		ПО Т.Номенклатура = СправочникНоменклатура.Ссылка";
	
	Запрос.УстановитьПараметр("Склад", 			Константы.ОсновнойСклад.Получить());
	Запрос.УстановитьПараметр("ОрганизацияМК",	Константы.ОсновнаяОрганизация.Получить());
	Запрос.УстановитьПараметр("ОрганизацияМСК",	Константы.ОсновнаяОрганизацияДляОплатыНаличнымиДляВодителей.Получить());
	Запрос.УстановитьПараметр("НачалоСегодняшнегоДня", НачалоДня(ТекущаяДата()));
	
	Результат = Запрос.Выполнить();
	Товары = Результат.Выгрузить();
	
	НовоеСообщение = Справочники.ИсходящиеСообщения.СоздатьЭлемент();
	НовоеСообщение.ОбменДанными.Загрузка = Истина;
	НовоеСообщение.ДатаВремяСобытия = ТекущаяДата();
	НовоеСообщение.ТочкаПубликации = Константы.ТочкаОтправки.Получить();
	
	ID = Новый УникальныйИдентификатор();     	
	НовоеСообщение.УстановитьСсылкуНового(Справочники.ИсходящиеСообщения.ПолучитьСсылку(ID));
	
	СтруктураДокумента = Новый Структура;
	
	СтруктураДокумента.Вставить("ВидСостояния", "ТекущийОстаток");
	СтруктураДокумента.Вставить("ДатаСостояния", ТекущаяДата());
	СтруктураДокумента.Вставить("ДатаВыгрузки", ТекущаяДата());
	СтруктураДокумента.Вставить("Склад", Константы.ОсновнойСклад.Получить().КодМДМ); 
	СтруктураДокумента.Вставить("Товары", ТаблицуВМассив(Товары));
	
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, СтруктураДокумента);
	JsonСтрока = ЗаписьJSON.Закрыть(); 	
	
	НовоеСообщение.Сообщение = JsonСтрока;	
	
	Заголовки = Новый СписокЗначений;
	Заголовки.Добавить("status_type", "ТекущийОстаток");
	Заголовки.Добавить("content_type", "application/json");
	Заголовки.Добавить("warehouse_id", Константы.ОсновнойСклад.Получить().КодМДМ);
	Заголовки.Добавить("price_id", Константы.FTPВыгрузкаОстатковКаталог.Получить());
	
	Свойства = Новый СписокЗначений;
	Свойства.Добавить("ОтметкаВремени", AMQP_РаботаСДокументами.ДатуВTimestamp(НовоеСообщение.ДатаВремяСобытия));   	
	Свойства.Добавить("Тип", "status"); 
	Свойства.Добавить("ИмяПриложения", Строка(Константы.База.Получить()));
	Свойства.Добавить("РежимДоставки", 2);
	Свойства.Добавить("НомерСообщения", Строка(ID));
	
	Для каждого Свойство Из Свойства Цикл
		
		НоваяСтрока = НовоеСообщение.Свойства.Добавить();
		НоваяСтрока.Наименование = Свойство.Значение;
		НоваяСтрока.Значение = Свойство.Представление;
		
	КонецЦикла;   	
	
	Если ЗначениеЗаполнено(Заголовки) Тогда
		
		Для каждого Заголовок Из Заголовки Цикл
			
			НоваяСтрока = НовоеСообщение.Заголовки.Добавить();
			НоваяСтрока.Наименование = Заголовок.Значение;
			НоваяСтрока.Значение = Заголовок.Представление;
			
		КонецЦикла;   
		
	КонецЕсли;         
	
	НовоеСообщение.Записать();
	
КонецПроцедуры

Процедура ОбновлениеОстатковИЦенRabbit() Экспорт
	
	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда 
		
		ЗаписьЖурналаРегистрации("Обновление остатков портал", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Отменена работа регламентного задания из-за несоответствия параметров подключения в ИБ");
		Возврат;
		
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТоварыВРезервеНаСкладахОстатки.Номенклатура,
	|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва КАК ЗаказПокупателя
	|ПОМЕСТИТЬ ТоварыВРезерке
	|ИЗ
	|	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(
	|			,
	|			Склад = &Склад
	|				И ДокументРезерва ССЫЛКА Документ.ЗаказПокупателя) КАК ТоварыВРезервеНаСкладахОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва,
	|	ТоварыВРезервеНаСкладахОстатки.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыНаСкладахОстатки.КоличествоОстаток - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0) КАК СвободныйОстатокСклад,
	|	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ НеНулевыеСвободныеОстаткиСклад
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(, Склад = &Склад) КАК ТоварыНаСкладахОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(, Склад = &Склад) КАК ТоварыВРезервеНаСкладахОстатки
	|		ПО ТоварыНаСкладахОстатки.Номенклатура = ТоварыВРезервеНаСкладахОстатки.Номенклатура
	|ГДЕ
	|	ТоварыНаСкладахОстатки.КоличествоОстаток - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0) > 0
	|	И ТоварыНаСкладахОстатки.Номенклатура.Родитель.НеПоказыватьНаПортале = ЛОЖЬ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НеНулевыеСвободныеОстаткиСклад.СвободныйОстатокСклад,
	|	НеНулевыеСвободныеОстаткиСклад.Номенклатура КАК Номенклатура,
	|	ТоварыВЯчейкахОстатки.КоличествоОстаток - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0) + ЕСТЬNULL(ТоварыВСборкеОстатки.СобраноОстаток, 0) + ЕСТЬNULL(ТоварыВСборкеОстатки.КСборкеОстаток, 0) КАК СвободныйОстатокЯчейки,
	|	ВЫБОР
	|		КОГДА НеНулевыеСвободныеОстаткиСклад.СвободныйОстатокСклад <= ТоварыВЯчейкахОстатки.КоличествоОстаток - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0) + ЕСТЬNULL(ТоварыВСборкеОстатки.СобраноОстаток, 0) + ЕСТЬNULL(ТоварыВСборкеОстатки.КСборкеОстаток, 0)
	|			ТОГДА НеНулевыеСвободныеОстаткиСклад.СвободныйОстатокСклад
	|		ИНАЧЕ ЕСТЬNULL(ТоварыВЯчейкахОстатки.КоличествоОстаток, 0) - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0) + ЕСТЬNULL(ТоварыВСборкеОстатки.СобраноОстаток, 0) + ЕСТЬNULL(ТоварыВСборкеОстатки.КСборкеОстаток, 0)
	|	КОНЕЦ КАК СвободныйОстаток
	|ПОМЕСТИТЬ НеНулевыеСвободныеОстатки
	|ИЗ
	|	НеНулевыеСвободныеОстаткиСклад КАК НеНулевыеСвободныеОстаткиСклад
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках.Остатки(
	|				,
	|				Склад = &Склад
	|					И Ячейка.НеУчитыватьВОперативномУчете = ЛОЖЬ) КАК ТоварыВЯчейкахОстатки
	|		ПО НеНулевыеСвободныеОстаткиСклад.Номенклатура = ТоварыВЯчейкахОстатки.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(, Склад = &Склад) КАК ТоварыВРезервеНаСкладахОстатки
	|		ПО (ТоварыВЯчейкахОстатки.Номенклатура = ТоварыВРезервеНаСкладахОстатки.Номенклатура)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВСборке.Остатки(
	|				,
	|				(ЗаказПокупателя, Номенклатура) В
	|					(ВЫБРАТЬ
	|						ТоварыВРезерке.ЗаказПокупателя КАК ЗаказПокупателя,
	|						ТоварыВРезерке.Номенклатура
	|					ИЗ
	|						ТоварыВРезерке КАК ТоварыВРезерке)) КАК ТоварыВСборкеОстатки
	|		ПО (ТоварыВЯчейкахОстатки.Номенклатура = ТоварыВСборкеОстатки.Номенклатура)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Таб.Номенклатура
	|ПОМЕСТИТЬ ОборотСегодня
	|ИЗ
	|	(ВЫБРАТЬ
	|		ТоварыНаСкладахОбороты.Номенклатура КАК Номенклатура
	|	ИЗ
	|		РегистрНакопления.ТоварыНаСкладах.Обороты(
	|				&НачалоСегодняшнегоДня,
	|				,
	|				,
	|				Склад = &Склад
	|					И НЕ Номенклатура В
	|							(ВЫБРАТЬ
	|								НеНулевыеСвободныеОстатки.Номенклатура
	|							ИЗ
	|								НеНулевыеСвободныеОстатки КАК НеНулевыеСвободныеОстатки)) КАК ТоварыНаСкладахОбороты
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ РАЗЛИЧНЫЕ
	|		ТоварыВРезервеНаСкладахОбороты.Номенклатура
	|	ИЗ
	|		РегистрНакопления.ТоварыВРезервеНаСкладах.Обороты(
	|				&НачалоСегодняшнегоДня,
	|				,
	|				,
	|				Склад = &Склад
	|					И НЕ Номенклатура В
	|							(ВЫБРАТЬ
	|								НеНулевыеСвободныеОстатки.Номенклатура
	|							ИЗ
	|								НеНулевыеСвободныеОстатки КАК НеНулевыеСвободныеОстатки)) КАК ТоварыВРезервеНаСкладахОбороты) КАК Таб
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СправочникНоменклатура.КодМДМ,
	|	Т.СвободныйОстаток КАК Количество
	|ИЗ
	|	(ВЫБРАТЬ
	|		НеНулевыеСвободныеОстатки.Номенклатура КАК Номенклатура,
	|		НеНулевыеСвободныеОстатки.СвободныйОстаток КАК СвободныйОстаток
	|	ИЗ
	|		НеНулевыеСвободныеОстатки КАК НеНулевыеСвободныеОстатки
	|	ГДЕ
	|		НеНулевыеСвободныеОстатки.СвободныйОстаток > 0
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ОборотСегодня.Номенклатура,
	|		0
	|	ИЗ
	|		ОборотСегодня КАК ОборотСегодня) КАК Т
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	|		ПО Т.Номенклатура = СправочникНоменклатура.Ссылка
	|ГДЕ
	|	Т.СвободныйОстаток > 0";
	
	
	Запрос.УстановитьПараметр("Склад", Константы.ОсновнойСклад.Получить());
	Запрос.УстановитьПараметр("НачалоСегодняшнегоДня", ТекущаяДата());

