		|	И НЕ ИсходящиеСообщения.Объект В (&МассивСтроковыхТипов)
		|	И ИсходящиеСообщения.ДатаВремяОтправки <= &Дата
		|	И ИсходящиеСообщения.ДатаВремяОтправки <> ДАТАВРЕМЯ(1, 1, 1)";
		
		
		Запрос.УстановитьПараметр("МассивТипов", МассивТипов);
		Запрос.УстановитьПараметр("МассивСтроковыхТипов", МассивСтроковыхТипов); 
		Запрос.УстановитьПараметр("Дата", Дата);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Спр = Выборка.Ссылка.ПолучитьОбъект();
			Спр.Удалить();                 
			
		КонецЦикла;	
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);	
	
КонецПроцедуры  

