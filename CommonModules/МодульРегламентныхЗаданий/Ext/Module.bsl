	КонецЕсли;
	
	ВремяНач = ТекущаяДата();
	
	Запрос = Новый Запрос;	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Номенклатура,
	|	ПРЕДСТАВЛЕНИЕССЫЛКИ(Номенклатура.Родитель) КАК Производитель,
	|	Номенклатура.Артикул,
	|	Номенклатура.КодПроизводителя,
	|	ПРЕДСТАВЛЕНИЕССЫЛКИ(Номенклатура.Наименование),
	|	Номенклатура.БазоваяЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА НЕ Номенклатура.КратностьФилиала = 0
	|				И НЕ Номенклатура.КратностьФилиала = Номенклатура.Кратность
	|			ТОГДА Номенклатура.КратностьФилиала
	|		ИНАЧЕ ВЫБОР
	|				КОГДА Номенклатура.Кратность = 0
	|					ТОГДА 1
	|				ИНАЧЕ Номенклатура.Кратность
	|			КОНЕЦ
	|	КОНЕЦ КАК Кратность,
	|	Номенклатура.КодМДМ
	|ПОМЕСТИТЬ Товары
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.ЭтоГруппа = ЛОЖЬ
	|	И Номенклатура.ВидНоменклатуры = &ВидНоменклатуры
	|	И Номенклатура.Родитель.НеПоказыватьНаПортале = ЛОЖЬ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таблица2.Номенклатура,
	|	Таблица2.ТипЦен,
	|	СрезПоследнихЦен.Валюта,
	|	ВЫБОР
	|		КОГДА СрезПоследнихЦен.Валюта = &Евро
	|			ТОГДА СрезПоследнихЦен.Цена
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ЕСТЬNULL(КурсыВалютСрезПоследних.Кратность, 0) > 0
	|						И ЕСТЬNULL(КурсыВалютСрезПоследних.Курс, 0) > 0
	|						И ЕСТЬNULL(КурсЕвро.Кратность, 0) > 0
	|						И ЕСТЬNULL(КурсЕвро.Курс, 0) > 0
	|					ТОГДА СрезПоследнихЦен.Цена * (КурсыВалютСрезПоследних.Курс * КурсЕвро.Кратность / (КурсЕвро.Курс * КурсыВалютСрезПоследних.Кратность))
	|				ИНАЧЕ 0
	|			КОНЕЦ
	|	КОНЕЦ КАК Цена
	|ПОМЕСТИТЬ БазоваяценаМоскворечье
	|ИЗ
	|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|		ЦеныНоменклатуры.ТипЦен КАК ТипЦен,
	|		ЦеныНоменклатуры.Номенклатура КАК Номенклатура,
	|		МАКСИМУМ(ЦеныНоменклатуры.Период) КАК Период
	|	ИЗ
	|		РегистрСведений.ЦеныНоменклатуры КАК ЦеныНоменклатуры
	|	ГДЕ
	|		ЦеныНоменклатуры.ТипЦен = &БазоваяценаМоскворечье
	|		И ЦеныНоменклатуры.Номенклатура В
	|				(ВЫБРАТЬ
	|					Товары.Номенклатура
	|				ИЗ
	|					Товары КАК Товары)
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ЦеныНоменклатуры.ТипЦен,
	|		ЦеныНоменклатуры.Номенклатура) КАК Таблица2
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры КАК СрезПоследнихЦен
	|		ПО Таблица2.ТипЦен = СрезПоследнихЦен.ТипЦен
	|			И Таблица2.Номенклатура = СрезПоследнихЦен.Номенклатура
