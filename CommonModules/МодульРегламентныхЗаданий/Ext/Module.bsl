Функция СоздатьНовыйДокументСборка(ТекСтр)
	
	ДокСборка 					= Документы.СборкаЗаказовПокупателя.СоздатьДокумент();
	ДокСборка.Контрагент 		= ТекСтр.Контрагент;
	ДокСборка.Грузополучатель 	= ТекСтр.Грузополучатель;
	ДокСборка.МаршрутДоставки 	= ?(ТекСтр.СпособДоставки = Перечисления.СпособДоставки.Самовывоз, Справочники.МаршрутыДоставки.ПустаяСсылка(), 
	                              ДокСборка.Грузополучатель.МаршрутДоставки);
	ДокСборка.Договор 			= ТекСтр.ДоговорКонтрагента;
	ДокСборка.СпособДоставки 	= ТекСтр.СпособДоставки;
	ДокСборка.Дата 				= ТекущаяДата();
	ДокСборка.ВремяНачалаСборки = ТекущаяДата();
	ДокСборка.ДатаДоставкиКлиенту = ТекущаяДата();
	ДокСборка.Организация 		= ТекСтр.ДоговорКонтрагента.Организация;
	
	Возврат ДокСборка;
	
КонецФункции 

Процедура ЗапускВАвтоматическомРежимеОбработки_КонтрольИОтправкаАктовСверкиВзаиморасчетов() Экспорт
	
	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда 
		
		ЗаписьЖурналаРегистрации("Регламентное : Автоматическая рассылка актов сверок взаиморасчетов контрагентам", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Отменена работа регламентного задания из-за несоответствия параметров подключения в ИБ");
		Возврат;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СУММА(1) КАК КоличествоРабочихДней
	|ИЗ
	|	РегистрСведений.РегламентированныйПроизводственныйКалендарь КАК РегламентированныйПроизводственныйКалендарь
	|ГДЕ
	|	(РегламентированныйПроизводственныйКалендарь.ВидДня = &ВидДняРабочий
	|			ИЛИ РегламентированныйПроизводственныйКалендарь.ВидДня = &ВидДняПредпраздничный)
	|	И РегламентированныйПроизводственныйКалендарь.ДатаКалендаря >= &НачМесяца
	|	И РегламентированныйПроизводственныйКалендарь.ДатаКалендаря <= &НачТекущегоДня";
	
	Запрос.УстановитьПараметр("ВидДняРабочий",         Перечисления.ВидыДнейПроизводственногоКалендаря.Рабочий);
	Запрос.УстановитьПараметр("ВидДняПредпраздничный", Перечисления.ВидыДнейПроизводственногоКалендаря.Предпраздничный);
	Запрос.УстановитьПараметр("НачМесяца", НачалоДня(НачалоМесяца(ТекущаяДата())));
	Запрос.УстановитьПараметр("НачТекущегоДня", НачалоДня(ТекущаяДата()));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если  ВыборкаДетальныеЗаписи.КоличествоРабочихДней = 2 Тогда 
			
			ОбработкаЗапуска = Обработки.КонтрольИОтправкаАктовСверкиВзаиморасчетов.Создать();
			ДатаОтчета = НачалоДня(НачалоМесяца(ТекущаяДата())) - 1;
			
			Если НачалоДня(ТекущаяДата()) = НачалоДня(НачалоКвартала(ТекущаяДата())) Тогда 
				
				ОбработкаЗапуска.ДатаНачалаФормированияСверки = НачалоКвартала(ДатаОтчета);
				ОбработкаЗапуска.ДатаОкончанияФормированияСверки = КонецКвартала(ДатаОтчета);
				
			Иначе
				
				ОбработкаЗапуска.ДатаНачалаФормированияСверки = НачалоМесяца(ДатаОтчета);
				ОбработкаЗапуска.ДатаОкончанияФормированияСверки = КонецМесяца(ДатаОтчета);
				
			КонецЕсли;
			
			ОбработкаЗапуска.ВыполнитьСозданиеАктовиРазослатьСверку(ОбработкаЗапуска.ДатаНачалаФормированияСверки, ОбработкаЗапуска.ДатаОкончанияФормированияСверки);
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

