			ЭлементНГ.Код 			= ТекСтр.КодНоменклатурнойГруппы ;
			ЭлементНГ.Наименование 	= ТекСтр.ИмяНоменклатурнойГруппы;
			ЭлементНГ.БазоваяЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоНаименованию("шт");
			ЭлементНГ.Записать(); 
			
		Исключение
		КонецПопытки;  
		
	КонецЦикла;	
	
	ТаблицаАБС = Пакет[6 + КоэффициентДляТаблиц].Выгрузить();
	
	Для Каждого ТекСтр ИЗ ТаблицаАБС Цикл            
		
		Попытка
		
			ЭлементАВС 		= Справочники.АВСКлассификацияНоменклатуры.СоздатьЭлемент();
			ЭлементАВС.Код 	= ТекСтр.КатегорияАВС;
			ЭлементАВС.наименование = ТекСтр.КатегорияАВС;
			ЭлементАВС.Записать();    
			
		Исключение
		КонецПопытки;           
		
	КонецЦикла;	
	
	
	ТаблицаЦен = Пакет[7 + КоэффициентДляТаблиц].Выгрузить();
	
	ЗаписьЖурналаРегистрации("Загрузка цен.Обработка", УровеньЖурналаРегистрации.Информация,,, "Товаров для установки цен: " + Строка(ТаблицаЦен.Количество()));
	
	ТаблицаВГруппеРеклама = Пакет[3 + КоэффициентДляТаблиц].Выгрузить();
	
	КоличествоВГруппеРеклама = 0;
	
	Если ТаблицаВГруппеРеклама.Количество() > 0 Тогда
		КоличествоВГруппеРеклама = ТаблицаВГруппеРеклама[0].Количество;
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации("Загрузка цен.Обработка", УровеньЖурналаРегистрации.Информация,,, "Товаров в группе реклама: " + Строка(КоличествоВГруппеРеклама));
	
	Если Константы.ИспользоватьГруппуНоменклатурыУценка.Получить() и ЗначениеЗаполнено(ГруппаНоменклатурыУценка) Тогда
		
		ТаблицаВГруппеУценка = Пакет[3].Выгрузить();
		
		КоличествоВГруппеУценка = 0;
		
		Если ТаблицаВГруппеУценка.Количество() > 0 Тогда
			КоличествоВГруппеУценка = ТаблицаВГруппеУценка[0].Количество;
		КонецЕсли;
		
		ЗаписьЖурналаРегистрации("Загрузка цен.Обработка", УровеньЖурналаРегистрации.Информация,,, "Товаров в группе распродажа: " + Строка(КоличествоВГруппеУценка));
		
	КонецЕсли;
	
	ТаблицаНоменклатурыКСнятиюПометки = Пакет[9 + КоэффициентДляТаблиц].Выгрузить();
	
	// Номенклатура, у которой изменилась Номенклатурная группа или АБС
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВсеТовары.Ссылка,
	|	ВсеТовары.Артикул,
	|	ВсеТовары.ЦенаСкидка35,
	|	ВсеТовары.ЦенаБазовая,
	|	ВсеТовары.ЦенаЗакупочная,
	|	ВсеТовары.ЦенаСкидка36,
	|	ВсеТовары.ЦенаСкидка37,
	|	ВсеТовары.ЦенаСкидка38,
	|	ВсеТовары.ЦенаСпециальная,	
	|	ВсеТовары.ЦенаАДУрал,
	|	ВсеТовары.ОстатокВМоскве,
	|	ВсеТовары.КодНоменклатурнойГруппы,
	|	ВсеТовары.ИмяНоменклатурнойГруппы,
	|	ВсеТовары.КатегорияАВС,
	|	ЕСТЬNULL(НоменклатурныеГруппы.Ссылка, ЗНАЧЕНИЕ(Справочник.НоменклатурныеГруппы.Прочее)) КАК НГНовая,
	|	ВсеТовары.Ссылка.НоменклатурнаяГруппа КАК НГСтарая,
	|	ЕСТЬNULL(АВСКлассификацияНоменклатуры.Ссылка, ЗНАЧЕНИЕ(Справочник.АВСКлассификацияНоменклатуры.ПустаяСсылка)) КАК КатегорияНовая,
	|	ВсеТовары.Ссылка.ГруппаАВС КАК КатегорияСтарая
	|ИЗ
	|	ВсеТовары КАК ВсеТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НоменклатурныеГруппы КАК НоменклатурныеГруппы
	|		ПО ВсеТовары.КодНоменклатурнойГруппы = НоменклатурныеГруппы.Код
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.АВСКлассификацияНоменклатуры КАК АВСКлассификацияНоменклатуры
	|		ПО ВсеТовары.КатегорияАВС = АВСКлассификацияНоменклатуры.Код
	|ГДЕ
	|	(ЕСТЬNULL(НоменклатурныеГруппы.Ссылка, ЗНАЧЕНИЕ(Справочник.НоменклатурныеГруппы.ПустаяСсылка)) <> ВсеТовары.Ссылка.НоменклатурнаяГруппа
	|   ИЛИ ВсеТовары.Ссылка.НоменклатурнаяГруппа = ЗНАЧЕНИЕ(Справочник.НоменклатурныеГруппы.ПустаяСсылка)
	|			ИЛИ ЕСТЬNULL(АВСКлассификацияНоменклатуры.Ссылка, ЗНАЧЕНИЕ(Справочник.АВСКлассификацияНоменклатуры.ПустаяСсылка)) <> ВсеТовары.Ссылка.ГруппаАВС)";
	
	Если Не ЗагружатьЗакупочнуюЦену Тогда 
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВсеТовары.ЦенаЗакупочная, ", "");
	КонецЕсли;
	
	Если Не ЗагружатьАДУрал Тогда 
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВсеТовары.ЦенаАДУрал, ", "");
	КонецЕсли;
	
	НоменклатураКИзменению =  Запрос.Выполнить().Выгрузить();
	
	Если НЕ Константы.ЗапретитьОбновлениеГруппыABCНоменклатуры.Получить() Тогда	
		
		Попытка
			
			Для Каждого ТекСтр ИЗ НоменклатураКИзменению Цикл   
				
				Об = ТекСтр.Ссылка.ПолучитьОбъект();
				Об.ГруппаАВС = ТекСтр.КатегорияНовая;
				Об.НоменклатурнаяГруппа = ТекСтр.НГНовая;
				Об.Записать();           
				
			КонецЦикла;	
			
		Исключение
		КонецПопытки;   
		
	КонецЕсли;		 
	
	// создание документов Цен
	
	ЗагружатьЦеныВРублях = Ложь;
	ВалютаРубль = Константы.ВалютаРегламентированногоУчета.Получить();
	
	ДатаПерехода = Константы.ДатаНачалаЗагрузкиИВыгрузкиЦенВРублях.Получить();  
	
	Если ЗначениеЗаполнено(ДатаПерехода) И ТекущаяДата() > ДатаПерехода Тогда 
		ЗагружатьЦеныВРублях = Истина;
	КонецЕсли;                  
	
	ДатаНачалаУдаления = ТекущаяДата()-1;
	
	ЗапросЦенНаДату = Новый Запрос;
	ЗапросЦенНаДату.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЦеныНоменклатуры.Номенклатура,
	|	ЦеныНоменклатуры.ТипЦен,
	|	ЦеныНоменклатуры.Период
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры КАК ЦеныНоменклатуры
	|ГДЕ
	|	ЦеныНоменклатуры.Период МЕЖДУ &НачДата И &КонДата
	|	И ЦеныНоменклатуры.Цена <> 0
	|	И ЦеныНоменклатуры.ТипЦен В(&МассивТиповЦен)"; 
	
	ЗапросЦенНаДату.УстановитьПараметр("НачДата", НачалоДня(ТекущаяДата()));
	ЗапросЦенНаДату.УстановитьПараметр("КонДата", КонецДня(ТекущаяДата()));
	ЗапросЦенНаДату.УстановитьПараметр("МассивТиповЦен", МассивТиповЦен);   
	
	РезультатЗапросаЦенНаДату = ЗапросЦенНаДату.Выполнить().Выгрузить();
	ЕстьЦеныНаДату = РезультатЗапросаЦенНаДату.Количество() > 0;      
	
	МаксимальнаяДатаДокумента = КонецДня(ТекущаяДата());      
	
	НовыйДокумент = СоздатьНовыйДокументЦен(МассивТиповЦен, Робот, МаксимальнаяДатаДокумента);  
	
	СчетчикСтрокВДокументе = 0;
	СтрокСЦенами = 0;
	КоличествоДокументовУстановкиЦен = 0;  
	
	Для Каждого ТекСтр Из ТаблицаЦен Цикл
		
		ЕстьЦенаВСтроке = Ложь;
		
		Для сч = 3 По 8 + ?(ЗагружатьЗакупочнуюЦену, 1, 0) + ?(ЗагружатьАДУрал, 1, 0) Цикл 
			
			НоваяСтрокаДокумента = НовыйДокумент.Товары.Добавить();
			НоваяСтрокаДокумента.Номенклатура 		= ТекСтр.Ссылка;
			НоваяСтрокаДокумента.ЕдиницаИзмерения  	= ТекСтр.ЕдиницаХраненияОстатков;  
			
			ТекТипЦен = МассивТиповЦен[сч-3];
			ЕстьУстановленнаяЦенаНаДату = Ложь;   
			
			Если ЕстьЦеныНаДату Тогда
				ЕстьУстановленнаяЦенаНаДату = РезультатЗапросаЦенНаДату.НайтиСтроки(Новый Структура("ТипЦен,Номенклатура", ТекТипЦен, ТекСтр.Ссылка)).Количество() > 0;
			КонецЕсли;			
			
			Если ЕстьУстановленнаяЦенаНаДату  Тогда
				НоваяСтрокаДокумента.Цена = 0;
			Иначе				
				НоваяСтрокаДокумента.Цена = ТекСтр[сч];
			КонецЕсли;    
			
			НоваяСтрокаДокумента.ТипЦен = ТекТипЦен;        
			
			Если ЗагружатьЦеныВРублях Тогда 
				НоваяСтрокаДокумента.Валюта = ВалютаРубль;
			Иначе
				НоваяСтрокаДокумента.Валюта = ТекТипЦен.ВалютаЦены;
			КонецЕсли;               
			
			НоваяСтрокаДокумента.ИндексСтрокиТаблицыЦен = ТаблицаЦен.Индекс(ТекСтр);
			
			СчетчикСтрокВДокументе = СчетчикСтрокВДокументе + 1;
			
			Если НЕ ЕстьЦенаВСтроке Тогда
				Если ЗначениеЗаполнено(ТекСтр[сч]) Тогда
					ЕстьЦенаВСтроке = Истина;		
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		Если ЕстьЦенаВСтроке Тогда
			СтрокСЦенами = СтрокСЦенами + 1;
		КонецЕсли;
		
		Если СчетчикСтрокВДокументе >= КоличествоСтрокВДокументе Тогда    
			
			Попытка
				
				НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение); 				
				КоличествоДокументовУстановкиЦен = КоличествоДокументовУстановкиЦен + 1;				
				
			Исключение
				
				НовыйДокумент.Записать();
				УдалятьПредыдущиеДокументы = Ложь;
				ЗаписьЖурналаРегистрации("Загрузка цен.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
				"Записан документ установки цен с количеством товаров: " + Строка(НовыйДокумент.Товары.Количество()) + Символы.ПС + ОписаниеОшибки());
				
			КонецПопытки;              
			
			НовыйДокумент = СоздатьНовыйДокументЦен(МассивТиповЦен, Робот,МаксимальнаяДатаДокумента);
			СчетчикСтрокВДокументе = 0;  
			
		КонецЕсли;
		
	КонецЦикла; 
	
	Если НовыйДокумент.Товары.Количество()> 0 Тогда      
		
		Попытка
			
			НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
			КоличествоДокументовУстановкиЦен = КоличествоДокументовУстановкиЦен + 1;   
			
		Исключение
			
			НовыйДокумент.Записать();
			УдалятьПредыдущиеДокументы = Ложь;
			ЗаписьЖурналаРегистрации("Загрузка цен.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
			"Записан документ установки цен с количеством товаров: " + Строка(НовыйДокумент.Товары.Количество()) + Символы.ПС + ОписаниеОшибки());   
			
		КонецПопытки;  
		
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации("Загрузка цен.Обработка", УровеньЖурналаРегистрации.Информация,,, 
	"Проведено " + Строка(КоличествоДокументовУстановкиЦен) + " документов установки цен (строк с ценами: " + Строка(СтрокСЦенами) 
	+ " всего: " + Строка(ТаблицаЦен.Количество()) + ")");
	
	Если НЕ Константы.НеСниматьФлагНеЗагружатьЦеныПриЗагрузкеЦен.Получить() Тогда
		
		Для Каждого ТекСтр ИЗ ТаблицаНоменклатурыКСнятиюПометки Цикл   
			
			ЭлементНоменклатура	= ТекСтр.Номенклатура.ПолучитьОбъект();
			ЭлементНоменклатура.НеЗагружатьЦеныЕслиЕстьОстатокТовара = Ложь;   
			
			Попытка
				ЭлементНоменклатура.Записать();
			Исключение
			КонецПопытки;	
			
		КонецЦикла; 
		
	КонецЕсли;

	Орг = Константы.ОсновнаяОрганизация.Получить();
	Контр = Константы.ОсновнойПоставщик.Получить();
	ТипЦен = Константы.ОсновнаяЦенаЗакупкиПоставщика.Получить();           
	
	Если ЗначениеЗаполнено(Орг) И ЗначениеЗаполнено(Контр) И ЗначениеЗаполнено(ТипЦен) Тогда     
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТЗ.Артикул,
		|	ТЗ.Цена
		|ПОМЕСТИТЬ Табл
		|ИЗ
		|	&ТЗ КАК ТЗ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Табл.Артикул,
		|	Табл.Цена,
		|	Номенклатура.Ссылка,
		|	Номенклатура.ЕдиницаХраненияОстатков КАК ЕдХраненияОстатков
		|ИЗ
		|	Табл КАК Табл
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
		|		ПО Табл.Артикул = Номенклатура.Артикул";  
		
		Запрос.УстановитьПараметр("ТЗ", ТабЗакупки);  
		
		Выб = Запрос.Выполнить().Выбрать();   
		
		СчетчикСтрокВДокументе = 0; 
		
		НовыйДокумент = Документы.УстановкаЦенНоменклатурыКонтрагентов.СоздатьДокумент();
		НовыйДокумент.Дата = Мин(ТекущаяДата(),МаксимальнаяДатаДокумента);
		НовыйДокумент.Контрагент = Контр;
		НовыйДокумент.Ответственный = Робот;
		НовыйДокумент.НеПроводитьНулевыеЗначения = Истина;  
		
		СтрТипов = НовыйДокумент.ТипыЦен.Добавить();
		СтрТипов.ТипЦен = ТипЦен;
		
		СтрокСЦенамиКонтрагентов = 0;
		КоличествоДокументовУстановкиЦенКонтрагентов = 0;
		
		Пока Выб.Следующий() Цикл
			
			Если ЗначениеЗаполнено(Выб.Ссылка) И ЗначениеЗаполнено(Выб.ЕдХраненияОстатков) И ЗначениеЗаполнено(Выб.Цена) Тогда
				
				НоваяСтрокаДокумента = НовыйДокумент.Товары.Добавить();
				НоваяСтрокаДокумента.Номенклатура 		= Выб.Ссылка;
				НоваяСтрокаДокумента.ЕдиницаИзмерения  	= Выб.ЕдХраненияОстатков;
				НоваяСтрокаДокумента.Цена 				= Выб.Цена;
				НоваяСтрокаДокумента.ТипЦен 			= ТипЦен ;       
				
				Если ЗагружатьЦеныВРублях Тогда 
					НоваяСтрокаДокумента.Валюта 		= ВалютаРубль;
				Иначе
					НоваяСтрокаДокумента.Валюта 		= ТипЦен.ВалютаЦены;
				КонецЕсли;       
				
				НоваяСтрокаДокумента.ИндексСтрокиТаблицыЦен = 0;
				
				СчетчикСтрокВДокументе = СчетчикСтрокВДокументе + 1;
				СтрокСЦенамиКонтрагентов = СтрокСЦенамиКонтрагентов + 1;
				
			КонецЕсли;
			
			Если СчетчикСтрокВДокументе >= КоличествоСтрокВДокументе Тогда
				
				Попытка
					
					НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
					КоличествоДокументовУстановкиЦенКонтрагентов = КоличествоДокументовУстановкиЦенКонтрагентов + 1;
					
				Исключение
					
					НовыйДокумент.Записать();
					ЗаписьЖурналаРегистрации("Загрузка цен.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
					"Записан документ установки цен контрагентов с количеством товаров: " + Строка(НовыйДокумент.Товары.Количество()) + Символы.ПС + ОписаниеОшибки());
					
				КонецПопытки;  
				
				НовыйДокумент = Документы.УстановкаЦенНоменклатурыКонтрагентов.СоздатьДокумент();
				НовыйДокумент.Дата = Мин(ТекущаяДата(), МаксимальнаяДатаДокумента);
				НовыйДокумент.Контрагент = Контр;
				НовыйДокумент.Ответственный = Робот;
				НовыйДокумент.НеПроводитьНулевыеЗначения = Истина;  
				
				СтрТипов = НовыйДокумент.ТипыЦен.Добавить();
				СтрТипов.ТипЦен = ТипЦен;
				СчетчикСтрокВДокументе = 0;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если НовыйДокумент.Товары.Количество()> 0 Тогда  
			
			Попытка
				
				НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
				КоличествоДокументовУстановкиЦенКонтрагентов = КоличествоДокументовУстановкиЦенКонтрагентов + 1;
				
			Исключение
				
				НовыйДокумент.Записать();
				ЗаписьЖурналаРегистрации("Загрузка цен.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
				"Записан документ установки цен контрагентов с количеством товаров: " + Строка(НовыйДокумент.Товары.Количество()) + Символы.ПС + ОписаниеОшибки());
				
			КонецПопытки;        
			
		КонецЕсли;
		
		ЗаписьЖурналаРегистрации("Загрузка цен.Обработка", УровеньЖурналаРегистрации.Информация,,, 
		"Проведено " + Строка(КоличествоДокументовУстановкиЦенКонтрагентов) + " документов установки цен контрагентов (строк с ценами: " 
		+ Строка(СтрокСЦенамиКонтрагентов) + " всего: " + Строка(Выб.Количество()) + ")");
		
	КонецЕсли;
	
	Если УдалятьПредыдущиеДокументы И ЗначениеЗаполнено(Робот) Тогда
		
		ЗаписьЖурналаРегистрации("Загрузка цен.Обработка", УровеньЖурналаРегистрации.Информация,,, 
		"Начало удаления предыдущих цен на дату меньшую: " + Формат(ДатаНачалаУдаления, "ДЛФ=DT"));
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	УстановкаЦенНоменклатурыТипыЦен.Ссылка
		|ИЗ
		|	Документ.УстановкаЦенНоменклатуры.ТипыЦен КАК УстановкаЦенНоменклатурыТипыЦен
		|ГДЕ
		|	УстановкаЦенНоменклатурыТипыЦен.Ссылка.Ответственный = &Ответственный
		|	И УстановкаЦенНоменклатурыТипыЦен.Ссылка.Дата < &Дата
		|
		|СГРУППИРОВАТЬ ПО
		|	УстановкаЦенНоменклатурыТипыЦен.Ссылка";
		
		Запрос.УстановитьПараметр("Дата", ДатаНачалаУдаления);
		Запрос.УстановитьПараметр("Ответственный", Робот);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		УдаленоЦенНоменклатуры = 0;
		
		Пока Выборка.Следующий() Цикл
			
			Об = Выборка.Ссылка.ПолучитьОбъект();
			
			КоличествоТоваров = Об.Товары.Количество();
			
			Попытка
				
				Об.Удалить();
				УдаленоЦенНоменклатуры = УдаленоЦенНоменклатуры + 1;
				
			Исключение
				
				Попытка
					
					Об.УстановитьПометкуУдаления(Истина);
					ЗаписьЖурналаРегистрации("Загрузка цен.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
					"Установлена пометка удаления докумена установки цен с количеством товаров: " + Строка(КоличествоТоваров) + Символы.ПС + ОписаниеОшибки());
					
				Исключение
					ЗаписьЖурналаРегистрации("Загрузка цен.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
					"Ошибка при установке пометке на удаление документа: " + Символы.ПС + ОписаниеОшибки());
				КонецПопытки;
				
			КонецПопытки;       
			
		КонецЦикла;
		
		ЗаписьЖурналаРегистрации("Загрузка цен.Обработка", УровеньЖурналаРегистрации.Информация,,, 
		"Удалено " + Строка(УдаленоЦенНоменклатуры) + " документов установки цен");
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	УстановкаЦенНоменклатурыКонтрагентовТипыЦен.Ссылка
		|ИЗ
		|	Документ.УстановкаЦенНоменклатурыКонтрагентов.ТипыЦен КАК УстановкаЦенНоменклатурыКонтрагентовТипыЦен
		|ГДЕ
		|	УстановкаЦенНоменклатурыКонтрагентовТипыЦен.Ссылка.Ответственный = &Ответственный
		|	И УстановкаЦенНоменклатурыКонтрагентовТипыЦен.Ссылка.Дата < &Дата
		|
		|СГРУППИРОВАТЬ ПО
		|	УстановкаЦенНоменклатурыКонтрагентовТипыЦен.Ссылка";
		
		Запрос.УстановитьПараметр("Дата", ДатаНачалаУдаления);
		Запрос.УстановитьПараметр("Ответственный", Робот);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		УдаленоЦенНоменклатурыКонтрагентов = 0;
		
		Пока Выборка.Следующий() Цикл 
			
			Об = Выборка.Ссылка.ПолучитьОбъект();
			
			КоличествоТоваров = Об.Товары.Количество();
			
			Попытка
				
				Об.Удалить();
				УдаленоЦенНоменклатурыКонтрагентов = УдаленоЦенНоменклатурыКонтрагентов + 1;  
				
			Исключение            
				
				Попытка
					
					Об.УстановитьПометкуУдаления(Истина);
					ЗаписьЖурналаРегистрации("Загрузка цен.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
					"Установлена пометка удаления докумена установки цен с количеством товаров: " + Строка(КоличествоТоваров) + Символы.ПС + ОписаниеОшибки());
					
				Исключение
					ЗаписьЖурналаРегистрации("Загрузка цен.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
					"Ошибка при установке пометке на удаление документа: " + Символы.ПС + ОписаниеОшибки());
				КонецПопытки;      
				
			КонецПопытки;
			
		КонецЦикла;      
		
		ЗаписьЖурналаРегистрации("Загрузка цен.Обработка", УровеньЖурналаРегистрации.Информация,,, 
		"Удалено " + Строка(УдаленоЦенНоменклатурыКонтрагентов) + " документов установки цен контрагентов");
		
		ЗаписьЖурналаРегистрации("Загрузка цен.Обработка", УровеньЖурналаРегистрации.Информация,,, 
		"Окончание удаления предыдущих цен");
		
	КонецЕсли;
	
КонецПроцедуры   

Процедура СозданиеДокументаЕдиныйПрайсЛист(Файл, УдалятьПредыдущиеДокументы = Истина, ИмяФайлаЗагрузки = "", Частично = Истина, Соединение = Неопределено)  
	
	Если Не ЗначениеЗаполнено(Файл) Тогда 
		Возврат;
	КонецЕсли;
	
	ИмяРегЗадания = "Загрузка цен единый прайс-лист" + ?(Частично, " ЧАСТИЧНО", "");
	
	ДатаЗагрузки = ТекущаяДата();
	МассивДокументов = Новый Массив;
	МассивОшибок = Новый Массив;
	
	КоличествоСтрокВДокументе = 25000;
	Робот = Справочники.Пользователи.НайтиПоКоду("robot");

	ТекущаяБаза = Константы.База.Получить();
	ОтдельноеЮрЛицо = ТекущаяБаза = Перечисления.НазваниеБазы.Воронеж
	Или ТекущаяБаза = Перечисления.НазваниеБазы.Казань
	Или ТекущаяБаза = Перечисления.НазваниеБазы.Ростов
	Или ТекущаяБаза = Перечисления.НазваниеБазы.Краснодар
	Или ТекущаяБаза = Перечисления.НазваниеБазы.Краснодар2
	Или ТекущаяБаза = Перечисления.НазваниеБазы.НижнийНовгород;
	
	ЗакупочнаяЦена 	= Константы.ЗакупочнаяЦена.Получить();
	Базовая 		= Константы.БазоваяЦена.Получить();
	Скидка35 		= Константы.Скидка35.Получить();
	Скидка36 		= Константы.Скидка36.Получить();
	Скидка37 		= Константы.Скидка37.Получить();
	Скидка38		= Константы.Скидка38.Получить();	
	СпецЦена        = Константы.СпецЦена.Получить();
	АДУрал			= Константы.АДУрал.Получить();
	Акция			= Константы.Акция.Получить();
	Уцененные		= Константы.Уцененные.Получить();
	Резерв4  		= Константы.Резерв4.Получить();   
	АвтоЕвропа      = Константы.АвтоЕвропа.Получить();
	
	ЗагружатьЗакупочнуюЦену = Истина; 
	ЗагружатьЦенуДляРекламнойПродукции = Истина;
	
	МассивТиповЦен =  Новый Массив;
	СоотвествиеТиповИКолонок = Новый Соответствие; 
	
	Если ЗначениеЗаполнено(АДУрал) Тогда       
		
		МассивТиповЦен.Добавить(АДУрал);
		СоотвествиеТиповИКолонок.Вставить(АДУрал, 3);  
		
	КонецЕсли;  	
	
	МассивТиповЦен.Добавить(Скидка35);
	СоотвествиеТиповИКолонок.Вставить(Скидка35, 6); 	
	МассивТиповЦен.Добавить(Базовая);
	СоотвествиеТиповИКолонок.Вставить(Базовая, 7);
	МассивТиповЦен.Добавить(ЗакупочнаяЦена);
	СоотвествиеТиповИКолонок.Вставить(ЗакупочнаяЦена, ?(ОтдельноеЮрЛицо, 3, 9)); 	
	МассивТиповЦен.Добавить(Скидка36);
	СоотвествиеТиповИКолонок.Вставить(Скидка36, 11);
	МассивТиповЦен.Добавить(Скидка37);
	СоотвествиеТиповИКолонок.Вставить(Скидка37, 12);
	МассивТиповЦен.Добавить(Скидка38);
	СоотвествиеТиповИКолонок.Вставить(Скидка38, 14);
	
	Если ЗначениеЗаполнено(Уцененные) Тогда
		
		МассивТиповЦен.Добавить(Уцененные);		
		СоотвествиеТиповИКолонок.Вставить(Уцененные, 16);
		
	КонецЕсли;
	
	
	Если ЗначениеЗаполнено(Акция) Тогда
		
		МассивТиповЦен.Добавить(Акция);
		СоотвествиеТиповИКолонок.Вставить(Акция, 17);
		
	КонецЕсли;
	
	МассивТиповЦен.Добавить(СпецЦена);
	СоотвествиеТиповИКолонок.Вставить(СпецЦена, 19);

	Если ЗначениеЗаполнено(Резерв4) Тогда
		
		МассивТиповЦен.Добавить(Резерв4);
		СоотвествиеТиповИКолонок.Вставить(Резерв4, 20); 
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(АвтоЕвропа) Тогда
		
		МассивТиповЦен.Добавить(АвтоЕвропа);
		СоотвествиеТиповИКолонок.Вставить(АвтоЕвропа, 4); 
		
	КонецЕсли;
	
	ТаблицаТоваровИЦен = Новый ТаблицаЗначений;
	ТаблицаТоваровИЦен.Колонки.Добавить("КодМДМ", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(36))); 
	
	ТаблицаЗакупка = Новый ТаблицаЗначений;
	ТаблицаЗакупка.Колонки.Добавить("КодМДМ", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(36)));
	ТаблицаЗакупка.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	
	Для Каждого СтрокаСоответствия Из СоотвествиеТиповИКолонок Цикл
		
		Если ТаблицаТоваровИЦен.Колонки.Найти("Кол_" + СокрЛП(СтрокаСоответствия.Значение)) = Неопределено Тогда    
			
			ТаблицаТоваровИЦен.Колонки.Добавить("Кол_" + СокрЛП(СтрокаСоответствия.Значение),
			Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)), СокрЛП(СтрокаСоответствия.Ключ));  
			
		КонецЕсли;
		
	КонецЦикла;	
	
	ForReading = 1;
	
	objFSO = Новый COMОбъект("Scripting.FileSystemObject");
	Текст = objFSO.OpenTextFile(Файл,ForReading,1);   
	
	КолонкаЦеныЗакупки = ?(ОтдельноеЮрЛицо,2,8); 
	
	Пока Текст.atEndOfStream()=0 Цикл 
		
		СтрокаФайла=Текст.ReadLine();
		МассивСтрокиДанных = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(СтрокаФайла, Символы.Таб);    
		
		НоваяСтрокаТаблицы = ТаблицаТоваровИЦен.Добавить();
		НоваяСтрокаТаблицы.КодМДМ = МассивСтрокиДанных[0];
		
		Для Каждого СтрокаСоответствия Из СоотвествиеТиповИКолонок Цикл			
			НоваяСтрокаТаблицы["Кол_" + СокрЛП(СтрокаСоответствия.Значение)] = МассивСтрокиДанных[СтрокаСоответствия.Значение - 1];
		КонецЦикла;                             
		
		Попытка
			ЦенаЗакупки = Число(МассивСтрокиДанных[КолонкаЦеныЗакупки]); 
		Исключение
			ЦенаЗакупки = 0;
		КонецПопытки;
		
		Если НЕ ЦенаЗакупки = 0 Тогда
			
			НоваяСтрокаЗакупка = ТаблицаЗакупка.Добавить();
			НоваяСтрокаЗакупка.КодМДМ = МассивСтрокиДанных[0]; 
			НоваяСтрокаЗакупка.Цена = ЦенаЗакупки;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Текст.Close();
	УдалитьФайлы(Файл); 
	
	Сообщить("В файле " + СокрЛП(ТаблицаТоваровИЦен.Количество()) + " строк");
	Сообщить("В файле закупка " + СокрЛП(ТаблицаЗакупка.Количество()) + " строк");     
	
	ЗаписьЖурналаРегистрации(ИмяРегЗадания + ".Обработка", УровеньЖурналаРегистрации.Информация,,, 
	"Количество строк в полученной таблице: " + Строка(ТаблицаТоваровИЦен.Количество()));	
	
	ЗапросТаблицыДляЗагрузки = Новый Запрос;
	ЗапросТаблицыДляЗагрузки.УстановитьПараметр("ТаблицаТоваровИЦен",ТаблицаТоваровИЦен);
	
	Если Константы.ИспользоватьГруппуНоменклатурыУценка.Получить() И ЗначениеЗаполнено(Константы.ГруппаНоменклатурыУценка.Получить()) Тогда
		ЗапросТаблицыДляЗагрузки.УстановитьПараметр("Уценка", Константы.ГруппаНоменклатурыУценка.Получить());
	Иначе
		ЗапросТаблицыДляЗагрузки.УстановитьПараметр("Уценка", Справочники.Номенклатура.ПустаяСсылка());
	КонецЕсли;	
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТабЗагрузки.КодМДМ, ";      
	
	Для Каждого СтрокаСоответствия Из СоотвествиеТиповИКолонок Цикл
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + "	ТабЗагрузки.Кол_" + СокрЛП(СтрокаСоответствия.Значение) + ","
	КонецЦикла;                  
	
	ТекстЗапроса = Лев(ТекстЗапроса,стрДлина(ТекстЗапроса)-1) + " 
	|ПОМЕСТИТЬ Таб
	|ИЗ
	|	&ТаблицаТоваровИЦен КАК ТабЗагрузки
	| ГДЕ ";             
	
	Для Каждого СтрокаСоответствия Из СоотвествиеТиповИКолонок Цикл
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + "НЕ ТабЗагрузки.Кол_" + СокрЛП(СтрокаСоответствия.Значение) + " = 0 ИЛИ "
	КонецЦикла; 	   
	
	ТекстЗапроса = Лев(ТекстЗапроса, СтрДлина(ТекстЗапроса) - 4) + "
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ТабЗагрузки.КодМДМ  
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СправочникНоменклатура.Ссылка,
	|	СправочникНоменклатура.НеЗагружатьЦеныЕслиЕстьОстатокТовара,
	|	Таб.КодМДМ, ";                                               
	
	Для Каждого СтрокаСоответствия Из СоотвествиеТиповИКолонок Цикл
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + "	Таб.Кол_" + СокрЛП(СтрокаСоответствия.Значение) + ","
	КонецЦикла;                                         
	
	ТекстЗапроса = Лев(ТекстЗапроса, СтрДлина(ТекстЗапроса) - 1) + " 
	|ПОМЕСТИТЬ ВсеТовары
	|ИЗ
	|	Таб КАК Таб
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	|		ПО Таб.КодМДМ = СправочникНоменклатура.КодМДМ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВсеТовары.Ссылка,
	|	ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0) + ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0) КАК Остаток
	|ПОМЕСТИТЬ НеЗагружаемыеТовары
	|ИЗ 
	|	ВсеТовары КАК ВсеТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки КАК ТоварыНаСкладахОстатки
	|		ПО (ТоварыНаСкладахОстатки.Номенклатура = ВсеТовары.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки КАК ТоварыВРезервеНаСкладахОстатки
	|		ПО (ТоварыВРезервеНаСкладахОстатки.Номенклатура = ВсеТовары.Ссылка)
	|ГДЕ
	|	ВсеТовары.НеЗагружатьЦеныЕслиЕстьОстатокТовара
	|	И ВЫБОР
	|			КОГДА НЕ &Уценка = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|				ТОГДА НЕ ВсеТовары.Ссылка В ИЕРАРХИИ (&Уценка)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ  	
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВсеТовары.Ссылка,
	|	ВсеТовары.КодМДМ, "; 
	
	Для Каждого СтрокаСоответствия Из СоотвествиеТиповИКолонок Цикл
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + "	ВсеТовары.Кол_" + СокрЛП(СтрокаСоответствия.Значение) + ","
	КонецЦикла;              
	
	ТекстЗапроса = Лев(ТекстЗапроса, СтрДлина(ТекстЗапроса)-1) + " 
	|ПОМЕСТИТЬ ТабНоменклатуры
	|ИЗ
	|	ВсеТовары КАК ВсеТовары
	|ГДЕ
	|	НЕ ВсеТовары.Ссылка В
	|				(ВЫБРАТЬ
	|					НеЗагружаемыеТовары.Ссылка
	|				ИЗ 
	|  	                Константы КАК Константы,
	|					НеЗагружаемыеТовары КАК НеЗагружаемыеТовары
	|				ГДЕ
	|					ВЫБОР
	|					КОГДА Константы.НеСниматьФлагНеЗагружатьЦеныПриЗагрузкеЦен
	|						ТОГДА ИСТИНА
	|					ИНАЧЕ НеЗагружаемыеТовары.Остаток > 0
	|   				КОНЕЦ) 
	|	И ВЫБОР
	|			КОГДА НЕ &Уценка = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|				ТОГДА НЕ ВсеТовары.Ссылка В ИЕРАРХИИ (&Уценка)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ  	
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабНоменклатуры.Ссылка,
	|	ТабНоменклатуры.КодМДМ,
	|	ТабНоменклатуры.Ссылка.ЕдиницаХраненияОстатков КАК ЕдиницаХраненияОстатков, ";
	
	Для Каждого СтрокаСоответствия Из СоотвествиеТиповИКолонок Цикл
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + "	ТабНоменклатуры.Кол_" + СокрЛП(СтрокаСоответствия.Значение) + ","
	КонецЦикла;                            
	
	ТекстЗапроса = Лев(ТекстЗапроса,стрДлина(ТекстЗапроса) - 1) + "
	|ИЗ
	|	ТабНоменклатуры КАК ТабНоменклатуры ";        
	
	ЗапросТаблицыДляЗагрузки.Текст = ТекстЗапроса;
	ПакетРезультата = ЗапросТаблицыДляЗагрузки.ВыполнитьПакет();
	ТаблицаЦен = ПакетРезультата[4].Выгрузить();   
	
	Сообщить("В запросе " + СокрЛП(ТаблицаЦен.Количество()) + " строк");
	ЗаписьЖурналаРегистрации("Загрузка цен единый прайс-лист.Обработка", УровеньЖурналаРегистрации.Информация,,, 
	"Количество строк с ценами: " + Строка(ТаблицаЦен.Количество()));
	
	ВалютаРубль = Константы.ВалютаРегламентированногоУчета.Получить();
	ДатаНачалаУдаления = ТекущаяДата() - 1; 
	
	ЗапросЦенНаДату = Новый Запрос;
	ЗапросЦенНаДату.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЦеныНоменклатуры.Номенклатура,
	|	ЦеныНоменклатуры.ТипЦен,
	|	ЦеныНоменклатуры.Период
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры КАК ЦеныНоменклатуры
	|ГДЕ
	|	ЦеныНоменклатуры.Период МЕЖДУ &НачДата И &КонДата
	|	И ЦеныНоменклатуры.Цена <> 0
	|	И ЦеныНоменклатуры.ТипЦен В(&МассивТиповЦен)";  
	
	ЗапросЦенНаДату.УстановитьПараметр("НачДата", НачалоДня(ТекущаяДата()));
	ЗапросЦенНаДату.УстановитьПараметр("КонДата", КонецДня(ТекущаяДата()));
	ЗапросЦенНаДату.УстановитьПараметр("МассивТиповЦен", МассивТиповЦен);  
	
	РезультатЗапросаЦенНаДату = ЗапросЦенНаДату.Выполнить().Выгрузить();
	ЕстьЦеныНаДату = РезультатЗапросаЦенНаДату.Количество() > 0;
	
	МаксимальнаяДатаДокумента = КонецДня(ТекущаяДата());         
	
	НовыйДокумент = СоздатьНовыйДокументЦен(МассивТиповЦен, Робот, МаксимальнаяДатаДокумента);
	НовыйДокумент.ИмяФайлаЗагрузки = ИмяФайлаЗагрузки;		    
	
	СчетчикСтрокВДокументе = 0;
	СтрокСЦенами = 0;
	КоличествоДокументовУстановкиЦен = 0; 
	
	Для каждого ТекСтр Из ТаблицаЦен Цикл  
		
		Если ЗначениеЗаполнено(ТекСтр.Ссылка) И ЗначениеЗаполнено(ТекСтр.ЕдиницаХраненияОстатков) Тогда 
			
			ЕстьЦенаВСтроке = Ложь;                                     
			
			Для Каждого СтрокаСоответствия Из СоотвествиеТиповИКолонок Цикл      
				
				НоваяСтрокаДокумента = НовыйДокумент.Товары.Добавить();
				НоваяСтрокаДокумента.Номенклатура 		= ТекСтр.Ссылка;
				НоваяСтрокаДокумента.ЕдиницаИзмерения  	= ТекСтр.ЕдиницаХраненияОстатков; 
				
				ТекТипЦен = СтрокаСоответствия.Ключ;
				ЕстьУстановленнаяЦенаНаДату = Ложь;

				Если ЕстьУстановленнаяЦенаНаДату  Тогда
					НоваяСтрокаДокумента.Цена = 0;
				Иначе				
					НоваяСтрокаДокумента.Цена = ТекСтр["Кол_" + СтрокаСоответствия.Значение];
				КонецЕсли;
				
				НоваяСтрокаДокумента.ТипЦен = ТекТипЦен ;
				НоваяСтрокаДокумента.Валюта = ВалютаРубль;
				
				НоваяСтрокаДокумента.ИндексСтрокиТаблицыЦен = ТаблицаЦен.Индекс(ТекСтр);
				
				СчетчикСтрокВДокументе = СчетчикСтрокВДокументе + 1;
				
				Если НЕ ЕстьЦенаВСтроке Тогда           
					
					Если ЗначениеЗаполнено(ТекСтр["Кол_" + СтрокаСоответствия.Значение]) Тогда
						ЕстьЦенаВСтроке = Истина;		
					КонецЕсли;                  
					
				КонецЕсли;   
				
			КонецЦикла; 
			
		КонецЕсли; 
		
		Если ЕстьЦенаВСтроке Тогда
			СтрокСЦенами = СтрокСЦенами + 1;
		КонецЕсли;                    
		
		Если СчетчикСтрокВДокументе >= КоличествоСтрокВДокументе Тогда 
			
			Попытка
				
				НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение); 				
				КоличествоДокументовУстановкиЦен = КоличествоДокументовУстановкиЦен + 1;	
				
			Исключение                   
				
				НовыйДокумент.Записать();
				УдалятьПредыдущиеДокументы = Ложь;     
				
				ЗаписьЖурналаРегистрации(ИмяРегЗадания + ".Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
				"Записан документ установки цен с количеством товаров: " + Строка(НовыйДокумент.Товары.Количество() / СоотвествиеТиповИКолонок.Количество()) 
				+ Символы.ПС + ОписаниеОшибки());     
				
				МассивОшибок.Добавить("Ошибка при проведении документа Установка цен номенклатуры " + НовыйДокумент.Номер + Символы.ПС + ОписаниеОшибки());  
				
			КонецПопытки;                  
			
			МассивДокументов.Добавить(НовыйДокумент.Ссылка);	
			НовыйДокумент = СоздатьНовыйДокументЦен(МассивТиповЦен, Робот,МаксимальнаяДатаДокумента);
			НовыйДокумент.ИмяФайлаЗагрузки = ИмяФайлаЗагрузки;		
			СчетчикСтрокВДокументе = 0;    
			
		КонецЕсли;  
		
	КонецЦикла; 
	
	Если НовыйДокумент.Товары.Количество() > 0 Тогда   
		
		Попытка
			
			НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
			КоличествоДокументовУстановкиЦен = КоличествоДокументовУстановкиЦен + 1;
			
		Исключение
			
			НовыйДокумент.Записать();
			УдалятьПредыдущиеДокументы = Ложь;
			ЗаписьЖурналаРегистрации(ИмяРегЗадания + ".Ошибка", УровеньЖурналаРегистрации.Ошибка,,, "Записан документ установки цен с количеством товаров: " 
			+ Строка(НовыйДокумент.Товары.Количество() / СоотвествиеТиповИКолонок.Количество()) + Символы.ПС + ОписаниеОшибки());
			МассивОшибок.Добавить("Ошибка при проведении документа Установка цен номенклатуры " + НовыйДокумент.Номер + Символы.ПС + ОписаниеОшибки());
			
		КонецПопытки;
		
		МассивДокументов.Добавить(НовыйДокумент.Ссылка);	
		
	КонецЕсли;
	
	Если Не Частично Тогда
		
		Орг = Константы.ОсновнаяОрганизация.Получить();
		Контр = Константы.ОсновнойПоставщик.Получить();
		ТипЦен = Константы.ОсновнаяЦенаЗакупкиПоставщика.Получить(); 
		
		Если ЗначениеЗаполнено(Орг) И ЗначениеЗаполнено(Контр) И ЗначениеЗаполнено(ТипЦен) И ТаблицаЗакупка.Количество() > 0 Тогда  
			
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ
			|	ТЗ.КодМДМ,
			|	ТЗ.Цена
			|ПОМЕСТИТЬ Табл
			|ИЗ
			|	&ТЗ КАК ТЗ
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Табл.КодМДМ,
			|	Табл.Цена,
			|	Номенклатура.Ссылка,
			|	Номенклатура.ЕдиницаХраненияОстатков КАК ЕдХраненияОстатков
			|ИЗ
			|	Табл КАК Табл
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
			|		ПО Табл.КодМДМ = Номенклатура.КодМДМ";  
			
			Запрос.УстановитьПараметр("ТЗ", ТаблицаЗакупка);
			Выб = Запрос.Выполнить().Выбрать();      
			
			СчетчикСтрокВДокументе = 0;              
			
			НовыйДокумент = Документы.УстановкаЦенНоменклатурыКонтрагентов.СоздатьДокумент();
			НовыйДокумент.Дата = Мин(ТекущаяДата(), МаксимальнаяДатаДокумента);
			НовыйДокумент.Контрагент = Контр;
			НовыйДокумент.Ответственный = Робот;
			НовыйДокумент.НеПроводитьНулевыеЗначения = Истина; 
			
			СтрТипов = НовыйДокумент.ТипыЦен.Добавить();
			СтрТипов.ТипЦен = ТипЦен;            
			
			СтрокСЦенамиКонтрагентов = 0;
			КоличествоДокументовУстановкиЦенКонтрагентов = 0; 
			
			Пока Выб.Следующий() Цикл        
				
				Если ЗначениеЗаполнено(Выб.Ссылка) И ЗначениеЗаполнено(Выб.ЕдХраненияОстатков) И ЗначениеЗаполнено(Выб.Цена) Тогда   
					
					НоваяСтрокаДокумента = НовыйДокумент.Товары.Добавить();
					НоваяСтрокаДокумента.Номенклатура 		= Выб.Ссылка;
					НоваяСтрокаДокумента.ЕдиницаИзмерения  	= Выб.ЕдХраненияОстатков;
					НоваяСтрокаДокумента.Цена 				= Выб.Цена;
					НоваяСтрокаДокумента.ТипЦен 			= ТипЦен;
					НоваяСтрокаДокумента.Валюта 		    = ВалютаРубль;
					НоваяСтрокаДокумента.ИндексСтрокиТаблицыЦен = 0;
					СчетчикСтрокВДокументе = СчетчикСтрокВДокументе + 1;
					СтрокСЦенамиКонтрагентов = СтрокСЦенамиКонтрагентов + 1;     
					
				КонецЕсли;                                                    
				
				Если СчетчикСтрокВДокументе >= КоличествоСтрокВДокументе Тогда  
					
					Попытка
						
						НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
						КоличествоДокументовУстановкиЦенКонтрагентов = КоличествоДокументовУстановкиЦенКонтрагентов + 1;
						
					Исключение
						
						НовыйДокумент.Записать();
						ЗаписьЖурналаРегистрации("Загрузка цен единый прайс-лист.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
						"Записан документ установки цен контрагентов с количеством товаров: " + Строка(НовыйДокумент.Товары.Количество()) + Символы.ПС + ОписаниеОшибки());
						МассивОшибок.Добавить("Ошибка при проведении документа Установка цен номенклатуры " + НовыйДокумент.Номер + Символы.ПС + ОписаниеОшибки());
						
						
					КонецПопытки;
					
					НовыйДокумент = Документы.УстановкаЦенНоменклатурыКонтрагентов.СоздатьДокумент();
					НовыйДокумент.Дата = Мин(ТекущаяДата(),МаксимальнаяДатаДокумента);
					НовыйДокумент.Контрагент = Контр;
					НовыйДокумент.Ответственный = Робот;
					НовыйДокумент.НеПроводитьНулевыеЗначения = Истина;
					
					СтрТипов = НовыйДокумент.ТипыЦен.Добавить();
					СтрТипов.ТипЦен = ТипЦен;
					
					СчетчикСтрокВДокументе = 0;
					
				КонецЕсли;
				
			КонецЦикла;
			
			Если НовыйДокумент.Товары.Количество()> 0 Тогда
				
				Попытка
					
					НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
					КоличествоДокументовУстановкиЦенКонтрагентов = КоличествоДокументовУстановкиЦенКонтрагентов + 1;
					
				Исключение
					
					НовыйДокумент.Записать();
					ЗаписьЖурналаРегистрации(ИмяРегЗадания + ".Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
					"Записан документ установки цен контрагентов с количеством товаров: " + Строка(НовыйДокумент.Товары.Количество()) + Символы.ПС + ОписаниеОшибки());
					МассивОшибок.Добавить("Ошибка при проведении документа Установка цен номенклатуры " + НовыйДокумент.Номер + Символы.ПС + ОписаниеОшибки());
					
				КонецПопытки;
				
			КонецЕсли;
			
			ЗаписьЖурналаРегистрации(ИмяРегЗадания + ".Обработка", УровеньЖурналаРегистрации.Информация,,, 
			"Проведено " + Строка(КоличествоДокументовУстановкиЦенКонтрагентов) + " документов установки цен контрагентов (строк с ценами: " 
			+ Строка(СтрокСЦенамиКонтрагентов) + " всего: " + Строка(Выб.Количество()) + ")");
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не Частично и УдалятьПредыдущиеДокументы И ЗначениеЗаполнено(Робот) Тогда     
		
		ЗаписьЖурналаРегистрации(ИмяРегЗадания + ".Обработка", УровеньЖурналаРегистрации.Информация,,, 
		"Начало удаления предыдущих цен на дату меньшую: " + Формат(ДатаНачалаУдаления, "ДЛФ=DT"));  
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	УстановкаЦенНоменклатурыТипыЦен.Ссылка
		|ИЗ
		|	Документ.УстановкаЦенНоменклатуры.ТипыЦен КАК УстановкаЦенНоменклатурыТипыЦен
		|ГДЕ
		|	УстановкаЦенНоменклатурыТипыЦен.Ссылка.Ответственный = &Ответственный
		|	И УстановкаЦенНоменклатурыТипыЦен.Ссылка.Дата < &Дата
		|
		|СГРУППИРОВАТЬ ПО
		|	УстановкаЦенНоменклатурыТипыЦен.Ссылка";  
		
		Запрос.УстановитьПараметр("Дата", ДатаНачалаУдаления);
		Запрос.УстановитьПараметр("Ответственный", Робот);
		
		Выборка = Запрос.Выполнить().Выбрать();
		УдаленоЦенНоменклатуры = 0;
		
		Пока Выборка.Следующий() Цикл
			
			Об = Выборка.Ссылка.ПолучитьОбъект();
			КоличествоТоваров = Об.Товары.Количество();
			
			Попытка
				
				Об.Удалить();
				УдаленоЦенНоменклатуры = УдаленоЦенНоменклатуры + 1;
				
			Исключение
				
				Попытка
					
					Об.УстановитьПометкуУдаления(Истина);
					ЗаписьЖурналаРегистрации(ИмяРегЗадания + ".Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
					"Установлена пометка удаления докумена установки цен с количеством товаров: " + Строка(КоличествоТоваров) + Символы.ПС + ОписаниеОшибки());
					
				Исключение
					ЗаписьЖурналаРегистрации(ИмяРегЗадания + ".Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
					"Ошибка при установке пометки на удаление документа: " + Символы.ПС + ОписаниеОшибки());
				КонецПопытки;
				
			КонецПопытки;
			
		КонецЦикла;
		
		ЗаписьЖурналаРегистрации(ИмяРегЗадания + ".Обработка", УровеньЖурналаРегистрации.Информация,,, 
		"Удалено " + Строка(УдаленоЦенНоменклатуры) + " документов установки цен");
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	УстановкаЦенНоменклатурыКонтрагентовТипыЦен.Ссылка
		|ИЗ
		|	Документ.УстановкаЦенНоменклатурыКонтрагентов.ТипыЦен КАК УстановкаЦенНоменклатурыКонтрагентовТипыЦен
		|ГДЕ
		|	УстановкаЦенНоменклатурыКонтрагентовТипыЦен.Ссылка.Ответственный = &Ответственный
		|	И УстановкаЦенНоменклатурыКонтрагентовТипыЦен.Ссылка.Дата < &Дата
		|
		|СГРУППИРОВАТЬ ПО
		|	УстановкаЦенНоменклатурыКонтрагентовТипыЦен.Ссылка"; 
		
		Запрос.УстановитьПараметр("Дата", ДатаНачалаУдаления);
		Запрос.УстановитьПараметр("Ответственный", Робот);
		
		Выборка = Запрос.Выполнить().Выбрать();
		УдаленоЦенНоменклатурыКонтрагентов = 0;
		
		Пока Выборка.Следующий() Цикл
			
			Об = Выборка.Ссылка.ПолучитьОбъект();
			КоличествоТоваров = Об.Товары.Количество();
			
			Попытка
				
				Об.Удалить();
				УдаленоЦенНоменклатурыКонтрагентов = УдаленоЦенНоменклатурыКонтрагентов + 1;
				
			Исключение
				
				Попытка
					
					Об.УстановитьПометкуУдаления(Истина);
					ЗаписьЖурналаРегистрации(ИмяРегЗадания + ".Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
					"Установлена пометка удаления докумена установки цен с количеством товаров: " + Строка(КоличествоТоваров) + Символы.ПС + ОписаниеОшибки());
					
					МассивОшибок.Добавить("Установлена пометка удаления докумена установки цен с количеством товаров: " + Строка(КоличествоТоваров) + Символы.ПС + ОписаниеОшибки());
					
				Исключение
					
					ЗаписьЖурналаРегистрации(ИмяРегЗадания + ".Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
					"Ошибка при установке пометке на удаление документа: " + Символы.ПС + ОписаниеОшибки());
					МассивОшибок.Добавить("Ошибка при установке пометки на удаление документа: " + Символы.ПС + ОписаниеОшибки());
					
				КонецПопытки;
				
			КонецПопытки;
			
		КонецЦикла;
		
		ЗаписьЖурналаРегистрации(ИмяРегЗадания + ".Обработка", УровеньЖурналаРегистрации.Информация,,, 
		"Удалено " + Строка(УдаленоЦенНоменклатурыКонтрагентов) + " документов установки цен контрагентов");
		ЗаписьЖурналаРегистрации(ИмяРегЗадания + ".Обработка", УровеньЖурналаРегистрации.Информация,,, "Окончание удаления предыдущих цен");
		
	КонецЕсли; 
	
	ЗаписатьЛогЗагрузкиЕдиныйПрайсЛистЧастично(Соединение, ДатаЗагрузки, ИмяФайлаЗагрузки, МассивДокументов, ТаблицаТоваровИЦен.Количество());
	ОтправитьЭлПисьмоОбОшибкахСозданияДокументаЕдиныйПрайсЛист(ИмяРегЗадания, МассивОшибок);        
	
Конецпроцедуры

Процедура УдалениеДокументовУстановкаЦенНоменклатуры() Экспорт
//+Гавриленков В. 13.02.2026 #UT10-5690

	ДатаДо = ДобавитьМесяц(ТекущаяДата(), - 6);
	
	ЗаписьЖурналаРегистрации("Удаление цен номенклатуры", УровеньЖурналаРегистрации.Информация,,, "Начало удаления предыдущих цен на дату меньше: " + Формат(ДатаДо, "ДЛФ=DT"));  
	
	КоличествоДокументов = 100;
	
	ТаблицаСвойствЗначений = Справочники.МТ_ПредопределенныеЗначения.ПолучитьТаблицуВсехСвойствЗначений(Справочники.МТ_ПредопределенныеЗначения.УдалениеДокументовУстановкаЦенНоменклатуры);
	
	Если ТипЗнч(ТаблицаСвойствЗначений) = Тип("ТаблицаЗначений") Тогда
		
		СтрокаДата = ТаблицаСвойствЗначений.Найти("Количество месяцев хранения цен", "Свойство");
		Если (Не СтрокаДата = Неопределено) И ЗначениеЗаполнено(СтрокаДата.Значение) И (ТипЗнч(СтрокаДата.Значение) = Тип("Число")) Тогда
			ДатаДо = ДобавитьМесяц(ТекущаяДата(), - СтрокаДата.Значение);
		КонецЕсли;
		
		СтрокаКоличествоДокументов = ТаблицаСвойствЗначений.Найти("Количество документов", "Свойство");
		Если (Не СтрокаКоличествоДокументов = Неопределено) И ЗначениеЗаполнено(СтрокаКоличествоДокументов.Значение) И (ТипЗнч(СтрокаКоличествоДокументов.Значение) = Тип("Число")) Тогда
			КоличествоДокументов = СтрокаКоличествоДокументов.Значение;
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ " + Формат(КоличествоДокументов, "ЧГ=0") + "
	|	УстановкаЦенНоменклатуры.Ссылка
	|ИЗ
	|	Документ.УстановкаЦенНоменклатуры КАК УстановкаЦенНоменклатуры
	|ГДЕ
	|	УстановкаЦенНоменклатуры.Дата < &Дата";  
	
	Запрос.УстановитьПараметр("Дата", ДатаДо);
	
	Выборка = Запрос.Выполнить().Выбрать();
	УдаленоЦенНоменклатуры = 0;
	
	Пока Выборка.Следующий() Цикл
		
		Об = Выборка.Ссылка.ПолучитьОбъект();
		КоличествоТоваров = Об.Товары.Количество();
		
		Попытка
			
			Об.Удалить();
			УдаленоЦенНоменклатуры = УдаленоЦенНоменклатуры + 1;
			
		Исключение
			
			Попытка
				
				Об.УстановитьПометкуУдаления(Истина);
				ЗаписьЖурналаРегистрации("Удаление цен номенклатуры", УровеньЖурналаРегистрации.Ошибка,,, "Установлена пометка удаления докумена установки цен с количеством товаров: " + Строка(КоличествоТоваров) + Символы.ПС + ОписаниеОшибки());
				
			Исключение
				ЗаписьЖурналаРегистрации("Удаление цен номенклатуры", УровеньЖурналаРегистрации.Ошибка,,, "Ошибка при установке пометки на удаление документа: " + Символы.ПС + ОписаниеОшибки());
			КонецПопытки;
			
		КонецПопытки;
		
	КонецЦикла;
	
	ЗаписьЖурналаРегистрации("Удаление цен номенклатуры", УровеньЖурналаРегистрации.Информация,,, "Удалено " + Строка(УдаленоЦенНоменклатуры) + " документов установки цен");
	
	ЗаписьЖурналаРегистрации("Удаление цен номенклатуры", УровеньЖурналаРегистрации.Информация,,, "Окончание удаления предыдущих цен");
	
//-Гавриленков В. 13.02.2026 #UT10-5690	
КонецПроцедуры

Процедура ЗаполнитьЗначенияДляЗагрузкиИзГоловногоФилиала(МассивСтрокиДанных, МассивТиповЦен, СоотвествиеТиповИКолонок, ТаблицаТоваровИЦен, КолонкаЗакупки)
	
    СтрокВМассиве = МассивСтрокиДанных.Количество()-1;
	ИндексСтрокиМассива = 2;
	
	КонстантаЗакупочнаяЦена = Константы.ЗакупочнаяЦена.Получить();
	
	Пока ИндексСтрокиМассива <= СтрокВМассиве Цикл
		
		КодМДМТипаЦен = МассивСтрокиДанных[ИндексСтрокиМассива]; 
		
		ЕстьТипЦенПоКодуМДМ = Справочники.ТипыЦенНоменклатуры.НайтиПоРеквизиту("КодМДМ", КодМДМТипаЦен);
		
		Если ЕстьТипЦенПоКодуМДМ.Пустая() Тогда
			
			ЗаписьЖурналаРегистрации("Загрузка цен номенклатуры из головного филиала.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
						"Не найден тип цены с кодом МДМ " + СокрЛП(КодМДМТипаЦен));
			
		Иначе
			
			МассивТиповЦен.Добавить(ЕстьТипЦенПоКодуМДМ);
			СоотвествиеТиповИКолонок.Вставить(ЕстьТипЦенПоКодуМДМ, ИндексСтрокиМассива);
			
			Если ЕстьТипЦенПоКодуМДМ = КонстантаЗакупочнаяЦена Тогда
				КолонкаЗакупки = ИндексСтрокиМассива;			
			КонецЕсли;
			
		КонецЕсли;
		
		ИндексСтрокиМассива = ИндексСтрокиМассива + 1;
		
	КонецЦикла;
	
	Для Каждого СтрокаСоответствия Из СоотвествиеТиповИКолонок Цикл
		
		Если ТаблицаТоваровИЦен.Колонки.Найти("Кол_" + СокрЛП(СтрокаСоответствия.Значение)) = Неопределено Тогда    
			
			ТаблицаТоваровИЦен.Колонки.Добавить("Кол_" + СокрЛП(СтрокаСоответствия.Значение),
			Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)), СокрЛП(СтрокаСоответствия.Ключ));  
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СозданиеДокументаИзГоловногоФилиала(Файл, УдалятьПредыдущиеДокументы = Истина, ИмяФайлаЗагрузки = "", Соединение = Неопределено)  
	
	Если Не ЗначениеЗаполнено(Файл) Тогда 
		Возврат;
	КонецЕсли;
	
	ИмяРегЗадания = "Загрузка цен номенклатуры из головного филиала";
	
	ДатаЗагрузки = ТекущаяДата();
	МассивДокументов = Новый Массив;
	МассивОшибок = Новый Массив;
	
	КоличествоСтрокВДокументе = 25000;
	Робот = Справочники.Пользователи.НайтиПоКоду("robot_op");
	
	Если Робот.Пустая() Тогда
		Робот = Справочники.Пользователи.НайтиПоКоду("robot");
	КонецЕсли;
	
	ЗагружатьЗакупочнуюЦену = Истина; 
	ЗагружатьЦенуДляРекламнойПродукции = Истина;
	
	МассивТиповЦен =  Новый Массив;
	СоотвествиеТиповИКолонок = Новый Соответствие; 
	
	ТаблицаТоваровИЦен = Новый ТаблицаЗначений;
	ТаблицаТоваровИЦен.Колонки.Добавить("КодМДМ"		   , Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(36))); 
	ТаблицаТоваровИЦен.Колонки.Добавить("КратностьФилиала" , Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(36)));
	
	ТаблицаЗакупка = Новый ТаблицаЗначений;
	ТаблицаЗакупка.Колонки.Добавить("КодМДМ"			   , Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(36)));
	ТаблицаЗакупка.Колонки.Добавить("Цена"				   , Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	
	
	ForReading = 1;
	
	objFSO = Новый COMОбъект("Scripting.FileSystemObject");
	Текст = objFSO.OpenTextFile(Файл,ForReading,1);   
	
	КолонкаЦеныЗакупки = 0; 
	
	СтрокаЗаголовка = Истина;
	
	Пока Текст.atEndOfStream()=0 Цикл 
		
		СтрокаФайла=Текст.ReadLine();
		
		МассивСтрокиДанных = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(СтрокаФайла, Символы.Таб);    
		
		Если СтрокаЗаголовка Тогда
			
			ЗаполнитьЗначенияДляЗагрузкиИзГоловногоФилиала(МассивСтрокиДанных, МассивТиповЦен, СоотвествиеТиповИКолонок, ТаблицаТоваровИЦен, КолонкаЦеныЗакупки);
			
			Если СоотвествиеТиповИКолонок.Количество() = 0 Тогда
				Прервать;
			КонецЕсли;
			
			СтрокаЗаголовка = Ложь;
			
			Продолжить; 
			
		КонецЕсли;		
		
		НоваяСтрокаТаблицы = ТаблицаТоваровИЦен.Добавить();       
		
		НоваяСтрокаТаблицы.КодМДМ = МассивСтрокиДанных[0];
		НоваяСтрокаТаблицы.КратностьФилиала = МассивСтрокиДанных[1];
		
		Для Каждого СтрокаСоответствия Из СоотвествиеТиповИКолонок Цикл			
			НоваяСтрокаТаблицы["Кол_" + СокрЛП(СтрокаСоответствия.Значение)] = МассивСтрокиДанных[СтрокаСоответствия.Значение];
		КонецЦикла;                             
		
		Попытка
			ЦенаЗакупки = Число(МассивСтрокиДанных[КолонкаЦеныЗакупки]); 
		Исключение
			ЦенаЗакупки = 0;
		КонецПопытки;
		
		Если НЕ ЦенаЗакупки = 0 Тогда
			
			НоваяСтрокаЗакупка = ТаблицаЗакупка.Добавить();
			НоваяСтрокаЗакупка.КодМДМ = МассивСтрокиДанных[0]; 
			НоваяСтрокаЗакупка.Цена = ЦенаЗакупки;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Текст.Close();
	УдалитьФайлы(Файл); 
	
	Сообщить("В файле " + СокрЛП(ТаблицаТоваровИЦен.Количество()) + " строк");
	Сообщить("В файле закупка " + СокрЛП(ТаблицаЗакупка.Количество()) + " строк");     
	
	ЗаписьЖурналаРегистрации(ИмяРегЗадания + ".Обработка", УровеньЖурналаРегистрации.Информация,,, 
	"Количество строк в полученной таблице: " + Строка(ТаблицаТоваровИЦен.Количество()));	
	
	ЗапросТаблицыДляЗагрузки = Новый Запрос;
	ЗапросТаблицыДляЗагрузки.УстановитьПараметр("ТаблицаТоваровИЦен",ТаблицаТоваровИЦен);
	
	Если Константы.ИспользоватьГруппуНоменклатурыУценка.Получить() И ЗначениеЗаполнено(Константы.ГруппаНоменклатурыУценка.Получить()) Тогда
		ЗапросТаблицыДляЗагрузки.УстановитьПараметр("Уценка", Константы.ГруппаНоменклатурыУценка.Получить());
	Иначе
		ЗапросТаблицыДляЗагрузки.УстановитьПараметр("Уценка", Справочники.Номенклатура.ПустаяСсылка());
	КонецЕсли;	
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТабЗагрузки.КодМДМ, 
	|	ТабЗагрузки.КратностьФилиала, ";      
	
	Для Каждого СтрокаСоответствия Из СоотвествиеТиповИКолонок Цикл
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + "	ТабЗагрузки.Кол_" + СокрЛП(СтрокаСоответствия.Значение) + ","
	КонецЦикла;                  
	
	ТекстЗапроса = Лев(ТекстЗапроса,стрДлина(ТекстЗапроса)-1) + " 
	|ПОМЕСТИТЬ Таб
	|ИЗ
	|	&ТаблицаТоваровИЦен КАК ТабЗагрузки
	| ГДЕ ";             
	
	Для Каждого СтрокаСоответствия Из СоотвествиеТиповИКолонок Цикл
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + "НЕ ТабЗагрузки.Кол_" + СокрЛП(СтрокаСоответствия.Значение) + " = 0 ИЛИ "
	КонецЦикла; 	   
	
	ТекстЗапроса = Лев(ТекстЗапроса, СтрДлина(ТекстЗапроса) - 4) + "
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ТабЗагрузки.КодМДМ  
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СправочникНоменклатура.Ссылка,
	|	СправочникНоменклатура.НеЗагружатьЦеныЕслиЕстьОстатокТовара,
	|	Таб.КодМДМ, 
	|	Таб.КратностьФилиала, ";                                               
	
	Для Каждого СтрокаСоответствия Из СоотвествиеТиповИКолонок Цикл
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + "	Таб.Кол_" + СокрЛП(СтрокаСоответствия.Значение) + ","
	КонецЦикла;                                         
	
	ТекстЗапроса = Лев(ТекстЗапроса, СтрДлина(ТекстЗапроса) - 1) + " 
	|ПОМЕСТИТЬ ВсеТовары
	|ИЗ
	|	Таб КАК Таб
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	|		ПО Таб.КодМДМ = СправочникНоменклатура.КодМДМ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВсеТовары.Ссылка,
	|	ВсеТовары.КодМДМ, 
	|	ВсеТовары.КратностьФилиала, "; 
	
	Для Каждого СтрокаСоответствия Из СоотвествиеТиповИКолонок Цикл
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + "	ВсеТовары.Кол_" + СокрЛП(СтрокаСоответствия.Значение) + ","
	КонецЦикла;              
	
	ТекстЗапроса = Лев(ТекстЗапроса, СтрДлина(ТекстЗапроса)-1) + " 
	|ПОМЕСТИТЬ ТабНоменклатуры
	|ИЗ
	|	ВсеТовары КАК ВсеТовары 
	|ГДЕ 
	|	ВЫБОР
	|			КОГДА НЕ &Уценка = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|				ТОГДА НЕ ВсеТовары.Ссылка В ИЕРАРХИИ (&Уценка)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ  	
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабНоменклатуры.Ссылка,
	|	ТабНоменклатуры.КодМДМ,
	|	ТабНоменклатуры.Ссылка.ЕдиницаХраненияОстатков КАК ЕдиницаХраненияОстатков, 
	|	ТабНоменклатуры.КратностьФилиала, ";
	
	Для Каждого СтрокаСоответствия Из СоотвествиеТиповИКолонок Цикл
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + "	ТабНоменклатуры.Кол_" + СокрЛП(СтрокаСоответствия.Значение) + ","
	КонецЦикла;                            
	
	ТекстЗапроса = Лев(ТекстЗапроса,стрДлина(ТекстЗапроса) - 1) + "
	|ИЗ
	|	ТабНоменклатуры КАК ТабНоменклатуры ";        
	
	ЗапросТаблицыДляЗагрузки.Текст = ТекстЗапроса;
	ПакетРезультата = ЗапросТаблицыДляЗагрузки.ВыполнитьПакет();
	ТаблицаЦен = ПакетРезультата[3].Выгрузить();   
	
	Сообщить("В запросе " + СокрЛП(ТаблицаЦен.Количество()) + " строк");
	ЗаписьЖурналаРегистрации("Загрузка цен единый прайс-лист.Обработка", УровеньЖурналаРегистрации.Информация,,, 
	"Количество строк с ценами: " + Строка(ТаблицаЦен.Количество()));
	
	ВалютаРубль = Константы.ВалютаРегламентированногоУчета.Получить();
	ДатаНачалаУдаления = ТекущаяДата()-1; 
	
	ЗапросЦенНаДату = Новый Запрос;
	ЗапросЦенНаДату.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЦеныНоменклатуры.Номенклатура,
	|	ЦеныНоменклатуры.ТипЦен,
	|	ЦеныНоменклатуры.Период
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры КАК ЦеныНоменклатуры
	|ГДЕ
	|	ЦеныНоменклатуры.Период МЕЖДУ &НачДата И &КонДата
	|	И ЦеныНоменклатуры.Цена <> 0
	|	И ЦеныНоменклатуры.ТипЦен В(&МассивТиповЦен)";  
	
	ЗапросЦенНаДату.УстановитьПараметр("НачДата", НачалоДня(ТекущаяДата()));
	ЗапросЦенНаДату.УстановитьПараметр("КонДата", КонецДня(ТекущаяДата()));
	ЗапросЦенНаДату.УстановитьПараметр("МассивТиповЦен", МассивТиповЦен);  
	
	РезультатЗапросаЦенНаДату = ЗапросЦенНаДату.Выполнить().Выгрузить();
	ЕстьЦеныНаДату = РезультатЗапросаЦенНаДату.Количество() > 0;
	
	МаксимальнаяДатаДокумента = КонецДня(ТекущаяДата());         
	
	НовыйДокумент = СоздатьНовыйДокументЦен(МассивТиповЦен, Робот, МаксимальнаяДатаДокумента);
	НовыйДокумент.ИмяФайлаЗагрузки = ИмяФайлаЗагрузки;		    
	
	СчетчикСтрокВДокументе = 0;
	СтрокСЦенами = 0;
	КоличествоДокументовУстановкиЦен = 0; 
	
	Для каждого ТекСтр Из ТаблицаЦен Цикл  
		
		Если ЗначениеЗаполнено(ТекСтр.Ссылка) И ЗначениеЗаполнено(ТекСтр.ЕдиницаХраненияОстатков) Тогда 
			
			ЕстьЦенаВСтроке = Ложь;                                     
			
			Для Каждого СтрокаСоответствия Из СоотвествиеТиповИКолонок Цикл      
				
				НоваяСтрокаДокумента = НовыйДокумент.Товары.Добавить();
				НоваяСтрокаДокумента.Номенклатура 		= ТекСтр.Ссылка;
				НоваяСтрокаДокумента.ЕдиницаИзмерения  	= ТекСтр.ЕдиницаХраненияОстатков; 
				
				ТекТипЦен = СтрокаСоответствия.Ключ;
				ЕстьУстановленнаяЦенаНаДату = Ложь;
				
				Если ЕстьУстановленнаяЦенаНаДату  Тогда
					НоваяСтрокаДокумента.Цена = 0;
				Иначе				
					НоваяСтрокаДокумента.Цена = ТекСтр["Кол_" + СтрокаСоответствия.Значение];
				КонецЕсли;
				
				НоваяСтрокаДокумента.ТипЦен = ТекТипЦен ;
				НоваяСтрокаДокумента.Валюта = ВалютаРубль;
				
				НоваяСтрокаДокумента.ИндексСтрокиТаблицыЦен = ТаблицаЦен.Индекс(ТекСтр);
				
				СчетчикСтрокВДокументе = СчетчикСтрокВДокументе + 1;
				
				Если НЕ ЕстьЦенаВСтроке Тогда           
					
					Если ЗначениеЗаполнено(ТекСтр["Кол_" + СтрокаСоответствия.Значение]) Тогда
						ЕстьЦенаВСтроке = Истина;		
					КонецЕсли;                  
					
				КонецЕсли;   
				
			КонецЦикла; 
			
		КонецЕсли; 
		
		Если ЕстьЦенаВСтроке Тогда
			СтрокСЦенами = СтрокСЦенами + 1;
		КонецЕсли;                    
		
		Если СчетчикСтрокВДокументе >= КоличествоСтрокВДокументе Тогда 
			
			Попытка
				
				НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение); 				
				КоличествоДокументовУстановкиЦен = КоличествоДокументовУстановкиЦен + 1;	
				
			Исключение                   
				
				НовыйДокумент.Записать();
				УдалятьПредыдущиеДокументы = Ложь;     
				
				ЗаписьЖурналаРегистрации(ИмяРегЗадания + ".Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
				"Записан документ установки цен с количеством товаров: " + Строка(НовыйДокумент.Товары.Количество() / СоотвествиеТиповИКолонок.Количество()) 
				+ Символы.ПС + ОписаниеОшибки());     
				
				МассивОшибок.Добавить("Ошибка при проведении документа Установка цен номенклатуры " + НовыйДокумент.Номер + Символы.ПС + ОписаниеОшибки());  
				
			КонецПопытки;                  
			
			МассивДокументов.Добавить(НовыйДокумент.Ссылка);	
			НовыйДокумент = СоздатьНовыйДокументЦен(МассивТиповЦен, Робот, МаксимальнаяДатаДокумента);
			НовыйДокумент.ИмяФайлаЗагрузки = ИмяФайлаЗагрузки;		
			СчетчикСтрокВДокументе = 0;    
			
		КонецЕсли;  
		
	КонецЦикла; 
	
	Если НовыйДокумент.Товары.Количество() > 0 Тогда   
		
		Попытка
			
			НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
			КоличествоДокументовУстановкиЦен = КоличествоДокументовУстановкиЦен + 1;
			
		Исключение
			
			НовыйДокумент.Записать();
			УдалятьПредыдущиеДокументы = Ложь;
			ЗаписьЖурналаРегистрации(ИмяРегЗадания + ".Ошибка", УровеньЖурналаРегистрации.Ошибка,,, "Записан документ установки цен с количеством товаров: " 
			+ Строка(НовыйДокумент.Товары.Количество() / СоотвествиеТиповИКолонок.Количество()) + Символы.ПС + ОписаниеОшибки());
			МассивОшибок.Добавить("Ошибка при проведении документа Установка цен номенклатуры " + НовыйДокумент.Номер + Символы.ПС + ОписаниеОшибки());
			
		КонецПопытки;
		
		МассивДокументов.Добавить(НовыйДокумент.Ссылка);	
		
	КонецЕсли;
	
	Орг = Константы.ОсновнаяОрганизация.Получить();
	Контр = Константы.ОсновнойПоставщик.Получить();
	ТипЦен = Константы.ОсновнаяЦенаЗакупкиПоставщика.Получить(); 
	
	Если ЗначениеЗаполнено(Орг) И ЗначениеЗаполнено(Контр) И ЗначениеЗаполнено(ТипЦен) И ТаблицаЗакупка.Количество() > 0 Тогда  
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ТЗ.КодМДМ,
		|	ТЗ.Цена
		|ПОМЕСТИТЬ Табл
		|ИЗ
		|	&ТЗ КАК ТЗ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Табл.КодМДМ,
		|	Табл.Цена,
		|	Номенклатура.Ссылка,
		|	Номенклатура.ЕдиницаХраненияОстатков КАК ЕдХраненияОстатков
		|ИЗ
		|	Табл КАК Табл
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
		|		ПО Табл.КодМДМ = Номенклатура.КодМДМ";  
		
		Запрос.УстановитьПараметр("ТЗ", ТаблицаЗакупка);
		Выб = Запрос.Выполнить().Выбрать();      
		
		СчетчикСтрокВДокументе = 0;              
		
		НовыйДокумент = Документы.УстановкаЦенНоменклатурыКонтрагентов.СоздатьДокумент();
		НовыйДокумент.Дата = Мин(ТекущаяДата(), МаксимальнаяДатаДокумента);
		НовыйДокумент.Контрагент = Контр;
		НовыйДокумент.Ответственный = Робот;
		НовыйДокумент.НеПроводитьНулевыеЗначения = Истина; 
		
		СтрТипов = НовыйДокумент.ТипыЦен.Добавить();
		СтрТипов.ТипЦен = ТипЦен;            
		
		СтрокСЦенамиКонтрагентов = 0;
		КоличествоДокументовУстановкиЦенКонтрагентов = 0; 
		
		Пока Выб.Следующий() Цикл        
			
			Если ЗначениеЗаполнено(Выб.Ссылка) И ЗначениеЗаполнено(Выб.ЕдХраненияОстатков) И ЗначениеЗаполнено(Выб.Цена) Тогда   
				
				НоваяСтрокаДокумента = НовыйДокумент.Товары.Добавить();
				НоваяСтрокаДокумента.Номенклатура 		= Выб.Ссылка;
				НоваяСтрокаДокумента.ЕдиницаИзмерения  	= Выб.ЕдХраненияОстатков;
				НоваяСтрокаДокумента.Цена 				= Выб.Цена;
				НоваяСтрокаДокумента.ТипЦен 			= ТипЦен ;
				НоваяСтрокаДокумента.Валюта 		= ВалютаРубль;
				НоваяСтрокаДокумента.ИндексСтрокиТаблицыЦен = 0;
				СчетчикСтрокВДокументе = СчетчикСтрокВДокументе + 1;
				СтрокСЦенамиКонтрагентов = СтрокСЦенамиКонтрагентов + 1;     
				
			КонецЕсли;                                                    
			
			Если СчетчикСтрокВДокументе >= КоличествоСтрокВДокументе Тогда  
				
				Попытка
					
					НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
					КоличествоДокументовУстановкиЦенКонтрагентов = КоличествоДокументовУстановкиЦенКонтрагентов + 1;
					
				Исключение
					
					НовыйДокумент.Записать();
					ЗаписьЖурналаРегистрации("Загрузка цен единый прайс-лист.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
					"Записан документ установки цен контрагентов с количеством товаров: " + Строка(НовыйДокумент.Товары.Количество()) + Символы.ПС + ОписаниеОшибки());
					МассивОшибок.Добавить("Ошибка при проведении документа Установка цен номенклатуры " + НовыйДокумент.Номер + Символы.ПС + ОписаниеОшибки());
					
					
				КонецПопытки;
				
				НовыйДокумент = Документы.УстановкаЦенНоменклатурыКонтрагентов.СоздатьДокумент();
				НовыйДокумент.Дата = Мин(ТекущаяДата(),МаксимальнаяДатаДокумента);
				НовыйДокумент.Контрагент = Контр;
				НовыйДокумент.Ответственный = Робот;
				НовыйДокумент.НеПроводитьНулевыеЗначения = Истина;
				
				СтрТипов = НовыйДокумент.ТипыЦен.Добавить();
				СтрТипов.ТипЦен = ТипЦен;
				
				СчетчикСтрокВДокументе = 0;
				
			КонецЕсли;
		КонецЦикла;
		
		Если НовыйДокумент.Товары.Количество()> 0 Тогда
			
			Попытка
				
				НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
				КоличествоДокументовУстановкиЦенКонтрагентов = КоличествоДокументовУстановкиЦенКонтрагентов + 1;
				
			Исключение
				
				НовыйДокумент.Записать();
				ЗаписьЖурналаРегистрации(ИмяРегЗадания + ".Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
				"Записан документ установки цен контрагентов с количеством товаров: " + Строка(НовыйДокумент.Товары.Количество()) + Символы.ПС + ОписаниеОшибки());
				МассивОшибок.Добавить("Ошибка при проведении документа Установка цен номенклатуры " + НовыйДокумент.Номер + Символы.ПС + ОписаниеОшибки());
				
			КонецПопытки;
			
		КонецЕсли;
		
		ЗаписьЖурналаРегистрации(ИмяРегЗадания + ".Обработка", УровеньЖурналаРегистрации.Информация,,, 
		"Проведено " + Строка(КоличествоДокументовУстановкиЦенКонтрагентов) + " документов установки цен контрагентов (строк с ценами: " 
		+ Строка(СтрокСЦенамиКонтрагентов) + " всего: " + Строка(Выб.Количество()) + ")");
		
	КонецЕсли;
	
	Если УдалятьПредыдущиеДокументы И ЗначениеЗаполнено(Робот) Тогда     
		
		ЗаписьЖурналаРегистрации(ИмяРегЗадания + ".Обработка", УровеньЖурналаРегистрации.Информация,,, 
		"Начало удаления предыдущих цен на дату меньшую: " + Формат(ДатаНачалаУдаления, "ДЛФ=DT"));  
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	УстановкаЦенНоменклатурыТипыЦен.Ссылка
		|ИЗ
		|	Документ.УстановкаЦенНоменклатуры.ТипыЦен КАК УстановкаЦенНоменклатурыТипыЦен
		|ГДЕ
		|	УстановкаЦенНоменклатурыТипыЦен.Ссылка.Ответственный В (&Ответственный)
		|	И УстановкаЦенНоменклатурыТипыЦен.Ссылка.Дата < &Дата 
		|
		|СГРУППИРОВАТЬ ПО
		|	УстановкаЦенНоменклатурыТипыЦен.Ссылка";  
		
		Запрос.УстановитьПараметр("Дата", ДатаНачалаУдаления);
		
		СписокОтветственных = Новый СписокЗначений;
		пРобот = Справочники.Пользователи.НайтиПоКоду("robot");
		
		Если НЕ пРобот.Пустая() Тогда
			СписокОтветственных.Добавить(пРобот);
		КонецЕсли;
		
		пРобот_ОП = Справочники.Пользователи.НайтиПоКоду("robot_op");
		Если НЕ пРобот_ОП.Пустая() Тогда
			СписокОтветственных.Добавить(пРобот_ОП);
		КонецЕсли;
		
		Запрос.УстановитьПараметр("Ответственный", СписокОтветственных);
		
		Выборка = Запрос.Выполнить().Выбрать();
		УдаленоЦенНоменклатуры = 0;
		
		Пока Выборка.Следующий() Цикл
			
			Об = Выборка.Ссылка.ПолучитьОбъект();
			КоличествоТоваров = Об.Товары.Количество();
			
			Попытка
				
				Об.Удалить();
				УдаленоЦенНоменклатуры = УдаленоЦенНоменклатуры + 1;
				
			Исключение
				
				Попытка
					
					Об.УстановитьПометкуУдаления(Истина);
					ЗаписьЖурналаРегистрации(ИмяРегЗадания + ".Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
					"Установлена пометка удаления докумена установки цен с количеством товаров: " + Строка(КоличествоТоваров) + Символы.ПС + ОписаниеОшибки());
					
				Исключение
					ЗаписьЖурналаРегистрации(ИмяРегЗадания + ".Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
					"Ошибка при установке пометки на удаление документа: " + Символы.ПС + ОписаниеОшибки());
					
				КонецПопытки;
			КонецПопытки;
			
		КонецЦикла;
		
		ЗаписьЖурналаРегистрации(ИмяРегЗадания + ".Обработка", УровеньЖурналаРегистрации.Информация,,, 
		"Удалено " + Строка(УдаленоЦенНоменклатуры) + " документов установки цен");
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	УстановкаЦенНоменклатурыКонтрагентовТипыЦен.Ссылка
		|ИЗ
		|	Документ.УстановкаЦенНоменклатурыКонтрагентов.ТипыЦен КАК УстановкаЦенНоменклатурыКонтрагентовТипыЦен
		|ГДЕ
		|	УстановкаЦенНоменклатурыКонтрагентовТипыЦен.Ссылка.Ответственный  В (&Ответственный)
		|	И УстановкаЦенНоменклатурыКонтрагентовТипыЦен.Ссылка.Дата < &Дата
		|
		|СГРУППИРОВАТЬ ПО
		|	УстановкаЦенНоменклатурыКонтрагентовТипыЦен.Ссылка"; 
		
		Запрос.УстановитьПараметр("Дата", ДатаНачалаУдаления);
		Запрос.УстановитьПараметр("Ответственный", СписокОтветственных);
		
		Выборка = Запрос.Выполнить().Выбрать();
		УдаленоЦенНоменклатурыКонтрагентов = 0;
		
		Пока Выборка.Следующий() Цикл
			
			Об = Выборка.Ссылка.ПолучитьОбъект();
			КоличествоТоваров = Об.Товары.Количество();
			
			Попытка
				
				Об.Удалить();
				УдаленоЦенНоменклатурыКонтрагентов = УдаленоЦенНоменклатурыКонтрагентов + 1;
				
			Исключение
				
				Попытка
					
					Об.УстановитьПометкуУдаления(Истина);
					ЗаписьЖурналаРегистрации(ИмяРегЗадания + ".Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
					"Установлена пометка удаления докумена установки цен с количеством товаров: " + Строка(КоличествоТоваров) + Символы.ПС + ОписаниеОшибки());
					
					МассивОшибок.Добавить("Установлена пометка удаления докумена установки цен с количеством товаров: " + Строка(КоличествоТоваров) + Символы.ПС + ОписаниеОшибки());
					
				Исключение
					
					ЗаписьЖурналаРегистрации(ИмяРегЗадания + ".Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
					"Ошибка при установке пометке на удаление документа: " + Символы.ПС + ОписаниеОшибки());
					МассивОшибок.Добавить("Ошибка при установке пометки на удаление документа: " + Символы.ПС + ОписаниеОшибки());
					
				КонецПопытки;
				
			КонецПопытки;
			
		КонецЦикла;
		
		ЗаписьЖурналаРегистрации(ИмяРегЗадания + ".Обработка", УровеньЖурналаРегистрации.Информация,,, 
		"Удалено " + Строка(УдаленоЦенНоменклатурыКонтрагентов) + " документов установки цен контрагентов");
		ЗаписьЖурналаРегистрации(ИмяРегЗадания + ".Обработка", УровеньЖурналаРегистрации.Информация,,, "Окончание удаления предыдущих цен");
		
	КонецЕсли; 
	
	ЗаписатьЛогЗагрузкиЕдиныйПрайсЛистЧастично(Соединение, ДатаЗагрузки, ИмяФайлаЗагрузки, МассивДокументов, ТаблицаТоваровИЦен.Количество());
	ОтправитьЭлПисьмоОбОшибкахСозданияДокументаЕдиныйПрайсЛист(ИмяРегЗадания, МассивОшибок);        
	
Конецпроцедуры   

Процедура ЗаписатьЛогЗагрузкиЕдиныйПрайсЛистЧастично(Соединение, ДатаЗагрузки, ИмяФайлаЗагрузки, МассивДокументов, КоличествоСтрокВФайле = 0)
	
	Если Соединение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МассивПодстрок = Новый Массив;
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	
	ИмяВременногоФайлаЛога = ПолучитьИмяВременногоФайла("txt");
	ИмяКаталогаСервера = "logs/";
	ИмяБазы = НРег(СтроковыеФункцииКлиентСервер.ПолучитьПараметрыИзСтроки(СтрокаСоединенияИнформационнойБазы()).Ref);
	ИмяФайлаЛога = ИмяКаталогаСервера + ИмяБазы + ".txt";  
	
	Если Соединение.НайтиФайлы(ИмяФайлаЛога).Количество() = 0 Тогда  
		
		//Добавим заголовки колонок файла
		МассивПодстрок.Очистить();
		МассивПодстрок.Добавить("ДатаЗагрузки");
		МассивПодстрок.Добавить("ИмяФайлаЗагрузки");
		МассивПодстрок.Добавить("КоличествоСтрокВФайле");
		МассивПодстрок.Добавить("КоличествоСтрокВДокументе");
		МассивПодстрок.Добавить("НомерДокумента");
		МассивПодстрок.Добавить("НаличиеОшибок");
		ТекстовыйДокумент.ДобавитьСтроку(СтрСоединить(МассивПодстрок, Символы.Таб)); 
		
	Иначе                                                
		
		Соединение.Получить(ИмяФайлаЛога, ИмяВременногоФайлаЛога);
		ТекстовыйДокумент.Прочитать(ИмяВременногоФайлаЛога);    
		
	КонецЕсли;
	
	Если МассивДокументов.Количество() = 0 Тогда      
		
		МассивПодстрок.Очистить();
		МассивПодстрок.Добавить(ДатаЗагрузки);
		МассивПодстрок.Добавить(ИмяФайлаЗагрузки);
		МассивПодстрок.Добавить(Строка(КоличествоСтрокВФайле));
		МассивПодстрок.Добавить(Строка(КоличествоСтрокВФайле));
		МассивПодстрок.Добавить("");
		МассивПодстрок.Добавить(Ложь);
		ТекстовыйДокумент.ДобавитьСтроку(СтрСоединить(МассивПодстрок, Символы.Таб)); 
		
	Иначе
		Для Каждого Док Из МассивДокументов Цикл   
			
			МассивПодстрок.Очистить();
			МассивПодстрок.Добавить(ДатаЗагрузки);
			МассивПодстрок.Добавить(ИмяФайлаЗагрузки);
			МассивПодстрок.Добавить(Строка(КоличествоСтрокВФайле));
			МассивПодстрок.Добавить(Строка(Док.Товары.Количество() / Док.ТипыЦен.Количество()));
			МассивПодстрок.Добавить(Док.Номер);
			МассивПодстрок.Добавить(Не Док.Проведен);
			ТекстовыйДокумент.ДобавитьСтроку(СтрСоединить(МассивПодстрок, Символы.Таб));   
			
		КонецЦикла;
	КонецЕсли;
	
	ТекстовыйДокумент.Записать(ИмяВременногоФайлаЛога);
	Соединение.Записать(ИмяВременногоФайлаЛога, ИмяФайлаЛога);
	
	УдалитьФайлы(ИмяВременногоФайлаЛога);
	
КонецПроцедуры

Процедура ОтправитьЭлПисьмоОбОшибкахСозданияДокументаЕдиныйПрайсЛист(ИмяРегЗадания, МассивОшибок) Экспорт
	
	ЭлПочтаДляУведомленийОЗагрузкеЦенНоменклатурыЕдиныйПрайсЛист = Константы.ЭлПочтаДляУведомленийОЗагрузкеЦенНоменклатурыЕдиныйПрайсЛист.Получить(); 
	
	Если Не ЗначениеЗаполнено(ЭлПочтаДляУведомленийОЗагрузкеЦенНоменклатурыЕдиныйПрайсЛист) Тогда
		Возврат;
	КонецЕсли;
	
	УчетнаяЗапись = Константы.ОсновнаяУчетнаяЗаписьЭлектроннойПочты.Получить();
	
	Если Константы.НеОтправлятьПочту.Получить() ИЛИ НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		ИмяБазы = НРег(СтроковыеФункцииКлиентСервер.ПолучитьПараметрыИзСтроки(СтрокаСоединенияИнформационнойБазы()).Ref);
		
		ТекстСообщения = "Возникли ошибки при выполнении регламентного задания '" + ИмяРегЗадания + "'" + Символы.ПС;
		
		Для Каждого ТекстОшибки Из МассивОшибок Цикл
			ТекстСообщения = ТекстСообщения + ТекстОшибки + Символы.ПС;
		КонецЦикла;
		
		УчетнаяЗапись = Константы.ОсновнаяУчетнаяЗаписьЭлектроннойПочты.Получить(); 		
		
		Если Константы.НеОтправлятьПочту.Получить() ИЛИ НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
			Возврат;
		КонецЕсли; 		
		
		Профиль = УправлениеЭлектроннойПочтой.ПолучитьИнтернетПочтовыйПрофиль(УчетнаяЗапись);
		Почта = Новый ИнтернетПочта; 
		
		Попытка
			Почта.Подключиться(Профиль);
		Исключение
			Возврат;
		КонецПопытки;
		
		Сообщение = Новый ИнтернетПочтовоеСообщение;
		Сообщение.Тема = ИмяРегЗадания + " " + ИмяБазы;
		Сообщение.Получатели.Добавить(ЭлПочтаДляУведомленийОЗагрузкеЦенНоменклатурыЕдиныйПрайсЛист); 
		Сообщение.Отправитель = УчетнаяЗапись.АдресЭлектроннойПочты;
		Сообщение.Тексты.Добавить(ТекстСообщения);
		Почта.Послать(Сообщение);			
		Почта.Отключиться();  
		
	Исключение
	КонецПопытки;
	
КонецПроцедуры

Функция СтрСоединить(МассивПодстрок, Разделитель) Экспорт
	
	ТекстСтрока = "";    
	
	Для н = 0 По МассивПодстрок.Количество()-1 Цикл
		ТекстСтрока = ТекстСтрока + МассивПодстрок[н] + ?(н = МассивПодстрок.Количество() - 1, "", Разделитель);		
	КонецЦикла;
	
	Возврат ТекстСтрока;
	
КонецФункции

Функция СоздатьНовыйДокументЦен(МассивТиповЦен , Ответственный ,МаксимальнаяДатаДокумента)
	
	НовыйДокумент = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
	НовыйДокумент.Дата = Мин(ТекущаяДата(),МаксимальнаяДатаДокумента);
	НовыйДокумент.Ответственный = Ответственный;
	НовыйДокумент.НеПроводитьНулевыеЗначения = Истина;
	
	Для Каждого Зн Из МассивТиповЦен Цикл      
		
		НовСтр =  НовыйДокумент.ТипыЦен.Добавить();
		НовСтр.ТипЦен = Зн;		                
		
	КонецЦикла;	
	
	Возврат НовыйДокумент;    
	
КонецФункции

Процедура СозданиеДокумента(Файл)   
	
	Если Не ЗначениеЗаполнено(Файл) Тогда 
		Возврат;
	КонецЕсли;
	
	УдалятьПредыдущиеДокументы = Истина;
	КоличествоСтрокВДокументе = 25000;
	Робот = Справочники.Пользователи.НайтиПоКоду("robot");
	
	// !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! Очистка "Московских остатков"
	НаборЗаписей = РегистрыСведений.МосковскиеОстаткиНоменклатуры.СоздатьНаборЗаписей(); 
	НаборЗаписей.Записать();
	
	Если УдалятьПредыдущиеДокументы И ЗначениеЗаполнено(Робот) Тогда
		
		Закупочная 	= Константы.ЗакупочнаяЦена.Получить();
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	УстановкаЦенНоменклатурыТипыЦен.Ссылка
		|ИЗ
		|	Документ.УстановкаЦенНоменклатуры.ТипыЦен КАК УстановкаЦенНоменклатурыТипыЦен
		|ГДЕ
		|	НЕ УстановкаЦенНоменклатурыТипыЦен.ТипЦен = &ТипЦен
		|	И НАЧАЛОПЕРИОДА(УстановкаЦенНоменклатурыТипыЦен.Ссылка.Дата, ДЕНЬ) < &Дата
		|	И УстановкаЦенНоменклатурыТипыЦен.Ссылка.Ответственный = &Ответственный
		|
		|СГРУППИРОВАТЬ ПО
		|	УстановкаЦенНоменклатурыТипыЦен.Ссылка";
		
		Запрос.УстановитьПараметр("Дата", НачалоДня(ТекущаяДата()));
		Запрос.УстановитьПараметр("ТипЦен",  Закупочная);
		Запрос.УстановитьПараметр("Ответственный", Робот);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл   
			
			Об = Выборка.Ссылка.ПолучитьОбъект();
			
			Если Об.Проведен Тогда 
				Об.УстановитьПометкуУдаления(Истина);
			Иначе 
				Об.Удалить();
			КонецЕсли;        
			
		КонецЦикла;
		
	КонецЕсли;
	
	ТЗ_МосковскиеОстатки = Новый ТаблицаЗначений;	
	ТЗ_МосковскиеОстатки.Колонки.Добавить("Номенклатура");
	ТЗ_МосковскиеОстатки.Колонки.Добавить("Количество");
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Номенклатура");
	ТЗ.Колонки.Добавить("ТипЦен");
	ТЗ.Колонки.Добавить("Цена");
	ТЗ.Колонки.Добавить("Индекс");
	
	МассивТиповЦен = Новый Массив;
	
	Рупь = Константы.ВалютаРегламентированногоУчета.Получить();
	ЗакупочнаяЦена 	= Константы.ЗакупочнаяЦена.Получить();
	Базовая 		= Константы.БазоваяЦена.Получить();
	Скидка35 		= Константы.Скидка35.Получить();
	Скидка36 		= Константы.Скидка36.Получить();
	Скидка37 		= Константы.Скидка37.Получить();
	Скидка38		= Константы.Скидка38.Получить();
	
	МассивТиповЦен.Добавить(Скидка35);
	МассивТиповЦен.Добавить(Базовая);
	МассивТиповЦен.Добавить(Скидка36);
	МассивТиповЦен.Добавить(Скидка37);
	МассивТиповЦен.Добавить(Скидка38);
	
	// Создаю новый документ 
	НовыйДокумент = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
	НовыйДокумент.Дата = ТекущаяДата();
	НовыйДокумент.Ответственный = Робот;
	НовыйДокумент.НеПроводитьНулевыеЗначения = Истина;
	
	// Табличная часть "ТипыЦен"
	НовСтр =  НовыйДокумент.ТипыЦен.Добавить();
	НовСтр.ТипЦен = Базовая ;
	
	НовСтр =  НовыйДокумент.ТипыЦен.Добавить();
	НовСтр.ТипЦен = Скидка35;
	
	НовСтр =  НовыйДокумент.ТипыЦен.Добавить();
	НовСтр.ТипЦен = Скидка36;
	
	НовСтр =  НовыйДокумент.ТипыЦен.Добавить();
	НовСтр.ТипЦен = Скидка37;
	
	НовСтр =  НовыйДокумент.ТипыЦен.Добавить();
	НовСтр.ТипЦен = Скидка38;
	
	Текст = Новый ТекстовыйДокумент; 
	Текст.Прочитать(Файл); 
	
	Для НомерСтроки = 1 По Текст.КоличествоСтрок() Цикл 
		
		Попытка
			
			Стр = Текст.ПолучитьСтроку(НомерСтроки); 
			НомерСобаки = Найти(Стр, "@");
			
			Если НомерСобаки > 0 Тогда
				Стр = Сред(Стр, НомерСобаки + 1);
			Иначе 
				Продолжить;
			КонецЕсли;
			
			НомерСобаки = Найти(Стр, "@"); 
			
			Если НомерСобаки > 0 Тогда 
				
				Артикул = Лев(Стр ,  НомерСобаки - 1);
				Номенклатура = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", Артикул).Ссылка; 
				
				Если Номенклатура  = Справочники.Номенклатура.ПустаяСсылка() Тогда 
					Продолжить;
				КонецЕсли;    
				
				Стр = Сред(Стр, НомерСобаки + 1);
				
			Иначе 
				Продолжить;
			КонецЕсли;
			
			Для  Х = 1  по 3  Цикл    
				
				НомерСобаки = Найти(Стр, "@");   
				
				Если НомерСобаки > 0 Тогда
					Стр = Сред(Стр, НомерСобаки + 1);
				Иначе 
					Продолжить;
				КонецЕсли;     
				
			КонецЦикла; 
			
			НомерСобаки = Найти(Стр, "@");
			КатегорияАВС = Лев(Стр ,  НомерСобаки - 1);  
			
			Если НЕ ПустаяСтрока(КатегорияАВС) и НЕ Константы.ЗапретитьОбновлениеГруппыABCНоменклатуры.Получить() Тогда		 
				МанипуляцииСКатегорией(КатегорияАВС,Артикул);
			КонецЕсли;                         
			
			Стр = Сред(Стр, НомерСобаки + 1);
			
			Для  Х = 1  по 5 Цикл     
				
				НомерСобаки = Найти(Стр, "@"); 
				
				Если НомерСобаки > 0 Тогда 
					Стр = Сред(Стр, НомерСобаки + 1);
				Иначе 
					Продолжить;
				КонецЕсли;  
				
			КонецЦикла;
			
			НомерСобаки = Найти(Стр, "@"); 
			
			Если НомерСобаки > 1 Тогда 
				ЦенаСкидка35 = Окр(Число(Лев(Стр, НомерСобаки - 1)), 2, 1);
			Иначе 
				ЦенаСкидка35 = 0;
			КонецЕсли;           
			
			Стр = Сред(Стр, НомерСобаки + 1);
			НомерСобаки = Найти(Стр, "@"); 
			
			Если НомерСобаки > 1 Тогда 
				ЦенаБазовая = Окр(Число(Лев(Стр, НомерСобаки - 1)), 2, 1);
			Иначе 
				ЦенаБазовая =  0;
			КонецЕсли;     
			
			Стр = Сред(Стр, НомерСобаки + 1);
			НомерСобаки = Найти(Стр, "@");
			Стр = Сред(Стр, НомерСобаки + 1);
			
			Для  Х = 1  по 2 Цикл          
				
				НомерСобаки = Найти(Стр, "@");  
				
				Если НомерСобаки > 0 Тогда 
					Стр = Сред(Стр, НомерСобаки + 1);
				Иначе 
					Продолжить;
				КонецЕсли;  
				
			КонецЦикла;
			
			НомерСобаки = Найти(Стр, "@"); 
			
			Если НомерСобаки > 1 Тогда 
				ЦенаСкидка36 = Окр(Число(Лев(Стр, НомерСобаки - 1)), 2, 1);
			Иначе 
				ЦенаСкидка36  = 0 ;
			КонецЕсли;       
			
			Стр = Сред(Стр, НомерСобаки + 1);
			
			НомерСобаки = Найти(Стр, "@"); 
			
			Если НомерСобаки > 1 Тогда 
				ЦенаСкидка37 =  Окр(Число(Лев(Стр, НомерСобаки - 1)), 2, 1);
			Иначе 
				ЦенаСкидка37 = 0 ;
			КонецЕсли;          
			
			Стр = Сред(Стр, НомерСобаки + 1);
			
			НомерСобаки = Найти(Стр, "@");
			Стр = Сред(Стр, НомерСобаки + 1);
			
			НомерСобаки = Найти(Стр, "@"); 
			
			Если НомерСобаки > 1 Тогда 
				ЦенаСкидка38 =  Окр(Число(Лев(Стр, НомерСобаки - 1)), 2, 1);	 
			Иначе 
				ЦенаСкидка38   = 0;
			КонецЕсли;    
			
			Стр = Сред(Стр, НомерСобаки + 1);
			
			НомерСобаки = Найти(Стр, "@");
			Стр = Сред(Стр, НомерСобаки + 1);
			
			НомерСобаки = Найти(Стр, "@");  
			
			Если НомерСобаки > 1 Тогда 
				ОстатокВМоскве =  Окр(Число(Лев(Стр, НомерСобаки - 1)), 2, 1);
			Иначе 
				ОстатокВМоскве = 0;
			КонецЕсли;
			
			НоваяСтрокаМО = ТЗ_МосковскиеОстатки.Добавить();
			НоваяСтрокаМО.Номенклатура  = Номенклатура ;
			НоваяСтрокаМО.Количество  =  ОстатокВМоскве;
			
			НоваяСтрокаТЗ =  ТЗ.Добавить();
			НоваяСтрокаТЗ.Номенклатура  = Номенклатура;
			НоваяСтрокаТЗ.Цена  = ЦенаСкидка35;
			НоваяСтрокаТЗ.ТипЦен =   Скидка35;
			НоваяСтрокаТЗ.Индекс = НомерСтроки - 1;
			
			НоваяСтрокаТЗ =  ТЗ.Добавить();
			НоваяСтрокаТЗ.Номенклатура  = Номенклатура;
			НоваяСтрокаТЗ.Цена  = ЦенаБазовая;
			НоваяСтрокаТЗ.ТипЦен =   Базовая;
			НоваяСтрокаТЗ.Индекс = НомерСтроки - 1;
			
			НоваяСтрокаТЗ =  ТЗ.Добавить();
			НоваяСтрокаТЗ.Номенклатура  = Номенклатура;
			НоваяСтрокаТЗ.Цена  = ЦенаСкидка36;
			НоваяСтрокаТЗ.ТипЦен =   Скидка36;
			НоваяСтрокаТЗ.Индекс = НомерСтроки - 1;
			
			НоваяСтрокаТЗ =  ТЗ.Добавить();
			НоваяСтрокаТЗ.Номенклатура  = Номенклатура;
			НоваяСтрокаТЗ.Цена  = ЦенаСкидка37;
			НоваяСтрокаТЗ.ТипЦен =   Скидка37;
			НоваяСтрокаТЗ.Индекс = НомерСтроки - 1;
			
			НоваяСтрокаТЗ =  ТЗ.Добавить();
			НоваяСтрокаТЗ.Номенклатура  = Номенклатура;
			НоваяСтрокаТЗ.Цена  = ЦенаСкидка38;
			НоваяСтрокаТЗ.ТипЦен =   Скидка38;
			НоваяСтрокаТЗ.Индекс = НомерСтроки - 1;
			
		Исключение
		КонецПопытки;    
		
	КонецЦикла;
	
	СчетчикСтрокВДокументе = 0;
	
	Для каждого ТекСтр Из ТЗ Цикл  
		
		НоваяСтрокаДокумента =  НовыйДокумент.Товары.Добавить();
		НоваяСтрокаДокумента.Номенклатура = ТекСтр.Номенклатура  ;
		НоваяСтрокаДокумента.ЕдиницаИзмерения  = НоваяСтрокаДокумента.Номенклатура.ЕдиницаХраненияОстатков;
		НоваяСтрокаДокумента.Цена = ТекСтр.Цена;
		НоваяСтрокаДокумента.ТипЦен = ТекСтр.ТипЦен ;
		НоваяСтрокаДокумента.СпособРасчетаЦены = ТекСтр.ТипЦен.СпособРасчетаЦены;
		НоваяСтрокаДокумента.Валюта = ТекСтр.ТипЦен.ВалютаЦены;
		НоваяСтрокаДокумента.ИндексСтрокиТаблицыЦен = ТекСтр.Индекс;    
		
		СчетчикСтрокВДокументе = СчетчикСтрокВДокументе + 1;  
		
		Если СчетчикСтрокВДокументе = КоличествоСтрокВДокументе Тогда
			
			Попытка
				НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				НовыйДокумент.Записать();
			КонецПопытки;
			
			НовыйДокумент = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
			НовыйДокумент.Дата = ТекущаяДата();
			НовыйДокумент.Ответственный = Робот;
			НовыйДокумент.НеПроводитьНулевыеЗначения = Истина;
			
			НовСтр =  НовыйДокумент.ТипыЦен.Добавить();
			НовСтр.ТипЦен = Базовая;
			
			НовСтр =  НовыйДокумент.ТипыЦен.Добавить();
			НовСтр.ТипЦен = Скидка35;
			
			НовСтр =  НовыйДокумент.ТипыЦен.Добавить();
			НовСтр.ТипЦен = Скидка36;
			
			НовСтр =  НовыйДокумент.ТипыЦен.Добавить();
			НовСтр.ТипЦен = Скидка37;
			
			НовСтр =  НовыйДокумент.ТипыЦен.Добавить();
			НовСтр.ТипЦен = Скидка38;
			
			СчетчикСтрокВДокументе = 0;   
			
		КонецЕсли;    
		
	КонецЦикла; 
	
	Если НовыйДокумент.Товары.Количество()> 0 Тогда  
		
		Попытка
			НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			НовыйДокумент.Записать();
		КонецПопытки;     
		
	КонецЕсли;
	
	// Заполню московские остатки
	Для каждого ТекСтр Из ТЗ_МосковскиеОстатки Цикл   
		
		Если ТекСтр.Количество > 0 Тогда
			
			НаборЗаписей = РегистрыСведений.МосковскиеОстаткиНоменклатуры.СоздатьНаборЗаписей(); 
			НаборЗаписей.Отбор.Номенклатура.Установить(ТекСтр.Номенклатура); 
			
			НоваяЗапись = НаборЗаписей.Добавить(); 
			НоваяЗапись. Номенклатура = ТекСтр.Номенклатура; 
			НоваяЗапись.Количество = ТекСтр.Количество; 
			
			НаборЗаписей.Записать();
			
		КонецЕсли;   
		
	КонецЦикла; 
	
КонецПроцедуры

// ежедневные регламентные процедуры
Процедура ЕжедневныйРегламент() Экспорт
	
	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда  
		
		ЗаписьЖурналаРегистрации("Ежедневный регламент", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Отменена работа регламентного задания из-за несоответствия параметров подключения к ИБ");
		Возврат;         
		
	КонецЕсли;
	
	УстановитьНовуюДатуЗапретаИзмененияДанных();
	
КонецПроцедуры

Процедура УстановитьНовуюДатуЗапретаИзмененияДанных()
	
	ДатаЗапрета = НачалоДня(ТекущаяДата() - 86400);
	
	УстановитьОбщуюГраницуЗапретаИзменений(ДатаЗапрета);
	УстановитьГраницуЗапретаПоОрганизациям(ДатаЗапрета);
	
	ДеньМесяцаДляЗакрытияПериода = Константы.ДеньМесяцаДляЗакрытияПериода.Получить();
	
	ИзменитьГраницуЗапретаИзмененияПоПользователям(ДеньМесяцаДляЗакрытияПериода);    
	ИзменитьГраницуЗапретаИзмененияПоПользователямИРазделамУчета(ДатаЗапрета, ДеньМесяцаДляЗакрытияПериода); 
	УстановитьГраницуЗапретаПоРазделамУчета(ДатаЗапрета);
	
	УдалитьПользователей();
	
КонецПроцедуры

Процедура УдалитьПользователей() 
	
	МенеджерРегистра = РегистрыСведений.ГраницыЗапретаИзмененияДанных; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Пользователи.Ссылка
	|ИЗ
	|	РегистрСведений.ГраницыЗапретаИзмененияДанных КАК ГраницыЗапретаИзмененияДанных
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
	|		ПО ГраницыЗапретаИзмененияДанных.Пользователь = Пользователи.Ссылка
	|ГДЕ
	|	Пользователи.ПометкаУдаления
	|
	|СГРУППИРОВАТЬ ПО
	|	Пользователи.Ссылка";
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Пока РезультатЗапроса.Следующий() Цикл
		
		Набор = МенеджерРегистра.СоздатьНаборЗаписей();		
		Набор.Отбор.Пользователь.Установить(РезультатЗапроса.Ссылка);
		Набор.Записать();
		
	КонецЦикла;
	
	Запрос = Новый Запрос;  
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Пользователи.Ссылка,
	|	ГраницыЗапретаИзмененияДанных.РазделУчета,
	|	ГраницыЗапретаИзмененияДанных.Организация
	|ИЗ
	|	РегистрСведений.ГраницыЗапретаИзмененияДанных КАК ГраницыЗапретаИзмененияДанных
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
	|		ПО ГраницыЗапретаИзмененияДанных.Пользователь = Пользователи.Ссылка,
	|	Константы КАК Константы
	|ГДЕ
	|	ВЫБОР
	|			КОГДА Константы.ДеньМесяцаДляЗакрытияПериода = 0
	|				ТОГДА ЛОЖЬ
	|			ИНАЧЕ Пользователи.РазрешенноеЧислоДнейДляРедактированияДанных = 0
	|		КОНЕЦ
	|	И ГраницыЗапретаИзмененияДанных.РазделУчета = ЗНАЧЕНИЕ(Справочник.РазделыУчета.ПустаяСсылка)"; 
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл  
		
		Набор = МенеджерРегистра.СоздатьНаборЗаписей();
		Набор.Отбор.Пользователь.Установить(Выборка.Ссылка);
		Набор.Отбор.РазделУчета.Установить(Выборка.РазделУчета);
		Набор.Отбор.Организация.Установить(Выборка.Организация);
		Набор.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ИзменитьГраницуЗапретаИзмененияПоПользователям(ДеньМесяцаДляЗакрытияПериода) 
	
	МенеджерРегистра = РегистрыСведений.ГраницыЗапретаИзмененияДанных;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ГраницыЗапретаИзмененияДанных.Организация
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	РегистрСведений.ГраницыЗапретаИзмененияДанных КАК ГраницыЗапретаИзмененияДанных
	|
	|СГРУППИРОВАТЬ ПО
	|	ГраницыЗапретаИзмененияДанных.Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Пользователи.Ссылка,
	|	Пользователи.РазрешенноеЧислоДнейДляРедактированияДанных,
	|	ВТ.Организация
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи, ВТ
	|		
	|		
	|ГДЕ
	|	НЕ Пользователи.ПометкаУдаления
	|	И Пользователи.РазрешенноеЧислоДнейДляРедактированияДанных > 1";
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Пока РезультатЗапроса.Следующий() Цикл
		
		ДатаЗапрета = ОпределитьДатуЗапретаПоПользователю(РезультатЗапроса.РазрешенноеЧислоДнейДляРедактированияДанных, ДеньМесяцаДляЗакрытияПериода); 
		
		Набор = МенеджерРегистра.СоздатьНаборЗаписей();
		Набор.Отбор.Организация.Установить(РезультатЗапроса.Организация);
		Набор.Отбор.Пользователь.Установить(РезультатЗапроса.Ссылка); 
		Набор.Отбор.РазделУчета.Установить(Справочники.РазделыУчета.ПустаяСсылка());
		
		Запись = Набор.Добавить();
		Запись.Организация = РезультатЗапроса.Организация;
		Запись.Пользователь = РезультатЗапроса.Ссылка;
		Запись.ГраницаЗапретаИзменений = ДатаЗапрета;
		Набор.Записать();
		
	КонецЦикла; 
	
КонецПроцедуры  

Функция ОпределитьДатуЗапретаПоПользователю(РазрешенноеЧислоДнейДляРедактированияДанных, ДеньМесяцаДляЗакрытияПериода)  
	
	Если ЗначениеЗаполнено(ДеньМесяцаДляЗакрытияПериода) Тогда   
		
		ТекущийДень = День(ТекущаяДата());
		
		Если ТекущийДень <= ДеньМесяцаДляЗакрытияПериода Тогда
			ДатаЗапрета = НачалоДня(ТекущаяДата() - РазрешенноеЧислоДнейДляРедактированияДанных * 86400);
		Иначе
			
			МинРазрешенноеЧислоДнейДляРедактированияДанных = Мин(РазрешенноеЧислоДнейДляРедактированияДанных, ТекущийДень);  
			ДатаЗапрета = НачалоДня(ТекущаяДата() - МинРазрешенноеЧислоДнейДляРедактированияДанных * 86400);
			
		КонецЕсли; 
		
		ДатаЗапрета = Макс(ДатаЗапрета, НачалоМесяца(НачалоМесяца(ТекущаяДата()) - 1));
		
	Иначе 		
		ДатаЗапрета = НачалоДня(ТекущаяДата() - РазрешенноеЧислоДнейДляРедактированияДанных * 86400);
	КонецЕсли;  
	
	Возврат ДатаЗапрета;
	
КонецФункции

Процедура ИзменитьГраницуЗапретаИзмененияПоПользователямИРазделамУчета(ДатаЗапрета, ДеньМесяцаДляЗакрытияПериода) 

	МенеджерРегистра = РегистрыСведений.ГраницыЗапретаИзмененияДанных;

	Если ЗначениеЗаполнено(ДеньМесяцаДляЗакрытияПериода) Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ГраницыЗапретаИзмененияДанных.Пользователь,
		|	ГраницыЗапретаИзмененияДанных.ВидДокумента,
		|	ГраницыЗапретаИзмененияДанных.РазделУчета,
		|	ГраницыЗапретаИзмененияДанных.Пользователь.РазрешенноеЧислоДнейДляРедактированияДанных КАК РазрешенноеЧислоДнейДляРедактированияДанных
		|ИЗ
		|	РегистрСведений.ГраницыЗапретаИзмененияДанных КАК ГраницыЗапретаИзмененияДанных
		|ГДЕ
		|	НЕ ГраницыЗапретаИзмененияДанных.РазделУчета = ЗНАЧЕНИЕ(Справочник.РазделыУчета.ПустаяСсылка)
		|	И НЕ ГраницыЗапретаИзмененияДанных.ВидДокумента = """"
		|	И НЕ ГраницыЗапретаИзмененияДанных.Пользователь = НЕОПРЕДЕЛЕНО
		|	И ГраницыЗапретаИзмененияДанных.Пользователь ССЫЛКА Справочник.Пользователи";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл     

			Набор = МенеджерРегистра.СоздатьНаборЗаписей(); 
			Набор.Отбор.РазделУчета.Установить(Выборка.РазделУчета);
			Набор.Отбор.Пользователь.Установить(Выборка.Пользователь);
			Набор.Отбор.ВидДокумента.Установить(Выборка.ВидДокумента);
			
			Запись = Набор.Добавить();
			Запись.Организация = Справочники.Организации.ПустаяСсылка();
			Запись.Пользователь = Выборка.Пользователь; 
			Запись.РазделУчета = Выборка.РазделУчета;
			Запись.ВидДокумента = Выборка.ВидДокумента;
			Запись.ГраницаЗапретаИзменений = ?(ЗначениеЗаполнено(Выборка.РазрешенноеЧислоДнейДляРедактированияДанных), 
			               НачалоДня(ТекущаяДата() - Выборка.РазрешенноеЧислоДнейДляРедактированияДанных * 86400), ДатаЗапрета);  
			
			Набор.Записать();
			
		КонецЦикла;
	
	Иначе

		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ГраницыЗапретаИзмененияДанных.РазделУчета,
		|	ГраницыЗапретаИзмененияДанных.ГраницаЗапретаИзменений
		|ПОМЕСТИТЬ ВТ_РазделыДаты
		|ИЗ
		|	РегистрСведений.ГраницыЗапретаИзмененияДанных КАК ГраницыЗапретаИзмененияДанных
		|ГДЕ
		|	НЕ ГраницыЗапретаИзмененияДанных.РазделУчета = ЗНАЧЕНИЕ(Справочник.РазделыУчета.ПустаяСсылка)
		|	И ГраницыЗапретаИзмененияДанных.Пользователь = НЕОПРЕДЕЛЕНО
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_РазделыДаты.РазделУчета,
		|	ГраницыЗапретаИзмененияДанных.ВидДокумента,
		|	ВТ_РазделыДаты.ГраницаЗапретаИзменений,
		|	ГраницыЗапретаИзмененияДанных.Пользователь,
		|	ГраницыЗапретаИзмененияДанных.ГраницаЗапретаИзменений КАК ГраницаЗапретаИзмененийПользователя
		|ИЗ
		|	ВТ_РазделыДаты КАК ВТ_РазделыДаты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ГраницыЗапретаИзмененияДанных КАК ГраницыЗапретаИзмененияДанных
		|		ПО ВТ_РазделыДаты.РазделУчета = ГраницыЗапретаИзмененияДанных.РазделУчета
		|			И (НЕ ГраницыЗапретаИзмененияДанных.Пользователь = НЕОПРЕДЕЛЕНО)
		|			И (НЕ ГраницыЗапретаИзмененияДанных.ВидДокумента = """")"; 
		
		Выборка = Запрос.Выполнить().Выбрать();    
		
		Пока Выборка.Следующий() Цикл         
			
			Если Выборка.ГраницаЗапретаИзмененийПользователя = Выборка.ГраницаЗапретаИзменений Тогда
				ТекДатаЗапрета = ДатаЗапрета;
			Иначе     
				ТекДатаЗапрета = Выборка.ГраницаЗапретаИзмененийПользователя;
			КонецЕсли;
			
			Набор = МенеджерРегистра.СоздатьНаборЗаписей();
			
			Набор.Отбор.РазделУчета.Установить(Выборка.РазделУчета);
			Набор.Отбор.Пользователь.Установить(Выборка.Пользователь);
			Набор.Отбор.ВидДокумента.Установить(Выборка.ВидДокумента);
			
			Запись = Набор.Добавить();
			Запись.Организация = Справочники.Организации.ПустаяСсылка();
			Запись.Пользователь = Выборка.Пользователь; 
			Запись.РазделУчета = Выборка.РазделУчета;
			Запись.ВидДокумента = Выборка.ВидДокумента;
			Запись.ГраницаЗапретаИзменений = ТекДатаЗапрета;  
			
			Набор.Записать();	
			
		КонецЦикла;  
	
	КонецЕсли;

КонецПроцедуры

Процедура УстановитьОбщуюГраницуЗапретаИзменений(ДатаЗапрета)
	
	ПустаяОрганизация = Справочники.Организации.ПустаяСсылка();
	
	Набор = РегистрыСведений.ГраницыЗапретаИзмененияДанных.СоздатьНаборЗаписей();
	
	УстановитьГраницуЗапретаИзменений(Набор, ПустаяОрганизация, ДатаЗапрета);
	
	Набор.Записать();
	
КонецПроцедуры

Процедура УстановитьГраницуЗапретаПоОрганизациям(ДатаЗапрета)
	
	ВыборкаОрганизаций = Справочники.Организации.Выбрать();  
	
	Пока ВыборкаОрганизаций.Следующий() Цикл    
		
		Набор = РегистрыСведений.ГраницыЗапретаИзмененияДанных.СоздатьНаборЗаписей();
		
		УстановитьГраницуЗапретаИзменений(Набор, ВыборкаОрганизаций.Ссылка, ДатаЗапрета);
		
		Набор.Записать(); 
		
	КонецЦикла;
	
КонецПроцедуры  

Процедура УстановитьГраницуЗапретаПоРазделамУчета(ДатаЗапрета)

	ВыборкаРазделов = Справочники.РазделыУчета.Выбрать();
	
	Пока ВыборкаРазделов.Следующий() Цикл
		
		Если ВыборкаРазделов.Ссылка.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		
		Набор = РегистрыСведений.ГраницыЗапретаИзмененияДанных.СоздатьНаборЗаписей();  
		
		Набор.Отбор.Организация.Установить(Справочники.Организации.ПустаяСсылка());
		Набор.Отбор.Пользователь.Установить(Неопределено);    
		Набор.Отбор.РазделУчета.Установить(ВыборкаРазделов.Ссылка);  
		Набор.Отбор.ВидДокумента.Установить("");
		
		Запись = Набор.Добавить();
		Запись.Организация = Справочники.Организации.ПустаяСсылка();
		Запись.Пользователь = Неопределено; 
		Запись.РазделУчета = ВыборкаРазделов.Ссылка;
		Запись.ВидДокумента = "";
		Запись.ГраницаЗапретаИзменений = ДатаЗапрета;	
		
		Набор.Записать();
		
	КонецЦикла;

КонецПроцедуры

Процедура УстановитьГраницуЗапретаИзменений(Набор, Организация, ДатаЗапрета)
	
	Набор.Отбор.Организация.Установить(Организация);
	Набор.Отбор.Пользователь.Установить(Неопределено);    
	Набор.Отбор.РазделУчета.Установить(Справочники.РазделыУчета.ПустаяСсылка());  
	
	Запись = Набор.Добавить();
	Запись.Организация = Организация;
	Запись.Пользователь = Неопределено;
	Запись.ГраницаЗапретаИзменений = ДатаЗапрета;
	
КонецПроцедуры

