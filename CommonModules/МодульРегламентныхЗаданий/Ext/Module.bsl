	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(, Валюта = &Евро) КАК КурсЕвро
	|		ПО (ИСТИНА)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Таблица7.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таблица8.Номенклатура,
	|	Таблица8.ТипЦен,
	|	СрезПоследнихЦен.Валюта,
	|	ВЫБОР
	|		КОГДА СрезПоследнихЦен.Валюта = &Евро
	|			ТОГДА СрезПоследнихЦен.Цена
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ЕСТЬNULL(КурсыВалютСрезПоследних.Кратность, 0) > 0
	|						И ЕСТЬNULL(КурсыВалютСрезПоследних.Курс, 0) > 0
	|						И ЕСТЬNULL(КурсЕвро.Кратность, 0) > 0
	|						И ЕСТЬNULL(КурсЕвро.Курс, 0) > 0
	|					ТОГДА СрезПоследнихЦен.Цена * (КурсыВалютСрезПоследних.Курс * КурсЕвро.Кратность / (КурсЕвро.Курс * КурсыВалютСрезПоследних.Кратность))
	|				ИНАЧЕ 0
	|			КОНЕЦ
	|	КОНЕЦ КАК Цена
	|ПОМЕСТИТЬ АДУрал
	|ИЗ
	|	(ВЫБРАТЬ
	|		ЦеныНоменклатуры.ТипЦен КАК ТипЦен,
	|		ЦеныНоменклатуры.Номенклатура КАК Номенклатура,
	|		МАКСИМУМ(ЦеныНоменклатуры.Период) КАК Период
	|	ИЗ
	|		РегистрСведений.ЦеныНоменклатуры КАК ЦеныНоменклатуры
	|	ГДЕ
	|		ЦеныНоменклатуры.ТипЦен = &АДУрал
	|		И ЦеныНоменклатуры.Номенклатура В
	|				(ВЫБРАТЬ
	|					Товары.Номенклатура
	|				ИЗ
	|					Товары КАК Товары)
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ЦеныНоменклатуры.ТипЦен,
	|		ЦеныНоменклатуры.Номенклатура) КАК Таблица8
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры КАК СрезПоследнихЦен
	|		ПО Таблица8.ТипЦен = СрезПоследнихЦен.ТипЦен
	|			И Таблица8.Номенклатура = СрезПоследнихЦен.Номенклатура
	|			И Таблица8.Период = СрезПоследнихЦен.Период
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(, ) КАК КурсыВалютСрезПоследних
	|		ПО (СрезПоследнихЦен.Валюта = КурсыВалютСрезПоследних.Валюта)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(, Валюта = &Евро) КАК КурсЕвро
	|		ПО (ИСТИНА)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Таблица8.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыВРезервеНаСкладахОстатки.Номенклатура,
	|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва КАК ЗаказПокупателя
	|ПОМЕСТИТЬ ТоварыВРезерке
	|ИЗ
	|	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(
	|			,
	|			Номенклатура В
	|					(ВЫБРАТЬ
	|						Товары.Номенклатура
	|					ИЗ
	|						Товары КАК Товары)
	|				И Склад = &Склад
	|				И ДокументРезерва ССЫЛКА Документ.ЗаказПокупателя) КАК ТоварыВРезервеНаСкладахОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва,
	|	ТоварыВРезервеНаСкладахОстатки.Номенклатура
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ТоварыВРезервеНаСкладахОстатки.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыНаСкладахОстатки.КоличествоОстаток КАК Остаток,
	|	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ТоварыНаСкладахОстатки
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(
	|			,
	|			Номенклатура В
	|					(ВЫБРАТЬ
	|						Товары.Номенклатура
	|					ИЗ
	|						Товары КАК Товары)
	|				И Склад = &Склад) КАК ТоварыНаСкладахОстатки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(ТоварыОстаток.Остаток, 0) - ЕСТЬNULL(ТоварыРезерв.КоличествоОстаток, 0) КАК СвободныйОстатокСклад
	|ПОМЕСТИТЬ ТоварыСвободныйОстаток
	|ИЗ
	|	Товары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТоварыНаСкладахОстатки КАК ТоварыОстаток
	|		ПО Товары.Номенклатура = ТоварыОстаток.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(
	|				,
	|				Номенклатура В
	|						(ВЫБРАТЬ
	|							Товары.Номенклатура
	|						ИЗ
	|							Товары КАК Товары)
	|					И Склад = &Склад) КАК ТоварыРезерв
	|		ПО Товары.Номенклатура = ТоварыРезерв.Номенклатура
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыВЯчейкахОстатки.КоличествоОстаток - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0) + ЕСТЬNULL(ТоварыВСборкеОстатки.СобраноОстаток, 0) + ЕСТЬNULL(ТоварыВСборкеОстатки.КСборкеОстаток, 0) КАК Остаток,
	|	ТоварыВЯчейкахОстатки.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ТоварыОстаток
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Остатки(
	|			,
	|			Номенклатура В
	|					(ВЫБРАТЬ
	|						Товары.Номенклатура
	|					ИЗ
	|						Товары КАК Товары)
	|				И Склад = &Склад
	|				И Ячейка.НеУчитыватьВОперативномУчете = ЛОЖЬ) КАК ТоварыВЯчейкахОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(, Склад = &Склад) КАК ТоварыВРезервеНаСкладахОстатки
	|		ПО ТоварыВЯчейкахОстатки.Номенклатура = ТоварыВРезервеНаСкладахОстатки.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВСборке.Остатки(
	|				,
	|				(ЗаказПокупателя, Номенклатура) В
	|					(ВЫБРАТЬ
	|						ТоварыВРезерке.ЗаказПокупателя КАК ЗаказПокупателя,
	|						ТоварыВРезерке.Номенклатура
	|					ИЗ
	|						ТоварыВРезерке КАК ТоварыВРезерке)) КАК ТоварыВСборкеОстатки
	|		ПО ТоварыВЯчейкахОстатки.Номенклатура = ТоварыВСборкеОстатки.Номенклатура
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ТоварыОстаток.Остаток, 0) <= ЕСТЬNULL(ТоварыСвободныйОстаток.СвободныйОстатокСклад, 0)
	|			ТОГДА ЕСТЬNULL(ТоварыОстаток.Остаток, 0)
	|		ИНАЧЕ ЕСТЬNULL(ТоварыСвободныйОстаток.СвободныйОстатокСклад, 0)
	|	КОНЕЦ КАК СвободныйОстаток,
	|	Товары.Производитель,
	|	Товары.Артикул,
	|	Товары.КодПроизводителя,
	|	Товары.НаименованиеПредставление,
	|	Товары.БазоваяЕдиницаИзмерения КАК ЕдИзм,
	|	Товары.Кратность,
	|	ЕСТЬNULL(БазоваяценаМоскворечье.Цена, 0) КАК БазоваяценаМоскворечье,
	|	ЕСТЬNULL(Скидка35.Цена, 0) КАК Скидка35,
	|	ЕСТЬNULL(Скидка36.Цена, 0) КАК Скидка36,
	|	ЕСТЬNULL(Скидка37.Цена, 0) КАК Скидка37,
	|	ЕСТЬNULL(Скидка38.Цена, 0) КАК Скидка38,
	|	ЕСТЬNULL(СпецЦена.Цена, 0) КАК СпецЦена,
	|	ЕСТЬNULL(АДУрал.Цена, 0) КАК АДУрал,
	|	Товары.ЗаменяемыйРодитель,
	|	Товары.КодМДМ,
	|	Товары.Номенклатура.ГруппаАВС
	|ПОМЕСТИТЬ Итог
	|ИЗ
	|	Товары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТоварыОстаток КАК ТоварыОстаток
	|		ПО Товары.Номенклатура = ТоварыОстаток.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТоварыСвободныйОстаток КАК ТоварыСвободныйОстаток
	|		ПО Товары.Номенклатура = ТоварыСвободныйОстаток.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ БазоваяценаМоскворечье КАК БазоваяценаМоскворечье
	|		ПО Товары.Номенклатура = БазоваяценаМоскворечье.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Скидка35 КАК Скидка35
	|		ПО Товары.Номенклатура = Скидка35.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Скидка36 КАК Скидка36
	|		ПО Товары.Номенклатура = Скидка36.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Скидка37 КАК Скидка37
	|		ПО Товары.Номенклатура = Скидка37.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Скидка38 КАК Скидка38
	|		ПО Товары.Номенклатура = Скидка38.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ СпецЦена КАК СпецЦена
	|		ПО Товары.Номенклатура = СпецЦена.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ АДУрал КАК АДУрал
	|		ПО Товары.Номенклатура = АДУрал.Номенклатура
	|ГДЕ
	|	НЕ(ТоварыОстаток.Остаток ЕСТЬ NULL
	|				И БазоваяценаМоскворечье.Цена ЕСТЬ NULL
	|				И Скидка35.Цена ЕСТЬ NULL
	|				И Скидка36.Цена ЕСТЬ NULL
	|				И Скидка37.Цена ЕСТЬ NULL
	|				И Скидка38.Цена ЕСТЬ NULL
	|				И СпецЦена.Цена ЕСТЬ NULL
	|				И АДУрал.Цена ЕСТЬ NULL)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Итог.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ТоварыZСНулевымОстатком
	|ИЗ
	|	Итог КАК Итог
	|ГДЕ
	|	Итог.НоменклатураГруппаАВС.Наименование ПОДОБНО ""Z%""
	|	И Итог.СвободныйОстаток = 0
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Итог.Номенклатура КАК Номенклатура,
	|	Итог.СвободныйОстаток,
	|	Итог.Производитель,
	|	Итог.Артикул КАК Артикул,
	|	Итог.КодПроизводителя,
	|	Итог.НаименованиеПредставление,
	|	Итог.ЕдИзм,
	|	Итог.Кратность,
	|	Итог.БазоваяценаМоскворечье,
	|	Итог.Скидка35,
	|	Итог.Скидка36,
	|	Итог.Скидка37,
	|	Итог.Скидка38,
	|	Итог.СпецЦена,
	|	Итог.АДУрал,
	|	Итог.ЗаменяемыйРодитель,
	|	Итог.КодМДМ,
	|	Итог.НоменклатураГруппаАВС
	|ИЗ
	|	Итог КАК Итог
	|ГДЕ
	|	НЕ Итог.Номенклатура В
	|				(ВЫБРАТЬ
	|					ТоварыZСНулевымОстатком.Номенклатура
	|				ИЗ
	|					ТоварыZСНулевымОстатком КАК ТоварыZСНулевымОстатком)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Артикул
	|АВТОУПОРЯДОЧИВАНИЕ";  
	
	ЗакупочнаяЦена 	= Константы.ЗакупочнаяЦена.Получить();
	Базовая 		= Константы.БазоваяЦена.Получить();
	Скидка35 		= Константы.Скидка35.Получить();
	Скидка36 		= Константы.Скидка36.Получить();
	Скидка37 		= Константы.Скидка37.Получить();
	Скидка38		= Константы.Скидка38.Получить();
	СпецЦена        = Константы.СпецЦена.Получить();                       
	АДУрал          = Константы.АДУрал.Получить();
	
	ЗаменятьРодителяДляГруппыУценка = 
	Константы.ИспользоватьГруппуНоменклатурыУценка.Получить()
	и ЗначениеЗаполнено(Константы.ГруппаНоменклатурыУценка.Получить());
	
	Запрос.УстановитьПараметр("БазоваяценаМоскворечье", Базовая);  // Базовая цена Москворечье
	Запрос.УстановитьПараметр("Скидка35", 				Скидка35);  // Скидка 35%
	Запрос.УстановитьПараметр("Скидка36", 				Скидка36);  // Скидка 36%
	Запрос.УстановитьПараметр("Скидка37", 				Скидка37); // Скидка 37%
	Запрос.УстановитьПараметр("Скидка38", 				Скидка38);   // Скидка 38%
	Запрос.УстановитьПараметр("СпецЦена", 				СпецЦена);   // Скидка 38%
	Запрос.УстановитьПараметр("АДУрал", 				АДУрал);   // АД Урал
	
	ДатаПерехода = Константы.ДатаНачалаЗагрузкиИВыгрузкиЦенВРублях.Получить();  
	
	Если ЗначениеЗаполнено(ДатаПерехода) И ТекущаяДата() > ДатаПерехода Тогда 
		Запрос.УстановитьПараметр("Евро", Константы.ВалютаРегламентированногоУчета.Получить());
	Иначе
		Запрос.УстановитьПараметр("Евро", Справочники.Валюты.НайтиПоКоду("978"));
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ВидНоменклатуры", 	Константы.ВидНоменклатурыПоУмолчанию.Получить());
	Запрос.УстановитьПараметр("Склад",   			Константы.ОсновнойСклад.Получить());      
	Текст = Новый ТекстовыйДокумент;
	
	Результат = Запрос.Выполнить(); 
	
	Если НЕ Результат.Пустой() Тогда   
		
		Выборка = Результат.Выбрать(); 
		
		ЗаписьЖурналаРегистрации("Полное обновление остатков и цен.Обработка", УровеньЖурналаРегистрации.Информация,,, 
		"Количество строк в запросе: " + Строка(Выборка.Количество()));
		
		Пока Выборка.Следующий() Цикл 
			
			Подстрока = 
			Выборка.ЗаменяемыйРодитель + Символы.Таб
			 + Выборка.Артикул + Символы.Таб
			 + Выборка.КодПроизводителя + Символы.Таб
			 + Выборка.Номенклатура + Символы.Таб
			 + Выборка.ЕдИзм + Символы.Таб
			 + строка(Выборка.Кратность) + Символы.Таб
			 + Строка(СтрЗаменить(?(Выборка.СвободныйОстаток < 0, 0, Выборка.СвободныйОстаток), Символы.НПП, "")) + Символы.Таб 
			 + Строка(СтрЗаменить(Выборка.БазоваяценаМоскворечье, Символы.НПП, "")) + Символы.Таб 
			 + Строка(СтрЗаменить(Выборка.Скидка35, Символы.НПП, "")) + Символы.Таб
			 + Строка(СтрЗаменить(Выборка.Скидка36, Символы.НПП, "")) + Символы.Таб
			 + Строка(СтрЗаменить(Выборка.Скидка37, Символы.НПП, "")) + Символы.Таб			
			 + Строка(СтрЗаменить(Выборка.Скидка38, Символы.НПП, "")) + Символы.Таб			
			 + Строка(СтрЗаменить(Выборка.СпецЦена, Символы.НПП, "")) + Символы.Таб			
			 + Строка(СтрЗаменить(Выборка.АДУрал, Символы.НПП, "")) + Символы.Таб
			 + Выборка.КодМДМ;                
			 
			Текст.ДобавитьСтроку(Подстрока);
			
