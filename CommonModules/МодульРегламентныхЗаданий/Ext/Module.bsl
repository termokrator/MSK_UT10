	|	РегистрНакопления.ТоварыВЯчейках.Остатки(
	|			,
	|			Номенклатура В
	|					(ВЫБРАТЬ
	|						Товары.Номенклатура
	|					ИЗ
	|						Товары КАК Товары)
	|				И Склад = &Склад
	|				И Ячейка.НеУчитыватьВОперативномУчете = ЛОЖЬ) КАК ТоварыВЯчейкахОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(, Склад = &Склад) КАК ТоварыВРезервеНаСкладахОстатки
	|		ПО ТоварыВЯчейкахОстатки.Номенклатура = ТоварыВРезервеНаСкладахОстатки.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВСборке.Остатки(
	|				,
	|				(ЗаказПокупателя, Номенклатура) В
	|					(ВЫБРАТЬ
	|						ТоварыВРезерке.ЗаказПокупателя КАК ЗаказПокупателя,
	|						ТоварыВРезерке.Номенклатура
	|					ИЗ
	|						ТоварыВРезерке КАК ТоварыВРезерке)) КАК ТоварыВСборкеОстатки
	|		ПО ТоварыВЯчейкахОстатки.Номенклатура = ТоварыВСборкеОстатки.Номенклатура
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Производитель,
	|	Товары.Артикул,
	|	Товары.КодПроизводителя,
	|	Товары.НаименованиеПредставление,
	|	Товары.БазоваяЕдиницаИзмерения КАК ЕдИзм,
	|	Товары.Кратность,
	|	Товары.КодМДМ,
	|	ЕСТЬNULL(ТоварыОстаток_Т2.КоличествоОстаток, 0) - ЕСТЬNULL(ТоварыРезерв_Т2.КоличествоРезерв, 0) КАК ОстатокПоСкладу,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ТоварыОстаток_Т2.КоличествоОстаток, 0) - ЕСТЬNULL(ТоварыРезерв_Т2.КоличествоРезерв, 0) <= ЕСТЬNULL(ТоварыОстаток.Остаток, 0)
	|			ТОГДА ЕСТЬNULL(ТоварыОстаток_Т2.КоличествоОстаток, 0) - ЕСТЬNULL(ТоварыРезерв_Т2.КоличествоРезерв, 0)
	|		ИНАЧЕ ЕСТЬNULL(ТоварыОстаток.Остаток, 0)
	|	КОНЕЦ КАК СвободныйОстаток,
	|	ЕСТЬNULL(БазоваяценаМоскворечье.Цена, 0) КАК БазоваяценаМоскворечье,
	|	ЕСТЬNULL(Скидка35.Цена, 0) КАК Скидка35,
	|	ЕСТЬNULL(Скидка36.Цена, 0) КАК Скидка36,
	|	ЕСТЬNULL(Скидка37.Цена, 0) КАК Скидка37,
	|	ЕСТЬNULL(Скидка38.Цена, 0) КАК Скидка38,
	|	ЕСТЬNULL(СпецЦена.Цена, 0) КАК СпецЦена
	|ИЗ
	|	Товары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТоварыОстаток КАК ТоварыОстаток
	|		ПО Товары.Номенклатура = ТоварыОстаток.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТоварыОстаток_Т2 КАК ТоварыОстаток_Т2
	|		ПО Товары.Номенклатура = ТоварыОстаток_Т2.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТоварыРезерв_Т2 КАК ТоварыРезерв_Т2
	|		ПО Товары.Номенклатура = ТоварыРезерв_Т2.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ БазоваяценаМоскворечье КАК БазоваяценаМоскворечье
	|		ПО Товары.Номенклатура = БазоваяценаМоскворечье.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Скидка35 КАК Скидка35
	|		ПО Товары.Номенклатура = Скидка35.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Скидка36 КАК Скидка36
	|		ПО Товары.Номенклатура = Скидка36.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Скидка37 КАК Скидка37
	|		ПО Товары.Номенклатура = Скидка37.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Скидка38 КАК Скидка38
	|		ПО Товары.Номенклатура = Скидка38.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ СпецЦена КАК СпецЦена
	|		ПО Товары.Номенклатура = СпецЦена.Номенклатура
	|ГДЕ
	|	НЕ(ТоварыОстаток.Остаток ЕСТЬ NULL
	|				И БазоваяценаМоскворечье.Цена ЕСТЬ NULL
	|				И Скидка35.Цена ЕСТЬ NULL
	|				И Скидка36.Цена ЕСТЬ NULL
	|				И Скидка37.Цена ЕСТЬ NULL
	|				И Скидка38.Цена ЕСТЬ NULL
	|				И СпецЦена.Цена ЕСТЬ NULL)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Товары.Артикул
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	ЗакупочнаяЦена 	= Константы.ЗакупочнаяЦена.Получить();
	Базовая 		= Константы.БазоваяЦена.Получить();
	Скидка35 		= Константы.Скидка35.Получить();
	Скидка36 		= Константы.Скидка36.Получить();
	Скидка37 		= Константы.Скидка37.Получить();
	Скидка38		= Константы.Скидка38.Получить();
	СпецЦена        = Константы.СпецЦена.Получить();   				
	
	Запрос.УстановитьПараметр("БазоваяценаМоскворечье",Базовая);  // Базовая цена Москворечье
	Запрос.УстановитьПараметр("Скидка35", 				Скидка35);  // Скидка 35%
	Запрос.УстановитьПараметр("Скидка36", 				Скидка36);  // Скидка 36%
	Запрос.УстановитьПараметр("Скидка37", 				Скидка37); // Скидка 37%
	Запрос.УстановитьПараметр("Скидка38", 				Скидка38);   // Скидка 38%
	Запрос.УстановитьПараметр("СпецЦена", 				СпецЦена);   // СпецЦена
	
	ДатаПерехода = Константы.ДатаНачалаЗагрузкиИВыгрузкиЦенВРублях.Получить();
	
	Если ЗначениеЗаполнено(ДатаПерехода) И ТекущаяДата() > ДатаПерехода Тогда 
		Запрос.УстановитьПараметр("Евро", Константы.ВалютаРегламентированногоУчета.Получить());
	Иначе
		Запрос.УстановитьПараметр("Евро", Справочники.Валюты.НайтиПоКоду("978"));
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ВидНоменклатуры", 	Константы.ВидНоменклатурыПоУмолчанию.Получить());
	Запрос.УстановитьПараметр("Склад",   			Константы.ОсновнойСклад.Получить());    
	
	Текст = Новый ТекстовыйДокумент;
	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		
		Выборка = Результат.Выбрать(); 
		
		Пока Выборка.Следующий() Цикл 
			
			Подстрока = 
			Выборка.Производитель + Символы.Таб
			 + Выборка.Артикул + Символы.Таб
			 + Выборка.КодПроизводителя + Символы.Таб
			 + Выборка.Номенклатура + Символы.Таб
			 + Выборка.ЕдИзм + Символы.Таб
			 + строка(Выборка.Кратность) + Символы.Таб
			 + Строка(СтрЗаменить(?(Выборка.СвободныйОстаток < 0, 0, Выборка.СвободныйОстаток), Символы.НПП, "")) + Символы.Таб 
			 + Строка(СтрЗаменить(Выборка.БазоваяценаМоскворечье, Символы.НПП, "")) + Символы.Таб 
			 + Строка(СтрЗаменить(Выборка.Скидка35, Символы.НПП, "")) + Символы.Таб
			 + Строка(СтрЗаменить(Выборка.Скидка36, Символы.НПП, "")) + Символы.Таб
			 + Строка(СтрЗаменить(Выборка.Скидка37, Символы.НПП, "")) + Символы.Таб
			 + Строка(СтрЗаменить(Выборка.Скидка38, Символы.НПП, "")) + Символы.Таб
			 + Строка(СтрЗаменить(Выборка.СпецЦена, Символы.НПП, "")) + Символы.Таб
			 + Выборка.КодМДМ; 			
			
			Текст.ДобавитьСтроку(Подстрока);	
			
		КонецЦикла;
		
	КонецЕсли;
	
	ИмяВременногоКаталога = СокрЛП(Новый УникальныйИдентификатор);
	СоздатьКаталог(КаталогВременныхФайлов() + ИмяВременногоКаталога);
	
	ВременныйКаталог = КаталогВременныхФайлов() + ИмяВременногоКаталога + "\";
	ВремИмя = Строка(Новый УникальныйИдентификатор);
	Текст.Записать(ВременныйКаталог + ВремИмя,КодировкаТекста.ANSI);
	
	Попытка
		Соединение = Новый FTPСоединение(ИмяFTPСервера, "21", Константы.FTPВыгрузкаОстатковЛогин2.Получить(), Константы.FTPВыгрузкаОстатковПароль2.Получить(), , Истина);
	Исключение
		
		ЗаписьЖурналаРегистрации("Полное обновление остатков и цен_2", УровеньЖурналаРегистрации.Ошибка, , ,
		"Не удалось установить соединение с FTP. Запись данных на FTP  не выполнена.");
		Возврат;
		
	КонецПопытки;
	
	Отказ = Ложь;
	
	МассивНайденныхФайловНаСервере = Соединение.НайтиФайлы(ИмяКаталогаСервера + "*.lock");	
	
	Для Каждого ТекСтр Из МассивНайденныхФайловНаСервере Цикл
		
		Если ВРег(ТекСтр.Имя) = ВРег("daemon.locK") 
			Или ВРег(ТекСтр.Имя) = ВРег("connect.lock") Тогда
			
			Отказ = Истина;
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;	
	
	Если Отказ Тогда
		
		ЗаписьЖурналаРегистрации("Запись данных на FTP НЕ СОСТОЯЛАСЬ из-за БЛОКИРОВКИ");
		Возврат;
		
	КонецЕсли;	
	
	// Записать файлик блокировки
	Файлик = Новый ТекстовыйДокумент;
	ВремИмяФайлаБлокировки = Строка(Новый УникальныйИдентификатор);
	Файлик.Записать(КаталогВременныхФайлов() + ВремИмяФайлаБлокировки);
	
	Попытка
		
		Соединение.Записать(КаталогВременныхФайлов() + ВремИмяФайлаБлокировки, ?(ЗначениеЗаполнено(ЗаданаПапкаДляFTP), ЗаданаПапкаДляFTP + "\", "") + "connect.lock");		
		ЗаписьЖурналаРегистрации("Полное обновление остатков и цен_2", УровеньЖурналаРегистрации.Информация,,, "Файл connect.lock записан в каталог: " + ЗаданаПапкаДляFTP);
		
	Исключение 
		
		Попытка
			
			Соединение = Новый FTPСоединение(ИмяFTPСервера, "21", Константы.FTPВыгрузкаОстатковЛогин2.Получить(),  Константы.FTPВыгрузкаОстатковПароль2.Получить(), , Истина);		
			Соединение.Записать(КаталогВременныхФайлов() + ВремИмяФайлаБлокировки, ?(ЗначениеЗаполнено(ЗаданаПапкаДляFTP), ЗаданаПапкаДляFTP + "\", "") + "connect.lock");
			ЗаписьЖурналаРегистрации("Полное обновление остатков и цен_2", УровеньЖурналаРегистрации.Информация,,, "Файл connect.lock записан в каталог: " + ЗаданаПапкаДляFTP);
			
		Исключение
			
			ЗаписьЖурналаРегистрации("Полное обновление остатков и цен_2", УровеньЖурналаРегистрации.Информация,,, 
			"Ошибка записи файла connect.lock записан в каталог: " + ЗаданаПапкаДляFTP + Символы.ПС + ОписаниеОшибки());	
			Возврат;
			
		КонецПопытки;
		
	КонецПопытки;
	
	Попытка
		
		Соединение.Записать(ВременныйКаталог + ВремИмя, ?(ЗначениеЗаполнено(ЗаданаПапкаДляFTP), ЗаданаПапкаДляFTP + "\", "") + ВремИмя);		
		ЗаписьЖурналаРегистрации("Полное обновление остатков и цен_2", УровеньЖурналаРегистрации.Информация, , ,
		"Документ записан под временным имененм на FTP: " + ИмяFTPСервера + " в каталог: " + ЗаданаПапкаДляFTP);
		
	Исключение
		
		Попытка
			Соединение = Новый FTPСоединение(ИмяFTPСервера, "21", Константы.FTPВыгрузкаОстатковЛогин2.Получить(),  Константы.FTPВыгрузкаОстатковПароль2.Получить(), , Истина);
			Соединение.Записать(ВременныйКаталог + ВремИмя, ?(ЗначениеЗаполнено(ЗаданаПапкаДляFTP), ЗаданаПапкаДляFTP + "\", "") + ВремИмя);		
			
			ЗаписьЖурналаРегистрации("Полное обновление остатков и цен_2", УровеньЖурналаРегистрации.Информация,,, 
			"Документ записан под временным имененм на FTP: " + ИмяFTPСервера + " в каталог: " + ЗаданаПапкаДляFTP);
			
		Исключение
			ЗаписьЖурналаРегистрации("Полное обновление остатков и цен_2", УровеньЖурналаРегистрации.Ошибка,,, 
			"Блокировки НЕ БЫЛО. Но запись данных под временным имененм на FTP: " + ИмяFTPСервера + " НЕ СОСТОЯЛАСЬ!" + Символы.ПС + ОписаниеОшибки());
		КонецПопытки;
		
	КонецПопытки;
	
	Попытка
		
		Соединение.Переместить(?(ЗначениеЗаполнено(ЗаданаПапкаДляFTP), ЗаданаПапкаДляFTP + "\", "") + ВремИмя, 
		?(ЗначениеЗаполнено(ЗаданаПапкаДляFTP), ЗаданаПапкаДляFTP + "\", "") + "price.file");		
		
		ЗаписьЖурналаРегистрации("Полное обновление остатков и цен.Обработка", УровеньЖурналаРегистрации.Информация,,, 
		"Документ записан на FTP: " + ИмяFTPСервера + " в каталог: " + ЗаданаПапкаДляFTP);
		
	Исключение     		
		
		Попытка
			
			Соединение = Новый FTPСоединение(ИмяFTPСервера, "21", Константы.FTPВыгрузкаОстатковЛогин2.Получить(), Константы.FTPВыгрузкаОстатковПароль2.Получить(), , Истина);
			Соединение.Переместить(?(ЗначениеЗаполнено(ЗаданаПапкаДляFTP), ЗаданаПапкаДляFTP + "\", "") + ВремИмя, 
			?(ЗначениеЗаполнено(ЗаданаПапкаДляFTP), ЗаданаПапкаДляFTP + "\", "") + "price.file");		
			
			ЗаписьЖурналаРегистрации("Полное обновление остатков и цен_2", УровеньЖурналаРегистрации.Информация,,, 
			"Документ записан на FTP: " + ИмяFTPСервера + " в каталог: " + ЗаданаПапкаДляFTP);
			
		Исключение
			ЗаписьЖурналаРегистрации("Полное обновление остатков и цен_2", УровеньЖурналаРегистрации.Ошибка,,, 
			"Блокировки НЕ БЫЛО. Но запись данных на FTP: " + ИмяFTPСервера + " НЕ СОСТОЯЛАСЬ!" + Символы.ПС + ОписаниеОшибки());
		КонецПопытки;
		
	КонецПопытки;
	
	// Удалить файлик
	Попытка
		
		Соединение.Удалить(?(ЗначениеЗаполнено(ЗаданаПапкаДляFTP), ЗаданаПапкаДляFTP + "/", "") + "connect.lock");
		ЗаписьЖурналаРегистрации("Полное обновление остатков и цен_2", УровеньЖурналаРегистрации.Информация, , , "Файл connect.lock успешно удален");
		
	Исключение
		
		Попытка
			
			Соединение = Новый FTPСоединение(ИмяFTPСервера, "21", Константы.FTPВыгрузкаОстатковЛогин2.Получить(), Константы.FTPВыгрузкаОстатковПароль2.Получить(), , Истина);
			Соединение.Удалить(?(ЗначениеЗаполнено(ЗаданаПапкаДляFTP), ЗаданаПапкаДляFTP + "/", "") + "connect.lock");
			
			ЗаписьЖурналаРегистрации("Полное обновление остатков и цен_2", УровеньЖурналаРегистрации.Информация, , , "Файл connect.lock успешно удален");
			
		Исключение
			ЗаписьЖурналаРегистрации("Полное обновление остатков и цен_2", УровеньЖурналаРегистрации.Ошибка, , , 
			"Ошибка при удалении файла connect.lock" + Символы.ПС + ОписаниеОшибки());
		КонецПопытки;
		
	КонецПопытки;
	
	УдалитьФайлы(КаталогВременныхФайлов() + ВремИмя);
	УдалитьФайлы(КаталогВременныхФайлов() + ВремИмяФайлаБлокировки);
	УдалитьФайлы(ВременныйКаталог);

КонецПроцедуры

Процедура ОбновлениеЦенПортал() Экспорт 
	
	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда  
		
		ЗаписьЖурналаРегистрации("Обновление цен портал", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Отменена работа регламентного задания из-за несоответствия параметров подключения к ИБ");
		Возврат;
		
	КонецЕсли; 
	
	ИмяS3Сервера       = Константы.S3ВыгрузкаЦенАдрес.Получить();
	ПортS3Сервера      = Константы.S3ВыгрузкаЦенПорт.Получить();
