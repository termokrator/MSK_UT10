	Запрос.УстановитьПараметр("ДатаПТУ", Дата('2024.01.01 00:00:01'));
	Запрос.УстановитьПараметр("Свойство", ПланыВидовХарактеристик.СвойстваОбъектов.СтатусПриемки);
	Запрос.УстановитьПараметр("ЗначениеСвойства", Перечисления.СтатусыПриемки.Обработка);
	Запрос.УстановитьПараметр("Контрагент", Константы.ОсновнойПоставщик.Получить());
	
