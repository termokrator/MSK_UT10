		Товары.Добавить(Запись);
		
	КонецЦикла; 
	
	СтруктураДокумента.Вставить("Товары", Товары);
	
КонецПроцедуры

Процедура ЗаписатьРеквизитыНоменклатуры(СтруктураДокумента, ДополнПараметры)
	
	СтруктураДокумента.Вставить("ТипСодержимого", "application/json");
	СтруктураДокумента.Вставить("ВидДокумента", "ПередачаРеквизитовНоменклатуры");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.КодМДМ КАК НоменклатураКодМДМ,
	|	Номенклатура.НеЗагружатьЦеныЕслиЕстьОстатокТовара,
	|	Номенклатура.КратностьФилиала
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	НЕ Номенклатура.КодМДМ = """"
	|			И (Номенклатура.НеЗагружатьЦеныЕслиЕстьОстатокТовара
	|				ИЛИ НЕ Номенклатура.КратностьФилиала = 0)";
	
	РезультатЗапроса = Запрос.Выполнить();
		
	Товары  = Новый Массив;
	
	КолСтрокВСообщении = 0;
	
	Если НЕ РезультатЗапроса.Пустой() Тогда   
		
		КолСтрокВСообщении = СокрЛП(РезультатЗапроса.Выгрузить().Количество());
		
		ВыборкаЗапроса = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаЗапроса.Следующий() Цикл
			
			ТоварыСтруктура = Новый Структура;
			
			ТоварыСтруктура.Вставить("НоменклатураКодМДМ" 	                      , ВыборкаЗапроса.НоменклатураКодМДМ);
			ТоварыСтруктура.Вставить("НеЗагружатьЦеныЕслиЕстьОстатокТовара" 	  , ВыборкаЗапроса.НеЗагружатьЦеныЕслиЕстьОстатокТовара);
			ТоварыСтруктура.Вставить("КратностьФилиала" 	                      , ВыборкаЗапроса.КратностьФилиала);
			Товары.Добавить(ТоварыСтруктура);
			
		КонецЦикла;
		
	КонецЕсли; 
	
	СтруктураДокумента.Вставить("КоличествоСтрок", КолСтрокВСообщении);
	СтруктураДокумента.Вставить("Товары"  , Товары);
	
КонецПроцедуры 
	
Процедура ЗаписатьПредопределенныеРеквизитыДокумента(Документ , СтруктураДокумента , ОтменаПроведения , ИмяДокумента) 	
 
	СтруктураДокумента.Вставить("УникальныйИдентификатор" , Строка(Документ.Ссылка.УникальныйИдентификатор()));
	СтруктураДокумента.Вставить("НомерДокумента"          , СокрЛП(Документ.Номер));
	СтруктураДокумента.Вставить("ДатаДокумента"           , Формат(Документ.Дата, "ДЛФ=DT"));	
	СтруктураДокумента.Вставить("Статус"                  , ?(Документ.Проведен, ?(ОтменаПроведения, 0, 1), 0)); 
	СтруктураДокумента.Вставить("ШтампВерсии"             , Документ.ШтампВерсии); 
	СтруктураДокумента.Вставить("ПометкаУдаления"         , Документ.ПометкаУдаления); 
	СтруктураДокумента.Вставить("Комментарий"			  , ?(ОбщегоНазначения.ЕстьРеквизитДокумента("Комментарий", Документ.Метаданные()), Документ.Комментарий, ""));
	
	Если ИмяДокумента = "КорректировкаПоступления" ИЛИ ИмяДокумента = "УстановкаЦенНоменклатуры" 
		ИЛИ ИмяДокумента = "УстановкаЦенНоменклатурыКонтрагентов"
		ИЛИ ИмяДокумента = "ПоступлениеУслугПрочихАктивов" Тогда  
		
		СтруктураДокумента.Вставить("ТипСодержимого" , "application/json");
		СтруктураДокумента.Вставить("ВидДокумента"   , ИмяДокумента);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаписатьВозвратТоваровОтПокупателя(Документ , СтруктураДокумента , ПеречитатьРегистры)

	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "Организация", "КодМДМГоловнойОрганизации", "КодОрганизацииМДМ");  
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "Контрагент", "КодМДМ", "КодКонтрагентаМДМ");
	
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "Контрагент", "КодМДМ", "КодФилиалаМДМ");	
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "Грузополучатель", "КодМДМ", "КодФилиалаМДМ");
	
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "Договор", "КодМДМ", "КодДоговораМДМ");
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "ДоговорКонтрагента", "КодМДМ", "КодДоговораМДМ");
	
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "Склад", "КодМДМ", "КодСкладаМДМ");     	
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "СуммаДокумента", "Сумма");  
	
	СтруктураДокумента.Вставить("КодПартнераМДМ", "");	
	
	СуммаНДС = Документ.Товары.Итог("СуммаНДС");
	СтруктураДокумента.Вставить("СуммаНДС", СуммаНДС);	
	
	Валюта = Документ.ВалютаДокумента;
	СтруктураДокумента.Вставить("Валюта", Валюта.КодМДМ);
	
	КодСоглашенияАварда = "";	
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДоговорыАварды.КодАварда
	|ИЗ
	|	РегистрСведений.ДоговорыАварды КАК ДоговорыАварды
	|ГДЕ
	|	ДоговорыАварды.ДоговорКонтрагента = &ДоговорКонтрагента";
	
	Запрос.УстановитьПараметр("ДоговорКонтрагента", Документ.ДоговорКонтрагента);
	
	Выборка = Запрос.Выполнить().Выбрать();	  
	
	Пока Выборка.Следующий() Цикл     
		КодСоглашенияАварда = КодСоглашенияАварда + ?(ЗначениеЗаполнено(КодСоглашенияАварда), ",", "") + СтрЗаменить(Строка(Выборка.КодАварда), " ", ""); 
	КонецЦикла;
	
	СтруктураДокумента.Вставить("КодСоглашенияАварда", КодСоглашенияАварда);
	
	Если Документ.Товары.Количество() > 0 И ЗначениеЗаполнено(Документ.Товары[0].ЗаказПокупателя) Тогда 
		СтруктураДокумента.Вставить("КлючСтрокиУсловий", Документ.Товары[0].ЗаказПокупателя.КлючСтрокиУсловий);   
	Иначе                                                                      
		СтруктураДокумента.Вставить("КлючСтрокиУсловий", 0);                
	КонецЕсли;
	
	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	
	Товары = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВозвратТоваровОтПокупателяТовары.Номенклатура.КодМДМ КАК НоменклатураКодМДМ,
	|	ВозвратТоваровОтПокупателяТовары.Количество,
	|	ВозвратТоваровОтПокупателяТовары.СтавкаНДС,
	|	ВозвратТоваровОтПокупателяТовары.Сумма,
	|	ВозвратТоваровОтПокупателяТовары.СуммаНДС,
	|	ВозвратТоваровОтПокупателяТовары.Цена,
	|	ВозвратТоваровОтПокупателяТовары.СерияНоменклатуры.НомерГТД.Представление КАК НомерГТД,
	|	ВозвратТоваровОтПокупателяТовары.ЗаказПокупателя,
	|	ВозвратТоваровОтПокупателяТовары.НомерСтроки КАК НомерСтроки,
	|	ВозвратТоваровОтПокупателяТовары.ЕдиницаИзмерения.КодМДМ КАК КодМДМЕдиницыИзмерения,
	|	ВозвратТоваровОтПокупателяТовары.ДокументПартии
	|ИЗ
	|	Документ.ВозвратТоваровОтПокупателя.Товары КАК ВозвратТоваровОтПокупателяТовары
	|ГДЕ
	|	ВозвратТоваровОтПокупателяТовары.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка",Документ.Ссылка);  
	
	Выб = Запрос.Выполнить().Выбрать();     
	
	Пока Выб.Следующий() Цикл  
		
		ТоварыСтруктура = Новый Структура;
		
		ТоварыСтруктура.Вставить("НомерСтроки", Выб.НомерСтроки);
		ТоварыСтруктура.Вставить("КодМДМНоменклатуры", Выб.НоменклатураКодМДМ);
		ТоварыСтруктура.Вставить("Количество", Выб.Количество);
		ТоварыСтруктура.Вставить("КодМДМЕдиницыИзмерения", Выб.КодМДМЕдиницыИзмерения);
		ТоварыСтруктура.Вставить("Цена", Выб.Цена);
		ТоварыСтруктура.Вставить("Сумма", Выб.Сумма);
		ТоварыСтруктура.Вставить("СуммаНДС", Выб.СуммаНДС);		
		ТоварыСтруктура.Вставить("СтавкаНДС", УчетНДС.ПолучитьСтавкуНДС(Выб.СтавкаНДС));
		ТоварыСтруктура.Вставить("НомерГТД", СокрЛП(Выб.НомерГТД));
		ТоварыСтруктура.Вставить("ГУИДДокументаОснование", Строка(Выб.ДокументПартии.УникальныйИдентификатор()));		
		
		Товары.Добавить(ТоварыСтруктура);   		
		
	КонецЦикла;  
	
	СтруктураДокумента.Вставить("Товары", Товары);

КонецПроцедуры                                

Процедура ЗаписатьРеализацияТоваровУслуг(Документ , СтруктураДокумента , ПеречитатьРегистры)
	
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "Организация", "КодМДМГоловнойОрганизации", "КодОрганизацииМДМ");  
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "Контрагент", "КодМДМ", "КодКонтрагентаМДМ");
	
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "Контрагент", "КодМДМ", "КодФилиалаМДМ");	
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "Грузополучатель", "КодМДМ", "КодФилиалаМДМ");
	
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "Договор", "КодМДМ", "КодДоговораМДМ");
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "ДоговорКонтрагента", "КодМДМ", "КодДоговораМДМ");
	
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "Склад", "КодМДМ", "КодСкладаМДМ");     	
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "СуммаДокумента", "Сумма");     	
	
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "Контрагент", "КодМДМПартнера", "КодПартнераМДМ");	
	
	СуммаНДС = Документ.Товары.Итог("СуммаНДС");
	СтруктураДокумента.Вставить("СуммаНДС", СуммаНДС);	
	
	Валюта = Документ.ВалютаДокумента;
	СтруктураДокумента.Вставить("Валюта", Валюта.КодМДМ);
	
	СтруктураДокумента.Вставить("КодОрганизацииИС", "");
	СтруктураДокумента.Вставить("КодКонтрагентаИС", "");
	СтруктураДокумента.Вставить("КодПартнераИС", "");
	СтруктураДокумента.Вставить("КодФилиалаИС", "");
	СтруктураДокумента.Вставить("КодДоговораИС", "");
	СтруктураДокумента.Вставить("КодСкладаИС", "");
	СтруктураДокумента.Вставить("ВалютаЦифровойКод", "");
	СтруктураДокумента.Вставить("ВалютаБуквенныйКод", "");
	СтруктураДокумента.Вставить("АдресДоставки", Документ.АдресДоставки);
	
    //Управленческая организация
	Если Документ.Организация = Константы.ОсновнаяОрганизацияДляОплатыНаличнымиДляВодителей.Получить() Тогда
		СтруктураДокумента.Вставить("НалогообложениеНДС", "ПродажаНеОблагаетсяНДС");	
	Иначе
		СтруктураДокумента.Вставить("НалогообложениеНДС", "ПродажаОблагаетсяНДС");
	КонецЕсли;
	
	КроссДокинг = Ложь;
	
	Для каждого Стр ИЗ Документ.Товары Цикл
		
		Если Стр.ЗаказПокупателя.КроссДокинг Тогда
			
			КроссДокинг = Истина;
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	СтруктураДокумента.Вставить("КроссДокинг", Число(КроссДокинг));
	СтруктураДокумента.Вставить("ОтражатьВУправленческомУчете", Число(Документ.ОтражатьВУправленческомУчете));
	
	КодСоглашенияАварда = "";	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДоговорыАварды.КодАварда
	|ИЗ
	|	РегистрСведений.ДоговорыАварды КАК ДоговорыАварды
	|ГДЕ
	|	ДоговорыАварды.ДоговорКонтрагента = &ДоговорКонтрагента";
	
	Запрос.УстановитьПараметр("ДоговорКонтрагента", Документ.ДоговорКонтрагента);
	
	Выборка = Запрос.Выполнить().Выбрать();	     
	
	Пока Выборка.Следующий() Цикл   
		КодСоглашенияАварда = КодСоглашенияАварда + ?(ЗначениеЗаполнено(КодСоглашенияАварда), ",", "") + СтрЗаменить(Строка(Выборка.КодАварда), " ", "");  
	КонецЦикла;
	
	СтруктураДокумента.Вставить("КодСоглашенияАварда", КодСоглашенияАварда);
	
	Если Документ.Товары.Количество() > 0 И ЗначениеЗаполнено(Документ.Товары[0].ЗаказПокупателя) Тогда 
		СтруктураДокумента.Вставить("КлючСтрокиУсловий", Документ.Товары[0].ЗаказПокупателя.КлючСтрокиУсловий); 
	Иначе                                                                                      
		СтруктураДокумента.Вставить("КлючСтрокиУсловий", 0);                                
	КонецЕсли;
	
	СтруктураДокумента.Вставить("Водитель", Строка(Документ.Водитель));
	СтруктураДокумента.Вставить("ОбратнаяПродажа", 0);
	СтруктураДокумента.Вставить("КоличествоКорректировок", 0); 
	СтруктураДокумента.Вставить("ЧекККМ", ?(ЗначениеЗаполнено(Документ.НомерЧекаККМ), 1, 0)); 	
	СтруктураДокумента.Вставить("ДатаПлатежа", Формат(Документ.ДатаПлатежа, "ДЛФ=DT"));
	
	//+Бычков О. 23.10.2025 #UT10-5480
	// Вставка
	Если ЭтоРеализацияТоваровИУслугПоОрганизацииТОХ(Документ.Ссылка) Тогда
		
	    ТекКодМДМОрганизацииТОХ = Константы.КодМДМОрганизацииТОХ.Получить();
		
		СтруктураДокумента.Вставить("КодМДМОрганизацииТОХ", ТекКодМДМОрганизацииТОХ);
		
		ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "ДоговорПоставщикаТОХ", "КодМДМ", "ДоговорПоставщикаТОХКодМДМ");

	КонецЕсли;
	//-Бычков О. 23.10.2025 #UT10-5480
	
	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	
	Если Документ.Движения.Найти("Продажи") <> Неопределено Тогда
		
		ПродажиМассив = Новый Массив;
		
		Если ПеречитатьРегистры Тогда
			Документ.Движения.Продажи.Прочитать();
		КонецЕсли;
		
		ТаблицаПродаж = Документ.Движения.Продажи.Выгрузить();
		ТаблицаПродаж.Свернуть("ЗаказПокупателя", "Стоимость, НДС");
		
		Для каждого Продажа Из ТаблицаПродаж Цикл
			
			Если Не ЗначениеЗаполнено(Продажа.ЗаказПокупателя) Тогда
				Продолжить;
			КонецЕсли;
			
			ПродажиСтруктура = Новый Структура;    
			ПродажиСтруктура.Вставить("УникальныйИдентификатор", Строка(Продажа.ЗаказПокупателя.УникальныйИдентификатор()));
			ПродажиСтруктура.Вставить("Номер", СокрЛП(Продажа.ЗаказПокупателя.Номер));
			ПродажиСтруктура.Вставить("Дата",  Формат(Продажа.ЗаказПокупателя.Дата, "ДЛФ=DT"));
			ПродажиСтруктура.Вставить("Сумма", Продажа.Стоимость);
			ПродажиСтруктура.Вставить("СуммаНДСЗаказа", Продажа.НДС);
			ПродажиСтруктура.Вставить("УИПортал", Продажа.ЗаказПокупателя.IDЗаказаПортал);
			
			ПродажиМассив.Добавить(ПродажиСтруктура);   		
			
		КонецЦикла;
		
		СтруктураДокумента.Вставить("Заказы", ПродажиМассив);
		
	КонецЕсли;
	
	Товары = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеализацияТоваровУслугТовары.Номенклатура.КодМДМ КАК НоменклатураКодМДМ,
	|	РеализацияТоваровУслугТовары.Количество,
	|	РеализацияТоваровУслугТовары.СтавкаНДС,
	|	ВЫБОР
	|		КОГДА РеализацияТоваровУслугТовары.Ссылка.СуммаВключаетНДС
	|			ТОГДА РеализацияТоваровУслугТовары.Сумма
	|		ИНАЧЕ РеализацияТоваровУслугТовары.Сумма + РеализацияТоваровУслугТовары.СуммаНДС
	|	КОНЕЦ КАК Сумма,
	|	РеализацияТоваровУслугТовары.СуммаНДС,
	|	РеализацияТоваровУслугТовары.Цена,
	|	РеализацияТоваровУслугТовары.СерияНоменклатуры.НомерГТД.Код КАК НомерГТД,
	|	РеализацияТоваровУслугТовары.СерияНоменклатуры.СтранаПроисхождения.КодМДМ КАК КодМДМСтранаПроисхождения,
	|	ВЫБОР
	|		КОГДА РеализацияТоваровУслугТовары.ЗаказПокупателя = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	|			ТОГДА """"
	|		КОГДА РеализацияТоваровУслугТовары.ЗаказПокупателя.IDСклада_СтороннийСклад = ЗНАЧЕНИЕ(Справочник.СторонниеСклады.ПустаяСсылка)
	|			ТОГДА """"
	|		ИНАЧЕ ""ПродажаСоСторСклада""
	|	КОНЕЦ КАК НаправлениеДеятельности,
	|	РеализацияТоваровУслугТовары.ЗаказПокупателя,
	|	РеализацияТоваровУслугТовары.НомерСтроки КАК НомерСтроки,
	|	РеализацияТоваровУслугТовары.ЕдиницаИзмерения.КодМДМ КАК КодМДМЕдиницыИзмерения,
	|	РеализацияТоваровУслугТовары.СерияНоменклатуры.Наименование КАК СерияНоменклатуры,
	//+Шульман А. 18.11.2024 #UT10-4903 
	|	РеализацияТоваровУслугТовары.ЗаказПокупателя.ТипЦен.КодМДМ КАК ТипЦенКодМДМ    
	//-Шульман А. 18.11.2024 #UT10-4903 
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|ГДЕ
	|	РеализацияТоваровУслугТовары.Ссылка = &Ссылка";  
	
	Запрос.УстановитьПараметр("Ссылка",Документ.Ссылка);  
	
	//+Бычков О. 28.11.2025 #UT10-5543
	// Было
	//Выб = Запрос.Выполнить().Выбрать();
	// Стало
	Запрос.Текст = Запрос.Текст
		+ "
		  |;
		  |
		  |////////////////////////////////////////////////////////////////////////////////
		  |";
	Запрос.Текст = Запрос.Текст
		+ "ВЫБРАТЬ
		  |	РеализацияТоваровУслугУслуги.Номенклатура.КодМДМ КАК НоменклатураКодМДМ,
		  |	РеализацияТоваровУслугУслуги.Количество,
		  |	РеализацияТоваровУслугУслуги.СтавкаНДС,
		  |	ВЫБОР
		  |		КОГДА РеализацияТоваровУслугУслуги.Ссылка.СуммаВключаетНДС
		  |			ТОГДА РеализацияТоваровУслугУслуги.Сумма
		  |		ИНАЧЕ РеализацияТоваровУслугУслуги.Сумма + РеализацияТоваровУслугУслуги.СуммаНДС
		  |	КОНЕЦ КАК Сумма,
		  |	РеализацияТоваровУслугУслуги.СуммаНДС,
		  |	РеализацияТоваровУслугУслуги.Цена,
		  |	ВЫБОР
		  |		КОГДА РеализацияТоваровУслугУслуги.ЗаказПокупателя = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
		  |			ТОГДА """"
		  |		КОГДА РеализацияТоваровУслугУслуги.ЗаказПокупателя.IDСклада_СтороннийСклад = ЗНАЧЕНИЕ(Справочник.СторонниеСклады.ПустаяСсылка)
		  |			ТОГДА """"
		  |		ИНАЧЕ ""ПродажаСоСторСклада""
		  |	КОНЕЦ КАК НаправлениеДеятельности,
		  |	РеализацияТоваровУслугУслуги.НомерСтроки КАК НомерСтроки,
		  |	РеализацияТоваровУслугУслуги.ЗаказПокупателя.ТипЦен.КодМДМ КАК ТипЦенКодМДМ
		  |ИЗ
		  |	Документ.РеализацияТоваровУслуг.Услуги КАК РеализацияТоваровУслугУслуги
		  |ГДЕ
		  |	РеализацияТоваровУслугУслуги.Ссылка = &Ссылка";  
		
	ТекРезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ТекРезультатЗапроса = ТекРезультатыЗапроса[0];
	
	Выб = ТекРезультатЗапроса.Выбрать();
	//-Бычков О. 28.11.2025 #UT10-5543
	
	Пока Выб.Следующий() Цикл                     
		
		ТоварыСтруктура = Новый Структура;
		
		ТоварыСтруктура.Вставить("НомерСтроки", Выб.НомерСтроки);
		ТоварыСтруктура.Вставить("КодМДМНоменклатуры", Выб.НоменклатураКодМДМ);
		ТоварыСтруктура.Вставить("Количество", Выб.Количество);
		ТоварыСтруктура.Вставить("КодМДМЕдиницыИзмерения", Выб.КодМДМЕдиницыИзмерения);
		ТоварыСтруктура.Вставить("Цена", Выб.Цена);
		ТоварыСтруктура.Вставить("Сумма", Выб.Сумма);
		ТоварыСтруктура.Вставить("НомерГТД", СокрЛП(Выб.НомерГТД));
		ТоварыСтруктура.Вставить("КодЗаказаГУИД", Строка(Выб.ЗаказПокупателя.УникальныйИдентификатор()));
		ТоварыСтруктура.Вставить("КодМДМСтранаПроисхождения", ?(ЗначениеЗаполнено(Выб.КодМДМСтранаПроисхождения), СокрЛП(Выб.КодМДМСтранаПроисхождения), ""));
		ТоварыСтруктура.Вставить("НаправлениеДеятельности", ?(ЗначениеЗаполнено(Выб.НаправлениеДеятельности), СокрЛП(Выб.НаправлениеДеятельности), "")); 	   
		//+Шульман А. 18.11.2024 #UT10-4903 
		ТоварыСтруктура.Вставить("ВидЦены", ?(ЗначениеЗаполнено(Выб.ТипЦенКодМДМ), СокрЛП(Выб.ТипЦенКодМДМ), ""));
		//-Шульман А. 18.11.2024 #UT10-4903 
		
		Если Документ.Организация = Константы.ОсновнаяОрганизацияДляОплатыНаличнымиДляВодителей.Получить() Тогда
			
			ТоварыСтруктура.Вставить("СуммаНДС", 0);		
			ТоварыСтруктура.Вставить("СтавкаНДС", 0);
					
		Иначе
			
			ТоварыСтруктура.Вставить("СуммаНДС", Выб.СуммаНДС);		
			ТоварыСтруктура.Вставить("СтавкаНДС", УчетНДС.ПолучитьСтавкуНДС(Выб.СтавкаНДС));
		
		КонецЕсли;
		
		ТоварыСтруктура.Вставить("ИнвентарныйНомер", "");
		ТоварыСтруктура.Вставить("Артикул", "");
		ТоварыСтруктура.Вставить("НаименованиеПроизводителя", "");
		ТоварыСтруктура.Вставить("НазваниеЕдиницыИзмерения", "");
		ТоварыСтруктура.Вставить("СерияНоменклатуры", Выб.СерияНоменклатуры);
		
		Товары.Добавить(ТоварыСтруктура);   		
		
	КонецЦикла;  
	
	СтруктураДокумента.Вставить("Товары", Товары);
	
	//+Бычков О. 01.12.2025 #UT10-5543
	// Вставка
	ТекРезультатЗапроса = ТекРезультатыЗапроса[1];
	
	Выб = ТекРезультатЗапроса.Выбрать();
	
	Услуги = Новый Массив;
	
	Пока Выб.Следующий() Цикл                     
		
		УслугиСтруктура = Новый Структура;
		
		УслугиСтруктура.Вставить("НомерСтроки", Выб.НомерСтроки);
		УслугиСтруктура.Вставить("КодМДМНоменклатуры", Выб.НоменклатураКодМДМ);
		УслугиСтруктура.Вставить("Количество", Выб.Количество);
		УслугиСтруктура.Вставить("Цена", Выб.Цена);
		УслугиСтруктура.Вставить("Сумма", Выб.Сумма);
		УслугиСтруктура.Вставить("НаправлениеДеятельности", ?(ЗначениеЗаполнено(Выб.НаправлениеДеятельности), СокрЛП(Выб.НаправлениеДеятельности), "")); 	   
		УслугиСтруктура.Вставить("ВидЦены", ?(ЗначениеЗаполнено(Выб.ТипЦенКодМДМ), СокрЛП(Выб.ТипЦенКодМДМ), ""));
		
		Если Документ.Организация = Константы.ОсновнаяОрганизацияДляОплатыНаличнымиДляВодителей.Получить() Тогда
			
			УслугиСтруктура.Вставить("СуммаНДС", 0);		
			УслугиСтруктура.Вставить("СтавкаНДС", 0);
					
		Иначе
			
			УслугиСтруктура.Вставить("СуммаНДС", Выб.СуммаНДС);		
			УслугиСтруктура.Вставить("СтавкаНДС", УчетНДС.ПолучитьСтавкуНДС(Выб.СтавкаНДС));
		
		КонецЕсли;
		
		УслугиСтруктура.Вставить("ИнвентарныйНомер", "");
		УслугиСтруктура.Вставить("Артикул", "");
		УслугиСтруктура.Вставить("НаименованиеПроизводителя", "");
		УслугиСтруктура.Вставить("НазваниеЕдиницыИзмерения", "");
		УслугиСтруктура.Вставить("СерияНоменклатуры", "");
		
		Услуги.Добавить(УслугиСтруктура);   		
		
	КонецЦикла;  
	
	СтруктураДокумента.Вставить("Услуги", Услуги);
	
	//-Бычков О. 01.12.2025 #UT10-5543
	
КонецПроцедуры                                

Процедура ЗаписатьРеализацияТоваровУслугКакПеремещениеТоваровМеждуСкладами(Документ , СтруктураДокумента , ПеречитатьРегистры) 	

	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "Организация", "КодМДМГоловнойОрганизации", "КодОрганизацииМДМ");
	
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "Контрагент", "КодМДМ", "КодКонтрагентаМДМ");
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "СуммаДокумента", "Сумма");     	
	СтруктураДокумента.Вставить("СуммаНДС", УчетНДС.ПолучитьНДСДокумента(Документ,"Товары"));
	
	Если ТипЗнч(Документ) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда

		//+Бычков О. 30.04.2025 #UT10-5208
		// Вставка
	    ТекКодМДМОрганизацииТОХ = "";
		
		//+Бычков О. 23.10.2025 #UT10-5480
		// Было
		//ТекЗапросТОХ = Новый Запрос;
		//
		//ТекЗапросТОХ.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		//                     |	МАКСИМУМ(РеализацияТоваровУслугТовары.ЗаказПокупателя.ДоговорПоставщикаТОХ) КАК ДоговорПоставщикаТОХ
		//                     |ИЗ
		//                     |	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
		//                     |ГДЕ
		//                     |	РеализацияТоваровУслугТовары.Ссылка = &Ссылка
		//                     |	И НЕ ЕСТЬNULL(РеализацияТоваровУслугТовары.ЗаказПокупателя.ДоговорПоставщикаТОХ, ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)";
		//
		//ТекЗапросТОХ.УстановитьПараметр("Ссылка", Документ.Ссылка);
		//
		//ТекРезультатЗапросаТОХ = ТекЗапросТОХ.Выполнить();
		//
		//Если Не ТекРезультатЗапросаТОХ.Пустой() Тогда
		//	
		//	ТекВыборка = ТекРезультатЗапросаТОХ.Выбрать();
		//	
		//	Если ТекВыборка.Следующий() Тогда
		//	
		//		Если ЗначениеЗаполнено(ТекВыборка.ДоговорПоставщикаТОХ) Тогда
		//			ТекКодМДМОрганизацииТОХ = Константы.КодМДМОрганизацииТОХ.Получить();
		//		КонецЕсли;
		//	
		//	КонецЕсли;
		//	
		//КонецЕсли;
		// Стало
		Если ЭтоРеализацияТоваровИУслугПоОрганизацииТОХ(Документ.Ссылка) Тогда
		    ТекКодМДМОрганизацииТОХ = Константы.КодМДМОрганизацииТОХ.Получить();
		КонецЕсли;
		//-Бычков О. 23.10.2025 #UT10-5480
		
		СтруктураДокумента.Вставить("КодМДМОрганизацииТОХ", ТекКодМДМОрганизацииТОХ);
		//-Бычков О. 30.04.2025 #UT10-5208
		
		СтруктураДокумента.Вставить("НомерДокументаУТ11", ВРег(Лев(СокрЛП(Константы.ПрефиксУзлаРаспределеннойИнформационнойБазы.Получить()), 2)) 
		+ "0" + Лев(Прав(СокрЛП(Документ.Номер), 6), 1) + "-Р" + Прав(СокрЛП(Документ.Номер), 5));
		
		ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "Склад", "КодМДМ", "КодСкладаМДМ");
		ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "Грузополучатель", "ТранзитныйСкладКодМДМ", "КодСкладаПолучателяМДМ");
		
	Иначе
		
		СтруктураДокумента.Вставить("НомерДокументаУТ11", ВРег(Лев(СокрЛП(Константы.ПрефиксУзлаРаспределеннойИнформационнойБазы.Получить()), 2))
		+ "0" + Лев(Прав(СокрЛП(Документ.Номер), 6), 1) + "-П" + Прав(СокрЛП(Документ.Номер), 5));
		
		ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "СкладОрдер", "КодМДМ", "КодСкладаПолучателяМДМ");
		ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "СкладОрдер", "ТранзитныйСкладКодМДМ", "КодСкладаМДМ");
		
	КонецЕсли;
	
	СтруктураДокумента.Вставить("КодСоглашения", СокрЛП(Документ.Грузополучатель.КодСоглашения));
	
	Валюта = Документ.ВалютаДокумента;    
	
	СтруктураДокумента.Вставить("Валюта", Валюта.КодМДМ);
	
	СтруктураДокумента.Вставить("ВозвратРекламационногоТовара", "");
	СтруктураДокумента.Вставить("СтатусСогласования", "");
	СтруктураДокумента.Вставить("ВозвратСтороннимСкладам", "");
	СтруктураДокумента.Вставить("Ответственный", СокрЛП(Документ.Ответственный));
	СтруктураДокумента.Вставить("ХозяйственнаяОперация", "ПеремещениеТоваров");
	СтруктураДокумента.Вставить("ДокументОснование", Неопределено);
	
	//+Макрушин Е. 22.07.2026 #UT10-5966
	тзКМ = Неопределено;
	//-Макрушин Е. 03.08.2026 #UT11-5966
	
	Если ТипЗнч(Документ) = Тип("ДокументОбъект.ПоступлениеТоваровУслуг") Тогда
		
		Если ЗначениеЗаполнено(Документ.КодМДМОрганизацииВСмежнойБазе) И Документ.КодМДМОрганизацииВСмежнойБазе <> СтруктураДокумента.КодОрганизацииМДМ Тогда
			СтруктураДокумента.КодОрганизацииМДМ = Документ.КодМДМОрганизацииВСмежнойБазе;	
		КонецЕсли;
		
	//+Макрушин Е. 22.07.2026 #UT10-5966	
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	РеализацияТоваровУслугКодыМаркировки.НомерСтроки КАК НомерСтроки,
		|	РеализацияТоваровУслугКодыМаркировки.КодМаркировки,
		|	РеализацияТоваровУслугКодыМаркировки.КодМаркировки.Номенклатура КАК Номенклатура,
		|	РеализацияТоваровУслугКодыМаркировки.КодМаркировки.СрокГодности КАК СрокГодности,
		|	РеализацияТоваровУслугКодыМаркировки.КодМаркировки.ДатаПроизводства КАК ДатаПроизводства,
		|	РеализацияТоваровУслугКодыМаркировки.КодМаркировки.ТипПоступления КАК ТипПоступления,
		|	РеализацияТоваровУслугКодыМаркировки.КодМаркировки.КодМаркировки КАК Код
		|ИЗ
		|	Документ.РеализацияТоваровУслуг.КодыМаркировки КАК РеализацияТоваровУслугКодыМаркировки
		|ГДЕ
		|	РеализацияТоваровУслугКодыМаркировки.Ссылка = &Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки
		|АВТОУПОРЯДОЧИВАНИЕ";
		
		Запрос.УстановитьПараметр("Ссылка", Документ.Ссылка);
		
		тзКМ = Запрос.Выполнить().Выгрузить();  
	//-Макрушин Е. 22.07.2026 #UT10-5966
		
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ОбъектМетаданных.Номенклатура.КодМДМ КАК НоменклатураКодМДМ,
	//+Макрушин Е. 22.07.2026 #UT10-5966
    |	ОбъектМетаданных.Номенклатура КАК Номенклатура,
	//-Макрушин Е. 22.07.2026 #UT10-5966
	|	ОбъектМетаданных.Количество,
	|	ОбъектМетаданных.СтавкаНДС,
	|	ОбъектМетаданных.Сумма,
	|	ОбъектМетаданных.СуммаНДС,
	|	ОбъектМетаданных.Цена,
	|	ОбъектМетаданных.СерияНоменклатуры.НомерГТД.Представление КАК НомерГТД,
	|	ОбъектМетаданных.НомерСтроки КАК НомерСтроки,
	|	ОбъектМетаданных.ЕдиницаИзмерения.КодМДМ КАК КодМДМЕдиницыИзмерения
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК ОбъектМетаданных
	|ГДЕ
	|	ОбъектМетаданных.Ссылка = &Ссылка";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.РеализацияТоваровУслуг", Документ.Метаданные().ПолноеИмя());
	
	Товары = Новый Массив;  
	
	Запрос = Новый Запрос(ТекстЗапроса);   
	
	Запрос.УстановитьПараметр("Ссылка", Документ.Ссылка); 
	
	Выб = Запрос.Выполнить().Выбрать(); 
	
	Пока Выб.Следующий() Цикл    
		
		ТоварыСтруктура = Новый Структура; 		
		ТоварыСтруктура.Вставить("НомерСтроки", Выб.НомерСтроки);
		ТоварыСтруктура.Вставить("КодМДМНоменклатуры", Выб.НоменклатураКодМДМ);
		ТоварыСтруктура.Вставить("Количество", Выб.Количество);
		ТоварыСтруктура.Вставить("КоличествоУпаковок", Выб.Количество);
		ТоварыСтруктура.Вставить("КодМДМЕдиницыИзмерения", Выб.КодМДМЕдиницыИзмерения);
		ТоварыСтруктура.Вставить("Цена", Выб.Цена);
		ТоварыСтруктура.Вставить("Сумма", Выб.Сумма);
		ТоварыСтруктура.Вставить("СуммаНДС", Выб.СуммаНДС);		
		ТоварыСтруктура.Вставить("СтавкаНДС", УчетНДС.ПолучитьСтавкуНДС(Выб.СтавкаНДС));
		ТоварыСтруктура.Вставить("НомерГТД", СокрЛП(Выб.НомерГТД));
		
		//+Макрушин Е. 22.07.2026 #UT10-5966
		мКодыМаркировки = Новый Массив;
		
		Если тзКМ <> Неопределено Тогда
			
			Для сч = 1 По Выб.Количество Цикл
				
				НайденнаяСтрокаПоКМ = тзКМ.Найти(Выб.Номенклатура, "Номенклатура");
				
				Если НайденнаяСтрокаПоКМ <> Неопределено Тогда
					
					КодыМаркировкиСтруктура = Новый Структура;
					КодыМаркировкиСтруктура.Вставить("Код", НайденнаяСтрокаПоКМ.Код);
					КодыМаркировкиСтруктура.Вставить("ДатаПроизводства", ?(ЗначениеЗаполнено(НайденнаяСтрокаПоКМ.ДатаПроизводства), Формат(НайденнаяСтрокаПоКМ.ДатаПроизводства, "ДФ=yyyy-MM-dd"), ""));
					КодыМаркировкиСтруктура.Вставить("СрокГодности", ?(ЗначениеЗаполнено(НайденнаяСтрокаПоКМ.СрокГодности), Формат(НайденнаяСтрокаПоКМ.СрокГодности, "ДФ=yyyy-MM-dd"), ""));
					КодыМаркировкиСтруктура.Вставить("ТипПоступления", НайденнаяСтрокаПоКМ.ТипПоступления);
					
					мКодыМаркировки.Добавить(КодыМаркировкиСтруктура);
					тзКМ.Удалить(НайденнаяСтрокаПоКМ);
					
				КонецЕсли;	
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если мКодыМаркировки.Количество() > 0 Тогда
			ТоварыСтруктура.Вставить("КодыМаркировки", мКодыМаркировки);
		КонецЕсли;
		//-Макрушин Е. 22.07.2026 #UT10-5966

		Товары.Добавить(ТоварыСтруктура);  
		
	КонецЦикла;  
	
	СтруктураДокумента.Вставить("Товары", Товары);   
	
КонецПроцедуры                                

Процедура ЗаписатьЗаявкаНаВозврат(Документ , СтруктураДокумента , ПеречитатьРегистры)

	СтруктураДокумента.Вставить("ВидДокумента", "ЗаявкаНаВозврат");
	СтруктураДокумента.Вставить("СтатусДокумента", СокрЛП(Документ.Статус));
	СтруктураДокумента.Вставить("РеализацияУникальныйИдентификатор", Строка(Документ.Реализация.УникальныйИдентификатор()));
	
	//+Сёмин Р.И. 17.03.2026 #UT10-5760
	Если ЗначениеЗаполнено(Документ.ЭлПочтаКлиента) Тогда
		
		ЭлПочтаКлиента = ?(ЗначениеЗаполнено(СтруктураДокумента.Комментарий), ". Эл. почта клиента: " + Документ.ЭлПочтаКлиента, "Эл. почта клиента: " + Документ.ЭлПочтаКлиента);
		СтруктураДокумента.Комментарий = СтруктураДокумента.Комментарий + ЭлПочтаКлиента;
		
	КонецЕсли;
	//-Сёмин Р.И. 17.03.2026 #UT10-5760
	
	Префикс = ПланыОбмена.ОбменУправлениеТорговлейУТ11.НайтиПоКоду("УТ").Префикс;
	ЧислоСимволов = 6;
	НовыйНомер = Прав(СокрЛП(Документ.Реализация.Номер), ЧислоСимволов);   
	
	Пока СтрДлина(НовыйНомер) < ЧислоСимволов Цикл   
		НовыйНомер = "0" + НовыйНомер;               
	КонецЦикла;     
	
	ВЧ = ?(Документ.Реализация.Организация.ИНН <> "7701302972", "УО-", "00-");
	РеализацияНомерДокумента = ?(Префикс = "", "00", Префикс) + ВЧ + НовыйНомер;
	СтруктураДокумента.Вставить("РеализацияНомерДокумента", РеализацияНомерДокумента);
	СтруктураДокумента.Вставить("РеализацияДатаДокумента", Формат(Документ.Реализация.Дата, "ДЛФ=DT"));
	
	Префикс = Лев(Документ.Реализация.Организация.Префикс,2);
	ЧислоСимволов = 6;
	НовыйНомер = Прав(СокрЛП(Документ.Номер), ЧислоСимволов);  
	
	Пока СтрДлина(НовыйНомер) < ЧислоСимволов Цикл     
		НовыйНомер = "0" + НовыйНомер;                 
	КонецЦикла;       
	
	НомерДокументаУТ11 = ?(Префикс = "", "00", Префикс) + "00-" + НовыйНомер;	
	СтруктураДокумента.Вставить("НомерДокументаУТ11", НомерДокументаУТ11);
	
	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	
	Товары = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаявкаНаВозвратТовары.Номенклатура КАК Номенклатура,
	|	ЗаявкаНаВозвратТовары.Номенклатура.КодМДМ КАК НоменклатураКодМДМ,
	|	ЗаявкаНаВозвратТовары.Номенклатура.КодПоБазеМоскоречье КАК КодПоБазеМоскоречье,
	|	ЗаявкаНаВозвратТовары.Количество,
	|	ЗаявкаНаВозвратТовары.Сумма,
	|	ЗаявкаНаВозвратТовары.Цена,
	|	ЗаявкаНаВозвратТовары.Статус,
	|	ЗаявкаНаВозвратТовары.Комментарий,
	|	ЗаявкаНаВозвратТовары.НомерСтрокиИзРТУ,
	|	ЗаявкаНаВозвратТовары.IDСклада_СтороннийСклад КАК СтороннийСклад,
	|	ЗаявкаНаВозвратТовары.ЕдиницаИзмерения.КодМДМ КАК КодМДМЕдиницыИзмерения,
	|	ЗаявкаНаВозвратТовары.НомерСтроки,
	|	ЗаявкаНаВозвратТовары.Тип
	|ИЗ
	|	Документ.ЗаявкаНаВозврат.Товары КАК ЗаявкаНаВозвратТовары
	|ГДЕ
	|	ЗаявкаНаВозвратТовары.Ссылка = &Ссылка";    
	
	Запрос.УстановитьПараметр("Ссылка", Документ.Ссылка);    
	
	Выб = Запрос.Выполнить().Выбрать();        
	
	Пока Выб.Следующий() Цикл             
		
		ТоварыСтруктура = Новый Структура;
		
		ТоварыСтруктура.Вставить("Номенклатура", Строка(Выб.Номенклатура));
		ТоварыСтруктура.Вставить("НоменклатураКодМДМ", Выб.НоменклатураКодМДМ);
		ТоварыСтруктура.Вставить("КодПоБазеМоскоречье", Выб.КодПоБазеМоскоречье);
		ТоварыСтруктура.Вставить("КодМДМЕдиницыИзмерения", Выб.КодМДМЕдиницыИзмерения);
		ТоварыСтруктура.Вставить("Количество", Выб.Количество);
		ТоварыСтруктура.Вставить("Цена", Выб.Цена);
		ТоварыСтруктура.Вставить("Сумма", Выб.Сумма);
		ТоварыСтруктура.Вставить("Статус", Выб.Статус);
		ТоварыСтруктура.Вставить("Комментарий", Выб.Комментарий);
		ТоварыСтруктура.Вставить("КодСторСклада", СокрЛП(Выб.СтороннийСклад.КодМДМ));

		Если ЗначениеЗаполнено(Выб.СтороннийСклад) Тогда       
			
			ТоварыСтруктура.Вставить("Рекламация", Ложь);
			ТоварыСтруктура.Вставить("Тип", "Возврат"); 
			
		Иначе                                                           
			
			ТоварыСтруктура.Вставить("Рекламация", Выб.Тип="Рекламация");			
			ТоварыСтруктура.Вставить("Тип", Выб.Тип);                    
			
		КонецЕсли;
		
		ТоварыСтруктура.Вставить("НомерСтрокиИзРТУ", Выб.НомерСтрокиИзРТУ);
		ТоварыСтруктура.Вставить("НомерСтроки", Выб.НомерСтроки);
		
		Товары.Добавить(ТоварыСтруктура);   		
		
	КонецЦикла; 
	
	СтруктураДокумента.Вставить("Товары", Товары);
	
	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	
	Файлы = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ХранилищеДополнительнойИнформации.Ссылка Как ФайлСсылка,
	|	ХранилищеДополнительнойИнформации.Наименование,
	|	ХранилищеДополнительнойИнформации.ПутьКФайлу,
	|	ХранилищеДополнительнойИнформации.ПометкаУдаления
	|ИЗ
	|	Справочник.ХранилищеДополнительнойИнформации КАК ХранилищеДополнительнойИнформации
	|ГДЕ
	|	ХранилищеДополнительнойИнформации.Объект = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Документ.Ссылка); 
	
	Выб = Запрос.Выполнить().Выбрать();               
	
	Пока Выб.Следующий() Цикл                        
		
		Если Не ЗначениеЗаполнено(Выб.ПутьКФайлу) Тогда
			Продолжить;
		КонецЕсли;
		
		ФайлыСтруктура = Новый Структура;
		
		ФайлыСтруктура.Вставить("ТомХраненияФайлов", СокрЛП(Константы.ТомХраненияФайлов.Получить()));
		ФайлыСтруктура.Вставить("Наименование", СокрЛП(Выб.Наименование));
		ФайлыСтруктура.Вставить("ПутьКФайлу", СокрЛП(Выб.ПутьКФайлу));
		ФайлыСтруктура.Вставить("ФайлУникальныйИдентификатор", Строка(Выб.ФайлСсылка.УникальныйИдентификатор()));
		ФайлыСтруктура.Вставить("ПометкаУдаления", Выб.ПометкаУдаления);
		
		Файлы.Добавить(ФайлыСтруктура);   		
		
	КонецЦикла;
	
	СтруктураДокумента.Вставить("Файлы", Файлы);

КонецПроцедуры                                

Процедура ЗаписатьКорректировкаПоступленияТоваровУслугРаббит(Документ, СтруктураДокумента, ТЗТовары)

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(КорректировкаПоступления.Организация.КодМДМГоловнойОрганизации, """") КАК КодОрганизацииМДМ,
	|	ЕСТЬNULL(КорректировкаПоступления.Контрагент.КодМДМ, """") КАК КодКонтрагентаМДМ,
	|	ЕСТЬNULL(КорректировкаПоступления.Контрагент.КодМДМПартнера, """") КАК КодПартнераМДМ,
	|	ЕСТЬNULL(КорректировкаПоступления.ДоговорКонтрагента.КодМДМ, """") КАК КодДоговораМДМ,
	|	ЕСТЬNULL(Склады.КодМДМ, """") КАК КодСкладаМДМ,
	//+Бычков О. 23.04.2025 #UT10-5207
	// Вставка
	|	ЕСТЬNULL(Склады.ТранзитныйСкладКодМДМ, """") КАК КодСкладаОтправителяМДМ,
	|КорректировкаПоступления.Ссылка В
	|	(ВЫБРАТЬ ПЕРВЫЕ 1
	|		КорректировкаПоступленияТовары.Ссылка
	|	ИЗ
	|		Документ.КорректировкаПоступления.Товары КАК КорректировкаПоступленияТовары
	|	ГДЕ
	|		КорректировкаПоступленияТовары.Ссылка = &Ссылка
	|		И КорректировкаПоступленияТовары.Количество < КорректировкаПоступленияТовары.КоличествоДоИзменения) КАК НуженСкладПолучатель,
	//-Бычков О. 23.04.2025 #UT10-5207
	|	ЕСТЬNULL(КорректировкаПоступления.ВалютаДокумента.КодМДМ, """") КАК Валюта,
	|	КорректировкаПоступления.ДокументПоступления,
	//+Бычков О. 06.08.2026 #UT10-5997
	// Вставка
	|	КорректировкаПоступления.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
	|	КорректировкаПоступления.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
	//-Бычков О. 06.08.2026 #UT10-5997
	|	0 КАК Сумма,
	|	0 КАК СуммаНДС,
	|	"""" КАК КодСоглашенияАварда,
	|	"""" КАК КоличествоКорректировок,
	|	"""" КАК НомерКорректировки,
	|	"""" КАК КодОснованияГУИД,
	|	"""" КАК НомерОснования,
	|	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаОснования,
	|	"""" КАК ВидДокументаОснования,
	|	"""" КАК РодительДокументаОснования,
	|	"""" КАК КодОрганизацииИС,
	|	"""" КАК КодКонтрагентаИС,
	|	"""" КАК КодПартнераИС,
	|	"""" КАК КодДоговораИС,
	|	"""" КАК КодСкладаИС,
	|	"""" КАК ВалютаЦифровойКод,
	|	"""" КАК ВалютаБуквенныйКод,
	|	КорректировкаПоступления.СуммаВключаетНДС КАК ЦенаВключаетНДС,
	|	""ПродажаОблагаетсяНДС"" КАК НалогообложениеНДС,
	|	ВЫБОР
	|		КОГДА КорректировкаПоступления.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки)
	|			ТОГДА ""ИсправлениеОшибок""
	|		ИНАЧЕ ""КорректировкаПоСогласованиюСторон""
	|	КОНЕЦ КАК ХозяйственнаяОперация
	|ИЗ
	|	Документ.КорректировкаПоступления КАК КорректировкаПоступления
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Склады КАК Склады
	|		ПО КорректировкаПоступления.СкладОрдер = Склады.Ссылка
	|ГДЕ
	|	КорректировкаПоступления.Ссылка = &Ссылка";
	
	СтруктураДокумента.Вставить("ПометкаУдаления", Документ.ПометкаУдаления);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", Документ.Ссылка);  
	
	Выборка = Запрос.Выполнить().Выбрать();       
	
	Выборка.Следующий();
	
	//+Бычков О. 24.04.2025 #UT10-5207
	// Вставка
	ТекВыгружаемВПеремещение = КорректировкаПоступленияТоваровУслугДолжнаВыгружатьсяКакПеремещениеТоваровМеждуСкладами(Документ.Ссылка);
	//-Бычков О. 24.04.2025 #UT10-5207
	
	Для Каждого Колонка Из Выборка.Владелец().Колонки Цикл 
		
		//+Бычков О. 23.04.2025 #UT10-5207
		// Было
		//Если Колонка.Имя <> "ДокументПоступления" Тогда
		// Стало
		Если Колонка.Имя <> "ДокументПоступления"
			И Колонка.Имя <> "НуженСкладПолучатель"
			Тогда
		//-Бычков О. 23.04.2025 #UT10-5207
			
			Значение = Выборка[Колонка.Имя];  
			
			Если ТипЗнч(Значение) = Тип("Дата") Тогда 
				Значение = Формат(Значение, "ДЛФ=DT");
			КонецЕсли;
			
			//+Бычков О. 24.04.2025 #UT10-5207
			// Было
			//СтруктураДокумента.Вставить(Колонка.Имя, Значение);
			// Стало
			ТекИмяПоля = Колонка.Имя;
			
			Если ТекИмяПоля = "КодСкладаОтправителяМДМ" Тогда
				
				Если Не ТекВыгружаемВПеремещение Тогда
					Продолжить;
				КонецЕсли;
				
				Если Выборка.НуженСкладПолучатель Тогда
					ТекИмяПоля = "КодСкладаПолучателяМДМ";
				КонецЕсли;
			
			КонецЕсли;
			
			СтруктураДокумента.Вставить(ТекИмяПоля, Значение);
			//-Бычков О. 24.04.2025 #UT10-5207
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Выборка.ДокументПоступления) Тогда     
		
		Данные = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Выборка.ДокументПоступления, "Номер, Дата");
		
		СтруктураДокумента.Вставить("КодОснованияГУИД", Строка(Выборка.ДокументПоступления.УникальныйИдентификатор()));
		СтруктураДокумента.Вставить("НомерОснования", Данные.Номер);
		СтруктураДокумента.Вставить("ДатаОснования", Формат(Данные.Дата, "ДЛФ=DT"));
		СтруктураДокумента.Вставить("ВидДокументаОснования", Выборка.ДокументПоступления.Метаданные().Имя);
		
		ДокументПоступления = Выборка.ДокументПоступления;   
		
		Пока ТипЗнч(ДокументПоступления) = Тип("ДокументСсылка.КорректировкаПоступления") Цикл    
			ДокументПоступления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументПоступления, "ДокументПоступления");
		КонецЦикла;
		
		Если ТипЗнч(ДокументПоступления) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда   
			
			СтруктураДокумента.Вставить("РодительДокументаОснования", Строка(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументПоступления, "ИДДокументаВСмежнойБазе")));
			
		КонецЕсли;
		
	КонецЕсли;
	
	//Взят за основу такой же кусок кода из корректировки реализации
	ДокументПоступления = Неопределено;
	УровеньВложенностиПоступления = 0;

	Если ТипЗнч(Выборка.ДокументПоступления) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		ДокументПоступления = Выборка.ДокументПоступления;	      		
	ИначеЕсли ТипЗнч(Выборка.ДокументПоступления) = Тип("ДокументСсылка.КорректировкаПоступления") Тогда
		
		УровеньВложенностиПоступления = 1;
		Ист = Выборка.ДокументПоступления;    
		
		Пока ТипЗнч(Ист) = Тип("ДокументСсылка.КорректировкаПоступления") Цикл 
			
			УровеньВложенностиПоступления = УровеньВложенностиПоступления + 1;
			Ист = Ист.ДокументПоступления;     
			
		КонецЦикла;
		
		Если ТипЗнч(Ист) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда   	
			ДокументПоступления = Ист;    
		КонецЕсли;                                                               
		
	КонецЕсли;
	
	//+Бычков О. 06.05.2025 #UT10-5208
	// Вставка
	Если Не ТекВыгружаемВПеремещение Тогда
		
		ТекОформлениеСделкиТОХ = ЭтоОформлениеСделкиТОХ(ДокументПоступления);
		
		СтруктураДокумента.Вставить("ОформлениеСделкиТОХ", ТекОформлениеСделкиТОХ);
		
	КонецЕсли;
	//-Бычков О. 06.05.2025 #UT10-5208
	
	Если ЗначениеЗаполнено(ДокументПоступления) Тогда   
		
		СтруктураДокумента.Вставить("КодПоступленияГУИД", Строка(ДокументПоступления.УникальныйИдентификатор()));
		СтруктураДокумента.Вставить("НомерПоступления", ДокументПоступления.Номер); 
		СтруктураДокумента.Вставить("ДатаПоступления", Формат(ДокументПоступления.Дата, "ДЛФ=DT"));  
		СтруктураДокумента.Вставить("УровеньВложенностиПоступления", УровеньВложенностиПоступления);  
		
	Иначе                                                   
		
		СтруктураДокумента.Вставить("КодПоступленияГУИД", "");
		СтруктураДокумента.Вставить("НомерПоступления", ""); 
		СтруктураДокумента.Вставить("ДатаПоступления", ""); 
		СтруктураДокумента.Вставить("УровеньВложенностиПоступления", 0);
		
	КонецЕсли;
	
	Товары = Новый Массив;   
	
	ЗапросТоваровПоДокументу = Новый Запрос; 
	ЗапросТоваровПоДокументу.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КорректировкаПоступленияТовары.Номенклатура
	|ПОМЕСТИТЬ ОткорретированныеТовары
	|ИЗ
	|	Документ.КорректировкаПоступления.Товары КАК КорректировкаПоступленияТовары
	|ГДЕ
	|	КорректировкаПоступленияТовары.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КорректировкаПоступленияТовары.Номенклатура,         
	|	КорректировкаПоступленияТовары.СерияНоменклатуры.НомерГТД.Код КАК НомерГТД,
	|	КорректировкаПоступленияТовары.СерияНоменклатуры.СтранаПроисхождения.КодМДМ КАК КодМДМСтранаПроисхождения,
	|	СУММА(КорректировкаПоступленияТовары.Количество) КАК Количество,
	|	СУММА(КорректировкаПоступленияТовары.Сумма) КАК Сумма,
	|	СУММА(КорректировкаПоступленияТовары.СуммаНДС) КАК СуммаНДС,
	|	СУММА(КорректировкаПоступленияТовары.КоличествоДоИзменения) КАК КоличествоДоИзменения,
	|	СУММА(КорректировкаПоступленияТовары.СуммаДоИзменения) КАК СуммаДоИзменения,
	|	МАКСИМУМ(КорректировкаПоступленияТовары.ЕдиницаИзмерения) КАК ЕдиницаИзмерения,
	|	СУММА(КорректировкаПоступленияТовары.СуммаНДСДоИзменения) КАК СуммаНДСДоИзменения,
	|	КорректировкаПоступленияТовары.СтавкаНДС
	|ПОМЕСТИТЬ ТаблицаДокумента
	|ИЗ
	|	Документ.КорректировкаПоступления.Товары КАК КорректировкаПоступленияТовары
	|ГДЕ
	|	КорректировкаПоступленияТовары.Ссылка = &Ссылка
	|	И КорректировкаПоступленияТовары.Номенклатура В
	|			(ВЫБРАТЬ
	|				ОткорретированныеТовары.Номенклатура
	|			ИЗ
	|				ОткорретированныеТовары КАК ОткорретированныеТовары)
	|
	|СГРУППИРОВАТЬ ПО
	|	КорректировкаПоступленияТовары.Номенклатура,
	|	КорректировкаПоступленияТовары.СерияНоменклатуры.НомерГТД.Код,
	|	КорректировкаПоступленияТовары.СерияНоменклатуры.СтранаПроисхождения.КодМДМ, 
	|	КорректировкаПоступленияТовары.СтавкаНДС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаДокумента.Номенклатура,
	|	ТаблицаДокумента.Номенклатура.КодМДМ КАК НоменклатураКодМДМ,
	|	ТаблицаДокумента.ЕдиницаИзмерения.КодМДМ КАК КодМДМЕдиницыИзмерения,  
	|	ТаблицаДокумента.НомерГТД КАК НомерГТД,
	|	ТаблицаДокумента.КодМДМСтранаПроисхождения КАК КодМДМСтранаПроисхождения,
	|	ТаблицаДокумента.Количество,
	|	ВЫБОР
	|		КОГДА ТаблицаДокумента.Количество = 0
	|			ТОГДА 0
	|		ИНАЧЕ ВЫРАЗИТЬ(ТаблицаДокумента.Сумма / ТаблицаДокумента.Количество КАК ЧИСЛО(15, 2))
	|	КОНЕЦ КАК Цена,
	|	ТаблицаДокумента.Сумма,
	|	ТаблицаДокумента.СуммаНДС,
	|	ТаблицаДокумента.КоличествоДоИзменения,
	|	ВЫБОР
	|		КОГДА ТаблицаДокумента.КоличествоДоИзменения = 0
	|			ТОГДА 0
	|		ИНАЧЕ ВЫРАЗИТЬ(ТаблицаДокумента.СуммаДоИзменения / ТаблицаДокумента.КоличествоДоИзменения КАК ЧИСЛО(15, 2))
	|	КОНЕЦ КАК ЦенаДоИзменения,
	|	ТаблицаДокумента.СуммаДоИзменения,
	|	ТаблицаДокумента.СуммаНДСДоИзменения,
	|	ТаблицаДокумента.СтавкаНДС
	|ИЗ
	|	ТаблицаДокумента КАК ТаблицаДокумента";                           
	
	ЗапросТоваровПоДокументу.УстановитьПараметр("Ссылка",Документ.Ссылка);
	
	РезультатЗапросаТоваров = ЗапросТоваровПоДокументу.Выполнить(); 
	
	Если НЕ РезультатЗапросаТоваров.Пустой() Тогда  
		
		Выб = РезультатЗапросаТоваров.Выбрать();
		
		ПромНомСтроки = 1;
		Сумма = 0;
		СуммаНДС = 0;   
		
		Пока Выб.Следующий() Цикл 
			
			Сумма = Сумма + Выб.Сумма - Выб.СуммаДоИзменения;
			СуммаНДС = СуммаНДС + Выб.СуммаНДС - Выб.СуммаНДСДоИзменения;     
			
			ТоварыСтруктура = Новый Структура; 			
			ТоварыСтруктура.Вставить("НомерСтроки", ПромНомСтроки);
			ТоварыСтруктура.Вставить("КодМДМНоменклатуры", Выб.НоменклатураКодМДМ);
			ТоварыСтруктура.Вставить("КодМДМЕдиницыИзмерения", Выб.КодМДМЕдиницыИзмерения);  
			ТоварыСтруктура.Вставить("НомерГТД", ?(ЗначениеЗаполнено(Выб.НомерГТД), СОКРЛП(Выб.НомерГТД), ""));
			ТоварыСтруктура.Вставить("КодМДМСтранаПроисхождения", ?(ЗначениеЗаполнено(Выб.КодМДМСтранаПроисхождения), СОКРЛП(Выб.КодМДМСтранаПроисхождения), ""));
			ТоварыСтруктура.Вставить("Количество", Выб.Количество);
			ТоварыСтруктура.Вставить("Цена", Выб.Цена);
			ТоварыСтруктура.Вставить("Сумма", Выб.Сумма);
			ТоварыСтруктура.Вставить("СуммаНДС", ?(ЗначениеЗаполнено(Выб.СуммаНДС), Выб.СуммаНДС, 0)); 
			ТоварыСтруктура.Вставить("КоличествоДоИзменения", Выб.КоличествоДоИзменения);
			ТоварыСтруктура.Вставить("ЦенаДоИзменения", Выб.ЦенаДоИзменения); 
			ТоварыСтруктура.Вставить("СуммаДоИзменения", Выб.СуммаДоИзменения);
			ТоварыСтруктура.Вставить("СуммаНДСДоИзменения", ?(ЗначениеЗаполнено(Выб.СуммаНДСДоИзменения), Выб.СуммаНДСДоИзменения, 0)); 
			
			ТоварыСтруктура.Вставить("ИнвентарныйНомер","");
			ТоварыСтруктура.Вставить("Артикул","");
			ТоварыСтруктура.Вставить("НаименованиеПроизводителя","");
			ТоварыСтруктура.Вставить("НазваниеЕдиницыИзмерения","");			
			ТоварыСтруктура.Вставить("СтавкаНДС", УчетНДС.ПолучитьСтавкуНДС(Выб.СтавкаНДС)); 

			ТоварыСтруктура.Вставить("ПодразделениеКодМДМ", "");
			ТоварыСтруктура.Вставить("СписатьНаРасходы", Ложь);
			ТоварыСтруктура.Вставить("СтатьяРасходов", Неопределено);
			ТоварыСтруктура.Вставить("АналитикаРасходов", Неопределено);
			ТоварыСтруктура.Вставить("Содержание", "");
			
			Товары.Добавить(ТоварыСтруктура); 
			ПромНомСтроки = ПромНомСтроки+1;  
			
		КонецЦикла;    
		
		СтруктураДокумента.Вставить("Сумма", Сумма);
		СтруктураДокумента.Вставить("СуммаНДС", СуммаНДС);  		
		СтруктураДокумента.Вставить("Товары", Товары);        
		
	КонецЕсли;	                                
	
КонецПроцедуры  

Процедура ЗаписатьПлатежноеПоручениеВходящее(Документ, СтруктураДокумента) Экспорт

	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "Организация", "КодМДМГоловнойОрганизации", "КодОрганизацииМДМ");  
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "Контрагент", "КодМДМ", "КодКонтрагентаМДМ");	
	
	КодДоговора = "";     
	
	Если Документ.РасшифровкаПлатежа.Количество() > 0 Тогда	
		
		Для Каждого СтрРасшифровки Из Документ.РасшифровкаПлатежа Цикл 
			
			ТекДоговор = СтрРасшифровки.ДоговорКонтрагента; 
			
			Если ЗначениеЗаполнено(ТекДоговор) И ЗначениеЗаполнено(ТекДоговор.КодМДМ) Тогда  
				
				КодДоговора = ТекДоговор.КодМДМ;
				Прервать;   
				
			КонецЕсли;	
			
		КонецЦикла;	
		
	КонецЕсли;
	
	СтруктураДокумента.Вставить("КодДоговораМДМ", 		СокрЛП(КодДоговора));
	СтруктураДокумента.Вставить("Сумма", 				Документ.СуммаДокумента);	
	СтруктураДокумента.Вставить("Валюта", 				?(ЗначениеЗаполнено(Документ.ВалютаДокумента), Документ.ВалютаДокумента.КодМДМ, ""));
	СтруктураДокумента.Вставить("БанковскийНомер", 		Документ.НомерВходящегоДокумента);
	СтруктураДокумента.Вставить("ДатаБанковскогоДокумента", Формат(Документ.ДатаВходящегоДокумента, "ДФ=dd.MM.yyyy"));	
	СтруктураДокумента.Вставить("НазначениеПлатежа", 	СокрЛП(Документ.НазначениеПлатежа));
	СтруктураДокумента.Вставить("УИП", 				    "");

КонецПроцедуры

Процедура ЗаписатьУстановкуЦенНоменклатуры(Документ, СтруктураДокумента)
	
	СтруктураДокумента.Вставить("АвторWebadmin", СокрЛП(Документ.Ответственный.Код)  = "webadmin");

	ТипыЦен = Новый Массив;
	Товары  = Новый Массив;    	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УстановкаЦенНоменклатурыТипыЦен.ТипЦен.Наименование КАК ТипЦенНаименование,
	|	УстановкаЦенНоменклатурыТипыЦен.ТипЦен.КодМДМ КАК ТипЦенКодМДМ
	|ИЗ
	|	Документ.УстановкаЦенНоменклатуры.ТипыЦен КАК УстановкаЦенНоменклатурыТипыЦен
	|ГДЕ
	|	УстановкаЦенНоменклатурыТипыЦен.Ссылка = &Ссылка
	|	И НЕ УстановкаЦенНоменклатурыТипыЦен.ТипЦен.КодМДМ = """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УстановкаЦенНоменклатурыТовары.ТипЦен.КодМДМ КАК ТипЦенКодМДМ,
	|	УстановкаЦенНоменклатурыТовары.Номенклатура.КодМДМ КАК НоменклатураКодМДМ,
	|	УстановкаЦенНоменклатурыТовары.Цена КАК Цена,
	|	УстановкаЦенНоменклатурыТовары.ИндексСтрокиТаблицыЦен
	|ИЗ
	|	Документ.УстановкаЦенНоменклатуры.Товары КАК УстановкаЦенНоменклатурыТовары
	|ГДЕ
	|	УстановкаЦенНоменклатурыТовары.Ссылка = &Ссылка
	|	И НЕ УстановкаЦенНоменклатурыТовары.Номенклатура.КодМДМ = """"
	|	И НЕ УстановкаЦенНоменклатурыТовары.ТипЦен.КодМДМ = """""; 
	
	Запрос.УстановитьПараметр("Ссылка",Документ.Ссылка); 
	
	ПакетЗапросаУстановкаЦен = Запрос.ВыполнитьПакет();
	
	ПакетТипыЦен = ПакетЗапросаУстановкаЦен[0].Выгрузить();
	ПакетТовары  = ПакетЗапросаУстановкаЦен[1].Выгрузить();
	
	Для Каждого СтрокаПакетаТипЦен Из ПакетТипыЦен Цикл
		
		ТипыЦенСтруктура = Новый Структура;
		
		ТипыЦенСтруктура.Вставить("ТипЦенНаименование", СтрокаПакетаТипЦен.ТипЦенНаименование);
		ТипыЦенСтруктура.Вставить("ТипЦенКодМДМ"      , СтрокаПакетаТипЦен.ТипЦенКодМДМ); 
		
		ТипыЦен.Добавить(ТипыЦенСтруктура);
		
	КонецЦикла;
	
	
	Для Каждого СтрокаПакетаТовары Из ПакетТовары Цикл  
		
		ТоварыСтруктура = Новый Структура;
		
		ТоварыСтруктура.Вставить("ТипЦенКодМДМ"       	  , СтрокаПакетаТовары.ТипЦенКодМДМ);
		ТоварыСтруктура.Вставить("НоменклатураКодМДМ" 	  , СтрокаПакетаТовары.НоменклатураКодМДМ);
		ТоварыСтруктура.Вставить("Цена"              	  , СтрокаПакетаТовары.Цена); 
		ТоварыСтруктура.Вставить("ИндексСтрокиТаблицыЦен" , СтрокаПакетаТовары.ИндексСтрокиТаблицыЦен);
		
		Товары.Добавить(ТоварыСтруктура);   		
		
	КонецЦикла;  
	
	СтруктураДокумента.Вставить("ТипыЦен", ТипыЦен);
	СтруктураДокумента.Вставить("Товары", Товары);
	
КонецПроцедуры

Процедура ЗаписатьУстановкуЦенНоменклатурыКонтрагента(Документ, СтруктураДокумента)
	
	ТипыЦен = Новый Массив;
	Товары  = Новый Массив;    	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УстановкаЦенНоменклатурыКонтрагентовТипыЦен.ТипЦен.Наименование КАК ТипЦенНаименование,
	|	УстановкаЦенНоменклатурыКонтрагентовТипыЦен.ТипЦен.КодМДМ КАК ТипЦенКодМДМ
	|ИЗ
	|	Документ.УстановкаЦенНоменклатурыКонтрагентов.ТипыЦен КАК УстановкаЦенНоменклатурыКонтрагентовТипыЦен
	|ГДЕ
	|	УстановкаЦенНоменклатурыКонтрагентовТипыЦен.Ссылка = &Ссылка
	|	И НЕ УстановкаЦенНоменклатурыКонтрагентовТипыЦен.ТипЦен.КодМДМ = """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УстановкаЦенНоменклатурыКонтрагентовТовары.ТипЦен.КодМДМ КАК ТипЦенКодМДМ,
	|	УстановкаЦенНоменклатурыКонтрагентовТовары.Номенклатура.КодМДМ КАК НоменклатураКодМДМ,
	|	УстановкаЦенНоменклатурыКонтрагентовТовары.Цена КАК Цена,
	|	УстановкаЦенНоменклатурыКонтрагентовТовары.ИндексСтрокиТаблицыЦен
	|ИЗ
	|	Документ.УстановкаЦенНоменклатурыКонтрагентов.Товары КАК УстановкаЦенНоменклатурыКонтрагентовТовары
	|ГДЕ
	|	УстановкаЦенНоменклатурыКонтрагентовТовары.Ссылка = &Ссылка
	|	И НЕ УстановкаЦенНоменклатурыКонтрагентовТовары.Номенклатура.КодМДМ = """"
	|	И НЕ УстановкаЦенНоменклатурыКонтрагентовТовары.ТипЦен.КодМДМ = """""; 
	
	Запрос.УстановитьПараметр("Ссылка", Документ.Ссылка); 
	
	ПакетЗапросаУстановкаЦен = Запрос.ВыполнитьПакет();
	
	ПакетТипыЦен = ПакетЗапросаУстановкаЦен[0].Выгрузить();
	ПакетТовары  = ПакетЗапросаУстановкаЦен[1].Выгрузить();
	
	Для Каждого СтрокаПакетаТипЦен Из ПакетТипыЦен Цикл
		
		ТипыЦенСтруктура = Новый Структура;
		
		ТипыЦенСтруктура.Вставить("ТипЦенНаименование", СтрокаПакетаТипЦен.ТипЦенНаименование);
		ТипыЦенСтруктура.Вставить("ТипЦенКодМДМ"      , СтрокаПакетаТипЦен.ТипЦенКодМДМ); 
		
		ТипыЦен.Добавить(ТипыЦенСтруктура);
		
	КонецЦикла;
	
	
	Для Каждого СтрокаПакетаТовары Из ПакетТовары Цикл  
		
		ТоварыСтруктура = Новый Структура;
		
		ТоварыСтруктура.Вставить("ТипЦенКодМДМ"       	  , СтрокаПакетаТовары.ТипЦенКодМДМ);
		ТоварыСтруктура.Вставить("НоменклатураКодМДМ" 	  , СтрокаПакетаТовары.НоменклатураКодМДМ);
		ТоварыСтруктура.Вставить("Цена"              	  , СтрокаПакетаТовары.Цена); 
		ТоварыСтруктура.Вставить("ИндексСтрокиТаблицыЦен" , СтрокаПакетаТовары.ИндексСтрокиТаблицыЦен);
		
		Товары.Добавить(ТоварыСтруктура);   		
		
	КонецЦикла;  
	
	СтруктураДокумента.Вставить("ТипыЦен", ТипыЦен);
	СтруктураДокумента.Вставить("Товары" , Товары);
	
КонецПроцедуры

Процедура ЗаписатьВыкупСОтветственногоХранения(Документ , СтруктураДокумента) 
	
	СтруктураДокумента.Вставить("ТипСодержимого"    , "application/json");
	СтруктураДокумента.Вставить("ВидДокумента"      , "ВыкупСОтветственногоХранения");
	СтруктураДокумента.Вставить("КодМДМФилиала"     , Константы.КодКонтрагентаВстороннейУТ10Пополнение.Получить());
	СтруктураДокумента.Вставить("КодМДМДоговораТОХ" , Документ.ДоговорКонтрагента.КодМДМ);
	СтруктураДокумента.Вставить("НазваниеБазы"      , СокрЛП(Константы.База.Получить()));
	СтруктураДокумента.Вставить("НачалоПериода"     , Строка(Документ.НачалоПериода));
	СтруктураДокумента.Вставить("КонецПериода"      , Строка(Документ.КонецПериода));
	
	//+Бычков О. 28.07.2026 #UT10-5970
	// Вставка
	Если СтруктураДокумента.Свойство("Статус") Тогда
		ТекСтатусПроведения = СтруктураДокумента.Статус;
	Иначе
		ТекСтатусПроведения = ?(Документ.Проведен, 1, 0);
	КонецЕсли;
	
	СтруктураДокумента.Вставить("СтатусПроведения", ТекСтатусПроведения);
	//-Бычков О. 28.07.2026 #UT10-5970
	
	СтруктураДокумента.Вставить("Статус"            , Число(Перечисления.СтатусыТОХ.Индекс(Документ.Статус)));
	
	//+Бычков О. 29.04.2025 #UT10-5208
	// Вставка
	ТекМассивТипов = МассивПоддерживаемыхТиповJSON();
	
	ТекДополнительныеПоляЗапросаТоваров = "";
	
	ТекПеремещениеТоваровМеждуСкладами = ВыкупСОтветственногоХраненияДолженВыгружатьсяКакПеремещениеТоваровМеждуСкладами(Документ.Ссылка);
	ТекВозвратТоваровПоставщику = ВыкупСОтветственногоХраненияДолженВыгружатьсяКакВозвратТоваровПоставщику(Документ.Ссылка);
	
	Если ТекПеремещениеТоваровМеждуСкладами Или ТекВозвратТоваровПоставщику Тогда
		
		ТекОформлениеСделкиТОХ = ЭтоОформлениеСделкиТОХ(Документ.Ссылка);
		
		СтруктураДокумента.Вставить("ОформлениеСделкиТОХ", ТекОформлениеСделкиТОХ);
		СтруктураДокумента.Вставить("СкладКодМДМ", Документ.Склад.КодМДМ);
		
		ТекОрганизацияКодМДМ = Константы.КодМДМОрганизацииТОХ.Получить();
		ТекЭтоМиниВыкупГП = Ложь;
		
		Если ТекПеремещениеТоваровМеждуСкладами Тогда
			
			ТекЭтоМиниВыкупИзБазыОП = ЭтоМиниВыкупИзБазыОП(Документ.Ссылка);
			
			Если ТекЭтоМиниВыкупИзБазыОП Тогда
				
			    ТекКодСкладаПолучателяМДМ = Константы.КодМДМОсновногоСкладаВБазеГП.Получить();
				ТекОрганизацияКодМДМ = Константы.КодМДМОрганизацииТОХ.Получить();
				
			Иначе
				
				ТекКодСкладаПолучателяМДМ = Документ.Филиал.СкладКодМДМ;
				//+Бычков О. 10.04.2026 #UT10-5819
				// Было
				//ТекОрганизацияКодМДМ = Документ.Организация.КодМДМ;
				// Стало
				ТекОрганизацияКодМДМ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ.Организация, "КодМДМГоловнойОрганизации");
				//-Бычков О. 10.04.2026 #UT10-5819
				ТекЭтоМиниВыкупГП = Истина;
				
			КонецЕсли;
			
			СтруктураДокумента.Вставить("КодСкладаПолучателяМДМ", ТекКодСкладаПолучателяМДМ);
			СтруктураДокумента.Вставить("ЭтоМиниВыкупГП", ТекЭтоМиниВыкупГП);
			
		КонецЕсли;
		
		Если ТекВозвратТоваровПоставщику Тогда
		
			СтруктураДокумента.Вставить("ПартнерКодМДМ", Документ.Контрагент.КодМДМПартнера);
			СтруктураДокумента.Вставить("КонтрагентКодМДМ", Документ.Контрагент.КодМДМ);
			СтруктураДокумента.Вставить("ДоговорКодМДМ", Документ.ДоговорКонтрагента.КодМДМ);
			СтруктураДокумента.Вставить("ВалютаКодМДМ", Документ.ВалютаДокумента.КодМДМ);
			СтруктураДокумента.Вставить("НалогообложениеНДС", "ПродажаНеОблагаетсяНДС");
			СтруктураДокумента.Вставить("Операция", "ВозвратТоваровПоставщику");
			СтруктураДокумента.Вставить("СпособКомпенсации", "ВернутьДенежныеСредства");
			СтруктураДокумента.Вставить("СуммаДокумента", 0);
			СтруктураДокумента.Вставить("ЦенаВключаетНДС", Истина);
			
			ТекДополнительныеПоляЗапросаТоваров = ",
			|	ВыкупСОтветственногоХраненияТовары.Цена,
			|	ВыкупСОтветственногоХраненияТовары.Сумма";
			
		КонецЕсли;
		
		СтруктураДокумента.Вставить("ОрганизацияКодМДМ", ТекОрганизацияКодМДМ);
		
	КонецЕсли;
	//-Бычков О. 29.04.2025 #UT10-5208
	
	Товары  = Новый Массив;  
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВыкупСОтветственногоХраненияТовары.Номенклатура.КодМДМ,
	|	ВыкупСОтветственногоХраненияТовары.СерияНоменклатуры,
	|	ЕСТЬNULL(ВыкупСОтветственногоХраненияТовары.СерияНоменклатуры.СтранаПроисхождения.Код, ""-- "") КАК СтранаПроисхожденияКод,
	|	ЕСТЬNULL(ВыкупСОтветственногоХраненияТовары.СерияНоменклатуры.СтранаПроисхождения.КодМДМ, """") КАК СтранаПроисхожденияКодМДМ,
	|	ЕСТЬNULL(ВыкупСОтветственногоХраненияТовары.СерияНоменклатуры.СтранаПроисхождения.Наименование, ""--"") КАК СтранаПроисхожденияНаименование,
	|	ВыкупСОтветственногоХраненияТовары.СерияНоменклатуры.НомерГТД.Представление КАК НомерГТД,
	//+Бычков О. 29.04.2025 #UT10-5208
	// Было
	//|	ВыкупСОтветственногоХраненияТовары.Количество
	// Стало
	|	ВыкупСОтветственногоХраненияТовары.Количество"
	+ ТекДополнительныеПоляЗапросаТоваров
	+ "
	//-Бычков О. 29.04.2025 #UT10-5208
	|ИЗ
	|	Документ.ВыкупСОтветственногоХранения.Товары КАК ВыкупСОтветственногоХраненияТовары
	|ГДЕ
	|	ВыкупСОтветственногоХраненияТовары.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Документ.Ссылка); 
	
	РезультатЗапроса = Запрос.Выполнить();     
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		ВыборкаЗапроса = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаЗапроса.Следующий() Цикл
			
			ТоварыСтруктура = Новый Структура;
			
			ТоварыСтруктура.Вставить("НоменклатураКодМДМ"     	 , ВыборкаЗапроса.НоменклатураКодМДМ);
			ТоварыСтруктура.Вставить("СтранаПроисхожденияКод" 	 , ВыборкаЗапроса.СтранаПроисхожденияКод);
			ТоварыСтруктура.Вставить("СтранаПроисхожденияКодМДМ" , ВыборкаЗапроса.СтранаПроисхожденияКодМДМ);
			ТоварыСтруктура.Вставить("СтранаПроисхождения"     	 , ВыборкаЗапроса.СтранаПроисхожденияНаименование);
			ТоварыСтруктура.Вставить("НомерГТД"     		 	 , ВыборкаЗапроса.НомерГТД);
			ТоварыСтруктура.Вставить("Количество"             	 , ВыборкаЗапроса.Количество); 

			//+Бычков О. 29.04.2025 #UT10-5208
			// Вставка
			Если ТекВозвратТоваровПоставщику Тогда                                             
				
				ТоварыСтруктура.Вставить("Цена", ВыборкаЗапроса.Цена); 
				ТоварыСтруктура.Вставить("Сумма", ВыборкаЗапроса.Сумма); 
				ТоварыСтруктура.Вставить("СуммаНДС", 0); 
				ТоварыСтруктура.Вставить("СуммаСНДС", ВыборкаЗапроса.Сумма);
				ТоварыСтруктура.Вставить("СтавкаНДС", ЗначениеJSON(Перечисления.СтавкиНДС.БезНДС, ТекМассивТипов));
				
				СтруктураДокумента.СуммаДокумента = СтруктураДокумента.СуммаДокумента + ВыборкаЗапроса.Сумма;
				
			КонецЕсли;
			//-Бычков О. 29.04.2025 #UT10-5208
			
			Товары.Добавить(ТоварыСтруктура); 
			
		КонецЦикла;
		
	КонецЕсли;

	СтруктураДокумента.Вставить("Товары"  , Товары);
	
КонецПроцедуры

Процедура ЗаписатьПоступлениеТоваровУслугРаббит(Документ, СтруктураДокумента, ТЗТовары)

	СтруктураДокумента.Вставить("ПометкаУдаления", Число(Документ.ПометкаУдаления));
	СтруктураДокумента.Вставить("КодОрганизацииМДМ", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ.Организация, "КодМДМГоловнойОрганизации"));
	СтруктураДокумента.Вставить("КодКонтрагентаМДМ", 	?(ЗначениеЗаполнено(Документ.Контрагент), Документ.Контрагент.КодМДМ, ""));	
	СтруктураДокумента.Вставить("КодПартнераМДМ", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ.Контрагент, "КодМДМПартнера"));		
	СтруктураДокумента.Вставить("КодДоговораМДМ", 		?(ЗначениеЗаполнено(Документ.ДоговорКонтрагента), Документ.ДоговорКонтрагента.КодМДМ, ""));
	
//+Бычков О. 06.05.2025 #UT10-5208
// Вставка
	ТекОформлениеСделкиТОХ = ЭтоОформлениеСделкиТОХ(Документ.Ссылка);
	
	СтруктураДокумента.Вставить("ОформлениеСделкиТОХ", ТекОформлениеСделкиТОХ);
//-Бычков О. 06.05.2025 #UT10-5208

	Если ТипЗнч(Документ.СкладОрдер) = Тип("СправочникСсылка.Склады") Тогда
		СтруктураДокумента.Вставить("КодСкладаМДМ", ?(ЗначениеЗаполнено(Документ.СкладОрдер), Документ.СкладОрдер.КодМДМ, ""));	
	Иначе
		СтруктураДокумента.Вставить("КодСкладаМДМ", "");	
	КонецЕсли;
	
	Сумма = Документ.Товары.Итог("Сумма");
	СуммаНДС = Документ.Товары.Итог("СуммаНДС");
	
	Если Не Документ.СуммаВключаетНДС Тогда
		Сумма = Сумма + СуммаНДС;
	КонецЕсли;
	
	СтруктураДокумента.Вставить("Сумма", 	Сумма);
	СтруктураДокумента.Вставить("СуммаНДС", СуммаНДС);
	СтруктураДокумента.Вставить("Валюта", 	?(ЗначениеЗаполнено(Документ.ВалютаДокумента),Документ.ВалютаДокумента.КодМДМ, ""));
	
	КодСоглашенияАварда = "";	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДоговорыАварды.КодАварда
	|ИЗ
	|	РегистрСведений.ДоговорыАварды КАК ДоговорыАварды
	|ГДЕ
	|	ДоговорыАварды.ДоговорКонтрагента = &ДоговорКонтрагента";
	
	Запрос.УстановитьПараметр("ДоговорКонтрагента", Документ.ДоговорКонтрагента);
	
	Выборка = Запрос.Выполнить().Выбрать();	 
	
	Пока Выборка.Следующий() Цикл       
		КодСоглашенияАварда = КодСоглашенияАварда + ?(ЗначениеЗаполнено(КодСоглашенияАварда), ",", "") + СтрЗаменить(Строка(Выборка.КодАварда), " ", "");
	КонецЦикла;
	
	
	СтруктураДокумента.Вставить("КодСоглашенияАварда", 	КодСоглашенияАварда); 
	
	//+Шульман А. 09.01.2025 #UT10-5019  
	СтруктураДокумента.Вставить("КодСоглашенияМДМ", ""); 
	СтруктураДокумента.Вставить("ПополнениеЗапасов", Документ.ПополнениеЗапасов);
	//-Шульман А. 09.01.2025 #UT10-5019
	
	СтруктураДокумента.Вставить("ОбратноеПоступление",	0);
	СтруктураДокумента.Вставить("КоличествоКорректировок", 0);
	СтруктураДокумента.Вставить("НалогообложениеНДС", "ПродажаОблагаетсяНДС");
	СтруктураДокумента.Вставить("КодОрганизацииИС", "");
	СтруктураДокумента.Вставить("КодКонтрагентаИС", "");
	СтруктураДокумента.Вставить("КодПартнераИС", "");
	СтруктураДокумента.Вставить("КодДоговораИС", "");
	СтруктураДокумента.Вставить("КодСкладаИС", "");
	СтруктураДокумента.Вставить("ВалютаЦифровойКод", "");
	СтруктураДокумента.Вставить("ВалютаБуквенныйКод", "");
	СтруктураДокумента.Вставить("НомерВходящегоДокумента", Документ.НомерВходящегоДокумента);
	СтруктураДокумента.Вставить("ДатаВходящегоДокумента", Строка(Документ.ДатаВходящегоДокумента));
	СтруктураДокумента.Вставить("ДатаПоступления", Строка(Документ.Дата));
	СтруктураДокумента.Вставить("ФактическаяДатаПоступления", Строка(Документ.ДатаПриходаТовараНаСклад));
	СтруктураДокумента.Вставить("ТоварПоступил", ЗначениеЗаполнено(Документ.ДатаПриходаТовараНаСклад));
	СтруктураДокумента.Вставить("Предварительный", Ложь);
	
	//+Бычков О. 19.06.2025 #UT10-5297
	// Было
	//Если ЗначениеЗаполнено(Документ.КодМДМОрганизацииВСмежнойБазе) И Документ.КодМДМОрганизацииВСмежнойБазе <> СтруктураДокумента.КодОрганизацииМДМ Тогда
	//	СтруктураДокумента.КодОрганизацииМДМ = Документ.КодМДМОрганизацииВСмежнойБазе;	
	//КонецЕсли;
	// Стало
	//-Бычков О. 19.06.2025 #UT10-5297
	
	СтруктураДокумента.Вставить("УникальныйИдентификаторОснования", "");  
	СтруктураДокумента.Вставить("ДатаОснования", Дата(1, 1, 1));  
	СтруктураДокумента.Вставить("НомерОснования", "");  
	
	//+Бычков О. 09.06.2026 #UT10-5905
	// Вставка
	ТекСтатусПриемки = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗначенияСвойствОбъектов.Значение
	|ИЗ
	|	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	|ГДЕ
	|	ЗначенияСвойствОбъектов.Свойство.Наименование = &Наименование
	|	И ЗначенияСвойствОбъектов.Объект = &Объект
	|	И ЗначенияСвойствОбъектов.Значение = &Значение";

	Запрос.УстановитьПараметр("Значение", Перечисления.СтатусыПриемки.ВПути);
	Запрос.УстановитьПараметр("Наименование", "Статус приемки");
	Запрос.УстановитьПараметр("Объект", Документ.Ссылка);

	РезультатЗапроса = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ТекСтатусПриемки = ВыборкаДетальныеЗаписи.Значение;
	КонецЕсли;
	
	МассивТипов = МассивПоддерживаемыхТиповJSON();
	
	СтруктураДокумента.Вставить("СтатусПриемки", ЗначениеJSON(ТекСтатусПриемки, МассивТипов));
	//-Бычков О. 09.06.2026 #UT10-5905
	
	ТоварыМассив = Новый Массив;  
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПоступлениеТоваровУслугТовары.НомерСтроки КАК НомерСтроки,
	|	ПоступлениеТоваровУслугТовары.Номенклатура.КодМДМ КАК КодНоменклатурыМДМ,
	|	ПоступлениеТоваровУслугТовары.Количество,
	|	ПоступлениеТоваровУслугТовары.Цена,
	|	ВЫБОР
	|		КОГДА ПоступлениеТоваровУслугТовары.Ссылка.СуммаВключаетНДС
	|			ТОГДА ПоступлениеТоваровУслугТовары.Сумма
	|		ИНАЧЕ ПоступлениеТоваровУслугТовары.Сумма + ПоступлениеТоваровУслугТовары.СуммаНДС
	|	КОНЕЦ КАК Сумма,
	|	ПоступлениеТоваровУслугТовары.СтавкаНДС,
	|	ПоступлениеТоваровУслугТовары.СуммаНДС,
	|	ПоступлениеТоваровУслугТовары.ЕдиницаИзмерения.КодМДМ КАК КодМДМЕдиницыИзмерения,
	|	ПоступлениеТоваровУслугТовары.СерияНоменклатуры.НомерГТД.Код КАК НомерГТД,
	|	ПоступлениеТоваровУслугТовары.СерияНоменклатуры.СтранаПроисхождения.КодМДМ КАК КодМДМСтранаПроисхождения
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.Товары КАК ПоступлениеТоваровУслугТовары
	|ГДЕ
	|	ПоступлениеТоваровУслугТовары.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Запрос.УстановитьПараметр("Ссылка", Документ.Ссылка);
	
	Выб = Запрос.Выполнить().Выбрать();    
	Пока Выб.Следующий() Цикл
		
		ТоварыСтруктура = Новый Структура;
		
		ТоварыСтруктура.Вставить("НомерСтроки", ?(ЗначениеЗаполнено(Выб.НомерСтроки), Выб.НомерСтроки, ""));		
		ТоварыСтруктура.Вставить("КодМДМНоменклатуры", ?(ЗначениеЗаполнено(Выб.КодНоменклатурыМДМ), Выб.КодНоменклатурыМДМ, "")); 		
		ТоварыСтруктура.Вставить("КодМДМЕдиницыИзмерения", ?(ЗначениеЗаполнено(Выб.КодМДМЕдиницыИзмерения), Выб.КодМДМЕдиницыИзмерения, "")); 		
		ТоварыСтруктура.Вставить("Количество", ?(ЗначениеЗаполнено(Выб.Количество), Выб.Количество, 0));
		ТоварыСтруктура.Вставить("Цена", ?(ЗначениеЗаполнено(Выб.Цена), Выб.Цена, 0)); 
		ТоварыСтруктура.Вставить("Сумма", ?(ЗначениеЗаполнено(Выб.Сумма), Выб.Сумма, 0)); 
		ТоварыСтруктура.Вставить("СтавкаНДС",УчетНДС.ПолучитьСтавкуНДС(Выб.СтавкаНДС));
		ТоварыСтруктура.Вставить("СуммаСНДС", ?(ЗначениеЗаполнено(Выб.Сумма), Выб.Сумма, 0)); 
		ТоварыСтруктура.Вставить("СуммаНДС", ?(ЗначениеЗаполнено(Выб.СуммаНДС), Выб.СуммаНДС, 0)); 
		ТоварыСтруктура.Вставить("ИнвентарныйНомер", "");
		ТоварыСтруктура.Вставить("Артикул", "");
		ТоварыСтруктура.Вставить("НаименованиеПроизводителя", "");
		ТоварыСтруктура.Вставить("НазваниеЕдиницыИзмерения", "");
		ТоварыСтруктура.Вставить("НомерГТД", ?(ЗначениеЗаполнено(Выб.НомерГТД), СОКРЛП(Выб.НомерГТД), ""));
		ТоварыСтруктура.Вставить("КодМДМСтранаПроисхождения", ?(ЗначениеЗаполнено(Выб.КодМДМСтранаПроисхождения), СОКРЛП(Выб.КодМДМСтранаПроисхождения), ""));
		ТоварыСтруктура.Вставить("ПодразделениеКодМДМ", "");
		ТоварыСтруктура.Вставить("СписатьНаРасходы", Ложь);
		ТоварыСтруктура.Вставить("СтатьяРасходов", Неопределено);
		ТоварыСтруктура.Вставить("АналитикаРасходов", Неопределено);
		ТоварыСтруктура.Вставить("Отменено", ЛОЖЬ);

		ТоварыМассив.Добавить(ТоварыСтруктура);   		
		
	КонецЦикла;
	
	СтруктураДокумента.Вставить("Товары", ТоварыМассив);
	СтруктураДокумента.Вставить("ЭтапыГрафикаОплаты", Новый Массив); 
	
КонецПроцедуры

Процедура ЗаписатьПересортицаТоваров(ДокументОбъект , СтруктураДокумента)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ПересортицаТоваров.Проведен,
	|	ПересортицаТоваров.Организация.КодМДМГоловнойОрганизации КАК ОрганизацияКодМДМ,
	|	ПересортицаТоваров.Склад.КодМДМ,
	|	ИСТИНА КАК ПриходоватьТоварыПоСебестоимостиСписания,
	|	Константы.ВалютаРегламентированногоУчета.КодМДМ КАК ВалютаКодМДМ,
	|	ПересортицаТоваров.Товары.(
	|		Номенклатура.КодМДМ КАК НоменклатураКодМДМ, 
    |		НоменклатураОприходование.КодМДМ КАК НоменклатураОприходованиеКодМДМ,	
	|		Количество,       
	|		ЕСТЬNULL(СерияНоменклатуры.НомерГТД.Код, """") КАК НомерГТД,
	|		ЕСТЬNULL(ПересортицаТоваров.Товары.СерияНоменклатуры.СтранаПроисхождения.КодМДМ, """") КАК КодМДМСтранаПроисхождения,
	|		ЕСТЬNULL(СерияОприходование.НомерГТД.Код, """") КАК НомерГТДОприходование,
	|		ЕСТЬNULL(СерияОприходование.СтранаПроисхождения.КодМДМ, """") КАК КодМДМСтранаПроисхожденияОприходование 
	|	)
	|ИЗ
	|	Документ.ПересортицаТоваров КАК ПересортицаТоваров,
	|	Константы КАК Константы
	|ГДЕ
	|	ПересортицаТоваров.Ссылка = &Ссылка";
	
	ВыгрузитьВыборку(ДокументОбъект, СтруктураДокумента, ТекстЗапроса);
	
	СтруктураДокумента.Вставить("ПометкаУдаления", ДокументОбъект.ПометкаУдаления);    
	
КонецПроцедуры 

Процедура ЗаписатьТребованиеНакладная(ДокументОбъект, СтруктураДокумента)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТребованиеНакладная.Организация.КодМДМГоловнойОрганизации КАК ОрганизацияКодМДМ,
