			ДополнЗаголовки.Добавить("document_type",  "ПеремещениеТоваровМеждуСкладами");	
			ДополнЗаголовки.Добавить("message_ver",    "2.0");		
			ДополнЗаголовки.Добавить("operation_type", "ПоступлениеТоваровНаОтветственноеХранение");
			
		ИначеЕсли ПоступлениеТоваровНаОтветственноеХранениеДолжноВыгружатьсяКакПоступлениеТоваровУслуг(Документ) Тогда
			
