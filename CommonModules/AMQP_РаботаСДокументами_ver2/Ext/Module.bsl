Процедура ДобавитьСвойстваИЗаголовкиВСообщение(НовоеСообщение, ТипДокумента, ДополнСвойства = Неопределено, ДополнЗаголовки = Неопределено, Тип = "")
	
	Заголовки = Новый СписокЗначений;

	НужноДобавлятьЗаголовокПолучателя = Истина;
	
	Если ЗначениеЗаполнено(ДополнЗаголовки) И ДополнЗаголовки.НайтиПоЗначению("app_Receiver_id") <> Неопределено Тогда
		НужноДобавлятьЗаголовокПолучателя = Ложь;	
	КонецЕсли;  
	
	Если НужноДобавлятьЗаголовокПолучателя Тогда
		Заголовки.Добавить("app_Receiver_id", "None");	
	КонецЕсли;  

	Свойства = Новый СписокЗначений;
	Свойства.Добавить("ТипСодержимого", "application/json"); 
	Свойства.Добавить("ОтметкаВремени", ДатуВTimestamp(НовоеСообщение.ДатаВремяСобытия));   	
	
	Если Не ЗначениеЗаполнено(Тип)Тогда 
		Свойства.Добавить("Тип", "document"); 
	Иначе                                      
		Свойства.Добавить("Тип", Тип); 	   
	КонецЕсли; 
	
	Свойства.Добавить("ИмяПриложения",  Константы.AMQP_ИдентификаторИнформацСистемы.Получить());
	Свойства.Добавить("РежимДоставки",  2);
	Свойства.Добавить("НомерСообщения", Строка(НовоеСообщение.ПолучитьСсылкуНового().УникальныйИдентификатор()));
	
	Для каждого Свойство Из Свойства Цикл
		
		НоваяСтрока = НовоеСообщение.Свойства.Добавить();
		НоваяСтрока.Наименование = Свойство.Значение;
		НоваяСтрока.Значение = Свойство.Представление;	
		
	КонецЦикла; 
	
	Если ЗначениеЗаполнено(Заголовки) Тогда
		
		Для каждого Заголовок Из Заголовки Цикл
			
			НоваяСтрока = НовоеСообщение.Заголовки.Добавить();
			НоваяСтрока.Наименование = Заголовок.Значение;
			НоваяСтрока.Значение = Заголовок.Представление;
			
		КонецЦикла;   
		
	КонецЕсли;   
	
	// Добавить дополнительные заголовки
	Если ЗначениеЗаполнено(ДополнЗаголовки) Тогда
		
		Для каждого ЗаголовокЭлемент Из ДополнЗаголовки Цикл	
			
			НоваяСтрока = НовоеСообщение.Заголовки.Добавить();
			НоваяСтрока.Наименование = ЗаголовокЭлемент.Значение;
			НоваяСтрока.Значение = ЗаголовокЭлемент.Представление;	
			
		КонецЦикла;   		                                      
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДополнСвойства) Тогда
		
		Для Каждого СвойствоЭлемент Из ДополнСвойства Цикл	
			
			НоваяСтрока = НовоеСообщение.Свойства.Добавить();
			НоваяСтрока.Наименование = СвойствоЭлемент.Значение;
			НоваяСтрока.Значение = СвойствоЭлемент.Представление;
			
		КонецЦикла;   
		
	КонецЕсли;	
	
КонецПроцедуры

Функция ПолучитьТипДокументаИзБиллингаДля1С(ТипДокумента) Экспорт
	
	Соотв = Новый Соответствие;
	Соотв.Вставить("СборкаЗаказа", "СборкаЗаказовПокупателя");
	Соотв.Вставить("Возврат", "ВозвратТоваровОтПокупателя");
	
	Имя = Соотв.Получить(ТипДокумента);
	
	Если Имя = Неопределено Тогда  
		Возврат ТипДокумента; 
	Иначе                    
		Возврат Имя;    
	КонецЕсли;   	
	
КонецФункции      

Процедура ДобавитьJSONВСообщение_ВиртуальныйДокумент(НовоеСообщение, ТипДокумента, ДополнПараметры)	
	
	СтруктураДокумента = Новый Структура;		
	
	Если ТипДокумента = "СостоянияТоваровНаСкладе" Тогда
		ЗаписатьСостоянияДокументовНаСкладах(СтруктураДокумента, ДополнПараметры);	
	КонецЕсли; 
	
	Если ТипДокумента = "ПередачаРеквизитовНоменклатуры" Тогда
		ЗаписатьРеквизитыНоменклатуры(СтруктураДокумента, ДополнПараметры);	
	КонецЕсли;
	
	ЕстьОшибки = Ложь;   
	
	Для каждого Стр Из СтруктураДокумента Цикл
		
		Если Найти(Стр.Ключ, "МДМ") <> 0 И Не ЗначениеЗаполнено(СокрЛП(Стр.Значение)) Тогда
			
			ЕстьОшибки = Истина;
			СписокОшибок = СписокОшибок + ?(ЗначениеЗаполнено(СписокОшибок),Символы.ПС,"") + "Не заполнен Код МДМ для реквизита: " + Стр.Ключ;
			СтруктураДокумента.Вставить(Стр.Ключ, СокрЛП(Стр.Значение));
			
		КонецЕсли;		
		
	КонецЦикла;
	
	Если ЕстьОшибки Тогда
		ЗаписьЖурналаРегистрации("ФормированиеСообщения" + ТипДокумента, УровеньЖурналаРегистрации.Ошибка, , , СписокОшибок); 
	КонецЕсли;
	
	ЗаписьJSON = Новый ЗаписьJSON();
	
	ПараметрыJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет, " ", Истина);	
	
	ЗаписьJSON.УстановитьСтроку(ПараметрыJSON);
	ЗаписатьJSON(ЗаписьJSON, СтруктураДокумента);
	JsonСтрока = ЗаписьJSON.Закрыть(); 	
	
	НовоеСообщение.Сообщение = JsonСтрока;	
	
КонецПроцедуры

Процедура ДобавитьJSONВСообщение(НовоеСообщение, Документ, ДокументОбъект, ОтменаПроведения, ПеречитатьРегистры = Истина) Экспорт
	
	СтруктураДокумента = Новый Структура;
	
	//+Бычков О. 23.04.2025 #UT10-5207
	// Было
	//ТипДокумента = Документ.Метаданные().Имя;
	// Стало
	ТекТипДокументаВЭтойБазе = Документ.Метаданные().Имя;
	ТипДокумента = ТекТипДокументаВЭтойБазе;
	//-Бычков О. 23.04.2025 #UT10-5207
	
	Если ТипДокумента = "РеализацияТоваровУслуг" И Документ.Грузополучатель.ОформлятьРеализацииКакВнутреннееПеремещение Тогда
		ТипДокумента = "ПеремещениеТоваровМеждуСкладами"; 
	ИначеЕсли ТипДокумента = "ПоступлениеТоваровУслуг" И НужноВыгрузитьПоступлениеТоваровУслугКакПеремещениеТоваровМеждуСкладами(Документ) Тогда 
		ТипДокумента = "ПеремещениеТоваровМеждуСкладами"; 
	ИначеЕсли ТипДокумента = "АктВыполненныхРабот" Тогда  
		ТипДокумента = "ПоступлениеУслугПрочихАктивов";
	//+Бычков О. 23.04.2025 #UT10-5207
	// Вставка
	ИначеЕсли ТипДокумента = "КорректировкаРеализации" Тогда
	
		Если КорректировкаРеализацииТоваровУслугДолжнаВыгружатьсяКакПеремещениеТоваровМеждуСкладами(Документ) Тогда
			ТипДокумента = "ПеремещениеТоваровМеждуСкладами";
		КонецЕсли;
		
	//-Бычков О. 23.04.2025 #UT10-5207
	//+Бычков О. 28.04.2025 #UT10-5208
	// Вставка
	ИначеЕсли ТипДокумента = "ПоступлениеТоваровНаОтветственноеХранение" Тогда
		
		Если ПоступлениеТоваровНаОтветственноеХранениеДолжноВыгружатьсяКакПеремещениеТоваровМеждуСкладами(Документ) Тогда
			ТипДокумента = "ПеремещениеТоваровМеждуСкладами";
		ИначеЕсли ПоступлениеТоваровНаОтветственноеХранениеДолжноВыгружатьсяКакПоступлениеТоваровУслуг(Документ) Тогда
			ТипДокумента = "ПоступлениеТоваровУслуг";
		КонецЕсли;
		
	//-Бычков О. 28.04.2025 #UT10-5208
	КонецЕсли;

	ЗаписатьПредопределенныеРеквизитыДокумента(ДокументОбъект, СтруктураДокумента, ОтменаПроведения, ТипДокумента);					
	
	ИсключПоля = Новый Структура;  
	
	Если ТипДокумента = "РеализацияТоваровУслуг" Тогда  
		ЗаписатьРеализацияТоваровУслуг(ДокументОбъект, СтруктураДокумента , ПеречитатьРегистры);	
	ИначеЕсли ТипДокумента = "СчетФактураПолученный" Тогда 
		ЗаписатьСчетФактураПолученный(ДокументОбъект, СтруктураДокумента); 
	ИначеЕсли ТипДокумента = "ТребованиеНакладная" Тогда
		ЗаписатьТребованиеНакладная(ДокументОбъект, СтруктураДокумента);
	ИначеЕсли ТипДокумента = "ПересортицаТоваров" Тогда
		ЗаписатьПересортицаТоваров(ДокументОбъект, СтруктураДокумента);   
	ИначеЕсли ТипДокумента = "РасходныйКассовыйОрдер" Тогда 
		ЗаписатьРасходныйКассовыйОрдер(ДокументОбъект, СтруктураДокумента);
	ИначеЕсли ТипДокумента = "СостоянияТоваровНаСкладе" Тогда
		
	ИначеЕсли ТипДокумента = "ОплатаОтПокупателяПлатежнойКартой" Тогда  
		ЗаписатьОплатуПлатежнойКартой(ДокументОбъект, СтруктураДокумента);
	ИначеЕсли ТипДокумента = "ПлатежноеПоручениеВходящее" Тогда
		ЗаписатьПлатежноеПоручениеВходящее(ДокументОбъект, СтруктураДокумента);	
	ИначеЕсли ТипДокумента = "СчетФактураВыданный" Тогда 
		ЗаписатьСчетФактуру(ДокументОбъект, СтруктураДокумента);
	ИначеЕсли ТипДокумента = "КорректировкаРеализации" Тогда
		ЗаписатьКорректировкуРеализации(ДокументОбъект, СтруктураДокумента, ПеречитатьРегистры);
	ИначеЕсли ТипДокумента = "ВозвратТоваровОтПокупателя" Тогда
		ЗаписатьВозвратТоваровОтПокупателя(ДокументОбъект, СтруктураДокумента, ПеречитатьРегистры);	
	ИначеЕсли ТипДокумента = "ПеремещениеТоваровМеждуСкладами" Тогда

		//+Бычков О. 23.04.2025 #UT10-5207
		// Было
		//ЗаписатьРеализацияТоваровУслугКакПеремещениеТоваровМеждуСкладами(ДокументОбъект, СтруктураДокумента, ПеречитатьРегистры);
		// Стало
		ЗаписатьПеремещениеТоваровМеждуСкладами(ДокументОбъект, СтруктураДокумента, ПеречитатьРегистры);
		//-Бычков О. 23.04.2025 #UT10-5207
		
	ИначеЕсли ТипДокумента = "ЗаявкаНаВозврат" Тогда
		ЗаписатьЗаявкаНаВозврат(ДокументОбъект, СтруктураДокумента, ПеречитатьРегистры);  
	ИначеЕсли ТипДокумента = "ПоступлениеТоваровУслуг" Тогда 
		
		ТЗТовары = Новый ТаблицаЗначений;
		//+Бычков О. 28.04.2025 #UT10-5208
		// Было
		//ЗаписатьПоступлениеТоваровУслугРаббит(ДокументОбъект, СтруктураДокумента, ТЗТовары); 
		// Стало
		ЗаписатьПоступлениеТоваровУслуг(ДокументОбъект, СтруктураДокумента, ТЗТовары); 
		//-Бычков О. 28.04.2025 #UT10-5208
		
	ИначеЕсли ТипДокумента = "КорректировкаПоступления" Тогда  
		
		ТЗТовары = Новый ТаблицаЗначений;
		ЗаписатьКорректировкаПоступленияТоваровУслугРаббит(ДокументОбъект, СтруктураДокумента, ТЗТовары);
		
	ИначеЕсли ТипДокумента = "УстановкаЦенНоменклатуры" Тогда  
		ЗаписатьУстановкуЦенНоменклатуры(ДокументОбъект, СтруктураДокумента);
	ИначеЕсли ТипДокумента = "ВыкупСОтветственногоХранения" Тогда  
		ЗаписатьВыкупСОтветственногоХранения(ДокументОбъект, СтруктураДокумента);
	ИначеЕсли ТипДокумента = "УстановкаЦенНоменклатурыКонтрагентов" Тогда  
		ЗаписатьУстановкуЦенНоменклатурыКонтрагента(ДокументОбъект, СтруктураДокумента);
	ИначеЕсли ТипДокумента = "ПоступлениеУслугПрочихАктивов" Тогда  
		ЗаписатьАктВыполненныхРабот(ДокументОбъект, СтруктураДокумента);
	ИначеЕсли ТипДокумента = "АвансовыйОтчет" Тогда  
		ЗаписатьАвансовыйОтчет(ДокументОбъект, СтруктураДокумента);
		
		//+Сёмин Р.И. 04.08.2026 #UT10-5985
	ИначеЕсли ТипДокумента = "ЗаказПокупателя" Тогда
		ЗаписатьЗаказПокупателя(ДокументОбъект, СтруктураДокумента);
		//-Сёмин Р.И. 04.08.2026 #UT10-5985
		
	КонецЕсли;	                                    
	
	ЕстьОшибки = Ложь;
	СписокОшибок = "";
	
	Для каждого Стр Из СтруктураДокумента Цикл
		
		Если Найти(Стр.Ключ, "МДМ") <> 0 И Не ЗначениеЗаполнено(СокрЛП(Стр.Значение)) Тогда   
			
			ЕстьОшибки = Истина;
			СписокОшибок = СписокОшибок + ?(ЗначениеЗаполнено(СписокОшибок), Символы.ПС, "") + "Не заполнен Код МДМ для реквизита: " + Стр.Ключ;
			СтруктураДокумента.Вставить(Стр.Ключ, СокрЛП(Стр.Значение));
			
		КонецЕсли;		
		
	КонецЦикла;
	
	Если ЕстьОшибки Тогда			
		ЗаписьЖурналаРегистрации("ФормированиеСообщения" + ТипДокумента, УровеньЖурналаРегистрации.Ошибка, , ДокументОбъект.Ссылка, СписокОшибок);  		
	КонецЕсли;
	
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, СтруктураДокумента);
	JsonСтрока = ЗаписьJSON.Закрыть(); 	
	
	НовоеСообщение.Сообщение = JsonСтрока;	
	
КонецПроцедуры


///////////////////Процедуры записи документов///////////////////
Процедура ЗаписатьКорректировкуРеализации(Документ, СтруктураДокумента, ПеречитатьРегистры)

	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "Организация", "КодМДМГоловнойОрганизации", "КодОрганизацииМДМ");  
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "Контрагент", "КодМДМ", "КодКонтрагентаМДМ");
	
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "Контрагент", "КодМДМ", "КодФилиалаМДМ");		
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "Грузополучатель", "КодМДМ", "КодФилиалаМДМ");
	
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "Договор", "КодМДМ", "КодДоговораМДМ");
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "ДоговорКонтрагента", "КодМДМ", "КодДоговораМДМ");
	
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "Склад", "КодМДМ", "КодСкладаМДМ");
	
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "Контрагент", "КодМДМПартнера", "КодПартнераМДМ");
	
	СтруктураДокумента.Вставить("ОтражатьВУправленческомУчете", Число(Документ.ОтражатьВУправленческомУчете));
	
	Если Документ.Организация = Константы.ОсновнаяОрганизацияДляОплатыНаличнымиДляВодителей.Получить() Тогда
		СтруктураДокумента.Вставить("НалогообложениеНДС", "ПродажаНеОблагаетсяНДС");	
	Иначе
		СтруктураДокумента.Вставить("НалогообложениеНДС", "ПродажаОблагаетсяНДС");
	КонецЕсли;

	Если Документ.Движения.Найти("Продажи") <> Неопределено Тогда    
		
		Если Документ.Проведен 
			И Документ.ДополнительныеСвойства.Свойство("РежимЗаписи") 
			И Документ.ДополнительныеСвойства.РежимЗаписи = РежимЗаписиДокумента.Запись Тогда
			ПеречитатьРегистры = Истина;
		КонецЕсли;
		
		Если ПеречитатьРегистры Тогда     
			Документ.Движения.Продажи.Прочитать();        
		КонецЕсли;
		
		ТаблицаПродаж = Документ.Движения.Продажи.Выгрузить();
		СуммаКорректировки = ТаблицаПродаж.Итог("Стоимость");
		СтруктураДокумента.Вставить("Сумма", СуммаКорректировки);
		
		СуммаКорректировкиНДС = ТаблицаПродаж.Итог("НДС");
		
		СтруктураДокумента.Вставить("СуммаНДС", СуммаКорректировкиНДС);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Документ.ДокументРеализации) Тогда 
		
		СтруктураДокумента.Вставить("КодОснованияГУИД", Строка(Документ.ДокументРеализации.УникальныйИдентификатор()));
		СтруктураДокумента.Вставить("НомерОснования", Документ.ДокументРеализации.Номер); 
		СтруктураДокумента.Вставить("ДатаОснования", Формат(Документ.ДокументРеализации.Дата, "ДЛФ=DT")); 
		СтруктураДокумента.Вставить("ВидДокументаОснования", Документ.ДокументРеализации.Метаданные().Имя);  
		
	Иначе                                                       
		
		СтруктураДокумента.Вставить("КодОснованияГУИД", "");
		СтруктураДокумента.Вставить("НомерОснования", "");
		СтруктураДокумента.Вставить("ДатаОснования", "");
		СтруктураДокумента.Вставить("ВидДокументаОснования", "");  
		
	КонецЕсли;
	
	ДокументРеализации = Неопределено;
	УровеньВложенностиРеализации = 0;
	
	Если ТипЗнч(Документ.ДокументРеализации) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		
		ДокументРеализации = Документ.ДокументРеализации;	      
		
	ИначеЕсли ТипЗнч(Документ.ДокументРеализации) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		
		УровеньВложенностиРеализации = 1;
		Ист = Документ.ДокументРеализации;
		
		Пока ТипЗнч(Ист) = Тип("ДокументСсылка.КорректировкаРеализации") Цикл 
			
			УровеньВложенностиРеализации = УровеньВложенностиРеализации + 1;
			Ист = Ист.ДокументРеализации;     
			
		КонецЦикла;
		
		Если ТипЗнч(Ист) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда   
			ДокументРеализации = Ист;    
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументРеализации) Тогда   
		
		СтруктураДокумента.Вставить("КодРеализацииГУИД", Строка(ДокументРеализации.УникальныйИдентификатор()));
		СтруктураДокумента.Вставить("НомерРеализации", ДокументРеализации.Номер); 
		СтруктураДокумента.Вставить("ДатаРеализации", Формат(ДокументРеализации.Дата, "ДЛФ=DT"));
		СтруктураДокумента.Вставить("УровеньВложенностиРеализации", УровеньВложенностиРеализации);  
		
	Иначе                                                   
		
		СтруктураДокумента.Вставить("КодРеализацииГУИД", "");
		СтруктураДокумента.Вставить("НомерРеализации", ""); 
		СтруктураДокумента.Вставить("ДатаРеализации", "");
		СтруктураДокумента.Вставить("УровеньВложенностиРеализации", 0);
		
	КонецЕсли;
	
	СтруктураДокумента.Вставить("Валюта", Документ.ВалютаДокумента.КодМДМ);
	
	СтруктураДокумента.Вставить("Ответственный", Документ.Ответственный.Наименование);
	
	КроссДокинг = Ложь; 
	
	Для каждого Стр ИЗ Документ.Товары Цикл
		
		Если Стр.ЗаказПокупателя.КроссДокинг Тогда  
			
			КроссДокинг = Истина;   			
			Прервать;       
			
		КонецЕсли;
		
	КонецЦикла;
	
	СтруктураДокумента.Вставить("КроссДокинг", Число(КроссДокинг));
	
	КодСоглашенияАварда = "";	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ДоговорыАварды.КодАварда
	|ИЗ
	|	РегистрСведений.ДоговорыАварды КАК ДоговорыАварды
	|ГДЕ
	|	ДоговорыАварды.ДоговорКонтрагента = &ДоговорКонтрагента";
	
	Запрос.УстановитьПараметр("ДоговорКонтрагента", Документ.ДоговорКонтрагента);
	
	Выборка = Запрос.Выполнить().Выбрать();	
	
	Пока Выборка.Следующий() Цикл 		
		КодСоглашенияАварда = КодСоглашенияАварда + ?(ЗначениеЗаполнено(КодСоглашенияАварда), ",", "") + СтрЗаменить(Строка(Выборка.КодАварда), " ", ""); 		
	КонецЦикла;
	
	СтруктураДокумента.Вставить("КодСоглашенияАварда", КодСоглашенияАварда);
	
	Если Документ.Товары.Количество() > 0 И ЗначениеЗаполнено(Документ.Товары[0].ЗаказПокупателя) Тогда		
		СтруктураДокумента.Вставить("КлючСтрокиУсловий", Документ.Товары[0].ЗаказПокупателя.КлючСтрокиУсловий); 		
	Иначе                                                                                                       	
		СтруктураДокумента.Вставить("КлючСтрокиУсловий", 0);                                                    	
	КонецЕсли;
	
	СтруктураДокумента.Вставить("Водитель", "");
	СтруктураДокумента.Вставить("КоличествоКорректировок", 0);
	СтруктураДокумента.Вставить("НомерКорректировки", 0);
	СтруктураДокумента.Вставить("ЧекККМ", ?(ЗначениеЗаполнено(Документ.НомерЧекаККМ), 1, 0)); 	
	
	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	ЗаказыМассив = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КорректировкаРеализацииТовары.ЗаказПокупателя
	|ПОМЕСТИТЬ ВТЗаказКлиента
	|ИЗ
	|	Документ.КорректировкаРеализации.Товары КАК КорректировкаРеализацииТовары
	|ГДЕ
	|	КорректировкаРеализацииТовары.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	КорректировкаРеализацииТовары.ЗаказПокупателя
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказКлиентаТовары.Ссылка КАК ЗаказПокупателя,
	|	ЗаказКлиентаТовары.Ссылка.Номер КАК Номер,
	|	ЗаказКлиентаТовары.Ссылка.Дата КАК Дата,
	|	СУММА(ЗаказКлиентаТовары.Сумма) КАК Сумма,
	|	СУММА(ЗаказКлиентаТовары.СуммаНДС) КАК СуммаНДС,
	|	МАКСИМУМ(ЗаказКлиентаТовары.Ссылка.IDЗаказаПортал) КАК IDЗаказаПортал
	|ИЗ
	|	ВТЗаказКлиента КАК ВТЗаказКлиента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя.Товары КАК ЗаказКлиентаТовары
	|		ПО ВТЗаказКлиента.ЗаказПокупателя = ЗаказКлиентаТовары.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиентаТовары.Ссылка,
	|	ЗаказКлиентаТовары.Ссылка.Номер,
	|	ЗаказКлиентаТовары.Ссылка.Дата";                  
	
	Запрос.УстановитьПараметр("Ссылка", Документ.Ссылка); 
	
	Выб = Запрос.Выполнить().Выбрать();        
	
	Пока Выб.Следующий() Цикл
		
		ЗаказыСтруктура = Новый Структура;
		
		ЗаказыСтруктура.Вставить("УникальныйИдентификатор", Строка(Выб.ЗаказПокупателя.УникальныйИдентификатор()));
		ЗаказыСтруктура.Вставить("Номер", СокрЛП(Выб.Номер));
		ЗаказыСтруктура.Вставить("Дата", Формат(Выб.Дата, "ДЛФ=DT"));
		ЗаказыСтруктура.Вставить("Сумма", Выб.Сумма);
		ЗаказыСтруктура.Вставить("СуммаНДСЗаказа", Выб.СуммаНДС);
		ЗаказыСтруктура.Вставить("УИПортал", "");
		
		ЗаказыМассив.Добавить(ЗаказыСтруктура);   		
		
	КонецЦикла;	     
	
	СтруктураДокумента.Вставить("Заказы", ЗаказыМассив);
	
	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	
	Товары = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КорректировкаРеализацииТовары.Номенклатура.КодМДМ КАК НоменклатураКодМДМ,
	|	КорректировкаРеализацииТовары.Количество,
	|	КорректировкаРеализацииТовары.СтавкаНДС,
	|	ВЫБОР
	|		КОГДА КорректировкаРеализацииТовары.Ссылка.СуммаВключаетНДС
	|			ТОГДА КорректировкаРеализацииТовары.Сумма
	|		ИНАЧЕ КорректировкаРеализацииТовары.Сумма + КорректировкаРеализацииТовары.СуммаНДС
	|	КОНЕЦ КАК Сумма,
	|	КорректировкаРеализацииТовары.СуммаНДС,
	|	КорректировкаРеализацииТовары.Цена,
	|	КорректировкаРеализацииТовары.СерияНоменклатуры.НомерГТД.Код КАК НомерГТД,
	|	КорректировкаРеализацииТовары.СерияНоменклатуры.СтранаПроисхождения.КодМДМ КАК КодМДМСтранаПроисхождения,
	|	ВЫБОР
	|		КОГДА КорректировкаРеализацииТовары.ЗаказПокупателя = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	|			ТОГДА """"
	|		КОГДА КорректировкаРеализацииТовары.ЗаказПокупателя.IDСклада_СтороннийСклад = ЗНАЧЕНИЕ(Справочник.СторонниеСклады.ПустаяСсылка)
	|			ТОГДА """"
	|		ИНАЧЕ ""ПродажаСоСторСклада""
	|	КОНЕЦ КАК НаправлениеДеятельности,
	|	КорректировкаРеализацииТовары.ЗаказПокупателя,      
	//+Шульман А. 18.11.2024 #UT10-4903 
	|	КорректировкаРеализацииТовары.ЗаказПокупателя.ТипЦен.КодМДМ КАК ТипЦенКодМДМ,
	//-Шульман А. 18.11.2024 #UT10-4903 
	|	КорректировкаРеализацииТовары.НомерСтроки КАК НомерСтроки,
	|	КорректировкаРеализацииТовары.ЕдиницаИзмерения.КодМДМ КАК КодМДМЕдиницыИзмерения,
	|	КорректировкаРеализацииТовары.КоличествоДоИзменения,
	|	КорректировкаРеализацииТовары.СтавкаНДСДоИзменения,
	|	КорректировкаРеализацииТовары.СуммаДоИзменения,
	|	КорректировкаРеализацииТовары.СуммаНДСДоИзменения,
	|	КорректировкаРеализацииТовары.ЦенаДоИзменения,
	|	КорректировкаРеализацииТовары.СерияНоменклатуры.Наименование КАК СерияНоменклатуры
	|ИЗ
	|	Документ.КорректировкаРеализации.Товары КАК КорректировкаРеализацииТовары
	|ГДЕ
	|	КорректировкаРеализацииТовары.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Документ.Ссылка); 
	
	Выб = Запрос.Выполнить().Выбрать();             
	
	Пока Выб.Следующий() Цикл                     
		
		ТоварыСтруктура = Новый Структура;
		
		ТоварыСтруктура.Вставить("НомерСтроки", Выб.НомерСтроки);
		ТоварыСтруктура.Вставить("КодМДМНоменклатуры", Выб.НоменклатураКодМДМ);
		ТоварыСтруктура.Вставить("Количество", Выб.Количество);
		ТоварыСтруктура.Вставить("КодМДМЕдиницыИзмерения", Выб.КодМДМЕдиницыИзмерения);
		ТоварыСтруктура.Вставить("Цена", Выб.Цена);
		ТоварыСтруктура.Вставить("Сумма", Выб.Сумма);
		
		ТоварыСтруктура.Вставить("КоличествоДоИзменения", Выб.КоличествоДоИзменения);
		ТоварыСтруктура.Вставить("СуммаДоИзменения", Выб.СуммаДоИзменения);
		ТоварыСтруктура.Вставить("ЦенаДоИзменения", Выб.ЦенаДоИзменения);
		
		ТоварыСтруктура.Вставить("НомерГТД", СокрЛП(Выб.НомерГТД));    
		ТоварыСтруктура.Вставить("КодМДМСтранаПроисхождения", ?(ЗначениеЗаполнено(Выб.КодМДМСтранаПроисхождения), СокрЛП(Выб.КодМДМСтранаПроисхождения), ""));    
		ТоварыСтруктура.Вставить("НаправлениеДеятельности", ?(ЗначениеЗаполнено(Выб.НаправлениеДеятельности), СокрЛП(Выб.НаправлениеДеятельности), ""));    
		
		ТоварыСтруктура.Вставить("СерияНоменклатуры", Выб.СерияНоменклатуры);
		ТоварыСтруктура.Вставить("КодЗаказаГУИД", Строка(Выб.ЗаказПокупателя.УникальныйИдентификатор()));		
		
		//+Шульман А. 18.11.2024 #UT10-4903  
		ТоварыСтруктура.Вставить("ВидЦены", ?(ЗначениеЗаполнено(Выб.ТипЦенКодМДМ), СокрЛП(Выб.ТипЦенКодМДМ), ""));    
		//-Шульман А. 18.11.2024 #UT10-4903 
		
		Если Документ.Организация = Константы.ОсновнаяОрганизацияДляОплатыНаличнымиДляВодителей.Получить() Тогда
			
			ТоварыСтруктура.Вставить("СуммаНДС", 0);		
			ТоварыСтруктура.Вставить("СтавкаНДС", 0);  
			ТоварыСтруктура.Вставить("СуммаНДСДоИзменения", 0);
			ТоварыСтруктура.Вставить("СтавкаНДСДоИзменения", 0);
					
		Иначе
			
			ТоварыСтруктура.Вставить("СуммаНДС", Выб.СуммаНДС);		
			ТоварыСтруктура.Вставить("СтавкаНДС", УчетНДС.ПолучитьСтавкуНДС(Выб.СтавкаНДС));                      
			ТоварыСтруктура.Вставить("СуммаНДСДоИзменения", Выб.СуммаНДСДоИзменения);
			ТоварыСтруктура.Вставить("СтавкаНДСДоИзменения", УчетНДС.ПолучитьСтавкуНДС(Выб.СтавкаНДСДоИзменения));
		
		КонецЕсли;

		Товары.Добавить(ТоварыСтруктура);   		
		
	КонецЦикла;  
	
	СтруктураДокумента.Вставить("Товары", Товары); 
			
КонецПроцедуры

Процедура ЗаписатьСчетФактуру(Документ , СтруктураДокумента)
	
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "Организация", "КодМДМГоловнойОрганизации", "КодОрганизацииМДМ");  
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "Контрагент", "КодМДМ", "КодКонтрагентаМДМ");		
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "Контрагент", "КодМДМ", "КодФилиалаМДМ");		
	
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "Договор", "КодМДМ", "КодДоговораМДМ");
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "ДоговорКонтрагента", "КодМДМ", "КодДоговораМДМ");
	
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "Контрагент", "КодМДМПартнера", "КодПартнераМДМ");
	
	Если ЗначениеЗаполнено(Документ.ДокументОснование) Тогда
		
		СтруктураДокумента.Вставить("КодОснованияГУИД", Строка(Документ.ДокументОснование.УникальныйИдентификатор()));
		СтруктураДокумента.Вставить("ВидДокументаОснования", Документ.ДокументОснование.Метаданные().Имя); 
		СтруктураДокумента.Вставить("НомерОснования", Документ.ДокументОснование.Номер);
		СтруктураДокумента.Вставить("ДатаОснования", Формат(Документ.ДокументОснование.Дата, "ДЛФ=DT")); 
		
	Иначе 
		
		СтруктураДокумента.Вставить("КодОснованияГУИД", "");
		СтруктураДокумента.Вставить("ВидДокументаОснования", "");
		СтруктураДокумента.Вставить("НомерОснования", "");
		СтруктураДокумента.Вставить("ДатаОснования", "");
		
	КонецЕсли;
	
	СтруктураДокумента.Вставить("Валюта", Документ.ВалютаДокумента.КодМДМ);		
	СтруктураДокумента.Вставить("Корректировочный", ?(Документ.ВидСчетаФактуры = Перечисления.ВидСчетаФактурыВыставленного.Корректировочный, 1, 0));
	СтруктураДокумента.Вставить("Исправление", Число(Документ.Исправление));   
	СтруктураДокумента.Вставить("КодВидаОперации", ?(СтруктураДокумента.Корректировочный = 1, "01", Документ.КодВидаОперации));  
	
	СтруктураДокумента.Вставить("НомерИсправления", Документ.НомерИсправления);
	
	МассивТипов = МассивПоддерживаемыхТиповJSON();
	
	СтруктураДокумента.Вставить("Контрагент", ЗначениеJSON(Документ.Контрагент, МассивТипов));
	СтруктураДокумента.Вставить("Договор", ЗначениеJSON(Документ.ДоговорКонтрагента, МассивТипов));
	СтруктураДокумента.Вставить("ДокументОснование", ЗначениеJSON(Документ.ДокументОснование, МассивТипов));
	СтруктураДокумента.Вставить("НалогообложениеНДС", "ПродажаОблагаетсяНДС");   
	СтруктураДокумента.Вставить("КодВидаОперацииНаУменьшение", ?(СтруктураДокумента.Корректировочный = 1, Документ.КодВидаОперации, ""));  
	СтруктураДокумента.Вставить("ДатаВыставления", Документ.ДатаВыставления);
	СтруктураДокумента.Вставить("КППКонтрагента", Документ.КППКонтрагента);
	
	//+Марков И. 04.12.2024 #UT10-4954
	СтруктураДокумента.Вставить("СуммаДокумента", Документ.СуммаДокумента);
	СтруктураДокумента.Вставить("СуммаНДСДокумента", Документ.СуммаНДСДокумента);
	СтруктураДокумента.Вставить("СуммаУвеличение", Документ.СуммаУвеличение);
	СтруктураДокумента.Вставить("СуммаНДСУвеличение", Документ.СуммаНДСУвеличение);
	СтруктураДокумента.Вставить("СуммаУменьшение", Документ.СуммаУменьшение);
	СтруктураДокумента.Вставить("СуммаНДСУменьшение", Документ.СуммаНДСУменьшение);
	//-Марков И. 04.12.2024 #UT10-4954
	
	СтруктураДокумента.Вставить("СчетФактураОснование", ЗначениеJSON(Документ.ИсправляемыйСчетФактура, МассивТипов));
	СтруктураДокумента.Вставить("Договор", ЗначениеJSON(Документ.ДоговорКонтрагента, МассивТипов));
	
	КроссДокинг = Ложь;
	
	Если ТипЗнч(Документ.ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг") 
	 ИЛИ ТипЗнч(Документ.ДокументОснование) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		
		Для каждого Стр ИЗ Документ.ДокументОснование.Товары Цикл
			
			Если Стр.ЗаказПокупателя.КроссДокинг Тогда
				
				КроссДокинг = Истина;
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	СтруктураДокумента.Вставить("КроссДокинг", Число(КроссДокинг));
	
	МассивОснований = Новый Массив;
	
	Для каждого Стр Из Документ.ДокументыОснования Цикл
		
		СтруктураОснования = Новый Структура;
		СтруктураОснования.Вставить("Номер", Стр.НомерИсходногоДокумента);
		СтруктураОснования.Вставить("Дата", Формат(Стр.ДатаИсходногоДокумента, "ДЛФ=DT"));
		СтруктураОснования.Вставить("НомерИсправления", Стр.НомерИсправленияИсходногоДокумента);
		СтруктураОснования.Вставить("ДатаИсправления", Формат(Стр.ДатаИсправленияИсходногоДокумента, "ДЛФ=DT"));
		
		СтруктураОснования.Вставить("КодОснованияГУИД", Строка(Стр.ДокументОснование.УникальныйИдентификатор()));
		СтруктураОснования.Вставить("ВидДокументаОснования", Стр.ДокументОснование.Метаданные().Имя); 
		СтруктураОснования.Вставить("НомерОснования", Стр.ДокументОснование.Номер);
		СтруктураОснования.Вставить("ДатаОснования", Формат(Стр.ДокументОснование.Дата, "ДЛФ=DT"));
		СтруктураОснования.Вставить("ДокументОснование", ЗначениеJSON(Стр.ДокументОснование, МассивТипов));
		СтруктураОснования.Вставить("ИсходныйДокумент", СтруктураДокумента.СчетФактураОснование);
		
		МассивОснований.Добавить(СтруктураОснования);
		
	КонецЦикла;  
	
	ПлатежноРасчетныеДокументы = Новый Массив;
	
	Если ЗначениеЗаполнено(Документ.НомерПлатежноРасчетногоДокумента) Тогда
		ПлатежноРасчетныеДокументы.Добавить(Новый Структура("НомерПлатежноРасчетногоДокумента, ДатаПлатежноРасчетногоДокумента", 
		Документ.НомерПлатежноРасчетногоДокумента, Документ.ДатаПлатежноРасчетногоДокумента));
	КонецЕсли;
	
	СтруктураДокумента.Вставить("ПлатежноРасчетныеДокументы", ПлатежноРасчетныеДокументы);
	СтруктураДокумента.Вставить("ДокументыОснования", МассивОснований);
				
КонецПроцедуры

Процедура ЗаписатьОплатуПлатежнойКартой(Документ , СтруктураДокумента)
	
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "Организация", "КодМДМГоловнойОрганизации", "КодОрганизацииМДМ");  
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "Контрагент", "КодМДМ", "КодКонтрагентаМДМ");				
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "ДоговорЭквайринга", "Номер", "НомерДоговораЭквайринга");
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "Контрагент", "КодМДМПартнера", "КодПартнераМДМ");
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "ДоговорЭквайринга", "КодМДМ", "КодЭквайринговогоТерминалаМДМ"); 
	
	СтруктураДокумента.Вставить("Валюта", Документ.ВалютаДокумента.КодМДМ);		
	СтруктураДокумента.Вставить("ИДПлатежа", Документ.ИДПлатежа);       
	
	RRNКод = Документ.RRNКодОперации;
	
	Если Документ.RRNКодОперации = "111111111111" И ЗначениеЗаполнено(Документ.ТекстСлипЧека) Тогда 
		RRNКод = Чеки.ПолучитьSBPRRNИзСлипЧека(ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(Документ.ТекстСлипЧека, Символы.ПС));
	КонецЕсли; 
	
	СтруктураДокумента.Вставить("RRNКод", RRNКод);
	СтруктураДокумента.Вставить("Сумма", Документ.СуммаДокумента);       
	СтруктураДокумента.Вставить("НомерЧекаККМ", Документ.НомерЧекаККМ);
	СтруктураДокумента.Вставить("НалогообложениеНДС", "ПродажаОблагаетсяНДС"); 
		
	Если Документ.ВидОперации = Перечисления.ВидыОперацийОплатаОтПокупателяПлатежнойКартой.ОплатаПокупателя Тогда   
		
		СтруктураДокумента.Вставить("ВидОперации", "Оплата");
		СтруктураДокумента.Вставить("ХозяйственнаяОперация", "ПоступлениеОплатыОтКлиента"); 
		
	Иначе                                                                                    
		
		СтруктураДокумента.Вставить("ВидОперации", "Возврат");
		СтруктураДокумента.Вставить("ХозяйственнаяОперация", "ВозвратОплатыКлиенту");  
		
	КонецЕсли; 
	
	СтруктураДокумента.Вставить("ЧекККМ", ?(ЗначениеЗаполнено(Документ.НомерЧекаККМ), 1, 0)); 	
	
	МассивОснований = Новый Массив;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ОплатаОтПокупателяПлатежнойКартойРасшифровкаПлатежа.ДоговорКонтрагента.Владелец.КодМДМПартнера КАК КодПартнераМДМ,
	|	ЕСТЬNULL(ОплатаОтПокупателяПлатежнойКартойРасшифровкаПлатежа.ДоговорКонтрагента.КодМДМ, """") КАК КодДоговораМДМ,
	|	ОплатаОтПокупателяПлатежнойКартойРасшифровкаПлатежа.СуммаПлатежа,
	|	ОплатаОтПокупателяПлатежнойКартойРасшифровкаПлатежа.СуммаПлатежа КАК Сумма,
	|	ЕСТЬNULL(ОплатаОтПокупателяПлатежнойКартойРасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств.КодМДМ, """") КАК КодСтатьиДвиженияДенежныхСредствМДМ,
	|	ОплатаОтПокупателяПлатежнойКартойРасшифровкаПлатежа.ДокументРасчетовСКонтрагентом КАК _ДокументРасчетовСКонтрагентом,
	|	ЕСТЬNULL(ОплатаОтПокупателяПлатежнойКартойРасшифровкаПлатежа.ДокументРасчетовСКонтрагентом.Номер, """") КАК _ДокументРасчетовСКонтрагентомНомер,
	|	ЕСТЬNULL(ОплатаОтПокупателяПлатежнойКартойРасшифровкаПлатежа.ДокументРасчетовСКонтрагентом.Дата, """") КАК _ДокументРасчетовСКонтрагентомДата,
	|	&ВалютаВзаиморасчетов,
	|	ОплатаОтПокупателяПлатежнойКартойРасшифровкаПлатежа.СуммаВзаиморасчетов,
	|	ОплатаОтПокупателяПлатежнойКартойРасшифровкаПлатежа.СуммаНДС,
	|	ОплатаОтПокупателяПлатежнойКартойРасшифровкаПлатежа.СтавкаНДС КАК _СтавкаНДС
	|ИЗ
	|	Документ.ОплатаОтПокупателяПлатежнойКартой.РасшифровкаПлатежа КАК ОплатаОтПокупателяПлатежнойКартойРасшифровкаПлатежа
	|ГДЕ
	|	ОплатаОтПокупателяПлатежнойКартойРасшифровкаПлатежа.Ссылка = &Ссылка";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", Документ.Ссылка);
	Запрос.УстановитьПараметр("ВалютаВзаиморасчетов", СтруктураДокумента.Валюта); 
	
	Массив = МассивПоддерживаемыхТиповJSON();
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Структура = Новый Структура;
		ЗаполнитьКоллекциюЗначений(Структура, Выборка, Выборка.Владелец().Колонки, Массив);
		
		Структура.Вставить("СтавкаНДС", УчетНДС.ПолучитьСтавкуНДС(Выборка._СтавкаНДС));
		
		Если ЗначениеЗаполнено(Выборка._ДокументРасчетовСКонтрагентом) Тогда
			
			Структура.Вставить("КодДокументаРасчетовГУИД", XMLСтрока(Выборка._ДокументРасчетовСКонтрагентом));
			Структура.Вставить("ВидДокументаРасчетов", Выборка._ДокументРасчетовСКонтрагентом.Метаданные().Имя);
			Структура.Вставить("НомерДокументаРасчетов", Выборка._ДокументРасчетовСКонтрагентомНомер);
			Структура.Вставить("ДатаДокументаРасчетов", Строка(Выборка._ДокументРасчетовСКонтрагентомДата));
			
		Иначе
			
			Структура.Вставить("КодДокументаРасчетовГУИД", "");
			Структура.Вставить("ВидДокументаРасчетов", "");
			Структура.Вставить("НомерДокументаРасчетов", "");
			Структура.Вставить("ДатаДокументаРасчетов", "");
			
		КонецЕсли;   
		
		Структура.Вставить("ДокументРасчетовСКонтрагентом", ЗначениеJSON(Выборка._ДокументРасчетовСКонтрагентом, Массив));
		МассивОснований.Добавить(Структура);
		
	КонецЦикла;
	
	СтруктураДокумента.Вставить("РасшифровкаПлатежа", МассивОснований);
	
КонецПроцедуры

Процедура ЗаписатьСостоянияДокументовНаСкладах(СтруктураДокумента , ДополнПараметры)
	
	//+ Пашкин О.А. 12.02.2025 #UT11-5465
	Если ДополнПараметры.Свойство("ДатаСостояния") И ЗначениеЗаполнено(ДополнПараметры.ДатаСостояния) Тогда
		СтруктураДокумента.Вставить("ДатаСостояния", Формат(Дата(ДополнПараметры.ДатаСостояния), "ДЛФ=DT"));
	Иначе
		СтруктураДокумента.Вставить("ДатаСостояния", Формат(НачалоДня(ТекущаяДата()), "ДЛФ=DT"));
	КонецЕсли;
	//- Пашкин О.А. 12.02.2025 #UT11-5465
	
	Идентификаторы = Новый Массив;
	Идентификаторы.Добавить("КодМДМ");
	Идентификаторы.Добавить("КоличествоНаСкладе");
	Идентификаторы.Добавить("КоличествоДоступно");
	Идентификаторы.Добавить("КоличествоВПути");
	Идентификаторы.Добавить("КоличествоВРезерве");
	Идентификаторы.Добавить("НаПриемке");
	Идентификаторы.Добавить("ЗаказаноПоставщику");
	Идентификаторы.Добавить("ВНедоступныхЯчейках"); 
	Идентификаторы.Добавить("НаПриемкеПоПеремещению");
	
	//+Макрушин Е. 12.12.2025 #UT10-5579
	Идентификаторы.Добавить("ОстатокТОХ");
	//-Макрушин Е. 12.12.2025 #UT10-5579
		
	СтруктураДокумента.Вставить("Идентификаторы", Идентификаторы);
	
	Товары = Новый Массив;
	
	Запрос = Новый Запрос;                    
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.Номенклатура, ТоварыНаСкладахОстатки.Номенклатура) КАК Номенклатура,
	|	ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток_Врезерве,
	|	ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток_Наскладах
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(
	|			&Дата,
	|			Склад = &Склад
	|				И ВЫБОР
	|					КОГДА &ОтборПоКодам
	|						ТОГДА Номенклатура.КодМДМ В (&КодыМДМ)
	|					ИНАЧЕ ИСТИНА
	|				КОНЕЦ) КАК ТоварыВРезервеНаСкладахОстатки
	|		ПОЛНОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки(
	|				&Дата,
	|				Склад = &Склад
	|					И ВЫБОР
	|						КОГДА &ОтборПоКодам
	|							ТОГДА Номенклатура.КодМДМ В (&КодыМДМ)
	|						ИНАЧЕ ИСТИНА
	|					КОНЕЦ) КАК ТоварыНаСкладахОстатки
	|		ПО ТоварыВРезервеНаСкладахОстатки.Номенклатура = ТоварыНаСкладахОстатки.Номенклатура
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ВТ.Номенклатура, ТоварыКПолучениюНаСкладыОстатки.Номенклатура) КАК Номенклатура,
	|	ЕСТЬNULL(ВТ.КоличествоОстаток_Врезерве, 0) КАК КоличествоОстаток_Врезерве,
	|	ЕСТЬNULL(ВТ.КоличествоОстаток_Наскладах, 0) КАК КоличествоОстаток_Наскладах,
	|	ЕСТЬNULL(ТоварыКПолучениюНаСкладыОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток_Кполучению
	|ПОМЕСТИТЬ ВТ_2
	|ИЗ
	|	ВТ КАК ВТ
	|		ПОЛНОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыКПолучениюНаСклады.Остатки(
	|				&Дата,
	|				Склад = &Склад
	|					И ВЫБОР
	|						КОГДА &ОтборПоКодам
	|							ТОГДА Номенклатура.КодМДМ В (&КодыМДМ)
	|						ИНАЧЕ ИСТИНА
	|					КОНЕЦ) КАК ТоварыКПолучениюНаСкладыОстатки
	|		ПО ВТ.Номенклатура = ТоварыКПолучениюНаСкладыОстатки.Номенклатура
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыНаСкладахОбороты.Номенклатура,
	|	СУММА(ТоварыНаСкладахОбороты.КоличествоПриход) КАК НаПриемкеПоПеремещению
	|ПОМЕСТИТЬ ПТУнаПриемке
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Обороты(
	|			&ДатаПТУ,
	|			,
	|			Регистратор,
	|			Склад = &Склад
	|				И ВЫБОР
	|					КОГДА &ОтборПоКодам
	|						ТОГДА Номенклатура.КодМДМ В (&КодыМДМ)
	|					ИНАЧЕ ИСТИНА
	|				КОНЕЦ) КАК ТоварыНаСкладахОбороты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	|		ПО ТоварыНаСкладахОбороты.Регистратор = ЗначенияСвойствОбъектов.Объект
	|			И (ЗначенияСвойствОбъектов.Свойство = &Свойство)
	|			И (ЗначенияСвойствОбъектов.Значение = &ЗначениеСвойства)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках КАК ТоварыВЯчейках
	|		ПО (ТоварыВЯчейках.Регистратор ССЫЛКА Документ.РазмещениеПоЯчейкам)
	|			И ТоварыНаСкладахОбороты.Регистратор = ТоварыВЯчейках.Регистратор.ДокументОснование
	|			И ТоварыНаСкладахОбороты.Номенклатура = ТоварыВЯчейках.Номенклатура
	|ГДЕ
	|	ТоварыНаСкладахОбороты.Регистратор ССЫЛКА Документ.ПоступлениеТоваровУслуг
	|	И ТоварыНаСкладахОбороты.Регистратор.Контрагент = &Контрагент
	|	И ТоварыНаСкладахОбороты.Регистратор.Экспресс = ЛОЖЬ
	|	И ТоварыНаСкладахОбороты.Регистратор.ТранзитнаяПоставка = ЛОЖЬ
	|	И ЕСТЬNULL(ТоварыВЯчейках.Количество, 0) <= 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыНаСкладахОбороты.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ВТ_2.Номенклатура, ПТУнаПриемке.Номенклатура) КАК Номенклатура,
	|	СУММА(ЕСТЬNULL(ВТ_2.КоличествоОстаток_Врезерве, 0)) КАК КоличествоОстаток_Врезерве,
	|	СУММА(ЕСТЬNULL(ВТ_2.КоличествоОстаток_Наскладах, 0)) КАК КоличествоОстаток_Наскладах,
	|	СУММА(ЕСТЬNULL(ВТ_2.КоличествоОстаток_Кполучению, 0)) КАК КоличествоОстаток_Кполучению,
	|	СУММА(ЕСТЬNULL(ВТ_2.КоличествоОстаток_Наскладах, 0) - ЕСТЬNULL(ВТ_2.КоличествоОстаток_Врезерве, 0)) КАК КоличествоОстаток_Доступно,
	|	СУММА(ЕСТЬNULL(ПТУнаПриемке.НаПриемкеПоПеремещению, 0)) КАК НаПриемкеПоПеремещению
	|ПОМЕСТИТЬ ВТ_3
	|ИЗ
	|	ВТ_2 КАК ВТ_2
	|		ПОЛНОЕ СОЕДИНЕНИЕ ПТУнаПриемке КАК ПТУнаПриемке
	|		ПО ВТ_2.Номенклатура = ПТУнаПриемке.Номенклатура
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕСТЬNULL(ВТ_2.Номенклатура, ПТУнаПриемке.Номенклатура)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказыПоставщикамОстатки.Номенклатура КАК Номенклатура,
	|	СУММА(ЗаказыПоставщикамОстатки.КоличествоОстаток) КАК КоличествоОстаток
	|ПОМЕСТИТЬ ЗаказаноУПоставщиков
	|ИЗ
	|	РегистрНакопления.ЗаказыПоставщикам.Остатки(
	|			&Дата,
	|			ЗаказПоставщику.Склад = &Склад
	|				И НЕ Номенклатура.КодМДМ = """"
	|				И ВЫБОР
	|					КОГДА &ОтборПоКодам
	|						ТОГДА Номенклатура.КодМДМ В (&КодыМДМ)
	|					ИНАЧЕ ИСТИНА
	|				КОНЕЦ) КАК ЗаказыПоставщикамОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказыПоставщикамОстатки.Номенклатура
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РазмещениеЗаказовПокупателейОстатки.Номенклатура КАК Номенклатура,
	|	СУММА(РазмещениеЗаказовПокупателейОстатки.КоличествоОстаток) КАК КоличествоОстаток
	|ПОМЕСТИТЬ РазмещеноЗаказов
	|ИЗ
	|	РегистрНакопления.РазмещениеЗаказовПокупателей.Остатки(
	|			&Дата,
	|			ЗаказПоставщику.Склад = &Склад
	|				И НЕ Номенклатура.КодМДМ = """"
	|				И ВЫБОР
	|					КОГДА &ОтборПоКодам
	|						ТОГДА Номенклатура.КодМДМ В (&КодыМДМ)
	|					ИНАЧЕ ИСТИНА
	|				КОНЕЦ) КАК РазмещениеЗаказовПокупателейОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	РазмещениеЗаказовПокупателейОстатки.Номенклатура
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ЗаказаноУПоставщиков.Номенклатура, РазмещеноЗаказов.Номенклатура) КАК Номенклатура,
	|	ЕСТЬNULL(ЗаказаноУПоставщиков.КоличествоОстаток, 0) КАК Заказано,
	|	ЕСТЬNULL(РазмещеноЗаказов.КоличествоОстаток, 0) КАК Размещено,
	|	ЕСТЬNULL(ЗаказаноУПоставщиков.КоличествоОстаток, 0) - ЕСТЬNULL(РазмещеноЗаказов.КоличествоОстаток, 0) КАК УжеЗаказано
	|ПОМЕСТИТЬ ЗаказаноИРазмещено
	|ИЗ
	|	ЗаказаноУПоставщиков КАК ЗаказаноУПоставщиков
	|		ПОЛНОЕ СОЕДИНЕНИЕ РазмещеноЗаказов КАК РазмещеноЗаказов
	|		ПО ЗаказаноУПоставщиков.Номенклатура = РазмещеноЗаказов.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыВРезервеНаСкладахОстатки.Номенклатура,
	|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва КАК ЗаказПокупателя
	|ПОМЕСТИТЬ ТоварыВРезерве
	|ИЗ
	|	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(
	|			&Дата,
	|			Склад = &Склад
	|				И ДокументРезерва ССЫЛКА Документ.ЗаказПокупателя
	|				И ВЫБОР
	|					КОГДА &ОтборПоКодам
	|						ТОГДА Номенклатура.КодМДМ В (&КодыМДМ)
	|					ИНАЧЕ ИСТИНА
	|				КОНЕЦ) КАК ТоварыВРезервеНаСкладахОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыВРезервеНаСкладахОстатки.Номенклатура,
	|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
//+Макрушин Е. 12.12.2025 #UT10-5579	
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗапросТоварыТОХ.Номенклатура,
	|	ВЫБОР
	|		КОГДА ЗапросТоварыТОХ.КоличествоОстатокТОХ - ЕСТЬNULL(ЗапросТоварыТОХПереданные.КоличествоОстатокТОХПереданные, 0) > 0
	|			ТОГДА ЗапросТоварыТОХ.КоличествоОстатокТОХ - ЕСТЬNULL(ЗапросТоварыТОХПереданные.КоличествоОстатокТОХПереданные, 0)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ОстатокТОХ
	|ПОМЕСТИТЬ ВТ_ТоварыТОХ
	|ИЗ
	|	(ВЫБРАТЬ
	|		ТоварыОтветственногоХраненияОстатки.Номенклатура КАК Номенклатура,
	|		СУММА(ТоварыОтветственногоХраненияОстатки.КоличествоОстаток) КАК КоличествоОстатокТОХ
	|	ИЗ
	|		РегистрНакопления.ТоварыОтветственногоХранения.Остатки(
	|				&Дата,
	|				ВЫБОР
	|					КОГДА &ОтборПоКодам
	|						ТОГДА Номенклатура.КодМДМ В (&КодыМДМ)
	|					ИНАЧЕ ИСТИНА
	|				КОНЕЦ) КАК ТоварыОтветственногоХраненияОстатки
	|	
