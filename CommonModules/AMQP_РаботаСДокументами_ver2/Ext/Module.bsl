Функция ЭтоБазаОбособленногоПодразделения(пДата)

//+Бычков О. 28.04.2025 #UT10-5208
// Вставка
	ТекРезультат = Ложь;
	
	ДатаСменыОП_ГП = Константы.ДатаСменыОП_ГП.Получить();
	
	ТекПополнениеДляОбособленногоПодразделенияЮЛ = Константы.ПополнениеДляОбособленногоПодразделенияЮЛ.Получить();
	
	Если ЗначениеЗаполнено(ДатаСменыОП_ГП) Тогда
		
		Если ТекПополнениеДляОбособленногоПодразделенияЮЛ = Истина 
		   И пДата >= ДатаСменыОП_ГП Тогда
		   	ТекРезультат = Истина;
		ИначеЕсли ТекПополнениеДляОбособленногоПодразделенияЮЛ = Ложь
		   И пДата < ДатаСменыОП_ГП Тогда		
			ТекРезультат = Истина;
		КонецЕсли;
		
	Иначе
		
		Если ТекПополнениеДляОбособленногоПодразделенияЮЛ = Истина Тогда
			ТекРезультат = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ТекРезультат;
//-Бычков О. 28.04.2025 #UT10-5208	

КонецФункции

