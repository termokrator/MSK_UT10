			ТекСтрокаТовара.Вставить("СуммаНДС", ТекВыборка.СуммаНДС);		
			ТекСтрокаТовара.Вставить("СтавкаНДС", УчетНДС.ПолучитьСтавкуНДС(ТекВыборка.СтавкаНДС));
			ТекСтрокаТовара.Вставить("НомерГТД", СокрЛП(ТекВыборка.НомерГТД));
			
			ТекТовары.Добавить(ТекСтрокаТовара);
			
			ТекСуммаДокумента = ТекСуммаДокумента + ТекВыборка.Сумма;
			
			//+Бычков О. 30.04.2025 #UT10-5208
			// Вставка
			Если ЗначениеЗаполнено(ТекВыборка.ДоговорПоставщикаТОХ) Тогда
				ТекЗаменитьОрганизациюНаОХ = Истина;
			КонецЕсли;
			//-Бычков О. 30.04.2025 #UT10-5208
			
			ТекСуммаНДСДокумента = ТекСуммаНДСДокумента + ТекВыборка.СуммаНДС;
			
			ТекНомерСтроки = ТекНомерСтроки + 1;
			
		КонецЦикла;
	
	КонецЕсли;
	
	СтруктураДокумента.Вставить("Сумма", ТекСуммаДокумента);
	СтруктураДокумента.Вставить("СуммаНДС", ТекСуммаНДСДокумента);
	
	//+Бычков О. 30.04.2025 #UT10-5208
	// Вставка
	Если ТекЗаменитьОрганизациюНаОХ Тогда
		СтруктураДокумента.Вставить("КодМДМОрганизацииТОХ", Константы.КодМДМОрганизацииТОХ.Получить());
	КонецЕсли;
	//-Бычков О. 30.04.2025 #UT10-5208
	
	СтруктураДокумента.Вставить("Товары", ТекТовары);
