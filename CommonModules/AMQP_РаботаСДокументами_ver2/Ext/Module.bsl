Функция СформироватСообщенияПоСостояниюТоваровНаСкладах(КодыМДМ = Неопределено, КодыМДМСкладов = Неопределено, UploadInitiator = "ScheduledTask", ДатаСостояния = Неопределено) Экспорт
	
	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда 
		
		ЗаписьЖурналаРегистрации("Отправка состояния товаров на складе", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Отменена работа регламентного задания из-за несоответствия параметров подключения к ИБ");   
		
		Возврат Ложь;     
		
	КонецЕсли;
	
	ИмяДокумента = "СостоянияТоваровНаСкладе";	
	ДокументВыгрузки = Справочники.AMQP_ДокументыВыгрузки.НайтиПоРеквизиту("ИмяДокумента", ИмяДокумента);
	
	ПродолжитьПроверку = Ложь;    
	
	Если ДокументВыгрузки.ВерсияВыгрузки =  Перечисления.ВерсияВыгрузкиСообщенийДляРаббит.Ver_2 Тогда 
		ПродолжитьПроверку = Истина; 
	КонецЕсли; 
	
	Если Не ПродолжитьПроверку Тогда
		Возврат Ложь;           
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Склады.Ссылка,
	|	Склады.ВыгружатьСостояниеТоваровНаСкладе
	|ИЗ                                                     
	|	Справочник.Склады КАК Склады
	|ГДЕ
	|	Склады.ВыгружатьСостояниеТоваровНаСкладе
	|	И ВЫБОР
	|			КОГДА &ОтборПоСкладам
	|				ТОГДА Склады.КодМДМ В (&КодыМДМСкладов)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ";
	
	Запрос.Параметры.Вставить("ОтборПоСкладам", ЗначениеЗаполнено(КодыМДМСкладов));
	Запрос.Параметры.Вставить("КодыМДМСкладов", КодыМДМСкладов);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Пока РезультатЗапроса.Следующий() Цикл
		
		ДополнСвойства = Новый СписокЗначений;
		ДополнЗаголовки = Новый СписокЗначений;	
		
		СкладСсылка = РезультатЗапроса.Ссылка;
		ДатаВремяСобытия = ТекущаяДата();
		
		НовоеСообщение = Справочники.ИсходящиеСообщения.СоздатьЭлемент();
		НовоеСообщение.ОбменДанными.Загрузка = Истина;
		НовоеСообщение.ДатаВремяСобытия = ДатаВремяСобытия;                           
		НовоеСообщение.Объект = "СостоянияТоваровНаСкладе";
		НовоеСообщение.ТочкаПубликации = Константы.AMQP_Exchange.Получить();
		
		ID = Новый УникальныйИдентификатор();     	
		НовоеСообщение.УстановитьСсылкуНового(Справочники.ИсходящиеСообщения.ПолучитьСсылку(ID));
		
		ДополнПараметры = Новый Структура;
		ДополнПараметры.Вставить("Склад", СкладСсылка);
		ДополнПараметры.Вставить("КодыМДМ", КодыМДМ); 
		//+ Пашкин О.А. 12.02.2025 #UT11-5465
		ДополнПараметры.Вставить("ДатаСостояния", ДатаСостояния); 
		//- Пашкин О.А. 12.02.2025 #UT11-5465
		
		ДобавитьJSONВСообщение_ВиртуальныйДокумент(НовоеСообщение, ИмяДокумента, ДополнПараметры);	
		ДобавитьДанныеВСвойстваИЗаголовки_СостоянияТоваровНаСкладе(СкладСсылка, ДополнСвойства, ДополнЗаголовки, UploadInitiator);	
		ДобавитьСвойстваИЗаголовкиВСообщение(НовоеСообщение, ИмяДокумента, ДополнСвойства, ДополнЗаголовки, "status");
		
		НовоеСообщение.Записать();
		
	КонецЦикла; 		

КонецФункции

Функция СформироватьСообщенияПередачаРеквизитовНоменклатуры() Экспорт 
	
	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда 
		
		ЗаписьЖурналаРегистрации("Передача реквизитов номенклатуры между ОП юр лица", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Отменена работа регламентного задания из-за несоответствия параметров подключения к ИБ");
		Возврат Ложь;
		
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации("Передача реквизитов номенклатуры между ОП юр лица", УровеньЖурналаРегистрации.Информация, , ,
	"Начато регламентное Передача реквизитов номенклатуры между ОП юр лица");
	
	ИмяДокумента = "ПередачаРеквизитовНоменклатуры";	
	ДокументВыгрузки = Справочники.AMQP_ДокументыВыгрузки.НайтиПоРеквизиту("ИмяДокумента", ИмяДокумента);
	
	ПродолжитьПроверку = Ложь;
	
	Если ДокументВыгрузки.ВерсияВыгрузки =  Перечисления.ВерсияВыгрузкиСообщенийДляРаббит.Ver_2 Тогда 
		ПродолжитьПроверку = Истина; 
	КонецЕсли; 
	
	Если Не ПродолжитьПроверку Тогда
		Возврат Ложь;           
	КонецЕсли; 
	
	ДополнСвойства = Новый СписокЗначений;
	ДополнЗаголовки = Новый СписокЗначений;	
	
	ДатаВремяСобытия = ТекущаяДата(); 
	
	НовоеСообщение = Справочники.ИсходящиеСообщения.СоздатьЭлемент();
	НовоеСообщение.ОбменДанными.Загрузка = Истина;
	НовоеСообщение.ДатаВремяСобытия = ДатаВремяСобытия;                           
	НовоеСообщение.Объект = "ПередачаРеквизитовНоменклатуры";
	НовоеСообщение.ТочкаПубликации = Константы.AMQP_Exchange.Получить();
	
	ID = Новый УникальныйИдентификатор();     	
	НовоеСообщение.УстановитьСсылкуНового(Справочники.ИсходящиеСообщения.ПолучитьСсылку(ID));
	
	ДополнПараметры = Новый Структура;
	
	ДобавитьJSONВСообщение_ВиртуальныйДокумент(НовоеСообщение, ИмяДокумента, ДополнПараметры);	
	ДобавитьДанныеВСвойстваИЗаголовки_ПередачаРеквизитовНоменклатуры(ДополнСвойства, ДополнЗаголовки);	
	ДобавитьСвойстваИЗаголовкиВСообщение(НовоеСообщение, ИмяДокумента, ДополнСвойства, ДополнЗаголовки , "status");
	
	НовоеСообщение.Записать();
	
	ЗаписьЖурналаРегистрации("Передача реквизитов номенклатуры между ОП юр лица", УровеньЖурналаРегистрации.Информация, , ,
	"Закончено регламентное Передача реквизитов номенклатуры между ОП юр лица"); 
	
КонецФункции

Функция СоздатьИсходящееСообщение(ДокументОбъект, ОтменаПроведения = Ложь, ПеречитатьРегистры = Истина, ДополнСвойства = Неопределено, 
	                              ДополнЗаголовки = Неопределено, Точка = "", НеЗаписыватьСообщение = Ложь) Экспорт
	
	Если ДополнСвойства = Неопределено Тогда   
		ДополнСвойства = Новый СписокЗначений;  
	КонецЕсли; 
	
	Если ДополнЗаголовки = Неопределено Тогда     
		ДополнЗаголовки = Новый СписокЗначений;	  
	КонецЕсли; 
	
	ЭтоНовый = Ложь;
	
	Если ДокументОбъект.ДополнительныеСвойства.Свойство("ЭтоНовый") Тогда  
		ЭтоНовый = ДокументОбъект.ДополнительныеСвойства.ЭтоНовый;  
	КонецЕсли;
	
	Документ = ДокументОбъект.Ссылка;
	
	ТипДокумента = Документ.Метаданные().Имя;
	 
	Если ТипДокумента = "РеализацияТоваровУслуг" И Документ.Грузополучатель.ОформлятьРеализацииКакВнутреннееПеремещение Тогда 
		ТипДокумента = "ПеремещениеТоваровМеждуСкладами";   
	КонецЕсли;
	
	Если ТипДокумента = "ПоступлениеТоваровУслуг" И НужноВыгрузитьПоступлениеТоваровУслугКакПеремещениеТоваровМеждуСкладами(Документ) Тогда  
		ТипДокумента = "ПеремещениеТоваровМеждуСкладами";     
	КонецЕсли;
	
	//+Бычков О. 24.04.2025 #UT10-5207
	// Вставка
	Если ТипДокумента = "КорректировкаРеализации" Тогда  
		
		Если КорректировкаРеализацииТоваровУслугДолжнаВыгружатьсяКакПеремещениеТоваровМеждуСкладами(Документ) Тогда
			ТипДокумента = "ПеремещениеТоваровМеждуСкладами";
		КонецЕсли;
		
	КонецЕсли;
	//-Бычков О. 24.04.2025 #UT10-5207
	
	//+Бычков О. 28.04.2025 #UT10-5208
	// Вставка
	Если ТипДокумента = "ПоступлениеТоваровНаОтветственноеХранение" Тогда  
		
		Если ПоступлениеТоваровНаОтветственноеХранениеДолжноВыгружатьсяКакПеремещениеТоваровМеждуСкладами(Документ) Тогда
			ТипДокумента = "ПеремещениеТоваровМеждуСкладами";
		ИначеЕсли ПоступлениеТоваровНаОтветственноеХранениеДолжноВыгружатьсяКакПоступлениеТоваровУслуг(Документ) Тогда
			ТипДокумента = "ПоступлениеТоваровУслуг";
		КонецЕсли;
		
	КонецЕсли;
	//-Бычков О. 28.04.2025 #UT10-5208
	
	Если ТипДокумента = "АктВыполненныхРабот" Тогда  
		ТипДокумента = "ПоступлениеУслугПрочихАктивов";     
	КонецЕсли;
	
	ДатаВремяСобытия = ТекущаяДата();
	
	НовоеСообщение = Справочники.ИсходящиеСообщения.СоздатьЭлемент();
	НовоеСообщение.ОбменДанными.Загрузка = Истина;
	НовоеСообщение.ДатаВремяСобытия = ДатаВремяСобытия;
	
	Если ЗначениеЗаполнено(Точка) Тогда  
		НовоеСообщение.ТочкаПубликации = Точка;
	Иначе            
		НовоеСообщение.ТочкаПубликации = Константы.AMQP_Exchange.Получить(); 
	КонецЕсли; 
	
	ID = Новый УникальныйИдентификатор();     	
	НовоеСообщение.УстановитьСсылкуНового(Справочники.ИсходящиеСообщения.ПолучитьСсылку(ID));
	
	ДобавитьJSONВСообщение(НовоеСообщение, Документ, ДокументОбъект, ОтменаПроведения, ПеречитатьРегистры);	
	ДобавитьДанныеВСвойстваИЗаголовки(ДокументОбъект, ДополнСвойства, ДополнЗаголовки);	
	ДобавитьСвойстваИЗаголовкиВСообщение(НовоеСообщение, ТипДокумента, ДополнСвойства, ДополнЗаголовки);                                                             	
	ДобавитьДополнительныйЗаголовокДляОбособленныхПодразделений(ТипДокумента,Документ, НовоеСообщение);
	НовоеСообщение.Объект = Документ.Ссылка;  
	
	Если НеЗаписыватьСообщение Тогда 
		Возврат НовоеСообщение;   
	Иначе        
		
		Если ЗначениеЗаполнено(НовоеСообщение.Сообщение) Тогда
			НовоеСообщение.Записать(); 
		КонецЕсли;
		
		Если НЕ НовоеСообщение.БылаОшибка Тогда	
			
			Если (ТипДокумента = "РеализацияТоваровУслуг" 
				ИЛИ ТипДокумента = "КорректировкаРеализации")  
				И (ЗначениеЗаполнено(Документ.Грузополучатель.DS_Подразделение_ID) ИЛИ ЗначениеЗаполнено(Документ.ДоговорКонтрагента.DS_Подразделение_ID))
				И ПроверитьКонтрагентаДляВыгрузкиВУТ11(ДокументОбъект) = "ERP" 
				И МСК.ПолучитьСостояниеЭДО(Документ.Ссылка).Пустая() Тогда
				МСК.ЗаписатьСостояниеЭДО(Документ.Ссылка,Перечисления.СостояниеЭДО.ВПроцессеОтправки);			
			КонецЕсли;	
			
		КонецЕсли;
		
		Возврат Не НовоеСообщение.БылаОшибка;  
		
	КонецЕсли;	
	
КонецФункции

Процедура СформироватьСообщениеПриемкиРазмещенияДневное() Экспорт
	
	Отчеты.СводныйОтчетПриемкиРазмещения.СформирватьДанныеДляОтправки();
	
КонецПроцедуры

Процедура СформироватьСообщениеПриемкиРазмещенияИнтервал() Экспорт
	
	Отчеты.СводныйОтчетПриемкиРазмещения.СформирватьДанныеДляОтправки(31);
	
КонецПроцедуры

Процедура СформироватьСообщениеПриемкиРазмещенияИнтервалДоп() Экспорт
	 
	ДнейВПрошломМесяце = День(НачалоМесяца(ТекущаяДата()) - 1);
	Отчеты.СводныйОтчетПриемкиРазмещения.СформирватьДанныеДляОтправки(ДнейВПрошломМесяце + День(ТекущаяДата()) - 1);

КонецПроцедуры

Функция СформироватьСообщениеСостояниеЭДО(Документ, Запись) Экспорт 
//+Белов А. 18.11.2024 #

	ДатаВремяСобытия = ТекущаяДата();
	
	НовоеСообщение = Справочники.ИсходящиеСообщения.СоздатьЭлемент();
	НовоеСообщение.ОбменДанными.Загрузка = Истина;
	НовоеСообщение.ДатаВремяСобытия = ДатаВремяСобытия;
	НовоеСообщение.ТочкаПубликации = СокрЛП(Константы.AMQP_Exchange.Получить());
	НовоеСообщение.Объект = Документ;
	
	ID = Новый УникальныйИдентификатор();     	
	НовоеСообщение.УстановитьСсылкуНового(Справочники.ИсходящиеСообщения.ПолучитьСсылку(ID));                                                                                   
	
	СтруктураДокумента = Новый Структура;
	СтруктураДокумента.Вставить("ТипСодержимого", "application/json");
	СтруктураДокумента.Вставить("ВидДокумента", "ИсторияОбменовЭДО");
	СтруктураДокумента.Вставить("ТипДокумента", СокрЛП(Документ.Метаданные().Имя)); 
	СтруктураДокумента.Вставить("УникальныйИдентификатор", Строка(Документ.УникальныйИдентификатор()));
	СтруктураДокумента.Вставить("Номер", Строка(Документ.Номер));
	СтруктураДокумента.Вставить("Дата", Формат(Документ.Дата, "ДЛФ=DT"));
	
	СтруктураДокумента.Вставить("Период", Запись.Период);
	СтруктураДокумента.Вставить("Статус", ОбщегоНазначения.ИмяЗначенияПеречисления(Запись.Статус));
	СтруктураДокумента.Вставить("Ошибка", Запись.Ошибка);
	СтруктураДокумента.Вставить("Комментарий", Запись.Комментарий);
	СтруктураДокумента.Вставить("Период", Запись.Период);
	
	НовоеСообщение.Сообщение = ОбщегоНазначения.ВернутьJSON(СтруктураДокумента);
	
	Заголовки = Новый СписокЗначений;
	Заголовки.Добавить("document_type",  "ИсторияОбменовЭДО");	
	Заголовки.Добавить("message_ver",    "2.0");		
	Заголовки.Добавить("app_Receiver_id", "ERP");
	
	Если ЗначениеЗаполнено(Заголовки) Тогда
		
		Для каждого Заголовок Из Заголовки Цикл
			
			НоваяСтрока = НовоеСообщение.Заголовки.Добавить();
			НоваяСтрока.Наименование = Заголовок.Значение;
			НоваяСтрока.Значение = Заголовок.Представление;
			
		КонецЦикла;   
		
	КонецЕсли;  
	
	Свойства = Новый СписокЗначений;
	Свойства.Добавить("ТипСодержимого", "application/json"); 
	Свойства.Добавить("ОтметкаВремени", ДатуВTimestamp(НовоеСообщение.ДатаВремяСобытия));   	
	Свойства.Добавить("Тип",            "document"); 
	Свойства.Добавить("ИмяПриложения",  Константы.AMQP_ИдентификаторИнформацСистемы.Получить());
	Свойства.Добавить("РежимДоставки",  2);
	Свойства.Добавить("НомерСообщения", Строка(НовоеСообщение.ПолучитьСсылкуНового().УникальныйИдентификатор()));
	
	Для каждого Свойство Из Свойства Цикл
		
		НоваяСтрока = НовоеСообщение.Свойства.Добавить();
		НоваяСтрока.Наименование = Свойство.Значение;
		НоваяСтрока.Значение = Свойство.Представление;
		
	КонецЦикла; 	
	
	НовоеСообщение.Записать();                                     

//-Белов А. 18.11.2024 #
КонецФункции

Функция СформироватьСообщениеЗаказЗаявка(Документ, Запись) Экспорт 
//+Белов А. 03.09.2026 #UT10-6035

	ДатаВремяСобытия = ТекущаяДата();
	
	НовоеСообщение = Справочники.ИсходящиеСообщения.СоздатьЭлемент();
	НовоеСообщение.ОбменДанными.Загрузка = Истина;
	НовоеСообщение.ДатаВремяСобытия = ДатаВремяСобытия;
	НовоеСообщение.ТочкаПубликации = СокрЛП(Константы.AMQP_Exchange.Получить());
	НовоеСообщение.Объект = Документ;
	
	ID = Новый УникальныйИдентификатор();     	
	НовоеСообщение.УстановитьСсылкуНового(Справочники.ИсходящиеСообщения.ПолучитьСсылку(ID));                                                                                   
	
	СтруктураДокумента = Новый Структура;	
	СтруктураДокумента.Вставить("ВидДокумента", "ЗаказЗаявка"); 
	СтруктураДокумента.Вставить("УникальныйИдентификатор", Строка(Документ.УникальныйИдентификатор()));
	СтруктураДокумента.Вставить("Номер", Строка(Документ.Номер));
	СтруктураДокумента.Вставить("Дата", Формат(Документ.Дата, "ДЛФ=DT"));
	
	СтруктураДокумента.Вставить("ГрузоотправительКодМДМ", Документ.Организация.КодМДМ);
	СтруктураДокумента.Вставить("ПеревозчикКодМДМ", Документ.Контрагент.КодМДМ);
	СтруктураДокумента.Вставить("ДоговорПеревозчикаКодМДМ", Документ.ДоговорКонтрагента.КодМДМ);
	СтруктураДокумента.Вставить("ТелефонКонтрагента", Документ.ТелефонКонтрагента);
	СтруктураДокумента.Вставить("ДатаПогрузки", Документ.ДатаПогрузки);
	СтруктураДокумента.Вставить("КоличествоГрузомест", Документ.КоличествоГрузомест);
	СтруктураДокумента.Вставить("ВесГруза", Документ.ВесГруза);
	СтруктураДокумента.Вставить("ОбъемГруза", Документ.ОбъемГруза);
	СтруктураДокумента.Вставить("Грузоподъемность", Документ.Грузоподъемность);
	СтруктураДокумента.Вставить("Вместимость", Документ.Вместимость);          
	СтруктураДокумента.Вставить("ОтветПеревозчика", ОбщегоНазначения.ВернутьСтруктуруИзJSON(Документ.ОтветПеревозчика));
	
	МассивГрузополучателей = Новый Массив; 
	
	Для каждого Стр Из Документ.Грузополучатели Цикл       	
		МассивГрузополучателей.Добавить(Новый Структура("ГрузополучательКодМДМ", Стр.Контрагент.КодМДМ));		
	КонецЦикла; 
	
	СтруктураДокумента.Вставить("Грузополучатели", МассивГрузополучателей);
	
	НовоеСообщение.Сообщение = ОбщегоНазначения.ВернутьJSON(СтруктураДокумента);
	
	Заголовки = Новый СписокЗначений;
	Заголовки.Добавить("document_type",  "ЗаказЗаявка");	
	Заголовки.Добавить("message_ver",    "2.0");		
	Заголовки.Добавить("app_Receiver_id", Документ.Организация.ИДбазы);
	
	Если ЗначениеЗаполнено(Заголовки) Тогда
		
		Для каждого Заголовок Из Заголовки Цикл
			
			НоваяСтрока = НовоеСообщение.Заголовки.Добавить();
			НоваяСтрока.Наименование = Заголовок.Значение;
			НоваяСтрока.Значение = Заголовок.Представление;
			
		КонецЦикла;   
		
	КонецЕсли;  
	
	Свойства = Новый СписокЗначений;
	Свойства.Добавить("ТипСодержимого", "application/json"); 
	Свойства.Добавить("ОтметкаВремени", ДатуВTimestamp(НовоеСообщение.ДатаВремяСобытия));   	
	Свойства.Добавить("Тип",            "document"); 
	Свойства.Добавить("ИмяПриложения",  Константы.AMQP_ИдентификаторИнформацСистемы.Получить());
	Свойства.Добавить("РежимДоставки",  2);
	Свойства.Добавить("НомерСообщения", Строка(НовоеСообщение.ПолучитьСсылкуНового().УникальныйИдентификатор()));
	
	Для каждого Свойство Из Свойства Цикл
		
		НоваяСтрока = НовоеСообщение.Свойства.Добавить();
		НоваяСтрока.Наименование = Свойство.Значение;
		НоваяСтрока.Значение = Свойство.Представление;
		
	КонецЦикла; 	
	
	НовоеСообщение.Записать();                                     

//-Белов А. 03.09.2026 #UT10-6035 
КонецФункции



///////////////////Общие процедуры и функции///////////////////
Функция ПроверитьНужноЛиВыгружатьДокумент(Документ) Экспорт
	
	ИмяДокумента = Документ.Метаданные().Имя;
	
	ДокументВыгрузки = Справочники.AMQP_ДокументыВыгрузки.НайтиПоРеквизиту("ИмяДокумента", ИмяДокумента);
	
	Если Не ЗначениеЗаполнено(ДокументВыгрузки) ИЛИ Не ДокументВыгрузки.Выгружать Или ДокументВыгрузки.ПометкаУдаления Тогда		
		Возврат Ложь;                                                                                                       	
	КонецЕсли;
	                           
	ПродолжитьПроверку = Ложь;   
	
	Если ДокументВыгрузки.ВерсияВыгрузки =  Перечисления.ВерсияВыгрузкиСообщенийДляРаббит.Ver1_Ver2 
		Или ДокументВыгрузки.ВерсияВыгрузки =  Перечисления.ВерсияВыгрузкиСообщенийДляРаббит.Ver_2 Тогда 		
		ПродолжитьПроверку = Истина;                                                                     	
	КонецЕсли; 
	
	Если ИмяДокумента = "РеализацияТоваровУслуг" И Документ.Грузополучатель.ОформлятьРеализацииКакВнутреннееПеремещение Тогда 		
		ПродолжитьПроверку = Истина; 
	//+Бычков О. 23.04.2025 #UT10-5207
	// Было
	//ИначеЕсли ИмяДокумента = "КорректировкаРеализации" И Документ.Грузополучатель.ОформлятьРеализацииКакВнутреннееПеремещение Тогда
	//	Возврат Ложь;        
	// Стало
	// Теперь такие документы выгружаем по условиям ниже.
	//-Бычков О. 23.04.2025 #UT10-5207
	ИначеЕсли ИмяДокумента = "СчетФактураПолученный" Тогда
		//+Бычков О. 21.01.2026 #UT11-5775
		// Было
		//Возврат Не Константы.ОсновнаяОрганизация.Получить().ИНН = Документ.Контрагент.ИНН;
		// Стало
		Возврат ПроверитьНужноЛиВыгружатьСчетФактуруПолученный(Документ);
		//-Бычков О. 21.01.2026 #UT11-5775
	//+Бычков О. 21.01.2026 #UT10-5642
	// Было
	//ИначеЕсли ИмяДокумента = "СчетФактураВыданный" И ОбщегоНазначения.ЕстьРеквизитДокумента("Грузополучатель", Документ.ДокументОснование.Метаданные()) 
	//	И Документ.ДокументОснование.Грузополучатель.ОформлятьРеализацииКакВнутреннееПеремещение Тогда                      
	//	Возврат Ложь;
	// Стало
	ИначеЕсли ИмяДокумента = "СчетФактураВыданный" Тогда                      
		ПродолжитьПроверку = ПроверитьНужноЛиВыгружатьСчетФактуруВыданный(Документ);
	//-Бычков О. 21.01.2026 #UT10-5642
	ИначеЕсли ИмяДокумента = "ПлатежноеПоручениеВходящее" Тогда 
		
		Если Не ПроверитьДоговорДляВыгрузкиВБиллинг(Документ, ИмяДокумента) ИЛИ Не (ЗначениеЗаполнено(Документ.Контрагент) И ЗначениеЗаполнено(Документ.Контрагент.КодМДМ)) Тогда
			Возврат Ложь;        
		КонецЕсли;    
		
	ИначеЕсли ИмяДокумента = "АвансовыйОтчет" Тогда
		ПродолжитьПроверку = Истина;                                                                     	
	ИначеЕсли ИмяДокумента = "УстановкаЦенНоменклатуры" И ПроверитьУстановкуЦен(Документ) Тогда 
		Возврат Ложь; 
	ИначеЕсли ИмяДокумента = "УстановкаЦенНоменклатурыКонтрагентов" И ПроверитьУстановкуЦенКонтрагентов(Документ) Тогда 
		Возврат Ложь; 
	ИначеЕсли ИмяДокумента = "АктВыполненныхРабот"  И ПроверитьАктВыполненныхРабот(Документ) Тогда 
		Возврат Ложь;

	//- Пашкин О.А. 07.07.2025 #UT10-5299
	ИначеЕсли ИмяДокумента = "ЗаказНаЭмиссиюКодовМаркировкиСУЗ" Тогда	
		
		Возврат Ложь; 
		
	//+ Пашкин О.А. 12.07.2025 #UT10-5299
	ИначеЕсли ИмяДокумента = "ОтчетОНанесенииКИЗ" Тогда	
		
		Возврат Ложь; 
	//- Пашкин О.А. 12.07.2025 #UT10-5299
		
	ИначеЕсли ИмяДокумента = "ВводВОборотКИЗ" Тогда	
		
		Возврат Ложь; 
	//- Пашкин О.А. 07.07.2025 #UT10-5299
		
	//+Бычков О. 23.04.2025 #UT10-5207
	//+Белов А. 24.03.2026 #UT10-5761
	ИначеЕсли ИмяДокумента = "ВыводИзОборотаКИЗ" Тогда	
		Возврат Ложь;	
	//-Белов А. 24.03.2026 #UT10-5761
	// Вставка
	ИначеЕсли ИмяДокумента = "КорректировкаПоступления" Тогда
		
		Если КорректировкаПоступленияТоваровУслугДолжнаВыгружатьсяКакПеремещениеТоваровМеждуСкладами(Документ.Ссылка) Тогда
			
			Если Не ВыполненыДополнительныеУсловияВыгрузкиКорректировкиПоступленияТоваровУслугКакПеремещенияТоваровМеждуСкладами(Документ.Ссылка) Тогда
				Возврат Ложь;
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ИмяДокумента = "КорректировкаРеализации" Тогда		
		
		Если КорректировкаРеализацииТоваровУслугДолжнаВыгружатьсяКакПеремещениеТоваровМеждуСкладами(Документ.Ссылка) Тогда
			
			Если Не ВыполненыДополнительныеУсловияВыгрузкиКорректировкиРеализацииТоваровУслугКакПеремещенияТоваровМеждуСкладами(Документ.Ссылка) Тогда
				Возврат Ложь;
			КонецЕсли;
		
		КонецЕсли;
		
	//-Бычков О. 23.04.2025 #UT10-5207
	//+Бычков О. 28.04.2025 #UT10-5208
	// Вставка
	ИначеЕсли ИмяДокумента = "ПоступлениеТоваровНаОтветственноеХранение" Тогда  
		
		Если Не ПоступлениеТоваровНаОтветственноеХранениеДолжноВыгружатьсяКакПеремещениеТоваровМеждуСкладами(Документ.Ссылка)
			И Не ПоступлениеТоваровНаОтветственноеХранениеДолжноВыгружатьсяКакПоступлениеТоваровУслуг(Документ.Ссылка) Тогда
			Возврат Ложь;
		КонецЕсли;
		
	//-Бычков О. 28.04.2025 #UT10-5208
	КонецЕсли;  
	
	Если Не ПродолжитьПроверку Тогда
		Возврат Ложь;  
	КонецЕсли; 
	
	Если ИмяДокумента = "ПоступлениеТоваровУслуг" И НужноВыгрузитьПоступлениеТоваровУслугКакПеремещениеТоваровМеждуСкладами(Документ.Ссылка) Тогда
		
		Если Документ.ТранзитнаяПоставка И Документ.Статус <> Перечисления.СтатусыПТУ.Закрыт Тогда 
			Возврат Ложь;                                                                                
		КонецЕсли;
		
	КонецЕсли;
	
	Если Документ.Дата < Константы.AMQP_ДатаНачалаВыгрузки.Получить() Тогда   
		Возврат Ложь;       
	КонецЕсли;  
	
	Если ОбщегоНазначения.ЕстьРеквизитДокумента("ШтампВерсии", Документ.Метаданные()) Тогда 
		
		Если Документ.ШтампВерсии = 0 тогда   
			Возврат Ложь;     
		КонецЕсли;   
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ПроверитьДоговорДляВыгрузкиВБиллинг(Документ , ИмяДокумента)
	
	Если ИмяДокумента = "КорректировкаСборкиЗаказовПокупателя" Тогда
		
		Результат = ПроверитьДокументКорректировкаСборкиЗаказовПокупателя(Документ);
		Возврат Результат;
		
	КонецЕсли; 
	
	Если ИмяДокумента = "КорректировкаРеализации" Тогда
		
		Результат = ПроверитьДокументКорректировкаРеализации(Документ);
		Возврат Результат;
		
	КонецЕсли; 
	
	Если ИмяДокумента = "КорректировкаДолга" Тогда	
		
		Результат = ПроверитьДокументКорректировкаДолга(Документ);
		Возврат Результат;
		
	КонецЕсли;
	
	Если ИмяДокумента = "ПлатежноеПоручениеВходящее" Тогда
		
		Результат = ПроверитьДокументПлатежноеПоручениеВходящее(Документ);
		Возврат Результат;
		
	КонецЕсли; 
	
	Если ИмяДокумента = "ПриходныйКассовыйОрдер" Тогда
		
		Результат = ПроверитьДокументПриходныйКассовыйОрдер(Документ);
		Возврат Результат;		
		
	КонецЕсли; 
	
	Если ИмяДокумента = "ОплатаОтПокупателяПлатежнойКартой" Тогда
		
		Результат = ПроверитьДокументОплатаОтПокупателяПлатежнойКартой(Документ);
		Возврат Результат;		
		
	КонецЕсли;
	
	Если ОбщегоНазначения.ЕстьРеквизитДокумента("Договор", Документ.Метаданные()) Тогда
		
		Если Не ПроверитьДоговор(Документ.Договор) Тогда
			Возврат Ложь;
		Иначе
			Возврат Истина;
		КонецЕсли;
		
	КонецЕсли;	                                  
	
	Если ОбщегоНазначения.ЕстьРеквизитДокумента("ДоговорКонтрагента", Документ.Метаданные()) Тогда
		
		Если Не ПроверитьДоговор(Документ.ДоговорКонтрагента) Тогда
			Возврат Ложь;
		Иначе
			Возврат Истина;			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ПроверитьДокументПриходныйКассовыйОрдер(ДокументОбъект)
	
	Результат = Ложь;
	
	Если ДокументОбъект.РасшифровкаПлатежа.Количество() = 1 Тогда		
		
		Результат = ПроверитьДоговор(ДокументОбъект.ДоговорКонтрагента);
		Возврат Результат;
		
	КонецЕсли;
	
	Для каждого Стр Из ДокументОбъект.РасшифровкаПлатежа Цикл
		
		Результат = ПроверитьДоговор(Стр.ДоговорКонтрагента);
		Если Результат Тогда
			Прервать;
		КонецЕсли; 	
		
	КонецЦикла; 
	
	Возврат Результат;
	
КонецФункции

Функция ПроверитьДокументОплатаОтПокупателяПлатежнойКартой(ДокументОбъект)

	Результат = Ложь;
	
	Для Каждого Стр Из ДокументОбъект.РасшифровкаПлатежа Цикл
		
		Результат = ПроверитьДоговор(Стр.ДоговорКонтрагента);  
		
		Если Результат Тогда  
			Прервать;    
		КонецЕсли; 	
		
	КонецЦикла; 
	
	Возврат Результат;
	
КонецФункции

Функция ПроверитьДокументПлатежноеПоручениеВходящее(ДокументОбъект)
	
	Результат = Ложь;
	
	Если ДокументОбъект.РасшифровкаПлатежа.Количество() = 1 Тогда		
		
		Результат = ПроверитьДоговор(ДокументОбъект.ДоговорКонтрагента);
		Возврат Результат;
		
	КонецЕсли;
	
	Для каждого Стр Из ДокументОбъект.РасшифровкаПлатежа Цикл
		
		Результат = ПроверитьДоговор(Стр.ДоговорКонтрагента);
		
		Если Результат Тогда
			Прервать;
		КонецЕсли; 	
		
	КонецЦикла; 
	
	Возврат Результат;
	
КонецФункции 

Функция ПроверитьДокументКорректировкаДолга(ДокументОбъект)
	
	Результат = Ложь;
	
	Запрос = Новый Запрос;                             
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВзаиморасчетыСКонтрагентами.Регистратор,
	|	ВзаиморасчетыСКонтрагентами.ДоговорКонтрагента
	|ИЗ
	|	РегистрНакопления.ВзаиморасчетыСКонтрагентами КАК ВзаиморасчетыСКонтрагентами
	|ГДЕ
	|	ВзаиморасчетыСКонтрагентами.Регистратор = &Регистратор
	|	И ВзаиморасчетыСКонтрагентами.ДоговорКонтрагента.ВыгружаетсяВБиллинг"; 
	
	Запрос.УстановитьПараметр("Регистратор", ДокументОбъект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Количество() > 0 Тогда		
		Результат = Истина;			
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции

Функция ПроверитьДокументКорректировкаРеализации(ДокументОбъект)
	
	Результат = Ложь;	
	
	Искать = Истина;
	Запрос = Новый Запрос;      
	
	ПараметрСсылка = ДокументОбъект.Ссылка;
	
	Пока Искать Цикл
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	КорректировкаРеализации.Ссылка КАК Ссылка,
		|	КорректировкаРеализации.ДокументРеализации КАК ДокументОснование
		|ИЗ
		|	Документ.КорректировкаРеализации КАК КорректировкаРеализации
		|ГДЕ
		|	КорректировкаРеализации.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", ПараметрСсылка);
		
		
		РезультатЗапроса = Запрос.Выполнить().Выбрать();
		РезультатЗапроса.Следующий();
		ПараметрСсылка = РезультатЗапроса.ДокументОснование;
		
		Если ТипЗнч(РезультатЗапроса.ДокументОснование) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда			
			Продолжить;
		КонецЕсли; 
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	РеализацияТоваровУслуг.Ссылка,
		|	РеализацияТоваровУслуг.ДоговорКонтрагента,
		|	РеализацияТоваровУслуг.ДоговорКонтрагента.ВыгружаетсяВБиллинг КАК ВыгружаетсяВБиллинг
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|ГДЕ
		|	РеализацияТоваровУслуг.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", ПараметрСсылка);
		
		РезультатЗапроса = Запрос.Выполнить().Выбрать();
		РезультатЗапроса.Следующий();
		Результат = РезультатЗапроса.ВыгружаетсяВБиллинг;
		Искать = Ложь;		
		
	КонецЦикла; 
	
	Возврат Результат;
	
КонецФункции

Функция ПроверитьДокументКорректировкаСборкиЗаказовПокупателя(ДокументОбъект)
	
	Результат = Ложь;	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	|	СборкаЗаказовПокупателя.Ссылка,
	|	СборкаЗаказовПокупателя.Договор,
	|	ЕСТЬNULL(ДоговорыКонтрагентов.ВыгружаетсяВБиллинг, ЛОЖЬ) КАК ВыгружаетсяВБиллинг,
	|	ЕСТЬNULL(ДоговорыКонтрагентов.Ссылка, """") КАК Договор
	|ИЗ
	|	Документ.СборкаЗаказовПокупателя КАК СборкаЗаказовПокупателя
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ПО СборкаЗаказовПокупателя.Договор = ДоговорыКонтрагентов.Ссылка
	|ГДЕ
	|	СборкаЗаказовПокупателя.Ссылка = &СборкаЗаказовПокупателя";	
	
	Запрос.УстановитьПараметр("СборкаЗаказовПокупателя", ДокументОбъект.СборкаЗаказовПокупателя);  
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Количество() > 0 Тогда  
		
		РезультатЗапроса.Следующий();
		Результат =  РезультатЗапроса.ВыгружаетсяВБиллинг; 
		
	КонецЕсли; 
	
	Возврат Результат;	
	
КонецФункции

Функция ПроверитьДоговор(Договор) 
	
	Если ТипЗнч(Договор) = Тип("СправочникСсылка.ДоговорыКонтрагентов") И НЕ Договор.ВыгружаетсяВБиллинг Тогда 
		Возврат Ложь;     
	КонецЕсли;      
	
	Возврат Истина;
	
КонецФункции

Функция ПроверитьКонтрагентаДляВыгрузкиВУТ11(Документ)

	Если Документ.ДополнительныеСвойства.Свойство("app_Recipient_id") Тогда
		Возврат Документ.ДополнительныеСвойства.app_Recipient_id;	
	КонецЕсли;
	
	Если ОбщегоНазначения.ЕстьРеквизитДокумента("Контрагент", Документ.Метаданные()) Тогда
		
		Если ЗначениеЗаполнено(Документ.Контрагент.ДатаНачалаОбменаВНовомФормате) И Документ.Дата >= Документ.Контрагент.ДатаНачалаОбменаВНовомФормате Тогда
			Возврат "ERP";
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат "";

КонецФункции

Процедура ДобавитьДанныеВСвойстваИЗаголовки(ДокументОбъект, ДополнСвойства, ДополнЗаголовки)
	
	Документ     = ДокументОбъект.Ссылка;
	ТипДокумента = ПолучитьТипДокументаИзБиллингаДля1С(Документ.Метаданные().Имя);
	ИмяДокумента = Документ.Метаданные().Имя;
		
	Если ИмяДокумента = "РасходныйКассовыйОрдер" Тогда
		ДополнЗаголовки.Добавить("document_type",  ТипДокумента);
	
	ИначеЕсли ИмяДокумента = "РеализацияТоваровУслуг" Тогда 
		
		Если Документ.Грузополучатель.ОформлятьРеализацииКакВнутреннееПеремещение Тогда
			
			ДополнЗаголовки.Добавить("document_type",  "ПеремещениеТоваровМеждуСкладами");	
			ДополнЗаголовки.Добавить("message_ver",    "2.0");			
			ДополнЗаголовки.Добавить("operation_type", "РеализацияТоваровУслуг");

		Иначе	
			
			ДополнЗаголовки.Добавить("document_type",  ТипДокумента);	
			ДополнЗаголовки.Добавить("message_ver",    "2.2");		
			ДополнЗаголовки.Добавить("warehouse_id",   СокрЛП(ДокументОбъект.Склад.КодМДМ));
			ДополнЗаголовки.Добавить("counterpart_id", СокрЛП(ДокументОбъект.Контрагент.КодМДМ));
			ДополнЗаголовки.Добавить("app_Recipient_id", ПроверитьКонтрагентаДляВыгрузкиВУТ11(ДокументОбъект)); 
			
		КонецЕсли; 
		
	ИначеЕсли ИмяДокумента = "КорректировкаСборкиЗаказовПокупателя" Тогда
		
	ИначеЕсли ИмяДокумента = "КорректировкаРеализации" Тогда    
		
		//+Бычков О. 24.04.2025 #UT10-5207
		// Вставка
		Если КорректировкаРеализацииТоваровУслугДолжнаВыгружатьсяКакПеремещениеТоваровМеждуСкладами(Документ) Тогда
		
			ДополнЗаголовки.Добавить("document_type",  "ПеремещениеТоваровМеждуСкладами");	
			ДополнЗаголовки.Добавить("message_ver",    "2.0");			
			ДополнЗаголовки.Добавить("operation_type", "КорректировкаРеализации");
			
		Иначе
		//-Бычков О. 24.04.2025 #UT10-5207
		
			ДополнЗаголовки.Добавить("document_type",  ТипДокумента);	
			ДополнЗаголовки.Добавить("message_ver",    "2.2");		
			ДополнЗаголовки.Добавить("warehouse_id",   СокрЛП(ДокументОбъект.Склад.КодМДМ));
			ДополнЗаголовки.Добавить("counterpart_id", СокрЛП(ДокументОбъект.Контрагент.КодМДМ));
			ДополнЗаголовки.Добавить("app_Recipient_id", ПроверитьКонтрагентаДляВыгрузкиВУТ11(ДокументОбъект));

		//+Бычков О. 24.04.2025 #UT10-5207
		// Вставка
		КонецЕсли;
		//-Бычков О. 24.04.2025 #UT10-5207
	ИначеЕсли ИмяДокумента = "ОплатаОтПокупателяПлатежнойКартой" Тогда  
		
		ДополнЗаголовки.Добавить("document_type",  ТипДокумента);	
		ДополнЗаголовки.Добавить("message_ver",    "2.0");		
		ДополнЗаголовки.Добавить("counterpart_id", СокрЛП(ДокументОбъект.Контрагент.КодМДМ));
		
		Если ДокументОбъект.ДополнительныеСвойства.Свойство("app_Recipient_id") Тогда    
			ДополнЗаголовки.Добавить("app_Recipient_id", ДокументОбъект.ДополнительныеСвойства.app_Recipient_id); 
		Иначе                                                        
			ДополнЗаголовки.Добавить("app_Recipient_id", "ERP");   
		КонецЕсли;     
		
	ИначеЕсли ИмяДокумента = "СчетФактураВыданный" Тогда  
		
		ДополнЗаголовки.Добавить("document_type",  ТипДокумента);	
