Функция ПроверитьНужноЛиВыгружатьСчетФактуруПолученный(пДокумент)
//+Бычков О. 21.01.2026 #UT10-5642
// Вставка

	ТекРезультат = Не Константы.ОсновнаяОрганизация.Получить().ИНН = пДокумент.Контрагент.ИНН;

	Если ТекРезультат Тогда
		
		// по старой логике нужно выгружать, скорректируем с учётом новой логики
		ТекДокументОснование = пДокумент.ДокументОснование;
		
		Если ТипЗнч(ТекДокументОснование) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
			
			Если НужноВыгрузитьПоступлениеТоваровУслугКакПеремещениеТоваровМеждуСкладами(ТекДокументОснование) Тогда
				ТекРезультат = Ложь;
			КонецЕсли;
		
		ИначеЕсли ТипЗнч(ТекДокументОснование) = Тип("ДокументСсылка.КорректировкаПоступления") Тогда
			
			Если КорректировкаПоступленияТоваровУслугДолжнаВыгружатьсяКакПеремещениеТоваровМеждуСкладами(ТекДокументОснование) Тогда
				ТекРезультат = Ложь;
			КонецЕсли;
			
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат ТекРезультат;
	
//-Бычков О. 21.01.2026 #UT10-5642
КонецФункции

Функция ПроверитьНужноЛиВыгружатьСчетФактуруВыданный(пДокумент)
//+Бычков О. 21.01.2026 #UT10-5642
// Вставка

	ТекРезультат = Истина;
	
	Если ОбщегоНазначения.ЕстьРеквизитДокумента("Грузополучатель", пДокумент.ДокументОснование.Метаданные()) 
		И пДокумент.ДокументОснование.Грузополучатель.ОформлятьРеализацииКакВнутреннееПеремещение Тогда
		ТекРезультат = Ложь;
	КонецЕсли;
	
	Если ТекРезультат Тогда
		
		// по старой логике нужно выгружать, скорректируем с учётом новой логики
		ТекДокументОснование = пДокумент.ДокументОснование;
		
		Если ТипЗнч(ТекДокументОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			
			Если ЭтоРеализацияТоваровИУслугПоОрганизацииТОХ(ТекДокументОснование) Тогда
				ТекРезультат = Ложь;
			КонецЕсли;
		
		ИначеЕсли ТипЗнч(ТекДокументОснование) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
			
			Если КорректировкаРеализацииТоваровУслугДолжнаВыгружатьсяКакПеремещениеТоваровМеждуСкладами(ТекДокументОснование) Тогда
				ТекРезультат = Ложь;
			КонецЕсли;
			
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат ТекРезультат;
	
