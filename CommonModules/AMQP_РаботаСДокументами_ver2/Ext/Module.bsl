//+Бычков О. 23.10.2025 #UT10-5480
// Вставка

   	ТекРезультат = Ложь;
	
	ТекЗапросТОХ = Новый Запрос;
	
	ТекЗапросТОХ.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	                     |	МАКСИМУМ(РеализацияТоваровУслугТовары.ЗаказПокупателя.ДоговорПоставщикаТОХ) КАК ДоговорПоставщикаТОХ
	                     |ИЗ
	                     |	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	                     |ГДЕ
	                     |	РеализацияТоваровУслугТовары.Ссылка = &Ссылка
	                     |	И НЕ ЕСТЬNULL(РеализацияТоваровУслугТовары.ЗаказПокупателя.ДоговорПоставщикаТОХ, ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)";
	
	ТекЗапросТОХ.УстановитьПараметр("Ссылка", пДокументСсылка);
	
	ТекРезультатЗапросаТОХ = ТекЗапросТОХ.Выполнить();
	
	Если Не ТекРезультатЗапросаТОХ.Пустой() Тогда
		
		ТекВыборка = ТекРезультатЗапросаТОХ.Выбрать();
		
		Если ТекВыборка.Следующий() Тогда
		
			Если ЗначениеЗаполнено(ТекВыборка.ДоговорПоставщикаТОХ) Тогда
				ТекРезультат = Истина;
			КонецЕсли;
		
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ТекРезультат;

