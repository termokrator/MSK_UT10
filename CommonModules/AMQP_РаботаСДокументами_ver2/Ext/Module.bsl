	Запрос.УстановитьПараметр("ОтборПоКодам", ЗначениеЗаполнено(ДополнПараметры.КодыМДМ));
	Запрос.УстановитьПараметр("КодыМДМ", ДополнПараметры.КодыМДМ);
	//Дата выбрана по причине того, что ранее допускались ошибки в статусе документа и 
