	|	ЕСТЬNULL(ТребованиеНакладнаяМатериалы.СерияНоменклатуры.НомерГТД.Код, """") КАК НомерГТД,
	|	ЕСТЬNULL(ТребованиеНакладнаяМатериалы.СерияНоменклатуры.СтранаПроисхождения.КодМДМ, """") КАК КодМДМСтранаПроисхождения
	|ПОМЕСТИТЬ Товары
	|ИЗ
	|	Документ.ТребованиеНакладная.Материалы КАК ТребованиеНакладнаяМатериалы
	|ГДЕ
	|	ТребованиеНакладнаяМатериалы.Ссылка = &Ссылка";
	
	ВыгрузитьВыборку(ДокументОбъект, СтруктураДокумента, ТекстЗапроса);
	
	СтруктураДокумента.Вставить("ПометкаУдаления", ДокументОбъект.ПометкаУдаления); 
	
КонецПроцедуры

Процедура ЗаписатьСчетФактураПолученный(ДокументОбъект , СтруктураДокумента)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	СчетФактураПолученный.Организация.КодМДМГоловнойОрганизации КАК КодОрганизацииМДМ,
	|	СчетФактураПолученный.ВидСчетаФактуры = ЗНАЧЕНИЕ(Перечисление.ВидСчетаФактурыПолученного.Корректировочный) КАК Корректировочный,
	|	СчетФактураПолученный.ВалютаДокумента.КодМДМ КАК Валюта,
	|	СчетФактураПолученный.КодВидаОперации,
	|	СчетФактураПолученный.Исправление,
	|	СчетФактураПолученный.НомерИсправления,
	|	СчетФактураПолученный.ДатаИсправления,
	|	ЛОЖЬ КАК ПолученВЭлектронномВиде,
	|	СчетФактураПолученный.Контрагент,                                                  
	|	СчетФактураПолученный.ДокументОснование.ДоговорКонтрагента.КодМДМ КАК ДоговорКодМДМ, 
	|	СчетФактураПолученный.ДатаВходящегоДокумента КАК ДатаСоставления,
	|	СчетФактураПолученный.ДатаВходящегоДокумента КАК ДатаЗаписиКнигиПокупок, 
	|	ВЫБОР КОГДА СчетФактураПолученный.ВидСчетаФактуры = ЗНАЧЕНИЕ(Перечисление.ВидСчетаФактурыПолученного.Корректировочный) 
	|         ТОГДА ""18""
	|         ИНАЧЕ """"
	|   КОНЕЦ КАК КодВидаОперацииНаУменьшение, 
	|	СчетФактураПолученный.НомерВходящегоДокумента КАК НомерДокумента, 
	|	СчетФактураПолученный.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
	|	СчетФактураПолученный.Дата КАК ДатаДокумента,
	|	СчетФактураПолученный.ИсправляемыйСчетФактура КАК СчетФактураОснование,
	|	СчетФактураПолученный.КППКонтрагента,
	|	СчетФактураПолученный.Контрагент.ИНН КАК ИННКонтрагента
	|ИЗ
	|	Документ.СчетФактураПолученный КАК СчетФактураПолученный
	|ГДЕ
	|	СчетФактураПолученный.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СчетФактураПолученныйДокументыОснования.ДокументОснование,
	|	СчетФактураПолученныйДокументыОснования.Ссылка.ИсправляемыйСчетФактура КАК ИсходныйДокумент
	|ПОМЕСТИТЬ ДокументыОснования
	|ИЗ
	|	Документ.СчетФактураПолученный.ДокументыОснования КАК СчетФактураПолученныйДокументыОснования
	|ГДЕ
	|	СчетФактураПолученныйДокументыОснования.Ссылка = &Ссылка";
	
	ВыгрузитьВыборку(ДокументОбъект, СтруктураДокумента, ТекстЗапроса);
	
	СтруктураДокумента.Вставить("ПометкаУдаления", ДокументОбъект.ПометкаУдаления); 
	
	Если ДокументОбъект.ВидСчетаФактуры = Перечисления.ВидСчетаФактурыПолученного.Корректировочный 
	   И СтруктураДокумента.Свойство("ДокументыОснования") И ЗначениеЗаполнено(СтруктураДокумента.ДокументыОснования) Тогда  
		
		СтруктураИсходный = СтруктураДокумента.ДокументыОснования[0].ИсходныйДокумент;
		
		ДанныеСФИсх = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОбъект.ИсправляемыйСчетФактура, "НомерВходящегоДокумента, ДатаВходящегоДокумента");
		СтруктураИсходный.Номер = СОКРЛП(ДанныеСФИсх.НомерВходящегоДокумента);
		СтруктураИсходный.Дата  = Строка(ДанныеСФИсх.ДатаВходящегоДокумента);
		
		СтруктураДокумента.СчетФактураОснование.Номер = СОКРЛП(ДанныеСФИсх.НомерВходящегоДокумента); 
		СтруктураДокумента.СчетФактураОснование.Дата  = Строка(ДанныеСФИсх.ДатаВходящегоДокумента);
		
	КонецЕсли;				   
	
КонецПроцедуры

Процедура ЗаписатьРасходныйКассовыйОрдер(ДокументОбъект, СтруктураДокумента)

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	РасходныйКассовыйОрдер.Организация.КодМДМ КАК КодОрганизацииМДМ,
	|	РасходныйКассовыйОрдер.Организация.КодМДМГоловнойОрганизации КАК _КодГоловнойОрганизацииМДМ,
	|	РасходныйКассовыйОрдер.Касса.КодМДМ КАК КодКассыМДМ,
	|	РасходныйКассовыйОрдер.СуммаДокумента,
	|	ВЫБОР
	|		КОГДА РасходныйКассовыйОрдер.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРКО.ВозвратДенежныхСредствПокупателю)
	|			ТОГДА ""ВозвратОплатыКлиенту""
	|		КОГДА РасходныйКассовыйОрдер.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРКО.РасчетыПоКредитамИЗаймамСКонтрагентами)
	|			ТОГДА ""ОплатаПоКредитам""
	|		КОГДА РасходныйКассовыйОрдер.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРКО.ОплатаПоставщику)
	|			ТОГДА ""ОплатаПоставщику""
	|		КОГДА РасходныйКассовыйОрдер.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРКО.ПрочиеРасчетыСКонтрагентами)
	|			ТОГДА ""ОплатаПоставщику""
	|		КОГДА РасходныйКассовыйОрдер.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРКО.ВыдачаДенежныхСредствПодотчетнику)
	|			ТОГДА ""ВыдачаДенежныхСредствПодотчетнику""
	|		КОГДА РасходныйКассовыйОрдер.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРКО.ВыдачаДенежныхСредствКассеККМ)
	|			ТОГДА ""ВыдачаДенежныхСредствВДругуюКассу""
	|		КОГДА РасходныйКассовыйОрдер.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРКО.ВзносНаличнымиВБанк)
	|			ТОГДА ""ИнкассацияДенежныхСредствВБанк""
	|		КОГДА РасходныйКассовыйОрдер.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРКО.РасходДенежныхСредствПрочее)
	|			ТОГДА ""ВыплатаЗарплатыЧерезКассу""
	|		ИНАЧЕ ""ПрочаяВыдачаДенежныхСредств""
	|	КОНЕЦ КАК ХозяйственнаяОперация,
	|	ЕСТЬNULL(Контрагенты.КодМДМ, """") КАК КодКонтрагентаМДМ,
	|	РасходныйКассовыйОрдер.ВалютаДокумента.КодМДМ КАК Валюта,
	|	РасходныйКассовыйОрдер.Номер КАК НомерДокумента,
	|	РасходныйКассовыйОрдер.Дата КАК ДатаДокумента,
	|	РасходныйКассовыйОрдер.ШтампВерсии,
	|	РасходныйКассовыйОрдер.Проведен,
	|	"""" КАК ПодотчетноеЛицоКодМДМ,
	|	РасходныйКассовыйОрдер.Подразделение.КодМДМ КАК ПодразделениеКодМДМ,
	|	"""" КАК НомерВедомостиНаВыплатуЗарплаты,
	|	"""" КАК ДатаВедомостиНаВыплатуЗарплаты,
	|	РасходныйКассовыйОрдер.Выдать КАК Выдать,
	|	РасходныйКассовыйОрдер.Основание КАК Основание,
	|	РасходныйКассовыйОрдер.Приложение КАК Приложение,
	|	РасходныйКассовыйОрдер.ПоДокументу КАК ПоДокументу
	|ИЗ
	|	Документ.РасходныйКассовыйОрдер КАК РасходныйКассовыйОрдер
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО РасходныйКассовыйОрдер.Контрагент = Контрагенты.Ссылка
	|ГДЕ
	|	РасходныйКассовыйОрдер.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РасходныйКассовыйОрдерРасшифровкаПлатежа.ДоговорКонтрагента.Владелец.КодМДМПартнера КАК КодПартнераМДМ,
	|	РасходныйКассовыйОрдерРасшифровкаПлатежа.СуммаПлатежа КАК Сумма,
	|	РасходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка.ВалютаВзаиморасчетовРаботника.КодМДМ КАК ВалютаВзаиморасчетов,
	|	РасходныйКассовыйОрдерРасшифровкаПлатежа.СуммаВзаиморасчетов,
	|	РасходныйКассовыйОрдерРасшифровкаПлатежа.СтавкаНДС КАК СтавкаНДС,
	|	РасходныйКассовыйОрдерРасшифровкаПлатежа.СуммаНДС,
	|	"""" КАК КодДоговораКредитаИДепозитаМДМ,
	|	РасходныйКассовыйОрдерРасшифровкаПлатежа.ДоговорКонтрагента.КодМДМ КАК КодДоговораМДМ,
	|	РасходныйКассовыйОрдерРасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств.КодМДМ КАК КодСтатьиДвиженияДенежныхСредствМДМ,
	|	РасходныйКассовыйОрдерРасшифровкаПлатежа.ДокументРасчетовСКонтрагентом КАК ДокументРасчетовСКонтрагентом,
	|	1 КАК КурсВзаиморасчетов,
	|	"""" КАК ТипСуммы,
	|	"""" КАК ТипДоговора,
	|	"""" КАК ТипСрочности,
	|	"""" КАК СтатьяРасходовКодМДМ,            
	|	"""" КАК СчетРасходов                  
	|ИЗ
	|	Документ.РасходныйКассовыйОрдер.РасшифровкаПлатежа КАК РасходныйКассовыйОрдерРасшифровкаПлатежа
	|ГДЕ
	|	РасходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка = &Ссылка";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДокументОбъект.Ссылка);
	
	Массив = Запрос.ВыполнитьПакет();
	МассивПоддерживаемыхТипов = МассивПоддерживаемыхТиповJSON();
	
	РезультатПоШапке = Массив[Массив.ВГраница() - 1];
	
	Выборка = РезультатПоШапке.Выбрать();
	
	Пока Выборка.Следующий() Цикл 
		ЗаполнитьКоллекциюЗначений(СтруктураДокумента, Выборка, РезультатПоШапке.Колонки, МассивПоддерживаемыхТипов); 
	КонецЦикла;                                                                           
	
	Если ЗначениеЗаполнено(СокрЛП(Выборка._КодГоловнойОрганизацииМДМ)) Тогда      
		СтруктураДокумента.Вставить("КодОрганизацииМДМ", Выборка._КодГоловнойОрганизацииМДМ); 
	КонецЕсли;
	
	МассивРасшифровкаПлатежа = Новый Массив;
	РезультатПоРасшифровкеПлатежа = Массив[Массив.ВГраница()];    
	
	Выборка = РезультатПоРасшифровкеПлатежа.Выбрать();
	
	Пока Выборка.Следующий() Цикл  
		
		Структура = Новый Структура; 
		ЗаполнитьКоллекциюЗначений(Структура, Выборка, РезультатПоРасшифровкеПлатежа.Колонки, МассивПоддерживаемыхТипов);		
		Структура.Вставить("КодОрганизацииМДМ", СтруктураДокумента.КодОрганизацииМДМ);
		
		МассивРасшифровкаПлатежа.Добавить(Структура);
		
	КонецЦикла;
	
	СтруктураДокумента.Вставить("РасшифровкаПлатежа", МассивРасшифровкаПлатежа);
	СтруктураДокумента.Вставить("ПометкаУдаления", ДокументОбъект.ПометкаУдаления); 
	СтруктураДокумента.Вставить("ЧекККМ", ?(ЗначениеЗаполнено(ДокументОбъект.НомерЧекаККМ), 1, 0)); 	

КонецПроцедуры

Процедура ЗаписатьАктВыполненныхРабот(ДокументОбъект , СтруктураДокумента)
	
	СуммаПоТЧУслуги = ДокументОбъект.Услуги.Итог("Сумма");
	
	СтруктураДокумента.Вставить("ХозяйственнаяОперация"			  , "ЗакупкаУПоставщика");
	СтруктураДокумента.Вставить("ОрганизацияКодМДМ"	   			  , СокрЛП(ДокументОбъект.Организация.КодМДМГоловнойОрганизации));
	СтруктураДокумента.Вставить("БанковскийСчетОрганизацииКодМДМ" , "");
	СтруктураДокумента.Вставить("КонтрагентКодМДМ"				  , СокрЛП(ДокументОбъект.Контрагент.КодМДМ));
	СтруктураДокумента.Вставить("ПартнерКодМДМ"					  , СокрЛП(ДокументОбъект.Контрагент.КодМДМПартнера));
	СтруктураДокумента.Вставить("ДоговорКодМДМ"                   , СокрЛП(ДокументОбъект.ДоговорКонтрагента.КодМДМ));
	СтруктураДокумента.Вставить("ПодразделениеКодМДМ"             , "");
	СтруктураДокумента.Вставить("СуммаДокумента"                  , СуммаПоТЧУслуги); 
	СтруктураДокумента.Вставить("СуммаОплаты"                     , ДокументОбъект.СуммаДокумента);
	СтруктураДокумента.Вставить("СуммаВзаиморасчетов"             , СуммаПоТЧУслуги);
	СтруктураДокумента.Вставить("ВалютаКодМДМ"                    , СокрЛП(ДокументОбъект.ДоговорКонтрагента.ВалютаВзаиморасчетов.КодМДМ));
	СтруктураДокумента.Вставить("ВалютаВзаиморасчетовКодМДМ"      , СокрЛП(ДокументОбъект.ДоговорКонтрагента.ВалютаВзаиморасчетов.КодМДМ));
	СтруктураДокумента.Вставить("ЦенаВключаетНДС"                 , ЛОЖЬ);
	СтруктураДокумента.Вставить("ФормаОплаты"                     , "");
	СтруктураДокумента.Вставить("ДатаОплаты"                      , "");
   	СтруктураДокумента.Вставить("НалогообложениеНДС"              , "ПродажаНеОблагаетсяНДС");
	СтруктураДокумента.Вставить("НомерВходящегоДокумента"         , ОбщегоНазначения.ПолучитьНомерНаПечать(ДокументОбъект, , Ложь));
	СтруктураДокумента.Вставить("ДатаВходящегоДокумента"          , Формат(ДокументОбъект.Дата, "ДЛФ=DT"));
	СтруктураДокумента.Вставить("ЗакупкаПодДеятельность"          , "");
	СтруктураДокумента.Вставить("ПорядокРасчетов"                 , "");
	СтруктураДокумента.Вставить("ПодотчетноеЛицоКодМДМ"           , "");
	СтруктураДокумента.Вставить("ОтветственныйКодМДМ"             , СокрЛП(ДокументОбъект.Ответственный.ФизЛицо.КодМДМ));
	СтруктураДокумента.Вставить("ДатаНачала"                  	  , Формат(ДокументОбъект.ДатаНачала, "ДЛФ=DT"));
	СтруктураДокумента.Вставить("ДатаОкончания"                   , Формат(КонецДня(ДокументОбъект.ДатаОкончания), "ДЛФ=DT"));
	
	Услуги = Новый Массив; 
	
	ЗапросТаблицыУслуг = Новый Запрос;
	ЗапросТаблицыУслуг.Текст = 
	"ВЫБРАТЬ
	|	АктВыполненныхРаботУслуги.Номенклатура КАК Товар,
	|	СУММА(АктВыполненныхРаботУслуги.Количество) КАК Количество,
	|	АктВыполненныхРаботУслуги.Тариф КАК Цена,
	|	СУММА(АктВыполненныхРаботУслуги.Сумма) КАК Сумма
	|ПОМЕСТИТЬ ВТ_Услуги
	|ИЗ
	|	Документ.АктВыполненныхРабот.Услуги КАК АктВыполненныхРаботУслуги
	|ГДЕ
	|	АктВыполненныхРаботУслуги.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	АктВыполненныхРаботУслуги.Номенклатура,
	|	АктВыполненныхРаботУслуги.Тариф
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Услуги.Товар.Наименование КАК Содержание,
	|	ВТ_Услуги.Количество,
	|	ВТ_Услуги.Цена,
	|	ВТ_Услуги.Сумма,
	|	ВТ_Услуги.Сумма КАК СуммаВзаиморасчетов,
	|	0 КАК СуммаНДС,
	|	0 КАК СуммаНДСВзаиморасчетов,
	|	ВТ_Услуги.Сумма КАК СуммаСНДС,
	|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС) КАК СтавкаНДС,
	|	"""" КАК ПодразделениеКодМДМ,
	|	"""" КАК СтатьяРасходов,
	|	"""" КАК АналитикаРасходов,
	|	"""" КАК КомментарийРаспределения,
	|	"""" КАК АналитикаАктивовПассивов
	|ИЗ
	|	ВТ_Услуги КАК ВТ_Услуги";
	
	ЗапросТаблицыУслуг.УстановитьПараметр("Ссылка", ДокументОбъект.Ссылка); 
	
	РезультатЗапросаТаблицыУслуг = ЗапросТаблицыУслуг.Выполнить();  
	
	ВыборкаЗапросаТаблицыУслуг = РезультатЗапросаТаблицыУслуг.Выбрать();
	
	Пока ВыборкаЗапросаТаблицыУслуг.Следующий() Цикл
		
		УслугиСтруктура = Новый Структура;
		
		УслугиСтруктура.Вставить("Содержание"       	    , "Услуги по ПГАТ за " + Формат(ДокументОбъект.ДатаНачала, "ДФ='MMMM yyyy'") + " (с " + Формат(ДокументОбъект.ДатаНачала, "ДФ=dd.MM.yyyy") + " по " + Формат(ДокументОбъект.ДатаОкончания, "ДФ=dd.MM.yyyy") + ")");    		
		УслугиСтруктура.Вставить("Количество"       	    , ВыборкаЗапросаТаблицыУслуг.Количество);
		УслугиСтруктура.Вставить("Цена"       	            , ВыборкаЗапросаТаблицыУслуг.Цена);
		УслугиСтруктура.Вставить("Сумма"       	            , ВыборкаЗапросаТаблицыУслуг.Сумма);
		УслугиСтруктура.Вставить("СуммаВзаиморасчетов"      , ВыборкаЗапросаТаблицыУслуг.СуммаВзаиморасчетов);
		УслугиСтруктура.Вставить("СуммаНДС"       	        , ВыборкаЗапросаТаблицыУслуг.СуммаНДС);
		УслугиСтруктура.Вставить("СуммаНДСВзаиморасчетов"   , ВыборкаЗапросаТаблицыУслуг.СуммаНДСВзаиморасчетов);
		УслугиСтруктура.Вставить("СуммаСНДС"       	        , ВыборкаЗапросаТаблицыУслуг.СуммаСНДС);
		УслугиСтруктура.Вставить("СтавкаНДС"       	        , УчетНДС.ПолучитьСтавкуНДС(ВыборкаЗапросаТаблицыУслуг.СтавкаНДС));
		УслугиСтруктура.Вставить("ПодразделениеКодМДМ"      , ВыборкаЗапросаТаблицыУслуг.ПодразделениеКодМДМ);
		УслугиСтруктура.Вставить("СтатьяРасходов"           , ВыборкаЗапросаТаблицыУслуг.СтатьяРасходов);
		УслугиСтруктура.Вставить("АналитикаРасходов"        , ВыборкаЗапросаТаблицыУслуг.АналитикаРасходов);
		УслугиСтруктура.Вставить("КомментарийРаспределения" , ВыборкаЗапросаТаблицыУслуг.КомментарийРаспределения);
		УслугиСтруктура.Вставить("АналитикаАктивовПассивов" , ВыборкаЗапросаТаблицыУслуг.АналитикаАктивовПассивов);
		
		Услуги.Добавить(УслугиСтруктура);
		
	КонецЦикла;	
	
	СтруктураДокумента.Вставить("Расходы" , Услуги);
	
	Файлы = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ХранилищеДополнительнойИнформации.Ссылка Как ФайлСсылка,
	|	ХранилищеДополнительнойИнформации.Наименование,
	|	ХранилищеДополнительнойИнформации.ПутьКФайлу,
	|	ХранилищеДополнительнойИнформации.ПометкаУдаления
	|ИЗ
	|	Справочник.ХранилищеДополнительнойИнформации КАК ХранилищеДополнительнойИнформации
	|ГДЕ
	|	ХранилищеДополнительнойИнформации.Объект = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка",ДокументОбъект.Ссылка); 
	
	Выб = Запрос.Выполнить().Выбрать();               
	
	Пока Выб.Следующий() Цикл                        
		
		Если Не ЗначениеЗаполнено(Выб.ПутьКФайлу) Тогда
			Продолжить;
		КонецЕсли;
		
		ФайлыСтруктура = Новый Структура;
		
		ФайлыСтруктура.Вставить("ТомХраненияФайлов"           , СокрЛП(Константы.ТомХраненияФайлов.Получить()));
		ФайлыСтруктура.Вставить("Наименование"                , СокрЛП(Выб.Наименование));
		ФайлыСтруктура.Вставить("ПутьКФайлу"                  , СокрЛП(Выб.ПутьКФайлу));
		ФайлыСтруктура.Вставить("ФайлУникальныйИдентификатор" , Строка(Выб.ФайлСсылка.УникальныйИдентификатор()));
		ФайлыСтруктура.Вставить("ПометкаУдаления"             , Выб.ПометкаУдаления);
		
		Файлы.Добавить(ФайлыСтруктура);   		
		
	КонецЦикла;    
	
	СтруктураДокумента.Вставить("Файлы", Файлы);
	
КонецПроцедуры

Процедура ЗаписатьАвансовыйОтчет(ДокументОбъект , СтруктураДокумента)
	
	МассивТипов = МассивПоддерживаемыхТиповJSON();
	
	СтруктураДокумента.Вставить("ОрганизацияКодМДМ"	   			  , СокрЛП(ДокументОбъект.Организация.КодМДМГоловнойОрганизации));
	СтруктураДокумента.Вставить("ПодотчетноеЛицоКодМДМ"           , СокрЛП(ДокументОбъект.ФизЛицо.КодМДМ));
	СтруктураДокумента.Вставить("ВалютаКодМДМ"				      , СокрЛП(ДокументОбъект.ВалютаДокумента.КодМДМ));
	СтруктураДокумента.Вставить("СуммаИзрасходовано"              , ДокументОбъект.СуммаДокумента); 
	СтруктураДокумента.Вставить("СуммаОтклонено"                  , 0);      
	СтруктураДокумента.Вставить("НазначениеАванса"                , ДокументОбъект.НазначениеАванса);
	СтруктураДокумента.Вставить("СтатусДокумента"                 , "");
	СтруктураДокумента.Вставить("ЦенаВключаетНДС"                 , ДокументОбъект.СуммаВключаетНДС);
	СтруктураДокумента.Вставить("КоличествоДокументов"            , ДокументОбъект.КоличествоДокументов);
	СтруктураДокумента.Вставить("КоличествоЛистов"                , ДокументОбъект.КоличествоЛистов);
	СтруктураДокумента.Вставить("ПодразделениеКодМДМ"             , ДокументОбъект.Подразделение.КодМДМ);   
	СтруктураДокумента.Вставить("БанковскийСчетКодМДМ"            , "");   
	СтруктураДокумента.Вставить("ДокументОснование"               , Неопределено);
	
	ПрочиеРасходы = Новый Массив; 
	ОплатаПоставщикам = Новый Массив; 
	
	Запрос = Новый Запрос;
	Запрос.Текст =   
	"ВЫБРАТЬ
	|	"""" КАК СтатьяДвиженияДенежныхСредствКодМДМ,
	|	АвансовыйОтчет.ВидДокВходящий КАК НаименованиеВходящегоДокумента,
	|	АвансовыйОтчет.НомерВходящегоДокумента,
	|	АвансовыйОтчет.ДатаВходящегоДокумента,
	|	АвансовыйОтчет.Сумма,
	|	АвансовыйОтчет.СтатьяЗатрат КАК СтатьяРасходов,
	|	АвансовыйОтчет.Подразделение КАК АналитикаРасходов,
	|	АвансовыйОтчет.Содержание КАК Комментарий,
	|	ЕСТЬNULL(АвансовыйОтчет.Подразделение.КодМДМ, """") КАК ПодразделениеКодМДМ,  
	|	АвансовыйОтчет.СтавкаНДС,
	|	АвансовыйОтчет.СуммаНДС,
	|	ВЫБОР
	|		КОГДА АвансовыйОтчет.Ссылка.НДСВключенВСтоимость
	|			ТОГДА АвансовыйОтчет.Сумма
	|		ИНАЧЕ АвансовыйОтчет.Сумма + АвансовыйОтчет.СуммаНДС
	|	КОНЕЦ КАК СуммаСНДС,
	|	ЕСТЬNULL(АвансовыйОтчет.Поставщик.КодМДМ, """") КАК КонтрагентКодМДМ
	|ИЗ
	|	Документ.АвансовыйОтчет.Прочее КАК АвансовыйОтчет
	|ГДЕ
	|	АвансовыйОтчет.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	"""" КАК СтатьяДвиженияДенежныхСредствКодМДМ,
	|	ЕСТЬNULL(АвансовыйОтчетОплатаПоставщикам.Контрагент.КодМДМ, """") КАК ПоставщикКодМДМ,
	|	ЕСТЬNULL(АвансовыйОтчетОплатаПоставщикам.Контрагент.КодМДМ, """") КАК КонтрагентКодМДМ,
	|	ЕСТЬNULL(АвансовыйОтчетОплатаПоставщикам.ДоговорКонтрагента.КодМДМ, """") КАК ДоговорКодМДМ,
	|	АвансовыйОтчетОплатаПоставщикам.Сумма,
	|	ЕСТЬNULL(АвансовыйОтчетОплатаПоставщикам.Ссылка.ВалютаДокумента.КодМДМ, """") КАК ВалютаВзаиморасчетовКодМДМ,
	|	АвансовыйОтчетОплатаПоставщикам.Сумма КАК СуммаВзаиморасчетов,
	|	АвансовыйОтчетОплатаПоставщикам.Содержание КАК Комментарий,
	|	АвансовыйОтчетОплатаПоставщикам.НомерВходящегоДокумента,
	|	АвансовыйОтчетОплатаПоставщикам.ДатаВходящегоДокумента
	|ИЗ
	|	Документ.АвансовыйОтчет.ОплатаПоставщикам КАК АвансовыйОтчетОплатаПоставщикам
	|ГДЕ
	|	АвансовыйОтчетОплатаПоставщикам.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументОбъект.Ссылка);  
	
	ВыпПакет = Запрос.ВыполнитьПакет();  
	
	Выборка = ВыпПакет[0].Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		УслугиСтруктура = Новый Структура;
		
		УслугиСтруктура.Вставить("СтатьяДвиженияДенежныхСредствКодМДМ" , Выборка.СтатьяДвиженияДенежныхСредствКодМДМ);    		
		УслугиСтруктура.Вставить("НаименованиеВходящегоДокумента"      , Выборка.НаименованиеВходящегоДокумента);
		УслугиСтруктура.Вставить("НомерВходящегоДокумента"       	   , Выборка.НомерВходящегоДокумента);
		УслугиСтруктура.Вставить("ДатаВходящегоДокумента"       	   , Строка(Выборка.ДатаВходящегоДокумента));
		УслугиСтруктура.Вставить("Сумма"                               , Выборка.Сумма);                               
		
		СтатьяРасходов = ЗначениеJSON(Выборка.СтатьяРасходов, МассивТипов);    
		СтатьяРасходов.Тип = "ПланВидовХарактеристик.СтатьиРасходов";
		УслугиСтруктура.Вставить("СтатьяРасходов"       	           , СтатьяРасходов);   
		
		АналитикаРасходов = ЗначениеJSON(Выборка.АналитикаРасходов, МассивТипов);
		АналитикаРасходов.Тип = "Справочник.СтруктураПредприятия";

		УслугиСтруктура.Вставить("АналитикаРасходов"       	           , АналитикаРасходов);
		УслугиСтруктура.Вставить("АналитикаАктивовПассивов"       	   , Неопределено);
		УслугиСтруктура.Вставить("Комментарий"                         , Выборка.Комментарий);  
		УслугиСтруктура.Вставить("СуммаНДС"       	                   , Выборка.СуммаНДС);
		УслугиСтруктура.Вставить("СуммаСНДС"       	                   , Выборка.СуммаСНДС);
		УслугиСтруктура.Вставить("СтавкаНДС"       	                   , УчетНДС.ПолучитьСтавкуНДС(Выборка.СтавкаНДС));
		УслугиСтруктура.Вставить("ПодразделениеКодМДМ"                 , Выборка.ПодразделениеКодМДМ);
		УслугиСтруктура.Вставить("КонтрагентКодМДМ"                    , Выборка.КонтрагентКодМДМ);
		
		ПрочиеРасходы.Добавить(УслугиСтруктура);
		
	КонецЦикла;	
	
	СтруктураДокумента.Вставить("ПрочиеРасходы", ПрочиеРасходы);
	
	Выборка = ВыпПакет[1].Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ОплатаСтруктура = Новый Структура;
		ОплатаСтруктура.Вставить("СтатьяДвиженияДенежныхСредствКодМДМ" , Выборка.СтатьяДвиженияДенежныхСредствКодМДМ);    		
		ОплатаСтруктура.Вставить("ПоставщикКодМДМ" ,                     Выборка.ПоставщикКодМДМ);    		
		ОплатаСтруктура.Вставить("КонтрагентКодМДМ" ,                    Выборка.КонтрагентКодМДМ);    		
		ОплатаСтруктура.Вставить("ДоговорКодМДМ" ,                       Выборка.ДоговорКодМДМ);    		
		ОплатаСтруктура.Вставить("Сумма" ,                               Выборка.Сумма);    		
		ОплатаСтруктура.Вставить("ВалютаВзаиморасчетовКодМДМ" ,          Выборка.ВалютаВзаиморасчетовКодМДМ);    		
		ОплатаСтруктура.Вставить("СуммаВзаиморасчетов" ,                 Выборка.СуммаВзаиморасчетов);    		
		ОплатаСтруктура.Вставить("Комментарий" ,                         Выборка.Комментарий);    	
		ОплатаСтруктура.Вставить("НомерВходящегоДокумента" ,             Выборка.НомерВходящегоДокумента);    		
		ОплатаСтруктура.Вставить("ДатаВходящегоДокумента" ,              Строка(Выборка.ДатаВходящегоДокумента));    		

		ОплатаПоставщикам.Добавить(ОплатаСтруктура);
		
	КонецЦикла;	
	
	СтруктураДокумента.Вставить("ОплатаПоставщикам", ОплатаПоставщикам);
		
КонецПроцедуры

