	СтруктураДокумента.Вставить("КодКонтрагентаМДМ", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ.Контрагент, "КодМДМ"));
	СтруктураДокумента.Вставить("КодПартнераМДМ", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ.Контрагент, "КодМДМПартнера"));
	СтруктураДокумента.Вставить("КодФилиалаМДМ", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ.Грузополучатель, "КодМДМ"));
	СтруктураДокумента.Вставить("КодДоговораМДМ", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ.ДоговорКонтрагента, "КодМДМ"));
	СтруктураДокумента.Вставить("КодСкладаМДМ", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ.СкладГруппа, "КодМДМ"));
	СтруктураДокумента.Вставить("СпособДоставки", Строка(Документ.СпособДоставки));
	СтруктураДокумента.Вставить("ИсточникЗаказа", Документ.ИсточникЗаказа.КодИсточника);
	СтруктураДокумента.Вставить("Сумма", Документ.СуммаДокумента);
	СтруктураДокумента.Вставить("СуммаНДС", Документ.Товары.Итог("СуммаНДС"));	
	СтруктураДокумента.Вставить("Валюта", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ.ВалютаДокумента, "КодМДМ"));
	
	Товары = Новый Массив;
	
	Для Каждого Стр Из Документ.Товары Цикл
		
		ТоварыСтруктура = Новый Структура;
		
		ТоварыСтруктура.Вставить("НомерСтроки", Стр.НомерСтроки);
		ТоварыСтруктура.Вставить("КодМДМНоменклатуры", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Стр.Номенклатура, "КодМДМ"));
		ТоварыСтруктура.Вставить("КодМДМЕдиницыИзмерения", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Стр.ЕдиницаИзмерения, "КодМДМ"));
		ТоварыСтруктура.Вставить("Количество", Стр.Количество);
		ТоварыСтруктура.Вставить("Цена", Стр.Цена);
		ТоварыСтруктура.Вставить("Сумма", Стр.Сумма);
		ТоварыСтруктура.Вставить("СуммаНДС", Стр.СуммаНДС);
		ТоварыСтруктура.Вставить("СтавкаНДС", УчетНДС.ПолучитьСтавкуНДС(Стр.СтавкаНДС));
		
		Товары.Добавить(ТоварыСтруктура);   		
		
	КонецЦикла;
	
	СтруктураДокумента.Вставить("Товары", Товары);
	//-Сёмин Р.И. 04.08.2026 #UT10-5985
	
КонецПроцедуры

///////////////////Вспомогательные процедуры///////////////////
Функция ДатуВTimestamp(Знач пДата = Неопределено) Экспорт
	
	Если ТипЗнч(пДата) = Тип("Дата") Тогда     
		пДата = УниверсальноеВремя(пДата);	  
	КонецЕсли;
	
	Возврат Формат(Число(?(ТипЗнч(пДата) = Тип("Дата"), пДата, УниверсальноеВремя(ТекущаяДата())) - Дата("19700101")), "ЧН=0; ЧГ=0");
	
КонецФункции

Процедура ОповеститьСерверМониторинга(Успешно, ЗаписыватьВЖурналОшибку = Истина, ИсходящееСообщение = Неопределено, ТекстОшибки = "", НомерСообщения = "") Экспорт 
	
	КодПрикладнойСистемы = ПолучитьКодПрикладнойСистемы();
	
	СтруктураСообщения = Новый Структура; 
	
	Если Не Успешно Тогда    
		
		СтруктураСообщения.Вставить("service", "doc-order-sending");
		СтруктураСообщения.Вставить("error", ?(ЗначениеЗаполнено(ТекстОшибки), ТекстОшибки, "Not estimated")); 	
		СтруктураСообщения.Вставить("solved", Успешно);
		
		СвойстваСтруктура = Новый Структура;
		СвойстваСтруктура.Вставить("app_id", КодПрикладнойСистемы);    					
		СтруктураСообщения.Вставить("props", СвойстваСтруктура); 
		
	Иначе        		                                          
		
		СвойстваСтруктура = Новый Структура;
		СвойстваСтруктура.Вставить("solved", Истина);    					
		СтруктураСообщения.Вставить("doc", СвойстваСтруктура); 
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИсходящееСообщение) Тогда 		
		
		Если Не Успешно И ЗначениеЗаполнено(ИсходящееСообщение.Сообщение) Тогда  
			
			СтруктураСообщения.Вставить("body", ИсходящееСообщение.Сообщение);
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(НомерСообщения) Тогда                    
			
			НомерСообщения = ИсходящееСообщение.УникальныйИдентификатор();  
			
		КонецЕсли;
		
	КонецЕсли;     
	
	Оповещен = AMQP_РаботаСоСправочниками.ОтправитьСообщениеВЭластик(СтруктураСообщения, НомерСообщения, ЗаписыватьВЖурналОшибку, "ОтправкаСообщений.Ошибка");
	
	Если Оповещен И Не Успешно Тогда   
		
		Если ЗначениеЗаполнено(ИсходящееСообщение) Тогда   
			
			Об = ИсходящееСообщение.ПолучитьОбъект();
			Об.БылаОшибка = Истина;
			Об.Записать(); 
			
		КонецЕсли;    
		
	КонецЕсли;  
	
КонецПроцедуры

Функция ПолучитьКодПрикладнойСистемы()
	
	Выборка = Справочники.ПодпискиНаОчередиСообщений.Выбрать();
	
	Если Выборка.Следующий() Тогда                    
		Возврат Лев(Выборка.ИмяОчереди, Найти(Выборка.ИмяОчереди, ".") - 1); 
	Иначе                     
		Возврат "Test";     
	КонецЕсли;
	
КонецФункции

Функция ЭтоСсылка(Значение)
	
	Если ТипЗнч(Значение) = Тип("Число") ИЛИ ТипЗнч(Значение) = Тип("Строка") ИЛИ ТипЗнч(Значение) = Тип("Дата") ИЛИ ТипЗнч(Значение) = Тип("Булево") Тогда  
		Возврат Ложь;   
	Иначе                
		Возврат Истина;   
	КонецЕсли;
	
КонецФункции

Процедура ЗаписатьРеквизитДокументаВСтруктуру(Структура, Документ, ИмяРеквизита, ИмяРеквизитаДоп = "", Представление = "") 	
	
	Если ОбщегоНазначения.ЕстьРеквизитДокумента(ИмяРеквизита, Документ.Метаданные()) Тогда
		
		Значение = Документ[ИмяРеквизита];
		ЭтоСсылка = ЭтоСсылка(Значение);			
		
		Если Не ЭтоСсылка Тогда    
			Структура.Вставить(?(ЗначениеЗаполнено(ИмяРеквизитаДоп), ИмяРеквизитаДоп, ИмяРеквизита), Значение);	
		Иначе   
			
			Если ЗначениеЗаполнено(ИмяРеквизитаДоп) Тогда 		
				
				ЗначениеДоп = Значение[ИмяРеквизитаДоп];  					
				Структура.Вставить(?(ЗначениеЗаполнено(Представление), Представление, ИмяРеквизитаДоп), ЗначениеДоп);	
				
			КонецЕсли;    
			
		КонецЕсли;   
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПрисвоитьШтрихКод(Владелец) Экспорт
	
	ТекЗапись = РегистрыСведений.Штрихкоды.СоздатьМенеджерЗаписи();
	ТекЗапись.Владелец = Владелец;
	ТекЗапись.ТипШтрихкода = ПланыВидовХарактеристик.ТипыШтрихкодов.EAN13;
	
	ШК = РаботаСТорговымОборудованием.СформироватьШтрихКод();
	ТекЗапись.Штрихкод = ?(ШК = Неопределено, "", ШК); 
	
	Попытка 
		
		ТекЗапись.Записать();
		Возврат Истина; 
		
	Исключение	
		Возврат Ложь; 		
	КонецПопытки;    	
	
КонецФУнкции

Процедура СформироватьЗаголовкиИСвойства_ПоступлениеТоваровУслуг(Заголовки, Свойства, ДокументОбъект) Экспорт

	Заголовки.Добавить("document_type",  ДокументОбъект.Ссылка.Метаданные().Имя);	
	Заголовки.Добавить("message_ver",    "2.0");
	
	Если ТипЗнч(ДокументОбъект.СкладОрдер) = Тип("СправочникСсылка.Склады") Тогда 
		Заголовки.Добавить("warehouse_id",   СокрЛП(ДокументОбъект.СкладОрдер.КодМДМ));  
	Иначе        
		Заголовки.Добавить("warehouse_id",   ""); 
	КонецЕсли;          
	
	Заголовки.Добавить("counterpart_id", СокрЛП(ДокументОбъект.Контрагент.КодМДМ));

КонецПроцедуры

Процедура ДобавитьДополнительныйЗаголовокДляОбособленныхПодразделений(ИмяДокумента, Документ, НовоеСообщение)

	ЗначениеОтбора = 0;  
	
	Если ИмяДокумента = "КорректировкаПоступления" Тогда 
		
		Если НЕ Константы.ПополнениеДляОбособленногоПодразделенияЮЛ.Получить() Тогда 
			ЗначениеОтбора = 0;           
		ИначеЕсли  Документ.Контрагент = Константы.ДопПоставщик.Получить() Тогда 
			ЗначениеОтбора = 1;  
		КонецЕсли;		      
		
	КонецЕсли;
	
	НоваяСтрока = НовоеСообщение.Заголовки.Добавить();
	НоваяСтрока.Наименование = "ReplenishmentSeparateSubdivisionLE";
	НоваяСтрока.Значение = ЗначениеОтбора;

КонецПроцедуры 

Функция НужноВыгрузитьПоступлениеТоваровУслугКакПеремещениеТоваровМеждуСкладами(Ссылка)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ПоступлениеТоваровУслуг.Ссылка
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО ПоступлениеТоваровУслуг.Организация = Организации.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО ПоступлениеТоваровУслуг.Контрагент = Контрагенты.Ссылка
	|ГДЕ
	|	Организации.ИНН = Контрагенты.ИНН
	|	И ПоступлениеТоваровУслуг.Ссылка = &Ссылка";
	
	Запрос = Новый Запрос(ТекстЗапроса); 
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции  

Функция ПроверитьУстановкуЦен(ПромДок)
	
	Возврат ПромДок.Ответственный = Справочники.Пользователи.НайтиПоКоду("robot")   
	ИЛИ ПромДок.Дата < НачалоДня(ТекущаяДата() - 86400*7)
	ИЛИ ЗначениеЗаполнено(ПромДок.ИДДокументаВСмежнойБазе);    
	
КонецФункции

Функция ПроверитьУстановкуЦенКонтрагентов(ПромДок)
	
	Возврат ПромДок.Контрагент = Константы.ОсновнойПоставщик.Получить()   
	ИЛИ ЗначениеЗаполнено(ПромДок.ИДДокументаВСмежнойБазе);    
	
КонецФункции 

Функция ПроверитьАктВыполненныхРабот(ПромДок) 
	
	Возврат НЕ (ПромДок.Организация = Константы.ОсновнаяОрганизация.Получить() 
	И ПромДок.Статус = Перечисления.СтатусАктаВыполненныхРабот.КОплате);  	
	
КонецФункции

// Позволяет определить, есть ли среди реквизитов объекта реквизит с переданным именем.
//
// Параметры:
//  ИмяРеквизита - Строка - имя реквизита;
//  МетаданныеОбъекта - ОбъектМетаданных - объект, в котором требуется проверить наличие реквизита.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьРеквизитОбъекта(ИмяРеквизита, МетаданныеОбъекта) Экспорт
	
	Возврат НЕ (МетаданныеОбъекта.Реквизиты.Найти(ИмяРеквизита) = Неопределено);
	
КонецФункции

// Определяет принадлежность объекта метаданных к ссылочному типу.
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных - объект, для которого необходимо определить принадлежность к заданному типу.
// 
//  Возвращаемое значение:
//   Булево.
//
Функция ЭтоОбъектСсылочногоТипа(ОбъектМетаданных) Экспорт
	
	ИмяОбъектаМетаданных = ОбъектМетаданных.ПолноеИмя();
	Позиция = Найти(ИмяОбъектаМетаданных, ".");  
	
	Если Позиция > 0 Тогда 
		
		ИмяБазовогоТипа = Лев(ИмяОбъектаМетаданных, Позиция - 1);
		Возврат ИмяБазовогоТипа = "Справочник"
		Или ИмяБазовогоТипа = "Документ"
		Или ИмяБазовогоТипа = "БизнесПроцесс"
		Или ИмяБазовогоТипа = "Задача"
		Или ИмяБазовогоТипа = "ПланСчетов"
		Или ИмяБазовогоТипа = "ПланОбмена"
		Или ИмяБазовогоТипа = "ПланВидовХарактеристик"
		Или ИмяБазовогоТипа = "ПланВидовРасчета";   
		
	Иначе 
		
		Возврат Ложь;   
		
	КонецЕсли;
	
КонецФункции

Функция МассивПоддерживаемыхТиповJSON() Экспорт
	
	Массив = Новый Массив;
	Массив.Добавить(Тип("Строка"));
	Массив.Добавить(Тип("Булево"));
	Массив.Добавить(Тип("Число"));
	Массив.Добавить(Тип("Структура"));
	Массив.Добавить(Тип("Соответствие"));
	Массив.Добавить(Тип("Массив"));
	Массив.Добавить(Тип("Неопределено"));
	
	Возврат Массив;  
	
КонецФункции 

Функция _XMLСтрока(Значение) Экспорт 
	
	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Результат = Строка(Значение);
	Иначе
		Результат = XMLСтрока(Значение);
	КонецЕсли;   
	
	Возврат Результат;     
	
КонецФункции 

Функция ЗначениеJSON(Значение , МассивПоддерживаемыхТипов) Экспорт 
	
	Если МассивПоддерживаемыхТипов.Найти(ТипЗнч(Значение)) <> Неопределено Тогда     
		Возврат Значение;
	КонецЕсли;                 
	
	Результат = Неопределено;
	
	МетаданныеОбъекта = Метаданные.НайтиПоТипу(ТипЗнч(Значение)); 
	
	Если МетаданныеОбъекта <> Неопределено И ЭтоОбъектСсылочногоТипа(МетаданныеОбъекта) Тогда    
		
		Результат = Новый Структура("Тип, Идентификатор", МетаданныеОбъекта.ПолноеИмя(), XMLСтрока(Значение));
		Результат.Вставить("Представление", Строка(Значение));
		
		МассивСвойств = Новый Массив;
		МассивСвойств.Добавить("КодМДМ");
		МассивСвойств.Добавить("Дата");
		МассивСвойств.Добавить("Номер");
		
		Массив = Новый Массив;
		
		Для Каждого Ключ Из МассивСвойств Цикл                		
			
			Если ЕстьРеквизитОбъекта(Ключ, МетаданныеОбъекта) Тогда 
				Массив.Добавить(Ключ);
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого Реквизит Из МетаданныеОбъекта.СтандартныеРеквизиты Цикл  
			
			Если МассивСвойств.Найти(Реквизит.Имя) <> Неопределено Тогда   
				Массив.Добавить(Реквизит.Имя);
			КонецЕсли;
			
		КонецЦикла;
		
		Если ЗначениеЗаполнено(Массив) Тогда
			
			Для Каждого КлючЗначение Из ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Значение, Массив) Цикл 
				Результат.Вставить(КлючЗначение.Ключ, _XMLСтрока(КлючЗначение.Значение));
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Результат = Неопределено Тогда    
		Результат = _XMLСтрока(Значение);  
	КонецЕсли;
	
	Возврат Результат;            
	
КонецФункции

Процедура ЗаполнитьКоллекциюЗначений(Структура, Выборка, Коллекция, МассивПоддерживаемыхТипов) Экспорт
	
	Для Каждого Ключ Из Коллекция Цикл
		
		Если ТипЗнч(Ключ) = Тип("КолонкаРезультатаЗапроса") Тогда
			Ключ = Ключ.Имя;
		КонецЕсли;
		
		Если Не Лев(Ключ, 1) = "_" Тогда   
			
			Значение = Выборка[Ключ];
			
			Если ТипЗнч(Значение) = Тип("РезультатЗапроса") Тогда
				Массив = Новый Массив;
				
				Если Не Значение.Пустой() Тогда  
					
					ВыборкаЗначений = Значение.Выбрать();  
					
					Пока ВыборкаЗначений.Следующий() Цикл  
						
						СтруктураЗначений = Новый Структура;
						ЗаполнитьКоллекциюЗначений(СтруктураЗначений, ВыборкаЗначений, Значение.Колонки, МассивПоддерживаемыхТипов);
						Массив.Добавить(СтруктураЗначений);
						
					КонецЦикла;
					
				Конецесли;
				
				Структура.Вставить(Ключ, Массив);
				
			Иначе
				Структура.Вставить(Ключ, ЗначениеJSON(Значение, МассивПоддерживаемыхТипов));
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;      
	
КонецПроцедуры 

Процедура ВыгрузитьВыборку(ДокументОбъект, СтруктураДокумента, ТекстЗапроса) Экспорт
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ДокументОбъект.Ссылка);
	
	МассивПоддерживаемыхТипов = МассивПоддерживаемыхТиповJSON();
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	ЗаполнитьКоллекциюЗначений(СтруктураДокумента, Выборка, Выборка.Владелец().Колонки, МассивПоддерживаемыхТипов);
	
	Для Каждого Таблица Из Запрос.МенеджерВременныхТаблиц.Таблицы Цикл  
		
		Результат = Таблица.ПолучитьДанные();
		Массив = Новый Массив;
		
		Если Не Результат.Пустой() Тогда   
			
			Выборка = Результат.Выбрать(); 
			
			Пока Выборка.Следующий() Цикл   
				
				Структура = Новый Структура;   
				ЗаполнитьКоллекциюЗначений(Структура, Выборка, Результат.Колонки, МассивПоддерживаемыхТипов);

				Массив.Добавить(Структура);
				
			КонецЦикла;
			
		КонецЕсли;
		
		СтруктураДокумента.Вставить(Таблица.ПолноеИмя, Массив);
		
	КонецЦикла;
	
КонецПроцедуры 

Функция ВКорректировкеЕстьИУвеличениеИУменьшениеКоличества(пКорректировка)

//+Бычков О. 23.04.2025 #UT10-5207
// Вставка
	ТекЗапрос = Новый Запрос;
	ТекЗапрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	                  |	ТоварыКорректировки.НомерСтроки КАК НомерСтрокиУвеличения
	                  |ИЗ
	                  |	Документ.КорректировкаПоступления.Товары КАК ТоварыКорректировки
	                  |ГДЕ
	                  |	ТоварыКорректировки.Ссылка = &Корректировка
	                  |	И ТоварыКорректировки.Количество > ТоварыКорректировки.КоличествоДоИзменения
	                  |;
	                  |
	                  |////////////////////////////////////////////////////////////////////////////////
	                  |ВЫБРАТЬ ПЕРВЫЕ 1
	                  |	ТоварыКорректировки.НомерСтроки КАК НомерСтрокиУвеличения
	                  |ИЗ
	                  |	Документ.КорректировкаПоступления.Товары КАК ТоварыКорректировки
	                  |ГДЕ
	                  |	ТоварыКорректировки.Ссылка = &Корректировка
	                  |	И ТоварыКорректировки.Количество < ТоварыКорректировки.КоличествоДоИзменения";
	
	ТекМетаданныеКорректировки = пКорректировка.Метаданные();
	
	ТекИмяТЧТовары = "Документ." + ТекМетаданныеКорректировки.Имя + ".Товары";
	
	Если Не ТекИмяТЧТовары = "Документ.КорректировкаПоступления.Товары" Тогда
		ТекЗапрос.Текст = СтрЗаменить(ТекЗапрос.Текст, "Документ.КорректировкаПоступления.Товары", ТекИмяТЧТовары);
	КонецЕсли;
	
	ТекЗапрос.УстановитьПараметр("Корректировка", пКорректировка);
	
	ТекРезультатыЗапроса = ТекЗапрос.ВыполнитьПакет();
	
	ТекЕстьИУвеличениеИУменьшениеКоличества = Не ТекРезультатыЗапроса[0].Пустой() И Не ТекРезультатыЗапроса[1].Пустой();
	
	Возврат ТекЕстьИУвеличениеИУменьшениеКоличества;
//-Бычков О. 23.04.2025 #UT10-5207	

