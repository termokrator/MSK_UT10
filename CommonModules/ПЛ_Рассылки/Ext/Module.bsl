Функция ПреобразоватьИзСтрокиJSONВСоответствие(Строка)
	
	Результат = Неопределено;
	
	ЧтениеJSON = Новый ЧтениеJSON;
	Попытка
		ЧтениеJSON.УстановитьСтроку(Строка);
		Результат = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();
	Исключение
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция УспехЗапроса(РезультатСоответствие, ОтветСервера, ТелоЗапроса = "")
	
	Если РезультатСоответствие.Получить("errors") <> Неопределено
		Или РезультатСоответствие.Получить("error") <> Неопределено Тогда
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Отправка уведомления о событии'"),
			УровеньЖурналаРегистрации.Предупреждение,,,
			ТелоЗапроса + "
				|" + ОтветСервера);
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции
