Функция ИнициализироватьСтруктуруПолейПодписчикаУнисендер()
	
	СтруктураПолей = Новый Структура("email, Name");
	
	Возврат СтруктураПолей;
	
КонецФункции

Функция ДанныеФайлаСтрокой(ДанныеФайла)
	
	Результат = "";
	
	ИмяФайла = ПолучитьИмяВременногоФайла();
	ДанныеФайла.Записать(ИмяФайла);
	
	ПотокЧтения = Новый ЧтениеТекста(ИмяФайла,,,, Ложь);
	
	ТекущаяСтрока = ПотокЧтения.ПрочитатьСтроку();
	Результат = ТекущаяСтрока;
	Пока ТекущаяСтрока <> Неопределено Цикл
		
		Результат = Результат + Символы.ПС;
		ТекущаяСтрока = ПотокЧтения.ПрочитатьСтроку();
		Результат = Результат + ТекущаяСтрока;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ОтправитьЗапросУнисендер(ПараметрыЗапроса, Соединение = Неопределено, Ключ)
	
	ПараметрыЗапроса.Вставить("api_key", Ключ);
	
	Если Соединение = Неопределено Тогда
		
		ssl = Новый ЗащищенноеСоединениеOpenSSL(
			Новый СертификатКлиентаWindows(),
				Новый СертификатыУдостоверяющихЦентровWindows());
		
		АдресСервера = "api.unisender.com/ru/api";
		Соединение = Новый HTTPСоединение(АдресСервера,,,,,, ssl);
	КонецЕсли;
	
	СтрокаЗапроса = СформироватьСтрокуДляPOSTЗапросаУнисендер(ПараметрыЗапроса);
	ИмяФайлаОтвета = ПолучитьИмяВременногоФайла("txt");
	
	ЗаголовокЗапроса = Новый Соответствие;
	ЗаголовокЗапроса.Вставить("Content-Type", "application/x-www-form-urlencoded");
	ЗаголовокЗапроса.Вставить("Accept-Language", "ru");
	ЗаголовокЗапроса.Вставить("Accept-Charset", "utf-8");
	ЗаголовокЗапроса.Вставить("Content-Language", "ru");
	ЗаголовокЗапроса.Вставить("Content-Charset", "utf-8");
	
	HTTPЗапрос = Новый HTTPЗапрос("/" + ПараметрыЗапроса.Запрос + "?format=json", ЗаголовокЗапроса);
	HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаЗапроса, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
	
	Соединение.ОтправитьДляОбработки(HTTPЗапрос, ИмяФайлаОтвета);
	
	ЧтениеТекста = Новый ЧтениеТекста(ИмяФайлаОтвета, "UTF-8");
	ОтветСервера = ЧтениеТекста.Прочитать();
	
	Результат = ПреобразоватьИзСтрокиJSONВСоответствие(ОтветСервера);
	
	Если Не УспехЗапроса(Результат, ОтветСервера, ПараметрыЗапроса.Запрос) Тогда
		Возврат Неопределено;
	Иначе
		Возврат Результат;
	КонецЕсли;
	
КонецФункции

Функция СформироватьСтрокуДляPOSTЗапросаУнисендер(ПараметрыЗапроса)
	
	ЭлементыСтрокиЗапроса = Новый Массив;
	
	СтрокаЗапроса = "";
	Для Каждого Параметр Из ПараметрыЗапроса Цикл
		
		Если Параметр.Ключ = "Запрос" Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрКлюч = Параметр.Ключ;
		ПараметрЗначение = Параметр.Значение;
		
		ПозАдреса = Найти(ПараметрКлюч, "email");
		Если ПозАдреса = 1 Тогда
			ПараметрКлюч = "email[" + Сред(Параметр.Ключ, 6) + "]";
		КонецЕсли;
		
		Кодировать = Ложь;
		ПозВложения = Найти(ПараметрКлюч, "attachments");
		Если ПозВложения = 1 Тогда
			ПараметрКлюч = "attachments[" + ПараметрЗначение.Имя + "]";
			ПараметрЗначение = ПолучитьСтрокуИзДвоичныхДанных(ПараметрЗначение.Данные, "ISO-8859-1");
			Кодировать = Истина;
		КонецЕсли;
		
		ПозПоляПодписчика = Найти(ПараметрКлюч, "fields");
		Если ПозПоляПодписчика = 1 Тогда
			Для каждого ЭлементСтруктурыПолей Из ПараметрЗначение Цикл
				ПараметрКлюч = "fields[" + ЭлементСтруктурыПолей.Ключ + "]";
				СтрокаЗапроса = ПараметрКлюч + "=" + КодироватьСтроку(ЭлементСтруктурыПолей.Значение, СпособКодированияСтроки.КодировкаURL);
				ЭлементыСтрокиЗапроса.Добавить(СтрокаЗапроса);
			КонецЦикла;
			Продолжить;
		КонецЕсли;
		
		ПозПолейПодписчика = Найти(ПараметрКлюч, "field_names");
		Если ПозПолейПодписчика = 1 Тогда
			Инд = 0;
			Для каждого ЭлементСписка Из ПараметрЗначение Цикл
				ЭлементПараметрКлюч = ПараметрКлюч + "[" + Строка(Инд) + "]";
				СтрокаЗапроса = ЭлементПараметрКлюч + "=" + КодироватьСтроку(ЭлементСписка, СпособКодированияСтроки.КодировкаURL);
				ЭлементыСтрокиЗапроса.Добавить(СтрокаЗапроса);
				Инд = Инд + 1;
			КонецЦикла;
			Продолжить;
		КонецЕсли;
		
		ПозПолейДанныхПодписчика = Найти(ПараметрКлюч, "data");
		Если ПозПолейДанныхПодписчика = 1 Тогда
			СтруктураПолей = ПараметрыЗапроса["field_names"];
			Инд1 = 0;
			Для каждого ЭлементСписка Из ПараметрЗначение Цикл
				Инд2 = 0;
				Для каждого ЭлементСтруктурыПолей Из СтруктураПолей Цикл
					ЭлементПараметрКлюч = ПараметрКлюч + "[" + Строка(Инд1) + "]" + "[" + Строка(Инд2) + "]";
					СтрокаЗапроса = ЭлементПараметрКлюч + "=" + КодироватьСтроку(ЭлементСписка[ЭлементСтруктурыПолей], СпособКодированияСтроки.КодировкаURL);
					ЭлементыСтрокиЗапроса.Добавить(СтрокаЗапроса);
					Инд2 = Инд2 + 1;
				КонецЦикла;
				Инд1 = Инд1 + 1;
			КонецЦикла;
			Продолжить;
		КонецЕсли;
		
		Если Кодировать Тогда
			СтрокаЗапроса = ПараметрКлюч + "=" + КодироватьСтроку(ПараметрЗначение, СпособКодированияСтроки.КодировкаURL, "ISO-8859-1");
		Иначе
			СтрокаЗапроса = ПараметрКлюч + "=" + КодироватьСтроку(ПараметрЗначение, СпособКодированияСтроки.КодировкаURL);
		КонецЕсли;
		
		ЭлементыСтрокиЗапроса.Добавить(СтрокаЗапроса);
	КонецЦикла;
	
	Возврат ПЛ_УведомленияОСобытиях.СтрокаИзМассиваПодстрок(ЭлементыСтрокиЗапроса, "&");
	
КонецФункции

