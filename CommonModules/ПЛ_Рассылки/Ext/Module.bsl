КонецФункции

Функция ЗапросСообщениеСендсейТранзакция(Сообщение)
	
	ТелоПисьма = Новый Структура;
	
	Если Сообщение.ОбычныйТекст Тогда
		ТелоПисьма.Вставить("text", Сообщение.Текст);
	Иначе
		ТелоПисьма.Вставить("html", Сообщение.Текст);
	КонецЕсли;
	
	Письмо = Новый Структура;
	Письмо.Вставить("subject", Сообщение.Тема);
	Письмо.Вставить("from__name", Сообщение.ИмяОтправителя);
	Письмо.Вставить("from__email", Сообщение.ОбратныйАдрес);
	Письмо.Вставить("reply__email", Сообщение.ОбратныйАдрес);
	Письмо.Вставить("message", ТелоПисьма);
	
	Вложения = Новый Массив;
	
	Если Сообщение.ПечатныеФормы <> Неопределено Тогда
		Для каждого ПечатнаяФорма Из Сообщение.ПечатныеФормы Цикл
			Если ПечатнаяФорма.ДвоичныеДанные <> Неопределено Тогда
				
				НовоеВложение = Новый Структура;
				НовоеВложение.Вставить("name", ПечатнаяФорма.ИмяФайла);
				НовоеВложение.Вставить("content", Base64Строка(ПечатнаяФорма.ДвоичныеДанные));
				НовоеВложение.Вставить("encoding", "base64");
				Вложения.Добавить(НовоеВложение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если Сообщение.ПрисоединенныеФайлы <> Неопределено Тогда
		Для каждого ПрисоединенныйФайл Из Сообщение.ПрисоединенныеФайлы Цикл
			ДанныеПрисоединенногоФайла = ПрисоединенныйФайл.Вложение.Получить();
			Если ДанныеПрисоединенногоФайла <> Неопределено Тогда
				
				НовоеВложение = Новый Структура;
				НовоеВложение.Вставить("name", ПрисоединенныйФайл.Имя);
				НовоеВложение.Вставить("content", Base64Строка(ДанныеПрисоединенногоФайла));
				НовоеВложение.Вставить("encoding", "base64");
				Вложения.Добавить(НовоеВложение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если Вложения.Количество() Тогда
		Письмо.Вставить("attaches", Вложения);
	КонецЕсли;
	
	Тело = Новый Структура;
	Тело.Вставить("action", "issue.send");
	Тело.Вставить("letter", Письмо);
	
	Тело.Вставить("group", "personal");
	Тело.Вставить("sendwhen", "now");
	Тело.Вставить("email", Сообщение.АдресатыРасширенно[0].Адрес);
	
	Возврат Тело;
	
КонецФункции

Функция ЗапросСообщениеСендсейЭкспрессВыпуск(Сообщение)
	
	ТелоПисьма = Новый Структура;
	
	Если Сообщение.ОбычныйТекст Тогда
		ТелоПисьма.Вставить("text", Сообщение.Текст);
	Иначе
		ТелоПисьма.Вставить("html", Сообщение.Текст);
	КонецЕсли;
	
	Письмо = Новый Структура;
	Письмо.Вставить("subject", Сообщение.Тема);
	Письмо.Вставить("from__name", Сообщение.ИмяОтправителя);
	Письмо.Вставить("from__email", Сообщение.ОбратныйАдрес);
	Письмо.Вставить("reply__email", Сообщение.ОбратныйАдрес);
	Письмо.Вставить("message", ТелоПисьма);
	
	Вложения = Новый Массив;
	
	Если Сообщение.ПечатныеФормы <> Неопределено Тогда
		Для каждого ПечатнаяФорма Из Сообщение.ПечатныеФормы Цикл
			Если ПечатнаяФорма.ДвоичныеДанные <> Неопределено Тогда
				
				НовоеВложение = Новый Структура;
				НовоеВложение.Вставить("name", ПечатнаяФорма.ИмяФайла);
				НовоеВложение.Вставить("content", Base64Строка(ПечатнаяФорма.ДвоичныеДанные));
				НовоеВложение.Вставить("encoding", "base64");
				Вложения.Добавить(НовоеВложение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если Сообщение.ПрисоединенныеФайлы <> Неопределено Тогда
		Для каждого ПрисоединенныйФайл Из Сообщение.ПрисоединенныеФайлы Цикл
			ДанныеПрисоединенногоФайла = ПрисоединенныйФайл.Вложение.Получить();
			Если ДанныеПрисоединенногоФайла <> Неопределено Тогда
				
				НовоеВложение = Новый Структура;
				НовоеВложение.Вставить("name", ПрисоединенныйФайл.Имя);
				НовоеВложение.Вставить("content", Base64Строка(ДанныеПрисоединенногоФайла));
				НовоеВложение.Вставить("encoding", "base64");
				Вложения.Добавить(НовоеВложение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если Вложения.Количество() Тогда
		Письмо.Вставить("attaches", Вложения);
	КонецЕсли;
	
	Тело = Новый Структура;
	Тело.Вставить("action", "issue.send");
	Тело.Вставить("letter", Письмо);
	
	СписокПолучателей = Новый Массив;
	
	Для каждого Подписчик Из Сообщение.АдресатыРасширенно Цикл
		
		АдресПолучателя = Новый Структура;
		АдресПолучателя.Вставить("email", Подписчик.Адрес);
		
		НовыйПолучатель = Новый Структура;
		НовыйПолучатель.Вставить("member", АдресПолучателя);
		
		СписокПолучателей.Добавить(НовыйПолучатель);
	КонецЦикла;
	
	Тело.Вставить("group", "masssending");
	Тело.Вставить("sendwhen", "now");
	Тело.Вставить("users__list", СписокПолучателей);
	
	Возврат Тело;
	
КонецФункции

