Функция ЗапросСообщениеУнисендерСоздатьКампанию(Сообщение,  ИдСообщения)
	
	Тело = Новый Структура;
	Тело.Вставить("Запрос", "createCampaign");
	
	Тело.Вставить("message_id", СтрЗаменить(Строка(ИдСообщения), Символ(160), ""));
	Тело.Вставить("track_read", 1);
	Тело.Вставить("track_links", 1);
	
	Контакты = "";
	Для каждого ЭлементМассива Из Сообщение.АдресатыРасширенно Цикл
		Контакты = Контакты + ЭлементМассива.Адрес + ", ";
	КонецЦикла;
	
	Тело.Вставить("contacts", Контакты);
	Тело.Вставить("defer", 1);
	
	Возврат Тело;
	
КонецФункции

Функция ЗапросСообщениеУнисендерРассылка(Сообщение, КодПодписки)
	
	ТекстСообщения = Сообщение.Текст;
	
	Тело = Новый Структура;
	Тело.Вставить("Запрос", "createEmailMessage");
	
	Тело.Вставить("sender_name", Сообщение.ИмяОтправителя);
	Тело.Вставить("sender_email", Сообщение.ОбратныйАдрес);
	Тело.Вставить("subject", Сообщение.Тема);
	Тело.Вставить("list_id", ЧислоСтрокой(КодПодписки));
	Тело.Вставить("generate_text", 1);
	Тело.Вставить("message_format", "raw_html");
	
	// Вложения
	Инд = 1;
	Если Сообщение.ПрисоединенныеФайлы <> Неопределено Тогда
		Для каждого ПрисоединенныйФайл Из Сообщение.ПрисоединенныеФайлы Цикл
			ДанныеПрисоединенногоФайла = ПрисоединенныйФайл.Вложение.Получить();
			Если ДанныеПрисоединенногоФайла <> Неопределено Тогда
				
				НовоеВложение = Новый Структура;
				НовоеВложение.Вставить("Имя", ПрисоединенныйФайл.Имя);
				НовоеВложение.Вставить("Данные", ДанныеПрисоединенногоФайла);
				Тело.Вставить("attachments" + Инд, НовоеВложение);
				Инд = Инд + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Для каждого СтрокаВложения Из Сообщение.ТаблицаВложений Цикл
		ДанныеПрисоединенногоФайла = СтрокаВложения.Вложение.Получить();
		Если ДанныеПрисоединенногоФайла <> Неопределено Тогда
			
			НовоеВложение = Новый Структура;
			
			НовоеИмяФайла = СтрокаЛатиницей(СтрЗаменить(СтрокаВложения.Имя, ".", Строка(Инд) + "."));
			
			НовоеВложение.Вставить("Имя", НовоеИмяФайла);
			НовоеВложение.Вставить("Данные", ДанныеПрисоединенногоФайла);
			Тело.Вставить("attachments" + Инд, НовоеВложение);
			
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "cid:" + СтрокаВложения.Идентификатор, Строка(Инд) + "_" + НовоеИмяФайла);
			
			Инд = Инд + 1;
		КонецЕсли;
	КонецЦикла;
	
	Тело.Вставить("body", ТекстСообщения);
	
	Возврат Тело;
	
КонецФункции

Функция ЗапросСообщениеУнисендерТранзакция(Сообщение, КодПодписки)
	
	Тело = Новый Структура;
	Тело.Вставить("Запрос", "sendEmail");
	
	Инд = 0;
	Для каждого ЭлементМассива Из Сообщение.АдресатыРасширенно Цикл
		Тело.Вставить("email" + Инд, ЭлементМассива.Адрес);
		Инд = Инд + 1;
	КонецЦикла;
	
	Тело.Вставить("track_read", 1);
	Тело.Вставить("error_checking", 1);
	Тело.Вставить("sender_email", Сообщение.ОбратныйАдрес);
	Тело.Вставить("sender_name", Сообщение.ИмяОтправителя);
	Тело.Вставить("subject", Сообщение.Тема);
	Тело.Вставить("body", Сообщение.Текст);
	Тело.Вставить("list_id", ЧислоСтрокой(КодПодписки));
	
	// В sendEmail вложения почему-то не передаются - возвращает ошибку...
	
	Возврат Тело;
	
КонецФункции

Функция ЗапросСообщениеУнисендерЭкспортироватьПодписчиков(Адресаты)
	
	Тело = Новый Структура;
	Тело.Вставить("Запрос", "importContacts");
	
	ИменаПолей = Новый Массив;
	СтруктураПолей = ИнициализироватьСтруктуруПолейПодписчикаУнисендер();
	Для каждого ЭлементСтруктуры Из СтруктураПолей Цикл
		ИменаПолей.Добавить(ЭлементСтруктуры.Ключ);
	КонецЦикла;
	
	Тело.Вставить("field_names", ИменаПолей);
	
	ДанныеПодписчиков = Новый Массив;
	Для каждого СтрокаАдресата Из Адресаты Цикл
		СтруктураАдресата = ИнициализироватьСтруктуруПолейПодписчикаУнисендер();
		СтруктураАдресата.Вставить("email", СтрокаАдресата.Адрес);
		СтруктураАдресата.Вставить("Name", Строка(СтрокаАдресата.Адресат));
		ДанныеПодписчиков.Добавить(СтруктураАдресата);
	КонецЦикла;
	
	Тело.Вставить("data", ДанныеПодписчиков);
	
	Возврат Тело;
	
КонецФункции

Функция ЗапросСообщениеУнисендерПодписатьНаРассылку(КодПодписки, АдресПодписчика)
	
	Тело = Новый Структура;
