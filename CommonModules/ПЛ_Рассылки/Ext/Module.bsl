Функция ОтправитьЗапросСендсей(ТелоЗапроса, Соединение = Неопределено, Сессия = Неопределено, ИмяХоста = "")
	
	Если Сессия <> Неопределено Тогда
		ТелоЗапроса.Вставить("session", Сессия);
	КонецЕсли;
	
	ПараметрыЗапроса = ПараметрыЗапросаСендсей(JSONИзТела(ТелоЗапроса));
	
	Если Соединение = Неопределено Тогда
		
		ssl = Новый ЗащищенноеСоединениеOpenSSL(
			Новый СертификатКлиентаWindows(),
				Новый СертификатыУдостоверяющихЦентровWindows());
		
		АдресСервера = "api.sendsay.ru" + ИмяХоста;
		Соединение = Новый HTTPСоединение(АдресСервера,,,,,, ssl);
	КонецЕсли;
	
	ИмяФайлаЗапроса = СформироватьФайлДляPOSTЗапросаСендсей(ПараметрыЗапроса);
	ИмяФайлаОтвета = ПолучитьИмяВременногоФайла("txt");
	
	ЗаголовокЗапроса = Новый Соответствие;
	ЗаголовокЗапроса.Вставить("Content-Type", "application/x-www-form-urlencoded");
	ЗаголовокЗапроса.Вставить("Content-Length", XMLСтрока(РазмерФайла(ИмяФайлаЗапроса)));
	
	Соединение.ОтправитьДляОбработки(ИмяФайлаЗапроса,, ИмяФайлаОтвета, ЗаголовокЗапроса);
	
	УдалитьФайлы(ИмяФайлаЗапроса);
	
	ЧтениеТекста = Новый ЧтениеТекста(ИмяФайлаОтвета);
	ОтветСервера = ЧтениеТекста.Прочитать();
	
	Результат = ПреобразоватьИзСтрокиJSONВСоответствие(ОтветСервера);
	
	Если Не УспехЗапроса(Результат, ОтветСервера, ПараметрыЗапроса.request) Тогда
		Возврат Неопределено;
	Иначе
		Возврат Результат;
	КонецЕсли;
	
КонецФункции

Функция ПараметрыЗапросаСендсей(ТекстЗапроса)
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("apiversion", 100);
	ПараметрыЗапроса.Вставить("json", 1);
	ПараметрыЗапроса.Вставить("request", ТекстЗапроса);
	
	Возврат ПараметрыЗапроса;
	
КонецФункции

Функция СформироватьФайлДляPOSTЗапросаСендсей(ПараметрыЗапроса)
	
	СтрокаЗапроса = "";
	Для Каждого Параметр Из ПараметрыЗапроса Цикл
		Если Не ПустаяСтрока(СтрокаЗапроса) Тогда
			СтрокаЗапроса = СтрокаЗапроса + "&";
		КонецЕсли;
		СтрокаЗапроса = СтрокаЗапроса + Параметр.Ключ + "=" + КодироватьСтроку(Параметр.Значение, СпособКодированияСтроки.КодировкаURL);
	КонецЦикла;
	
	ИмяФайлаЗапроса = ПолучитьИмяВременногоФайла("txt");
	
	ФайлЗапроса = Новый ЗаписьТекста(ИмяФайлаЗапроса, КодировкаТекста.ANSI);
	ФайлЗапроса.Записать(СтрокаЗапроса);
	ФайлЗапроса.Закрыть();
	
	Возврат ИмяФайлаЗапроса;
	
КонецФункции

// Запросы UniSender

Функция ПолучитьСпискиРассылок(Соединение, Ключ)
	
	Результат = Новый Структура;
	
	ПараметрыЗапроса = ЗапросПолучениеСписковРассылокУнисендер();
	Результат = ОтправитьЗапросУнисендер(ПараметрыЗапроса, Соединение, Ключ);
	
	Если Результат <> Неопределено Тогда
		Возврат Результат.Получить("result");
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция СоздатьСписокРассылки(Событие, Соединение, Ключ)
	
	ПараметрыЗапроса = ЗапросСозданиеСпискаРассылкиУнисендер(Строка(Событие));
	Результат = ОтправитьЗапросУнисендер(ПараметрыЗапроса, Соединение, Ключ);
	
	Если Результат <> Неопределено Тогда
		Результат = Результат.Получить("result");
		Если Результат <> Неопределено Тогда
			Если ТипЗнч(Результат) = Тип("Соответствие") Тогда
				Возврат Результат.Получить("id");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ОтправитьСообщенияУнисендер(Сообщения, Настройки)
	
	Результат = Новый Структура("ОтправленныеСообщения, ОписаниеОшибки", Новый Массив, "");
	
	Ключ = Настройки.ЛогинПочтовойРассылки;
	Если Не ЗначениеЗаполнено(Ключ) Тогда
		Результат.ОписаниеОшибки = НСтр("ru = 'Не заполнены настройки соединения с сервисом рассылки.'");
		Возврат Результат;
	КонецЕсли;
	
	Соединение = Неопределено;
	
	Для каждого Сообщение Из Сообщения Цикл
		
		СобытиеНайдено = Ложь;
		
		// Получим код подписки - группы рассылок
		КодПодписки = Справочники.ПЛ_События.РеквизитыСобытия(Сообщение.Событие).КодПодписки;
		Если Не ЗначениеЗаполнено(КодПодписки) Тогда
			СобытиеНайдено = Ложь;
		Иначе
			СпискиРассылок = ПолучитьСпискиРассылок(Соединение, Ключ);
			Если СпискиРассылок <> Неопределено Тогда
				Для каждого ЭлементСписка Из СпискиРассылок Цикл
					Код = ЭлементСписка.Получить("id");
					Если Код <> Неопределено И КодПодписки = Код Тогда
						СобытиеНайдено = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
		Если Не СобытиеНайдено Тогда
			КодПодписки = СоздатьСписокРассылки(Сообщение.Событие, Соединение, Ключ);
			Если КодПодписки <> Неопределено Тогда
				ОбъектСобытие = Сообщение.Событие.ПолучитьОбъект();
				Попытка
					ОбъектСобытие.Заблокировать();
					ОбъектСобытие.КодПодписки = КодПодписки;
					ОбъектСобытие.Записать();
				Исключение
					Результат.ОписаниеОшибки = НСтр("ru = 'Не удалось заблокировать для записи событие %1'");
					
					ЗаписьЖурналаРегистрации(НСтр("ru = 'Отправка уведомления о событии'"),
						УровеньЖурналаРегистрации.Предупреждение,,,
						ПЛ_УведомленияОСобытиях.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось заблокировать для записи событие %1'"), Сообщение.Событие));
					Возврат Результат;
				КонецПопытки;
			Иначе
				Результат.ОписаниеОшибки = НСтр("ru = 'Не удалось создать список рассылки.'");
				Возврат Результат;
			КонецЕсли;
		КонецЕсли;
		
		Если Сообщение.ИсточникСобытия = Перечисления.ПЛ_ИсточникиСобытий.Рассылка Тогда // Экспресс выпуск
			
			РезультатЭкспорта = ЭкспортироватьПодписчиковУнисендер(Сообщение.АдресатыРасширенно, Соединение, Ключ);
			Если РезультатЭкспорта <> Неопределено Тогда
				ПодписатьНаРассылкуУнисендер(КодПодписки, Сообщение.АдресатыРасширенно, Соединение, Ключ);
			КонецЕсли;
			
			ПараметрыЗапроса = ЗапросСообщениеУнисендерРассылка(Сообщение, КодПодписки);
			Ответ = ОтправитьЗапросУнисендер(ПараметрыЗапроса, Соединение, Ключ);
			
			Если Ответ <> Неопределено Тогда
				
				Попытка
					ИдСообщения = Ответ.Получить("result").Получить("message_id");
				Исключение
					ТекстОшибки = НСтр("ru = 'Не удалось получить идентификатор сообщения UniSender для отправки.'");
					
					ЗаписьЖурналаРегистрации(НСтр("ru = 'Отправка уведомления о событии'"),
						УровеньЖурналаРегистрации.Предупреждение,,,
						ТекстОшибки);
						
					Результат.ОписаниеОшибки = ТекстОшибки;
					Возврат Результат;
				КонецПопытки;
				
				ПараметрыЗапроса = ЗапросСообщениеУнисендерСоздатьКампанию(Сообщение, ИдСообщения);
				Ответ = ОтправитьЗапросУнисендер(ПараметрыЗапроса, Соединение, Ключ);
				
				Если Ответ <> Неопределено Тогда
					
					Попытка
						ИдентификаторСообщения = Ответ.Получить("result").Получить("campaign_id");
						Сообщение.ИдентификаторСообщения = Формат(ИдентификаторСообщения, "ЧГ=");
						Результат.ОтправленныеСообщения.Добавить(Сообщение);
					Исключение
						ТекстОшибки = НСтр("ru = 'Не удалось получить идентификатор отправленного сообщения UniSender.'");
						
						ЗаписьЖурналаРегистрации(НСтр("ru = 'Отправка уведомления о событии'"),
							УровеньЖурналаРегистрации.Предупреждение,,,
							ТекстОшибки);
							
						Результат.ОписаниеОшибки = ТекстОшибки;
						Возврат Результат;
					КонецПопытки;
					
				Иначе
					Результат.ОписаниеОшибки = НСтр("ru = 'Не удалось отправить сообщения рассылки.'");
					Возврат Результат;
				КонецЕсли;
			Иначе
				Результат.ОписаниеОшибки = НСтр("ru = 'Не удалось отправить сообщения рассылки.'");
				Возврат Результат;
			КонецЕсли;
			
			
		Иначе // Транзакция
			
			ПараметрыЗапроса = ЗапросСообщениеУнисендерТранзакция(Сообщение, КодПодписки);
			Ответ = ОтправитьЗапросУнисендер(ПараметрыЗапроса, Соединение, Ключ);
			
			Если Ответ <> Неопределено Тогда
				ОтправленноеСообщение = Новый Структура("Уведомление", Сообщение.Уведомление);
				Результат.ОтправленныеСообщения.Добавить(ОтправленноеСообщение);
			Иначе
				Результат.ОписаниеОшибки = НСтр("ru = 'Не удалось отправить уведомление.'");
				Возврат Результат;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ЭкспортироватьПодписчиковУнисендер(Адресаты, Соединение, Ключ)
	
	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(Ключ) Тогда
		ПараметрыЗапроса = ЗапросСообщениеУнисендерЭкспортироватьПодписчиков(Адресаты);
		Результат = ОтправитьЗапросУнисендер(ПараметрыЗапроса, Соединение, Ключ);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПодписатьНаРассылкуУнисендер(КодПодписки, Адресаты, Соединение, Ключ)
	
	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(Ключ) Тогда
		Для каждого Подписчик Из Адресаты Цикл
			ПараметрыЗапроса = ЗапросСообщениеУнисендерПодписатьНаРассылку(КодПодписки, Подписчик.Адрес);
			Результат = ОтправитьЗапросУнисендер(ПараметрыЗапроса, Соединение, Ключ);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


