/////////////////Методы веб сервисов//////////////////
Функция PM_6951_FOR_PORTAL(ПараметрыОтбора) Экспорт
	
	пДатаНачалаОтчета	  = Дата(ПараметрыОтбора.BEGIN_DATE_);
	пДатаКонцаОтчета	  = Дата(ПараметрыОтбора.END_DATE_);
	пКодКонтрагентаПортал = ПараметрыОтбора.KONTRAGENT_; 	 

	пФилиалы			  = СокрЛП(ПараметрыОтбора.FILIALS); 
	пСписокФилиалов = Новый Массив;

	Если ЗначениеЗаполнено(пФилиалы) И НЕ Константы.НеПроверятьФилиалВВэбСервисах.Получить() Тогда
		пСписокФилиалов = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(СокрЛП(пФилиалы), ",");
	КонецЕсли;
	
	ИДАвардаКонтрагента = СтрЗаменить(СокрЛП(пКодКонтрагентаПортал), Символы.НПП, "");

	ТипОтвет					= ФабрикаXDTO.Тип(Метаданные.WebСервисы.PM_6951_FOR_PORTAL.ПространствоИмен, "RS_PM_6951_FOR_PORTAL");
	РезультатДляВозвратаПорталу = ФабрикаXDTO.Создать(ТипОтвет);
	ТипСтрокаОтвета			    = ФабрикаXDTO.Тип(Метаданные.WebСервисы.PM_6951_FOR_PORTAL.ПространствоИмен, "Out_PM_6951_FOR_PORTAL");  
	
	ИскатьПоКодуМДМ = СтрДлина(ИДАвардаКонтрагента) = 36;
	
	Если ИскатьПоКодуМДМ Тогда  
		пКонтрагент = Справочники.Контрагенты.НайтиПоРеквизиту("КодМДМ",ИДАвардаКонтрагента);	
	Иначе
		пКонтрагент = Справочники.Контрагенты.НайтиПоРеквизиту("IDАварда",ИДАвардаКонтрагента);	
	КонецЕсли;
	
	Если НЕ пКонтрагент.Пустая() Или НЕ пСписокФилиалов.Количество() = 0 Тогда
		
		ЗапросЗаказовПоСтатусам = Новый Запрос;
		ЗапросЗаказовПоСтатусам.УстановитьПараметр("ДатаНач", ?(ЗначениеЗаполнено(пДатаНачалаОтчета), НачалоДня(пДатаНачалаОтчета), НачалоДня(ТекущаяДата() - 86400 * 14)));
		ЗапросЗаказовПоСтатусам.УстановитьПараметр("ДатаКон", ?(ЗначениеЗаполнено(пДатаКонцаОтчета), КонецДня(пДатаКонцаОтчета), КонецДня(ТекущаяДата())));
		ЗапросЗаказовПоСтатусам.УстановитьПараметр("IDАварда", ИДАвардаКонтрагента);
		ЗапросЗаказовПоСтатусам.УстановитьПараметр("СписокИД", пСписокФилиалов);
		
		Если пСписокФилиалов.Количество() <> 0 Тогда
			
			ТекстЗапроса = 			
			"ВЫБРАТЬ
			|	Контрагенты.Ссылка
			|ПОМЕСТИТЬ ИДАварда
			|ИЗ
			|	Справочник.Контрагенты КАК Контрагенты
			|ГДЕ
			|	Контрагенты.IDАварда = &IDАварда
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Контрагенты.Ссылка
			|ПОМЕСТИТЬ ТаблицаКлиентов
			|ИЗ
			|	Справочник.Контрагенты КАК Контрагенты
			|ГДЕ
			|	(Контрагенты.IDФилиала В(&СписокИД) ИЛИ Контрагенты.КодМДМ В(&СписокИД))
			|	И Контрагенты.ГоловнойКонтрагент В
			|			(ВЫБРАТЬ
			|				ИДАварда.Ссылка
			|			ИЗ
			|				ИДАварда КАК ИДАварда)
			|ИНДЕКСИРОВАТЬ ПО
			|	Ссылка
			|";    
			
		Иначе      
			
			ТекстЗапроса = 
			"ВЫБРАТЬ
			|	Контрагенты.Ссылка
			|ПОМЕСТИТЬ ТаблицаКлиентов
			|ИЗ
			|	Справочник.Контрагенты КАК Контрагенты
			|ГДЕ
			|	Контрагенты.ГоловнойКонтрагент.IDАварда = &IDАварда
			|ИНДЕКСИРОВАТЬ ПО
			|	Ссылка
			|";           
			
		КонецЕсли;
		
		Если ИскатьПоКодуМДМ Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ".IDАварда", ".КодМДМ");
		КонецЕсли;
		
		ЗапросЗаказовПоСтатусам.Текст = ТекстЗапроса;          
		
		//расчет полей в зависимости от константы ДатаОтправкиСтатусаДоставкиНаПортал
		//Доставлено = РН Продажи, где у Документа продажи (РТУ) установлено свойство Товар передан
		//На доставке = Колво из документа Грузовое место (проведен и V Погружено) - Доставлено
		//Готово к погрузке = РН Собрано по заказу - ?(На доставке> 0, На доставке, Доставлено)
		
		ДатаНачалаВыгрузкиСтатусаДоставкиНаПортал = Константы.ДатаНачалаВыгрузкиСтатусаДоставкиНаПортал.Получить();
		
		Если ЗначениеЗаполнено(ДатаНачалаВыгрузкиСтатусаДоставкиНаПортал) Тогда
			ЗапросЗаказовПоСтатусам.УстановитьПараметр("ДатаНачалаВыгрузкиСтатусаДоставкиНаПортал", ДатаНачалаВыгрузкиСтатусаДоставкиНаПортал);
		Иначе
			ЗапросЗаказовПоСтатусам.УстановитьПараметр("ДатаНачалаВыгрузкиСтатусаДоставкиНаПортал", Дата("22000101"));
		КонецЕсли;			                                                                        
		
		ЗапросЗаказовПоСтатусам.Текст = ЗапросЗаказовПоСтатусам.Текст + "
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗаказПокупателяТовары.Ссылка КАК Заказ,
		|	ЗаказПокупателяТовары.Номенклатура КАК Номенклатура,
		|	СУММА(ЗаказПокупателяТовары.Количество) КАК Количество,
		|	МИНИМУМ(ВЫБОР
		|			КОГДА СобственныеСклады.Ссылка ЕСТЬ NULL
		|					ИЛИ СобственныеСклады.Ссылка = ЗНАЧЕНИЕ(Справочник.СобственныеСклады.ПустаяСсылка)
		|					ИЛИ НЕ СобственныеСклады.ИсключитьИзОбщегоЭкспресса
		|				ТОГДА """"
		|			ИНАЧЕ СобственныеСклады.СкладПоставщикаДляСтатусовНаПортале
		|		КОНЕЦ) КАК СкладДляПортала
		|ПОМЕСТИТЬ СгруппТаблЧасть
		|ИЗ
		|	ТаблицаКлиентов КАК ТаблицаКлиентов
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК ЗаказПокупателя
		|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары
		|			ПО ЗаказПокупателя.Ссылка = ЗаказПокупателяТовары.Ссылка
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СобственныеСклады КАК СобственныеСклады
		|			ПО ЗаказПокупателя.IDСклада = СобственныеСклады.Идентификатор
		|		ПО ТаблицаКлиентов.Ссылка = ЗаказПокупателя.Грузополучатель
		|ГДЕ
		|	ЗаказПокупателяТовары.Ссылка.Проведен
		|	И ЗаказПокупателяТовары.Ссылка.Дата МЕЖДУ &ДатаНач И &ДатаКон
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказПокупателяТовары.Ссылка,
		|	ЗаказПокупателяТовары.Номенклатура
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Заказ,
		|	Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Т1.Заказ,
		|	Т1.Номенклатура,
		|	МАКСИМУМ(Т1.Количество) КАК Количество,
		|	МИНИМУМ(ЕСТЬNULL(Т2.Статус, """")) КАК СтатусAvarda,
		|	МИНИМУМ(ВЫБОР
		|			КОГДА НЕ Т1.СкладДляПортала = """"
		|				ТОГДА Т1.СкладДляПортала
		|			ИНАЧЕ ВЫБОР
		|					КОГДА Константы.ДопПоставщик = Т2.Документ.Контрагент
		|						ТОГДА Константы.СкладДопПоставщикаДляСтатусовНаПортале
		|					ИНАЧЕ ""ЦС в Москве""
		|				КОНЕЦ
		|		КОНЕЦ) КАК СтатусПоДопПостащику
		|ПОМЕСТИТЬ ТаблЧасть
		|ИЗ
		|	СгруппТаблЧасть КАК Т1
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсторияХраненияИзмененийЗагружСтатусов КАК Т2
		|		ПО Т1.Заказ = Т2.ЗаказПокупателя
		|			И Т1.Номенклатура = Т2.Номенклатура,
		|	(ВЫБРАТЬ
		|		ВЫБОР
		|			КОГДА Константы.ОтправлятьЗаказыВСтророннююУТ11
		|				ТОГДА Константы.ДопПоставщик
		|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|		КОНЕЦ КАК ДопПоставщик,
		|		Константы.СкладДопПоставщикаДляСтатусовНаПортале КАК СкладДопПоставщикаДляСтатусовНаПортале
		|	ИЗ
		|		Константы КАК Константы) КАК Константы
		|
		|СГРУППИРОВАТЬ ПО
		|	Т1.Заказ,
		|	Т1.Номенклатура
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Т1.Заказ,
		|	Т1.Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(ВЫБОР
		|			КОГДА ЗаказыПокупателейОтказПоставщика.ВидДвижения ЕСТЬ NULL
		|				ТОГДА 0
		|			ИНАЧЕ ВЫБОР
		|					КОГДА ЗаказыПокупателейОтказПоставщика.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|						ТОГДА ЗаказыПокупателейОтказПоставщика.Количество * -1
		|					ИНАЧЕ ЗаказыПокупателейОтказПоставщика.Количество
		|				КОНЕЦ
		|		КОНЕЦ) КАК КоличествоОтказПоставщика,
		|	0 КАК КоличествоИстекСрок,
		|	ЗаказыПокупателейОтказПоставщика.ЗаказПокупателя КАК ЗаказПокупателя,
		|	ЗаказыПокупателейОтказПоставщика.Номенклатура КАК Номенклатура
		|ПОМЕСТИТЬ ЗаказыПокупателейОтказПоставщика
		|ИЗ
		|	РегистрНакопления.ЗаказыПокупателей КАК ЗаказыПокупателейОтказПоставщика
		|ГДЕ
		|	(ЗаказыПокупателейОтказПоставщика.Причина = ЗНАЧЕНИЕ(Перечисление.ПричиныКорректировкиСборки.ОтказПоставщика)
		|			ИЛИ ЗаказыПокупателейОтказПоставщика.Причина = ЗНАЧЕНИЕ(Перечисление.ПричиныКорректировкиСборки.Недопоставка)
		|			ИЛИ ЗаказыПокупателейОтказПоставщика.Причина = ЗНАЧЕНИЕ(Перечисление.ПричиныКорректировкиСборки.Недостача)
		|			ИЛИ ЗаказыПокупателейОтказПоставщика.Причина = ЗНАЧЕНИЕ(Перечисление.ПричиныКорректировкиСборки.Пересорт))
		|	И (ЗаказыПокупателейОтказПоставщика.ЗаказПокупателя, ЗаказыПокупателейОтказПоставщика.Номенклатура) В
		|			(ВЫБРАТЬ
		|				ТаблЧасть.Заказ,
		|				ТаблЧасть.Номенклатура
		|			ИЗ
		|				ТаблЧасть КАК ТаблЧасть)
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказыПокупателейОтказПоставщика.ЗаказПокупателя,
		|	ЗаказыПокупателейОтказПоставщика.Номенклатура
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	0,
		|	ВЫБОР
		|		КОГДА ЗаказыПокупателейИстекСрок.ВидДвижения ЕСТЬ NULL
		|			ТОГДА 0
		|		ИНАЧЕ ВЫБОР
		|				КОГДА ЗаказыПокупателейИстекСрок.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|					ТОГДА ЗаказыПокупателейИстекСрок.Количество * -1
		|				ИНАЧЕ ЗаказыПокупателейИстекСрок.Количество
		|			КОНЕЦ
		|	КОНЕЦ,
		|	ЗаказыПокупателейИстекСрок.ЗаказПокупателя,
		|	ЗаказыПокупателейИстекСрок.Номенклатура
		|ИЗ
		|	РегистрНакопления.ЗаказыПокупателей КАК ЗаказыПокупателейИстекСрок
		|ГДЕ
		|	(ЗаказыПокупателейИстекСрок.ЗаказПокупателя, ЗаказыПокупателейИстекСрок.Номенклатура) В
		|			(ВЫБРАТЬ
		|				ТаблЧасть.Заказ,
		|				ТаблЧасть.Номенклатура
		|			ИЗ
		|				ТаблЧасть КАК ТаблЧасть)
		|	И ЗаказыПокупателейИстекСрок.Причина = ЗНАЧЕНИЕ(Перечисление.ПричиныКорректировкиСборки.ИстекСрокРезервирования)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ЗаказПокупателя,
		|	Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(ВЫБОР
		|			КОГДА ЗаказыПокупателейОтказКлиента.ВидДвижения ЕСТЬ NULL
		|				ТОГДА 0
		|			ИНАЧЕ ВЫБОР
		|					КОГДА ЗаказыПокупателейОтказКлиента.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|						ТОГДА ЗаказыПокупателейОтказКлиента.Количество * -1
		|					ИНАЧЕ ЗаказыПокупателейОтказКлиента.Количество
		|				КОНЕЦ
		|		КОНЕЦ) КАК КоличествоОтказКлиента,
		|	СУММА(0) КАК КоличествоОшибкаКратности,
		|	ЗаказыПокупателейОтказКлиента.ЗаказПокупателя КАК ЗаказПокупателя,
		|	ЗаказыПокупателейОтказКлиента.Номенклатура КАК Номенклатура,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ЗаказыПокупателейОтказКлиента.Регистратор ССЫЛКА Документ.ЗакрытиеЗаказовПокупателей
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК Закрыт
		|ПОМЕСТИТЬ ЗаказыПокупателейОтказКлиента
		|ИЗ
		|	РегистрНакопления.ЗаказыПокупателей КАК ЗаказыПокупателейОтказКлиента
		|ГДЕ
		|	(ЗаказыПокупателейОтказКлиента.Причина = ЗНАЧЕНИЕ(Перечисление.ПричиныКорректировкиСборки.ОтказКлиента)
		|			ИЛИ ЗаказыПокупателейОтказКлиента.Регистратор ССЫЛКА Документ.ЗакрытиеЗаказовПокупателей)
		|	И (ЗаказыПокупателейОтказКлиента.ЗаказПокупателя, ЗаказыПокупателейОтказКлиента.Номенклатура) В
		|			(ВЫБРАТЬ
		|				ТаблЧасть.Заказ,
		|				ТаблЧасть.Номенклатура
		|			ИЗ
		|				ТаблЧасть КАК ТаблЧасть)
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказыПокупателейОтказКлиента.ЗаказПокупателя,
		|	ЗаказыПокупателейОтказКлиента.Номенклатура
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СУММА(0),
		|	СУММА(ВЫБОР
		|			КОГДА ЗаказыПокупателейОшибкаКратности.ВидДвижения ЕСТЬ NULL
		|				ТОГДА 0
		|			ИНАЧЕ ВЫБОР
		|					КОГДА ЗаказыПокупателейОшибкаКратности.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|						ТОГДА ЗаказыПокупателейОшибкаКратности.Количество * -1
		|					ИНАЧЕ ЗаказыПокупателейОшибкаКратности.Количество
		|				КОНЕЦ
		|		КОНЕЦ),
		|	ЗаказыПокупателейОшибкаКратности.ЗаказПокупателя,
		|	ЗаказыПокупателейОшибкаКратности.Номенклатура,
		|	МАКСИМУМ(ЛОЖЬ)
		|ИЗ
		|	РегистрНакопления.ЗаказыПокупателей КАК ЗаказыПокупателейОшибкаКратности
		|ГДЕ
		|	(ЗаказыПокупателейОшибкаКратности.ЗаказПокупателя, ЗаказыПокупателейОшибкаКратности.Номенклатура) В
		|			(ВЫБРАТЬ
		|				ТаблЧасть.Заказ,
		|				ТаблЧасть.Номенклатура
		|			ИЗ
		|				ТаблЧасть КАК ТаблЧасть)
		|	И ЗаказыПокупателейОшибкаКратности.Причина = ЗНАЧЕНИЕ(Перечисление.ПричиныКорректировкиСборки.ОшибкаКратности)
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказыПокупателейОшибкаКратности.ЗаказПокупателя,
