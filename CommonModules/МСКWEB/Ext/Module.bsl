		|	МИНИМУМ(СтатусAvarda),
		|	СУММА(КолГрузомест),
		|	МАКСИМУМ(ТаксиДоставка)
		|ПО
		|	Номенклатура";
		
		РезультатПоСтрокамЗаказа = ЗапросПоСтрокамЗаказа.Выполнить();       
		
		Если НЕ РезультатПоСтрокамЗаказа.Пустой() Тогда
			
			ВыборкаРезультата = РезультатПоСтрокамЗаказа.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);   
			
			Пока ВыборкаРезультата.Следующий() Цикл
				
				Если ВыборкаРезультата.Заказано > 0 Тогда                     
					
					СтрокаВозврата =  ЗаполнитьСтрокуВозврата(ТипСтрокаОтвета, ВыборкаРезультата, ВыборкаРезультата.Заказано, "20;заказан");
					РезультатДляВозвратаПорталу.Row.Добавить(СтрокаВозврата);  
					
				КонецЕсли;
				
				Если ВыборкаРезультата.Зарезервированно > 0 Тогда        
					
					СтрокаВозврата =  ЗаполнитьСтрокуВозврата(ТипСтрокаОтвета, ВыборкаРезультата, ВыборкаРезультата.Зарезервированно, "10;зарезервирован");
					РезультатДляВозвратаПорталу.Row.Добавить(СтрокаВозврата); 
					
				КонецЕсли;
				
				Если ВыборкаРезультата.ЗаказаноПоставщику > 0 Тогда 
					
					ИмяПоля      = "ЗаказаноПоставщику";
					Количество   = ВыборкаРезультата.ЗаказаноПоставщику;	
					КодСообщения = 10;
					СообщениеДляПортала = СформироватьСообщениеДляПортала(ИмяПоля, Количество, ВыборкаРезультата.СтатусAvarda, КодСообщения);
					СтрокаВозврата =  ЗаполнитьСтрокуВозврата(ТипСтрокаОтвета, ВыборкаРезультата, ВыборкаРезультата.ЗаказаноПоставщику, СообщениеДляПортала );
					
					РезультатДляВозвратаПорталу.Row.Добавить(СтрокаВозврата);  
					
				КонецЕсли;
				
				Если ВыборкаРезультата.Собирается > 0 Тогда      
					
					СтрокаВозврата =  ЗаполнитьСтрокуВозврата(ТипСтрокаОтвета, ВыборкаРезультата, ВыборкаРезультата.Собирается, "10;на подборе");
					РезультатДляВозвратаПорталу.Row.Добавить(СтрокаВозврата);    
					
				КонецЕсли;
				
				Если ВыборкаРезультата.ГотовоКПогрузке > 0 Тогда
					
					СтрокаВозврата =  ЗаполнитьСтрокуВозврата(ТипСтрокаОтвета, ВыборкаРезультата, ВыборкаРезультата.ГотовоКПогрузке, "40;готов к отгрузке");
					РезультатДляВозвратаПорталу.Row.Добавить(СтрокаВозврата);   
					
				КонецЕсли;
				
				Если ВыборкаРезультата.ОтказКлиента > 0 Тогда            
					
					СтрокаВозврата =  ЗаполнитьСтрокуВозврата(ТипСтрокаОтвета, ВыборкаРезультата, ВыборкаРезультата.ОтказКлиента, "100;отказ покупателя");
					РезультатДляВозвратаПорталу.Row.Добавить(СтрокаВозврата);   
					
				КонецЕсли;
				
				Если ВыборкаРезультата.ОтказПоставщика > 0 Тогда          
					
					СтрокаВозврата =  ЗаполнитьСтрокуВозврата(ТипСтрокаОтвета, ВыборкаРезультата, ВыборкаРезультата.ОтказПоставщика, 
					                ?(ВыборкаРезультата.Ссылка.ТаксиДоставка, "110;нет на складе;", "110;отказ поставщика;"));
					РезультатДляВозвратаПорталу.Row.Добавить(СтрокаВозврата);            
					
				КонецЕсли;
				
				Если ВыборкаРезультата.ОтказИстекСрок > 0 Тогда     
					
					СтрокаВозврата =  ЗаполнитьСтрокуВозврата(ТипСтрокаОтвета, ВыборкаРезультата, ВыборкаРезультата.ОтказИстекСрок, "110;истек срок резервирования");
					РезультатДляВозвратаПорталу.Row.Добавить(СтрокаВозврата); 
					
				КонецЕсли;
				
				Если ВыборкаРезультата.ОтказОшибкаКратности > 0 И ВыборкаРезультата.Ссылка.IDСклада_СтороннийСклад.Пустая() Тогда 
					
					СтрокаВозврата =  ЗаполнитьСтрокуВозврата(ТипСтрокаОтвета, ВыборкаРезультата, ВыборкаРезультата.ОтказОшибкаКратности, "110;ошибка кратности");
					РезультатДляВозвратаПорталу.Row.Добавить(СтрокаВозврата);	
					
				КонецЕсли;
				
				Если ВыборкаРезультата.НаДоставке > 0 Тогда      
					
					СтрокаВозврата =  ЗаполнитьСтрокуВозврата(ТипСтрокаОтвета, ВыборкаРезультата, ВыборкаРезультата.НаДоставке, "50;на доставке");
					РезультатДляВозвратаПорталу.Row.Добавить(СтрокаВозврата); 
					
				КонецЕсли;
				
				Если (ВыборкаРезультата.Доставлено-ВыборкаРезультата.ДоставленоПоСФ) > 0 Тогда	//если есть отгруженные товары без СФ (предусматриваем все, что возможно) 
					
					СтрокаВозврата =  ЗаполнитьСтрокуВозврата(ТипСтрокаОтвета, ВыборкаРезультата, ВыборкаРезультата.Доставлено-ВыборкаРезультата.ДоставленоПоСФ, "60;выполнен");
					РезультатДляВозвратаПорталу.Row.Добавить(СтрокаВозврата);
					
				КонецЕсли;
				
				Если ВыборкаРезультата.ДоставленоПоСФ > 0 Тогда   
					
					ВыборкаРезультатаПоСФ = ВыборкаРезультата.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);  
					
					Пока ВыборкаРезультатаПоСФ.Следующий() Цикл
						
						Если ВыборкаРезультатаПоСФ.ДоставленоПоСФ > 0 Тогда
							
							СтрокаВозврата =  ЗаполнитьСтрокуВозврата(ТипСтрокаОтвета, ВыборкаРезультатаПоСФ, ВыборкаРезультатаПоСФ.ДоставленоПоСФ, "60;выполнен");
							РезультатДляВозвратаПорталу.Row.Добавить(СтрокаВозврата);
							
						КонецЕсли;
						
					КонецЦикла;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;		
		
	КонецЕсли; 	
	
	Возврат РезультатДляВозвратаПорталу;   
	
КонецФункции

Функция PM_GET_RNS_STR_FOR_PORTAL_2021(ПараметрыОтбора) Экспорт      
	
	пЗаказКлиента	  = СокрЛП(ПараметрыОтбора.DID_6951);
	ДокументЗаказКлиента = Документы.ЗаказПокупателя.ПолучитьСсылку(Новый УникальныйИдентификатор(пЗаказКлиента));
	
	ТипОтвет					= ФабрикаXDTO.Тип(Метаданные.WebСервисы.PM_GET_RNS_STR_FOR_PORTAL.ПространствоИмен, "RS_PM_GET_RNS_STR_FOR_PORTAL_2021");
	РезультатДляВозвратаПорталу = ФабрикаXDTO.Создать(ТипОтвет);
	ТипСтрокаОтвета			    = ФабрикаXDTO.Тип(Метаданные.WebСервисы.PM_GET_RNS_STR_FOR_PORTAL.ПространствоИмен, "Out_PM_GET_RNS_STR_FOR_PORTAL_2021"); 
	
	Если НЕ ДокументЗаказКлиента.Пустая() Тогда         
		
		ЗапросПоСтрокамЗаказа = Новый Запрос;
