Процедура ЗаписатьJSONLines(Данные , ПутьКФайлу , Заголовок) Экспорт 
	//+Кабанов А.В. 19.03.2025 # UT10-5139	
	
	// Создаем объект записи текстового файла
	Запись              = Новый ЗаписьТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	ЗаписьJSON          = Новый ЗаписьJSON;
	ПараметрыЗаписиJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет,,Истина);
	
	Если ЗначениеЗаполнено(Заголовок) Тогда  
		
		ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписиJSON);
		ЗаписатьJSON(ЗаписьJSON, Заголовок);
		JSONСтрока = ЗаписьJSON.Закрыть();	
		Запись.ЗаписатьСтроку(JSONСтрока);
		
	КонецЕсли;  
	
	Попытка
		
		// Для каждой записи в массиве данных
		Для Каждого Строка Из Данные Цикл
			// Записываем каждый объект как отдельную JSON строку
			ПараметрыЗаписиJSON = Новый ПараметрыЗаписиJSON(, Символы.Таб);
			
			// Создаем строку в памяти
			ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписиJSON);
			
			// Записываем объект в JSON
			ЗаписатьJSON(ЗаписьJSON, Строка);
			
			// Получаем строку JSON и записываем в файл
			JSONСтрока = ЗаписьJSON.Закрыть();
			Запись.ЗаписатьСтроку(JSONСтрока); 
			
		КонецЦикла;
		
	Исключение
		
		Запись.Закрыть();
		ВызватьИсключение; 
		
	КонецПопытки;
	
	Запись.Закрыть();
	
	//-Кабанов А.В. 19.03.2025 # UT10-5139	
КонецПроцедуры  

Процедура ЗаписатьТабличнуюЧастьВJSONLines(Объект , ИмяТЧ , ПутьКФайлу , Заголовок) Экспорт 
	//+Кабанов А.В. 19.03.2025 # UT10-5139	

    // Создаем объект записи текстового файла
    Запись              = Новый ЗаписьТекста(ПутьКФайлу , КодировкаТекста.UTF8);
    ЗаписьJSON          = Новый ЗаписьJSON;
    ПараметрыЗаписиJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет , , Истина);
	
	Если ЗначениеЗаполнено(Заголовок) Тогда  
		
		ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписиJSON);
		ЗаписатьJSON(ЗаписьJSON , Заголовок);
		JSONСтрока = ЗаписьJSON.Закрыть();	
		Запись.ЗаписатьСтроку(JSONСтрока);
		
	КонецЕсли;	

    Попытка
		
		// Перебираем строки табличной части
        Для Каждого СтрокаТЧ Из Объект[ИмяТЧ] Цикл
			
			// Создаем структуру для текущей строки
            СтруктураСтроки = Новый Структура;
            
            // Заполняем структуру значениями из строки табличной части
            Для Каждого Колонка Из Объект[ИмяТЧ].Выгрузить().Колонки Цикл
                СтруктураСтроки.Вставить(Колонка.Имя , СтрокаТЧ[Колонка.Имя]);
            КонецЦикла;
            
            // Записываем структуру в JSON и сразу в файл
            ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписиJSON);
            ЗаписатьJSON(ЗаписьJSON , СтруктураСтроки , , "ОбработатьНеподдерживаемоеСвойствоJSON" , ОбщегоНазначения);
            JSONСтрока = ЗаписьJSON.Закрыть();
            
            // Записываем строку в файл
            Запись.ЗаписатьСтроку(JSONСтрока); 
			
        КонецЦикла;
        
    Исключение
		
		Запись.Закрыть();
        ВызватьИсключение;
		
	КонецПопытки;
    
    Запись.Закрыть();

