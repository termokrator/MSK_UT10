		|	Рез КАК Рез
		|ГДЕ
		|	Рез.Нехватка > 0";         
		
		Запрос.УстановитьПараметр("ТЗ", ТЗ);
		Запрос.УстановитьПараметр("ПустоеРазмещение", Неопределено);
		Табл = Запрос.Выполнить().Выгрузить();    
		
		Для каждого стр из Табл Цикл          
			
			Отбор = Новый Структура;
			Отбор.Вставить("Номенклатура", Стр.Номенклатура);
			НайдСтроки = НовыйДокЗаказ.Товары.НайтиСтроки(Отбор);
			КУменьшению = Стр.Нехватка;          
			
			Для каждого строка из НайдСтроки Цикл  
				
				Если КУменьшению > 0 Тогда          
					
					Если Строка.Количество > КУменьшению Тогда   
						
						НоваяСтрока = НовыйДокЗаказ.Товары.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
						Строка.Количество = Строка.Количество - КУменьшению;
						НоваяСтрока.Количество = КУменьшению;
						НоваяСтрока.Размещение = "";
						НоваяСтрока.СерияНоменклатуры = "";
						
						КУменьшению = 0;
						СтрСумма = НоваяСтрока.Количество * НоваяСтрока.Цена;
						НоваяСтрока.Сумма = СтрСумма;
						ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НоваяСтрока, НовыйДокЗаказ);
						
						СтрСумма = Строка.Количество * Строка.Цена;
						Строка.Сумма = СтрСумма;
						ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(Строка, НовыйДокЗаказ);  
						
