Функция СоздатьАктОРасхожденииВУТ11(ГУИДДокумента,ГУИДПТУ, СтатусПТУ,ДокументАкт) Экспорт 
	
	Ответ = Новый Структура("Результат",Ложь);  
	
	Попытка
		
		КонстантаАдрес = Константы.АдресВебСервисаУТ11.Получить();		
		АдресВебСервиса = "http://" + КонстантаАдрес + "/ws/CreateVarianceAct.1cws?wsdl";
		ВСОпределение = Новый WSОпределения(АдресВебСервиса, , ,, 30);
		ВСПрокси = Новый WSПрокси(ВСОпределение, "Data", "CreateVarianceAct", "CreateVarianceActSoap");
		
	Исключение
		
		Ответ.Вставить("ТекстОшибки", "Не удалось подключиться к УТ11 !" + ОписаниеОшибки());
		Возврат Ответ;
		
	КонецПопытки;
	
	ЗапросТабличнойЧасти = Новый Запрос;
	ЗапросТабличнойЧасти.УстановитьПараметр("ДокАкт", ДокументАкт);
	ЗапросТабличнойЧасти.Текст =
	"ВЫБРАТЬ
	|	АктОРасхожденияхПослеПриемкиТовары.Номенклатура.КодМДМ КАК Номенклатура,
	|	АктОРасхожденияхПослеПриемкиТовары.Брак,
	|	АктОРасхожденияхПослеПриемкиТовары.Количество,
//+Макрушин Е. 28.04.2026 #UT10-5838
	|	АктОРасхожденияхПослеПриемкиТовары.КоличествоПоДокументу,
	|	ВЫБОР
	|		КОГДА АктОРасхожденияхПослеПриемкиТовары.КоличествоРасхождения > 0
	|				И АктОРасхожденияхПослеПриемкиТовары.КоличествоПоДокументу = 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоИзлишек,	
//-Макрушин Е. 28.04.2026 #UT10-5838
	|	АктОРасхожденияхПослеПриемкиТовары.КомментарийМенеджера,
	|	АктОРасхожденияхПослеПриемкиТовары.КомментарийПоставщика,
	|	АктОРасхожденияхПослеПриемкиТовары.КлючСтроки
	|ИЗ
	|	Документ.АктОРасхожденияхПослеПриемки.Товары КАК АктОРасхожденияхПослеПриемкиТовары
	|ГДЕ
	|	АктОРасхожденияхПослеПриемкиТовары.Ссылка = &ДокАкт"; 

	//+Макрушин Е. 29.01.2026 #UT10-5635
	//ПромТабличнаяЧасть = ЗапросТабличнойЧасти.Выполнить().Выгрузить();
	
	ЗапросТабличнойЧасти.Текст = ЗапросТабличнойЧасти.Текст + "
	|
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АктОРасхожденияхПослеПриемкиРасхожденияКМ.Номенклатура.КодМДМ КАК Номенклатура,
	|	АктОРасхожденияхПослеПриемкиРасхожденияКМ.КодМаркировки.КодМаркировки КАК КодМаркировки,
	|	АктОРасхожденияхПослеПриемкиРасхожденияКМ.Недостача,
	|	АктОРасхожденияхПослеПриемкиРасхожденияКМ.Излишек
	|ИЗ
	|	Документ.АктОРасхожденияхПослеПриемки.РасхожденияКМ КАК АктОРасхожденияхПослеПриемкиРасхожденияКМ
	|ГДЕ
	|	АктОРасхожденияхПослеПриемкиРасхожденияКМ.Ссылка = &ДокАкт
	|
	|УПОРЯДОЧИТЬ ПО
	|	АктОРасхожденияхПослеПриемкиРасхожденияКМ.НомерСтроки
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	РезультатПоАкту = ЗапросТабличнойЧасти.ВыполнитьПакет();
	
	ПромТабличнаяЧасть = РезультатПоАкту[0].Выгрузить();
	
	тзРасхожденияКМ = РезультатПоАкту[1].Выгрузить();
	мРасхожденияКМ = ТаблицуВМассив(тзРасхожденияКМ);
	//-Макрушин Е. 29.01.2026 #UT10-5635

	ТабличнаяЧасть= ТаблицуВМассив(ПромТабличнаяЧасть);
	
	//+Макрушин Е. 23.01.2026 #UT10-5634
	Если ЗначениеЗаполнено(СтатусПТУ) Тогда
	//-Макрушин Е. 23.01.2026 #UT10-5634
	
		ИндексСтатуса = Перечисления.СтатусыПТУ.Индекс(СтатусПТУ);
		НовыйСтатусТекст = Метаданные.Перечисления.СтатусыПТУ.ЗначенияПеречисления[ИндексСтатуса].Имя;
		
		//+Макрушин Е. 23.01.2026 #UT10-5634
	Иначе
		НовыйСтатусТекст = "";
	КонецЕсли;	
	//-Макрушин Е. 23.01.2026 #UT10-5634
	
	Попытка

		ПараметрыСтруктура = Новый Структура("ГУИДДокумента,ГУИДПТУ, СтатусПТУ, ТабличнаяЧасть,Комментарий,ДатаДокумента, НомерДокумента",
								ГУИДДокумента, ГУИДПТУ, НовыйСтатусТекст, ТабличнаяЧасть, СокрЛП(ДокументАкт.Комментарий), ДокументАкт.Дата, СокрЛП(ДокументАкт.Номер));
								
		//+Макрушин Е. 28.01.2026 #UT10-5634
		ПараметрыСтруктура.Вставить("ТранзитнаяПоставка", ДокументАкт.ТранзитнаяПоставка);
		ПараметрыСтруктура.Вставить("ВидОперации", "" + ВРег(ДокументАкт.ВидОперации));
		//-Макрушин Е. 28.01.2026 #UT10-5634
		
		//+Макрушин Е. 29.01.2026 #UT10-5635
		ПараметрыСтруктура.Вставить("РасхожденияКМ", мРасхожденияКМ);
		//-Макрушин Е. 29.01.2026 #UT10-5635
		
		ОтветУТ11 = ВСПрокси.СоздатьАктОРасхожденияхПослеПриемки(ДанныеВJSONХранилище(ПараметрыСтруктура));
		
		Если ТипЗнч(ОтветУТ11) = Тип("ХранилищеЗначения") Тогда		
			Ответ = ХранилищеJSONВСтруктуру(ОтветУТ11);			
		КонецЕсли;		
		
	Исключение
		
		Ответ.Результат = Ложь;
		Ответ.Вставить("ТекстОшибки",ОписаниеОшибки()); 		
		
	КонецПопытки;
	
	Возврат Ответ;

КонецФункции

Функция ОтправитьАктОРасхожденииВУТ10(ГУИДДокумента,ГУИДПТУ, СтатусПТУ,ДокументАкт) Экспорт 
	
	//+Макрушин Е. 10.02.2026 #UT10-5665
	// выгрузка акта о расхождениях в соседнюю УТ10 для дальнейшей обработки
	Ответ = Новый Структура("Результат",Ложь);  
	
	Попытка
		
		IDСкладаСобственныйСклад = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументАкт, "IDСкладаСобственныйСклад");
				
		//АдресВебСервиса = "http://" + IDСкладаСобственныйСклад.АдресВебСервисаCreateVarianceAct + "/ws/CreateVarianceAct.1cws?wsdl";
		АдресВебСервиса = IDСкладаСобственныйСклад.АдресВебСервисаCreateVarianceAct;
		ВСОпределение = Новый WSОпределения(АдресВебСервиса, , ,, 30);
		ВСПрокси = Новый WSПрокси(ВСОпределение, "Data", "CreateVarianceAct", "CreateVarianceActSoap");
		
	Исключение
		
		Ответ.Вставить("ТекстОшибки", "Не удалось подключиться к УТ10!" + ОписаниеОшибки());
		Возврат Ответ;
		
	КонецПопытки;
	
	
	IDСклада = Константы.FTPВыгрузкаОстатковКаталог.Получить();
	
	Если Не значениеЗаполнено(IDСклада) Тогда
		
		Ответ.Вставить("Ошибка при отправке акта. В константах не проставлен IDСклада!" + ОписаниеОшибки());
		Возврат Ответ;
		
	КонецЕсли;
	
	ЗапросТабличнойЧасти = Новый Запрос;
	ЗапросТабличнойЧасти.УстановитьПараметр("ДокАкт", ДокументАкт);
	ЗапросТабличнойЧасти.Текст =
	"ВЫБРАТЬ
	|	АктОРасхожденияхПослеПриемкиТовары.Номенклатура.КодМДМ КАК Номенклатура,
	|	АктОРасхожденияхПослеПриемкиТовары.Брак,
	|	АктОРасхожденияхПослеПриемкиТовары.Количество,
	|	АктОРасхожденияхПослеПриемкиТовары.КомментарийМенеджера,
	|	АктОРасхожденияхПослеПриемкиТовары.КомментарийПоставщика,
	|	АктОРасхожденияхПослеПриемкиТовары.КлючСтроки
	|ИЗ
	|	Документ.АктОРасхожденияхПослеПриемки.Товары КАК АктОРасхожденияхПослеПриемкиТовары
	|ГДЕ
	|	АктОРасхожденияхПослеПриемкиТовары.Ссылка = &ДокАкт"; 

	ЗапросТабличнойЧасти.Текст = ЗапросТабличнойЧасти.Текст + "
	|
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АктОРасхожденияхПослеПриемкиРасхожденияКМ.Номенклатура.КодМДМ КАК Номенклатура,
	|	АктОРасхожденияхПослеПриемкиРасхожденияКМ.КодМаркировки.КодМаркировки КАК КодМаркировки,
	|	АктОРасхожденияхПослеПриемкиРасхожденияКМ.Недостача,
	|	АктОРасхожденияхПослеПриемкиРасхожденияКМ.Излишек
	|ИЗ
	|	Документ.АктОРасхожденияхПослеПриемки.РасхожденияКМ КАК АктОРасхожденияхПослеПриемкиРасхожденияКМ
	|ГДЕ
	|	АктОРасхожденияхПослеПриемкиРасхожденияКМ.Ссылка = &ДокАкт
	|
	|УПОРЯДОЧИТЬ ПО
	|	АктОРасхожденияхПослеПриемкиРасхожденияКМ.НомерСтроки
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	РезультатПоАкту = ЗапросТабличнойЧасти.ВыполнитьПакет();
	
	ПромТабличнаяЧасть = РезультатПоАкту[0].Выгрузить();
	ТабличнаяЧасть= ТаблицуВМассив(ПромТабличнаяЧасть);
	
	тзРасхожденияКМ = РезультатПоАкту[1].Выгрузить();
	мРасхожденияКМ = ТаблицуВМассив(тзРасхожденияКМ);

	Если ЗначениеЗаполнено(СтатусПТУ) Тогда
	
		ИндексСтатуса = Перечисления.СтатусыПТУ.Индекс(СтатусПТУ);
		НовыйСтатусТекст = Метаданные.Перечисления.СтатусыПТУ.ЗначенияПеречисления[ИндексСтатуса].Имя;
		
	Иначе
		НовыйСтатусТекст = "";
	КонецЕсли;	
	
	Попытка

		ПараметрыСтруктура = Новый Структура("ГУИДДокумента,ГУИДПТУ, СтатусПТУ, ТабличнаяЧасть,Комментарий,ДатаДокумента, НомерДокумента",
								ГУИДДокумента, ГУИДПТУ, НовыйСтатусТекст, ТабличнаяЧасть, СокрЛП(ДокументАкт.Комментарий), ДокументАкт.Дата, СокрЛП(ДокументАкт.Номер));
								
		ПараметрыСтруктура.Вставить("ТранзитнаяПоставка", ДокументАкт.ТранзитнаяПоставка);
		ПараметрыСтруктура.Вставить("ВидОперации", "" + ВРег(ДокументАкт.ВидОперации));
		ПараметрыСтруктура.Вставить("РасхожденияКМ", мРасхожденияКМ);
		ПараметрыСтруктура.Вставить("IDСклада", IDСклада);
		ПараметрыСтруктура.Вставить("ИДДокументаВСмежнойБазеУТ11", ПараметрыСтруктура.ГУИДДокумента);
		
		ОтветУТ10 = ВСПрокси.СоздатьАктОРасхожденияхПослеОтгрузки(ДанныеВJSONХранилище(ПараметрыСтруктура));
		
		Если ТипЗнч(ОтветУТ10) = Тип("ХранилищеЗначения") Тогда		
			Ответ = ХранилищеJSONВСтруктуру(ОтветУТ10);			
		КонецЕсли;		
		
	Исключение
		
		Ответ.Результат = Ложь;
		Ответ.Вставить("ТекстОшибки",ОписаниеОшибки()); 		
		
	КонецПопытки;
	
	Возврат Ответ;
    //-Макрушин Е. 10.02.2026 #UT10-5665
	
КонецФункции 

Функция ИзменитьСтатусАктаОРасхожденияхВСмежнойУТ10(АктСсылка) Экспорт
	
	//+Макрушин Е. 12.02.2026 #UT10-5665
	Результат = Новый Структура("Результат, ТекстОшибки", Ложь, "");
	
	ИндексСтатуса = Перечисления.СтатусыАктаОРасхождениях.Индекс(АктСсылка.Статус);
	НовыйСтатусТекст = Метаданные.Перечисления.СтатусыАктаОРасхождениях.ЗначенияПеречисления[ИндексСтатуса].Имя;
	
	РеквизитыАкта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(АктСсылка, "ДокументОснование, ИДДокументаВСмежнойБазе, Товары");
	ДокОснованиеАкта = РеквизитыАкта.ДокументОснование;
	
	Если Не ЗначениеЗаполнено(ДокОснованиеАкта) Тогда
		
		Результат.ТекстОшибки = "Не найден документ основание акта " + АктСсылка;
		Возврат Результат; 
		
	КонецЕсли;
	
	ТоварыАкта = РеквизитыАкта.Товары.Выгрузить();
	
	ТЧТовары = Новый ТаблицаЗначений;
	ТЧТовары.Колонки.Добавить("Номенклатура");
	ТЧТовары.Колонки.Добавить("Действие");
	ТЧТовары.Колонки.Добавить("КомментарийПоставщика");
	ТЧТовары.Колонки.Добавить("Количество");
	ТЧТовары.Колонки.Добавить("КоличествоПоДокументу");
	ТЧТовары.Колонки.Добавить("Цена");

	Для Каждого Стр Из ТоварыАкта Цикл
		
		НовСтр = ТЧТовары.Добавить();
		НовСтр.Номенклатура = Стр.Номенклатура.КодМДМ;
		
		Если ЗначениеЗаполнено(Стр.Действие) Тогда
			
			ИндексДействия = Перечисления.ВариантыДействийПоРасхождениямВАктеПослеОтгрузки.Индекс(Стр.Действие);
			НовСтр.Действие = Перечисления.ВариантыДействийПоРасхождениямВАктеПослеОтгрузки.ПолучитьПарноеЗначениеПеречисленияУТ10(Стр.Действие); 
			
		Иначе
			НовСтр.Действие = "";
		КонецЕсли; 
		
		НовСтр.КомментарийПоставщика = Стр.КомментарийМенеджера;
		
		НовСтр.КоличествоПоДокументу = Стр.КоличествоПоДокументу;
		НовСтр.Количество = Стр.Количество; 
		НовСтр.Цена = Стр.Цена;
		
	КонецЦикла;
	
	ДанныеТЧТовары = ДанныеВJSONХранилище(ТаблицуВМассив(ТЧТовары));
	
	ДопПараметры = Новый Структура("ТекстОшибки", "");
	
	Ответ = Новый Структура("Результат",Ложь);
	
	Попытка
		
		IDСкладаСобственныйСклад = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(АктСсылка, "IDСкладаСобственныйСклад");
				
		//АдресВебСервиса = "http://" + IDСкладаСобственныйСклад.АдресВебСервисаCreateVarianceAct + "/ws/CreateVarianceAct.1cws?wsdl";
		АдресВебСервиса = IDСкладаСобственныйСклад.АдресВебСервисаUpdateVarianceAct;
		ВСОпределение = Новый WSОпределения(АдресВебСервиса, , ,, 30);
		ВСПрокси = Новый WSПрокси(ВСОпределение, "Data", "UpdateVarianceAct", "UpdateVarianceActSoap");

	Исключение
		
		Ответ.Вставить("ТекстОшибки", "Не удалось подключиться к веб-сервису UpdateVarianceAct в УТ10! " + ОписаниеОшибки());
		Возврат Ответ;
		
	КонецПопытки;
	
	Попытка
		
		ОтветУТ10 = ВСПрокси.ИзменитьСтатусАктаОРасхождении(Строка(АктСсылка.ИДДокументаВСмежнойБазе),Строка(ДокОснованиеАкта.УникальныйИдентификатор()), 
		                             "КОРРЕКТИРОВКАОСТАТКАВУТ10", НовыйСтатусТекст, ДанныеТЧТовары, ""); 
		
		Если ТипЗнч(ОтветУТ10) = Тип("ХранилищеЗначения") Тогда		
			Ответ = ХранилищеJSONВСтруктуру(ОтветУТ10);			
		КонецЕсли;		
		
	Исключение
		
		Ответ.Результат = Ложь;
		Ответ.Вставить("ТекстОшибки",ОписаниеОшибки()); 		
		
	КонецПопытки;
	
	Возврат Ответ;
	
	//-Макрушин Е. 12.02.2026 #UT10-5665
	
КонецФункции

Функция СоздатьАктОРасхожденияхПослеОтгрузкиВебСервисУТ10(Документ, ТаблТов, ДопПараметры = Неопределено) Экспорт

	//+Макрушин Е. 11.02.2026 #UT10-5665
	//Документ - Реализация товаров и услуг
	ДокАкт = Документы.АктОРасхожденияхПослеОтгрузки.ПустаяСсылка();
	
	Если Документ <> Неопределено тогда
		
		РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Документ, "Склад");
		
		Если ЗначениеЗаполнено(ДопПараметры) и ДопПараметры.Свойство("ДокАкт") Тогда
			
			ДокАкт = ДопПараметры.ДокАкт.ПолучитьОбъект();
			ДокАкт.Товары.Очистить();
			
		Иначе
			ДокАкт = Документы.АктОРасхожденияхПослеОтгрузки.СоздатьДокумент();
			ДокАкт.Дата = ТекущаяДата();
		КонецЕсли;
		
		ДокАкт.Заполнить(Документ);

		ДокАкт.Статус = Перечисления.СтатусыАктаОРасхождениях.НаСогласовании;
		ДокАкт.Комментарий = ДопПараметры.Комментарий;
		ДокАкт.ИДДокументаВСмежнойБазе = ДопПараметры.ИДДокументаВСмежнойБазе;

		ДокАкт.IDСкладаСобственныйСклад = Справочники.СобственныеСклады.ПолучитьСобственныйСкладПоИдентификатору(МСК.СтрокаВЧисло(ДопПараметры.IDСклада));
		
		ДокАкт.ДатаВСтороннейБазе = МСК.СтрокаВДату(ДопПараметры.ДатаДокумента);
		ДокАкт.НомерВСтороннейБазе = ДопПараметры.НомерДокумента;
		
		Если Не ЗначениеЗаполнено(ДокАкт.Номер) Тогда
			ДокАкт.УстановитьНовыйНомер(ДокАкт.Организация.Префикс);
		КонецЕсли;		
		
		// определяем первый доступный заказ для излишка, а далее оставляем его, если нет более подходящего с учетом номенклатуры
		ЗаказДляИзлишкаПервый = Документы.ЗаказПокупателя.ПустаяСсылка();
		
		Для Каждого СтрокаАкта Из  ДокАкт.Товары Цикл
			
			СтрокаАкта.Количество = 0;
			
			Если ЗначениеЗаполнено(СтрокаАкта.ЗаказПокупателя) И НЕ ЗначениеЗаполнено(ЗаказДляИзлишкаПервый) Тогда
				ЗаказДляИзлишкаПервый = СтрокаАкта.ЗаказПокупателя;
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого Строка Из ТаблТов Цикл
			
			НоменклатураДляПоиска = Строка.Номенклатура;
			КоличествоПринято = Строка.Количество;
			
			ЗаказДляИзлишкаПоНоменклатуре = Документы.ЗаказПокупателя.ПустаяСсылка();
			
			Отбор = Новый Структура("Номенклатура", НоменклатураДляПоиска);
			СтрокиАкта = ДокАкт.Товары.НайтиСтроки(Отбор);
			
			Для Каждого СтрокаАкта Из СтрокиАкта Цикл
				
				Если ЗначениеЗаполнено(СтрокаАкта.ЗаказПокупателя) И НЕ ЗначениеЗаполнено(ЗаказДляИзлишкаПоНоменклатуре) Тогда
					ЗаказДляИзлишкаПоНоменклатуре = СтрокаАкта.ЗаказПокупателя;
				КонецЕсли;
				
				КоличествоДляЗачета = Мин(СтрокаАкта.КоличествоПоДокументу, КоличествоПринято);
				СтрокаАкта.Количество = СтрокаАкта.Количество + КоличествоДляЗачета;
				КоличествоПринято = КоличествоПринято - КоличествоДляЗачета;
				
				Если КоличествоПринято = 0 Тогда
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
			Если КоличествоПринято > 0 Тогда 
				
				СтрокаАкта = ДокАкт.Товары.Добавить();
				СтрокаАкта.Номенклатура = НоменклатураДляПоиска;
				СтрокаАкта.ЕдиницаИзмерения = СтрокаАкта.Номенклатура.ЕдиницаХраненияОстатков;
				СтрокаАкта.Коэффициент      = СтрокаАкта.ЕдиницаИзмерения.Коэффициент;
				СтрокаАкта.Количество = КоличествоПринято;
				СтрокаАкта.ЗаказПокупателя = ?(ЗначениеЗаполнено(ЗаказДляИзлишкаПоНоменклатуре), ЗаказДляИзлишкаПоНоменклатуре, ЗаказДляИзлишкаПервый);
				СтрокаАкта.Цена = 0.07;
				
				//СтрокаАкта.СтавкаНДС = УчетНДС.ПолучитьСтавкуНДСПоНоменклатуре(СтрокаАкта.Номенклатура, ДокАкт.Дата);
				ОбработкаТабличныхЧастей.ЗаполнитьСтавкуНДСТабЧасти(СтрокаАкта, ДокАкт, "Реализация");
				
				СтрокаАкта.Склад = РеквизитыДокумента.Склад;
				
			КонецЕсли;
						
		КонецЦикла;
		
		// финально подбиваем количество и проверяем нужно ли вообще записывать акт
		НужноЗаписатьАкт = Ложь;
		
		Для Каждого СтрокаАкта Из  ДокАкт.Товары Цикл
			
			СтрокаАкта.КоличествоРасхождения = СтрокаАкта.Количество - СтрокаАкта.КоличествоПоДокументу;
			
			ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(СтрокаАкта, ДокАкт);
			ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(СтрокаАкта, ДокАкт);
			
			ОбработкаТабличныхЧастей.РассчитатьСуммуРасхожденияТабЧасти(СтрокаАкта, ДокАкт);
			ОбработкаТабличныхЧастей.РассчитатьСуммуНДСРасхожденияТабЧасти(СтрокаАкта, ДокАкт);
			
			Если СтрокаАкта.КоличествоПоДокументу > СтрокаАкта.Количество тогда
				СтрокаАкта.Действие = Перечисления.ВариантыДействийПоРасхождениямВАктеПослеОтгрузки.ДопоставкаНеТребуется;
			ИначеЕсли СтрокаАкта.КоличествоПоДокументу < СтрокаАкта.Количество тогда
				СтрокаАкта.Действие = Перечисления.ВариантыДействийПоРасхождениямВАктеПослеОтгрузки.ПокупкаПерепоставленного;
			КонецЕсли;
			
			Если СтрокаАкта.Количество <> СтрокаАкта.КоличествоПоДокументу Тогда
				НужноЗаписатьАкт = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
		Если НужноЗаписатьАкт Тогда
			
			// если есть, фиксируем в отдельной тч Расхождения кодов маркировки
			ДокАкт.РасхожденияКМ.Очистить();
			
			Если ЗначениеЗаполнено(ДопПараметры) и ДопПараметры.Свойство("ТаблРасхожденияКМ") Тогда
				
				ТаблРасхожденияКМ = ДопПараметры.ТаблРасхожденияКМ;
				
				Для Каждого СтрокаРасхожденияКМ Из ТаблРасхожденияКМ Цикл
					
					НовСтрокаРасхожденияКМ = ДокАкт.РасхожденияКМ.Добавить();
					ЗаполнитьЗначенияСвойств(НовСтрокаРасхожденияКМ, СтрокаРасхожденияКМ);
					
				КонецЦикла;
				
			КонецЕсли;
			
			ДокАкт.ЗаполнитьРасхожденияКМ();			
			
			// собственно запись
			ДокАкт.Записать(РежимЗаписиДокумента.Запись);
			
			Попытка
				ДокАкт.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				ЗаписьЖурналаРегистрации("Ошибка проведения документа " + ДокАкт.Ссылка, УровеньЖурналаРегистрации.Ошибка,,, ОписаниеОшибки());
			Конецпопытки;
			
		Иначе
			ДокАкт = Документы.АктОРасхожденияхПослеОтгрузки.ПустаяСсылка();
		КонецЕсли;	
		
	КонецЕсли;
	
	Возврат ДокАкт.Ссылка;
    //-Макрушин Е. 11.02.2026 #UT10-5665
	
КонецФункции

Функция СоздатьКорректировкаЗаказаПокупателя(НовыйДокЗаказ, ПараметрРежимПроведенияДокумента = Неопределено, Комментарий = "") Экспорт
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("Документ", "");
	СтруктураВозврата.Вставить("Ошибка", "");         
	
	ТоварыТолькоСоСклада = НовыйДокЗаказ.Грузополучатель.ТоварыТолькоСоСклада ИЛИ НовыйДокЗаказ.ТаксиДоставка; 
	
	Если Не ТоварыТолькоСоСклада Тогда 
		
		Если Константы.ИспользоватьАлгоритмПроверкиКратностиФилиала.Получить()Тогда
			Возврат СоздатьКорректировкаЗаказаПокупателяПоКратностиФилиала(НовыйДокЗаказ,, Комментарий = "")	
		Иначе 			
			Возврат СтруктураВозврата;	
		КонецЕсли;     	
		
	КонецЕсли;      
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказПокупателяТовары.Ссылка,
	|	ЗаказПокупателяТовары.НомерСтроки,
	|	ЗаказПокупателяТовары.Номенклатура,
	|	ЗаказПокупателяТовары.ХарактеристикаНоменклатуры,
	|	ЗаказПокупателяТовары.СерияНоменклатуры,
	|	ЗаказПокупателяТовары.Ссылка.СкладГруппа КАК Склад,
	|	ЗаказПокупателяТовары.Количество
	|ПОМЕСТИТЬ ТабЗакПокуп
	|ИЗ
	|	Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары
	|ГДЕ
	|	ЗаказПокупателяТовары.Ссылка = &ЗаказПокупателя
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыВРезервеНаСкладахОстатки.Склад,
	|	ТоварыВРезервеНаСкладахОстатки.Номенклатура,
	|	ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры,
	|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва,
	|	ТоварыВРезервеНаСкладахОстатки.СерияНоменклатуры,
	|	ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток КАК КоличествоВРезерве
	|ПОМЕСТИТЬ ТабТоварыВРезерве
	|ИЗ
	|	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(, ДокументРезерва = &ЗаказПокупателя) КАК ТоварыВРезервеНаСкладахОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабЗакПокуп.Ссылка,
	|	ТабЗакПокуп.НомерСтроки,
	|	ТабЗакПокуп.Номенклатура КАК Номенклатура,
	|	ТабЗакПокуп.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ТабЗакПокуп.СерияНоменклатуры КАК СерияНоменклатуры,
	|	ТабЗакПокуп.Склад,
	|	ТабЗакПокуп.Количество,
	|	ЕСТЬNULL(ТабТоварыВРезерве.КоличествоВРезерве, 0) КАК КоличествоВРезерве
	|ИЗ
	|	ТабЗакПокуп КАК ТабЗакПокуп
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТабТоварыВРезерве КАК ТабТоварыВРезерве
	|		ПО ТабЗакПокуп.Ссылка = ТабТоварыВРезерве.ДокументРезерва
	|			И ТабЗакПокуп.Номенклатура = ТабТоварыВРезерве.Номенклатура
	|			И ТабЗакПокуп.ХарактеристикаНоменклатуры = ТабТоварыВРезерве.ХарактеристикаНоменклатуры
	|			И ТабЗакПокуп.СерияНоменклатуры = ТабТоварыВРезерве.СерияНоменклатуры
	|			И ТабЗакПокуп.Склад = ТабТоварыВРезерве.Склад
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура,
	|	ХарактеристикаНоменклатуры,
	|	СерияНоменклатуры";
	
	Запрос.УстановитьПараметр("ЗаказПокупателя", НовыйДокЗаказ.Ссылка);
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Количество() = 0 Тогда
		Возврат СтруктураВозврата;                                                    
	КонецЕсли; 
	
	ДокументКорректировки = Документы.КорректировкаЗаказаПокупателя.СоздатьДокумент();
	ДокументКорректировки.Заполнить(НовыйДокЗаказ.Ссылка);
	ДокументКорректировки.Дата = ТекущаяДата();
	ДокументКорректировки.Комментарий = Комментарий;
	ДокументКорректировки.ВалютаДокумента = НовыйДокЗаказ.ВалютаДокумента; 
	
	ДокументКорректировки.Товары.Очистить();
	ДокументКорректировки.Услуги.Очистить();                               
	ДокументКорректировки.ВозвратнаяТара.Очистить();
	
	Номенклатура = Неопределено;
	ХарактеристикаНоменклатуры = Неопределено;
	СерияНоменклатуры = Неопределено;
	
	КоличествоВРезерве = 0;                
	
	Пока РезультатЗапроса.Следующий() Цикл
		
		Если Номенклатура <> РезультатЗапроса.Номенклатура Или 
			
			ХарактеристикаНоменклатуры <> РезультатЗапроса.ХарактеристикаНоменклатуры Или 
			СерияНоменклатуры <> РезультатЗапроса.СерияНоменклатуры Тогда
			
			ХарактеристикаНоменклатуры = РезультатЗапроса.ХарактеристикаНоменклатуры;
			СерияНоменклатуры = РезультатЗапроса.СерияНоменклатуры;
			Номенклатура = РезультатЗапроса.Номенклатура;
			
			КоличествоВРезерве = РезультатЗапроса.КоличествоВРезерве;
			
		КонецЕсли; 
		
		
		Если РезультатЗапроса.Количество <= КоличествоВРезерве Тогда
			КоличествоВРезерве = КоличествоВРезерве - РезультатЗапроса.Количество;
		Иначе
			
			НоваяСтрока = ДокументКорректировки.Товары.Добавить();
			КоличествоКорректировки = РезультатЗапроса.Количество - КоличествоВРезерве;
			КоличествоВРезерве = 0;
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, НовыйДокЗаказ.Товары[РезультатЗапроса.НомерСтроки - 1]);	
			
			НоваяСтрока.Количество = -1 * КоличествоКорректировки;
			НоваяСтрока.Цена = НовыйДокЗаказ.Товары[РезультатЗапроса.НомерСтроки - 1].Цена;	
			НоваяСтрока.Причина = ?(НовыйДокЗаказ.ТаксиДоставка, Перечисления.ПричиныКорректировкиСборки.ОтказПоставщика, Перечисления.ПричиныКорректировкиСборки.ОтказКлиента);
			мВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();	
			
			ОбработкаТабличныхЧастей.ПриИзмененииНоменклатурыТабЧасти(НоваяСтрока, ДокументКорректировки);	
			ОбработкаТабличныхЧастей.ЗаполнитьСтавкуНДСТабЧасти(НоваяСтрока, ДокументКорректировки, "Реализация");
			ОбработкаТабличныхЧастей.РассчитатьКоличествоМестТабЧасти(НоваяСтрока, ДокументКорректировки);
			ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(НоваяСтрока, ДокументКорректировки);
			ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НоваяСтрока, ДокументКорректировки);	
			ОбработкаТабличныхЧастей.РассчитатьПлановуюСебестоимостьВСтрокеТабЧасти(НоваяСтрока, ДокументКорректировки, мВалютаРегламентированногоУчета);
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	ДокументКорректировки.СуммаДокумента = ДокументКорректировки.Товары.Итог("Сумма");

	Если НЕ ДокументКорректировки.Товары.Количество() = 0 Тогда
		
		Попытка
			
			Если ПараметрРежимПроведенияДокумента = Неопределено Тогда
				ДокументКорректировки.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Оперативный);		
			Иначе
				ДокументКорректировки.Записать(РежимЗаписиДокумента.Проведение, ПараметрРежимПроведенияДокумента);		
			КонецЕсли; 		
			
			СтруктураВозврата.Документ = ДокументКорректировки;
			
		Исключение
			
			СтруктураВозврата.Документ = ДокументКорректировки;
			СтруктураВозврата.Ошибка = ОписаниеОшибки();
			Возврат СтруктураВозврата;
			
		КонецПопытки;

	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции

Функция СоздатьКорректировкаЗаказаПокупателяПоТоварамТОХ(НовыйДокЗаказ, ПараметрРежимПроведенияДокумента = Неопределено, Комментарий = "") Экспорт
	
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("Документ", "");
	СтруктураВозврата.Вставить("Ошибка", "");

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Товары.НомерСтроки,
	|	Товары.Номенклатура,
	|	Товары.СерияНоменклатуры,
	|	Товары.Количество
	|ПОМЕСТИТЬ ТаблТовары
	|ИЗ
	|	&Товары КАК Товары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыНаСкладахОстатки.Номенклатура,
	|	ТоварыНаСкладахОстатки.СерияНоменклатуры,
	|	СУММА(ТоварыНаСкладахОстатки.КоличествоОстаток) КАК ОстатокСклад,
	|	СУММА(ЕСТЬNULL(ТоварыОтветственногоХраненияОстатки.КоличествоОстаток, 0)) КАК ОстатокТОХ,
	|	ТоварыНаСкладахОстатки.КоличествоОстаток
	|ПОМЕСТИТЬ ТаблОстатки
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(
	|			&Дата,
	|			(Номенклатура, СерияНоменклатуры) В
	|				(ВЫБРАТЬ
	|					ТаблТовары.Номенклатура,
	|					ТаблТовары.СерияНоменклатуры
	|				ИЗ
	|					ТаблТовары КАК ТаблТовары)) КАК ТоварыНаСкладахОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыОтветственногоХранения.Остатки(
	|				&Дата,
	|				(Номенклатура, СерияНоменклатуры) В
	|					(ВЫБРАТЬ
	|						ТаблТовары.Номенклатура,
	|						ТаблТовары.СерияНоменклатуры
	|					ИЗ
	|						ТаблТовары КАК ТаблТовары)) КАК ТоварыОтветственногоХраненияОстатки
	|		ПО ТоварыНаСкладахОстатки.Номенклатура = ТоварыОтветственногоХраненияОстатки.Номенклатура
	|			И ТоварыНаСкладахОстатки.СерияНоменклатуры = ТоварыОтветственногоХраненияОстатки.СерияНоменклатуры
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыНаСкладахОстатки.Номенклатура,
	|	ТоварыНаСкладахОстатки.СерияНоменклатуры,
	|	ТоварыНаСкладахОстатки.КоличествоОстаток
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблТовары.НомерСтроки,
	|	ТаблТовары.Номенклатура,
	|	ТаблТовары.СерияНоменклатуры,
	|	СУММА(ТаблТовары.Количество) КАК Количество,
	|	СУММА(ТаблОстатки.ОстатокСклад) КАК ОстатокСклад,
	|	СУММА(ТаблОстатки.ОстатокТОХ) КАК ОстатокТОХ,
	|	СУММА(ВЫБОР
	|			КОГДА ТаблОстатки.ОстатокСклад - ТаблОстатки.ОстатокТОХ < 0
	|				ТОГДА 0
	|			ИНАЧЕ ТаблОстатки.ОстатокСклад - ТаблОстатки.ОстатокТОХ
	|		КОНЕЦ) КАК ОстатокСкладБезТОХ
	|ПОМЕСТИТЬ ИтоговаяТаблица
	|ИЗ
	|	ТаблТовары КАК ТаблТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблОстатки КАК ТаблОстатки
	|		ПО (ТаблОстатки.Номенклатура = ТаблТовары.Номенклатура)
	|			И (ТаблОстатки.СерияНоменклатуры = ТаблТовары.СерияНоменклатуры)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблТовары.Номенклатура,
	|	ТаблТовары.СерияНоменклатуры,
	|	ТаблТовары.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИтоговаяТаблица.НомерСтроки,
	|	ИтоговаяТаблица.Номенклатура,
	|	ИтоговаяТаблица.СерияНоменклатуры,
	|	ИтоговаяТаблица.Количество КАК КоличествоВДокументе,
	|	ВЫБОР
	|		КОГДА ИтоговаяТаблица.ОстатокСкладБезТОХ >= ИтоговаяТаблица.Количество
	|			ТОГДА 0
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ИтоговаяТаблица.Количество - ИтоговаяТаблица.ОстатокСкладБезТОХ > ИтоговаяТаблица.ОстатокТОХ
	|					ТОГДА ИтоговаяТаблица.ОстатокТОХ
	|				ИНАЧЕ ИтоговаяТаблица.Количество - ИтоговаяТаблица.ОстатокСкладБезТОХ
	|			КОНЕЦ
	|	КОНЕЦ КАК Количество,
	|	ИтоговаяТаблица.ОстатокСклад,
	|	ИтоговаяТаблица.ОстатокТОХ,
	|	ИтоговаяТаблица.ОстатокСкладБезТОХ
	|ИЗ
	|	ИтоговаяТаблица КАК ИтоговаяТаблица
	|ГДЕ
	|	ВЫБОР
	|			КОГДА ИтоговаяТаблица.ОстатокСкладБезТОХ >= ИтоговаяТаблица.Количество
	|				ТОГДА 0
	|			ИНАЧЕ ВЫБОР
	|					КОГДА ИтоговаяТаблица.Количество - ИтоговаяТаблица.ОстатокСкладБезТОХ > ИтоговаяТаблица.ОстатокТОХ
	|						ТОГДА ИтоговаяТаблица.ОстатокТОХ
	|					ИНАЧЕ ИтоговаяТаблица.Количество - ИтоговаяТаблица.ОстатокСкладБезТОХ
	|				КОНЕЦ
	|		КОНЕЦ > 0";
	
	
	ТаблТоваров = НовыйДокЗаказ.Товары.Выгрузить();
	ТаблТоваров.Свернуть("НомерСтроки, Номенклатура, СерияНоменклатуры", "Количество");  
	
	Запрос.УстановитьПараметр("Товары", ТаблТоваров); 
	Запрос.УстановитьПараметр("Дата", Новый Граница(НовыйДокЗаказ.Дата, ВидГраницы.Исключая));

	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Количество() = 0 Тогда
		Возврат СтруктураВозврата;                                                    
	КонецЕсли; 
	
	ДокументКорректировки = Документы.КорректировкаЗаказаПокупателя.СоздатьДокумент();
	ДокументКорректировки.Заполнить(НовыйДокЗаказ.Ссылка);
	ДокументКорректировки.Дата = ТекущаяДата();
	ДокументКорректировки.Комментарий = Комментарий;
	ДокументКорректировки.ВалютаДокумента = НовыйДокЗаказ.ВалютаДокумента; 
	
	ДокументКорректировки.Товары.Очистить();
	ДокументКорректировки.Услуги.Очистить();                               
	ДокументКорректировки.ВозвратнаяТара.Очистить();
	
	Номенклатура = Неопределено;
	СерияНоменклатуры = Неопределено;
	
	
	Пока РезультатЗапроса.Следующий() Цикл
		
		НоваяСтрока = ДокументКорректировки.Товары.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, НовыйДокЗаказ.Товары[РезультатЗапроса.НомерСтроки - 1]);	
		НоваяСтрока.Количество = -1 * РезультатЗапроса.Количество;
		НоваяСтрока.Цена = НовыйДокЗаказ.Товары[РезультатЗапроса.НомерСтроки - 1].Цена;	
		НоваяСтрока.Причина = Перечисления.ПричиныКорректировкиСборки.ОтказПоставщика;
		мВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();	
		
		ОбработкаТабличныхЧастей.ПриИзмененииНоменклатурыТабЧасти(НоваяСтрока, ДокументКорректировки);	
		ОбработкаТабличныхЧастей.ЗаполнитьСтавкуНДСТабЧасти(НоваяСтрока, ДокументКорректировки, "Реализация");
		ОбработкаТабличныхЧастей.РассчитатьКоличествоМестТабЧасти(НоваяСтрока, ДокументКорректировки);
		ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(НоваяСтрока, ДокументКорректировки);
		ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НоваяСтрока, ДокументКорректировки);	
		ОбработкаТабличныхЧастей.РассчитатьПлановуюСебестоимостьВСтрокеТабЧасти(НоваяСтрока, ДокументКорректировки, мВалютаРегламентированногоУчета);
		
	КонецЦикла; 
	
	ДокументКорректировки.СуммаДокумента = ДокументКорректировки.Товары.Итог("Сумма");

	Если НЕ ДокументКорректировки.Товары.Количество() = 0 Тогда
		
		Попытка
			
			Если ПараметрРежимПроведенияДокумента = Неопределено Тогда
				ДокументКорректировки.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Оперативный);		
			Иначе
				ДокументКорректировки.Записать(РежимЗаписиДокумента.Проведение, ПараметрРежимПроведенияДокумента);		
			КонецЕсли; 		
			
			СтруктураВозврата.Документ = ДокументКорректировки;
			
		Исключение
			
			СтруктураВозврата.Документ = ДокументКорректировки;
			СтруктураВозврата.Ошибка = ОписаниеОшибки();
			Возврат СтруктураВозврата;
			
		КонецПопытки;

	КонецЕсли;

	Возврат СтруктураВозврата;

КонецФункции

Функция СоздатьКорректировкаЗаказаПокупателяПоКратностиФилиала(НовыйДокЗаказ, ПараметрРежимПроведенияДокумента = Неопределено, Комментарий = "") Экспорт
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("Документ", "");
	СтруктураВозврата.Вставить("Ошибка", "");

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказПокупателяТовары.Ссылка,
	|	ЗаказПокупателяТовары.НомерСтроки,
	|	ЗаказПокупателяТовары.Номенклатура,
	|	ЗаказПокупателяТовары.ХарактеристикаНоменклатуры,
	|	ЗаказПокупателяТовары.СерияНоменклатуры,
	|	ЗаказПокупателяТовары.Ссылка.СкладГруппа КАК Склад,
	|	ЗаказПокупателяТовары.Количество
	|ПОМЕСТИТЬ ТабЗакПокуп
	|ИЗ
	|	Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары
	|ГДЕ
	|	ЗаказПокупателяТовары.Ссылка = &ЗаказПокупателя
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыВРезервеНаСкладахОстатки.Склад,
	|	ТоварыВРезервеНаСкладахОстатки.Номенклатура,
	|	ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры,
	|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва,
	|	ТоварыВРезервеНаСкладахОстатки.СерияНоменклатуры,
	|	ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток КАК КоличествоВРезерве
	|ПОМЕСТИТЬ ТабТоварыВРезерве
	|ИЗ
	|	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(, ДокументРезерва = &ЗаказПокупателя) КАК ТоварыВРезервеНаСкладахОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабЗакПокуп.Ссылка,
	|	ТабЗакПокуп.НомерСтроки,
	|	ТабЗакПокуп.Номенклатура КАК Номенклатура,
	|	ТабЗакПокуп.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ТабЗакПокуп.СерияНоменклатуры КАК СерияНоменклатуры,
	|	ТабЗакПокуп.Склад,
	|	ТабЗакПокуп.Количество,
	|	ЕСТЬNULL(ТабТоварыВРезерве.КоличествоВРезерве, 0) КАК КоличествоВРезерве
	|ПОМЕСТИТЬ ИтоговаяТаблица
	|ИЗ
	|	ТабЗакПокуп КАК ТабЗакПокуп
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТабТоварыВРезерве КАК ТабТоварыВРезерве
	|		ПО ТабЗакПокуп.Ссылка = ТабТоварыВРезерве.ДокументРезерва
	|			И ТабЗакПокуп.Номенклатура = ТабТоварыВРезерве.Номенклатура
	|			И ТабЗакПокуп.ХарактеристикаНоменклатуры = ТабТоварыВРезерве.ХарактеристикаНоменклатуры
	|			И ТабЗакПокуп.СерияНоменклатуры = ТабТоварыВРезерве.СерияНоменклатуры
	|			И ТабЗакПокуп.Склад = ТабТоварыВРезерве.Склад
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИтоговаяТаблица.Ссылка,
	|	ИтоговаяТаблица.НомерСтроки,
	|	ИтоговаяТаблица.Номенклатура,
	|	ИтоговаяТаблица.ХарактеристикаНоменклатуры,
	|	ИтоговаяТаблица.СерияНоменклатуры,
	|	ИтоговаяТаблица.Склад,
	|	ИтоговаяТаблица.Количество,
	|	ИтоговаяТаблица.КоличествоВРезерве
	|ИЗ
	|	ИтоговаяТаблица КАК ИтоговаяТаблица
	|ГДЕ
	|	ИтоговаяТаблица.КоличествоВРезерве = 0
	|	И НЕ ИтоговаяТаблица.Номенклатура.НеОчищатьКратностьПриНулевыхОстатках
	|	И ВЫБОР
	|			КОГДА НЕ ЦЕЛ(ИтоговаяТаблица.Количество / ИтоговаяТаблица.Номенклатура.Кратность) = ИтоговаяТаблица.Количество / ИтоговаяТаблица.Номенклатура.Кратность
	|					И НЕ ИтоговаяТаблица.Номенклатура.Кратность = ИтоговаяТаблица.Номенклатура.КратностьФилиала
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ";
	
	Запрос.УстановитьПараметр("ЗаказПокупателя", НовыйДокЗаказ.Ссылка);
	РезультатЗапроса = Запрос.Выполнить().Выбрать();	
	
	Если РезультатЗапроса.Количество() = 0 Тогда
		Возврат СтруктураВозврата;                                                    
	КонецЕсли; 
	
	ДокументКорректировки = Документы.КорректировкаЗаказаПокупателя.СоздатьДокумент();
	ДокументКорректировки.Заполнить(НовыйДокЗаказ.Ссылка);
	ДокументКорректировки.Дата = ТекущаяДата();
	ДокументКорректировки.Комментарий = Комментарий;
	ДокументКорректировки.ВалютаДокумента = НовыйДокЗаказ.ВалютаДокумента; 
	ДокументКорректировки.Товары.Очистить();
	ДокументКорректировки.Услуги.Очистить();                               
	ДокументКорректировки.ВозвратнаяТара.Очистить();
	
	Номенклатура = Неопределено;
	ХарактеристикаНоменклатуры = Неопределено;
	СерияНоменклатуры = Неопределено;
	КоличествоВРезерве = 0;
	
	Пока РезультатЗапроса.Следующий() Цикл
		
		Если Номенклатура <> РезультатЗапроса.Номенклатура Или 
			ХарактеристикаНоменклатуры <> РезультатЗапроса.ХарактеристикаНоменклатуры Или 
			СерияНоменклатуры <> РезультатЗапроса.СерияНоменклатуры Тогда
			
			ХарактеристикаНоменклатуры = РезультатЗапроса.ХарактеристикаНоменклатуры;
			СерияНоменклатуры = РезультатЗапроса.СерияНоменклатуры;
			Номенклатура = РезультатЗапроса.Номенклатура;
			
			КоличествоВРезерве = РезультатЗапроса.КоличествоВРезерве;
			
		КонецЕсли; 
		
		Если РезультатЗапроса.Количество <= КоличествоВРезерве Тогда
			КоличествоВРезерве = КоличествоВРезерве - РезультатЗапроса.Количество;
		Иначе
			
			НоваяСтрока = ДокументКорректировки.Товары.Добавить();
			КоличествоКорректировки = РезультатЗапроса.Количество - КоличествоВРезерве;
			КоличествоВРезерве = 0;
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, НовыйДокЗаказ.Товары[РезультатЗапроса.НомерСтроки - 1]);	
			НоваяСтрока.Количество = -1 * КоличествоКорректировки;
			НоваяСтрока.Цена = НовыйДокЗаказ.Товары[РезультатЗапроса.НомерСтроки - 1].Цена;	
			НоваяСтрока.Причина = Перечисления.ПричиныКорректировкиСборки.ОтказПоставщика; 		
			мВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();	
			
			ОбработкаТабличныхЧастей.ПриИзмененииНоменклатурыТабЧасти(НоваяСтрока, ДокументКорректировки);	
			ОбработкаТабличныхЧастей.ЗаполнитьСтавкуНДСТабЧасти(НоваяСтрока, ДокументКорректировки, "Реализация");
			ОбработкаТабличныхЧастей.РассчитатьКоличествоМестТабЧасти(НоваяСтрока, ДокументКорректировки);
			ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(НоваяСтрока, ДокументКорректировки);
			ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НоваяСтрока, ДокументКорректировки);	
			ОбработкаТабличныхЧастей.РассчитатьПлановуюСебестоимостьВСтрокеТабЧасти(НоваяСтрока, ДокументКорректировки, мВалютаРегламентированногоУчета);
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	ДокументКорректировки.СуммаДокумента = ДокументКорректировки.Товары.Итог("Сумма");
	
	Если НЕ ДокументКорректировки.Товары.Количество() = 0 Тогда
		
		Попытка
			
			Если ПараметрРежимПроведенияДокумента = Неопределено Тогда
				ДокументКорректировки.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Оперативный);		
			Иначе
				ДокументКорректировки.Записать(РежимЗаписиДокумента.Проведение, ПараметрРежимПроведенияДокумента);		
			КонецЕсли; 		
			
			СтруктураВозврата.Документ = ДокументКорректировки;
			
		Исключение
			
			СтруктураВозврата.Документ = ДокументКорректировки;
			СтруктураВозврата.Ошибка = ОписаниеОшибки();
			Возврат СтруктураВозврата;
			
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат СтруктураВозврата;

КонецФункции

Функция СозданиеЗаказПокупателя(ДанныеШапки, ДанныеТЧТовары) Экспорт
	
	//+Шульман А. 21.01.2025 #UT10-5059  
	Результат = Новый Структура("Результат, ТекстОшибки, ГУИДЗаказа, НомерЗаказа, Создан, Проведен, ПомеченНаУдаление, ДанныеТЧТовары", 
	Ложь, "", "", "", Ложь, Ложь, Ложь, Неопределено);  
	
	ВидыПроцессов = Новый Соответствие();
	ВидыПроцессов.Вставить("Возврат неликвида ТОХ через WMS", Перечисления.ВидыПроцессов.ВозвратНеликвидаТОХчерезWMS);  
	ВидыПроцессов.Вставить("Возврат неликвида ТОХ напрямую поставщику", Перечисления.ВидыПроцессов.ВозвратНеликвидаТОХНапрямуюПоставщику);  
	
	СтрШапка = ХранилищеJSONВСтруктуру(ДанныеШапки);
	
	ГУИДДокумента = СтрШапка.ГУИДДокумента;
	
	МассивДанных = ХранилищеJSONВСтруктуру(ДанныеТЧТовары);   
	тзДанныеТЧТовары = ОбщегоНазначения.ПреобразоватьМассивВТаблицуЗначений(МассивДанных);
	
	ДокСсылка = Неопределено;        
	СкладГруппа = Константы.ОсновнойСклад.Получить();
	
	Если Не ПустаяСтрока(ГУИДДокумента) И СтрДлина(ГУИДДокумента) = 36 Тогда   
		
		Попытка
			ДокСсылка = Документы.ЗаказПокупателя.ПолучитьСсылку(Новый УникальныйИдентификатор(ГУИДДокумента));
		Исключение
			
			Результат.ТекстОшибки = "Ошибка при получении заказа с ГУИД " + ГУИДДокумента + ". " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			Возврат Результат;
			
		КонецПопытки;
	
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДокСсылка) Тогда
		
		
		ДокОбъект = Документы.ЗаказПокупателя.СоздатьДокумент();
		ДокОбъект.Дата = ТекущаяДата();
		ДокОбъект.Организация = Константы.ОсновнаяОрганизация.Получить();
		ДокОбъект.КроссДокинг = СтрШапка.КроссДокинг;  
		ДокОбъект.ВидПроцесса = ВидыПроцессов.Получить(СтрШапка.ВидПроцесса);    
		
		Если ЗначениеЗаполнено(СтрШапка.КонтрагентКодМДМ) Тогда
			ДокОбъект.Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту("КодМДМ", СтрШапка.КонтрагентКодМДМ);           
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрШапка.ДоговорКонтрагентаКодМДМ) Тогда
			ДокОбъект.ДоговорКонтрагента = Справочники.ДоговорыКонтрагентов.НайтиПоРеквизиту("КодМДМ", СтрШапка.ДоговорКонтрагентаКодМДМ);
		КонецЕсли;      
		
		ДокОбъект.Грузополучатель = Справочники.Контрагенты.НайтиПоРеквизиту("КодМДМ", СтрШапка.ПартнерКодМДМ); 
		ДокОбъект.СпособДоставки = ДокОбъект.Грузополучатель.СпособДоставки;
		ДокОбъект.ИсточникЗаказа        	= Справочники.ИсточникиЗаказов.НайтиПоРеквизиту("КодИсточника", 5);   
		ДокОбъект.ВалютаДокумента 			= ДокОбъект.ДоговорКонтрагента.ВалютаВзаиморасчетов; 

		ДокОбъект.КурсВзаиморасчетов 		= 1;
		ДокОбъект.КратностьВзаиморасчетов 	= 1;
		ДокОбъект.СуммаВключаетНДС 			= Истина;
		ДокОбъект.УчитыватьНДС 				= Истина;
		ДокОбъект.СкладГруппа				= СкладГруппа;   
		ДокОбъект.Подразделение = УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(ПараметрыСеанса.ТекущийПользователь, "ОсновноеПодразделение");
		ДокОбъект.Ответственный         	= ПараметрыСеанса.ТекущийПользователь;
		
		ДокОбъект.Комментарий = СтрШапка.Комментарий;  
		
		Результат.Создан = Истина;
		
	Иначе                                  
		
		ДокОбъект = ДокСсылка.ПолучитьОбъект();   
		ДокОбъект.ПометкаУдаления = Ложь;  
		
	КонецЕсли;     
	
	// Полученные товары сравниваются с остатками и распределяются по сериям.
	// Превышение остатка заносится в корректировку заказа
	Запрос = Новый Запрос;     
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	тзДанныеТЧТовары.НоменклатураКодМДМ,
	|	тзДанныеТЧТовары.Количество,
	|	тзДанныеТЧТовары.Цена,
	|	тзДанныеТЧТовары.КлючСтроки
	|ПОМЕСТИТЬ ВТ_ДанныеТЧТовары
	|ИЗ
	|	&тзДанныеТЧТовары КАК тзДанныеТЧТовары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(Номенклатура.Ссылка, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК Номенклатура,
	|	ЕСТЬNULL(Номенклатура.ЕдиницаХраненияОстатков, ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)) КАК ЕдиницаИзмерения,  
	|	ЕСТЬNULL(Номенклатура.СтавкаНДС, ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка)) КАК СтавкаНДС,
	|	ВТ_ДанныеТЧТовары.НоменклатураКодМДМ,
	|	ВТ_ДанныеТЧТовары.Количество,
	|	ВТ_ДанныеТЧТовары.Цена,
	|	ВТ_ДанныеТЧТовары.КлючСтроки,
	|	ВЫБОР
	|		КОГДА Номенклатура.Ссылка ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК НайденаНоменклатура
	|ПОМЕСТИТЬ ВТ_Товары
	|ИЗ
	|	ВТ_ДанныеТЧТовары КАК ВТ_ДанныеТЧТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|		ПО (Номенклатура.КодМДМ = ВТ_ДанныеТЧТовары.НоменклатураКодМДМ)
	|        И  НЕ Номенклатура.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Товары.Номенклатура КАК Номенклатура,
	|	ВТ_Товары.Номенклатура.КодМДМ КАК НоменклатураКодМДМ,
	|	ПартииТоваровНаСкладахОстатки.СерияНоменклатуры,
	|	ПартииТоваровНаСкладахОстатки.КоличествоОстаток,
	|	ПартииТоваровНаСкладахОстатки.СтоимостьОстаток,
	|	ВТ_Товары.Количество КАК Количество,
	|	ВТ_Товары.Цена КАК Цена,
	|	ВТ_Товары.КлючСтроки КАК КлючСтроки,
	|	ВТ_Товары.НайденаНоменклатура КАК НайденаНоменклатура
	|ИЗ
	|	ВТ_Товары КАК ВТ_Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПартииТоваровНаСкладах.Остатки(
	|				&МоментДокумента,
	|				Номенклатура В
	|					(ВЫБРАТЬ
	|						ВТ_Товары.Номенклатура
	|					ИЗ
	|						ВТ_Товары КАК ВТ_Товары
	|					ГДЕ
	|						ВТ_Товары.НайденаНоменклатура)) КАК ПартииТоваровНаСкладахОстатки
	|		ПО ВТ_Товары.Номенклатура = ПартииТоваровНаСкладахОстатки.Номенклатура
	|			И (ВТ_Товары.НайденаНоменклатура)
	|ГДЕ
	|	ПартииТоваровНаСкладахОстатки.КоличествоОстаток > 0";
	
	ТЧТовары = Новый ТаблицаЗначений;
	ТЧТовары.Колонки.Добавить("НоменклатураКодМДМ", ОбщегоНазначения.ОписаниеТипаСтрока(36));
	ТЧТовары.Колонки.Добавить("КлючСтроки", ОбщегоНазначения.ОписаниеТипаЧисло(5, 0, ДопустимыйЗнак.Неотрицательный));
	ТЧТовары.Колонки.Добавить("Количество", ОбщегоНазначения.ОписаниеТипаЧисло(15, 3, ДопустимыйЗнак.Неотрицательный));	
	ТЧТовары.Колонки.Добавить("Цена", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2, ДопустимыйЗнак.Неотрицательный));	
	
	Для каждого тзСтрока Из тзДанныеТЧТовары Цикл
		
		ДобСтрока = ТЧТовары.Добавить();
		ЗаполнитьЗначенияСвойств(ДобСтрока, тзСтрока);
		
	КонецЦикла; 
	
	Запрос.УстановитьПараметр("тзДанныеТЧТовары", ТЧТовары);    
	Запрос.УстановитьПараметр("МоментДокумента", ?(ЗначениеЗаполнено(ДокСсылка), ДокСсылка.МоментВремени(), Неопределено));
	
	ОстаткиПартий = Запрос.Выполнить().Выгрузить();  
	ТаблицаРаспределения = Запрос.МенеджерВременныхТаблиц.Таблицы["ВТ_Товары"].ПолучитьДанные().Выгрузить();
	
	ДокОбъект.Товары.Очистить(); 
	
	ТЧТовары = Новый ТаблицаЗначений;    
	ТЧТовары.Колонки.Добавить("Номенклатура");
	ТЧТовары.Колонки.Добавить("НоменклатураКодМДМ", ОбщегоНазначения.ОписаниеТипаСтрока(36));
	ТЧТовары.Колонки.Добавить("КодСтроки", ОбщегоНазначения.ОписаниеТипаЧисло(5, 0, ДопустимыйЗнак.Неотрицательный));
	ТЧТовары.Колонки.Добавить("Количество", ОбщегоНазначения.ОписаниеТипаЧисло(15, 3, ДопустимыйЗнак.Неотрицательный));	
	
	Для Каждого СтрокаТовара из ТаблицаРаспределения Цикл 
		
		СтруктураОтбора 	= Новый Структура("Номенклатура", СтрокаТовара.Номенклатура);
		МассивСтрокПартий 	= ОстаткиПартий.НайтиСтроки(СтруктураОтбора); 
		
		Распределить = СтрокаТовара.Количество;
		
		Для каждого СтрокаПартия из МассивСтрокПартий Цикл                      
			
			Если Распределить <= 0 Тогда 
				Прервать;
			КонецЕсли;    
			
			Если СтрокаПартия.КоличествоОстаток <= 0 Тогда 
				Продолжить;
			КонецЕсли;	
			
			МожноРаспределить 	= Мин(Распределить, СтрокаПартия.КоличествоОстаток);
			
			НоваяСтрока = ДокОбъект.Товары.Добавить();
			НоваяСтрока.Номенклатура 		= СтрокаТовара.Номенклатура; 
			НоваяСтрока.ЕдиницаИзмерения    = СтрокаТовара.ЕдиницаИзмерения;  
			НоваяСтрока.ЕдиницаИзмеренияМест = СтрокаТовара.ЕдиницаИзмерения;
			//+Гавриленков В. 18.12.2025 #UT10-5598
			//НоваяСтрока.СтавкаНДС           = СтрокаТовара.СтавкаНДС;
			НоваяСтрока.СтавкаНДС           = УчетНДС.ПолучитьСтавкуНДСПоНоменклатуре(СтрокаТовара.Номенклатура, ?(ЗначениеЗаполнено(ДокСсылка), ДокСсылка.Дата, Неопределено));
			//-Гавриленков В. 18.12.2025 #UT10-5598
			НоваяСтрока.Коэффициент         = СтрокаТовара.ЕдиницаИзмерения.Коэффициент;
			НоваяСтрока.СерияНоменклатуры 	= СтрокаПартия.СерияНоменклатуры;
			НоваяСтрока.Количество 			= МожноРаспределить;     
			НоваяСтрока.КоличествоМест		= МожноРаспределить;
			НоваяСтрока.Цена 				= СтрокаТовара.Цена;
			НоваяСтрока.Сумма 				= СтрокаТовара.Цена * МожноРаспределить;        
			НоваяСтрока.КлючСтроки          = СтрокаПартия.КлючСтроки;
			НоваяСтрока.Размещение 			= СкладГруппа;
			ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НоваяСтрока, ДокОбъект);

			ДобСтрока = ТЧТовары.Добавить();     
			ДобСтрока.Номенклатура = СтрокаТовара.Номенклатура;     
			ДобСтрока.НоменклатураКодМДМ = СтрокаТовара.НоменклатураКодМДМ;     
			ДобСтрока.Количество = МожноРаспределить;
			ДобСтрока.КодСтроки = СтрокаТовара.КлючСтроки;
			
			Распределить = Распределить - МожноРаспределить; 
			
			СтрокаПартия.КоличествоОстаток = СтрокаПартия.КоличествоОстаток - МожноРаспределить;
			
		КонецЦикла;      
			
		//+Шульман А. 21.02.2025 #UT10-5103  
		// Количество, превышающее остаток, заносится в док.Заказ
		Если Распределить > 0 Тогда
			
			НоваяСтрока = ДокОбъект.Товары.Добавить();
			НоваяСтрока.Номенклатура 		= СтрокаТовара.Номенклатура; 
			НоваяСтрока.ЕдиницаИзмерения    = СтрокаТовара.ЕдиницаИзмерения;  
			НоваяСтрока.ЕдиницаИзмеренияМест = СтрокаТовара.ЕдиницаИзмерения;
			//+Гавриленков В. 18.12.2025 #UT10-5598
			//НоваяСтрока.СтавкаНДС           = СтрокаТовара.СтавкаНДС;
			НоваяСтрока.СтавкаНДС           = УчетНДС.ПолучитьСтавкуНДСПоНоменклатуре(СтрокаТовара.Номенклатура, ?(ЗначениеЗаполнено(ДокСсылка), ДокСсылка.Дата, Неопределено));
			//-Гавриленков В. 18.12.2025 #UT10-5598
			НоваяСтрока.Коэффициент         = СтрокаТовара.ЕдиницаИзмерения.Коэффициент;   
			НоваяСтрока.Количество 			= Распределить;     
			НоваяСтрока.КоличествоМест		= Распределить;
			НоваяСтрока.Цена 				= СтрокаТовара.Цена;
			НоваяСтрока.Сумма 				= СтрокаТовара.Цена * Распределить;        
			НоваяСтрока.Размещение 			= "";
			ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НоваяСтрока, ДокОбъект);
			
			ДобСтрока = ТЧТовары.Добавить();          
			ДобСтрока.Номенклатура = СтрокаТовара.Номенклатура;     
			ДобСтрока.НоменклатураКодМДМ = СтрокаТовара.НоменклатураКодМДМ;     
			ДобСтрока.Количество = Распределить;
			ДобСтрока.КодСтроки = СтрокаТовара.КлючСтроки;
			
		КонецЕсли;
		//-Шульман А. 21.02.2025 #UT10-5103
		
	КонецЦикла;	       
	
	//+Шульман А. 21.02.2025 #UT10-5103
	ТЧТовары.Свернуть("Номенклатура, НоменклатураКодМДМ, КодСтроки", "Количество");
	//-Шульман А. 21.02.2025 #UT10-5103
	
	Попытка
		ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		
		Результат.Создан = Ложь;
		Результат.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
		
	КонецПопытки;
	
	Если ДокОбъект.Товары.Количество() Тогда
		
		Попытка
			
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);  
			Результат.Проведен = Истина;  
			
		Исключение
			Результат.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		
	Иначе
		
		Попытка

			ДокОбъект.УстановитьПометкуУдаления(Истина);
			Результат.ПомеченНаУдаление = Истина;   
			Результат.Проведен = Истина;
		
		Исключение
			Результат.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		
	КонецЕсли;   
	
	//+Шульман А. 21.02.2025 #UT10-5103   
	// Создается сборка    
	Если ДокОбъект.Проведен Тогда
	
		ТекстОшибкиСборка = "";
		ОтказСборка  = Ложь;
		
		МассивСборок = Документы.СборкаЗаказовПокупателя.СоздатьСборкиПоЗаказуПокупателя(ДокОбъект.Ссылка, ТекстОшибкиСборка, ОтказСборка);
		
		// Заполняется корректировка ЗП с учетом сборок        
		Если Не ОтказСборка Тогда        
			
			ТекстОшибкиКорректировка = "";    
			ОтказКорректировка = Ложь;    
			ДокКорректировка = Документы.КорректировкаЗаказаПокупателя.СоздатьДокумент();

			Документы.КорректировкаЗаказаПокупателя.ЗаполнитьКорректировкуЗаказовПокупателяСУчетомСборки(ДокОбъект, ДокКорректировка, МассивСборок, ТекстОшибкиКорректировка, ОтказКорректировка);
			
			Если Не ПустаяСтрока(ТекстОшибкиКорректировка) Тогда
				Результат.ТекстОшибки = ТекстОшибкиКорректировка;    
			Иначе
				
				// Изменить количество в ТЧТовары в связи с корректировкой
				тзКорр = ДокКорректировка.Товары.Выгрузить();
				тзКорр.Свернуть("Номенклатура", "Количество");
				
				Для каждого тзСтрока Из тзКорр Цикл
					
					МассивСтрок = ТЧТовары.НайтиСтроки(Новый Структура("Номенклатура", тзСтрока.Номенклатура));  
					
					Для каждого тзСтрокаТЧ Из МассивСтрок Цикл              
						
						НовоеКоличество = тзСтрокаТЧ.Количество + тзСтрока.Количество;
						тзСтрокаТЧ.Количество = НовоеКоличество;         
						тзСтрока.Количество = тзСтрока.Количество + НовоеКоличество;
					
					КонецЦикла;
				
				КонецЦикла;  
				
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЕсли;                 
	
	ТЧТовары.Колонки.Удалить("Номенклатура");
	//-Шульман А. 21.02.2025 #UT10-5103
	
	Результат.ГУИДЗаказа = Строка(ДокОбъект.Ссылка.УникальныйИдентификатор());
	Результат.НомерЗаказа = ДокОбъект.Номер;             
	
	Результат.ДанныеТЧТовары = МодульРегламентныхЗаданий.ТаблицуВМассив(ТЧТовары);
	
	Результат.Результат = Истина;
	
	Возврат Результат;
	//-Шульман А. 21.01.2025 #UT10-5059

КонецФункции

/////////////////Вспомогательные процедуры//////////////////
Функция ТаблицуВМассив(Таблица)
	
	МассивДанных = Новый Массив;
	
	Для Каждого ТекСтрока Из Таблица Цикл
		
		СтруктураДанных = Новый Структура;
		
		Для Каждого Колонка ИЗ Таблица.Колонки Цикл
			
			Если ЭтоСсылка(ТекСтрока[Колонка.Имя]) Тогда
				
				Если Колонка.Имя = "Номенклатура" ИЛИ Колонка.Имя = "Ссылка" Тогда
					СтруктураДанных.Вставить(Колонка.Имя, ?(ТекСтрока[Колонка.Имя] = NULL, "", Строка(ТекСтрока[Колонка.Имя].УникальныйИдентификатор())));
				Иначе
					СтруктураДанных.Вставить(Колонка.Имя, Строка(ТекСтрока[Колонка.Имя]));
				КонецЕсли;
				
			Иначе
				СтруктураДанных.Вставить(Колонка.Имя, ТекСтрока[Колонка.Имя]);
			КонецЕсли;
			
		КонецЦикла;
		
		МассивДанных.Добавить(СтруктураДанных);
		
	КонецЦикла;
	
	Возврат МассивДанных;
	
КонецФункции

Функция ЭтоСсылка(Значение)
	
	Если ТипЗнч(Значение) = Тип("Число") ИЛИ ТипЗнч(Значение) = Тип("Строка") ИЛИ ТипЗнч(Значение) = Тип("Дата") 
	 ИЛИ ТипЗнч(Значение) = Тип("Булево") ИЛИ ТипЗнч(Значение) = Тип("Структура") Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

Функция ХранилищеJSONВСтруктуру(Данные)Экспорт
	
	ДанныеТекст = Данные.Получить();
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ДанныеТекст);
	ДанныеСтруктура = ПрочитатьJSON(ЧтениеJSON);
	
	Возврат ДанныеСтруктура;
	
КонецФункции

Функция ДанныеВJSONХранилище(Данные) Экспорт
	
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	JsonСтрока = ЗаписьJSON.Закрыть(); 	
	
	ДанныеВозврат = Новый ХранилищеЗначения(JsonСтрока, Новый СжатиеДанных(9));
	
	Возврат ДанныеВозврат;
	
КонецФункции

Функция ДвоичноеВДесятичное(Знач Стр2) Экспорт
	
	Стр = СокрЛП(Стр2);
	Рез = 0;
	
	Для Н = 1 по СтрДлина(Стр) Цикл
		Рез = Рез * 2 + Число(Сред(Стр, Н, 1));
	КонецЦикла;
	
	Возврат Рез;
	
КонецФункции   

Функция ЗначениеДопСвойства(СсылкаНаОбъект, Свойство) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗначенияСвойствОбъектов.Объект,
	               |	ЗначенияСвойствОбъектов.Свойство,
	               |	ЗначенияСвойствОбъектов.Значение
	               |ИЗ
	               |	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	               |ГДЕ
	               |	ЗначенияСвойствОбъектов.Объект = &СсылкаНаОбъект
	               |	И ЗначенияСвойствОбъектов.Свойство = &Свойство";
	
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
	Запрос.УстановитьПараметр("Свойство", Свойство);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Возврат Выборка.Значение;
		
	КонецЕсли;
	
КонецФункции

Функция УстановитьЗначениеДопСвойства(СсылкаНаОбъект, Свойство, Значение) Экспорт
	
	ЗаменаЗначения = Ложь;
	
	НаборЗаписей = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Объект.Установить(СсылкаНаОбъект);
	НаборЗаписей.Отбор.Свойство.Установить(Свойство);
	
	УстановитьПривилегированныйРежим(Истина);	
	НаборЗаписей.Прочитать();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если НаборЗаписей.Количество() = 0 Тогда
		
		ЗаписьРегистра = НаборЗаписей.Добавить();
		ЗаписьРегистра.Объект = СсылкаНаОбъект;
		ЗаписьРегистра.Свойство = Свойство;
		
	Иначе
		
		ЗаписьРегистра = НаборЗаписей[0];
		ЗаменаЗначения = Истина;
		
	КонецЕсли;
	
	ЗаписьРегистра.Значение = Значение;
	УстановитьПривилегированныйРежим(Истина);	
	НаборЗаписей.Записать();
	УстановитьПривилегированныйРежим(Ложь); 
	
	//+Белов А. 07.05.2025 #UT10-5225
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг")
		И Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.СтатусПриемки 
		И Значение = Перечисления.СтатусыПриемки.Завершено Тогда
		
		НаборЗаписей = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Объект.Установить(СсылкаНаОбъект);
		НаборЗаписей.Отбор.Свойство.Установить(ПланыВидовХарактеристик.СвойстваОбъектов.ДатаИВремяЗакрытия);
		
		УстановитьПривилегированныйРежим(Истина);	
		НаборЗаписей.Прочитать();
		УстановитьПривилегированныйРежим(Ложь); 
		
		Если НаборЗаписей.Количество() = 0 Тогда
			
			ЗаписьРегистра = НаборЗаписей.Добавить();
			ЗаписьРегистра.Объект = СсылкаНаОбъект;
			ЗаписьРегистра.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.ДатаИВремяЗакрытия;  
			ЗаписьРегистра.Значение = ТекущаяДата();
			
			УстановитьПривилегированныйРежим(Истина);	
			НаборЗаписей.Записать();
			УстановитьПривилегированныйРежим(Ложь); 
			
		КонецЕсли;     
						
	КонецЕсли;	
	//-Белов А. 07.05.2025 #UT10-5225
	
	Возврат ЗаменаЗначения;
	
КонецФункции

Функция ПолучитьОписаниеПараметровВэбСервиса(ПромПараметры) Экспорт

	СтрокаПараметровВэбСервиса = "";
	
	Попытка
		
		Если НЕ ПромПараметры.Свойства().Получить("Lines") = Неопределено ИЛИ НЕ ПромПараметры.Свойства().Получить("ROW") = Неопределено Тогда
			
			Если НЕ ПромПараметры.Свойства().Получить("Lines") = Неопределено  Тогда
				ПромСписок = ПромПараметры.ПолучитьСписок("Lines");
			Иначе
				ПромСписок = ПромПараметры.ПолучитьСписок("ROW");
			КонецЕсли;
			
			Для Каждого СтрокаСписка Из ПромСписок Цикл
				
				Для Каждого ПромСвойствоСтроки Из СтрокаСписка.Свойства() Цикл 
					СтрокаПараметровВэбСервиса = СтрокаПараметровВэбСервиса + """" + ПромСвойствоСтроки.Имя + ": """ + СтрокаСписка.Получить(ПромСвойствоСтроки) + ";"; 
				КонецЦикла;
				
				СтрокаПараметровВэбСервиса = СтрокаПараметровВэбСервиса+Символы.ПС;
				
			КонецЦикла;		
			
		Иначе		
			
			Для Каждого ПромСвойство Из ПромПараметры.Свойства() Цикл 
				СтрокаПараметровВэбСервиса = СтрокаПараметровВэбСервиса + """" + ПромСвойство.Имя + ": """ + ПромПараметры.Получить(ПромСвойство) + ";";
			КонецЦикла;  
			
		КонецЕсли;   
		
	Исключение  
	КонецПопытки;
	
	Возврат СтрокаПараметровВэбСервиса;

КонецФункции

