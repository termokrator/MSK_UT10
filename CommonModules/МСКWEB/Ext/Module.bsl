		|		ПО (ЦеныНоменклатурыСрезПоследних.Валюта = КурсыВалютСрезПоследних.Валюта)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(, Валюта = &Рубль) КАК КурсРубля
		|		ПО (ИСТИНА)
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &ПроверкаЦенСебестоимости
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ТабОстатков.ЦенаПортал >= ВЫБОР
		|					КОГДА ЦеныНоменклатурыСрезПоследних.Цена ЕСТЬ NULL
		|						ТОГДА 0
		|					ИНАЧЕ ВЫБОР
		|							КОГДА ЦеныНоменклатурыСрезПоследних.Валюта = &Рубль
		|								ТОГДА ЦеныНоменклатурыСрезПоследних.Цена
		|							ИНАЧЕ ВЫБОР
		|									КОГДА ЕСТЬNULL(КурсыВалютСрезПоследних.Кратность, 0) > 0
		|											И ЕСТЬNULL(КурсыВалютСрезПоследних.Курс, 0) > 0
		|											И ЕСТЬNULL(КурсРубля.Кратность, 0) > 0
		|											И ЕСТЬNULL(КурсРубля.Курс, 0) > 0
		|										ТОГДА ЦеныНоменклатурыСрезПоследних.Цена * (КурсыВалютСрезПоследних.Курс * КурсРубля.Кратность / (КурсРубля.Курс * КурсыВалютСрезПоследних.Кратность))
		|									ИНАЧЕ 0
		|								КОНЕЦ
		|						КОНЕЦ
		|				КОНЕЦ
		|		КОНЕЦ
		|	И (ВЫРАЗИТЬ(ТабОстатков.Количество / ВЫБОР
		|				КОГДА ТабОстатков.Коэффициент > 0
		|					ТОГДА ТабОстатков.Коэффициент
		|				ИНАЧЕ 1
		|			КОНЕЦ КАК ЧИСЛО(15, 3))) = (ВЫРАЗИТЬ(ТабОстатков.Количество / ВЫБОР
		|				КОГДА ТабОстатков.Коэффициент > 0
		|					ТОГДА ТабОстатков.Коэффициент
		|				ИНАЧЕ 1
		|			КОНЕЦ КАК ЧИСЛО(15, 0)))";
		
		Запрос.УстановитьПараметр("ТипЦенЗаказ", НовыйДокЗаказ.ДоговорКонтрагента.ТипЦен);
		Запрос.УстановитьПараметр("Рубль", Константы.ВалютаРегламентированногоУчета.Получить());
		Запрос.УстановитьПараметр("ПустаяСерия", Справочники.СерииНоменклатуры.ПустаяСсылка());
		Запрос.УстановитьПараметр("ТЗ", ТЗ);
		ПроверкаЦенСебестоимости = ЗначениеЗаполнено(Константы.МинимальнаяНаценкаНаСебестоимость.Получить()) 
		               И ЗначениеЗаполнено(Константы.ЦенаСебестоимость.Получить()) И СобственныйСкладКакСторонний; 
		Запрос.УстановитьПараметр("ПроверкаЦенСебестоимости", ПроверкаЦенСебестоимости);

		Результат = Запрос.Выполнить().Выгрузить();
		
		Если Результат.Количество() = 0 Тогда          
			
			Для Каждого Стр Из НовыйДокЗаказ.Товары Цикл  
				
				Стр.Размещение = "";
				Стр.СерияНоменклатуры = "";     
				
			КонецЦикла;      
			
		Иначе
			
			Для Каждого Стр Из НовыйДокЗаказ.Товары Цикл   
				
				СтрРезультат = Результат.Найти(Стр.Номенклатура, "Номенклатура"); 
				
				Если СтрРезультат = Неопределено  Тогда   
					
					Стр.Размещение = "";
					Стр.СерияНоменклатуры = "";         
					
				ИначеЕсли СтрРезультат.ЦенаПоДоговору = 0 И НЕ ПроверкаЦенСебестоимости Тогда
					Стр.Размещение = "";
				КонецЕсли;     
				
			КонецЦикла;   
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если НовыйДокЗаказ.ТолькоРезерв Тогда   
		
		ПромТабличнаяЧасть = НовыйДокЗаказ.Товары.Выгрузить();
		ПромТабличнаяЧасть.ЗаполнитьЗначения(НовыйДокЗаказ.ТолькоРезерв, "ТолькоРезерв");
		НовыйДокЗаказ.Товары.Загрузить(ПромТабличнаяЧасть); 
		
	КонецЕсли;
	
	ОбработатьРезервОбособленнойОтгрузки(НовыйДокЗаказ);
	
	ПроверитьЦеныПоИсключительнымСкладам(НовыйДокЗаказ);
	
	Попытка
		
		//+Белов А. 10.03.2026 #UT10-5729
		ВыделитьМаркировкуВОтдельныйЗаказ = Ложь;
		
		//Если основная организация
		Если НовыйДокЗаказ.Организация = Константы.ОсновнаяОрганизация.Получить() Тогда
			ВыделитьМаркировкуВОтдельныйЗаказ = Маркировка.ЕстьНоменклатураТребующаяМаркировки(НовыйДокЗаказ.Товары.Выгрузить()) И Константы.ВыделятьТоварыСМаркировкойПоОснОрганизацииВОтдельныйЗаказ.Получить() И МСКWEB.ПоДоворуНужноВыделениеЗаказаСМаркировкойВОтдельный(НовыйДокЗаказ.ДоговорКонтрагента);		
		Иначе
			//Если управленческая организация	
			ВыделитьМаркировкуВОтдельныйЗаказ = Маркировка.ЕстьНоменклатураТребующаяМаркировки(НовыйДокЗаказ.Товары.Выгрузить()) И Не Константы.НеВыделятьТоварыСМаркировкойПоУпрОрганизацииВОтдельныйЗаказ.Получить();  				
		КонецЕсли;
		
		Если ВыделитьМаркировкуВОтдельныйЗаказ Тогда
			
			СтруктураВыделения = МСКWEB.ВыделитьМаркировкуВОтдельныйЗаказ(НовыйДокЗаказ);	
			НовыйДокЗаказ = СтруктураВыделения.ЗаказИсходныйОбъект;  
			
		Иначе
			НовыйДокЗаказ.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Оперативный); 
		КонецЕсли;
		
		////+Белов А. 25.12.2025 #UT10-5586
		//Если Не Константы.НеВыделятьТоварыСМаркировкойПоУпрОрганизацииВОтдельныйЗаказ.Получить() 
		//	И НовыйДокЗаказ.Организация <> Константы.ОсновнаяОрганизация.Получить() 
		//	И Маркировка.ЕстьНоменклатураТребующаяМаркировки(НовыйДокЗаказ.Товары.Выгрузить()) Тогда
		//	
		//	СтруктураВыделения = МСКWEB.ВыделитьМаркировкуВОтдельныйЗаказ(НовыйДокЗаказ);	
		//	НовыйДокЗаказ = СтруктураВыделения.ЗаказИсходныйОбъект;
		//	
		////-Белов А. 25.12.2025 #UT10-5586	
		//Иначе
		//	
		//	НовыйДокЗаказ.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Оперативный); 
		//КонецЕсли;  
		//-Белов А. 10.03.2026 #UT10-5729
		
		СтрокаВозврата.OrderNumber = НовыйДокЗаказ.Номер;	
		СтрокаВозврата.Status = "0";
		РезультатДляВозвратаПорталу.OutForPortalLines.Добавить(СтрокаВозврата);			
		НовыйЗаказ = НовыйДокЗаказ.Ссылка;
			
	Исключение 
		
		НеСозданныйЗП.Причина = ?( НеСозданныйЗП.Причина = "", "", НеСозданныйЗП.Причина + ", ") + "Ошибка при проведении заказа покупателя"; 
		НеСозданныйЗП.Записать();
		СтрокаВозврата.Status = "1";
		РезультатДляВозвратаПорталу.OutForPortalLines.Добавить(СтрокаВозврата);	
		ЗаписьЖурналаРегистрации("Оформление заказа с портала", УровеньЖурналаРегистрации.Информация,,, 
		"Ошибка при проведении заказа покупателя (" + ОписаниеОшибки() + "). Записан Несозданный заказ (код " + СокрЛП(НеСозданныйЗП.Код) + ")");
		
		Возврат РезультатДляВозвратаПорталу;
		
	КонецПопытки;	
	
	Коментарий = "Документ сформирован автоматически при загрузке заказа покупателя из портала";  
	
	Если Не ЗначениеЗаполнено(НовыйДокЗаказ.IDСклада_СтороннийСклад) Тогда
		
		Если МСК.НеобходимоПроверятьКратностьВЗаказе(НовыйДокЗаказ) Тогда     
			
			СтруктураВозврата = СоздатьКорректировкаЗаказаПокупателя(НовыйДокЗаказ, , Коментарий);  
			
			Если ЗначениеЗаполнено(СтруктураВозврата.Ошибка) Тогда  
				
				СтрокаВозврата.Status = "3";
				РезультатДляВозвратаПорталу.OutForPortalLines.Добавить(СтрокаВозврата);	
				
			КонецЕсли;       
			
		КонецЕсли;		
		
	КонецЕсли;  
	
	Если EMailЗаказ Тогда
		ЗаписьЖурналаРегистрации("Запрос данных с эл почты", УровеньЖурналаРегистрации.Информация,,, "TransmitOrderFromEMail окончание ");	
	Иначе
	КонецЕсли;
	
	Возврат РезультатДляВозвратаПорталу;
	
КонецФункции 

Функция ВыделитьМаркировкуВОтдельныйЗаказ(ЗаказОбъект) Экспорт
	//+Белов А. 25.12.2025 #UT10-5586
	
	СтруктураВозврата = Новый Структура("ЗаказИсходныйОбъект, ЗаказМаркировкаОбъект", Неопределено, Неопределено);
	СтруктураВозврата.ЗаказИсходныйОбъект = ЗаказОбъект;
	
	ДоговорМаркировки = ПолучитьДоговорДляМаркированныхТоваров(ЗаказОбъект.Контрагент);
	
	Если ЗначениеЗаполнено(ДоговорМаркировки) Тогда
		
		ЗаказСМаркировкой = Документы.ЗаказПокупателя.СоздатьДокумент(); 
		ЗаполнитьЗначенияСвойств(ЗаказСМаркировкой, ЗаказОбъект,,"Номер,Ссылка");
		
		ЗаказСМаркировкой.ДоговорКонтрагента = ДоговорМаркировки;
		ЗаказСМаркировкой.Организация = ДоговорМаркировки.Организация;
		
		СтрокиУдаления = Новый Массив;
		
		Для каждого Стр Из ЗаказОбъект.Товары Цикл
			
			Если Стр.Номенклатура.ТребуетсяМаркировка Тогда
				СтрокиУдаления.Добавить(Стр);		
			КонецЕсли;
			
		КонецЦикла; 
		
		Для каждого СтрУдаления Из СтрокиУдаления Цикл
			
			НСтр = ЗаказСМаркировкой.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НСтр, СтрУдаления); 
			
			ЗаказОбъект.Товары.Удалить(СтрУдаления);
			
		КонецЦикла;
		
		Попытка
			
			//Может так случиться, что все товары в заказе с маркировкой
			Если ЗаказОбъект.Товары.Количество() > 0 Тогда
				
				НачатьТранзакцию();
				
				ЗаказСМаркировкой.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Оперативный); 	
				ЗаказОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Оперативный); 
				
				ЗафиксироватьТранзакцию();
				
				СтруктураВозврата.ЗаказМаркировкаОбъект = ЗаказСМаркировкой;
				
			Иначе
				
				ЗаказСМаркировкой.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Оперативный); 
				СтруктураВозврата.ЗаказИсходныйОбъект = ЗаказСМаркировкой;
									
			КонецЕсли;   
			
		Исключение
			
			Если ТранзакцияАктивна() Тогда
				ОтменитьТранзакцию();	
			КонецЕсли;      
			
			ВызватьИсключение("Произошла ошибка: " + ОписаниеОшибки());
			
		КонецПопытки;
		
	//Если договор не найден, вводим корректировку заказа
	Иначе 
		
		Попытка
			
			НачатьТранзакцию();
			
			ЗаказОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Оперативный); 
			
			//+Белов А. 02.03.2026 #UT10-5729
			Если ЗаказОбъект.Организация = Константы.ОсновнаяОрганизация.Получить() Тогда
				КорректировкаОбъект = СоздатьКорректировкуПоМаркированнымТоварам(ЗаказОбъект.Ссылка, "Маркированные товары нужно выделять в отдельный заказ. Розничный или лицевой договор у клиента не найден"); 
			Иначе
			//-Белов А. 02.03.2026 #UT10-5729
				КорректировкаОбъект = СоздатьКорректировкуПоМаркированнымТоварам(ЗаказОбъект.Ссылка, "Маркированные товары нельзя отгружать по упр организации. Розничный или лицевой договор у клиента не найден"); 
			КонецЕсли;	
			
			КорректировкаОбъект.ДополнительныеСвойства.Вставить("НеПроверятьНаСтороннийСклад", Истина);
			КорректировкаОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Оперативный); 				
			
			ЗафиксироватьТранзакцию();  
			
		Исключение
			
			Если ТранзакцияАктивна() Тогда
				ОтменитьТранзакцию();	
			КонецЕсли;      
			
			ВызватьИсключение("Произошла ошибка: " + ОписаниеОшибки()); 		
			
		КонецПопытки;     
		
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
	//-Белов А. 25.12.2025 #UT10-5586
КонецФункции

Функция СоздатьКорректировкуПоМаркированнымТоварам(ЗаказСсылка, Комментарий = "") 
	
	ДокументКорректировки = Документы.КорректировкаЗаказаПокупателя.СоздатьДокумент();
	ДокументКорректировки.Заполнить(ЗаказСсылка);
	ДокументКорректировки.Дата = ТекущаяДата();
	ДокументКорректировки.Комментарий = Комментарий;
	ДокументКорректировки.ВалютаДокумента = ЗаказСсылка.ВалютаДокумента; 
	
	ДокументКорректировки.Товары.Очистить();
	ДокументКорректировки.Услуги.Очистить();                               
	ДокументКорректировки.ВозвратнаяТара.Очистить();
	
	Номенклатура = Неопределено;
	ХарактеристикаНоменклатуры = Неопределено;
	СерияНоменклатуры = Неопределено;
	
	Для каждого Стр Из ЗаказСсылка.Товары Цикл
		
		Если Не Стр.Номенклатура.ТребуетсяМаркировка Тогда
			Продолжить;
		КонецЕсли;	
		
		НоваяСтрока = ДокументКорректировки.Товары.Добавить();		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);	
		
		НоваяСтрока.Количество = -1 * Стр.Количество;	
		НоваяСтрока.Причина = ?(ЗаказСсылка.ТаксиДоставка, Перечисления.ПричиныКорректировкиСборки.ОтказПоставщика, Перечисления.ПричиныКорректировкиСборки.ОтказКлиента);
		
		мВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();	
		
		ОбработкаТабличныхЧастей.ПриИзмененииНоменклатурыТабЧасти(НоваяСтрока, ДокументКорректировки);	
		ОбработкаТабличныхЧастей.ЗаполнитьСтавкуНДСТабЧасти(НоваяСтрока, ДокументКорректировки, "Реализация");
		ОбработкаТабличныхЧастей.РассчитатьКоличествоМестТабЧасти(НоваяСтрока, ДокументКорректировки);
		ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(НоваяСтрока, ДокументКорректировки);
		ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НоваяСтрока, ДокументКорректировки);	
		ОбработкаТабличныхЧастей.РассчитатьПлановуюСебестоимостьВСтрокеТабЧасти(НоваяСтрока, ДокументКорректировки, мВалютаРегламентированногоУчета);
		
	КонецЦикла; 
	
	ДокументКорректировки.СуммаДокумента = ДокументКорректировки.Товары.Итог("Сумма");
	
	Возврат ДокументКорректировки;
		
КонецФункции

Функция ПолучитьДоговорДляМаркированныхТоваров(Контрагент)
//+Белов А. 25.12.2025 #UT10-5586

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Ссылка,
	|	ВЫБОР
	|		КОГДА ДоговорыКонтрагентов.ЛицевойСчет
	|			ТОГДА 1
	|		КОГДА ДоговорыКонтрагентов.РозничнаяПродажа
	|			ТОГДА 2
	|		ИНАЧЕ 3
	|	КОНЕЦ КАК Приоритет
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.Владелец = &Контрагент
	|	И ДоговорыКонтрагентов.Организация = &Организация
	|	И (ДоговорыКонтрагентов.ЛицевойСчет
	|			ИЛИ ДоговорыКонтрагентов.РозничнаяПродажа)
	|	И ДоговорыКонтрагентов.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПокупателем)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет";
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);  
	Запрос.УстановитьПараметр("Организация", Константы.ОсновнаяОрганизация.Получить());
	
	Выборка = Запрос.Выполнить().Выбрать();  
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;                 
	
	Возврат Неопределено;

	//-Белов А. 25.12.2025 #UT10-5586
КонецФункции

Функция ПоДоворуНужноВыделениеЗаказаСМаркировкойВОтдельный(ДоговорКонтрагента) Экспорт
	//+Белов А. 02.03.2026 #UT10-5729
	
	МассивУсловий = Новый Массив;
	МассивУсловий.Добавить(Перечисления.УсловияРаботыСЧЗ.НеПокупаетТоварыЧЗ);
	МассивУсловий.Добавить(Перечисления.УсловияРаботыСЧЗ.НеКлассифицирован);
	МассивУсловий.Добавить(Перечисления.УсловияРаботыСЧЗ.ТоварыЧЗВРозницу);
	МассивУсловий.Добавить(Перечисления.УсловияРаботыСЧЗ.ПустаяСсылка());
	
	УсловияРаботыСЧЗ = ДоговорКонтрагента.УсловияРаботыСЧЗ;
	
	Если МассивУсловий.Найти(УсловияРаботыСЧЗ) <> Неопределено
		И Не ДоговорКонтрагента.ЛицевойСчет
		И Не ДоговорКонтрагента.РозничнаяПродажа Тогда
		Возврат Истина;	
	КонецЕсли;         
	
	Возврат Ложь;
	
	//-Белов А. 02.03.2026 #UT10-5729		
КонецФункции


Процедура ОбработатьРезервОбособленнойОтгрузки(НовыйДокЗаказ) Экспорт
	
	//+Шульман А. 20.10.2025 #UT10-5457
	Если НовыйДокЗаказ.ОбособленнаяОтгрузкаГМИзСтороннегоФилиала И Маркировка.ЕстьНоменклатураТребующаяМаркировки(НовыйДокЗаказ.Товары.Выгрузить()) Тогда  
		
		НовыйДокЗаказ.ОбособленнаяОтгрузкаГМИзСтороннегоФилиала = Ложь;     
		Возврат;
		
	КонецЕсли;
	//-Шульман А. 20.10.2025 #UT10-5457
	
	Если НовыйДокЗаказ.ОбособленнаяОтгрузкаГМИзСтороннегоФилиала Тогда
		
		ПоВсемТоварамВсталРезерв = Истина;
		
		Для Каждого Стр Из НовыйДокЗаказ.Товары Цикл
			
			Если Не ЗначениеЗаполнено(Стр.Размещение) Тогда
				
				ПоВсемТоварамВсталРезерв = Ложь;
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла; 
		
		Если Не ПоВсемТоварамВсталРезерв Тогда
			
			Для Каждого Стр Из НовыйДокЗаказ.Товары Цикл
				Стр.Размещение = "";  			
			КонецЦикла;
			
		Иначе   
			НовыйДокЗаказ.ОбособленнаяОтгрузкаГМИзСтороннегоФилиала = Ложь;	
		КонецЕсли;  
		
	КонецЕсли;
	
КонецПроцедуры   

Процедура ПроверитьЦеныПоИсключительнымСкладам(НовыйДокЗаказ) Экспорт
//+Гавриленков В. 23.11.2024 #UT10-4934       

	Если ЗначениеЗаполнено(НовыйДокЗаказ.IDСклада) И Справочники.СобственныеСклады.IDСоответстуетИсключительномуСкладу(НовыйДокЗаказ.IDСклада) Тогда 
	
		Если ЗначениеЗаполнено(Константы.МинимальнаяНаценкаНаСебестоимость.Получить()) И ЗначениеЗаполнено(Константы.ЦенаСебестоимость.Получить()) Тогда
			
			ЗапросСоответствияЦен = Новый Запрос;
			ЗапросСоответствияЦен.Текст =
			"ВЫБРАТЬ
			|	ТаблФильтр.Номенклатура,
			|	ТаблФильтр.Цена
			|ПОМЕСТИТЬ ВТ_Товары
			|ИЗ
			|	&ТаблФильтр КАК ТаблФильтр
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ВТ_Товары.Номенклатура КАК Номенклатура,
			|	МИНИМУМ(ВТ_Товары.Цена) КАК Цена,
			|	МАКСИМУМ(Константы.ЦенаСебестоимость) КАК Себестоимость,
			|	МАКСИМУМ(Константы.МинимальнаяНаценкаНаСебестоимость) КАК МинимальнаяНаценка
			|ПОМЕСТИТЬ ВТ_ТоварыЗаказа
			|ИЗ
			|	Константы КАК Константы,
			|	ВТ_Товары КАК ВТ_Товары
			|
			|СГРУППИРОВАТЬ ПО
			|	ВТ_Товары.Номенклатура
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ЦеныНоменклатурыСрезПоследних.Номенклатура,
			|	МАКСИМУМ(ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0)) КАК ЦенаСебестоимость
			|ПОМЕСТИТЬ ВТ_ЦеныСебестоимости
			|ИЗ
			|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
			|			,
			|			Номенклатура В
			|					(ВЫБРАТЬ
			|						ВТ_ТоварыЗаказа.Номенклатура
			|					ИЗ
			|						ВТ_ТоварыЗаказа)
			|				И ТипЦен В
			|					(ВЫБРАТЬ
			|						ВТ_ТоварыЗаказа.Себестоимость
			|					ИЗ
			|						ВТ_ТоварыЗаказа)) КАК ЦеныНоменклатурыСрезПоследних
			|
			|СГРУППИРОВАТЬ ПО
			|	ЦеныНоменклатурыСрезПоследних.Номенклатура
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ_ТоварыЗаказа.Номенклатура,
			|	ВТ_ТоварыЗаказа.Цена КАК ЦенаЗаказа,
			|	ЕСТЬNULL(ВТ_ЦеныСебестоимости.ЦенаСебестоимость, 0) * ВТ_ТоварыЗаказа.МинимальнаяНаценка / 100 + ЕСТЬNULL(ВТ_ЦеныСебестоимости.ЦенаСебестоимость, 0) КАК МинимальнаяЦена
			|ПОМЕСТИТЬ ВТ_Итог
			|ИЗ
			|	ВТ_ТоварыЗаказа КАК ВТ_ТоварыЗаказа
			|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЦеныСебестоимости КАК ВТ_ЦеныСебестоимости
			|		ПО ВТ_ТоварыЗаказа.Номенклатура = ВТ_ЦеныСебестоимости.Номенклатура
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ_Итог.Номенклатура,
			|	ВТ_Итог.ЦенаЗаказа,
			|	ВТ_Итог.МинимальнаяЦена
			|ИЗ
			|	ВТ_Итог КАК ВТ_Итог
			|ГДЕ
			|	(ВТ_Итог.ЦенаЗаказа < ВТ_Итог.МинимальнаяЦена
			|			ИЛИ ВТ_Итог.МинимальнаяЦена = 0)";
			
			ТаблицаФильтра = НовыйДокЗаказ.Товары.Выгрузить(,"Номенклатура, Размещение, Цена");
			
			сч = 0;
			
			Пока сч < ТаблицаФильтра.Количество() Цикл 
				
				ТекСтрока = ТаблицаФильтра.Получить(сч); 
				
				Если ЗначениеЗаполнено(ТекСтрока.Размещение) Тогда
					сч = сч + 1;
				Иначе
					ТаблицаФильтра.Удалить(ТекСтрока);
				КонецЕсли;
				
			КонецЦикла;   
			
			Если ТаблицаФильтра.Количество() = 0 Тогда
				Возврат;
			КонецЕсли;
			
			ТаблицаФильтра.Свернуть("Номенклатура,Цена");
			ЗапросСоответствияЦен.УстановитьПараметр("ТаблФильтр",ТаблицаФильтра);
			
			Выборка = ЗапросСоответствияЦен.Выполнить().Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				СтруктураПоиска = Новый Структура("Номенклатура, Цена", Выборка.Номенклатура, Выборка.ЦенаЗаказа);
				МассивНайденных = НовыйДокЗаказ.Товары.НайтиСтроки(СтруктураПоиска);
				
				Для Каждого НайденнаяСтрока Из МассивНайденных Цикл
					НайденнаяСтрока.Размещение = Неопределено;
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЕсли;
	
	КонецЕсли;

//-Гавриленков В. 23.11.2024 #UT10-4934
КонецПроцедуры

Функция ПустойСтороннийСклад(НовыйДокЗаказ)    
	
	Результат = Ложь;
	
	// Проверяем значение НовыйДокЗаказ.IDСклада, что это Собственный Склад	
	Если НЕ ЗначениеЗаполнено(НовыйДокЗаказ.IDСклада_СтороннийСклад) Тогда 
		
		Результат = МСК.ЭтоСтороннийСклад(НовыйДокЗаказ.IDСклада);	
		
		Если НЕ Результат Тогда
			Возврат Результат;
		КонецЕсли;    
		
	КонецЕсли; 
	
	
	Если ЗначениеЗаполнено(НовыйДокЗаказ.IDСклада) И НЕ ЗначениеЗаполнено(НовыйДокЗаказ.IDСклада_СтороннийСклад)
		И Константы.НеСоздаватьСтороннийСклад.Получить() Тогда
		Результат = Истина;	   
	КонецЕсли;		
	
	Возврат Результат;  
	
КонецФункции

Процедура ОбработкаРазмещенияИЦенЗаказаПокупателя(НовыйДокЗаказ) Экспорт
	
	ЭтоСтороннийСклад = ЗначениеЗаполнено(НовыйДокЗаказ.IDСклада_СтороннийСклад); 	
	
	СкладФильтр = Константы.ОсновнойСклад.Получить();  
	
	Для каждого Стр Из НовыйДокЗаказ.Товары Цикл	 
		
		Если НЕ Стр.Размещение = СкладФильтр ИЛИ НЕ ЗначениеЗаполнено(Стр.СерияНоменклатуры) Тогда					
			Стр.Размещение = "";
		КонецЕсли;        
		
	КонецЦикла;
	
	Если ТекущаяДата() >= Константы.РезервированиеЗаказовСУчетомЯчеек.Получить() Тогда   
		
		ТЗ = НовыйДокЗаказ.Товары.Выгрузить();
		ТЗ.Свернуть("Номенклатура, Размещение", "Количество");
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Константы.ИспользоватьАлгоритмПроверкиКратностиФилиала КАК ЗначениеКонстанты
		|ПОМЕСТИТЬ КонстКратности
		|ИЗ
		|	Константы КАК Константы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТЗ.Номенклатура КАК Номенклатура,
		|	ТЗ.Количество КАК Количество,
		|	ТЗ.Размещение КАК Размещение
		|ПОМЕСТИТЬ ТаблицаНоменклатура
		|ИЗ
		|	&ТЗ КАК ТЗ
		|ГДЕ
		|	ТЗ.Размещение <> НЕОПРЕДЕЛЕНО
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТоварыВЯчейкахОстатки.Номенклатура,
		|	ТоварыВЯчейкахОстатки.КоличествоОстаток КАК Остаток,
		|	1 КАК Поле1
		|ПОМЕСТИТЬ Остатки
		|ИЗ
		|	ТаблицаНоменклатура КАК ТаблицаНоменклатура
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках.Остатки(, НЕ Ячейка.НеУчитыватьВОперативномУчете) КАК ТоварыВЯчейкахОстатки
		|		ПО ТаблицаНоменклатура.Номенклатура = ТоварыВЯчейкахОстатки.Номенклатура
		|ГДЕ
		|	ТоварыВЯчейкахОстатки.Ячейка.НеУчитыватьВОперативномУчете = ЛОЖЬ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ТоварыГотовыеКСборкеОстатки.Номенклатура,
		|	-ТоварыГотовыеКСборкеОстатки.КоличествоОстаток,
		|	3
		|ИЗ
		|	ТаблицаНоменклатура КАК ТаблицаНоменклатура
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыГотовыеКСборке.Остатки(, ) КАК ТоварыГотовыеКСборкеОстатки
		|		ПО ТаблицаНоменклатура.Номенклатура = ТоварыГотовыеКСборкеОстатки.Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Остатки.Номенклатура,
		|	СУММА(Остатки.Остаток) КАК Остаток,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА КонстКратности.ЗначениеКонстанты
		|				ТОГДА ВЫБОР
		|						КОГДА НЕ Остатки.Номенклатура.КратностьФилиала = 0
		|							ТОГДА Остатки.Номенклатура.КратностьФилиала
		|						ИНАЧЕ Остатки.Номенклатура.Кратность
		|					КОНЕЦ
		|			ИНАЧЕ Остатки.Номенклатура.Кратность
		|		КОНЕЦ) КАК Кратность
		|ПОМЕСТИТЬ ОстаткиГруппа
		|ИЗ
		|	Остатки КАК Остатки,
		|	КонстКратности КАК КонстКратности
		|
		|СГРУППИРОВАТЬ ПО
		|	Остатки.Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОстаткиГруппа.Номенклатура,
		|	СУММА(ОстаткиГруппа.Остаток) КАК Остаток,
		|	СУММА(ВЫБОР
		|			КОГДА ОстаткиГруппа.Остаток > 0
		|				ТОГДА ВЫБОР
		|						КОГДА ОстаткиГруппа.Кратность > ОстаткиГруппа.Остаток
		|							ТОГДА 0
		|						ИНАЧЕ ВЫБОР
		|								КОГДА (ВЫРАЗИТЬ(ОстаткиГруппа.Остаток / ОстаткиГруппа.Кратность - 0.5 КАК ЧИСЛО(15, 0))) * ОстаткиГруппа.Кратность <= ОстаткиГруппа.Остаток
		|									ТОГДА (ВЫРАЗИТЬ(ОстаткиГруппа.Остаток / ОстаткиГруппа.Кратность - 0.5 КАК ЧИСЛО(15, 0))) * ОстаткиГруппа.Кратность
		|								ИНАЧЕ ВЫРАЗИТЬ(ОстаткиГруппа.Остаток / ОстаткиГруппа.Кратность - 0.5 КАК ЧИСЛО(15, 0))
		|							КОНЕЦ
		|					КОНЕЦ
		|			ИНАЧЕ ВЫБОР
		|					КОГДА (ВЫРАЗИТЬ(ОстаткиГруппа.Остаток / ОстаткиГруппа.Кратность + 0.5 КАК ЧИСЛО(15, 0))) * ОстаткиГруппа.Кратность <= ОстаткиГруппа.Остаток
		|						ТОГДА (ВЫРАЗИТЬ(ОстаткиГруппа.Остаток / ОстаткиГруппа.Кратность + 0.5 КАК ЧИСЛО(15, 0))) * ОстаткиГруппа.Кратность
		|					ИНАЧЕ ВЫРАЗИТЬ(ОстаткиГруппа.Остаток / ОстаткиГруппа.Кратность + 0.5 КАК ЧИСЛО(15, 0))
		|				КОНЕЦ
		|		КОНЕЦ) КАК ОстатокПоКратности
		|ПОМЕСТИТЬ ОстаткиИтог
		|ИЗ
		|	ОстаткиГруппа КАК ОстаткиГруппа
		|ГДЕ
		|	ОстаткиГруппа.Остаток > 0
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиГруппа.Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаНоменклатура.Номенклатура,
		|	ВЫБОР
		|		КОГДА ТаблицаНоменклатура.Количество - ЕСТЬNULL(ОстаткиИтог.Остаток, 0) > ТаблицаНоменклатура.Количество
		|			ТОГДА ТаблицаНоменклатура.Количество
		|		ИНАЧЕ ТаблицаНоменклатура.Количество - ЕСТЬNULL(ОстаткиИтог.Остаток, 0)
		|	КОНЕЦ КАК Нехватка_,
		|	ВЫБОР
		|		КОГДА ТаблицаНоменклатура.Количество - ЕСТЬNULL(ОстаткиИтог.ОстатокПоКратности, 0) > ТаблицаНоменклатура.Количество
		|			ТОГДА ТаблицаНоменклатура.Количество
		|		ИНАЧЕ ТаблицаНоменклатура.Количество - ЕСТЬNULL(ОстаткиИтог.ОстатокПоКратности, 0)
		|	КОНЕЦ КАК Нехватка
		|ПОМЕСТИТЬ Рез
		|ИЗ
		|	ТаблицаНоменклатура КАК ТаблицаНоменклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиИтог КАК ОстаткиИтог
		|		ПО ТаблицаНоменклатура.Номенклатура = ОстаткиИтог.Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Рез.Номенклатура,
		|	Рез.Нехватка
		|ИЗ
		|	Рез КАК Рез
		|ГДЕ
		|	Рез.Нехватка > 0";      
		
		Запрос.УстановитьПараметр("ТЗ", ТЗ);
		Запрос.УстановитьПараметр("ПустоеРазмещение", Неопределено);
		
		Табл = Запрос.Выполнить().Выгрузить();  
		
		Для каждого стр из Табл Цикл   
			
			Отбор = Новый Структура;
			Отбор.Вставить("Номенклатура", Стр.Номенклатура);
			Строки = НовыйДокЗаказ.Товары.НайтиСтроки(Отбор);
			КУменьшению = Стр.Нехватка;     
			
			Для каждого строка из Строки Цикл   
				
				Если КУменьшению > 0 Тогда      
					
					Если Строка.Количество > КУменьшению Тогда   
						
						НоваяСтрока = НовыйДокЗаказ.Товары.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка,, "КлючСтроки");
						Строка.Количество = Строка.Количество - КУменьшению;
						НоваяСтрока.Количество = КУменьшению;
						НоваяСтрока.Размещение = "";
						НоваяСтрока.СерияНоменклатуры = "";
						
						КУменьшению = 0;
						СтрСумма = НоваяСтрока.Количество * НоваяСтрока.Цена;
						НоваяСтрока.Сумма = СтрСумма;
						ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НоваяСтрока, НовыйДокЗаказ);
						
						СтрСумма = Строка.Количество * Строка.Цена;
						Строка.Сумма = СтрСумма;
						ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(Строка, НовыйДокЗаказ);  
						
					Иначе                      
						
						КУменьшению = КУменьшению - Строка.Количество;
						Строка.Размещение = "";
						Строка.СерияНоменклатуры = "";   
						
					КонецЕсли; 
					
				КонецЕсли;  
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;        
	
	СобственныйСкладКакСторонний = Ложь;    
	
	Если НЕ ЭтоСтороннийСклад Тогда
		СобственныйСкладКакСторонний = Справочники.СобственныеСклады.НайтиПоРеквизиту("Идентификатор", НовыйДокЗаказ.IDСклада).ИсключитьИзОбщегоЭкспресса; 
	КонецЕсли;	
	
	Если ЭтоСтороннийСклад ИЛИ СобственныйСкладКакСторонний Тогда   
		
		ТЗ = НовыйДокЗаказ.Товары.Выгрузить();
		ТЗ.Свернуть("Номенклатура, Цена, Коэффициент, Размещение, СерияНоменклатуры", "Количество");
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		
		"ВЫБРАТЬ
		|	ТЗ.Номенклатура КАК Номенклатура,
		|	ТЗ.Цена КАК ЦенаПортал,
		|	ТЗ.Коэффициент КАК Коэффициент,
		|	ТЗ.Количество КАК Количество,
		|	ТЗ.Размещение КАК Размещение,
		|	ТЗ.СерияНоменклатуры КАК СерияНоменклатуры
		|ПОМЕСТИТЬ ТаблицаНоменклатура
		|ИЗ
		|	&ТЗ КАК ТЗ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаНоменклатура.Номенклатура,
		|	ТаблицаНоменклатура.ЦенаПортал,
		|	СправочникНоменклатура.Кратность КАК Коэффициент,
		|	ТаблицаНоменклатура.Количество,
		|	ТаблицаНоменклатура.Размещение,
		|	ТаблицаНоменклатура.СерияНоменклатуры
		|ПОМЕСТИТЬ ТабОстатков
		|ИЗ
		|	ТаблицаНоменклатура КАК ТаблицаНоменклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
		|		ПО ТаблицаНоменклатура.Номенклатура = СправочникНоменклатура.Ссылка
		|ГДЕ
		|	ТаблицаНоменклатура.СерияНоменклатуры <> &ПустаяСерия
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТабОстатков.Номенклатура,
		|	ТабОстатков.ЦенаПортал,
		|	ТабОстатков.Количество,
		|	ТабОстатков.Коэффициент,
		|	ВЫБОР
		|		КОГДА ЦеныНоменклатурыСрезПоследних.Цена ЕСТЬ NULL
		|			ТОГДА 0
		|		ИНАЧЕ ВЫБОР
		|				КОГДА ЦеныНоменклатурыСрезПоследних.Валюта = &Рубль
		|					ТОГДА ЦеныНоменклатурыСрезПоследних.Цена
		|				ИНАЧЕ ВЫБОР
		|						КОГДА ЕСТЬNULL(КурсыВалютСрезПоследних.Кратность, 0) > 0
		|								И ЕСТЬNULL(КурсыВалютСрезПоследних.Курс, 0) > 0
		|								И ЕСТЬNULL(КурсРубля.Кратность, 0) > 0
		|								И ЕСТЬNULL(КурсРубля.Курс, 0) > 0
		|							ТОГДА ЦеныНоменклатурыСрезПоследних.Цена * (КурсыВалютСрезПоследних.Курс * КурсРубля.Кратность / (КурсРубля.Курс * КурсыВалютСрезПоследних.Кратность))
		|						ИНАЧЕ 0
		|					КОНЕЦ
		|			КОНЕЦ
		|	КОНЕЦ КАК ЦенаПоДоговору,
		|	ВЫРАЗИТЬ(ТабОстатков.Количество / ВЫБОР
		|			КОГДА ТабОстатков.Коэффициент > 0
		|				ТОГДА ТабОстатков.Коэффициент
		|			ИНАЧЕ 1
		|		КОНЕЦ КАК ЧИСЛО(15, 1)) КАК Дробное,
		|	ВЫРАЗИТЬ(ТабОстатков.Количество / ВЫБОР
		|			КОГДА ТабОстатков.Коэффициент > 0
		|				ТОГДА ТабОстатков.Коэффициент
		|			ИНАЧЕ 1
		|		КОНЕЦ КАК ЧИСЛО(15, 0)) КАК Целое
		|ИЗ
		|	ТабОстатков КАК ТабОстатков
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
		|				,
		|				Номенклатура В
		|						(ВЫБРАТЬ
		|							ТабОстатков.Номенклатура
		|						ИЗ
		|							ТабОстатков КАК ТабОстатков)
		|					И ТипЦен = &ТипЦенЗаказ) КАК ЦеныНоменклатурыСрезПоследних
		|		ПО ТабОстатков.Номенклатура = ЦеныНоменклатурыСрезПоследних.Номенклатура
		|			И (ЦеныНоменклатурыСрезПоследних.ТипЦен = &ТипЦенЗаказ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(, ) КАК КурсыВалютСрезПоследних
		|		ПО (ЦеныНоменклатурыСрезПоследних.Валюта = КурсыВалютСрезПоследних.Валюта)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(, Валюта = &Рубль) КАК КурсРубля
		|		ПО (ИСТИНА)
		|ГДЕ
		|	ТабОстатков.ЦенаПортал >= ВЫБОР
		|			КОГДА ЦеныНоменклатурыСрезПоследних.Цена ЕСТЬ NULL
		|				ТОГДА 0
		|			ИНАЧЕ ВЫБОР
		|					КОГДА ЦеныНоменклатурыСрезПоследних.Валюта = &Рубль
		|						ТОГДА ЦеныНоменклатурыСрезПоследних.Цена
		|					ИНАЧЕ ВЫБОР
		|							КОГДА ЕСТЬNULL(КурсыВалютСрезПоследних.Кратность, 0) > 0
		|									И ЕСТЬNULL(КурсыВалютСрезПоследних.Курс, 0) > 0
		|									И ЕСТЬNULL(КурсРубля.Кратность, 0) > 0
		|									И ЕСТЬNULL(КурсРубля.Курс, 0) > 0
		|								ТОГДА ЦеныНоменклатурыСрезПоследних.Цена * (КурсыВалютСрезПоследних.Курс * КурсРубля.Кратность / (КурсРубля.Курс * КурсыВалютСрезПоследних.Кратность))
		|							ИНАЧЕ 0
		|						КОНЕЦ
		|				КОНЕЦ
		|		КОНЕЦ
		|	И (ВЫРАЗИТЬ(ТабОстатков.Количество / ВЫБОР
		|				КОГДА ТабОстатков.Коэффициент > 0
		|					ТОГДА ТабОстатков.Коэффициент
		|				ИНАЧЕ 1
		|			КОНЕЦ КАК ЧИСЛО(15, 1))) = (ВЫРАЗИТЬ(ТабОстатков.Количество / ВЫБОР
		|				КОГДА ТабОстатков.Коэффициент > 0
		|					ТОГДА ТабОстатков.Коэффициент
		|				ИНАЧЕ 1
		|			КОНЕЦ КАК ЧИСЛО(15, 0)))";
		
		
		Запрос.УстановитьПараметр("ТипЦенЗаказ", НовыйДокЗаказ.ДоговорКонтрагента.ТипЦен);
		Запрос.УстановитьПараметр("Рубль", Константы.ВалютаРегламентированногоУчета.Получить());
		Запрос.УстановитьПараметр("ПустаяСерия", Справочники.СерииНоменклатуры.ПустаяСсылка());
		Запрос.УстановитьПараметр("ТЗ", ТЗ);
		
		Результат = Запрос.Выполнить().Выгрузить();
		
		Если Результат.Количество() = 0 Тогда    
			
			Для каждого Стр Из НовыйДокЗаказ.Товары Цикл      
				
				Стр.Размещение = "";
				Стр.СерияНоменклатуры = "";   
				
			КонецЦикла;     
			
		Иначе
			
			Для каждого Стр Из НовыйДокЗаказ.Товары Цикл  
				
				Если Результат.Найти(Стр.Номенклатура, "Номенклатура") = Неопределено Тогда  
					
					Стр.Размещение = "";
					Стр.СерияНоменклатуры = "";    
					
				Иначе
					// возможно меняем цену на нашу ?
				КонецЕсли; 
				
			КонецЦикла;   
			
		КонецЕсли;
		
	КонецЕсли;  
	
КонецПроцедуры

Функция НайтиКонтрагентаПоКодуИзПортала(ID) Экспорт
	
	Если Не ЗначениеЗаполнено(ID) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИскатьПоКодуМДМ = СтрДлина(ID) = 36;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.IDАварда = &KontragentID
	|	И НЕ Контрагенты.ПометкаУдаления
	|	И (Контрагенты.IDФилиала = NULL
	|			ИЛИ Контрагенты.IDФилиала = """")";
	
	Если ИскатьПоКодуМДМ Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ".IDАварда", ".КодМДМ");
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("KontragentID",ID);
	Выборка = Запрос.Выполнить().Выбрать();  
	
	Если Выборка.Следующий() Тогда	
		Возврат Выборка.Ссылка;
	Иначе 
		Возврат Неопределено;	
	КонецЕсли;		
	
КонецФункции

Функция НайтиДоговорПоКодуИзПортала(ID, СпособДоставки) Экспорт
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("ДоговорКонтрагента", Неопределено);
	СтруктураВозврата.Вставить("ОплатаНаличными", Ложь);
	
	Если Не ЗначениеЗаполнено(ID) Тогда
		Возврат СтруктураВозврата;
	КонецЕсли;
	
	Если СтрДлина(ID) >= 36 Тогда
		
		Если СтрДлина(ID) = 36 Тогда
			КодМДМДоговора = ID;
		Иначе
			КодМДМДоговора = Лев(ID, 36);			
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДоговорыКонтрагентов.Ссылка КАК ДоговорКонтрагента,
		|	ДоговорыКонтрагентов.ОплатаПоДоговоруНаличными КАК ОплатаНаличными
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	ДоговорыКонтрагентов.КодМДМ = &КодМДМ";
		
		Запрос.УстановитьПараметр("КодМДМ", КодМДМДоговора);
		
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДоговорыАварды.ДоговорКонтрагента,
		|	ДоговорыАварды.ОплатаНаличными
		|ИЗ
		|	РегистрСведений.ДоговорыАварды КАК ДоговорыАварды
		|ГДЕ
		|	ДоговорыАварды.КодАварда = &КодАварда";
		
		Запрос.УстановитьПараметр("КодАварда",ID);
		
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда    
		
		Если СпособДоставки = Перечисления.СпособДоставки.Самовывоз И Выборка.ДоговорКонтрагента.Организация <> Константы.ОсновнаяОрганизация.Получить() Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ
			|	ДоговорыКонтрагентов.Ссылка
			|ИЗ
			|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
			|ГДЕ
			|	ДоговорыКонтрагентов.Владелец = &Владелец
			|	И ДоговорыКонтрагентов.Организация = &Организация
			|
			|УПОРЯДОЧИТЬ ПО
			|	ДоговорыКонтрагентов.РозничнаяПродажа УБЫВ";

			Запрос.УстановитьПараметр("Владелец", Выборка.ДоговорКонтрагента.Владелец);
			Запрос.УстановитьПараметр("Организация", Константы.ОсновнаяОрганизация.Получить()); 			
			
			Если НЕ Константы.СамовывозУправленческий.Получить() Тогда 
				
				Выб = Запрос.Выполнить().Выбрать();      
				
				Если Выб.Следующий() Тогда
					СтруктураВозврата.ДоговорКонтрагента = Выб.Ссылка; 
				КонецЕсли;          
				
			Иначе
				
				Если НЕ Выборка.ДоговорКонтрагента.Владелец.СамовывозУправленческий Тогда    
					
					Выб = Запрос.Выполнить().Выбрать();  
					
					Если Выб.Следующий() Тогда
						СтруктураВозврата.ДоговорКонтрагента = Выб.Ссылка; 
					КонецЕсли; 	
					
				Иначе          
					
					СтруктураВозврата.ДоговорКонтрагента = Выборка.ДоговорКонтрагента;
					СтруктураВозврата.ОплатаНаличными = Выборка.ОплатаНаличными;	
					
				КонецЕсли;	
				
			КонецЕсли; 
			
		Иначе         
			
			СтруктураВозврата.ДоговорКонтрагента = Выборка.ДоговорКонтрагента;
			СтруктураВозврата.ОплатаНаличными = Выборка.ОплатаНаличными;   
			
		КонецЕсли;  
		
	КонецЕсли;	 
	
	Возврат СтруктураВозврата; 
	
КонецФункции

Функция НайтиФилиалПоКодуИзПортала(ID) Экспорт
	
	Если Не ЗначениеЗаполнено(ID) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИскатьПоКодуМДМ = СтрДлина(ID) = 36;     
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.IDФилиала = &FilialID
	|	И НЕ Контрагенты.ПометкаУдаления";
	
	Если ИскатьПоКодуМДМ Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ".IDФилиала", ".КодМДМ");
	КонецЕсли;	
	
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("FilialID",ID);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда	
		Возврат Выборка.Ссылка;
	Иначе 
		Возврат Неопределено;	
	КонецЕсли;	
	
КонецФункции	

Функция НайтиТоварПоАртикулу(ИнвНомер) Экспорт
	
	Если Не ЗначениеЗаполнено(ИнвНомер) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Артикул = &ИнвНомер
	|	И НЕ Номенклатура.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ИнвНомер",ИнвНомер);
	Выборка = Запрос.Выполнить().Выбрать();  
	
	Если Выборка.Количество()= 1 И Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе 
		Возврат Неопределено;	
	КонецЕсли;	
	
КонецФункции

Процедура ДополнитьТаблицу(ТЗ, К, ДН, ДК)  
	
	Если К.ОсновнойДоговорКонтрагента.ОплатаПоДоговоруНаличными Тогда
		Нал = Истина;
	Иначе
		Нал = Ложь;
	КонецЕсли;
	
	ПоКалендарнымДням = Ложь; 
	
	Если Константы.СпособКонтроляДнейЗадолженности.Получить() = Перечисления.СпособыКонтроляДнейЗадолженности.ПоКалендарнымДням Тогда 
		ПоКалендарнымДням = Истина;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстаткиИОбороты.ДокументРасчетовСКонтрагентом,
	|	ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстаткиИОбороты.СуммаВзаиморасчетовКонечныйОстаток
	|ИЗ
	|	РегистрНакопления.ВзаиморасчетыСКонтрагентамиПоДокументамРасчетов.ОстаткиИОбороты(&ДатаНач, &ДатаКон, , , Контрагент = &Контр) КАК ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстаткиИОбороты";
	
	Запрос.УстановитьПараметр("Контр", К);
	Запрос.УстановитьПараметр("ДатаНач", ДН);
	Запрос.УстановитьПараметр("ДатаКон", ДК);
	
	Табл = Запрос.Выполнить().Выгрузить();
	Сч = 1;
	
	Для каждого строка Из ТЗ Цикл   
		
		Если НЕ ПоКалендарнымДням И строка.ДопустимоеЧислоДнейЗадолженности > 0 Тогда 
			строка.DDATE2 = ЗаполнениеДокументов.ОпределитьДату(строка.DDATE1, строка.ДопустимоеЧислоДнейЗадолженности);
		КонецЕсли;
		
		Для каждого стр1 из Табл Цикл      
			
			Если Строка.Регистратор = Стр1.ДокументРасчетовСКонтрагентом Тогда
				
				Строка.DOLG = Стр1.СуммаВзаиморасчетовКонечныйОстаток;
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Строка.I = Сч;
		Сч = Сч + 1;
		
		Если Строка.DOC_TYPE <> "Реализация товаров и услуг" Тогда
			Строка.DDATE2 = Строка.DDATE1;
		КонецЕсли;

		Если ЗначениеЗаполнено(Строка.СчетФактура) Тогда
			Строка.SF = Строка.СчетФактураНомер;
		КонецЕсли;
		
		Если Нал Тогда
			
			Строка.RASHOD_RUB_NAL = Строка.RASHOD_RUB;
			Строка.RASHOD_RUB = 0;
			Строка.PRIHOD_RUB_NAL = Строка.PRIHOD_RUB;
			Строка.PRIHOD_RUB = 0;
			Строка.SALDO_RUB_NAL = Строка.SALDO_RUB;
			Строка.SALDO_RUB = 0;
			Строка.IS_NAL = 1;
			
		КонецЕсли;
		
		Если Строка.RASHOD_RUB_NAL > 0 или Строка.RASHOD_RUB > 0 Тогда
			Строка.IS_DEBIT = 1;
		КонецЕсли;
		
		Если Строка.DOC_TYPE = "Реализация товаров и услуг" Тогда
			Строка.DOC_STATE = "Доставлена";
		ИначеЕсли Строка.DOC_TYPE = "Платежное поручение входящее" Тогда
			Строка.DOC_STATE = "Зачислено";
		ИначеЕсли Строка.DOC_TYPE = "Возврат товаров от покупателя" Тогда
			Строка.DOC_STATE = "Принят";
		КонецЕсли;   
		
	КонецЦикла;  
	
КонецПроцедуры

Функция ПолучитьОстатокПоСтроке(ЗаказКлиента, НомерСтроки)
	
	ЗапросОстатка = Новый Запрос;
	ЗапросОстатка.УстановитьПараметр("ДокЗаказ", ЗаказКлиента);
	ЗапросОстатка.УстановитьПараметр("КлючСтроки", НомерСтроки);
	
	ЗапросОстатка.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаказПокупателяТовары.Ссылка КАК ЗаказПокупателя,
	|	ЗаказПокупателяТовары.Номенклатура,
	|	ЗаказПокупателяТовары.КлючСтроки,
	|	ЗаказПокупателяТовары.Количество,
	|	ЗаказПокупателяТовары.СерияНоменклатуры
	|ПОМЕСТИТЬ ТаблицаИзменение
	|ИЗ
	|	Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары
	|ГДЕ
	|	ЗаказПокупателяТовары.Ссылка = &ДокЗаказ
	|	И ЗаказПокупателяТовары.КлючСтроки = &КлючСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаказыПокупателейОстатки.ЗаказПокупателя,
	|	ЗаказыПокупателейОстатки.Номенклатура,
	|	ЗаказыПокупателейОстатки.КоличествоОстаток КАК ЗаказаноПокупателем
	|ПОМЕСТИТЬ ТаблицаРезультат
	|ИЗ
	|	РегистрНакопления.ЗаказыПокупателей.Остатки(
	|			,
	|			(ЗаказПокупателя, Номенклатура) В
	|				(ВЫБРАТЬ
	|					ТаблицаИзменение.ЗаказПокупателя,
	|					ТаблицаИзменение.Номенклатура
	|				ИЗ
	|					ТаблицаИзменение КАК ТаблицаИзменение)) КАК ЗаказыПокупателейОстатки
	|ГДЕ
	|	ЗаказыПокупателейОстатки.КоличествоОстаток > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаРезультат.ЗаказПокупателя,
	|	ТаблицаРезультат.Номенклатура,
	|	СУММА(ТаблицаРезультат.ЗаказаноПокупателем) КАК ЗаказаноПокупателем,
	|	ТаблицаИзменение.КлючСтроки,
	|	ТаблицаИзменение.СерияНоменклатуры
	|ПОМЕСТИТЬ ИтоговаяТаблица
	|ИЗ
	|	ТаблицаИзменение КАК ТаблицаИзменение
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаРезультат КАК ТаблицаРезультат
	|		ПО ТаблицаИзменение.ЗаказПокупателя = ТаблицаРезультат.ЗаказПокупателя
	|			И ТаблицаИзменение.Номенклатура = ТаблицаРезультат.Номенклатура
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаРезультат.Номенклатура,
	|	ТаблицаРезультат.ЗаказПокупателя,
	|	ТаблицаИзменение.Номенклатура,
	|	ТаблицаИзменение.КлючСтроки,
	|	ТаблицаИзменение.СерияНоменклатуры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ИтоговаяТаблица.ЗаказПокупателя,
	|	ИтоговаяТаблица.Номенклатура,
	|	ИтоговаяТаблица.ЗаказаноПокупателем,
	|	ТаблицаИзменение.КлючСтроки,
	|	ВЫБОР
	|		КОГДА ИтоговаяТаблица.ЗаказаноПокупателем >= ТаблицаИзменение.Количество
	|			ТОГДА ТаблицаИзменение.Количество
	|		ИНАЧЕ ИтоговаяТаблица.ЗаказаноПокупателем
	|	КОНЕЦ КАК Количество,
	|	ИтоговаяТаблица.СерияНоменклатуры
	|ПОМЕСТИТЬ Итог
	|ИЗ
	|	ТаблицаИзменение КАК ТаблицаИзменение
	|		ЛЕВОЕ СОЕДИНЕНИЕ ИтоговаяТаблица КАК ИтоговаяТаблица
	|		ПО ТаблицаИзменение.ЗаказПокупателя = ИтоговаяТаблица.ЗаказПокупателя
	|			И (ИтоговаяТаблица.Номенклатура = ТаблицаИзменение.Номенклатура)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Итог.Номенклатура,
	|	Итог.ЗаказаноПокупателем,
	|	ВЫБОР
	|		КОГДА Итог.Количество - ЕСТЬNULL(ЗапросыИзмененияКоличестваВЗаказах.Количество, 0) < 0
	|			ТОГДА 0
	|		ИНАЧЕ Итог.Количество - ЕСТЬNULL(ЗапросыИзмененияКоличестваВЗаказах.Количество, 0)
	|	КОНЕЦ КАК Остаток
	|ИЗ
	|	Итог КАК Итог
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗапросыИзмененияКоличестваВЗаказах КАК ЗапросыИзмененияКоличестваВЗаказах
	|		ПО Итог.ЗаказПокупателя = ЗапросыИзмененияКоличестваВЗаказах.ЗаказПокупателя
	|			И Итог.КлючСтроки = ЗапросыИзмененияКоличестваВЗаказах.КлючСтроки
	|			И (НЕ ЗапросыИзмененияКоличестваВЗаказах.Обработано)
	|ГДЕ
	|	Итог.ЗаказаноПокупателем > 0";
	
	Результат = ЗапросОстатка.Выполнить().Выгрузить();
	
	Если Результат.Количество() = 0 Тогда
		Возврат 0;
	Иначе
		Возврат Результат[0].Остаток;
	КонецЕсли;	

КонецФункции

Функция ПолучитьСписокДействийСЗаказом(Заказ, ЕстьСборка, ЕстьЗаказПоставщику,МожноКорректировать = Ложь) Экспорт
	
	ДействияВДесятичномВиде = "";
	ДействияВДесятичномВиде = ?(Заказ.ТолькоРезерв, "1", "0") + "0"+ ?(МожноКорректировать, "1", "0") + "0";
	
	Возврат ДвоичноеВДесятичное(ДействияВДесятичномВиде);
	
КонецФункции

Функция ЕстьСборка(Заказ) Экспорт
	
	ЕстьСборка = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СУММА(СобраноПоЗаказуОбороты.КоличествоОборот) КАК Количество
	|ИЗ
	|	РегистрНакопления.СобраноПоЗаказу.Обороты(, , , Заказ = &Заказ) КАК СобраноПоЗаказуОбороты";
	
	Запрос.УстановитьПараметр("Заказ", Заказ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Если Выборка.Количество <> NULL И Выборка.Количество > 0 Тогда
			ЕстьСборка = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ЕстьСборка;
	
КонецФункции

