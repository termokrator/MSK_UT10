				СтрокаВозврата.DDATE1 = Формат(ВыборкаРезультата.DATE_TIMESTAMP, "ДФ='dd.MM.yyyy HH:mm'");
				СтрокаВозврата.DID    = СокрЛП(ВыборкаРезультата.Ссылка.УникальныйИдентификатор());
