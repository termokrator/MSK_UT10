Функция ЕстьЗакрытие(Заказ) Экспорт
	
	ЕстьОтказ = Ложь;
	ЗапросЗакрытия = Новый Запрос;
	ЗапросЗакрытия.Текст = 
	"ВЫБРАТЬ
	|	ЗакрытиеЗаказовПокупателейЗаказы.Ссылка
	|ИЗ
	|	Документ.ЗакрытиеЗаказовПокупателей.Заказы КАК ЗакрытиеЗаказовПокупателейЗаказы
	|ГДЕ
	|	ЗакрытиеЗаказовПокупателейЗаказы.ЗаказПокупателя = &Заказ
	|	И ЗакрытиеЗаказовПокупателейЗаказы.Ссылка.Проведен";
	
	ЗапросЗакрытия.УстановитьПараметр("Заказ",Заказ);
	РезультатЗакрытия = ЗапросЗакрытия.Выполнить();
	
	Если НЕ РезультатЗакрытия.Пустой() Тогда 		
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗаказыПокупателейОстатки.КоличествоОстаток
		|ИЗ
		|	РегистрНакопления.ЗаказыПокупателей.Остатки(, ЗаказПокупателя = &Заказ) КАК ЗаказыПокупателейОстатки
		|ГДЕ
		|	ЗаказыПокупателейОстатки.КоличествоОстаток > 0";
		
		Запрос.УстановитьПараметр("Заказ", Заказ);
		
		Результат = Запрос.Выполнить();
		
		Если Результат.Пустой() Тогда
			ЕстьОтказ = Истина;
		КонецЕсли;
		
	КонецЕсли; 
	
	Возврат ЕстьОтказ;	

КонецФункции

//+Гавриленков В. 19.05.2026 #UT10-5868 Добавлен параметр Адрес
Функция СоздатьПодключение(УТ11 = Ложь, ВидОперации = "", Склад = Неопределено, АдресСервиса = "") Экспорт
	
	//+Гавриленков В. 19.05.2026 #UT10-5868
	Если ЗначениеЗаполнено(АдресСервиса) Тогда 
		КонстантаАдрес = АдресСервиса;
	Иначе// Алгоритм без изменений 
		
		Если УТ11 Тогда
			
			Если НЕ Склад = Неопределено Тогда
				
				КонстантаАдрес = СокрЛП(Склад.АдресВебСервиса);
				ВСПользователь = "";
				ВСПароль = "";  			
				
			Иначе
				
				Если ВидОперации = "СторонниеСкладыВыбор" Тогда 
					КонстантаАдрес = Константы.АдресВебСервисаУТ11.Получить();
				ИначеЕсли ВидОперации = "СторонниеСкладыПарал" Тогда  
					КонстантаАдрес = Константы.АдресWebServiceСторСклады.Получить();
				Иначе 
					КонстантаАдрес = Константы.АдресВебСервисаУТ11.Получить();		
				КонецЕсли;
				
			КонецЕсли;
			
		ИначеЕсли ВидОперации = "Экспрессы" Или ВидОперации = "ГорючиеЖидкости" Тогда
			КонстантаАдрес = Константы.АдресВебСервисаУТ10.Получить();
		Иначе
			
			Если НЕ Склад = Неопределено Тогда
				КонстантаАдрес = СокрЛП(Склад.АдресВебСервиса);
			Иначе
				КонстантаАдрес = Константы.АдресВебСервиса.Получить();
			КонецЕсли;
			
		КонецЕсли; 
		
	КонецЕсли;
	
	АдресВебСервиса = "http://" + КонстантаАдрес + "/ws/GoodsReserve.1cws?wsdl";
	ВСОпределение = Новый WSОпределения(АдресВебСервиса, , ,, 30);
	ВСПрокси = Новый WSПрокси(ВСОпределение, "Data", "GoodsReserve", "GoodsReserveSoap");
	
	Возврат  ВСПрокси;	
	
КонецФункции

Функция ЗарезервироватьТоварыВСтороннейБазе(ТЗНоменклатуры, УТ11 = Ложь, ВидОперации = "", Склад = Неопределено) Экспорт
	
	Результат = Новый Структура("Загружен",Ложь);
	СтруктураДанных = Новый Структура;
	КодСоглашения = "";

	Если УТ11 Тогда 
		
		КодКонтрагента = Константы.КодКонтрагента.Получить();
		КодСоглашения = Константы.КодСоглашения.Получить(); 
		СтрУТ = "УТ11";		
		
	ИначеЕсли ВидОперации = "Экспрессы" Тогда
		
		КодКонтрагента = Константы.КодКонтрагентаЭкспрессУТ10Восток.Получить(); 
		СтрУТ = "УТ10";
		
	ИначеЕсли ВидОперации = "ГорючиеЖидкости" Тогда
		
		КодКонтрагента = Константы.КодКонтрагентаКроссДокинг.Получить(); 
		СтрУТ = "УТ10";     
		КодСоглашения = Константы.КодДоговораКроссДокингМасла.Получить(); 
		
	ИначеЕсли ВидОперации = "ПополнениеОП" Тогда
		
		Если НЕ Склад = Неопределено Тогда
			
			КодКонтрагента = Склад.КодКонтрагента;
			КодСоглашения  = Склад.КодДоговора;
			
		Иначе  			
			
			КодКонтрагента = Константы.КодКонтрагентаВстороннейУТ10Пополнение.Получить();			
			КодСоглашения  = Константы.КодМДМвСтороннейУТ10.Получить(); 
			
		КонецЕсли;
		
		СтрУТ = "УТ10";
		
	Иначе

		Если Константы.ОтправлятьЗаказыВСтророннююУТ.Получить() Тогда			
			КодСоглашения = СокрЛП(Константы.КодМДМвСтороннейУТ10.Получить());
		КонецЕсли;

		КодКонтрагента = Константы.КодКонтрагентаВстороннейУТ10.Получить();
		СтрУТ = "УТ10";	
		
	КонецЕсли;
	
	Попытка		
		
		//+Гавриленков В. 19.05.2026 #UT10-5868
		Если (Склад = Неопределено) ИЛИ ((ТипЗнч(Склад) = Тип("СправочникСсылка.СобственныеСклады")) И (Не ЗначениеЗаполнено(Склад.ВебСервис))) Тогда 
			// Алгоритм без изменений
			
			ВСПрокси = СоздатьПодключение(УТ11, ВидОперации, Склад);
			СтруктураДанных.Вставить("ТЗНоменклатуры", ТаблицуВМассив(ТЗНоменклатуры));
			СтруктураДанных.Вставить("КодМДМдоговора", КодСоглашения);
			
			Если Константы.ИспользоватьКонтрольВыгрузкиВУТ11ПоНоменклатуре.Получить() Тогда 
				СтруктураДанных.Вставить("ВидОперации", ВидОперации);
			КонецЕсли;                                                
			
			СтруктураДанных.Вставить("КодСоглашения", Константы.КодСоглашения.Получить());
			
			Если НЕ Склад = Неопределено И Склад.ВэбСервисУТ11 Тогда
				
				СтруктураДанных.Вставить("УИДмск", ТЗНоменклатуры[0].ГУИДЗаказаУТ10); 
				ТЗНоменклатуры.Колонки.Удалить("ГУИДЗаказаУТ10");
				
			КонецЕсли;
			
			Данные = ДанныеВJSONХранилище(СтруктураДанных);
			ЗаписьЖурналаРегистрации("Отправка заказа в стороннюю " + СтрУТ, УровеньЖурналаРегистрации.Информация,,, "GoodsReserve.отправка_заказа");
			
			Если УТ11 Тогда
				Ответ = ВСПрокси.ЗарезервироватьТовары(Данные, КодКонтрагента, КодСоглашения);
			Иначе
				Ответ = ВСПрокси.ЗарезервироватьТовары(Данные, КодКонтрагента);
			КонецЕсли;
			
		Иначе   
			
			ТаблицаАдресов = ПолучитьАдресаСервиса(Склад.ВебСервис);
			
			Если ТаблицаАдресов.Количество() = 0 Тогда
				ЗаписьЖурналаРегистрации("Отправка заказа в стороннюю " + СтрУТ, УровеньЖурналаРегистрации.Ошибка,,, "Не установлены веб-сервисы для склада " + Строка(Склад));
			Иначе
				
				ОтветПолучен = Ложь;
				
				Для Каждого СтрокаАдрес Из ТаблицаАдресов Цикл
					
					Если ОтветПолучен Тогда
						Прервать;
					КонецЕсли;  
					
					//+Гавриленков В. 27.05.2026 #UT10-5880 Создание подключение в попытке
					Попытка
						ВСПрокси = СоздатьПодключение(УТ11, ВидОперации, Склад, СтрокаАдрес.АдресСервиса);
					Исключение 
						
						ЗаписьЖурналаРегистрации("Получение статусов из сторонней базы", УровеньЖурналаРегистрации.Ошибка,,, "Не установлено соединение с веб-сервисом по адресу " + СтрокаАдрес.АдресСервиса + ", склад " + Строка(Склад));	
						Продолжить;
						
					КонецПопытки;
					
					СтруктураДанных.Вставить("ТЗНоменклатуры", ТаблицуВМассив(ТЗНоменклатуры));
					СтруктураДанных.Вставить("КодМДМдоговора", КодСоглашения);
					
					Если Константы.ИспользоватьКонтрольВыгрузкиВУТ11ПоНоменклатуре.Получить() Тогда 
						СтруктураДанных.Вставить("ВидОперации", ВидОперации);
					КонецЕсли;                                                
					
					СтруктураДанных.Вставить("КодСоглашения", Константы.КодСоглашения.Получить());
					
					Если НЕ Склад = Неопределено И Склад.ВэбСервисУТ11 Тогда
						
						СтруктураДанных.Вставить("УИДмск", ТЗНоменклатуры[0].ГУИДЗаказаУТ10); 
						ТЗНоменклатуры.Колонки.Удалить("ГУИДЗаказаУТ10");
						
					КонецЕсли;
					
					Данные = ДанныеВJSONХранилище(СтруктураДанных);
					ЗаписьЖурналаРегистрации("Отправка заказа в стороннюю " + СтрУТ, УровеньЖурналаРегистрации.Информация,,, "GoodsReserve.отправка_заказа");
					
					Попытка 
						
						Если УТ11 Тогда  
							
							Ответ = ВСПрокси.ЗарезервироватьТовары(Данные, КодКонтрагента, КодСоглашения);
							ОтветПолучен = Истина;
							
						Иначе 
							
							Ответ = ВСПрокси.ЗарезервироватьТовары(Данные, КодКонтрагента);
							ОтветПолучен = Истина; 
							
						КонецЕсли; 
						
					Исключение  
						
						ОтветПолучен = Ложь;
						ЗаписьЖурналаРегистрации("Ошибка получения ответа после отправки заказа в стороннюю " + СтрУТ, УровеньЖурналаРегистрации.Ошибка,,, "Веб-сервис " + СтрокаАдрес.АдресСервиса + " недоступен. " + ОписаниеОшибки());
						
					КонецПопытки;
					
				КонецЦикла; 
				
				Если ОтветПолучен Тогда
					
					ЗаписьЖурналаРегистрации("Получен ответ после отправки заказа в стороннюю " + СтрУТ, УровеньЖурналаРегистрации.Информация,,, "GoodsReserve.получение_заказа");
					Результат = ОбработкаОтвета(Ответ, Результат);	
					Возврат Результат;
					
				Иначе           
					
					ЗаписьЖурналаРегистрации("Отправка заказа в стороннюю " + СтрУТ, УровеньЖурналаРегистрации.Ошибка,,, "Не получен ответ ни по одному веб-сервису для склада " + Строка(Склад));
					Возврат Результат;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;		
		
	Исключение
		
		ЗаписьЖурналаРегистрации("Ошибка получения ответа после отправки заказа в стороннюю " + СтрУТ, УровеньЖурналаРегистрации.Ошибка,,, 
		"GoodsReserve.получение_заказа " + ОписаниеОшибки());
		
		Сообщить(ОписаниеОшибки());
		
		РаботаСАвардой.СоздатьОповещениеОбОшибкеОтправкиВАварду("Ошибка получения ответа после отправки заказа в стороннюю " + СтрУТ,
		"" + СокрЛП(Константы.База.Получить()) + ". GoodsReserve.получение_заказа " + ОписаниеОшибки());

		Возврат Результат;
		
	КонецПопытки;
	
	Результат = ОбработкаОтвета(Ответ, Результат);	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьРеализацииВСтороннейБазе(УТ11 = Ложь , ВидОперации = "" , Склад = Неопределено) Экспорт 
	
	Результат = Новый Структура("Загружен",Ложь); 
	КодМДМКонтрагента = "";
	
	Если УТ11 Тогда 
		
		КодКонтрагента = Константы.КодКонтрагента.Получить();
		КодСоглашения  = Константы.КодСоглашения.Получить();
		КроссДокинг    = ?(ВидОперации = "ГорючиеЖидкости", Истина, Ложь);
		мКодФилиала    = СокрЛП(Константы.КодФилиала.Получить());
		КодФилиала     = ?(мКодФилиала = "", Неопределено,мКодФилиала);

	ИначеЕсли ВидОперации = "Экспрессы" Тогда
		КодКонтрагента = Константы.КодКонтрагентаЭкспрессУТ10Восток.Получить();
	ИначеЕсли ВидОперации = "ГорючиеЖидкости" Тогда
		КодКонтрагента = Константы.КодКонтрагентаКроссДокинг.Получить();
	Иначе
		
		Если Склад = Неопределено Тогда
			КодМДМдоговора = Константы.КодМДМвСтороннейУТ10.Получить();
		Иначе
			
			КодМДМдоговора = Склад.КодДоговора;
			КодМДМКонтрагента = Склад.КодКонтрагента;		
			
		КонецЕсли;

	КонецЕсли;
	
	Попытка	
		
		//+Гавриленков В. 19.05.2026 #UT10-5868
		Если (Склад = Неопределено) ИЛИ ((ТипЗнч(Склад) = Тип("СправочникСсылка.СобственныеСклады")) И (Не ЗначениеЗаполнено(Склад.ВебСервис))) Тогда 
			// Алгоритм без изменений
			
			ВСПрокси = СоздатьПодключение(УТ11, ВидОперации, Склад);
			
			Если УТ11 Тогда
				
				Если НЕ Склад = Неопределено ИЛИ КодФилиала = Неопределено Тогда
					Ответ = ВСПрокси.ПолучитьРеализации(КодКонтрагента, КодСоглашения, КроссДокинг);
				Иначе
					Ответ = ВСПрокси.ПолучитьРеализацииПоФилиалу(КодКонтрагента, КодСоглашения, КроссДокинг,КодФилиала);	
				КонецЕсли;
				
			Иначе			
				Ответ = ВСПрокси.ПолучитьРеализацииVer2(КодМДМдоговора, КодМДМКонтрагента);
			КонецЕсли; 
			
		Иначе     
			
			ТаблицаАдресов = ПолучитьАдресаСервиса(Склад.ВебСервис);
			
			Если ТаблицаАдресов.Количество() = 0 Тогда
				ЗаписьЖурналаРегистрации("Получение реализаций сторонней базе", УровеньЖурналаРегистрации.Ошибка,,, "Не установлены веб-сервисы для склада " + Строка(Склад));
			Иначе
				
				ОтветПолучен = Ложь;
				
				Для Каждого СтрокаАдрес Из ТаблицаАдресов Цикл
					
					Если ОтветПолучен Тогда
						Прервать;
					КонецЕсли;   
					
					//+Гавриленков В. 27.05.2026 #UT10-5880 Создание подключение в попытке
					Попытка
						ВСПрокси = СоздатьПодключение(УТ11, ВидОперации, Склад, СтрокаАдрес.АдресСервиса);
					Исключение 
						
						ЗаписьЖурналаРегистрации("Получение статусов из сторонней базы", УровеньЖурналаРегистрации.Ошибка,,, "Не установлено соединение с веб-сервисом по адресу " + СтрокаАдрес.АдресСервиса + ", склад " + Строка(Склад));	
						Продолжить;
						
					КонецПопытки;
					
					
					Если УТ11 Тогда
						
						Попытка
							
							Если КодФилиала = Неопределено Тогда
								
								Ответ = ВСПрокси.ПолучитьРеализации(КодКонтрагента, КодСоглашения, КроссДокинг); 
								ОтветПолучен = Истина;
								
							Иначе   
								
								Ответ = ВСПрокси.ПолучитьРеализацииПоФилиалу(КодКонтрагента, КодСоглашения, КроссДокинг,КодФилиала);
								ОтветПолучен = Истина;
								
							КонецЕсли;  
							
						Исключение
							ОтветПолучен = Ложь;
						КонецПопытки;
						
					Иначе		
						
						Попытка  
							
							Ответ = ВСПрокси.ПолучитьРеализацииVer2(КодМДМдоговора, КодМДМКонтрагента);
							ОтветПолучен = Истина;
							
						Исключение
							ОтветПолучен = Ложь;
						КонецПопытки;
						
					КонецЕсли;
					
				КонецЦикла;
				
				Если ОтветПолучен Тогда
					
					Результат = ОбработкаОтвета(Ответ, Результат);	
					Возврат Результат; 
					
				Иначе
					
					ЗаписьЖурналаРегистрации("Получение реализаций сторонней базе", УровеньЖурналаРегистрации.Ошибка,,, "Не получен ответ ни по одному веб-сервису для склада " + Строка(Склад));
					Возврат Результат;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;

	Исключение
		
		Сообщить(ОписаниеОшибки());		
		Возврат Результат;
		
	КонецПопытки;
	
	Результат = ОбработкаОтвета(Ответ, Результат);	
	Возврат Результат;
	
КонецФункции

