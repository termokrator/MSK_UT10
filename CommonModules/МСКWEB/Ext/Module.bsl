Функция ОбработкаОтвета(Ответ, Результат) Экспорт
	
	Если ТипЗнч(Ответ) = Тип("ХранилищеЗначения") Тогда		
		
		Данные = ХранилищеJSONВСтруктуру(Ответ);		
		
		Если ТипЗнч(Данные) = Тип("Структура") Тогда			
			
			Результат.Вставить("СписокДанных",Данные.СписокДанных);
			
			Если Результат.СписокДанных.Количество() > 0 Тогда
				Результат.Загружен = Истина;
			Иначе
				Результат.Загружен = Ложь;
			КонецЕсли;			 
			
			//+Шульман А. 21.02.2025 #UT10-5103  
			Если Данные.Свойство("ДанныеРезультат") Тогда       
				Результат.Вставить("ДанныеРезультат", Данные.ДанныеРезультат);
			КонецЕсли;
			//-Шульман А. 21.02.2025 #UT10-5103
			
			//+Макрушин Е. 24.09.2025 #UT10-5430 
			Если Данные.Свойство("ДополнительныеДанные") Тогда       
				Результат.Вставить("ДополнительныеДанные", Данные.ДополнительныеДанные);
			КонецЕсли;
			//-Макрушин Е. 24.09.2025 #UT10-5430
			
		КонецЕсли;		
		
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

