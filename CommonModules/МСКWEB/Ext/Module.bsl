				Если ВыборкаРезультата.Зарезервированно > 0 Тогда 
					СтрокаСтатус = СтрокаСтатус + "10;зарезервирован;"+СокрЛП(ВыборкаРезультата.Зарезервированно) + ",";
				КонецЕсли;
				
				Если ВыборкаРезультата.ЗаказаноПоставщику > 0 Тогда
					
					ИмяПоля      = "ЗаказаноПоставщику";
					Количество   = ВыборкаРезультата.ЗаказаноПоставщику;					
					КодСообщения = 10;                                              
					СообщениеДляПортала = СформироватьСообщениеДляПортала(ИмяПоля, Количество, ВыборкаРезультата.СтатусAvarda, КодСообщения, Истина,
					                    ?(ВыборкаРезультата.СтатусПоДопПостащику = "", "ЦС в Москве", ВыборкаРезультата.СтатусПоДопПостащику));
					СтрокаСтатус = СтрокаСтатус + СообщениеДляПортала + СокрЛП(ВыборкаРезультата.ЗаказаноПоставщику) + ",";
					
				КонецЕсли;         
				
				Если ВыборкаРезультата.Собирается <> 0 Тогда
					СтрокаСтатус = СтрокаСтатус + "10;на подборе;" + СокрЛП(ВыборкаРезультата.Собирается) + ",";
				КонецЕсли;       
				
				Если ВыборкаРезультата.ГотовоКПогрузке > 0 Тогда
					СтрокаСтатус = СтрокаСтатус + "40;готов к отгрузке;" + СокрЛП(ВыборкаРезультата.ГотовоКПогрузке) + ",";
				КонецЕсли;

				Если ВыборкаРезультата.ОтказКлиента > 0 ИЛИ ВыборкаРезультата.Закрыт Тогда
					СтрокаСтатус = СтрокаСтатус + "100;отказ покупателя;" + СокрЛП(ВыборкаРезультата.ОтказКлиента) + ",";
				КонецЕсли;     
				
				Если ВыборкаРезультата.ОтказПоставщика > 0 Тогда 
					СтрокаСтатус = СтрокаСтатус + ?(ВыборкаРезультата.ссылка.ТаксиДоставка, "110;нет на складе;", "110;отказ поставщика;")
					              + СокрЛП(ВыборкаРезультата.ОтказПоставщика) + ",";
				КонецЕсли;               
							  
				Если ВыборкаРезультата.ОтказИстекСрок > 0 Тогда 
					СтрокаСтатус = СтрокаСтатус + "110;истек срок резервирования;" + СокрЛП(ВыборкаРезультата.ОтказИстекСрок) + ",";
				КонецЕсли;                
				
				Если ВыборкаРезультата.ОтказОшибкаКратности > 0 И ВыборкаРезультата.Ссылка.IDСклада_СтороннийСклад.Пустая() Тогда 
					СтрокаСтатус = СтрокаСтатус + "110;ошибка кратности;" + СокрЛП(ВыборкаРезультата.ОтказОшибкаКратности) + ",";
				КонецЕсли;            
				
				Если ВыборкаРезультата.НаДоставке > 0 Тогда 
					СтрокаСтатус = СтрокаСтатус + "50;на доставке;" + СокрЛП(ВыборкаРезультата.НаДоставке) + ",";
				КонецЕсли; 
				
				Если ВыборкаРезультата.Доставлено > 0 Тогда
					СтрокаСтатус = СтрокаСтатус + ?(ВыборкаРезультата.ТаксиДоставка И КонецДня(ВыборкаРезультата.ДокументПродажи.Дата) = КонецДня(ТекущаяДата()),
					               "60;Такси доставка " + ?(ВыборкаРезультата.КолГрузомест = 0 , "", "(" + СокрЛП(ВыборкаРезультата.КолГрузомест) + " гр.мест)") 
					             + ";", "60;выполнен;") + СокрЛП(ВыборкаРезультата.Доставлено) + ",";
				КонецЕсли;
							
				СтрокаВозврата.STATUS = СокрЛП(СтрокаСтатус);
				
				мМожноКорректировать = Истина;	
				
				Если Найти(СтрокаСтатус, "40;готов к отгрузке") > 0 
					ИЛИ Найти(СтрокаСтатус, "50;на доставке") > 0 
					ИЛИ Найти(СтрокаСтатус, "60;") > 0 
					ИЛИ Найти(СтрокаСтатус, "100;отказ покупателя") > 0 
					ИЛИ Найти(СтрокаСтатус, "110;отказ поставщика") > 0
					ИЛИ Найти(СтрокаСтатус, "110;нет на складе") > 0
					ИЛИ Найти(СтрокаСтатус, "110;истек срок резервирования") > 0 
					Тогда 
					мМожноКорректировать = Ложь;
				ИначеЕсли СтрокаСтатус = "10;на подборе" Тогда
					мМожноКорректировать = ПроверитьСтатусСборки(ВыборкаРезультата.Ссылка, ВыборкаРезультата.Номенклатура);
				Иначе
					мМожноКорректировать = Ложь;
				КонецЕсли;                         
				
				Если мМожноКорректировать Тогда 
					мМожноКорректировать = НЕ Константы.ЯчейкаДляПеремещенияОтказовКлиентов.Получить().Пустая();
				КонецЕсли;                                                           
				
				Если мМожноКорректировать Тогда 
					мМожноКорректировать = ВыборкаРезультата.Ссылка.IDСклада_СтороннийСклад.Пустая();
				КонецЕсли;                                                        
				
				СтрокаВозврата.FLAG_1 = ПолучитьСписокДействийСЗаказом(ВыборкаРезультата.Ссылка, ВыборкаРезультата.ЕстьСборка, ВыборкаРезультата.ЕстьЗаказ,мМожноКорректировать);
				
				РезультатДляВозвратаПорталу.Row.Добавить(СтрокаВозврата);   
				
			КонецЦикла;		
			
		КонецЕсли;		
		
		ДобавитьНеСозданныеЗаказыПокупателей(РезультатДляВозвратаПорталу, пДатаНачалаОтчета, пДатаКонцаОтчета, ИДАвардаКонтрагента, ТипСтрокаОтвета); 
		
	КонецЕсли;
	
	Возврат РезультатДляВозвратаПорталу;
	
КонецФункции

Функция PM_GET_ZP_PORTAL(ПараметрыОтбора) Экспорт
	
	пЗаказКлиента	  = СокрЛП(ПараметрыОтбора.DID_ZP);
	ДокументЗаказКлиента = Документы.ЗаказПокупателя.ПолучитьСсылку(Новый УникальныйИдентификатор(пЗаказКлиента));
	
	ТипОтвет					= ФабрикаXDTO.Тип(Метаданные.WebСервисы.PM_GET_ZP_PORTAL.ПространствоИмен, "RS_PM_GET_ZP_PORTAL");
	РезультатДляВозвратаПорталу = ФабрикаXDTO.Создать(ТипОтвет);
	ТипСтрокаОтвета			    = ФабрикаXDTO.Тип(Метаданные.WebСервисы.PM_GET_ZP_PORTAL.ПространствоИмен, "Out_PM_GET_ZP_PORTAL");  
	
	Если НЕ ДокументЗаказКлиента.Пустая() Тогда
		
		ЗапросПоШапкеЗаказа = Новый Запрос;
		ЗапросПоШапкеЗаказа.УстановитьПараметр("ЗаказПараметр", ДокументЗаказКлиента);
		ЗапросПоШапкеЗаказа.Текст =
		"ВЫБРАТЬ
		|	ЗаказПокупателяТовары.Ссылка,
		|	ЗаказПокупателяТовары.Ссылка.Номер КАК DOC_NUM,
		|	ЗаказПокупателяТовары.Ссылка.Дата КАК DOC_DATE,
		|	ЗаказПокупателяТовары.Ссылка.Контрагент.Наименование КАК FILIAL,
		|	ВЫБОР
		|		КОГДА ЗаказПокупателяТовары.Ссылка.Контрагент.НеИспользоватьИдентификаторАвардыДляСвязиСПорталом
		|				ИЛИ ЗаказПокупателяТовары.Ссылка.Контрагент.IDАварда = """"
		|			ТОГДА ЗаказПокупателяТовары.Ссылка.Контрагент.КодМДМ
		|		ИНАЧЕ ЗаказПокупателяТовары.Ссылка.Контрагент.IDАварда
		|	КОНЕЦ КАК FILIAL_ID,
		|	ЗаказПокупателяТовары.Ссылка.Контрагент.ГоловнойКонтрагент.Наименование КАК KONTRAGENT,
		|	ЗаказПокупателяТовары.Ссылка.ДоговорКонтрагента.Наименование КАК DOGOVOR,
		|	ВЫБОР
		|		КОГДА НЕ ЕСТЬNULL(ЗаказПокупателяТовары.Ссылка.IDСклада_СтороннийСклад.Наименование, """") = """"
		|			ТОГДА ЗаказПокупателяТовары.Ссылка.IDСклада_СтороннийСклад.Идентификатор
		|		ИНАЧЕ ЗаказПокупателяТовары.Ссылка.СкладГруппа.Наименование
		|	КОНЕЦ КАК SKLAD,
		|	ЗаказПокупателяТовары.Ссылка.ВалютаДокумента.Наименование КАК VALUTA,
		|	ВЫБОР
		|		КОГДА ЗаказПокупателяТовары.Ссылка.Контрагент.ГоловнойКонтрагент.НеИспользоватьИдентификаторАвардыДляСвязиСПорталом
		|				ИЛИ ЗаказПокупателяТовары.Ссылка.Контрагент.ГоловнойКонтрагент.IDАварда = """"
		|			ТОГДА ЗаказПокупателяТовары.Ссылка.Контрагент.ГоловнойКонтрагент.КодМДМ
		|		ИНАЧЕ ЗаказПокупателяТовары.Ссылка.Контрагент.ГоловнойКонтрагент.IDАварда
		|	КОНЕЦ КАК KONTRAGENT_ID,
		|	МАКСИМУМ(ЗаказПокупателяТовары.НомерСтроки) КАК KOL_VO_STROK,
		|	СУММА(ЗаказПокупателяТовары.Количество) КАК KOL_VO_POS,
		|	НЕ ЕСТЬNULL(ЗаказПокупателяТовары.Ссылка.IDСклада_СтороннийСклад.Наименование, """") = """" КАК Стор
		|ИЗ
		|	Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары
		|ГДЕ
		|	ЗаказПокупателяТовары.Ссылка = &ЗаказПараметр
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказПокупателяТовары.Ссылка,
		|	ЗаказПокупателяТовары.Ссылка.Номер,
		|	ЗаказПокупателяТовары.Ссылка.Дата,
		|	ЗаказПокупателяТовары.Ссылка.Контрагент.Наименование,
		|	ЗаказПокупателяТовары.Ссылка.ДоговорКонтрагента.Наименование,
		|	ЗаказПокупателяТовары.Ссылка.ВалютаДокумента.Наименование,
		|	ЗаказПокупателяТовары.Ссылка.Контрагент.ГоловнойКонтрагент.Наименование,
		|	ВЫБОР
		|		КОГДА ЗаказПокупателяТовары.Ссылка.Контрагент.НеИспользоватьИдентификаторАвардыДляСвязиСПорталом
		|				ИЛИ ЗаказПокупателяТовары.Ссылка.Контрагент.IDАварда = """"
		|			ТОГДА ЗаказПокупателяТовары.Ссылка.Контрагент.КодМДМ
		|		ИНАЧЕ ЗаказПокупателяТовары.Ссылка.Контрагент.IDАварда
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА ЗаказПокупателяТовары.Ссылка.Контрагент.ГоловнойКонтрагент.НеИспользоватьИдентификаторАвардыДляСвязиСПорталом
		|				ИЛИ ЗаказПокупателяТовары.Ссылка.Контрагент.ГоловнойКонтрагент.IDАварда = """"
		|			ТОГДА ЗаказПокупателяТовары.Ссылка.Контрагент.ГоловнойКонтрагент.КодМДМ
		|		ИНАЧЕ ЗаказПокупателяТовары.Ссылка.Контрагент.ГоловнойКонтрагент.IDАварда
		|	КОНЕЦ,
		|	НЕ ЕСТЬNULL(ЗаказПокупателяТовары.Ссылка.IDСклада_СтороннийСклад.Наименование, """") = """",
		|	ВЫБОР
		|		КОГДА НЕ ЕСТЬNULL(ЗаказПокупателяТовары.Ссылка.IDСклада_СтороннийСклад.Наименование, """") = """"
		|			ТОГДА ЗаказПокупателяТовары.Ссылка.IDСклада_СтороннийСклад.Идентификатор
		|		ИНАЧЕ ЗаказПокупателяТовары.Ссылка.СкладГруппа.Наименование
		|	КОНЕЦ
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЗаказПокупателяТовары.Ссылка.Дата УБЫВ";
		
		РезультатЗапросаШапкиЗаказа = ЗапросПоШапкеЗаказа.Выполнить();
		
		ЕстьСборка = ЕстьСборка(ДокументЗаказКлиента);
		ЕстьЗаказ = ЕстьЗаказПоставщику(ДокументЗаказКлиента);
		
		Если НЕ РезультатЗапросаШапкиЗаказа.Пустой() Тогда
			
			ВыборкаРезультата = РезультатЗапросаШапкиЗаказа.Выбрать();
			
			Пока ВыборкаРезультата.Следующий()Цикл
				
				СтрокаВозврата = ФабрикаXDTO.Создать(ТипСтрокаОтвета);
				ЗаполнитьЗначенияСвойств(СтрокаВозврата, ВыборкаРезультата, , "FILIAL_ID, KONTRAGENT_ID,SKLAD");
				СтрокаВозврата.DOC_NUM = СокрЛП(СтрокаВозврата.DOC_NUM) + "("
				                       + ?(ВыборкаРезультата.Ссылка.ТаксиДоставка, "Такси", СтрЗаменить(ВыборкаРезультата.Ссылка.СпособДоставки, "Наша д", "Д")) + ")";	
					
				СтрокаВозврата.FILIAL_ID =  СокрЛП(ВыборкаРезультата.FILIAL_ID);
				СтрокаВозврата.KONTRAGENT_ID = СокрЛП(ВыборкаРезультата.KONTRAGENT_ID);
				СтрокаВозврата.SKLAD = ?(ВыборкаРезультата.Стор, "Стор ", "") + СокрЛП(ВыборкаРезультата.SKLAD); 
				
				Если ДокументЗаказКлиента.ТолькоРезерв Тогда
					ДействияВДесятичномВиде = "0010";
				Иначе					
					ДействияВДесятичномВиде = "0010";
				КонецЕсли;  
				
				СтрокаВозврата.FLAG_1 = ДвоичноеВДесятичное(ДействияВДесятичномВиде);
				
				РезультатДляВозвратаПорталу.Row.Добавить(СтрокаВозврата);
				
			КонецЦикла;	
			
		КонецЕсли;	
		
	КонецЕсли;
	
	Возврат РезультатДляВозвратаПорталу;
	
КонецФункции

Функция PM_GET_RNS_STR_FOR_PORTAL(ПараметрыОтбора) Экспорт
	
	пЗаказКлиента	  = СокрЛП(ПараметрыОтбора.DID_6951);
	ДокументЗаказКлиента = Документы.ЗаказПокупателя.ПолучитьСсылку(Новый УникальныйИдентификатор(пЗаказКлиента));
	
	ТипОтвет					= ФабрикаXDTO.Тип(Метаданные.WebСервисы.PM_GET_RNS_STR_FOR_PORTAL.ПространствоИмен, "RS_PM_GET_RNS_STR_FOR_PORTAL");
	РезультатДляВозвратаПорталу = ФабрикаXDTO.Создать(ТипОтвет);
	ТипСтрокаОтвета			    = ФабрикаXDTO.Тип(Метаданные.WebСервисы.PM_GET_RNS_STR_FOR_PORTAL.ПространствоИмен, "Out_PM_GET_RNS_STR_FOR_PORTAL"); 
	
	Если НЕ ДокументЗаказКлиента.Пустая() Тогда
		
		ЗапросПоСтрокамЗаказа = Новый Запрос;
		ЗапросПоСтрокамЗаказа.УстановитьПараметр("ЗаказПараметр", ДокументЗаказКлиента);
		ЗапросПоСтрокамЗаказа.УстановитьПараметр("ДатаНач", ДокументЗаказКлиента.Дата);
		
		//Расчет полей в зависимости от константы ДатаОтправкиСтатусаДоставкиНаПортал
		//Доставлено = РН Продажи, где у Документа продажи (РТУ) установлено свойство Товар передан
		//На доставке = Колво из документа Грузовое место (проведен и V Погружено) - Доставлено
		//Готово к погрузке = РН Собрано по заказу - ?(На доставке> 0, На доставке, Доставлено)
		
		ДатаНачалаВыгрузкиСтатусаДоставкиНаПортал = Константы.ДатаНачалаВыгрузкиСтатусаДоставкиНаПортал.Получить();
		
		Если ЗначениеЗаполнено(ДатаНачалаВыгрузкиСтатусаДоставкиНаПортал) Тогда
			ЗапросПоСтрокамЗаказа.УстановитьПараметр("ДатаНачалаВыгрузкиСтатусаДоставкиНаПортал", ДатаНачалаВыгрузкиСтатусаДоставкиНаПортал);
		Иначе
			ЗапросПоСтрокамЗаказа.УстановитьПараметр("ДатаНачалаВыгрузкиСтатусаДоставкиНаПортал", Дата("22000101"));
		КонецЕсли;			
		
		РазрешеноРедактироватьЗаказ = Ложь;           
		
		ЗапросПоСтрокамЗаказа.УстановитьПараметр("РазрешеноРедактироватьЗаказ", РазрешеноРедактироватьЗаказ);
		ЗапросПоСтрокамЗаказа.Текст =
		"ВЫБРАТЬ
		|	ЗаказПокупателяТовары.Ссылка КАК Заказ,
		|	ЗаказПокупателяТовары.Номенклатура КАК Номенклатура,
		|	СУММА(ЗаказПокупателяТовары.Количество) КАК Количество,
		|	ЗаказПокупателяТовары.Цена,
		|	МАКСИМУМ(ЗаказПокупателяТовары.Комментарий) КАК Комментарий,
		|	ВЫБОР
		|		КОГДА &РазрешеноРедактироватьЗаказ = ИСТИНА
		|			ТОГДА ЗаказПокупателяТовары.КлючСтроки
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК IDLIN
		|ПОМЕСТИТЬ СгруппТаблЧасть
		|ИЗ
		|	Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары
		|ГДЕ
		|	ЗаказПокупателяТовары.Ссылка = &ЗаказПараметр
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказПокупателяТовары.Ссылка,
		|	ЗаказПокупателяТовары.Номенклатура,
		|	ЗаказПокупателяТовары.Цена,
		|	ВЫБОР
		|		КОГДА &РазрешеноРедактироватьЗаказ = ИСТИНА
		|			ТОГДА ЗаказПокупателяТовары.КлючСтроки
		|		ИНАЧЕ """"
		|	КОНЕЦ
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Заказ,
		|	Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ИсторияХраненияИзмененийЗагружСтатусов.ЗаказПокупателя,
		|	ИсторияХраненияИзмененийЗагружСтатусов.Номенклатура,
		|	МИНИМУМ(ИсторияХраненияИзмененийЗагружСтатусов.Статус) КАК СтатусAvarda
		|ПОМЕСТИТЬ ИсторияСтатусовAvarda
		|ИЗ
		|	РегистрСведений.ИсторияХраненияИзмененийЗагружСтатусов КАК ИсторияХраненияИзмененийЗагружСтатусов
		|ГДЕ
		|	ИсторияХраненияИзмененийЗагружСтатусов.ЗаказПокупателя = &ЗаказПараметр
		|
		|СГРУППИРОВАТЬ ПО
		|	ИсторияХраненияИзмененийЗагружСтатусов.ЗаказПокупателя,
		|	ИсторияХраненияИзмененийЗагружСтатусов.Номенклатура
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ИсторияХраненияИзмененийЗагружСтатусов.ЗаказПокупателя,
		|	ИсторияХраненияИзмененийЗагружСтатусов.Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Т1.Заказ,
		|	Т1.Номенклатура,
		|	Т1.Количество,
		|	Т1.Цена,
		|	Т1.Комментарий,
		|	Т1.IDLIN,
		|	ЕСТЬNULL(Т2.СтатусAvarda, """") КАК СтатусAvarda
		|ПОМЕСТИТЬ ТаблЧасть
		|ИЗ
		|	СгруппТаблЧасть КАК Т1
		|		ЛЕВОЕ СОЕДИНЕНИЕ ИсторияСтатусовAvarda КАК Т2
		|		ПО Т1.Заказ = Т2.ЗаказПокупателя
		|			И Т1.Номенклатура = Т2.Номенклатура
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Т1.Заказ,
		|	Т1.Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(ВЫБОР
		|			КОГДА ЗаказыПокупателейОтказПоставщика.ВидДвижения ЕСТЬ NULL
		|				ТОГДА 0
		|			ИНАЧЕ ВЫБОР
