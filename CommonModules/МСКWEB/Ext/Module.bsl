Функция ОбработатьСкладскойЗаказВУТ11(ДокЗаказ) Экспорт
	
	Результат = Новый Структура("Обработан",Ложь);
	СтруктураДанных = Новый Структура;	
	КодКонтрагента = Константы.КодКонтрагента.Получить();
	КодСоглашения = Константы.КодСоглашения.Получить();
	
	Попытка		
		
		ВСПрокси = СоздатьПодключение(Истина, "ОбработкаСкладскихЗаказов");		
		
		СтруктураДанных.Вставить("ГУИДЗаказаПокупателя", СокрЛП(ДокЗаказ.ГУИДЗаказаПокупателя));
		СтруктураДанных.Вставить("СкладскойЗаказ"      , ДокЗаказ.СкладскойЗаказ);
		СтруктураДанных.Вставить("ПометкаУдаления"     , ДокЗаказ.ПометкаУдаления);
		Данные = ДанныеВJSONХранилище(СтруктураДанных);
		
		ЗаписьЖурналаРегистрации("Отправка заказа в стороннюю УТ11", УровеньЖурналаРегистрации.Информация,,, "GoodsReserve.Обработка_складских_заказов");
		
		Ответ = ВСПрокси.ОбработкаСкладскихЗаказов(Данные, КодКонтрагента, КодСоглашения);	
		ЗаписьЖурналаРегистрации("Получен ответ после отправки заказа в стороннюю УТ11", УровеньЖурналаРегистрации.Информация,,, "GoodsReserve.Обработка_складских_заказов");
		
	Исключение
		
		ЗаписьЖурналаРегистрации("Ошибка получения ответа после отправки заказа в стороннюю УТ11", УровеньЖурналаРегистрации.Ошибка,,, 
		"GoodsReserve.Обработка_складских_заказов " + ОписаниеОшибки());
		
		Сообщить(ОписаниеОшибки());
		РаботаСАвардой.СоздатьОповещениеОбОшибкеОтправкиВАварду("Ошибка получения ответа после отправки заказа в стороннюю УТ11",
		"GoodsReserve.Обработка_складских_заказов " + ОписаниеОшибки());
		Возврат Результат;
		
	КонецПопытки;
	
	Если ТипЗнч(Ответ) = Тип("ХранилищеЗначения") Тогда		
		
		Данные = ХранилищеJSONВСтруктуру(Ответ);		
		
		Если ТипЗнч(Данные) = Тип("Структура") Тогда			
			
			Результат.Вставить("Описание", Данные.СписокДанных.ОписаниеОтвета);
			Результат.Обработан = Данные.СписокДанных.Результат;
			
		КонецЕсли;		
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Процедура ДобавитьНеСозданныеЗаказыПокупателей(РезультатДляВозвратаПорталу, пДатаНачалаОтчета, пДатаКонцаОтчета, ИДАвардаКонтрагента, ТипСтрокаОтвета)
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	СУММА(НеСозданныеЗаказыПокупателейТовары.Price * НеСозданныеЗаказыПокупателейТовары.Count) КАК SUMMA,
	|	НеСозданныеЗаказыПокупателейТовары.Ссылка.Ссылка,
	|	НеСозданныеЗаказыПокупателейТовары.Ссылка.Дата КАК DATE_TIMESTAMP,
	|	НеСозданныеЗаказыПокупателейТовары.Ссылка.Наименование КАК FILIAL_NAME,
	|	ВЫРАЗИТЬ(НеСозданныеЗаказыПокупателейТовары.Ссылка.Comment КАК СТРОКА(100)) КАК DNOTE,
	|	""RUB"" КАК VALUTA_NAME,
	|	НеСозданныеЗаказыПокупателейТовары.Ссылка.FirmID КАК OUR_FIRM
	|ИЗ
	|	Справочник.НеСозданныеЗаказыПокупателей.Товары КАК НеСозданныеЗаказыПокупателейТовары
	|ГДЕ
	|	НеСозданныеЗаказыПокупателейТовары.Ссылка.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|	И НеСозданныеЗаказыПокупателейТовары.Ссылка.ПометкаУдаления = ЛОЖЬ
	|	И НеСозданныеЗаказыПокупателейТовары.Ссылка.KontragentID = &KontragentID
	|	И НеСозданныеЗаказыПокупателейТовары.Ссылка.ЗаказПокупателяСсылка = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	НеСозданныеЗаказыПокупателейТовары.Ссылка.FirmID,
	|	НеСозданныеЗаказыПокупателейТовары.Ссылка.Ссылка,
	|	НеСозданныеЗаказыПокупателейТовары.Ссылка.Дата,
	|	ВЫРАЗИТЬ(НеСозданныеЗаказыПокупателейТовары.Ссылка.Comment КАК СТРОКА(100)),
	|	ПРЕДСТАВЛЕНИЕ(НеСозданныеЗаказыПокупателейТовары.Ссылка.ФилиалКонтрагента)
	|
	|УПОРЯДОЧИТЬ ПО
	|	DATE_TIMESTAMP");
	
	Запрос.УстановитьПараметр("ДатаНач", ?(ЗначениеЗаполнено(пДатаНачалаОтчета), НачалоДня(пДатаНачалаОтчета), НачалоДня(ТекущаяДата() - 86400 * 14)));
	Запрос.УстановитьПараметр("ДатаКон", ?(ЗначениеЗаполнено(пДатаКонцаОтчета), КонецДня(пДатаКонцаОтчета), КонецДня(ТекущаяДата())));
	Запрос.УстановитьПараметр("KontragentID", ИДАвардаКонтрагента);
	
	РезЗапроса = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрРез Из РезЗапроса Цикл
		
		СтрокаВозврата = ФабрикаXDTO.Создать(ТипСтрокаОтвета);		
		
		СтрокаВозврата.DATE_TIMESTAMP = СтрРез.DATE_TIMESTAMP;		
		СтрокаВозврата.FILIAL_NAME = СтрРез.FILIAL_NAME;
		СтрокаВозврата.DNOTE = СтрРез.DNOTE;
		СтрокаВозврата.VALUTA_NAME = СтрРез.VALUTA_NAME;
		СтрокаВозврата.DOGOVOR_NAME = "";
		СтрокаВозврата.SKLAD_NAME = "";
		СтрокаВозврата.OUR_FIRM = СтрРез.OUR_FIRM;		
		
		СтрокаВозврата.DID = СокрЛП(СтрРез.Ссылка.УникальныйИдентификатор());
		СтрокаВозврата.DDATE1 = Формат(СтрРез.DATE_TIMESTAMP, "ДФ='dd.MM.yyyy HH:mm'");
		СтрокаВозврата.DCODE = "Заказ от " + СтрокаВозврата.DDATE1;
		СтрокаВозврата.STATUS = "10; принят в работу";
		СтрокаВозврата.REZERV_SUM = СтрРез.SUMMA;
		
		СтрокаВозврата.FLAG_1 = "0000";
		
		РезультатДляВозвратаПорталу.Row.Добавить(СтрокаВозврата);
		
	КонецЦикла;		
	
КонецПроцедуры

Функция ПроверитьКратностьИСоздатьКорректировкуЗаказаПокупателя(НовыйДокЗаказ, Комментарий = "", ПараметрРежимПроведенияДокумента = Неопределено) Экспорт
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("Документ", "");
	СтруктураВозврата.Вставить("Ошибка", "");
	
	ДокументКорректировки = Документы.КорректировкаЗаказаПокупателя.СоздатьДокумент();
	ДокументКорректировки.Заполнить(НовыйДокЗаказ.Ссылка);
	ДокументКорректировки.Дата = ТекущаяДата();
	ДокументКорректировки.Комментарий = Комментарий;
	ДокументКорректировки.ВалютаДокумента = НовыйДокЗаказ.ВалютаДокумента; 
	
	ДокументКорректировки.Товары.Очистить();
	ДокументКорректировки.Услуги.Очистить();                               
	ДокументКорректировки.ВозвратнаяТара.Очистить();
	
	Для Каждого СтрТовары Из НовыйДокЗаказ.Товары Цикл 

		РезультатДеления = СтрТовары.Количество / ?(СтрТовары.Номенклатура.Кратность = 0, 1, СтрТовары.Номенклатура.Кратность);
		ЦелаяЧасть = Цел(РезультатДеления);   
		
		Если НЕ РезультатДеления = ЦелаяЧасть Тогда

			НоваяСтрока = ДокументКорректировки.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрТовары);	
			НоваяСтрока.Количество = -НоваяСтрока.Количество;
			НоваяСтрока.Причина = Перечисления.ПричиныКорректировкиСборки.ОшибкаКратности;
			
			мВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();	
			ОбработкаТабличныхЧастей.ПриИзмененииНоменклатурыТабЧасти(НоваяСтрока, ДокументКорректировки);	
			ОбработкаТабличныхЧастей.ЗаполнитьСтавкуНДСТабЧасти(НоваяСтрока, ДокументКорректировки, "Реализация");
			ОбработкаТабличныхЧастей.РассчитатьКоличествоМестТабЧасти(НоваяСтрока, ДокументКорректировки);
			ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(НоваяСтрока, ДокументКорректировки);
			ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НоваяСтрока, ДокументКорректировки);	
			ОбработкаТабличныхЧастей.РассчитатьПлановуюСебестоимостьВСтрокеТабЧасти(НоваяСтрока, ДокументКорректировки, мВалютаРегламентированногоУчета);
			
		КонецЕсли;   
		
	КонецЦикла;
	
	ДокументКорректировки.СуммаДокумента = ДокументКорректировки.Товары.Итог("Сумма");
	
	Если ДокументКорректировки.Товары.Количество() > 0 Тогда  
		
		Попытка
			
			Если ПараметрРежимПроведенияДокумента = Неопределено Тогда
				ДокументКорректировки.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Оперативный);		
			Иначе
				ДокументКорректировки.Записать(РежимЗаписиДокумента.Проведение, ПараметрРежимПроведенияДокумента);		
			КонецЕсли; 		
			
			СтруктураВозврата.Документ = ДокументКорректировки;			
			
		Исключение
			
			СтруктураВозврата.Документ = ДокументКорректировки;
			СтруктураВозврата.Ошибка = ОписаниеОшибки();
			Возврат СтруктураВозврата;
			
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции

Функция ОтправитьПТУВУТ11(Док) Экспорт
	
	Результат = Новый Структура("Загружен, ОписаниеОшибки, Текст, ИДДокументаВСмежнойБазе, НомерДокументаУТ11, ДатаДокументаУТ11", Ложь, "", "", "", "", Дата(1,1,1));
	СтруктураДанных = Новый Структура;

	//Проверка, был ли ранее отправлен документ в УТ11
	Если (ТипЗнч(Док.Ссылка) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") 
		и ЗначениеЗаполнено(МСКWEB.ЗначениеДопСвойства(Док.Ссылка, ПланыВидовХарактеристик.СвойстваОбъектов.IDИнвойса)))
		или (ТипЗнч(Док.Ссылка) = Тип("ДокументСсылка.ПоступлениеТоваровНаОтветственноеХранение") и ЗначениеЗаполнено(Док.Ссылка.ИдДокументаВСмежнойБазе)) Тогда
		
		Возврат Результат;
		
	КонецЕсли;

	Попытка
		
		СтруктураДанных.Вставить("ВидОперации", "Транзит4");
		СтруктураДанных.Вставить("КодКонтрагента", Док.Контрагент.КодМДМ);
		СтруктураДанных.Вставить("ДатаПоДаннымПоставщика", Док.ДатаВходящегоДокумента);
		СтруктураДанных.Вставить("НомерПоДаннымПоставщика", Док.НомерВходящегоДокумента);
		СтруктураДанных.Вставить("ДатаПоступления", Док.ДатаПриходаТовараНаСклад);
		СтруктураДанных.Вставить("Валюта", Док.ВалютаДокумента.Код);

		Если ТипЗнч(Док) = Тип("ДокументСсылка.ПоступлениеТоваровНаОтветственноеХранение") И ЗначениеЗаполнено(Док.ГрузополучательТОХ) Тогда
			СтруктураДанных.Вставить("КодФилиала", Док.ГрузополучательТОХ.КодМДМГрузополучателяУТ11);
		Иначе			
			СтруктураДанных.Вставить("КодФилиала", Константы.КодФилиала.Получить());
		КонецЕсли;

		СтруктураДанных.Вставить("КодКонтрагентаКонечногоПокупателя", Константы.КодКонтрагента.Получить());
		СтруктураДанных.Вставить("СуммаДокумента", Док.СуммаДокумента);
		СтруктураДанных.Вставить("СуммаНДС", ?(ОбщегоНазначения.ЕстьРеквизитТабЧастиДокумента("СуммаНДС", Док.Метаданные(), "Товары"), Док.Товары.Выгрузить().Итог("СуммаНДС"), 0));
		СтруктураДанных.Вставить("Сумма", Док.Товары.Выгрузить().Итог("Сумма"));
		СтруктураДанных.Вставить("СуммаВключаетНДС", ?(ОбщегоНазначения.ЕстьРеквизитДокумента("СуммаВключаетНДС", Док.Метаданные()), Док.СуммаВключаетНДС, Ложь));
		СтруктураДанных.Вставить("КурсВзаиморасчетов", Док.КурсВзаиморасчетов);
		СтруктураДанных.Вставить("Дата", Док.Дата);
		СтруктураДанных.Вставить("Номер", Док.Номер);
		СтруктураДанных.Вставить("Ответственный", Строка(Док.Ответственный));
		СтруктураДанных.Вставить("ОтветственноеХранение", ТипЗнч(Док) = Тип("ДокументСсылка.ПоступлениеТоваровНаОтветственноеХранение"));
		СтруктураДанных.Вставить("Филиал", СокрЛП(Константы.База.Получить()));
		
		//+Белов А. 13.01.2025 #UT10-5006
		Если ТипЗнч(Док.Ссылка) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
			СтруктураДанных.Вставить("ТранспортныеЕдиницы", ТаблицуВМассив(Док.УпаковочныеЛисты.Выгрузить()));	                  
		КонецЕсли;
		//-Белов А. 13.01.2025 #UT10-5006   
		
		//+Шульман А. 01.04.2025 #UT10-5173 
		Если ОбщегоНазначения.ЕстьРеквизитДокумента("ПремиальнаяПерекупка", Док.Метаданные()) Тогда
			СтруктураДанных.Вставить("ПремиальнаяПерекупка", Док.ПремиальнаяПерекупка);
		КонецЕсли;
		//-Шульман А. 01.04.2025 #UT10-5173
		
		КодГрузоотправителяУТ11 = "";       
		
		Если ОбщегоНазначения.ЕстьРеквизитТабЧастиДокумента("ЗаказПоставщику",Док.Метаданные(), "Товары") Тогда			
			
			Для Каждого СтрТов Из Док.Товары Цикл			
				
				Если ЗначениеЗаполнено(СтрТов.ЗаказПоставщику.IDСкладаСобственныйСклад) Тогда					
					
					КодГрузоотправителяУТ11 = СтрТов.ЗаказПоставщику.IDСкладаСобственныйСклад.КодГрузоотправителяУТ11;
					Прервать;
					
				КонецЕсли;				
				
			КонецЦикла;			
			
		КонецЕсли;	        
		
		СтруктураДанных.Вставить("КодГрузоотправителя", КодГрузоотправителяУТ11);
		
		Данные = ДанныеВJSONХранилище(СтруктураДанных);
		ЗаписьЖурналаРегистрации("GoodsReserve.СоздатьИнвойсПо4Транзиту", УровеньЖурналаРегистрации.Информация,,, "Отправка ПТУ в стороннюю УТ11");
		
		ВСПрокси = СоздатьПодключение(Истина);
		Ответ = ВСПрокси.СоздатьИнвойсПоТранзиту4(Данные);
		ЗаписьЖурналаРегистрации("GoodsReserve.СоздатьИнвойсПо4Транзиту", УровеньЖурналаРегистрации.Информация,,, "Получен ответ после отправки ПТУ в стороннюю УТ11");
		
	Исключение
		
		ЗаписьЖурналаРегистрации("GoodsReserve.СоздатьИнвойсПо4Транзиту", УровеньЖурналаРегистрации.Ошибка,,, 
		"Ошибка получения ответа после отправки ПТУ в стороннюю УТ11: " + ОписаниеОшибки());
		
		Сообщить(ОписаниеОшибки());
		РаботаСАвардой.СоздатьОповещениеОбОшибкеОтправкиВАварду("Ошибка получения ответа после отправки ПТУ в стороннюю УТ11",
		"GoodsReserve.СоздатьИнвойсПо4Транзиту " + ОписаниеОшибки());
		Результат.ОписаниеОшибки = ОписаниеОшибки();
		
		Возврат Результат;
		
	КонецПопытки;

	Если ТипЗнч(Ответ) = Тип("ХранилищеЗначения") Тогда		
		
		Данные = ХранилищеJSONВСтруктуру(Ответ);		
		
		Если ТипЗнч(Данные) = Тип("Структура") Тогда
			ЗаполнитьЗначенияСвойств(Результат, Данные);
		КонецЕсли;		
		
	КонецЕсли;
	
	Если Результат.Загружен Тогда     
		
		IDИнвойса = Результат.ИДДокументаВСмежнойБазе;
		ДокПоступление = Док.ПолучитьОбъект();
		ДокПоступление.Комментарий = ДокПоступление.Комментарий + ?(ЗначениеЗаполнено(ДокПоступление.Комментарий), ". ", "") 
		+ СтрШаблон("В УТ11 Инвойс %1 от %2", Результат.НомерДокументаУТ11, Формат(Результат.ДатаДокументаУТ11, "ДФ=dd.MM.yyyy"));
		
		Если ТипЗнч(ДокПоступление.Ссылка) = Тип("ДокументСсылка.ПоступлениеТоваровНаОтветственноеХранение") Тогда
			
			ДокПоступление.ИДДокументаВСмежнойБазе = IDИнвойса;
			ДокПоступление.Статус = Перечисления.СтатусыПТОХ.ОтправленИнвойс;

		КонецЕсли;
		
		УстановитьПривилегированныйРежим(Истина);
		ДокПоступление.Записать(РежимЗаписиДокумента.Запись);
		УстановитьПривилегированныйРежим(Ложь);
		
		Если ТипЗнч(ДокПоступление.Ссылка) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
			УстановитьЗначениеДопСвойства(ДокПоступление.Ссылка, ПланыВидовХарактеристик.СвойстваОбъектов.IDИнвойса, IDИнвойса);
		КонецЕсли;

	КонецЕсли;
	///
	
	Возврат Результат;
	
КонецФункции

Функция ПеренестиДатуПеремещенияТоваровВУТ11(ПТУ) Экспорт
	
	//+Сёмин Р. 16.02.2026 #UT10-5677
	Подключение = СоздатьПодключение(Истина);
	
	СтруктураПараметры = Новый Структура("ТранзитнаяПоставка", ПТУ.ТранзитнаяПоставка);
	
	РезультатХранилищеЗначения = Подключение.ПеренестиПеремещениеТоваровНаТекущийМесяц(
		Строка(ПТУ.ИДДокументаВСмежнойБазе),
		ДанныеВJSONХранилище(СтруктураПараметры)
	);
	
	Результат = ХранилищеJSONВСтруктуру(РезультатХранилищеЗначения);
	
	Если Результат.ОперацияВыполнена Тогда
		лУровеньЖурналаРегистрации = УровеньЖурналаРегистрации.Информация;
	Иначе
		лУровеньЖурналаРегистрации = УровеньЖурналаРегистрации.Ошибка;
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации(
		"МСКWEB.ПеренестиДатуПеремещенияТоваровУТ11",
		лУровеньЖурналаРегистрации,
		Метаданные.Документы.ПоступлениеТоваровУслуг,
		ПТУ,
		"УТ 11: " + Результат.ТекстСообщения
	);
	
	Возврат Результат;
	//-Сёмин Р. 16.02.2026 #UT10-5677
	
КонецФункции

Функция ПолучитьДанныеИзУТ11ОПодписиПТУВЭДО(МассивГУИДыПТУ) Экспорт
	
	//+Сёмин Р.И. 14.07.2026 #UT10-5945
	СтруктураПараметры = Новый Структура;
	СтруктураПараметры.Вставить("ГУИДыПТУ", МассивГУИДыПТУ);
	
	ВСПрокси = СоздатьПодключение(Истина);
	
	РезультатХранилищеЗначения = ВСПрокси.ПолучитьПодписанныеПоступления(ДанныеВJSONХранилище(СтруктураПараметры));
	Результат = ХранилищеJSONВСтруктуру(РезультатХранилищеЗначения);
	
	Возврат Результат;
	//-Сёмин Р.И. 14.07.2026 #UT10-5945
	
КонецФункции

Функция ПолучитьАдресаСервиса(Настройка) Экспорт
//+Гавриленков В. 19.05.2026 #UT10-5868
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	АдресаСервисов.АдресСервиса
	|ИЗ
	|	Справочник.ВнешниеСервисы.АдресаСервисов КАК АдресаСервисов
	|ГДЕ
	|	АдресаСервисов.Ссылка = &Ссылка
	|	И НЕ (ВЫРАЗИТЬ(АдресаСервисов.АдресСервиса КАК СТРОКА(256))) = """"";
	
	Запрос.УстановитьПараметр("Ссылка", Настройка);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
//-Гавриленков В. 19.05.2026 #UT10-5868	
КонецФункции

