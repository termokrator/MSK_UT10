					Если ВыборкаРезультата.ОтказКлиента > 0 И НЕ ПромКолПоСтроке = 0 Тогда      
						
						СтрокаВозврата = ЗаполнитьСтрокуВозврата(ТипСтрокаОтвета, ВыборкаРезультата, Мин(ВыборкаРезультата.ОтказКлиента, ПромКолПоСтроке), 
						                 "100;отказ покупателя", Истина, СтрокаТаблЧасти.ТолькоРезерв);
						РезультатДляВозвратаПорталу.Row.Добавить(СтрокаВозврата);
						ВыборкаРезультата.ОтказКлиента = ?(ВыборкаРезультата.ОтказКлиента <= ПромКолПоСтроке, 0, ВыборкаРезультата.ОтказКлиента - ПромКолПоСтроке);
						ПромКолПоСтроке = ПромКолПоСтроке - СтрокаВозврата.KOL_VO;   
						
						Если СтрокаВозврата.KOL_VO = СтрокаТаблЧасти.Количество Тогда 
							Продолжить;  
						КонецЕсли;  
						
					КонецЕсли;
					
					Если ВыборкаРезультата.ОтказПоставщика > 0 И НЕ ПромКолПоСтроке = 0 Тогда 
						
						СтрокаВозврата =  ЗаполнитьСтрокуВозврата(ТипСтрокаОтвета, ВыборкаРезультата, Мин(ВыборкаРезультата.ОтказПоставщика, ПромКолПоСтроке), 
						             ?(ВыборкаРезультата.ссылка.ТаксиДоставка, "110;нет на складе", "110;отказ поставщика"), Истина, СтрокаТаблЧасти.ТолькоРезерв);
						РезультатДляВозвратаПорталу.Row.Добавить(СтрокаВозврата);
						ВыборкаРезультата.ОтказПоставщика = ?(ВыборкаРезультата.ОтказПоставщика <= ПромКолПоСтроке, 0, ВыборкаРезультата.ОтказПоставщика - ПромКолПоСтроке);
						ПромКолПоСтроке = ПромКолПоСтроке - СтрокаВозврата.KOL_VO;
						
						Если СтрокаВозврата.KOL_VO = СтрокаТаблЧасти.Количество Тогда 
							Продолжить;  
						КонецЕсли;
						
					КонецЕсли;
					
					Если ВыборкаРезультата.ОтказИстекСрок > 0 И НЕ ПромКолПоСтроке = 0 Тогда    
						
						СтрокаВозврата =  ЗаполнитьСтрокуВозврата(ТипСтрокаОтвета, ВыборкаРезультата, Мин(ВыборкаРезультата.ОтказИстекСрок, ПромКолПоСтроке), 
						                 "110;истек срок резервирования", Истина, СтрокаТаблЧасти.ТолькоРезерв);
						РезультатДляВозвратаПорталу.Row.Добавить(СтрокаВозврата);
						ВыборкаРезультата.ОтказИстекСрок = ?(ВыборкаРезультата.ОтказИстекСрок <= ПромКолПоСтроке, 0, ВыборкаРезультата.ОтказИстекСрок - ПромКолПоСтроке);
						ПромКолПоСтроке = ПромКолПоСтроке - СтрокаВозврата.KOL_VO;        
						
						Если СтрокаВозврата.KOL_VO = СтрокаТаблЧасти.Количество Тогда 
							Продолжить;  
						КонецЕсли;  
						
					КонецЕсли;
					
					Если ВыборкаРезультата.ОтказОшибкаКратности > 0 И ВыборкаРезультата.Ссылка.IDСклада_СтороннийСклад.Пустая() И НЕ ПромКолПоСтроке = 0 Тогда
						
						СтрокаВозврата =  ЗаполнитьСтрокуВозврата(ТипСтрокаОтвета, ВыборкаРезультата, Мин(ВыборкаРезультата.ОтказОшибкаКратности, ПромКолПоСтроке), 
						                 "110;ошибка кратности", Истина, СтрокаТаблЧасти.ТолькоРезерв);
						РезультатДляВозвратаПорталу.Row.Добавить(СтрокаВозврата);
						ВыборкаРезультата.ОтказОшибкаКратности = ?(ВыборкаРезультата.ОтказОшибкаКратности <= ПромКолПоСтроке, 0, 
						                                        ВыборкаРезультата.ОтказОшибкаКратности - ПромКолПоСтроке);
						ПромКолПоСтроке = ПромКолПоСтроке - СтрокаВозврата.KOL_VO;         
						
						Если СтрокаВозврата.KOL_VO = СтрокаТаблЧасти.Количество Тогда 
							Продолжить; 
						КонецЕсли; 
						
					КонецЕсли;
					
					Если ВыборкаРезультата.НаДоставке > 0 И НЕ ПромКолПоСтроке = 0 Тогда  
						
						СтрокаВозврата =  ЗаполнитьСтрокуВозврата(ТипСтрокаОтвета, ВыборкаРезультата, Мин(ВыборкаРезультата.НаДоставке, ПромКолПоСтроке), 
						                 "50;на доставке", Истина, СтрокаТаблЧасти.ТолькоРезерв);
						РезультатДляВозвратаПорталу.Row.Добавить(СтрокаВозврата);
						ВыборкаРезультата.НаДоставке = ?(ВыборкаРезультата.НаДоставке<=ПромКолПоСтроке, 0, ВыборкаРезультата.НаДоставке - ПромКолПоСтроке);
						ПромКолПоСтроке = ПромКолПоСтроке - СтрокаВозврата.KOL_VO;  
						
						Если СтрокаВозврата.KOL_VO = СтрокаТаблЧасти.Количество Тогда
							Продолжить;  
						КонецЕсли; 
						
					КонецЕсли;
					
					
					Если ВыборкаРезультата.ГотовоКПогрузке > 0 И НЕ ПромКолПоСтроке = 0 Тогда    
						
						СтрокаВозврата =  ЗаполнитьСтрокуВозврата(ТипСтрокаОтвета, ВыборкаРезультата, Мин(ВыборкаРезультата.ГотовоКПогрузке, ПромКолПоСтроке), 
						                  "40;готов к отгрузке", Истина, СтрокаТаблЧасти.ТолькоРезерв);
						РезультатДляВозвратаПорталу.Row.Добавить(СтрокаВозврата);
						ВыборкаРезультата.ГотовоКПогрузке = ?(ВыборкаРезультата.ГотовоКПогрузке <= ПромКолПоСтроке, 0, ВыборкаРезультата.ГотовоКПогрузке - ПромКолПоСтроке);
						ПромКолПоСтроке = ПромКолПоСтроке - СтрокаВозврата.KOL_VO;         
						
						Если СтрокаВозврата.KOL_VO = СтрокаТаблЧасти.Количество Тогда 
							Продолжить;  
						КонецЕсли;   
						
					КонецЕсли;
					
					Если ВыборкаРезультата.Зарезервированно > 0 И НЕ ПромКолПоСтроке = 0 Тогда    
						
						СтрокаВозврата =  ЗаполнитьСтрокуВозврата(ТипСтрокаОтвета, ВыборкаРезультата, Мин(ВыборкаРезультата.Зарезервированно, ПромКолПоСтроке), 
						                 "10;зарезервирован", Истина, СтрокаТаблЧасти.ТолькоРезерв);
						РезультатДляВозвратаПорталу.Row.Добавить(СтрокаВозврата);
						ВыборкаРезультата.Зарезервированно = ?(ВыборкаРезультата.Зарезервированно<=ПромКолПоСтроке, 0, ВыборкаРезультата.Зарезервированно - ПромКолПоСтроке);
						ПромКолПоСтроке = ПромКолПоСтроке - СтрокаВозврата.KOL_VO;  
						
						Если СтрокаВозврата.KOL_VO = СтрокаТаблЧасти.Количество Тогда 
							Продолжить;  
						КонецЕсли;
						
					КонецЕсли;    
					
					Если ВыборкаРезультата.Заказано > 0 И НЕ ПромКолПоСтроке = 0 Тогда  
						
						СтрокаВозврата =  ЗаполнитьСтрокуВозврата(ТипСтрокаОтвета, ВыборкаРезультата, Мин(ВыборкаРезультата.Заказано, ПромКолПоСтроке), 
						                 "20;заказан", Истина, СтрокаТаблЧасти.ТолькоРезерв);
						РезультатДляВозвратаПорталу.Row.Добавить(СтрокаВозврата);
						ВыборкаРезультата.Заказано = ?(ВыборкаРезультата.Заказано <= ПромКолПоСтроке, 0, ВыборкаРезультата.Заказано - ПромКолПоСтроке);
						ПромКолПоСтроке = ПромКолПоСтроке - СтрокаВозврата.KOL_VO;                   
						
						Если СтрокаВозврата.KOL_VO = СтрокаТаблЧасти.Количество Тогда 
							Продолжить;  
						КонецЕсли;	
						
					КонецЕсли; 
					
				КонецЕсли; 
				
			КонецЕсли;   
			
		КонецЦикла;		
		
	КонецЕсли;     
	
	Возврат РезультатДляВозвратаПорталу; 
	
КонецФункции

Функция PM_6051_DOC_FOR_PORTAL(ПараметрыОтбора) Экспорт  
		
	пРеализация = СокрЛП(ПараметрыОтбора.DID);
	
	//Теперь на входе СФ входящая, но также оставляю вариант если придет реализация	
	НашлиДокумент = Ложь;
	НашлиДокументСФ = Ложь;
	ДокументСФКлиента = Документы.СчетФактураВыданный.ПолучитьСсылку(Новый УникальныйИдентификатор(пРеализация));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СчетФактураВыданный.Ссылка
	|ИЗ
	|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
	|ГДЕ
	|	СчетФактураВыданный.Ссылка = &Ссылка
	|	И СчетФактураВыданный.Проведен";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСФКлиента);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();  
	
	Если  ВыборкаДетальныеЗаписи.Следующий() Тогда        
		
		ДокументРеализацияКлиента = ДокументСФКлиента.ДокументОснование;
		НашлиДокумент = Истина;
		НашлиДокументСФ = Истина;   
		
	Иначе
		
		// пробуем найти реализацию
		ДокументРеализацияКлиента = Документы.РеализацияТоваровУслуг.ПолучитьСсылку(Новый УникальныйИдентификатор(пРеализация));
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	РеализацияТоваровУслуг.Ссылка
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|ГДЕ
		|	РеализацияТоваровУслуг.Ссылка = &Ссылка
		|	И РеализацияТоваровУслуг.Проведен";
		
		Запрос.УстановитьПараметр("Ссылка", ДокументРеализацияКлиента);
		
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();  
		
		Если  ВыборкаДетальныеЗаписи.Следующий() Тогда 
			НашлиДокумент = Истина;
		КонецЕсли;              
		
	КонецЕсли;
	
	ТипОтвет					= ФабрикаXDTO.Тип(Метаданные.WebСервисы.PM_6051_DOC_FOR_PORTAL.ПространствоИмен, "RS_PM_6051_DOC_FOR_PORTAL");
	РезультатДляВозвратаПорталу = ФабрикаXDTO.Создать(ТипОтвет);
	ТипСтрокаОтвета			    = ФабрикаXDTO.Тип(Метаданные.WebСервисы.PM_6051_DOC_FOR_PORTAL.ПространствоИмен, "Out_PM_6051_DOC_FOR_PORTAL"); 
	
	Если НашлиДокумент Тогда	             
		
		ЗапросПоШапкеРеализация = Новый Запрос;
		ЗапросПоШапкеРеализация.УстановитьПараметр("РеализацияПараметр", ДокументРеализацияКлиента);
		ЗапросПоШапкеРеализация.Текст =  
		"ВЫБРАТЬ
		|	РеализацияТоваровУслуг.Ссылка,
		|	РеализацияТоваровУслуг.Ссылка.Номер КАК DCODE,
		|	ВЫБОР
		|		КОГДА РеализацияТоваровУслуг.Ссылка.Контрагент.ГоловнойКонтрагент.НеИспользоватьИдентификаторАвардыДляСвязиСПорталом
		|				ИЛИ РеализацияТоваровУслуг.Ссылка.Контрагент.ГоловнойКонтрагент.IDАварда = """"
		|			ТОГДА РеализацияТоваровУслуг.Ссылка.Контрагент.ГоловнойКонтрагент.КодМДМ
		|		ИНАЧЕ РеализацияТоваровУслуг.Ссылка.Контрагент.ГоловнойКонтрагент.IDАварда
		|	КОНЕЦ КАК IDKLIENT,
		|	РеализацияТоваровУслуг.Ссылка.Контрагент.ГоловнойКонтрагент.Наименование КАК KLIENT,
		|	РеализацияТоваровУслуг.Ссылка.Дата КАК DDATE1,
		|	РеализацияТоваровУслуг.Ссылка.Контрагент.Наименование КАК FILIAL,
		|	РеализацияТоваровУслуг.Ссылка.ВалютаДокумента.Наименование КАК VALUTA,
		|	""Отгружен"" КАК DSTATE,
		|	РеализацияТоваровУслуг.Ссылка.СуммаДокумента КАК DNUM1,
		|	ЕСТЬNULL(РеализацияТоваровУслуг.Водитель.Наименование, """") КАК VODITEL_NAME,
		|	ЕСТЬNULL(КонтактнаяИнформация.Представление, """") КАК MOBILE_VODITEL,
		|	ВЫБОР
		|		КОГДА РеализацияТоваровУслуг.ТаксиДоставка
		|			ТОГДА ЕСТЬNULL(Грузоместа.Грузоместо, 0)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Грузомест,
		|	ВЫБОР
		|		КОГДА РеализацияТоваровУслуг.ДоговорКонтрагента.РозничнаяПродажа
		|				ИЛИ РеализацияТоваровУслуг.ДоговорКонтрагента.ЛицевойСчет
		|			ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК FLAGS
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		|		ПО РеализацияТоваровУслуг.Водитель = КонтактнаяИнформация.Объект
		|			И (КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон))
		|			И (КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонФизЛицаСлужебный))
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ГрузовоеМесто.РеализацияСамовывоза КАК Реализация,
		|			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ГрузовоеМесто.Ссылка) КАК Грузоместо
		|		ИЗ
		|			Документ.ГрузовоеМесто КАК ГрузовоеМесто
		|		ГДЕ
		|			ГрузовоеМесто.РеализацияСамовывоза = &РеализацияПараметр
		|			И ГрузовоеМесто.Проведен
		|			И ГрузовоеМесто.Погружено
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ГрузовоеМесто.РеализацияСамовывоза) КАК Грузоместа
		|		ПО РеализацияТоваровУслуг.Ссылка = Грузоместа.Реализация
		|ГДЕ
		|	РеализацияТоваровУслуг.Ссылка = &РеализацияПараметр";	       
		
		РезультатЗапросаШапкиРеализация = ЗапросПоШапкеРеализация.Выполнить(); 
		
		Если НЕ РезультатЗапросаШапкиРеализация.Пустой() Тогда            
			
			ВыборкаРезультата = РезультатЗапросаШапкиРеализация.Выбрать();  
			
			Пока ВыборкаРезультата.Следующий()Цикл                      
				
				СтрокаВозврата = ФабрикаXDTO.Создать(ТипСтрокаОтвета);
				ЗаполнитьЗначенияСвойств(СтрокаВозврата, ВыборкаРезультата);
				
				СтрокаВозврата.IDDOC     = СокрЛП(ВыборкаРезультата.Ссылка.УникальныйИдентификатор());				
				СтрокаВозврата.PLAN_DATE_DOSTAVKA = Формат(ВыборкаРезультата.DDATE1, "ДФ=dd.MM.yyyy");
				
				Если НашлиДокументСФ Тогда 
					
					СтрокаВозврата.DCODE = ОбщегоНазначения.ПолучитьНомерНаПечать(ДокументСФКлиента,,,Истина);						
                    //+Кабанов А.В. 16.04.2025 # UT10-5193
					//СтрокаВозврата.FLAGS = 1; 
					СтрокаВозврата.FLAGS = ВыборкаРезультата.FLAGS;
					//-Кабанов А.В. 16.04.2025 # UT10-5193
					
				КонецЕсли;	
				
				
				Если КонецДня(ВыборкаРезультата.Ссылка.Дата) = КонецДня(ТекущаяДата()) И ВыборкаРезультата.Ссылка.ТаксиДоставка И НЕ ВыборкаРезультата.Грузомест = 0 Тогда
					 СтрокаВозврата.DSTATE = "Такси доставка (" + СокрЛП(ВыборкаРезультата.Грузомест) + " гр.мест)";
				 КонецЕсли;	
				 
				РезультатДляВозвратаПорталу.Row.Добавить(СтрокаВозврата);          
				
			КонецЦикла;	
			
		КонецЕсли;	
		
	КонецЕсли;               
	
	Возврат РезультатДляВозвратаПорталу;     
	
КонецФункции

Функция RA_R_RN_LIN(ПараметрыОтбора) Экспорт     
	
	пРеализация = СокрЛП(ПараметрыОтбора.IDDOC);
	
	//Теперь на входе СФ входящая, но также оставляю вариант если придет реализация
	НашлиДокумент = Ложь;
	ДокументСФКлиента = Документы.СчетФактураВыданный.ПолучитьСсылку(Новый УникальныйИдентификатор(пРеализация));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СчетФактураВыданный.Ссылка
	|ИЗ
	|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
	|ГДЕ
	|	СчетФактураВыданный.Ссылка = &Ссылка
	|	И СчетФактураВыданный.Проведен";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСФКлиента);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда 
		
		ДокументРеализацияКлиента = ДокументСФКлиента.ДокументОснование;
		НашлиДокумент = Истина;             
		
	Иначе
		
		// пробуем найти реализацию
		ДокументРеализацияКлиента = Документы.РеализацияТоваровУслуг.ПолучитьСсылку(Новый УникальныйИдентификатор(пРеализация));
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	РеализацияТоваровУслуг.Ссылка
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|ГДЕ
		|	РеализацияТоваровУслуг.Ссылка = &Ссылка
		|	И РеализацияТоваровУслуг.Проведен";
		
		Запрос.УстановитьПараметр("Ссылка", ДокументРеализацияКлиента);
		
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();  
		
		Если  ВыборкаДетальныеЗаписи.Следующий() Тогда 
			НашлиДокумент = Истина;
		КонецЕсли;       
		
	КонецЕсли;
	
	ТипОтвет					= ФабрикаXDTO.Тип(Метаданные.WebСервисы.RA_R_RN_LIN.ПространствоИмен, "RS_RA_R_RN_LIN");
	РезультатДляВозвратаПорталу = ФабрикаXDTO.Создать(ТипОтвет);
	ТипСтрокаОтвета			    = ФабрикаXDTO.Тип(Метаданные.WebСервисы.RA_R_RN_LIN.ПространствоИмен, "Out_RA_R_RN_LIN"); 
	
	Если НашлиДокумент Тогда                       
		
		Для Каждого СтрокаРеализации ИЗ ДокументРеализацияКлиента.Товары Цикл  
			
			СтрокаВозврата = ФабрикаXDTO.Создать(ТипСтрокаОтвета);
			СтрокаВозврата.EID = СтрокаРеализации.НомерСтроки;
			СтрокаВозврата.EID2 = СокрЛП(СтрокаРеализации.Номенклатура.Код);
			СтрокаВозврата.PROIZV = СокрЛП(СтрокаРеализации.Номенклатура.Родитель.Наименование);
			СтрокаВозврата.ARTICLE = СокрЛП(СтрокаРеализации.Номенклатура.КодПроизводителя);
			СтрокаВозврата.TOVAR_NAME = СокрЛП(СтрокаРеализации.Номенклатура.Наименование);
			СтрокаВозврата.TOVAR_KOL_V_ED_IZM = СтрокаРеализации.ЕдиницаИзмерения.Коэффициент * СтрокаРеализации.Количество;
			СтрокаВозврата.KOEF_EDIZM = СтрокаРеализации.ЕдиницаИзмерения.Коэффициент;
			СтрокаВозврата.TOVAR_KOL = СтрокаРеализации.Количество;
			СтрокаВозврата.TOVAR_EDIZM = СокрЛП(СтрокаРеализации.ЕдиницаИзмерения.Наименование);
			СтрокаВозврата.TOVAR_PRICE = СтрокаРеализации.Цена;
			СтрокаВозврата.TOVAR_SUMMA = СтрокаРеализации.Сумма;
			СтрокаВозврата.TOVAR_PRIMECH = "";
			РезультатДляВозвратаПорталу.Row.Добавить(СтрокаВозврата);    
			
		КонецЦикла;	
		
	КонецЕсли;  
	
	Возврат РезультатДляВозвратаПорталу; 
	
КонецФункции

Функция PM_GET_BALANCE_FOR_PORTAL(ПараметрыОтбора) Экспорт
	
	пКодКонтрагентаПортал = СтрЗаменить(СокрЛП(ПараметрыОтбора.ID), Символы.НПП, ""); 	
	
	ТипОтвет					= ФабрикаXDTO.Тип(Метаданные.WebСервисы.PM_GET_BALANCE_FOR_PORTAL.ПространствоИмен, "RS_PM_GET_BALANCE_FOR_PORTAL");
	РезультатДляВозвратаПорталу = ФабрикаXDTO.Создать(ТипОтвет);
	ТипСтрокаОтвета			    = ФабрикаXDTO.Тип(Метаданные.WebСервисы.PM_GET_BALANCE_FOR_PORTAL.ПространствоИмен, "Out_PM_GET_BALANCE_FOR_PORTAL");  
	
	Если СтрДлина(пКодКонтрагентаПортал) = 36 Тогда  
		пКонтрагент = Справочники.Контрагенты.НайтиПоРеквизиту("КодМДМ", пКодКонтрагентаПортал);	
	Иначе
		пКонтрагент = Справочники.Контрагенты.НайтиПоРеквизиту("IDАварда", пКодКонтрагентаПортал);	
	КонецЕсли;	
	
	Если НЕ пКонтрагент.Пустая() Тогда                        
		
		Договор = пКонтрагент.ОсновнойДоговорКонтрагента;     
		
		Если ЗначениеЗаполнено(Договор) Тогда   
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	-ВзаиморасчетыСКонтрагентамиОстатки.СуммаВзаиморасчетовОстаток КАК СуммаВзаиморасчетовОстаток
			|ИЗ
			|	РегистрНакопления.ВзаиморасчетыСКонтрагентами.Остатки(
			|			,
			|			Контрагент = &Контрагент
			|				И ДоговорКонтрагента = &Договор) КАК ВзаиморасчетыСКонтрагентамиОстатки"; 
			
			Запрос.УстановитьПараметр("Контрагент", пКонтрагент);
			Запрос.УстановитьПараметр("Договор", Договор);        
			
			Выб = Запрос.Выполнить().Выбрать();
			СтрокаВозврата = ФабрикаXDTO.Создать(ТипСтрокаОтвета);
			СтрокаВозврата.Summa_RUB = 0;             
			
			Если Выб.Следующий() Тогда
				СтрокаВозврата.Summa_RUB = Выб.СуммаВзаиморасчетовОстаток;
			КонецЕсли;                       
			
			СтрокаВозврата.Summa_EUR = 0;
			РезультатДляВозвратаПорталу.Row.Добавить(СтрокаВозврата);
			
		Иначе                    
			
			СтрокаВозврата = ФабрикаXDTO.Создать(ТипСтрокаОтвета);
			СтрокаВозврата.Summa_RUB = 0;
			СтрокаВозврата.Summa_EUR = 0;
			РезультатДляВозвратаПорталу.Row.Добавить(СтрокаВозврата);
			
		КонецЕсли; 
		
	КонецЕсли;   
	
	Возврат РезультатДляВозвратаПорталу;
	
КонецФункции

Функция PM_CALCULATION_FOR_PORTAL(ПараметрыОтбора) Экспорт
	
	пКодКонтрагентаПортал = СтрЗаменить(СокрЛП(ПараметрыОтбора.KONTRAGENT_ID), Символы.НПП, ""); 	
	
	ТипОтвет					= ФабрикаXDTO.Тип(Метаданные.WebСервисы.PM_GET_BALANCE_FOR_PORTAL.ПространствоИмен, "RS_PM_CALCULATION_FOR_PORTAL");
	РезультатДляВозвратаПорталу = ФабрикаXDTO.Создать(ТипОтвет);
	ТипСтрокаОтвета			    = ФабрикаXDTO.Тип(Метаданные.WebСервисы.PM_GET_BALANCE_FOR_PORTAL.ПространствоИмен, "Out_PM_CALCULATION_FOR_PORTAL");  
	
	Если СтрДлина(пКодКонтрагентаПортал) = 36 Тогда  
		пКонтрагент = Справочники.Контрагенты.НайтиПоРеквизиту("КодМДМ", пКодКонтрагентаПортал);	
	Иначе
		пКонтрагент = Справочники.Контрагенты.НайтиПоРеквизиту("IDАварда", пКодКонтрагентаПортал);	
	КонецЕсли;	
	
	ДатаНач = ?(ЗначениеЗаполнено(ПараметрыОтбора.BDATE), Дата(ПараметрыОтбора.BDATE), Дата("20010101000000"));
	ДатаКон = ?(ЗначениеЗаполнено(ПараметрыОтбора.EDATE), Дата(ПараметрыОтбора.EDATE), Дата("20990101000000"));
	
	ДатаКон = КонецДня(ДатаКон);
	
	Если НЕ пКонтрагент.Пустая() Тогда   
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	0 КАК DID,
		|	ПРЕДСТАВЛЕНИЕ(ВзаиморасчетыСКонтрагентамиОстаткиИОбороты.Регистратор.Номер) КАК DCODE, 
		|	ВзаиморасчетыСКонтрагентамиОстаткиИОбороты.Период КАК DDATE1,
		|	ПРЕДСТАВЛЕНИЕ(ВзаиморасчетыСКонтрагентамиОстаткиИОбороты.Контрагент) КАК KONTRAGENT,
		|	ПРЕДСТАВЛЕНИЕ(ТИПЗНАЧЕНИЯ(ВзаиморасчетыСКонтрагентамиОстаткиИОбороты.Регистратор)) КАК DOC_TYPE,
		|	""               "" КАК DOC_STATE,
		|	ВЫБОР
		|		КОГДА ВзаиморасчетыСКонтрагентамиОстаткиИОбороты.ДоговорКонтрагента.ОплатаПоДоговоруНаличными
		|			ТОГДА ""Нал""
		|		ИНАЧЕ ""Б/Н""
		|	КОНЕЦ КАК FORMA_OPLATY,
		|	ПРЕДСТАВЛЕНИЕ(ВзаиморасчетыСКонтрагентамиОстаткиИОбороты.ДоговорКонтрагента.ВалютаВзаиморасчетов) КАК VALUTA,
		|	ВзаиморасчетыСКонтрагентамиОстаткиИОбороты.СуммаВзаиморасчетовПриход + ВзаиморасчетыСКонтрагентамиОстаткиИОбороты.СуммаВзаиморасчетовРасход КАК SUMMA_DOC,
		|	0 КАК DOLG,
		|	"" "" КАК PRIVAZ,
		|	ПРЕДСТАВЛЕНИЕ(ВзаиморасчетыСКонтрагентамиОстаткиИОбороты.Контрагент) КАК FILIAL,
		|	0 КАК RASHOD_EURO,
		|	0 КАК PRIHOD_EURO,
		|	0 КАК SALDO_EURO,
		|	""               "" КАК SF,
		|	ВзаиморасчетыСКонтрагентамиОстаткиИОбороты.СуммаВзаиморасчетовРасход КАК PRIHOD_RUB,
		|	ВзаиморасчетыСКонтрагентамиОстаткиИОбороты.СуммаВзаиморасчетовПриход КАК RASHOD_RUB,
		|	-ВзаиморасчетыСКонтрагентамиОстаткиИОбороты.СуммаВзаиморасчетовКонечныйОстаток КАК SALDO_RUB,
		|	0 КАК RASHOD_RUB_NAL,
		|	0 КАК PRIHOD_RUB_NAL,
		|	0 КАК SALDO_RUB_NAL,
		|	0 КАК I,
		|	ДОБАВИТЬКДАТЕ(ВзаиморасчетыСКонтрагентамиОстаткиИОбороты.Регистратор.Дата, ДЕНЬ, ВзаиморасчетыСКонтрагентамиОстаткиИОбороты.ДоговорКонтрагента.ДопустимоеЧислоДнейЗадолженности - 1) КАК DDATE2,
		|	0 КАК IS_DEBIT,
		|	0 КАК IS_NAL,
		|	ВзаиморасчетыСКонтрагентамиОстаткиИОбороты.Регистратор,
		|	ВзаиморасчетыСКонтрагентамиОстаткиИОбороты.ДоговорКонтрагента.ДопустимоеЧислоДнейЗадолженности КАК ДопустимоеЧислоДнейЗадолженности,
		|	СчетФактураВыданный.Ссылка КАК СчетФактура,
		|	СчетФактураВыданный.Номер КАК СчетФактураНомер
		|ИЗ
		|	РегистрНакопления.ВзаиморасчетыСКонтрагентами.ОстаткиИОбороты(&ДатаНач, &ДатаКон, Регистратор, , Контрагент = &Контрагент) КАК ВзаиморасчетыСКонтрагентамиОстаткиИОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный КАК СчетФактураВыданный
		|		ПО ВзаиморасчетыСКонтрагентамиОстаткиИОбороты.Регистратор = СчетФактураВыданный.ДокументОснование
		|ГДЕ
		|	ВзаиморасчетыСКонтрагентамиОстаткиИОбороты.Контрагент = &Контрагент"; 
		
		Запрос.УстановитьПараметр("Контрагент", пКонтрагент);
		Запрос.УстановитьПараметр("ДатаНач", ДатаНач);
		Запрос.УстановитьПараметр("ДатаКон", ДатаКон); 
		
		ТЗ = Запрос.Выполнить().Выгрузить();
		ДополнитьТаблицу(ТЗ,пКонтрагент,ДатаНач,ДатаКон);
		
		Если ПараметрыОтбора.IS_SORT_BY_DOC_DATE = "1" Тогда
			ТЗ.Сортировать("DDATE1 Возр");
		Иначе
			ТЗ.Сортировать("DDATE2 Возр");
		КонецЕсли;                             
		
		Если Константы.СпособКонтроляДнейЗадолженности.Получить() = Перечисления.СпособыКонтроляДнейЗадолженности.ПоРабочимДням Тогда
			РД = Истина;
		Иначе
			РД = Ложь;
		КонецЕсли;      
		
		Для каждого строка из ТЗ Цикл    
			
			Если ЗначениеЗаполнено(Строка.DCODE) Тогда    
				
				СтрокаВозврата = ФабрикаXDTO.Создать(ТипСтрокаОтвета);
				ЗаполнитьЗначенияСвойств(СтрокаВозврата, Строка);  
				
				Если РД Тогда     
					
					// считаем по производственному календарю
					ДнейЗадолженности	=	?(строка.ДопустимоеЧислоДнейЗадолженности >= 1,строка.ДопустимоеЧислоДнейЗадолженности, 0);
					СтрокаВозврата.DDATE2 = ?(ДнейЗадолженности = 0, строка.DDATE1,  ЗаполнениеДокументов.ОпределитьДату(строка.DDATE1, ДнейЗадолженности));
					
				КонецЕсли;

				РезультатДляВозвратаПорталу.Row.Добавить(СтрокаВозврата);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат РезультатДляВозвратаПорталу;
	
КонецФункции

Функция PM_PAYMENTS_FOR_PORTAL(ПараметрыОтбора) Экспорт
	
	пКодКонтрагентаПортал = СтрЗаменить(СокрЛП(ПараметрыОтбора.ID), Символы.НПП, ""); 	
	
	ТипОтвет					= ФабрикаXDTO.Тип(Метаданные.WebСервисы.PM_PAYMENTS_FOR_PORTAL.ПространствоИмен, "RS_PM_PAYMENTS_FOR_PORTAL");
	РезультатДляВозвратаПорталу = ФабрикаXDTO.Создать(ТипОтвет);
	ТипСтрокаОтвета			    = ФабрикаXDTO.Тип(Метаданные.WebСервисы.PM_PAYMENTS_FOR_PORTAL.ПространствоИмен, "Out_PM_PAYMENTS_FOR_PORTAL");  
	
	ТаблВозврат = Новый ТаблицаЗначений;
	ТаблВозврат.Колонки.Добавить("DATE_OPLATY");
	ТаблВозврат.Колонки.Добавить("DATE_OPLATY_DATE",);
	ТаблВозврат.Колонки.Добавить("VALUTA");
	ТаблВозврат.Колонки.Добавить("SUMMA");
	ТаблВозврат.Колонки.Добавить("VALUTA_ID");
	
	Если СтрДлина(пКодКонтрагентаПортал) = 36 Тогда  
		пКонтрагент = Справочники.Контрагенты.НайтиПоРеквизиту("КодМДМ", пКодКонтрагентаПортал);	
	Иначе
		пКонтрагент = Справочники.Контрагенты.НайтиПоРеквизиту("IDАварда", пКодКонтрагентаПортал);	
	КонецЕсли;
	
	Если НЕ пКонтрагент.Пустая() Тогда
		
		ПоКалендарнымДням = Ложь;        
		
		Если Константы.СпособКонтроляДнейЗадолженности.Получить() = Перечисления.СпособыКонтроляДнейЗадолженности.ПоКалендарнымДням Тогда 
			ПоКалендарнымДням = Истина;
		КонецЕсли;		
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстатки.СуммаВзаиморасчетовОстаток КАК СуммаВзаиморасчетовОстаток,
		|	ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстатки.Контрагент,
		|	ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстатки.ДоговорКонтрагента,
		|	ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстатки.ДокументРасчетовСКонтрагентом.Дата КАК Дата,
		|	ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстатки.ДокументРасчетовСКонтрагентом.ВалютаДокумента КАК Валюта,
		|	ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстатки.ДоговорКонтрагента.ДопустимоеЧислоДнейЗадолженности КАК ДнейЗадолженности,
		|	ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстатки.ДокументРасчетовСКонтрагентом.ВалютаДокумента.Код КАК КодВалюты
		|ИЗ
		|	РегистрНакопления.ВзаиморасчетыСКонтрагентамиПоДокументамРасчетов.Остатки(, Контрагент = &Контрагент) КАК ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстатки";
		
		Запрос.УстановитьПараметр("Контрагент", пКонтрагент);
		ТЗ = Запрос.Выполнить().Выгрузить();
		
		Для каждого строка из ТЗ Цикл 	
			
			Если ПоКалендарнымДням Тогда 
				ДатаОплаты =   ЗаполнениеДокументов.ОпределитьДатуКалендарныхДней(строка.Дата, строка.ДнейЗадолженности);
				
			Иначе
				ДнейЗадолженности	=	?(строка.ДнейЗадолженности >= 1,строка.ДнейЗадолженности, 0);
				ДатаОплаты 			=	?(ДнейЗадолженности = 0, строка.Дата,  ЗаполнениеДокументов.ОпределитьДату(строка.Дата, ДнейЗадолженности));
				
			КонецЕсли;	
			
			Если НЕ ДатаОплаты =  Неопределено 
				И НЕ ДатаОплаты =  Null
				Тогда 
				
				СтрВозврат = ТаблВозврат.Добавить();      
				СтрВозврат.DATE_OPLATY 		= Строка(Формат(ДатаОплаты, "ДЛФ=Д"));
				СтрВозврат.DATE_OPLATY_DATE = НачалоДня(ДатаОплаты);
				СтрВозврат.VALUTA 			= Строка(Строка.Валюта);
				СтрВозврат.SUMMA 			= Строка.СуммаВзаиморасчетовОстаток;
				СтрВозврат.VALUTA_ID 		= Строка(Строка.КодВалюты);   
				
			КонецЕсли;  
			
		КонецЦикла;
		
		ТаблВозврат.Свернуть("DATE_OPLATY,DATE_OPLATY_DATE,VALUTA,VALUTA_ID", "SUMMA");
		ТаблВозврат.Сортировать("DATE_OPLATY_DATE");  
		
		Для каждого строка из ТаблВозврат Цикл     
			
			СтрокаВозврата = ФабрикаXDTO.Создать(ТипСтрокаОтвета);
			ЗаполнитьЗначенияСвойств(СтрокаВозврата, Строка);
			РезультатДляВозвратаПорталу.Row.Добавить(СтрокаВозврата);  
			
		КонецЦикла;    
		
	КонецЕсли;    
	
	Возврат РезультатДляВозвратаПорталу;
	
КонецФункции

Функция RA_MOVE_DOC_FOR_PORTAL(Параметры) Экспорт
	
	ТипОтвет					= ФабрикаXDTO.Тип(Метаданные.WebСервисы.PORTAL_MSK.ПространствоИмен, "RS_RA_MOVE_DOC_FOR_PORTAL");
	РезультатДляВозвратаПорталу = ФабрикаXDTO.Создать(ТипОтвет);
	
	пЗаказКлиента	  = СокрЛП(Параметры.IDDOC);
	ДокументЗаказКлиента = Документы.ЗаказПокупателя.ПолучитьСсылку(Новый УникальныйИдентификатор(пЗаказКлиента));
	
	Если ДокументЗаказКлиента.Пустая() Тогда	
		
		РезультатДляВозвратаПорталу.RESULT = 0;
		РезультатДляВозвратаПорталу.MSG = "Не найден заказ клиента с таким ID";	
		Возврат РезультатДляВозвратаПорталу;
		
	КонецЕсли;
	
	ОбъектЗаказа = ДокументЗаказКлиента.ПолучитьОбъект();
	ОбъектЗаказа.ТолькоРезерв = Ложь;
	
	Попытка		
		
		ОбъектЗаказа.Записать(РежимЗаписиДокумента.Запись, РежимПроведенияДокумента.Неоперативный);
		
		РезультатДляВозвратаПорталу.RN_ID = Строка(ДокументЗаказКлиента.УникальныйИдентификатор());
		РезультатДляВозвратаПорталу.RN_DCODE = ДокументЗаказКлиента.Номер;
		РезультатДляВозвратаПорталу.RESULT = 1;
		РезультатДляВозвратаПорталу.MSG = "Заказ успешно снят с резерва и готов к сборке";		
		
	Исключение 		
		
		РезультатДляВозвратаПорталу.RESULT = 0;
		РезультатДляВозвратаПорталу.MSG = "Возникла ошибка при записи заказа" + Символы.ПС + ОписаниеОшибки();		
		
	КонецПопытки;  	
	
	Возврат РезультатДляВозвратаПорталу;
	
КонецФункции

Функция AZ_A_DOC_6951_DEL_PORTAL(Параметры) Экспорт
	
	ТипОтвет					= ФабрикаXDTO.Тип(Метаданные.WebСервисы.PORTAL_MSK.ПространствоИмен, "RS_AZ_A_DOC_6951_DEL_PORTAL");
	РезультатДляВозвратаПорталу = ФабрикаXDTO.Создать(ТипОтвет);
	
	пЗаказКлиента	  = СокрЛП(Параметры.DID);
	ДокументЗаказКлиента = Документы.ЗаказПокупателя.ПолучитьСсылку(Новый УникальныйИдентификатор(пЗаказКлиента));
	
	Если ДокументЗаказКлиента.Пустая() Тогда	
		
		РезультатДляВозвратаПорталу.RESULT = 0;
		РезультатДляВозвратаПорталу.MSG = "Не найден заказ клиента с таким ID";	
		Возврат РезультатДляВозвратаПорталу;
		
	КонецЕсли;   	
	
	Если МСКWEB.ЕстьСборка(ДокументЗаказКлиента) Тогда
		
		РезультатДляВозвратаПорталу.RESULT = 0;
		РезультатДляВозвратаПорталу.MSG = "Заказ уже отправлен на сборку";	
		Возврат РезультатДляВозвратаПорталу;	
		
	КонецЕсли;
	
	Если МСКWEB.ЕстьЗаказПоставщику(ДокументЗаказКлиента) Тогда
		
		РезультатДляВозвратаПорталу.RESULT = 0;
		РезультатДляВозвратаПорталу.MSG = "По заказу уже сформирован заказ поставщику";	
		Возврат РезультатДляВозвратаПорталу;	
		
	КонецЕсли;         		
	
	Попытка	  		
		
		ДокументЗакрытия = Документы.ЗакрытиеЗаказовПокупателей.СоздатьДокумент();
		ДокументЗакрытия.Заполнить(ДокументЗаказКлиента);
		ДокументЗакрытия.Дата = ТекущаяДата();
		ДокументЗакрытия.ВидОперации = Перечисления.ВидыОперацийЗакрытиеЗаказовПокупателей.ЗакрытиеЗаказов;
		ДокументЗакрытия.Комментарий = "Документ сформирован через интернет-портал";
		ДокументЗакрытия.Записать(РежимЗаписиДокумента.Проведение);
		
		Если МСКWEB.ЕстьСборка(ДокументЗаказКлиента) Тогда
			
			ДокументЗакрытия.УстановитьПометкуУдаления(Истина);
			РезультатДляВозвратаПорталу.RESULT = 0;
			РезультатДляВозвратаПорталу.MSG = "Заказ уже отправлен на сборку";
			
		Иначе
			
			РезультатДляВозвратаПорталу.RESULT = 1;
			РезультатДляВозвратаПорталу.MSG = "Заказ успешно отменен!";	 
			
		КонецЕсли;

	Исключение 		
		
		РезультатДляВозвратаПорталу.RESULT = 0;
		РезультатДляВозвратаПорталу.MSG = "Возникла ошибка при записи документа снятия резервов" + Символы.ПС + ОписаниеОшибки();		
		
	КонецПопытки;  	
	
	Возврат РезультатДляВозвратаПорталу;

КонецФункции

Функция RA_INS_UPDATE_STROKA_IZ_PORTALA(Параметры) Экспорт
		
	ТипОтвет					= ФабрикаXDTO.Тип(Метаданные.WebСервисы.PORTAL_MSK.ПространствоИмен, "RS_RA_INS_UPDATE_STROKA_IZ_PORTALA");
	РезультатДляВозвратаПорталу = ФабрикаXDTO.Создать(ТипОтвет);
	
	пЗаказКлиента	  = СокрЛП(Параметры.IDDOC);
	ДокументЗаказКлиента = Документы.ЗаказПокупателя.ПолучитьСсылку(Новый УникальныйИдентификатор(пЗаказКлиента));
	
	Если ДокументЗаказКлиента.Пустая() Тогда	
		
		РезультатДляВозвратаПорталу.RESULT = 0;
		РезультатДляВозвратаПорталу.MSG = "Не найден заказ клиента с таким ID";	
		Возврат РезультатДляВозвратаПорталу;
		
	КонецЕсли; 
	
	Если МСКWEB.ЕстьСборка(ДокументЗаказКлиента) Тогда
		
		РезультатДляВозвратаПорталу.RESULT = 0;
		РезультатДляВозвратаПорталу.MSG = "Заказ уже отправлен на сборку";
		Возврат РезультатДляВозвратаПорталу;	
		
	КонецЕсли;
	
	Если МСКWEB.ЕстьЗаказПоставщику(ДокументЗаказКлиента) Тогда
		
		РезультатДляВозвратаПорталу.RESULT = 0;
		РезультатДляВозвратаПорталу.MSG = "По заказу уже оформлен заказ поставщику";	
		Возврат РезультатДляВозвратаПорталу;	
		
	КонецЕсли;
	
	пТовар = СокрЛП(Параметры.IDTOVAR); 
	пКоличествоКорректировки = Число(Параметры.KOL);
	
	Попытка
		пНомерСтроки = Число(Параметры.IDLIN);
	Исключение
		пНомерСтроки = Неопределено;
	КонецПопытки;
	
	ИсходноеКоличествоВЗаказе = 0;	
	
	СтруктураОтбора = Новый Структура;
	
	Если ЗначениеЗаполнено(пНомерСтроки) Тогда
		СтруктураОтбора.Вставить("КлючСтроки", пНомерСтроки);
	Иначе
		
		РезультатДляВозвратаПорталу.RESULT = 0;
		РезультатДляВозвратаПорталу.MSG = "Не заполнен ID строки";	
		Возврат РезультатДляВозвратаПорталу;
		
	КонецЕсли;
	
	СтрокиПоиска = ДокументЗаказКлиента.Товары.НайтиСтроки(СтруктураОтбора);
	
	ДобавляемНовыйТоварЧерезКорректировку = Ложь;
	
	Если СтрокиПоиска.Количество() = 0 Тогда
		
		ДобавляемНовыйТоварЧерезКорректировку = Истина;	
		
		ТоварКорректировки = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(пТовар));
		
		Если ТоварКорректировки.Пустая() Тогда	
			
			РезультатДляВозвратаПорталу.RESULT = 0;
			РезультатДляВозвратаПорталу.MSG = "Не найден товар с таким ID";	
			Возврат РезультатДляВозвратаПорталу;
			
		КонецЕсли;  
		
	ИначеЕсли СтрокиПоиска.Количество() > 1 Тогда
		
		РезультатДляВозвратаПорталу.RESULT = 0;
		РезультатДляВозвратаПорталу.MSG = "В заказе несколько строк с товарами, которые имеют одинаковый ID. Не удается идентифицировать строку корректировки";	
		Возврат РезультатДляВозвратаПорталу;		
		
	Иначе
		
		ИсходноеКоличествоВЗаказе = СтрокиПоиска[0].Количество;
		ТоварКорректировки = СтрокиПоиска[0].Номенклатура;
		
	КонецЕсли;  
	
	Попытка	 
		
		ДокументКорректировки = Документы.КорректировкаЗаказаПокупателя.СоздатьДокумент();
		ДокументКорректировки.Заполнить(ДокументЗаказКлиента);
		ДокументКорректировки.Дата = ТекущаяДата();
		ДокументКорректировки.Комментарий = "Документ сформирован через интернет-портал" + ?(ЗначениеЗаполнено(СокрЛП(Параметры.PRIMECH)), ": " + СокрЛП(Параметры.PRIMECH), "");
		
		СтрокиДляУдаления = Новый СписокЗначений;
		НужнаяСтрокаИзменена = Ложь;
		
		Если Не ДобавляемНовыйТоварЧерезКорректировку Тогда
			
			Для каждого Стр ИЗ ДокументКорректировки.Товары Цикл		
				
				Если Не НужнаяСтрокаИзменена Тогда
					
					Если Стр.Номенклатура <> ТоварКорректировки Тогда
						СтрокиДляУдаления.Добавить(Стр);
					Иначе
						
						Стр.Количество = пКоличествоКорректировки - ИсходноеКоличествоВЗаказе;
						НужнаяСтрокаИзменена = Истина;
						
						ОбработкаТабличныхЧастей.РассчитатьКоличествоМестТабЧасти(Стр, ДокументКорректировки);
						ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(Стр, ДокументКорректировки);
						ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(Стр, ДокументКорректировки);
						
					КонецЕсли;  				
					
				Иначе
					СтрокиДляУдаления.Добавить(Стр);	
				КонецЕсли; 
				
			КонецЦикла;
			
		Иначе
			
			ДокументКорректировки.Товары.Очистить();
			
			НоваяСтрока = ДокументКорректировки.Товары.Добавить();
			НоваяСтрока.Номенклатура = ТоварКорректировки;
			НоваяСтрока.Количество = пКоличествоКорректировки;
			НоваяСтрока.Причина = Перечисления.ПричиныКорректировкиСборки.ОтказКлиента;
			
			мВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
			
			ОбработкаТабличныхЧастей.ПриИзмененииНоменклатурыТабЧасти(НоваяСтрока, ДокументКорректировки);
			
			ОбработкаТабличныхЧастей.ЗаполнитьСтавкуНДСТабЧасти(НоваяСтрока, ДокументКорректировки, "Реализация");
			ОбработкаТабличныхЧастей.ЗаполнитьЕдиницуЦенуПродажиТабЧасти(НоваяСтрока, ДокументКорректировки, мВалютаРегламентированногоУчета, 
			ДокументКорректировки.ЗаказПокупателя.ВалютаДокумента);
			
			ОбработкаТабличныхЧастей.РассчитатьКоличествоМестТабЧасти(НоваяСтрока, ДокументКорректировки);
			ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(НоваяСтрока, ДокументКорректировки);
			ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НоваяСтрока, ДокументКорректировки);
			
			ОбработкаТабличныхЧастей.РассчитатьПлановуюСебестоимостьВСтрокеТабЧасти(НоваяСтрока, ДокументКорректировки, мВалютаРегламентированногоУчета);
			
		КонецЕсли;
		
		Для каждого СтрУ Из СтрокиДляУдаления Цикл  		
			ДокументКорректировки.Товары.Удалить(СтрУ.Значение); 			
		КонецЦикла;
		
		ДокументКорректировки.Услуги.Очистить();
		ДокументКорректировки.ВозвратнаяТара.Очистить();
		
		ДокументКорректировки.Записать(РежимЗаписиДокумента.Проведение);
		
		РезультатДляВозвратаПорталу.RESULT = 1;
		РезультатДляВозвратаПорталу.MSG = "Заказ клиента успешно изменен";		
		
	Исключение 		
		
		РезультатДляВозвратаПорталу.RESULT = 0;
		РезультатДляВозвратаПорталу.MSG = "Возникла ошибка при записи документа корректировки заказа" + Символы.ПС + ОписаниеОшибки();		
		
	КонецПопытки;  	

	Возврат РезультатДляВозвратаПорталу;
	
КонецФункции

Функция PM_GET_CHANGES_FOR_ORDER(Header,Lines) Экспорт 
	
	ТипОтвет					= ФабрикаXDTO.Тип(Метаданные.WebСервисы.PORTAL_MSK.ПространствоИмен, "RS_PM_GET_CHANGES_FOR_ORDER");
	РезультатДляВозвратаПорталу = ФабрикаXDTO.Создать(ТипОтвет);
	
	пЗаказКлиента	  = СокрЛП(Header.OrderID);
	ДокументЗаказКлиента = Документы.ЗаказПокупателя.ПолучитьСсылку(Новый УникальныйИдентификатор(пЗаказКлиента));
	
	Если ДокументЗаказКлиента.Пустая() Тогда	
		
		РезультатДляВозвратаПорталу.RESULT = 0;
		РезультатДляВозвратаПорталу.MSG = "Не найден заказ клиента с таким ID";	
		Возврат РезультатДляВозвратаПорталу;
		
	КонецЕсли;
	
	БылиОшибки = Ложь;
	
	СтрокиЗаказа = Lines.Row;
	
	// 1.Снятие резерва
	ЗаказКлиентаОбъект = ДокументЗаказКлиента.ПолучитьОбъект();
	БылиИзменения = Ложь;

	Если НЕ ЗаказКлиентаОбъект.СкладскойЗаказ Тогда

		Для Каждого СтрокаЗаказа ИЗ СтрокиЗаказа Цикл
			
			Попытка 
				пНомерСтроки = Число(СтрокаЗаказа.IDLIN);
			Исключение 
				пНомерСтроки = Неопределено; 
			КонецПопытки;                 
			
			Попытка 
				пСнятьРезерв = Число(СтрокаЗаказа.UNRESERVE);
			Исключение 
				пСнятьРезерв = Неопределено; 
			КонецПопытки;                           
			
			Если НЕ пНомерСтроки = Неопределено И пСнятьРезерв = 1 Тогда
				
				ЕстьСтрокаВДокументе = ЗаказКлиентаОбъект.Товары.Найти(пНомерСтроки, "КлючСтроки");
				
				Если НЕ ЕстьСтрокаВДокументе = Неопределено Тогда
					
					ЕстьСтрокаВДокументе.ТолькоРезерв = Ложь;
					БылиИзменения = Истина;
					
				КонецЕсли;			
				
			КонецЕсли;	
		КонецЦикла;
		
		Если БылиИзменения Тогда 
			
			Попытка
				
				ЕстьТолькоРезервВСтроках = Ложь;
				
				Для Каждого СтрокиТоваров Из ЗаказКлиентаОбъект.Товары Цикл     
					
					Если СтрокиТоваров.ТолькоРезерв Тогда 
						ЕстьТолькоРезервВСтроках = Истина;
						Прервать;
					КонецЕсли; 
					
				КонецЦикла;  
				
				ЗаказКлиентаОбъект.ТолькоРезерв = ЕстьТолькоРезервВСтроках;
				ЗаказКлиентаОбъект.Записать(РежимЗаписиДокумента.Проведение); 
				
			Исключение 
				
				БылиОшибки  = Истина;
				ТекстОшибки = ОписаниеОшибки()
				
			КонецПопытки;
			
		КонецЕсли;

	КонецЕсли;  
	
	//2.Корректировка количества       	
	ТестОшибкиКратности = "";
	ТаблицаТовараДляКратности = Новый ТаблицаЗначений;
	ТаблицаТовараДляКратности.Колонки.Добавить("IDTOVAR");	
	ТаблицаТовараДляКратности.Колонки.Добавить("Номенклатура");
	ТаблицаТовараДляКратности.Колонки.Добавить("Количество");
	ТаблицаТовараДляКратности.Колонки.Добавить("ЕстьНарушение");
	ТаблицаТовараДляКратности.Колонки.Добавить("КлючСтроки");	
	
	Для Каждого СтрокаЗаказа Из СтрокиЗаказа Цикл
		
		Попытка 
			пНомерСтроки = Число(СтрокаЗаказа.IDLIN);
		Исключение 
			пНомерСтроки = Неопределено; 
		КонецПопытки;
		
		ПромТоварЗаказа = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(СокрЛП(СтрокаЗаказа.IDTOVAR)));
		
		Если НЕ ПромТоварЗаказа.Получитьобъект() = Неопределено Тогда
			
			Если НЕ Константы.ИспользоватьКорректировкуГрузомест.Получить() Тогда				
				
				Если НЕ МСКWEB.ПроверитьСтатусСборки(ДокументЗаказКлиента, ПромТоварЗаказа) Тогда
					
					БылиОшибки = Истина;
					ТекстОшибки = ?(ТекстОшибки = "", "", "   ") + "Товар из строки № " + СокрЛП(СтрокаЗаказа.IDLIN) + " уже собран";
					Продолжить;
					
				КонецЕсли;
				
			Иначе
				
				Если ДокументЗаказКлиента.СпособДоставки = Перечисления.СпособДоставки.НашаДоставка Тогда
					
					Если НЕ МСКWEB.ПроверитьСтатусОтгрузки(ДокументЗаказКлиента, ПромТоварЗаказа) Тогда
						
						БылиОшибки = Истина;
						ТекстОшибки = ?(ТекстОшибки = "", "", "   ") + "Товар из строки № " + СокрЛП(СтрокаЗаказа.IDLIN) + " уже погружен в машину";
						Продолжить;
						
					КонецЕсли; 				
					
				Иначе
					
					Если НЕ МСКWEB.ПроверитьСтатусСборки(ДокументЗаказКлиента, ПромТоварЗаказа) Тогда
						
						БылиОшибки = Истина;
						ТекстОшибки = ?(ТекстОшибки = "", "", "   ") + "Товар из строки № " + СокрЛП(СтрокаЗаказа.IDLIN) + " уже собран";
						Продолжить;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
			Если НЕ пНомерСтроки = Неопределено Тогда
				
				ЕстьСтрокаВДокументе = ЗаказКлиентаОбъект.Товары.Найти(пНомерСтроки, "КлючСтроки");
				
				Если НЕ ЕстьСтрокаВДокументе = Неопределено Тогда
					
					ТеОстатокПоСтроке = ПолучитьОстатокПоСтроке(ЗаказКлиентаОбъект.Ссылка,пНомерСтроки);
					ПромКол  =  ТеОстатокПоСтроке - СтрокаЗаказа.KOL;
					
				КонецЕсли;			
				
			КонецЕсли;
			
			Если ПромКол > 0 Тогда 
				
				НоваяСтрокаКратности = ТаблицаТовараДляКратности.Добавить();
				НоваяСтрокаКратности.IDTOVAR      = СтрокаЗаказа.IDTOVAR;
				НоваяСтрокаКратности.Номенклатура = ПромТоварЗаказа.Ссылка;
				НоваяСтрокаКратности.Количество   = ПромКол;
				НоваяСтрокаКратности.ЕстьНарушение = Ложь;  
				НоваяСтрокаКратности.КлючСтроки = пНомерСтроки;   
				
			КонецЕсли;
			
		Иначе
			
			БылиОшибки = Истина;
			ТекстОшибки = ?(ТекстОшибки = "", "", "   ") + "Не найден товар из строки № " + СокрЛП(СтрокаЗаказа.IDLIN);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ ТаблицаТовараДляКратности.Количество() = 0 Тогда
		
		ТаблицаТовараДляКратности.Свернуть("IDTOVAR, Номенклатура, ЕстьНарушение, КлючСтроки", "Количество");
		
		Для Каждого СтрокаТаблКратности Из ТаблицаТовараДляКратности Цикл

			Если НЕ МСК.ПроверкаНоменклатурыНаКратность(СтрокаТаблКратности.Номенклатура, СтрокаТаблКратности.Количество) Тогда
				СтрокаТаблКратности.ЕстьНарушение = Истина;
			КонецЕсли;	
			
		КонецЦикла;
		
		Для Каждого СтрокаЗаказа ИЗ СтрокиЗаказа Цикл
			
			Попытка 
				пНомерСтроки = Число(СтрокаЗаказа.IDLIN);
			Исключение 
				пНомерСтроки = Неопределено; 
			КонецПопытки;
			
			Если НЕ пНомерСтроки = Неопределено Тогда
				
				ЕстьСтрокаВДокументе = ЗаказКлиентаОбъект.Товары.Найти(пНомерСтроки, "КлючСтроки");   
				СтрокаВТаблПроверки  = ТаблицаТовараДляКратности.Найти(пНомерСтроки, "КлючСтроки");
				
				Если СтрокаВТаблпроверки.ЕстьНарушение Тогда
					
					БылиОшибки = Истина;
					ТестОшибкиКратности = ?(ТестОшибкиКратности = "", "", Символы.ПС) + "Нарушена кратность у товара  " + СокрЛП(СтрокаВТаблпроверки.Номенклатура.Наименование);				
					
				Иначе								
					
					Если НЕ ЕстьСтрокаВДокументе = Неопределено Тогда
						
						РегЗапросИзменений = РегистрыСведений.ЗапросыИзмененияКоличестваВЗаказах.СоздатьМенеджерЗаписи();
						РегЗапросИзменений.ЗаказПокупателя = ДокументЗаказКлиента;
						РегЗапросИзменений.Номенклатура    = СтрокаВТаблпроверки.Номенклатура;
						РегЗапросИзменений.КлючСтроки      = Число(СтрокаЗаказа.IDLIN);
						РегЗапросИзменений.Количество      = СтрокаВТаблпроверки.Количество;
						РегЗапросИзменений.ДатаЗапроса     = ТекущаяДата();
						РегЗапросИзменений.Записать(Истина);	
						
					Иначе
						
						БылиОшибки = Истина;
						ТекстОшибки = ?(ТекстОшибки = "", "", "   ") + "Не найден товар из строки № " + СокрЛП(СтрокаЗаказа.IDLIN);					
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;	
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если БылиОшибки Тогда	
		
		РезультатДляВозвратаПорталу.RESULT = 0;
		РезультатДляВозвратаПорталу.MSG = "" + ТекстОшибки + " " + ТестОшибкиКратности;		
		
	Иначе
		
		РезультатДляВозвратаПорталу.RESULT = 1;
		РезультатДляВозвратаПорталу.MSG = "Заказ клиента успешно изменен";
		
	КонецЕсли;	  	
	
	Возврат РезультатДляВозвратаПорталу;

КонецФункции


/////////////////Вспомогательные процедуры методов веб сервисов//////////////////
Функция ПолучитьСтруктуруСтатусовПортала()
	
	СтруктураСтатусов = Новый Соответствие;	
	СтруктураСтатусов.Вставить(10, "10; зарезервирован");
	СтруктураСтатусов.Вставить(20, "20; ожидание оплаты");
	СтруктураСтатусов.Вставить(30, "30; на подборе");
	СтруктураСтатусов.Вставить(40, "40; готов к отгрузке");
	СтруктураСтатусов.Вставить(50, "50; на доставке");
	СтруктураСтатусов.Вставить(60, "60; выполнен");
	СтруктураСтатусов.Вставить(70, "70; не определен");
	СтруктураСтатусов.Вставить(80, "80; не определен");
	СтруктураСтатусов.Вставить(90, "90; не определен");
	СтруктураСтатусов.Вставить(100, "100; отказ клиента");
	СтруктураСтатусов.Вставить(110, "110; недостача при сборке");
	
	Возврат СтруктураСтатусов;

КонецФункции	

Функция СформироватьОтветДляПортала(ПараметрыОтбора) Экспорт
	
	пДатаНачалаОтчета	  = Дата(ПараметрыОтбора.BEGIN_DATE_);
	пДатаКонцаОтчета	  = Дата(ПараметрыОтбора.END_DATE_);
	пКодКонтрагентаПортал = СтрЗаменить(СокрЛП(ПараметрыОтбора.KONTRAGENT_), Символы.НПП, "");
	пСтатусСостояния	  = ПараметрыОтбора.DSTATE_;
	
	ТипОтвет					= ФабрикаXDTO.Тип(Метаданные.WebСервисы.PORTAL.ПространствоИмен, "RS");
	РезультатДляВозвратаПорталу = ФабрикаXDTO.Создать(ТипОтвет);
	ТипСтрокаОтвета			    = ФабрикаXDTO.Тип(Метаданные.WebСервисы.PORTAL.ПространствоИмен, "OutgoingSettings");  
	
	Если СтрДлина(пКодКонтрагентаПортал) = 36 Тогда  
		пКонтрагент = Справочники.Контрагенты.НайтиПоРеквизиту("КодМДМ",пКодКонтрагентаПортал);	
	Иначе
		пКонтрагент = Справочники.Контрагенты.НайтиПоРеквизиту("IDАварда",пКодКонтрагентаПортал);	
	КонецЕсли;
	
	Если НЕ пКонтрагент.Пустая() Тогда
		
		ЗапросСтрокПоСтатусам = Новый Запрос;
		ЗапросСтрокПоСтатусам.УстановитьПараметр("ДатаНач", ?(ЗначениеЗаполнено(пДатаНачалаОтчета), НачалоДня(пДатаНачалаОтчета), НачалоНедели(ТекущаяДата())));
		ЗапросСтрокПоСтатусам.УстановитьПараметр("ДатаКон", ?(ЗначениеЗаполнено(пДатаКонцаОтчета), КонецДня(пДатаКонцаОтчета), КонецДня(ТекущаяДата())));
		ЗапросСтрокПоСтатусам.УстановитьПараметр("Клиент", пКонтрагент);

		ЗапросСтрокПоСтатусам.Текст =
		"ВЫБРАТЬ
		|	ПродажиОбороты.Номенклатура.Код КАК ID_TOVAR,
		|	ПродажиОбороты.Номенклатура.Родитель.Наименование КАК BREND,
		|	ПродажиОбороты.Номенклатура.Артикул КАК ARTICUL,
		|	ПродажиОбороты.Номенклатура.БазоваяЕдиницаИзмерения.Наименование КАК ED_IZM_6951,
		|	1 КАК KOEF_6951,
		|	0 КАК KOL_VO_6951,
		|	0 КАК RESRV_6951,
		|	0 КАК OTGRUJENO_6951,
		|	ПродажиОбороты.Номенклатура.Наименование КАК TOVAR_NAME,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ПродажиОбороты.КоличествоОборот, 0) = 0
		|			ТОГДА ПродажиОбороты.СтоимостьОборот
		|		ИНАЧЕ ПродажиОбороты.СтоимостьОборот / ПродажиОбороты.КоличествоОборот
		|	КОНЕЦ КАК PRICE_6951,
		|	ЕСТЬNULL(ПродажиОбороты.СтоимостьБезСкидокОборот, 0) КАК SUMMA_6951,
		|	ПродажиОбороты.ЗаказПокупателя.Номер КАК DID_6951,
		|	ПродажиОбороты.ДокументПродажи.Номер КАК DID_6501,
		|	ПродажиОбороты.Номенклатура.ЕдиницаХраненияОстатков.Наименование КАК ED_IZM_6501,
		|	ПродажиОбороты.КоличествоОборот КАК KOL_VO_6501,
		|	1 КАК KOEF_6501,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ПродажиОбороты.КоличествоОборот, 0) = 0
		|			ТОГДА ПродажиОбороты.СтоимостьОборот
		|		ИНАЧЕ ПродажиОбороты.СтоимостьОборот / ПродажиОбороты.КоличествоОборот
		|	КОНЕЦ КАК PRICE_6501,
		|	ПродажиОбороты.СтоимостьОборот КАК SUMMA_6501,
		|	0 КАК NEDOS,
		|	0 КАК VOZVRAT
		|ИЗ
		|	РегистрНакопления.Продажи.Обороты(&ДатаНач, &ДатаКон, , ) КАК ПродажиОбороты";   
		
		РезультатЗапросаСтрок = ЗапросСтрокПоСтатусам.Выполнить();   
		
		Если Не РезультатЗапросаСтрок.Пустой() Тогда         
			
			ВыборкаРезультата = РезультатЗапросаСтрок.Выбрать(); 
			
			Пока ВыборкаРезультата.Следующий()Цикл              
				
				СтрокаВозврата = ФабрикаXDTO.Создать(ТипСтрокаОтвета);
				ЗаполнитьЗначенияСвойств(СтрокаВозврата, ВыборкаРезультата);
				РезультатДляВозвратаПорталу.Row.Добавить(СтрокаВозврата);    
				
			КонецЦикла;	      
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат РезультатДляВозвратаПорталу;  
	
КонецФункции

Функция СформироватьСообщениеДляПортала(ИмяПоля, Количество, СтатусAvarda, КодСообщения, ДобавитьТочкуСЗапятой = Ложь, СтатусПоДопПостащику = "ЦС в Москве") Экспорт
	
	Результат = "";
	
	Если ИмяПоля = "ЗаказаноПоставщику" И Количество > 0 Тогда
		
		Если НЕ ЗначениеЗаполнено(СтатусAvarda)  Тогда
			Результат = "10;заказано поставщику"			
		Иначе

			Если СтатусAvarda = "10; составлен" Тогда                   
				Результат = Строка(КодСообщения) + ";размещен на складе " + СокрЛП(СтатусПоДопПостащику);//  ЦС в Москве";
			КонецЕсли; 
			
			Если СтатусAvarda = "10; зарезервирован" Тогда                    
				Результат = Строка(КодСообщения) + ";зарезервирован на складе " + СокрЛП(СтатусПоДопПостащику);// ЦС в Москве";
			КонецЕсли; 
			
			Если СтатусAvarda = "30; на подборе" Тогда                     
				Результат = Строка(КодСообщения) + ";подбирается на складе " + СокрЛП(СтатусПоДопПостащику);// ЦС В Москве";
			КонецЕсли; 
			
			Если СтатусAvarda = "40; подобрано" Тогда                     
				Результат = Строка(КодСообщения) + ";подобрано на складе " + СокрЛП(СтатусПоДопПостащику);// ЦС в Москве";
			КонецЕсли; 
			
			Если СтатусAvarda = "40; готов к отгрузке" Тогда                    
				Результат = Строка(КодСообщения) + ";готов к отгрузке со склада " + СокрЛП(СтатусПоДопПостащику);// ЦС в Москве";
			КонецЕсли; 
			
			Если СтатусAvarda = "50; на доставке" Тогда
				Результат = Строка(КодСообщения) + ";отгружено со склада " + СокрЛП(СтатусПоДопПостащику);// ЦС в Москве";
			КонецЕсли; 
			
			Если СтатусAvarda = "300; принят в работу" Тогда
				Результат = Строка(КодСообщения) + ";размещен у поставщика";
			КонецЕсли; 
			
			Если СтатусAvarda = "310; размещен у поставщика" Тогда
				Результат = Строка(КодСообщения) + ";размещен у поставщика";
			КонецЕсли; 
			
			Если СтатусAvarda = "320; подтвежден поставщиком" Тогда
				Результат = Строка(КодСообщения) + ";подтвержден поставщиком";
			КонецЕсли; 
			
			Если СтатусAvarda = "320; в пути на склад" Тогда
				Результат = Строка(КодСообщения) + ";в пути на склад ЦС в Москве";
			КонецЕсли; 
			
			Если СтатусAvarda = "330; поступило на склад" Тогда
				Результат = Строка(КодСообщения) + ";поступило на склад ЦС  в Москве";
			КонецЕсли; 
			
			Если Результат = "" Тогда
				Результат = "10;заказано поставщику";				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	Если ДобавитьТочкуСЗапятой Тогда
		Результат = Результат + ";";
	КонецЕсли; 
	
	Возврат Результат ;
	
КонецФункции

Функция ЗаполнитьСтрокуВозврата(ТипСтрокаОтвета, ВыборкаРезультата, Значение_KOL_VO, Значение_STATUS, ДобавитьФлаг = Ложь, ТолькоРезерв = Ложь)
	
	СтрокаВозврата = ФабрикаXDTO.Создать(ТипСтрокаОтвета);
	ЗаполнитьЗначенияСвойств(СтрокаВозврата, ВыборкаРезультата);
	СтрокаВозврата.INV_NUM = СокрЛП(ВыборкаРезультата.Номенклатура.УникальныйИдентификатор());
	СтрокаВозврата.DDATE1 = ?(ЗначениеЗаполнено(ВыборкаРезультата.ДатаДок), Формат(ВыборкаРезультата.ДатаДок, "ДФ=dd.MM.yyyy"), "");
	
	СтрокаВозврата.DID = ?(ЗначениеЗаполнено(ВыборкаРезультата.СсылкаНаСф), СокрЛП(ВыборкаРезультата.СсылкаНаСф.УникальныйИдентификатор()), "");				
	
	НомерНаПечатьСтрокой = "";    
	
	Если ЗначениеЗаполнено(ВыборкаРезультата.СсылкаНаСф) И (НЕ Найти(Значение_STATUS, "60;") = 0) Тогда 
		
		Если Константы.База.Получить() = Перечисления.НазваниеБазы.Казань ИЛИ Константы.База.Получить() = Перечисления.НазваниеБазы.Воронеж Тогда 
			УдалятьВедущиеНули = Истина;
		Иначе
			
			Если ВыборкаРезультата.СсылкаНаСф.Дата > Дата(2016, 01, 01) Тогда
				УдалятьВедущиеНули = Истина;
			Иначе
				УдалятьВедущиеНули = Ложь;
			КонецЕсли;	
			
		КонецЕсли;	
		
		НомерНаПечатьСтрокой = ОбщегоНазначения.ПолучитьНомерНаПечать(ВыборкаРезультата.СсылкаНаСф,,, УдалятьВедущиеНули); 
		
	КонецЕсли;           
	
	СтрокаВозврата.DCODE = НомерНаПечатьСтрокой;				
	
	Если (ТолькоРезерв ИЛИ НЕ ВыборкаРезультата.ЗаказаноПоставщику = 0  
		ИЛИ НЕ ВыборкаРезультата.Заказано = 0 
		ИЛИ НЕ ВыборкаРезультата.Собирается = 0 
		ИЛИ НЕ ВыборкаРезультата.Собрано = 0 
		ИЛИ НЕ ВыборкаРезультата.Зарезервированно = 0) Тогда
		СтрокаВозврата.PLAN_DATE = ?(ЗначениеЗаполнено(ВыборкаРезультата.PLAN_DATE), Формат(ВыборкаРезультата.PLAN_DATE, "ДФ=dd.MM.yyyy"), "");
	Иначе
		СтрокаВозврата.PLAN_DATE = "";
	КонецЕсли;	                       
	
	Если ЕстьЗапросНаКорректировку(ВыборкаРезультата.Ссылка, ВыборкаРезультата.IDLIN) Тогда  
		
		МожноКорректировать = Ложь;
		СтрокаВозврата.STATUS = Значение_STATUS + "(запрос на изменение количества)";  
		
	Иначе                          
		
		МожноКорректировать = Истина;

		Если Значение_STATUS = "50;на доставке"
			ИЛИ НЕ Найти(Значение_STATUS, "60;") = 0  
			ИЛИ Значение_STATUS = "100;отказ покупателя"
			ИЛИ Значение_STATUS = "110;отказ поставщика"
			ИЛИ Значение_STATUS = "110;нет на складе"
			ИЛИ Значение_STATUS = "110;истек срок резервирования"
			Тогда
			МожноКорректировать = Ложь;
		ИначеЕсли Значение_STATUS = "30;на подборе" Тогда
			МожноКорректировать = МСКWEB.ПроверитьСтатусСборки(ВыборкаРезультата.Ссылка, ВыборкаРезультата.Номенклатура);  
		ИначеЕсли Значение_STATUS = "40;готов к отгрузке" Тогда
			МожноКорректировать = МСКWEB.ПроверитьСтатусОтгрузки(ВыборкаРезультата.Ссылка, ВыборкаРезультата.Номенклатура); 
		КонецЕсли;              
		
		СтрокаВозврата.STATUS = Значение_STATUS;  
		
	КонецЕсли;	                                
	
	Если МожноКорректировать Тогда 
		МожноКорректировать = НЕ Константы.ЯчейкаДляПеремещенияОтказовКлиентов.Получить().Пустая(); 
	КонецЕсли;            
	
	Если МожноКорректировать Тогда 
		МожноКорректировать = ВыборкаРезультата.Ссылка.IDСклада_СтороннийСклад.Пустая(); 
	КонецЕсли;                                  
	
	Если МожноКорректировать И ТолькоРезерв Тогда 
		МожноКорректировать = Ложь; 
	КонецЕсли;                               
	
	СтрокаВозврата.KOL_VO = Значение_KOL_VO;
	СтрокаВозврата.SUMMA = Значение_KOL_VO*ВыборкаРезультата.PRICE;	  
	СтрокаВозврата.TOVAR_PRIMECH = СокрЛП(ВыборкаРезультата.Комментарий);
	
	Если ДобавитьФлаг Тогда        
		
		ДействияВДесятичномВиде = ?(ТолькоРезерв, "1", "0") + "0"+ ?(МожноКорректировать, "1", "0") + "0";
		СтрокаВозврата.FLAG_1 = ДвоичноеВДесятичное(ДействияВДесятичномВиде);
		
	КонецЕсли;

	Возврат СтрокаВозврата;
	
КонецФункции // ЗаполнитьСтрокуВозврата()

Функция ЕстьЗапросНаКорректировку(Заказ, Строка)  
	
	ЗапросКорректировки = Новый Запрос;
	ЗапросКорректировки.УстановитьПараметр("ЗаказПокупателя", Заказ);
	ЗапросКорректировки.УстановитьПараметр("КлючСтроки", Строка); 
	
	ЗапросКорректировки.Текст =
	"ВЫБРАТЬ
	|	ЗапросыИзмененияКоличестваВЗаказах.ЗаказПокупателя
	|ИЗ
	|	РегистрСведений.ЗапросыИзмененияКоличестваВЗаказах КАК ЗапросыИзмененияКоличестваВЗаказах
	|ГДЕ
	|	ВЫБОР
	|			КОГДА НЕ ВЫРАЗИТЬ(ЗапросыИзмененияКоличестваВЗаказах.ДокументКорректировки КАК Документ.КорректировкаГрузовогоМеста) ЕСТЬ NULL
	|				ТОГДА НЕ ЗапросыИзмененияКоличестваВЗаказах.ДокументКорректировки.Исполнено
	|			ИНАЧЕ НЕ ЗапросыИзмененияКоличестваВЗаказах.Обработано
	|		КОНЕЦ
	|	И ЗапросыИзмененияКоличестваВЗаказах.ЗаказПокупателя = &ЗаказПокупателя
	|	И ЗапросыИзмененияКоличестваВЗаказах.КлючСтроки = &КлючСтроки"; 
	
	Возврат НЕ ЗапросКорректировки.Выполнить().Пустой();       
	
КонецФункции

Функция ПроверитьСтатусСборки(ПромЗаказ, ПромТовар) Экспорт  
	
	ЗапросНаличияСборки = Новый Запрос;
	ЗапросНаличияСборки.УстановитьПараметр("Заказ", ПромЗаказ);
	ЗапросНаличияСборки.УстановитьПараметр("Товар", ПромТовар); 
	
	ЗапросНаличияСборки.Текст = 
	"ВЫБРАТЬ
	|	ТоварыВСборкеОстатки.Сборка.Ссылка,
	|	ТоварыВСборкеОстатки.Сборка.ВремяОкончанияСборки
	|ИЗ
	|	РегистрНакопления.ТоварыВСборке.Остатки(
	|			,
	|			ЗаказПокупателя = &Заказ ";      
	
	Если НЕ ПромТовар = NULL Тогда
		ЗапросНаличияСборки.Текст = ЗапросНаличияСборки.Текст + "
		|				И Номенклатура = &Товар";
	КонецЕсли;               
	
	ЗапросНаличияСборки.Текст = ЗапросНаличияСборки.Текст + " 
	|) КАК ТоварыВСборкеОстатки";    
	
	Если НЕ ЗапросНаличияСборки.Выполнить().Пустой() Тогда	
		
		ЗапросСтатусаСборки = Новый Запрос;
		ЗапросСтатусаСборки.УстановитьПараметр("Заказ", ПромЗаказ);
		ЗапросСтатусаСборки.УстановитьПараметр("Товар", ПромТовар); 
		
		ЗапросСтатусаСборки.Текст = 
		"ВЫБРАТЬ
		|	ТоварыВСборкеОстатки.Сборка.Ссылка,
		|	ТоварыВСборкеОстатки.Сборка.ВремяОкончанияСборки
		|ИЗ
		|	РегистрНакопления.ТоварыВСборке.Остатки(
		|			,
		|			ЗаказПокупателя = &Заказ ";   
		
		Если НЕ ПромТовар = NULL Тогда
			ЗапросСтатусаСборки.Текст = ЗапросСтатусаСборки.Текст +"
			|				И Номенклатура = &Товар";
		КонецЕсли;                        
		
		ЗапросСтатусаСборки.Текст = ЗапросСтатусаСборки.Текст +"		
		|) КАК ТоварыВСборкеОстатки
		|ГДЕ
		|	ТоварыВСборкеОстатки.Сборка.ВремяОкончанияСборки = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)";   
		
		Возврат НЕ ЗапросСтатусаСборки.Выполнить().Пустой();  
		
	Иначе
		Возврат Истина;
	КонецЕсли;      
	
КонецФункции

Функция ПроверитьСтатусОтгрузки(ПромЗаказ, ПромТовар) Экспорт    
	
	Если НЕ Константы.ИспользоватьКорректировкуГрузомест.Получить() Тогда 
		Возврат Ложь; 
	КонецЕсли;          
	
	Если ПромЗаказ.СпособДоставки = Перечисления.СпособДоставки.НашаДоставка Тогда  
		
		ЗапросСтатусаОтгрузки = Новый Запрос;
		ЗапросСтатусаОтгрузки.УстановитьПараметр("Заказ", ПромЗаказ);
		ЗапросСтатусаОтгрузки.УстановитьПараметр("Товар", ПромТовар);
		
		ЗапросСтатусаОтгрузки.Текст =	
		"ВЫБРАТЬ
		|	СборкаЗаказовПокупателяЗаказано.Ссылка КАК ДокСборка
		|ПОМЕСТИТЬ Сборки
		|ИЗ
		|	Документ.СборкаЗаказовПокупателя.Заказано КАК СборкаЗаказовПокупателяЗаказано
		|ГДЕ
		|	СборкаЗаказовПокупателяЗаказано.Заказ = &Заказ
		|	И СборкаЗаказовПокупателяЗаказано.Номенклатура = &Товар
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗаданиеНаДоставкуДоставка.Ссылка
		|ИЗ
		|	Документ.ЗаданиеНаДоставку.Доставка КАК ЗаданиеНаДоставкуДоставка
		|ГДЕ
		|	ЗаданиеНаДоставкуДоставка.ДокументСборки В
		|			(ВЫБРАТЬ
		|				Сборки.ДокСборка
		|			ИЗ
		|				Сборки)
		|	И НЕ ЗаданиеНаДоставкуДоставка.Ссылка.ПометкаУдаления"; 
		
		РезультатЗапросаСтатусаОтгрузки = ЗапросСтатусаОтгрузки.Выполнить();
		Возврат РезультатЗапросаСтатусаОтгрузки.Пустой();   
		
	Иначе 	
		Возврат Ложь;
	КонецЕсли;    
	
КонецФункции

Функция СоздатьНовуюНоменклатуру(Стр, НоменклатураРодитель, Товар, ЭтоНашТовар, Комментарий = "", EMailЗаказ = Ложь) Экспорт
	
	Если EMailЗаказ Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		
		Если НоменклатураРодитель = Справочники.Номенклатура.ПустаяСсылка() Тогда
			
			ИскомаяГруппа = Справочники.Номенклатура.НайтиПоНаименованию(ВРег(стр.Brand), Истина);
			
			Если ИскомаяГруппа = Неопределено Тогда 
				
				НоменклатураРодитель = Справочники.Номенклатура.СоздатьГруппу();
				НоменклатураРодитель.ВидНоменклатуры = Константы.ВидНоменклатурыПоУмолчанию.Получить();
				НоменклатураРодитель.Наименование = ВРег(стр.Brand);
				НоменклатураРодитель.ДополнительныеСвойства.Вставить("ПропуститьПроверкуAMQP", Истина);	
				НоменклатураРодитель.Записать();   
				
			Иначе 
				НоменклатураРодитель = ИскомаяГруппа;
			КонецЕсли;        
			
		КонецЕсли;
		
		НовыйЭлемент = Справочники.Номенклатура.СоздатьЭлемент();
		НовыйЭлемент.ВестиУчетПоСериям 				= Истина;
		НовыйЭлемент.Наименование 					= стр.Name;
		НовыйЭлемент.ВидНоменклатуры 				= Константы.ВидНоменклатурыПоУмолчанию.Получить();  
		//+Гавриленков В. 10.12.2025 #UT10-5574
		//НовыйЭлемент.СтавкаНДС 						= ?(ТекущаяДата() >= Дата("20190101000000"), Перечисления.СтавкиНДС.НДС20, Перечисления.СтавкиНДС.НДС18);
		НовыйЭлемент.СтавкаНДС 						= ?(ТекущаяДата() >= Дата("20260101000000"), Перечисления.СтавкиНДС.НДС22, ?(ТекущаяДата() >= Дата("20190101000000"), Перечисления.СтавкиНДС.НДС20, Перечисления.СтавкиНДС.НДС18));
		//-Гавриленков В. 10.12.2025 #UT10-5574

		Если НЕ ЭтоНашТовар Тогда 
			НовыйЭлемент.НаименованиеПолное 			= СтрЗаменить(стр.Articul + " " + стр.Name, "'", "");	
		Иначе
			НовыйЭлемент.НаименованиеПолное 			= стр.Articul + " " + стр.Name;
		КонецЕсли;                          
		
		НовыйЭлемент.КодПроизводителя				= стр.Articul;
		НовыйЭлемент.ВестиПартионныйУчетПоСериям 	= Истина;
		НовыйЭлемент.БазоваяЕдиницаИзмерения 		= Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796");
		НовыйЭлемент.Комментарий 					= Комментарий;
		НовыйЭлемент.НеПодлежитВозврату 			= Ложь; 
		НовыйЭлемент.Кратность 						= 1;
		НовыйЭлемент.Родитель 						= НоменклатураРодитель.Ссылка; 
		
		Если ЭтоНашТовар Тогда           
			
			НовыйЭлемент.Артикул                    = СокрЛП(стр.NumberInv);
			НовыйЭлемент.КодПоБазеМоскоречье        = СокрЛП(стр.NumberInv);   
			
		КонецЕсли;    
		
		НовыйЭлемент.НоменклатурнаяГруппа = Справочники.НоменклатурныеГруппы.Прочее;
		НовыйЭлемент.ДополнительныеСвойства.Вставить("ПропуститьПроверкуAMQP", Истина);	
		НовыйЭлемент.Записать();
		
		НоваяЕдиница 							= Справочники.ЕдиницыИзмерения.СоздатьЭлемент();
		НоваяЕдиница.Владелец 					= НовыйЭлемент.Ссылка ;
		НоваяЕдиница.Наименование 				= НовыйЭлемент.БазоваяЕдиницаИзмерения.Наименование;
		НоваяЕдиница.ЕдиницаПоКлассификатору 	= НовыйЭлемент.БазоваяЕдиницаИзмерения;
		НоваяЕдиница.Коэффициент 				= 1;
		НоваяЕдиница.ДополнительныеСвойства.Вставить("ПропуститьПроверкуAMQP", Истина);	
		НоваяЕдиница.Записать();
		
		НовыйЭлемент.ЕдиницаХраненияОстатков		= НоваяЕдиница.Ссылка;
		НовыйЭлемент.ЕдиницаДляОтчетов			= НоваяЕдиница.Ссылка;
		НовыйЭлемент.ЕдиницаИзмеренияМест         = НоваяЕдиница.Ссылка;
		НовыйЭлемент.ДополнительныеСвойства.Вставить("ПропуститьПроверкуAMQP", Истина);	
		НовыйЭлемент.Записать();
		
		Товар = НовыйЭлемент.Ссылка;
		Возврат Истина;
		
	Исключение
		
		Товар = Неопределено;
		Возврат Ложь;								
		
	КонецПопытки;      
	
КонецФункции

Функция ПолучитьЗаказыСПортала(Шапка, Строки, EMailЗаказ = Ложь, НовыйЗаказ = Неопределено, ТипЦенЗаказа = Неопределено) Экспорт
	
	Если EMailЗаказ Тогда
		ЗаписьЖурналаРегистрации("Запрос данных с эл почты", УровеньЖурналаРегистрации.Информация,,, "TransmitOrderFromEMail начало ");	
	КонецЕсли;
	
	//Создаем объект для возврата
	ТипОтвет					= ФабрикаXDTO.Тип(Метаданные.WebСервисы.TransmitOrderFromPortal.ПространствоИмен, "OutForPortal");
	РезультатДляВозвратаПорталу = ФабрикаXDTO.Создать(ТипОтвет);
	//Создаем строку ответа
	ТипСтрокаОтвета			    = ФабрикаXDTO.Тип(Метаданные.WebСервисы.TransmitOrderFromPortal.ПространствоИмен, "OutLine");
	СтрокаВозврата = ФабрикаXDTO.Создать(ТипСтрокаОтвета);
	
	ТекДата = ТекущаяДата();
	
	НовыйДокЗаказ = Документы.ЗаказПокупателя.СоздатьДокумент();
	НовыйДокЗаказ.Дата 	 = ТекДата;
	НовыйДокЗаказ.Портал = Истина; 	
	ДопИнформация = "";
	
	//Определим есть ли передаваемый заказ в списке ранее загруженных
	Если EMailЗаказ Тогда
		
		Если Справочники.НеСозданныеЗаказыПокупателей.НайтиПоРеквизиту("ИдентификаторСообщения", 
			 СокрЛП(Шапка.ИдентификаторСообщения)) <> Справочники.НеСозданныеЗаказыПокупателей.ПустаяСсылка() Тогда     
			 
			Если Константы.База.Получить() = Перечисления.НазваниеБазы.Казань Тогда 
				СтрокаВозврата.Status = "1";
			Иначе
				СтрокаВозврата.Status = "3";
			КонецЕсли;                              
			
			РезультатДляВозвратаПорталу.OutForPortalLines.Добавить(СтрокаВозврата);
			ЗаписьЖурналаРегистрации("EMail-заказ", УровеньЖурналаРегистрации.Предупреждение,,, "Письмо " + СокрЛП(Шапка.ИдентификаторСообщения) 
			+ " было загружено ранее (см. справочник Несозданные заказы)");
			Возврат РезультатДляВозвратаПорталу;       
			
		КонецЕсли;
			
	ИначеЕсли НЕ Справочники.НеСозданныеЗаказыПокупателей.НайтиПоКоду(СокрЛП(Шапка.OrderID)) = Справочники.НеСозданныеЗаказыПокупателей.ПустаяСсылка() Тогда
		
		Если Константы.База.Получить() = Перечисления.НазваниеБазы.Казань Тогда 
			СтрокаВозврата.Status = "1";
		Иначе
			СтрокаВозврата.Status = "3";
		КонецЕсли;                       
		
		РезультатДляВозвратаПорталу.OutForPortalLines.Добавить(СтрокаВозврата);	
		ЗаписьЖурналаРегистрации("Оформление заказа с портала", УровеньЖурналаРегистрации.Информация,,,
		"В базе данных уже есть Несозданный заказ с ID " + СокрЛП(Шапка.OrderID) + ". На портал возвращается статус " + СтрокаВозврата.Status + ".");
		
		Возврат РезультатДляВозвратаПорталу;		
		
	КонецЕсли;	
	
	НеСоздаватьНоменклатуруВУТ10 = Константы.НеСоздаватьНоменклатуруВУТ10.Получить(); 
	НеСозданныйЗП = Справочники.НеСозданныеЗаказыПокупателей.СоздатьЭлемент();
	НеСозданныйЗП.Дата = ТекДата;
	НеСозданныйЗП.Addres = Шапка.Addres;
	НеСозданныйЗП.AddresFakt = СокрЛП(Шапка.AddresFakt);
	НеСозданныйЗП.AddresFaktID = Шапка.AddresFaktID;
	НеСозданныйЗП.Comment = Шапка.Comment;
	НеСозданныйЗП.DogovorID = Шапка.DogovorID;	
	НеСозданныйЗП.FirmID = Шапка.FirmID;
	НеСозданныйЗП.KontragentID = Шапка.KlientID;
	НеСозданныйЗП.FilialID = Шапка.FilialID;
	НеСозданныйЗП.TipDost = Шапка.TipDost;
	НеСозданныйЗП.ValutaID = СокрЛП(Шапка.ValutaID);
	НеСозданныйЗП.Код = СокрЛП(Шапка.OrderID);
	НеСозданныйЗП.Наименование = Шапка.Name;
	НеСозданныйЗП.INN = СокрЛП(Шапка.INN);
	НеСозданныйЗП.KPP = СокрЛП(Шапка.KPP);
	НеСозданныйЗП.SkladID = СокрЛП(Шапка.SkladID);
	НеСозданныйЗП.PaymentType = СокрЛП(Шапка.PaymentType);   
	
	Если НЕ EMailЗаказ Тогда                                 
		
		Если НЕ Шапка.Свойства().Получить("OrderSource") = Неопределено Тогда
			НеСозданныйЗП.OrderSource = СокрЛП(Шапка.OrderSource);
		КонецЕсли;       
		
	Иначе
		НеСозданныйЗП.OrderSource = 6;
	КонецЕсли;
	
	ИспользоватьДатуОтгрузкиИзЗаказа = Константы.ИспользоватьДатуОтгрузкиИзЗаказа.Получить(); 
	
	Если ИспользоватьДатуОтгрузкиИзЗаказа И НЕ EMailЗаказ Тогда  
		
		Если  НЕ Шапка.Свойства().Получить("Dostavka") = Неопределено Тогда   
			
			Если  СтрДлина(Шапка.Dostavka) = 19 Тогда        
				
				стр1 = СтрЗаменить(СокрЛП(Шапка.Dostavka), "-", "");
				стр1 = СтрЗаменить(стр1, ":", "");
				стр1 = СтрЗаменить(стр1, "T", "");
				Дата = Дата(стр1);
				
				//+Белов А. 05.02.2026 #UT10-5641
				////+Кабанов А.В. 19.05.2025 # UT10-5247 
				//ЧасовойПоясФилиала = Константы.ЧасовойПоясФилиала.Получить();
				//Дата               = Дата - ЧасовойПоясФилиала*3600 ;				
				////+Кабанов А.В. 19.05.2025 # UT10-5247
				//-Белов А. 05.02.2026 #UT10-5641

				НеСозданныйЗП.Dostavka = Дата;
				НовыйДокЗаказ.ДатаОтгрузки = Дата;
				
			Иначе                                
				
				НеСозданныйЗП.Dostavka = ТекущаяДата();
				НовыйДокЗаказ.ДатаОтгрузки = ТекущаяДата();
				
			КонецЕсли;
		КонецЕсли;                   
		
	ИначеЕсли ИспользоватьДатуОтгрузкиИзЗаказа И EMailЗаказ Тогда  
		
		НеСозданныйЗП.Dostavka = ТекущаяДата();
		НовыйДокЗаказ.ДатаОтгрузки = ТекущаяДата();   
		
	КонецЕсли;	            
	
	Если EMailЗаказ Тогда    
		
		НеСозданныйЗП.EMailЗаказ = Истина;		
		НеСозданныйЗП.ИдентификаторСообщения = Шапка.ИдентификаторСообщения;  
		СтрПараметры = 
		"OrderID_ = '"	    + СокрЛП(Шапка.OrderID) + "';" +
		"Addres_ = '"	    + СокрЛП(Шапка.Addres)+ "';" +
		"AddresFakt_ = '"	+ СокрЛП(Шапка.AddresFakt) + "';" +
		"DogovorID_ = '"	+ Строка(Шапка.DogovorID) + "';" +
		"FirmID_ = '"		+ Строка(Шапка.FirmID) + "';" +
		"KontragentID_ = '"	+ Строка(Шапка.KlientID) + "';" +
		"FilialID_ = '"		+ Строка(Шапка.FilialID) + "';" +
		"TipDost_ = '"		+ Строка(Шапка.TipDost) + "';" +
		"INN_ = '"		    + СокрЛП(Шапка.INN) + "';" +
		"SkladID_ = '"		+ СокрЛП(Шапка.SkladID) + "';" +
		"PaymentType_ = '"	+ СокрЛП(Шапка.PaymentType) + "';";
		
		Если НЕ EMailЗаказ Тогда                   
			
			Если НЕ Шапка.Свойства().Получить("OrderSource") = Неопределено Тогда
				СтрПараметры =  СтрПараметры + "OrderSource_ = '"	+ СокрЛП(Шапка.OrderSource) + "';";
			КонецЕсли;         
			
		КонецЕсли;          
		
		СтрПараметры = СтрПараметры + "ИД_Сообщения_ = '" + СокрЛП(Шапка.ИдентификаторСообщения) +"';";  	
		ЗаписьЖурналаРегистрации("Оформление заказа через EMail", УровеньЖурналаРегистрации.Информация,,, "TransmitOrderFromEMail " + Символы.ПС + СтрПараметры);	
		
	КонецЕсли;
	
	Причина = "";
	
	////////////////////Заполнение контрагента///////////////////////////
	Контрагент 		  = НайтиКонтрагентаПоКодуИзПортала(СокрЛП(Шапка.KlientID));
	ФилиалКонтрагента = НайтиФилиалПоКодуИзПортала(СокрЛП(Шапка.FilialID));
	
	Если EMailЗаказ Тогда    
		
		Если Не ЗначениеЗаполнено(Контрагент) и ЗначениеЗаполнено(Шапка.Контрагент) Тогда
			Контрагент = Шапка.Контрагент;
		КонецЕсли;          
		
		Если Не ЗначениеЗаполнено(ФилиалКонтрагента) и ЗначениеЗаполнено(Шапка.ФилиалКонтрагента) Тогда
			ФилиалКонтрагента = Шапка.ФилиалКонтрагента;
		КонецЕсли;   
		
	КонецЕсли;
	
	Если НЕ ФилиалКонтрагента  = Неопределено Тогда
		НовыйДокЗаказ.Контрагент = ФилиалКонтрагента;
	ИначеЕсли НЕ Контрагент = Неопределено Тогда
		НовыйДокЗаказ.Контрагент = Контрагент;
	Иначе                             
		
		Причина = Причина + "Не найден клиент";		
		
		Если Не EMailЗаказ Тогда
			ЗаписьЖурналаРегистрации("Оформление заказа с портала", УровеньЖурналаРегистрации.Информация,,,
			"Не найдены контрагент по ID " + СокрЛП(Шапка.KlientID) + " и филиал по ID " + СокрЛП(Шапка.FilialID) + ".");
		КонецЕсли;      
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НовыйДокЗаказ.Контрагент) И ЗначениеЗаполнено(НовыйДокЗаказ.Контрагент.ГоловнойКонтрагент) 
		И НовыйДокЗаказ.Контрагент.ГоловнойКонтрагент <> НовыйДокЗаказ.Контрагент Тогда  
		
		НовыйДокЗаказ.Грузополучатель = НовыйДокЗаказ.Контрагент;
		НовыйДокЗаказ.Контрагент =   НовыйДокЗаказ.Контрагент.ГоловнойКонтрагент;  
		
	ИначеЕсли Не EMailЗаказ или ЗначениеЗаполнено(ФилиалКонтрагента) Тогда 
		НовыйДокЗаказ.Грузополучатель = НовыйДокЗаказ.Контрагент;		
	КонецЕсли;                                            
	
	////////////////////Заполнение способа доставки///////////////////////////
	//Значения "TipDost" из портала:
	//0 - только резерв
	//1 - самовывоз
	//2 - экспресс доставка
	//3 - трансп компания
	//4 - стандартная доставка
	//5 - такси доставка 	
	ТипДоставки = Число(Шапка.TipDost);

	Если ТипДоставки = 1 ИЛИ ТипДоставки = 5 Тогда  
		
		Если ТипДоставки = 5 И Константы.ТаксиДоставка.Получить() Тогда  
			
			НовыйДокЗаказ.УпаковыватьСамовывоз = Истина;
			НовыйДокЗаказ.ТаксиДоставка        = Истина; 
			
		КонецЕсли;       
		
		НовыйДокЗаказ.СпособДоставки = Перечисления.СпособДоставки.Самовывоз;  
		
	ИначеЕсли ТипДоставки = 2 ИЛИ ТипДоставки = 3 ИЛИ ТипДоставки = 4 Тогда 	
		НовыйДокЗаказ.СпособДоставки = Перечисления.СпособДоставки.НашаДоставка; 	 
		
	ИначеЕсли ТипДоставки = 0 и ЗначениеЗаполнено(НовыйДокЗаказ.Грузополучатель) Тогда
		
		НовыйДокЗаказ.ТолькоРезерв  = Истина;                      
		
		Если ЗначениеЗаполнено(НовыйДокЗаказ.Грузополучатель.СпособДоставки) Тогда
			НовыйДокЗаказ.СпособДоставки = НовыйДокЗаказ.Грузополучатель.СпособДоставки;
		Иначе      
			
			Если ЗначениеЗаполнено(НовыйДокЗаказ.Грузополучатель.МаршрутДоставки) Тогда
				НовыйДокЗаказ.СпособДоставки = Перечисления.СпособДоставки.НашаДоставка;
			Иначе
				НовыйДокЗаказ.СпособДоставки = Перечисления.СпособДоставки.Самовывоз;
			КонецЕсли;   
			
		КонецЕсли;	
		
	Иначе	
		Причина = ?(Причина = "", Причина, Причина + ", ") + "Не указан способ доставки";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НовыйДокЗаказ.Грузополучатель) Тогда
		Причина = ?(Причина = "", Причина, Причина + ", ") + "Не заполнен филиал контрагента (выберите из справочника)";	
	КонецЕсли;
	
	Если НЕ EMailЗаказ Тогда      
		
		Если НЕ Шапка.Свойства().Получить("OrderSource") = Неопределено Тогда
			ПромКодИсточника = Число(Шапка.OrderSource);
		Иначе
			ПромКодИсточника = 0;
		КонецЕсли;      
		
	Иначе         
		
		ПромКодИсточника = 6;                    
		
		Если ЗначениеЗаполнено(НовыйДокЗаказ.Грузополучатель) И НовыйДокЗаказ.Грузополучатель.ОбособленнаяОтгрузкаГМИзСтороннегоФилиала Тогда
			
			НеСозданныйЗП.ОбособленнаяОтгрузкаГМИзСтороннегоФилиала = Истина;
			НеСозданныйЗП.SkladID = "0";
			Причина = ?(Причина = "", Причина, Причина + ", ") + "Обособленная отгрузка ГМ , выбор склада";
			
		КонецЕсли;
		
	КонецЕсли;                                  
	
	НовыйДокЗаказ.ИсточникЗаказа =  Справочники.ИсточникиЗаказов.НайтиПоРеквизиту("КодИсточника", ПромКодИсточника); 

	//////////////////////////////////////////////////
	
	Если Константы.ЗагружатьДоговораСПортала.Получить() Тогда
		
		СтруктураВозврата = НайтиДоговорПоКодуИзПортала(СокрЛП(Шапка.DogovorID), НовыйДокЗаказ.СпособДоставки);
		Договор = СтруктураВозврата.ДоговорКонтрагента;
		НовыйДокЗаказ.ОплатаНаличными = СтруктураВозврата.ОплатаНаличными;
		
		Если СтрДлина(СокрЛП(Шапка.DogovorID)) > 36 Тогда
			
			МассивСтр = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(СокрЛП(Шапка.DogovorID), "|");
			
			Если МассивСтр.Количество() > 3 Тогда
				
				КлючСтрокиУсловий = МассивСтр[3];
				
				Попытка
					НовыйДокЗаказ.КлючСтрокиУсловий = Число(КлючСтрокиУсловий);
				Исключение
				КонецПопытки;
				
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе 
		
		Если EMailЗаказ Тогда
			Договор = ?(ЗначениеЗаполнено(НовыйДокЗаказ.Контрагент.EMailЗаказ_Договор),
			          НовыйДокЗаказ.Контрагент.EMailЗаказ_Договор, НовыйДокЗаказ.Контрагент.ОсновнойДоговорКонтрагента);
		Иначе 
			Договор = НовыйДокЗаказ.Контрагент.ОсновнойДоговорКонтрагента;
		КонецЕсли;    
		
		НовыйДокЗаказ.ОплатаНаличными = Договор.ОплатаПоДоговоруНаличными; 
		
	КонецЕсли;                                          
	
	Если Контрагент = Константы.ОсновнойПоставщик.Получить() 
		И (НовыйДокЗаказ.ИсточникЗаказа.КодИсточника = 2 ИЛИ НовыйДокЗаказ.ИсточникЗаказа.КодИсточника = 3) Тогда   
		
		ПромДоговорАПИ = Константы.ДоговорДляЗаказаЧерезАПИДляОсновногоПоставщика.Получить();    
		
		Если НЕ ПромДоговорАПИ.Пустая() Тогда
			Договор = ПромДоговорАПИ;
		КонецЕсли;	
		
	КонецЕсли;        
	
	НовыйДокЗаказ.ДоговорКонтрагента = Договор;
	
	Если ЗначениеЗаполнено(Договор) Тогда  
		
		НовыйДокЗаказ.ВалютаДокумента = Договор.ВалютаВзаиморасчетов;
		НеСозданныйЗП.ТипЦенЗаказ = ?(ТипЦенЗаказа = Неопределено ИЛИ ТипЦенЗаказа.Пустая(), Договор.ТипЦен, ТипЦенЗаказа);   
		
		Если Договор.Потенциальный Тогда
			Причина = ?(Причина = "", Причина, Причина + ", ") + "В договоре установлен признак Потенциальный";	
		КонецЕсли;		
		
	Иначе                                                          
		
		Причина = ?(Причина = "", Причина, Причина + ", ") + "Не найден основной договор с покупателем";  
		
		Если EMailЗаказ Тогда
			ЗаписьЖурналаРегистрации("Оформление заказа через EMail", УровеньЖурналаРегистрации.Предупреждение,,, "Не найден договор при создании Заказа");
		Иначе
			ЗаписьЖурналаРегистрации("Оформление заказа с портала", УровеньЖурналаРегистрации.Предупреждение,,, "Не найден договор при создании Заказа");
		КонецЕсли;   
		
	КонецЕсли;       
	
	НовыйДокЗаказ.Комментарий   = СокрЛП(Шапка.Comment);
	
	Попытка
		
		НовыйДокЗаказ.IDСклада = Число(СокрЛП(Шапка.SkladID));
		НовыйДокЗаказ.IDСклада_СтороннийСклад = МСК.НайтиСтороннийСкладПоID(НовыйДокЗаказ.IDСклада, Истина);		
		
	Исключение
	КонецПопытки;
	
	ЭтоСтороннийСклад = ЗначениеЗаполнено(НовыйДокЗаказ.IDСклада_СтороннийСклад); 

	Если НЕ ЭтоСтороннийСклад И ПустойСтороннийСклад(НовыйДокЗаказ) Тогда		
		ЭтоСтороннийСклад = Истина;	 	
	КонецЕсли; 	
	
	Попытка
		НовыйДокЗаказ.IDЗаказаПортал = СокрЛП(Шапка.OrderID);	
	Исключение
	КонецПопытки;
	
	//+Белов А. 22.10.2024 UT10-4825#
	Если ЭтоСтороннийСклад И ЗначениеЗаполнено(НовыйДокЗаказ.IDСклада_СтороннийСклад) Тогда
		НовыйДокЗаказ.IDСклада = НовыйДокЗаказ.IDСклада_СтороннийСклад.IDСклада;		
	КонецЕсли;
	//-Белов А. 22.10.2024 #UT10-4825
	
	//////////////Если в карточке клиента указано не использовать цены из портала Тогда заказ попадает в не созданные!!!!!!!!!!!!!!!////////////
	Если ЗначениеЗаполнено(НовыйДокЗаказ.Контрагент) И НовыйДокЗаказ.Контрагент.НеИспользоватьЦеныПортала 
		И НЕ Константы.ОформлятьВсеЗаказыСПортала.Получить() Тогда   
		
		Если ЭтоСтороннийСклад Тогда 
			// для сторонних складов берем цены портала
		Иначе
			Причина = ?(Причина = "", Причина, Причина + ", ") + "Не портальная цена; ";
		КонецЕсли;          
		
	КонецЕсли;	
	/////////////////////////////////
	
	Если ЗначениеЗаполнено(Договор) Тогда
		НовыйДокЗаказ.Организация = Договор.Организация;
	Иначе
		
		Если Найти(Причина, "Не найден основной договор с покупателем") = 0 Тогда
			Причина = ?(Причина = "", Причина, Причина + ", ") + "Не найден основной договор с покупателем";
		КонецЕсли;  
		
	КонецЕсли;
	
	Если СокрЛП(НовыйДокЗаказ.Контрагент.ИНН) = "" Тогда 
		
		Если (Константы.База.Получить() = Перечисления.НазваниеБазы.Казань или Константы.База.Получить() = Перечисления.НазваниеБазы.Воронеж) 
			И НовыйДокЗаказ.Организация <> Константы.ОсновнаяОрганизация.Получить() Тогда 
		Иначе
			Причина = ?(Причина = "", Причина, Причина + ", ") + "Нет ИНН контрагента";
		КонецЕсли;
		
	КонецЕсли;

	Если (НовыйДокЗаказ.СпособДоставки = Перечисления.СпособДоставки.Самовывоз И ЗначениеЗаполнено(НовыйДокЗаказ.Грузополучатель))
		И (НЕ ТипДоставки = 5 ИЛИ (ТипДоставки = 5 И НЕ Константы.ТаксиДоставка.Получить())) Тогда		    
		НовыйДокЗаказ.УпаковыватьСамовывоз = НовыйДокЗаказ.Грузополучатель.УпаковыватьСамовывоз;		
	КонецЕсли;	
	
	//____________Строка ниже отработает только в клиент-серверном варианте
	ЗаполнениеДокументов.ЗаполнитьШапкуДокумента(НовыйДокЗаказ, глЗначениеПеременной("глТекущийПользователь"), 
	НовыйДокЗаказ.мВалютаРегламентированногоУчета, "Продажа", Неопределено, Неопределено, НовыйДокЗаказ.мСтруктураПараметровДляПолученияДоговора);
	//~~~~~~~~~~
	
	Если ЗначениеЗаполнено(НовыйДокЗаказ.КлючСтрокиУсловий) Тогда
		
		Попытка
			
			СтрокаСКлючем = НовыйДокЗаказ.ДоговорКонтрагента.Условия.Найти(НовыйДокЗаказ.КлючСтрокиУсловий, "КлючСтроки");
			
			Если СтрокаСКлючем <> Неопределено И ЗначениеЗаполнено(СтрокаСКлючем.ТипЦен) Тогда
				НовыйДокЗаказ.ТипЦен = СтрокаСКлючем.ТипЦен;
			КонецЕсли;
			
		Исключение
		КонецПопытки                                        		
		
	КонецЕсли;
	
	Если НЕ НовыйДокЗаказ.ДоговорКонтрагента.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем Тогда
		Причина = ?(Причина = "", Причина, Причина + ", ") + "Вид основного договора не с покупателем";	
	КонецЕсли;	
	
	НовыйДокЗаказ.УчитыватьНДС = Истина;
	НовыйДокЗаказ.СуммаВключаетНДС = Истина;
	
	НовыйДокЗаказ.ВалютаДокумента = НовыйДокЗаказ.мВалютаРегламентированногоУчета;
	//Ниже курс и кратность указаны для рублей
	НовыйДокЗаказ.КратностьВзаиморасчетов = 1;
	НовыйДокЗаказ.КурсВзаиморасчетов = 1;
	
	НовыйДокЗаказ.СкладГруппа = Константы.ОсновнойСклад.Получить();
	НовыйДокЗаказ.Комментарий = СокрЛП(Шапка.Comment);
	
	Если EMailЗаказ Тогда
		
		НеСозданныйЗП.Контрагент = НовыйДокЗаказ.Контрагент;
		НеСозданныйЗП.ФилиалКонтрагента = НовыйДокЗаказ.Грузополучатель;
		
	КонецЕсли;
	
	//#############################Заполнение табличной части Заказа ###########################
	ДокСумма = 0;
	
	СтрокиЗаказа = ?(EMailЗаказ, Строки, Строки.Lines);  
	
	Для Каждого стр из СтрокиЗаказа Цикл
		
		НоваяСтрокаНеСозданныйЗП = НеСозданныйЗП.Товары.Добавить();
		НоваяСтрокаНеСозданныйЗП.Articul   = стр.Articul;
		НоваяСтрокаНеСозданныйЗП.Brand     = стр.Brand;
		НоваяСтрокаНеСозданныйЗП.Comment   = стр.Comment;
		НоваяСтрокаНеСозданныйЗП.Count     = стр.Count;
		НоваяСтрокаНеСозданныйЗП.РазрешеноКОтгрузке = стр.Count;
		НоваяСтрокаНеСозданныйЗП.Name      = стр.Name;
		НоваяСтрокаНеСозданныйЗП.NumberInv = стр.NumberInv;
		НоваяСтрокаНеСозданныйЗП.Price     = стр.Price;	
		НоваяСтрокаНеСозданныйЗП.Price_Zak = стр.Price_Zak;
		
		Попытка
			НоваяСтрокаНеСозданныйЗП.ПроизводительПоставщика = стр.PROIZV_SUPPLIER;
		Исключение
		КонецПопытки;
		
		
		НоваяСтрокаНеСозданныйЗП.Кратность = 1;// По умолчанию кратность ставим равной 1
		
