			ВыборкаРезультата = РезультатЗапросаЗаказовПоСтатусам.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);	
			
			Пока ВыборкаРезультата.Следующий() Цикл
				
				СтрокаВозврата = ФабрикаXDTO.Создать(ТипСтрокаОтвета);
				ЗаполнитьЗначенияСвойств(СтрокаВозврата, ВыборкаРезультата);
				СтрокаВозврата.DCODE = СокрЛП(СтрокаВозврата.DCODE) + "(" +? (ВыборкаРезультата.Ссылка.ТаксиДоставка, "Такси",
