Процедура ЗаполнитьУИДвСтрокахЗаказа(ТЗНоменклатуры, ГУИДЗаказаПокупателя) Экспорт
	
	СтруктураДанных = Новый Структура;
	
	Попытка		
		
		ВСПрокси = СоздатьПодключение();
		СтруктураДанных.Вставить("ТЗНоменклатуры", ТаблицуВМассив(ТЗНоменклатуры));
		Данные = ДанныеВJSONХранилище(СтруктураДанных);
		Ответ = ВСПрокси.ЗаполнитьУИДвСтрокахЗаказа(Данные, ГУИДЗаказаПокупателя);				
		
	Исключение
		Сообщить(ОписаниеОшибки());		
	КонецПопытки;
	
