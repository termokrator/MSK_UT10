	СтруктураПараметров.Вставить("Авторезервирование", Авторезервирование);
	СтруктураПараметров.Вставить("Авторазмещение",     Авторазмещение);
	СтруктураПараметров.Вставить("СтратегияАвторезервированияПоЗаказам", СтратегияАвторезервированияПоЗаказам);
	
	НовыйДокЗаказ.ЗаполнитьТабличныеЧастиПередПроведениемУпр(СтруктураПараметров);
	
	//Флаг обособленной отгрузки заполняем именно здесь, если выше, то размещение не заполнится 
	//+Шульман А. 20.10.2025 #UT10-5457
	Если Маркировка.ЕстьНоменклатураТребующаяМаркировки(НовыйДокЗаказ.Товары.Выгрузить()) Тогда  
		НовыйДокЗаказ.ОбособленнаяОтгрузкаГМИзСтороннегоФилиала = Ложь;    
	//-Шульман А. 20.10.2025 #UT10-5457
	Иначе
	
		Если НовыйДокЗаказ.СпособДоставки = Перечисления.СпособДоставки.НашаДоставка 
			И ЗначениеЗаполнено(НовыйДокЗаказ.Грузополучатель)   
			И НовыйДокЗаказ.Грузополучатель.ОбособленнаяОтгрузкаГМИзСтороннегоФилиала Тогда
			НовыйДокЗаказ.ОбособленнаяОтгрузкаГМИзСтороннегоФилиала = Справочники.СобственныеСклады.IDСоответстуетОбособленнойОтгрузке(НовыйДокЗаказ.IDСклада);
		КонецЕсли;	
		
	КонецЕсли;
	
	СкладФильтр = Константы.ОсновнойСклад.Получить(); 
	
	Для каждого Стр Из НовыйДокЗаказ.Товары Цикл	
		
		Если НЕ Стр.Размещение = СкладФильтр ИЛИ НЕ ЗначениеЗаполнено(Стр.СерияНоменклатуры) Тогда					
			Стр.Размещение = "";    
		КонецЕсли; 
		
	КонецЦикла; 
		
	Если ТекущаяДата() >= Константы.РезервированиеЗаказовСУчетомЯчеек.Получить() Тогда      
		
		ТЗ = НовыйДокЗаказ.Товары.Выгрузить();
