	#КонецЕсли 
		
КонецПроцедуры

Процедура ДобавитьДокументВОчередьОтправкиКопийЧеков(Документ, Email) Экспорт
	
	МенеджерЗаписи = РегистрыСведений.ОчередьОтправкиКопииЧеков.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Документ = Документ; 
	МенеджерЗаписи.Период = ТекущаяДата();
	МенеджерЗаписи.Статус = "ВОчереди"; 
	МенеджерЗаписи.Email = Email;
	МенеджерЗаписи.Записать(Истина); 
		
КонецПроцедуры


