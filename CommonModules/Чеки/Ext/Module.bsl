	Комментарий = ?(ПустаяСтрока(Комментарий), Строка(ТекущаяДата()) + ": (check) ", Комментарий + Символы.ПС) + Текст;
	
КонецПроцедуры




///////////////////Работа с кассами///////////////////
Процедура ОбновитьСтатусыКасс() Экспорт   
	
	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда 
		ЗаписьЖурналаРегистрации("Обновить статусы касс", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Отменена работа регламентного задания из-за несоответствия параметров подключения к ИБ");
		Возврат;
	КонецЕсли;
	
	Если НЕ ИспользоватРегламентныеЗаданияДляРаботыССерверомЧеков() Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Кассы.Ссылка КАК Касса
	               |ИЗ
	               |	Справочник.Кассы КАК Кассы
	               |ГДЕ
	               |	Кассы.ИД <> """"
	               |	И Кассы.ОбновлятьСтатусКассыССервера";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Чеки.ОбновитьСтатусКассыССервера(Выборка.Касса);
		
	КонецЦикла;	
	
КонецПроцедуры

Функция ОбновитьСтатусКассыССервера(Касса) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ЗаписьЖурналаРегистрации("Операции с кассой.Начало", УровеньЖурналаРегистрации.Информация, Метаданные.Справочники.Кассы, Касса, "Начало выполнения функции получения статуса кассы");		
	
	СерверОтправки = Константы.АтолАдресВебСервера.Получить() + ":" + Формат(Константы.АтолПортВебСервера.Получить(), "ЧГ=0");

	СтруктураВозврата = Новый Структура("Результат, Сообщение, СтатусСмены, КрышкаОткрыта, БумагаВставлена, Ошибка", Ложь, "", "", "", "", "");
	
	HTTPЗапрос = Новый HTTPЗапрос();
	HTTPЗапрос.АдресРесурса = "/api/v2/operations/queryDeviceStatus?deviceID=" + Касса.ИД;
	HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json;charset=utf-8");
	
	Попытка
		Соединение = Чеки.ПолучитьСоединениеССерверомЧеков(60);
		ОтветHTTP = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
		Ответ = ОтветHTTP.ПолучитьТелоКакСтроку();
		ЗаписьЖурналаРегистрации("Операции с кассой.Обработка", УровеньЖурналаРегистрации.Информация, Метаданные.Справочники.Кассы, Касса, "Получение статуса кассы с сервера: " + СерверОтправки + " выполнено успешно! " + Символы.ПС + Ответ);				
	Исключение
		ТекстОшибки = "Ошибка получения статуса кассы " + СерверОтправки + Символы.ПС + ОписаниеОшибки();
		СтруктураВозврата.Сообщение = ТекстОшибки;
		ЗаписьЖурналаРегистрации("Операции с кассой.Ошибка", УровеньЖурналаРегистрации.Ошибка, Метаданные.Справочники.Кассы, Касса, СтруктураВозврата.Сообщение);		
		Возврат СтруктураВозврата;
	КонецПопытки;

	Если Не ОтветHTTP.КодСостояния = 200 Тогда
		
		ТекстОшибки = "При получении ответа от сервера обнаружена ошибка. Код состояния " + Строка(ОтветHTTP.КодСостояния) + Символы.ПС + ВернутьОписаниеОшибкиОбновленияСтатусаКассы(ОтветHTTP.КодСостояния);
		СтруктураВозврата.Сообщение = ТекстОшибки;
		ЗаписьЖурналаРегистрации("Операции с кассой.Ошибка", УровеньЖурналаРегистрации.Ошибка, Метаданные.Справочники.Кассы, Касса, СтруктураВозврата.Сообщение);
		
		Если ОтветHTTP.КодСостояния = 401 ИЛИ ОтветHTTP.КодСостояния = 403 ИЛИ ОтветHTTP.КодСостояния = 404 Тогда
			СтруктураВозврата.Ошибка = ВернутьОписаниеОшибкиОбновленияСтатусаКассы(ОтветHTTP.КодСостояния);
		Иначе
			Возврат СтруктураВозврата;
		КонецЕсли;
		
	Иначе
	
		СтруктураСтатуса = ВернутьСтруктуруИзJSON(Ответ);
		
		Если СтруктураСтатуса.Свойство("deviceStatus") Тогда
			
			Если СтруктураСтатуса.deviceStatus.Свойство("shift") Тогда               			
				СтруктураВозврата.СтатусСмены = СтруктураСтатуса.deviceStatus.shift;
			КонецЕсли;
			
			Если СтруктураСтатуса.deviceStatus.Свойство("coverOpened") Тогда               			
				СтруктураВозврата.КрышкаОткрыта = СтруктураСтатуса.deviceStatus.coverOpened;
			КонецЕсли;
			
			Если СтруктураСтатуса.deviceStatus.Свойство("paperPresent") Тогда               			
				СтруктураВозврата.БумагаВставлена = СтруктураСтатуса.deviceStatus.paperPresent;
			КонецЕсли;
			
		КонецЕсли;
		
		ЗаписьЖурналаРегистрации("Операции с кассой.Обработка", УровеньЖурналаРегистрации.Информация, Метаданные.Справочники.Кассы, Касса, "Получен успешный ответ запросе статуса кассы. Код состояния " + Строка(ОтветHTTP.КодСостояния));			
		
	КонецЕсли;
	
	СтруктураВозврата.Результат = Истина;
	
	МенеджерЗаписи = РегистрыСведений.СтатусыКасс.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период = ТекущаяДата();
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи, СтруктураВозврата);
	МенеджерЗаписи.Касса = Касса;
	МенеджерЗаписи.Записать(Истина);
	
	ЗаписьЖурналаРегистрации("Операции с кассой.Завершение", УровеньЖурналаРегистрации.Информация, Метаданные.Справочники.Кассы, Касса, "Окончание выполнения функции открытия получения статуса кассы");		
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат СтруктураВозврата;
	
КонецФункции

