Функция ЗаписатьНовоеЗадание(Документ, Статус, Ошибка = "", ГУИД = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ГУИД = Неопределено Тогда
		ГУИД = Строка(Новый УникальныйИдентификатор());
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.ЗаданияНаПробитиеЧека.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период = ТекущаяДата();
	МенеджерЗаписи.ПКО = Документ;
	МенеджерЗаписи.ГУИД = ГУИД;
	МенеджерЗаписи.Статус = Статус;
	МенеджерЗаписи.ТекстОшибки = Ошибка;
	МенеджерЗаписи.Записать();   
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецФункции

Функция ПолучитьSBPRRNИзСлипЧека(МассивСтрокСлипЧека) Экспорт

	SbpRRN = "";

	Для каждого Строка Из МассивСтрокСлипЧека Цикл
		
		Если Найти(Строка, "SbpRRN:") > 0 Тогда
			
			SbpRRN = СтрЗаменить(Строка, "SbpRRN:", "");
			SbpRRN = СокрЛП(SbpRRN); 
			Прервать;
			
		КонецЕсли;
		
		//+Марков И. 21.04.2025 #UT10-5204
		Если Найти(Строка, "QR RRN:") > 0 Тогда
			
			SbpRRN = СтрЗаменить(Строка, "QR RRN:", "");
			SbpRRN = СокрЛП(SbpRRN); 
			Прервать;
			
		КонецЕсли;
		//-Марков И. 21.04.2025 #UT10-5204
		
	КонецЦикла;
	
	Возврат SbpRRN;
		
КонецФункции

Функция КодироватьСтрокуВBase64(Знач Строка,
                               Знач Кодировка = Неопределено,
                               Знач ЗаписатьBOM = Ложь) Экспорт

   // Устанавливаем кодировку по умолчанию, если не указана
   Если Не ЗначениеЗаполнено(Кодировка) Тогда
       Кодировка = КодировкаТекста.UTF8;
   КонецЕсли;

   // Преобразуем строку в двоичные данные
   ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(Строка, Кодировка, ЗаписатьBOM);

   // Кодируем двоичные данные в Base64
   Результат = Base64Строка(ДвоичныеДанные);

   Возврат Результат;

КонецФункции

