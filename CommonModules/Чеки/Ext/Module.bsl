		СтруктураЧека.Вставить("salesNotice", УведомленияПродажи);
		
	КонецЕсли;
	//-Белов А. 02.02.2026 #UT10-5641
		
	СтруктураJSON.Вставить("request", СтруктураЧека);
	
	Возврат СтруктураJSON;
	
КонецФункции 

Функция ПолучитьМассивПозиций(ДополнительныеПараметры, МаркировкаПоНоменклатуре)
	
	//данные о товарах массив items
	МассивПозиций = Новый Массив();
	
	//+Белов А. 02.02.2026 #UT10-5641
	Если ПробиватьВЧекахКодыМаркировки() И МаркировкаПоНоменклатуре.Количество() > 0 Тогда
			
		Для Каждого Стр Из ДополнительныеПараметры.ПозицииЧекККМ Цикл
			
			Если Стр.Тип = Перечисления.ТипыПозицийЧекККМ.Аванс Тогда
				
				СтруктураПозиции = Новый Структура();
				СтруктураПозиции.Вставить("type", "position");
				СтруктураПозиции.Вставить("name", "Аванс");
				СтруктураПозиции.Вставить("paymentMethod", "advance");
				СтруктураПозиции.Вставить("paymentObject", "payment");
				СтруктураПозиции.Вставить("price", Стр.Цена);
				СтруктураПозиции.Вставить("quantity", Стр.Количество);
				СтруктураПозиции.Вставить("amount", Стр.Сумма);
				СтруктураПозиции.Вставить("tax", ПолучитьСтруктуруСтавкиНДС(Стр));
				
				МассивПозиций.Добавить(СтруктураПозиции);
				
			ИначеЕсли Стр.Тип = Перечисления.ТипыПозицийЧекККМ.Товар Тогда

				КоличествоТовара = Стр.Количество;
			
				МассивСтруктурМаркировки = МаркировкаПоНоменклатуре.Получить(Стр.Позиция);
				Если МассивСтруктурМаркировки = Неопределено Тогда
					МассивСтруктурМаркировки = Новый Массив;
				КонецЕсли;
				
				Для Каждого ПозицияМаркировки Из МассивСтруктурМаркировки Цикл
					
					Если КоличествоТовара = 0 Тогда
						Продолжить;
					КонецЕсли;     
					
					Если ПозицияМаркировки.Использован Тогда
						Продолжить;
					КонецЕсли;
					
					СтруктураПозиции = Новый Структура();
					СтруктураПозиции.Вставить("type", "position");
					СтруктураПозиции.Вставить("name", Стр.Позиция.Наименование);
					СтруктураПозиции.Вставить("paymentMethod", "fullPayment");
					СтруктураПозиции.Вставить("paymentObject", "commodityWithMarking");
					СтруктураПозиции.Вставить("price", Стр.Цена);
					СтруктураПозиции.Вставить("quantity", 1);
					СтруктураПозиции.Вставить("amount", Стр.Цена);
					СтруктураПозиции.Вставить("tax", ПолучитьСтруктуруСтавкиНДС(Стр));
					СтруктураПозиции.Вставить("imcParams", ПозицияМаркировки.Маркировка);
					
					//+Сёмин Р.И. 09.09.2026 #UT10-6020
					Если ПозицияМаркировки.Свойство("ПроверкаПИоТ") Тогда
						
						industryAttribute = "UUID=" + ПозицияМаркировки.ПроверкаПИоТ.reqId + "&Time=" + XMLСтрока(ПозицияМаркировки.ПроверкаПИоТ.reqTimestamp);
						
						Если ПозицияМаркировки.ПроверкаПИоТ.isCheckedOffline Тогда
							industryAttribute = industryAttribute + "&Inst=" + СокрЛ(ПозицияМаркировки.ПроверкаПИоТ.inst) + "&Ver=" + СокрЛП(ПозицияМаркировки.ПроверкаПИоТ.version);
						КонецЕсли;
						
						industryInfo = Новый Структура;
						industryInfo.Вставить("industryAttribute", industryAttribute);
						
						
						industryInfo.Вставить("date", Формат(ПозицияМаркировки.ПроверкаПИоТ.ДатаДокумента, "ДФ=гггг.ММ.дд"));
						industryInfo.Вставить("number", ПозицияМаркировки.ПроверкаПИоТ.НомерДокумента);
						industryInfo.Вставить("fois", "030"); //Министерство промышленности и торговли Российской Федерации
						
						industryInfoМассив = Новый Массив;
						industryInfoМассив.Добавить(industryInfo);
						
						СтруктураПозиции.Вставить("industryInfo", industryInfoМассив);
						
					КонецЕсли;
					//-Сёмин Р.И. 09.09.2026 #UT10-6020
					
					МассивПозиций.Добавить(СтруктураПозиции);               
					
					ПозицияМаркировки.Использован = Истина;
					
					КоличествоТовара = КоличествоТовара - 1;
					
				КонецЦикла;
				
				Если КоличествоТовара > 0 Тогда
					
					СтруктураПозиции = Новый Структура();
					СтруктураПозиции.Вставить("type", "position");
					СтруктураПозиции.Вставить("name", Стр.Позиция.Наименование);
					СтруктураПозиции.Вставить("paymentMethod", "fullPayment");
					СтруктураПозиции.Вставить("paymentObject", "commodity");
					СтруктураПозиции.Вставить("price", Стр.Цена);
					СтруктураПозиции.Вставить("quantity", КоличествоТовара);
					СтруктураПозиции.Вставить("amount", Стр.Цена * КоличествоТовара);
					СтруктураПозиции.Вставить("tax", ПолучитьСтруктуруСтавкиНДС(Стр));
					
					МассивПозиций.Добавить(СтруктураПозиции);
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		//-Белов А. 02.02.2026 #UT10-5641
		
		Для Каждого Стр Из ДополнительныеПараметры.ПозицииЧекККМ Цикл
			
			СтруктураПозиции = Новый Структура();
			
			СтруктураПозиции.Вставить("type", "position");
			
			Если Стр.Тип = Перечисления.ТипыПозицийЧекККМ.Аванс Тогда
				
				СтруктураПозиции.Вставить("name", "Аванс");
				СтруктураПозиции.Вставить("paymentMethod", "advance");
				СтруктураПозиции.Вставить("paymentObject", "payment");
				
			ИначеЕсли Стр.Тип = Перечисления.ТипыПозицийЧекККМ.Товар Тогда
				
				СтруктураПозиции.Вставить("name", Стр.Позиция.Наименование);
				СтруктураПозиции.Вставить("paymentMethod", "fullPayment");
				СтруктураПозиции.Вставить("paymentObject", "commodity");
				
			КонецЕсли;
			
			СтруктураПозиции.Вставить("price", Стр.Цена);
			СтруктураПозиции.Вставить("quantity", Стр.Количество);
			СтруктураПозиции.Вставить("amount", Стр.Сумма);
			СтруктураПозиции.Вставить("tax", ПолучитьСтруктуруСтавкиНДС(Стр));
			
			МассивПозиций.Добавить(СтруктураПозиции);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат МассивПозиций;
	
КонецФункции

Функция ПолучитьСтруктуруСтавкиНДС(Стр)
	
	СтруктураНДС = Новый Структура();
	Если Стр.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС Тогда
		СтруктураНДС.Вставить("type", "none");
	ИначеЕсли Стр.СтавкаНДС = Перечисления.СтавкиНДС.НДС20 Тогда
		СтруктураНДС.Вставить("type", "vat20");
	ИначеЕсли Стр.СтавкаНДС = Перечисления.СтавкиНДС.НДС20_120 Тогда	
		СтруктураНДС.Вставить("type", "vat120");
		//+Гавриленков В. 05.12.2025 #UT10-5574
	ИначеЕсли Стр.СтавкаНДС = Перечисления.СтавкиНДС.НДС22 Тогда
		СтруктураНДС.Вставить("type", "vat22");
	ИначеЕсли Стр.СтавкаНДС = Перечисления.СтавкиНДС.НДС22_122 Тогда	
		СтруктураНДС.Вставить("type", "vat122");
		//-Гавриленков В. 05.12.2025 #UT10-5574
	ИначеЕсли Стр.СтавкаНДС = Перечисления.СтавкиНДС.НДС18 Тогда
		СтруктураНДС.Вставить("type", "vat18");
	Иначе
		СтруктураНДС.Вставить("type", "none");
	КонецЕсли; 
	
	Возврат СтруктураНДС;
	
КонецФункции

Функция ПолучитьТаймЗону() Экспорт
	
	СоответствиеЗоныКоду = Новый Соответствие;
	СоответствиеЗоныКоду.Вставить("+2", 1);
	СоответствиеЗоныКоду.Вставить("+3", 2);
	СоответствиеЗоныКоду.Вставить("+4", 3);
	СоответствиеЗоныКоду.Вставить("+5", 4);
	СоответствиеЗоныКоду.Вставить("+6", 5);
	СоответствиеЗоныКоду.Вставить("+7", 6);
	СоответствиеЗоныКоду.Вставить("+8", 7);
	СоответствиеЗоныКоду.Вставить("+9", 8);
	СоответствиеЗоныКоду.Вставить("+10", 9);
	СоответствиеЗоныКоду.Вставить("+11", 10);
	СоответствиеЗоныКоду.Вставить("+12", 11);
		
	ЧасовойПоясПредсталение = "+3";
	
	ЧасовойПоясФилиала = Константы.ЧасовойПоясФилиала.Получить();
	
	Если ЗначениеЗаполнено(ЧасовойПоясФилиала) Тогда
		ЧасовойПоясПредсталение = Строка(ЧасовойПоясФилиала);	
	КонецЕсли;
		
	Возврат СоответствиеЗоныКоду.Получить(ЧасовойПоясПредсталение);
	
КонецФункции

Функция ПолучитьМассивОплат(ДополнительныеПараметры) 
	
	//формирование стуктуры оплат
	МассивОплат = Новый Массив();
	
	Для каждого Стр ИЗ ДополнительныеПараметры.ОплатыЧекККМ Цикл
		
		СтруктураОплаты = Новый Структура();
		
		Если Стр.Тип = Перечисления.ТипыОплатЧекККМ.Наличные Тогда
			СтруктураОплаты.Вставить("type", "cash");
		ИначеЕсли Стр.Тип = Перечисления.ТипыОплатЧекККМ.Безналичные Тогда
			СтруктураОплаты.Вставить("type", "electronically");
		ИначеЕсли Стр.Тип = Перечисления.ТипыОплатЧекККМ.Предоплата Тогда
			СтруктураОплаты.Вставить("type", "prepaid");
		КонецЕсли;
		
		СтруктураОплаты.Вставить("sum", Стр.Сумма);
		
		МассивОплат.Добавить(СтруктураОплаты);
		
	КонецЦикла;
	
	Возврат МассивОплат;
		
КонецФункции

Функция ПолучитьДанныеОПокупателе(ДополнительныеПараметры, Электронный)
	
	//данные о покупателе
	
	СтруктураПокупатель = Новый Структура();
	
	АдресEmail = ПолучитьEmail(ДополнительныеПараметры.Контрагент);
	Если Не ЗначениеЗаполнено(АдресEmail) И Электронный Тогда
		АдресEmail = Константы.РезервныйEmailДляОтправкиЭлектронныхЧеков.Получить();		
	КонецЕсли;
	
	Если АдресEmail <> "" Тогда
		СтруктураПокупатель.Вставить("emailOrPhone", АдресEmail);
	КонецЕсли;   
	
	Если ТипЗнч(ДополнительныеПараметры) = Тип("ДокументСсылка.ОплатаОтПокупателяПлатежнойКартой") Тогда
		ЗаполняемСтруктуруПокупателя = ДополнительныеПараметры.РасшифровкаПлатежа[0].ДоговорКонтрагента.БизнесКарта;
	Иначе
		ЗаполняемСтруктуруПокупателя = НЕ (ДополнительныеПараметры.ДоговорКонтрагента.РозничнаяПродажа ИЛИ ДополнительныеПараметры.ДоговорКонтрагента.ЛицевойСчет);
	КонецЕсли;  	
	
	Если ЗаполняемСтруктуруПокупателя Тогда
		
		Если ДополнительныеПараметры.Контрагент.ИНН <> "" Тогда 
			
			СтруктураПокупатель.Вставить("name", СокрЛП(?(ЗначениеЗаполнено(ДополнительныеПараметры.Контрагент.НаименованиеПолное),ДополнительныеПараметры.Контрагент.НаименованиеПолное,ДополнительныеПараметры.Контрагент.Наименование)));
			СтруктураПокупатель.Вставить("vatin", ДополнительныеПараметры.Контрагент.ИНН);
			
		КонецЕсли;
		
	КонецЕсли; 
	
	Возврат СтруктураПокупатель;
		
КонецФункции

Процедура ДополнитьСтруктуруЧекаНовымиРеквизитами(СтруктураЧека, ДополнительныеПараметры, Электронный, МестоРасчетов)
	
	//+Белов А. 04.08.2025 #
	ЭтоИнтернетЧек = МестоРасчетов = Константы.АдресПортала.Получить();	
	
	Если Электронный Тогда
		
		//Способы оплаты
		//1 — банковская карта;
		//2 — мобильное приложение (например, Apple Pay, Google Pay);
		//3 — электронное средство платежа (например, Яндекс.Деньги, WebMoney);
		//4 — безналичный перевод (включая СБП — Систему быстрых платежей);
		//5 — иная форма безналичной оплаты. 					
		СпособОплаты = 1;		
		ИдентификаторПлатежа = "1";
		
		Если ТипЗнч(ДополнительныеПараметры) = Тип("ДокументСсылка.ОплатаОтПокупателяПлатежнойКартой") Тогда
			
			ИдентификаторПлатежа = ДополнительныеПараметры.RRNКодОперации;
			
			Если ДополнительныеПараметры.RRNКодОперации = "111111111111" И ЗначениеЗаполнено(ДополнительныеПараметры.ТекстСлипЧека) Тогда 
				
				ИдентификаторПлатежа = ПолучитьSBPRRNИзСлипЧека(ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(ДополнительныеПараметры.ТекстСлипЧека, Символы.ПС));
				СпособОплаты = 1; 
				
			ИначеЕсли Не ЗначениеЗаполнено(ИдентификаторПлатежа) Тогда
				
				ИдентификаторПлатежа = ДополнительныеПараметры.ИДПлатежа;
				
				Если Найти(ДополнительныеПараметры.ДанныеПоОплате, "Card") = 0 Тогда
					СпособОплаты = 1;
				КонецЕсли;
				
			КонецЕсли; 
			
		КонецЕсли;
		
		//формирование стуктуры безналичных оплат
		МассивБезналичныхОплат = Новый Массив();
		
		Для каждого Стр ИЗ ДополнительныеПараметры.ОплатыЧекККМ Цикл
			
			Если Стр.Тип = Перечисления.ТипыОплатЧекККМ.Безналичные Тогда	
				МассивБезналичныхОплат.Добавить(Новый Структура("sum, paymentMethod, electronicallyId", Стр.Сумма, СпособОплаты, ИдентификаторПлатежа));					
			КонецЕсли;
			
		КонецЦикла;
		
		Если МассивБезналичныхОплат.Количество() > 0 Тогда
			СтруктураЧека.Вставить("paymentsAddInfo", МассивБезналичныхОплат);	
		КонецЕсли;		
		
		СтруктураЧека.Вставить("internet", ЭтоИнтернетЧек);		
		
	КонецЕсли;
	
	//-Белов А. 04.08.2025 # 

КонецПроцедуры

Функция ПолучитьEmail(Контрагент) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтактнаяИнформация.Объект КАК Объект,
		|	КонтактнаяИнформация.Тип КАК Тип,
		|	КонтактнаяИнформация.Вид КАК Вид,
		|	КонтактнаяИнформация.Представление КАК Представление
		|ИЗ
		|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Объект = &Ссылка
		|	И КонтактнаяИнформация.Тип = &Тип
		|	И КонтактнаяИнформация.Вид = &Вид";
	
	Запрос.УстановитьПараметр("Ссылка", Контрагент);
	Запрос.УстановитьПараметр("Тип", Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
	Запрос.УстановитьПараметр("Вид", Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыКонтрагентаДляОтправкиЧеков);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		УстановитьПривилегированныйРежим(Ложь);
		Возврат СокрЛП(ВыборкаДетальныеЗаписи.Представление); 

	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);

	Возврат "";
	
КонецФункции
 
Функция ПолучитьСтатусЗаданияПечатиПКО(ПКО, ДополнятьСтатус = Ложь, МассивСсылок = Неопределено) Экспорт
//+Гавриленков В. 31.05.2025 #UT10-5251 Добавлен параметр МассивСсылок
	
	УстановитьПривилегированныйРежим(Истина);   
	
	Если МассивСсылок = Неопределено Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ЗаданияНаПробитиеЧекаСрезПоследних.Статус,
		|	ЗаданияНаПробитиеЧекаСрезПоследних.ТекстОшибки
		|ИЗ
		|	РегистрСведений.ЗаданияНаПробитиеЧека.СрезПоследних(, ПКО = &ПКО) КАК ЗаданияНаПробитиеЧекаСрезПоследних";
		
		Запрос.УстановитьПараметр("ПКО", ПКО);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			
			УстановитьПривилегированныйРежим(Ложь);
			Возврат Выборка.Статус + ?(ДополнятьСтатус И ЗначениеЗаполнено(Выборка.ТекстОшибки), " (" + Выборка.ТекстОшибки + ")", "");  
			
		КонецЕсли;  
		
	//+Гавриленков В. 11.06.2025 #UT10-5251	
	Иначе
		
		Соответствие = Новый Соответствие;
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЗаданияНаПробитиеЧекаСрезПоследних.Статус,
		               |	ЗаданияНаПробитиеЧекаСрезПоследних.ТекстОшибки,
		               |	ЗаданияНаПробитиеЧекаСрезПоследних.ПКО
		               |ИЗ
		               |	РегистрСведений.ЗаданияНаПробитиеЧека.СрезПоследних(, ПКО В (&МассивСсылок)) КАК ЗаданияНаПробитиеЧекаСрезПоследних";
		
		Запрос.УстановитьПараметр("МассивСсылок", МассивСсылок);  
		
		Таб = Запрос.Выполнить().Выгрузить();
		
		Для Каждого Реализация Из МассивСсылок Цикл  
			
			НайденнаяСтрока = Таб.Найти(Реализация, "ПКО");
			Соответствие.Вставить(Реализация, ?(НайденнаяСтрока = Неопределено , "", НайденнаяСтрока.Статус + ?(ДополнятьСтатус И ЗначениеЗаполнено(НайденнаяСтрока.ТекстОшибки), " (" + НайденнаяСтрока.ТекстОшибки + ")", "")));
			
		КонецЦикла;   
		
		Возврат Соответствие;
		
	КонецЕсли; 
	//-Гавриленков В. 11.06.2025 #UT10-5251
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат "";	
	
КонецФункции

Процедура ЗаполнитьСоставЧекаККМДляПКО(ПКООбъект) Экспорт
	
	ПКООбъект.ПозицииЧекККМ.Очистить();
	ПКООбъект.ОплатыЧекККМ.Очистить();  
	
	//Если лицевой счет, то печатаем всю сумму на аванс
	Если ПлатежныйДокументЛицевойСчет(ПКООбъект) Тогда
		
		СуммаДокумента = ПКООбъект.СуммаДокумента;
		
		НСтр = ПКООбъект.ПозицииЧекККМ.Добавить();
		НСтр.Тип = Перечисления.ТипыПозицийЧекККМ.Аванс;
		НСтр.Количество = 1;
		НСтр.Цена = СуммаДокумента;
		НСтр.Сумма = СуммаДокумента; 
		//+Гавриленков В. 05.12.2025 #UT10-5574
		//НСтр.СтавкаНДС = Перечисления.СтавкиНДС.НДС20;
		НСтр.СтавкаНДС = ?(ПКООбъект.Дата >= Дата("20260101000000"), Перечисления.СтавкиНДС.НДС22, Перечисления.СтавкиНДС.НДС20);
		//-Гавриленков В. 05.12.2025 #UT10-5574
		
		НСтр = ПКООбъект.ОплатыЧекККМ.Добавить();
		НСтр.Тип = Перечисления.ТипыОплатЧекККМ.Наличные;
		НСтр.Сумма = СуммаДокумента;
		
		Возврат;	                         
		
	КонецЕсли;
	
	СписокРеализаций = Новый СписокЗначений;
	
	Для каждого Стр ИЗ ПКООбъект.РасшифровкаПлатежа Цикл
		
		Если ТипЗнч(Стр.ДокументРасчетовСКонтрагентом) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			СписокРеализаций.Добавить(Стр.ДокументРасчетовСКонтрагентом);	
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СписокРеализаций", СписокРеализаций);
	
	Если ПКООбъект.Проведен Тогда
		
		МоментСразуПередДокументом = Новый Граница(ПКООбъект.Ссылка.МоментВремени(), ВидГраницы.Исключая);
		Запрос.УстановитьПараметр("Дата", МоментСразуПередДокументом);
		
	Иначе
		Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	КонецЕсли;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	СУММА(ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстатки.СуммаВзаиморасчетовОстаток) КАК Остаток,
	               |	ВЫРАЗИТЬ(ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстатки.ДокументРасчетовСКонтрагентом КАК Документ.РеализацияТоваровУслуг).Ссылка КАК Реализация
	               |ПОМЕСТИТЬ ВТ_Остатки
	               |ИЗ
	               |	РегистрНакопления.ВзаиморасчетыСКонтрагентамиПоДокументамРасчетов.Остатки(&Дата, ДокументРасчетовСКонтрагентом В (&СписокРеализаций)) КАК ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстатки
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВЫРАЗИТЬ(ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстатки.ДокументРасчетовСКонтрагентом КАК Документ.РеализацияТоваровУслуг).Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СУММА(ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОбороты.СуммаВзаиморасчетовРасход) КАК Оплата,
	               |	ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОбороты.ДокументРасчетовСКонтрагентом КАК Реализация
	               |ПОМЕСТИТЬ ВТ_Оплаты
	               |ИЗ
	               |	РегистрНакопления.ВзаиморасчетыСКонтрагентамиПоДокументамРасчетов.Обороты(, &Дата, Регистратор, ДокументРасчетовСКонтрагентом В (&СписокРеализаций)) КАК ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОбороты
	               |ГДЕ
	               |	(ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОбороты.Регистратор ССЫЛКА Документ.ПриходныйКассовыйОрдер
	               |			ИЛИ ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОбороты.Регистратор ССЫЛКА Документ.ПлатежноеПоручениеВходящее)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОбороты.ДокументРасчетовСКонтрагентом
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СУММА(ВложенныйЗапрос.Предоплата) КАК Предоплата,
	               |	ВложенныйЗапрос.Реализация КАК Реализация
	               |ПОМЕСТИТЬ ВТ_Предоплаты
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		СУММА(РеализацияТоваровУслугДокументыРасчетовСКонтрагентом.СуммаВзаиморасчетов) КАК Предоплата,
	               |		РеализацияТоваровУслугДокументыРасчетовСКонтрагентом.Ссылка КАК Реализация
	               |	ИЗ
	               |		Документ.РеализацияТоваровУслуг.ДокументыРасчетовСКонтрагентом КАК РеализацияТоваровУслугДокументыРасчетовСКонтрагентом
	               |	ГДЕ
	               |		РеализацияТоваровУслугДокументыРасчетовСКонтрагентом.Ссылка В(&СписокРеализаций)
	               |		И РеализацияТоваровУслугДокументыРасчетовСКонтрагентом.Ссылка.Проведен
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		РеализацияТоваровУслугДокументыРасчетовСКонтрагентом.Ссылка
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		СУММА(ВТ_Оплаты.Оплата),
	               |		ВТ_Оплаты.Реализация
	               |	ИЗ
	               |		ВТ_Оплаты КАК ВТ_Оплаты
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		ВТ_Оплаты.Реализация
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		КорректировкаРеализацииДокументыРасчетовСКонтрагентом.СуммаВзаиморасчетов,
	               |		КорректировкаРеализацииДокументыРасчетовСКонтрагентом.ДокументРасчетовСКонтрагентом
	               |	ИЗ
	               |		Документ.КорректировкаРеализации.ДокументыРасчетовСКонтрагентом КАК КорректировкаРеализацииДокументыРасчетовСКонтрагентом
	               |	ГДЕ
	               |		КорректировкаРеализацииДокументыРасчетовСКонтрагентом.ДокументРасчетовСКонтрагентом В(&СписокРеализаций)
	               |		И КорректировкаРеализацииДокументыРасчетовСКонтрагентом.Ссылка.Проведен
	               |		И КорректировкаРеализацииДокументыРасчетовСКонтрагентом.ДокументРасчетовСКонтрагентом <> КорректировкаРеализацииДокументыРасчетовСКонтрагентом.Ссылка.ДокументРеализации) КАК ВложенныйЗапрос
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВложенныйЗапрос.Реализация
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Остатки.Реализация,
	               |	ЕСТЬNULL(ВТ_Остатки.Остаток, 0) КАК Остаток,
	               |	ЕСТЬNULL(ВТ_Предоплаты.Предоплата, 0) КАК Предоплата
	               |ИЗ
	               |	ВТ_Остатки КАК ВТ_Остатки
	               |		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_Предоплаты КАК ВТ_Предоплаты
	               |		ПО ВТ_Остатки.Реализация = ВТ_Предоплаты.Реализация";
		
	ТаблицаПредоплат = Запрос.Выполнить().Выгрузить();
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПродажиОбороты.Номенклатура,
	               |	СУММА(ПродажиОбороты.КоличествоОборот) КАК Количество,
	               |	СУММА(ПродажиОбороты.СтоимостьОборот) КАК Сумма,
	               |	ПродажиОбороты.ДокументПродажи
	               |ПОМЕСТИТЬ ВТ_Товары
	               |ИЗ
	               |	РегистрНакопления.Продажи.Обороты(, &Дата, , ДокументПродажи В (&СписокРеализаций)) КАК ПродажиОбороты
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПродажиОбороты.Номенклатура,
	               |	ПродажиОбороты.ДокументПродажи
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Товары.Номенклатура,
	               |	ВТ_Товары.Количество,
	               |	ВТ_Товары.ДокументПродажи,
	               |	ВТ_Товары.Сумма,
	               |	ВТ_Товары.Сумма / ВТ_Товары.Количество КАК Цена
	               |ИЗ
	               |	ВТ_Товары КАК ВТ_Товары";
	
	ТаблицаТоваровПоРеализациям = Запрос.Выполнить().Выгрузить();
	
	Для каждого Стр ИЗ ПКООбъект.РасшифровкаПлатежа Цикл
		
		Если ТипЗнч(Стр.ДокументРасчетовСКонтрагентом) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			
			СтрПоиска = ТаблицаПредоплат.Найти(Стр.ДокументРасчетовСКонтрагентом, "Реализация");	
			
			Если СтрПоиска <> Неопределено Тогда
				
				//Если в ПКО погасили только часть остатка реализации, то это аванс
				Если СтрПоиска.Остаток <> Стр.СуммаВзаиморасчетов Тогда
					
					НСтр = ПКООбъект.ПозицииЧекККМ.Добавить();
					НСтр.Тип = Перечисления.ТипыПозицийЧекККМ.Аванс;
					НСтр.Количество = 1;
					НСтр.Цена = Стр.СуммаВзаиморасчетов;
					НСтр.Сумма = Стр.СуммаВзаиморасчетов;
					//+Гавриленков В. 05.12.2025 #UT10-5574
					//НСтр.СтавкаНДС = Перечисления.СтавкиНДС.НДС20; 
					НСтр.СтавкаНДС = ?(ПКООбъект.Дата >= Дата("20260101000000"), Перечисления.СтавкиНДС.НДС22, Перечисления.СтавкиНДС.НДС20);
					//-Гавриленков В. 05.12.2025 #UT10-5574
					
					//В ином случае получаем список товаров с учетом корректировок 
					//и добавляем предоплату если она есть чтобы закрыть сумму по товарам
				Иначе
					
					СтрокиПоиска = ТаблицаТоваровПоРеализациям.НайтиСтроки(Новый Структура("ДокументПродажи", Стр.ДокументРасчетовСКонтрагентом));
					
					ОстатокДляСписанияПоРеализации = СтрПоиска.Остаток;
					
					Для каждого СтрТовара ИЗ СтрокиПоиска Цикл
						
						//Данное условие введено для исключительных ситуаций у которых в релизации несколько
						//одинаковых товаров с разными ценами
						КоличествоРазрядов = СтрДлина(СтрТовара.Цена) - СтрДлина(Цел(СтрТовара.Цена)) - 1;
						
						Если КоличествоРазрядов > 2 Тогда
							
							ТаблицаТоваровПоиска = Стр.ДокументРасчетовСКонтрагентом.Товары.Выгрузить(Новый Структура("Номенклатура", СтрТовара.Номенклатура));
							
							Если ТаблицаТоваровПоиска.Итог("Сумма") = СтрТовара.Сумма Тогда
								
								Для каждого СтрТ Из ТаблицаТоваровПоиска Цикл
									
									НСтр = ПКООбъект.ПозицииЧекККМ.Добавить();
									НСтр.Тип = Перечисления.ТипыПозицийЧекККМ.Товар;
									НСтр.Позиция = СтрТ.Номенклатура;
									НСтр.Количество = СтрТ.Количество;
									НСтр.Цена = СтрТ.Цена;
									НСтр.Сумма = СтрТ.Сумма;
									НСтр.СтавкаНДС = Стр.СтавкаНДС; 
									
								КонецЦикла; 
								
							Иначе
								
								НСтр = ПКООбъект.ПозицииЧекККМ.Добавить();
								НСтр.Тип = Перечисления.ТипыПозицийЧекККМ.Товар;
								НСтр.Позиция = СтрТовара.Номенклатура;
								НСтр.Количество = СтрТовара.Количество;
								НСтр.Цена = СтрТовара.Цена;
								НСтр.Сумма = СтрТовара.Сумма;
								НСтр.СтавкаНДС = Стр.СтавкаНДС;
								
							КонецЕсли; 
							
						Иначе
							
							НСтр = ПКООбъект.ПозицииЧекККМ.Добавить();
							НСтр.Тип = Перечисления.ТипыПозицийЧекККМ.Товар;
							НСтр.Позиция = СтрТовара.Номенклатура;
							НСтр.Количество = СтрТовара.Количество;
							НСтр.Цена = СтрТовара.Цена;
							НСтр.Сумма = СтрТовара.Сумма;
							НСтр.СтавкаНДС = Стр.СтавкаНДС;
							
						КонецЕсли;
						
						ОстатокДляСписанияПоРеализации = ОстатокДляСписанияПоРеализации - СтрТовара.Сумма;
						
					КонецЦикла;
					
					//Бывает по реализации оформлена корректировка, но взаиморасчет списывается по другим реализацям
					//в этом случает будет висеть пустой взаиморасчет без товаров. Это будет аванс
					//возможно здесь стоит выводить не просто аванс, а товары погашенных реализаций (в случае если они полностью погашены)
					Если ОстатокДляСписанияПоРеализации > 0 Тогда
						
						НСтр = ПКООбъект.ПозицииЧекККМ.Добавить();
						НСтр.Тип = Перечисления.ТипыПозицийЧекККМ.Аванс;
						НСтр.Количество = 1;
						НСтр.Цена = ОстатокДляСписанияПоРеализации;
						НСтр.Сумма = ОстатокДляСписанияПоРеализации;
						//+Гавриленков В. 05.12.2025 #UT10-5574
						//НСтр.СтавкаНДС = Перечисления.СтавкиНДС.НДС20;
						НСтр.СтавкаНДС = ?(ПКООбъект.Дата >= Дата("20260101000000"), Перечисления.СтавкиНДС.НДС22, Перечисления.СтавкиНДС.НДС20);
						//-Гавриленков В. 05.12.2025 #UT10-5574
						
						ОстатокДляСписанияПоРеализации = 0;
						
						//В этом случае обнуляем предоплату, так как она не нужна чтобы покрыть 
						//стоимость всех товары, так как корректировка была не большую сумму
						СтрПоиска.Предоплата = 0;
						
					ИначеЕсли ОстатокДляСписанияПоРеализации = 0 Тогда
						
						СтрПоиска.Предоплата = 0;
						
					ИначеЕсли ОстатокДляСписанияПоРеализации < 0 Тогда
						
						СтрПоиска.Предоплата = ОстатокДляСписанияПоРеализации * -1;
						
					КонецЕсли;
					
					Если СтрПоиска.Предоплата > 0 Тогда
						
						НСтр = ПКООбъект.ОплатыЧекККМ.Добавить();
						НСтр.Тип = Перечисления.ТипыОплатЧекККМ.Предоплата;
						НСтр.Сумма = СтрПоиска.Предоплата;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
			//Если документом расчета не является реализация, то это аванс
		Иначе
			
			НСтр = ПКООбъект.ПозицииЧекККМ.Добавить();
			НСтр.Тип = Перечисления.ТипыПозицийЧекККМ.Аванс;
			НСтр.Количество = 1;
			НСтр.Цена = Стр.СуммаВзаиморасчетов;
			НСтр.Сумма = Стр.СуммаВзаиморасчетов; 
			//+Гавриленков В. 05.12.2025 #UT10-5574
			//НСтр.СтавкаНДС = Перечисления.СтавкиНДС.НДС20;
			НСтр.СтавкаНДС = ?(ПКООбъект.Дата >= Дата("20260101000000"), Перечисления.СтавкиНДС.НДС22, Перечисления.СтавкиНДС.НДС20);
			//-Гавриленков В. 05.12.2025 #UT10-5574
			
		КонецЕсли;
		
		НСтр = ПКООбъект.ОплатыЧекККМ.Добавить();
		НСтр.Тип = Перечисления.ТипыОплатЧекККМ.Наличные;
		НСтр.Сумма = Стр.СуммаВзаиморасчетов;
		
	КонецЦикла;
	
	ПКООбъект.ПозицииЧекККМ.Свернуть("Тип, Позиция, СтавкаНДС, Цена", "Количество, Сумма");
	ПКООбъект.ОплатыЧекККМ.Свернуть("Тип", "Сумма");
	
КонецПроцедуры

Процедура ЗаполнитьСоставЧекаККМДляРКО(РКООбъект) Экспорт
	
	РКООбъект.ПозицииЧекККМ.Очистить();
	РКООбъект.ОплатыЧекККМ.Очистить();	
	
	Для каждого Стр ИЗ РКООбъект.РасшифровкаПлатежа Цикл
		
		Если ЗначениеЗаполнено(Стр.ДокументРасчетовСКонтрагентом) Тогда
			
			Если ТипЗнч(Стр.ДокументРасчетовСКонтрагентом) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
				
				ОткорректированныеТовары = ПолучитьОткорректированныеТоварыПоРелизации(Стр.ДокументРасчетовСКонтрагентом);
				СуммаОткорректированных = ОткорректированныеТовары.Итог("Сумма");
				
				Если СуммаОткорректированных = Стр.СуммаВзаиморасчетов Тогда
					
					Для каждого СтрКор ИЗ ОткорректированныеТовары Цикл
						
						НСтр = РКООбъект.ПозицииЧекККМ.Добавить();
						НСтр.Тип = Перечисления.ТипыПозицийЧекККМ.Товар;
						ЗаполнитьЗначенияСвойств(НСтр, СтрКор);
						
					КонецЦикла;
					
				Иначе
					
					НСтр = РКООбъект.ПозицииЧекККМ.Добавить();
					НСтр.Тип = Перечисления.ТипыПозицийЧекККМ.Аванс;
					НСтр.Количество = 1;
					НСтр.Цена = Стр.СуммаВзаиморасчетов;
					НСтр.Сумма = Стр.СуммаВзаиморасчетов; 
					//+Гавриленков В. 05.12.2025 #UT10-5574
					//НСтр.СтавкаНДС = Перечисления.СтавкиНДС.НДС20;
					НСтр.СтавкаНДС = ?(РКООбъект.Дата >= Дата("20260101000000"), Перечисления.СтавкиНДС.НДС22, Перечисления.СтавкиНДС.НДС20);
					//-Гавриленков В. 05.12.2025 #UT10-5574
					
				КонецЕсли;
				
			ИначеЕсли ТипЗнч(Стр.ДокументРасчетовСКонтрагентом) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер") ИЛИ ТипЗнч(Стр.ДокументРасчетовСКонтрагентом) = Тип("ДокументСсылка.ПлатежноеПоручениеВходящее") Тогда
				
				НСтр = РКООбъект.ПозицииЧекККМ.Добавить();
				НСтр.Тип = Перечисления.ТипыПозицийЧекККМ.Аванс;
				НСтр.Количество = 1;
				НСтр.Цена = Стр.СуммаВзаиморасчетов;
				НСтр.Сумма = Стр.СуммаВзаиморасчетов;
				//+Гавриленков В. 05.12.2025 #UT10-5574
				//НСтр.СтавкаНДС = Перечисления.СтавкиНДС.НДС20; 
				НСтр.СтавкаНДС = ?(РКООбъект.Дата >= Дата("20260101000000"), Перечисления.СтавкиНДС.НДС22, Перечисления.СтавкиНДС.НДС20);
				//-Гавриленков В. 05.12.2025 #UT10-5574
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	НСтр = РКООбъект.ОплатыЧекККМ.Добавить();
	НСтр.Тип = Перечисления.ТипыОплатЧекККМ.Наличные;
	НСтр.Сумма = РКООбъект.СуммаДокумента;
			
	РКООбъект.ПозицииЧекККМ.Свернуть("Тип, Позиция, СтавкаНДС, Цена", "Количество, Сумма");
	РКООбъект.ОплатыЧекККМ.Свернуть("Тип", "Сумма");
	
КонецПроцедуры

Процедура ЗаполнитьСоставЧекаККМДляОПК_Оплата(ПКООбъект) Экспорт
	
	ПКООбъект.ПозицииЧекККМ.Очистить();
	ПКООбъект.ОплатыЧекККМ.Очистить();  
	
	//Если лицевой счет, то печатаем всю сумму на аванс
	Если ПлатежныйДокументЛицевойСчет(ПКООбъект) Тогда
		
		СуммаДокумента = ПКООбъект.СуммаДокумента;
		
		НСтр = ПКООбъект.ПозицииЧекККМ.Добавить();
		НСтр.Тип = Перечисления.ТипыПозицийЧекККМ.Аванс;
		НСтр.Количество = 1;
		НСтр.Цена = СуммаДокумента;
		НСтр.Сумма = СуммаДокумента; 
		//+Гавриленков В. 05.12.2025 #UT10-5574
		//НСтр.СтавкаНДС = Перечисления.СтавкиНДС.НДС20;
		НСтр.СтавкаНДС = ?(ПКООбъект.Дата >= Дата("20260101000000"), Перечисления.СтавкиНДС.НДС22, Перечисления.СтавкиНДС.НДС20);
		//-Гавриленков В. 05.12.2025 #UT10-5574
		
		НСтр = ПКООбъект.ОплатыЧекККМ.Добавить();
		НСтр.Тип = Перечисления.ТипыОплатЧекККМ.Безналичные;
		НСтр.Сумма = СуммаДокумента;
		
		Возврат;	                         
		
	КонецЕсли;
	
	СписокРеализаций = Новый СписокЗначений;
	
	Для каждого Стр ИЗ ПКООбъект.РасшифровкаПлатежа Цикл
		
		Если ТипЗнч(Стр.ДокументРасчетовСКонтрагентом) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			СписокРеализаций.Добавить(Стр.ДокументРасчетовСКонтрагентом);	
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СписокРеализаций", СписокРеализаций);
	
	Если ПКООбъект.Проведен Тогда
		
		МоментСразуПередДокументом = Новый Граница(ПКООбъект.Ссылка.МоментВремени(), ВидГраницы.Исключая);
		Запрос.УстановитьПараметр("Дата", МоментСразуПередДокументом); 
		
	Иначе
		Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	КонецЕсли;
	
		Запрос.Текст = "ВЫБРАТЬ
	               |	СУММА(ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстатки.СуммаВзаиморасчетовОстаток) КАК Остаток,
	               |	ВЫРАЗИТЬ(ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстатки.ДокументРасчетовСКонтрагентом КАК Документ.РеализацияТоваровУслуг).Ссылка КАК Реализация
	               |ПОМЕСТИТЬ ВТ_Остатки
	               |ИЗ
	               |	РегистрНакопления.ВзаиморасчетыСКонтрагентамиПоДокументамРасчетов.Остатки(&Дата, ДокументРасчетовСКонтрагентом В (&СписокРеализаций)) КАК ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстатки
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВЫРАЗИТЬ(ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстатки.ДокументРасчетовСКонтрагентом КАК Документ.РеализацияТоваровУслуг).Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СУММА(ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОбороты.СуммаВзаиморасчетовРасход) КАК Оплата,
	               |	ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОбороты.ДокументРасчетовСКонтрагентом КАК Реализация
	               |ПОМЕСТИТЬ ВТ_Оплаты
	               |ИЗ
	               |	РегистрНакопления.ВзаиморасчетыСКонтрагентамиПоДокументамРасчетов.Обороты(, &Дата, Регистратор, ДокументРасчетовСКонтрагентом В (&СписокРеализаций)) КАК ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОбороты
	               |ГДЕ
	               |	(ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОбороты.Регистратор ССЫЛКА Документ.ПриходныйКассовыйОрдер
	               |			ИЛИ ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОбороты.Регистратор ССЫЛКА Документ.ПлатежноеПоручениеВходящее)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОбороты.ДокументРасчетовСКонтрагентом
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СУММА(ВложенныйЗапрос.Предоплата) КАК Предоплата,
	               |	ВложенныйЗапрос.Реализация КАК Реализация
	               |ПОМЕСТИТЬ ВТ_Предоплаты
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		СУММА(РеализацияТоваровУслугДокументыРасчетовСКонтрагентом.СуммаВзаиморасчетов) КАК Предоплата,
	               |		РеализацияТоваровУслугДокументыРасчетовСКонтрагентом.Ссылка КАК Реализация
	               |	ИЗ
	               |		Документ.РеализацияТоваровУслуг.ДокументыРасчетовСКонтрагентом КАК РеализацияТоваровУслугДокументыРасчетовСКонтрагентом
	               |	ГДЕ
	               |		РеализацияТоваровУслугДокументыРасчетовСКонтрагентом.Ссылка В(&СписокРеализаций)
	               |		И РеализацияТоваровУслугДокументыРасчетовСКонтрагентом.Ссылка.Проведен
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		РеализацияТоваровУслугДокументыРасчетовСКонтрагентом.Ссылка
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		СУММА(ВТ_Оплаты.Оплата),
	               |		ВТ_Оплаты.Реализация
	               |	ИЗ
	               |		ВТ_Оплаты КАК ВТ_Оплаты
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		ВТ_Оплаты.Реализация
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		КорректировкаРеализацииДокументыРасчетовСКонтрагентом.СуммаВзаиморасчетов,
	               |		КорректировкаРеализацииДокументыРасчетовСКонтрагентом.ДокументРасчетовСКонтрагентом
	               |	ИЗ
	               |		Документ.КорректировкаРеализации.ДокументыРасчетовСКонтрагентом КАК КорректировкаРеализацииДокументыРасчетовСКонтрагентом
	               |	ГДЕ
	               |		КорректировкаРеализацииДокументыРасчетовСКонтрагентом.ДокументРасчетовСКонтрагентом В(&СписокРеализаций)
	               |		И КорректировкаРеализацииДокументыРасчетовСКонтрагентом.Ссылка.Проведен
	               |		И КорректировкаРеализацииДокументыРасчетовСКонтрагентом.ДокументРасчетовСКонтрагентом <> КорректировкаРеализацииДокументыРасчетовСКонтрагентом.Ссылка.ДокументРеализации) КАК ВложенныйЗапрос
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВложенныйЗапрос.Реализация
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Остатки.Реализация,
	               |	ЕСТЬNULL(ВТ_Остатки.Остаток, 0) КАК Остаток,
	               |	ЕСТЬNULL(ВТ_Предоплаты.Предоплата, 0) КАК Предоплата
	               |ИЗ
	               |	ВТ_Остатки КАК ВТ_Остатки
	               |		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_Предоплаты КАК ВТ_Предоплаты
	               |		ПО ВТ_Остатки.Реализация = ВТ_Предоплаты.Реализация";
		
	ТаблицаПредоплат = Запрос.Выполнить().Выгрузить();
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПродажиОбороты.Номенклатура,
	               |	СУММА(ПродажиОбороты.КоличествоОборот) КАК Количество,
	               |	СУММА(ПродажиОбороты.СтоимостьОборот) КАК Сумма,
	               |	ПродажиОбороты.ДокументПродажи
	               |ПОМЕСТИТЬ ВТ_Товары
	               |ИЗ
	               |	РегистрНакопления.Продажи.Обороты(, &Дата, , ДокументПродажи В (&СписокРеализаций)) КАК ПродажиОбороты
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПродажиОбороты.Номенклатура,
	               |	ПродажиОбороты.ДокументПродажи
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Товары.Номенклатура,
	               |	ВТ_Товары.Количество,
	               |	ВТ_Товары.ДокументПродажи,
	               |	ВТ_Товары.Сумма,
	               |	ВТ_Товары.Сумма / ВТ_Товары.Количество КАК Цена
	               |ИЗ
	               |	ВТ_Товары КАК ВТ_Товары";
	
	ТаблицаТоваровПоРеализациям = Запрос.Выполнить().Выгрузить();
	
	Для каждого Стр ИЗ ПКООбъект.РасшифровкаПлатежа Цикл
		
		Если ТипЗнч(Стр.ДокументРасчетовСКонтрагентом) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			
			СтрПоиска = ТаблицаПредоплат.Найти(Стр.ДокументРасчетовСКонтрагентом, "Реализация");	
			
			Если СтрПоиска <> Неопределено Тогда
				
				//Если в ПКО погасили только часть остатка реализации, то это аванс
				Если СтрПоиска.Остаток <> Стр.СуммаВзаиморасчетов Тогда
					
					НСтр = ПКООбъект.ПозицииЧекККМ.Добавить();
					НСтр.Тип = Перечисления.ТипыПозицийЧекККМ.Аванс;
					НСтр.Количество = 1;
					НСтр.Цена = Стр.СуммаВзаиморасчетов;
					НСтр.Сумма = Стр.СуммаВзаиморасчетов;
					//+Гавриленков В. 05.12.2025 #UT10-5574
					//НСтр.СтавкаНДС = Перечисления.СтавкиНДС.НДС20;
					НСтр.СтавкаНДС = ?(ПКООбъект.Дата >= Дата("20260101000000"), Перечисления.СтавкиНДС.НДС22, Перечисления.СтавкиНДС.НДС20);
					//-Гавриленков В. 05.12.2025 #UT10-5574
					
					//В ином случае получаем список товаров с учетом корректировок 
					//и добавляем предоплату если она есть чтобы закрыть сумму по товарам
				Иначе
					
					СтрокиПоиска = ТаблицаТоваровПоРеализациям.НайтиСтроки(Новый Структура("ДокументПродажи", Стр.ДокументРасчетовСКонтрагентом));
					
					ОстатокДляСписанияПоРеализации = СтрПоиска.Остаток;
					
					Для каждого СтрТовара ИЗ СтрокиПоиска Цикл
						
						//Данное условие введено для исключительных ситуаций у которых в релизации несколько
						//одинаковых товаров с разными ценами
						КоличествоРазрядов = СтрДлина(СтрТовара.Цена) - СтрДлина(Цел(СтрТовара.Цена)) - 1;
						
						Если КоличествоРазрядов > 2 Тогда
							
							ТаблицаТоваровПоиска = Стр.ДокументРасчетовСКонтрагентом.Товары.Выгрузить(Новый Структура("Номенклатура", СтрТовара.Номенклатура));
							
							Если ТаблицаТоваровПоиска.Итог("Сумма") = СтрТовара.Сумма Тогда
								
								Для каждого СтрТ Из ТаблицаТоваровПоиска Цикл
									
									НСтр = ПКООбъект.ПозицииЧекККМ.Добавить();
									НСтр.Тип = Перечисления.ТипыПозицийЧекККМ.Товар;
									НСтр.Позиция = СтрТ.Номенклатура;
									НСтр.Количество = СтрТ.Количество;
									НСтр.Цена = СтрТ.Цена;
									НСтр.Сумма = СтрТ.Сумма;
									НСтр.СтавкаНДС = Стр.СтавкаНДС; 
									
								КонецЦикла; 
								
							КонецЕсли; 
							
						Иначе
							
							НСтр = ПКООбъект.ПозицииЧекККМ.Добавить();
							НСтр.Тип = Перечисления.ТипыПозицийЧекККМ.Товар;
							НСтр.Позиция = СтрТовара.Номенклатура;
							НСтр.Количество = СтрТовара.Количество;
							НСтр.Цена = СтрТовара.Цена;
							НСтр.Сумма = СтрТовара.Сумма;
							НСтр.СтавкаНДС = Стр.СтавкаНДС;
							
						КонецЕсли;
						
						ОстатокДляСписанияПоРеализации = ОстатокДляСписанияПоРеализации - СтрТовара.Сумма;
						
					КонецЦикла;
					
					//Бывает по реализации оформлена корректировка, но взаиморасчет списывается по другим реализацям
					//в этом случает будет висеть пустой взаиморасчет без товаров. Это будет аванс
					//возможно здесь стоит выводить не просто аванс, а товары погашенных реализаций (в случае если они полностью погашены)
					Если ОстатокДляСписанияПоРеализации > 0 Тогда
						
						НСтр = ПКООбъект.ПозицииЧекККМ.Добавить();
						НСтр.Тип = Перечисления.ТипыПозицийЧекККМ.Аванс;
						НСтр.Количество = 1;
						НСтр.Цена = ОстатокДляСписанияПоРеализации;
						НСтр.Сумма = ОстатокДляСписанияПоРеализации; 
						//+Гавриленков В. 05.12.2025 #UT10-5574
						//НСтр.СтавкаНДС = Перечисления.СтавкиНДС.НДС20;
						НСтр.СтавкаНДС = ?(ПКООбъект.Дата >= Дата("20260101000000"), Перечисления.СтавкиНДС.НДС22, Перечисления.СтавкиНДС.НДС20);
						//-Гавриленков В. 05.12.2025 #UT10-5574
						
						ОстатокДляСписанияПоРеализации = 0;
						
						//В этом случае обнуляем предоплату, так как она не нужна чтобы покрыть 
						//стоимость всех товары, так как корректировка была не большую сумму
						СтрПоиска.Предоплата = 0;
						
					ИначеЕсли ОстатокДляСписанияПоРеализации = 0 Тогда
						
						СтрПоиска.Предоплата = 0;
						
					ИначеЕсли ОстатокДляСписанияПоРеализации < 0 Тогда
						
						СтрПоиска.Предоплата = ОстатокДляСписанияПоРеализации * -1;
						
					КонецЕсли;
					
					Если СтрПоиска.Предоплата > 0 Тогда
						
						НСтр = ПКООбъект.ОплатыЧекККМ.Добавить();
						НСтр.Тип = Перечисления.ТипыОплатЧекККМ.Предоплата;
						НСтр.Сумма = СтрПоиска.Предоплата;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
			//Если документом расчета не является реализация, то это аванс
		Иначе
			
			НСтр = ПКООбъект.ПозицииЧекККМ.Добавить();
			НСтр.Тип = Перечисления.ТипыПозицийЧекККМ.Аванс;
			НСтр.Количество = 1;
			НСтр.Цена = Стр.СуммаВзаиморасчетов;
			НСтр.Сумма = Стр.СуммаВзаиморасчетов; 
			//+Гавриленков В. 05.12.2025 #UT10-5574
			//НСтр.СтавкаНДС = Перечисления.СтавкиНДС.НДС20; 
			НСтр.СтавкаНДС = ?(ПКООбъект.Дата >= Дата("20260101000000"), Перечисления.СтавкиНДС.НДС22, Перечисления.СтавкиНДС.НДС20);
			//-Гавриленков В. 05.12.2025 #UT10-5574
			
		КонецЕсли;
		
		НСтр = ПКООбъект.ОплатыЧекККМ.Добавить();
		НСтр.Тип = Перечисления.ТипыОплатЧекККМ.Безналичные;
		НСтр.Сумма = Стр.СуммаВзаиморасчетов;
		
	КонецЦикла;
	
	ПКООбъект.ПозицииЧекККМ.Свернуть("Тип, Позиция, СтавкаНДС, Цена", "Количество, Сумма");
	ПКООбъект.ОплатыЧекККМ.Свернуть("Тип", "Сумма");
	
КонецПроцедуры

Процедура ЗаполнитьСоставЧекаККМДляОПК_Возврат(РКООбъект) Экспорт
	
	РКООбъект.ПозицииЧекККМ.Очистить();
	РКООбъект.ОплатыЧекККМ.Очистить();	
	
	Для каждого Стр ИЗ РКООбъект.РасшифровкаПлатежа Цикл
		
		Если ЗначениеЗаполнено(Стр.ДокументРасчетовСКонтрагентом) Тогда
			
			Если ТипЗнч(Стр.ДокументРасчетовСКонтрагентом) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
				
				ОткорректированныеТовары = ПолучитьОткорректированныеТоварыПоРелизацииОПК(Стр.ДокументРасчетовСКонтрагентом);
				СуммаОткорректированных = ОткорректированныеТовары.Итог("Сумма");
				
				Если СуммаОткорректированных = Стр.СуммаВзаиморасчетов Тогда
					
					Для каждого СтрКор ИЗ ОткорректированныеТовары Цикл
						
						НСтр = РКООбъект.ПозицииЧекККМ.Добавить();
						НСтр.Тип = Перечисления.ТипыПозицийЧекККМ.Товар;
						ЗаполнитьЗначенияСвойств(НСтр, СтрКор);
											
					КонецЦикла;
					
				Иначе
					
					НСтр = РКООбъект.ПозицииЧекККМ.Добавить();
					НСтр.Тип = Перечисления.ТипыПозицийЧекККМ.Аванс;
					НСтр.Количество = 1;
					НСтр.Цена = Стр.СуммаВзаиморасчетов;
					НСтр.Сумма = Стр.СуммаВзаиморасчетов; 
					//+Гавриленков В. 05.12.2025 #UT10-5574
					//НСтр.СтавкаНДС = Перечисления.СтавкиНДС.НДС20;
					НСтр.СтавкаНДС = ?(РКООбъект.Дата >= Дата("20260101000000"), Перечисления.СтавкиНДС.НДС22, Перечисления.СтавкиНДС.НДС20);
					//-Гавриленков В. 05.12.2025 #UT10-5574
					
				КонецЕсли;
				
			ИначеЕсли ТипЗнч(Стр.ДокументРасчетовСКонтрагентом) = Тип("ДокументСсылка.ОплатаОтПокупателяПлатежнойКартой") Тогда
				
				НСтр = РКООбъект.ПозицииЧекККМ.Добавить();
				НСтр.Тип = Перечисления.ТипыПозицийЧекККМ.Аванс;
				НСтр.Количество = 1;
				НСтр.Цена = Стр.СуммаВзаиморасчетов;
				НСтр.Сумма = Стр.СуммаВзаиморасчетов;  
				//+Гавриленков В. 05.12.2025 #UT10-5574
				//НСтр.СтавкаНДС = Перечисления.СтавкиНДС.НДС20; 
				НСтр.СтавкаНДС = ?(РКООбъект.Дата >= Дата("20260101000000"), Перечисления.СтавкиНДС.НДС22, Перечисления.СтавкиНДС.НДС20);
				//-Гавриленков В. 05.12.2025 #UT10-5574
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	НСтр = РКООбъект.ОплатыЧекККМ.Добавить();
	НСтр.Тип = Перечисления.ТипыОплатЧекККМ.Безналичные;
	НСтр.Сумма = РКООбъект.СуммаДокумента;
			
	РКООбъект.ПозицииЧекККМ.Свернуть("Тип, Позиция, СтавкаНДС, Цена", "Количество, Сумма");
	РКООбъект.ОплатыЧекККМ.Свернуть("Тип", "Сумма");
	
КонецПроцедуры

Процедура ЗаполнитьСоставЧекаККМДляРеализации(РеализацияОбъект) Экспорт
	
	РеализацияОбъект.ПозицииЧекККМ.Очистить();
	РеализацияОбъект.ОплатыЧекККМ.Очистить(); 
	
	Для каждого СтрТ Из РеализацияОбъект.Товары Цикл
		
		НСтр = РеализацияОбъект.ПозицииЧекККМ.Добавить();
		НСтр.Тип = Перечисления.ТипыПозицийЧекККМ.Товар;
		НСтр.Позиция = СтрТ.Номенклатура;
		НСтр.Количество = СтрТ.Количество;
		НСтр.Цена = СтрТ.Цена;
		НСтр.Сумма = СтрТ.Сумма;
		НСтр.СтавкаНДС = СтрТ.СтавкаНДС; 
		
	КонецЦикла; 
	
	НСтр = РеализацияОбъект.ОплатыЧекККМ.Добавить();
	НСтр.Тип = Перечисления.ТипыОплатЧекККМ.Предоплата;
	НСтр.Сумма = РеализацияОбъект.СуммаДокумента;	
	
	РеализацияОбъект.ПозицииЧекККМ.Свернуть("Тип, Позиция, СтавкаНДС, Цена", "Количество, Сумма");
	РеализацияОбъект.ОплатыЧекККМ.Свернуть("Тип", "Сумма");   
	
	//+Белов А. 13.11.2024 #UT10-4894
	РеализацияОбъект.ДополнительныеСвойства.Вставить("НеВыполнятьПроверкуНаДатыЗапрета", Истина);
	//-Белов А. 13.11.2024 #UT10-4894
	
КонецПроцедуры

Процедура ЗаполнитьСоставЧекаККМДляКорректировкиРеализации(КорректировкаОбъект) Экспорт
	
	КорректировкаОбъект.ПозицииЧекККМ.Очистить();
	КорректировкаОбъект.ОплатыЧекККМ.Очистить(); 
	
	СуммаСкорректирована = 0;
	
	Для каждого СтрТ Из КорректировкаОбъект.Товары Цикл
		
		Если Не СтрТ.Количество < СтрТ.КоличествоДоИзменения Тогда
			Продолжить;			
		КонецЕсли;
		
		НСтр = КорректировкаОбъект.ПозицииЧекККМ.Добавить();
		НСтр.Тип = Перечисления.ТипыПозицийЧекККМ.Товар;
		НСтр.Позиция = СтрТ.Номенклатура;
		НСтр.Количество = СтрТ.КоличествоДоИзменения - СтрТ.Количество;
		НСтр.Цена = СтрТ.ЦенаДоИзменения;
		НСтр.Сумма = НСтр.Цена * НСтр.Количество;
		НСтр.СтавкаНДС = СтрТ.СтавкаНДСДоИзменения; 
		
		СуммаСкорректирована = СуммаСкорректирована + НСтр.Сумма;
		
	КонецЦикла; 
	
	НСтр = КорректировкаОбъект.ОплатыЧекККМ.Добавить();
	НСтр.Тип = Перечисления.ТипыОплатЧекККМ.Предоплата;
	НСтр.Сумма = СуммаСкорректирована;	
	
	КорректировкаОбъект.ПозицииЧекККМ.Свернуть("Тип, Позиция, СтавкаНДС, Цена", "Количество, Сумма");
	КорректировкаОбъект.ОплатыЧекККМ.Свернуть("Тип", "Сумма");
	
КонецПроцедуры

Функция ПоверитьКорректностьЗаполненияОПК_Возврат(Объект) Экспорт
	
	СтруктураВозврата = Новый Структура("Результат, Сообщение", Ложь, "");
	
	СписокРеализаций = Новый СписокЗначений;
	СписокПриходников = Новый СписокЗначений;
	СписокИныхДокументов = Новый СписокЗначений;
	
	ТЗРасшифровка = Объект.РасшифровкаПлатежа.Выгрузить();
	ТЗРасшифровка.Свернуть("ДокументРасчетовСКонтрагентом");
	
	Для каждого Стр ИЗ ТЗРасшифровка Цикл
		
		Если ЗначениеЗаполнено(Стр.ДокументРасчетовСКонтрагентом) Тогда
			
			Если ТипЗнч(Стр.ДокументРасчетовСКонтрагентом) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
				СписокРеализаций.Добавить(Стр.ДокументРасчетовСКонтрагентом);
			ИначеЕсли ТипЗнч(Стр.ДокументРасчетовСКонтрагентом) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер") 
				ИЛИ ТипЗнч(Стр.ДокументРасчетовСКонтрагентом) = Тип("ДокументСсылка.ПлатежноеПоручениеВходящее")
				ИЛИ ТипЗнч(Стр.ДокументРасчетовСКонтрагентом) = Тип("ДокументСсылка.ОплатаОтПокупателяПлатежнойКартой") Тогда
				СписокПриходников.Добавить(Стр.ДокументРасчетовСКонтрагентом);
			Иначе
				СписокИныхДокументов.Добавить(Стр.ДокументРасчетовСКонтрагентом);
			КонецЕсли;
			
		Иначе
			
			СтруктураВозврата.Сообщение = "Обнаружены строки без заполненного реквизита 'Документ расчета с контрагентом'";
			Возврат СтруктураВозврата;
		
		КонецЕсли;
		
	КонецЦикла;
	
	Если СписокИныхДокументов.Количество() > 0 Тогда
		
		СтруктураВозврата.Сообщение = "В качестве документов расчетов с контрагентом обнаружены документы, печать которых не предусмотрена системой!";
		Возврат СтруктураВозврата;
		
	КонецЕсли;
			
	СтруктураВозврата.Результат = Истина;
	
	Возврат СтруктураВозврата;
	
КонецФункции

Функция ПоверитьКорректностьЗаполненияРеализации(Объект, МассивСсылок = Неопределено) Экспорт
//+Гавриленков В. 31.05.2025 #UT10-5251 добавлен параметр МассивОбъектов	
	
	Если МассивСсылок = Неопределено Тогда
		
		СтруктураВозврата = Новый Структура("Результат, Сообщение", Истина, "");
		
		Если Не Объект.Проведен Тогда 
			
			СтруктураВозврата.Результат = Ложь;
			СтруктураВозврата.Сообщение = "Документ не проведен";
			
		ИначеЕсли Не Объект.ДоговорКонтрагента.ЛицевойСчет Тогда 
			
			СтруктураВозврата.Результат = Ложь;
			СтруктураВозврата.Сообщение = "В договоре у контрагента не установлен признак Лицевой счет"; 
			
		//+Белов А. 22.01.2026 #UT10-5638
		//ИначеЕсли Объект.ДокументыРасчетовСКонтрагентом.Итог("СуммаВзаиморасчетов") <> Объект.СуммаДокумента И Не ВсяРеализацияПогашена(Объект.Ссылка) Тогда
		//Если галка КонтролироватьВзаиморасчетыЧерезСистемуБиллинг стоит, то делаем отложенную печать	
		ИначеЕсли Не Объект.ДоговорКонтрагента.КонтролироватьВзаиморасчетыЧерезСистемуБиллинг И Объект.ДокументыРасчетовСКонтрагентом.Итог("СуммаВзаиморасчетов") <> Объект.СуммаДокумента И Не ВсяРеализацияПогашена(Объект.Ссылка) Тогда
		//-Белов А. 22.01.2026 #UT10-5638	
				
			СтруктураВозврата.Результат = Ложь;
			СтруктураВозврата.Сообщение = "Сумма предоплаты по документу не равна сумме документа";
			
			//+Белов А. 10.10.2024 #UT10-4803
		ИначеЕсли ВсяРеализацияСкорректирована(Объект.Ссылка) Тогда
			
			СтруктураВозврата.Результат = Ложь;
			СтруктураВозврата.Сообщение = "Вся реализация была скорректирована";
			
			//-Белов А. 10.10.2024 #UT10-4803
		КонецЕсли;
		
		Возврат СтруктураВозврата;    
		
	//+Гавриленков В. 31.05.2025 #UT10-5251	
	Иначе      
		
		сч = 0;
		Пока сч < МассивСсылок.Количество() Цикл 
			
			Объект = МассивСсылок.Получить(сч);
			
			Если (Не Объект.Проведен)
				ИЛИ (Не Объект.ДоговорКонтрагента.ЛицевойСчет)
				//+Белов А. 22.01.2026 #UT10-5638
				//Или (Объект.ДокументыРасчетовСКонтрагентом.Итог("СуммаВзаиморасчетов") <> Объект.СуммаДокумента И Не ВсяРеализацияПогашена(Объект.Ссылка)) Тогда 
				//Если галка КонтролироватьВзаиморасчетыЧерезСистемуБиллинг стоит, то делаем отложенную печать
				ИЛИ (Не Объект.ДоговорКонтрагента.КонтролироватьВзаиморасчетыЧерезСистемуБиллинг И Объект.ДокументыРасчетовСКонтрагентом.Итог("СуммаВзаиморасчетов") <> Объект.СуммаДокумента И Не ВсяРеализацияПогашена(Объект.Ссылка)) Тогда 
				//-Белов А. 22.01.2026 #UT10-5638		
				
				МассивСсылок.Удалить(сч);
				
			Иначе
				 сч = сч + 1;
			КонецЕсли;	
				
		КонецЦикла;
		
		РезультатПроверки = ВсяРеализацияСкорректирована(Неопределено, МассивСсылок);
		
		Возврат РезультатПроверки;
		
	КонецЕсли;
		
КонецФункции

Функция ПоверитьКорректностьЗаполненияКорректировкиРеализации(Объект) Экспорт
	
	СтруктураВозврата = Новый Структура("Результат, Сообщение", Истина, "");
	
	Если Не Объект.ДоговорКонтрагента.ЛицевойСчет Тогда
		
		СтруктураВозврата.Результат = Ложь;
		СтруктураВозврата.Сообщение = "В договоре у контрагента не установлен признак Лицевой счет";    
		
	Иначе 
		
		Реализация = ПолучитьРеализациюПоКорректировке(Объект);                   
		СтатусЗаданияПечати = Чеки.ПолучитьСтатусЗаданияПечатиПКО(Реализация);
		
		Если Не ЗначениеЗаполнено(СтатусЗаданияПечати) Тогда
			
			//+Белов А. 22.01.2026 #UT10-5638 реализации у нас будут печататься в отложенном режиме
			СтруктураВозврата.Результат = Ложь;
			СтруктураВозврата.Сообщение = "Нет задания на печать реализации";
			//Если Не ЗначениеЗаполнено(Реализация.НомерЧекаККМ) Тогда
			//	
			//	СтруктураВозврата.Результат = Ложь;
			//	СтруктураВозврата.Сообщение = "Нет задания на печать реализации и номера чека";
			//	
			//КонецЕсли;   
			//-Белов А. 22.01.2026 #UT10-5638
			
		КонецЕсли;                                                                                  
	
	КонецЕсли;
	
	Возврат СтруктураВозврата;
		
КонецФункции

Функция ВсяРеализацияПогашена(Реализация)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстатки.СуммаВзаиморасчетовОстаток
	|ИЗ
	|	РегистрНакопления.ВзаиморасчетыСКонтрагентамиПоДокументамРасчетов.Остатки(, ДокументРасчетовСКонтрагентом = &Реализация) КАК ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстатки";
	
	Запрос.УстановитьПараметр("Реализация", Реализация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Если Выборка.СуммаВзаиморасчетовОстаток = 0 Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Истина;
		
КонецФункции

Функция ВсяРеализацияСкорректирована(Реализация, МассивРеализаций = Неопределено)  
//+Гавриленков В. 31.05.2025 #UT10-5251 добавлен параметр МассивРеализаций)
	
	Если МассивРеализаций = Неопределено Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОбороты.Регистратор КАК Корректировка
		|ПОМЕСТИТЬ ВТ_КорректировкиРеализации
		|ИЗ
		|	РегистрНакопления.ВзаиморасчетыСКонтрагентамиПоДокументамРасчетов.Обороты(, , Регистратор, ДокументРасчетовСКонтрагентом = &Реализация) КАК ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОбороты
		|ГДЕ
		|	ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОбороты.Регистратор ССЫЛКА Документ.КорректировкаРеализации
		|	И ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОбороты.Регистратор.ДокументРеализации = ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОбороты.ДокументРасчетовСКонтрагентом
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(ЕСТЬNULL(КорректировкаРеализацииТовары.КоличествоДоКорректировки - КорректировкаРеализацииТовары.Количество, 0) * -1) КАК КоличествоСкорректировано
		|ИЗ
		|	Документ.КорректировкаРеализации.Товары КАК КорректировкаРеализацииТовары
		|ГДЕ
		|	КорректировкаРеализацииТовары.Ссылка В
		|			(ВЫБРАТЬ
		|				ВТ_КорректировкиРеализации.Корректировка
		|			ИЗ
		|				ВТ_КорректировкиРеализации)";
		
		Запрос.УстановитьПараметр("Реализация", Реализация);  
		
		КоличествоСкорректировано = 0;
		
		Выборка = Запрос.Выполнить().Выбрать();           
		
		Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.КоличествоСкорректировано) Тогда
			
			КоличествоСкорректировано = Выборка.КоличествоСкорректировано;	
			
			Если КоличествоСкорректировано * -1 = Реализация.Товары.Итог("Количество") Тогда
				Возврат Истина;
			КонецЕсли;
			
		КонецЕсли;	           
		
		Возврат Ложь;
		
	Иначе     
		
		Соответствие = Новый Соответствие;  
		
		Если МассивРеализаций.Количество() = 0 Тогда
			Возврат Соответствие;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОбороты.Регистратор КАК Корректировка
		|ПОМЕСТИТЬ ВТ_КорректировкиРеализации
		|ИЗ
		|	РегистрНакопления.ВзаиморасчетыСКонтрагентамиПоДокументамРасчетов.Обороты(, , Регистратор, ДокументРасчетовСКонтрагентом В (&МассивРеализаций)) КАК ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОбороты
		|ГДЕ
		|	ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОбороты.Регистратор ССЫЛКА Документ.КорректировкаРеализации
		|	И ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОбороты.Регистратор.ДокументРеализации = ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОбороты.ДокументРасчетовСКонтрагентом
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(ЕСТЬNULL(КорректировкаРеализацииТовары.КоличествоДоКорректировки - КорректировкаРеализацииТовары.Количество, 0) * -1) КАК КоличествоСкорректировано,
		|	КорректировкаРеализацииТовары.Ссылка.ДокументРеализации КАК ДокументРеализации
		|ИЗ
		|	Документ.КорректировкаРеализации.Товары КАК КорректировкаРеализацииТовары
		|ГДЕ
		|	КорректировкаРеализацииТовары.Ссылка В
		|			(ВЫБРАТЬ
		|				ВТ_КорректировкиРеализации.Корректировка
		|			ИЗ
		|				ВТ_КорректировкиРеализации)
		|
		|СГРУППИРОВАТЬ ПО
		|	КорректировкаРеализацииТовары.Ссылка.ДокументРеализации";
		
		Запрос.УстановитьПараметр("МассивРеализаций", МассивРеализаций);  
		
		Таб = Запрос.Выполнить().Выгрузить();
		
		Для Каждого Реализация Из МассивРеализаций Цикл 
			
			НайденнаяСтрока = Таб.Найти(Реализация, "ДокументРеализации");  
			
			Если НайденнаяСтрока <> Неопределено И ЗначениеЗаполнено(НайденнаяСтрока.КоличествоСкорректировано) Тогда
				
				Если НайденнаяСтрока.КоличествоСкорректировано * -1 = Реализация.Товары.Итог("Количество") Тогда
					
					Соответствие.Вставить(Реализация, Ложь);
					Продолжить;
					
				КонецЕсли;
				
			КонецЕсли;
			
			Соответствие.Вставить(Реализация, Истина);
			
		КонецЦикла; 
		
		Возврат Соответствие;
		
	КонецЕсли;
	
КонецФункции

Функция ПолучитьОткорректированныеТоварыПоРелизацииОПК(Реализация)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	МИНИМУМ(ЗапросДатПлатежныхДокументов.Дата) КАК МинимальнаяДатаВводаПлатежногоДокумента
	               |ПОМЕСТИТЬ ВТ_Дата
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ОплатаОтПокупателяПлатежнойКартойРасшифровкаПлатежа.Ссылка.Дата КАК Дата
	               |	ИЗ
	               |		Документ.ОплатаОтПокупателяПлатежнойКартой.РасшифровкаПлатежа КАК ОплатаОтПокупателяПлатежнойКартойРасшифровкаПлатежа
	               |	ГДЕ
	               |		ОплатаОтПокупателяПлатежнойКартойРасшифровкаПлатежа.ДокументРасчетовСКонтрагентом = &Реализация
	               |		И ОплатаОтПокупателяПлатежнойКартойРасшифровкаПлатежа.Ссылка.Проведен) КАК ЗапросДатПлатежныхДокументов
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПродажиОбороты.Номенклатура КАК Позиция,
	               |	ПродажиОбороты.КоличествоОборот * -1 КАК Количество,
	               |	ПродажиОбороты.СтоимостьОборот * -1 КАК Сумма,
	               |	ПродажиОбороты.СтоимостьОборот / ПродажиОбороты.КоличествоОборот КАК Цена,
				   //+Гавриленков В. 05.12.2025 #UT10-5574 ВременноеУсловиеСтавкиНДС
				   //|	ВЫБОР 
				   //|		КОГДА ПродажиОбороты.Номенклатура.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка)
				   //|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС20)
				   //|		ИНАЧЕ ПродажиОбороты.Номенклатура.СтавкаНДС
				   //|	КОНЕЦ КАК СтавкаНДС 
				   |	ВЫБОР
				   |		КОГДА ПродажиОбороты.Период >= &ДатаСтавкиНДС
		           |			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС22)
				   |		ИНАЧЕ ВЫБОР
				   |			КОГДА ПродажиОбороты.Номенклатура.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка)
				   |				ТОГДА ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС20)
				   |			ИНАЧЕ ПродажиОбороты.Номенклатура.СтавкаНДС
				   |		КОНЕЦ
				   |	КОНЕЦ КАК СтавкаНДС
				   //-Гавриленков В. 05.12.2025 #UT10-5574
	               |ИЗ
	               |	ВТ_Дата КАК ВТ_Дата
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.Продажи.Обороты(, , Регистратор, ДокументПродажи = &Реализация) КАК ПродажиОбороты
	               |		ПО (ПродажиОбороты.Период >= ВТ_Дата.МинимальнаяДатаВводаПлатежногоДокумента)
	               |ГДЕ
	               |	ПродажиОбороты.КоличествоОборот < 0";  
	
	//+Гавриленков В. 05.12.2025 #UT10-5574
	Запрос.УстановитьПараметр("ДатаСтавкиНДС", Дата("20260101000000"));
	//-Гавриленков В. 05.12.2025 #UT10-5574
	Запрос.УстановитьПараметр("Реализация", Реализация);
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Возврат ТЗ;
	
КонецФункции

