Функция ПоверитьКорректностьСоставаЧекаККМ(Объект) Экспорт
	
	СтруктураВозврата = Новый Структура("Результат, Сообщение", Истина, "");
	
	Если Объект.ПозицииЧекККМ.Итог("Сумма") <> Объект.ОплатыЧекККМ.Итог("Сумма") Тогда
		
		СтруктураВозврата.Результат = Ложь;
		СтруктураВозврата.Сообщение = "Сумма по таблице позиций не совпадает с суммой по таблице оплат";
		
		Возврат СтруктураВозврата;
		
	ИначеЕсли Объект.ПозицииЧекККМ.Количество() = 0 ИЛИ Объект.ОплатыЧекККМ.Количество() = 0 Тогда 
		
		СтруктураВозврата.Результат = Ложь;
		СтруктураВозврата.Сообщение = "Отсутствуют позиции или оплаты в составе чека";
		
		Возврат СтруктураВозврата;
		
	КонецЕсли;	
	
	Возврат СтруктураВозврата;
	
КонецФункции

Функция ПоверитьКорректностьЗаполненияРКО(Объект) Экспорт
	
	СтруктураВозврата = Новый Структура("Результат, Сообщение", Ложь, "");
	
	СписокРеализаций = Новый СписокЗначений;
	СписокПриходников = Новый СписокЗначений;
	СписокИныхДокументов = Новый СписокЗначений;
	
	ТЗРасшифровка = Объект.РасшифровкаПлатежа.Выгрузить();
	ТЗРасшифровка.Свернуть("ДокументРасчетовСКонтрагентом");
	
	Для каждого Стр ИЗ ТЗРасшифровка Цикл
		
		Если ЗначениеЗаполнено(Стр.ДокументРасчетовСКонтрагентом) Тогда
			
			Если ТипЗнч(Стр.ДокументРасчетовСКонтрагентом) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
				СписокРеализаций.Добавить(Стр.ДокументРасчетовСКонтрагентом);
			ИначеЕсли ТипЗнч(Стр.ДокументРасчетовСКонтрагентом) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер") 
				ИЛИ ТипЗнч(Стр.ДокументРасчетовСКонтрагентом) = Тип("ДокументСсылка.ПлатежноеПоручениеВходящее") Тогда
				СписокПриходников.Добавить(Стр.ДокументРасчетовСКонтрагентом);
			Иначе
				СписокИныхДокументов.Добавить(Стр.ДокументРасчетовСКонтрагентом);
			КонецЕсли;
			
		Иначе
			
			СтруктураВозврата.Сообщение = "Обнаружены строки без заполненного реквизита 'Документ расчета с контрагентом'";
			Возврат СтруктураВозврата;
		
		КонецЕсли;
		
	КонецЦикла;
	
	Если СписокИныхДокументов.Количество() > 0 Тогда
		
		СтруктураВозврата.Сообщение = "В качестве документов расчетов с контрагентом обнаружены документы, печать которых не предусмотрена системой!";
		Возврат СтруктураВозврата;
		
	КонецЕсли;
			
	СтруктураВозврата.Результат = Истина;
	
	Возврат СтруктураВозврата;
	
КонецФункции

Функция ПКОАннулирован(ПКО) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РасходныйКассовыйОрдер.Ссылка
	|ИЗ
	|	Документ.РасходныйКассовыйОрдер КАК РасходныйКассовыйОрдер
	|ГДЕ
	|	РасходныйКассовыйОрдер.Аннулирование
	|	И РасходныйКассовыйОрдер.ДокументОснование = &ДокументОснование
	|	И РасходныйКассовыйОрдер.Проведен";
	
	Запрос.УстановитьПараметр("ДокументОснование", ПКО);
	
	Выборка = Запрос.Выполнить().Выбрать();           
	
	Если Выборка.Следующий() Тогда
		Возврат Истина;		
	КонецЕсли;         
	
	Возврат Ложь;	
		
КонецФункции

Функция ЕстьПлатежныйДокументПоРеализации(Реализация) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОбороты.Регистратор
	|ИЗ
	|	РегистрНакопления.ВзаиморасчетыСКонтрагентамиПоДокументамРасчетов.Обороты(, , Регистратор, ДокументРасчетовСКонтрагентом = &Реализация) КАК ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОбороты
	|ГДЕ
	|	(ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОбороты.Регистратор ССЫЛКА Документ.ПриходныйКассовыйОрдер
	|			ИЛИ ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОбороты.Регистратор ССЫЛКА Документ.ОплатаОтПокупателяПлатежнойКартой)";
	
	Запрос.УстановитьПараметр("Реализация", Реализация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Истина;		
	КонецЕсли;         
	
	Возврат Ложь;
	
КонецФункции

Функция ПолучитьКассуПоВодителю(Водитель, Организация) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОтветственныеЛицаСрезПоследних.СтруктурнаяЕдиница КАК Касса
	|ИЗ
	|	РегистрСведений.ОтветственныеЛица.СрезПоследних(
	|			,
	|			СтруктурнаяЕдиница ССЫЛКА Справочник.Кассы
	|				И ФизическоеЛицо = &ФизическоеЛицо
	|				И СтруктурнаяЕдиница.Владелец = &Организация
	|				И СтруктурнаяЕдиница.ПометкаУдаления = ЛОЖЬ) КАК ОтветственныеЛицаСрезПоследних";  
	
	Запрос.УстановитьПараметр("ФизическоеЛицо", Водитель);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();  
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Касса;		
	КонецЕсли;
	
	Возврат Неопределено;	
	
КонецФункции


