Функция ПробиватьВЧекахКодыМаркировки() Экспорт
	
	Возврат Константы.ПробиватьВЧекахКодыМаркировки.Получить() И ФФД12();
	
КонецФункции

//+Сёмин Р.И. 09.07.2026 #UT10-5935
//Функция ПолучитьМаркировкуПоДокументу(Документ, ЭтоВозврат, СтруктураЧека)
Функция ПолучитьМаркировкуПоДокументу(Документ, ЭтоВозврат, СтруктураЧека, ВернутьРезультатЗапроса = Ложь)
//-Сёмин Р.И. 09.07.2026 #UT10-5935	
	
	//+Белов А. 04.05.2026 #UT10-5841
	Если СтруктураЧека.Свойство("clientInfo") И СтруктураЧека.clientInfo.Свойство("vatin") И ЗначениеЗаполнено(СтруктураЧека.clientInfo.vatin) Тогда
		Возврат Новый Соответствие;	
	КонецЕсли;
	//-Белов А. 04.05.2026 #UT10-5841
	
	//+Сёмин Р.И. 09.09.2026 #UT10-6020
	ВыводитьДанныеПроверкиШтрихкодовПИоТ = Константы.ИспользоватьПроверкуМаркировокТСПИоТ.Получить() И ВДокументеЛицевойИлиРозничныйДоговор(Документ) И НЕ ЭтоОплатаКартойИлиПКОСЛицевымСчетом(Документ);
	//-Сёмин Р.И. 09.09.2026 #UT10-6020
	
	МаркировкаПоНоменклатуре = Новый Соответствие; 
	МаркировкиИсключения = Новый Массив;	
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Документ.КодМаркировки.Номенклатура КАК Номенклатура,
		|	Документ.КодМаркировки КАК ШК,
		|	ВЫБОР
		|		КОГДА Документ.Ссылка.ДоговорКонтрагента.ЛицевойСчет
		|				ИЛИ Документ.Ссылка.ДоговорКонтрагента.РозничнаяПродажа
		|			ТОГДА ""itemPieceSold""
		|		ИНАЧЕ ВЫБОР
		|				КОГДА Документ.Ссылка.ДоговорКонтрагента.УсловияРаботыСЧЗ = ЗНАЧЕНИЕ(Перечисление.УсловияРаботыСЧЗ.УчастникОборота)
		|					ТОГДА ""itemPieceForSale""
		|				КОГДА Документ.Ссылка.ДоговорКонтрагента.УсловияРаботыСЧЗ = ЗНАЧЕНИЕ(Перечисление.УсловияРаботыСЧЗ.ПокупкаДляСобственныхНужд)
		|					ТОГДА ""itemPieceSold""
		|				ИНАЧЕ ""itemPieceForSale""
		|			КОНЕЦ
		|	КОНЕЦ КАК itemEstimatedStatus
		|ИЗ
		|	Документ.РеализацияТоваровУслуг.КодыМаркировки КАК Документ
		|ГДЕ
		|	Документ.Ссылка В(&МассивДокументов)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Документ.КодМаркировки.Номенклатура,
		|	Документ.КодМаркировки,
		|	ВЫБОР
		|		КОГДА Документ.Ссылка.ДоговорКонтрагента.ЛицевойСчет
		|				ИЛИ Документ.Ссылка.ДоговорКонтрагента.РозничнаяПродажа
		|			ТОГДА ""itemPieceSold""
		|		ИНАЧЕ ВЫБОР
		|				КОГДА Документ.Ссылка.ДоговорКонтрагента.УсловияРаботыСЧЗ = ЗНАЧЕНИЕ(Перечисление.УсловияРаботыСЧЗ.УчастникОборота)
		|					ТОГДА ""itemPieceForSale""
		|				КОГДА Документ.Ссылка.ДоговорКонтрагента.УсловияРаботыСЧЗ = ЗНАЧЕНИЕ(Перечисление.УсловияРаботыСЧЗ.ПокупкаДляСобственныхНужд)
		|					ТОГДА ""itemPieceSold""
		|				ИНАЧЕ ""itemPieceForSale""
		|			КОНЕЦ
		|	КОНЕЦ
		|ИЗ
		|	Документ.КорректировкаРеализации.КодыМаркировки КАК Документ
		|ГДЕ
		|	Документ.Ссылка В(&МассивДокументов)";
	
	//+Сёмин Р.И. 09.09.2026 #UT10-6020
	Если ВыводитьДанныеПроверкиШтрихкодовПИоТ Тогда
		Запрос.Текст = ПолучитьТекстЗапросаМаркировокПоНоменклатуреСПроверкамиПИоТ();
	КонецЕсли;
	//-Сёмин Р.И. 09.09.2026 #UT10-6020
	
	Если ТипЗнч(Документ) = Тип("Массив") Тогда
		МассивДокументов = Документ;
	Иначе
		
		МассивДокументов = Новый Массив;
		
		Если ТипЗнч(Документ) = Тип("ДокументСсылка.РеализацияТоваровУслуг")
				ИЛИ ТипЗнч(Документ) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
			МассивДокументов.Добавить(Документ);
		Иначе
			МассивДокументов = ПолучитьМассивДокументовПоРасшифровкеПлатежа(Документ);	
		КонецЕсли;
		
	КонецЕсли;   
	
	//+Белов А. 15.04.2026 #UT10-5813
	УбратьДокументыИзРасшифровкиПоФильтру(МассивДокументов, МаркировкиИсключения);
	//-Белов А. 15.04.2026 #UT10-5813
	
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
	
	//+Сёмин Р.И. 09.07.2026 #UT10-5935
	Если ВернутьРезультатЗапроса Тогда
		Возврат Запрос.Выполнить();
	КонецЕсли;
	//-Сёмин Р.И. 09.07.2026 #UT10-5935
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Номенклатура = Выборка.Номенклатура;
		ШК = Выборка.ШК; 		  
		
		//+Белов А. 15.04.2026 #UT10-5813
		Если МаркировкиИсключения.Найти(ШК) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		//-Белов А. 15.04.2026 #UT10-5813
		
		ПолныйКодМаркировки = ШК.ПолныйКодМаркировки.Получить();
		
		//Если на находим разделитель групп, то это забагованный код маркировки, пытаемся его исправить
		Если Найти(ПолныйКодМаркировки, "<GS>") = 0 И Найти(ПолныйКодМаркировки, Символ(29)) = 0 Тогда
			
			ПолныйКодМаркировкиДоработанный = ДобавитьВКодМаркировкиНедостающиеСимволы(ПолныйКодМаркировки);
			
			Если ПолныйКодМаркировкиДоработанный = Неопределено Тогда
				
				//Значит не добавляем этот код маркировки в чек, иначе он вообще не пробьется
				ЗаписьЖурналаРегистрации("Печать чеков.Ошибка", УровеньЖурналаРегистрации.Ошибка, Документ.Метаданные(), Документ, "Код маркировки: " + ПолныйКодМаркировки + " при печати чека был пропущен, так как его структура не валидна");		
				Продолжить;
				
			Иначе
				ПолныйКодМаркировки = ПолныйКодМаркировкиДоработанный;	
			КонецЕсли;					
			
		КонецЕсли;
		
		СтруктураМаркировки = Новый Структура;
		СтруктураМаркировки.Вставить("imcType", "auto");
		СтруктураМаркировки.Вставить("imc", КодироватьСтрокуВBase64(СтрЗаменить(ПолныйКодМаркировки, "<GS>", Символ(29))));
		
		Если ЭтоВозврат Тогда
			СтруктураМаркировки.Вставить("itemEstimatedStatus", "itemPieceReturn");
		Иначе
			
			//+Белов А. 17.03.2026 #UT10-5757
			СтруктураМаркировки.Вставить("itemEstimatedStatus", Выборка.itemEstimatedStatus);
			//Если СтруктураЧека.Свойство("clientInfo") И СтруктураЧека.clientInfo.Свойство("vatin") Тогда
			//	СтруктураМаркировки.Вставить("itemEstimatedStatus", "itemPieceForSale");
			//Иначе
			//	СтруктураМаркировки.Вставить("itemEstimatedStatus", "itemPieceSold");
			//КонецЕсли;  
			//-Белов А. 17.03.2026 #UT10-5757
			
		КонецЕсли;
		
		СтруктураМаркировки.Вставить("imcModeProcessing", 0);
		
		МассивМаркировки = МаркировкаПоНоменклатуре.Получить(Номенклатура);
		
		Если МассивМаркировки = Неопределено Тогда
			
			МассивМаркировки = Новый Массив;
			МаркировкаПоНоменклатуре.Вставить(Номенклатура, МассивМаркировки);
			
		КонецЕсли;  
		
		//+Сёмин Р.И. 09.07.2026 #UT10-6020
		//МассивМаркировки.Добавить(Новый Структура("Маркировка, Использован", СтруктураМаркировки, Ложь));
		
		СтрокаМассиваМаркировки = Новый Структура;
		СтрокаМассиваМаркировки.Вставить("Маркировка", СтруктураМаркировки);
		СтрокаМассиваМаркировки.Вставить("Использован", Ложь);
		
		Если ВыводитьДанныеПроверкиШтрихкодовПИоТ Тогда
			
			ПроверкаПИоТ = Новый Структура;
			
			ПроверкаПИоТ.Вставить("reqId", Выборка.reqId);
			ПроверкаПИоТ.Вставить("reqTimestamp", Выборка.reqTimestamp);
			ПроверкаПИоТ.Вставить("isCheckedOffline", Выборка.isCheckedOffline);
			ПроверкаПИоТ.Вставить("inst", Выборка.inst);
			ПроверкаПИоТ.Вставить("version", Выборка.version);
			ПроверкаПИоТ.Вставить("ДатаДокумента", Выборка.ДатаДокумента);
			ПроверкаПИоТ.Вставить("НомерДокумента", Выборка.НомерДокумента);
			
			СтрокаМассиваМаркировки.Вставить("ПроверкаПИоТ", ПроверкаПИоТ);
			
		КонецЕсли;
		
		МассивМаркировки.Добавить(СтрокаМассиваМаркировки);
		//-Сёмин Р.И. 09.07.2026 #UT10-6020
		
	КонецЦикла;
	
	Возврат МаркировкаПоНоменклатуре;
	
КонецФункции 

Процедура УбратьДокументыИзРасшифровкиПоФильтру(МассивДокументов, МаркировкиИсключения)
	//+Белов А. 15.04.2026 #UT10-5813  
	
	МассивДокументовУдаления = Новый Массив;
	
	Для каждого Документ Из МассивДокументов Цикл
		
		Если ТипЗнч(Документ) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			
			ДоговорКонтрагента = ОбщегоНазначения.ПолучитьЗначениеРеквизита(Документ, "ДоговорКонтрагента");
			
			Если Не ОбщегоНазначения.ПолучитьЗначениеРеквизита(ДоговорКонтрагента, "ЛицевойСчет") 
				И Не ОбщегоНазначения.ПолучитьЗначениеРеквизита(ДоговорКонтрагента, "РозничнаяПродажа") Тогда
				
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ
				|	ЗначенияСвойствОбъектов.Объект
				|ИЗ
				|	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
				|ГДЕ
				|	ЗначенияСвойствОбъектов.Объект = &Объект
				|	И ЗначенияСвойствОбъектов.Свойство = &Свойство";
				
				Запрос.УстановитьПараметр("Свойство", ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("DS_Документ_ID"));  
				Запрос.УстановитьПараметр("Объект", Документ);
				
				Выборка = Запрос.Выполнить().Выбрать();
				
				//Если отправлен через ЭДО, то не отправляем маркировки по документу
				Если Выборка.Следующий() Тогда
					
					МассивДокументовУдаления.Добавить(Документ);
					Продолжить;
					
				КонецЕсли;     
				
				УсловияРаботыСЧЗ = ОбщегоНазначения.ПолучитьЗначениеРеквизита(ДоговорКонтрагента, "УсловияРаботыСЧЗ"); 
				
				Если УсловияРаботыСЧЗ = Перечисления.УсловияРаботыСЧЗ.ПокупкаДляСобственныхНужд Тогда
					
					Запрос = Новый Запрос;
					Запрос.Текст = 
					"ВЫБРАТЬ
					|	ВыводИзОборотаКИЗТовары.ШтрихКодМаркировки
					|ИЗ
					|	Документ.ВыводИзОборотаКИЗ.Товары КАК ВыводИзОборотаКИЗТовары
					|ГДЕ
					|	ВыводИзОборотаКИЗТовары.Ссылка.Основание = &Основание
					|	И ВыводИзОборотаКИЗТовары.Ссылка.Проведен";
					
					Запрос.УстановитьПараметр("Основание", Документ);  
					
					Выборка = Запрос.Выполнить().Выбрать(); 
					
					Пока Выборка.Следующий() Цикл
						МаркировкиИсключения.Добавить(Выборка.ШтрихКодМаркировки);
					КонецЦикла;		 
					
				КонецЕсли;                                                                     		
				
			КонецЕсли;
			
		КонецЕсли;  
		
	КонецЦикла;  
	
	Для каждого ДокументУдаления Из МассивДокументовУдаления Цикл
		
		Пока МассивДокументов.Найти(ДокументУдаления) <> Неопределено Цикл
			МассивДокументов.Удалить(МассивДокументов.Найти(ДокументУдаления));		
		КонецЦикла;  
		
	КонецЦикла;
	
	//-Белов А. 15.04.2026 #UT10-5813		
КонецПроцедуры

Функция ПолучитьМассивДокументовПоРасшифровкеПлатежа(Документ)
	
	МетаданныеДокумента = Документ.Метаданные(); 
	
	Если ОбщегоНазначения.ЕстьТабЧастьДокумента("РасшифровкаПлатежа", МетаданныеДокумента) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПлатежныйДокумент.ДокументРасчетовСКонтрагентом
		|ПОМЕСТИТЬ ВТ_Расшифровка
		|ИЗ
		|	Документ.ПриходныйКассовыйОрдер.РасшифровкаПлатежа КАК ПлатежныйДокумент
		|ГДЕ
		|	ПлатежныйДокумент.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Расшифровка.ДокументРасчетовСКонтрагентом
		|ИЗ
		|	ВТ_Расшифровка КАК ВТ_Расшифровка
		|ГДЕ
		|	ВТ_Расшифровка.ДокументРасчетовСКонтрагентом ССЫЛКА Документ.РеализацияТоваровУслуг
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_Расшифровка.ДокументРасчетовСКонтрагентом";
		
		Запрос.УстановитьПараметр("Ссылка", Документ); 
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПриходныйКассовыйОрдер", МетаданныеДокумента.Имя);
		
		МассивДокументовРасчетов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ДокументРасчетовСКонтрагентом");   
		
		//Если РКО или Оплата картой с типом - Возврат, то коды маркировки надо брать из корректировок. Подбираем их по сумме
		Если ТипЗнч(Документ) = Тип("ДокументСсылка.РасходныйКассовыйОрдер")
			ИЛИ (ТипЗнч(Документ) = Тип("ДокументСсылка.ОплатаОтПокупателяПлатежнойКартой") И Документ.ВидОперации = Перечисления.ВидыОперацийОплатаОтПокупателяПлатежнойКартой.ВозвратДенежныхСредствПокупателю) Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОбороты.Регистратор КАК Корректировка,
			|	СУММА(ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОбороты.СуммаВзаиморасчетовОборот * -1) КАК Сумма
			|ПОМЕСТИТЬ ВТ_Корректировки
			|ИЗ
			|	РегистрНакопления.ВзаиморасчетыСКонтрагентамиПоДокументамРасчетов.Обороты(, , Регистратор, ДокументРасчетовСКонтрагентом В (&МассивДокументовРасчетов)) КАК ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОбороты
			|ГДЕ
			|	ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОбороты.Регистратор ССЫЛКА Документ.КорректировкаРеализации
			|
			|СГРУППИРОВАТЬ ПО
			|	ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОбороты.Регистратор
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ_Корректировки.Корректировка
			|ИЗ
			|	ВТ_Корректировки КАК ВТ_Корректировки
			|ГДЕ
			|	ВТ_Корректировки.Сумма = &Сумма";
			
			Запрос.УстановитьПараметр("МассивДокументовРасчетов", МассивДокументовРасчетов);
			Запрос.УстановитьПараметр("Сумма", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "СуммаДокумента"));
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Выборка.Следующий() Тогда
				
				МассивВозврата = Новый Массив;
				МассивВозврата.Добавить(Выборка.Корректировка);
				
				Возврат МассивВозврата;
				
			КонецЕсли;   
			
		Иначе
			Возврат МассивДокументовРасчетов;			
		КонецЕсли; 	
		
	КонецЕсли;
	
	Возврат Новый Массив;
	
КонецФункции

Функция ДобавитьВКодМаркировкиНедостающиеСимволы(Знач ИсходнаяСтрока) Экспорт
	
	RegExp = Новый COMОбъект("VBScript.RegExp");
	RegExp.Global = Истина;
	
	// Маска: (91 + 4 символа) и (92)
	RegExp.Pattern = "(91.{4})(92)";
	
	// Символ Group Separator
	GS = "<GS>"; 
	
	// Формируем результат: GS + первая группа + GS + вторая группа
	Результат = RegExp.Replace(ИсходнаяСтрока, GS + "$1" + GS + "$2"); 
	
	Если Найти(Результат, "<GS>") > 0 Тогда
		Возврат Результат;	
	КонецЕсли;
	
	Возврат Неопределено;
		
КонецФункции  

Функция ПроверитьКодМаркировкиПродолжение(МассивКодовМаркировкиBase64, АдресТСПиоТ, Порт, ЗащищенноеСоединение) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("КодОшибки", 0);
	Результат.Вставить("ОписаниеОшибки", "");
	Результат.Вставить("ПродажаРазрешена", Ложь);
	Результат.Вставить("ПричинаЗапрета", "");
	Результат.Вставить("ДанныеТовара", Неопределено);
	Результат.Вставить("Комментарий", "");
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("codes", МассивКодовМаркировкиBase64);
	
	//♯а1с:1028
	ИнформацияОКлиенте = Новый Структура;
	ИнформацияОКлиенте.Вставить("name", "1С ПМСР");
	ИнформацияОКлиенте.Вставить("version", "1.0.0");
	ИнформацияОКлиенте.Вставить("id", "65329da4-01d1-48ba-9db8-ed58b3892774"); 		
	ИнформацияОКлиенте.Вставить("token", "token");
	
	ПараметрыЗапроса.Вставить("client_info", ИнформацияОКлиенте);
	
	ТекстЗапроса = Чеки.ВернутьJSON(ПараметрыЗапроса);
	
	ЗаголовокHTTP = Новый Соответствие();
	ЗаголовокHTTP.Вставить("Content-Type",   "application/json");
	ЗаголовокHTTP.Вставить("Accept",         "application/json");
	
	URL = "/api/v2/codes/check";
	HTTPЗапрос = Новый HTTPЗапрос(URL, ЗаголовокHTTP);
	HTTPЗапрос.УстановитьТелоИзСтроки(ТекстЗапроса, КодировкаТекста.UTF8);
	
	HTTPСоединение = Новый HTTPСоединение(АдресТСПиоТ, Порт, , , , 10, Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Неопределено));
	
	Попытка
		HTTPОтвет = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
	Исключение
		ВызватьИсключение "Ошибка при выполнении запроса: " + ОписаниеОшибки();
	КонецПопытки;
	
	Если HTTPОтвет.КодСостояния = 200 Тогда
		
		ТекстОтвета = HTTPОтвет.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		Ответ = Чеки.ВернутьСтруктуруИзJSON(ТекстОтвета);
		
		Если ТипЗнч(Ответ) = Тип("Структура") И Ответ.Свойство("codesResponse") Тогда
			ОтветПоКоду = Ответ.codesResponse[0];
			
			Если ОтветПоКоду.Свойство("codes") И ТипЗнч(ОтветПоКоду.codes) = Тип("Массив") И ОтветПоКоду.codes.Количество() > 0 Тогда
				ДанныеКода = ОтветПоКоду.codes[0];
				Результат.ДанныеТовара = ДанныеКода;
				
				ПричинаЗапретаПродажи = "";
				
				ОффЛайнПроверка = ОтветПоКоду.isCheckedOffline;
				Если ОффЛайнПроверка Тогда
					//♯а1с:1031
					Если ДанныеКода.isBlocked Тогда
						ПричинаЗапретаПродажи = "Товар заблокирован по решению органов власти";
					Иначе
						ПродажаРазрешена = Истина;
						ДобавитьКомментарий(Результат.Комментарий, "ОффЛайн проверка");
					КонецЕсли;
				Иначе
					Если НЕ ДанныеКода.found Тогда
						ПричинаЗапретаПродажи = "Код не найден в ГИС МТ";
					ИначеЕсли ДанныеКода.isBlocked Тогда
						ПричинаЗапретаПродажи = "Товар заблокирован по решению органов власти";
					ИначеЕсли ДанныеКода.sold Тогда
						ПричинаЗапретаПродажи = "Товар уже был продан ранее";
					ИначеЕсли НЕ ДанныеКода.realizable Тогда
						ПричинаЗапретаПродажи = "Товар не введен в оборот или выведен из оборота";
					ИначеЕсли НЕ ДанныеКода.utilised Тогда
						ПричинаЗапретаПродажи = "Код маркировки не нанесен на упаковку";
					ИначеЕсли НЕ ДанныеКода.valid Тогда
						ПричинаЗапретаПродажи = "Неверная структура кода маркировки";
					ИначеЕсли НЕ ДанныеКода.verified Тогда
						ПричинаЗапретаПродажи = "Ошибка проверки крипто-подписи";
					ИначеЕсли ДанныеКода.Свойство("expireDate") И ДанныеКода.expireDate <> Неопределено Тогда
						// Проверка срока годности
						ДатаИстечения = Дата(ДанныеКода.expireDate);
						Если ДатаИстечения < ТекущаяДата() Тогда
							ПричинаЗапретаПродажи = "Истек срок годности товара";
						КонецЕсли;
					Иначе
						ПродажаРазрешена = Истина;
						ДобавитьКомментарий(Результат.Комментарий, "ОнЛайн проверка");
					КонецЕсли;
				КонецЕсли;
				
				Если ПродажаРазрешена Тогда
					Результат.ПродажаРазрешена = ПродажаРазрешена;
				Иначе
					Результат.ПродажаРазрешена = ПродажаРазрешена;
					Результат.ПричинаЗапретаПродажи = ПричинаЗапретаПродажи;
				КонецЕсли;
			Иначе
				ВызватьИсключение "Неизвестный формат ответа от ТС ПИоТ #2";
			КонецЕсли;
		Иначе
			ВызватьИсключение "Неизвестный формат ответа от ТС ПИоТ #1";
		КонецЕсли;
	Иначе
		// Обработка HTTP-ошибок
		Результат.КодОшибки = HTTPОтвет.КодСостояния;
				
		// Особые коды ошибок по документации
		Если HTTPОтвет.КодСостояния = 203 Тогда
			Результат.ОписаниеОшибки = "Аварийный режим ТС ПИоТ, продажа разрешена";
			Результат.ПродажаРазрешена = Истина; // По документации, при 203 продажа разрешается ♯а1с:1033
			ДобавитьКомментарий(Результат.Комментарий, "Аварийный режим ТС ПИоТ, продажа разрешена");
		ИначеЕсли HTTPОтвет.КодСостояния = 400 Тогда
			Результат.ОписаниеОшибки = "Неверный формат запроса: " + ТекстЗапроса;
		ИначеЕсли HTTPОтвет.КодСостояния = 500 Тогда
			Результат.ОписаниеОшибки = "Internal Server Error - внутренняя ошибка сервера при обработке запроса";		
		ИначеЕсли HTTPОтвет.КодСостояния = 504 Тогда
			Результат.ОписаниеОшибки = "Gateway Timeout - превышено время ожидания ответа от upstream сервиса";	
		ИначеЕсли HTTPОтвет.КодСостояния = 514 Тогда
			Результат.ОписаниеОшибки = "Таймаут: нет ответа от ГИС МТ и ЛМ ЧЗ";
		Иначе
			Результат.ОписаниеОшибки = "HTTP ошибка: " + HTTPОтвет.КодСостояния;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

Функция ПроверитьКодыМаркировкиПИоТ(КодМассивКодовМаркировки, АдресТСПиоТ, Действие = "Продажа", Событие = "", Источник = Неопределено) Экспорт
	
	//+Сёмин Р.И. 06.07.2026 #UT10-5935
	Если ЗначениеЗаполнено(Событие) Тогда
		Операция = Событие;
	Иначе
		Операция = Действие;
	КонецЕсли;
	
	КодыМаркировкиДляПроверки = Новый ТаблицаЗначений;
	КодыМаркировкиДляПроверки.Колонки.Добавить("ШтрихкодНоменклатуры");
