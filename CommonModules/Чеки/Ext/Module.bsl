///////////////////Работа с сервером///////////////////
Функция ПолучитьСоединениеССерверомЧеков(Таймаут = 3) Экспорт
	
	Если ИспользоватьАутификациюНаКассовомСервере() Тогда
		Возврат Новый HTTPСоединение(Константы.АтолАдресВебСервера.Получить(),Константы.АтолПортВебСервера.Получить(),Константы.ЛогинКассовогоСервера.Получить(),Константы.ПарольКассовогоСервера.Получить(),,Таймаут);
	Иначе
		Возврат Новый HTTPСоединение(Константы.АтолАдресВебСервера.Получить(),Константы.АтолПортВебСервера.Получить(),,,,Таймаут);
	КонецЕсли;	
	
КонецФункции

Функция ИспользоватьАутификациюНаКассовомСервере()
	
	Возврат ПолучитьВерсиюСервераЧислом() >= 101070;
		
КонецФункции

Функция ИспользоватьНовыеРеквизитыВЧеках()
	
	Возврат ПолучитьВерсиюСервераЧислом() >= 101070;
		
КонецФункции

Функция ПолучитьВерсиюСервераЧислом()
	
	Версия = Константы.ВерсияКассовогоСервера.Получить();
	
	Если ЗначениеЗаполнено(Версия) Тогда
		
		Представление = Строка(Версия);
		Представление = СтрЗаменить(Представление, ".", "");
		
		Попытка
			Возврат Число(Представление);			
		Исключение
		    Возврат 0;
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

Функция ВернутьОписаниеОшибкиОтправкиЧекаВОчередьПоКоду(КодСостояния)
	
	Если КодСостояния = 401 Тогда
		Возврат "Авторизация не пройдена";
	ИначеЕсли КодСостояния = 403 Тогда
		Возврат "ККТ не активирована";
	ИначеЕсли КодСостояния = 404 Тогда
		Возврат "ККТ по заданному идентификатору не найдена или ККТ по умолчанию не выбрана";
	ИначеЕсли КодСостояния = 408 Тогда
		Возврат "За 30 секунд не удалось захватить управление драйвером (занят фоновыми непрерываемыми задачами). Повторите запрос позже. Может произойти при включенной настройке validateRequestsOnAdd.";
	ИначеЕсли КодСостояния = 409 Тогда
		Возврат "Задание с таким же uuid уже существует";
	ИначеЕсли КодСостояния = 420 Тогда
		Возврат "Произошла ошибка во время проверки формата задания";
	Иначе
		Возврат "Не идентифицированный код состояния";
	КонецЕсли;
	
КонецФункции

Функция ВернутьОписаниеОшибкиОбновленияСтатусаКассы(КодСостояния)
	
	Если КодСостояния = 401 Тогда
		Возврат "Авторизация не пройдена";
	ИначеЕсли КодСостояния = 403 Тогда
		Возврат "ККТ не активирована";
	ИначеЕсли КодСостояния = 404 Тогда
		Возврат "ККТ по заданному идентификатору не найдена или ККТ по умолчанию не выбрана или задание с указанным UUID не найдено";
	ИначеЕсли КодСостояния = 408 Тогда
		Возврат "За 30 секунд не удалось захватить управление драйвером (занят фоновыми непрерываемыми задачами). Повторите запрос позже";
	ИначеЕсли КодСостояния = 420 Тогда
		Возврат "Ошибка при выполнении запроса";
	Иначе
		Возврат "Не идентифицированный код состояния";
	КонецЕсли;
	
КонецФункции

Функция ИспользоватьПечатьЧековЧерезСервер() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Использовать = Константы.АтолИспользоватьПечатьЧерезСервер.Получить();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Использовать;
	
КонецФункции

Функция ИспользоватьПечатьЧековЧерезСерверАМРВодитель() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Использовать = Константы.АтолИспользоватьПечатьЧерезСерверАРМВодитель.Получить();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Использовать;
	
КонецФункции

Функция ИспользоватРегламентныеЗаданияДляРаботыССерверомЧеков() Экспорт
	
	Возврат ИспользоватьПечатьЧековЧерезСервер() ИЛИ ИспользоватьПечатьЧековЧерезСерверАМРВодитель();
	
КонецФункции

Функция ПолучитьПользователяЗакрытияОткрытияСмены(Касса) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СтатусыКассСрезПоследних.Пользователь
	|ИЗ
	|	РегистрСведений.СтатусыКасс.СрезПоследних(
	|			,
	|			Касса.ИД = &ИД
	|				И Пользователь <> ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)) КАК СтатусыКассСрезПоследних";
	
	Запрос.УстановитьПараметр("ИД", Касса.ИД);
	
	Выборка = Запрос.Выполнить().Выбрать(); 
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Пользователь;
	Иначе 
		Возврат Пользователи.ТекущийПользователь();
	КонецЕсли;	
	
КонецФункции

Функция ФФД12()
	
	Возврат Константы.ФорматФискальныхДанных.Получить() = Перечисления.ФорматыФискальныхДанных.ОдинДва;
	
КонецФункции

Функция ВыводитьЧекСТоварамиИДругимиРеквизитами(Коррекция)
	
	Если ФФД12() Тогда
		Возврат Истина;
	Иначе
		Возврат Не Коррекция;
	КонецЕсли;	
		
КонецФункции


///////////////////Работа с чеками///////////////////
Процедура ОбновлениеСтатусовЗаданийНаПробитиеЧеков() Экспорт

	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда 
		
		ЗаписьЖурналаРегистрации("Обновление статусов заданий на пробитие чеков", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Отменена работа регламентного задания из-за несоответствия параметров подключения к ИБ");
		Возврат; 
		
	КонецЕсли;
	
	Если НЕ ИспользоватРегламентныеЗаданияДляРаботыССерверомЧеков() Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	ЗаписьЖурналаРегистрации("Обновление статусов чеков.Начало", УровеньЖурналаРегистрации.Информация, Метаданные.РегламентныеЗадания.ОбновлениеСтатусовЗаданийНаПробитиеЧеков,, "Начало выполнения регламентного задания ОбновлениеСтатусовЗаданийНаПробитиеЧеков");		
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаданияНаПробитиеЧека.ПКО,
	               |	ЗаданияНаПробитиеЧека.ГУИД,
	               |	ЗаданияНаПробитиеЧека.Статус
	               |ИЗ
	               |	РегистрСведений.ЗаданияНаПробитиеЧека КАК ЗаданияНаПробитиеЧека
	               |ГДЕ
	               |	НЕ ЗаданияНаПробитиеЧека.Статус В (&СтатусыНеДляПроверки)";
	
	СтатусыНеДляПроверки = Новый СписокЗначений;
	СтатусыНеДляПроверки.Добавить("ready");
	СтатусыНеДляПроверки.Добавить("error");
	СтатусыНеДляПроверки.Добавить("prepare"); 	
	//+Белов А. 22.01.2026 #UT10-5638
	СтатусыНеДляПроверки.Добавить("check"); 	
	//-Белов А. 22.01.2026 #UT10-5638
	
	Запрос.УстановитьПараметр("СтатусыНеДляПроверки", СтатусыНеДляПроверки);
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ПКО = ВыборкаДетальныеЗаписи.ПКО;
		ГУИД = ВыборкаДетальныеЗаписи.ГУИД;
		
		ЗаписьЖурналаРегистрации("Обновление статусов чеков.Обработка", УровеньЖурналаРегистрации.Информация, ПКО.Метаданные(), ПКО, "Начало обновления статуса ГУИД: " + ГУИД);		
				
		СтруктураВозврата = ПроверитьЧекНаСервере(ГУИД, ПКО);
		
		Если СтруктураВозврата.Результат Тогда
			
			Если ЗначениеЗаполнено(СтруктураВозврата.НомерЧека) Тогда
				
				ПКООбъект = ПКО.ПолучитьОбъект();
				ПКООбъект.ОбменДанными.Загрузка = Истина;    
				
				//+Белов А. 13.11.2024 #UT10-4894
				ПКООбъект.ДополнительныеСвойства.Вставить("НеВыполнятьПроверкуНаДатыЗапрета", Истина);
				//-Белов А. 13.11.2024 #UT10-4894
				
				Если ТипЗнч(ПКО) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер") И ПКООбъект.Аннулирован И ЗначениеЗаполнено(ПКООбъект.НомерЧекаККМ) Тогда
					ПКООбъект.НомерЧекаККМАннулирование = СтруктураВозврата.НомерЧека;
				Иначе
					ПКООбъект.НомерЧекаККМ = СтруктураВозврата.НомерЧека;
				КонецЕсли; 
				
				ПКООбъект.Записать(РежимЗаписиДокумента.Запись);
				
			КонецЕсли;
			
			ИзменитьСтатусЗаданияНаПробитиеЧека(ПКО, ГУИД, СтруктураВозврата.Статус, Ложь, ?(Не ЗначениеЗаполнено(СтруктураВозврата.НомерЧека), СтруктураВозврата.Сообщение, ""));
			
			ЗаписьЖурналаРегистрации("Обновление статусов чеков.Обработка", УровеньЖурналаРегистрации.Информация, ПКО.Метаданные(), ПКО, "Изменен статус на " + СтруктураВозврата.Статус);		
			
			Если СтруктураВозврата.Статус = "error" Тогда
				ЗаписьЖурналаРегистрации("Обновление статусов чеков.Ошибка", УровеньЖурналаРегистрации.Ошибка, ПКО.Метаданные(), ПКО, "Обнаружен статус error при обновлении задания на печать: " + ГУИД);				
			КонецЕсли;
			
		Иначе
			
			Если ВыборкаДетальныеЗаписи.Статус = "unknown" И СтруктураВозврата.КодОшибки = 505 Тогда
				ИзменитьСтатусЗаданияНаПробитиеЧека(ПКО, ГУИД, "error", Ложь, СтруктураВозврата.Сообщение);	
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЦикла;
	
	
	//Отправляем предварительные задания на печать
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаданияНаПробитиеЧека.ПКО,
	               |	ЗаданияНаПробитиеЧека.ГУИД,
	               |	ЗаданияНаПробитиеЧека.ПКО.Касса КАК ПКОКасса,
	               |	ЗаданияНаПробитиеЧека.ТекстОшибки
	               |ИЗ
	               |	РегистрСведений.ЗаданияНаПробитиеЧека КАК ЗаданияНаПробитиеЧека
	               |ГДЕ
	               |	ЗаданияНаПробитиеЧека.Статус В (&СтатусыДляОтправки)
	               |	И НЕ ЗаданияНаПробитиеЧека.Обработан
	               |ИТОГИ ПО
	               |	ПКОКасса";
	
	СтатусыДляОтправки = Новый СписокЗначений;
	СтатусыДляОтправки.Добавить("prepare");
	
	Запрос.УстановитьПараметр("СтатусыДляОтправки", СтатусыДляОтправки);
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Касса = ВыборкаДетальныеЗаписи.ПКОКасса;
		
		ЗаписьЖурналаРегистрации("Обновление статусов чеков.Обработка", УровеньЖурналаРегистрации.Информация, Метаданные.Справочники.Кассы, Касса, "Получение статуса возможности отправки предварительных документов по кассе " + Строка(Касса));			
		
		МожноЛиПечататьСтруктура = МожноПечататьЧеки(Касса);
		
		Если Не МожноЛиПечататьСтруктура.Результат Тогда
			
			ЗаписьЖурналаРегистрации("Обновление статусов чеков.Ошибка", УровеньЖурналаРегистрации.Ошибка, Метаданные.Справочники.Кассы, Касса, "Получен отрицательный ответ при запросе отправки предварительных документов по кассе " + Строка(Касса) + Символы.ПС + МожноЛиПечататьСтруктура.Сообщение);				
			Продолжить; 
			
		Иначе
			ЗаписьЖурналаРегистрации("Обновление статусов чеков.Обработка", УровеньЖурналаРегистрации.Информация, Метаданные.Справочники.Кассы, Касса, "Получен положительный ответ при запросе отправки предварительных документов по кассе " + Строка(Касса));				
		КонецЕсли;

		Выборка = ВыборкаДетальныеЗаписи.Выбрать(); 
		
		Пока Выборка.Следующий() Цикл
			
			//+Белов А. 22.01.2026 #UT10-5638
			//Для этих видов докуменов используем отложенную проверку по биллингу
			Если (ТипЗнч(Выборка.ПКО) = Тип("ДокументСсылка.РеализацияТоваровУслуг")
				ИЛИ ТипЗнч(Выборка.ПКО) = Тип("ДокументСсылка.КорректировкаРеализации"))
				И Выборка.ПКО.ДоговорКонтрагента.КонтролироватьВзаиморасчетыЧерезСистемуБиллинг Тогда
				
				//+Белов А. 28.08.2026 #UT10-6002
				Если ТипЗнч(Выборка.ПКО) = Тип("ДокументСсылка.РеализацияТоваровУслуг") И Выборка.ПКО.ДоговорКонтрагента.ЛицевойСчет Тогда
					
					Если РаботаСТоварамиНаДоставке.ТоварПередан(Выборка.ПКО) Тогда
						
						ИзменитьСтатусЗаданияНаПробитиеЧека(Выборка.ПКО, Выборка.ГУИД, "prepare", Истина, Выборка.ТекстОшибки);
						Чеки.ЗаписатьНовоеЗадание(Выборка.ПКО, "check");  
						
					КонецЕсли;
					
				Иначе
					//-Белов А. 28.08.2026 #UT10-6002
					
					ИзменитьСтатусЗаданияНаПробитиеЧека(Выборка.ПКО, Выборка.ГУИД, "prepare", Истина, Выборка.ТекстОшибки);
					Чеки.ЗаписатьНовоеЗадание(Выборка.ПКО, "check");  
					
				КонецЕсли;	
				 
				Продолжить;
				
			КонецЕсли;    
			//-Белов А. 22.01.2026 #UT10-5638
							
			Если ТипЗнч(Выборка.ПКО) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер") Тогда
				СтруктураВозврата = ОтправитьЧекВОчередьНаПечать(Выборка.ПКО, Истина, Выборка.ПКО.Аннулирован И ЗначениеЗаполнено(Выборка.ПКО.НомерЧекаККМ));
			ИначеЕсли ТипЗнч(Выборка.ПКО) = Тип("ДокументСсылка.ОплатаОтПокупателяПлатежнойКартой") Тогда
				
				Если Выборка.ПКО.ВидОперации = Перечисления.ВидыОперацийОплатаОтПокупателяПлатежнойКартой.ОплатаПокупателя Тогда
					СтруктураВозврата = ОтправитьЧекВОчередьНаПечать(Выборка.ПКО, Истина,, Константы.АдресПортала.Получить());
				Иначе
					СтруктураВозврата = ОтправитьЧекНаВозвратВОчередьНаПечать(Выборка.ПКО, Истина, Константы.АдресПортала.Получить());
				КонецЕсли; 
				
			ИначеЕсли ТипЗнч(Выборка.ПКО) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
				СтруктураВозврата = ОтправитьЧекВОчередьНаПечать(Выборка.ПКО, Истина);
			Иначе
				СтруктураВозврата = ОтправитьЧекНаВозвратВОчередьНаПечать(Выборка.ПКО);
			КонецЕсли;
			
			Если НЕ СтруктураВозврата.Результат Тогда
				
				ИзменитьСтатусЗаданияНаПробитиеЧека(Выборка.ПКО, Выборка.ГУИД, "prepare", Ложь, СтруктураВозврата.Сообщение);
				ЗаписьЖурналаРегистрации("Обновление статусов чеков.Ошибка", УровеньЖурналаРегистрации.Ошибка, Выборка.ПКО.Метаданные(), Выборка.ПКО, "Не удалось поменять статус с prepare на new. Документ не был отправлен в очередь на печать" + Символы.ПС + СтруктураВозврата.Сообщение);								
				
			Иначе
				
				ИзменитьСтатусЗаданияНаПробитиеЧека(Выборка.ПКО, Выборка.ГУИД, "prepare", Истина, Выборка.ТекстОшибки);
				ЗаписьЖурналаРегистрации("Обновление статусов чеков.Обработка", УровеньЖурналаРегистрации.Информация, Выборка.ПКО.Метаданные(), Выборка.ПКО, "Документ успешно изменил статус с prepare на new и отправлен в очередь на печать");								
				
			КонецЕсли;
		
		КонецЦикла;
		
	КонецЦикла;
	
	ЗаписьЖурналаРегистрации("Обновление статусов чеков.Завершение", УровеньЖурналаРегистрации.Информация, Метаданные.РегламентныеЗадания.ОбновлениеСтатусовЗаданийНаПробитиеЧеков,, "Окончание выполнения регламентного задания ОбновлениеСтатусовЗаданийНаПробитиеЧеков");		
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ОбновлениеСтатусовЗаданийНаПробитиеЧековПроверки() Экспорт
//+Белов А. 22.01.2026 #UT10-5638

	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда 
		
		ЗаписьЖурналаРегистрации("Обновление статусов заданий на пробитие чеков проверки", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Отменена работа регламентного задания из-за несоответствия параметров подключения к ИБ");
		Возврат; 
		
	КонецЕсли;
	
	Если НЕ ИспользоватРегламентныеЗаданияДляРаботыССерверомЧеков() Тогда
		Возврат;
	КонецЕсли;  
	
	ЗаписьЖурналаРегистрации("Обновление статусов чеков проверки.Начало", УровеньЖурналаРегистрации.Информация, Метаданные.РегламентныеЗадания.ОбновлениеСтатусовЗаданийНаПробитиеЧековПроверки,, "Начало выполнения регламентного задания ОбновлениеСтатусовЗаданийНаПробитиеЧековПроверки");		
	
	//Отправляем предварительные задания на печать
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаданияНаПробитиеЧека.ПКО,
	               |	ЗаданияНаПробитиеЧека.ГУИД,
	               |	ЗаданияНаПробитиеЧека.ПКО.Касса КАК ПКОКасса,
	               |	ЗаданияНаПробитиеЧека.ТекстОшибки,
	               |	ЗаданияНаПробитиеЧека.Период,
	               |	ЗаданияНаПробитиеЧека.Тест
	               |ИЗ
	               |	РегистрСведений.ЗаданияНаПробитиеЧека КАК ЗаданияНаПробитиеЧека
	               |ГДЕ
	               |	ЗаданияНаПробитиеЧека.Статус В(&СтатусыДляОтправки)
	               |	И НЕ ЗаданияНаПробитиеЧека.Обработан
	               |ИТОГИ ПО
	               |	ПКОКасса";
	
	СтатусыДляОтправки = Новый СписокЗначений;
	СтатусыДляОтправки.Добавить("check");
	
	Запрос.УстановитьПараметр("СтатусыДляОтправки", СтатусыДляОтправки);
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Касса = ВыборкаДетальныеЗаписи.ПКОКасса; 
		
		ЗаписьЖурналаРегистрации("Обновление статусов чеков проверки.Обработка", УровеньЖурналаРегистрации.Информация, Метаданные.Справочники.Кассы, Касса, "Получение статуса возможности отправки предварительных документов по кассе " + Строка(Касса));			
		
		МожноЛиПечататьСтруктура = МожноПечататьЧеки(Касса);
		
		Если Не МожноЛиПечататьСтруктура.Результат Тогда
			
			ЗаписьЖурналаРегистрации("Обновление статусов чеков проверки.Ошибка", УровеньЖурналаРегистрации.Ошибка, Метаданные.Справочники.Кассы, Касса, "Получен отрицательный ответ при запросе отправки предварительных документов по кассе " + Строка(Касса) + Символы.ПС + МожноЛиПечататьСтруктура.Сообщение);				
			Продолжить; 
			
		Иначе
			ЗаписьЖурналаРегистрации("Обновление статусов чеков проверки.Обработка", УровеньЖурналаРегистрации.Информация, Метаданные.Справочники.Кассы, Касса, "Получен положительный ответ при запросе отправки предварительных документов по кассе " + Строка(Касса));				
		КонецЕсли;   
		
		Выборка = ВыборкаДетальныеЗаписи.Выбрать(); 
		
		МассивИдентификаторов = Новый Массив;
		
		Пока Выборка.Следующий() Цикл
			
			Если ТипЗнч(Выборка.ПКО) <> Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
				Продолжить;
			КонецЕсли;
			
			Если Выборка.Тест Тогда
				МассивИдентификаторов.Добавить(Выборка.ГУИД);
			Иначе
				МассивИдентификаторов.Добавить(Строка(Выборка.ПКО.УникальныйИдентификатор()));
			КонецЕсли; 	
			
		КонецЦикла;        
		
		ТаблицаОплаченныхДокументов = ПолучитьТаблицуОплаченныхДокументовИзБиллинга(МассивИдентификаторов);
		
		//Если не смогли достучаться до биллинга, то пропускаем
		Если МассивИдентификаторов.Количество() > 0 И ТаблицаОплаченныхДокументов = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Выборка.Сбросить();
		
		Пока Выборка.Следующий() Цикл
			
			ДокументПечати = Выборка.ПКО; 
			//Коррекция = НачалоДня(Выборка.Период) <> НачалоДня(ТекущаяДата()); 
			Коррекция = Ложь;
			
			Если Выборка.Тест Тогда
				ГУИД = Выборка.ГУИД;	
			Иначе
				ГУИД = Строка(ДокументПечати.УникальныйИдентификатор());
			КонецЕсли;
				
			Если ТипЗнч(ДокументПечати) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
				
				СтрокаВТаблице = ТаблицаОплаченныхДокументов.Найти(ГУИД, "source_id");  
				
				Если СтрокаВТаблице = Неопределено Тогда
					
					ИзменитьСтатусЗаданияНаПробитиеЧека(ДокументПечати, Выборка.ГУИД, "check", Ложь, "Не удалось получить данные из биллинга по оплате");
					Продолжить;
					
				КонецЕсли;
				
				Если СтрокаВТаблице.is_paid Тогда
					СтруктураВозврата = ОтправитьЧекВОчередьНаПечать(ДокументПечати, Истина,,, Коррекция);	
				Иначе					
					
					ТекстОшибки = "";
					
					Если Не СтрокаВТаблице.found Тогда
						ТекстОшибки = "Такая реализация в биллинге не была найдена";	
					ИначеЕсли Не СтрокаВТаблице.is_paid Тогда					
						ТекстОшибки = "Реализация пока не оплачена";
					КонецЕсли; 
					
					ИзменитьСтатусЗаданияНаПробитиеЧека(ДокументПечати, Выборка.ГУИД, "check", Ложь, ТекстОшибки);	
					
					Продолжить;
					
				КонецЕсли;						
				
			ИначеЕсли ТипЗнч(ДокументПечати) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
				
				Реализация = ПолучитьРеализациюПоКорректировке(ДокументПечати);                   
				
				Если ЗначениеЗаполнено(Реализация.НомерЧекаККМ) Тогда 				
					СтруктураВозврата = ОтправитьЧекНаВозвратВОчередьНаПечать(ДокументПечати, Истина,, Коррекция);					
				Иначе          
					//Ждем когда реализация распечатается и проставится номер чека
					Продолжить;				
				КонецЕсли;  
				
			Иначе
				Продолжить;
			КонецЕсли;  
			
			
			Если НЕ СтруктураВозврата.Результат Тогда
				
				ИзменитьСтатусЗаданияНаПробитиеЧека(ДокументПечати, Выборка.ГУИД, "check", Ложь, СтруктураВозврата.Сообщение);
				ЗаписьЖурналаРегистрации("Обновление статусов чеков проверки.Ошибка", УровеньЖурналаРегистрации.Ошибка, ДокументПечати.Метаданные(), ДокументПечати, "Не удалось поменять статус с check на new. Документ не был отправлен в очередь на печать" + Символы.ПС + СтруктураВозврата.Сообщение);								
				
			Иначе
				
				ИзменитьСтатусЗаданияНаПробитиеЧека(ДокументПечати, Выборка.ГУИД, "check", Истина, Выборка.ТекстОшибки);
				ЗаписьЖурналаРегистрации("Обновление статусов чеков проверки.Обработка", УровеньЖурналаРегистрации.Информация, ДокументПечати.Метаданные(), ДокументПечати, "Документ успешно изменил статус с check на new и отправлен в очередь на печать");								
				
			КонецЕсли;    
			
		КонецЦикла;  
		
	КонецЦикла;
	
	ЗаписьЖурналаРегистрации("Обновление статусов чеков проверки.Завершение", УровеньЖурналаРегистрации.Информация, Метаданные.РегламентныеЗадания.ОбновлениеСтатусовЗаданийНаПробитиеЧековПроверки,, "Начало выполнения регламентного задания ОбновлениеСтатусовЗаданийНаПробитиеЧековПроверки");		
	
//-Белов А. 22.01.2026 #UT10-5638	
КонецПроцедуры

Функция ПолучитьТаблицуОплаченныхДокументовИзБиллинга(МассивИдентификаторов)
	
	Тело = ОбщегоНазначения.ВернутьJSON(Новый Структура("source_ids", МассивИдентификаторов));
	
	СтруктураРезультата = AMQP_РаботаСДокументами.ОтправитьЗапросВБиллинг("api/v2/client/check-realization-payment", "Получение данных по оплате реализаций",,,,, Тело);
	
	Если СтруктураРезультата.Результат <> 0 Тогда
		
		ЗаписьЖурналаРегистрации("Обновление статусов чеков проверки.Ошибка", УровеньЖурналаРегистрации.Ошибка, Метаданные.РегламентныеЗадания.ОбновлениеСтатусовЗаданийНаПробитиеЧековПроверки,, "Возникла ошибка при получении данных из биллинга: " + СтруктураРезультата.Сообщение);		
		Возврат Неопределено;
		
	КонецЕсли;   
	
	Возврат ОбщегоНазначения.ПреобразоватьМассивВТаблицуЗначений(СтруктураРезультата.Данные);	
	
КонецФункции                                                               

Процедура ИзменитьСтатусЗаданияНаПробитиеЧека(ПКО, ГУИД, НовыйСтатус, Обработан, ТекстОшибки)
	
	НаборЗаписей = РегистрыСведений.ЗаданияНаПробитиеЧека.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ПКО.Установить(ПКО);
	НаборЗаписей.Прочитать();
	
	Для каждого ЗаписьНабора ИЗ НаборЗаписей Цикл
		
		Если ЗаписьНабора.ГУИД <> ГУИД Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаписьНабора.Статус = НовыйСтатус;
		ЗаписьНабора.Обработан = Обработан;
		ЗаписьНабора.ТекстОшибки = ТекстОшибки;
		ЗаписьНабора.ДатаОбновления = ТекущаяДата();
		
	КонецЦикла;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

Функция ОтправитьНефискальныйЧекВОчередьНаПечать(Текст, Касса) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ЗаписьЖурналаРегистрации("Печать чеков.Начало", УровеньЖурналаРегистрации.Информация, , , "Начало выполнения функции отправки нефискального чека на сервер печати");		
	
	СерверОтправки = Константы.АтолАдресВебСервера.Получить() + ":" + Формат(Константы.АтолПортВебСервера.Получить(), "ЧГ=0");

	СтруктураВозврата = Новый Структура("Результат, Сообщение", Ложь, "");
	
	ГУИД = Строка(Новый УникальныйИдентификатор());
	
	HTTPЗапрос = Новый HTTPЗапрос();
	HTTPЗапрос.АдресРесурса = "/api/v2/requests?deviceID=" + Касса.ИД;
	HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json;charset=utf-8");
	
	Попытка  
		
		СтруктураЗапроса = Новый Структура;      
		СтруктураЗапроса.Вставить("uuid", ГУИД);
		
		МассивСтрок = Новый Массив; 
		
		СтруктураСтроки = Новый Структура; 
		СтруктураСтроки.Вставить("type", "nonFiscal");
		
		МассивЭлементов = Новый Массив;
		МассивЭлементов.Добавить(Новый Структура("type, text, alignment", "text", Текст, "left"));
		
		СтруктураСтроки.Вставить("items", МассивЭлементов);
		
		МассивСтрок.Добавить(СтруктураСтроки);  
		
		СтруктураЗапроса.Вставить("request", МассивСтрок);
	
		СтрокаЗапросаJS = ВернутьJSON(СтруктураЗапроса);
		ЗаписьЖурналаРегистрации("Печать чеков.Обработка", УровеньЖурналаРегистрации.Информация, , , "Успешно сформирован JSON для отправки на сервер" + Символы.ПС + СтрокаЗапросаJS);		
		
	Исключение
		
		ТекстОшибки = "Ошибка формирования менеджера задания (JSON)" + Символы.ПС + ОписаниеОшибки();
		СтруктураВозврата.Сообщение = ТекстОшибки;   
		
		ЗаписьЖурналаРегистрации("Печать чеков.Ошибка", УровеньЖурналаРегистрации.Ошибка, , , СтруктураВозврата.Сообщение);
		
		Возврат СтруктураВозврата;
		
	КонецПопытки;
	
	HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаЗапросаJS, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	
	Попытка
		
		Соединение = ПолучитьСоединениеССерверомЧеков(10);
		ОтветHTTP = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
		Ответ = ОтветHTTP.ПолучитьТелоКакСтроку();
		ЗаписьЖурналаРегистрации("Печать чеков.Обработка", УровеньЖурналаРегистрации.Информация, , , "Подключение и отправка нефискального чека на сервер " + СерверОтправки + " выполнена успешно! " + Символы.ПС + Ответ);		
		
	Исключение 	
		
		ТекстОшибки = "Ошибка отправки нефискального чека на сервер" + Символы.ПС + ОписаниеОшибки();
		СтруктураВозврата.Сообщение = ТекстОшибки;  
		УстановитьПривилегированныйРежим(Ложь);
		
		Возврат СтруктураВозврата;		
		
	КонецПопытки;

	Если Не ОтветHTTP.КодСостояния = 201 Тогда
		
		ТекстОшибки = "При получении ответа от сервера обнаружена ошибка. Код состояния " + Строка(ОтветHTTP.КодСостояния) + Символы.ПС + ВернутьОписаниеОшибкиОтправкиЧекаВОчередьПоКоду(ОтветHTTP.КодСостояния);
		СтруктураВозврата.Сообщение = ТекстОшибки;
		ЗаписьЖурналаРегистрации("Печать чеков.Ошибка", УровеньЖурналаРегистрации.Ошибка, , , СтруктураВозврата.Сообщение);		
		
		Возврат СтруктураВозврата;   
		
	Иначе
		ЗаписьЖурналаРегистрации("Печать чеков.Обработка", УровеньЖурналаРегистрации.Информация, , , "Получен успешный ответ при отправке нефискального чека на сервер. Код состояния " + Строка(ОтветHTTP.КодСостояния));			
	КонецЕсли;
	
	СтруктураВозврата.Результат = Истина;
	СтруктураВозврата.Сообщение = "Чек успешно отправлен в очередь!";
	
	ЗаписьЖурналаРегистрации("Печать чеков.Завершение", УровеньЖурналаРегистрации.Информация, , , "Успешное завершение выполнения функции отправки нефискального чека на сервер печати");
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат СтруктураВозврата;
	
КонецФункции

Функция ОтправитьЧекВОчередьНаПечать(ПКОСсылка, Электронный = Ложь, Аннулирование = Ложь, МестоРасчетов = "", Коррекция = Ложь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ЗаписьЖурналаРегистрации("Печать чеков.Начало", УровеньЖурналаРегистрации.Информация, ПКОСсылка.Метаданные(), ПКОСсылка, "Начало выполнения функции отправки ПКО на сервер печати");		
	
	Касса = ПКОСсылка.Касса;
	
	СерверОтправки = Константы.АтолАдресВебСервера.Получить() + ":" + Формат(Константы.АтолПортВебСервера.Получить(), "ЧГ=0");

	СтруктураВозврата = Новый Структура("Результат, Сообщение", Ложь, "");
	
	ГУИД = Строка(Новый УникальныйИдентификатор());
	
	HTTPЗапрос = Новый HTTPЗапрос();
	HTTPЗапрос.АдресРесурса = "/api/v2/requests?deviceID=" + Касса.ИД;
	HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json;charset=utf-8");
	
	Попытка
		
		Если Аннулирование Тогда
			СтруктураJSON = СформироватьСтруктуруДляВозврата(ГУИД, Касса, ПКОСсылка, Электронный, МестоРасчетов, Коррекция);
		Иначе
			СтруктураJSON = СформироватьСтруктуруДляФискальногоЧека(ГУИД, Касса, ПКОСсылка, Электронный, МестоРасчетов, Коррекция);
		КонецЕсли;
	
		СтрокаЗапросаJS = ВернутьJSON(СтруктураJSON);
		ЗаписьЖурналаРегистрации("Печать чеков.Обработка", УровеньЖурналаРегистрации.Информация, ПКОСсылка.Метаданные(), ПКОСсылка, "Успешно сформирован JSON для отправки на сервер" + Символы.ПС + СтрокаЗапросаJS);		
		
	Исключение
		
		ТекстОшибки = "Ошибка формирования менеджера задания (JSON)" + Символы.ПС + ОписаниеОшибки();
		СтруктураВозврата.Сообщение = ТекстОшибки;
		ЗаписьЖурналаРегистрации("Печать чеков.Ошибка", УровеньЖурналаРегистрации.Ошибка, ПКОСсылка.Метаданные(), ПКОСсылка, СтруктураВозврата.Сообщение);		
		
		Возврат СтруктураВозврата;   
		
	КонецПопытки;
	
	//+Сёмин Р.И. 08.09.2026 #UT10-6020
	////+Сёмин Р.И. 08.07.2026 #UT10-5935
	//КодыМаркировки = Новый Массив;
	//
	//Если Константы.ИспользоватьПроверкуМаркировокТСПИоТ.Получить() Тогда
	//	
