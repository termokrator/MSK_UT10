Функция ПолучитьМассивМаркировки(Документ, Номенклатура, ЭтоВозврат, СтруктураЧека)
	
	МассивВозврата = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РеализацияТоваровУслугКодыМаркировки.Ссылка,
	|	РеализацияТоваровУслугКодыМаркировки.КодМаркировки КАК ШК
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.КодыМаркировки КАК РеализацияТоваровУслугКодыМаркировки
	|ГДЕ
	|	РеализацияТоваровУслугКодыМаркировки.Ссылка = &Ссылка
	|	И РеализацияТоваровУслугКодыМаркировки.КодМаркировки.Номенклатура = &Номенклатура";  
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "РеализацияТоваровУслуг", Документ.Метаданные().Имя);
	
	Запрос.УстановитьПараметр("Ссылка", Документ);  
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);  
	
	Выборка = Запрос.Выполнить().Выбрать();  
	
	Пока Выборка.Следующий() Цикл
		
		ШК = Выборка.ШК;
		
		СтруктураМаркировки = Новый Структура; 
		СтруктураМаркировки.Вставить("imcType", "auto");
		СтруктураМаркировки.Вставить("imc", КодироватьСтрокуВBase64(СтрЗаменить(ШК.ПолныйКодМаркировки.Получить(), "<GS>", Символ(29)))); 		
		
		Если ЭтоВозврат Тогда
			СтруктураМаркировки.Вставить("itemEstimatedStatus", "itemPieceReturn");
		Иначе
			
			Если СтруктураЧека.Свойство("clientInfo") И СтруктураЧека.clientInfo.Свойство("vatin") Тогда
				СтруктураМаркировки.Вставить("itemEstimatedStatus", "itemPieceForSale");
			Иначе
				СтруктураМаркировки.Вставить("itemEstimatedStatus", "itemPieceSold");
			КонецЕсли;			
			
		КонецЕсли;
				
		СтруктураМаркировки.Вставить("imcModeProcessing", 0);
			
		МассивВозврата.Добавить(СтруктураМаркировки); 
		
	КонецЦикла;            

	Возврат МассивВозврата;	
	
КонецФункции

Функция UNIXВДату(Unix) Экспорт
		
	Возврат МестноеВремя('19700101' + Unix); 
	
КонецФункции

Функция ВДокументеЛицевойИлиРозничныйДоговор(Док)
	
	//+Сёмин Р.И. 09.07.2026 #UT10-5935
	ДоговорКонтрагента = Неопределено;
	ЭтоЛицевойИлиРозничныйДоговор = Ложь;
	
	Если ТипЗнч(Док) = Тип("ДокументСсылка.ОплатаОтПокупателяПлатежнойКартой") Тогда
		ДоговорКонтрагента = Док.РасшифровкаПлатежа[0].ДоговорКонтрагента;
	ИначеЕсли ТипЗнч(Док) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер")
		ИЛИ ТипЗнч(Док) = Тип("ДокументСсылка.РасходныйКассовыйОрдер")
		ИЛИ ТипЗнч(Док) = Тип("ДокументСсылка.РеализацияТоваровУслуг")
		ИЛИ ТипЗнч(Док) = Тип("ДокументСсылка.КорректировкаРеализации")
		Тогда
		
		ДоговорКонтрагента = Док.ДоговорКонтрагента;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДоговорКонтрагента) Тогда
		ЭтоЛицевойИлиРозничныйДоговор = ДоговорКонтрагента.РозничнаяПродажа ИЛИ ДоговорКонтрагента.ЛицевойСчет;
	КонецЕсли;
	
	Возврат ЭтоЛицевойИлиРозничныйДоговор;
	//-Сёмин Р.И. 09.07.2026 #UT10-5935
	
КонецФункции

Функция ЭтоОплатаКартойИлиПКОСЛицевымСчетом(Док)
	
	//+Сёмин Р.И. 05.08.2026 #UT10-5994
	ДоговорКонтрагента = Неопределено;
	ЭтоЛицевойСчет = Ложь;
	
	Если ТипЗнч(Док) = Тип("ДокументСсылка.ОплатаОтПокупателяПлатежнойКартой") Тогда
		ДоговорКонтрагента = Док.РасшифровкаПлатежа[0].ДоговорКонтрагента;
	ИначеЕсли ТипЗнч(Док) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер") Тогда
		ДоговорКонтрагента = Док.ДоговорКонтрагента;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДоговорКонтрагента) Тогда
		ЭтоЛицевойСчет = ДоговорКонтрагента.ЛицевойСчет;
	КонецЕсли;
	
	Возврат ЭтоЛицевойСчет;
	//-Сёмин Р.И. 05.08.2026 #UT10-5994
	
КонецФункции

