Функция ПолучитьИнформациюПоПечатиЛюбогоДокумента(Дата)
	
	СтруктураВозврата = Новый Структура("ДатаПечати, ГУИД, Документ", Неопределено, "");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗаданияНаПробитиеЧекаСрезПоследних.ГУИД,
	|	ЗаданияНаПробитиеЧекаСрезПоследних.ДатаОбновления КАК ДатаПечати,
	|	ЗаданияНаПробитиеЧекаСрезПоследних.ПКО КАК Документ
	|ИЗ
	|	РегистрСведений.ЗаданияНаПробитиеЧека.СрезПоследних(, Статус = ""ready"") КАК ЗаданияНаПробитиеЧекаСрезПоследних
	|ГДЕ
	|	ЗаданияНаПробитиеЧекаСрезПоследних.ДатаОбновления МЕЖДУ &ДатаНач И &ДатаКон";
	
	Запрос.УстановитьПараметр("ДатаНач", НачалоДня(Дата));
	Запрос.УстановитьПараметр("ДатаКон", КонецДня(Дата));
	
	Выборка = Запрос.Выполнить().Выбрать(); 
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураВозврата, Выборка);
	КонецЕсли;
	
	Возврат СтруктураВозврата; 
		
КонецФункции

Функция ПолучитьСписокЧековЗаПериод(ВремяНачала, ВремяОкончания) Экспорт
	
	СтруктураВозврата = Новый Структура("Результат, Сообщение, Данные", Ложь, "", Неопределено);
	
	СтруктураПечати = ПолучитьИнформациюПоПечатиЛюбогоДокумента(ВремяНачала);
	
	Если Не ЗначениеЗаполнено(СтруктураПечати.ДатаПечати) Тогда
		
		СтруктураВозврата.Сообщение = "Не удалось получить по документу данные по печати чека";
		
		Возврат СтруктураВозврата;
		
	КонецЕсли; 
	
	Документ = СтруктураПечати.Документ;	
	ДатаПечати = СтруктураПечати.ДатаПечати;
	ГУИД = СтруктураПечати.ГУИД; 
	
	СтруктураРегНомера = ПолучитьРегистрационныйНомерККТ(ДатаПечати, ГУИД, Документ);
	
	Если Не СтруктураРегНомера.Результат Тогда
		
		СтруктураВозврата.Сообщение = "Не удалось получить регистрационный номер ККМ: " + СтруктураРегНомера.Сообщение;
		
		Возврат СтруктураВозврата;

	КонецЕсли;
	
	РегистрационныйНомер = СтруктураРегНомера.Номер;	
	СтруктураАутификации = ПолучитьПараметрыАутификацииииСБИС();	
	
	Если Не СтруктураАутификации.Результат Тогда 	                 
		
		СтруктураВозврата.Сообщение = "Проблемы при аутификации в СБИС: " + СтруктураАутификации.Сообщение;	
		
		Возврат СтруктураВозврата;
		
	КонецЕсли;     
	
	SID = СтруктураАутификации.Данные.sid; 
	ИНН = Константы.ОсновнаяОрганизация.Получить().ИНН;  
	
	СтруктураФискальногоНакопителя = ПолучитьНомерФискальногоНакопителя(РегистрационныйНомер, ДатаПечати, SID, ИНН);
	
	Если Не СтруктураФискальногоНакопителя.Результат Тогда
		
		СтруктураВозврата.Сообщение = "Проблемы при получении номера накопителя: " + СтруктураФискальногоНакопителя.Сообщение;	
		
		Возврат СтруктураВозврата;
		
	КонецЕсли;   	
	
	НомерНакопителя = СтруктураФискальногоНакопителя.Номер;
		
	HTTPСоединение = Новый HTTPСоединение("api.sbis.ru", , , , , 10, Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Неопределено));
	HTTPЗапрос = Новый HTTPЗапрос("/ofd/v1/orgs/" + Строка(ИНН) + "/kkts/" + Строка(РегистрационныйНомер) + "/storages/" + Строка(НомерНакопителя) + "/docs?dateFrom=" + Формат(ВремяНачала, "ДФ=yyyy-MM-ddTHH:mm:ss") + "&dateTo=" + Формат(ВремяОкончания, "ДФ=yyyy-MM-ddTHH:mm:ss") + "&limit=1000"); 	
	HTTPЗапрос.Заголовки.Вставить("Cookie", "sid=" + SID);
	Ответ = HTTPСоединение.Получить(HTTPЗапрос);
	
	Если Ответ.КодСостояния <> 200 Тогда
		
		ОтветСтрока = Ответ.ПолучитьТелоКакСтроку();   
		
		СтруктураВозврата.Сообщение = ОтветСтрока; 
		Возврат СтруктураВозврата;
				
	КонецЕсли;   
	
	Данные = Ответ.ПолучитьТелоКакСтроку();
	
	СтруктураВозврата.Результат = Истина;
	СтруктураВозврата.Данные = Данные; 	
	
	Возврат СтруктураВозврата;
	
КонецФункции

Функция ПроверитьНаДублиВПределахДня(Дата, ВремяНачала = Неопределено, ВремяОкончания = Неопределено) Экспорт
		
	Если ВремяНачала = Неопределено Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	МАКСИМУМ(ПроверкиПоДублямЧековСрезПоследних.ВремяОкончания) КАК ВремяОкончания
		|ИЗ
		|	РегистрСведений.ПроверкиПоДублямЧеков.СрезПоследних(
		|			,
		|			День = &День
		|				И Успешно) КАК ПроверкиПоДублямЧековСрезПоследних";
		
		Запрос.УстановитьПараметр("День", Дата);  
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() И Выборка.ВремяОкончания <> NULL Тогда
			ВремяНачала = НачалоДня(Дата) + (Выборка.ВремяОкончания + 1 - Дата('00010101'));
		Иначе
			ВремяНачала = НачалоДня(Дата);	
		КонецЕсли;         
		
	КонецЕсли; 
	
	Если ВремяОкончания = Неопределено Тогда
		
		Т = ТекущаяДата();
		ВремяОкончания = НачалоДня(Дата) + (Т - НачалоДня(Т));
		
	КонецЕсли; 
	
	ГУИДПроверки = Строка(Новый УникальныйИдентификатор);
	
	МенеджерПроверки = РегистрыСведений.ПроверкиПоДублямЧеков.СоздатьМенеджерЗаписи(); 
	МенеджерПроверки.Период = ТекущаяДата();
	МенеджерПроверки.День = Дата;
	МенеджерПроверки.ВремяНачала = ВремяНачала;
	МенеджерПроверки.ВремяОкончания = ВремяОкончания;
	МенеджерПроверки.ГУИД = ГУИДПроверки;         
	
	СтруктураЧеков = Чеки.ПолучитьСписокЧековЗаПериод(ВремяНачала, ВремяОкончания);
	
	Если СтруктураЧеков.Результат Тогда
			
		Данные = СтруктураЧеков.Данные;
		ДанныеСтруктура = ОбщегоНазначения.ВернутьСтруктуруИзJSON(Данные); 
		Дубли = НайтиДублиЗаказов(ДанныеСтруктура); 
		
		МенеджерПроверки.КоличествоДублей = Дубли.Количество();
		МенеджерПроверки.Успешно = Истина;		
		
		Если Дубли.Количество() > 0 Тогда
			
			ЗаписьЖурналаРегистрации("Дубли чеков.Проверка", УровеньЖурналаРегистрации.Предупреждение,,,"Обнаружено: " + Строка(Дубли.Количество()) + " дублей чеков. День: " + Формат(Дата,"ДФ=dd.MM.yyyy" ));
			
			НаборДублей = РегистрыСведений.ДублиПоЧекам.СоздатьНаборЗаписей();
			НаборДублей.Отбор.ГУИД.Установить(ГУИДПроверки);	
			
			Инд = 0;
			
			Для каждого ГруппаДублей Из Дубли Цикл	
				
				МассивНомеровЧековККМ = Новый Массив;
				
				Для каждого ЭлементГруппы Из ГруппаДублей Цикл
					МассивНомеровЧековККМ.Добавить(ЭлементГруппы.receipt.fiscalDocumentNumber);	
				КонецЦикла;    
				
				ДатаЧека = Чеки.UNIXВДату(ГруппаДублей[0].receipt.dateTime);
				
				ДокументПоНомерамЧекаККМ = ПолучитьДокументПоНомерамЧекаККМ(МассивНомеровЧековККМ, ДатаЧека);
				
				Если ДокументПоНомерамЧекаККМ <> Неопределено И ДокументПоНомерамЧекаККМ.Количество() = МассивНомеровЧековККМ.Количество() Тогда
					Продолжить;
				КонецЕсли;
				
				Инд = Инд + 1;
				
				Запись = НаборДублей.Добавить();
				Запись.Период = ТекущаяДата();
				Запись.ГУИД = ГУИДПроверки; 
				Запись.НомерДубля = Инд;
				Запись.Данные = ОбщегоНазначения.ВернутьJSON(ГруппаДублей);  
				Запись.Сумма = ГруппаДублей[0].receipt.totalSum / 100; 
				Запись.Дата = ДатаЧека; 
				Запись.Документ = ?(ДокументПоНомерамЧекаККМ = Неопределено, Неопределено, ДокументПоНомерамЧекаККМ[0]);
							
			КонецЦикла; 
			
			НаборДублей.Записать(Истина);
			
		КонецЕсли;
		
	Иначе
		МенеджерПроверки.ТекстОшибки = СтруктураЧеков.Сообщение;
	КонецЕсли; 
	
	МенеджерПроверки.Записать();
		
КонецФункции 

Функция ПолучитьДокументПоНомерамЧекаККМ(МассивНомеровЧековККМ, ДатаЧека)
    
    Если МассивНомеровЧековККМ.Количество() = 0 Тогда
        Возврат Неопределено; // Если искать нечего, возвращаем пустой массив
    КонецЕсли;

    ТекстЗапроса = "";
    
    // Перебираем метаданные всех документов конфигурации
    Для Каждого МетаданныеДокумента Из Метаданные.Документы Цикл
        
        // Проверяем наличие реквизита "НомерЧекаККМ" у документа
        Если МетаданныеДокумента.Реквизиты.Найти("НомерЧекаККМ") <> Неопределено Тогда
            
            ТекстЧасти = 
                "ВЫБРАТЬ
                |   Док.Ссылка КАК Ссылка,
                |   Док.НомерЧекаККМ КАК НомерЧекаККМ
                |ИЗ
                |   Документ." + МетаданныеДокумента.Имя + " КАК Док
                |ГДЕ
                |   Док.НомерЧекаККМ В(&МассивНомеровЧековККМ) И Док.Дата Между &ДатаНач и &ДатаКон";
                
            // Если текст запроса уже содержит данные, добавляем соединение
            Если Не ПустаяСтрока(ТекстЗапроса) Тогда
                ТекстЗапроса = ТекстЗапроса + Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС;
            КонецЕсли;
            
            // Прибавляем новую часть к общему тексту
            ТекстЗапроса = ТекстЗапроса + ТекстЧасти;
            
        КонецЕсли;
        
    КонецЦикла;
    
    // Если не найдено ни одного документа с таким реквизитом
    Если ПустаяСтрока(ТекстЗапроса) Тогда
        Возврат Новый Массив; 
    КонецЕсли;
    
    // Инициализируем и выполняем запрос
    Запрос = Новый Запрос;
    Запрос.Текст = ТекстЗапроса;
    Запрос.УстановитьПараметр("МассивНомеровЧековККМ", МассивНомеровЧековККМ);
	Запрос.УстановитьПараметр("ДатаНач", ДобавитьМесяц(ДатаЧека, -1));
	Запрос.УстановитьПараметр("ДатаКон", ДобавитьМесяц(ДатаЧека, 1));
    
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();    
    НайденныеДокументы = Новый Массив;
    
    Пока Выборка.Следующий() Цикл
        НайденныеДокументы.Добавить(Выборка.Ссылка);
    КонецЦикла;
	
	Если НайденныеДокументы.Количество() > 0 Тогда
		Возврат НайденныеДокументы; 	
	КонецЕсли; 
	
    Возврат Неопределено;

КонецФункции

Функция НайтиДублиЗаказов(МассивЗаказов)
	
	// 1. Создаем Таблицу Значений с жесткой типизацией колонок
	ТЗ_Заказы = Новый ТаблицаЗначений;
	ТЗ_Заказы.Колонки.Добавить("ИндексМассива", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)));
	ТЗ_Заказы.Колонки.Добавить("dateTime", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 0)));
	ТЗ_Заказы.Колонки.Добавить("totalSum", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	ТЗ_Заказы.Колонки.Добавить("cashTotalSum", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));    
	
	// 2. Заполняем ТЗ данными из массива, отсеивая лишнее (например, openShift)
	Для Индекс = 0 По МассивЗаказов.ВГраница() Цикл
		ЭлементМассива = МассивЗаказов[Индекс];
		
		ДанныеЧека = Неопределено;
		Если ЭлементМассива.Свойство("receipt", ДанныеЧека) Тогда 
			
			НоваяСтрока = ТЗ_Заказы.Добавить();
			НоваяСтрока.ИндексМассива = Индекс;
			НоваяСтрока.dateTime      = ДанныеЧека.dateTime;
			НоваяСтрока.totalSum      = ДанныеЧека.totalSum;
			НоваяСтрока.cashTotalSum       = ДанныеЧека.cashTotalSum;
			
		КонецЕсли;
	КонецЦикла;
	
	МассивВсехДублей = Новый Массив;
	
	// Если чеков нет, возвращаем пустой массив
	Если ТЗ_Заказы.Количество() = 0 Тогда
		Возврат МассивВсехДублей;
	КонецЕсли;
	
	// 3. Запрос для поиска дублей
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЗ.ИндексМассива КАК ИндексМассива,
	|	ТЗ.dateTime КАК dateTime,
	|	ТЗ.totalSum КАК totalSum,
	|	ТЗ.cashTotalSum КАК cashTotalSum
	|ПОМЕСТИТЬ ВТ_ИсходныеДанные
	|ИЗ
	|	&ТЗ КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ИсходныеДанные.dateTime КАК dateTime,
	|	ВТ_ИсходныеДанные.totalSum КАК totalSum,
	|	ВТ_ИсходныеДанные.cashTotalSum КАК cashTotalSum
	|ПОМЕСТИТЬ ВТ_Дубли
	|ИЗ
	|	ВТ_ИсходныеДанные КАК ВТ_ИсходныеДанные
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ИсходныеДанные.dateTime,
	|	ВТ_ИсходныеДанные.totalSum,
	|	ВТ_ИсходныеДанные.cashTotalSum
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(ВТ_ИсходныеДанные.ИндексМассива) > 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ИсходныеДанные.ИндексМассива КАК ИндексМассива,
	|	ВТ_ИсходныеДанные.dateTime КАК dateTime,
	|	ВТ_ИсходныеДанные.totalSum КАК totalSum,
	|	ВТ_ИсходныеДанные.cashTotalSum КАК cashTotalSum
	|ИЗ
	|	ВТ_ИсходныеДанные КАК ВТ_ИсходныеДанные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Дубли КАК ВТ_Дубли
	|		ПО ВТ_ИсходныеДанные.dateTime = ВТ_Дубли.dateTime
	|			И ВТ_ИсходныеДанные.totalSum = ВТ_Дубли.totalSum
	|				И ВТ_ИсходныеДанные.cashTotalSum = ВТ_Дубли.cashTotalSum
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_ИсходныеДанные.dateTime,
	|	ВТ_ИсходныеДанные.totalSum,
	|	ВТ_ИсходныеДанные.cashTotalSum";
	
	Запрос.УстановитьПараметр("ТЗ", ТЗ_Заказы);
	
	// 4. Выполняем запрос и пакуем дубли в массив массивов
	Выборка = Запрос.Выполнить().Выбрать();
	
	МассивТекущейГруппы = Неопределено;
	Пред_dateTime = Неопределено;
	Пред_totalSum = Неопределено;
	Пред_cashTotalSum = Неопределено;
	
	Пока Выборка.Следующий() Цикл
		
		// Если комбинация даты и суммы сменилась — значит началась новая группа дублей
		Если Пред_dateTime <> Выборка.dateTime Или Пред_totalSum <> Выборка.totalSum Или Пред_cashTotalSum <> Выборка.cashTotalSum Тогда
			
			// Создаем новый массив для новой группы
			МассивТекущейГруппы = Новый Массив;
			// Сразу кладем его в общий массив (в 1С массивы передаются по ссылке, 
			// поэтому мы сможем его заполнять дальше)
			МассивВсехДублей.Добавить(МассивТекущейГруппы);
			
			// Запоминаем новые значения для следующих итераций
			Пред_dateTime = Выборка.dateTime;
			Пред_totalSum = Выборка.totalSum;
			Пред_cashTotalSum = Выборка.cashTotalSum;
			
		КонецЕсли;
		
		// Добавляем оригинальную структуру заказа во вложенный массив текущей группы
		МассивТекущейГруппы.Добавить(МассивЗаказов[Выборка.ИндексМассива]);
		
	КонецЦикла;
	
	Возврат МассивВсехДублей;
	
КонецФункции


