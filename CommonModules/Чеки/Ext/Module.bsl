		Если HTTPОтвет.КодСостояния = 203 Тогда
			
			Результат.Сообщение = "Аварийный режим ТС ПИоТ, продажа разрешена";
			Результат.Результат = Истина; // По документации, при 203 продажа разрешается ♯а1с:1033
			
		ИначеЕсли HTTPОтвет.КодСостояния = 400 Тогда
			Результат.Сообщение = "Неверный формат запроса: " + Чеки.ВернутьJSON(ПараметрыЗапроса);
		ИначеЕсли HTTPОтвет.КодСостояния = 500 Тогда
			Результат.Сообщение = "Internal Server Error - внутренняя ошибка сервера при обработке запроса";		
		ИначеЕсли HTTPОтвет.КодСостояния = 504 Тогда
			Результат.Сообщение = "Gateway Timeout - превышено время ожидания ответа от upstream сервиса";	
		ИначеЕсли HTTPОтвет.КодСостояния = 514 Тогда
			Результат.Сообщение = "Таймаут: нет ответа от ГИС МТ и ЛМ ЧЗ";
		Иначе
			Результат.Сообщение = "Не получен ответ от сервиса ПИоТ. HTTP ошибка: " + HTTPОтвет.КодСостояния;
		КонецЕсли;      
		
	КонецЕсли;
	
	Если ПолученыДанныеПоКодамИзПИоТ Тогда
		
		Для Каждого Стр Из ТаблицаПроверенныхКодов Цикл
			
			МенеджерЗаписи = РегистрыСведений.ИсторияКодовМаркировокПиОТ.СоздатьМенеджерЗаписи();
			
			МенеджерЗаписи.Дата = ТекущаяДата();
			МенеджерЗаписи.Успешно = Стр.ДействиеРезрешено;
			МенеджерЗаписи.Данные = ВернутьJSON(Стр.ДанныеКода);
			МенеджерЗаписи.Действие = Операция;
			МенеджерЗаписи.ПричинаЗапрета = Стр.ПричинаЗапрета;
			
			//+Сёмин Р.И. 08.09.2026 #UT10-6020
			МенеджерЗаписи.isCheckedOffline = ОтветПоКоду.isCheckedOffline;
			МенеджерЗаписи.reqId = ОтветПоКоду.reqId;
			МенеджерЗаписи.reqTimestamp = ОтветПоКоду.reqTimestamp;
			
			Если ОтветПоКоду.isCheckedOffline Тогда
				
				Если ОтветПоКоду.Свойство("inst") Тогда
					МенеджерЗаписи.inst = ОтветПоКоду.inst;
				КонецЕсли;
				
				Если ОтветПоКоду.Свойство("version") Тогда
					МенеджерЗаписи.version = ОтветПоКоду.version;
				КонецЕсли;
				
			КонецЕсли;
			//-Сёмин Р.И. 08.09.2026 #UT10-6020
			
			Если ЗначениеЗаполнено(Источник) Тогда
				МенеджерЗаписи.Документ = Источник;
			КонецЕсли;
			
			Если ТипЗнч(КодМассивКодовМаркировки) = Тип("Массив") Тогда
				
				СтрокиКодМаркировки = КодыМаркировкиДляПроверки.НайтиСтроки(Новый Структура("КороткийКодМаркировки", Стр.ДанныеКода.printView));
				
				Если ЗначениеЗаполнено(СтрокиКодМаркировки) Тогда
					МенеджерЗаписи.ШтрихкодНоменклатуры = СтрокиКодМаркировки.Получить(0).ШтрихкодНоменклатуры;
				КонецЕсли;
				
			Иначе
				МенеджерЗаписи.ШтрихкодНоменклатуры = КодМассивКодовМаркировки;
			КонецЕсли;
			
			Попытка
				МенеджерЗаписи.Записать();
			Исключение
			КонецПопытки;
			
		КонецЦикла;
		
	Иначе
		
		Для Каждого Стр Из КодыМаркировкиДляПроверки Цикл
			
			МенеджерЗаписи = РегистрыСведений.ИсторияКодовМаркировокПиОТ.СоздатьМенеджерЗаписи();
			
			МенеджерЗаписи.Дата = ТекущаяДата();
			МенеджерЗаписи.Успешно = Ложь;
			МенеджерЗаписи.Действие = Операция;
			МенеджерЗаписи.ПричинаЗапрета = Результат.Сообщение;
			
			Если ЗначениеЗаполнено(Источник) Тогда
				МенеджерЗаписи.Документ = Источник;
			КонецЕсли;
			
			МенеджерЗаписи.ШтрихкодНоменклатуры = Стр.ШтрихкодНоменклатуры;
			
			Попытка
				МенеджерЗаписи.Записать();
			Исключение
			КонецПопытки;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	//-Сёмин Р.И. 06.07.2026 #UT10-5935
	
КонецФункции

Процедура ДобавитьКодМаркировкиВТаблицуДляПроверкиПИоТ(КодМаркировки, ТаблицаКодовДляПроверки)
	
	//+Сёмин Р.И. 08.07.2026 #UT10-5935
	НовСтр = ТаблицаКодовДляПроверки.Добавить();
	НовСтр.ШтрихкодНоменклатуры = КодМаркировки;
	НовСтр.КороткийКодМаркировки = КодМаркировки.КодМаркировки;
	
	ПолныйКодМаркировки = КодМаркировки.ПолныйКодМаркировки.Получить();
	
	Если Найти(ПолныйКодМаркировки, "<GS>") = 0 И Найти(ПолныйКодМаркировки, Символ(29)) = 0 Тогда
		
		ПолныйКодМаркировки = ДобавитьВКодМаркировкиНедостающиеСимволы(ПолныйКодМаркировки);
		ПолныйКодМаркировки = СтрЗаменить(ПолныйКодМаркировки, "<GS>", Символ(29));
		
	КонецЕсли;
	
	НовСтр.ПолныйКодМаркировки = КодироватьСтрокуВBase64(ПолныйКодМаркировки);
	//-Сёмин Р.И. 08.07.2026 #UT10-5935
	
КонецПроцедуры

Функция ЗарегистрироватьПродажуВозвратПИоТ(КодМассивКодовМаркировки, АдресТСПиоТ, Действие = "Продажа", Событие = "", Источник = Неопределено, ИмяСобытияЖР = "РучнаяРегистрацияПродажиВозвратаПИоТ") Экспорт
	
	//+Сёмин Р.И. 07.07.2026 #UT10-5935
	Если ЗначениеЗаполнено(Событие) Тогда
		Операция = Событие;
	Иначе
		Операция = Действие;
	КонецЕсли;
	
	КодыМаркировкиДляРегистрации = Новый ТаблицаЗначений;
	КодыМаркировкиДляРегистрации.Колонки.Добавить("ШтрихкодНоменклатуры");
	КодыМаркировкиДляРегистрации.Колонки.Добавить("КороткийКодМаркировки");
	
	Если ТипЗнч(КодМассивКодовМаркировки) <> Тип("Массив") Тогда
		ДобавитьКодМаркировкиВТаблицуДляРегистрацииПИоТ(КодМассивКодовМаркировки, КодыМаркировкиДляРегистрации);
	Иначе
		
		Для Каждого Стр Из КодМассивКодовМаркировки Цикл
			ДобавитьКодМаркировкиВТаблицуДляРегистрацииПИоТ(Стр, КодыМаркировкиДляРегистрации);
		КонецЦикла;
		
	КонецЕсли;
	
	КодыМаркировкиRfc1738 = КодыМаркировкиДляРегистрации.ВыгрузитьКолонку("КороткийКодМаркировки");
	
	СтруктураВозврата = Новый Структура("Результат, Сообщение, Данные", Ложь, "", Неопределено);
	
	НеУдалосьЗарегистрировать = Новый Массив;
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("cis_list", КодыМаркировкиRfc1738);
		
	Если Действие = "Продажа" Тогда
		URL = "/api/v2/lmSell";  
	ИначеЕсли Действие = "Возврат" Тогда 
		URL = "/api/v2/lmReturn";
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации(
		ИмяСобытияЖР,
		УровеньЖурналаРегистрации.Информация,
		?(ЗначениеЗаполнено(Источник), Источник.Метаданные(), ""),
		?(ЗначениеЗаполнено(Источник), Источник, ""),
		"В ПИоТ направлен запрос на регистрацию действия " + Действие + " по кодам:" + Символы.ПС + МодульРегламентныхЗаданий.СтрСоединить(КодыМаркировкиRfc1738, Символы.ПС)
	);
	
	ПолученыДанныеРегистрацииПИоТ = Ложь;
	   
	HTTPОтвет = OPI_ЗапросыHTTP.PostСТелом(АдресТСПиоТ + URL, ПараметрыЗапроса,,,Истина,,1,2);	
	
	Если HTTPОтвет.КодСостояния = 200 Тогда

		ТекстОтвета = HTTPОтвет.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		Ответ = ВернутьСтруктуруИзJSON(ТекстОтвета);
		
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖР,
			УровеньЖурналаРегистрации.Информация,
			?(ЗначениеЗаполнено(Источник), Источник.Метаданные(), ""),
			?(ЗначениеЗаполнено(Источник), Источник, ""),
			"Ответ из ПиОТ по действию " + Действие + " :" + ТекстОтвета 
		);
		
		//+Сёмин Р.И. 04.08.2026 #UT10-5994
		results = Неопределено;
		
		Если ТипЗнч(Ответ) = Тип("Массив") Тогда
			results = Ответ;
		ИначеЕсли ТипЗнч(Ответ) = Тип("Структура") Тогда
			
			Если НЕ Ответ.Свойство("results") Тогда
				СтруктураВозврата.Сообщение = "Неизвестный формат ответа от ТС ПИоТ #3. " + ТекстОтвета;
			Иначе
				results = Ответ.results;
			КонецЕсли;
			
		Иначе
			СтруктураВозврата.Сообщение = "Неизвестный формат ответа от ТС ПИоТ #4. " + ТекстОтвета;
		КонецЕсли;
		
		//Если НЕ Ответ.Свойство("results") Тогда
		//	СтруктураВозврата.Сообщение = "Неизвестный формат ответа от ТС ПИоТ #3. " + ТекстОтвета;
		//Иначе        
		
		Если results <> Неопределено Тогда
		//-Сёмин Р.И. 04.08.2026 #UT10-5994
		
			ПолученыДанныеРегистрацииПИоТ = Истина;
			
			ТаблицаЗарегистрированныхКодов = Новый ТаблицаЗначений; 
			ТаблицаЗарегистрированныхКодов.Колонки.Добавить("ДействиеРезрешено");
			ТаблицаЗарегистрированныхКодов.Колонки.Добавить("КодМаркировки");
			
			//Для Каждого Результат Из Ответ.results Цикл
			Для Каждого Результат Из results Цикл
				
				НСтр = ТаблицаЗарегистрированныхКодов.Добавить(); 
				
				Если Результат.Свойство("success") Тогда
					НСтр.ДействиеРезрешено = Результат.success;   				
				Иначе 
					
					//Если свойство success отсутствует, то действие уже было выполнено (т.е. запрос на регистрацию дейстия повторный)
					НСтр.ДействиеРезрешено = Истина;
					
				КонецЕсли;
				
				НСтр.КодМаркировки = Результат.cis;
				
				Если НЕ НСтр.ДействиеРезрешено Тогда
					НеУдалосьЗарегистрировать.Добавить(НСтр.КодМаркировки);
				КонецЕсли;
				
			КонецЦикла;     
			
			СтрокиКодовСРазрешенныимДействием = ТаблицаЗарегистрированныхКодов.НайтиСтроки(Новый Структура("ДействиеРезрешено", Истина));
			
			Если СтрокиКодовСРазрешенныимДействием.Количество() = ТаблицаЗарегистрированныхКодов.Количество() Тогда
				
				СтруктураВозврата.Результат = Истина;
				
				ЗаписьЖурналаРегистрации(
					ИмяСобытияЖР,
					УровеньЖурналаРегистрации.Информация,
					?(ЗначениеЗаполнено(Источник), Источник.Метаданные(), ""),
					?(ЗначениеЗаполнено(Источник), Источник, ""),
					"Регистрация в ПИоТ действия " + Действие + " выполнена успешно."
				);
				
			Иначе
				
				СтруктураВозврата.Сообщение = "Не все коды разрешены для действия " + Действие + ". Список запрещенных кодов:" + Символы.ПС + МодульРегламентныхЗаданий.СтрСоединить(НеУдалосьЗарегистрировать, Символы.ПС);
				
				ЗаписьЖурналаРегистрации(
					ИмяСобытияЖР,
					УровеньЖурналаРегистрации.Ошибка,
					?(ЗначениеЗаполнено(Источник), Источник.Метаданные(), ""),
					?(ЗначениеЗаполнено(Источник), Источник, ""),
					СтруктураВозврата.Сообщение
				);
				
			КонецЕсли;
			
			СтруктураВозврата.Данные = ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаЗарегистрированныхКодов);
			
		КонецЕсли;
		
	Иначе
		
		СтруктураВозврата.Сообщение = "Ответ из ПиОТ по действию " + Действие + ": HTTP ошибка " + Строка(HTTPОтвет.КодСостояния);
		
		Попытка
			СтруктураВозврата.Сообщение = СтруктураВозврата.Сообщение + Символы.ПС + HTTPОтвет.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		Исключение
		КонецПопытки;
		
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖР,
			УровеньЖурналаРегистрации.Ошибка,
			?(ЗначениеЗаполнено(Источник), Источник.Метаданные(), ""),
			?(ЗначениеЗаполнено(Источник), Источник, ""),
			СтруктураВозврата.Сообщение
		);
		
	КонецЕсли;
	
	Если ПолученыДанныеРегистрацииПИоТ Тогда
		
		Для Каждого Стр Из ТаблицаЗарегистрированныхКодов Цикл
			
			МенеджерЗаписи = РегистрыСведений.ИсторияКодовМаркировокПиОТ.СоздатьМенеджерЗаписи();
			
			МенеджерЗаписи.Дата = ТекущаяДата();
			МенеджерЗаписи.Успешно = Стр.ДействиеРезрешено;
			МенеджерЗаписи.Действие = Операция;
			
			Если ЗначениеЗаполнено(Источник) Тогда
				МенеджерЗаписи.Документ = Источник;
			КонецЕсли;
			
			Если ТипЗнч(КодМассивКодовМаркировки) = Тип("Массив") Тогда
				
				СтрокиКодМаркировки = КодыМаркировкиДляРегистрации.НайтиСтроки(Новый Структура("КороткийКодМаркировки", Стр.КодМаркировки));
				
				Если ЗначениеЗаполнено(СтрокиКодМаркировки) Тогда
					МенеджерЗаписи.ШтрихкодНоменклатуры = СтрокиКодМаркировки.Получить(0).ШтрихкодНоменклатуры;
				КонецЕсли;
				
			Иначе
				МенеджерЗаписи.ШтрихкодНоменклатуры = КодМассивКодовМаркировки;
			КонецЕсли;
			
			Попытка
				МенеджерЗаписи.Записать();
			Исключение
			КонецПопытки;
			
		КонецЦикла;
		
	Иначе
		
		Для Каждого Стр Из КодыМаркировкиДляРегистрации Цикл
			
			МенеджерЗаписи = РегистрыСведений.ИсторияКодовМаркировокПиОТ.СоздатьМенеджерЗаписи();
			
			МенеджерЗаписи.Дата = ТекущаяДата();
			МенеджерЗаписи.Успешно = Ложь;
			МенеджерЗаписи.Действие = Операция;
			МенеджерЗаписи.ПричинаЗапрета = СтрЗаменить(СтруктураВозврата.Сообщение, Символы.ПС, " ");
			
			Если ЗначениеЗаполнено(Источник) Тогда
				МенеджерЗаписи.Документ = Источник;
			КонецЕсли;
			
			МенеджерЗаписи.ШтрихкодНоменклатуры = Стр.ШтрихкодНоменклатуры;
			
			Попытка
				МенеджерЗаписи.Записать();
			Исключение
			КонецПопытки;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	//-Сёмин Р.И. 07.07.2026 #UT10-5935
	
КонецФункции

Процедура ДобавитьКодМаркировкиВТаблицуДляРегистрацииПИоТ(КодМаркировки, ТаблицаКодовДляРегистрации)
	
	//+Сёмин Р.И. 08.07.2026 #UT10-5935
	НовСтр = ТаблицаКодовДляРегистрации.Добавить();
	НовСтр.ШтрихкодНоменклатуры = КодМаркировки;
	НовСтр.КороткийКодМаркировки = КодироватьСтрокуВRFC1738(КодМаркировки.КодМаркировки);
	//-Сёмин Р.И. 08.07.2026 #UT10-5935
	
КонецПроцедуры

Функция ПолучитьТекстЗапросаМаркировокПоНоменклатуреСПроверкамиПИоТ()
	
	//+Сёмин Р.И. 09.09.2026 #UT10-6020
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	Документ.КодМаркировки.Номенклатура КАК Номенклатура,
		|	Документ.КодМаркировки КАК ШК,
		|	ВЫБОР
		|		КОГДА Документ.Ссылка.ДоговорКонтрагента.ЛицевойСчет
		|				ИЛИ Документ.Ссылка.ДоговорКонтрагента.РозничнаяПродажа
		|			ТОГДА ""itemPieceSold""
		|		ИНАЧЕ ВЫБОР
		|				КОГДА Документ.Ссылка.ДоговорКонтрагента.УсловияРаботыСЧЗ = ЗНАЧЕНИЕ(Перечисление.УсловияРаботыСЧЗ.УчастникОборота)
		|					ТОГДА ""itemPieceForSale""
		|				КОГДА Документ.Ссылка.ДоговорКонтрагента.УсловияРаботыСЧЗ = ЗНАЧЕНИЕ(Перечисление.УсловияРаботыСЧЗ.ПокупкаДляСобственныхНужд)
		|					ТОГДА ""itemPieceSold""
		|				ИНАЧЕ ""itemPieceForSale""
		|			КОНЕЦ
		|	КОНЕЦ КАК itemEstimatedStatus,
		|	Документ.Ссылка.Дата КАК ДатаДокумента,
		|	Документ.Ссылка.Номер КАК НомерДокумента
		|ПОМЕСТИТЬ ВТ_Предварительная
		|ИЗ
		|	Документ.РеализацияТоваровУслуг.КодыМаркировки КАК Документ
		|ГДЕ
		|	Документ.Ссылка В(&МассивДокументов)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Документ.КодМаркировки.Номенклатура,
		|	Документ.КодМаркировки,
		|	ВЫБОР
		|		КОГДА Документ.Ссылка.ДоговорКонтрагента.ЛицевойСчет
		|				ИЛИ Документ.Ссылка.ДоговорКонтрагента.РозничнаяПродажа
		|			ТОГДА ""itemPieceSold""
		|		ИНАЧЕ ВЫБОР
		|				КОГДА Документ.Ссылка.ДоговорКонтрагента.УсловияРаботыСЧЗ = ЗНАЧЕНИЕ(Перечисление.УсловияРаботыСЧЗ.УчастникОборота)
		|					ТОГДА ""itemPieceForSale""
		|				КОГДА Документ.Ссылка.ДоговорКонтрагента.УсловияРаботыСЧЗ = ЗНАЧЕНИЕ(Перечисление.УсловияРаботыСЧЗ.ПокупкаДляСобственныхНужд)
		|					ТОГДА ""itemPieceSold""
		|				ИНАЧЕ ""itemPieceForSale""
		|			КОНЕЦ
		|	КОНЕЦ,
		|	Документ.Ссылка.Дата,
		|	Документ.Ссылка.Номер
		|ИЗ
		|	Документ.КорректировкаРеализации.КодыМаркировки КАК Документ
		|ГДЕ
		|	Документ.Ссылка В(&МассивДокументов)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МАКСИМУМ(ИсторияКодовМаркировокПиОТ.Дата) КАК Дата,
		|	ИсторияКодовМаркировокПиОТ.ШтрихкодНоменклатуры
		|ПОМЕСТИТЬ ВТ_ДатыПроверокПИоТ
		|ИЗ
		|	РегистрСведений.ИсторияКодовМаркировокПиОТ КАК ИсторияКодовМаркировокПиОТ
		|ГДЕ
		|	ИсторияКодовМаркировокПиОТ.ШтрихкодНоменклатуры В
		|			(ВЫБРАТЬ
		|				ВТ_Предварительная.ШК
		|			ИЗ
		|				ВТ_Предварительная)
		|
		|СГРУППИРОВАТЬ ПО
		|	ИсторияКодовМаркировокПиОТ.ШтрихкодНоменклатуры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ДатыПроверокПИоТ.ШтрихкодНоменклатуры,
		|	ВТ_ДатыПроверокПИоТ.Дата,
		|	ИсторияКодовМаркировокПиОТ.isCheckedOffline,
		|	ИсторияКодовМаркировокПиОТ.reqId,
		|	ИсторияКодовМаркировокПиОТ.reqTimestamp,
		|	ИсторияКодовМаркировокПиОТ.inst,
		|	ИсторияКодовМаркировокПиОТ.version
		|ПОМЕСТИТЬ ВТ_ПроверкиПИоТ
		|ИЗ
		|	ВТ_ДатыПроверокПИоТ КАК ВТ_ДатыПроверокПИоТ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсторияКодовМаркировокПиОТ КАК ИсторияКодовМаркировокПиОТ
		|		ПО ВТ_ДатыПроверокПИоТ.ШтрихкодНоменклатуры = ИсторияКодовМаркировокПиОТ.ШтрихкодНоменклатуры
		|			И ВТ_ДатыПроверокПИоТ.Дата = ИсторияКодовМаркировокПиОТ.Дата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Предварительная.Номенклатура,
		|	ВТ_Предварительная.ШК,
		|	ВТ_Предварительная.itemEstimatedStatus,
		|	ВТ_Предварительная.ДатаДокумента,
		|	ВТ_Предварительная.НомерДокумента,
		|	ЕСТЬNULL(ВТ_ПроверкиПИоТ.reqId, """") КАК reqId,
		|	ЕСТЬNULL(ВТ_ПроверкиПИоТ.reqTimestamp, 0) КАК reqTimestamp,
		|	ЕСТЬNULL(ВТ_ПроверкиПИоТ.isCheckedOffline, ЛОЖЬ) КАК isCheckedOffline,
		|	ЕСТЬNULL(ВТ_ПроверкиПИоТ.inst, """") КАК inst,
		|	ЕСТЬNULL(ВТ_ПроверкиПИоТ.version, """") КАК version
		|ИЗ
		|	ВТ_Предварительная КАК ВТ_Предварительная
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПроверкиПИоТ КАК ВТ_ПроверкиПИоТ
		|		ПО ВТ_Предварительная.ШК = ВТ_ПроверкиПИоТ.ШтрихкодНоменклатуры";
	
	Возврат ТекстЗапроса;
	//-Сёмин Р.И. 09.09.2026 #UT10-6020
	
КонецФункции

