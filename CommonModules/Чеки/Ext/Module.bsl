								ПричинаЗапрета = "Ошибка проверки крипто-подписи";
								// Владелец
							//ИначеЕсли НЕ ДанныеКода.isOwner Тогда
							//	ПричинаЗапрета = "Код маркировки не принадлежит организации " + Константы.ОсновнаяОрганизация.Получить();
								
							ИначеЕсли ДанныеКода.Свойство("expireDate") И ДанныеКода.expireDate <> Неопределено Тогда
								
								// Проверка срока годности
								ДатаИстечения = XMLЗначение(Тип("Дата"), ДанныеКода.expireDate);
