	СерверОтправки = Константы.АтолАдресВебСервера.Получить() + ":" + Формат(Константы.АтолПортВебСервера.Получить(), "ЧГ=0");
	
	СтруктураВозврата = Новый Структура("Результат, Сообщение, Статус, НомерЧека, КодОшибки", Ложь, "", "", 0, 0);
	
	ЧтениеJSON = Новый ЧтениеJSON;
	Результат = ПолучитьСоединениеССерверомЧеков();
	НовыйЗапрос = Новый HTTPЗапрос("/api/v2/requests/" + ГУИД + "?deviceID=" + ПКО.Касса.ИД);
	
	Попытка
		
		НовыйОтвет = Результат.Получить(НовыйЗапрос);
		Тело = НовыйОтвет.ПолучитьТелоКакСтроку();
		ЧтениеJSON.УстановитьСтроку(Тело);
		Данные = ПрочитатьJSON(ЧтениеJSON);
		ЗаписьЖурналаРегистрации("Обновление статусов чеков.Обработка", УровеньЖурналаРегистрации.Информация, ПКО.Метаданные(), ПКО, "Получен ответ от сервера " + СерверОтправки + Символы.ПС + Тело);		
		
	Исключение
		
		ТекстОшибки = "Обнаружены ошибки при получении ответа от сервера " + СерверОтправки + Символы.ПС + ОписаниеОшибки();
		СтруктураВозврата.Сообщение = ТекстОшибки;
		ЗаписьЖурналаРегистрации("Обновление статусов чеков.Ошибка", УровеньЖурналаРегистрации.Ошибка, ПКО.Метаданные(), ПКО, ТекстОшибки);		
		
		Возврат СтруктураВозврата;
		
	КонецПопытки;
	
	Если Данные.Свойство("results") И Данные.results.Количество() > 0 Тогда
		
		Результат = Данные.results[0];
		
		Если Результат.status = "error" Тогда
			СтруктураВозврата.Сообщение = Результат.error.description + ". КодОшибки " + Строка(Результат.error.code);	
		ИначеЕсли Результат.status = "ready" Тогда
			
			//+Белов А. 04.02.2026 #UT10-5641 - если отправляются коды маркировки, то при статусе ready этих параметров может не быть. Значит марки не прошли проверку, либо нет связи с ИСМ или другая ошибка 			
			Если Результат.Свойство("result") И Результат.result.Свойство("fiscalParams") Тогда
			//-Белов А. 04.02.2026 #UT10-5641
			
				СтруктураВозврата.Сообщение = "Чек успешно распечатан";				
				СтруктураВозврата.НомерЧека = Результат.result.fiscalParams.fiscalDocumentNumber;  	   
				
			Иначе
				
				//+Белов А. 04.02.2026 #UT10-5641
				Результат.status = "error"; 
				
				Если Результат.Свойство("error") И Результат.error.code > 0 Тогда
					СтруктураВозврата.Сообщение = Результат.error.description + ". КодОшибки " + Строка(Результат.error.code);	
				КонецЕсли;  
				
				Если Результат.Свойство("result") И Результат.result.Свойство("validateMarks") И Результат.result.validateMarks.Количество() > 0 Тогда
					
					СтруктураВозврата.Сообщение	= СтруктураВозврата.Сообщение + Символы.ПС + ОбщегоНазначения.ВернутьJSON(Результат.result.validateMarks);
					
					//Если ПроверкаМарок.Свойство("driverError") И ПроверкаМарок.driverError.code > 0 Тогда
					//	СтруктураВозврата.Сообщение	= СтруктураВозврата.Сообщение + Символы.ПС + "Ошибка драйвера при проверке КМ: " + ПроверкаМарок.driverError.error + ". КодОшибки " + Строка(ПроверкаМарок.driverError.code);						
					//КонецЕсли;	
					
				КонецЕсли;  
				//-Белов А. 04.02.2026 #UT10-5641			
				
			КонецЕсли;
			
			
		Иначе   
			
			Если Результат.Свойство("error") И Результат.error.code > 0 Тогда
				СтруктураВозврата.Сообщение = Результат.error.description + ". КодОшибки " + Строка(Результат.error.code);	
			КонецЕсли; 
			
		КонецЕсли;
		
		СтруктураВозврата.Статус = Результат.status;
		СтруктураВозврата.Результат = Истина;

	Иначе
		
		Если Данные.Свойство("error") И Данные.error.Свойство("description") Тогда
			
			ТекстОшибки = Данные.error.description;
			СтруктураВозврата.КодОшибки = Данные.error.code;        
			
		Иначе
			ТекстОшибки = "В ответе отсутствует результат в необходимом формате";
		КонецЕсли;
	
		СтруктураВозврата.Сообщение = ТекстОшибки;
		ЗаписьЖурналаРегистрации("Обновление статусов чеков.Ошибка", УровеньЖурналаРегистрации.Ошибка, ПКО.Метаданные(), ПКО, ТекстОшибки);
		
		Возврат СтруктураВозврата;
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
			
	Возврат СтруктураВозврата;
	
КонецФункции

Функция СформироватьСтруктуруДляВозврата(уникИД, Касса, ДополнительныеПараметры, Электронный, МестоРасчетов, Коррекция)
	
	ЗаписьJSON = новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	СтруктураJSON = Новый Структура();
	СтруктураJSON.Вставить("uuid", уникИД);
	МассивПараметров = Новый Массив();
	СтруктураЧека = Новый Структура();
	
	//+Белов А. 02.02.2026 #UT10-5641 	
	ВыводитьЧекСТоварамиИДругимиРеквизитами = ВыводитьЧекСТоварамиИДругимиРеквизитами(Коррекция);
	//-Белов А. 02.02.2026 #UT10-5641
	
	//Тип задания
	//sell - чек прихода buy - чек расхода sellReturn - чек возврата прихода buyReturn - чек возврата расхода
	Если Коррекция Тогда  
		
		type = "buyCorrection"; 
		СтруктураЧека.Вставить("correctionType", "self");
		СтруктураЧека.Вставить("correctionBaseDate", Формат(ДополнительныеПараметры.Дата, "ДФ=гггг.ММ.дд"));
		СтруктураЧека.Вставить("correctionBaseNumber", ДополнительныеПараметры.Номер); 
		
	Иначе
		type = "sellReturn";            
	КонецЕсли;

	СтруктураЧека.Вставить("type", type);
	//Электронный чек
	СтруктураЧека.Вставить("electronically", Электронный);   
	
	//taxationType Система налогообложения
	taxationType = "osn";
	Если Не ПустаяСтрока(taxationType) Тогда
		СтруктураЧека.Вставить("taxationType", taxationType);
	КонецЕсли;  
	
	//+Белов А. 03.02.2026 #UT10-5641
	//Если Не Коррекция Тогда          
	Если ВыводитьЧекСТоварамиИДругимиРеквизитами Тогда
	//-Белов А. 03.02.2026 #UT10-5641
		
		//useVAT18 использовать при регистрации чека ставку налога 18%
		СтруктураЧека.Вставить("useVAT18", Ложь);
		
		//+Белов А. 28.08.2025 #
		Если ЗначениеЗаполнено(МестоРасчетов) Тогда
			СтруктураЧека.Вставить("paymentsPlace", МестоРасчетов);		
		КонецЕсли;   
		//-Белов А. 28.08.2025 #
		
	КонецЕсли; 
		
	//данные о кассире
	СтруктураОператор = Новый Структура();
	
	Если ТипЗнч(ДополнительныеПараметры) = Тип("ДокументСсылка.ОплатаОтПокупателяПлатежнойКартой") И ЗначениеЗаполнено(ДополнительныеПараметры.ИДПлатежа) Тогда
		
		Если Коррекция Тогда
			
			СтруктураОператор.Вставить("name", ПараметрыСеанса.ТекущийПользователь.ФизЛицо.Наименование);
			Если ДополнительныеПараметры.Ответственный.ФизЛицо.ИНН <> "" Тогда
				СтруктураОператор.Вставить("vatin", ПараметрыСеанса.ТекущийПользователь.ФизЛицо.ИНН);
			КонецЕсли; 
			
		Иначе
			СтруктураОператор.Вставить("name", "Администратор");
		КонецЕсли;      
		
	ИначеЕсли ТипЗнч(ДополнительныеПараметры) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда  	
		СтруктураОператор.Вставить("name", "Администратор");                                         	
	Иначе
		
		Если Коррекция Тогда
			
			СтруктураОператор.Вставить("name", ПараметрыСеанса.ТекущийПользователь.ФизЛицо.Наименование);
			Если ДополнительныеПараметры.Ответственный.ФизЛицо.ИНН <> "" Тогда
				СтруктураОператор.Вставить("vatin", ПараметрыСеанса.ТекущийПользователь.ФизЛицо.ИНН);
			КонецЕсли;  
			
		Иначе  
			
			СтруктураОператор.Вставить("name", ДополнительныеПараметры.Ответственный.ФизЛицо.Наименование);
			Если ДополнительныеПараметры.Ответственный.ФизЛицо.ИНН <> "" Тогда
				СтруктураОператор.Вставить("vatin", ДополнительныеПараметры.Ответственный.ФизЛицо.ИНН);
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЕсли;
	
	СтруктураЧека.Вставить("operator", СтруктураОператор); 
	
	//+Белов А. 03.02.2026 #UT10-5641
	//Если Не Коррекция Тогда          
	Если ВыводитьЧекСТоварамиИДругимиРеквизитами Тогда
	//-Белов А. 03.02.2026 #UT10-5641		
		СтруктураЧека.Вставить("clientInfo", ПолучитьДанныеОПокупателе(ДополнительныеПараметры, Электронный)); 		
	КонецЕсли; 
	
	//+Белов А. 17.03.2026 #UT10-5758
	МаркировкаПоНоменклатуре = ПолучитьМаркировкуПоДокументу(ДополнительныеПараметры, Истина, СтруктураЧека);
	ЕстьКодыМаркировки = МаркировкаПоНоменклатуре.Количество() > 0; 
	//-Белов А. 17.03.2026 #UT10-5758
	
	//+Белов А. 03.02.2026 #UT10-5641
	//Если Не Коррекция Тогда          
	Если ВыводитьЧекСТоварамиИДругимиРеквизитами Тогда
	//-Белов А. 03.02.2026 #UT10-5641  		
		СтруктураЧека.Вставить("items", ПолучитьМассивПозиций(ДополнительныеПараметры, МаркировкаПоНоменклатуре));		
	Иначе
		СуммаНДС = УчетНДС.РассчитатьСуммуНДС(ДополнительныеПараметры.СуммаДокумента, Истина, Истина, 20);
		
		Налоги = Новый Массив;
		
		СтруктураНДС = Новый Структура();
		СтруктураНДС.Вставить("type", "vat22");
		СтруктураНДС.Вставить("sum", СуммаНДС); 
		
		Налоги.Добавить(СтруктураНДС);
		
		СтруктураЧека.Вставить("taxes", Налоги);  		
		
	КонецЕсли;
	
	СтруктураЧека.Вставить("payments", ПолучитьМассивОплат(ДополнительныеПараметры));
	
	//+Белов А. 05.08.2025 #
	Если ИспользоватьНовыеРеквизитыВЧеках() Тогда
		ДополнитьСтруктуруЧекаНовымиРеквизитами(СтруктураЧека, ДополнительныеПараметры, Электронный, МестоРасчетов);	
	КонецЕсли;
	//-Белов А. 05.08.2025 #
	
	//+Белов А. 02.02.2026 #UT10-5641	
	Если ПробиватьВЧекахКодыМаркировки() И ЕстьКодыМаркировки Тогда
		
		СтруктураЧека.Вставить("validateMarkingCodes", Истина);
		
		УведомленияПродажи = Новый Структура();
		УведомленияПродажи.Вставить("timeZone", ПолучитьТаймЗону());
		
		СтруктураЧека.Вставить("salesNotice", УведомленияПродажи);
		
	КонецЕсли;
	//-Белов А. 02.02.2026 #UT10-5641
	
	СтруктураJSON.Вставить("request", СтруктураЧека);
	
	Возврат СтруктураJSON;
	
КонецФункции

