		ДобавитьКодМаркировкиВТаблицуДляПроверкиПИоТ(КодМассивКодовМаркировки, КодыМаркировкиДляПроверки);
	Иначе
		
		Для Каждого Стр Из КодМассивКодовМаркировки Цикл
			ДобавитьКодМаркировкиВТаблицуДляПроверкиПИоТ(Стр, КодыМаркировкиДляПроверки);
		КонецЦикла;
		
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("Результат", Ложь);
	Результат.Вставить("Данные", Неопределено);
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("codes", КодыМаркировкиДляПроверки.ВыгрузитьКолонку("ПолныйКодМаркировки"));
	
	//♯а1с:1028
	ИнформацияОКлиенте = Новый Структура;
	ИнформацияОКлиенте.Вставить("name", "1С ПМСР");
	ИнформацияОКлиенте.Вставить("version", "1.0.0");
	ИнформацияОКлиенте.Вставить("id", "55329da4-01d1-48ba-9db8-ed58b3892774"); 		
	ИнформацияОКлиенте.Вставить("token", "85329da4-01d1-48ba-9db8-ed58b3892774");
	ИнформацияОКлиенте.Вставить("inn", Константы.ОсновнаяОрганизация.Получить().ИНН);
	
	ПараметрыЗапроса.Вставить("client_info", ИнформацияОКлиенте);
		
	URL = "/api/v2/codes/check";
	
	ПолученыДанныеПоКодамИзПИоТ = Ложь;
	
	HTTPОтвет = OPI_ЗапросыHTTP.PostСТелом(АдресТСПиоТ + URL, ПараметрыЗапроса,,,Истина,,1,2);	
		
	Если HTTPОтвет.КодСостояния = 200 Тогда
		
		ТекстОтвета = HTTPОтвет.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		Ответ = ВернутьСтруктуруИзJSON(ТекстОтвета);
		
		Если ТипЗнч(Ответ) = Тип("Структура") И Ответ.Свойство("codesResponse") Тогда
			
			ОтветПоКоду = Ответ.codesResponse[0];
			
			Если ОтветПоКоду.Свойство("codes") И ТипЗнч(ОтветПоКоду.codes) = Тип("Массив") И ОтветПоКоду.codes.Количество() > 0 Тогда
				
				ПолученыДанныеПоКодамИзПИоТ = Истина;
				
				ТаблицаПроверенныхКодов = Новый ТаблицаЗначений; 
				ТаблицаПроверенныхКодов.Колонки.Добавить("ДействиеРезрешено");
				ТаблицаПроверенныхКодов.Колонки.Добавить("ДанныеКода");
				ТаблицаПроверенныхКодов.Колонки.Добавить("ПричинаЗапрета");
				
