									ПричинаЗапрета = "Истек срок годности товара"; 
								Иначе
									ДействиеРезрешено = Истина;	
								КонецЕсли;  
								
							Иначе     					
								ДействиеРезрешено = Истина;						
							КонецЕсли;
							
						ИначеЕсли Действие = "Возврат" Тогда
							
							Если НЕ ДанныеКода.found Тогда
								ПричинаЗапрета = "Код не найден в ГИС МТ";
							ИначеЕсли ДанныеКода.isBlocked Тогда
								ПричинаЗапрета = "Товар заблокирован по решению органов власти";
							ИначеЕсли ДанныеКода.sold Тогда
								ПричинаЗапрета = "Товар уже был продан ранее";
							ИначеЕсли НЕ ДанныеКода.utilised Тогда
								ПричинаЗапрета = "Код маркировки не нанесен на упаковку";
							ИначеЕсли НЕ ДанныеКода.valid Тогда
								ПричинаЗапрета = "Неверная структура кода маркировки";
							ИначеЕсли НЕ ДанныеКода.verified Тогда
								ПричинаЗапрета = "Ошибка проверки крипто-подписи";								
							Иначе     					
								ДействиеРезрешено = Истина;						
							КонецЕсли;        
							
						КонецЕсли;
						
					КонецЕсли;  
					
					НСтр = ТаблицаПроверенныхКодов.Добавить();
					НСтр.ДействиеРезрешено = ДействиеРезрешено;  
					НСтр.ДанныеКода = ДанныеКода;     
					НСтр.ПричинаЗапрета = ПричинаЗапрета;
					
				КонецЦикла;                   
				
				СтрокиКодовСРазрешенныимДействием = ТаблицаПроверенныхКодов.НайтиСтроки(Новый Структура("ДействиеРезрешено", Истина));
				
				Если СтрокиКодовСРазрешенныимДействием.Количество() = ТаблицаПроверенныхКодов.Количество() Тогда
					Результат.Результат = Истина;
				Иначе
					
					Результат.Результат = Ложь;
					
					Если ТипЗнч(КодМассивКодовМаркировки) = Тип("Массив") Тогда
						Результат.Сообщение = "Не все коды разрешены для операции " + Операция + ". Разрешено: " + Строка(СтрокиКодовСРазрешенныимДействием.Количество()) + " из " + Строка(ТаблицаПроверенныхКодов.Количество());
					Иначе
