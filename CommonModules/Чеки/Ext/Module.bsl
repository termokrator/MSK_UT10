		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры

Функция ПолучитьПараметрыФискальногоНакопителяПоКассе(Касса) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ЗаписьЖурналаРегистрации("Операции с кассой.Начало", УровеньЖурналаРегистрации.Информация, Метаданные.Справочники.Кассы, Касса, "Начало выполнения функции получения параметров фискальника");		
	
	СерверОтправки = Константы.АтолАдресВебСервера.Получить() + ":" + Формат(Константы.АтолПортВебСервера.Получить(), "ЧГ=0");

	СтруктураВозврата = Новый Структура("Результат, Сообщение, ПараметрыФискальника", Ложь, "", Новый Структура());
	
	HTTPЗапрос = Новый HTTPЗапрос();
	HTTPЗапрос.АдресРесурса = "/api/v2/operations/queryFnInfo?deviceID=" + Касса.ИД;
	HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json;charset=utf-8");
	
	Попытка
		
		Соединение = Чеки.ПолучитьСоединениеССерверомЧеков(60);
		ОтветHTTP = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
		Ответ = ОтветHTTP.ПолучитьТелоКакСтроку();
		ЗаписьЖурналаРегистрации("Операции с кассой.Обработка", УровеньЖурналаРегистрации.Информация, Метаданные.Справочники.Кассы, Касса, "Получение параметров фискальника с сервера: " + СерверОтправки + " выполнено успешно! " + Символы.ПС + Ответ);				
		
	Исключение
		
		ТекстОшибки = "Ошибка получения статуса фискальника " + СерверОтправки + Символы.ПС + ОписаниеОшибки();
		СтруктураВозврата.Сообщение = ТекстОшибки;
		ЗаписьЖурналаРегистрации("Операции с кассой.Ошибка", УровеньЖурналаРегистрации.Ошибка, Метаданные.Справочники.Кассы, Касса, СтруктураВозврата.Сообщение);		
		
		Возврат СтруктураВозврата;
		
	КонецПопытки;

	Если Не ОтветHTTP.КодСостояния = 200 Тогда
		
		ТекстОшибки = "При получении ответа от сервера обнаружена ошибка. Код состояния " + Строка(ОтветHTTP.КодСостояния);
		СтруктураВозврата.Сообщение = ТекстОшибки;
		ЗаписьЖурналаРегистрации("Операции с кассой.Ошибка", УровеньЖурналаРегистрации.Ошибка, Метаданные.Справочники.Кассы, Касса, СтруктураВозврата.Сообщение);
		
		СтруктураВозврата.Ошибка = ТекстОшибки;
		Возврат СтруктураВозврата;
		
	Иначе
	
		СтруктураФискальника = ВернутьСтруктуруИзJSON(Ответ);
		
		ПараметрыФискальника = Новый Структура("id,validityDate,criticalError,memoryOverflow,needReplacement,ofdTimeout,resourceExhausted", Касса.ИД);
		
		ЗаполнитьЗначенияСвойств(ПараметрыФискальника, СтруктураФискальника.fnInfo.validity);		
		ЗаполнитьЗначенияСвойств(ПараметрыФискальника, СтруктураФискальника.fnInfo.warnings);		
		
		СтруктураВозврата.ПараметрыФискальника = ПараметрыФискальника;
		
		ЗаписьЖурналаРегистрации("Операции с кассой.Обработка", УровеньЖурналаРегистрации.Информация, Метаданные.Справочники.Кассы, Касса, "Получен успешный ответ запроса параметров фискальника. Код состояния " + Строка(ОтветHTTP.КодСостояния));			
		
	КонецЕсли;
	
	СтруктураВозврата.Результат = Истина;
	
	ЗаписьЖурналаРегистрации("Операции с кассой.Завершение", УровеньЖурналаРегистрации.Информация, Метаданные.Справочники.Кассы, Касса, "Окончание выполнения функции получения параметров фискальника");		
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат СтруктураВозврата;
	
КонецФункции

Функция ОткрытьЗакрытьСмену(Касса, Закрыть = Ложь, Кассир = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ЗаписьЖурналаРегистрации("Операции с кассой.Начало", УровеньЖурналаРегистрации.Информация, Метаданные.Справочники.Кассы, Касса, "Начало выполнения функции открытия закрытия смены");		
	
	СерверОтправки = Константы.АтолАдресВебСервера.Получить() + ":" + Формат(Константы.АтолПортВебСервера.Получить(), "ЧГ=0");

	СтруктураВозврата = Новый Структура("Результат, Сообщение", Ложь, "");

	ГУИД = Строка(Новый УникальныйИдентификатор());
	
	HTTPЗапрос = Новый HTTPЗапрос();
	HTTPЗапрос.АдресРесурса = "/api/v2/requests?deviceID=" + Касса.ИД;
	HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json;charset=utf-8");
	
	Попытка
		СтруктураJSON = СформироватьСтруктуруДляОткрытияЗакрытияСмены(ГУИД, ?(Закрыть, "ЗакрытиеСмены", "ОткрытиеСмены"), Кассир);
		СтрокаЗапросаJS = Чеки.ВернутьJSON(СтруктураJSON);
		ЗаписьЖурналаРегистрации("Операции с кассой.Обработка", УровеньЖурналаРегистрации.Информация, Метаданные.Справочники.Кассы, Касса, "Успешно сформирован JSON для отправки на сервер" + Символы.ПС + СтрокаЗапросаJS);		
	Исключение
		ТекстОшибки = "Ошибка формирования менеджера задания (JSON)" + Символы.ПС + ОписаниеОшибки();
		СтруктураВозврата.Сообщение = ТекстОшибки;
		ЗаписьЖурналаРегистрации("Операции с кассой.Ошибка", УровеньЖурналаРегистрации.Ошибка, Метаданные.Справочники.Кассы, Касса, СтруктураВозврата.Сообщение);		
		Возврат СтруктураВозврата;
	КонецПопытки;
	
	HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаЗапросаJS, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	
	Попытка
		Соединение = Чеки.ПолучитьСоединениеССерверомЧеков();
		ОтветHTTP = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
		Ответ = ОтветHTTP.ПолучитьТелоКакСтроку();
		ЗаписьЖурналаРегистрации("Операции с кассой.Обработка", УровеньЖурналаРегистрации.Информация, Метаданные.Справочники.Кассы, Касса, "Открытие закрытие смены " + СерверОтправки + " выполнено успешно! " + Символы.ПС + Ответ);		
	Исключение
		ТекстОшибки = "Ошибка открытия закрытия смены " + СерверОтправки + Символы.ПС + ОписаниеОшибки();
		СтруктураВозврата.Сообщение = ТекстОшибки;
		ЗаписьЖурналаРегистрации("Операции с кассой.Ошибка", УровеньЖурналаРегистрации.Ошибка, Метаданные.Справочники.Кассы, Касса, СтруктураВозврата.Сообщение);		
		Возврат СтруктураВозврата;
	КонецПопытки;

	Если Не ОтветHTTP.КодСостояния = 201 Тогда
		ТекстОшибки = "При получении ответа от сервера обнаружена ошибка. Код состояния " + Строка(ОтветHTTP.КодСостояния);
		СтруктураВозврата.Сообщение = ТекстОшибки;
		ЗаписьЖурналаРегистрации("Операции с кассой.Ошибка", УровеньЖурналаРегистрации.Ошибка, Метаданные.Справочники.Кассы, Касса, СтруктураВозврата.Сообщение);		
		Возврат СтруктураВозврата;
	Иначе
		ЗаписьЖурналаРегистрации("Операции с кассой.Обработка", УровеньЖурналаРегистрации.Информация, Метаданные.Справочники.Кассы, Касса, "Получен успешный ответ при открытии закрытии смены. Код состояния " + Строка(ОтветHTTP.КодСостояния));			
	КонецЕсли;
	
	СтруктураВозврата.Результат = Истина;
	
	МенеджерЗаписи = РегистрыСведений.СтатусыКасс.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период = ТекущаяДата();
	МенеджерЗаписи.Касса = Касса;
	МенеджерЗаписи.СтатусСмены = ?(Закрыть, "closed", "opened");
	МенеджерЗаписи.Комментарий = ?(Закрыть, "Смена закрыта", "Смена открыта"); 
	Если ЗначениеЗаполнено(Кассир) Тогда
		МенеджерЗаписи.Пользователь = Кассир;
	Иначе 
		МенеджерЗаписи.Пользователь = Пользователи.ТекущийПользователь();
	КонецЕсли;
	МенеджерЗаписи.Записать(Истина);
	
	ЗаписьЖурналаРегистрации("Операции с кассой.Завершение", УровеньЖурналаРегистрации.Информация, Метаданные.Справочники.Кассы, Касса, "Окончания выполнения функции открытия закрытия смены");		
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат СтруктураВозврата;
	
КонецФункции

Функция ХОтчет(Касса) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ЗаписьЖурналаРегистрации("Операции с кассой.Начало", УровеньЖурналаРегистрации.Информация, Метаданные.Справочники.Кассы, Касса, "Начало выполнения функции снятия Х-отчета");		
	
	СерверОтправки = Константы.АтолАдресВебСервера.Получить() + ":" + Формат(Константы.АтолПортВебСервера.Получить(), "ЧГ=0");

	СтруктураВозврата = Новый Структура("Результат, Сообщение", Ложь, "");

	ГУИД = Строка(Новый УникальныйИдентификатор());
	
	HTTPЗапрос = Новый HTTPЗапрос();
	HTTPЗапрос.АдресРесурса = "/api/v2/requests?deviceID=" + Касса.ИД;
	HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json;charset=utf-8");
	
	Попытка
		СтруктураJSON = СформироватьСтруктуруДляСнятияХОтчета(ГУИД);
		СтрокаЗапросаJS = Чеки.ВернутьJSON(СтруктураJSON);
		ЗаписьЖурналаРегистрации("Операции с кассой.Обработка", УровеньЖурналаРегистрации.Информация, Метаданные.Справочники.Кассы, Касса, "Успешно сформирован JSON для отправки на сервер" + Символы.ПС + СтрокаЗапросаJS);		
	Исключение
		ТекстОшибки = "Ошибка формирования менеджера задания (JSON)" + Символы.ПС + ОписаниеОшибки();
		СтруктураВозврата.Сообщение = ТекстОшибки;
		ЗаписьЖурналаРегистрации("Операции с кассой.Ошибка", УровеньЖурналаРегистрации.Ошибка, Метаданные.Справочники.Кассы, Касса, СтруктураВозврата.Сообщение);		
		Возврат СтруктураВозврата;
	КонецПопытки;
	
	HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаЗапросаJS, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	
	Попытка
		Соединение = Чеки.ПолучитьСоединениеССерверомЧеков();
		ОтветHTTP = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
		Ответ = ОтветHTTP.ПолучитьТелоКакСтроку();
		ЗаписьЖурналаРегистрации("Операции с кассой.Обработка", УровеньЖурналаРегистрации.Информация, Метаданные.Справочники.Кассы, Касса, "Снятие Х-отчета " + СерверОтправки + " выполнено успешно! " + Символы.ПС + Ответ);		
	Исключение
		ТекстОшибки = "Ошибка снятия Х-отчета " + СерверОтправки + Символы.ПС + ОписаниеОшибки();
		СтруктураВозврата.Сообщение = ТекстОшибки;
		ЗаписьЖурналаРегистрации("Операции с кассой.Ошибка", УровеньЖурналаРегистрации.Ошибка, Метаданные.Справочники.Кассы, Касса, СтруктураВозврата.Сообщение);		
		Возврат СтруктураВозврата;
	КонецПопытки;

	Если Не ОтветHTTP.КодСостояния = 201 Тогда
		ТекстОшибки = "При получении ответа от сервера обнаружена ошибка. Код состояния " + Строка(ОтветHTTP.КодСостояния);
		СтруктураВозврата.Сообщение = ТекстОшибки;
		ЗаписьЖурналаРегистрации("Операции с кассой.Ошибка", УровеньЖурналаРегистрации.Ошибка, Метаданные.Справочники.Кассы, Касса, СтруктураВозврата.Сообщение);		
		Возврат СтруктураВозврата;
	Иначе
		ЗаписьЖурналаРегистрации("Операции с кассой.Обработка", УровеньЖурналаРегистрации.Информация, Метаданные.Справочники.Кассы, Касса, "Получен успешный ответ при снятии Х-отчета. Код состояния " + Строка(ОтветHTTP.КодСостояния));			
	КонецЕсли;
	
	СтруктураВозврата.Результат = Истина;
		
	ЗаписьЖурналаРегистрации("Операции с кассой.Завершение", УровеньЖурналаРегистрации.Информация, Метаданные.Справочники.Кассы, Касса, "Окончания выполнения функции снятия Х-отчета");		
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат СтруктураВозврата;
	
КонецФункции

Функция ПолучитьСтатусКассы(Касса) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтруктураВозврата = Новый Структура("СтатусСмены, КрышкаОткрыта, БумагаВставлена, Комментарий, Ошибка", "", "", "", "", "");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СтатусыКассСрезПоследних.СтатусСмены,
	               |	СтатусыКассСрезПоследних.Комментарий,
	               |	СтатусыКассСрезПоследних.КрышкаОткрыта,
	               |	СтатусыКассСрезПоследних.БумагаВставлена,
	               |	СтатусыКассСрезПоследних.Ошибка
	               |ИЗ
	               |	РегистрСведений.СтатусыКасс.СрезПоследних(, Касса.ИД = &ИД) КАК СтатусыКассСрезПоследних";
	
	Запрос.УстановитьПараметр("ИД", Касса.ИД);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ЗаполнитьЗначенияСвойств(СтруктураВозврата, Выборка);
				
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат СтруктураВозврата;	
	
КонецФункции

Функция СформироватьСтруктуруДляОткрытияЗакрытияСмены(ГУИД, Операция, Кассир = Неопределено)
    
    Если Операция = "ОткрытиеСмены" Тогда
        ТипОперации = "openShift";
    ИначеЕсли Операция = "ЗакрытиеСмены" Тогда    
        ТипОперации = "closeShift";
    Иначе
        Возврат Неопределено;
    КонецЕсли;
    
    УИД = Формат(ТекущаяДата(),"ДФ=ддММггггЧЧммсс");
	
	Если Кассир <> Неопределено Тогда
		СтруктураОператор = Новый Структура("name", Строка(Кассир));
	Иначе
		СтруктураОператор = Новый Структура("name", Строка(ПараметрыСеанса.ТекущийПользователь));
	КонецЕсли;
    
    СтруктураЧека = Новый Структура;
    СтруктураЧека.Вставить("type", ТипОперации);
    СтруктураЧека.Вставить("operator", СтруктураОператор);
    
    МассивПараметров = Новый Массив;
    МассивПараметров.Добавить(СтруктураЧека);
    
    СтруктураJSON = Новый Структура();
    СтруктураJSON.Вставить("uuid", ГУИД);
    СтруктураJSON.Вставить("request", МассивПараметров);
    
    Возврат СтруктураJSON;
    
КонецФункции

Функция СформироватьСтруктуруДляСнятияХОтчета(ГУИД)
    
    ТипОперации = "reportX";
    
    СтруктураОператор = Новый Структура("name", Строка(ПараметрыСеанса.ТекущийПользователь));
    
    СтруктураЧека = Новый Структура;
    СтруктураЧека.Вставить("type", ТипОперации);
    СтруктураЧека.Вставить("operator", СтруктураОператор);
    
    МассивПараметров = Новый Массив;
    МассивПараметров.Добавить(СтруктураЧека);
    
    СтруктураJSON = Новый Структура();
    СтруктураJSON.Вставить("uuid", ГУИД);
    СтруктураJSON.Вставить("request", МассивПараметров);
    
    Возврат СтруктураJSON;
    
КонецФункции

Процедура НапечататьСлипЧек(Документ, ПечататьВторойСлип = Ложь) Экспорт
	
	СлипНаПечать = Документ.ТекстСлипЧека;   
	ВторойСлипНаПечать = "";      
	
	СимволыРазделенияСлипЧеков = Константы.СимволыРазделенияСлипЧеков.Получить();
	
	Если ЗначениеЗаполнено(СимволыРазделенияСлипЧеков) Тогда
		
		НомерСтрокиОтреза = Найти(Документ.ТекстСлипЧека, СимволыРазделенияСлипЧеков);
		
		Если НомерСтрокиОтреза <> 0 Тогда
			
			СлипНаПечать = Лев(СлипНаПечать, НомерСтрокиОтреза - 1);		
			ВторойСлипНаПечать = Сред(Документ.ТекстСлипЧека, НомерСтрокиОтреза + СтрДлина(СимволыРазделенияСлипЧеков)); 
			
		Иначе
			
			ВторойСлипНаПечать = СлипНаПечать;	
			
		КонецЕсли;  
		
	Иначе 
		
		ВторойСлипНаПечать = СлипНаПечать;
		
	КонецЕсли;

	
	Чеки.ОтправитьНефискальныйЧекВОчередьНаПечать(СлипНаПечать, Документ.Касса);
	
	Если ПечататьВторойСлип Тогда
		Чеки.ОтправитьНефискальныйЧекВОчередьНаПечать(ВторойСлипНаПечать, Документ.Касса);	
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьОписаниеСменыПоСтатусу(Статус) Экспорт
	
	Если Статус = "expired" Тогда
		Возврат "Смена истекла";
	ИначеЕсли Статус = "opened" Тогда
		Возврат "Смена открыта";
	ИначеЕсли Статус = "closed" Тогда
		Возврат "Смена закрыта";
	КонецЕсли;
	
	Возврат "";

КонецФункции

Функция МожноПечататьЧеки(Касса) Экспорт
	
	СтруктураВозврата = Новый Структура("Результат, Сообщение", Истина, "");
	
	СтруктураВозвратаСтатуса = ПолучитьСтатусКассы(Касса);
	
	Если СтруктураВозвратаСтатуса.СтатусСмены = "expired" Тогда
		СтруктураВозврата.Результат = Ложь;
		СтруктураВозврата.Сообщение = "Смена превысила 24 часа";
	КонецЕсли;
	
	Если СтруктураВозвратаСтатуса.КрышкаОткрыта = "Да" Тогда
		СтруктураВозврата.Результат = Ложь;
		СтруктураВозврата.Сообщение = СтруктураВозврата.Сообщение + ?(ЗначениеЗаполнено(СтруктураВозврата.Сообщение), Символы.ПС, "") + "Открыта крышка кассового аппарата";
	КонецЕсли;
	
	Если СтруктураВозвратаСтатуса.БумагаВставлена = "Нет" Тогда
		СтруктураВозврата.Результат = Ложь;
		СтруктураВозврата.Сообщение = СтруктураВозврата.Сообщение + ?(ЗначениеЗаполнено(СтруктураВозврата.Сообщение), Символы.ПС, "") + "Не вставлена бумага в кассовый аппарат";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураВозвратаСтатуса.Ошибка) Тогда
		СтруктураВозврата.Результат = Ложь;
		СтруктураВозврата.Сообщение = СтруктураВозврата.Сообщение + ?(ЗначениеЗаполнено(СтруктураВозврата.Сообщение), Символы.ПС, "") + СтруктураВозвратаСтатуса.Ошибка;
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции


///////////////////Работа с документами///////////////////
Процедура ОтправитьДокументНаПечать(Док, ВозвратПродажи = Ложь, Электронный = Истина) Экспорт 
	
	Если Чеки.ИспользоватьПечатьЧековЧерезСерверАМРВодитель() Тогда
		
		Если ЗначениеЗаполнено(Док.Касса.ИД) И Док.Организация = Константы.ОсновнаяОрганизация.Получить() Тогда
						
			ЗаписьЖурналаРегистрации("Печать чеков.Начало", УровеньЖурналаРегистрации.Информация,,"Начало отправки документов на печать");								
			
			Если Док.Ссылка.Проведен Тогда
				
				Если Док.ПозицииЧекККМ.Количество() = 0 Тогда 					
					ЗаполнитьСоставЧекаУДокументаСсылки(Док.Ссылка);	
				КонецЕсли;	
				
				МожноЛиПечататьСтруктура = Чеки.МожноПечататьЧеки(Док.Касса);
				
				Если Не МожноЛиПечататьСтруктура.Результат Тогда
					
					ЗаписьЖурналаРегистрации("Печать чеков.Обработка", УровеньЖурналаРегистрации.Информация, Метаданные.Справочники.Кассы, Док.Касса , "По кассе " + Строка(Док.Касса) + " в данный момент нельзя печатать чеки" + Символы.ПС + МожноЛиПечататьСтруктура.Сообщение + Символы.ПС + "Документ добавлен в очередь на печать со статусом prepare");								
					Чеки.ЗаписатьНовоеЗадание(Док.Ссылка, "prepare", МожноЛиПечататьСтруктура.Сообщение);
					
				Иначе      			
					
					РезультатПроверки = Чеки.ПоверитьКорректностьСоставаЧекаККМ(Док.Ссылка);
					
					Если Не РезультатПроверки.Результат Тогда
						Чеки.ЗаписатьНовоеЗадание(Док.Ссылка, "error", "При проверке корректности состава Чека ККМ обнаружены ошибки" + Символы.ПС + РезультатПроверки.Сообщение);						
					Иначе
						
						Если Электронный Тогда
							EmailКонтрагента = Чеки.ПолучитьEmail(Док.Контрагент);
						Иначе
							EmailКонтрагента = "Проверка не нужна";							
						КонецЕсли; 					
						
						//Из АРМ Водителя можно отправлять только электронные чеки
						Если Не ЗначениеЗаполнено(EmailКонтрагента) Тогда                                                                                          						
							Чеки.ЗаписатьНовоеЗадание(Док.Ссылка, "error", "У контрагента не заполнен Email для печати электронного чека");						
						Иначе  
							
							//+Белов А. 22.01.2026 #UT10-5638  
							//Для этих видов докуменов используем отложенную проверку по биллингу
							Если (ТипЗнч(Док.Ссылка) = Тип("ДокументСсылка.РеализацияТоваровУслуг")
								ИЛИ ТипЗнч(Док.Ссылка) = Тип("ДокументСсылка.КорректировкаРеализации"))
								И Док.Ссылка.ДоговорКонтрагента.КонтролироватьВзаиморасчетыЧерезСистемуБиллинг Тогда
								
								//+Белов А. 28.08.2026 #UT10-6002
								Если ТипЗнч(Док.Ссылка) = Тип("ДокументСсылка.РеализацияТоваровУслуг") И Док.Ссылка.ДоговорКонтрагента.ЛицевойСчет Тогда
									
									Если РаботаСТоварамиНаДоставке.ТоварПередан(Док.Ссылка) Тогда						
										Чеки.ЗаписатьНовоеЗадание(Док.Ссылка, "check"); 
									Иначе
										ЗаписьЖурналаРегистрации("Печать чеков.Обработка", УровеньЖурналаРегистрации.Информация, Док.Ссылка.Метаданные(), Док.Ссылка , "Документ не был отправлен в очередь на печать. Ожидаем статус доставки - товар передан");								
									КонецЕсли;
									
								Иначе
								//-Белов А. 28.08.2026 #UT10-6002									
									Чеки.ЗаписатьНовоеЗадание(Док.Ссылка, "check");
								КонецЕсли;
								
							Иначе
							//-Белов А. 22.01.2026 #UT10-5638
								
								Если ВозвратПродажи Тогда
									СтруктураВозврата = Чеки.ОтправитьЧекНаВозвратВОчередьНаПечать(Док.Ссылка, Электронный);
								Иначе
									СтруктураВозврата = Чеки.ОтправитьЧекВОчередьНаПечать(Док.Ссылка, Электронный);	
									
									Если ТипЗнч(Док.Ссылка) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер") Тогда
										ОтправитьЧекиИзПлатежногоДокументаПоРеализациям(Док.Ссылка);	
									КонецЕсли;
									
								КонецЕсли;							
								
								Если НЕ СтруктураВозврата.Результат Тогда
									
									ЗаписьЖурналаРегистрации("Печать чеков.Обработка", УровеньЖурналаРегистрации.Информация, Док.Ссылка.Метаданные(), Док.Ссылка , "Документ не был отправлен в очередь на печать" + Символы.ПС + СтруктураВозврата.Сообщение + Символы.ПС + "Документ добавлен в очередь на печать со статусом prepare");								
									Чеки.ЗаписатьНовоеЗадание(Док.Ссылка, "prepare", СтруктураВозврата.Сообщение);  
									
								КонецЕсли; 							
								
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;
				
			Иначе
				ЗаписьЖурналаРегистрации("Печать чеков.Ошибка", УровеньЖурналаРегистрации.Ошибка, Док.Ссылка.Метаданные(), Док.Ссылка, "Документ был записан, но не проведен. Чек не был отправлен на печать в ККМ");		
			КонецЕсли;
			
			ЗаписьЖурналаРегистрации("Печать чеков.Завершение", УровеньЖурналаРегистрации.Информация,,, "Окончание отправки документов на печать");								
			
		КонецЕсли;		
		
	КонецЕсли;    
		
КонецПроцедуры

Функция ПолучитьРеализациюПоКорректировке(Знач Корректировка)
	
	Реализация = Неопределено;
	ДокументПроверки = Корректировка;
	
	Пока Не ЗначениеЗаполнено(Реализация) Цикл
		
		Если НЕ ЗначениеЗаполнено(ДокументПроверки.ДокументРеализации) Тогда
			
			Реализация = Документы.РеализацияТоваровУслуг.ПустаяСсылка();
			Прервать; 
			
		ИначеЕсли ТипЗнч(ДокументПроверки.ДокументРеализации) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			Реализация = ДокументПроверки.ДокументРеализации;
		Иначе
			ДокументПроверки = ДокументПроверки.ДокументРеализации;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Реализация;
	
КонецФункции  

Процедура ЗаполнитьФормуДляПечатиЧеков(ЭтотОбъект, ЭлементыФормы) Экспорт 
	
	Если НЕ ЭтотОбъект.ЭтоНовый() И Чеки.ИспользоватьПечатьЧековЧерезСервер() Тогда
		
		СтатусЗаданияНаПечать = Чеки.ПолучитьСтатусЗаданияПечатиПКО(ЭтотОбъект.Ссылка);
		
		Если СтатусЗаданияНаПечать = "error" Тогда
			ЭлементыФормы.ОсновныеДействияФормы.Кнопки.Чек.Текст = "Чек (возникли ошибки при печати)";	
		КонецЕсли;
		
	КонецЕсли;  
	
	РезультатПроверки = Истина;	
	
	Если ТипЗнч(ЭтотОбъект) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда      
		
		РезультатПроверки = Чеки.ПоверитьКорректностьЗаполненияРеализации(ЭтотОбъект).Результат; 
		
		Если ЭтотОбъект.ЭтоНовый() Тогда
			ЭтотОбъект.Касса = Константы.ОсновнаяКассаДляПечатиЧеков.Получить();		
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ЭтотОбъект) = Тип("ДокументОбъект.КорректировкаРеализации") Тогда                        
		
		РезультатПроверки = Чеки.ПоверитьКорректностьЗаполненияКорректировкиРеализации(ЭтотОбъект).Результат; 
		
		Если ЭтотОбъект.ЭтоНовый() Тогда
			ЭтотОбъект.Касса = Константы.ОсновнаяКассаДляПечатиЧеков.Получить();		
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не РезультатПроверки Тогда
		
		ЭлементыФормы.ОсновныеДействияФормы.Кнопки.Чек.Доступность = Ложь;		
		ЭлементыФормы.ОсновнаяПанель.Страницы.ЧекККМ.Видимость = Ложь;
		
	КонецЕсли;  
   	
КонецПроцедуры

Процедура ЗаполнитьСоставЧекаУДокументаСсылки(Документ) Экспорт
	
	ДокументОбъект = Документ.ПолучитьОбъект();           
	
	ЗаполнитьСоставЧекаУДокументаОбъекта(ДокументОбъект);		
	 
	ДокументОбъект.ОбменДанными.Загрузка = Истина;
	ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		
КонецПроцедуры

Процедура ЗаполнитьСоставЧекаУДокументаОбъекта(ДокументОбъект) Экспорт
	
	Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		ЗаполнитьСоставЧекаККМДляРеализации(ДокументОбъект);
	ИначеЕсли ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.КорректировкаРеализации") Тогда
		ЗаполнитьСоставЧекаККМДляКорректировкиРеализации(ДокументОбъект);           
	ИначеЕсли ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ПриходныйКассовыйОрдер") Тогда
		ЗаполнитьСоставЧекаККМДляПКО(ДокументОбъект);                              
	ИначеЕсли ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.РасходныйКассовыйОрдер") Тогда
		ЗаполнитьСоставЧекаККМДляРКО(ДокументОбъект);
	ИначеЕсли ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ОплатаОтПокупателяПлатежнойКартой") Тогда
		
		Если ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийОплатаОтПокупателяПлатежнойКартой.ОплатаПокупателя Тогда
			ЗаполнитьСоставЧекаККМДляОПК_Оплата(ДокументОбъект);  
		Иначе
			ЗаполнитьСоставЧекаККМДляОПК_Возврат(ДокументОбъект);
		КонецЕсли;
	
	КонецЕсли;   

КонецПроцедуры

Процедура ОтправитьЧекиИзПлатежногоДокументаПоРеализациям(ПлатежныйДокумент) Экспорт 
	
	Если НЕ ПлатежныйДокументЛицевойСчет(ПлатежныйДокумент) Тогда
		Возврат;	
	КонецЕсли;
	
	ТаблицаРеализацийНаПечать = ПолучитьТаблицуРеализацийДляПечатиЧекаИзПлатежногоДокумента(ПлатежныйДокумент);
	
	Для каждого СтрТаблицы Из ТаблицаРеализацийНаПечать Цикл 
		
		Если Не СтрТаблицы.НаПечать Тогда
			Продолжить;	
		КонецЕсли;   
		
		Документ = СтрТаблицы.Документ;
		
		ДокументОб = Документ.ПолучитьОбъект();
		ЗаполнитьСоставЧекаККМДляРеализации(ДокументОб);  
		ДокументОб.ОбменДанными.Загрузка = Истина;
		ДокументОб.Записать();    
		
		//+Белов А. 22.01.2026 #UT10-5638
		//Чеки.ОтправитьЧекВОчередьНаПечать(Документ, Истина);
		Если Не Документ.ДоговорКонтрагента.КонтролироватьВзаиморасчетыЧерезСистемуБиллинг Тогда
			Чеки.ОтправитьЧекВОчередьНаПечать(Документ, Истина);
		Иначе
			
			//+Белов А. 28.08.2026 #UT10-6002
			//Чеки.ЗаписатьНовоеЗадание(Документ, "check"); 
			Если Документ.ДоговорКонтрагента.ЛицевойСчет Тогда
				
				Если РаботаСТоварамиНаДоставке.ТоварПередан(Документ) Тогда						
					Чеки.ЗаписатьНовоеЗадание(Документ, "check");								
				КонецЕсли; 
				
			Иначе
				Чеки.ЗаписатьНовоеЗадание(Документ, "check");								
			КонецЕсли;  		
			//-Белов А. 28.08.2026 #UT10-6002
			
		КонецЕсли;
		//-Белов А. 22.01.2026 #UT10-5638
			
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьТаблицуРеализацийДляПечатиЧекаИзПлатежногоДокумента(ПлатежныйДокумент)
	
	ТаблицаВозврата = Новый ТаблицаЗначений;
	ТаблицаВозврата.Колонки.Добавить("Документ");
	ТаблицаВозврата.Колонки.Добавить("НаПечать");
	ТаблицаВозврата.Колонки.Добавить("ТекстОшибки");	
	
	Для каждого СтрРасшифровки Из ПлатежныйДокумент.РасшифровкаПлатежа Цикл
		
		Документ = СтрРасшифровки.ДокументРасчетовСКонтрагентом;
		
		Если ТипЗнч(Документ) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			
			НСтр = ТаблицаВозврата.Добавить();
			НСтр.Документ = Документ;
			НСтр.НаПечать = Ложь;
			
			Если ЗначениеЗаполнено(Документ.НомерЧекаККМ) Тогда				
				НСтр.ТекстОшибки = "У реализации уже заполнен номер чека ККМ";
			ИначеЕсли Не Документ.ДоговорКонтрагента.ЛицевойСчет Тогда
				НСтр.ТекстОшибки = "У договора не стоит галка Лицевой счет";				
			Иначе   
				
				СтатусЗаданияНаПечатьПоРеализации = ПолучитьСтатусЗаданияПечатиПКО(Документ); 
				
				Если ЗначениеЗаполнено(СтатусЗаданияНаПечатьПоРеализации) И (Найти(СтатусЗаданияНаПечатьПоРеализации, "error") = 0) Тогда
					НСтр.ТекстОшибки = "Реализация уже отправлена на печать";				
				//+Белов А. 22.01.2026 #UT10-5638
				//ИначеЕсли Не ВсяРеализацияПогашена(Документ) Тогда
				ИначеЕсли Не Документ.ДоговорКонтрагента.КонтролироватьВзаиморасчетыЧерезСистемуБиллинг И Не ВсяРеализацияПогашена(Документ) Тогда
				//-Белов А. 22.01.2026 #UT10-5638	
					НСтр.ТекстОшибки = "Реализация не погашена полностью платежными документами";				
				Иначе
					НСтр.НаПечать = Истина;	
				КонецЕсли; 
				
			КонецЕсли;  
			
		КонецЕсли;
		
	КонецЦикла; 
	
	Возврат ТаблицаВозврата;
	
КонецФункции

Функция ПлатежныйДокументЛицевойСчет(Документ)
	
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер")
		ИЛИ ТипЗнч(Документ) = Тип("ДокументОбъект.ПриходныйКассовыйОрдер") Тогда
		
		Если ЗначениеЗаполнено(Документ.ДоговорКонтрагента) Тогда
			Возврат Документ.ДоговорКонтрагента.ЛицевойСчет;                     
		Иначе    
			
			Если Документ.РасшифровкаПлатежа.Количество() > 0 Тогда
				
				ЭтоЛицевойСчет = Истина;
				ЕстьДоговорВРасшифровке = Ложь;
				
				//Проверяем что все договоры - это лицевой счет
				Для каждого СтрокаРасшифровки Из Документ.РасшифровкаПлатежа Цикл  
					
					Если ЗначениеЗаполнено(СтрокаРасшифровки.ДоговорКонтрагента) Тогда
						
						ЕстьДоговорВРасшифровке = Истина;
						
						Если Не СтрокаРасшифровки.ДоговорКонтрагента.ЛицевойСчет Тогда
							ЭтоЛицевойСчет = Ложь;	
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЦикла;
				
				Возврат ЭтоЛицевойСчет И ЕстьДоговорВРасшифровке;
				
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.ОплатаОтПокупателяПлатежнойКартой")
		ИЛИ ТипЗнч(Документ) = Тип("ДокументОбъект.ОплатаОтПокупателяПлатежнойКартой") Тогда
		
		Если Документ.РасшифровкаПлатежа.Количество() > 0 Тогда
			Возврат Документ.РасшифровкаПлатежа[0].ДоговорКонтрагента.ЛицевойСчет;	
		КонецЕсли;
		
	КонецЕсли;                                                                     
	
	Возврат Ложь;
		
КонецФункции

Функция ПолучитьСписокРТУБезЧека(Организация, ДатаНачала = Неопределено, ДатаОкончания = Неопределено) Экспорт
	
	СписокРеализаций = Новый СписокЗначений;
	СписокРТУ = Новый МенеджерВременныхТаблиц;
	
	ДатаПереходаНаРаботуСЛицевымиСчетами = Константы.ДатаПереходаНаРаботуСЛицевымиСчетами.Получить();
	
	Если ЗначениеЗаполнено(ДатаНачала) Тогда
		
		Если ДатаНачала < ДатаПереходаНаРаботуСЛицевымиСчетами Тогда
			ДатаНачала = ДатаПереходаНаРаботуСЛицевымиСчетами;	
		КонецЕсли;
		
	Иначе
		ДатаНачала = ДатаПереходаНаРаботуСЛицевымиСчетами;
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(ДатаОкончания) Тогда
		ДатаОкончания = ТекущаяДата();
	КонецЕсли;
	
	ЗапросРТУ = Новый Запрос;
	ЗапросРТУ.МенеджерВременныхТаблиц = СписокРТУ;
	//Марков И. 23.06.2025 #UT10-5298 Добавлено условия для проверки связи КРТУ и РТУ
	ЗапросРТУ.Текст = 
	"ВЫБРАТЬ
	|	РТУ.Ссылка КАК Ссылка,
	|	РТУ.СуммаДокумента КАК РеквизитСумма
	|ПОМЕСТИТЬ СписокРТУ
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК РТУ
	|ГДЕ
	|	РТУ.Проведен
	|	И РТУ.НомерЧекаККМ = 0
	|	И РТУ.ДоговорКонтрагента.ЛицевойСчет
	|	И РТУ.Организация = &Организация
	|	И РТУ.ДоговорКонтрагента.ДатаНачалаРаботыЛицевогоСчета <= РТУ.Дата
	|	И РТУ.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОбороты.Регистратор КАК Корректировка,
	|	ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОбороты.ДокументРасчетовСКонтрагентом КАК Реализация
	|ПОМЕСТИТЬ ВТ_КорректировкиРеализации
	|ИЗ
	|	РегистрНакопления.ВзаиморасчетыСКонтрагентамиПоДокументамРасчетов.Обороты(
	|			,
	|			,
	|			Регистратор,
	|			ДокументРасчетовСКонтрагентом В
	|				(ВЫБРАТЬ
	|					СписокРТУ.Ссылка
	|				ИЗ
	|					СписокРТУ)) КАК ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОбороты
	|ГДЕ
	|	ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОбороты.Регистратор ССЫЛКА Документ.КорректировкаРеализации
	|	И ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОбороты.Регистратор.ДокументРеализации = ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОбороты.ДокументРасчетовСКонтрагентом
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ЕСТЬNULL(КорректировкаРеализацииТовары.КоличествоДоКорректировки - КорректировкаРеализацииТовары.Количество, 0) * -1) КАК КоличествоСкорректировано,
	|	ВТ_КорректировкиРеализации.Реализация
	|ПОМЕСТИТЬ ВТ_КоличествоСкорректированоПоРеализациям
	|ИЗ
	|	Документ.КорректировкаРеализации.Товары КАК КорректировкаРеализацииТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_КорректировкиРеализации КАК ВТ_КорректировкиРеализации
	|		ПО КорректировкаРеализацииТовары.Ссылка = ВТ_КорректировкиРеализации.Корректировка
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_КорректировкиРеализации.Реализация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РеализацияТоваровУслугТовары.Ссылка КАК Реализация,
	|	СУММА(РеализацияТоваровУслугТовары.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТ_КоличествоПоРеализациям
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|ГДЕ
	|	РеализацияТоваровУслугТовары.Ссылка В
	|			(ВЫБРАТЬ
	|				СписокРТУ.Ссылка
	|			ИЗ
	|				СписокРТУ)
	|
	|СГРУППИРОВАТЬ ПО
	|	РеализацияТоваровУслугТовары.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РеализацияТоваровУслугДокументыРасчетовСКонтрагентом.Ссылка КАК Реализация,
	|	СУММА(РеализацияТоваровУслугДокументыРасчетовСКонтрагентом.СуммаВзаиморасчетов) КАК СуммаВзаиморасчетов
	|ПОМЕСТИТЬ ВТ_СуммыПоТабЧастиРеализаций
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.ДокументыРасчетовСКонтрагентом КАК РеализацияТоваровУслугДокументыРасчетовСКонтрагентом
	|ГДЕ
	|	РеализацияТоваровУслугДокументыРасчетовСКонтрагентом.Ссылка В
	|			(ВЫБРАТЬ
	|				СписокРТУ.Ссылка
	|			ИЗ
	|				СписокРТУ)
	|
	|СГРУППИРОВАТЬ ПО
	|	РеализацияТоваровУслугДокументыРасчетовСКонтрагентом.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СписокРТУ.Ссылка КАК Ссылка
	|ИЗ
	|	СписокРТУ КАК СписокРТУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СуммыПоТабЧастиРеализаций КАК ВТ_СуммыПоТабЧастиРеализаций
	|		ПО СписокРТУ.Ссылка = ВТ_СуммыПоТабЧастиРеализаций.Реализация
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВзаиморасчетыСКонтрагентамиПоДокументамРасчетов.Остатки(
	|				,
	|				ДокументРасчетовСКонтрагентом В
	|					(ВЫБРАТЬ
	|						СписокРТУ.Ссылка
	|					ИЗ
	|						СписокРТУ)) КАК Взаиморасчеты
	|		ПО СписокРТУ.Ссылка = Взаиморасчеты.ДокументРасчетовСКонтрагентом
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КоличествоПоРеализациям КАК ВТ_КоличествоПоРеализациям
	|		ПО СписокРТУ.Ссылка = ВТ_КоличествоПоРеализациям.Реализация
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КоличествоСкорректированоПоРеализациям КАК ВТ_КоличествоСкорректированоПоРеализациям
	|		ПО СписокРТУ.Ссылка = ВТ_КоличествоСкорректированоПоРеализациям.Реализация
	|ГДЕ
	|	ВЫБОР
	|			КОГДА ЕСТЬNULL(ВТ_СуммыПоТабЧастиРеализаций.СуммаВзаиморасчетов, 0) <> СписокРТУ.Ссылка.СуммаДокумента
	|					И НЕ ЕСТЬNULL(Взаиморасчеты.СуммаВзаиморасчетовОстаток, 0) = 0
	|				ТОГДА ЛОЖЬ
	|			ИНАЧЕ ЕСТЬNULL(ВТ_КоличествоСкорректированоПоРеализациям.КоличествоСкорректировано, 0) * -1 <> ЕСТЬNULL(ВТ_КоличествоПоРеализациям.Количество, 0)
	|		КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	СписокРТУ.Ссылка.Дата";
	 
	ЗапросРТУ.УстановитьПараметр("Организация", Организация);
	ЗапросРТУ.УстановитьПараметр("ДатаНачала", ДатаНачала);
	ЗапросРТУ.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	
	Результат = ЗапросРТУ.Выполнить();
	
	Если НЕ(Результат.Пустой()) Тогда
		
		Массив = Результат.Выгрузить().ВыгрузитьКолонку("Ссылка");
		СписокРеализаций.ЗагрузитьЗначения(Массив);
		
	КонецЕсли;
	
	Возврат СписокРеализаций;
	
КонецФункции

Функция ПолучитьСписокКРТУБезЧека(Организация, ДатаНачала = Неопределено, ДатаОкончания = Неопределено) Экспорт
	
	СписокКорректировок = Новый СписокЗначений;
	СписокКРТУ = Новый МенеджерВременныхТаблиц;
	
	ДатаПереходаНаРаботуСЛицевымиСчетами = Константы.ДатаПереходаНаРаботуСЛицевымиСчетами.Получить();
	
	Если ЗначениеЗаполнено(ДатаНачала) Тогда
		
		Если ДатаНачала < ДатаПереходаНаРаботуСЛицевымиСчетами Тогда
			ДатаНачала = ДатаПереходаНаРаботуСЛицевымиСчетами;	
		КонецЕсли;
		
	Иначе
		ДатаНачала = ДатаПереходаНаРаботуСЛицевымиСчетами;
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(ДатаОкончания) Тогда
		ДатаОкончания = ТекущаяДата();
	КонецЕсли;
	
	ЗапросКРТУ = Новый Запрос;
	ЗапросКРТУ.МенеджерВременныхТаблиц = СписокКРТУ;
	ЗапросКРТУ.Текст = 
	"ВЫБРАТЬ
	|	КРТУ.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.КорректировкаРеализации КАК КРТУ
	|ГДЕ
	|	КРТУ.Проведен
	|	И КРТУ.НомерЧекаККМ = 0
	|	И КРТУ.ДоговорКонтрагента.ЛицевойСчет
	|	И КРТУ.Организация = &Организация
	|	И НЕ КРТУ.ДокументРеализации ЕСТЬ NULL
	|	И (КРТУ.ДокументРеализации ССЫЛКА Документ.РеализацияТоваровУслуг
	|			ИЛИ КРТУ.ДокументРеализации ССЫЛКА Документ.КорректировкаРеализации)
	|	И КРТУ.ДокументРеализации.НомерЧекаККМ <> 0
	|	И КРТУ.ДоговорКонтрагента.ДатаНачалаРаботыЛицевогоСчета <= КРТУ.Дата
	|	И КРТУ.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания";
	
	ЗапросКРТУ.УстановитьПараметр("Организация", Организация);
	ЗапросКРТУ.УстановитьПараметр("ДатаНачала", ДатаНачала);
	ЗапросКРТУ.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	
	Результат = ЗапросКРТУ.Выполнить();
	
	Если НЕ(Результат.Пустой()) Тогда
		
		Массив = Результат.Выгрузить().ВыгрузитьКолонку("Ссылка");
		СписокКорректировок.ЗагрузитьЗначения(Массив);
		
	КонецЕсли;
	
	Возврат СписокКорректировок;
	
КонецФункции


///////////////////Отправка копии чеков///////////////////
Процедура ОтправкаКопииЧеков() Экспорт
	
	УчетнаяЗапись = Константы.ОсновнаяУчетнаяЗаписьЭлектроннойПочты.Получить();
	
	Если Не ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		
		Сообщить("Не заполнена основная учетная запись электнонной почты");
		Возврат;
		
	КонецЕсли;  
	
	Если Не ЗначениеЗаполнено(Константы.СБИС_ИдентификаторКлиента.Получить()) Тогда
		
		Сообщить("Не заполнен идентификатор клиента");
		Возврат;
		
	КонецЕсли;
	
	ПользовательДляОтправки = Неопределено;
	
	Если ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		
		Для каждого Доступ Из УчетнаяЗапись.ДоступКУчетнойЗаписи Цикл
			
			Если Доступ.Администрирование Тогда
				
				ПользовательДляОтправки = Доступ.Пользователь;	
				Прервать;
				
			КонецЕсли; 			
			
		КонецЦикла;    		
		
	КонецЕсли;
	
	Если ПользовательДляОтправки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОчередьОтправкиКопииЧеков.Период,
	|	ОчередьОтправкиКопииЧеков.Email КАК Email,
	|	ОчередьОтправкиКопииЧеков.Документ КАК Документ,
	|	ОчередьОтправкиКопииЧеков.Статус
	|ИЗ
	|	РегистрСведений.ОчередьОтправкиКопииЧеков КАК ОчередьОтправкиКопииЧеков
	|ГДЕ
	|	(ОчередьОтправкиКопииЧеков.Статус = ""ВОчереди""
	|			ИЛИ ВЫБОР
	|				КОГДА ОчередьОтправкиКопииЧеков.Статус = ""Ошибка""
	|					ТОГДА ОчередьОтправкиКопииЧеков.КоличествоПопыток < 2
	|			КОНЕЦ)
	|ИТОГИ ПО
	|	Email,
	|	Документ"; 
	
	СоответствиеЭлектронныхПисем = Новый Соответствие;
	
	ВыборкаПочта = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Email");
	
	Пока ВыборкаПочта.Следующий() Цикл        
		
		МассивМенеджеровЗаписей = Новый Массив;
		
		НовоеПисьмо = Документы.ЭлектронноеПисьмо.СоздатьДокумент(); 
		НовоеПисьмо.Дата = ТекущаяДата();
		НовоеПисьмо.ЗаголовокПисьма = "Копии чеков";
		НовоеПисьмо.Тема            = "Запрос копии чеков от " + Формат(ТекущаяДата(), "ДЛФ=DT");  
		НовоеПисьмо.Кому		    = ВыборкаПочта.Email;
		НовоеПисьмо.УчетнаяЗапись   = УчетнаяЗапись; 
		НовоеПисьмо.СтатусПисьма    = Перечисления.СтатусыПисем.Исходящее;
		НовоеПисьмо.ЕстьВложения    = Истина;  
		НовоеПисьмо.УстановитьСсылкуНового(Документы.ЭлектронноеПисьмо.ПолучитьСсылку(Новый УникальныйИдентификатор()));
		
		Получатель = НовоеПисьмо.КомуТЧ.Добавить();
		Получатель.АдресЭлектроннойПочты = ВыборкаПочта.Email;
		
		МассивФайлов = Новый Массив;
		
		ВыборкаДокумента = ВыборкаПочта.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Документ");
		
		Пока ВыборкаДокумента.Следующий() Цикл
			
			БылаОшибка = Ложь;
			Отменено = Ложь;
			ТекстОшибки = "";
			
			Попытка
				
				СтруктураЧека = ПолучитьЧекПоДокументу(ВыборкаДокумента.Документ);
				
				Отменено = СтруктураЧека.Отменено;	
				БылаОшибка = Не СтруктураЧека.Результат;
				
				Если СтруктураЧека.Результат Тогда					
									
					ИмяФайла = КаталогВременныхФайлов() + Формат(ВыборкаДокумента.Документ.НомерЧекаККМ, "ЧГ=0") + ".pdf"; 
					СтруктураЧека.Данные.Записать(ИмяФайла);
					
					МассивФайлов.Добавить(ИмяФайла);
										
				Иначе
					ТекстОшибки = СтруктураЧека.Сообщение;					
				КонецЕсли;
				
			Исключение           
				
			    БылаОшибка = Истина;
				ТекстОшибки = ОписаниеОшибки();
				
			КонецПопытки;
					
			ВыборкаДетальные = ВыборкаДокумента.Выбрать();
			
			Пока ВыборкаДетальные.Следующий() Цикл
				
				Запись = РегистрыСведений.ОчередьОтправкиКопииЧеков.СоздатьМенеджерЗаписи();
				Запись.Документ = ВыборкаДокумента.Документ; 
				Запись.Период = ВыборкаДетальные.Период;
				Запись.Статус = ?(БылаОшибка, ?(Отменено, "Отменено", "Ошибка"), "Отправлено"); 
				Запись.Email = ВыборкаПочта.Email;
				Запись.КоличествоПопыток = Запись.КоличествоПопыток + ?(ВыборкаДетальные.Статус = "Ошибка", 1, 0); 
				Запись.ДатаОбновленияСтатуса = ТекущаяДата();
				Запись.ТекстОшибки = ТекстОшибки;  
				
				МассивМенеджеровЗаписей.Добавить(Запись);
				
			КонецЦикла;
			
		КонецЦикла;                                   
		
		Если МассивФайлов.Количество() > 0 Тогда
			
			ИмяВременногоФайлаАрхива = ПолучитьИмяВременногоФайла("zip");
			ИмяФайла = "Чеки.zip";   
			
			ЗаписьZIP = Новый ЗаписьZipФайла(ИмяВременногоФайлаАрхива,,, МетодСжатияZIP.Сжатие, УровеньСжатияZIP.Оптимальный);
			
			Для каждого Файл Из МассивФайлов Цикл
				ЗаписьZIP.Добавить(Файл);	
			КонецЦикла; 
			
			ЗаписьZIP.Записать();
			
			НовыйФайл = Справочники.ВложенияЭлектронныхПисем.СоздатьЭлемент();
			
			ПолученныйФайл = Новый Файл(ИмяВременногоФайлаАрхива);
			НовыйФайл = Справочники.ВложенияЭлектронныхПисем.СоздатьЭлемент();
			НовыйФайл.Объект = НовоеПисьмо.ПолучитьСсылкуНового();
			НовыйФайл.ИмяФайла = ИмяФайла;
			НовыйФайл.Наименование = ИмяФайла;
			НовыйФайл.Хранилище = Новый ХранилищеЗначения(Новый ДвоичныеДанные(ПолученныйФайл.ПолноеИмя), Новый СжатиеДанных());
			НовыйФайл.Записать();
			
			НовоеПисьмо.Записать();
			
			Для каждого Запись Из МассивМенеджеровЗаписей Цикл
				Запись.Записать(Истина);	
			КонецЦикла;
						
			СоответствиеЭлектронныхПисем.Вставить(НовоеПисьмо.Ссылка);  
			
			УдалитьФайлы(ИмяВременногоФайлаАрхива); 
			
			Для каждого Файл Из МассивФайлов Цикл
				УдалитьФайлы(Файл); 
			КонецЦикла; 
			
		КонецЕсли;
		
	КонецЦикла;	
	
	Если СоответствиеЭлектронныхПисем.Количество() > 0 Тогда
		УправлениеЭлектроннойПочтой.ОтправитьПисьма(СоответствиеЭлектронныхПисем, глЗначениеПеременной("глСоответствиеТекстовЭлектронныхПисем"), ПользовательДляОтправки);		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьЧекПоДокументу(Документ) Экспорт
	
	СтруктураВозврата = Новый Структура("Результат, Отменено, Сообщение, Данные", Ложь, Ложь, "", Неопределено);
	
	Если Не ЗначениеЗаполнено(Документ.НомерЧекаККМ) Тогда
		
		СтруктураВозврата.Отменено = Истина;
		СтруктураВозврата.Сообщение = "У документа не заполнен реквизит НомерЧекаККМ";
		
		Возврат СтруктураВозврата;
		
	КонецЕсли;  
	
	НомерЧекаККМ = Документ.НомерЧекаККМ;
	
	СтруктураПечати = ПолучитьИнформациюПоПечати(Документ);
	
	Если Не ЗначениеЗаполнено(СтруктураПечати.ДатаПечати) Тогда
		
		СтруктураВозврата.Отменено = Истина;
		СтруктураВозврата.Сообщение = "Не удалось получить по документу данные по печати чека";
		
		Возврат СтруктураВозврата;
		
	КонецЕсли; 	
		
	ДатаПечати = СтруктураПечати.ДатаПечати;
	ГУИД = СтруктураПечати.ГУИД; 
	
	СтруктураРегНомера = ПолучитьРегистрационныйНомерККТ(ДатаПечати, ГУИД, Документ);
	
	Если Не СтруктураРегНомера.Результат Тогда
		
		СтруктураВозврата.Сообщение = "Не удалось получить регистрационный номер ККМ: " + СтруктураРегНомера.Сообщение;
		
		Возврат СтруктураВозврата;

	КонецЕсли;
	
	РегистрационныйНомер = СтруктураРегНомера.Номер;
	
	СтруктураАутификации = ПолучитьПараметрыАутификацииииСБИС();	
	
	Если Не СтруктураАутификации.Результат Тогда 	                 
		
		СтруктураВозврата.Сообщение = "Проблемы при аутификации в СБИС: " + СтруктураАутификации.Сообщение;	
		
		Возврат СтруктураВозврата;
		
	КонецЕсли;     
	
	SID = СтруктураАутификации.Данные.sid; 
	ИНН = Константы.ОсновнаяОрганизация.Получить().ИНН;
	
	СтруктураФискальногоНакопителя = ПолучитьНомерФискальногоНакопителя(РегистрационныйНомер, ДатаПечати, SID, ИНН);
	
	Если Не СтруктураФискальногоНакопителя.Результат Тогда
		
		СтруктураВозврата.Сообщение = "Проблемы при получении номера накопителя: " + СтруктураФискальногоНакопителя.Сообщение;	
		
		Возврат СтруктураВозврата;
		
	КонецЕсли; 
	
	НомерНакопителя = СтруктураФискальногоНакопителя.Номер;
		
	HTTPСоединение = Новый HTTPСоединение("api.sbis.ru", , , , , 10, Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Неопределено));
	HTTPЗапрос = Новый HTTPЗапрос("/ofd/v1/orgs/" + Строка(ИНН) + "/kkts/" + Строка(РегистрационныйНомер) + "/storages/" + Строка(НомерНакопителя) + "/docs/" + Формат(НомерЧекаККМ, "ЧГ=0") + "?docDate=" + Формат(ДатаПечати, "ДФ=yyyy-MM-ddT00:00:00") + "&format=pdf"); 	
	HTTPЗапрос.Заголовки.Вставить("Cookie", "sid=" + SID);
	Ответ = HTTPСоединение.Получить(HTTPЗапрос);
	
	Если Ответ.КодСостояния <> 200 Тогда
		
		ОтветСтрока = Ответ.ПолучитьТелоКакСтроку();   
		
		СтруктураВозврата.Сообщение = ОтветСтрока; 
		Возврат СтруктураВозврата;
				
	КонецЕсли;   
	
	ДвоичныеДанные = Ответ.ПолучитьТелоКакДвоичныеДанные();
	
	СтруктураВозврата.Результат = Истина;
	СтруктураВозврата.Данные = ДвоичныеДанные; 
	
	Возврат СтруктураВозврата;
	
КонецФункции

Функция ПолучитьИнформациюПоПечати(Документ)
	
	СтруктураВозврата = Новый Структура("ДатаПечати, ГУИД", Неопределено, "");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаданияНаПробитиеЧекаСрезПоследних.ГУИД,
	|	ЗаданияНаПробитиеЧекаСрезПоследних.ДатаОбновления КАК ДатаПечати
	|ИЗ
	|	РегистрСведений.ЗаданияНаПробитиеЧека.СрезПоследних(
	|			,
	|			ПКО = &Документ
	|				И Статус = ""ready"") КАК ЗаданияНаПробитиеЧекаСрезПоследних";
	
	Запрос.УстановитьПараметр("Документ", Документ);  
	
	Выборка = Запрос.Выполнить().Выбрать(); 
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураВозврата, Выборка);
	КонецЕсли;
	
	Возврат СтруктураВозврата; 
		
КонецФункции

Функция ПолучитьРегистрационныйНомерККТ(ДатаПечати, ГУИД, Документ)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ДатаПечати < (ТекущаяДата() - 86400*29) Тогда
		ГУИД = ПолучитьПоследнийНапечатанныйГУИДПоКассе(Документ.Касса);		
	КонецЕсли;
	
	СерверОтправки = Константы.АтолАдресВебСервера.Получить() + ":" + Формат(Константы.АтолПортВебСервера.Получить(), "ЧГ=0");
	
	СтруктураВозврата = Новый Структура("Результат, Сообщение, Номер, КодОшибки", Ложь, "", "", 0, 0);
	
	ЧтениеJSON = Новый ЧтениеJSON;
	Результат = ПолучитьСоединениеССерверомЧеков();
	НовыйЗапрос = Новый HTTPЗапрос("/api/v2/requests/" + ГУИД + "?deviceID=" + Документ.Касса.ИД);
	
	Попытка
		
		НовыйОтвет = Результат.Получить(НовыйЗапрос);
		
		Если НовыйОтвет.КодСостояния <> 200 Тогда
			
			ТекстОшибки = "Код ошибки " + Строка(НовыйОтвет.КодСостояния);
			СтруктураВозврата.Сообщение = ТекстОшибки; 
			
			Возврат СтруктураВозврата;
			
		КонецЕсли;

		Тело = НовыйОтвет.ПолучитьТелоКакСтроку();
		ЧтениеJSON.УстановитьСтроку(Тело);
		Данные = ПрочитатьJSON(ЧтениеJSON);
	
	Исключение
		
		ТекстОшибки = "Обнаружены ошибки при получении ответа от сервера " + СерверОтправки + Символы.ПС + ОписаниеОшибки();
		СтруктураВозврата.Сообщение = ТекстОшибки;	
		
		Возврат СтруктураВозврата;
		
	КонецПопытки;
	
	Если Данные.Свойство("results") И Данные.results.Количество() > 0 Тогда
		
		Результат = Данные.results[0];
		
		Если Результат.status = "error" Тогда
			СтруктураВозврата.Сообщение = Результат.error.description + ". КодОшибки " + Строка(Результат.error.code);	
		ИначеЕсли Результат.status = "ready" Тогда
			
			СтруктураВозврата.Сообщение = "Номер успешно получен";				
			СтруктураВозврата.Номер = Результат.result.fiscalParams.registrationNumber;    
			СтруктураВозврата.Результат = Истина;
			
		Иначе   
			
			Если Результат.Свойство("error") И Результат.error.code > 0 Тогда
				СтруктураВозврата.Сообщение = Результат.error.description + ". КодОшибки " + Строка(Результат.error.code);	
			КонецЕсли; 
			
		КонецЕсли;
		
	Иначе
		
		Если Данные.Свойство("error") И Данные.error.Свойство("description") Тогда
			
			ТекстОшибки = Данные.error.description;
			СтруктураВозврата.КодОшибки = Данные.error.code;        
			
		Иначе
			ТекстОшибки = "В ответе отсутствует результат в необходимом формате";
		КонецЕсли;
	
		СтруктураВозврата.Сообщение = ТекстОшибки;
		
		Возврат СтруктураВозврата;
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
			
	Возврат СтруктураВозврата;
	
КонецФункции

Функция ПолучитьПоследнийНапечатанныйГУИДПоКассе(Касса)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗаданияНаПробитиеЧекаСрезПоследних.ГУИД
	|ИЗ
	|	РегистрСведений.ЗаданияНаПробитиеЧека.СрезПоследних КАК ЗаданияНаПробитиеЧекаСрезПоследних
	|ГДЕ
	|	ЗаданияНаПробитиеЧекаСрезПоследних.ПКО.Касса = &Касса
	|	И ЗаданияНаПробитиеЧекаСрезПоследних.Статус = ""ready""
	|	И ЗаданияНаПробитиеЧекаСрезПоследних.ДатаОбновления >= &ДатаОбновления";
	
	Запрос.УстановитьПараметр("Касса", Касса); 
	Запрос.УстановитьПараметр("ДатаОбновления", ТекущаяДата() - 86400 * 10);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ГУИД;
	КонецЕсли;               
	
	Возврат "";	
		
КонецФункции

Функция ПолучитьПараметрыАутификацииииСБИС()
	
	СтруктураВозврата = Новый Структура("Результат, Данные, Сообщение", Ложь, Неопределено, "");
	
	СтруктураЗапроса = Новый Структура("login,password,app_client_id", Константы.СБИС_Логин.Получить(), Константы.СБИС_Пароль.Получить(), Константы.СБИС_ИдентификаторКлиента.Получить());
	
	HTTPСоединение = Новый HTTPСоединение("api.sbis.ru", , , , , 2, Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Неопределено));
	HTTPЗапрос = Новый HTTPЗапрос("/oauth/service/"); 	
	HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json"); 
	HTTPЗапрос.УстановитьТелоИзСтроки(ВернутьJSON(СтруктураЗапроса), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Ответ = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
	
	ОтветJSONСтрока = Ответ.ПолучитьТелоКакСтроку("UTF8");
	
	Если ЗначениеЗаполнено(СокрЛП(ОтветJSONСтрока)) Тогда
		
		Попытка
			
			СтруктураВозврата.Данные = ВернутьСтруктуруИзJSON(ОтветJSONСтрока);		
			СтруктураВозврата.Результат = Истина;
			
		Исключение          			
			СтруктураВозврата.Сообщение = СокрЛП(ОтветJSONСтрока); 		    
		КонецПопытки;  
		
	Иначе	
		СтруктураВозврата.Сообщение = "Не удалось получить данные аутификации СБИС";
	КонецЕсли;
	
	Возврат СтруктураВозврата;
		
КонецФункции

Функция ПолучитьНомерФискальногоНакопителя(РегистрационныйНомер, ДатаПечати, SID, ИНН)
	
	СтруктураВозврата = Новый Структура("Результат, Номер, Сообщение", Ложь, Неопределено, "");
	
	МассивСтатусовПроверки = Новый Массив;
	МассивСтатусовПроверки.Добавить("2");
	МассивСтатусовПроверки.Добавить("3");
	
	Для каждого Статус Из МассивСтатусовПроверки Цикл
		
		ФискальныеНакопители = ПолучитьФискальныеПоСтатусу(РегистрационныйНомер, SID, ИНН, Статус);
		
		Если ЗначениеЗаполнено(ФискальныеНакопители) Тогда
						
			Для каждого Накопитель Из ФискальныеНакопители Цикл
				
				ДатаНачала = XMLЗначение(Тип("Дата"), Накопитель.effectiveFrom);
				
				Если Статус = "2" Тогда
					ДатаОкончания = XMLЗначение(Тип("Дата"), Накопитель.fsFinishDate);				
				Иначе
					ДатаОкончания = XMLЗначение(Тип("Дата"), Накопитель.effectiveTo);
				КонецЕсли;
								
				Если ДатаПечати >= ДатаНачала И ДатаПечати <= ДатаОкончания Тогда

					СтруктураВозврата.Результат = Истина;
					СтруктураВозврата.Номер = Накопитель.StorageId;
					
					Возврат СтруктураВозврата;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	СтруктураВозврата.Сообщение = "Не удалось получить номер фискального накопителя по дате печати";	
	
	Возврат СтруктураВозврата;
		
КонецФункции 

Функция ПолучитьФискальныеПоСтатусу(РегистрационныйНомер, SID, ИНН, Статус) 
	
	HTTPСоединение = Новый HTTPСоединение("api.sbis.ru", , , , , 2, Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Неопределено));
	HTTPЗапрос = Новый HTTPЗапрос("/ofd/v1/orgs/" + ИНН + "/kkts/" + РегистрационныйНомер + "/storages?status=" + Статус); 	
	HTTPЗапрос.Заголовки.Вставить("Cookie", "sid=" + SID);
	Ответ = HTTPСоединение.Получить(HTTPЗапрос);
	
	ОтветJSONСтрока = Ответ.ПолучитьТелоКакСтроку("UTF8");
	
	Если ЗначениеЗаполнено(СокрЛП(ОтветJSONСтрока)) Тогда
		
		Попытка   		        
			
			ФискальныеНакопители = ВернутьСтруктуруИзJSON(ОтветJSONСтрока);						
			
			Возврат ФискальныеНакопители;
			
		Исключение          			
		КонецПопытки;  
		
	КонецЕсли; 
	
	Возврат Неопределено;
	
КонецФункции

Функция МожноОтправитьКопиюЧекаИзДокумента(Документ) Экспорт
	
	Если Не ЗначениеЗаполнено(Документ.НомерЧекаККМ) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Документ.Касса) Тогда
		Возврат Ложь;
	КонецЕсли;  
	
	СтруктураПечати = ПолучитьИнформациюПоПечати(Документ);
	
	Если Не ЗначениеЗаполнено(СтруктураПечати.ДатаПечати) Тогда		
		Возврат Ложь;                                          	
	КонецЕсли; 
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Не ЗначениеЗаполнено(Константы.СБИС_ИдентификаторКлиента.Получить())
		ИЛИ Не ЗначениеЗаполнено(Константы.СБИС_Логин.Получить()) 
		ИЛИ Не ЗначениеЗаполнено(Константы.СБИС_Пароль.Получить()) Тогда
		Возврат Ложь;	
	КонецЕсли;
	
	Возврат Истина;
		
КонецФункции

