Процедура ОбработатьРеквизитыФабрики(СпрОбъект, ИмяОбъектаМетаданных, ФабрикаСправочника, ИмяОчереди)
	
	Если ИмяОбъектаМетаданных = "ЭквайринговыеТерминалы" Тогда
		
		СпрОбъект.Эквайрер = СсылкаПоИдентификатору(Тип("СправочникСсылка.Контрагенты"), ФабрикаСправочника.Эквайер.GUID);
		СпрОбъект.ДоговорВзаиморасчетов = СсылкаПоИдентификатору(Тип("СправочникСсылка.ДоговорыКонтрагентов"), ФабрикаСправочника.ДоговорВзаиморасчетов.GUID);
		СпрОбъект.Касса = СсылкаПоИдентификатору(Тип("СправочникСсылка.Кассы"), ФабрикаСправочника.Касса.GUID);
		СпрОбъект.Номер = ФабрикаСправочника.Код;
		СпрОбъект.Пароль = ФабрикаСправочника.Пароль;
		СпрОбъект.ПометкаУдаления = XMLЗначение(Тип("Булево"), ФабрикаСправочника.ПометкаУдаления);
		СпрОбъект.Наименование = ФабрикаСправочника.Наименование;
		
		СпрОбъект.ТарифыЗаРасчетноеОбслуживание.Очистить();
		
		Если ТипЗнч(ФабрикаСправочника.ТарифыЗаРасчетноеОбслуживание) = Тип("ОбъектXDTO") Тогда
			
			Если ТипЗнч(ФабрикаСправочника.ТарифыЗаРасчетноеОбслуживание.Строка) = Тип("СписокXDTO") Тогда
				Массив = ФабрикаСправочника.ТарифыЗаРасчетноеОбслуживание.Строка;
			Иначе
				
				Массив = Новый Массив;
				Массив.Добавить(ФабрикаСправочника.ТарифыЗаРасчетноеОбслуживание.Строка);
				
			КонецЕсли;   
			
			Для Каждого Строка Из Массив Цикл
				
				НоваяСтрока = СпрОбъект.ТарифыЗаРасчетноеОбслуживание.Добавить();
				НоваяСтрока.ПроцентТорговойУступки = XMLЗначение(Тип("Число"), Строка.ПроцентТорговойУступки);
				НоваяСтрока.ВидОплаты = СсылкаПоИдентификатору(Тип("СправочникСсылка.ВидыОплатЧекаККМ"), Строка.ВидОплаты.GUID);
				
			КонецЦикла;
			
		КонецЕсли;
		
		СпрОбъект.Касса = Справочники.Кассы.ПустаяСсылка();
		
		МассивСтрок = СформироватьМассивПоСвойству(ФабрикаСправочника, "КассыПодключенныеКТерминалу", "Строка");
		
		Для Каждого Строка Из МассивСтрок Цикл
			
			Если ТипЗнч(Строка.Касса) = Тип("ОбъектXDTO") И Строка.Касса.Свойства().Количество() > 0 И Строка.Касса.Свойства().Получить("GUID") <> Неопределено Тогда		
				
				Касса = Справочники.Кассы.НайтиПоРеквизиту("КодМДМ", Строка.Касса.GUID); 
				
				Если ЗначениеЗаполнено(Касса) Тогда
					
					СпрОбъект.Касса = Касса;
					Прервать;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	ИначеЕсли ИмяОбъектаМетаданных = "ВидОплатыЧекаККМ" Тогда
		
		СпрОбъект.ТипОплаты = СсылкаПоИдентификатору(Тип("ПеречислениеСсылка.ТипыОплатЧекаККМ"), ФабрикаСправочника.ТипОплаты.Перечисление);
		СпрОбъект.Наименование = ФабрикаСправочника.Наименование;
		СпрОбъект.ПометкаУдаления = ФабрикаСправочника.ПометкаУдаления;
		
	ИначеЕсли ИмяОбъектаМетаданных = "Валюты" Тогда
		
		СпрОбъект.НаименованиеПолное = ФабрикаСправочника.НаименованиеПолное;
		СпрОбъект.Наименование = ФабрикаСправочника.Наименование;
		СпрОбъект.Код = ФабрикаСправочника.Код;					
		
	ИначеЕсли ИмяОбъектаМетаданных = "Организации" Тогда
		
		СпрОбъект.НаименованиеПолное = ФабрикаСправочника.НаименованиеПолное;
		СпрОбъект.Наименование = ФабрикаСправочника.НаименованиеСокращенное;
		СпрОбъект.ИНН = ФабрикаСправочника.ИНН;
		СпрОбъект.КПП = ФабрикаСправочника.КПП;
		СпрОбъект.КодПоОКПО = ФабрикаСправочника.ОКПО;
		СпрОбъект.ОГРН = ФабрикаСправочника.ОГРН;
		СпрОбъект.КодПоОКАТО = ФабрикаСправочника.ОКАТО; 		
		СпрОбъект.СвидетельствоДатаВыдачи = ПреобразоватьДатуМДМ(ФабрикаСправочника.ДатаРегистрации);		
		СпрОбъект.Префикс = ФабрикаСправочника.Префикс;
		СпрОбъект.КодИМНС = ФабрикаСправочника.КодИФНС;
		СпрОбъект.КодМДМГоловнойОрганизации = СокрЛП(ФабрикаСправочника.ГоловнаяОрганизация.GUID);
		
		ЗаполнитьРеквизитПоСоответствию(ФабрикаСправочника.ЮрФизЛицо, "GUID", СпрОбъект, "ЮрФизЛицо", ИмяОчереди);
		
		СпрОбъект.ОтражатьВРегламентированномУчете = ?(ФабрикаСправочника.ОтражатьВРегламентированномУчете = "true", Истина, Ложь);	
		
		Если НЕ ФабрикаСправочника.Свойства().Получить("ЮридическоеНаименованиеПодразделения") = Неопределено Тогда
			СпрОбъект.НаименованиеПодразделения = ФабрикаСправочника.ЮридическоеНаименованиеПодразделения; 
		КонецЕсли;			

	ИначеЕсли ИмяОбъектаМетаданных = "Контрагенты" Тогда
		
		СпрОбъект.НаименованиеПолное = ФабрикаСправочника.НаименованиеПолное;
		
		Если Булево(ФабрикаСправочника.НеЗагружатьИННвЦелевыеСистемы) <> Истина Тогда
			СпрОбъект.ИНН = ФабрикаСправочника.ИНН;
			СпрОбъект.КПП = ФабрикаСправочника.КПП;
		КонецЕсли;
		
		СпрОбъект.Комментарий = ФабрикаСправочника.Комментарий;
		
		СпрОбъект.КодМДМПартнера = ФабрикаСправочника.Партнер.GUID;
		
		СпрОбъект.Наименование = ФабрикаСправочника.Наименование;			
		
		Если СпрОбъект.ЭтоНовый() Тогда
			СпрОбъект.ГоловнойКонтрагент = СпрОбъект.ПолучитьСсылкуНового();
		Иначе
			СпрОбъект.ГоловнойКонтрагент = СпрОбъект.Ссылка;
		КонецЕсли;
		
		СпрОбъект.Покупатель = Булево(ФабрикаСправочника.Покупатель);
		СпрОбъект.Поставщик = Булево(ФабрикаСправочника.Поставщик);
		
		СпрОбъект.IDАварда = ФабрикаСправочника.КодАварда;
		СпрОбъект.IDФилиала = "";
		
		ЗаполнитьРеквизитПоСоответствию(ФабрикаСправочника.ЮрФизЛицо, "GUID", СпрОбъект, "ЮрФизЛицо", ИмяОчереди);
		
		МассивСтрок = СформироватьМассивПоСвойству(ФабрикаСправочника, "КонтактнаяИнформация", "Строка");
		ЗагрузитьКонтактнуюИнформацию(МассивСтрок, СпрОбъект, ИмяОчереди);
		
		СпрОбъект.AMQP_ПроверятьВзаиморасчетыЧерезБиллинг = ?(СпрОбъект.ЭтоНовый(), Булево(ФабрикаСправочника.КонтролироватьВзаиморасчетыЧерезСистемуБиллинг), 
		ПроверятьВзаимоарасчетыЧерезБиллингКонтроль(СпрОбъект)); 
		
		Если ФабрикаСправочника.МетодКонтроляВзаиморасчетовЧерезБиллинг.Перечисление = "По каждому договору" Тогда
			СпрОбъект.AMQP_МетодКонтроляВзаиморасчетовЧерезБиллинг = Перечисления.МетодыКонтроляВзаиморасчетовЧерезБиллинг.ПоКаждомуДоговору;
		ИначеЕсли ФабрикаСправочника.МетодКонтроляВзаиморасчетовЧерезБиллинг.Перечисление = "По всем договорам контрагента" Тогда
			СпрОбъект.AMQP_МетодКонтроляВзаиморасчетовЧерезБиллинг = Перечисления.МетодыКонтроляВзаиморасчетовЧерезБиллинг.ПоВсемДоговорамКонтрагента;
		ИначеЕсли ФабрикаСправочника.МетодКонтроляВзаиморасчетовЧерезБиллинг.Перечисление = "По всем договорам в разрезе организаций" Тогда
			СпрОбъект.AMQP_МетодКонтроляВзаиморасчетовЧерезБиллинг = Перечисления.МетодыКонтроляВзаиморасчетовЧерезБиллинг.ПоВсемДоговорамВРазрезеОрганизаций;
		Иначе
			СпрОбъект.AMQP_МетодКонтроляВзаиморасчетовЧерезБиллинг = Перечисления.МетодыКонтроляВзаиморасчетовЧерезБиллинг.ПустаяСсылка();
		КонецЕсли;
		
		СпрОбъект.AMQP_ДатаНачалаВеденияВзаиморасчетовЧерезБиллинг = ПреобразоватьДатуМДМ(ФабрикаСправочника.ДатаНачалаВеденияВзаиморасчетовЧерезБиллинг);
		СпрОбъект.AMQP_ОтправлятьДокументы = Булево(ФабрикаСправочника.ОтправлятьДокументыAMQP);
		СпрОбъект.НеОбъединятьЗаказы = Булево(ФабрикаСправочника.НеОбъединятьЗаказы);  
		//+Шульман А. 25.02.2026 #UT10-5712  
		СпрОбъект.ЗагружатьУПДОтКонтрагентаИзЭДО = Булево(ФабрикаСправочника.ЗагружатьУПДОтКонтрагентаИзЭДО);  
		//-Шульман А. 25.02.2026 #UT10-5712
		
		СпрОбъект.EMailЗаказ_КонтролироватьРасхождениеЦенВПроцентах = ФабрикаСправочника.EMailЗаказ_КонтролироватьРасхождениеЦенВПроцентах;
		
		Если НРег(ФабрикаСправочника.ИсточникКонтакта.Перечисление) = "другое" Тогда
			СпрОбъект.ИсточникКонтакта = Перечисления.ИсточникКонтакта.Другое;
		ИначеЕсли НРег(ФабрикаСправочника.ИсточникКонтакта.Перечисление) = "рекомендации" Тогда
			СпрОбъект.ИсточникКонтакта = Перечисления.ИсточникКонтакта.Рекомендации;
		ИначеЕсли НРег(ФабрикаСправочника.ИсточникКонтакта.Перечисление) = "поиск в интернете" Тогда
			СпрОбъект.ИсточникКонтакта = Перечисления.ИсточникКонтакта.ПоискВИнтернете;
		ИначеЕсли НРег(ФабрикаСправочника.ИсточникКонтакта.Перечисление) = "регистрация с сайта" Тогда
			СпрОбъект.ИсточникКонтакта = Перечисления.ИсточникКонтакта.РегистрацияССайта;
		ИначеЕсли НРег(ФабрикаСправочника.ИсточникКонтакта.Перечисление) = "исходящий звонок" Тогда
			СпрОбъект.ИсточникКонтакта = Перечисления.ИсточникКонтакта.ИсходящийЗвонок;
		ИначеЕсли НРег(ФабрикаСправочника.ИсточникКонтакта.Перечисление) = "входящий звонок" Тогда
			СпрОбъект.ИсточникКонтакта = Перечисления.ИсточникКонтакта.ВходящийЗвонок;
		ИначеЕсли НРег(ФабрикаСправочника.ИсточникКонтакта.Перечисление) = "личное посещение" Тогда
