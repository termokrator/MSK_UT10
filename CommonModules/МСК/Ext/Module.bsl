Функция ПоискИСозданиеНоменклатуры(ФабрикаИмени)

	СпрОбъект = Неопределено;	
	ЧислоКодАварды = Число(ФабрикаИмени.КодАварда);
	
	Если ЧислоКодАварды > 0 Тогда		
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.КодАварда = &КодАварда
		|	И Номенклатура.КодМДМ = """"
		|	И Номенклатура.ПометкаУдаления = ЛОЖЬ";
		
		Запрос.УстановитьПараметр("КодАварда", ЧислоКодАварды);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			СпрОбъект = Выборка.Ссылка.ПолучитьОбъект();		
		КонецЕсли;
		
	КонецЕсли;
	
	Если СпрОбъект = Неопределено Тогда
		
		СпрОбъект = РаботаСАвардой.ПроверитьНоменклатуруПоНормализованномуКоду(ФабрикаИмени.Артикул, 
		Справочники.Номенклатура.НайтиПоРеквизиту("КодМДМ", ФабрикаИмени.Производитель.GUID, Справочники.Номенклатура.ПустаяСсылка()));
		
	КонецЕсли;
	
	Возврат СпрОбъект;	

КонецФункции

Функция ПолучитьСоответствиеСтороннегоСкладаСкладуФилиала(СтороннийСклад, СтороннийСкладФилиала) Экспорт

	//Если нужно получить соответствие по одному из параметров, то нужно передать второй параметр как Неопределено	
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	СоответствиеСтороннихСкладовСкладамФилиала.СтороннийСклад,
	                      |	СоответствиеСтороннихСкладовСкладамФилиала.СтороннийСкладФилиала
	                      |ИЗ
	                      |	РегистрСведений.СоответствиеСтороннихСкладовСкладамФилиала КАК СоответствиеСтороннихСкладовСкладамФилиала
	                      |ГДЕ
	                      |	ВЫБОР
	                      |			КОГДА &СтороннийСклад = НЕОПРЕДЕЛЕНО
	                      |				ТОГДА ИСТИНА
	                      |			ИНАЧЕ СоответствиеСтороннихСкладовСкладамФилиала.СтороннийСклад = &СтороннийСклад
	                      |		КОНЕЦ
	                      |	И ВЫБОР
	                      |			КОГДА &СтороннийСкладФилиала = НЕОПРЕДЕЛЕНО
	                      |				ТОГДА ИСТИНА
	                      |			ИНАЧЕ СоответствиеСтороннихСкладовСкладамФилиала.СтороннийСкладФилиала = &СтороннийСкладФилиала
	                      |		КОНЕЦ
	                      |	И СоответствиеСтороннихСкладовСкладамФилиала.Использование = ИСТИНА
						  |	И СоответствиеСтороннихСкладовСкладамФилиала.СтороннийСклад ССЫЛКА Справочник.СторонниеСклады");
	
	Запрос.Параметры.Вставить("СтороннийСклад", СтороннийСклад);
	Запрос.Параметры.Вставить("СтороннийСкладФилиала", СтороннийСкладФилиала);
	
	РезЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезЗапроса.Следующий() Тогда
		Возврат РезЗапроса;
	Иначе
		Возврат Неопределено;
	КонецЕсли;	

КонецФункции

Функция ТекстЗапросаЗаполнитьТЧТОХ() 
	
	// ВНИМАНИЕ!!! Меняя этот запрос, нужно также аналогичным образом изменить запрос 
	// в РегистрыНакопления.ТоварыОтветственногоХранения.ПолучитьДвиженияСписание(),
	// УправлениеЗапасами.ПолучитьТаблицуСвободныхОстатковПоСериямТОХ(),
	// МСК.СверитьТабЧастьТОХиВыкупы()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Остатки.Номенклатура,
	|	Остатки.СерияНоменклатуры,
	|	Остатки.КоличествоОстаток КАК КоличествоОстатокТОХ,
	|	0 КАК КоличествоОстатокТОХФилиал,
	|	0 КАК КоличествоОстатокСклад
	|ПОМЕСТИТЬ ВТ_ОстаткиТОХ
	|ИЗ
	|	РегистрНакопления.ТоварыОтветственногоХранения.Остатки(&Дата, Номенклатура В (&МассивТоваров)) КАК Остатки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОстаткиТОХ.Номенклатура,
	|	ОстаткиТОХ.СерияНоменклатуры,
	|	0,
	|	ОстаткиТОХ.КоличествоОстаток,
	|	0
	|ИЗ
	|	РегистрНакопления.ТоварыОтветственногоХраненияПереданные.Остатки(&Дата, Номенклатура В (&МассивТоваров)) КАК ОстаткиТОХ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОстаткиСклад.Номенклатура,
	|	ОстаткиСклад.СерияНоменклатуры,
	|	0,
	|	0,
	|	ОстаткиСклад.КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(
	|			&Дата,
	|			Номенклатура В (&МассивТоваров)
	|				И Склад = &Склад) КАК ОстаткиСклад
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОстаткиТОХ.Номенклатура,
	|	СУММА(ВТ_ОстаткиТОХ.КоличествоОстатокТОХ) КАК КоличествоОстатокТОХ,
	|	СУММА(ВТ_ОстаткиТОХ.КоличествоОстатокТОХФилиал) КАК КоличествоОстатокТОХФилиал,
	|	СУММА(ВТ_ОстаткиТОХ.КоличествоОстатокСклад) КАК КоличествоОстатокСклад,
	|	СУММА(ВЫБОР
	|			КОГДА ВТ_ОстаткиТОХ.КоличествоОстатокТОХФилиал < 0
	|				ТОГДА ВТ_ОстаткиТОХ.КоличествоОстатокТОХФилиал
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоОстатокТОХФилиалОтрицат
	|ПОМЕСТИТЬ ВТ_ОстаткиТОХ_БезСерии
	|ИЗ
	|	ВТ_ОстаткиТОХ КАК ВТ_ОстаткиТОХ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ОстаткиТОХ.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	// Для процедуры ЗаполнитьТЧТОХ - не отбрасываем отрицательные остатки
	|ВЫБРАТЬ
	|	ВТ_ОстаткиТОХ.Номенклатура,
	|	ВТ_ОстаткиТОХ.СерияНоменклатуры,
	|	СУММА(ВТ_ОстаткиТОХ.КоличествоОстатокТОХ) КАК КоличествоОстатокТОХ,
	|	СУММА(ВТ_ОстаткиТОХ.КоличествоОстатокТОХФилиал) КАК КоличествоОстатокТОХФилиал,
	|	СУММА(ВТ_ОстаткиТОХ.КоличествоОстатокСклад) КАК КоличествоОстатокСклад,
	|	СУММА(ВТ_ОстаткиТОХ.КоличествоОстатокТОХ - ВТ_ОстаткиТОХ.КоличествоОстатокТОХФилиал) КАК ДоступноТОХПоСерии
	|ПОМЕСТИТЬ ВТ_ОстаткиТОХ_ПоСериям
	|ИЗ
	|	ВТ_ОстаткиТОХ КАК ВТ_ОстаткиТОХ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ОстаткиТОХ.Номенклатура,
	|	ВТ_ОстаткиТОХ.СерияНоменклатуры
	|;                              
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОстаткиТОХ_ПоСериям.Номенклатура,
	|	СУММА(ВТ_ОстаткиТОХ_ПоСериям.КоличествоОстатокТОХФилиал) КАК КоличествоОстатокТОХФилиал
	|ПОМЕСТИТЬ ВТ_ОтрицатТОХПереданные
	|ИЗ
	|	ВТ_ОстаткиТОХ_ПоСериям КАК ВТ_ОстаткиТОХ_ПоСериям
	|ГДЕ
	|	ВТ_ОстаткиТОХ_ПоСериям.КоличествоОстатокТОХФилиал < 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ОстаткиТОХ_ПоСериям.Номенклатура
	|;	
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОстаткиТОХ_БезСерии.Номенклатура,
	|	ВТ_ОстаткиТОХ_БезСерии.КоличествоОстатокТОХ - ВТ_ОстаткиТОХ_БезСерии.КоличествоОстатокТОХФилиал КАК ВсегоДоступноТОХ,
	|	ВТ_ОстаткиТОХ_БезСерии.КоличествоОстатокТОХ,
	|	ВТ_ОстаткиТОХ_БезСерии.КоличествоОстатокТОХФилиал,
	|	ВТ_ОстаткиТОХ_БезСерии.КоличествоОстатокСклад,
	|	ВТ_ОстаткиТОХ_БезСерии.КоличествоОстатокСклад - (ВТ_ОстаткиТОХ_БезСерии.КоличествоОстатокТОХ - ВТ_ОстаткиТОХ_БезСерии.КоличествоОстатокТОХФилиал) КАК СобственныйОстаток,
	|	ВТ_ОстаткиТОХ_БезСерии.КоличествоОстатокТОХФилиалОтрицат КАК КоличествоОстатокТОХФилиалОтрицат	
	|ПОМЕСТИТЬ ВТ_ОстаткиТОХ_ПоНоменклатуре  
	|ИЗ
	|	ВТ_ОстаткиТОХ_БезСерии КАК ВТ_ОстаткиТОХ_БезСерии
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОстаткиТОХ.Номенклатура,
	|	ВТ_ОстаткиТОХ.СерияНоменклатуры,
	|	СУММА(ВТ_ОстаткиТОХ.КоличествоОстатокТОХ - ВЫБОР
	|			КОГДА ВТ_ОстаткиТОХ.КоличествоОстатокТОХФилиал > 0
	|				ТОГДА ВТ_ОстаткиТОХ.КоличествоОстатокТОХФилиал
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ДоступноТОХПоСерии
	|ПОМЕСТИТЬ ВТ_ОстаткиТОХ_БезОтрицатОстатков  
	|ИЗ
	|	ВТ_ОстаткиТОХ КАК ВТ_ОстаткиТОХ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ОстаткиТОХ.Номенклатура,
	|	ВТ_ОстаткиТОХ.СерияНоменклатуры
	|
	|ИМЕЮЩИЕ
	|	СУММА(ВТ_ОстаткиТОХ.КоличествоОстатокТОХ - ВЫБОР
	|			КОГДА ВТ_ОстаткиТОХ.КоличествоОстатокТОХФилиал > 0
	|				ТОГДА ВТ_ОстаткиТОХ.КоличествоОстатокТОХФилиал
	|			ИНАЧЕ 0
	|		КОНЕЦ) > 0	
	|";

    Возврат ТекстЗапроса;

КонецФункции // ()

