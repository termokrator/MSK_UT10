Функция ПолучитьЦенуПоставщика(Товар,ТипЦен,Дата)
	
	ЗапросЦены = Новый Запрос;
	ЗапросЦены.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЦеныНоменклатурыКонтрагентовСрезПоследних.Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатурыКонтрагентов.СрезПоследних(
	|			&Дата,
	|			Номенклатура = &Номенклатура
	|				И ТипЦен = &ТипЦены) КАК ЦеныНоменклатурыКонтрагентовСрезПоследних";
	
	ЗапросЦены.УстановитьПараметр("Дата", Дата);
	ЗапросЦены.УстановитьПараметр("Номенклатура", Товар);
	ЗапросЦены.УстановитьПараметр("ТипЦены", ТипЦен);
	
	РезультатЗапросаЦены = ЗапросЦены.Выполнить();
	
	Если Не РезультатЗапросаЦены.Пустой() Тогда
		
		ВыборкаЗапросаЦены = РезультатЗапросаЦены.Выбрать();
		ВыборкаЗапросаЦены.Следующий();
		Возврат ВыборкаЗапросаЦены.Цена;
		
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

Функция ФорматироватьДату(ДатаСтрока)
	
	День = Сред(ДатаСтрока, 1, 2);
	Месяц = Сред(ДатаСтрока, 4, 2);
	Год = Сред(ДатаСтрока, 7, 4);
	Час = Сред(ДатаСтрока, 12, 2);
	Мин = Сред(ДатаСтрока, 15, 2);
	Сек = Сред(ДатаСтрока, 18, 2);
	
	Возврат Дата(Год, Месяц, День, Час, Мин, Сек);

КонецФункции

Функция ОбработатьНеподдерживаемоеСвойствоJSON(Знач Свойство, Значение, ДополнительныеПараметры, Отказ) Экспорт
	
	Возврат "";
	
КонецФункции

Процедура ПередЗаписьюДокументаПроверкаПометкиУдаления(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт 

	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ПривилегированныйРежим() Тогда
		
		Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения ИЛИ Источник.ПометкаУдаления Тогда
			
			Если НЕ РольДоступна(Метаданные.Роли.СамыеПолныеПрава) И НЕ РольДоступна(Метаданные.Роли.РазрешитьУстанавливатьПометкуНаУдаление) Тогда		
				
				Отказ = Истина;	
				#Если Клиент Тогда
					Сообщить("Недостаточно прав для установки пометки удаления. Изменения не могут быть записаны...", СтатусСообщения.Важное);
				#КонецЕсли 
				
			КонецЕсли; 		
			
		КонецЕсли;             	
		
	КонецЕсли; 

КонецПроцедуры

Процедура ОтправкаЗаказовВнешнимПоставщикам() Экспорт 
	
	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда 
		
		ЗаписьЖурналаРегистрации("Отправка заказов внешним поставщикам", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Отменена работа регламентного задания из-за несоответствия параметров подключения к ИБ");
		Возврат;
		
	КонецЕсли;
	
	Письма = Новый Соответствие;
	
	Запрос = Новый Запрос;                                                  
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЭлектронноеПисьмо.Ссылка КАК Письмо
	|ИЗ
	|	Документ.ЭлектронноеПисьмо КАК ЭлектронноеПисьмо
	|ГДЕ
	|	ЭлектронноеПисьмо.ПометкаУдаления = ЛОЖЬ
	|	И ЭлектронноеПисьмо.Тема ПОДОБНО &Тема
	|	И ЭлектронноеПисьмо.Дата > &Дата
	|	И ЭлектронноеПисьмо.СтатусПисьма = &СтатусПисьма";
	
	Запрос.УстановитьПараметр("Дата", ТекущаяДата() - 60*60*24*7); //Письма за неделю	
	Запрос.УстановитьПараметр("Тема", "%Перечень товаров к заказу%");
	Запрос.УстановитьПараметр("СтатусПисьма", Перечисления.СтатусыПисем.Исходящее);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Письма.Вставить(Выборка.Письмо, Неопределено);
	КонецЦикла;
	
	УправлениеЭлектроннойПочтой.ПолучениеОтправкаПисем(глЗначениеПеременной("глСоответствиеТекстовЭлектронныхПисем"), 
	глЗначениеПеременной("глТекущийПользователь"),, Письма, Истина);
	
КонецПроцедуры

Функция ПолучитьСостояниеЭДО(ПромДок) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Объект",ПромДок);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗначенияСвойствОбъектов.Значение КАК ТекЗначение
	|ИЗ
	|	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	|ГДЕ
	|	ЗначенияСвойствОбъектов.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СвойстваОбъектов.СостояниеЭДО)
	|	И ЗначенияСвойствОбъектов.Объект = &Объект";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ОбъектЗначение = Выборка.ТекЗначение; 
	Иначе
		ОбъектЗначение = Перечисления.СостояниеЭДО.ПустаяСсылка();
	КонецЕсли; 
	
	Возврат ОбъектЗначение;

КонецФункции

Функция ЗаписатьСостояниеЭДО(ПромДок,ПромСтатус) Экспорт

	НаборЗаписей = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Объект.Установить(ПромДок);
	НаборЗаписей.Отбор.Свойство.Установить(ПланыВидовХарактеристик.СвойстваОбъектов.СостояниеЭДО);
	НаборЗаписей.Записать();
	
	НовЗначСвва = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
	НовЗначСвва.Объект = ПромДок;
	НовЗначСвва.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.СостояниеЭДО;
	НовЗначСвва.Значение = ПромСтатус;
	НовЗначСвва.Записать();

КонецФункции

Функция ПроверятьВзаимоарасчетыЧерезБиллингКонтроль(ТекОбъект) 
	
	ВозвращаемоеЗначение = Ложь;
	
	ОсновнаяОрганизация = Константы.ОсновнаяОрганизация.Получить();   
	
	Если Не ЗначениеЗаполнено(ОсновнаяОрганизация) Тогда
		Возврат ВозвращаемоеЗначение;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Ссылка
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.Владелец = &Владелец
	|	И ДоговорыКонтрагентов.Организация = &Организация
	|	И ДоговорыКонтрагентов.ВыгружаетсяВБиллинг = ИСТИНА";
	
	Запрос.УстановитьПараметр("Владелец", ТекОбъект.Ссылка);
	Запрос.УстановитьПараметр("Организация", ОсновнаяОрганизация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ВозвращаемоеЗначение = Истина;
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции 

Функция ПолучитьСтатусПриемки(ПромДок) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Объект", ПромДок);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗначенияСвойствОбъектов.Значение КАК ТекЗначение
	|ИЗ
	|	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	|ГДЕ
	|	ЗначенияСвойствОбъектов.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СвойстваОбъектов.СтатусПриемки)
	|	И ЗначенияСвойствОбъектов.Объект = &Объект";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ОбъектЗначение = Выборка.ТекЗначение; 
	Иначе
		ОбъектЗначение = Перечисления.СтатусыПриемки.ПустаяСсылка();
	КонецЕсли; 
	
	Возврат ОбъектЗначение;

КонецФункции

