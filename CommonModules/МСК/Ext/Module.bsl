			|	РегистрСведений.ТоварыГруппыZВНаличииВОП КАК ТоварыГруппыZВНаличииВОП
			|
			|УПОРЯДОЧИТЬ ПО
			|	Дата";
		
		РезультатЗапросаДатыВРегистре = ЗапросДатыВРегистре.Выполнить().Выгрузить();
		
		Если НЕ РезультатЗапросаДатыВРегистре.Количество() = 0 Тогда
			
			ТекДатаВРегистре = РезультатЗапросаДатыВРегистре[0].Дата;
			
			Если ТекДатаВРегистре < ДатаВыгрузки Тогда
				
				НаборЗаписейВРегистре = РегистрыСведений.ТоварыГруппыZВНаличииВОП.СоздатьНаборЗаписей();				
				НаборЗаписейВРегистре.Записать();
				
			КонецЕсли;
				
		КонецЕсли;
		
		НачатьТранзакцию();
		
		Для Каждого СтрокаСпискаТоваров Из Товары Цикл
			
			ТоварПоКодуМДМ = Справочники.Номенклатура.НайтиПоРеквизиту("КодМДМ", СтрокаСпискаТоваров.НоменклатураКодМДМ);
			
			Если НЕ ТоварПоКодуМДМ.Пустая() Тогда
				
