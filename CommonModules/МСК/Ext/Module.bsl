			ОтветственныйДокумента = Справочники.Пользователи.НайтиПоКоду("robot_op");
			
			Если ОтветственныйДокумента.Пустая() Тогда
				ОтветственныйДокумента = Справочники.Пользователи.НайтиПоКоду("robot");
			КонецЕсли;

		КонецЕсли;
		
		Если ЗначениеЗаполнено(ГУИДУстановкиЦен) Тогда 
			
			ДокУстановкаЦен = Документы.УстановкаЦенНоменклатуры.НайтиПоРеквизиту("ИДДокументаВСмежнойБазе", ГУИДУстановкиЦен);  
			
			Если НЕ ДокУстановкаЦен.Пустая() Тогда    
				
				ЗаписьЖурналаРегистрации("Загрузка документов.Установка цен номенклатуры.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, "Документ с ИД документа '"
				+ ГУИДУстановкиЦен + "' уже загружен ");
				Возврат;
				
			Иначе
				
				ДокУстановкаЦен							   = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
				ДокУстановкаЦен.Дата                       =  ТекущаяДата();
				ДокУстановкаЦен.ИДДокументаВСмежнойБазе    = ГУИДУстановкиЦен;				 
				ДокУстановкаЦен.Ответственный              = ?(ОтветственныйДокумента.Пустая(), Справочники.Пользователи.НайтиПоКоду("webadmin"), ОтветственныйДокумента);;
				ДокУстановкаЦен.Комментарий                = "Установка цен " + СокрЛП(СообщениеJSON.НомерДокумента) + " от " + Дата(СообщениеJSON.ДатаДокумента);
				ДокУстановкаЦен.НеПроводитьНулевыеЗначения = Истина;
				
				СоответствиеТиповЦен = Новый Соответствие;
				СписокТиповЦен = СообщениеJSON.ТипыЦен;
				
				Для Каждого СтрокаСпискаТиповЦен Из СписокТиповЦен Цикл
					
					ТипЦеныПоКодМДМ = Справочники.ТипыЦенНоменклатуры.НайтиПоРеквизиту("КодМДМ", СтрокаСпискаТиповЦен.ТипЦенКодМДМ);  
					
					Если НЕ ТипЦеныПоКодМДМ.Пустая() Тогда  
						
						НовСтрТипыЦен =  ДокУстановкаЦен.ТипыЦен.Добавить();
						НовСтрТипыЦен.ТипЦен = ТипЦеныПоКодМДМ.Ссылка;
						
						СоответствиеТиповЦен.Вставить(СтрокаСпискаТиповЦен.ТипЦенКодМДМ, ТипЦеныПоКодМДМ);
						
					Иначе             
						ЗаписьЖурналаРегистрации("Загрузка документов.Установка цен номенклатуры.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
						"Не найден тип цены  " + СокрЛП(СтрокаСпискаТиповЦен.ТипЦенНаименование) + " с кодом МДМ " + СокрЛП(СтрокаСпискаТиповЦен.ТипЦенКодМДМ));
					КонецЕсли;
					
				КонецЦикла;
				
				Если ДокУстановкаЦен.ТипыЦен.Количество() = 0 Тогда   
					
					ЗаписьЖурналаРегистрации("Загрузка документов.Установка цен номенклатуры.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
					"Документ с ИД документа '" + ГУИДУстановкиЦен + "' не найден ни один тип цен по кодам МДМ");
					Возврат;
					
				Иначе
					ДокУстановкаЦен.Записать(РежимЗаписиДокумента.Запись);
				КонецЕсли;
				
				СписокТоваров = СообщениеJSON.Товары;
				
				Для Каждого СтрокаСпискаТоваров Из СписокТоваров Цикл
					
					ТипЦеныПоСоответствию = СоответствиеТиповЦен.Получить(СтрокаСпискаТоваров.ТипЦенКодМДМ); 
					
					Если НЕ ТипЦеныПоСоответствию = Неопределено Тогда       
						
						ТоварПоКодуМДМ = Справочники.Номенклатура.НайтиПоРеквизиту("КодМДМ", СтрокаСпискаТоваров.НоменклатураКодМДМ);
						
						Если НЕ ТоварПоКодуМДМ.Пустая() Тогда     
							
							ТекЕдиницаХранения = ТоварПоКодуМДМ.ЕдиницаХраненияОстатков;							
							
							Если Не ЗначениеЗаполнено(ТекЕдиницаХранения) Тогда
								
								ЗаписьЖурналаРегистрации("Загрузка документов.Установка цен номенклатуры.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
								"У номенклатуры с кодом МДМ " + СокрЛП(СтрокаСпискаТоваров.НоменклатураКодМДМ)+ " не заполнена единица хранения остатков.");
								Продолжить;  
								
							КонецЕсли;
							
							НоваяСтрокаТовары				  		 = ДокУстановкаЦен.Товары.Добавить();
							НоваяСтрокаТовары.Номенклатура	  		 = ТоварПоКодуМДМ;
							НоваяСтрокаТовары.ЕдиницаИзмерения		 = ТекЕдиницаХранения;
							НоваяСтрокаТовары.ТипЦен	     		 = ТипЦеныПоСоответствию; 
							НоваяСтрокаТовары.Валюта	      		 = ТипЦеныПоСоответствию.ВалютаЦены;
							НоваяСтрокаТовары.Цена	          		 = СтрокаСпискаТоваров.Цена;
							НоваяСтрокаТовары.ИндексСтрокиТаблицыЦен = СтрокаСпискаТоваров.ИндексСтрокиТаблицыЦен; 
							
						Иначе 
							ЗаписьЖурналаРегистрации("Загрузка документов.Установка цен номенклатуры.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
							"Не найден товар с кодом МДМ " + СокрЛП(СтрокаСпискаТоваров.НоменклатураКодМДМ));
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЦикла;
				
				Если Не ДокУстановкаЦен.Товары.Количество() = 0 Тогда 
					
					Попытка    
						
						ДокУстановкаЦен.Записать(РежимЗаписиДокумента.Проведение);
						ЗаписьЖурналаРегистрации("ПолучениеСообщений.Прием", УровеньЖурналаРегистрации.Информация,,, ДокУстановкаЦен.Ссылка);    
						
					Исключение     
						
						ЗаписьЖурналаРегистрации("Загрузка документов.Установка цен номенклатуры.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
						"Ошибка проведения документа: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
						
						СтрокаИсключения = "ВидДокумента " + ВидДокумента + "; Ошибка создания/записи" + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()); 					 
						ВызватьИсключение СтрокаИсключения; 
						
					КонецПопытки;	 
					
				Иначе
					
					ЗаписьЖурналаРегистрации("Загрузка документов.Установка цен номенклатуры.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
					"Ошибка создания документа: не заполнена табличная часть 'Товары' ");
					
				КонецЕсли;
				
			КонецЕсли;  
			
		КонецЕсли;		
		
	ИначеЕсли ВидДокумента = "УстановкаЦенНоменклатурыКонтрагентов" Тогда
		
		ГУИДУстановкиЦен = СообщениеJSON.УникальныйИдентификатор;
	
		ОтветственныйДокумента = Справочники.Пользователи.НайтиПоКоду("служебный");
		
		Если ЗначениеЗаполнено(ГУИДУстановкиЦен) Тогда 
			
			ДокУстановкаЦен = Документы.УстановкаЦенНоменклатурыКонтрагентов.НайтиПоРеквизиту("ИДДокументаВСмежнойБазе", ГУИДУстановкиЦен);  
			
			Если НЕ ДокУстановкаЦен.Пустая() Тогда    
				
				ЗаписьЖурналаРегистрации("Загрузка документов.Установка цен номенклатуры контрагентов.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
				"Документ с ИД документа '" + ГУИДУстановкиЦен + "' уже загружен ");
				Возврат;
				
			Иначе
				
				ДокУстановкаЦен							   = Документы.УстановкаЦенНоменклатурыКонтрагентов.СоздатьДокумент();
				ДокУстановкаЦен.Дата					   =  Дата(СообщениеJSON.ДатаДокумента);
				ДокУстановкаЦен.ИДДокументаВСмежнойБазе    = ГУИДУстановкиЦен;				 
				ДокУстановкаЦен.Ответственный			   = ?(ОтветственныйДокумента.Пустая(), Справочники.Пользователи.НайтиПоКоду("webadmin"), ОтветственныйДокумента);;
				ДокУстановкаЦен.Комментарий 			   = "Установка цен " + СокрЛП(СообщениеJSON.НомерДокумента) + " от " + Дата(СообщениеJSON.ДатаДокумента);
				ДокУстановкаЦен.НеПроводитьНулевыеЗначения = Истина;
				
				СоответствиеТиповЦен = Новый Соответствие;
				СписокТиповЦен = СообщениеJSON.ТипыЦен;
				
				Для Каждого СтрокаСпискаТиповЦен Из СписокТиповЦен Цикл
					
					ТипЦеныПоКодМДМ = Справочники.ТипыЦенНоменклатурыКонтрагентов.НайтиПоРеквизиту("КодМДМ", СтрокаСпискаТиповЦен.ТипЦенКодМДМ);  
					
					Если НЕ ТипЦеныПоКодМДМ.Пустая() Тогда  
						
						НовСтрТипыЦен =  ДокУстановкаЦен.ТипыЦен.Добавить();
						НовСтрТипыЦен.ТипЦен = ТипЦеныПоКодМДМ.Ссылка;
						
