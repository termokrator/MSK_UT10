	|		ПО ВТ_ТоварыНоменклатура.НомерГТД = СправНомераГТД.Код
	|			И (НЕ СправНомераГТД.ПометкаУдаления)
	|			И (НЕ СправНомераГТД.Код = """")
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ТоварыНоменклатура.НоменклатураКодМДМ,
	|	ВТ_ТоварыНоменклатура.Номенклатура,
	|	ВТ_ТоварыНоменклатура.Количество,
