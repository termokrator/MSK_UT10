Функция СуществуетДокументПоДаннымВходящегоДокумента(НомерПоДаннымПоставщика, ДатаПоДаннымПоставщика, ИмяДокумента)
	
	//+Макрушин Е. 26.02.2026 #UT10-5657
	Запрос = Новый Запрос();
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КорректировкаПоступления.Ссылка
	|ИЗ
	|	Документ." + ИмяДокумента + " КАК КорректировкаПоступления " + "
	|ГДЕ
	|	КорректировкаПоступления.ПометкаУдаления = ЛОЖЬ
	|	И КорректировкаПоступления.НомерВходящегоДокумента = &НомерПоДаннымПоставщика
	|	И НачалоПериода(КорректировкаПоступления.ДатаВходящегоДокумента, День) = &ДатаПоДаннымПоставщика";
	
	Запрос.Параметры.Вставить("НомерПоДаннымПоставщика", НомерПоДаннымПоставщика);
	Запрос.Параметры.Вставить("ДатаПоДаннымПоставщика", НачалоДня(ДатаПоДаннымПоставщика));
	
	Выборка = Запрос.Выполнить().Выбрать();	
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка; 
	Иначе
		Возврат Документы[ИмяДокумента].ПустаяСсылка(); 	
	КонецЕсли;	
