			СпрОбъект.БанкДляРасчетов = Справочники.Банки.НайтиПоКоду(ФабрикаСправочника.БИКБанкаДляРасчетов);
		Иначе
			ЗаполнитьСвойствоПоПоискуКодаМДМ("Банки", СпрОбъект, "БанкДляРасчетов", ФабрикаСправочника.БанкДляРасчетов, ФабрикаСправочника);
		КонецЕсли;
		
		ЗаполнитьСвойствоПоПоискуКодаМДМ("Контрагенты", СпрОбъект, "Владелец", ФабрикаСправочника.Владелец, ФабрикаСправочника);
		
		СпрОбъект.ТекстКорреспондента = ФабрикаСправочника.ТекстКорреспондента;
