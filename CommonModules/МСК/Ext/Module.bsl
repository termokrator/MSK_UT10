	|	ВТ_ТоварыНоменклатура.Цена,
	|	ВТ_ТоварыНоменклатура.Сумма,
	|	ВТ_ТоварыНоменклатура.СуммаСНДС,
	|	ВТ_ТоварыНоменклатура.СуммаНДС,
	|	ВТ_ТоварыНоменклатура.КодСтрокиКМ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТоварыНоменклатураГТД.КодСтрокиКМ,
	|	ВТ_ТоварыНоменклатураГТД.Номенклатура КАК Номенклатура,
	|	ВТ_ТоварыНоменклатураГТД.НоменклатураКодМДМ,
	|	ВТ_ТоварыНоменклатураГТД.НомерГТД КАК НомерГТД,
	|	ВТ_ТоварыНоменклатураГТД.НомерГТДСсылка КАК НомерГТДСсылка,
	|	ВТ_ТоварыНоменклатураГТД.Цена,
	|	ВТ_ТоварыНоменклатураГТД.Количество,
	|	ВТ_ТоварыНоменклатураГТД.Сумма,
	|	ВТ_ТоварыНоменклатураГТД.СуммаСНДС,
	|	ВТ_ТоварыНоменклатураГТД.СуммаНДС,
	|	ВТ_ТоварыНоменклатураГТД.СтранаНаименование,
	|	ВТ_ТоварыНоменклатураГТД.КодСтраны,
	|	МАКСИМУМ(ЕСТЬNULL(КлассификаторСтранМираПоКоду.Ссылка, ЕСТЬNULL(КлассификаторСтранМираПоНаименованию.Ссылка, ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.Россия)))) КАК Страна
	|ПОМЕСТИТЬ ВТ_ТоварыБезСерий
	|ИЗ
