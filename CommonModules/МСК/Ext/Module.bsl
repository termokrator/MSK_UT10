/////////////////Процедуры загрузки сообщений//////////////////
Процедура ОбработатьСообщениеИзОчереди(ИмяОчереди, ТекстСообщения, Отказ, КоличествоПопытокОбработки = 0) Экспорт
	
	Если Не ЗначениеЗаполнено(ИмяОчереди) Тогда
		
		Отказ = Истина;
		Возврат;
		
	КонецЕсли; 

	ЭтоСообщениеJSON = Найти(ТекстСообщения,"/json");    
	
	Если ЭтоСообщениеJSON Тогда
		
		СтрВидДокумента = Найти(ТекстСообщения, "ВидДокумента");
		
		Если СтрВидДокумента > 0 Тогда
			
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(ТекстСообщения);
			СообщениеJSON = ПрочитатьJSON(ЧтениеJSON);
			
			Если ТипЗнч(СообщениеJSON) = Тип("Массив") тогда
				
				СтруктураДокумента = СообщениеJSON[0];		
				ВидДокумента = СтруктураДокумента.ВидДокумента;
				ЗагрузитьДокументПоФабрике(СообщениеJSON, СтруктураДокумента, ВидДокумента, ИмяОчереди, Отказ);
				
			Иначе
				
				ВидДокумента = СообщениеJSON.ВидДокумента;
				ЗагрузитьДокументИзСтруктурыПоФабрике(СообщениеJSON, ВидДокумента, ИмяОчереди, Отказ, КоличествоПопытокОбработки);
				
			КонецЕсли;
			
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	КодПрикладнойСистемы = ИмяОчереди;	
	Чтение = Новый ЧтениеXML;	
	Пар = Новый ПараметрыЧтенияXML(,,,,,,,,, Истина, Истина);	
	Чтение.УстановитьСтроку(ТекстСообщения, Пар);	
	Фабрика = ФабрикаXDTO.ПрочитатьXML(Чтение);		
	
	Если Фабрика.Свойства().Количество() > 0 Тогда
		
		ТипИмени = Фабрика.Свойства()[0].Имя;
		ИмяОбъектаМетаданныхИсточник = Сред(ТипИмени, Найти(ТипИмени, "_") + 1);
		
		Если ИмяОбъектаМетаданныхИсточник = "ЭквайринговыеТерминалы" Тогда
			ИмяОбъектаМетаданных = "ДоговорыЭквайринга";
		ИначеЕсли ИмяОбъектаМетаданныхИсточник = "ВидОплатыЧекаККМ" Тогда
			ИмяОбъектаМетаданных = "ВидыОплатЧекаККМ"
		ИначеЕсли ИмяОбъектаМетаданныхИсточник = "Филиалы" Тогда 
			ИмяОбъектаМетаданных = "Контрагенты";
		ИначеЕсли ИмяОбъектаМетаданныхИсточник = "СхемыРаботы" Тогда 
			ИмяОбъектаМетаданных = "ТипыЦенНоменклатуры";
		ИначеЕсли ИмяОбъектаМетаданныхИсточник = "ФорматОтправки" Тогда 
			ИмяОбъектаМетаданных = "ФорматыОтправки";
		ИначеЕсли ИмяОбъектаМетаданныхИсточник = "ОтправлятьФорматСтруктурыСчетФактуры" Тогда 
			ИмяОбъектаМетаданных = "ФорматыСтруктуры";   
		ИначеЕсли ИмяОбъектаМетаданныхИсточник = "ВидыДеятельностиПоКлассификацииПроизводителя" Тогда 
			ИмяОбъектаМетаданных = "ПрофильПроизводителя";   
		ИначеЕсли ИмяОбъектаМетаданныхИсточник = "КлассификаторДеталейАвтомобилей" Тогда 
			ИмяОбъектаМетаданных = "НоменклатурныеГруппы";   
		ИначеЕсли ИмяОбъектаМетаданныхИсточник = "УпаковкиЕдиницыИзмерения" Тогда 
			ИмяОбъектаМетаданных = "ЕдиницыИзмерения";   
		ИначеЕсли ИмяОбъектаМетаданныхИсточник = "ШтрихКодыНоменклатуры" Тогда 
			ИмяОбъектаМетаданных = "Штрихкоды";   
		ИначеЕсли ИмяОбъектаМетаданныхИсточник = "БанковскиеСчетаКонтрагентов" Тогда 
			ИмяОбъектаМетаданных = "БанковскиеСчета"; 
		ИначеЕсли ИмяОбъектаМетаданныхИсточник = "КлассификаторБанковРФ" Тогда 
			ИмяОбъектаМетаданных = "Банки"; 
		ИначеЕсли ИмяОбъектаМетаданныхИсточник = "СторонниеСклады" Тогда
			
			Если НЕ Булево(Фабрика[ТипИмени].СтороннийСклад) Тогда
				ИмяОбъектаМетаданных = "Склады";
			Иначе
				ИмяОбъектаМетаданных = ИмяОбъектаМетаданныхИсточник;
			КонецЕсли;

		ИначеЕсли ИмяОбъектаМетаданныхИсточник = "СтраныМира" Тогда 
			ИмяОбъектаМетаданных = "КлассификаторСтранМира";
		ИначеЕсли ИмяОбъектаМетаданныхИсточник = "ГруппыРассылок" Тогда 
			ИмяОбъектаМетаданных = "КатегорииОбъектов";
		ИначеЕсли ИмяОбъектаМетаданныхИсточник = "ТоварныеГруппыЧестногоЗнака" Тогда 
			ИмяОбъектаМетаданных = "ТоварныеГруппыЧЗ";
		ИначеЕсли ИмяОбъектаМетаданныхИсточник = "КлассификаторОКПД2" Тогда 
			ИмяОбъектаМетаданных = "КодыОКПД2";
		Иначе
			ИмяОбъектаМетаданных = ИмяОбъектаМетаданныхИсточник;
		КонецЕсли;
		
		СправочникЗагрузки = Справочники.AMQP_СправочникиЗагрузки.НайтиПоРеквизиту("ИмяСправочника", ИмяОбъектаМетаданных);
		
		Если Не ЗначениеЗаполнено(СправочникЗагрузки) ИЛИ НЕ СправочникЗагрузки.Загружать Тогда
			
			ЗаписьЖурналаРегистрации("ПолучениеСообщений.Прием", УровеньЖурналаРегистрации.Информация,,, "Справочник " 
			+ ИмяОбъектаМетаданных + " не настроен для загрузки в справочнике СправочникиЗагрузки. Сообщение отклонено.");
			Отказ = Истина;
			Возврат;
			
		КонецЕсли;
		
		ФабрикаИмени = Фабрика[ТипИмени];
		
		Если ИмяОбъектаМетаданныхИсточник = "Филиалы" Тогда
			
			МассивСтрок = СформироватьМассивПоСвойству(ФабрикаИмени, "ФилиалКонтрагент", "Строка");
			
			Если МассивСтрок.Количество() > 0 Тогда 				
				
				БылиОшибки = Ложь;
				
				Для Каждого Стр Из МассивСтрок Цикл
					
					ГУИДГоловногоКонтрагента = Стр.КонтрагентФилиала.GUID; 
					
					ГоловнойСсылка = Справочники.Контрагенты.НайтиПоРеквизиту("КодМДМ", ГУИДГоловногоКонтрагента);
					
					Если ГоловнойСсылка = Справочники.Контрагенты.ПустаяСсылка() Тогда   						
						
						БылиОшибки = Истина;
						Продолжить;   					
						
					КонецЕсли;
					
					СпрОбъект = ПолучитьОбъектПоФабрике(ФабрикаИмени, ИмяОбъектаМетаданных, КодПрикладнойСистемы, Ложь);

					Если СпрОбъект = Неопределено ИЛИ СпрОбъект.Ссылка.Пустая() Тогда
						
						Если СокрЛП(Стр.КодАвардаФилиала) = "ОбъектXDTO" ИЛИ НЕ ЗначениеЗаполнено(СокрЛП(Стр.КодАвардаФилиала)) Тогда 						
							СпрОбъект = ПолучитьОбъектПоФабрике(ФабрикаИмени, ИмяОбъектаМетаданных, КодПрикладнойСистемы, Истина);
						Иначе
							
							СпрОбъект = ПолучитьКонтрагентаПоКодуАварды(Стр.КодАвардаФилиала);
							СпрОбъект.IDФилиала = Стр.КодАвардаФилиала;						
							
						КонецЕсли;
						
					Иначе
						
						Если НЕ СокрЛП(Стр.КодАвардаФилиала) = "ОбъектXDTO" И  ЗначениеЗаполнено(СокрЛП(Стр.КодАвардаФилиала)) Тогда 													
							СпрОбъект.IDФилиала = Стр.КодАвардаФилиала;						
						КонецЕсли;  						
						
					КонецЕсли;
					
					СпрОбъект.ГоловнойКонтрагент = ГоловнойСсылка;
					ЗаполнитьОбъектЗагрузки(СпрОбъект, ФабрикаИмени, ИмяОбъектаМетаданныхИсточник, ИмяОбъектаМетаданных, ИмяОчереди, СправочникЗагрузки);					

					Если ЗначениеЗаполнено(СпрОбъект.ГоловнойКонтрагент) И ЗначениеЗаполнено(СпрОбъект.МенеджерМСК) Тогда
						
						ГоловнойОбъект = ГоловнойСсылка.ПолучитьОбъект();
						ГоловнойОбъект.МенеджерМСК = СпрОбъект.МенеджерМСК;
						ГоловнойОбъект.ОбменДанными.Загрузка = Истина; 
						ГоловнойОбъект.Записать();
						
					КонецЕсли;					

					Если ЗначениеЗаполнено(СпрОбъект.ГоловнойКонтрагент) И СпрОбъект.ЦентрФинансовойОтветственности И СпрОбъект.МенеджерыПокупателя.Количество() > 0 Тогда
						
						ЕстьТПВГоловном = СпрОбъект.ГоловнойКонтрагент.МенеджерыПокупателя.Найти(СпрОбъект.МенеджерыПокупателя[0].МенеджерПокупателя);
						
						Если ЕстьТПВГоловном = Неопределено Тогда
							
							ОбъектГоловнойКонтрагент = СпрОбъект.ГоловнойКонтрагент.ПолучитьОбъект();
							ОбъектГоловнойКонтрагент.МенеджерыПокупателя.Очистить();
							НовыйМенеджер = ОбъектГоловнойКонтрагент.МенеджерыПокупателя.Добавить();
							ЗаполнитьЗначенияСвойств(НовыйМенеджер,СпрОбъект.МенеджерыПокупателя[0]);
							ОбъектГоловнойКонтрагент.ОсновнойМенеджерПокупателя = СпрОбъект.МенеджерыПокупателя[0].МенеджерПокупателя;
							ОбъектГоловнойКонтрагент.ОбменДанными.Загрузка = Истина;
							ОбъектГоловнойКонтрагент.Записать();
							
						КонецЕсли;
						
					КонецЕсли;

				КонецЦикла; 				
				
				Если БылиОшибки Тогда 					
					ВызватьИсключение "Не найден головной контрагент для филиала: " + ФабрикаИмени.Наименование;					
				КонецЕсли;
				
			Иначе
				
				ВызватьИсключение "Не найден головной контрагент для филиала: " + ФабрикаИмени.Наименование;
				
			КонецЕсли;
			
		Иначе			

			СправочникЗагрузики = Справочники.AMQP_СправочникиЗагрузки.НайтиПоРеквизиту("ИмяСправочника", ИмяОбъектаМетаданных);			
			
			Если СправочникЗагрузики <> Неопределено И СправочникЗагрузики.ТипДанных = "Справочники"  Тогда
				
				Если ИмяОбъектаМетаданных = "ДоговорыКонтрагентов"  Тогда
					
					ПромОрганизация = Справочники.Организации.НайтиПоРеквизиту("КодМДМГоловнойОрганизации", СокрЛП(ФабрикаИмени.Организация.GUID));
					
					Если НЕ ЗначениеЗаполнено(ПромОрганизация) Тогда
						ВызватьИсключение "Не найдена организация для договора: " + ФабрикаИмени.Наименование+ " контрагента  "
						+ СокрЛП(Справочники.Контрагенты.НайтиПоРеквизиту("КодМДМ", СокрЛП(ФабрикаИмени.Владелец.GUID)).Наименование);
					КонецЕсли;	  
					
				ИначеЕсли  ИмяОбъектаМетаданных = "ПоставщикиТОХ" Тогда
					
					ПромОрганизация = Справочники.Организации.НайтиПоРеквизиту("КодМДМГоловнойОрганизации", СокрЛП(ФабрикаИмени.Организация.GUID));
					
					Если НЕ ЗначениеЗаполнено(ПромОрганизация) Тогда
						ВызватьИсключение "Поставщик ТОХ не принадлежит организации с кодом : " + СокрЛП(ФабрикаИмени.Организация.GUID);
					КонецЕсли;

				КонецЕсли;

				СпрОбъект = ПолучитьОбъектПоФабрике(ФабрикаИмени, ИмяОбъектаМетаданных, КодПрикладнойСистемы);   			
				ЗаполнитьОбъектЗагрузки(СпрОбъект, ФабрикаИмени, ИмяОбъектаМетаданныхИсточник, ИмяОбъектаМетаданных, ИмяОчереди, СправочникЗагрузки);
				
			ИначеЕсли СправочникЗагрузики <> Неопределено И СправочникЗагрузики.ТипДанных = "СправочникиМДМ" Тогда 	
				
				Если СправочникЗагрузки.ИмяСправочника = "Производители" Тогда     
					
					ЗаменяющийСправочник = "Номенклатура";
					ЭтоГруппа = Истина;      
					СпрОбъект = ПолучитьОбъектПоФабрике(ФабрикаИмени, ИмяОбъектаМетаданных, КодПрикладнойСистемы, , , ЭтоГруппа , ЗаменяющийСправочник );   			
					ЗаполнитьОбъектЗагрузки(СпрОбъект, ФабрикаИмени, ИмяОбъектаМетаданныхИсточник, ИмяОбъектаМетаданных, ИмяОчереди, СправочникЗагрузки, ЗаменяющийСправочник);	
					
				КонецЕсли; 
				
			ИначеЕсли СправочникЗагрузики <> Неопределено И СправочникЗагрузики.ТипДанных = "РегистрыСведений" Тогда 				

				РСЗапись = Неопределено;
				РСЗаписи = ПолучитьРегистрСведенийПоФабрике(РСЗапись, ФабрикаИмени, ИмяОбъектаМетаданных, КодПрикладнойСистемы);
				ЗаполнитьОбъектРегистраСведений(РСЗаписи, РСЗапись, ФабрикаИмени, ИмяОбъектаМетаданныхИсточник, ИмяОбъектаМетаданных, ИмяОчереди, СправочникЗагрузки );
				
			КонецЕсли; 
			
		КонецЕсли; 		
		
	КонецЕсли; 
	
КонецПроцедуры

Процедура ОбработатьСообщениеJSON(Сообщение, Отказ) Экспорт
	
	ИмяОчереди = Сообщение.Подписка.ИмяОчереди;     
	ТекстСообщения = Сообщение.Данные;
	
	Если Не ЗначениеЗаполнено(ИмяОчереди) Тогда
		
		Отказ = Истина;      
		ЗаписьЖурналаРегистрации("ОбработатьСообщениеJSON", УровеньЖурналаРегистрации.Информация,, Сообщение, "Не заполнено имя очереди в подписке " + Сообщение.Подписка);
		Возврат;
		
	КонецЕсли; 
	
	ВидДокумента = Справочники.Р_ВходящиеСообщения.ПолучитьВидДокументаИзПараметров(Сообщение);  
	
	Если Найти(ВРЕГ(ТекстСообщения), "ID_EDI") > 0 Тогда
		
		ОбработатьСообщениеИзЭДО(Сообщение, ВидДокумента, Отказ);  
		Возврат;

	ИначеЕсли Маркировка.ЭтоОчередьПоМаркировке(ИмяОчереди)	Тогда
		
		Если ВидДокумента = "ПоступлениеТоваровУслуг" 			
			//+Макрушин Е. 27.02.2026 #UT10-5657
			ИЛИ ВидДокумента = "КорректировкаПоступления" Тогда
			//-Макрушин Е. 27.02.2026 #UT10-5657
			
			
			ОбработатьСообщениеИзЭДО(Сообщение, ВидДокумента, Отказ);
			Возврат;
		
		КонецЕсли;

		Маркировка.ОбработатьСообщениеПоМаркировке(Сообщение.Данные,Отказ,Сообщение.Подписка,Сообщение.Параметры,Сообщение);
		Возврат;
		
	ИначеЕсли МСК.ЭтоОчередьПрайсПМ(ИмяОчереди) Тогда
		ВидДокумента = "УстановкаЦенНоменклатурыКонтрагентов";  
		
	ИначеЕсли МСК.ЭтоОчередьПрайсПМ(ИмяОчереди) Тогда
		ВидДокумента = "УстановкаЦенНоменклатурыКонтрагентов"; 
		//+Белов А. 14.09.2026 #UT10-6038
	ИначеЕсли МСК.ЭтоОчередьУТ10ВУТ10(ИмяОчереди) Тогда
		//-Белов А. 14.09.2026 #UT10-6038	
	Иначе	
		
		Если Найти(ТекстСообщения, "/json") = 0 Тогда
			
			Отказ = Истина;      
			ЗаписьЖурналаРегистрации("ОбработатьСообщениеJSON", УровеньЖурналаРегистрации.Информация,, Сообщение, "Текст сообщения не содержит подстроку '/json'");
			Возврат;   
			
		КонецЕсли;
		
		СтрВидДокумента = Найти(ТекстСообщения, "ВидДокумента");    
		
		Если СтрВидДокумента = 0 Тогда
			
			Отказ = Истина;      
			ЗаписьЖурналаРегистрации("ОбработатьСообщениеJSON", УровеньЖурналаРегистрации.Информация,, Сообщение, "Не определен вид документа");
			Возврат;   
			
		КонецЕсли; 
	
	КонецЕсли;
	
	Попытка
		
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТекстСообщения);
		СообщениеJSON = ПрочитатьJSON(ЧтениеJSON);
		
		Если ТипЗнч(СообщениеJSON) = Тип("Массив") тогда
			
			СтруктураДокумента = СообщениеJSON[0];	
			
			Если СтруктураДокумента.Свойство("ВидДокумента") Тогда
				ВидДокумента = СтруктураДокумента.ВидДокумента;
			КонецЕсли;
			
			ЗагрузитьДокументПоФабрике(СообщениеJSON, СтруктураДокумента, ВидДокумента, ИмяОчереди, Отказ);
			
		Иначе
			
			Если СообщениеJSON.Свойство("ВидДокумента") Тогда
				ВидДокумента = СообщениеJSON.ВидДокумента;
			КонецЕсли;
			
			//+Шульман А. 02.07.2026 #UT10-5944
			СообщениеJSON.Вставить("КодСообщения", Сообщение.Код);  
			//-Шульман А. 02.07.2026 #UT10-5944
			ЗагрузитьДокументИзСтруктурыПоФабрике(СообщениеJSON, ВидДокумента, ИмяОчереди, Отказ, Сообщение.КоличествоПопытокПовторнойОбработки);  
			
		КонецЕсли;
		
		Справочники.Р_ВходящиеСообщения.ПометитьВходящееОбработанным(Сообщение);   
		
	Исключение
		
		ТекстОшибки = "Не удалось загрузить сообщение в " + ВидДокумента + ". " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()); 
		Справочники.Р_ВходящиеСообщения.ЗаписатьОшибкуПоВходящемуСообщению(Сообщение, ТекстОшибки);		
		
	КонецПопытки;
	
КонецПроцедуры       

Процедура ОбработатьСообщениеИзЭДО(Сообщение, ВидДокумента, Отказ) Экспорт   
	
	ТекстСообщения = Сообщение.Данные;    
	
	Если ВидДокумента = "" Тогда
	
		Отказ = Истина;      
		ТекстОшибки = "Не удалось определить вид документа"; 
		Справочники.Р_ВходящиеСообщения.ЗаписатьОшибкуПоВходящемуСообщению(Сообщение, ТекстОшибки);	
		Возврат;
		
	КонецЕсли;    
	
	ТекстОшибки = "";
	
	Попытка
		
		Если ВидДокумента = "ПоступлениеТоваровУслуг" Тогда
			
			//+Шульман А. 26.03.2026 #UT10-5785 
			//ЗагрузитьПоступлениеТоваровУслугИзЭДО(ТекстСообщения, ТекстОшибки, Отказ);  
			ДокПТУ = ЗагрузитьПоступлениеТоваровУслугИзЭДО(ТекстСообщения, ТекстОшибки, Отказ, Сообщение);  
			//-Шульман А. 26.03.2026 #UT10-5785
			
			//+Шульман А. 25.02.2026 #UT10-5713       
			//Справочники.Р_ВходящиеСообщения.ПометитьВходящееОбработанным(Сообщение);   
			
			Если ПустаяСтрока(ТекстОшибки) Тогда
				Справочники.Р_ВходящиеСообщения.ПометитьВходящееОбработанным(Сообщение);
				
				//+Сёмин Р.И. 09.06.2026 #UT10-5900
			ИначеЕсли ЗначениеЗаполнено(Найти(ТекстОшибки, "#Пропустить_Сообщение#")) Тогда
				
				ТекстОшибки = СтрЗаменить(ТекстОшибки, "#Пропустить_Сообщение#", "");
				Справочники.Р_ВходящиеСообщения.ЗаписатьОшибкуБезУстановкиПометок(Сообщение, ТекстОшибки);
				//-Сёмин Р.И. 09.06.2026 #UT10-5900
				
			Иначе		
				Справочники.Р_ВходящиеСообщения.ЗаписатьОшибкуПоВходящемуСообщению(Сообщение, ТекстОшибки);		
			КонецЕсли;     
			//-Шульман А. 25.02.2026 #UT10-5713

		//+Макрушин Е. 26.02.2026 #UT10-5657
		ИначеЕсли ВидДокумента = "КорректировкаПоступления" Тогда
				
			ЗагрузитьКорректировкуПоступленияИзЭДО(ТекстСообщения, ТекстОшибки, Отказ);   
			
			Если ПустаяСтрока(ТекстОшибки) Тогда
				Справочники.Р_ВходящиеСообщения.ПометитьВходящееОбработанным(Сообщение);   
			Иначе		
				Справочники.Р_ВходящиеСообщения.ЗаписатьОшибкуПоВходящемуСообщению(Сообщение, ТекстОшибки);		
			КонецЕсли;     

		//-Макрушин Е. 26.02.2026 #UT10-5657
		КонецЕсли;
		
	Исключение
		
		Если ПустаяСтрока(ТекстОшибки) Тогда
			ТекстОшибки = "Не удалось загрузить сообщение в " + ВидДокумента + ". " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()); 
		КонецЕсли;    
		
		Справочники.Р_ВходящиеСообщения.ЗаписатьОшибкуПоВходящемуСообщению(Сообщение, ТекстОшибки);		
		
	КонецПопытки;        
		
	//+Шульман А. 26.03.2026 #UT10-5785
	Если ВидДокумента = "ПоступлениеТоваровУслуг" И ЗначениеЗаполнено(ДокПТУ) Тогда  //+Белов А. 18.05.2026 #UT10-5856 - добавил проверку на заполненность ДокПТУ    
		AMQP_РаботаСДокументами.СоздатьИсходящееСообщениеПоИтогамЗагрузкиПТУ(Сообщение, ДокПТУ, ТекстОшибки);
	КонецЕсли;        
	//-Шульман А. 26.03.2026 #UT10-5785
	
КонецПроцедуры	

Процедура ЗагрузитьСообщениеИзУТ10(Сообщение, ВидДокумента, Отказ)
