				ДобСтрока.СерияНоменклатуры = СерияНоменклатуры;
				
				ТекЗаказПоставщику.КоличествоЗаказаноУПоставщика = ТекЗаказПоставщику.КоличествоЗаказаноУПоставщика - ДобСтрока.Количество;
				ТекКоличество = ТекКоличество - ДобСтрока.Количество; 
				
				//+Шульман А. 25.02.2026 #UT10-5713
				ТекСумма    = ТекСумма - ДобСтрока.Сумма;    
				ТекСуммаНДС = ТекСуммаНДС - ДобСтрока.СуммаНДС;    
				//-Шульман А. 25.02.2026 #UT10-5713
				
			КонецЕсли;
				
		КонецЦикла;  
			
		// пришло товара больше чем заказывали
		Если ТекКоличество > 0 Тогда
			
			СтруктураСтроки = Новый Структура();
			СтруктураСтроки.Вставить("Документ", 					ДокПоступления);
			СтруктураСтроки.Вставить("Номенклатура", 				Номенклатура);
			СтруктураСтроки.Вставить("ТекСтрока", 					Неопределено);
			СтруктураСтроки.Вставить("ТекКоличество", 			    ТекКоличество);
			СтруктураСтроки.Вставить("БратьУказанноеКоличество", 	Истина);
			СтруктураСтроки.Вставить("Цена", 					    тзСтрока.Цена);
			СтруктураСтроки.Вставить("ЗаказПоставщикуУказан", 		Ложь);
			СтруктураСтроки.Вставить("ЗаказПокупателяУказан", 	    Ложь);
			СтруктураСтроки.Вставить("ЗаказПоставщику", 			Неопределено);
			СтруктураСтроки.Вставить("ВидЗагрузки", ВидЗагрузки);
			
			ДобСтрока = ДокПоступления.Товары.Добавить();      
			ЗаполнитьЗначенияСвойств(ДобСтрока, тзСтрока);
			ДобСтрока.СтавкаНДС = СтавкаНДС;     
			
			ЗаполнитьСтрокуПТУ(ДобСтрока, СтруктураСтроки);
			
			//+Шульман А. 25.02.2026 #UT10-5713
			ДобСтрока.Сумма = ТекСумма;
			ДобСтрока.СуммаНДС = ТекСуммаНДС;     
			//-Шульман А. 25.02.2026 #UT10-5713
			
			ДобСтрока.Склад = СкладОрдер;        
			ДобСтрока.СерияНоменклатуры = СерияНоменклатуры;
			
			ТекКоличество = ТекКоличество - ДобСтрока.Количество; 
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Таб.часть КодыМаркировки
	НайтиКодыМаркировки(тзКодыМаркировки, тзТоварыПТУ);   
	
	Для каждого тзСтрока Из тзКодыМаркировки Цикл
		
		ДобСтрока = ДокПоступления.КодыМаркировки.Добавить();      
		ДобСтрока.КодСтрокиКМ = тзСтрока.КодСтрокиКМ;
		
		//+Шульман А. 17.03.2026 #UT10-5748
		// Перенесено в процедуру НайтиКодыМаркировки()
		//Если Не ЗначениеЗаполнено(тзСтрока.ШтрихкодСсылка) Тогда    
		//	
		//	ДанныеКМ = Новый Структура("КодМаркировки, Номенклатура, СрокГодности, ДатаПроизводства");
		//	ЗаполнитьЗначенияСвойств(ДанныеКМ, тзСтрока);
		//	ДанныеКМ.Вставить("ТипУпаковки", Перечисления.ТипУпаковкиМаркировки.МаркированныйТовар);
		//	ДанныеКМ.Вставить("ТипПоступления", 2);
		//	
		//	ДобСтрока.КодМаркировки = Справочники.ШтрихкодыНоменклатуры.СоздатьКодМаркировки(ДанныеКМ);     
		//	
		//Иначе	
		//    ДобСтрока.КодМаркировки = тзСтрока.ШтрихкодСсылка;
		//КонецЕсли;        
		ДобСтрока.КодМаркировки = тзСтрока.ШтрихкодСсылка;     
		ДобСтрока.Невалиден = тзСтрока.Невалиден;    
		ДобСтрока.Причина = тзСтрока.Причина;
		//-Шульман А. 17.03.2026 #UT10-5748
		
	КонецЦикла;
	
	//+Сёмин Р.И. 22.06.2026 #UT10-5914
	Если НЕ ЭтоМежфилиальнаяПоставка Тогда
		
		УчитыватьКонстантуОстаточныйСрокГодности = НадоУчитыватьКонстантуОстаточныйСрокГодности(ДокПоступления);
		ЗаполнитьОстаточныеСрокиГодностиМаркировки(ДокПоступления.КодыМаркировки, ДокПоступления.ДатаВходящегоДокумента, ДокПоступления.ДоговорКонтрагента, ДокПоступления.Дата, УчитыватьКонстантуОстаточныйСрокГодности);
		
	КонецЕсли;
	//-Сёмин Р.И. 22.06.2026 #UT10-5914
	
	//+Шульман А. 05.06.2026 #UT10-5909
	Если СтруктураДокумента.Свойство("file_id") Тогда   
		
		АдресИсходнаяТЗНоменклатуры = ПоместитьВоВременноеХранилище(тзТоварыПТУ);
		ДокПоступления.ДополнительныеСвойства.Вставить("АдресИсходнаяТЗНоменклатуры", АдресИсходнаяТЗНоменклатуры); 
		
	КонецЕсли;     
	//-Шульман А. 05.06.2026 #UT10-5909
	
	Попытка
		ДокПоступления.Записать(РежимЗаписиДокумента.Запись); 
	Исключение    
		
		//+Шульман А. 04.03.2026 #UT10-5735
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()); 
		Возврат Неопределено;
		//-Шульман А. 04.03.2026 #UT10-5735
		
	КонецПопытки; 
	
	//+Белов А. 14.04.2026 #UT10-5816
	Если ЭтоМагистраль Тогда
		
		Если ТабЗаказовПоставщику.Количество() Тогда  
			
			КопияТабЗаказовПоставщику = ТабЗаказовПоставщику.Скопировать();
			КопияТабЗаказовПоставщику.Свернуть("ЗаказПоставщику");
			МассивЗаказовПоставщику = КопияТабЗаказовПоставщику.ВыгрузитьКолонку("ЗаказПоставщику");
			
			Для каждого ДокЗаказ Из МассивЗаказовПоставщику Цикл
				
				Если Не ЗначениеЗаполнено(ДокЗаказ) Тогда
					Продолжить;
				КонецЕсли;
				
				ЗаказОбъект = ДокЗаказ.ПолучитьОбъект();
				ЗаказОбъект.ОбменДанными.Загрузка = Истина;
				ЗаказОбъект.ЗагруженоПоступление = Истина;
				
				Попытка
					ЗаказОбъект.Записать(РежимЗаписиДокумента.Запись);	
				Исключение
				    ЗаписьЖурналаРегистрации("Обработка сообщения", УровеньЖурналаРегистрации.Ошибка, ДокЗаказ.Метаданные(), ДокЗаказ, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				КонецПопытки;
				
				
			КонецЦикла;		
			
		КонецЕсли;
				
	КонецЕсли;
	//-Белов А. 14.04.2026 #UT10-5816
			
	Попытка
		
		//+Шульман А. 30.03.2026 #UT10-5789
		Если Не ДокПоступления.ДоговорКонтрагента.Пустая() Тогда
		//-Шульман А. 30.03.2026 #UT10-5789
			ДокПоступления.Записать(РежимЗаписиДокумента.Проведение);  
		КонецЕсли;
			
	Исключение                   
		
		//+Шульман А. 04.03.2026 #UT10-5735
		//ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()); 
		ЗаписьЖурналаРегистрации("Обработка сообщения", УровеньЖурналаРегистрации.Ошибка, ДокПоступления.Метаданные(), 
		ДокПоступления.Ссылка, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		//-Шульман А. 04.03.2026 #UT10-5735
		
	КонецПопытки;
	
	//+Шульман А. 26.03.2026 #UT10-5785
	Возврат ДокПоступления.Ссылка; 
	//-Шульман А. 26.03.2026 #UT10-5785
	
КонецФункции

Процедура ЗагрузитьКорректировкуПоступленияИзЭДО(ТекстСообщения, ТекстОшибки, Отказ)
	
	//+Макрушин Е. 26.02.2026 #UT10-5657
	//переложил аналогичный код УТ11
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТекстСообщения);
	СтруктураДокумента = ПрочитатьJSON(ЧтениеJSON); 
	
	СкладКодМДМ = СтруктураДокумента.warehouse_mdm_id;
	КонтрагентКодМДМ = СтруктураДокумента.supplier_mdm_id;
	КонтрагентИНН = "";	
	КонтрагентКПП = "";
	НомерПоДаннымПоставщика = СокрЛП(СтруктураДокумента.number);
	ДатаПоДаннымПоставщика  = ПреобразоватьДатуМДМ(СтруктураДокумента.date);    
	НомерПоДаннымПоставщикаПТУ = СокрЛП(СтруктураДокумента.utd_number);
	ДатаПоДаннымПоставщикаПТУ  = ПреобразоватьДатуМДМ(СтруктураДокумента.utd_date);
	
	СуммаНДС          = СтруктураДокумента.total.totalAmountOfTax;
	СуммаВсегоСНДС    = СтруктураДокумента.total.totalAmount;
	ОрганизацияКодМДМ = СтруктураДокумента.organization_mdm_id;

	СуществующийКПТУ  = СуществуетДокументПоДаннымВходящегоДокумента(НомерПоДаннымПоставщика, ДатаПоДаннымПоставщика, "КорректировкаПоступления"); 
	
	Если ЗначениеЗаполнено(СуществующийКПТУ) Тогда
		
		СтрокаОшибка = "Уже существует Корректировка поступления с Номер вх. документа = " + НомерПоДаннымПоставщика + " и Дата вх. документа = " + ДатаПоДаннымПоставщика;   
		ЗаписьЖурналаРегистрации("UT10.documents.Mark", УровеньЖурналаРегистрации.Ошибка,,, СтрокаОшибка);
		ВызватьИсключение СтрокаОшибка;
		
	КонецЕсли;
	
	ДокументОснование  = СуществуетДокументПоДаннымВходящегоДокумента(НомерПоДаннымПоставщикаПТУ, ДатаПоДаннымПоставщикаПТУ, "ПоступлениеТоваровУслуг"); 
	
	Если НЕ ЗначениеЗаполнено(ДокументОснование) Тогда
		
		СтрокаОшибка = "Не найден ПТУ с Номер вх. документа = " + НомерПоДаннымПоставщикаПТУ + " и Дата вх. документа = " + ДатаПоДаннымПоставщикаПТУ;   
		ЗаписьЖурналаРегистрации("UT10.documents.Mark", УровеньЖурналаРегистрации.Ошибка,,, СтрокаОшибка);
		ВызватьИсключение СтрокаОшибка;
		
	КонецЕсли;
	
	СтрокаОшибка = "";

	Для Каждого СтрокаДетайл ИЗ СтруктураДокумента.Detail Цикл        
		
		Номенклатура = Справочники.Номенклатура.НайтиПоРеквизиту("КодМДМ", СтрокаДетайл.Product_mdm_id);    
		
		Если Номенклатура.Пустая() Тогда
		
			СтрокаОшибка = СтрокаОшибка + "Не найдена номенклатура с кодом МДМ " + СтрокаДетайл.Product_mdm_id + Символы.ПС;     
			Продолжить;
		
		КонецЕсли;         
		
		СтрокаДетайл.Вставить("Номенклатура", Номенклатура);
		
		мКодыМаркировки = Новый Массив;
		
		Для Каждого СтрокаКодес ИЗ СтрокаДетайл.codes Цикл    
			
			ПолученныйКМ = СокрЛП(СтрокаКодес.km);
			
			Если НЕ ЗначениеЗаполнено(ПолученныйКМ) Тогда
				Продолжить;
			КонецЕсли;
			
			НайденныйШК = Справочники.ШтрихкодыНоменклатуры.НайтиШтрихкод(ПолученныйКМ, Номенклатура);
			
			Если НЕ ЗначениеЗаполнено(НайденныйШК) Тогда
				
				СтрокаОшибка = СтрокаОшибка + "Не найден код маркировки " + ПолученныйКМ + " по номенклатуре " + Номенклатура + Символы.ПС;     
				Продолжить;
				
			КонецЕсли;
			
			СтрокаКодес.Вставить("КодМаркировки", НайденныйШК);
			
		КонецЦикла;
		
	КонецЦикла;   
	
	Если ЗначениеЗаполнено(СтрокаОшибка) Тогда
		ВызватьИсключение СтрокаОшибка;
	КонецЕсли;
	
	
	ДокОбъект = Документы.КорректировкаПоступления.СоздатьДокумент();  
	ДокОбъект.Заполнить(ДокументОснование);
	ДокОбъект.Дата = ТекущаяДата();		
	ДокОбъект.НомерВходящегоДокумента = НомерПоДаннымПоставщика;
	ДокОбъект.ДатаВходящегоДокумента = ДатаПоДаннымПоставщика;
	ДокОбъект.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение;
	ДокОбъект.ВидПоступления = Перечисления.ВидыПоступленияТоваров.НаСклад;
	ДокОбъект.Комментарий = "Создан регламентным заданием загрузки из Раббит " + ДокОбъект.Дата;
	ДокОбъект.УстановитьНовыйНомер(ДокОбъект.Организация.Префикс);
	
	ИсходнаяТЧ = ДокОбъект.Товары.Выгрузить();
	ИсходнаяТЧ.Колонки.Добавить("ПересчитатьСуммуДоИзменения", Новый ОписаниеТипов("Булево"));
	ИсходнаяТЧ.Колонки.Добавить("ПересчитатьСумму", Новый ОписаниеТипов("Булево"));
	
	Для Каждого СтрокаДетайл ИЗ СтруктураДокумента.Detail Цикл        
		
		ИзменениеКоличества = СтрокаВЧисло(СтрокаДетайл.Qty);
		
		// тч РасхожденияКМ
		Для Каждого СтрокаКодес ИЗ СтрокаДетайл.codes Цикл    
			
			СтрокаРасхожденияКМ = ДокОбъект.РасхожденияКМ.Добавить();
			СтрокаРасхожденияКМ.Номенклатура = СтрокаДетайл.Номенклатура;
			СтрокаРасхожденияКМ.КодМаркировки = СтрокаКодес.КодМаркировки;
			
			Если ИзменениеКоличества < 0 Тогда
				СтрокаРасхожденияКМ.Недостача = Истина;
			ИначеЕсли ИзменениеКоличества > 0 Тогда
				СтрокаРасхожденияКМ.Излишек = Истина;
			КонецЕсли;
			
		КонецЦикла; 		
		
		// тч Товары
		// суммы для финальной проверки после распределения
		ИзменениеСуммаСНДС = СтрокаВЧисло(СтрокаДетайл.Total.Amount);
		ИзменениеСуммаНДС  = ИзменениеСуммаСНДС - СтрокаВЧисло(СтрокаДетайл.Total.AmountOfTax);
				
		тзДляПроверкиСуммДо = ИсходнаяТЧ.Скопировать(Новый Структура("Номенклатура", СтрокаДетайл.Номенклатура));		
		
		// распределение количества изменения 
		Если ИзменениеКоличества < 0 Тогда
			
			ИзменениеКоличества = -ИзменениеКоличества;
			ЭтоНедостача = Истина;
			
		Иначе
			ЭтоНедостача = Ложь;
		КонецЕсли;		
		
		мСтрокиПоНоменклатуре = ИсходнаяТЧ.НайтиСтроки(Новый Структура("Номенклатура", СтрокаДетайл.Номенклатура));
			
		Для Каждого СтрокаПоНоменклатуре Из мСтрокиПоНоменклатуре Цикл
			
			Если ИзменениеКоличества = 0 Тогда
				Прервать;
			КонецЕсли;
			
			Если ЭтоНедостача Тогда
				
				Если ИзменениеКоличества >= СтрокаПоНоменклатуре.Количество Тогда
					
					// строка полностью списывается
					ИзменениеКоличества = ИзменениеКоличества - СтрокаПоНоменклатуре.Количество;
					
					СтрокаПоНоменклатуре.Количество = 0;
					СтрокаПоНоменклатуре.ПересчитатьСумму = Истина;
					
					СтрокаПоНоменклатуре.Заказ = Неопределено;
					СтрокаПоНоменклатуре.ОтражатьТоварныйУчет = Истина;
					
				Иначе
					
					КоличествоКЗачету = ИзменениеКоличества;
					
					// выделяем пересечение по количеству
					ДопСтрока = ИсходнаяТЧ.Добавить();
					ЗаполнитьЗначенияСвойств(ДопСтрока, СтрокаПоНоменклатуре);
					
					ДопСтрока.КоличествоДоИзменения = КоличествоКЗачету;
					ДопСтрока.Количество = КоличествоКЗачету;
					ИзменениеКоличества = ИзменениеКоличества - КоличествоКЗачету;
					
					ДопСтрока.ПересчитатьСуммуДоИзменения = Истина;
					ДопСтрока.ПересчитатьСумму = Истина;
					
					
					// остаток - отдельной строкой отклонение
					СтрокаПоНоменклатуре.КоличествоДоИзменения = СтрокаПоНоменклатуре.КоличествоДоИзменения - КоличествоКЗачету;
					СтрокаПоНоменклатуре.Количество = 0;
					
					СтрокаПоНоменклатуре.ПересчитатьСуммуДоИзменения = Истина;
					СтрокаПоНоменклатуре.ПересчитатьСумму = Истина;
					
					СтрокаПоНоменклатуре.Заказ = Неопределено;
					СтрокаПоНоменклатуре.ОтражатьТоварныйУчет = Истина;
				КонецЕсли;
			
				
			
			Иначе
				
				// излишек, заполняем по первой подходящей строке
				ДопСтрока = ИсходнаяТЧ.Добавить();
				ЗаполнитьЗначенияСвойств(ДопСтрока, СтрокаПоНоменклатуре);
				
				ДопСтрока.КоличествоДоИзменения = 0;
                ДопСтрока.Количество = ИзменениеКоличества;
				
				ДопСтрока.ПересчитатьСуммуДоИзменения = Истина;
				ДопСтрока.ПересчитатьСумму = Истина;
				
				ДопСтрока.Заказ = Неопределено;
				ДопСтрока.ОтражатьТоварныйУчет = Истина;
				
				ИзменениеКоличества = 0;
				
				Прервать;
				
			КонецЕсли;

		КонецЦикла;
		
		Если ИзменениеКоличества <> 0 Тогда
			
			СтрокаОшибка = "Осталось нераспределенное изменение количества " + ИзменениеКоличества + " по номенклатуре " + СтрокаДетайл.Номенклатура;
			ВызватьИсключение СтрокаОшибка;
			
		КонецЕсли;

		
		// пересчет сумм
		Для Каждого СтрокаПоНоменклатуре Из ИсходнаяТЧ Цикл
			
			Если СтрокаПоНоменклатуре.ПересчитатьСуммуДоИзменения Тогда
				
				СтрокаПоНоменклатуре.ПересчитатьСуммуДоИзменения = Ложь;
				
				СтрокаПоНоменклатуре.СуммаДоИзменения = СтрокаПоНоменклатуре.Цена * СтрокаПоНоменклатуре.КоличествоДоИзменения;
				СтрокаПоНоменклатуре.СуммаНДСДоИзменения = УчетНДС.РассчитатьСуммуНДС(СтрокаПоНоменклатуре.СуммаДоИзменения,
			                                                   ДокОбъект.УчитыватьНДС, ДокОбъект.СуммаВключаетНДС,
			                                                   УчетНДС.ПолучитьСтавкуНДС(СтрокаПоНоменклатуре.СтавкаНДС));
															   
			КонецЕсли;
			
			Если СтрокаПоНоменклатуре.ПересчитатьСумму Тогда
				
				СтрокаПоНоменклатуре.ПересчитатьСумму = Ложь;
				
				СтрокаПоНоменклатуре.Сумма = СтрокаПоНоменклатуре.Цена * СтрокаПоНоменклатуре.Количество;											   
				СтрокаПоНоменклатуре.СуммаНДС = УчетНДС.РассчитатьСуммуНДС(СтрокаПоНоменклатуре.Сумма,
			                                                   ДокОбъект.УчитыватьНДС, ДокОбъект.СуммаВключаетНДС,
			                                                   УчетНДС.ПолучитьСтавкуНДС(СтрокаПоНоменклатуре.СтавкаНДС)); 
															   
			КонецЕсли;
														   
		КонецЦикла;											   
		
		// проверка расхождения по суммам
		тзДляПроверкиСуммПосле = ИсходнаяТЧ.Скопировать(Новый Структура("Номенклатура", СтрокаДетайл.Номенклатура));
		
		Если ИзменениеСуммаСНДС <> тзДляПроверкиСуммПосле.Итог("Сумма") - тзДляПроверкиСуммДо.Итог("Сумма") Тогда
			
			//СтрокаОшибка = "После распределения и пересчета по номенклатуре " + СтрокаДетайл.Номенклатура + " не сошлась Сумма расхождения." 
			//	+ " Получено по ЭДО значение = " + ИзменениеСуммаСНДС + " после пересчета получилась Сумма расхождения = " + тзДляПроверкиСуммПосле.Итог("Сумма") - тзДляПроверкиСуммДо.Итог("Сумма");
			//	
			//ВызватьИсключение СтрокаОшибка;
			
		КонецЕсли;
		
		Если ИзменениеСуммаНДС <> тзДляПроверкиСуммПосле.Итог("СуммаНДС") - тзДляПроверкиСуммДо.Итог("СуммаНДС") Тогда
			
			//СтрокаОшибка = "После распределения и пересчета по номенклатуре " + СтрокаДетайл.Номенклатура + " не сошлась СуммаНДС расхождения." 
			//	+ " Получено по ЭДО значение = " + ИзменениеСуммаНДС + " после пересчета получилась Сумма расхождения = " + тзДляПроверкиСуммПосле.Итог("СуммаНДС") - тзДляПроверкиСуммДо.Итог("СуммаНДС");
			//	
			//ВызватьИсключение СтрокаОшибка;
			
		КонецЕсли; 
		
		Если тзДляПроверкиСуммДо.Итог("СуммаДоИзменения") <> тзДляПроверкиСуммПосле.Итог("СуммаДоИзменения") Тогда
			
			//СтрокаОшибка = "После распределения и пересчета по номенклатуре " + СтрокаДетайл.Номенклатура + " не сошлась Сумма до изменения." 
			//	+ " Было: " + тзДляПроверкиСуммДо.Итог("СуммаДоИзменения") + " стало: " +  тзДляПроверкиСуммПосле.Итог("СуммаДоИзменения");
			//	
			//ВызватьИсключение СтрокаОшибка;
			
		КонецЕсли;
		
		Если тзДляПроверкиСуммДо.Итог("СуммаНДСДоИзменения") <> тзДляПроверкиСуммПосле.Итог("СуммаНДСДоИзменения") Тогда
			
			//СтрокаОшибка = "После распределения и пересчета по номенклатуре " + СтрокаДетайл.Номенклатура + " не сошлась СуммаНДС до изменения." 
			//	+ " Было: " + тзДляПроверкиСуммДо.Итог("СуммаНДСДоИзменения") + " стало: " +  тзДляПроверкиСуммПосле.Итог("СуммаНДСДоИзменения");
			//	
			//ВызватьИсключение СтрокаОшибка;
			
		КонецЕсли;

	КонецЦикла;   
	
    ДокОбъект.Товары.Очистить();
	ДокОбъект.Товары.Загрузить(ИсходнаяТЧ);
	
	Попытка
		
		НачатьТранзакцию();
		
		ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		
		// отметим категорию
		РезультатУстановкиДокументПолучен = Справочники.КатегорииОбъектов.УстановитьКатегориюОбъекта(ДокОбъект.Ссылка, "ДокументПолучен");
		
		Если НЕ РезультатУстановкиДокументПолучен.ВыполненоУспешно Тогда
			
			СтрокаОшибка = "Ошибка при установке категории " + РезультатУстановкиДокументПолучен.ОписаниеОшибки;     
			ВызватьИсключение СтрокаОшибка;
			
		КонецЕсли;
		
		// собственно проведение корректировки
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);      
		
		// сф по корректировке
		ДокОбъектСФ = Документы.СчетФактураПолученный.СоздатьДокумент();
		ДокОбъект.Дата = ДокОбъект.Дата;
		ДокОбъектСФ.ДополнительныеСвойства.Вставить("НеЗаполнятьСчетФактуруНаАванс");
		ДокОбъектСФ.Заполнить(ДокОбъект.Ссылка);
		ДокОбъектСФ.НомерВходящегоДокумента = ДокОбъект.НомерВходящегоДокумента;
		ДокОбъектСФ.ДатаВходящегоДокумента = ДокОбъект.ДатаВходящегоДокумента;
		ДокОбъектСФ.УстановитьНовыйНомер(ДокОбъектСФ.Организация.Префикс);
		
		ДокОбъектСФ.Записать(РежимЗаписиДокумента.Проведение); 
		
	Исключение       
		
		ОтменитьТранзакцию();
		ВызватьИсключение ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
	КонецПопытки;
	
	ЗафиксироватьТранзакцию();
	//-Макрушин Е. 26.02.2026 #UT10-5657 

КонецПроцедуры

Функция ЭтоМагистраль(Контрагент)
//+Белов А. 14.04.2026 #UT10-5816

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СобственныеСклады.Ссылка
	|ИЗ
	|	Справочник.СобственныеСклады КАК СобственныеСклады
	|ГДЕ
	|	НЕ СобственныеСклады.ПометкаУдаления
	|	И СобственныеСклады.Поставщик = &Поставщик
	|	И СобственныеСклады.ВэбСервисУТ11";
	
	Запрос.УстановитьПараметр("Поставщик", Контрагент);  
	
	Выборка = Запрос.Выполнить().Выбрать(); 
	
	Если Выборка.Следующий() Тогда
		Возврат Истина;
	КонецЕсли;         
	
	Возврат Ложь;

//-Белов А. 14.04.2026 #UT10-5816 
