Процедура ЗаполнитьОбъектЗагрузки(СпрОбъект, ФабрикаИмени, ИмяОбъектаМетаданныхИсточник, ИмяОбъектаМетаданных, ИмяОчереди, СправочникЗагрузки, ЗаменяющийСправочник = "")
	
	Если СпрОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ФабрикаИмени.Свойства().Получить("ШтампВерсии") = Неопределено Тогда
		ШтампВерсии = Число(ФабрикаИмени.ШтампВерсии);
	Иначе
		ШтампВерсии = 0;
	КонецЕсли;

	Если (НЕ СпрОбъект.ЭтоНовый() И НЕ ЗначениеЗаполнено(СпрОбъект.ШтампВерсии) ) 
		Или (СпрОбъект.ШтампВерсии < ШтампВерсии) или (СпрОбъект.ЭтоНовый() и ШтампВерсии=0)
		ИЛИ (СпрОбъект.ШтампВерсии = ШтампВерсии) Тогда

		СпрОбъект.ОбменДанными.Загрузка = Истина;
		СпрОбъект.ПометкаУдаления = Булево(ФабрикаИмени.ПометкаУдаления);
		
		СпрОбъект.КодМДМ = ФабрикаИмени.GUID;    			
		СпрОбъект.ШтампВерсии = ШтампВерсии;
		
		ОчиститьПустыеСвойства(ФабрикаИмени);		
		ОбработатьРеквизитыФабрики(СпрОбъект, ИмяОбъектаМетаданныхИсточник, ФабрикаИмени, ИмяОчереди);		
		
		Если СпрОбъект.ЭтоНовый() И ЗначениеЗаполнено(СправочникЗагрузки.РодительЗагрузки) Тогда
			СпрОбъект.Родитель = СправочникЗагрузки.РодительЗагрузки;	
		КонецЕсли;     
		
		СпрОбъект.Записать();
		
		Если ЗначениеЗаполнено(ЗаменяющийСправочник)  Тогда
			ЗаписьЖурналаРегистрации("ПолучениеСообщений.Прием", УровеньЖурналаРегистрации.Информация,,, "Получен элемент справочника " 
			+ ИмяОбъектаМетаданныхИсточник + " : " + СпрОбъект.Ссылка + " заменяющий его справочник " + ЗаменяющийСправочник);	
		Иначе
			ЗаписьЖурналаРегистрации("ПолучениеСообщений.Прием", УровеньЖурналаРегистрации.Информация,,, "Получен элемент справочника " 
			+ ИмяОбъектаМетаданных + " : " + СпрОбъект.Ссылка);	
		КонецЕсли; 
		
		Если ИмяОбъектаМетаданных = "Номенклатура" и ИмяОбъектаМетаданных = ИмяОбъектаМетаданныхИсточник Тогда
			
			//Проверим, не зависли ли элементы связанных справочников
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	ОшибкиЗагрузкиДанныхИзОчередиAMQP.МоментОшибки КАК МоментОшибки,
			|	ОшибкиЗагрузкиДанныхИзОчередиAMQP.ИмяОбъектаМетаданных,
			|	ОшибкиЗагрузкиДанныхИзОчередиAMQP.КодМДМ КАК КодМДМ,
			|	ОшибкиЗагрузкиДанныхИзОчередиAMQP.ИмяСопутствСправочника,
			|	ОшибкиЗагрузкиДанныхИзОчередиAMQP.КодМДМСопутствСправочника,
			|	ОшибкиЗагрузкиДанныхИзОчередиAMQP.ТекстОшибки,
			|	ОшибкиЗагрузкиДанныхИзОчередиAMQP.ОписаниеОшибки,
			|	ОшибкиЗагрузкиДанныхИзОчередиAMQP.Обработано,
			|	ОшибкиЗагрузкиДанныхИзОчередиAMQP.НомерСообщения,
			|	ОшибкиЗагрузкиДанныхИзОчередиAMQP.НужноОбработать,
			|	ОшибкиЗагрузкиДанныхИзОчередиAMQP.ИмяОчереди,
			|	ОшибкиЗагрузкиДанныхИзОчередиAMQP.КоличествоПопыток,
			|	ОшибкиЗагрузкиДанныхИзОчередиAMQP.ШтампВерсии КАК ШтампВерсии
			|ИЗ
			|	РегистрСведений.ОшибкиЗагрузкиДанныхИзОчередиAMQP КАК ОшибкиЗагрузкиДанныхИзОчередиAMQP
			|ГДЕ
			|	ОшибкиЗагрузкиДанныхИзОчередиAMQP.НужноОбработать = ИСТИНА
			|	И ОшибкиЗагрузкиДанныхИзОчередиAMQP.КодМДМСопутствСправочника = &КодМДМ
			|
			|УПОРЯДОЧИТЬ ПО
			|	ШтампВерсии УБЫВ
			|ИТОГИ ПО
			|	КодМДМ";
			
			Запрос.УстановитьПараметр("КодМДМ",ФабрикаИмени.GUID);
			ВыборкаПоСправочникам = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаПоСправочникам.Следующий() Цикл
				
				Выборка = ВыборкаПоСправочникам.Выбрать();
				
				Если Выборка.Следующий() Тогда
					
					Чтение = Новый ЧтениеXML;
					Пар = Новый ПараметрыЧтенияXML(,,,,,,,,, Истина, Истина);
					
					Чтение.УстановитьСтроку(Выборка.ОписаниеОшибки, Пар);
					ФабрикаМДМ = ФабрикаXDTO.ПрочитатьXML(Чтение);
					
					ИмяОбъектаМетаданных_ = Выборка.ИмяОбъектаМетаданных;
					СправочникЗагрузки = Справочники.AMQP_СправочникиЗагрузки.НайтиПоРеквизиту("ИмяСправочника", ИмяОбъектаМетаданных_);			
					
					Если ИмяОбъектаМетаданных_ = "ЕдиницыИзмерения" Тогда
						
						ИмяОбъектаМетаданныхИсточник_ = "УпаковкиЕдиницыИзмерения";
						СпрОбъектМДМ = ПолучитьОбъектПоФабрике(ФабрикаМДМ, ИмяОбъектаМетаданных_, ИмяОчереди);   			
						ЗаполнитьОбъектЗагрузки(СпрОбъектМДМ, ФабрикаМДМ, ИмяОбъектаМетаданныхИсточник_, ИмяОбъектаМетаданных_, ИмяОчереди, СправочникЗагрузки);
						
					ИначеЕсли ИмяОбъектаМетаданных_ = "Штрихкоды" Тогда
						
						ИмяОбъектаМетаданныхИсточник_ = "ШтрихКодыНоменклатуры";
						РСЗапись = Неопределено;
						РСЗаписи = ПолучитьРегистрСведенийПоФабрике(РСЗапись, ФабрикаМДМ, ИмяОбъектаМетаданных_, ИмяОчереди);
						ЗаполнитьОбъектРегистраСведений(РСЗаписи, РСЗапись, ФабрикаМДМ, ИмяОбъектаМетаданныхИсточник_, ИмяОбъектаМетаданных_, ИмяОчереди, СправочникЗагрузки );
						
					Иначе
						Продолжить;
					КонецЕсли;
					
					КоличествоПопыток = Выборка.КоличествоПопыток;
					
					НаборЗаписей = РегистрыСведений.ОшибкиЗагрузкиДанныхИзОчередиAMQP.СоздатьНаборЗаписей();
					НаборЗаписей.Отбор.КодМДМ.Установить(ФабрикаМДМ.GUID);
					НаборЗаписей.Отбор.КодМДМСопутствСправочника.Установить(ФабрикаИмени.GUID);
					НаборЗаписей.Прочитать();
					
					Если НаборЗаписей.Количество() > 0 Тогда
						
						Если НаборЗаписей[0].КоличествоПопыток <= КоличествоПопыток Тогда	//Ошибка не повторилась, можно удалять записи
							НаборЗаписей.Очистить();
							НаборЗаписей.Записать();
						КонецЕсли;	
						
					КонецЕсли;
					
				КонецЕсли;  
				
			КонецЦикла;
			
		ИначеЕсли (ИмяОбъектаМетаданных = "Номенклатура" и ИмяОбъектаМетаданныхИсточник = "Производители") 
			  ИЛИ ИмяОбъектаМетаданных = "ЕдиницыИзмерения" или ИмяОбъектаМетаданных = "НоменклатурныеГруппы" //или ИмяОбъектаМетаданных = "Штрихкоды" 
			  ИЛИ ИмяОбъектаМетаданных = "ВидНоменклатуры" или ИмяОбъектаМетаданных = "КлассификаторЕдиницИзмерения" 
			  ИЛИ ИмяОбъектаМетаданных = "АВСКлассификацияНоменклатуры" Тогда
			
			Если ИмяОбъектаМетаданных = "ЕдиницыИзмерения" Тогда
				
				ИмяОбъектаМетаданныхИсточник = "УпаковкиЕдиницыИзмерения";
				Владелец = СпрОбъект.Владелец;
				
				Если СпрОбъект.ЕдиницаПоКлассификатору = Владелец.БазоваяЕдиницаИзмерения и Не ЗначениеЗаполнено(Владелец.ЕдиницаХраненияОстатков) Тогда
					
					ВладелецНом = Владелец.ПолучитьОбъект();
					ВладелецНом.ЕдиницаХраненияОстатков = СпрОбъект.Ссылка;
					ВладелецНом.ЕдиницаДляОтчетов = СпрОбъект.Ссылка;
					ВладелецНом.ОбменДанными.Загрузка = Истина;
					ВладелецНом.Записать();
					
				КонецЕсли;
				
			КонецЕсли;
			
			//Проверим, не завис ли элемент в РС Ошибки
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	ОшибкиЗагрузкиДанныхИзОчередиAMQP.МоментОшибки КАК МоментОшибки,
			|	ОшибкиЗагрузкиДанныхИзОчередиAMQP.ИмяОбъектаМетаданных,
			|	ОшибкиЗагрузкиДанныхИзОчередиAMQP.КодМДМ КАК КодМДМ,
			|	ОшибкиЗагрузкиДанныхИзОчередиAMQP.ИмяСопутствСправочника,
			|	ОшибкиЗагрузкиДанныхИзОчередиAMQP.КодМДМСопутствСправочника КАК КодМДМСопутствСправочника,
			|	ОшибкиЗагрузкиДанныхИзОчередиAMQP.ТекстОшибки,
			|	ОшибкиЗагрузкиДанныхИзОчередиAMQP.ОписаниеОшибки,
			|	ОшибкиЗагрузкиДанныхИзОчередиAMQP.Обработано,
			|	ОшибкиЗагрузкиДанныхИзОчередиAMQP.НомерСообщения,
			|	ОшибкиЗагрузкиДанныхИзОчередиAMQP.НужноОбработать,
			|	ОшибкиЗагрузкиДанныхИзОчередиAMQP.ИмяОчереди,
			|	ОшибкиЗагрузкиДанныхИзОчередиAMQP.КоличествоПопыток,
			|	ОшибкиЗагрузкиДанныхИзОчередиAMQP.ШтампВерсии КАК ШтампВерсии
			|ИЗ
			|	РегистрСведений.ОшибкиЗагрузкиДанныхИзОчередиAMQP КАК ОшибкиЗагрузкиДанныхИзОчередиAMQP
			|ГДЕ
			|	ОшибкиЗагрузкиДанныхИзОчередиAMQP.НужноОбработать = ИСТИНА
			|	И ОшибкиЗагрузкиДанныхИзОчередиAMQP.КодМДМСопутствСправочника = &КодМДМ
			|	И (ОшибкиЗагрузкиДанныхИзОчередиAMQP.ИмяОбъектаМетаданных = ""Номенклатура""
			|	ИЛИ ОшибкиЗагрузкиДанныхИзОчередиAMQP.ИмяОбъектаМетаданных = ""Штрихкоды"")
			|
			|УПОРЯДОЧИТЬ ПО
			|	ШтампВерсии УБЫВ
			|ИТОГИ ПО
			|	КодМДМСопутствСправочника";
			
			Запрос.УстановитьПараметр("КодМДМ",ФабрикаИмени.GUID);
			
			ВыборкаПоОбъектам = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаПоОбъектам.Следующий() Цикл
				
				Выборка = ВыборкаПоОбъектам.Выбрать();
				
				Если Выборка.Следующий() Тогда
					
					Чтение = Новый ЧтениеXML;
					Пар = Новый ПараметрыЧтенияXML(,,,,,,,,,Истина, Истина);
					Чтение.УстановитьСтроку(Выборка.ОписаниеОшибки, Пар);
					ФабрикаМДМ = ФабрикаXDTO.ПрочитатьXML(Чтение);
					
					ИмяОбъектаМетаданных_ = Выборка.ИмяОбъектаМетаданных;
					ИмяОбъектаМетаданныхИсточник_ = Выборка.ИмяОбъектаМетаданных;
					
					КоличествоПопыток = Выборка.КоличествоПопыток;
					СправочникЗагрузки = Справочники.AMQP_СправочникиЗагрузки.НайтиПоРеквизиту("ИмяСправочника", ИмяОбъектаМетаданных_);			
					
					Если СправочникЗагрузки.ТипДанных = "РегистрыСведений" Тогда
						
						РСЗапись = Неопределено;
						РСЗаписи = ПолучитьРегистрСведенийПоФабрике(РСЗапись, ФабрикаМДМ, ИмяОбъектаМетаданных_, ИмяОчереди);
						ЗаполнитьОбъектРегистраСведений(РСЗаписи, РСЗапись, ФабрикаМДМ, ИмяОбъектаМетаданныхИсточник_, ИмяОбъектаМетаданных_, ИмяОчереди, СправочникЗагрузки );
						
					Иначе
						
						СпрОбъектМДМ = ПолучитьОбъектПоФабрике(ФабрикаМДМ, ИмяОбъектаМетаданных_, ИмяОчереди);   			
						ЗаполнитьОбъектЗагрузки(СпрОбъектМДМ, ФабрикаМДМ, ИмяОбъектаМетаданныхИсточник_, ИмяОбъектаМетаданных_, ИмяОчереди, СправочникЗагрузки);
						
					КонецЕсли;
					
					НаборЗаписей = РегистрыСведений.ОшибкиЗагрузкиДанныхИзОчередиAMQP.СоздатьНаборЗаписей();
					НаборЗаписей.Отбор.КодМДМ.Установить(ФабрикаМДМ.GUID);
					НаборЗаписей.Отбор.КодМДМСопутствСправочника.Установить(ФабрикаИмени.GUID);
					НаборЗаписей.Прочитать();
					
					Если НаборЗаписей.Количество() > 0 Тогда
						
						Если НаборЗаписей[0].КоличествоПопыток <= КоличествоПопыток Тогда	//Ошибка не повторилась, можно удалять записи
							
							НаборЗаписей.Очистить();
							НаборЗаписей.Записать();
							
						КонецЕсли;	
						
					КонецЕсли;
					
				КонецЕсли;   
				
			КонецЦикла;
			
		КонецЕсли;
		
	Иначе
		
		ЗаписьЖурналаРегистрации("ПолучениеСообщений.Прием", УровеньЖурналаРегистрации.Информация,,, "Существующий элемент справочника " 
		+ ИмяОбъектаМетаданных + " : " + СпрОбъект.Ссылка + " имеет больший штамп версии, чем загружаемый. Сообщение отклонено.");			
		
	КонецЕсли; 
	
КонецПроцедуры

Функция ПолучитьОбъектПоФабрике(ФабрикаИмени, ИмяОбъектаМетаданных, КодПрикладнойСистемы, Создавать = Истина, ВернутьСсылку = Ложь, ЭтоГруппа = Ложь, ЗаменяющийСправочник = "")
	
	ИмяОбъектаМетаданныхОригинал = ИмяОбъектаМетаданных;
	Если ЗначениеЗаполнено(ЗаменяющийСправочник) Тогда
		ИмяОбъектаМетаданных = ЗаменяющийСправочник;
	КонецЕсли; 
	
	ГУИД = "";
	СпрОбъект = Неопределено;
	
	СпрСсылка = Справочники[ИмяОбъектаМетаданных].НайтиПоРеквизиту("КодМДМ", ФабрикаИмени.GUID);
	
	Если НЕ СпрСсылка.Пустая() Тогда
		СпрОбъект = СпрСсылка.ПолучитьОбъект();
	КонецЕсли;
	
	Если СпрОбъект = Неопределено Тогда
		
		Если ТипЗнч(ФабрикаИмени.УникальныеИдентификаторыПрикладныхСистем) = Тип("ОбъектXDTO") Тогда
			
			Если ТипЗнч(ФабрикаИмени.УникальныеИдентификаторыПрикладныхСистем.Строки) = Тип("СписокXDTO") Тогда			
				
				Для Каждого Стр Из ФабрикаИмени.УникальныеИдентификаторыПрикладныхСистем.Строки Цикл
					
					Если Стр.КодПрикладнойСистемы = КодПрикладнойСистемы И ТипЗнч(Стр.GUID) = Тип("Строка") Тогда
						
						ГУИД = Стр.GUID;
						Прервать;
						
					КонецЕсли;
					
				КонецЦикла;
				
				Если ЗначениеЗаполнено(ГУИД) Тогда
					
					СпрСсылка = Справочники[ИмяОбъектаМетаданных].ПолучитьСсылку(Новый УникальныйИдентификатор(ГУИД));
					СпрОбъект = СпрСсылка.ПолучитьОбъект();
					
				КонецЕсли;
				
			ИначеЕсли ТипЗнч(ФабрикаИмени.УникальныеИдентификаторыПрикладныхСистем.Строки) = Тип("ОбъектXDTO") Тогда
				
				ГУИД = ""; 				
				
				Если ФабрикаИмени.УникальныеИдентификаторыПрикладныхСистем.Строки.КодПрикладнойСистемы = КодПрикладнойСистемы 
					И ТипЗнч(ФабрикаИмени.УникальныеИдентификаторыПрикладныхСистем.Строки.GUID) = Тип("Строка")Тогда
					ГУИД = ФабрикаИмени.УникальныеИдентификаторыПрикладныхСистем.Строки.GUID;		
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ГУИД) Тогда
					
					СпрСсылка = Справочники[ИмяОбъектаМетаданных].ПолучитьСсылку(Новый УникальныйИдентификатор(ГУИД));
					СпрОбъект = СпрСсылка.ПолучитьОбъект();
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если СпрОбъект = Неопределено Тогда
		
		Если ЗначениеЗаполнено(ФабрикаИмени.GUID) Тогда
			
			СпрСсылка = Справочники[ИмяОбъектаМетаданных].ПолучитьСсылку(Новый УникальныйИдентификатор(ФабрикаИмени.GUID));
			СпрОбъект = СпрСсылка.ПолучитьОбъект();
			
		КонецЕсли;
		
	КонецЕсли; 		
	
	
	//По коду МДМ не нашли, продолжаем поиск по остальным ключевым реквизитам
	Если СпрОбъект = Неопределено и ИмяОбъектаМетаданных = "Номенклатура" и Не ЗначениеЗаполнено(ЗаменяющийСправочник) Тогда
		
		ЗагружатьНоменклатуруТолькоПоКодуМДМ = Константы.ЗагружатьНоменклатуруТолькоПоКодуМДМ.Получить();
		Если ЗагружатьНоменклатуруТолькоПоКодуМДМ Тогда	
			//Если не нашли по коду МДМ, то сразу создаем новую
			СпрОбъект = Справочники.Номенклатура.СоздатьЭлемент();			
		Иначе
			//Перенес поиск номенклатуры в отдельную функцию
			СпрОбъект = ПоискИСозданиеНоменклатуры(ФабрикаИмени);
		КонецЕсли;
		
	ИначеЕсли СпрОбъект = Неопределено и ИмяОбъектаМетаданных = "КлассификаторЕдиницИзмерения" Тогда
		
		СпрСсылка = Справочники[ИмяОбъектаМетаданных].НайтиПоКоду(ФабрикаИмени.Код);
		
		Если НЕ СпрСсылка.Пустая() Тогда
			СпрОбъект = СпрСсылка.ПолучитьОбъект();
		КонецЕсли;
		
	ИначеЕсли СпрОбъект = Неопределено и ИмяОбъектаМетаданных = "ОператорыЭДО" Тогда
		
		СпрСсылка = Справочники[ИмяОбъектаМетаданных].НайтиПоНаименованию(ФабрикаИмени.Наименование);
		
		Если НЕ СпрСсылка.Пустая() Тогда
			СпрОбъект = СпрСсылка.ПолучитьОбъект();
		КонецЕсли; 
		
	ИначеЕсли СпрОбъект = Неопределено и ИмяОбъектаМетаданных = "АВСКлассификацияНоменклатуры" Тогда
		
		СпрСсылка = Справочники[ИмяОбъектаМетаданных].НайтиПоКоду(ФабрикаИмени.КодABC);
		
		Если НЕ СпрСсылка.Пустая() Тогда
			СпрОбъект = СпрСсылка.ПолучитьОбъект();
		КонецЕсли;
		
	ИначеЕсли СпрОбъект = Неопределено и ИмяОбъектаМетаданных = "Кассы" Тогда
		
		Если ТипЗнч(ФабрикаИмени.Владелец) = Тип("ОбъектXDTO") И ФабрикаИмени.Владелец.Свойства().Количество() > 0 Тогда
			
			Владелец = Справочники.Организации.НайтиПоРеквизиту("КодМДМ", ФабрикаИмени.Владелец.GUID);
			
			Если Владелец.Пустая() Тогда
				
				//Владелец еще не загрузился в ИБ
				ТекстОшибки = "Не найден владелец Кассы организация КодМДМ " + СокрЛП(ФабрикаИмени.Владелец.GUID);
				ЗаписатьОшибкуВРС(ФабрикаИмени, ИмяОбъектаМетаданных, ФабрикаИмени.GUID, "Организации", ФабрикаИмени.Владелец.GUID, ТекстОшибки);
				Возврат Неопределено;
				
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли СпрОбъект = Неопределено и ИмяОбъектаМетаданных = "ЕдиницыИзмерения" Тогда
		
		Если ТипЗнч(ФабрикаИмени.Владелец) = Тип("ОбъектXDTO") И ФабрикаИмени.Владелец.Свойства().Количество() > 0 
			И ФабрикаИмени.Владелец.Свойства().Получить("Тип") <> Неопределено и ФабрикаИмени.Владелец.Тип = "Справочник.Номенклатура" Тогда
			
			Владелец = Справочники.Номенклатура.НайтиПоРеквизиту("КодМДМ", ФабрикаИмени.Владелец.GUID);
			
			Если Владелец.Пустая() Тогда
				
				//Владелец еще не загрузился в ИБ, сохраним сведения о ЕИ в регистре сведений. ЕИ будет создана после загрузки номенклатуры
				ТекстОшибки = "Не найден владелец ЕИ " + СокрЛП(ФабрикаИмени.Владелец.GUID);
				ЗаписатьОшибкуВРС(ФабрикаИмени, ИмяОбъектаМетаданных, ФабрикаИмени.GUID, "Номенклатура", ФабрикаИмени.Владелец.GUID, ТекстОшибки);
				Возврат Неопределено;
				
			КонецЕсли;
			
			БазоваяЕИ = Справочники.КлассификаторЕдиницИзмерения.НайтиПоРеквизиту("КодМДМ", ФабрикаИмени.ЕдиницаИзмерения.GUID);
			
			Если ЗначениеЗаполнено(Владелец.ЕдиницаХраненияОстатков) и Владелец.ЕдиницаХраненияОстатков.ЕдиницаПоКлассификатору = БазоваяЕИ Тогда
				СпрОбъект = Владелец.ЕдиницаХраненияОстатков.ПолучитьОбъект();
				
			Иначе
				
				Запрос = Новый Запрос;
				Запрос.Текст = "ВЫБРАТЬ
				|	ЕдиницыИзмерения.Ссылка,
				|	ЕдиницыИзмерения.ПометкаУдаления КАК ПометкаУдаления,
				|	ЕдиницыИзмерения.ЕдиницаПоКлассификатору
				|ИЗ
				|	Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
				|ГДЕ
				|	ЕдиницыИзмерения.Владелец = &Владелец
				|	И ЕдиницыИзмерения.ЕдиницаПоКлассификатору = &БазоваяЕИ
				|
				|УПОРЯДОЧИТЬ ПО
				|	ПометкаУдаления";
				
				Запрос.УстановитьПараметр("Владелец", Владелец);
				Запрос.УстановитьПараметр("БазоваяЕИ", БазоваяЕИ);
				
				//Получаем еи сначала без пометок на удаление, если такие есть
				Выборка = Запрос.Выполнить().Выбрать();
				
				Пока Выборка.Следующий() Цикл
					
					СпрОбъект = Выборка.Ссылка.ПолучитьОбъект();
					Прервать;
					
				КонецЦикла;
				
			КонецЕсли;
			
		Иначе
			Возврат Неопределено;
		КонецЕсли;
		
	ИначеЕсли СпрОбъект = Неопределено и ИмяОбъектаМетаданных = "Банки" Тогда
		
		СпрСсылка = Справочники[ИмяОбъектаМетаданных].НайтиПоКоду(ФабрикаИмени.Код);
		
		Если НЕ СпрСсылка.Пустая() Тогда
			СпрОбъект = СпрСсылка.ПолучитьОбъект();
		КонецЕсли;
		
		ЭтоГруппа = (ФабрикаИмени.ЭтоГруппа = "true");
		
	КонецЕсли;
	
	Если Создавать Тогда
		
		Если СпрОбъект = Неопределено Тогда 			
			
			Если ЭтоГруппа = Ложь Тогда
				
				СпрОбъект = Справочники[ИмяОбъектаМетаданных].СоздатьЭлемент();
				
				Если ЗначениеЗаполнено(ФабрикаИмени.GUID) Тогда
					
					СпрОбъект.УстановитьСсылкуНового(Справочники[ИмяОбъектаМетаданных].ПолучитьСсылку(Новый УникальныйИдентификатор(ФабрикаИмени.GUID)));
					СпрОбъект.УстановитьНовыйКод();
					
				КонецЕсли; 			
				
			Иначе 
				
				СпрОбъект = Справочники[ИмяОбъектаМетаданных].СоздатьГруппу();
				
				Если ЗначениеЗаполнено(ФабрикаИмени.GUID) Тогда
					
					СпрОбъект.УстановитьСсылкуНового(Справочники[ИмяОбъектаМетаданных].ПолучитьСсылку(Новый УникальныйИдентификатор(ФабрикаИмени.GUID)));
					СпрОбъект.УстановитьНовыйКод();
					
				КонецЕсли; 			
				
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ВернутьСсылку Тогда
		Возврат СпрОбъект;
	Иначе
		
		Если СпрОбъект = Неопределено Тогда
			Возврат Неопределено;
		Иначе
			Возврат СпрОбъект.Ссылка
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции

Процедура ЗагрузитьДокументПоФабрике(СообщениеJSON, СтруктураДокумента, ВидДокумента, ИмяОчереди, Отказ)
	
	Если ВидДокумента = "ПеремещениеТоваров" Или ВидДокумента = "РеализацияТоваровУслуг" Тогда
		
		//Получим основные поля из структуры документа в сообщении
		НомерДок = СокрЛП(СтруктураДокумента.Номер);
		ДатаДок = ПреобразоватьДатуМДМ(СтруктураДокумента.Дата);
		КонтрагентКодАварда = РаботаСАвардой.ФорматироватьСтроку(СтруктураДокумента.КонтрагентКодАварда);
		КонтрагентИНН = СтруктураДокумента.КонтрагентИНН;
		КонтрагентКПП = СтруктураДокумента.КонтрагентКПП;
		СкладГУИД = СтруктураДокумента.СкладGUID;
		
		//Поиск существующих документов
		ДокПоступления = Документы.ПоступлениеТоваровУслуг.НайтиПоРеквизиту("НомерСкладскогоДокумента",НомерДок);		
		
		Если ЗначениеЗаполнено(ДокПоступления) Тогда
			//Не трогаем существующие
			Возврат;			
		Иначе
			
			ДокПоступления = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент();
			СобытиеЖурнала = "Создан документ: ";
			
		КонецЕсли;
		
		//Заполнение шапки
		ДокПоступления.Дата = НачалоДня(ТекущаяДата() + 60 * 60 * 24);
		ДокПоступления.ВидПоступления  = Перечисления.ВидыПоступленияТоваров.НаСклад;
		ДокПоступления.КратностьВзаиморасчетов = 1;
		ДокПоступления.КурсВзаиморасчетов  = 1;			
		ДокПоступления.ОтражатьВНалоговомУчете = Истина;
		ДокПоступления.ОтражатьВБухгалтерскомУчете = Истина;	
		ДокПоступления.ОтражатьВУправленческомУчете = Истина;
		ДокПоступления.НДСВключенВСтоимость = Истина;
		ДокПоступления.Организация = Константы.ОсновнаяОрганизация.Получить();
		ДокПоступления.СкладОрдер = Константы.ОсновнойСклад.Получить();
		ДокПоступления.ВалютаДокумента = Константы.ВалютаУправленческогоУчета.Получить();
		Контрагент = Константы.ОсновнойПоставщик;
		ДокПоступления.Контрагент = Контрагент;
		ДокПоступления.ДоговорКонтрагента = Контрагент.ОсновнойДоговорКонтрагента;
		ДокПоступления.Комментарий = "Создан регламентным заданием загрузки из Раббит " + ТекущаяДата();		
		ДокПоступления.Ответственный = глЗначениеПеременной("глТекущийПользователь");
		ДокПоступления.НомерСкладскогоДокумента = НомерДок;
		
		//Заполнение ТЧ
		Для Сч=1 По СообщениеJSON.Количество()-1 Цикл
			
			ТекСтр = СообщениеJSON[Сч];
			ИнвНомер = СокрЛП(ТекСтр.ИнвНомер); //в ут10 это артикул
			Артикул = СокрЛП(ТекСтр.Артикул);
			Упаковка = СокрЛП(ТекСтр.Упаковка);
			КоличествоУпаковок = Число(ТекСтр.КоличествоУпаковок);
			Количество = Число(ТекСтр.Количество);
			Цена = Число(ТекСтр.Цена);
			НомерГТД = СокрЛП(ТекСтр.НомерГТД);
			КодСтраны = СокрЛП(ТекСтр.КодСтраны);
			
			Если ВидДокумента = "РеализацияТоваровУслуг" Тогда
				
				Сумма = Число(ТекСтр.Сумма);
				СтавкаНДС = ПолучитьСтавкуНДСПеречислением(СокрЛП(ТекСтр.СтавкаНДС));
				СуммаНДС = Число(ТекСтр.СуммаНДС);				
				
			Иначе
				
				Сумма = Окр(Количество * Цена, 2);  

				Если ДокПоступления.Дата >= Дата("20260101000000") Тогда
					
					СтавкаНДС = Перечисления.СтавкиНДС.НДС22;
					СуммаНДС = Окр(Сумма * 0.22, 2);
					
				Иначе
					
					СтавкаНДС = Перечисления.СтавкиНДС.НДС20;
					СуммаНДС = Окр(Сумма * 0.20, 2);
					
				КонецЕсли;
				
			КонецЕсли;		
			
			НовСтр = ДокПоступления.Товары.Добавить();
			Номенклатура = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", ИнвНомер);
			НовСтр.Номенклатура = Номенклатура;
			НовСтр.ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.НайтиПоНаименованию(Упаковка);
			НовСтр.Количество = КоличествоУпаковок;
			НовСтр.Коэффициент = Количество / КоличествоУпаковок;
			НовСтр.Цена = Цена;
			НовСтр.Сумма = Сумма;
			НовСтр.СтавкаНДС = СтавкаНДС;
			НовСтр.СуммаНДС = СуммаНДС;
			НовСтр.Склад = ДокПоступления.СкладОрдер;
			СерияНоменклатуры = Справочники.СерииНоменклатуры.НайтиПоНаименованию(НомерГТД, Истина,, Номенклатура);
			
			Если СерияНоменклатуры.Пустая() И Не Номенклатура.Пустая() Тогда
				
				НомерГТДСсылка = Справочники.НомераГТД.НайтиПоКоду(НомерГТД);
				Страна = Справочники.КлассификаторСтранМира.НайтиПоКоду(КодСтраны);
				НовСтр.СерияНоменклатуры = ПроверитьИСоздатьСерию(Номенклатура, НомерГТД, Страна, НомерГТДСсылка);
				
			Иначе			
				НовСтр.СерияНоменклатуры = СерияНоменклатуры;
			КонецЕсли;
			
		КонецЦикла;
		
		ДокПоступления.Записать(); 
		ЗаписьЖурналаРегистрации("ПолучениеСообщений.Прием", УровеньЖурналаРегистрации.Информация,,, СобытиеЖурнала+ДокПоступления.Ссылка);				
		
	ИначеЕсли МСК.ЭтоОчередьПрайсПМ(ИмяОчереди) И ВидДокумента = "УстановкаЦенНоменклатурыКонтрагентов" Тогда  
		
		Для каждого СтруктураОбъекта Из СообщениеJSON Цикл
			
			// Данные шапки			
			ЕстьОшибки = Ложь;   
			ДанныеПрайсПМ = ПолучитьДанныеПрайсПМ(СтруктураОбъекта, ЕстьОшибки);    
			
			Если ЕстьОшибки Тогда
				Продолжить;
			КонецЕсли;     
			
			// Поиск / создание документа			
			ДокОбъект = Неопределено;
			ПолучитьДокументУстановкаЦенНоменклатурыКонтрагентов(ДокОбъект, ДанныеПрайсПМ);
			
			// Поиск и добавление в документ номенклатуры с новой ценой
			ДобавитьНоменклатуруПрайсПМСНовойЦеной(ДокОбъект, СтруктураОбъекта, ДанныеПрайсПМ);
			
		КонецЦикла;
		
	КонецЕсли;	
	
КонецПроцедуры

Функция ЗагрузитьПоступлениеТоваровУслугИзЭДО(ТекстСообщения, ТекстОшибки, Отказ, Сообщение, ПринудительнаяЗагрузкаДляКонтрагентаТОХ = Ложь) Экспорт
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТекстСообщения);
	СтруктураДокумента = ПрочитатьJSON(ЧтениеJSON); 
	
	НомерДок = СокрЛП(СтруктураДокумента.number);
	ДатаДок = ПреобразоватьДатуМДМ(СтруктураДокумента.date);
	КонтрагентКодМДМ = СтруктураДокумента.supplier_mdm_id; 
	ОрганизацияКодМДМ = СтруктураДокумента.organization_mdm_id;
	СкладКодМДМ = СтруктураДокумента.warehouse_mdm_id;  
	//+Шульман А. 25.02.2026 #UT10-5713
	СуммаДокумента = СтруктураДокумента.total.totalAmount;
	СуммаНДСДокумента = СтруктураДокумента.total.totalAmountOfTax;
	//-Шульман А. 25.02.2026 #UT10-5713
	
	Если СтруктураДокумента.Свойство("Id_edi") Тогда
		ВидЗагрузки = 0;
	Иначе
		ВидЗагрузки = 1;
	КонецЕсли;
	
	НомерЭДО = ?(ВидЗагрузки = 0, СтруктураДокумента.Id_edi, НомерДок);
		
	//Поиск существующих документов     
	Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту("КодМДМ", КонтрагентКодМДМ); 
	
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
	
		ЗаписьЖурналаРегистрации("Обработка сообщения", УровеньЖурналаРегистрации.Ошибка,,, 
		"Не найден контрагент с кодом МДМ " + КонтрагентКодМДМ); 
		
		ТекстОшибки = ТекстОшибки + "Не найден контрагент с кодом МДМ " + КонтрагентКодМДМ + Символы.ПС;
	    Возврат Неопределено;
		
	КонецЕсли; 
	
	//+Сёмин Р.И. 08.06.2026 #UT10-5900
	ЭтоМежфилиальнаяПоставка = ЭтоМежфилиальнаяПоставка(Контрагент);
	//-Сёмин Р.И. 08.06.2026 #UT10-5900
	
	ДокПоступления = НайтиДокументПТУПоНомеруЭДОИКонтрагенту(НомерЭДО, ДатаДок, Контрагент, ВидЗагрузки);
	
	Если ЗначениеЗаполнено(ДокПоступления) Тогда
		
		//+Сёмин Р.И. 08.06.2026 #UT10-5900
		Если ЭтоМежфилиальнаяПоставка Тогда
			
			МСКWEB.УстановитьЗначениеДопСвойства(ДокПоступления, ПланыВидовХарактеристик.СвойстваОбъектов.СтатусПодтвержденияЭДОПТУ, Перечисления.СтатусыПодтвержденияЭДОПТУ.Подтверждено);
			
			//+Сёмин Р.И. 10.06.2026 #UT10-5918
			Если НЕ ЗначениеЗаполнено(ДокПоступления.file_id) Тогда
				
				Если СтруктураДокумента.Свойство("file_id") Тогда
					
					ДокПоступленияОбъект = ДокПоступления.ПолучитьОбъект();
					ДокПоступленияОбъект.file_id = СтруктураДокумента.file_id;
					ДокПоступленияОбъект.Записать();
					
				КонецЕсли;
				
			КонецЕсли;
			//-Сёмин Р.И. 10.06.2026 #UT10-5918
			
			Возврат Неопределено;
			
		КонецЕсли;
		//-Сёмин Р.И. 08.06.2026 #UT10-5900
		
		Ошибка = "Документ с номером вх.документа " + НомерЭДО + ", дата вх.документа " + Формат(ДатаДок, "ДФ=dd.MM.yyyy") 
		      + " по контрагенту " + Строка(Контрагент) + " уже загружен";
		ЗаписьЖурналаРегистрации("Обработка сообщения", УровеньЖурналаРегистрации.Ошибка,,, 
		Ошибка); 
		
		ТекстОшибки = ТекстОшибки + Ошибка;
		Возврат Неопределено;
		
	КонецЕсли;
	
	//+Сёмин Р.И. 08.06.2026 #UT10-5900
	Если ЭтоМежфилиальнаяПоставка Тогда
		
		Ошибка = "Документ с номером вх. документа " + НомерЭДО + ", дата вх.документа " + Формат(ДатаДок, "ДФ=dd.MM.yyyy") + ", контрагент " + Строка(Контрагент) + " является межфилиальной поставкой. Такой документ должен быть загружен через веб-сервис goodsreserv.";
		ЗаписьЖурналаРегистрации("Обработка сообщения", УровеньЖурналаРегистрации.Ошибка, , , Ошибка);
		
		ТекстОшибки = "#Пропустить_Сообщение#" + ТекстОшибки + Ошибка;
		Возврат Неопределено;
		
	КонецЕсли;
	//-Сёмин Р.И. 08.06.2026 #UT10-5900
	
	СкладОрдер = Справочники.Склады.НайтиПоРеквизиту("КодМДМ", СкладКодМДМ);
	
	Если Не ЗначениеЗаполнено(СкладОрдер) Тогда
	
		ЗаписьЖурналаРегистрации("Обработка сообщения", УровеньЖурналаРегистрации.Ошибка,,, 
		"Не найден склад с кодом МДМ " + СкладКодМДМ); 
		
		ТекстОшибки = ТекстОшибки + "Не найден склад с кодом МДМ " + СкладКодМДМ + Символы.ПС;
	
	КонецЕсли;    
	
	//Заполнение ТЧ  
	МассивТовары = СтруктураДокумента.Detail;   
	ТипСумма = ОбщегоНазначения.ОписаниеТипаЧисло(15, 2, ДопустимыйЗнак.Неотрицательный);
	
	тзТовары = Новый ТаблицаЗначений;    
	тзТовары.Колонки.Добавить("КодСтрокиКМ", ОбщегоНазначения.ОписаниеТипаЧисло(6, 0, ДопустимыйЗнак.Неотрицательный));
	тзТовары.Колонки.Добавить("НоменклатураКодМДМ", ОбщегоНазначения.ОписаниеТипаСтрока(36));     
	тзТовары.Колонки.Добавить("Количество", ОбщегоНазначения.ОписаниеТипаЧисло(10, 3, ДопустимыйЗнак.Неотрицательный));
	тзТовары.Колонки.Добавить("Цена", ТипСумма);
	тзТовары.Колонки.Добавить("Сумма", ТипСумма);
	тзТовары.Колонки.Добавить("СуммаНДС", ТипСумма);     
	тзТовары.Колонки.Добавить("СуммаСНДС", ТипСумма);   
	//+Шульман А. 25.02.2026 #UT10-5713
	//тзТовары.Колонки.Добавить("СтавкаНДСЧисло", ТипСумма);  
	//-Шульман А. 25.02.2026 #UT10-5713
	тзТовары.Колонки.Добавить("СтранаНаименование", ОбщегоНазначения.ОписаниеТипаСтрока(30)); 
	//+Шульман А. 30.03.2026 #UT10-5789   
	тзТовары.Колонки.Добавить("КодСтраны", ОбщегоНазначения.ОписаниеТипаСтрока(3)); 
	//-Шульман А. 30.03.2026 #UT10-5789
	тзТовары.Колонки.Добавить("НомерГТД", ОбщегоНазначения.ОписаниеТипаСтрока(30));         
	
	тзКодыМаркировки = Новый ТаблицаЗначений;    
	тзКодыМаркировки.Колонки.Добавить("КодСтрокиКМ", ОбщегоНазначения.ОписаниеТипаЧисло(6, 0, ДопустимыйЗнак.Неотрицательный));
	
	//+Макрушин Е. 27.02.2026 #UT11-5806
	// обрезало 1 символ
	//тзКодыМаркировки.Колонки.Добавить("КодМаркировки", ОбщегоНазначения.ОписаниеТипаСтрока(30));
	тзКодыМаркировки.Колонки.Добавить("КодМаркировки", ОбщегоНазначения.ОписаниеТипаСтрока(31));
	//-Макрушин Е. 27.02.2026 #UT11-5806
	
	тзКодыМаркировки.Колонки.Добавить("ДатаПроизводства", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	тзКодыМаркировки.Колонки.Добавить("СрокГодности", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	//+Шульман А. 17.03.2026 #UT10-5748
	тзКодыМаркировки.Колонки.Добавить("Причина", ОбщегоНазначения.ОписаниеТипаСтрока(50));
	тзКодыМаркировки.Колонки.Добавить("Невалиден", Новый ОписаниеТипов("Булево"));     
	//-Шульман А. 17.03.2026 #UT10-5748
	
	КодСтроки = 1;
	
	Для каждого ТекСтр Из МассивТовары Цикл
		
		ДобСтрока = тзТовары.Добавить();     
		ДобСтрока.КодСтрокиКМ = КодСтроки;
		ДобСтрока.НоменклатураКодМДМ = ТекСтр.Product_mdm_id; 
		ДобСтрока.Количество = ТекСтр.Qty; 
		ДобСтрока.НомерГТД = ТекСтр.gtd; 
		ДобСтрока.СтранаНаименование = ТекСтр.country; 
		
		//+Шульман А. 30.03.2026 #UT10-5789
		Если ТекСтр.Свойство("code_country") Тогда    // потом условие можно убрать
			ДобСтрока.КодСтраны = ТекСтр.code_country; 
		КонецЕсли;  
		//-Шульман А. 30.03.2026 #UT10-5789
		
		Если ВидЗагрузки = 0 Тогда   
			
			//+Гавриленков В. 29.07.2026 #UT10-5980
			//ДобСтрока.Цена = ТекСтр.Cost.PriceOfTax;
			//-Гавриленков В. 29.07.2026 #UT10-5980
			
			//+Шульман А. 25.02.2026 #UT10-5713
			//ДобСтрока.СтавкаНДСЧисло = ТекСтр.Cost.Tax;   
			//-Шульман А. 25.02.2026 #UT10-5713    
