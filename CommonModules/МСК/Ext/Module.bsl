			КорректировкаОбъект = КорректировкаСборки.ПолучитьОбъект();
			
			Если ПечатьКорректировкиСборки Тогда
				КорректировкаОбъект.Печать("ЗаданиеНаРазбор", 2, СразуНаПринтер, Ложь, ОтветственныйКорректировкаСборки);
			Иначе
				КорректировкаОбъект.Печать("ЗаданиеНаРазбор", 1, Ложь, Ложь, ОтветственныйКорректировкаСборки);
			КонецЕсли;
			
		КонецЦикла;				
		
