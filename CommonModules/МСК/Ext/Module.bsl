				ПечДокСчет = ДокОбъект.НовыйСчет();
				УниверсальныеМеханизмы.НапечататьДокумент(ПечДокСчет, 1, СразуНаПринтер, ОбщегоНазначения.СформироватьЗаголовокДокумента(ДокОбъект), ДокОбъект.Ссылка);
				
			КонецЕсли;
			
		КонецЕсли;				
		
		Если ПечатьКорректСчФк И Константы.ДатаОтсчетаНачалаПечатиКорректСчФк.Получить() <> Дата('00010101') Тогда
			
			//+Гавриленков В. 22.05.2026 #
			//ТолькоОтметка = ЗначениеЗаполнено(Реализация.Грузополучатель.DS_Подразделение_ID) ИЛИ ЗначениеЗаполнено(Реализация.ДоговорКонтрагента.DS_Подразделение_ID); 
			//РаспечататьКорректированыеСчетФактуры(ДокОбъект.Грузополучатель, СтруктураДляПечати, ТолькоОтметка);
			
			//+Сёмин Р.И. 08.09.2026 #UT10-6028
			//РаспечататьКорректированыеСчетФактуры(ДокОбъект.Грузополучатель, СтруктураДляПечати);
			РаспечататьКорректированыеСчетФактуры(ДокОбъект.Грузополучатель, СтруктураДляПечати, ДокОбъект.Грузополучатель.НеПечататьУКД);
			//-Сёмин Р.И. 08.09.2026 #UT10-6028
			
			//-Гавриленков В. 22.05.2026 #
			МассивТабДокКорректСчФк = ПолучитьКорректировочныеСчетаФактурыДляОтправки(ДокОбъект.Грузополучатель);	
			
		КонецЕсли; 			
		
		Если ПечатьТТН И Константы.ВключитьПечатьТТН.Получить() = Истина И ГрузополучательПризнакПечатиТТН = Истина Тогда
			РаспечататьТТН(ДокОбъект, СтруктураДляПечати);				
		КонецЕсли; 
		
		Если ПечатьАктРасчетаПремииПоРекламе Тогда 
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
