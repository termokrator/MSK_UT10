	|		ПО (ВЫБОР
	|				КОГДА ВТ_ТоварыНоменклатураГТД.КодСтраны = """"
	|					ТОГДА ЛОЖЬ
	|				ИНАЧЕ ВТ_ТоварыНоменклатураГТД.КодСтраны = КлассификаторСтранМираПоКоду.Код
	|			КОНЕЦ)
	|			И (НЕ КлассификаторСтранМираПоКоду.ПометкаУдаления)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторСтранМира КАК КлассификаторСтранМираПоНаименованию
	|		ПО (ВТ_ТоварыНоменклатураГТД.СтранаНаименование = КлассификаторСтранМираПоНаименованию.Наименование
	|				ИЛИ ВТ_ТоварыНоменклатураГТД.СтранаНаименование = КлассификаторСтранМираПоНаименованию.Код
	|				ИЛИ ВТ_ТоварыНоменклатураГТД.СтранаНаименование = КлассификаторСтранМираПоНаименованию.КодАльфа2
	|				ИЛИ ВТ_ТоварыНоменклатураГТД.СтранаНаименование = КлассификаторСтранМираПоНаименованию.НаименованиеПолное)
	|			И (НЕ КлассификаторСтранМираПоНаименованию.ПометкаУдаления)
	|			И (НЕ ВТ_ТоварыНоменклатураГТД.СтранаНаименование = """")
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ТоварыНоменклатураГТД.НоменклатураКодМДМ,
	|	ВТ_ТоварыНоменклатураГТД.Номенклатура,
	|	ВТ_ТоварыНоменклатураГТД.Количество,
	|	ВТ_ТоварыНоменклатураГТД.НомерГТД,
	|	ВТ_ТоварыНоменклатураГТД.НомерГТДСсылка,
	|	ВТ_ТоварыНоменклатураГТД.СтранаНаименование,
	|	ВТ_ТоварыНоменклатураГТД.КодСтраны,
	|	ВТ_ТоварыНоменклатураГТД.Цена,
	|	ВТ_ТоварыНоменклатураГТД.Сумма,
	|	ВТ_ТоварыНоменклатураГТД.СуммаСНДС,
	|	ВТ_ТоварыНоменклатураГТД.СуммаНДС,
	|	ВТ_ТоварыНоменклатураГТД.КодСтрокиКМ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТоварыБезСерий.КодСтрокиКМ КАК КодСтрокиКМ,
	|	ВТ_ТоварыБезСерий.Номенклатура,
	|	ВТ_ТоварыБезСерий.НоменклатураКодМДМ,
	|	МАКСИМУМ(ЕСТЬNULL(СерииНоменклатуры.Ссылка, ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка))) КАК СерияНоменклатуры,
	|	ВТ_ТоварыБезСерий.Номенклатура.ЕдиницаХраненияОстатков КАК ЕдиницаИзмерения,
	|	ВТ_ТоварыБезСерий.НомерГТД КАК НомерГТД,
	|	ВТ_ТоварыБезСерий.НомерГТДСсылка КАК НомерГТДСсылка,
	|	ВТ_ТоварыБезСерий.Цена,
	|	ВТ_ТоварыБезСерий.Количество,
	|	ВТ_ТоварыБезСерий.Количество КАК КоличествоУпаковок,
	|	ВТ_ТоварыБезСерий.Сумма,
	|	ВТ_ТоварыБезСерий.СуммаСНДС,
	|	ВТ_ТоварыБезСерий.СуммаНДС,
	|	ВТ_ТоварыБезСерий.СтранаНаименование,
	|	ВТ_ТоварыБезСерий.КодСтраны,
	|	ВТ_ТоварыБезСерий.Страна,
	|	ВТ_ТоварыБезСерий.Номенклатура.ЕдиницаХраненияОстатков.Коэффициент КАК Коэффициент
	|ИЗ
	|	ВТ_ТоварыБезСерий КАК ВТ_ТоварыБезСерий
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СерииНоменклатуры КАК СерииНоменклатуры
	|		ПО (НЕ ВТ_ТоварыБезСерий.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка))
	|			И ВТ_ТоварыБезСерий.Номенклатура = СерииНоменклатуры.Владелец
	|			И (НЕ ВТ_ТоварыБезСерий.НомерГТДСсылка = ЗНАЧЕНИЕ(Справочник.НомераГТД.ПустаяСсылка))
	|			И ВТ_ТоварыБезСерий.НомерГТДСсылка = СерииНоменклатуры.НомерГТД
	|			И (НЕ ВТ_ТоварыБезСерий.Страна = ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка))
	|			И ВТ_ТоварыБезСерий.Страна = СерииНоменклатуры.СтранаПроисхождения
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ТоварыБезСерий.Страна,
	|	ВТ_ТоварыБезСерий.СуммаСНДС,
	|	ВТ_ТоварыБезСерий.СуммаНДС,
	|	ВТ_ТоварыБезСерий.НоменклатураКодМДМ,
	|	ВТ_ТоварыБезСерий.НомерГТД,
	|	ВТ_ТоварыБезСерий.НомерГТДСсылка,
	|	ВТ_ТоварыБезСерий.Цена,
	|	ВТ_ТоварыБезСерий.Сумма,
	|	ВТ_ТоварыБезСерий.Номенклатура,
	|	ВТ_ТоварыБезСерий.СтранаНаименование,
	|	ВТ_ТоварыБезСерий.КодСтраны,
	|	ВТ_ТоварыБезСерий.КодСтрокиКМ,
	|	ВТ_ТоварыБезСерий.Количество,
	|	ВТ_ТоварыБезСерий.Номенклатура.ЕдиницаХраненияОстатков,
	|	ВТ_ТоварыБезСерий.Количество,
	|	ВТ_ТоварыБезСерий.Номенклатура.ЕдиницаХраненияОстатков.Коэффициент
	|
	|УПОРЯДОЧИТЬ ПО
	|	КодСтрокиКМ";
	//-Гавриленков В. 08.04.2026 #UT10-5804
	
	Запрос.УстановитьПараметр("тзТовары", тзТовары);
	
	РезультатЗапроса = Запрос.Выполнить();  
	
