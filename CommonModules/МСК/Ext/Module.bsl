		ЗаполнитьСвойствоПоПоискуКодаМДМ("Валюты", СпрОбъект, "ВалютаДенежныхСредств", ФабрикаСправочника.ВалютаДенежныСредств, ФабрикаСправочника);
		ЗаполнитьСвойствоПоПоискуКодаМДМ("Организации", СпрОбъект, "Владелец", ФабрикаСправочника.Владелец, ФабрикаСправочника);
		
		СтруктураМДМ = Новый Структура("ОтветственноеЛицоОсновнойКассир",Справочники.ФизическиеЛица.ПустаяСсылка());
		ЗаполнитьСвойствоПоПоискуКодаМДМ("ФизическиеЛица", СтруктураМДМ, "ОтветственноеЛицоОсновнойКассир", ФабрикаСправочника.ОтветственноеЛицоОсновнойКассир, ФабрикаСправочника);
		
		Отбор = Новый Структура("СтруктурнаяЕдиница", ?(СпрОбъект.ЭтоНовый(), СпрОбъект.ПолучитьСсылкуНового(), СпрОбъект.Ссылка));
		ТекущаяЗапись = РегистрыСведений.ОтветственныеЛица.ПолучитьПоследнее(ТекущаяДата(), Отбор);
		
		Если ТекущаяЗапись.ФизическоеЛицо <> СтруктураМДМ.ОтветственноеЛицоОсновнойКассир и ЗначениеЗаполнено(СтруктураМДМ.ОтветственноеЛицоОсновнойКассир) Тогда
			
