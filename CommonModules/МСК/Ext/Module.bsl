Функция ПолучитьДанныеПрайсПМ(СтруктураОбъекта, ЕстьОшибки)
	
	ДанныеПрайсПМ = Новый Структура("ИДДокументаВСмежнойБазе, Контрагент, Валюта, ТипЦен, Дата");
	
	ДанныеПрайсПМ.ИДДокументаВСмежнойБазе = Формат(СтруктураОбъекта.id, "ЧГ=");
	
	ГУИДКонтрагента = СтруктураОбъекта.partner;
	Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту("КодМДМ", ГУИДКонтрагента);
	
	Если Контрагент.Пустая() Тогда 
		
		ЗаписьЖурналаРегистрации("Загрузка прайс-листа из PM. Установка цен номенклатуры контрагентов.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
		"Не найден контрагент с кодом МДМ " + ГУИДКонтрагента);
		ЕстьОшибки = Истина;
		Возврат ДанныеПрайсПМ;
		
	КонецЕсли;    
	
	ДанныеПрайсПМ.Контрагент = Контрагент;
	
	Валюта = Справочники.Валюты.НайтиПоРеквизиту("КодМДМ", СтруктураОбъекта.currency); 
	
	Если Валюта.Пустая() Тогда 
		
		ЗаписьЖурналаРегистрации("Загрузка прайс-листа из PM. Установка цен номенклатуры контрагентов.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
		"Не найдена валюта с кодом МДМ " + СтруктураОбъекта.currency);
		ЕстьОшибки = Истина;
		Возврат ДанныеПрайсПМ;
		
	КонецЕсли;   
	
	ДанныеПрайсПМ.Валюта = Валюта;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВидыЦенПоставщиков.Ссылка
		|ИЗ
		|	Справочник.ТипыЦенНоменклатурыКонтрагентов КАК ВидыЦенПоставщиков
		|ГДЕ
		|	ВидыЦенПоставщиков.Владелец = &Контрагент
		|	И ВидыЦенПоставщиков.ВалютаЦены = &Валюта
		|	И НЕ ВидыЦенПоставщиков.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Валюта", Валюта);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	
	РезультатЗапроса = Запрос.Выполнить();   
	
	Если РезультатЗапроса.Пустой() Тогда
	
		ЗаписьЖурналаРегистрации("Загрузка прайс-листа из PM. Установка цен номенклатуры контрагентов.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
		"Не найден тип цены для " + Строка(Контрагент) + " в " + Строка(Валюта));
		ЕстьОшибки = Истина;
		Возврат ДанныеПрайсПМ;
		
	КонецЕсли;
			
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	ДанныеПрайсПМ.ТипЦен = Выборка.Ссылка;
	
	ДанныеПрайсПМ.Дата = ПреобразоватьДатуМДМ(СтруктураОбъекта.date);
	
	Возврат ДанныеПрайсПМ;
	
КонецФункции    

Процедура ПолучитьДокументУстановкаЦенНоменклатурыКонтрагентов(ДокОбъект, ДанныеПрайсПМ)
	
	//Поиск существующих документов  
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	УстановкаЦенНоменклатурыКонтрагентов.Ссылка
		|ИЗ
		|	Документ.УстановкаЦенНоменклатурыКонтрагентов КАК УстановкаЦенНоменклатурыКонтрагентов
		|ГДЕ
		|	УстановкаЦенНоменклатурыКонтрагентов.Контрагент = &Контрагент      
		|	И Год(УстановкаЦенНоменклатурыКонтрагентов.Дата) = &Год
		|	И УстановкаЦенНоменклатурыКонтрагентов.ИДДокументаВСмежнойБазе = &ИДДокументаВСмежнойБазе";
	
	Запрос.УстановитьПараметр("ИДДокументаВСмежнойБазе", ДанныеПрайсПМ.ИДДокументаВСмежнойБазе);
	Запрос.УстановитьПараметр("Контрагент", ДанныеПрайсПМ.Контрагент);
	Запрос.УстановитьПараметр("Год", Год(ДанныеПрайсПМ.Дата));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	//Создаем документ или получаем объект существующего
	Если РезультатЗапроса.Пустой() Тогда
		
		// Найти документ за дату прайса, чтобы получить дату-время последнего документа
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ЦеныНоменклатурыКонтрагентов.Регистратор,
			|	ЦеныНоменклатурыКонтрагентов.Период КАК Период
			|ИЗ
			|	РегистрСведений.ЦеныНоменклатурыКонтрагентов КАК ЦеныНоменклатурыКонтрагентов
			|ГДЕ
			|	НАЧАЛОПЕРИОДА(ЦеныНоменклатурыКонтрагентов.Период, ДЕНЬ) = &ДатаПрайса
			|	И ЦеныНоменклатурыКонтрагентов.ТипЦен = &ТипЦен
			|	И ЦеныНоменклатурыКонтрагентов.Регистратор ССЫЛКА Документ.УстановкаЦенНоменклатурыКонтрагентов
			|
			|УПОРЯДОЧИТЬ ПО
			|	Период УБЫВ";
		
		Запрос.УстановитьПараметр("ДатаПрайса", НачалоДня(ДанныеПрайсПМ.Дата));
		Запрос.УстановитьПараметр("ТипЦен", ДанныеПрайсПМ.ТипЦен);
		
		РезультатЗапроса = Запрос.Выполнить(); 
		
		Если РезультатЗапроса.Пустой() Тогда
			ДатаДок = ДанныеПрайсПМ.Дата;
		Иначе	
		    // Дата документа на секунду большего, чтобы не было записей с одинаковыми ключами
			Выборка = РезультатЗапроса.Выбрать();
		    Выборка.Следующий();   
			ДатаДок = Выборка.Период + 1;
		
		КонецЕсли;
		
		ДокОбъект = Документы.УстановкаЦенНоменклатурыКонтрагентов.СоздатьДокумент();    
		ДокОбъект.Дата = ДатаДок;
		
		ДокОбъект.Контрагент = ДанныеПрайсПМ.Контрагент;   
		ДокОбъект.ИДДокументаВСмежнойБазе = ДанныеПрайсПМ.ИДДокументаВСмежнойБазе;
		
		ДобСтрока = ДокОбъект.ТипыЦен.Добавить();
		ДобСтрока.ТипЦен = ДанныеПрайсПМ.ТипЦен;  
		
	Иначе
		
		Выборка = РезультатЗапроса.Выбрать();
	    Выборка.Следующий();
		
		ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
		
		Если ДокОбъект.ПометкаУдаления = Истина Тогда
			ДокОбъект.УстановитьПометкуУдаления(Ложь);
		КонецЕсли;
	
		Если ДокОбъект.ТипыЦен.НайтиСтроки(Новый Структура("ТипЦен", ДанныеПрайсПМ.ТипЦен)).Количество() = 0 Тогда
		
			ДобСтрока = ДокОбъект.ТипыЦен.Добавить();
			ДобСтрока.ТипЦен = ДанныеПрайсПМ.ТипЦен;  
			
		КонецЕсли;   
		
	КонецЕсли;	   

КонецПроцедуры

Процедура ДобавитьНоменклатуруПрайсПМСНовойЦеной(ДокОбъект, СтруктураОбъекта, ДанныеПрайсПМ)
	
	// Считывание прайса в тзЦены
	тзЦены = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент().Товары.Выгрузить();  
	тзЦены.Колонки.Добавить("КодМДМ", ОбщегоНазначения.ОписаниеТипаСтрока(36));
	
	Для Каждого Стр Из СтруктураОбъекта.data Цикл              
		
		Если ПустаяСтрока(Стр.mdm_id) Тогда
			Продолжить;
		КонецЕсли;  
		
		НовСтр = тзЦены.Добавить();
		НовСтр.КодМДМ = Стр.mdm_id;    
		НовСтр.Цена = Стр.price;
		
	КонецЦикла;    
	
	// Получаем номенклатуру, у которой цена в прайсе отличается от текущей цены в регистре ЦеныНоменклатурыКонтрагентов
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	тзЦены.КодМДМ,
		|	тзЦены.Цена
		|ПОМЕСТИТЬ ВТ_Цены
		|ИЗ
		|	&тзЦены КАК тзЦены
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СправНоменклатура.Ссылка КАК Номенклатура,
		|	ВТ_Цены.Цена,
		|	ВТ_Цены.КодМДМ
		|ПОМЕСТИТЬ ВТ_Номенклатура
		|ИЗ
		|	ВТ_Цены КАК ВТ_Цены
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправНоменклатура
		|		ПО ВТ_Цены.КодМДМ = СправНоменклатура.КодМДМ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Номенклатура.Номенклатура,
		|	ВТ_Номенклатура.КодМДМ,
		|	ВТ_Номенклатура.Цена,
		|	ЕСТЬNULL(ЦеныНоменклатурыКонтрагентовСрезПоследних.Цена, 0) КАК ЦенаПоследняя,
		|	ЦеныНоменклатурыКонтрагентовСрезПоследних.Регистратор
		|ИЗ
		|	ВТ_Номенклатура КАК ВТ_Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатурыКонтрагентов.СрезПоследних(&Дата, ТипЦен = &ТипЦен) КАК ЦеныНоменклатурыКонтрагентовСрезПоследних
		|		ПО ВТ_Номенклатура.Номенклатура = ЦеныНоменклатурыКонтрагентовСрезПоследних.Номенклатура
		|ГДЕ
		|	НЕ ВТ_Номенклатура.Цена = ЕСТЬNULL(ЦеныНоменклатурыКонтрагентовСрезПоследних.Цена, 0)";
	
	Запрос.УстановитьПараметр("тзЦены", тзЦены);
	Запрос.УстановитьПараметр("Дата",   ДанныеПрайсПМ.Дата);
	Запрос.УстановитьПараметр("ТипЦен", ДанныеПрайсПМ.ТипЦен);
	
	РезультатЗапроса = Запрос.Выполнить();   
	
	Если РезультатЗапроса.Пустой() Тогда
	     Возврат;
	КонецЕсли;
	
	ТипЦен = ДанныеПрайсПМ.ТипЦен;
	Валюта = ДанныеПрайсПМ.Валюта;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
	
		Если Не Выборка.Номенклатура = NULL Тогда
		
			НовСтр = ДокОбъект.Товары.Добавить();
			НовСтр.Номенклатура = Выборка.Номенклатура;    
			НовСтр.ЕдиницаИзмерения = Выборка.Номенклатура.ЕдиницаХраненияОстатков;
			НовСтр.Цена = Выборка.Цена;
			НовСтр.ТипЦен = ТипЦен;     
			НовСтр.Валюта = Валюта;   
			
		Иначе
			ЗаписьЖурналаРегистрации("Загрузка прайс-листа из PM. Установка цен номенклатуры контрагентов.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
			"Не найдена номенклатура с кодом МДМ " + Выборка.КодМДМ);
		КонецЕсли;
			
	КонецЦикла;
	
	ВидДокумента = "УстановкаЦенНоменклатурыКонтрагентов";
	
	Если ДокОбъект.Товары.Количество() Тогда 
		
		Попытка    
			
			ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
			ЗаписьЖурналаРегистрации("ПолучениеСообщений.Прием", УровеньЖурналаРегистрации.Информация,,, ДокОбъект.Ссылка);    
			
		Исключение     
			
			ЗаписьЖурналаРегистрации("Загрузка прайс-листа из PM. Установка цен номенклатуры контрагентов.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
			"Ошибка записи документа: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			СтрокаИсключения = "ВидДокумента " + ВидДокумента + "; Ошибка записи" + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()); 					 
			ВызватьИсключение СтрокаИсключения; 
			
		КонецПопытки;	 
		
		
		Попытка    
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение     
			
			ЗаписьЖурналаРегистрации("Загрузка прайс-листа из PM. Установка цен номенклатуры контрагентов.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
			"Ошибка проведения документа: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
		КонецПопытки;	 
		
	Иначе
		
		ЗаписьЖурналаРегистрации("Загрузка прайс-листа из PM. Установка цен номенклатуры контрагентов.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
		"Ошибка создания документа: не заполнена табличная часть 'Товары' ");
		
	КонецЕсли;

КонецПроцедуры // ()

// Работа с кратностью товара начало  
Функция ПроверкаНоменклатурыНаКратность(Номенклатура,Количество)   Экспорт
	
	Если Константы.ИспользоватьАлгоритмПроверкиКратностиФилиала.Получить() Тогда
		ПромКратностьТовара = ?(Номенклатура.КратностьФилиала = 0 , Номенклатура.Кратность , Номенклатура.КратностьФилиала);
	Иначе
		ПромКратностьТовара = Номенклатура.Кратность;		
	КонецЕсли;
	
	Если  Количество  = 0 ИЛИ ПромКратностьТовара = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	РезультатДеления  =  Количество /ПромКратностьТовара;
	ЦелаяЧасть = Цел(РезультатДеления);
	
	Если  ЦелаяЧасть  <>  РезультатДеления Тогда
		Возврат Ложь;
	Иначе 
		Возврат Истина;
	КонецЕсли;	
	
КонецФункции

Функция ПолучитьКратностьНоменклатуры(Номенклатура) Экспорт

	Если Константы.ИспользоватьАлгоритмПроверкиКратностиФилиала.Получить() Тогда
		ПромКратностьТовара = ?(Номенклатура.КратностьФилиала = 0 , Номенклатура.Кратность , Номенклатура.КратностьФилиала);
	Иначе
		ПромКратностьТовара = Номенклатура.Кратность;		
	КонецЕсли; 
	
	Возврат ?(ПромКратностьТовара = 0 , 1 , ПромКратностьТовара);

КонецФункции

Функция ПроверкаНоменклатурыНаКратностьЗаказПокупателя(ЗаказПокупателя) Экспорт 
	
	ТаблицаНоменклатурыСНарушеннойКратностью = Новый ТаблицаЗначений;
	ТаблицаНоменклатурыСНарушеннойКратностью.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаНоменклатурыСНарушеннойКратностью.Колонки.Добавить("Кратность", ОбщегоНазначения.ПолучитьОписаниеТиповЧисла(15, 0));
	ТаблицаНоменклатурыСНарушеннойКратностью.Колонки.Добавить("Количество", ОбщегоНазначения.ПолучитьОписаниеТиповЧисла(15, 2));
	
	Если НеобходимоПроверятьКратностьВЗаказе(ЗаказПокупателя) Тогда 	
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Константы.ИспользоватьАлгоритмПроверкиКратностиФилиала КАК ЗначениеКонстанты
		|ПОМЕСТИТЬ КонстКратности
		|ИЗ
		|	Константы КАК Константы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗаказПокупателяТовары.Номенклатура,
		|	СУММА(ЗаказПокупателяТовары.Количество) КАК Количество,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА КонстКратности.ЗначениеКонстанты
		|				ТОГДА ВЫБОР
		|						КОГДА НЕ ЗаказПокупателяТовары.Номенклатура.КратностьФилиала = 0
		|							ТОГДА ЗаказПокупателяТовары.Номенклатура.КратностьФилиала
		|						ИНАЧЕ ЗаказПокупателяТовары.Номенклатура.Кратность
		|					КОНЕЦ
		|			ИНАЧЕ ЗаказПокупателяТовары.Номенклатура.Кратность
		|		КОНЕЦ) КАК Кратность
		|ИЗ
		|	Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары,
		|	КонстКратности КАК КонстКратности
		|ГДЕ
		|	ЗаказПокупателяТовары.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказПокупателяТовары.Номенклатура";
		
		Запрос.УстановитьПараметр("Ссылка",ЗаказПокупателя);
		
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Если ВыборкаДетальныеЗаписи.Кратность = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			РезультатДеления = ВыборкаДетальныеЗаписи.Количество / ВыборкаДетальныеЗаписи.Кратность;
			ЦелаяЧасть = Цел(РезультатДеления);
			
			Если ЦелаяЧасть <> РезультатДеления Тогда
				
				НоваяСтрока = ТаблицаНоменклатурыСНарушеннойКратностью.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,ВыборкаДетальныеЗаписи);
				
			КонецЕсли;	
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ТаблицаНоменклатурыСНарушеннойКратностью;
	
КонецФункции

Функция НеобходимоПроверятьКратностьВЗаказе(ЗаказПокупателя) Экспорт
	
	Если Константы.ИспользоватьАлгоритмПроверкиКратностиФилиала.Получить() Тогда
		
		КодОсновногоСклада = Константы.FTPВыгрузкаОстатковКаталог.Получить();
		КодОсновногоСклада = ?(КодОсновногоСклада = "", 1, Число(КодОсновногоСклада));
		КодДопСклада       = Константы.FTPВыгрузкаОстатковКаталог1.Получить();
		КодДопСклада       = ?(КодДопСклада = "", 1, Число(КодДопСклада));                                                                                                    
		
		Возврат ЗаказПокупателя.IDСклада = КодОсновногоСклада ИЛИ ЗаказПокупателя.IDСклада = КодДопСклада Или ЗаказПокупателя.IDСклада = 0 
		Или ЗаказПокупателя.IDСклада = 1 Или ЗаказПокупателя.IDСклада = 4;
		
	Иначе  
		Возврат НЕ ЭтоСтороннийСклад(ЗаказПокупателя.IDСклада);
	КонецЕсли; 
	
КонецФункции
// Работа с кратностью товара конец

Функция ПолучитьСписокРабочихДней(ГрафикРаботыСтрока) Экспорт 
	
	СоответствиеГрафика = Новый Соответствие; 	
	СоответствиеГрафика.Вставить("ПН",1);
	СоответствиеГрафика.Вставить("ВТ",1);
	СоответствиеГрафика.Вставить("СР",1);
	СоответствиеГрафика.Вставить("ЧТ",1);
	СоответствиеГрафика.Вставить("ПТ",1);
	СоответствиеГрафика.Вставить("СБ",1);
	СоответствиеГрафика.Вставить("ВС",1);
	
	Если ЗначениеЗаполнено(ГрафикРаботыСтрока) Тогда
		
		Если СтрДлина(ГрафикРаботыСтрока) = 14 Тогда
			
			СоответствиеГрафика.Вставить("ПН", Число(Сред(ГрафикРаботыСтрока, 1, 1)));
			СоответствиеГрафика.Вставить("ВТ", Число(Сред(ГрафикРаботыСтрока, 3, 1))); 
			СоответствиеГрафика.Вставить("СР", Число(Сред(ГрафикРаботыСтрока, 5, 1))); 
			СоответствиеГрафика.Вставить("ЧТ", Число(Сред(ГрафикРаботыСтрока, 7, 1))); 
			СоответствиеГрафика.Вставить("ПТ", Число(Сред(ГрафикРаботыСтрока, 9, 1))); 
			СоответствиеГрафика.Вставить("СБ", Число(Сред(ГрафикРаботыСтрока, 11, 1))); 
			СоответствиеГрафика.Вставить("ВС", Число(Сред(ГрафикРаботыСтрока, 13, 1))); 			
			
		КонецЕсли;		
		
	КонецЕсли;
	
	Возврат СоответствиеГрафика;

КонецФункции

Процедура ЗагрузкаКурсаЕвро() Экспорт    
	
	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда 
		
		ЗаписьЖурналаРегистрации("Загрузка курса Евро", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Отменена работа регламентного задания из-за несоответствия параметров подключения к ИБ");
		Возврат;
		
	КонецЕсли;
	
	ОбработкаЗагрузкиКурсов = Обработки.КурсыВалютРБК.Создать();
	ОбработкаЗагрузкиКурсов.НачДата = ТекущаяДата();
	ОбработкаЗагрузкиКурсов.КонДата = ТекущаяДата();
	
	НовВалюта = ОбработкаЗагрузкиКурсов.СписокВалют.Добавить();
	НовВалюта.Валюта = Справочники.Валюты.НайтиПоКоду("978");
	
	ОбработкаЗагрузкиКурсов.ЗагрузитьКурсыСРБК_Фоновое();
	
КонецПроцедуры

Функция ДанныеОКонтрагентеДляСверкиСМосквой(Контрагент,Признак)  Экспорт 
	
	Код = СокрЛП(Контрагент.Код);
	Наименование = СокрЛП(Контрагент.Наименование);
	ИНН    =     Контрагент.ИНН;
	КодПоОКПО = Контрагент.КодПоОКПО;
	КПП    =    Контрагент.КПП;
	ЮрФизЛицо = ?(Контрагент.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо, "1", "0");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	КонтактнаяИнформация.Представление,
	|	КонтактнаяИнформация.Тип,
	|	КонтактнаяИнформация.Вид
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Объект = &Объект
	|	И КонтактнаяИнформация.Тип В(&Тип)
	|	И КонтактнаяИнформация.Вид В(&Вид)";
	
	Запрос.УстановитьПараметр("Объект", Контрагент);
	Тип = Новый Массив;
	Вид = Новый Массив;
	
	Тип.Добавить(Перечисления.ТипыКонтактнойИнформации.Адрес);
	Тип.Добавить(Перечисления.ТипыКонтактнойИнформации.Телефон);
	Тип.Добавить(Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
	
	Вид.Добавить(Справочники.ВидыКонтактнойИнформации.ФактАдресКонтрагента);
	Вид.Добавить(Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента);
	Вид.Добавить(Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента);
	Вид.Добавить(Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыКонтрагентаДляОбменаДокументами);
	
	Запрос.УстановитьПараметр("Тип", Тип);
	Запрос.УстановитьПараметр("Вид", Вид);
	
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	ФактАдресКонтрагента  = "";
	ЮрАдресКонтрагента    = "";
	ТелефонКонтрагента    = "";
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес И Выборка.Вид =  Справочники.ВидыКонтактнойИнформации.ФактАдресКонтрагента Тогда
			ФактАдресКонтрагента = Выборка.Представление;
		ИначеЕсли Выборка.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес И Выборка.Вид =  Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента Тогда
			ЮрАдресКонтрагента = Выборка.Представление;
		ИначеЕсли Выборка.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон Тогда
			ТелефонКонтрагента = Выборка.Представление;
		ИначеЕсли Выборка.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты Тогда
			ЭлПочта = Выборка.Представление;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Признак = 1 Тогда
		Возврат СокрЛП(Код) + "@" + СокрЛП(Наименование) + "@" + СокрЛП(ИНН) + "@" + СокрЛП(КодПоОКПО) + "@" + СокрЛП(КПП)
		 + "@" + ЮрФизЛицо + "@" + СокрЛП(ФактАдресКонтрагента) + "@" + СокрЛП(ЮрАдресКонтрагента) + "@" + СокрЛП(ТелефонКонтрагента) + "@" + СокрЛП(ЭлПочта);
	ИначеЕсли Признак  = 2  Тогда
		Возврат СокрЛП(ФактАдресКонтрагента) + "@" + СокрЛП(ЮрАдресКонтрагента) + "@" + СокрЛП(ТелефонКонтрагента) + "@" + СокрЛП(ЭлПочта);
	КонецЕсли;
	
КонецФункции

Функция ПроверитьДоговорНаНаличныеОплаты(Договор,СуммаДокумента) Экспорт 
	
	Если НЕ Договор.ОплатаПоДоговоруНаличными Тогда
		Возврат Истина;
	КонецЕсли;
	
	//
	// Если приход денег по договору за весь период (с учетом планируемой суммы) превышает 100000 руб - возврат "Ложь"
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДвиженияДенежныхСредствОбороты.СуммаОборот
	|ИЗ
	|	РегистрНакопления.ДвиженияДенежныхСредств.Обороты(
	|			,
	|			,
	|			,
	|			ВидДенежныхСредств = &ВидДенежныхСредств
	|				И ПриходРасход = &ПриходРасход
	|				И ДоговорКонтрагента = &ДоговорКонтрагента) КАК ДвиженияДенежныхСредствОбороты";
	
	Запрос.УстановитьПараметр("ДоговорКонтрагента", Договор);
	Запрос.УстановитьПараметр("ПриходРасход", Перечисления.ВидыДвиженийПриходРасход.Приход);
	Запрос.УстановитьПараметр("ВидДенежныхСредств", Перечисления.ВидыДенежныхСредств.Наличные);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.СуммаОборот + СуммаДокумента > 100000 Тогда
			Возврат Ложь;
		Иначе 
			Возврат Истина;
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

Функция ПолучитьМассивДоговоровКонтрагента(Контрагент, ИсключаемыйДоговор = Неопределено) Экспорт
	
	МассивРезультата = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Ссылка
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.Владелец = &Владелец
	|	И ДоговорыКонтрагентов.Ссылка <> &ИсключаемыйДоговор
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДоговорыКонтрагентов.ПометкаУдаления УБЫВ";
	
	Запрос.УстановитьПараметр("Владелец", Контрагент);	
	Запрос.УстановитьПараметр("ИсключаемыйДоговор", ?(ЗначениеЗаполнено(ИсключаемыйДоговор), ИсключаемыйДоговор, Справочники.ДоговорыКонтрагентов.ПустаяСсылка()));	
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		МассивРезультата.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат МассивРезультата;	
	
КонецФункции

Функция НайтиИзРегистратора(Регистратор, Номенклатура, НомерСтроки)
	
	СтрДок = Регистратор.Товары[НомерСтроки];
	Возврат СтрДок.ОтказПоставщика;
	
КонецФункции

Функция НайтиДокументПТУПоНомеруЭДОИКонтрагенту(НомерДокументаУПД, ДатаДокументаУПД, Контрагент, ВидПоиска = 0)  
	
	ЗапросПТУ = Новый Запрос;
	ЗапросПТУ.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПоступлениеТоваровУслуг.Ссылка КАК ДокПТУ
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
	|ГДЕ
	|	ПоступлениеТоваровУслуг.Контрагент = &Контрагент   
	|	И НЕ ПоступлениеТоваровУслуг.ПометкаУдаления";
	
	Если ВидПоиска = 0 Тогда
		ЗапросПТУ.Текст = ЗапросПТУ.Текст + " 
	|	И ПоступлениеТоваровУслуг.НомерВходящегоДокументаЭлектронногоОбмена = &НомерВходящегоДокумента 
	//+Шульман А. 25.02.2026 #UT10-5713
	|	И ПоступлениеТоваровУслуг.ДатаВходящегоДокументаЭлектронногоОбмена = &ДатаВходящегоДокумента";
	//-Шульман А. 25.02.2026 #UT10-5713	
	Иначе	
		ЗапросПТУ.Текст = ЗапросПТУ.Текст + "
	|	И ПоступлениеТоваровУслуг.НомерВходящегоДокумента = &НомерВходящегоДокумента   
	//+Шульман А. 25.02.2026 #UT10-5713
	|	И ПоступлениеТоваровУслуг.ДатаВходящегоДокумента = &ДатаВходящегоДокумента";
	//-Шульман А. 25.02.2026 #UT10-5713
	КонецЕсли;
	
	ЗапросПТУ.УстановитьПараметр("Контрагент", Контрагент);
	ЗапросПТУ.УстановитьПараметр("НомерВходящегоДокумента", НомерДокументаУПД); 
	//+Шульман А. 25.02.2026 #UT10-5713
	ЗапросПТУ.УстановитьПараметр("ДатаВходящегоДокумента", ДатаДокументаУПД);
	//-Шульман А. 25.02.2026 #UT10-5713
	
	РезультатЗапросаПТУ = ЗапросПТУ.Выполнить();
	
	Если НЕ РезультатЗапросаПТУ.Пустой() Тогда  
		
		Выборка = РезультатЗапросаПТУ.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.ДокПТУ;       
		
	Иначе
		Возврат Документы.ПоступлениеТоваровУслуг.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

Процедура ПриЗаписиРегистра_ЗаказыПокупателейПередЗаписью(Источник, Отказ, Замещение) Экспорт
	
	Регистратор = Источник.Отбор.Регистратор.Значение; 
	
	Если ТипЗнч(Регистратор) = Тип("ДокументСсылка.КорректировкаЗаказаПокупателя") Тогда
		
		Если НЕ	Источник.Записывать Тогда 
			Источник.Записывать = Истина;
		КонецЕсли;
		
		Для Каждого Запись Из Источник Цикл
			
			Если НЕ ЗначениеЗаполнено(Запись.ОтказПоставщика) Тогда
				
				ОтказПоставщика = НайтиИзРегистратора(Регистратор, Запись.Номенклатура, Запись.НомерСтроки);
				Запись.ОтказПоставщика = ОтказПоставщика;
				
			КонецЕсли;
			
		КонецЦикла;	 
		
	КонецЕсли;
	
КонецПроцедуры

Функция ВернутьНомерСчетФактуры(Дата) Экспорт 
	
	СтруктураСНомеромСчетфактуры = Новый Структура;
	ГодЭтогоДокумента = Год(Дата);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	НомераСчетовФактур.МаксимальныйНомер
	|ИЗ
	|	Справочник.НомераСчетовФактур КАК НомераСчетовФактур
	|ГДЕ
	|	НомераСчетовФактур.Код = &Код
	|	И (НомераСчетовФактур.ВидДокумента = ""СчетФактураВыданный""
	|			ИЛИ НомераСчетовФактур.ВидДокумента = """")";
	
	Запрос.УстановитьПараметр("Код", ГодЭтогоДокумента);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		
		НовЭлемент = Справочники.НомераСчетовФактур.СоздатьЭлемент();
		НовЭлемент.Код = ГодЭтогоДокумента;
		НовЭлемент.ВидДокумента = "СчетФактураВыданный";
		НовЭлемент.Записать();
		МаксимальныйНомер = 0;
		
	Иначе
		
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			МаксимальныйНомер = Выборка.МаксимальныйНомер;
			Прервать;
			
		КонецЦикла;
		
	КонецЕсли;
	
	СтруктураСНомеромСчетфактуры.Вставить("МаксимальныйНомер", МаксимальныйНомер);
	
	Макс =  МаксимальныйНомер + 1;
	Макс  = СтрЗаменить(Строка(Макс), Символы.НПП, "");
	ТекущаяБаза = Константы.База.Получить();                 
	
	Если ТекущаяБаза = Перечисления.НазваниеБазы.Самара 
		ИЛИ ТекущаяБаза = Перечисления.НазваниеБазы.НабережныеЧелны 
		ИЛИ ТекущаяБаза = Перечисления.НазваниеБазы.Воронеж2 Тогда                           
		Номер = Прав("0000000" + Макс + "/01", 11);
	ИначеЕсли  ТекущаяБаза = Перечисления.НазваниеБазы.Владимир 
		ИЛИ ТекущаяБаза = Перечисления.НазваниеБазы.Казань2 
		ИЛИ ТекущаяБаза = Перечисления.НазваниеБазы.Липецк Тогда
		Номер = Прав("0000000" + Макс + "/02", 11);
	ИначеЕсли  ТекущаяБаза = Перечисления.НазваниеБазы.Рязань 
		ИЛИ ТекущаяБаза = Перечисления.НазваниеБазы.Чебоксары
		ИЛИ ТекущаяБаза = Перечисления.НазваниеБазы.Тамбов Тогда
		Номер = Прав("0000000" + Макс + "/03", 11);	
	ИначеЕсли  ТекущаяБаза = Перечисления.НазваниеБазы.Тула
		ИЛИ ТекущаяБаза = Перечисления.НазваниеБазы.Ульяновск Тогда
		Номер = Прав("0000000" + Макс + "/04", 11);	
	ИначеЕсли  ТекущаяБаза = Перечисления.НазваниеБазы.Ярославль
		ИЛИ ТекущаяБаза = Перечисления.НазваниеБазы.Альметьевск Тогда
		Номер = Прав("0000000" + Макс + "/05", 11);		
	ИначеЕсли  ТекущаяБаза = Перечисления.НазваниеБазы.Калуга Тогда
		Номер = Прав("0000000" + Макс + "/06", 11);		
	ИначеЕсли  ТекущаяБаза = Перечисления.НазваниеБазы.Молодогвардейская Тогда
		Номер = Прав("0000000" + Макс + "/07", 11);	
	ИначеЕсли  ТекущаяБаза = Перечисления.НазваниеБазы.ЮГ Тогда
		Номер = Прав("0000000" + Макс + "/08", 11);	
	ИначеЕсли  ТекущаяБаза = Перечисления.НазваниеБазы.Тверь Тогда
		Номер = Прав("0000000" + Макс + "/09", 11);	
	ИначеЕсли  ТекущаяБаза = Перечисления.НазваниеБазы.Север Тогда
		Номер = Прав("0000000" + Макс + "/10", 11);	
	ИначеЕсли  ТекущаяБаза = Перечисления.НазваниеБазы.Восток Тогда
		Номер = "УТ" + Прав("0000000" + Макс, 9);
	Иначе
		
		Префикс = СокрЛП(Константы.ОсновнаяОрганизация.Получить().Префикс);
		ОбщегоНазначения.ДобавитьПрефиксУзла(Префикс);
		ДлинаНомера = 11;
		Номер = Префикс + Прав("0000000000" + Макс, ДлинаНомера - СтрДлина(Префикс));   
		
	КонецЕсли;
	
	СтруктураСНомеромСчетфактуры.Вставить("Номер", Номер);
	Возврат СтруктураСНомеромСчетфактуры ;
	
КонецФункции

Функция ВернутьНомерРеализацииТоваровУслуг(Дата, Организация) Экспорт 
	
	СтруктураСНомеромРТУ = Новый Структура;
	ГодЭтогоДокумента = Год(Дата);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НомераСчетовФактур.МаксимальныйНомер
	|ИЗ
	|	Справочник.НомераСчетовФактур КАК НомераСчетовФактур
	|ГДЕ
	|	НомераСчетовФактур.Код = &Код
	|	И (НомераСчетовФактур.ВидДокумента = ""РеализацияТоваровУслуг"")";
	
	Запрос.УстановитьПараметр("Код", ГодЭтогоДокумента);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		
		НовЭлемент = Справочники.НомераСчетовФактур.СоздатьЭлемент();
		НовЭлемент.Код = ГодЭтогоДокумента;
		НовЭлемент.ВидДокумента = "РеализацияТоваровУслуг";
		НовЭлемент.Записать();
		МаксимальныйНомер = 0;
		
	Иначе
		
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			МаксимальныйНомер = Выборка.МаксимальныйНомер;
			Прервать;
			
		КонецЦикла;
		
	КонецЕсли;
	
	СтруктураСНомеромРТУ.Вставить("МаксимальныйНомер", МаксимальныйНомер);
	
	Макс = МаксимальныйНомер + 1;
	Макс = СтрЗаменить(Строка(Макс), Символы.НПП, "");
	
	Префикс = СокрЛП(Организация.Префикс);
	ОбщегоНазначения.ДобавитьПрефиксУзла(Префикс);
	ДлинаНомера = 11;
	
	Номер = Префикс + Прав("0000000000" + Макс,ДлинаНомера - СтрДлина(Префикс));
	
	СтруктураСНомеромРТУ.Вставить("Номер", Номер);
	
	Возврат СтруктураСНомеромРТУ;
	
КонецФункции

