			|	КорректировкаДолгаСуммыДолга.Ссылка
			|ИЗ
			|	Документ.КорректировкаДолга.СуммыДолга КАК КорректировкаДолгаСуммыДолга
			|ГДЕ
			|	КорректировкаДолгаСуммыДолга.ДокументРасчетовСКонтрагентом = &ДокументРасчетовСКонтрагентом
			|	И КорректировкаДолгаСуммыДолга.ВидЗадолженности = &ВидЗадолженности
			|	И КорректировкаДолгаСуммыДолга.Ссылка.Проведен
			|	И КорректировкаДолгаСуммыДолга.Ссылка.КорректировкаЗадолженностиПоПремии";
			
			Запрос.УстановитьПараметр("ВидЗадолженности", Перечисления.ВидыЗадолженности.Дебиторская);
			Запрос.УстановитьПараметр("ДокументРасчетовСКонтрагентом", Реализация);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
				КорректировкаОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
				ПечДокАкт = КорректировкаОбъект.ПечатьАктаРасчетаПремии();
				УниверсальныеМеханизмы.НапечататьДокумент(ПечДокАкт, 2, СразуНаПринтер, 
				ОбщегоНазначения.СформироватьЗаголовокДокумента(КорректировкаОбъект), КорректировкаОбъект.Ссылка);
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если ДокОбъект.ТаксиДоставка Тогда
			
			ПечДокЧек = ДокОбъект.ПечатьАктаПриемаПередачиТаксиДоставка();
			УниверсальныеМеханизмы.НапечататьДокумент(ПечДокЧек, 2, СразуНаПринтер, ОбщегоНазначения.СформироватьЗаголовокДокумента(ДокОбъект), ДокОбъект.Ссылка);				
			
		КонецЕсли;			
		
		Если ОтправлятьПоПочте Тогда 
			
			ТекГрузополучатель = Реализация.Грузополучатель; 
			
			Если ЗначениеЗаполнено(ТекГрузополучатель) И 
				(ТекГрузополучатель.ОтправлятьСчетФактуруПоПочте ИЛИ ТекГрузополучатель.ОтправлятьСчетПоПочте
