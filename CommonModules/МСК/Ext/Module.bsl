							МСК.ОтправитьПечатныеФормыПоЭП(Реализация); 					
						КонецЕсли;							
						
						Если НЕ СтруктураДляОтравки.ОтправлятьСчетФактуруПоПочте ИЛИ НЕ ПечатьУПД Тогда 
							ПечДокСФ = Неопределено;
						Иначе
							
							Если ТекГрузополучатель.ВидОтправляемойСФ <> Перечисления.ВидСчетФактурыДляКонтрагента.УПД 
								И ТекГрузополучатель.ВидОтправляемойСФ <> Перечисления.ВидСчетФактурыДляКонтрагента.УПДИКодПроизводителя 
								И ТекГрузополучатель.ВидОтправляемойСФ <> Перечисления.ВидСчетФактурыДляКонтрагента.ИзСохраненныхНастроек Тогда 
								
								ТекОбъектСФ = СчетФактура.ПолучитьОбъект();
								ПечДокСФ = ТекОбъектСФ.ПечатьСчетФактуру(СчетФактура); 		
								
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЕсли;

					Если СтруктураДляОтравки.ОтправлятьСчетПоПочте Тогда  
						ПечДокСчет = ДокОбъект.НовыйСчет();
					Иначе
						ПечДокСчет = Неопределено;
					КонецЕсли;
					
					Если НЕ СтруктураДляОтравки.ОтправлятьТорг12ПоПочте ИЛИ НЕ ПечатьТорг12 Тогда 
						ПечДокТорг12 = Неопределено;
					КонецЕсли;
					
					КодОтправки = ОправитьПоЭлектроннойПочте(СтруктураДляОтравки, ПечДокСФ, ПечДокСчет, Истина, ПечДокТорг12);
					
					Если КодОтправки <> "" Тогда 
						Сообщить(КодОтправки); 
					Иначе
						Если СтруктураДляОтравки.Свойство("МассивТабДокКорректСчФк") Тогда
							
							Если НЕ СтруктураДляОтравки.МассивТабДокКорректСчФк.Количество() = 0 Тогда
								
								Для Каждого СтрокаЗаголовковУКД Из СтруктураДляОтравки.МассивТабДокКорректСчФк Цикл  
									
									РСМенеджерЗаписи = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
									РСМенеджерЗаписи.Объект = СтрокаЗаголовковУКД.Ключ.Ссылка;
									РСМенеджерЗаписи.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.ОтправленоПоЭлПочте;		
									РСМенеджерЗаписи.Значение = Истина;
									РСМенеджерЗаписи.Записать(Истина);										
									
								КонецЦикла;			
								
