Функция ОправитьПоЭлектроннойПочте(СтруктураДляОтравки,ТабДокументСФ, ТабДокументСчет = Неопределено, ВыводитьСообщениеОбОтправке = Ложь, 
	                               ТабДокументТорг12 = Неопределено, ТабДокументТоварныйЧек = Неопределено)  Экспорт
	
	УчетнаяЗапись = Константы.ОсновнаяУчетнаяЗаписьЭлектроннойПочты.Получить();
	
	Если  Константы.НеОтправлятьПочту.Получить() ИЛИ НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		Возврат "";
	КонецЕсли;
	
	Если ТабДокументСФ = Неопределено И ТабДокументСчет = Неопределено И ТабДокументТорг12 = Неопределено
		И ТабДокументТоварныйЧек = Неопределено Тогда 
		Возврат "";		
	КонецЕсли;	
	
	// СФ
	Если ТабДокументСФ <> Неопределено Тогда 
		
		ТабДокументСФ.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
		ТабДокументСФ.ПолеСверху = 13;
		ТабДокументСФ.ПолеСлева  = 0;
		ТабДокументСФ.ПолеСнизу  = 0;
		ТабДокументСФ.ПолеСправа = 0;
		
		ТабДокументСФ.ВерхнийКолонтитул.Выводить          = Истина;
		ТабДокументСФ.ВерхнийКолонтитул.НачальнаяСтраница = 2;
		ТабДокументСФ.ВерхнийКолонтитул.ВертикальноеПоложение = ВертикальноеПоложение.Низ;
		ТабДокументСФ.ВерхнийКолонтитул.ТекстСправа  = "Лист [&НомерСтраницы]";
		
		ТабДокументСФ.Записать(СтруктураДляОтравки.ЗаголовокФайла,СтруктураДляОтравки.ТипФайлаТабДок); 
		
	КонецЕсли;
	
	Если ТабДокументСчет <> Неопределено Тогда 
		ТабДокументСчет.Записать(СтруктураДляОтравки.ЗаголовокФайлаСчет,СтруктураДляОтравки.ТипФайлаСчетТабДок); 
	КонецЕсли;
	
	Если ТабДокументТорг12 <> Неопределено Тогда 
		ТабДокументТорг12.Записать(СтруктураДляОтравки.ЗаголовокФайлаТорг12,СтруктураДляОтравки.ТипФайлаТорг12ТабДок); 
	КонецЕсли;
	
	Если ТабДокументТоварныйЧек<>Неопределено Тогда
		ТабДокументТоварныйЧек.Записать(СтруктураДляОтравки.ЗаголовокФайлаТоварныйЧек,СтруктураДляОтравки.ТипФайлаТоварныйЧек);  
	КонецЕсли;
	
	Профиль = УправлениеЭлектроннойПочтой.ПолучитьИнтернетПочтовыйПрофиль(УчетнаяЗапись);
	
	Сообщение = Новый ИнтернетПочтовоеСообщение;
	Сообщение.Тема = СтруктураДляОтравки.ТемаПисьма;
	МылоКонтрагента = "";
	
	МылоКонтрагента = СтруктураДляОтравки.Емэйл;
	
	МассивАдресов = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(СтруктураДляОтравки.Емэйл, ";");
	
	Почта = Новый ИнтернетПочта; 
	
	Попытка
		Почта.Подключиться(Профиль);
	Исключение
		
		ЗаписьЖурналаРегистрации("Отправка электронной почты.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, "Не удалось подключиться к почтовому серверу. " 
		+ Символы.ПС + ОписаниеОшибки());
		Возврат "Не сумел подключиться к почтовому серверу!"; 
		
	КонецПопытки;
	
	Для каждого ТекАдрес Из МассивАдресов Цикл
		Сообщение.Получатели.Добавить(ТекАдрес); 
	КонецЦикла;
	
	Сообщение.Отправитель = УчетнаяЗапись.АдресЭлектроннойПочты;
	
	Если ТабДокументСФ <> Неопределено Тогда 
		Сообщение.Вложения.Добавить(СтруктураДляОтравки.ЗаголовокФайла, СтруктураДляОтравки.ТипФайлаТабДок);
	КонецЕсли;
	
	Если ТабДокументСчет <> Неопределено Тогда 
		Сообщение.Вложения.Добавить(СтруктураДляОтравки.ЗаголовокФайлаСчет, СтруктураДляОтравки.ТипФайлаСчетТабДок);
	КонецЕсли;
	
	Если ТабДокументТорг12 <> Неопределено Тогда 
		Сообщение.Вложения.Добавить(СтруктураДляОтравки.ЗаголовокФайлаТорг12, СтруктураДляОтравки.ТипФайлаТорг12ТабДок);
	КонецЕсли;
	
	Если ТабДокументТоварныйЧек<>Неопределено Тогда
		Сообщение.Вложения.Добавить(СтруктураДляОтравки.ЗаголовокФайлаТоварныйЧек, СтруктураДляОтравки.ТипФайлаТоварныйЧек); 	
	КонецЕсли;

	Если СтруктураДляОтравки.Свойство("ЗаголовкиФайловУКД") Тогда
		
		Если НЕ СтруктураДляОтравки.ЗаголовкиФайловУКД.Количество() = 0 Тогда
			
			Для Каждого СтрокаЗаголовковУКД Из СтруктураДляОтравки.ЗаголовкиФайловУКД Цикл
				
				ТабДокУКД = СтрокаЗаголовковУКД.Значение;
				ТабДокУКД.Записать(СтрокаЗаголовковУКД.Ключ, СтруктураДляОтравки.ТипФайлаУКД);	
				Сообщение.Вложения.Добавить(СтрокаЗаголовковУКД.Ключ, СтруктураДляОтравки.ТипФайлаУКД);
				
			КонецЦикла;			
			
		КонецЕсли;		
		
	КонецЕсли;
	
	Если СтруктураДляОтравки.Свойство("ТекстПисьма") Тогда
		Сообщение.Тексты.Добавить(СтруктураДляОтравки.ТекстПисьма, ТипТекстаПочтовогоСообщения.HTML);
	КонецЕсли;
		
	Попытка
		
		Почта.Послать(Сообщение);
		
		ЗаписьЖурналаРегистрации("Отправка электронной почты.Успешно", УровеньЖурналаРегистрации.Информация,,, СтруктураДляОтравки.Сообщение); 
		СтатусВозврата = "";
		
	Исключение
		
		ЗаписьЖурналаРегистрации("Отправка электронной почты.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, "Не отправлено письмо на адрес " 
		+ СтруктураДляОтравки.Емэйл + Символы.ПС + ОписаниеОшибки());
		СтатусВозврата = ОписаниеОшибки(); 
		
	Конецпопытки;
	
	Сообщение.Получатели.Очистить();
	Сообщение.Вложения.Очистить();
	Почта.Отключиться();
	
	Если ВыводитьСообщениеОбОтправке Тогда 
		Сообщить(СтруктураДляОтравки.Сообщение, СтатусСообщения.Информация);
	КонецЕсли;
	
	Если ТабДокументСФ <> Неопределено Тогда 
		УдалитьФайлы(СтруктураДляОтравки.ЗаголовокФайла);
	КонецЕсли;
	
	Если ТабДокументСчет <> Неопределено Тогда
		УдалитьФайлы(СтруктураДляОтравки.ТипФайлаСчетТабДок);
	КонецЕсли;
	
	Если ТабДокументТорг12 <> Неопределено Тогда 
		УдалитьФайлы(СтруктураДляОтравки.ТипФайлаТорг12ТабДок);
	КонецЕсли; 
	
	Если СтруктураДляОтравки.Свойство("ЗаголовкиФайловУКД") Тогда
		
		Если НЕ СтруктураДляОтравки.ЗаголовкиФайловУКД.Количество() = 0 Тогда
			
			Для Каждого СтрокаЗаголовковУКД Из СтруктураДляОтравки.ЗаголовкиФайловУКД Цикл
				УдалитьФайлы(СтрокаЗаголовковУКД.Ключ);
			КонецЦикла;			
			
		КонецЕсли;		
		
	КонецЕсли;
	
	Возврат СтатусВозврата;
	
КонецФункции  

Процедура ДополнитьСтруктуруДляОтправкиПоСобытию(СтруктураДляОтправки, Событие = Неопределено, Контрагент = Неопределено) Экспорт

	ТекстПисьма = "";

	Если ЗначениеЗаполнено(Событие) Тогда  
		
		Рассылка = Справочники.МТ_ПредопределенныеЗначения.ПолучитьЗначениеПоСвойству(Справочники.МТ_ПредопределенныеЗначения.Рассылки , Событие); 
		
		Если ЗначениеЗаполнено(Рассылка) И ТипЗнч(Рассылка) = Тип("СправочникСсылка.ПЛ_События") Тогда
		
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ПЛ_УведомленияОСобытиях.Ссылка
			|ИЗ
			|	Справочник.ПЛ_УведомленияОСобытиях КАК ПЛ_УведомленияОСобытиях
			|ГДЕ
			|	НЕ ПЛ_УведомленияОСобытиях.ПометкаУдаления
			|	И ПЛ_УведомленияОСобытиях.Событие = &Событие";
			
			Запрос.УстановитьПараметр("Событие", Рассылка);
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			Пока Выборка.Следующий() Цикл  
				
				ТекстПисьма = ТекстПисьма + Выборка.Ссылка.ТекстСообщения + Символы.ПС + Символы.ПС;	
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ТекстПисьма) Тогда
		
		Если СтруктураДляОтправки.Свойство("ТекстПисьма") Тогда
			СтруктураДляОтправки.ТекстПисьма = СтруктураДляОтправки.ТекстПисьма + Символы.ПС + ТекстПисьма;
		Иначе
			СтруктураДляОтправки.Вставить("ТекстПисьма", ТекстПисьма);
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры 

Функция НапечататьКомплектДокументов(СтруктураДляПечати) Экспорт
	
	Реализация 						= СтруктураДляПечати.Реализация;
	СчетФактура 					= СтруктураДляПечати.СчетФактура;
	База 							= СтруктураДляПечати.База;
	КолЭкз 							= СтруктураДляПечати.КолЭкз;
	СразуНаПринтер 					= СтруктураДляПечати.СразуНаПринтер;
	ПечатьУПД 						= СтруктураДляПечати.ПечатьУПД;
	ПечатьСчета 					= СтруктураДляПечати.ПечатьСчета;
	ПечатьТорг12 					= СтруктураДляПечати.ПечатьТорг12;
	ОтправлятьПоПочте 				= СтруктураДляПечати.ОтправлятьПоПочте;
	ПечатьАктРасчетаПремииПоРекламе = СтруктураДляПечати.ПечатьАктРасчетаПремииПоРекламе;
	ПечатьКорректСчФк               = СтруктураДляПечати.ПечатьКорректСчФк;
	ПечатьТТН                       = СтруктураДляПечати.ПечатьТТН; 
	КолвоЭкзТТН						= СтруктураДляПечати.КолвоЭкзТТН;
	ГрузополучательПризнакПечатиТТН = СтруктураДляПечати.ГрузополучательПризнакПечатиТТН; 
	
	ПечатьТранзитЧерезТомилино 		= СтруктураДляПечати.ПечатьТранзитЧерезТомилино;
	
	Если СтруктураДляПечати.Свойство("ПечатьКорректировкиСборки") Тогда
		ПечатьКорректировкиСборки = СтруктураДляПечати.ПечатьКорректировкиСборки;
	Иначе
		ПечатьКорректировкиСборки = Ложь;
	КонецЕсли;      
	
	Если СтруктураДляПечати.Свойство("ОтветственныйКорректировкаСборки") Тогда
		ОтветственныйКорректировкаСборки = СтруктураДляПечати.ОтветственныйКорректировкаСборки;
	Иначе
		ОтветственныйКорректировкаСборки = Ложь;
	КонецЕсли;       
	
	Если СтруктураДляПечати.Свойство("ЕстьКорректировкиСборки") Тогда
		ЕстьКорректировкиСборки = СтруктураДляПечати.ЕстьКорректировкиСборки;
	Иначе
		ЕстьКорректировкиСборки = Ложь;
	КонецЕсли;
	
	Если СтруктураДляПечати.Свойство("ПечатьЗаявкиНаВозврат") Тогда
		ПечатьЗаявкиНаВозврат = СтруктураДляПечати.ПечатьЗаявкиНаВозврат;
	Иначе
		ПечатьЗаявкиНаВозврат = Ложь;
	КонецЕсли;
	
	//+Сёмин Р. 24.02.2026 #UT10-5691
	Если СтруктураДляПечати.Свойство("ПечатьЗаявкиНаПеревозкуГрузов") Тогда
		ПечатьЗаявкиНаПеревозкуГрузов = СтруктураДляПечати.ПечатьЗаявкиНаПеревозкуГрузов;
	Иначе
		ПечатьЗаявкиНаПеревозкуГрузов = Ложь;
	КонецЕсли;
	//-Сёмин Р. 24.02.2026 #UT10-5691
	
	//+Сёмин Р.И. 18.08.2026 #UT10-6010
	Если СтруктураДляПечати.Свойство("НеПечататьУПДГрузополучателю") Тогда
		НеПечататьУПДГрузополучателю = СтруктураДляПечати.НеПечататьУПДГрузополучателю;
	Иначе
		НеПечататьУПДГрузополучателю = Ложь;
	КонецЕсли;
	//-Сёмин Р.И. 18.08.2026 #UT10-6010
   
	ДокОбъект = Реализация.ПолучитьОбъект(); 
	
	ПечДокСФ = Неопределено;
	ПечДокСчет = Неопределено;       
	
	
	ОрганизацияМСК = Константы.ОсновнаяОрганизацияДляОплатыНаличнымиДляВодителей.Получить();
	
	Если (Реализация.Организация = ОрганизацияМСК 
		И 
		(База = Перечисления.НазваниеБазы.Казань
		ИЛИ База = Перечисления.НазваниеБазы.Воронеж
		ИЛИ База = Перечисления.НазваниеБазы.Молодогвардейская
		ИЛИ База = Перечисления.НазваниеБазы.ЮГ
		ИЛИ База = Перечисления.НазваниеБазы.Север
		ИЛИ База = Перечисления.НазваниеБазы.Восток
		ИЛИ База = Перечисления.НазваниеБазы.Ростов
		ИЛИ База = Перечисления.НазваниеБазы.Краснодар
		ИЛИ База = Перечисления.НазваниеБазы.Краснодар2
		ИЛИ База = Перечисления.НазваниеБазы.НижнийНовгород
		ИЛИ База = Перечисления.НазваниеБазы.НабережныеЧелны))
		ИЛИ Реализация.ДоговорКонтрагента.РозничнаяПродажа
		ИЛИ Реализация.ДоговорКонтрагента.ЛицевойСчет Тогда 
		
		Если Константы.ОбъединятьТоварныеЧекиПриПечати.Получить() Тогда
			
			ПечДокЧек = ДокОбъект.Чек(Ложь, Ложь, КолЭкз);
			
			//+Сёмин Р.И. 19.08.2026 #UT10-6010
			//УниверсальныеМеханизмы.НапечататьДокумент(ПечДокЧек, 1, СразуНаПринтер, ОбщегоНазначения.СформироватьЗаголовокДокумента(ДокОбъект), ДокОбъект.Ссылка);
			
			Если НЕ НеПечататьУПДГрузополучателю Тогда
				УниверсальныеМеханизмы.НапечататьДокумент(ПечДокЧек, 1, СразуНаПринтер, ОбщегоНазначения.СформироватьЗаголовокДокумента(ДокОбъект), ДокОбъект.Ссылка);
			КонецЕсли;
			//-Сёмин Р.И. 19.08.2026 #UT10-6010
			
		Иначе
			
			ПечДокЧек = ДокОбъект.Чек();
			
			//+Сёмин Р.И. 19.08.2026 #UT10-6010
			//УниверсальныеМеханизмы.НапечататьДокумент(ПечДокЧек, КолЭкз, СразуНаПринтер, ОбщегоНазначения.СформироватьЗаголовокДокумента(ДокОбъект), ДокОбъект.Ссылка);
			
			Если НЕ НеПечататьУПДГрузополучателю Тогда
				УниверсальныеМеханизмы.НапечататьДокумент(ПечДокЧек, КолЭкз, СразуНаПринтер, ОбщегоНазначения.СформироватьЗаголовокДокумента(ДокОбъект), ДокОбъект.Ссылка);
			КонецЕсли;
			//-Сёмин Р.И. 19.08.2026 #UT10-6010
			
		КонецЕсли;
		
		Если ПечатьКорректСчФк И Константы.ДатаОтсчетаНачалаПечатиКорректСчФк.Получить() <> Дата('00010101') Тогда
			
			//+Гавриленков В. 22.05.2026 #
			//ТолькоОтметка = ЗначениеЗаполнено(Реализация.Грузополучатель.DS_Подразделение_ID) ИЛИ ЗначениеЗаполнено(Реализация.ДоговорКонтрагента.DS_Подразделение_ID);
			//РаспечататьКорректированыеСчетФактуры(ДокОбъект.Грузополучатель, СтруктураДляПечати, ТолькоОтметка);
			
			//+Сёмин Р.И. 08.09.2026 #UT10-6028
			//РаспечататьКорректированыеСчетФактуры(ДокОбъект.Грузополучатель, СтруктураДляПечати);
			РаспечататьКорректированыеСчетФактуры(ДокОбъект.Грузополучатель, СтруктураДляПечати, ДокОбъект.Грузополучатель.НеПечататьУКД);
			//-Сёмин Р.И. 08.09.2026 #UT10-6028
			
			//-Гавриленков В. 22.05.2026 #
			МассивТабДокКорректСчФк = ПолучитьКорректировочныеСчетаФактурыДляОтправки(ДокОбъект.Грузополучатель);	
			
		КонецЕсли; 						
		
		Если ПечатьТТН И Константы.ВключитьПечатьТТН.Получить() = Истина И 
			
			ГрузополучательПризнакПечатиТТН = Истина И ДокОбъект.Автомобиль <> Справочники.ТранспортныеСредства.ПустаяСсылка() Тогда
			РаспечататьТТН(ДокОбъект, СтруктураДляПечати);				
			
		КонецЕсли; 
		
		Если ДокОбъект.ТаксиДоставка Тогда
			
			ПечДокЧек = ДокОбъект.ПечатьАктаПриемаПередачиТаксиДоставка();
			УниверсальныеМеханизмы.НапечататьДокумент(ПечДокЧек, 2, СразуНаПринтер, ОбщегоНазначения.СформироватьЗаголовокДокумента(ДокОбъект), ДокОбъект.Ссылка);				
			
		КонецЕсли;			
		
		Если  НЕ ДокОбъект.БылаПечать  Тогда
			
			ДокОбъект.БылаПечать  = Истина;
			ДокОбъект.ОбменДанными.Загрузка = Истина;
			ДокОбъект.ДополнительныеСвойства.Вставить("НеФормироватьИсходящееСообщение");
			
			Попытка
				
				ДокОбъект.Записать();
				СтруктураДляПечати.Вставить("БылаПечать", Истина);
				
			Исключение
				
				Сообщить("Для документа " + Реализация + " не удалось установить признак 'Была печать'. Не удалось выполнить запись документа!");
				
			КонецПопытки;
			
		КонецЕсли; 
		
		Если ОтправлятьПоПочте Тогда 
			
			ТекГрузополучатель = Реализация.Грузополучатель;  
			
			Если  ((ЗначениеЗаполнено(Реализация.Грузополучатель.DS_Подразделение_ID) ИЛИ ЗначениеЗаполнено(Реализация.ДоговорКонтрагента.DS_Подразделение_ID)) 
				И МСК.ЭтоОбособленноеПодразделение() 
				И НЕ Константы.База.Получить() = Перечисления.НазваниеБазы.Ростов) Тогда
				 
				Если ЗначениеЗаполнено(ТекГрузополучатель) И 
					(ТекГрузополучатель.ОтправлятьСчетФактуруПоПочте ИЛИ ТекГрузополучатель.ОтправлятьСчетПоПочте
					ИЛИ ТекГрузополучатель.ОтправлятьТорг12ПоПочте) Тогда
					
					АдресЭлПочты = МСК.ПолучитьЭлектронныйАдрес(ТекГрузополучатель); 
					
					Если Не ПустаяСтрока(АдресЭлПочты)  Тогда
						
						СтруктураДляОтравки = СформироватьСтруктуруДляОтправкеПоПочте(АдресЭлПочты,
						ТекГрузополучатель,
						СчетФактура, 
						Реализация, 
						ПечатьУПД, 
						Истина, 
						ПечатьТорг12,
						МассивТабДокКорректСчФк);
						
						ДополнитьСтруктуруДляОтправкиПоСобытию(СтруктураДляОтравки, "Печать комплекта документов", ТекГрузополучатель);
						
						Если Реализация.Контрагент.ВместоУПДВысылатьДругуюФорму Тогда 
							
							ПечДокСФ = ДокОбъект.ПечатьДляКорсуна();
							ПечДокСФ_НаПечать = ДокОбъект.ПечатьУниверсальногоПередаточногоДокумента();
							
						Иначе
							
							Если НЕ Реализация.Грузополучатель.ПечататьТоварныйЧекБезЦенВместоУПД Тогда
								
								ПечДокСФ = ДокОбъект.ПечатьУниверсальногоПередаточногоДокумента();
								
								Если НЕ ПечДокСФ = Неопределено Тогда
									
									Если Реализация.Грузополучатель.ПечатьУПДВВертикальномФормате Тогда
										ПечДокСФ.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
									Иначе
										ПечДокСФ.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
									КонецЕсли;
									
								КонецЕсли; 
								
							Иначе
								ПечДокСФ = ДокОбъект.Чек(Ложь,Истина);
							КонецЕсли;
							
						КонецЕсли;
						
						Если ТекГрузополучатель.ОтправлятьСчетФактуруПоПочте Тогда
							
							Если Реализация.ДоговорКонтрагента.Розничнаяпродажа ИЛИ Реализация.ДоговорКонтрагента.ЛицевойСчет Тогда
								
								Если СтруктураДляОтравки.ОтправлятьТоварныйЧекПоПочте Тогда 
									
									ПечДокЧек = ДокОбъект.Чек(Ложь, Ложь, 1);
									ПечДокСФ = Неопределено;
									
								Иначе
									ПечДокЧек = Неопределено;
								КонецЕсли;
								
							Иначе
								
								Если ТекГрузополучатель.ОтправлятьСчетФактуруПоПочте И ПечатьУПД 
								   И ТекГрузополучатель.ВидОтправляемойСФ = Перечисления.ВидСчетФактурыДляКонтрагента.ИзСохраненныхНастроек Тогда
									МСК.ОтправитьПечатныеФормыПоЭП(Реализация);
								КонецЕсли;							
								
								Если НЕ СтруктураДляОтравки.ОтправлятьСчетФактуруПоПочте ИЛИ НЕ ПечатьУПД Тогда 
									ПечДокСФ = Неопределено;
								Иначе
									
									Если ТекГрузополучатель.ВидОтправляемойСФ <> Перечисления.ВидСчетФактурыДляКонтрагента.УПД 
									   И ТекГрузополучатель.ВидОтправляемойСФ <> Перечисления.ВидСчетФактурыДляКонтрагента.УПДИКодПроизводителя 
									   И ТекГрузополучатель.ВидОтправляемойСФ <> Перечисления.ВидСчетФактурыДляКонтрагента.ИзСохраненныхНастроек Тогда 
										
										ТекОбъектСФ = СчетФактура.ПолучитьОбъект();
										ПечДокСФ = ТекОбъектСФ.ПечатьСчетФактуру(СчетФактура); 		
										
									КонецЕсли;
									
								КонецЕсли;
								
							КонецЕсли;
							
						КонецЕсли;
						
						Если СтруктураДляОтравки.ОтправлятьСчетПоПочте Тогда 
							ПечДокСчет = ДокОбъект.НовыйСчет();
						Иначе
							ПечДокСчет = Неопределено;
						КонецЕсли;
						
						Если НЕ СтруктураДляОтравки.ОтправлятьТорг12ПоПочте ИЛИ НЕ ПечатьТорг12 Тогда 
							ПечДокТорг12 = Неопределено;
						КонецЕсли;
						
						КодОтправки = ОправитьПоЭлектроннойПочте(СтруктураДляОтравки,ПечДокСФ, ПечДокСчет, Истина, ПечДокТорг12, ПечДокЧек);
						
						Если КодОтправки<>"" Тогда 
							Сообщить(КодОтправки);
						Иначе
							
							Если СтруктураДляОтравки.Свойство("МассивТабДокКорректСчФк") Тогда
								
								Если НЕ СтруктураДляОтравки.МассивТабДокКорректСчФк.Количество() = 0 Тогда
									
									Для Каждого СтрокаЗаголовковУКД Из СтруктураДляОтравки.МассивТабДокКорректСчФк Цикл  
										
										РСМенеджерЗаписи = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
										РСМенеджерЗаписи.Объект = СтрокаЗаголовковУКД.Ключ.Ссылка;
										РСМенеджерЗаписи.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.ОтправленоПоЭлПочте;		
										РСМенеджерЗаписи.Значение = Истина;
										РСМенеджерЗаписи.Записать(Истина);										
										
									КонецЦикла;			
									
								КонецЕсли;		
								
							КонецЕсли;	
							
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли; 
				
			ИначеЕсли ЗначениеЗаполнено(ТекГрузополучатель) И ТекГрузополучатель.ОтправлятьСчетФактуруПоПочте 
			        И (Реализация.ДоговорКонтрагента.Розничнаяпродажа ИЛИ Реализация.ДоговорКонтрагента.ЛицевойСчет) Тогда
				
				АдресЭлПочты = МСК.ПолучитьЭлектронныйАдрес(ТекГрузополучатель); 
				
				Если Не ПустаяСтрока(АдресЭлПочты)  Тогда
					
					СтруктураДляОтравки = СформироватьСтруктуруДляОтправкеПоПочте(АдресЭлПочты,
					ТекГрузополучатель,
					СчетФактура, 
					Реализация, 
					Ложь, 
					Ложь, 
					Ложь,
					МассивТабДокКорректСчФк);    
					
					ДополнитьСтруктуруДляОтправкиПоСобытию(СтруктураДляОтравки, "Печать комплекта документов", ТекГрузополучатель);
					
					ПечДокЧек = ДокОбъект.Чек(Ложь, Ложь, 1);

					КодОтправки = ОправитьПоЭлектроннойПочте(СтруктураДляОтравки,ПечДокСФ, ПечДокСчет, Истина, ПечДокТорг12, ПечДокЧек);
					
					Если КодОтправки<>"" Тогда 
						Сообщить(КодОтправки);
					Иначе
						
						Если СтруктураДляОтравки.Свойство("МассивТабДокКорректСчФк") Тогда
							
							Если НЕ СтруктураДляОтравки.МассивТабДокКорректСчФк.Количество() = 0 Тогда
								
								Для Каждого СтрокаЗаголовковУКД Из СтруктураДляОтравки.МассивТабДокКорректСчФк Цикл  
									
									РСМенеджерЗаписи = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
									РСМенеджерЗаписи.Объект = СтрокаЗаголовковУКД.Ключ.Ссылка;
									РСМенеджерЗаписи.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.ОтправленоПоЭлПочте;		
									РСМенеджерЗаписи.Значение = Истина;
									РСМенеджерЗаписи.Записать(Истина);										
									
								КонецЦикла;			
								
							КонецЕсли;		
							
						КонецЕсли;	
						
					КонецЕсли;

				КонецЕсли;			
				
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		
		Если ПечатьУПД Тогда 
			
			Если СокрЛП(Реализация.Контрагент.ИНН) = "" Тогда 
				Сообщить("У контрагента " + Реализация.Контрагент + "по документу " + Реализация + " не заполнен ИНН! Печать УПД для контрагентов с незаполненным ИНН запрещена!");
			Иначе	
				
				Если Константы.ПечататьТоварныйЧекСУПД.Получить() Тогда
					
					ПечДокЧек = ДокОбъект.Чек();
					
					//+Сёмин Р.И. 07.09.2026 #UT10-6030
					//УниверсальныеМеханизмы.НапечататьДокумент(ПечДокЧек, 1, СразуНаПринтер, ОбщегоНазначения.СформироватьЗаголовокДокумента(ДокОбъект), ДокОбъект.Ссылка);
					
					Если НЕ НеПечататьУПДГрузополучателю Тогда
						УниверсальныеМеханизмы.НапечататьДокумент(ПечДокЧек, 1, СразуНаПринтер, ОбщегоНазначения.СформироватьЗаголовокДокумента(ДокОбъект), ДокОбъект.Ссылка);
					КонецЕсли;
					//-Сёмин Р.И. 07.09.2026 #UT10-6030
					
					Если ПечатьСчета Тогда 
						
						ПечДокСчет = ДокОбъект.НовыйСчет();
						
						//+Сёмин Р.И. 07.09.2026 #UT10-6030
						//УниверсальныеМеханизмы.НапечататьДокумент(ПечДокСчет, 1, СразуНаПринтер, ОбщегоНазначения.СформироватьЗаголовокДокумента(ДокОбъект), ДокОбъект.Ссылка);
						
						Если НЕ НеПечататьУПДГрузополучателю Тогда
							УниверсальныеМеханизмы.НапечататьДокумент(ПечДокСчет, 1, СразуНаПринтер, ОбщегоНазначения.СформироватьЗаголовокДокумента(ДокОбъект), ДокОбъект.Ссылка);
						КонецЕсли;
						//-Сёмин Р.И. 07.09.2026 #UT10-6030
						
					КонецЕсли;						
					
				КонецЕсли;
				
				Если Реализация.Контрагент.ВместоУПДВысылатьДругуюФорму Тогда 
					
					ПечДокСФ = ДокОбъект.ПечатьДляКорсуна();
					ПечДокСФ_НаПечать = ДокОбъект.ПечатьУниверсальногоПередаточногоДокумента();
					
				Иначе
					
					Если НЕ Реализация.Грузополучатель.ПечататьТоварныйЧекБезЦенВместоУПД Тогда
						
						ПечДокСФ = ДокОбъект.ПечатьУниверсальногоПередаточногоДокумента();
						
						Если НЕ ПечДокСФ = Неопределено Тогда
							
							Если Реализация.Грузополучатель.ПечатьУПДВВертикальномФормате Тогда
								ПечДокСФ.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
							Иначе
								ПечДокСФ.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
							КонецЕсли;
							
						КонецЕсли; 
						
					Иначе
						ПечДокСФ = ДокОбъект.Чек(Ложь, Истина);
					КонецЕсли;
					
				КонецЕсли;
				
				Для Х = 1 по КолЭкз Цикл
					
					//+Сёмин Р.И. 18.08.2026 #UT10-6010
					//Если Реализация.Контрагент.ВместоУПДВысылатьДругуюФорму Тогда 
					//	УниверсальныеМеханизмы.НапечататьДокумент(ПечДокСФ_НаПечать, 1, СразуНаПринтер, ОбщегоНазначения.СформироватьЗаголовокДокумента(ДокОбъект), ДокОбъект.Ссылка);
					//Иначе 
					//	УниверсальныеМеханизмы.НапечататьДокумент(ПечДокСФ, 1, СразуНаПринтер, ОбщегоНазначения.СформироватьЗаголовокДокумента(ДокОбъект), ДокОбъект.Ссылка);							
					//КонецЕсли;
					
					Если НЕ НеПечататьУПДГрузополучателю Тогда
						
						Если Реализация.Контрагент.ВместоУПДВысылатьДругуюФорму Тогда 
							УниверсальныеМеханизмы.НапечататьДокумент(ПечДокСФ_НаПечать, 1, СразуНаПринтер, ОбщегоНазначения.СформироватьЗаголовокДокумента(ДокОбъект), ДокОбъект.Ссылка);
						Иначе 
							УниверсальныеМеханизмы.НапечататьДокумент(ПечДокСФ, 1, СразуНаПринтер, ОбщегоНазначения.СформироватьЗаголовокДокумента(ДокОбъект), ДокОбъект.Ссылка);							
						КонецЕсли;
						
					КонецЕсли;
					//-Сёмин Р.И. 18.08.2026 #UT10-6010
					
				КонецЦикла;
				
				Если НЕ ДокОбъект.БылаПечать Тогда
					
					ДокОбъект.БылаПечать = Истина;
					ДокОбъект.ДополнительныеСвойства.Вставить("НеФормироватьИсходящееСообщение");
					ДокОбъект.ОбменДанными.Загрузка = Истина;
					
					Попытка
						
						ДокОбъект.записать();
						СтруктураДляПечати.Вставить("БылаПечать", Истина);
						
					Исключение
						Сообщить("Для документа " + Реализация + " не удалось установить признак 'Была печать'. Не удалось выполнить запись документа!");
					КонецПопытки;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если ПечатьТорг12 Тогда 
			
			ПечДокТорг12 = ДокОбъект.ПечатьТОРГ12();
			УниверсальныеМеханизмы.НапечататьДокумент(ПечДокТорг12, 1, СразуНаПринтер, ОбщегоНазначения.СформироватьЗаголовокДокумента(ДокОбъект), ДокОбъект.Ссылка);
			
