		ТабГруппыРассылок.Колонки.Добавить("ГруппаРассылок", Новый ОписаниеТипов("СправочникСсылка.КатегорииОбъектов"));
		ТабГруппыРассылок.Колонки.Добавить("Подключить",	 Новый ОписаниеТипов("Булево"));
		
		МассивСтрок = СформироватьМассивПоСвойству(ФабрикаСправочника, "ПодключениеКРассылкам", "Строка");
		
		Если МассивСтрок.Количество() > 0 Тогда
			
			Для Каждого Стр Из МассивСтрок Цикл 				
				
				НоваяСтрока = ТабГруппыРассылок.Добавить();
				ЗаполнитьСвойствоПоПоискуКодаМДМ("КатегорииОбъектов", НоваяСтрока, "ГруппаРассылок", Стр.ГруппаРассылок);
				НоваяСтрока.Подключить = Булево(Стр.Подключить);
				НоваяСтрока.ФизическоеЛицо = ?(СпрОбъект.ЭтоНовый(), СпрОбъект.ПолучитьСсылкуНового(), СпрОбъект.Ссылка);
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если СпрОбъект.ЭтоНовый() Тогда
			
			Для Каждого Строка Из ТабГруппыРассылок Цикл
				
				Если Строка.Подключить Тогда
					
					МЗ = РегистрыСведений.КатегорииОбъектов.СоздатьМенеджерЗаписи();
					МЗ.Объект = СпрОбъект.ПолучитьСсылкуНового();
					МЗ.Категория = Строка.ГруппаРассылок;
					МЗ.Записать();
					
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	ВЫРАЗИТЬ(ТабГруппыРассылок.ФизическоеЛицо КАК Справочник.ФизическиеЛица) КАК ФизическоеЛицо,
			|	ТабГруппыРассылок.ГруппаРассылок,
			|	ТабГруппыРассылок.Подключить
			|ПОМЕСТИТЬ ТабГруппыРассылок
			|ИЗ
			|	&ТабГруппыРассылок КАК ТабГруппыРассылок
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ТабГруппыРассылок.ФизическоеЛицо,
			|	ТабГруппыРассылок.ГруппаРассылок,
			|	ТабГруппыРассылок.Подключить КАК ПодключитьСтало,
			|	ЛОЖЬ КАК ПодключитьБыло
			|ПОМЕСТИТЬ втГруппыРассылок
			|ИЗ
			|	ТабГруппыРассылок КАК ТабГруппыРассылок
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	КатегорииОбъектов.Объект,
			|	КатегорииОбъектов.Категория,
			|	ИСТИНА,
			|	ИСТИНА
			|ИЗ
			|	РегистрСведений.КатегорииОбъектов КАК КатегорииОбъектов
			|ГДЕ
			|	КатегорииОбъектов.Объект = &ФизическоеЛицо
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	втГруппыРассылок.ФизическоеЛицо,
			|	втГруппыРассылок.ГруппаРассылок,
			|	МАКСИМУМ(втГруппыРассылок.ПодключитьСтало) КАК ПодключитьСтало,
			|	МАКСИМУМ(втГруппыРассылок.ПодключитьБыло) КАК ПодключитьБыло
			|ИЗ
			|	втГруппыРассылок КАК втГруппыРассылок
			|
			|СГРУППИРОВАТЬ ПО
			|	втГруппыРассылок.ФизическоеЛицо,
			|	втГруппыРассылок.ГруппаРассылок";
			
			Запрос.УстановитьПараметр("ТабГруппыРассылок", ТабГруппыРассылок.Скопировать());
			Запрос.УстановитьПараметр("ФизическоеЛицо", СпрОбъект.Ссылка);
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				Если Не Выборка.ПодключитьСтало и Выборка.ПодключитьБыло Тогда
					
					НаборЗаписей = РегистрыСведений.КатегорииОбъектов.СоздатьНаборЗаписей();
					НаборЗаписей.Отбор.Объект.Установить(СпрОбъект.Ссылка);
					НаборЗаписей.Отбор.Категория.Установить(Выборка.ГруппаРассылок);
					НаборЗаписей.Записать();
					
				ИначеЕсли Выборка.ПодключитьСтало и Не Выборка.ПодключитьБыло Тогда
					
					МЗ = РегистрыСведений.КатегорииОбъектов.СоздатьМенеджерЗаписи();
					МЗ.Объект = СпрОбъект.Ссылка;
					МЗ.Категория = Выборка.ГруппаРассылок;
					МЗ.Записать();
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;

	ИначеЕсли ИмяОбъектаМетаданных = "БанковскиеСчетаКонтрагентов" Тогда
		
		СпрОбъект.Наименование = ФабрикаСправочника.Наименование;
		СпрОбъект.НомерСчета = ФабрикаСправочника.НомерСчета;
		
