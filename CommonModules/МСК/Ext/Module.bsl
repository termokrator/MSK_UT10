//  Процедуры работы с таб.частью ТОХ

Функция ЗаполнитьТЧТОХ(ДокОбъект, тзТОХНовый, мСклад = Неопределено, ЗадаватьВопрос = Истина) Экспорт
	
	#Если Клиент Тогда
	Если ЗадаватьВопрос И РольДоступна("ТОХ_ПолныеПрава") Тогда
		
		Ответ = Вопрос("Перезаполнить данные на вкладке ТОХ?", РежимДиалогаВопрос.ДаНет, 0);
		
		Если Ответ = КодВозвратаДиалога.Нет Тогда
			Возврат Ложь;
		КонецЕсли;
		
	КонецЕсли;
	#КонецЕсли
	
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ТребованиеНакладная") Тогда 
		ТаблТоваров = ДокОбъект.Материалы.Выгрузить();
	Иначе
		ТаблТоваров = ДокОбъект.Товары.Выгрузить();
	КонецЕсли;     
	
	тзТОХНовый.Очистить();
	
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.КорректировкаПоступления") Тогда  
		ТаблТоваров.Свернуть("Номенклатура, СерияНоменклатуры", "Количество, КоличествоДоИзменения");
	Иначе	          
		
		ТаблТоваров.Свернуть("Номенклатура, СерияНоменклатуры", "Количество");   
		ТаблТоваров.Колонки.Добавить("КоличествоДоИзменения", 	Новый ОписаниеТипов("Число")); 
		
	КонецЕсли;
	
	ТаблТоваров.Колонки.Добавить("Распределить", 			Новый ОписаниеТипов("Булево"));
	ТаблТоваров.Колонки.Добавить("КоличествоРаспределить", 	Новый ОписаниеТипов("Число"));
	
	МассивТоваров = ТаблТоваров.ВыгрузитьКолонку("Номенклатура");     
	
	Запрос = Новый Запрос;  
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = ТекстЗапросаЗаполнитьТЧТОХ(); 
		
	Запрос.УстановитьПараметр("МассивТоваров", 	МассивТоваров);
	Запрос.УстановитьПараметр("Дата", 			Новый Граница(ДокОбъект.Дата, ВидГраницы.Исключая)); 
	Запрос.УстановитьПараметр("Склад",          ?(мСклад = Неопределено, Константы.ОсновнойСклад.Получить(), мСклад));
	
	Запрос.Выполнить();
	ОбщиеОстаткиТОХ   = Запрос.МенеджерВременныхТаблиц.Таблицы["ВТ_ОстаткиТОХ_ПоНоменклатуре"].ПолучитьДанные().Выгрузить();
	ОстаткиТОХПоСерии = Запрос.МенеджерВременныхТаблиц.Таблицы["ВТ_ОстаткиТОХ_ПоСериям"].ПолучитьДанные().Выгрузить(); 
	
	Если ОбщиеОстаткиТОХ.Количество() > 0 Тогда  
		
		//итерации распределения
		//1. по серии, с учетом общего количества, и определение в дальнейшее распределение на другие серии  
		
		Для Каждого СтрокаТовар Из ТаблТоваров Цикл
			
			СтрукПоискОбщие 	= Новый Структура("Номенклатура", СтрокаТовар.Номенклатура);
			МассивСтрокОбщие 	= ОбщиеОстаткиТОХ.НайтиСтроки(СтрукПоискОбщие);
			
			Если МассивСтрокОбщие.Количество() = 0 Тогда  
				Продолжить;
			КонецЕсли;
				
			ОстаткиОбщие = МассивСтрокОбщие[0];
			
			Если Не ОстаткиОбщие.ВсегоДоступноТОХ > 0 Тогда 
				Продолжить;
			КонецЕсли;
					
			Если СтрокаТовар.КоличествоДоИзменения > 0 Тогда // для документа КорректировкаПоступления
				СтрокаТовар.КоличествоРаспределить = СтрокаТовар.КоличествоДоИзменения - СтрокаТовар.Количество;
			Иначе
				СтрокаТовар.КоличествоРаспределить = СтрокаТовар.Количество;
			КонецЕсли;	
			
			//учет собственного Товара не участвующий в распределении
			СобственныйТовар =  Мин(СтрокаТовар.КоличествоРаспределить, Макс(0, ОстаткиОбщие.СобственныйОстаток)); 
			
			СтрокаТовар.КоличествоРаспределить 	= СтрокаТовар.КоличествоРаспределить - СобственныйТовар; 
			СтрокаТовар.Распределить 			= СтрокаТовар.КоличествоРаспределить > 0; 
			
			//Учтем распределение собственного количества, если по серии не найдет, в распределении по прочим уйдет меньше количество
			ОстаткиОбщие.СобственныйОстаток 	= ОстаткиОбщие.СобственныйОстаток - СобственныйТовар;
								
			Если Не СтрокаТовар.Распределить Тогда 
				Продолжить;
			КонецЕсли;
				
			СтрукПоискСерия  = Новый Структура("Номенклатура, СерияНоменклатуры", СтрокаТовар.Номенклатура, СтрокаТовар.СерияНоменклатуры);
			МассивСтрокСерия = ОстаткиТОХПоСерии.НайтиСтроки(СтрукПоискСерия);   
			
			Если МассивСтрокСерия.Количество() = 0 Тогда 
				Продолжить;
			КонецЕсли;
						
			ОстаткиПоСерии = МассивСтрокСерия[0];       
			
			СкорректироватьДоступноТОХПоСерии(ОстаткиОбщие, ОстаткиПоСерии, СтрокаТовар.КоличествоРаспределить);   
			
			КоличествоТОХПоСерии = Мин(макс(ОстаткиОбщие.ВсегоДоступноТОХ, 0), Макс(0, ОстаткиПоСерии.ДоступноТОХПоСерии));   
			
			Если Не КоличествоТОХПоСерии > 0 Тогда 
				Продолжить;
			КонецЕсли;
			
			МожноРаспределить = Мин(КоличествоТОХПоСерии, СтрокаТовар.КоличествоРаспределить); 
			
			Если Не МожноРаспределить > 0 Тогда 
				Продолжить;
			КонецЕсли;
			
			НоваяСтрокаТох = тзТОХНовый.Добавить();
			НоваяСтрокаТох.Номенклатура			= СтрокаТовар.Номенклатура; 
			НоваяСтрокаТох.СерияНоменклатуры	= СтрокаТовар.СерияНоменклатуры; 
			НоваяСтрокаТох.Количество			= МожноРаспределить;
			НоваяСтрокаТох.ЕдиницаИзмерения 	= НоваяСтрокаТох.Номенклатура.ЕдиницаХраненияОстатков;
			НоваяСтрокаТох.Коэффициент 			= НоваяСтрокаТох.ЕдиницаИзмерения.Коэффициент;  
			
			//учет распределенного
			СтрокаТовар.КоличествоРаспределить 	= СтрокаТовар.КоличествоРаспределить - МожноРаспределить;
			СтрокаТовар.Распределить 			= СтрокаТовар.КоличествоРаспределить > 0;
			
			//Учет распределения 
			ОстаткиПоСерии.ДоступноТОХПоСерии 	= ОстаткиПоСерии.ДоступноТОХПоСерии - МожноРаспределить;        
			ОстаткиОбщие.ВсегоДоступноТОХ		= ОстаткиОбщие.ВсегоДоступноТОХ - МожноРаспределить;		
												
			//КонецЕсли;   
						
		КонецЦикла;  
		
		//распределение на другие серии ТОХ
		СтукрПоискРаспределения  = Новый Структура("Распределить", Истина);
		МассивСтрокРаспределения = ТаблТоваров.Скопировать(СтукрПоискРаспределения);   
		МассивСтрокРаспределения.Свернуть("Номенклатура", "КоличествоРаспределить");
		
		Для Каждого ТоварТОХ Из МассивСтрокРаспределения Цикл 
			
			ВсегоДоступноТОХ 	= 0;
			ОстаткиОбщие 		= Неопределено;
			
			СтрукПоискОбщие 	= Новый Структура("Номенклатура", ТоварТОХ.Номенклатура);
			МассивСтрокОбщие 	= ОбщиеОстаткиТОХ.НайтиСтроки(СтрукПоискОбщие);
			
			Если МассивСтрокОбщие.Количество() > 0 Тогда 
				
				ОстаткиОбщие 	 = МассивСтрокОбщие[0];
				ВсегоДоступноТОХ = ОстаткиОбщие.ВсегоДоступноТОХ;
				
			КонецЕсли;	
			
			Распределить = Мин(ТоварТОХ.КоличествоРаспределить, Макс(0, ВсегоДоступноТОХ));
			
			Если Не Распределить > 0 Тогда 
				Продолжить;
			КонецЕсли;
				
			СтрутураОтбора = Новый Структура("Номенклатура", ТоварТОХ.Номенклатура);
			МассивСтрокТОХ = ОстаткиТОХПоСерии.НайтиСтроки(СтрутураОтбора); 
			
			Для Каждого СтрокаТОХ Из МассивСтрокТОХ Цикл 
				
				Если Распределить = 0 Тогда
					Прервать;
				КонецЕсли;  
				
				СкорректироватьДоступноТОХПоСерии(ОстаткиОбщие, СтрокаТОХ, Распределить);   
				
				Если СтрокаТОХ.ДоступноТОХПоСерии <= 0 Тогда 
					Продолжить;
				КонецЕсли;	                        
				
				МожноРаспределить = Мин(СтрокаТОХ.ДоступноТОХПоСерии, Распределить); 
				
				Если МожноРаспределить > 0 Тогда
					
					НоваяСтрокаТох = тзТОХНовый.Добавить();
					
					НоваяСтрокаТох.Номенклатура			= ТоварТОХ.Номенклатура; 
					НоваяСтрокаТох.СерияНоменклатуры	= СтрокаТОХ.СерияНоменклатуры; 
					НоваяСтрокаТох.Количество			= МожноРаспределить;
					НоваяСтрокаТох.ЕдиницаИзмерения 	= НоваяСтрокаТох.Номенклатура.ЕдиницаХраненияОстатков;
					НоваяСтрокаТох.Коэффициент 			= НоваяСтрокаТох.ЕдиницаИзмерения.Коэффициент;  
					
					Распределить = Распределить - МожноРаспределить;
					
					СтрокаТОХ.ДоступноТОХПоСерии = СтрокаТОХ.ДоступноТОХПоСерии - МожноРаспределить;  
					
					Если ОстаткиОбщие <> Неопределено Тогда 
						ОстаткиОбщие.ВсегоДоступноТОХ = ОстаткиОбщие.ВсегоДоступноТОХ - МожноРаспределить;
					КонецЕсли;
					
				КонецЕсли;  
				
			КонецЦикла;	
				
		КонецЦикла;		
		
	КонецЕсли; 
	
	Возврат Истина;
	
КонецФункции

Процедура ЗаполнитьСерииТЧТОХ(ДокОбъект) Экспорт   

	ЗапросТоваровТОХ = Новый Запрос;	
	ЗапросТоваровТОХ.Текст = 
	"ВЫБРАТЬ
	|	Товары.Номенклатура,
	|	Товары.СерияНоменклатуры,
	|	Товары.Количество
	|ПОМЕСТИТЬ ВТ_ТаблТовары
	|ИЗ
	|	&Товары КАК Товары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыОтветственногоХраненияОстатки.Номенклатура,
	|	ТоварыОтветственногоХраненияОстатки.СерияНоменклатуры,   
	|	ЛОЖЬ КАК Отработано,
	|	СУММА(ЕСТЬNULL(ТоварыОтветственногоХраненияОстатки.КоличествоОстаток, 0) - ЕСТЬNULL(ТоварыОтветственногоХраненияПереданныеОстатки.КоличествоОстаток, 0)) КАК ОстатокТОХ
	|ИЗ
	|	РегистрНакопления.ТоварыОтветственногоХранения.Остатки(
	|			&Дата,
	|			Номенклатура В
	|				(ВЫБРАТЬ
	|					ТаблТовары.Номенклатура
	|				ИЗ
	|					ВТ_ТаблТовары КАК ТаблТовары)) КАК ТоварыОтветственногоХраненияОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыОтветственногоХраненияПереданные.Остатки(
	|				&Дата,
	|				Номенклатура В
	|					(ВЫБРАТЬ
	|						ТаблТовары.Номенклатура
	|					ИЗ
	|						ВТ_ТаблТовары КАК ТаблТовары)) КАК ТоварыОтветственногоХраненияПереданныеОстатки
	|		ПО ТоварыОтветственногоХраненияОстатки.Номенклатура = ТоварыОтветственногоХраненияПереданныеОстатки.Номенклатура
	|			И ТоварыОтветственногоХраненияОстатки.СерияНоменклатуры = ТоварыОтветственногоХраненияПереданныеОстатки.СерияНоменклатуры
	|			И ТоварыОтветственногоХраненияОстатки.ДоговорКонтрагента = ТоварыОтветственногоХраненияПереданныеОстатки.ДоговорКонтрагента
	|			И ТоварыОтветственногоХраненияПереданныеОстатки.КоличествоОстаток > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыОтветственногоХраненияОстатки.Номенклатура,
	|	ТоварыОтветственногоХраненияОстатки.СерияНоменклатуры
	|
	|ИМЕЮЩИЕ
	|	СУММА(ЕСТЬNULL(ТоварыОтветственногоХраненияОстатки.КоличествоОстаток, 0) - ЕСТЬNULL(ТоварыОтветственногоХраненияПереданныеОстатки.КоличествоОстаток, 0)) > 0";
	
	
	ТаблТоваров  = ДокОбъект.ТоварыОтветственногоХранения.Выгрузить();       
	ТаблТоваров1 = ТаблТоваров.Скопировать();
	
	ТаблТоваров1.Свернуть("Номенклатура, СерияНоменклатуры", "Количество");
	
	ЗапросТоваровТОХ.УстановитьПараметр("Товары", 	ТаблТоваров1);
	ЗапросТоваровТОХ.УстановитьПараметр("Дата", 	Новый Граница(ДокОбъект.Дата, ВидГраницы.Исключая));
	
	РезультатЗапроса = ЗапросТоваровТОХ.Выполнить();  
	
	тзОстаткиТОХ = РезультатЗапроса.Выгрузить();  
	
	тзНовыеСтроки = ТаблТоваров.Скопировать();    
	тзНовыеСтроки.Очистить();
	
	ОтборОстаткиСерии = Новый Структура("Номенклатура, СерияНоменклатуры, Отработано");      
	ОтборОстаткиСерии.Отработано = Ложь;
	
	ОтборОстатки = Новый Структура("Номенклатура, Отработано");      
	ОтборОстатки.Отработано = Ложь;
	
	Для каждого тзСтрокаТОХ Из ТаблТоваров Цикл
		
		РаспределитьПоСериям = тзСтрокаТОХ.Количество;   
		ДобавитьСтроку = Истина;
		
		// Поиск остатка в разрезе серии                
		Если Не тзСтрокаТОХ.СерияНоменклатуры.Пустая() Тогда
		
			ОтборОстаткиСерии.Номенклатура      = тзСтрокаТОХ.Номенклатура;
			ОтборОстаткиСерии.СерияНоменклатуры = тзСтрокаТОХ.СерияНоменклатуры;   
			
			МассивСтрок = тзОстаткиТОХ.НайтиСтроки(ОтборОстаткиСерии);      
			
			Если МассивСтрок.Количество() > 0 Тогда
				
				тзСтрокаОстатки = МассивСтрок[0];
				
				Если тзСтрокаТОХ.Количество <= тзСтрокаОстатки.ОстатокТОХ Тогда 
					
					// Достаточно остатка по этой серии    
					РаспределитьПоСериям = 0;
					тзСтрокаОстатки.ОстатокТОХ = тзСтрокаОстатки.ОстатокТОХ - тзСтрокаТОХ.Количество;
					
					Если тзСтрокаОстатки.ОстатокТОХ = 0 Тогда  
						тзСтрокаОстатки.Отработано  = Истина;
					КонецЕсли;
					
				Иначе                      
					
					// Остатка по серии не хватает, нужно распределить на другие серии
					РаспределитьПоСериям       = тзСтрокаТОХ.Количество - тзСтрокаОстатки.ОстатокТОХ;
					тзСтрокаТОХ.Количество     = тзСтрокаОстатки.ОстатокТОХ; 
					тзСтрокаОстатки.ОстатокТОХ = 0;         
					тзСтрокаОстатки.Отработано = Истина;      
					
				КонецЕсли;   
				
			Иначе                                              
				
				// Нет остатка по серии. Эту строку потом удалим.
				РаспределитьПоСериям = тзСтрокаТОХ.Количество;  
				ДобавитьСтроку       = Ложь;
				
			КонецЕсли;
			
		КонецЕсли;   // Не тзСтрокаТОХ.СерияНоменклатуры.Пустая()
		
		Если РаспределитьПоСериям > 0 Тогда
		
			// Распределение по сериям. Поиск остатков в разрезе номенклатуры
			ОтборОстатки.Номенклатура = тзСтрокаТОХ.Номенклатура;
			
			МассивСтрок = тзОстаткиТОХ.НайтиСтроки(ОтборОстатки);  
			
			Для каждого тзСтрокаОстатки Из МассивСтрок Цикл
			
				Если РаспределитьПоСериям = 0 Тогда
					Прервать;
				КонецЕсли;   
				
				Списать = МИН(РаспределитьПоСериям, тзСтрокаОстатки.ОстатокТОХ);
				
				Если ДобавитьСтроку Тогда
					НоваяСтрокаТох = тзНовыеСтроки.Добавить();
				Иначе
					
					НоваяСтрокаТох = тзСтрокаТОХ;  
					ДобавитьСтроку = Истина;
					
				КонецЕсли;  
				
				НоваяСтрокаТох.Номенклатура      = тзСтрокаОстатки.Номенклатура; 
				НоваяСтрокаТох.СерияНоменклатуры = тзСтрокаОстатки.СерияНоменклатуры; 
				НоваяСтрокаТох.ЕдиницаИзмерения  = НоваяСтрокаТох.Номенклатура.ЕдиницаХраненияОстатков;
				НоваяСтрокаТох.Коэффициент 		 = НоваяСтрокаТох.ЕдиницаИзмерения.Коэффициент;  
				НоваяСтрокаТох.Количество        = Списать;
				
				тзСтрокаОстатки.ОстатокТОХ = тзСтрокаОстатки.ОстатокТОХ - Списать;   
				РаспределитьПоСериям       = РаспределитьПоСериям - Списать;
				
				Если тзСтрокаОстатки.ОстатокТОХ = 0 Тогда  
					тзСтрокаОстатки.Отработано  = Истина;
				КонецЕсли;         
				
				Если РаспределитьПоСериям > 0  Тогда  
					
					// Для количество, для которых нет остатков, добавляется строка с пустой серией
					
					НоваяСтрокаТох                   = тзНовыеСтроки.Добавить();
					НоваяСтрокаТох.Номенклатура      = тзСтрокаТОХ.Номенклатура; 
					НоваяСтрокаТох.ЕдиницаИзмерения  = НоваяСтрокаТох.Номенклатура.ЕдиницаХраненияОстатков;
					НоваяСтрокаТох.Коэффициент 		 = НоваяСтрокаТох.ЕдиницаИзмерения.Коэффициент;   
					НоваяСтрокаТох.Количество        = РаспределитьПоСериям;  
					РаспределитьПоСериям             = 0;
						
					Сообщить("Строка " + Строка(тзСтрокаТОХ.НомерСтроки) + ": недостаточно остатка " + Строка(тзСтрокаТОХ.Номенклатура) 
					       + " артикул " + СОКРЛП(тзСтрокаТОХ.Номенклатура.Артикул) 
					       + ", серия " + СОКРЛП(Строка(тзСтрокаТОХ.СерияНоменклатуры)) + " в количестве " + Строка(РаспределитьПоСериям) 
						   + " " +  СОКРЛП(Строка(тзСтрокаТОХ.ЕдиницаИзмерения)) + ". Поле серии очищено.");
				
				КонецЕсли;   
			
			КонецЦикла;  
			
		КонецЕсли;
	
		Если РаспределитьПоСериям > 0 Тогда        
			
			Сообщить("Строка " + Строка(тзСтрокаТОХ.НомерСтроки) + ": недостаточно остатка " + Строка(тзСтрокаТОХ.Номенклатура)  
			       + " артикул " + СОКРЛП(тзСтрокаТОХ.Номенклатура.Артикул) 
			       + ", серия " + СОКРЛП(Строка(тзСтрокаТОХ.СерияНоменклатуры)) + " в количестве " + Строка(РаспределитьПоСериям) 
				   + " " +  СОКРЛП(Строка(тзСтрокаТОХ.ЕдиницаИзмерения)) + ?(Не ДобавитьСтроку, ". Установлено количество 0.", "")); 
				   
			Если Не ДобавитьСтроку Тогда
				тзСтрокаТОХ.Количество = 0;
			КонецЕсли;      
			
		КонецЕсли;   
			   
	КонецЦикла;   
		
	// Добавить новые строки
	Для каждого тзСтрокаТОХ Из тзНовыеСтроки Цикл  
		
		МассивСтрок   = ТаблТоваров.НайтиСтроки(Новый Структура("Номенклатура", тзСтрокаТОХ.Номенклатура));   
		
		ИндексВставки = ТаблТоваров.Индекс(МассивСтрок[0]) + 1;
		ДобСтрока = ТаблТоваров.Вставить(ТаблТоваров.Индекс(МассивСтрок[0]) + 1);  
		
		ЗаполнитьЗначенияСвойств(ДобСтрока, тзСтрокаТОХ);
	
	КонецЦикла;  
	
	ДокОбъект.ТоварыОтветственногоХранения.Загрузить(ТаблТоваров);
	
КонецПроцедуры      

Процедура СкорректироватьДоступноТОХПоСерии(ОстаткиОбщие, ОстаткиПоСерии, НужноСписать)

	Если ОстаткиПоСерии.КоличествоОстатокТОХ <= 0 Тогда  
		ОстаткиПоСерии.ДоступноТОХПоСерии = 0;
	Иначе
		
		Если ОстаткиПоСерии.КоличествоОстатокТОХФилиал = 0 Тогда  
			ОстаткиПоСерии.ДоступноТОХПоСерии = ОстаткиПоСерии.КоличествоОстатокТОХ;   
			
		ИначеЕсли ОстаткиПоСерии.КоличествоОстатокТОХФилиал > 0 Тогда  
			
			// Добавить до КоличествоОстатокТОХ из имеющихся отрицат.остатков других серий  
			ДобратьТОХ = МИН(НужноСписать, ОстаткиПоСерии.КоличествоОстатокТОХ - МАКС(ОстаткиПоСерии.ДоступноТОХПоСерии, 0), -ОстаткиОбщие.КоличествоОстатокТОХФилиалОтрицат);
			
			ОстаткиПоСерии.ДоступноТОХПоСерии = ОстаткиПоСерии.ДоступноТОХПоСерии + ДобратьТОХ; 
			ОстаткиОбщие.КоличествоОстатокТОХФилиалОтрицат = ОстаткиОбщие.КоличествоОстатокТОХФилиалОтрицат + ДобратьТОХ;
				
		Иначе   // ОстаткиПоСерии.КоличествоОстатокТОХФилиал < 0 
			ОстаткиПоСерии.ДоступноТОХПоСерии = ОстаткиПоСерии.КоличествоОстатокТОХ;
		КонецЕсли;  

    КонецЕсли;

КонецПроцедуры

Процедура СверитьТабЧастьТОХиДвижения(тзТОХ, ТаблицаДвижений, ВыводитьСообщения, Отказ, ТекстСообщения) Экспорт  

	тзЗаписи = ТаблицаДвижений.Скопировать();
	тзЗаписи.Свернуть("Номенклатура, СерияНоменклатуры", "Количество");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	тзЗаписи.Номенклатура,
		|	тзЗаписи.СерияНоменклатуры,
		|	тзЗаписи.Количество
		|ПОМЕСТИТЬ ТабЗаписи
		|ИЗ
		|	&тзЗаписи КАК тзЗаписи
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	тзТОХ.Номенклатура,
		|	тзТОХ.СерияНоменклатуры,
		|	тзТОХ.Количество
		|ПОМЕСТИТЬ ТабТОХ
		|ИЗ
		|	&тзТОХ КАК тзТОХ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДокументСписанияТОХ.Номенклатура,
		|	ДокументСписанияТОХ.СерияНоменклатуры,
		|	СУММА(ДокументСписанияТОХ.Количество) КАК Количество
		|ПОМЕСТИТЬ ТабДокумент
		|ИЗ
		|	ТабТОХ КАК ДокументСписанияТОХ
		|
		|СГРУППИРОВАТЬ ПО
		|	ДокументСписанияТОХ.Номенклатура,
		|	ДокументСписанияТОХ.СерияНоменклатуры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТабДокумент.Номенклатура,
		|	ТабДокумент.СерияНоменклатуры,
		|	ТабДокумент.Количество,
		|	ЕСТЬNULL(ТабЗаписи.Количество, 0) КАК КоличествоВРегистре,
		|	ТабДокумент.Количество - ЕСТЬNULL(ТабЗаписи.Количество, 0) КАК Расхождение,
		|	ТабДокумент.Номенклатура.ЕдиницаХраненияОстатков КАК ЕдиницаИзмерения
		|ИЗ
		|	ТабДокумент КАК ТабДокумент
		|		ЛЕВОЕ СОЕДИНЕНИЕ ТабЗаписи КАК ТабЗаписи
		|		ПО ТабДокумент.Номенклатура = ТабЗаписи.Номенклатура
		|			И ТабДокумент.СерияНоменклатуры = ТабЗаписи.СерияНоменклатуры
		|ГДЕ
		|	НЕ ТабДокумент.Количество = ЕСТЬNULL(ТабЗаписи.Количество, 0)";
	
	Запрос.УстановитьПараметр("тзТОХ", тзТОХ);
	Запрос.УстановитьПараметр("тзЗаписи", тзЗаписи);
	
	РезультатЗапроса = Запрос.Выполнить(); 
	
	Если НЕ РезультатЗапроса.Пустой() Тогда  
		
		ТекстСообщения = "Есть отрицательные остатки по измененным товарам с вкладки ТОХ. Проверьте заполнение вкладки ТОХ и проведите документ.";
	
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ТекстСообщения = ТекстСообщения + Символы.ПС 
			       + Строка(Выборка.Номенклатура) + " артикул " + СОКРЛП(Выборка.Номенклатура.Артикул) + ", серия " + СОКРЛП(Строка(Выборка.СерияНоменклатуры)) 
			       + ": не хватает " + Строка(Выборка.Расхождение) + " " + Строка(Выборка.ЕдиницаИзмерения);
		КонецЦикла;               
			   
		#Если Клиент Тогда    
		Если ВыводитьСообщения Тогда
			Сообщить(ТекстСообщения);					   
		КонецЕсли;			
	    #КонецЕсли
			   
		Отказ = Истина;   
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПолучитьВТ_Расхождения(Запрос, ДокОбъект, ТаблицаДвижений) Экспорт
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	тзЗаписи.Номенклатура,
		|	тзЗаписи.Количество
		|ПОМЕСТИТЬ ТабЗаписи
		|ИЗ
		|	&тзЗаписи КАК тзЗаписи
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	тзТОХ.Номенклатура,
		|	тзТОХ.Количество
		|ПОМЕСТИТЬ ТабТОХ
		|ИЗ
		|	&тзТОХ КАК тзТОХ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	тзТовары.Номенклатура,
		|	тзТовары.Количество
		|ПОМЕСТИТЬ ТабТовары
		|ИЗ
		|	&тзТовары КАК тзТовары
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТабЗаписи.Номенклатура,
		|	ТабТОХ.Номенклатура КАК НоменклатураТОХ,
		|	ЕСТЬNULL(ТабТОХ.Количество, 0) КАК Количество,
		|	ТабТОХ.Количество КАК Количество1,
		|	ТабЗаписи.Количество КАК Количество2
		|ПОМЕСТИТЬ ВТ_Расхождения
		|ИЗ
		|	ТабЗаписи КАК ТабЗаписи
		|		ЛЕВОЕ СОЕДИНЕНИЕ ТабТОХ КАК ТабТОХ
		|		ПО (ТабТОХ.Номенклатура = ТабЗаписи.Номенклатура)
		|ГДЕ
		|	НЕ ТабЗаписи.Количество = ЕСТЬNULL(ТабТОХ.Количество, 0)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Расхождения.Номенклатура,
		|	ЕСТЬNULL(ТабТовары.Количество, 0) КАК Количество,
		|	ВТ_Расхождения.Количество КАК КоличествоТОХ
		|ПОМЕСТИТЬ ВТ_РасхожденияТовары
		|ИЗ
		|	ВТ_Расхождения КАК ВТ_Расхождения
		|		ЛЕВОЕ СОЕДИНЕНИЕ ТабТовары КАК ТабТовары
		|		ПО ВТ_Расхождения.Номенклатура = ТабТовары.Номенклатура
		|ГДЕ
		|	ВТ_Расхождения.Количество > ЕСТЬNULL(ТабТовары.Количество, 0)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ТабЗаписи
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ТабТОХ";
		
	тзЗаписи = ТаблицаДвижений.Выгрузить();
	тзЗаписи.Свернуть("Номенклатура", "Количество");

	тзТОХ = ДокОбъект.ТоварыОтветственногоХранения.Выгрузить();
	тзТОХ.Свернуть("Номенклатура", "Количество");
	
	МетаданныеДокумента = ДокОбъект.Метаданные();   
	
	Если ОбщегоНазначения.ЕстьТабЧастьДокумента("Товары", МетаданныеДокумента) И ОбщегоНазначения.ЕстьТабЧастьДокумента("Материалы", МетаданныеДокумента) Тогда
		тзТовары = ДокОбъект.Товары.Выгрузить(); 
	ИначеЕсли ОбщегоНазначения.ЕстьТабЧастьДокумента("Материалы", МетаданныеДокумента) Тогда 
		тзТовары = ДокОбъект.Материалы.Выгрузить();
	Иначе
		тзТовары = ДокОбъект.Товары.Выгрузить();
	КонецЕсли;
		
	тзТовары.Свернуть("Номенклатура", "Количество");
	
	Запрос.УстановитьПараметр("тзТОХ",     тзТОХ);
	Запрос.УстановитьПараметр("тзЗаписи",  тзЗаписи);  
	Запрос.УстановитьПараметр("тзТовары",  тзТовары);
	Запрос.УстановитьПараметр("ДокСсылка", ДокОбъект.Ссылка);
	Запрос.УстановитьПараметр("Дата",      ДокОбъект.Дата);
	
	Запрос.Выполнить();

КонецПроцедуры

Процедура СверитьТабЧастьТОХиВыкупы(Запрос, ВыводитьСообщения, Отказ) Экспорт
	
	// Сравнение с имеющимися выкупами по измененной номенклатуре и документу
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВТ_Расхождения.Номенклатура КАК Номенклатура,
	|	ВыкупДокументыОснования.Ссылка КАК Выкуп,
	|	СУММА(ВыкупДокументыОснования.Количество) КАК КоличествоВыкуп,
	|	ВТ_Расхождения.Количество КАК Количество,
	|	МАКСИМУМ(ВТ_Расхождения.Номенклатура.Артикул) КАК Артикул,
	|	МАКСИМУМ(ВТ_Расхождения.Номенклатура.ЕдиницаХраненияОстатков) КАК ЕдиницаИзмерения
	|ИЗ
	|	ВТ_Расхождения КАК ВТ_Расхождения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВыкупСОтветственногоХранения.ДокументыОснованияВыкупаТОХ КАК ВыкупДокументыОснования
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВыкупСОтветственногоХранения КАК ВыкупСОтветственногоХранения
	|			ПО ВыкупДокументыОснования.Ссылка = ВыкупСОтветственногоХранения.Ссылка
	|				И (ВыкупСОтветственногоХранения.Проведен)
	|				И (ВыкупСОтветственногоХранения.Дата >= &Дата)
	|				И (ВыкупДокументыОснования.ДокументОснование = &ДокСсылка)
	|		ПО (ВыкупДокументыОснования.Номенклатура = ВТ_Расхождения.Номенклатура)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Расхождения.Номенклатура,
	|	ВыкупДокументыОснования.Ссылка,
	|	ВТ_Расхождения.Количество
	|
	|ИТОГИ
	|	МАКСИМУМ(Количество),   
	|	СУММА(КоличествоВыкуп),
	|	МАКСИМУМ(Артикул),
	|	МАКСИМУМ(ЕдиницаИзмерения)
	|ПО
	|	Номенклатура";
	
	РезультатЗапроса = Запрос.Выполнить(); 
	
	Если НЕ РезультатЗапроса.Пустой() Тогда     
		
		ТекстСообщения = "";
		
		ВыборкаНоменклатура = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

		Пока ВыборкаНоменклатура.Следующий() Цикл
			
			Если ВыборкаНоменклатура.Количество = ВыборкаНоменклатура.КоличествоВыкуп Тогда
				Продолжить;
			КонецЕсли; 
			
			ТекстСообщения = ?(ТекстСообщения = "", "Ошибка проведения, вкладка ТОХ не соответствует Выкупам:", ТекстСообщения);

			ТекстСообщения = ТекстСообщения + Символы.ПС  
			       + Строка(ВыборкаНоменклатура.Номенклатура) + " артикул " + СОКРЛП(ВыборкаНоменклатура.Артикул) + Символы.ПС 
				   + "Новое количество " + ВыборкаНоменклатура.Количество  + " " + Строка(ВыборкаНоменклатура.ЕдиницаИзмерения)
				   + " не соответствует количеству в выкупах: ";
			
			Выборка = ВыборкаНоменклатура.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				ТекстСообщения = ТекстСообщения + Символы.ПС + "   " + Строка(Выборка.Выкуп) + " - " + Выборка.КоличествоВыкуп + " " + Строка(Выборка.ЕдиницаИзмерения);
			КонецЦикла;               
			
		КонецЦикла;               
			
		Если Не ПустаяСтрока(ТекстСообщения) Тогда
			
			Если ВыводитьСообщения Тогда
				Сообщить(ТекстСообщения, СтатусСообщения.ОченьВажное);					   
			КонецЕсли;
			   
			Отказ = Истина;    
			
		КонецЕсли;			
		
	КонецЕсли; 

КонецПроцедуры

Процедура ПроверитьНедосписаниеТОХ(Запрос, МассивТоваров, ВыводитьСообщения, Отказ) Экспорт
	
	// Сравнение с собственными остатками по измененной номенклатуре    
	
	// ... Остатки получаем тем же запросом, которым заполняется закладка ТОХ при проведении нового документа
	ЗапросОстатки = Новый Запрос;   
	ЗапросОстатки.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ЗапросОстатки.Текст = ТекстЗапросаЗаполнитьТЧТОХ(); 
		
	ЗапросОстатки.УстановитьПараметр("МассивТоваров", 	МассивТоваров);
	ЗапросОстатки.УстановитьПараметр("Дата", 			Новый Граница(Запрос.Параметры.Дата, ВидГраницы.Исключая)); 
	ЗапросОстатки.УстановитьПараметр("Склад",           Константы.ОсновнойСклад.Получить());           
	
	ЗапросОстатки.Выполнить();
	ОбщиеОстаткиТОХ = ЗапросОстатки.МенеджерВременныхТаблиц.Таблицы["ВТ_ОстаткиТОХ_ПоНоменклатуре"].ПолучитьДанные().Выгрузить();
	
	// Сравнение разницы закладок Товары-ТОХ с остатками.
	// Если собствееные товары к списанию превышают остаток собств.товаров, значит ТОХ недосписаны
	Запрос.УстановитьПараметр("ОбщиеОстаткиТОХ", ОбщиеОстаткиТОХ);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОбщиеОстаткиТОХ.Номенклатура,
	|	ОбщиеОстаткиТОХ.СобственныйОстаток КАК СобственныйОстаток
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	&ОбщиеОстаткиТОХ КАК ОбщиеОстаткиТОХ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ВТ_Расхождения.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ВТ_Расхождения.Количество,
	|	СУММА(РеализацияТоваровУслугТовары.Количество) КАК КоличествоТовары,
	|	СУММА(РеализацияТоваровУслугТовары.Количество) - МАКСИМУМ(ВТ_Расхождения.Количество) КАК КоличествоСобственное,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ЕСТЬNULL(ВТ_Остатки.СобственныйОстаток, 0) < 0
	|				ТОГДА 0
	|			ИНАЧЕ ЕСТЬNULL(ВТ_Остатки.СобственныйОстаток, 0)
	|		КОНЕЦ) КАК СобственныйОстаток           
	|ПОМЕСТИТЬ ВТ_Результат
	|ИЗ
	|	ВТ_Расхождения КАК ВТ_Расхождения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|		ПО ВТ_Расхождения.Номенклатура = РеализацияТоваровУслугТовары.Номенклатура
	|	    И РеализацияТоваровУслугТовары.Ссылка = &ДокСсылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Остатки КАК ВТ_Остатки
	|		ПО ВТ_Расхождения.Номенклатура = ВТ_Остатки.Номенклатура
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Расхождения.Номенклатура,
	|	ВТ_Расхождения.Количество
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Результат.Номенклатура,     
	|	ВТ_Результат.Номенклатура.Артикул КАК Артикул,
	|	ВТ_Результат.Номенклатура.ЕдиницаХраненияОстатков КАК ЕдиницаИзмерения,
	|	ВТ_Результат.Количество,
	|	ВТ_Результат.КоличествоСобственное,
	|	ВТ_Результат.СобственныйОстаток,
	|	ВТ_Результат.КоличествоСобственное - ВТ_Результат.СобственныйОстаток КАК НедосписанТОХ
	|ИЗ
	|	ВТ_Результат КАК ВТ_Результат
	|ГДЕ
	|	ВТ_Результат.КоличествоСобственное > ВТ_Результат.СобственныйОстаток";
	
	РезультатЗапроса = Запрос.Выполнить(); 
	
	Если НЕ РезультатЗапроса.Пустой() Тогда     
		
		ТекстСообщения = "Ошибка проведения, недостаточное заполнение вкладки ТОХ:";

		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл     
			ТекстСообщения = ТекстСообщения + Символы.ПС  
		       + Строка(Выборка.Номенклатура) + " артикул " + СОКРЛП(Выборка.Артикул) 
			    + ". Количество к списанию собственное - " + Выборка.КоличествоСобственное  + " " + Строка(Выборка.ЕдиницаИзмерения)
			   + ", собственный остаток - " + Выборка.СобственныйОстаток + " " + Строка(Выборка.ЕдиницаИзмерения);
		КонецЦикла;               
			
		Если ВыводитьСообщения Тогда
			Сообщить(ТекстСообщения, СтатусСообщения.ОченьВажное);					   
		КонецЕсли;			
			   
		Отказ = Истина;   
		
	КонецЕсли; 

КонецПроцедуры


Процедура ПроверитьПроведениеПоТОХНаВыкупы(ДокОбъект, НаборТОХ, ВыводитьСообщения,  Отказ) Экспорт
	
	// Получение измененных строк ТОХ в ВТ_Расхождения
	Запрос = Новый Запрос; 
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	МСК.ПолучитьВТ_Расхождения(Запрос, ДокОбъект, НаборТОХ);
	
	тзРасхождения = Запрос.МенеджерВременныхТаблиц.Таблицы["ВТ_Расхождения"].ПолучитьДанные().Выгрузить();
	тзРасхожденияТовары = Запрос.МенеджерВременныхТаблиц.Таблицы["ВТ_РасхожденияТовары"].ПолучитьДанные().Выгрузить();
	
	Если тзРасхождения.Количество() > 0 Тогда
		
		Если тзРасхожденияТовары.Количество() > 0 Тогда
			
			Отказ = Истина;
			
			ТекстСообщения = "Ошибка проведения, количество на вкладке ТОХ превышает количество на вкладке Товар:";
			
			Для каждого тзСтрока Из тзРасхожденияТовары Цикл
				ТекстСообщения = ТекстСообщения + Символы.ПС  
			       + Строка(тзСтрока.Номенклатура) + " артикул " + СОКРЛП(тзСтрока.Номенклатура.Артикул) 
				   + ". Количество ТОХ - " + тзСтрока.КоличествоТОХ + " " + Строка(тзСтрока.Номенклатура.ЕдиницаХраненияОстатков)
				   + ", количество Товары - " + тзСтрока.Количество + " " + Строка(тзСтрока.Номенклатура.ЕдиницаХраненияОстатков);
			 КонецЦикла;    
			   
			Сообщить(ТекстСообщения, СтатусСообщения.ОченьВажное);   
		
		КонецЕсли;    
		
		// Если расхождения есть, то проводятся проверки    
		// Проверка 1. на соответствие выкупам измененных строк 
		МСК.СверитьТабЧастьТОХиВыкупы(Запрос, ВыводитьСообщения, Отказ);
		
		#Если Клиент Тогда      
		// Проверка 2. На недосписанные выкупы
		ОтключитьПроверкуТоварыПриИзмененииТОХ = Справочники.МТ_ПредопределенныеЗначения.ОтключитьПроверкуТоварыПриИзмененииТОХ.Значение;   
		
		ПолныеПраваТОХ = РольДоступна("ТОХ_ПолныеПрава");
		
		Если Не ПолныеПраваТОХ Или (ПолныеПраваТОХ И Не ОтключитьПроверкуТоварыПриИзмененииТОХ = Истина) Тогда
		
			МассивТоваров = тзРасхождения.ВыгрузитьКолонку("Номенклатура");
			ПроверитьНедосписаниеТОХ(Запрос, МассивТоваров, ВыводитьСообщения, Отказ);    
			
		КонецЕсли;
    	#КонецЕсли
		
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьПроведениеПоТОХ(ДокОбъект, НаборТОХ, Отказ) Экспорт
	
	ТаблицаДвижений = РегистрыНакопления.ТоварыОтветственногоХранения.ПолучитьДвиженияСписание(ДокОбъект);
	
	// Проверка на отрицательные остатки по всей таб.части ТОХ, без вывода сообщения
	ОтказТОХ = Ложь;    
	ТекстОшибки = "";
	МСК.СверитьТабЧастьТОХиДвижения(ДокОбъект.ТоварыОтветственногоХранения.Выгрузить(), ТаблицаДвижений, Ложь, ОтказТОХ, ТекстОшибки);   

	Если ОтказТОХ Тогда
		
		// Проверка на отрицательные остатки по сериям и количеству, которые различаются в старых и новых движениях ТОХ.
		// Отказ происходит только в случае расхождения по измененным строкам.
		тзДвиженияТОХСтарый = НаборТОХ.Выгрузить();   
		тзДвиженияТОХСтарый.Свернуть("Номенклатура, СерияНоменклатуры", "Количество");
		
		ТекстОшибки2 = "";
		МСК.СверитьТабЧастьТОХиДвижения(тзДвиженияТОХСтарый, ТаблицаДвижений, Истина, Отказ, ТекстОшибки2);  
		
		Если Не Отказ Тогда
			// Движения совпали, но поскольку при первой проверке не совпали таб.части, то все равно отказ
			#Если Клиент Тогда    
			Сообщить(ТекстОшибки, СтатусСообщения.ОченьВажное);					   
	    	#КонецЕсли
		
			Отказ = Истина;	
			
		КонецЕсли;
		
	КонецЕсли;
	
	МСК.ПроверитьПроведениеПоТОХНаВыкупы(ДокОбъект, НаборТОХ, Истина, Отказ); 

КонецПроцедуры


Функция ПроверитьВыкупыТОХ(ДокСсылка) Экспорт

	Набор = РегистрыНакопления.ТоварыОтветственногоХранения.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(ДокСсылка);
	Набор.Прочитать();
	
	Если Набор.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	
	// Найти документы выкупа по договорам поставщика из движения по регистру ТОХ 
	Запрос = Новый Запрос;  
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	тзДвиженияТОХ.Номенклатура,
		|	тзДвиженияТОХ.СерияНоменклатуры,
		|	тзДвиженияТОХ.ДоговорКонтрагента,
		|	тзДвиженияТОХ.Количество
		|ПОМЕСТИТЬ ВТ_ДоговораТОХ
		|ИЗ
		|	&тзДвиженияТОХ КАК тзДвиженияТОХ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ДоговораТОХ.Номенклатура,
		|	ВТ_ДоговораТОХ.СерияНоменклатуры,
		|	ВТ_ДоговораТОХ.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	ВТ_ДоговораТОХ.Количество,
		|	ТОХПереданныеОбороты.Регистратор КАК Выкуп,
		|	ТОХПереданныеОбороты.Период КАК Период,
		|	ТОХПереданныеОбороты.КоличествоРасход
		|ПОМЕСТИТЬ ВТ_Выкупы1
		|ИЗ
		|	ВТ_ДоговораТОХ КАК ВТ_ДоговораТОХ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыОтветственногоХранения.Обороты(
		|				&Дата,
		|				,
		|				Регистратор,
		|				ДоговорКонтрагента В
		|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						ВТ_ДоговораТОХ.ДоговорКонтрагента
		|					ИЗ
		|						ВТ_ДоговораТОХ КАК ВТ_ДоговораТОХ)) КАК ТОХПереданныеОбороты
		|		ПО ВТ_ДоговораТОХ.ДоговорКонтрагента = ТОХПереданныеОбороты.ДоговорКонтрагента
		|ГДЕ
		|	ТОХПереданныеОбороты.Регистратор ССЫЛКА Документ.ВыкупСОтветственногоХранения
		|	И ВЫРАЗИТЬ(ТОХПереданныеОбороты.Регистратор КАК Документ.ВыкупСОтветственногоХранения).Филиал = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|	И ВЫРАЗИТЬ(ТОХПереданныеОбороты.Регистратор КАК Документ.ВыкупСОтветственногоХранения).КонецПериода >= &Дата
		|	И НЕ ВЫРАЗИТЬ(ТОХПереданныеОбороты.Регистратор КАК Документ.ВыкупСОтветственногоХранения).Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыТОХ.ВозвратПоБраку)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ДоговораТОХ.Номенклатура,
		|	ВТ_ДоговораТОХ.СерияНоменклатуры,
		|	ВТ_ДоговораТОХ.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	ВТ_ДоговораТОХ.Количество,
		|	ТОХПереданныеОбороты.Регистратор КАК Выкуп,
		|	ТОХПереданныеОбороты.Период КАК Период,
		|	ТОХПереданныеОбороты.КоличествоРасход
		|ПОМЕСТИТЬ ВТ_Выкупы2
		|ИЗ
		|	ВТ_ДоговораТОХ КАК ВТ_ДоговораТОХ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыТОХпоДаннымПоставщиков.Обороты(
		|				&Дата,
		|				,
		|				Регистратор,
		|				Договор В
		|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						ВТ_ДоговораТОХ.ДоговорКонтрагента
		|					ИЗ
		|						ВТ_ДоговораТОХ КАК ВТ_ДоговораТОХ)) КАК ТОХПереданныеОбороты
		|		ПО ВТ_ДоговораТОХ.ДоговорКонтрагента = ТОХПереданныеОбороты.Договор
		|ГДЕ
		|	ТОХПереданныеОбороты.Регистратор ССЫЛКА Документ.ВыкупСОтветственногоХранения
		|	И ВЫРАЗИТЬ(ТОХПереданныеОбороты.Регистратор КАК Документ.ВыкупСОтветственногоХранения).Филиал = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|	И ВЫРАЗИТЬ(ТОХПереданныеОбороты.Регистратор КАК Документ.ВыкупСОтветственногоХранения).КонецПериода >= &Дата
		|	И НЕ ВЫРАЗИТЬ(ТОХПереданныеОбороты.Регистратор КАК Документ.ВыкупСОтветственногоХранения).Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыТОХ.ВозвратПоБраку)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Выкупы1.Номенклатура,
		|	ВТ_Выкупы1.СерияНоменклатуры,
		|	ВТ_Выкупы1.ДоговорКонтрагента,
		|	ВТ_Выкупы1.Количество,
		|	ВТ_Выкупы1.Выкуп,
		|	ВТ_Выкупы1.Период КАК Период
		|ИЗ
		|	ВТ_Выкупы1 КАК ВТ_Выкупы1
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВТ_Выкупы2.Номенклатура,
		|	ВТ_Выкупы2.СерияНоменклатуры,
		|	ВТ_Выкупы2.ДоговорКонтрагента,
		|	ВТ_Выкупы2.Количество,
		|	ВТ_Выкупы2.Выкуп,
		|	ВТ_Выкупы2.Период
		|ИЗ
		|	ВТ_Выкупы2 КАК ВТ_Выкупы2";
	
	Запрос.УстановитьПараметр("тзДвиженияТОХ", Набор.Выгрузить());  
	Запрос.УстановитьПараметр("Дата", ДокСсылка.Дата);    
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат Не РезультатЗапроса.Пустой();

КонецФункции

Функция ЗаблокироватьПерепроведениеТОХ(ДокОбъект, Отказ) Экспорт
	
	ДокСсылка = ДокОбъект.Ссылка;
	
	ВключенаБлокировкаПерепроведения = ДокСсылка.Проведен 
	                                    И Справочники.МТ_ПредопределенныеЗначения.ВключитьБлокировкуПерепроведенияДокументовТОХ(ТипЗнч(ДокСсылка));
										
	Если НЕ ВключенаБлокировкаПерепроведения Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ДокОбъект.Дата = ДокСсылка.Дата Тогда
		
		Сообщить("Дата документа с заполненной вкладкой ТОХ не может быть изменена");  
		Отказ = Истина;
		Возврат Истина;
	
	КонецЕсли;  
	
	Если ЕстьОшибкиИзмененияТОХПриПроведении(ДокОбъект) Тогда   
	
		Отказ = Истина;  
		Возврат Истина;
	
	КонецЕсли; 
	
	Возврат Ложь;

КонецФункции // ()

Функция ЕстьОшибкиИзмененияТОХПриПроведении(ДокОбъект)
	
	тзТОХНовый = ДокОбъект.ТоварыОтветственногоХранения.Выгрузить();  
	тзТОХНовый.Очистить();
	
	// Получение тзТОХНовый      
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПеремещениеТоваров") Тогда
		МСК.ЗаполнитьТЧТОХ(ДокОбъект, тзТОХНовый, ДокОбъект.СкладОтправитель, Ложь); 
	ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.КорректировкаПоступления") Тогда
		МСК.ЗаполнитьТЧТОХ(ДокОбъект, тзТОХНовый, ДокОбъект.СкладОрдер, Ложь);  
	Иначе
		МСК.ЗаполнитьТЧТОХ(ДокОбъект, тзТОХНовый, ДокОбъект.Склад, Ложь);  
	КонецЕсли;
	
	// Сравнить существующие ТОХ и новые, после заполнения
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(тзТОХНовый.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
		|	тзТОХНовый.Количество
		|ПОМЕСТИТЬ ВТ_ТОХНовая
		|ИЗ
		|	&тзТОХНовый КАК тзТОХНовый
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	тзТОХ.Номенклатура,
		|	тзТОХ.Количество
		|ПОМЕСТИТЬ ВТ_ТОХ
		|ИЗ
		|	&тзТОХ КАК тзТОХ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ТОХНовая.Номенклатура,
		|	ВТ_ТОХНовая.Номенклатура.Артикул КАК Артикул,
		|	ВТ_ТОХНовая.Номенклатура.КодПроизводителя КАК ИнвНомер,
		|	ЕСТЬNULL(ВТ_ТОХ.Количество, 0) КАК Количество,
		|	ВТ_ТОХНовая.Количество КАК КоличествоНовое
		|ИЗ
		|	ВТ_ТОХНовая КАК ВТ_ТОХНовая
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТОХ КАК ВТ_ТОХ
		|		ПО ВТ_ТОХНовая.Номенклатура = ВТ_ТОХ.Номенклатура
		|ГДЕ
		|	ВТ_ТОХНовая.Количество > ЕСТЬNULL(ВТ_ТОХ.Количество, 0)";
	
	тзТОХНовый.Свернуть("Номенклатура", "Количество");
	тзТОХ = ДокОбъект.Ссылка.ТоварыОтветственногоХранения.Выгрузить();  
	тзТОХ.Свернуть("Номенклатура", "Количество");
	
	Запрос.УстановитьПараметр("тзТОХНовый", тзТОХНовый);
	Запрос.УстановитьПараметр("тзТОХ", тзТОХ);
	
	РезультатЗапроса = Запрос.Выполнить();  
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТабДок = Новый ТабличныйДокумент;
	Макет = Документы.СписаниеТоваров.СоздатьДокумент().ПолучитьМакет("РасхожденияТОХ"); 
	Область = Макет.ПолучитьОбласть("Шапка");
	Область.Параметры.Заголовок = "Блокировка перепроведения в связи с увеличением количества по артикулам ТОХ" + Символы.ПС + Строка(ДокОбъект);
	ТабДок.Вывести(Область);
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл 
		
		Область = Макет.ПолучитьОбласть("Строка");   
		Область.Параметры.Заполнить(Выборка); 
		ТабДок.Вывести(Область);
		
	КонецЦикла;      
	
	ТабДок.ОтображатьЗаголовки = Ложь;
	ТабДок.ОтображатьСетку = Ложь;
	ТабДок.Показать("Блокировка перепроведения ТОХ"); 
	
	Возврат Истина;

КонецФункции

Функция ПолучитьДеньПоКалендарю(Дата) Экспорт

	ДеньНедели = ДеньНедели(Дата);

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РегламентированныйПроизводственныйКалендарь.ДатаКалендаря,
	|	РегламентированныйПроизводственныйКалендарь.ВидДня
	|ИЗ
	|	РегистрСведений.РегламентированныйПроизводственныйКалендарь КАК РегламентированныйПроизводственныйКалендарь
	|ГДЕ
	|	РегламентированныйПроизводственныйКалендарь.ДатаКалендаря = &ДатаКалендаря
	|	И РегламентированныйПроизводственныйКалендарь.ВидДня = ЗНАЧЕНИЕ(Перечисление.ВидыДнейПроизводственногоКалендаря.Суббота)"; 

	Запрос.УстановитьПараметр("ДатаКалендаря", НачалоДня(Дата));

	Результат = Запрос.Выполнить();

	Если Результат.Пустой() Тогда
		Возврат ?(ДеньНедели = 6, 1, ДеньНедели);	
	Иначе
		Возврат 6;
	КонецЕсли;   

КонецФункции

Функция ПолучитьДоговор(Контрагент, НомерДоговора, ДатаДоговора)
	
	//+Шульман А. 04.03.2026 #UT10-5735
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДоговорыКонтрагентов.Ссылка
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
