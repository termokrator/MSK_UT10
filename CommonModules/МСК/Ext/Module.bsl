				НоваяСтрока = СпрОбъект.НастрокиЗагрузкиМХ1.Добавить();
				ЗаполнитьСвойствоПоПоискуКодаМДМ("EMailЗаказ_ПоляExcel", НоваяСтрока, "ПолеExcel", Стр.ПолеExcel);
