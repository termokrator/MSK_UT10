		СпрОбъект.НомерСтрокиНомерМХ1		  = Число(ФабрикаСправочника.НомерСтрокиНомерМХ1);
		СпрОбъект.НомерСтрокиНомерУПД 		  = Число(ФабрикаСправочника.НомерСтрокиНомерУПД);
		
		СпрОбъект.ПроизводителиПоУмолчанию.Очистить();
