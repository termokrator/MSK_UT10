						ДокУстановкаЦен.Контрагент = ТипЦеныПоКодМДМ.Владелец;
						
					Иначе             
						ЗаписьЖурналаРегистрации("Загрузка документов.Установка цен номенклатуры контрагентов.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
						"Не найден тип цены  " + СокрЛП(СтрокаСпискаТиповЦен.ТипЦенНаименование) + " с кодом МДМ " + СокрЛП(СтрокаСпискаТиповЦен.ТипЦенКодМДМ));
					КонецЕсли;
					
				КонецЦикла;
				
				Если ДокУстановкаЦен.ТипыЦен.Количество() = 0 Тогда   
					
					ЗаписьЖурналаРегистрации("Загрузка документов.Установка цен номенклатуры контрагентов.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
					"Документ с ИД документа '" + ГУИДУстановкиЦен + "' не найден ни один тип цен по кодам МДМ");
					Возврат;
					
				Иначе
					ДокУстановкаЦен.Записать(РежимЗаписиДокумента.Запись);
				КонецЕсли;
				
				СписокТоваров = СообщениеJSON.Товары;
				
				Для Каждого СтрокаСпискаТоваров Из СписокТоваров Цикл
					
					ТипЦеныПоСоответствию = СоответствиеТиповЦен.Получить(СтрокаСпискаТоваров.ТипЦенКодМДМ); 
					
					Если НЕ ТипЦеныПоСоответствию = Неопределено Тогда       
						
						ТоварПоКодуМДМ = Справочники.Номенклатура.НайтиПоРеквизиту("КодМДМ", СтрокаСпискаТоваров.НоменклатураКодМДМ);
						
						Если НЕ ТоварПоКодуМДМ.Пустая() Тогда
							
							НоваяСтрокаТовары				  		 = ДокУстановкаЦен.Товары.Добавить();
							НоваяСтрокаТовары.Номенклатура	  		 = ТоварПоКодуМДМ;
							НоваяСтрокаТовары.ЕдиницаИзмерения		 = ТоварПоКодуМДМ.ЕдиницаХраненияОстатков;
							НоваяСтрокаТовары.ТипЦен	     		 = ТипЦеныПоСоответствию; 
							НоваяСтрокаТовары.Валюта	      		 = ТипЦеныПоСоответствию.ВалютаЦены;
							НоваяСтрокаТовары.Цена	          		 = СтрокаСпискаТоваров.Цена;
							НоваяСтрокаТовары.ИндексСтрокиТаблицыЦен = СтрокаСпискаТоваров.ИндексСтрокиТаблицыЦен; 
							
						Иначе 
							ЗаписьЖурналаРегистрации("Загрузка документов.Установка цен номенклатуры контрагентов.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
							"Не найден товар с кодом МДМ " + СокрЛП(СтрокаСпискаТоваров.НоменклатураКодМДМ));
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЦикла;
				
				Если Не ДокУстановкаЦен.Товары.Количество() = 0 Тогда 
					
					Попытка    
						
						ДокУстановкаЦен.Записать(РежимЗаписиДокумента.Проведение);
						ЗаписьЖурналаРегистрации("ПолучениеСообщений.Прием", УровеньЖурналаРегистрации.Информация,,, ДокУстановкаЦен.Ссылка);    
						
					Исключение     
						
						ЗаписьЖурналаРегистрации("Загрузка документов.Установка цен номенклатуры контрагентов.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
						"Ошибка проведения документа: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
						
						СтрокаИсключения = "ВидДокумента " + ВидДокумента + "; Ошибка создания/записи" + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()); 					 
						ВызватьИсключение СтрокаИсключения; 
						
					КонецПопытки;	 
					
				Иначе
					
					ЗаписьЖурналаРегистрации("Загрузка документов.Установка цен номенклатуры контрагентов.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
					"Ошибка создания документа: не заполнена табличная часть 'Товары' ");
					
				КонецЕсли;
				
			КонецЕсли;  
			
		КонецЕсли;
	
	ИначеЕсли ВидДокумента = "ПередачаРеквизитовНоменклатуры" Тогда
		
		СписокТоваров = СообщениеJSON.Товары;
		
		Для Каждого СтрокаСпискаТоваров Из СписокТоваров Цикл
			
			ТоварПоКодуМДМ = Справочники.Номенклатура.НайтиПоРеквизиту("КодМДМ", СтрокаСпискаТоваров.НоменклатураКодМДМ);
			
			Если НЕ ТоварПоКодуМДМ.Пустая() Тогда
				
				Если НЕ ТоварПоКодуМДМ.НеЗагружатьЦеныЕслиЕстьОстатокТовара = Булево(СтрокаСпискаТоваров.НеЗагружатьЦеныЕслиЕстьОстатокТовара) 
					ИЛИ НЕ ТоварПоКодуМДМ.КратностьФилиала = СтрокаСпискаТоваров.КратностьФилиала Тогда
					
					ТоварОбъект                                      = ТоварПоКодуМДМ.ПолучитьОбъект(); 
					ТоварОбъект.ОбменДанными.Загрузка                = Истина;   
					ТоварОбъект.НеЗагружатьЦеныЕслиЕстьОстатокТовара = Булево(СтрокаСпискаТоваров.НеЗагружатьЦеныЕслиЕстьОстатокТовара);
					ТоварОбъект.КратностьФилиала                     = СтрокаСпискаТоваров.КратностьФилиала;
					
					Попытка
						ТоварОбъект.Записать();
					Исключение
						ЗаписьЖурналаРегистрации("Загрузка документов.Передача реквизитов номенклатуры.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
						"Ошибка записи номенклатуры : " + СокрЛП(ТоварОбъект.Артикул) + "  " + сокрЛП(ТоварОбъект.Наименование)
						+ "  " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
					КонецПопытки;
					
				КонецЕсли;
				
			Иначе 
				ЗаписьЖурналаРегистрации("Загрузка документов.Передача реквизитов номенклатуры.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
				"Не найден товар с кодом МДМ " + СокрЛП(СтрокаСпискаТоваров.НоменклатураКодМДМ));
			КонецЕсли;
			
		КонецЦикла; 
		
		ЗаписьЖурналаРегистрации("Загрузка документов.Передача реквизитов номенклатуры.Обработка", УровеньЖурналаРегистрации.Информация,,,
		"Обработано " + СокрЛП(СписокТоваров.Количество()) + " строк");
		
	ИначеЕсли ВидДокумента = "ВыкупСОтветственногоХранения" Тогда 

		ГУИДВыкупа 		  = СообщениеJSON.УникальныйИдентификатор;
		КодМДМФилиала	  = СокрЛП(СообщениеJSON.КодМДМФилиала);
		КодМДМДоговораТОХ = СокрЛП(СообщениеJSON.КодМДМДоговораТОХ);
		НазваниеБазы 	  = СокрЛП(СообщениеJSON.НазваниеБазы);
		НачалоПериода     = Дата(СообщениеJSON.НачалоПериода);
		КонецПериода      = Дата(СообщениеJSON.КонецПериода);
		Статус            = Число(СообщениеJSON.Статус);

		ЕстьФилиал = Справочники.Контрагенты.НайтиПоРеквизиту("КодМДМ", КодМДМФилиала);
		
		Если ЕстьФилиал.Пустая() Тогда
			
			ЗаписьЖурналаРегистрации("Загрузка документов.Выкуп с ответственного хранения.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
			"Не найден филиал с кодом МДМ " + КодМДМФилиала);
			
			Возврат;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(КодМДМДоговораТОХ) Тогда
			
			ЕстьДоговорПоставщикаТОХ = Справочники.ДоговорыКонтрагентов.НайтиПоРеквизиту("КодМДМ", КодМДМДоговораТОХ);
			
			Если Не ЕстьДоговорПоставщикаТОХ.Пустая() Тогда
				
				ПоставщикТОХ = Справочники.ПоставщикиТОХ.НайтиПоРеквизиту("ДоговорКонтрагента", ЕстьДоговорПоставщикаТОХ);
				
				Если ПоставщикТОХ.Пустая() Тогда
					
					ЗаписьЖурналаРегистрации("Загрузка документов.Выкуп с ответственного хранения.Ошибка", УровеньЖурналаРегистрации.Ошибка,,,
					"Не найден поставщик ТОХ с договором " + СокрЛП(ЕстьДоговорПоставщикаТОХ.Наименование));
					Возврат;
					
				КонецЕсли;
				
			Иначе
				
				ЗаписьЖурналаРегистрации("Загрузка документов.Выкуп с ответственного хранения.Ошибка", УровеньЖурналаРегистрации.Ошибка,,,
				"Не найден договор поставщика ТОХ с кодом МДМ " + СокрЛП(КодМДМДоговораТОХ));
				Возврат;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ГУИДВыкупа) Тогда 
			
			ДокВыкуп = Документы.ВыкупСОтветственногоХранения.НайтиПоРеквизиту("ИДДокументаВСмежнойБазе",ГУИДВыкупа);  
			
			Если НЕ ДокВыкуп.Пустая() Тогда    
				
				ЗаписьЖурналаРегистрации("Загрузка документов.Выкуп с ответственного хранения.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
				"Документ с ИД документа '" + ГУИДВыкупа + "' уже загружен ");
				Возврат;
				
			Иначе
				
				ДокВыкуп 						   = Документы.ВыкупСОтветственногоХранения.СоздатьДокумент();
				ДокВыкуп.Дата 					   = Дата(СообщениеJSON.ДатаДокумента);
				ДокВыкуп.ИДДокументаВСмежнойБазе   = ГУИДВыкупа;
				ДокВыкуп.Филиал 				   = ЕстьФилиал;
				ДокВыкуп.НачалоПериода			   = НачалоПериода;
				ДокВыкуп.КонецПериода			   = КонецПериода;
				ДокВыкуп.Ответственный			   = ПараметрыСеанса.ТекущийПользователь; 
				ДокВыкуп.Контрагент				   = ПоставщикТОХ.Контрагент;
				ДокВыкуп.ДоговорКонтрагента		   = ПоставщикТОХ.ДоговорКонтрагента;
				ДокВыкуп.ВалютаДокумента		   = ПоставщикТОХ.ДоговорКонтрагента.ВалютаВзаиморасчетов; 
				ДокВыкуп.КурсВзаиморасчетов	       = 1;
				ДокВыкуп.КратностьВзаиморасчетов   = 1;  			
				ДокВыкуп.Организация               = ПоставщикТОХ.ДоговорКонтрагента.Организация;
				ДокВыкуп.Склад					   = Константы.ОсновнойСклад.Получить();
				ИмяПеречисления					   = Метаданные.Перечисления.СтатусыТОХ.ЗначенияПеречисления[Статус].Имя; 
				ДокВыкуп.Статус                    = Перечисления.СтатусыТОХ[ИмяПеречисления];
				ДокВыкуп.Комментарий               = "Создан по документу № " + СокрЛП(СообщениеJSON.НомерДокумента) + " из базы " + НазваниеБазы;
				
				ПромТипЦен = ЕстьДоговорПоставщикаТОХ.ТипЦен;
				
				СписокТоваров = СообщениеJSON.Товары;
				
				ЗапросСерииНоменклатуры = Новый Запрос;
				ЗапросСерииНоменклатуры.Текст =
				"ВЫБРАТЬ
				|	ТоварыОтветственногоХраненияПереданныеОстатки.ДоговорКонтрагента,
				|	ТоварыОтветственногоХраненияПереданныеОстатки.Номенклатура,
				|	ТоварыОтветственногоХраненияПереданныеОстатки.СерияНоменклатуры,
				|	ТоварыОтветственногоХраненияПереданныеОстатки.Филиал,
				|	ТоварыОтветственногоХраненияПереданныеОстатки.КоличествоОстаток,
				|	ВЫБОР
				|		КОГДА &Серия = ЗНАЧЕНИЕ(Справочник.Серииноменклатуры.ПустаяСсылка)
				|			ТОГДА 1
				|		ИНАЧЕ ВЫБОР
				|				КОГДА ТоварыОтветственногоХраненияПереданныеОстатки.СерияНоменклатуры = &Серия
				|					ТОГДА 0
				|				ИНАЧЕ 1
				|			КОНЕЦ
				|	КОНЕЦ КАК Приоритет
				|ПОМЕСТИТЬ ВТ_Остатки
				|ИЗ
				|	РегистрНакопления.ТоварыОтветственногоХраненияПереданные.Остатки(
				|			&Дата,
				|			Номенклатура = &Номенклатура
				|				И Филиал = &Филиал) КАК ТоварыОтветственногоХраненияПереданныеОстатки
				|ГДЕ
				|	ТоварыОтветственногоХраненияПереданныеОстатки.КоличествоОстаток > 0
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ВТ_Остатки.Номенклатура,
				|	ВТ_Остатки.СерияНоменклатуры,
				|	ВТ_Остатки.КоличествоОстаток КАК КоличествоОстаток,
				|	ВТ_Остатки.Приоритет КАК Приоритет
				|ИЗ
				|	ВТ_Остатки КАК ВТ_Остатки
				|
				|УПОРЯДОЧИТЬ ПО
				|	Приоритет,
				|	КоличествоОстаток Возр";
				
				ЗапросСерииНоменклатуры.УстановитьПараметр("Дата",ДокВыкуп.Дата);
				ЗапросСерииНоменклатуры.УстановитьПараметр("Филиал",ЕстьФилиал);

				Для Каждого СтрокаСпискаТоваров Из СписокТоваров Цикл
					
					ТоварПоКодуМДМ = Справочники.Номенклатура.НайтиПоРеквизиту("КодМДМ", СтрокаСпискаТоваров.НоменклатураКодМДМ);
					
					Если НЕ ТоварПоКодуМДМ.Пустая() Тогда
						
						СерияНоменклатуры = Справочники.СерииНоменклатуры.НайтиПоНаименованию(СтрокаСпискаТоваров.НомерГТД, Истина,, ТоварПоКодуМДМ);
						
						ЗапросСерииНоменклатуры.УстановитьПараметр("Номенклатура",ТоварПоКодуМДМ);
						ЗапросСерииНоменклатуры.УстановитьПараметр("Серия",СерияНоменклатуры);
						
						РезультатЗапросаСерии = ЗапросСерииНоменклатуры.Выполнить();
						
						Если НЕ РезультатЗапросаСерии.Пустой() Тогда
							
							ВыборкаЗапросаСерии = РезультатЗапросаСерии.Выбрать();
							
							КоличествоСписатьПоСтроке = СтрокаСпискаТоваров.Количество;
							
							Пока ВыборкаЗапросаСерии.Следующий() Цикл
								
								Если КоличествоСписатьПоСтроке = 0 Тогда
									Прервать;
								КонецЕсли;
								
								Если ВыборкаЗапросаСерии.КоличествоОстаток >= КоличествоСписатьПоСтроке Тогда
									
									НоваяСтрокаТовары				  			 = ДокВыкуп.Товары.Добавить();
									НоваяСтрокаТовары.Номенклатура	  			 = ТоварПоКодуМДМ;
									НоваяСтрокаТовары.ЕдиницаИзмерения			 = ТоварПоКодуМДМ.ЕдиницаХраненияОстатков;
									НоваяСтрокаТовары.Коэффициент				 = НоваяСтрокаТовары.ЕдиницаИзмерения.Коэффициент;
									НоваяСтрокаТовары.Количество            	 = КоличествоСписатьПоСтроке; 					
									НоваяСтрокаТовары.Цена	           			 = ПолучитьЦенуПоставщика(ТоварПоКодуМДМ,ПромТипЦен,ДокВыкуп.Дата); 						
									НоваяСтрокаТовары.Сумма	          		 	 = НоваяСтрокаТовары.Цена*СтрокаСпискаТоваров.Количество;
									НоваяСтрокаТовары.ХарактеристикаНоменклатуры = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка(); 
									НоваяСтрокаТовары.СерияНоменклатуры 		 = ВыборкаЗапросаСерии.СерияНоменклатуры;

									КоличествоСписатьПоСтроке = 0;
									
								Иначе
									
									НоваяСтрокаТовары				  			 = ДокВыкуп.Товары.Добавить();
									НоваяСтрокаТовары.Номенклатура	  			 = ТоварПоКодуМДМ;
									НоваяСтрокаТовары.ЕдиницаИзмерения			 = ТоварПоКодуМДМ.ЕдиницаХраненияОстатков;
									НоваяСтрокаТовары.Коэффициент				 = НоваяСтрокаТовары.ЕдиницаИзмерения.Коэффициент;
									НоваяСтрокаТовары.Количество            	 = Мин(КоличествоСписатьПоСтроке,ВыборкаЗапросаСерии.КоличествоОстаток); 					
									НоваяСтрокаТовары.Цена	           			 = ПолучитьЦенуПоставщика(ТоварПоКодуМДМ,ПромТипЦен,ДокВыкуп.Дата); 						
									НоваяСтрокаТовары.Сумма	          		 	 = НоваяСтрокаТовары.Цена*СтрокаСпискаТоваров.Количество;
									НоваяСтрокаТовары.ХарактеристикаНоменклатуры = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка(); 
									НоваяСтрокаТовары.СерияНоменклатуры 		 = ВыборкаЗапросаСерии.СерияНоменклатуры;
									
									КоличествоСписатьПоСтроке = КоличествоСписатьПоСтроке - Мин(КоличествоСписатьПоСтроке,ВыборкаЗапросаСерии.КоличествоОстаток);
									
								КонецЕсли;									
								
							КонецЦикла;							
							
							Если НЕ КоличествоСписатьПоСтроке = 0 Тогда
								
								НоваяСтрокаТовары				  			 = ДокВыкуп.Товары.Добавить(); 
								НоваяСтрокаТовары.Номенклатура	  			 = ТоварПоКодуМДМ;
								НоваяСтрокаТовары.ЕдиницаИзмерения			 = ТоварПоКодуМДМ.ЕдиницаХраненияОстатков;
								НоваяСтрокаТовары.Коэффициент				 = НоваяСтрокаТовары.ЕдиницаИзмерения.Коэффициент;
								НоваяСтрокаТовары.Количество            	 = КоличествоСписатьПоСтроке; 					
								НоваяСтрокаТовары.Цена	           			 = ПолучитьЦенуПоставщика(ТоварПоКодуМДМ,ПромТипЦен,ДокВыкуп.Дата); 						
								НоваяСтрокаТовары.Сумма	          		 	 = НоваяСтрокаТовары.Цена*СтрокаСпискаТоваров.Количество;
								НоваяСтрокаТовары.ХарактеристикаНоменклатуры = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
								НоваяСтрокаТовары.СерияНоменклатуры 		 = СерияНоменклатуры;
								
							КонецЕсли;
							
						Иначе
							
							НоваяСтрокаТовары				  			 = ДокВыкуп.Товары.Добавить();   
							НоваяСтрокаТовары.Номенклатура	  			 = ТоварПоКодуМДМ;
							НоваяСтрокаТовары.ЕдиницаИзмерения			 = ТоварПоКодуМДМ.ЕдиницаХраненияОстатков;
							НоваяСтрокаТовары.Коэффициент				 = НоваяСтрокаТовары.ЕдиницаИзмерения.Коэффициент;
							НоваяСтрокаТовары.Количество            	 = КоличествоСписатьПоСтроке; 					
							НоваяСтрокаТовары.Цена	           			 = ПолучитьЦенуПоставщика(ТоварПоКодуМДМ,ПромТипЦен,ДокВыкуп.Дата); 						
							НоваяСтрокаТовары.Сумма	          		 	 = НоваяСтрокаТовары.Цена*СтрокаСпискаТоваров.Количество;
							НоваяСтрокаТовары.ХарактеристикаНоменклатуры = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка(); 
							
							Если СерияНоменклатуры.Пустая()  Тогда  
								
								НомерГТДСсылка = Справочники.НомераГТД.НайтиПоКоду(СтрокаСпискаТоваров.НомерГТД);
								
								Если ЗначениеЗаполнено(СокрЛП(СтрокаСпискаТоваров.СтранаПроисхожденияКодМДМ)) Тогда
									Страна = Справочники.КлассификаторСтранМира.НайтиПоРеквизиту("КодМДМ", СокрЛП(СтрокаСпискаТоваров.СтранаПроисхожденияКодМДМ));	
								ИначеЕсли ЗначениеЗаполнено(СокрЛП(СтрокаСпискаТоваров.СтранаПроисхожденияКод)) Тогда   							
									Страна = Справочники.КлассификаторСтранМира.НайтиПоКоду(СтрокаСпискаТоваров.СтранаПроисхожденияКод);   						
								КонецЕсли;
								
								НоваяСтрокаТовары.СерияНоменклатуры = ПроверитьИСоздатьСерию(ТоварПоКодуМДМ, СтрокаСпискаТоваров.НомерГТД, Страна, НомерГТДСсылка);
								
							Иначе			
								НоваяСтрокаТовары.СерияНоменклатуры = СерияНоменклатуры;
							КонецЕсли;  
							
						КонецЕсли;
						
					Иначе 
						ЗаписьЖурналаРегистрации("Загрузка документов.Выкуп с ответственного хранения.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, 
						"Не найден товар с кодом МДМ " + СокрЛП(СтрокаСпискаТоваров.НоменклатураКодМДМ));
					КонецЕсли;
					
