	Если ПечатьТранзитЧерезТомилино Тогда   	
		
		ПечДокТранзитЧерезТомилино = ДокОбъект.ПечатьТранзитЧерезТомилино();
		УниверсальныеМеханизмы.НапечататьДокумент(ПечДокТранзитЧерезТомилино, 1, СразуНаПринтер, ОбщегоНазначения.СформироватьЗаголовокДокумента(ДокОбъект), ДокОбъект.Ссылка);	
		
	КонецЕсли;	
	
	Если ПечатьЗаявкиНаВозврат Тогда				
		
		МассивЗаявокНаВозврат = СформироватьЗаявкиНаВозвратДляВыводаНаПечать(Реализация);				
		
		Для Каждого ЗаявкаНаВозврат Из МассивЗаявокНаВозврат Цикл					
			
			ЗаявкаНаВозвратОбъект = ЗаявкаНаВозврат.ПолучитьОбъект();
			
			Попытка
				
				Если Реализация.ДоговорКонтрагента.РозничнаяПродажа Тогда 
					ЗаявкаНаВозвратОбъект.Печать("ЗаявлениеНаВозвратФизЛица", 1, СразуНаПринтер);
				Иначе 
					ЗаявкаНаВозвратОбъект.Печать("Претензия", 2, СразуНаПринтер);					
				КонецЕсли;

				ЗаявкаНаВозвратОбъект.Печать("Возврат", 2, СразуНаПринтер);
				
				НаборЗаписей = РегистрыСведений.КатегорииОбъектов.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.Объект.Установить(ЗаявкаНаВозвратОбъект.Ссылка);
				НаборЗаписей.Отбор.Категория.Установить(Справочники.КатегорииОбъектов.РаспечатаноПриОтгрузке);
				Запись = НаборЗаписей.Добавить();
				Запись.Объект = ЗаявкаНаВозвратОбъект.Ссылка;
				Запись.Категория = Справочники.КатегорииОбъектов.РаспечатаноПриОтгрузке;  
				
				НаборЗаписей.Записать();
				
			Исключение
				
			КонецПопытки;
			
		КонецЦикла;				
		
	КонецЕсли;
	
	//+Сёмин Р. 24.02.2026 #UT10-5691
	Если ПечатьЗаявкиНаПеревозкуГрузов Тогда
		
		ПечДокЗаявкаНаПеревозкуГрузов = ДокОбъект.ПечатьЗаявкиНаПеревозкуГрузов();
		УниверсальныеМеханизмы.НапечататьДокумент(ПечДокЗаявкаНаПеревозкуГрузов, 1, СразуНаПринтер, ОбщегоНазначения.СформироватьЗаголовокДокумента(ДокОбъект), ДокОбъект.Ссылка);
		
	КонецЕсли;
	//-Сёмин Р. 24.02.2026 #UT10-5691

КонецФункции

Функция РаспечататьТТН(ДокОбъект , СтруктураДляПечати) Экспорт
	
	ПечДокТТН = ДокОбъект.ПечатьТранспортнойНакладной();
	
	Если СтруктураДляПечати.СразуНаПринтер Тогда
		
		Для Х = 1 по СтруктураДляПечати.КолвоЭкзТТН Цикл
			
			УниверсальныеМеханизмы.НапечататьДокумент(ПечДокТТН, 1, СтруктураДляПечати.СразуНаПринтер, 
			ОбщегоНазначения.СформироватьЗаголовокДокумента(ДокОбъект), ДокОбъект.Ссылка);					
			
		КонецЦикла;				  
	Иначе
		УниверсальныеМеханизмы.НапечататьДокумент(ПечДокТТН, 1, СтруктураДляПечати.СразуНаПринтер, 
		ОбщегоНазначения.СформироватьЗаголовокДокумента(ДокОбъект), ДокОбъект.Ссылка);							
	КонецЕсли; 
	
КонецФункции

Функция РаспечататьКорректированыеСчетФактуры(Грузополучатель, СтруктураДляПечати, ТолькоОтметкаПечати = Ложь) Экспорт
	
	Запрос = Новый Запрос;		
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СчетФактураВыданныйДокументыОснования.Ссылка,
	|	СчетФактураВыданныйДокументыОснования.Ссылка.Номер КАК Номер
	|ИЗ
	|	Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	|		ПО СчетФактураВыданныйДокументыОснования.Ссылка = ЗначенияСвойствОбъектов.Объект
	|ГДЕ
	|	ТИПЗНАЧЕНИЯ(СчетФактураВыданныйДокументыОснования.Ссылка.ДокументОснование) = ЗНАЧЕНИЕ(Документ.КорректировкаРеализации)
	|	И СчетФактураВыданныйДокументыОснования.Ссылка.Дата >= &Дата
	|	И СчетФактураВыданныйДокументыОснования.Ссылка.Проведен
	|	И СчетФактураВыданныйДокументыОснования.ДокументОснование.Грузополучатель = &Грузополучатель
	|	И СчетФактураВыданныйДокументыОснования.Ссылка.ВидСчетаФактуры = ЗНАЧЕНИЕ(Перечисление.ВидСчетаФактурыВыставленного.Корректировочный)
	|	И (ЗначенияСвойствОбъектов.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СвойстваОбъектов.Распечатано)
	|				И ЗначенияСвойствОбъектов.Значение = ЛОЖЬ
	|			ИЛИ ЗначенияСвойствОбъектов.Объект ЕСТЬ NULL)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номер";
	
	//+Гавриленков В. 22.05.2026 #
	//Запрос.УстановитьПараметр("Дата", Константы.ДатаОтсчетаНачалаПечатиКорректСчФк.Получить());
	Запрос.УстановитьПараметр("Дата", Макс(Константы.ДатаОтсчетаНачалаПечатиКорректСчФк.Получить(), ДобавитьМесяц(ТекущаяДата(), -1)));
	//-Гавриленков В. 22.05.2026 #
	Запрос.УстановитьПараметр("Грузополучатель", Грузополучатель);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	УстановитьПривилегированныйРежим(Истина);
	
	Пока РезультатЗапроса.Следующий() Цикл                                            
		
		Если НЕ ТолькоОтметкаПечати Тогда 
			
			ДокОбъект = РезультатЗапроса.Ссылка.ПолучитьОбъект();			
			
			ДанныеДляПечати = Неопределено;
			УчетнаяПолитика = Неопределено;		
			
			ВерсияПостановления = УчетНДС.ПолучитьВерсиюПостановления(ДокОбъект.Дата);		
			Корректировочный = ДокОбъект.ВидСчетаФактуры = Перечисления.ВидСчетаФактурыВыставленного.Корректировочный;
			
			ДокОбъект.СобратьДанныеДляПечати(ДанныеДляПечати, УчетнаяПолитика);
			
			Если ВерсияПостановления = 2 Тогда			
				
				Если Корректировочный Тогда
					
					Если Константы.ИспользоватьУКДВместоКорректировочногоСчетаФактуры.Получить() Тогда
						ТабДокумент = ДокОбъект.ПечатьУниверсальногоКорректировочногоДокумента();
					Иначе
						ТабДокумент = ДокОбъект.ПечатьКорректировочногоСчетаФактуры1137(ДанныеДляПечати); 
					КонецЕсли;
					
				Иначе
					ТабДокумент = ДокОбъект.ПечатьСчетаФактуры1137(ДанныеДляПечати);
				КонецЕсли;
				
			Иначе
				
				Если Корректировочный Тогда
					
					Если Константы.ИспользоватьУКДВместоКорректировочногоСчетаФактуры.Получить() Тогда
						ТабДокумент = ДокОбъект.ПечатьУниверсальногоКорректировочногоДокумента();
					Иначе
						ТабДокумент = ДокОбъект.ПечатьКорректировочногоСчетаФактуры(ДанныеДляПечати);
					КонецЕсли;
					
				Иначе
					ТабДокумент  = ДокОбъект.ПечатьСчетаФактуры1137(ДанныеДляПечати);
				КонецЕсли;			
				
			КонецЕсли;		
			
			КолЭкземпляров = ?(Константы.ИспользоватьУКДВместоКорректировочногоСчетаФактуры.Получить(), 2, 1); 
			
			Если СтруктураДляПечати.СразуНаПринтер Тогда
				
				УниверсальныеМеханизмы.НапечататьДокумент(ТабДокумент, 
				КолЭкземпляров,                       
				СтруктураДляПечати.СразуНаПринтер, 
				ОбщегоНазначения.СформироватьЗаголовокДокумента(ДокОбъект),
				ДокОбъект.Ссылка); 
				
			Иначе
				
				УниверсальныеМеханизмы.НапечататьДокумент(ТабДокумент, 
				КолЭкземпляров,                       
				СтруктураДляПечати.СразуНаПринтер, 
				ОбщегоНазначения.СформироватьЗаголовокДокумента(ДокОбъект),
				ДокОбъект.Ссылка);
				
			КонецЕсли; 
			
		КонецЕсли;   
		
		РСМенеджерЗаписи = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
		РСМенеджерЗаписи.Объект = РезультатЗапроса.Ссылка;
		РСМенеджерЗаписи.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.Распечатано;		
		РСМенеджерЗаписи.Значение = Истина;			
		РСМенеджерЗаписи.Записать(Истина);
		
	КонецЦикла; 
	
	УстановитьПривилегированныйРежим(Ложь);   
	
	Возврат Истина;
	
КонецФункции

Функция  ПолучитьКорректировочныеСчетаФактурыДляОтправки(Грузополучатель)
	
	МассивТабДок = Новый Соответствие;   
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СчетФактураВыданныйДокументыОснования.Ссылка,
	|	СчетФактураВыданныйДокументыОснования.Ссылка.Номер КАК Номер,
	|	ЕСТЬNULL(ЗначенияСвойствОбъектов.Значение, ЛОЖЬ) КАК Значение
	|ИЗ
	|	Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	|		ПО СчетФактураВыданныйДокументыОснования.Ссылка = ЗначенияСвойствОбъектов.Объект
	|			И (ЗначенияСвойствОбъектов.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СвойстваОбъектов.ОтправленоПоЭлПочте))
	|ГДЕ
	|	ТИПЗНАЧЕНИЯ(СчетФактураВыданныйДокументыОснования.Ссылка.ДокументОснование) = ЗНАЧЕНИЕ(Документ.КорректировкаРеализации)
	|	И СчетФактураВыданныйДокументыОснования.Ссылка.Дата >= &Дата
	|	И СчетФактураВыданныйДокументыОснования.Ссылка.Проведен
	|	И СчетФактураВыданныйДокументыОснования.ДокументОснование.Грузополучатель = &Грузополучатель
	|	И СчетФактураВыданныйДокументыОснования.ДокументОснование.Грузополучатель.ОтправлятьСчетФактуруПоПочте = ИСТИНА
	|	И СчетФактураВыданныйДокументыОснования.Ссылка.ВидСчетаФактуры = ЗНАЧЕНИЕ(Перечисление.ВидСчетаФактурыВыставленного.Корректировочный)
	|	И ЕСТЬNULL(ЗначенияСвойствОбъектов.Значение, ЛОЖЬ) = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номер";
	
	Запрос.УстановитьПараметр("Дата", Константы.ДатаОтсчетаНачалаПечатиКорректСчФк.Получить());
	Запрос.УстановитьПараметр("Грузополучатель", Грузополучатель);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Пока РезультатЗапроса.Следующий() Цикл                                            
		
		ДокОбъект = РезультатЗапроса.Ссылка.ПолучитьОбъект();			
		ДанныеДляПечати = Неопределено;
		УчетнаяПолитика     = Неопределено;		
		ВерсияПостановления = УчетНДС.ПолучитьВерсиюПостановления(ДокОбъект.Дата);		
		
		Корректировочный = ДокОбъект.ВидСчетаФактуры = Перечисления.ВидСчетаФактурыВыставленного.Корректировочный;
		ДокОбъект.СобратьДанныеДляПечати(ДанныеДляПечати, УчетнаяПолитика);
		
		Если ВерсияПостановления = 2 Тогда			
			
			Если Корректировочный Тогда
				
				Если Константы.ИспользоватьУКДВместоКорректировочногоСчетаФактуры.Получить() Тогда
					ТабДокумент = ДокОбъект.ПечатьУниверсальногоКорректировочногоДокумента();
				Иначе
					ТабДокумент = ДокОбъект.ПечатьКорректировочногоСчетаФактуры1137(ДанныеДляПечати); 
				КонецЕсли;
				
			Иначе
				ТабДокумент = ДокОбъект.ПечатьСчетаФактуры1137(ДанныеДляПечати);
			КонецЕсли;
			
		Иначе
			
			Если Корректировочный Тогда
				
				Если Константы.ИспользоватьУКДВместоКорректировочногоСчетаФактуры.Получить() Тогда
					ТабДокумент = ДокОбъект.ПечатьУниверсальногоКорректировочногоДокумента();
				Иначе
					ТабДокумент = ДокОбъект.ПечатьКорректировочногоСчетаФактуры(ДанныеДляПечати);
				КонецЕсли;
				
			Иначе
				ТабДокумент  = ДокОбъект.ПечатьСчетаФактуры1137(ДанныеДляПечати);
			КонецЕсли;			
			
		КонецЕсли;		
		
		МассивТабДок.Вставить(ДокОбъект, ТабДокумент);
		
	КонецЦикла; 
	
	Возврат МассивТабДок;
	
КонецФункции

Функция СформироватьСтруктуруДляОтправкеПоПочте(АдресЭлПочты,
	Грузополучатель, 
	ДокументОснование, 
	Реализация, 
	ПечатьСФ, 
	ПечатьСчета, 
	ПечатьТорг12, 
	МассивТабДокКорректСчФк = Неопределено) Экспорт
	
	Город = Константы.Город.Получить();
	СтруктураДляОтравки = Новый Структура;
	СтруктураДляОтравки.Вставить("ЕМэйл", АдресЭлПочты);
	
	Если НЕ Грузополучатель.ВидОтправляемойСФ = Перечисления.ВидСчетФактурыДляКонтрагента.ИзСохраненныхНастроек Тогда
		СтруктураДляОтравки.Вставить("ОтправлятьСчетФактуруПоПочте", Грузополучатель.ОтправлятьСчетФактуруПоПочте);
	Иначе
		СтруктураДляОтравки.Вставить("ОтправлятьСчетФактуруПоПочте", Ложь);
	КонецЕсли;
	
	СтруктураДляОтравки.Вставить("ОтправлятьСчетПоПочте", Грузополучатель.ОтправлятьСчетПоПочте);

	// СФ и УПД
	Если НЕ  Грузополучатель.ВидОтправляемойСФ = Перечисления.ВидСчетФактурыДляКонтрагента.ИзСохраненныхНастроек Тогда
		
		НазваниеСФ = ОбщегоНазначения.СформироватьЗаголовокДокумента(ДокументОснование);
		НазваниеСФ = СтрЗаменить(НазваниеСФ, "г.", "г");
		
		Если Грузополучатель.ВидОтправляемойСФ = Перечисления.ВидСчетФактурыДляКонтрагента.УПД 
		 ИЛИ Грузополучатель.ВидОтправляемойСФ = Перечисления.ВидСчетФактурыДляКонтрагента.УПДИКодПроизводителя Тогда
			
			Если ДокументОснование.ВидСчетаФактуры = Перечисления.ВидСчетаФактурыВыставленного.Корректировочный Тогда 
				
				Если Константы.ИспользоватьУКДВместоКорректировочногоСчетаФактуры.Получить() Тогда
					ЗаголовокДокумента = "УКД";
				Иначе 
					ЗаголовокДокумента = "Счет-фактура корректировочный";	
				КонецЕсли; 
				
			Иначе
				ЗаголовокДокумента = "";
			КонецЕсли;
			
			НазваниеСФ = ОбщегоНазначения.СформироватьЗаголовокДокумента(ДокументОснование, ЗаголовокДокумента);
			НазваниеСФ = СтрЗаменить(НазваниеСФ, "г.", "г");   
			
		КонецЕсли;
		
		НазваниеСФ = НазваниеСФ + " " + Город;
		
		Если Грузополучатель.ФорматExcel = Перечисления.ФорматExcel.Excel2007 Тогда 
			
			СтруктураДляОтравки.Вставить("ЗаголовокФайла", КаталогВременныхФайлов() + СтрЗаменить(НазваниеСФ, "/", "-") + ".xlsx");
			СтруктураДляОтравки.Вставить("ТипФайлаТабДок", ТипФайлаТабличногоДокумента.XLSX);
			
		Иначе 
			
			СтруктураДляОтравки.Вставить("ЗаголовокФайла", КаталогВременныхФайлов() + СтрЗаменить(НазваниеСФ, "/", "-") + ".xls");
			СтруктураДляОтравки.Вставить("ТипФайлаТабДок", ТипФайлаТабличногоДокумента.XLS);
			
		КонецЕсли;
		
	КонецЕсли; 
	

	// Счет
	СтруктураДляОтравки.Вставить("ОтправлятьСчетПоПочте", Грузополучатель.ОтправлятьСчетПоПочте);
	
	НазваниеСчета = ОбщегоНазначения.СформироватьЗаголовокДокумента(Реализация, "Счет");
	НазваниеСчета = СтрЗаменить(НазваниеСчета, "г.", "г");
	
	Если Грузополучатель.ФорматExcelдляСчета = Перечисления.ФорматExcel.Excel2007 Тогда 
		
		СтруктураДляОтравки.Вставить("ЗаголовокФайлаСчет", КаталогВременныхФайлов()+СтрЗаменить(НазваниеСчета, "/", "-") + ".xlsx");
		СтруктураДляОтравки.Вставить("ТипФайлаСчетТабДок", ТипФайлаТабличногоДокумента.XLSX);
		
	Иначе 
		
		СтруктураДляОтравки.Вставить("ЗаголовокФайлаСчет", КаталогВременныхФайлов()+СтрЗаменить(НазваниеСчета, "/", "-") + ".xls");
		СтруктураДляОтравки.Вставить("ТипФайлаСчетТабДок", ТипФайлаТабличногоДокумента.XLS);
		
	КонецЕсли;
	
	//Торг12
	СтруктураДляОтравки.Вставить("ОтправлятьТорг12ПоПочте", Грузополучатель.ОтправлятьТорг12ПоПочте);
	
	НазваниеТорг12 = ОбщегоНазначения.СформироватьЗаголовокДокумента(Реализация, "Торг12");
	НазваниеТорг12 = СтрЗаменить(НазваниеТорг12, "г.", "г");
	
	Если Грузополучатель.ФорматExcelдляСчета = Перечисления.ФорматExcel.Excel2007 Тогда 
		
		СтруктураДляОтравки.Вставить("ЗаголовокФайлаТорг12", КаталогВременныхФайлов()+СтрЗаменить(НазваниеТорг12, "/", "-") + ".xlsx");
		СтруктураДляОтравки.Вставить("ТипФайлаТорг12ТабДок", ТипФайлаТабличногоДокумента.XLSX);
		
	Иначе 
		
		СтруктураДляОтравки.Вставить("ЗаголовокФайлаТорг12", КаталогВременныхФайлов()+СтрЗаменить(НазваниеТорг12, "/", "-") + ".xls");
		СтруктураДляОтравки.Вставить("ТипФайлаТорг12ТабДок", ТипФайлаТабличногоДокумента.XLS);
		
	КонецЕсли;	

	СтруктураДляОтравки.Вставить("ОтправлятьТоварныйЧекПоПочте",Ложь);
	
	Если Грузополучатель.ОтправлятьСчетФактуруПоПочте И ЗначениеЗаполнено(Реализация) 
	   И (Реализация.ДоговорКонтрагента.РозничнаяПродажа ИЛИ Реализация.ДоговорКонтрагента.ЛицевойСчет) Тогда
		
		СтруктураДляОтравки.ОтправлятьТоварныйЧекПоПочте = Истина;   
		
		НазваниеТоварныйЧек = ОбщегоНазначения.СформироватьЗаголовокДокумента(Реализация, "Товарный чек");
		НазваниеТоварныйЧек = СтрЗаменить(НазваниеТоварныйЧек, "г.", "г");
		
		СтруктураДляОтравки.Вставить("ЗаголовокФайлаТоварныйЧек", КаталогВременныхФайлов()+СтрЗаменить(НазваниеТоварныйЧек, "/", "-") + ".xls");
		СтруктураДляОтравки.Вставить("ТипФайлаТоварныйЧек", ТипФайлаТабличногоДокумента.XLS);
		
		СтруктураДляОтравки.ОтправлятьСчетФактуруПоПочте = Ложь;		
		
	КонецЕсли;
	
	// общая часть
	ТемаПисьма = "";
	СообщениеОтправки = "";
	СтрокаОтправкиУКД = "";
	
	Если НЕ Грузополучатель.ВидОтправляемойСФ = Перечисления.ВидСчетФактурыДляКонтрагента.ИзСохраненныхНастроек Тогда
		
		Если Грузополучатель.ОтправлятьСчетФактуруПоПочте И ПечатьСФ Тогда
			
			ТемаПисьма = НазваниеСФ;
			СообщениеОтправки = НазваниеСФ + " для контрагента " + Грузополучатель + " отправлена."
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Грузополучатель.ОтправлятьСчетПоПочте И ПечатьСчета Тогда 
		
		ТемаПисьма = ?(ТемаПисьма = "", НазваниеСчета, ТемаПисьма + "; " + НазваниеСчета);
		СообщениеОтправки = ?(СообщениеОтправки = "", 
		НазваниеСчета + " для контрагента " + Грузополучатель + " отправлен.", 
		"Документы : " + НазваниеСФ + " и " + НазваниеСчета + " для контрагента " + Грузополучатель + " отправлены.");
		
	КонецЕсли;
	
	Если Грузополучатель.ОтправлятьТорг12ПоПочте И ПечатьТорг12 Тогда 
		
		ТемаПисьма = ?(ТемаПисьма = "", НазваниеТорг12, ТемаПисьма + "; " +НазваниеТорг12);
		СообщениеОтправки = ?(СообщениеОтправки = "", 
		НазваниеТорг12 + " для контрагента " + Грузополучатель+ " отправлен.", 
		СообщениеОтправки + "; " + НазваниеТорг12 + " для контрагента " + Грузополучатель + " отправлена.");
		
	КонецЕсли;
	
	Если СтруктураДляОтравки.ОтправлятьТоварныйЧекПоПочте Тогда
		
		ТемаПисьма = ?(ТемаПисьма = "", НазваниеТоварныйЧек, ТемаПисьма + "; " + НазваниеТоварныйЧек);
		СообщениеОтправки = ?(СообщениеОтправки = "", 
		НазваниеТоварныйЧек + " для контрагента " + Грузополучатель + " отправлен.", 
		СообщениеОтправки + "; " + НазваниеТоварныйЧек + " для контрагента " + Грузополучатель + " отправлен.");
		
	КонецЕсли;

	
	Если Не МассивТабДокКорректСчФк = Неопределено И МассивТабДокКорректСчФк.Количество() > 0 Тогда
		
		СоответствиеКорректировочныхСчФактур = Новый Соответствие;   
		
		Для Каждого СтрокаМассива Из МассивТабДокКорректСчФк Цикл
			
			Если Константы.ИспользоватьУКДВместоКорректировочногоСчетаФактуры.Получить() Тогда 
				НазваниеСФ = "УКД № " + ОбщегоНазначения.ПолучитьНомерНаПечать(СтрокаМассива.Ключ) + " от " + Формат(СтрокаМассива.Ключ.Дата, "ДФ='дд ММММ гггг'") + " г";
			Иначе
				НазваниеСФ = "Счет-фактура корректировочный № " + ОбщегоНазначения.ПолучитьНомерНаПечать(СтрокаМассива.Ключ) 
				+ " от " + Формат(СтрокаМассива.Ключ.Дата, "ДФ='дд ММММ гггг'") + " г"; 
			КонецЕсли;
			
			НазваниеСФ = НазваниеСФ + " " + Город;
			СтрокаОтправкиУКД = ?(СтрокаОтправкиУКД = "", НазваниеСФ,СтрокаОтправкиУКД + ";" + НазваниеСФ);
			
			Если Грузополучатель.ФорматExcelдляСчета = Перечисления.ФорматExcel.Excel2007 Тогда 
				ПутьФайлаУКД = КаталогВременныхФайлов() + СтрЗаменить(НазваниеСФ, "/", "-") + ".xlsx";	
			Иначе
				ПутьФайлаУКД = КаталогВременныхФайлов() + СтрЗаменить(НазваниеСФ, "/", "-") + ".xls";
			КонецЕсли;
			
			СоответствиеКорректировочныхСчФактур.Вставить(ПутьФайлаУКД, СтрокаМассива.Значение);;
			
		КонецЦикла; 
		
		Если Грузополучатель.ФорматExcelдляСчета = Перечисления.ФорматExcel.Excel2007 Тогда 
			СтруктураДляОтравки.Вставить("ТипФайлаУКД", ТипФайлаТабличногоДокумента.XLSX);
		Иначе 
			СтруктураДляОтравки.Вставить("ТипФайлаУКД", ТипФайлаТабличногоДокумента.XLS);
		КонецЕсли;
		
		СтруктураДляОтравки.Вставить("ЗаголовкиФайловУКД", СоответствиеКорректировочныхСчФактур);
		СтруктураДляОтравки.Вставить("МассивТабДокКорректСчФк", МассивТабДокКорректСчФк);   
		
		ТемаПисьма = ?(ТемаПисьма = "", СтрокаОтправкиУКД, ТемаПисьма + ";" + СтрокаОтправкиУКД); 
		СообщениеОтправки = ?(СообщениеОтправки = "", 
		СтрокаОтправкиУКД + " для контрагента " + Грузополучатель + " отправлен.", 
		СообщениеОтправки + "; " +СтрокаОтправкиУКД); 		
		
	КонецЕсли;
	
	СтруктураДляОтравки.Вставить("ТемаПисьма",	ТемаПисьма);
	СтруктураДляОтравки.Вставить("Сообщение",	СообщениеОтправки); 
	
	Возврат СтруктураДляОтравки; 
	
КонецФункции

Функция ЗакрытьОткрытуюФорму() Экспорт
	
	Если Не ЭтоОбособленноеПодразделение() тогда
		
		Сообщить("Обработка не предназначена для вашей базы!");
		Возврат Истина;
		
	КонецЕсли;	
	
	Возврат Ложь;
	
КонецФункции	

Функция ЗафиксироватьПечатьДокумента(ДокументПечати,МакетПечати,СинонимМакета) Экспорт 
	
	НоваяЗапись = РегистрыСведений.НапечатанныеДокументы.СоздатьМенеджерЗаписи();
	
	НоваяЗапись.Документ = ДокументПечати;
	НоваяЗапись.Макет = МакетПечати;
	НоваяЗапись.СинонимМакета = СинонимМакета;
	НоваяЗапись.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	НоваяЗапись.ДатаПечати = ТекущаяДата();
	
	НоваяЗапись.Записать();
	
КонецФункции	

Функция ПроверитьПараметрыПодключения() Экспорт 
	
	КластерСерверов = СокрЛП(Константы.КластерСерверов.Получить());
	ИмяИБ = СокрЛП(Константы.ИмяИБВКластере.Получить());
	
	Возврат ВРег(СтрокаСоединенияИнформационнойБазы()) = ВРег("Srvr=""" + КластерСерверов + """;Ref=""" + ИмяИБ + """;"); 

КонецФункции

Функция ВычиститьНепечатныеСимволы(СтрокаАнализа) Экспорт 
	
	СтрокаАнализа = СтрЗаменить(СтрокаАнализа, Символы.ВТаб, "");
	СтрокаАнализа = СтрЗаменить(СтрокаАнализа, Символы.Таб, "");
	
	Возврат СтрокаАнализа;

КонецФункции

Функция ЭтоОбособленноеПодразделение() Экспорт
	
	ТекБаза = Константы.База.Получить();
	
	Если  ТекБаза = Перечисления.НазваниеБазы.Самара ИЛИ 
		ТекБаза = Перечисления.НазваниеБазы.Владимир ИЛИ
		ТекБаза = Перечисления.НазваниеБазы.Рязань ИЛИ 
		ТекБаза = Перечисления.НазваниеБазы.Ярославль ИЛИ 
		ТекБаза = Перечисления.НазваниеБазы.Тула ИЛИ 
		ТекБаза = Перечисления.НазваниеБазы.Калуга ИЛИ 
		ТекБаза = Перечисления.НазваниеБазы.Молодогвардейская ИЛИ 
		ТекБаза = Перечисления.НазваниеБазы.ЮГ ИЛИ 
		ТекБаза = Перечисления.НазваниеБазы.Север ИЛИ 
		ТекБаза = Перечисления.НазваниеБазы.Тверь ИЛИ
		ТекБаза = Перечисления.НазваниеБазы.Восток ИЛИ 
		ТекБаза = Перечисления.НазваниеБазы.Ростов Тогда 
		Возврат Истина;
		
	Иначе
		Возврат Ложь;
	КонецЕсли;	
	
КонецФункции

Функция ЭтоОбособленноеПодразделениеОтдельногоЮрЛица() Экспорт
	
	ТекБаза = Константы.База.Получить();
	
	Если ТекБаза = Перечисления.НазваниеБазы.НабережныеЧелны Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;	
	
КонецФункции

Функция ЗаполнитьОстатокВДокументе(ОбъектДокумент)  Экспорт
	
	Для каждого Стр Из ОбъектДокумент.Товары Цикл
		
		Стр.СвободныйОстаток = 0;
		Стр.ВЗаказе = 0;
		
	КонецЦикла;
	
	ТзТовары = ОбъектДокумент.Товары.Выгрузить(, "НомерСтроки,Номенклатура");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТЗ.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ТаблицаНоменклатура
	|ИЗ
	|	&ТЗ КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыНаСкладахОстатки.Номенклатура,
	|	ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0) - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0) КАК Остаток
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(
	|			&ДатаОстатков,
	|			Номенклатура В
	|					(ВЫБРАТЬ
	|						ТаблицаНоменклатура.Номенклатура
	|					ИЗ
	|						ТаблицаНоменклатура КАК ТаблицаНоменклатура)
	|				И Склад В
	|					(ВЫБРАТЬ
	|						Склады.Ссылка
	|					ИЗ
	|						Справочник.Склады КАК Склады
	|					ГДЕ
	|						Склады.ИспользоватьВЗаполненииСвободногоОстаткаВДокументахПоступления)) КАК ТоварыНаСкладахОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(
	|				&ДатаОстатков,
	|				Номенклатура В
	|						(ВЫБРАТЬ
	|							ТаблицаНоменклатура.Номенклатура
	|						ИЗ
	|							ТаблицаНоменклатура КАК ТаблицаНоменклатура)
	|					И Склад В
	|						(ВЫБРАТЬ
	|							Склады.Ссылка
	|						ИЗ
	|							Справочник.Склады КАК Склады
	|						ГДЕ
	|							Склады.ИспользоватьВЗаполненииСвободногоОстаткаВДокументахПоступления)) КАК ТоварыВРезервеНаСкладахОстатки
	|		ПО ТоварыНаСкладахОстатки.Номенклатура = ТоварыВРезервеНаСкладахОстатки.Номенклатура
	|ГДЕ
	|	ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0) - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0) > 0";
	
	Запрос.УстановитьПараметр("ТЗ", ТзТовары);
	Запрос.УстановитьПараметр("ДатаОстатков", Новый Граница(ОбъектДокумент.МоментВремени(), ВидГраницы.Включая));
	
	
	ТаблицаОстатков = Запрос.Выполнить().Выгрузить();
	
	Для каждого СтрТЧ Из ТаблицаОстатков Цикл
		
		ОтборПоНоменклатуре = Новый Структура("Номенклатура", СтрТЧ.Номенклатура);
		НайденныеСтроки = ТзТовары.НайтиСтроки(ОтборПоНоменклатуре);
		
		Если НайденныеСтроки <> Неопределено Тогда 
			
			Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				ОбъектДокумент.Товары[НайденнаяСтрока.НомерСтроки - 1].СвободныйОстаток = СтрТЧ.Остаток;
			КонецЦикла;
			
		КонецЕсли;
	КонецЦикла;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТЗ.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ТаблицаНоменклатура
	|ИЗ
	|	&ТЗ КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказыПоставщикамОстатки.Номенклатура,
	|	СУММА(ЗаказыПоставщикамОстатки.КоличествоОстаток - ЕСТЬNULL(РазмещениеЗаказовПокупателейОстатки.КоличествоОстаток, 0)) КАК РазмещеноБезЗаказаПокупателя
	|ИЗ
	|	РегистрНакопления.ЗаказыПоставщикам.Остатки(
	|			,
	|			Номенклатура В
	|				(ВЫБРАТЬ
	|					ТаблицаНоменклатура.Номенклатура
	|				ИЗ
	|					ТаблицаНоменклатура КАК ТаблицаНоменклатура)) КАК ЗаказыПоставщикамОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РазмещениеЗаказовПокупателей.Остатки(
	|				,
	|				Номенклатура В
	|					(ВЫБРАТЬ
	|						ТаблицаНоменклатура.Номенклатура
	|					ИЗ
	|						ТаблицаНоменклатура КАК ТаблицаНоменклатура)) КАК РазмещениеЗаказовПокупателейОстатки
	|		ПО ЗаказыПоставщикамОстатки.Номенклатура = РазмещениеЗаказовПокупателейОстатки.Номенклатура
	|ГДЕ
	|	ЗаказыПоставщикамОстатки.КоличествоОстаток - ЕСТЬNULL(РазмещениеЗаказовПокупателейОстатки.КоличествоОстаток, 0) > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказыПоставщикамОстатки.Номенклатура";
	
	Запрос.УстановитьПараметр("ТЗ", ТзТовары);
	Запрос.УстановитьПараметр("ДатаОстатков", Новый Граница(ОбъектДокумент.МоментВремени(), ВидГраницы.Включая));
	
	
	ТаблицаОстатков = Запрос.Выполнить().Выгрузить();
	
	Для каждого СтрТЧ Из ТаблицаОстатков Цикл
		
		ОтборПоНоменклатуре = Новый Структура("Номенклатура", СтрТЧ.Номенклатура);
		НайденныеСтроки = ТзТовары.НайтиСтроки(ОтборПоНоменклатуре);
		
		Если НайденныеСтроки <> Неопределено Тогда 
			
			Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				ОбъектДокумент.Товары[НайденнаяСтрока.НомерСтроки - 1].ВЗаказе = СтрТЧ.РазмещеноБезЗаказаПокупателя;
			КонецЦикла;
			
		КонецЕсли;
	КонецЦикла;
	
КонецФункции // ЗаполнитьОстатокВДокументе()

Процедура СоздатьИОтправитьАкт(ТекАкт, ТекКонтрагент, АдресЭлектроннойПочты, ВсегоАктов = 0, НомерТекущегоАкта = 0) Экспорт 
	
	ТекАктОбъект = 	ТекАкт.ПолучитьОбъект();
	
	УчетнаяЗапись = Справочники.УчетныеЗаписиЭлектроннойПочты.ДляСверки;
	Профиль = УправлениеЭлектроннойПочтой.ПолучитьИнтернетПочтовыйПрофиль(УчетнаяЗапись);
	
	Если АдресЭлектроннойПочты = "" Тогда 
		АдресЭлектроннойПочты = МСК.ПолучитьЭлектронныйАдрес(ТекКонтрагент);    
	КонецЕсли;
	
	//!!!!!!!!!!!!!!!!!!!
	//АдресЭлектроннойПочты = "MakarovaMarina@list.ru";	
	//АдресЭлектроннойПочты = "svetlov_dn@moskvorechie.ru";
	
	
	Если  АдресЭлектроннойПочты <> "" Тогда     
		
		ПечатныйДокумент = ТекАктОбъект.ПечатьАктаСверки();
		
		Почта = Новый ИнтернетПочта; 
		УдалосьПодключиться = Ложь;
		
		Попытка
			
			Почта.Подключиться(Профиль);
			УдалосьПодключиться = Истина;
			
		Исключение
		КонецПопытки;
		
		Если НЕ УдалосьПодключиться Тогда 
			
			Попытка
				
				Почта.Подключиться(Профиль);
				УдалосьПодключиться = Истина;
				
			Исключение
			КонецПопытки;
			
		КонецЕсли;
		
		Если НЕ УдалосьПодключиться Тогда 
			
			Попытка
				
				Почта.Подключиться(Профиль);
				УдалосьПодключиться = Истина;
				
			Исключение
				
				ТекстСообщения = "К почтовому серверу подключиться не удалось!";
				#Если Клиент Тогда
					Сообщить(ТекстСообщения);
				#Иначе
					ЗаписьЖурналаРегистрации("ОбработкаКонтрольИОтправкаАктовСверкиВзаиморасчетов", УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
				#КонецЕсли 
				
				Возврат;
				
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	ДатаНачалаБезВремени = Формат(ТекАкт.ДатаНачала, "ДФ=dd.MM.yyyy");
	ДатаОкончанияБезВремени = Формат(ТекАкт.ДатаОкончания, "ДФ=dd.MM.yyyy");
	
	ЗаголовокФайла = "Акт_сверки_С_" + СтрЗаменить(ДатаНачалаБезВремени, ".", "_") + "_по_" + СтрЗаменить(ДатаОкончанияБезВремени, ".", "_") + ".xlsx";
	
	ПечатныйДокумент.Записать(КаталогВременныхФайлов() + ЗаголовокФайла, ТипФайлаТабличногоДокумента.XLSX);
	
	Сообщение = Новый ИнтернетПочтовоеСообщение;
	Сообщение.Тема = "Сверка взаиморасчетов с ООО Москворечье Трейдинг с " + ДатаНачалаБезВремени+ " по " +ДатаОкончанияБезВремени;
	
	Если ТекАкт.ДатаНачала = НачалоМесяца(ТекАкт.ДатаНачала) И ТекАкт.ДатаОкончания = КонецМесяца(ТекАкт.ДатаОкончания) Тогда 
		
		// сверка за месяц
		ТекстСообщенияОтправки = "Уважаемый клиент!" + Символы.ПС +
		"Вам отправлен акт сверки взаиморасчетов за месяц с " + ДатаНачалаБезВремени+
		" по " + ДатаОкончанияБезВремени + "." + Символы.ПС +
		"Пожалуйста, направьте ответ на адрес " + СокрЛП(УчетнаяЗапись.АдресЭлектроннойПочты) + " согласны или не согласны с данными в документе. " + Символы.ПС +
		"Заранее спасибо," + Символы.ПС + 
		"Бухгалтерия ООО Москворечье-Трейдинг.";
		
	ИначеЕсли ТекАкт.ДатаНачала = НачалоМесяца(ТекАкт.ДатаНачала) И ТекАкт.ДатаОкончания = КонецКвартала(ТекАкт.ДатаНачала) Тогда 	
		
		// квартальная сверка
		ТекстСообщенияОтправки = "Уважаемый клиент!" + Символы.ПС +
		
		"Вам отправлен акт сверки взаиморасчетов за квартал с " + ДатаНачалаБезВремени+
		" по " + ДатаОкончанияБезВремени+ "." + Символы.ПС +
		"Пожалуйста, распечатайте документ и в случае согласия с данными поставьте печать и подпись. " + Символы.ПС +
		"Заранее спасибо," + Символы.ПС + 
		"Бухгалтерия ООО Москворечье-Трейдинг.";			
		
	Иначе
		
		// произвольные даты
		ТекстСообщенияОтправки = "Уважаемый клиент!" + Символы.ПС +
		"Вам отправлен акт сверки взаиморасчетов с " + ДатаНачалаБезВремени+
		" по " + ДатаОкончанияБезВремени+ "." + Символы.ПС +
		"Пожалуйста, направьте ответ на адрес " + СокрЛП(УчетнаяЗапись.АдресЭлектроннойПочты) + " согласны или не согласны с данными в документе. " + Символы.ПС +
		"Заранее спасибо," + Символы.ПС + 
		"Бухгалтерия ООО Москворечье-Трейдинг.";
		
	КонецЕсли;
	
	Сообщение.Тексты.Добавить(ТекстСообщенияОтправки, ТипТекстаПочтовогоСообщения.ПростойТекст);
	
	МассивАдресов = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(АдресЭлектроннойПочты,";");  // ТекСтр.ЭлАдрес   "svetlov_dn@moskvorechie.ru"
	
	Для каждого ТекАдрес Из МассивАдресов Цикл
		Сообщение.Получатели.Добавить(ТекАдрес);    
	КонецЦикла;
	
	//Сообщение.Получатели.Добавить("makarova_mv@moskvorechie.ru"); 
	Сообщение.Отправитель = УчетнаяЗапись.АдресЭлектроннойПочты;
	Сообщение.Вложения.Добавить(КаталогВременныхФайлов() + ЗаголовокФайла, ТипФайлаТабличногоДокумента.XLSX);
	
	ОтправкаСостоялась = Ложь;
	
	Попытка
		
		Почта.Послать(Сообщение);
		ТекстСообщения = ?(НомерТекущегоАкта = 0, "", Строка(НомерТекущегоАкта) + " из ")+
		?(ВсегоАктов = 0, "", Строка(ВсегоАктов) + ": ")+
		"Отправлено письмо " + ТекКонтрагент + " на адрес " + АдресЭлектроннойПочты +
		" с актом сверки взаиморасчетов с " + ДатаНачалаБезВремени + " по " + ДатаОкончанияБезВремени + ".";
		
		Сообщить(ТекстСообщения);
		ОтправкаСостоялась = Истина;
		
	Исключение
	КонецПопытки;
	
	Сообщение.Получатели.Очистить();
	Сообщение.Вложения.Очистить();
	УдалитьФайлы(КаталогВременныхФайлов()+ЗаголовокФайла);
	
	// зафиксируем факт отправки
	Если ОтправкаСостоялась Тогда  
		
		НоваяЗапись = РегистрыСведений.РассылкаДокументов.СоздатьМенеджерЗаписи();
		НоваяЗапись.Период 		= НачалоДня(ТекущаяДата());
		НоваяЗапись.Контрагент 	= ТекКонтрагент;
		НоваяЗапись.Документ 		= ТекАкт;
		НоваяЗапись.ТипРассылки 	= Перечисления.ТипыРассылокЭлектроннойПочты.АктСверкиВзаиморасчетов;
		НоваяЗапись.ВремяОтправки 	= ТекущаяДата();
		ТекстСообщения = "Отправлено письмо " + ТекКонтрагент + " на адрес " + АдресЭлектроннойПочты +
		" с актом сверки взаиморасчетов с " + ТекАкт.ДатаНачала + " по " + ТекАкт.ДатаОкончания + ".";
		НоваяЗапись.Комментарий 	= ТекстСообщения;	
		
		НоваяЗапись.Записать();		
		
	КонецЕсли;
	
КонецПроцедуры	

Функция  ЗавершитьОтправку(ТекГрузополучатель, ТекстТелаПисьма, ТекстСПеречнемЗаказов, ТекЗаказПокупателя, АдресЭлПочтыДляОтправки, ДокументРодитель)
	
	Если ТекГрузополучатель = "!!!" Тогда 
		Возврат Истина;
	КонецЕсли;
	
	Если ТекстТелаПисьма <> "" Тогда 
		
		ТекстТелаПисьма = ТекстТелаПисьма + "</table><p>С Уважением,<br>Компания «Москворечье-" + Константы.База.Получить() + "»</p>";
		
		// и добавим приветствие
		ТекстТелаПисьма = "<p>Уважаемый клиент!<br>Информация по Заказу(-ам) " + ТекстСПеречнемЗаказов + "</p>" + ТекстТелаПисьма;
		
		//отправляем
		УчетнаяЗапись = Константы.ОсновнаяУчетнаяЗаписьЭлектроннойПочты.Получить();
		Профиль = УправлениеЭлектроннойПочтой.ПолучитьИнтернетПочтовыйПрофиль(УчетнаяЗапись);
		
		Сообщение = Новый ИнтернетПочтовоеСообщение;
		Сообщение.Тема = "Информация о заказе № " + ТекстСПеречнемЗаказов;
		
		Почта = Новый ИнтернетПочта; 
		ОтправитьПочту = Истина;
		
		Попытка
			Почта.Подключиться(Профиль);
		Исключение
			
			ЗаписьЖурналаРегистрации("Регламентное задание по отправке электронной почты", УровеньЖурналаРегистрации.Ошибка,,,
			"Не удалось подключиться к почтовому серверу!");
			ОтправитьПочту = Ложь;
			Возврат Ложь;
			
		КонецПопытки;
		
		Если ОтправитьПочту Тогда 
			
			МассивАдресов = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(АдресЭлПочтыДляОтправки, ";");
			
			Для каждого ТекАдрес Из МассивАдресов Цикл
				
				Сообщение.Получатели.Добавить(ТекАдрес); 
				//Сообщение.Получатели.Добавить("MakarovaMarina@list.ru"); 
				//Сообщение.Получатели.Добавить("svetlov_dn@moskvorechie.ru");
			КонецЦикла;
			
			Сообщение.Отправитель = УчетнаяЗапись.АдресЭлектроннойПочты;
			Сообщение.Тексты.Добавить(ТекстТелаПисьма,ТипТекстаПочтовогоСообщения.HTML);
			
			Попытка
				Почта.Послать(Сообщение);
			Исключение
				
				ЗаписьЖурналаРегистрации("Регламентное задание по отправке электронной почты", УровеньЖурналаРегистрации.Ошибка,,,
				"Не удалось отправить письмо клиенту " + ТекГрузополучатель.Наименование+" по адресу " + АдресЭлПочтыДляОтправки+
				" с информацией об отказе по документу " + ТекЗаказПокупателя);
				
				Возврат Ложь;
			КонецПопытки;
			
			Сообщение.Получатели.Очистить();
			
			Почта.Отключиться();
			
			ЗаписьЖурналаРегистрации("Регламентное задание по отправке электронной почты", УровеньЖурналаРегистрации.Информация,,,
			"Отправлено письмо клиенту " + ТекГрузополучатель.Наименование + " по адресу " + АдресЭлПочтыДляОтправки +
			" с информацией об отказе по документу " + ТекЗаказПокупателя);
			
			// зафиксируем факт отправки
			НЗРассылкаДокументов 				= РегистрыСведений.РассылкаДокументов.СоздатьМенеджерЗаписи();
			НЗРассылкаДокументов.Период 		= НачалоДня(ТекущаяДата());
			НЗРассылкаДокументов.Контрагент 	= ТекГрузополучатель;
			НЗРассылкаДокументов.Документ 		= ТекЗаказПокупателя;
			НЗРассылкаДокументов.ТипРассылки 	= Перечисления.ТипыРассылокЭлектроннойПочты.ЗакрытиеЗаказаПоставщику;
			НЗРассылкаДокументов.ВремяОтправки 	= ТекущаяДата();
			НЗРассылкаДокументов.Комментарий 	= "выполнено регламентным заданием по " + ДокументРодитель;	
			НЗРассылкаДокументов.Записать();
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Процедура ОтправкаПисемПоЭлектроннойПочте() Экспорт 
	
	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда 
		
		ЗаписьЖурналаРегистрации("Отправка писем по электронной почте", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Отменена работа регламентного задания из-за несоответствия параметров подключения к ИБ");
		Возврат;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ДокументыКОтправке.ТипСообщения,
	|	ДокументыКОтправке.ДокументКОтправке,
	|	ДокументыКОтправке.АктуальноДо
	|ИЗ
	|	РегистрСведений.ДокументыКОтправке КАК ДокументыКОтправке";
	
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.АктуальноДо < ТекущаяДата() Тогда 
			
			Рег = РегистрыСведений.ДокументыКОтправке.СоздатьНаборЗаписей();
			Рег.Отбор.ДокументКОтправке.Установить(Выборка.ДокументКОтправке);   
			Рег.Отбор.ТипСообщения.Установить(Выборка.ТипСообщения);
			Рег.Отбор.АктуальноДо.Установить(Выборка.АктуальноДо);
			
			Рег.Очистить();
			Рег.Записать();
			
		Иначе
			
			Если ТипЗнч(Выборка.ДокументКОтправке) = Тип("ДокументСсылка.КорректировкаЗаказаПокупателя") Тогда 
				
				Если Выборка.ТипСообщения = Перечисления.ТипыРассылокЭлектроннойПочты.ПроведениеКорректировкиЗаказа Тогда 
					
					ГрузополучательИзЗаказа = Выборка.ДокументКОтправке.ЗаказПокупателя.Грузополучатель;
					
					Если НЕ ЗначениеЗаполнено(ГрузополучательИзЗаказа) Тогда 
						ГрузополучательИзЗаказа = Выборка.ДокументКОтправке.Контрагент;
					КонецЕсли;
					
					Запрос = Новый Запрос;
					Запрос.Текст = "ВЫБРАТЬ
					|	КонтактнаяИнформация.Представление
					|ИЗ
					|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
					|ГДЕ
					|	КонтактнаяИнформация.Объект = &Объект
					|	И КонтактнаяИнформация.Тип = &Тип
					|	И КонтактнаяИнформация.Вид = &Вид";
					
					Запрос.УстановитьПараметр("Объект", ГрузополучательИзЗаказа);
					Запрос.УстановитьПараметр("Тип", Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
					Запрос.УстановитьПараметр("Вид", Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыКонтрагентаДляОтказа);
					Результат = Запрос.Выполнить();
					ВыборкаПочта = Результат.Выбрать();
					
					Если ВыборкаПочта.Следующий() Тогда
						
						АдресЭлПочтыДляОтправки = ВыборкаПочта.Представление;
						
						Если Не ПустаяСтрока(АдресЭлПочтыДляОтправки) Тогда
							
							//формируем письмо
							// отправляются только строки с причинами отказа  Отказ Покупателя и Отказ поставщика
							Запрос = Новый Запрос;
							Запрос.Текст = 
							"ВЫБРАТЬ
							|	КорректировкаЗаказаПокупателяТовары.Номенклатура,
							|	КорректировкаЗаказаПокупателяТовары.Номенклатура.Родитель КАК Родитель,
							|	КорректировкаЗаказаПокупателяТовары.Номенклатура.КодПроизводителя КАК КодПроизводителя,
							|	КорректировкаЗаказаПокупателяТовары.Номенклатура.Наименование КАК Наименование,
							|	-1 * КорректировкаЗаказаПокупателяТовары.Количество КАК Количество,
							|	КорректировкаЗаказаПокупателяТовары.Причина,
							|	КорректировкаЗаказаПокупателяТовары.Ссылка.ЗаказПокупателя
							|ИЗ
							|	Документ.КорректировкаЗаказаПокупателя.Товары КАК КорректировкаЗаказаПокупателяТовары
							|ГДЕ
							|	КорректировкаЗаказаПокупателяТовары.Ссылка = &Ссылка
							|	И (КорректировкаЗаказаПокупателяТовары.Причина = ЗНАЧЕНИЕ(Перечисление.ПричиныКорректировкиСборки.ОтказПоставщика)
							|			ИЛИ КорректировкаЗаказаПокупателяТовары.Причина = ЗНАЧЕНИЕ(Перечисление.ПричиныКорректировкиСборки.ОтказКлиента)
							|			ИЛИ КорректировкаЗаказаПокупателяТовары.Причина = ЗНАЧЕНИЕ(Перечисление.ПричиныКорректировкиСборки.ИстекСрокРезервирования))
							|	И КорректировкаЗаказаПокупателяТовары.Количество < 0";
							
							
							Запрос.УстановитьПараметр("Ссылка", Выборка.ДокументКОтправке);
							Результат = Запрос.Выполнить();
							ВыборкаДанных = Результат.Выбрать();
							
							ТекстТелаПисьма = "" ;
							СписокЗаказов = Новый СписокЗначений; 
							ТекстСПеречнемЗаказов = "";
							
							Пока ВыборкаДанных.Следующий() Цикл 
								
								Если СписокЗаказов.НайтиПоЗначению(ВыборкаДанных.ЗаказПокупателя) = Неопределено Тогда 
									
									СписокЗаказов.Добавить(ВыборкаДанных.ЗаказПокупателя);
									
									ТекстСПеречнемЗаказов = ТекстСПеречнемЗаказов +
									?(ТекстСПеречнемЗаказов = "", ВыборкаДанных.ЗаказПокупателя.Номер + " от " + ВыборкаДанных.ЗаказПокупателя.Дата,
									"; " + ВыборкаДанных.ЗаказПокупателя.Номер + " от " + ВыборкаДанных.ЗаказПокупателя.Дата);
									
								КонецЕсли;
								
								Если ТекстТелаПисьма = "" Тогда 
									// шапка
									ТекстТелаПисьма = "
									|<table border=""1"" style= ""border-collapse: collapse;"">
									|<thead>
									|<tr style=""background-color: eee;"">
									|<th style=""text-align:center"">Причина отказа</th>
									|<th style=""text-align:center"">Родитель</th>
									|<th style=""text-align:center"">Код производителя</th>
									|<th style=""text-align:center"">Наименование</th>
									|<th style=""text-align:center"">Количество</th>
									|</tr>
									|</thead>";
								КонецЕсли;	
								
								ПричинаТекст = "";                                
								
								Если  ВыборкаДанных.Причина = Перечисления.ПричиныКорректировкиСборки.ОтказКлиента Тогда 
									ПричинаТекст = "Отказ покупателя";
								ИначеЕсли  ВыборкаДанных.Причина = Перечисления.ПричиныКорректировкиСборки.ИстекСрокРезервирования Тогда
									ПричинаТекст = "Истёк срок резервирования";
								Иначе
									ПричинаТекст = "Отказ поставщика";
								КонецЕсли;
								
								// строки
								ТекстТелаПисьма=ТекстТелаПисьма+"<tbody>
								|<tr>
								|<td>"+ПричинаТекст+"</td>
								|<td>"+ВыборкаДанных.Родитель+"</td>
								|<td>"+ВыборкаДанных.КодПроизводителя+"</td>
								|<td>"+ВыборкаДанных.Наименование+"</td>
								|<td>"+ВыборкаДанных.Количество+"</td>
								|</tr>
								|</tbody>";
								
							КонецЦикла;
							
							Если ТекстТелаПисьма <> "" Тогда 
								
								ТекстТелаПисьма = ТекстТелаПисьма + "</table><p>С Уважением,<br>Компания «Москворечье-" + Константы.База.Получить() + "»</p>";
								
								// и добавим приветствие
								ТекстТелаПисьма = "<p>Уважаемый клиент!<br>Информация по Заказу(-ам) " + ТекстСПеречнемЗаказов+"</p>" + ТекстТелаПисьма;
								
								// отправляем
								УчетнаяЗапись = Константы.ОсновнаяУчетнаяЗаписьЭлектроннойПочты.Получить();
								Профиль = УправлениеЭлектроннойПочтой.ПолучитьИнтернетПочтовыйПрофиль(УчетнаяЗапись);
								
								Сообщение = Новый ИнтернетПочтовоеСообщение;
								Сообщение.Тема = "Информация о заказе № " + ТекстСПеречнемЗаказов;
								
								Почта = Новый ИнтернетПочта; 
								ОтправитьПочту = Истина;      
								
								Попытка
									Почта.Подключиться(Профиль);
								Исключение
									
									ЗаписьЖурналаРегистрации("Регламентное задание по отправке электронной почты", УровеньЖурналаРегистрации.Ошибка,,,
									"Не удалось подключиться к почтовому серверу!");
									ОтправитьПочту = Ложь;
									
								КонецПопытки;
								
								Если ОтправитьПочту Тогда 
									
									МассивАдресов = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(АдресЭлПочтыДляОтправки, ";");
									
									Для Каждого ТекАдрес Из МассивАдресов Цикл
										Сообщение.Получатели.Добавить(ТекАдрес); 
									КонецЦикла;
									
									Сообщение.Отправитель = УчетнаяЗапись.АдресЭлектроннойПочты;
									Сообщение.Тексты.Добавить(ТекстТелаПисьма,ТипТекстаПочтовогоСообщения.HTML);
									
									Попытка
										Почта.Послать(Сообщение);
									Исключение 
										
										ЗаписьЖурналаРегистрации("Регламентное задание по отправке электронной почты", УровеньЖурналаРегистрации.Ошибка,,,
										"Не удалось отправить письмо клиенту " + ГрузополучательИзЗаказа.Наименование + " по адресу " + АдресЭлПочтыДляОтправки+
										" с информацией об отказе по документу " + Выборка.ДокументКОтправке+" " + СокрЛП(ОписаниеОшибки())); 
										Сообщение.Получатели.Очистить(); 								
										Почта.Отключиться(); 
										
										Продолжить;
										
									КонецПопытки;
									
									Сообщение.Получатели.Очистить();
									
									Почта.Отключиться();
									
									ЗаписьЖурналаРегистрации("Регламентное задание по отправке электронной почты", УровеньЖурналаРегистрации.Информация,,,
									"Отправлено письмо клиенту " + ГрузополучательИзЗаказа.Наименование+" по адресу " + АдресЭлПочтыДляОтправки+
									" с информацией об отказе по документу " + Выборка.ДокументКОтправке);
									
									// зафиксируем факт отправки
									НЗРассылкаДокументов 				= РегистрыСведений.РассылкаДокументов.СоздатьМенеджерЗаписи();
									НЗРассылкаДокументов.Период 		= НачалоДня(ТекущаяДата());
									НЗРассылкаДокументов.Контрагент 	= ГрузополучательИзЗаказа;
									НЗРассылкаДокументов.Документ 		= Выборка.ДокументКОтправке;
									НЗРассылкаДокументов.ТипРассылки 	= Перечисления.ТипыРассылокЭлектроннойПочты.ПроведениеКорректировкиЗаказа;
									НЗРассылкаДокументов.ВремяОтправки 	= ТекущаяДата();
									НЗРассылкаДокументов.Комментарий 	= "выполнено регламентным заданием";	
									НЗРассылкаДокументов.Записать();
									
									// очистим текущее задание на отправку
									Рег = РегистрыСведений.ДокументыКОтправке.СоздатьНаборЗаписей();
									Рег.Отбор.ДокументКОтправке.Установить(Выборка.ДокументКОтправке);   
									Рег.Отбор.ТипСообщения.Установить(Выборка.ТипСообщения);
									Рег.Отбор.АктуальноДо.Установить(Выборка.АктуальноДо);
									
									Рег.Очистить();
									Рег.Записать();
									
								КонецЕсли;
								
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;
				
				
			ИначеЕсли ТипЗнч(Выборка.ДокументКОтправке) = Тип("ДокументСсылка.ЗакрытиеЗаказовПоставщикам") Тогда 
				
				Если Выборка.ТипСообщения = Перечисления.ТипыРассылокЭлектроннойПочты.ЗакрытиеЗаказаПоставщику Тогда 
					
					Запрос = Новый Запрос;
					Запрос.Текст = 
					"ВЫБРАТЬ
					|	ЗаказыПокупателей.ЗаказПокупателя,
					|	ЗаказыПокупателей.ЗаказПокупателя.Грузополучатель,
					|	ЗаказыПокупателей.ЗаказПокупателя.Контрагент,
					|	ЗаказыПокупателей.Номенклатура,
					|	СУММА(ЗаказыПокупателей.Количество) КАК Количество
					|ПОМЕСТИТЬ Таб
					|ИЗ
					|	РегистрНакопления.ЗаказыПокупателей КАК ЗаказыПокупателей
					|ГДЕ
					|	ЗаказыПокупателей.Регистратор = &Регистратор
					|	И ЗаказыПокупателей.ЗаказПокупателя.Грузополучатель.ОтправлятьИнформациюОбОтказах
					|
					|СГРУППИРОВАТЬ ПО
					|	ЗаказыПокупателей.ЗаказПокупателя,
					|	ЗаказыПокупателей.ЗаказПокупателя.Грузополучатель,
					|	ЗаказыПокупателей.ЗаказПокупателя.Контрагент,
					|	ЗаказыПокупателей.Номенклатура
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ
					|	Таб.ЗаказПокупателя КАК ЗаказПокупателя,
					|	Таб.ЗаказПокупателяГрузополучатель КАК Грузополучатель,
					|	Таб.ЗаказПокупателяКонтрагент КАК Контрагент,
					|	Таб.Номенклатура,
					|	Таб.Количество,
					|	Таб.Номенклатура.Родитель КАК Родитель,
					|	Таб.Номенклатура.КодПроизводителя КАК КодПроизводителя
					|ИЗ
					|	Таб КАК Таб
					|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РассылкаДокументов.СрезПервых КАК РассылкаДокументовСрезПервых
					|		ПО Таб.ЗаказПокупателя = РассылкаДокументовСрезПервых.Документ
					|			И (РассылкаДокументовСрезПервых.ТипРассылки = ЗНАЧЕНИЕ(Перечисление.ТипыРассылокЭлектроннойПочты.ЗакрытиеЗаказаПоставщику))
					|			И Таб.ЗаказПокупателяГрузополучатель = РассылкаДокументовСрезПервых.Контрагент
					|ГДЕ
					|	РассылкаДокументовСрезПервых.Документ ЕСТЬ NULL 
					|
					|УПОРЯДОЧИТЬ ПО
					|	Таб.ЗаказПокупателяГрузополучатель,
					|	ЗаказПокупателя
					|АВТОУПОРЯДОЧИВАНИЕ";
					
					Запрос.УстановитьПараметр("Регистратор", Выборка.ДокументКОтправке);
					РезультатЗапроса = Запрос.Выполнить();
					
					Если РезультатЗапроса.Пустой() Тогда 
						
						Рег = РегистрыСведений.ДокументыКОтправке.СоздатьНаборЗаписей();
						Рег.Отбор.ДокументКОтправке.Установить(Выборка.ДокументКОтправке);   
						Рег.Отбор.ТипСообщения.Установить(Перечисления.ТипыРассылокЭлектроннойПочты.ЗакрытиеЗаказаПоставщику);
						Рег.Отбор.АктуальноДо.Установить(Выборка.АктуальноДо);
						
						Рег.Очистить();
						Рег.Записать();
						
					Иначе
						
						ВыборкаДанных = РезультатЗапроса.Выбрать();
						
						ТекГрузополучатель = "!!!";
						ТекЗаказ = "!!!";
						АдресЭлПочтыДляОтправки = "";
						ТекстТелаПисьма = "";
						ТекстСПеречнемЗаказов = "";
						РезультатОтправкиОсновной = Истина; 
						
						Пока ВыборкаДанных.Следующий() Цикл
							
							Если ТекГрузополучатель <> ВыборкаДанных.Грузополучатель Тогда 
								
								РезультатОтправкиОсновной = РезультатОтправкиОсновной 
								и ЗавершитьОтправку(ТекГрузополучатель,ТекстТелаПисьма, ТекстСПеречнемЗаказов, ТекЗаказ, АдресЭлПочтыДляОтправки, Выборка.ДокументКОтправке);
								
								ТекГрузополучатель = ВыборкаДанных.Грузополучатель;
								ТекЗаказ = ВыборкаДанных.ЗаказПокупателя;
								АдресЭлПочтыДляОтправки = "";
								
								Запрос = Новый Запрос;
								Запрос.Текст = 
								"ВЫБРАТЬ
								|	КонтактнаяИнформация.Представление
								|ИЗ
								|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
								|ГДЕ
								|	КонтактнаяИнформация.Объект = &Объект
								|	И КонтактнаяИнформация.Тип = &Тип
								|	И КонтактнаяИнформация.Вид = &Вид";
								
								Запрос.УстановитьПараметр("Объект", ТекГрузополучатель);
								Запрос.УстановитьПараметр("Тип", Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
								Запрос.УстановитьПараметр("Вид", Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыКонтрагентаДляОтказа);
								
								Результат = Запрос.Выполнить();
								ВыборкаПочта = Результат.Выбрать();
								
								Если ВыборкаПочта.Следующий() Тогда
									АдресЭлПочтыДляОтправки = ВыборкаПочта.Представление;
								КонецЕсли;
								
								ТекстТелаПисьма = "" ;
								СписокЗаказов = Новый СписокЗначений; 
								ТекстСПеречнемЗаказов = "";
								
							КонецЕсли;
							
							Если Не ПустаяСтрока(АдресЭлПочтыДляОтправки) Тогда
								
								Если СписокЗаказов.НайтиПоЗначению(ВыборкаДанных.ЗаказПокупателя) = Неопределено Тогда 
									
									СписокЗаказов.Добавить(ВыборкаДанных.ЗаказПокупателя);
									
									ТекстСПеречнемЗаказов = ТекстСПеречнемЗаказов +
									?(ТекстСПеречнемЗаказов = "", ВыборкаДанных.ЗаказПокупателя.Номер + " от " + ВыборкаДанных.ЗаказПокупателя.Дата,
									"; " + ВыборкаДанных.ЗаказПокупателя.Номер + " от " + ВыборкаДанных.ЗаказПокупателя.Дата);
									
								КонецЕсли;
								
								Если ТекстТелаПисьма = "" Тогда 
									// шапка
									ТекстТелаПисьма = "
									|<table border=""1"" style= ""border-collapse: collapse;"">
									|<thead>
									|<tr style=""background-color: eee;"">
									|<th style=""text-align:center"">Причина отказа</th>
									|<th style=""text-align:center"">Родитель</th>
									|<th style=""text-align:center"">Код производителя</th>
									|<th style=""text-align:center"">Наименование</th>
									|<th style=""text-align:center"">Количество</th>
									|</tr>
									|</thead>";
								КонецЕсли;	
								
								// строки
								ТекстТелаПисьма=ТекстТелаПисьма+"<tbody>
								|<tr>
								|<td>Отказ поставщика</td>
								|<td>"+ВыборкаДанных.Родитель+"</td>
								|<td>"+ВыборкаДанных.КодПроизводителя+"</td>
								|<td>"+ВыборкаДанных.Номенклатура.Наименование+"</td>
								|<td>"+ВыборкаДанных.Количество+"</td>
								|</tr>
								|</tbody>";
								
							КонецЕсли;
							
						КонецЦикла;
						
						РезультатОтправки = ЗавершитьОтправку(ТекГрузополучатель, ТекстТелаПисьма, ТекстСПеречнемЗаказов, ТекЗаказ, 
						                    АдресЭлПочтыДляОтправки, Выборка.ДокументКОтправке);
						
						// очистим текущее задание на отправку
						Если  РезультатОтправки  и РезультатОтправкиОсновной Тогда 
							
							Рег = РегистрыСведений.ДокументыКОтправке.СоздатьНаборЗаписей();
							Рег.Отбор.ДокументКОтправке.Установить(Выборка.ДокументКОтправке);   
							Рег.Отбор.ТипСообщения.Установить(Перечисления.ТипыРассылокЭлектроннойПочты.ЗакрытиеЗаказаПоставщику);
							Рег.Отбор.АктуальноДо.Установить(Выборка.АктуальноДо);
							
							Рег.Очистить();
							Рег.Записать();
							
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;
				
			Иначе
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры	

Процедура ПодпискаНаСобытие1ОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	//  Если у документа НЕТ документа "СчетФактураПолученный"    -> СОЗДАЮ!!
	Если Не Отказ И Источник.Проведен И Константы.СоздаватьСчетФактуруПриПроведенииПТУ.Получить()
		И Источник.ОтражатьВБухгалтерскомУчете И ЗначениеЗаполнено( Источник.НомерВходящегоДокумента)
		И ПроверитьНеобходимостьСозданияСчетаФактуры(Источник)
		Тогда 
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СчетФактураПолученный.Ссылка
		|ИЗ
		|	Документ.СчетФактураПолученный КАК СчетФактураПолученный
		|ГДЕ
		|	СчетФактураПолученный.ДокументОснование = &ДокументОснование
		|	И НЕ СчетФактураПолученный.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПоступлениеТоваровУслугТовары.НомерСтроки
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг.Товары КАК ПоступлениеТоваровУслугТовары
		|ГДЕ
		|	ПоступлениеТоваровУслугТовары.СтавкаНДС <> &БезНДС
		|	И ПоступлениеТоваровУслугТовары.Ссылка = &ДокументОснование";
		
		Запрос.УстановитьПараметр("ДокументОснование", Источник.Ссылка);
		Запрос.УстановитьПараметр("БезНДС", Перечисления.СтавкиНДС.БезНДС);
		
		РезультатЗапроса = Запрос.ВыполнитьПакет();
		Результат = РезультатЗапроса[0];
		ЕстьСтрокиСНДС = НЕ РезультатЗапроса[1].Пустой();
		
		Если Результат.Пустой() И ЕстьСтрокиСНДС Тогда 
			
			//  Создать документ "СчетФактураПолученный"
			НовыйДокумент = Документы.СчетФактураПолученный.СоздатьДокумент();
			НовыйДокумент.Заполнить(Источник.Ссылка);
			НовыйДокумент.ДатаВходящегоДокумента =  Источник.ДатаВходящегоДокумента ;
			НовыйДокумент.НомерВходящегоДокумента = Источник.НомерВходящегоДокумента ;
			
			НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПодпискаНаСобытиеОбработкаПроведенияЗаказаПоставщику(Источник, Отказ, РежимПроведения) Экспорт   
	
	Если Не Отказ И Источник.Проведен Тогда  
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗаказПоставщикуТовары.Заказ,
		|	ЗаказПоставщикуТовары.Номенклатура
		|ПОМЕСТИТЬ ВТ_ЗаказыПокупателей
		|ИЗ
		|	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
		|ГДЕ
		|	ЗаказПоставщикуТовары.Ссылка = &Ссылка
		|	И НЕ ЗаказПоставщикуТовары.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
		|	И ЗаказПоставщикуТовары.Ссылка.Экспресс = ИСТИНА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗаказПоставщикуТовары.Ссылка
		|ИЗ
		|	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ЗаказыПокупателей КАК ВТ_ЗаказыПокупателей
		|		ПО ЗаказПоставщикуТовары.Заказ = ВТ_ЗаказыПокупателей.Заказ
		|			И ЗаказПоставщикуТовары.Номенклатура = ВТ_ЗаказыПокупателей.Номенклатура
		|ГДЕ
		|	ЗаказПоставщикуТовары.Ссылка.Проведен = ЛОЖЬ
		|	И ЗаказПоставщикуТовары.Ссылка.ПометкаУдаления = ЛОЖЬ";
		
		Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			ТекОбъект = Выборка.Ссылка.ПолучитьОбъект();
			ТекОбъект.УстановитьПометкуУдаления(Истина);  
			
		КонецЦикла;
	
	КонецЕсли;
	
КонецПроцедуры

Функция ПроверитьНеобходимостьСозданияСчетаФактуры(Документ)
	
	Если  Документ.Контрагент = Константы.ОсновнойПоставщик.Получить() Тогда
		Возврат Константы.СоздаватьСчетФактуруПриПроведенииПТУДляОсновногоПоставщика.Получить();
	КонецЕсли;
	
	Если Документ.Товары.Количество() = 0 Тогда  
		Возврат Ложь;
	Иначе
		
		ЗапросСозданияПоСкладуВЗаказе = Новый Запрос;
		ЗапросСозданияПоСкладуВЗаказе.Текст =  
		"ВЫБРАТЬ
		|	Константы.ДопПоставщик
		|ПОМЕСТИТЬ ВТ_ДопПоставщик
		|ИЗ
		|	Константы КАК Константы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ПоступлениеТоваровУслугТовары.ЗаказПоставщику.IDСкладаСобственныйСклад ЕСТЬ NULL
		|					ИЛИ ПоступлениеТоваровУслугТовары.ЗаказПоставщику.IDСкладаСобственныйСклад = ЗНАЧЕНИЕ(Справочник.СобственныеСклады.ПустаяСсылка)
		|				ТОГДА НЕ ПоступлениеТоваровУслугТовары.Ссылка.Контрагент = ВТ_ДопПоставщик.ДопПоставщик
		|			ИНАЧЕ ПоступлениеТоваровУслугТовары.ЗаказПоставщику.IDСкладаСобственныйСклад.СоздаватьСчетФактуруПриПроведенииПТУ
		|		КОНЕЦ) КАК СоздаватьСчФактуру
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг.Товары КАК ПоступлениеТоваровУслугТовары,
		|	ВТ_ДопПоставщик КАК ВТ_ДопПоставщик
		|ГДЕ
		|	ПоступлениеТоваровУслугТовары.Ссылка = &Ссылка";

		ЗапросСозданияПоСкладуВЗаказе.УстановитьПараметр("Ссылка",Документ.Ссылка);
		
		РезультатЗапросаСозданияПоСкладу = ЗапросСозданияПоСкладуВЗаказе.Выполнить();
		
		Если НЕ РезультатЗапросаСозданияПоСкладу.Пустой() Тогда
			
			ВыборкаЗапросаСозданияПоСкладу = РезультатЗапросаСозданияПоСкладу.Выбрать(); 
			ВыборкаЗапросаСозданияПоСкладу.Следующий();
			Возврат ВыборкаЗапросаСозданияПоСкладу.СоздаватьСчФактуру;
			
		Иначе
			Возврат Не Документ.Контрагент = Константы.ДопПоставщик.Получить() 
		КонецЕсли;  
		
	КонецЕсли;
	
	Возврат Ложь;	

КонецФункции

Функция ПроверкаНаСтороннийСклад(ДокументПроверки) Экспорт 
	
	Если ТипЗнч(ДокументПроверки) = Тип("ДокументОбъект.КорректировкаСборкиЗаказовПокупателя") Тогда 
		
		ТабЗаказов = ДокументПроверки.Товары.Выгрузить(, "ЗаказПокупателя,Причина");
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВЫРАЗИТЬ(ТЗ.ЗаказПокупателя КАК Документ.ЗаказПокупателя) КАК ЗаказПокупателя,
		|	ВЫРАЗИТЬ(ТЗ.Причина КАК Перечисление.ПричиныКорректировкиСборки) КАК Причина
		|ПОМЕСТИТЬ ТаблицаЗаказов
		|ИЗ
		|	&ТЗ КАК ТЗ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТаблицаЗаказов.ЗаказПокупателя КАК ЗаказСсылка
		|ИЗ
		|	ТаблицаЗаказов КАК ТаблицаЗаказов
		|ГДЕ
		|	ТаблицаЗаказов.Причина = ЗНАЧЕНИЕ(Перечисление.ПричиныКорректировкиСборки.ОтказКлиента)
		|	И ТаблицаЗаказов.ЗаказПокупателя.IDСклада_СтороннийСклад <> ЗНАЧЕНИЕ(Справочник.СторонниеСклады.ПустаяСсылка)";
		
		Запрос.УстановитьПараметр("ТЗ", ТабЗаказов);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если НЕ РезультатЗапроса.Пустой() Тогда 
			
			ПереченьЗаказов = "";
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				ПереченьЗаказов = ПереченьЗаказов + ВыборкаДетальныеЗаписи.ЗаказСсылка.Номер + ", ";
			КонецЦикла;
			
			ПереченьЗаказов = Лев(ПереченьЗаказов,СтрДлина(ПереченьЗаказов) - 2);
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Товар заказанный со стороннего склада по заказу(-ам) %1 отказу и возврату НЕ ПОДЛЕЖИТ!!!'"), ПереченьЗаказов);
			Возврат ТекстСообщения;
			
		Иначе 
			Возврат "";
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДокументПроверки) = Тип("ДокументОбъект.КорректировкаЗаказаПокупателя") Тогда
		
		ТекЗаказ = ДокументПроверки.ЗаказПокупателя;
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РазмещениеЗаказовПокупателейОстатки.ЗаказПокупателя,
		|	РазмещениеЗаказовПокупателейОстатки.Номенклатура,
		|	РазмещениеЗаказовПокупателейОстатки.ЗаказПоставщику,
		|	РазмещениеЗаказовПокупателейОстатки.КоличествоОстаток
		|ИЗ
		|	РегистрНакопления.РазмещениеЗаказовПокупателей.Остатки(&МоментДокумента, ЗаказПокупателя = &ЗаказПокупателя) КАК РазмещениеЗаказовПокупателейОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТоварыВРезервеНаСкладахОстатки.Склад,
		|	ТоварыВРезервеНаСкладахОстатки.Номенклатура,
		|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва,
		|	ТоварыВРезервеНаСкладахОстатки.СерияНоменклатуры,
		|	ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток
		|ИЗ
		|	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(&МоментДокумента, ДокументРезерва = &ЗаказПокупателя) КАК ТоварыВРезервеНаСкладахОстатки";
		
		Если ДокументПроверки.Ссылка.Пустая() Тогда 
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&МоментДокумента", "");
		Иначе
			Запрос.УстановитьПараметр("МоментДокумента", Новый Граница(ДокументПроверки.МоментВремени(), ВидГраницы.Исключая));
		КонецЕсли;
		
		Запрос.УстановитьПараметр("ЗаказПокупателя", ТекЗаказ);
		
		РезультатЗапроса = Запрос.ВыполнитьПакет();
		
		ТЗРазмещений = РезультатЗапроса[0].Выгрузить();
		ТЗРезервов = РезультатЗапроса[1].Выгрузить();
		
		ТекстСообщения = "";
		
		Если ТЗРазмещений.Количество()>0 Тогда 
			ТекстСообщения = "Товар, заказанный со стороннего склада по заказу " + ТекЗаказ.Номер+
			", уже заказан поставщику. Товар не подлежит корректировке по причине 'Отказ клиента!'!";
		КонецЕсли;
		
		Если ТЗРезервов.Количество() > 0 Тогда
			
			ТекстСообщения = ?(ТекстСообщения <> "", ТекстСообщения + Символы.ПС, "");
			ТекстСообщения = ТекстСообщения + "Товар, заказанный со стороннего склада по заказу " + ТекЗаказ.Номер +
			", уже зарезервирован за покупателем. Товар не подлежит корректировке по причине 'Отказ клиента!'!";
			
		КонецЕсли;
		
		Возврат ТекстСообщения;
		
	КонецЕсли;

КонецФункции

Функция НайтиСтороннийСкладПоID(ID,СоздаватьВСлучаеОтсутствия = Ложь) Экспорт 
	
	ПустойСклад = Справочники.СторонниеСклады.ПустаяСсылка();
	
	Если ID = 0 Тогда 
		Возврат ПустойСклад;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СобственныеСклады.Ссылка КАК СобственныйСклад,
	|	СобственныеСклады.Идентификатор
	|ИЗ
	|	Справочник.СобственныеСклады КАК СобственныеСклады
	|ГДЕ
	|	СобственныеСклады.Идентификатор = &Идентификатор";
	
	Запрос.УстановитьПараметр("Идентификатор", ID);	
	РезультатЗапросаСобственные = Запрос.Выполнить(); 
	
	Если НЕ РезультатЗапросаСобственные.Пустой()  Тогда
		Возврат ПустойСклад;
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СоответствиеСтороннихСкладовСкладамФилиала.СтороннийСкладФилиала
	|ИЗ
	|	РегистрСведений.СоответствиеСтороннихСкладовСкладамФилиала КАК СоответствиеСтороннихСкладовСкладамФилиала
	|ГДЕ
	|	СоответствиеСтороннихСкладовСкладамФилиала.Использование
	|	И СоответствиеСтороннихСкладовСкладамФилиала.СтороннийСклад = &Идентификатор
	|	И НЕ СоответствиеСтороннихСкладовСкладамФилиала.СтороннийСкладФилиала.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Идентификатор", ID);  
	
	Выборка = Запрос.Выполнить().Выбрать();  
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.СтороннийСкладФилиала;
	Иначе
		
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		               |	СторонниеСклады.Ссылка КАК СтороннийСклад
		               |ИЗ
		               |	Справочник.СторонниеСклады КАК СторонниеСклады
		               |ГДЕ
		               |	СторонниеСклады.Идентификатор = &Идентификатор
		               |	И НЕ СторонниеСклады.ПометкаУдаления
		               |	И НЕ СторонниеСклады.СтороннийСкладФилиала";   
		
		Выборка = Запрос.Выполнить().Выбрать();  
		
		Если Выборка.Следующий() Тогда
			Возврат Выборка.СтороннийСклад;			
		КонецЕсли;     
		
		Если СоздаватьВСлучаеОтсутствия И НЕ Константы.НеСоздаватьСтороннийСклад.Получить() Тогда 
			
			НовыйСтороннийСклад = Справочники.СторонниеСклады.СоздатьЭлемент();
			НовыйСтороннийСклад.Идентификатор = ID;
			НовыйСтороннийСклад.Наименование = ID;
			НовыйСтороннийСклад.IDСклада = ID;
			
			НовыйСтороннийСклад.Записать();
			РаботаСАвардой.СоздатьОповещениеОбИзмененииДляСтороннихСкладов("Появился новый сторонний склад", "Появился новый сторонний склад с идентификатором "
			 + ID + ". Необходимо задать для него настройки отправки!",НовыйСтороннийСклад.Ссылка);		
			Возврат НовыйСтороннийСклад.Ссылка;
			
		КонецЕсли;
		
		Возврат Неопределено;
		
	КонецЕсли;	
	
КонецФункции

Функция ЭтоСтороннийСклад(ИдентификаторСклада = 0) Экспорт 
	
	Если ИдентификаторСклада <> 0 Тогда 
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	СобственныеСклады.Ссылка
		|ИЗ
		|	Справочник.СобственныеСклады КАК СобственныеСклады
		|ГДЕ
		|	СобственныеСклады.Идентификатор = &Идентификатор
		|	И НЕ СобственныеСклады.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	СобственныеСклады.Ссылка
		|ИЗ
		|	Справочник.СобственныеСклады КАК СобственныеСклады
		|ГДЕ
		|	НЕ СобственныеСклады.ПометкаУдаления";
		
		Запрос.УстановитьПараметр("Идентификатор", ИдентификаторСклада);
		
		РезультатЗапроса = Запрос.ВыполнитьПакет();
		
		ТЗСобственныйСклад = РезультатЗапроса[0].Выгрузить();
		СобственныйСкладыЗаполнены = РезультатЗапроса[1].Выгрузить();
		
		Если СобственныйСкладыЗаполнены.Количество() > 0 Тогда 
			
			Если ТЗСобственныйСклад.Количество() = 0 Тогда 
				Возврат Истина;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Процедура ПроверкаДоговоров() Экспорт
	
	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда 
		
		ЗаписьЖурналаРегистрации("Проверка договоров", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Отменена работа регламентного задания из-за несоответствия параметров подключения к ИБ");
		Возврат;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Ссылка
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.НеПроверятьПриРегламентномЗадании = ЛОЖЬ
	|	И ДоговорыКонтрагентов.ВидДоговора = &ВидДоговора
	|	И ДоговорыКонтрагентов.ВестиПоДокументамРасчетовСКонтрагентом
	|	И ДоговорыКонтрагентов.КонтролироватьЧислоДнейЗадолженности = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("ВидДоговора", Перечисления.ВидыДоговоровКонтрагентов.СПокупателем );
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Об =  Выборка.Ссылка.ПолучитьОбъект();
		Об.КонтролироватьЧислоДнейЗадолженности = Истина;
		Об.ДопустимоеЧислоДнейЗадолженности  = 1;
		Об.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

Функция ЗаполнитьРеквизитПоСоответствию(Значение, ИмяРеквизитаФабрики, СпрОбъект, ИмяРеквизитаСправочника, ИмяОчереди)	
	
	Если ТипЗнч(Значение) = Тип("ОбъектXDTO") И Значение.Свойства().Количество() > 0 И Значение.Свойства().Получить(ИмяРеквизитаФабрики) <> Неопределено Тогда		
		
		ЗначениеУстановки = СокрЛП(Значение[ИмяРеквизитаФабрики]);
		
		Если ЗначениеЗаполнено(ЗначениеУстановки) Тогда
			
			СоответствиеУстановки = ПолучитьСоответствиеПоID(ЗначениеУстановки);
			
			Если ЗначениеЗаполнено(СоответствиеУстановки) Тогда
				СпрОбъект[ИмяРеквизитаСправочника] = СоответствиеУстановки;
			Иначе
				
				СтруктураСообщения = Новый Структура;
				СтруктураСообщения.Вставить("service", "doc-order-assemble-additional");
				СтруктураСообщения.Вставить("error", "Не найдено соответствие для реквизита: " + ИмяРеквизитаСправочника 
				+ " (" + Строка(ТипЗнч(СпрОбъект)) + ")" + " и значения: " + ЗначениеУстановки + " в регистре сведений СоответствиеОбъектовДляОбмена");
				СтруктураСообщения.Вставить("body", "");
				СтруктураСообщения.Вставить("solved", false); 				
				
				СвойстваСтруктура = Новый Структура;
				СвойстваСтруктура.Вставить("app_id", ИмяОчереди);    					
				СтруктураСообщения.Вставить("props", СвойстваСтруктура); 					
				
				AMQP_РаботаСоСправочниками.ОтправитьСообщениеВЭластик(СтруктураСообщения, Строка(Новый УникальныйИдентификатор()), Истина);
				
