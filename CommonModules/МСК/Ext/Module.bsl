		СпрОбъект.ВидСчета = "Расчетный";
		
		ЗаполнитьСвойствоПоПоискуКодаМДМ("Валюты", СпрОбъект, "ВалютаДенежныхСредств", ФабрикаСправочника.ВалютаДенежныхСредств, ФабрикаСправочника);
		
		Если Булево(ФабрикаСправочника.ОсновнойБанковскийСчет) И ЗначениеЗаполнено(СпрОбъект.Владелец) Тогда
			
