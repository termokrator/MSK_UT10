КонецФункции // ()

Функция ЗапросНайтиЗаказыПоставщикуДляПТУ(тзТоварыКопия, Контрагент)
	
	Запрос = Новый Запрос; 
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВТ_Товары.Номенклатура КАК Номенклатура,
	|	ВТ_Товары.Количество КАК Количество
	|ПОМЕСТИТЬ ВТ_Заказов
	|ИЗ
	|	&ВТ_Товары КАК ВТ_Товары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказыПоставщикамОстатки.Номенклатура КАК Номенклатура,
	|	ЗаказыПоставщикамОстатки.ЗаказПоставщику КАК ЗаказПоставщику,
	|	СУММА(ЗаказыПоставщикамОстатки.КоличествоОстаток) КАК КоличествоОстаток,
	|	МАКСИМУМ(ВТ_Заказов.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТ_ЗаказыПоставщику
	|ИЗ
	|	РегистрНакопления.ЗаказыПоставщикам.Остатки(
	|			,
	|			Номенклатура В
	|					(ВЫБРАТЬ
	|						ВТ_Заказов.Номенклатура
	|					ИЗ
	|						ВТ_Заказов)
	|				И ДоговорКонтрагента.Владелец = &Контрагент) КАК ЗаказыПоставщикамОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Заказов КАК ВТ_Заказов
	|		ПО ЗаказыПоставщикамОстатки.Номенклатура = ВТ_Заказов.Номенклатура
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказыПоставщикамОстатки.Номенклатура,
	|	ЗаказыПоставщикамОстатки.ЗаказПоставщику
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ЗаказыПоставщику.ЗаказПоставщику,
	|	СУММА(1) КАК СовпалоСтрок,
	|	СУММА(ВЫБОР
	|			КОГДА ВТ_ЗаказыПоставщику.КоличествоОстаток = ВТ_ЗаказыПоставщику.Количество
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СовпалоПолностью
	|ПОМЕСТИТЬ ВТ_КоличествоСовпадений
	|ИЗ
	|	ВТ_ЗаказыПоставщику КАК ВТ_ЗаказыПоставщику
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ЗаказыПоставщику.ЗаказПоставщику
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ЗаказыПоставщику.Номенклатура КАК Номенклатура,
	|	ВТ_ЗаказыПоставщику.ЗаказПоставщику КАК ЗаказПоставщику,
	|	РазмещениеЗаказовПокупателейОстатки.ЗаказПокупателя КАК ЗаказПокупателя,
	|	МАКСИМУМ(ВТ_ЗаказыПоставщику.КоличествоОстаток) КАК КоличествоЗаказаноУПоставщика,
	|	СУММА(ЕСТЬNULL(РазмещениеЗаказовПокупателейОстатки.КоличествоОстаток, 0)) КАК КоличествоЗаказаноПокупателем
	|ПОМЕСТИТЬ ТабДанных
	|ИЗ
	|	ВТ_ЗаказыПоставщику КАК ВТ_ЗаказыПоставщику
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РазмещениеЗаказовПокупателей.Остатки(
	|				,
	|				Номенклатура В
	|						(ВЫБРАТЬ
	|							ВТ_Заказов.Номенклатура
	|						ИЗ
	|							ВТ_Заказов)
	|					И ЗаказПоставщику.Контрагент = &Контрагент) КАК РазмещениеЗаказовПокупателейОстатки
	|		ПО ВТ_ЗаказыПоставщику.ЗаказПоставщику = РазмещениеЗаказовПокупателейОстатки.ЗаказПоставщику
	|			И ВТ_ЗаказыПоставщику.Номенклатура = РазмещениеЗаказовПокупателейОстатки.Номенклатура
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ЗаказыПоставщику.Номенклатура,
	|	РазмещениеЗаказовПокупателейОстатки.ЗаказПокупателя,
	|	ВТ_ЗаказыПоставщику.ЗаказПоставщику
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабДанных.Номенклатура,
	|	ТабДанных.ЗаказПоставщику КАК ЗаказПоставщику,
	|	ТабДанных.ЗаказПокупателя КАК ЗаказПокупателя,
	|	ТабДанных.КоличествоЗаказаноУПоставщика,
	|	ТабДанных.КоличествоЗаказаноПокупателем,
	|	ВТ_КоличествоСовпадений.СовпалоСтрок КАК СовпалоСтрок,
	|	ВТ_КоличествоСовпадений.СовпалоПолностью КАК СовпалоПолностью
	|ИЗ
	|	ТабДанных КАК ТабДанных
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_КоличествоСовпадений КАК ВТ_КоличествоСовпадений
	|		ПО ТабДанных.ЗаказПоставщику = ВТ_КоличествоСовпадений.ЗаказПоставщику
	|
	|УПОРЯДОЧИТЬ ПО
	|	СовпалоСтрок УБЫВ,
	|	СовпалоПолностью УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабДанных.Номенклатура КАК Номенклатура,
	|	ТабДанных.ЗаказПоставщику КАК ЗаказПоставщику,
	|	ТабДанных.ЗаказПоставщику.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	МАКСИМУМ(ТабДанных.КоличествоЗаказаноУПоставщика) КАК КоличествоЗаказаноУПоставщика,
	|	ВТ_КоличествоСовпадений.СовпалоСтрок КАК СовпалоСтрок,
	|	ВТ_КоличествоСовпадений.СовпалоПолностью КАК СовпалоПолностью
	|ИЗ
	|	ТабДанных КАК ТабДанных
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_КоличествоСовпадений КАК ВТ_КоличествоСовпадений
	|		ПО ТабДанных.ЗаказПоставщику = ВТ_КоличествоСовпадений.ЗаказПоставщику
	|
	|СГРУППИРОВАТЬ ПО
	|	ТабДанных.Номенклатура,
	|	ТабДанных.ЗаказПоставщику,
	|	ВТ_КоличествоСовпадений.СовпалоСтрок,
	|	ВТ_КоличествоСовпадений.СовпалоПолностью
	|
	|УПОРЯДОЧИТЬ ПО
	|	СовпалоСтрок УБЫВ,
	|	СовпалоПолностью УБЫВ";
	
	
	Запрос.УстановитьПараметр("ВТ_Товары", тзТоварыКопия); 
	Запрос.УстановитьПараметр("Контрагент", Контрагент); 
	
	Возврат Запрос.ВыполнитьПакет();   
	
КонецФункции // ()

Процедура НайтиКодыМаркировки(тзКодыМаркировки, тзТовары)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	тзКодыМаркировки.КодСтрокиКМ,
	|	тзКодыМаркировки.КодМаркировки,
	|	тзКодыМаркировки.ДатаПроизводства,  
	//+Шульман А. 17.03.2026 #UT10-5748
	|	тзКодыМаркировки.Невалиден,  
	|	тзКодыМаркировки.Причина,    
	//-Шульман А. 17.03.2026 #UT10-5748
	|	тзКодыМаркировки.СрокГодности
	|ПОМЕСТИТЬ ВТ_Коды
	|ИЗ
	|	&тзКодыМаркировки КАК тзКодыМаркировки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	тзТовары.КодСтрокиКМ,
	|	тзТовары.Номенклатура
	|ПОМЕСТИТЬ ВТ_Товары
	|ИЗ
	|	&тзТовары КАК тзТовары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Коды.КодСтрокиКМ,
	|	ВТ_Коды.КодМаркировки,
	|	ВТ_Коды.ДатаПроизводства,
	|	ВТ_Коды.СрокГодности,   
	//+Шульман А. 17.03.2026 #UT10-5748
	|	ВТ_Коды.Невалиден,       
	|	ВТ_Коды.Причина,
	//-Шульман А. 17.03.2026 #UT10-5748
	|	ВТ_Товары.Номенклатура
	|ПОМЕСТИТЬ ВТ_ТоварыКМ
	|ИЗ
	|	ВТ_Коды КАК ВТ_Коды
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Товары КАК ВТ_Товары
	|		ПО ВТ_Коды.КодСтрокиКМ = ВТ_Товары.КодСтрокиКМ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТоварыКМ.КодСтрокиКМ,
	|	ВТ_ТоварыКМ.Номенклатура,
	|	ВТ_ТоварыКМ.КодМаркировки,
	|	ВТ_ТоварыКМ.ДатаПроизводства,
	|	ВТ_ТоварыКМ.СрокГодности,  
	//+Шульман А. 17.03.2026 #UT10-5748
	|	ВТ_ТоварыКМ.Невалиден,  
	|	ВТ_ТоварыКМ.Причина,
	//-Шульман А. 17.03.2026 #UT10-5748
	|	ЕСТЬNULL(ШтрихкодыНоменклатуры.Ссылка, ЗНАЧЕНИЕ(Справочник.ШтрихкодыНоменклатуры.ПустаяСсылка)) КАК ШтрихкодСсылка
	|ИЗ
	|	ВТ_ТоварыКМ КАК ВТ_ТоварыКМ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
	|		ПО ВТ_ТоварыКМ.КодМаркировки = ШтрихкодыНоменклатуры.КодМаркировки
	|			И ВТ_ТоварыКМ.Номенклатура = ШтрихкодыНоменклатуры.Номенклатура
	|			И (НЕ ШтрихкодыНоменклатуры.ПометкаУдаления)";
	
	тзТоварыКопия = тзТовары.Скопировать();
	тзТоварыКопия.Свернуть("Номенклатура, КодСтрокиКМ");
	
	Запрос.УстановитьПараметр("тзКодыМаркировки", тзКодыМаркировки);
	Запрос.УстановитьПараметр("тзТовары", тзТоварыКопия);
	
	РезультатЗапроса = Запрос.Выполнить();   
	
	тзКодыМаркировки = РезультатЗапроса.Выгрузить();  
	
	//+Шульман А. 17.03.2026 #UT10-5748         
	Для каждого тзСтрока Из тзКодыМаркировки Цикл
	
		Если Не ЗначениеЗаполнено(тзСтрока.ШтрихкодСсылка) Тогда    
			
			ДанныеКМ = Новый Структура("КодМаркировки, Номенклатура, СрокГодности, ДатаПроизводства");
			ЗаполнитьЗначенияСвойств(ДанныеКМ, тзСтрока);
			ДанныеКМ.Вставить("ТипУпаковки", Перечисления.ТипУпаковкиМаркировки.МаркированныйТовар);
			ДанныеКМ.Вставить("ТипПоступления", 2);
			
			тзСтрока.ШтрихкодСсылка = Справочники.ШтрихкодыНоменклатуры.СоздатьКодМаркировки(ДанныеКМ);     
			
		КонецЕсли;	
	
	КонецЦикла;  
	//-Шульман А. 17.03.2026 #UT10-5748

КонецПроцедуры

Функция ЗаполнитьСтрокуПТУ(НоваяСтрокаДокумента, СтруктураСтроки)
	
	Если СтруктураСтроки.ЗаказПокупателяУказан И СтруктураСтроки.ТекСтрока <> Неопределено Тогда 
		НоваяСтрокаДокумента.Заказ = СтруктураСтроки.ТекСтрока.ЗаказПокупателя;
	КонецЕсли;
	
	ПересчитатьСумму = СтруктураСтроки.ВидЗагрузки = 0 Или Не НоваяСтрокаДокумента.Количество = СтруктураСтроки.ТекКоличество;      
	
	НоваяСтрокаДокумента.Количество = СтруктураСтроки.ТекКоличество;
	
	Если СтруктураСтроки.ЗаказПоставщикуУказан Тогда 
		НоваяСтрокаДокумента.ЗаказПоставщику = СтруктураСтроки.ЗаказПоставщику;
	КонецЕсли;
	
	Если ПересчитатьСумму Тогда
	
		НоваяСтрокаДокумента.Сумма = НоваяСтрокаДокумента.Цена * НоваяСтрокаДокумента.Количество;
		ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НоваяСтрокаДокумента, СтруктураСтроки.Документ);   
		
	КонецЕсли;
	
КонецФункции

Функция СформироватьМассивПоСвойству(ФабрикаИмени, ИмяСвойства, ИмяРеквизитаСтрок)
	
	МассивСтрок = Новый Массив;
	
	Если ПроверитьЧтоСвойствоИмеетСтроки(ФабрикаИмени, ИмяСвойства, ИмяРеквизитаСтрок) Тогда
		
		Для Каждого Стр Из ФабрикаИмени[ИмяСвойства][ИмяРеквизитаСтрок] Цикл
			МассивСтрок.Добавить(Стр);	
		КонецЦикла;
		
	ИначеЕсли ПроверитьЧтоСвойствоЯвляетсяОбъектом(ФабрикаИмени, ИмяСвойства, ИмяРеквизитаСтрок) Тогда
		МассивСтрок.Добавить(ФабрикаИмени[ИмяСвойства][ИмяРеквизитаСтрок]);	
	КонецЕсли;
	
	Возврат МассивСтрок;
	
КонецФункции

Функция ПолучитьПараметрСообщения(Параметры, ИмяПараметра)
	
	СтрокаПараметр = Параметры.Выгрузить().Найти(ИмяПараметра);
	
	Если СтрокаПараметр = Неопределено Тогда
		Возврат "";
	Иначе
		Возврат СтрокаПараметр.Значение;
	КонецЕсли;
	

КонецФункции // ()

Функция ПолучитьКонтрагентаПоКодуАварды(КодАвардаФилиала)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Контрагенты.Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.IDФилиала В(&СписокID)
	|	И Контрагенты.КодМДМ = """"";
	
	//Эту тупость потом надо будет убрать когда запретим редактировать контрагентов 24.04.2018
	//При ручном вводе Айди пользователи понадобавляли пробелов
	СписокID = Новый СписокЗначений;
	СписокID.Добавить(КодАвардаФилиала);
	СписокID.Добавить(" " + КодАвардаФилиала);
	СписокID.Добавить(КодАвардаФилиала + " ");
	СписокID.Добавить(" " + КодАвардаФилиала + " ");
	
	Запрос.УстановитьПараметр("СписокID", СписокID);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 		
		Возврат Выборка.Ссылка.ПолучитьОбъект();
	Иначе	
		
		СпрОбъект = Справочники.Контрагенты.СоздатьЭлемент();
		СпрОбъект.УстановитьСсылкуНового(Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор()));
		СпрОбъект.IDФилиала = СокрЛП(КодАвардаФилиала);
		СпрОбъект.УстановитьНовыйКод();		
		
	КонецЕсли;
	
	Возврат СпрОбъект;
	
КонецФункции

Процедура ЗаполнитьОбъектРегистраСведений(РСЗаписи, РСЗапись, ФабрикаИмени, ИмяОбъектаМетаданныхИсточник, ИмяОбъектаМетаданных, ИмяОчереди, СправочникЗагрузки)
	
	Если РСЗаписи = Неопределено или РСЗаписи.Количество() = 0 или РСЗапись = Неопределено Тогда                                               
		Возврат;
	КонецЕсли;
	
	ШтампВерсии = Число(ФабрикаИмени.ШтампВерсии);
	
	Если (РСЗапись.ШтампВерсии < ШтампВерсии) или (РСЗапись.ШтампВерсии = 0 и ШтампВерсии=0)
		ИЛИ (РСЗапись.ШтампВерсии = ШтампВерсии) Тогда
		
		РСЗапись.КодМДМ = ФабрикаИмени.GUID;    			
		РСЗапись.ШтампВерсии = ШтампВерсии;
		ОчиститьПустыеСвойства(ФабрикаИмени);
		
		ОбработатьРеквизитыФабрикиРС(РСЗапись, ИмяОбъектаМетаданных, ФабрикаИмени, ИмяОчереди);		
		
		РСЗаписи.ОбменДанными.Загрузка = Истина;

		Если Булево(ФабрикаИмени.ПометкаУдаления) = Истина Тогда
			РСЗаписи.Удалить(РСЗапись);
		Иначе
			РСЗаписи.Записать(Истина);	
		КонецЕсли; 
		
		ЗаписьЖурналаРегистрации("ПолучениеСообщений.Прием", УровеньЖурналаРегистрации.Информация,,, "Получена запись справочника " 
		//+Макрушин Е. 02.09.2026 #UT11-6043
		// для РС возникает ошибка из-за наименования
		//+ ИмяОбъектаМетаданных + " : " + ФабрикаИмени.GUID + ", " + ФабрикаИмени.Наименование);
		+ ИмяОбъектаМетаданных + " : " + ФабрикаИмени.GUID);
		//-Макрушин Е. 02.09.2026 #UT11-6043
		
	Иначе
		ЗаписьЖурналаРегистрации("ПолучениеСообщений.Прием", УровеньЖурналаРегистрации.Информация,,, "Существующая запись регистра сведений "
		//+Макрушин Е. 02.09.2026 #UT11-6043
		// для РС возникает ошибка из-за наименования
		//+ ИмяОбъектаМетаданных + " : " + ФабрикаИмени.GUID + ", " + ФабрикаИмени.Наименование + " имеет больший штамп версии, чем загружаемый. Сообщение отклонено.");
		+ ИмяОбъектаМетаданных + " : " + ФабрикаИмени.GUID + " имеет больший штамп версии, чем загружаемый. Сообщение отклонено.");
		//-Макрушин Е. 02.09.2026 #UT11-6043
	КонецЕсли; 
	
КонецПроцедуры                         

Процедура ОбработатьРеквизитыФабрикиРС(РСЗапись, ИмяОбъектаМетаданных, ФабрикаРС, ИмяОчереди)
	
	Если ИмяОбъектаМетаданных = "СинонимыПроизводителей" Тогда
		РСЗапись.СинонимПроизводителя = ФабрикаРС.Наименование;
	ИначеЕсли ИмяОбъектаМетаданных = "Штрихкоды" Тогда
		
		РСЗапись.Штрихкод = ФабрикаРС.Штрихкод;
		РСЗапись.Качество = Справочники.Качество.Новый;
		ЗаполнитьСвойствоПоПоискуКодаМДМ("ЕдиницыИзмерения", РСЗапись, "ЕдиницаИзмерения", ФабрикаРС.Упаковка, ФабрикаРС, ИмяОбъектаМетаданных);
		
		Попытка
			
			Значен = Число(ФабрикаРС.Штрихкод);
			
			Если Значен >= 1000000000000 И  Значен <= 9999999999999 тогда
				РСЗапись.ТипШтрихкода = ПланыВидовХарактеристик.ТипыШтрихкодов.EAN13;
			Иначе
				РСЗапись.ТипШтрихкода = ПланыВидовХарактеристик.ТипыШтрихкодов.Code128;
			КонецЕсли;
			
		Исключение
			РСЗапись.ТипШтрихкода = ПланыВидовХарактеристик.ТипыШтрихкодов.Code128;
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьРегистрСведенийПоФабрике(РСЗапись, ФабрикаИмени, ИмяОбъектаМетаданных, КодПрикладнойСистемы, Создавать = Истина)
	
	РСЗаписи = Неопределено;
	РСЗапись = Неопределено;
	
	Если ИмяОбъектаМетаданных = "СинонимыПроизводителей"  Тогда
		
		СинонимПроизводителя_КодМДМ = ФабрикаИмени.GUID;
		Производитель_КодМДМ = ФабрикаИмени.Производитель.GUID;
		
		Если ЗначениеЗаполнено(Производитель_КодМДМ) Тогда
			
			Производитель = Справочники.Номенклатура.НайтиПоРеквизиту("КодМДМ", Производитель_КодМДМ); 
			
			Если НЕ ЗначениеЗаполнено(Производитель) Тогда
				Производитель = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Производитель_КодМДМ));			
			КонецЕсли; 
			
			Если ЗначениеЗаполнено(Производитель) Тогда
				
				РСЗаписи = РегистрыСведений.СинонимыПроизводителей.СоздатьНаборЗаписей();
				РСЗаписи.ОбменДанными.Загрузка = Истина;
				РСЗаписи.Отбор.Производитель.Установить(Производитель);
				РСЗаписи.Отбор.КодМДМ.Установить(СинонимПроизводителя_КодМДМ);
				РСЗаписи.Прочитать();
				
				Если Создавать и РСЗаписи.Количество() = 0 Тогда                 
					
					РСЗапись = РСЗаписи.Добавить();
					РСЗапись.Производитель = Производитель;
					РСЗапись.КодМДМ = СинонимПроизводителя_КодМДМ;
					РСЗапись.СинонимПроизводителя = ФабрикаИмени.Наименование;
					РСЗапись.Активность = Истина;
					
				КонецЕсли;
				
			КонецЕсли; 
			
		КонецЕсли;
		
	ИначеЕсли ИмяОбъектаМетаданных = "Штрихкоды" Тогда
		
		РСЗапись = Неопределено;
		ШК_КодМДМ = ФабрикаИмени.GUID;
		Номенклатура_КодМДМ = ФабрикаИмени.Владелец.GUID;
		
		Если ЗначениеЗаполнено(Номенклатура_КодМДМ) Тогда
			
			Номенклатура = Справочники.Номенклатура.НайтиПоРеквизиту("КодМДМ", Номенклатура_КодМДМ); 
			
			Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
				
				НоменклатураСсылка = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Номенклатура_КодМДМ));
				Номенклатура = НоменклатураСсылка.ПолучитьОбъект();
				
			КонецЕсли; 
			
			Если ЗначениеЗаполнено(Номенклатура) Тогда
				
				//Ищем по коду МДМ
				РСЗаписи = РегистрыСведений.Штрихкоды.СоздатьНаборЗаписей();
				РСЗаписи.ОбменДанными.Загрузка = Истина;
				РСЗаписи.Отбор.Владелец.Установить(Номенклатура);
				РСЗаписи.Отбор.КодМДМ.Установить(ШК_КодМДМ);
				РСЗаписи.Прочитать();
				
				Если РСЗаписи.Количество() > 0 Тогда
					РСЗапись = РСЗаписи[0];
				Иначе
					
					//Попробуем найти по ШК:
					РСЗаписи = РегистрыСведений.Штрихкоды.СоздатьНаборЗаписей();
					РСЗаписи.ОбменДанными.Загрузка = Истина;
					РСЗаписи.Отбор.Владелец.Установить(Номенклатура);
					РСЗаписи.Прочитать();
					
					Для н = 0 По РСЗаписи.Количество()-1 Цикл
						
						Если РСЗаписи[н].Штрихкод = ФабрикаИмени.Штрихкод и (Не ЗначениеЗаполнено(РСЗаписи[н].КодМДМ) или РСЗаписи[н].КодМДМ = ШК_КодМДМ) Тогда
							
							РСЗапись = РСЗаписи[н];
							Прервать;
							
						КонецЕсли;
						
					КонецЦикла;	
					
					Если РСЗапись = Неопределено и Создавать Тогда
						РСЗапись = РСЗаписи.Добавить();
					КонецЕсли;
					
					Если РСЗапись <> Неопределено Тогда
						
						РСЗапись.Владелец = Номенклатура;
						РСЗапись.КодМДМ = ШК_КодМДМ;
						РСЗапись.Штрихкод = ФабрикаИмени.Штрихкод;
						РСЗапись.Качество = Справочники.Качество.Новый;
						
						Попытка
							
							Значен = Число(ФабрикаИмени.Штрихкод);
							
							Если Значен >= 1000000000000 И  Значен <= 9999999999999 тогда
								РСЗапись.ТипШтрихкода = ПланыВидовХарактеристик.ТипыШтрихкодов.EAN13;
							Иначе
								РСЗапись.ТипШтрихкода = ПланыВидовХарактеристик.ТипыШтрихкодов.Code128;
							КонецЕсли;
							
						Исключение
							РСЗапись.ТипШтрихкода = ПланыВидовХарактеристик.ТипыШтрихкодов.Code128;
						КонецПопытки;
						
						ЗаполнитьСвойствоПоПоискуКодаМДМ("ЕдиницыИзмерения", РСЗапись, "ЕдиницаИзмерения", ФабрикаИмени.Упаковка, ФабрикаИмени, ИмяОбъектаМетаданных);
						РСЗапись.Активность = Истина;
						
					КонецЕсли;
					
				КонецЕсли;
				
			Иначе
				
				ТекстОшибки = "Не найден владелец ШК "+СокрЛП(ФабрикаИмени.Владелец.GUID);
				ЗаписатьОшибкуВРС(ФабрикаИмени, ИмяОбъектаМетаданных, ФабрикаИмени.GUID, "Номенклатура", ФабрикаИмени.Владелец.GUID, ТекстОшибки);
				
			КонецЕсли; 
			
		КонецЕсли;

	//+Макрушин Е. 02.09.2026 #UT11-6043	
	ИначеЕсли ИмяОбъектаМетаданных = "ОбластиДействияСертификатовНоменклатуры"  Тогда
		
		ОбластьДействияСертификатовНоменклатуры_КодМДМ = ФабрикаИмени.GUID;
		
		Номенклатура_КодМДМ = ФабрикаИмени.Номенклатура.GUID;
		СертификатНоменклатуры_КодМДМ = ФабрикаИмени.СертификатНоменклатуры.GUID;
		
		Если ЗначениеЗаполнено(Номенклатура_КодМДМ) И ЗначениеЗаполнено(СертификатНоменклатуры_КодМДМ) Тогда
			
			Номенклатура = Справочники.Номенклатура.НайтиПоРеквизиту("КодМДМ", Номенклатура_КодМДМ);
			СертификатНоменклатуры = Справочники.СертификатыНоменклатуры.НайтиПоРеквизиту("КодМДМ", СертификатНоменклатуры_КодМДМ);
			
			Если ЗначениеЗаполнено(Номенклатура) И ЗначениеЗаполнено(СертификатНоменклатуры) Тогда
				
				РСЗаписи = РегистрыСведений.ОбластиДействияСертификатовНоменклатуры.СоздатьНаборЗаписей();
				РСЗаписи.ОбменДанными.Загрузка = Истина;
				РСЗаписи.Отбор.КодМДМ.Установить(ОбластьДействияСертификатовНоменклатуры_КодМДМ);
				РСЗаписи.Прочитать();
				
				Если Создавать и РСЗаписи.Количество() = 0 Тогда                 
					
					РСЗапись = РСЗаписи.Добавить();
					РСЗапись.КодМДМ = ОбластьДействияСертификатовНоменклатуры_КодМДМ;
					РСЗапись.Номенклатура = Номенклатура;
					РСЗапись.СертификатНоменклатуры = СертификатНоменклатуры;
					РСЗапись.Активность = Истина;
					
				КонецЕсли;
				
			КонецЕсли; 
			
		КонецЕсли;
	//-Макрушин Е. 02.09.2026 #UT11-6043	
		
	КонецЕсли; 
	
	Если РСЗапись = Неопределено Тогда
		РСЗаписи = Неопределено;
	КонецЕсли;
	
	Возврат РСЗаписи;
	
КонецФункции

Функция ПолучитьСтавкуНДСПеречислением(СтавкаНДС) Экспорт
	
	ЗначениеНДС = Неопределено;
	
	Если ТипЗнч(СтавкаНДС) = Тип("Строка") Тогда
		ПредставлениеСтавкиНДС = СтавкаНДС;
	ИначеЕсли ТипЗнч(СтавкаНДС) = Тип("Число") Тогда 
		ПредставлениеСтавкиНДС = Строка(СтавкаНДС);
	Иначе// неправильный тип
		ПредставлениеСтавкиНДС = Неопределено;
	КонецЕсли;
	
	Если ПредставлениеСтавкиНДС = Неопределено ИЛИ ВРЕГ(ПредставлениеСтавкиНДС) = "БЕЗ НДС" Тогда
		ЗначениеНДС = Перечисления.СтавкиНДС.БезНДС;
		
	ИначеЕсли ПредставлениеСтавкиНДС = "0" ИЛИ ПредставлениеСтавкиНДС = "0%" Тогда
		ЗначениеНДС = Перечисления.СтавкиНДС.НДС0;
		
	ИначеЕсли Найти("10#0.1#0,1#0.10#0,10#10%", ПредставлениеСтавкиНДС) > 0 Тогда
		
		ЗначениеНДС = Перечисления.СтавкиНДС.НДС10;
		
	ИначеЕсли Найти("20#0.2#0,2#0.20#0,20#20%", ПредставлениеСтавкиНДС) > 0 Тогда
		
		ЗначениеНДС = Перечисления.СтавкиНДС.НДС20; 
		
	ИначеЕсли Найти("22#0.22#0,22#0.22#0,22#22%", ПредставлениеСтавкиНДС) > 0 Тогда
		
		ЗначениеНДС = Перечисления.СтавкиНДС.НДС22;
		
	ИначеЕсли Найти("18#0.18#0,18#0.18#0,18#18%", ПредставлениеСтавкиНДС) > 0 Тогда
		
		ЗначениеНДС = Перечисления.СтавкиНДС.НДС18;
		
	ИначеЕсли Найти("10/110#10% / 110%#10%/110%", ПредставлениеСтавкиНДС) > 0 Тогда
		
		ЗначениеНДС = Перечисления.СтавкиНДС.НДС10_110;
		
	ИначеЕсли Найти("18/118#18% / 118%#18%/118%", ПредставлениеСтавкиНДС) > 0 Тогда
		
		ЗначениеНДС = Перечисления.СтавкиНДС.НДС18_118; 
		
	ИначеЕсли Найти("22/122#22% / 122%#22%/122%", ПредставлениеСтавкиНДС) > 0 Тогда
		
		ЗначениеНДС = Перечисления.СтавкиНДС.НДС22_122;
		
	КонецЕсли;
	
	Возврат ЗначениеНДС;
	
КонецФункции

Функция ПроверитьИСоздатьСерию(Номенклатура, НомерГТД, Страна, НомерГТДСсылка)
	
	//+Гавриленков В. 10.03.2026 #UT10-5742 // исправлены типы сравнения для НомерГТД и СтранаПроисхождения
	//+Марков И. 19.02.2026 #UT10-5709
	Запрос = Новый Запрос();
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НомераГТД.Ссылка КАК НомерГТДСсылка,
	|	СерииНоменклатуры.Ссылка КАК СерияСсылка
	|ИЗ
	|	Справочник.НомераГТД КАК НомераГТД
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СерииНоменклатуры КАК СерииНоменклатуры
	|		ПО (НЕ СерииНоменклатуры.Владелец = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка))
	|			И (СерииНоменклатуры.Владелец = &Номенклатура)
	|			И (НЕ СерииНоменклатуры.НомерГТД = ЗНАЧЕНИЕ(Справочник.НомераГТД.ПустаяСсылка))
	|			И (СерииНоменклатуры.НомерГТД = НомераГТД.Ссылка)
	|			И (НЕ СерииНоменклатуры.СтранаПроисхождения = ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка))
	|			И (СерииНоменклатуры.СтранаПроисхождения = &Страна)
	|			И (НЕ СерииНоменклатуры.ПометкаУдаления)
	|ГДЕ
	|	НЕ НомераГТД.ПометкаУдаления
	|	И НомераГТД.Код = &НомерГТД";
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Страна", Страна);
	Запрос.УстановитьПараметр("НомерГТД", НомерГТД);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Если ЗначениеЗаполнено(Выборка.НомерГТДСсылка) Тогда
			НомерГТДСсылка = Выборка.НомерГТДСсылка;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.СерияСсылка) Тогда
			Возврат Выборка.СерияСсылка;
		КонецЕсли;
		
	КонецЕсли;
		
	СерияНоменклатуры = Справочники.СерииНоменклатуры.СоздатьЭлемент();
	СерияНоменклатуры.Владелец = Номенклатура;
	СерияНоменклатуры.Наименование = НомерГТД;
	СерияНоменклатуры.СтранаПроисхождения = Страна;
		
	Если ЗначениеЗаполнено(НомерГТДСсылка) Тогда
		СерияНоменклатуры.НомерГТД = НомерГТДСсылка;
	Иначе
		
		НомерГТДОбъект = Справочники.НомераГТД.СоздатьЭлемент();
		НомерГТДОбъект.Код = НомерГТД;
		НомерГТДОбъект.Комментарий = "Создан регламентным заданием загрузки из Раббит " + ТекущаяДата();
		НомерГТДОбъект.Записать();
		СерияНоменклатуры.НомерГТД = НомерГТДОбъект.Ссылка;

	КонецЕсли;
	
	СерияНоменклатуры.Комментарий = "Создан регламентным заданием загрузки из Раббит " + ТекущаяДата();
		
	СерияНоменклатуры.Записать();
	
	Возврат СерияНоменклатуры.Ссылка;
	//-Марков И. 19.02.2026 #UT10-5709
	
КонецФункции

Процедура СформироватьСкидкиПоУсловиям(ФабрикаСправочника, ДоговорОб)
	
	СписокКодовМДМПрайсЛистов = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Склады.КодМДМПрайсЛиста
	|ИЗ
	|	Справочник.Склады КАК Склады
	|ГДЕ
	|	Склады.КодМДМПрайсЛиста <> """"";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл 
		
		Если ЗначениеЗаполнено(СокрЛП(Выборка.КодМДМПрайсЛиста)) Тогда
			СписокКодовМДМПрайсЛистов.Добавить(СокрЛП(Выборка.КодМДМПрайсЛиста));
		КонецЕсли;
		
	КонецЦикла;
	
	Если СписокКодовМДМПрайсЛистов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НовыйДоговор = ДоговорОб.ЭтоНовый();
	Множественные = ДоговорОб.МножественныеУсловия;
	
	ОбработанныеДокументы = Новый Массив;
	
	МассивСтрокПрайсов = СформироватьМассивПоСвойству(ФабрикаСправочника, "ПрайсЛистыДляСкидокНаБренды", "Строка");
	
	МассивСтрокУсловий = СформироватьМассивПоСвойству(ФабрикаСправочника, "Условия", "Строка");
	
	Если НЕ Множественные Тогда
		
		МассивСтрокУсловий.Очистить();		
		МассивСтрокУсловий.Добавить(Новый Структура("КлючСтроки, Неактивное", "0", "false"));
		
	КонецЕсли;
	
	МассивСтрокСкидок = СформироватьМассивПоСвойству(ФабрикаСправочника, "СкидкиНаБренды", "Строка");
	
	Для каждого СтрУсловий ИЗ МассивСтрокУсловий Цикл
		
		Для каждого СтрСкидок ИЗ МассивСтрокСкидок Цикл
			
			Если Множественные Тогда
				
				Если СтрСкидок.КлючСтроки <> СтрУсловий.КлючСтроки Тогда
					Продолжить;
				КонецЕсли;
				
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(СтрСкидок.Скидка) Тогда
				Продолжить;
			КонецЕсли;
			
			ЕстьПрайсНужные = Ложь;
			
			Для каждого СтрПрайсов Из МассивСтрокПрайсов Цикл
				
				Если Не СтрПрайсов.УникальныйИдентификатор = СтрСкидок.УникальныйИдентификатор Тогда
					Продолжить;
				КонецЕсли;
				
				Если СписокКодовМДМПрайсЛистов.НайтиПоЗначению(СтрПрайсов.ПрайсЛист.GUID) <> Неопределено Тогда
					
					ЕстьПрайсНужные = Истина;
					Прервать;
					
				КонецЕсли;
				
			КонецЦикла;
			
			Если ЕстьПрайсНужные Тогда
				
				Если Не НовыйДоговор Тогда
					
					Документ = ПолучитьУстановкуСкидокПоКлючам(СтрУсловий.КлючСтроки, СтрСкидок.УникальныйИдентификатор, ДоговорОб.Ссылка);
					
					Если ЗначениеЗаполнено(Документ) Тогда
						
						ДокументОб = Документ.ПолучитьОбъект();
						
						Если ДокументОб.ПометкаУдаления Тогда
							ДокументОб.УстановитьПометкуУдаления(Ложь);
						КонецЕсли;
						
					Иначе
						
						ДокументОб = Документы.УстановкаСкидокНоменклатуры.СоздатьДокумент();
						ДокументОб.Дата = ТекущаяДата();
						
					КонецЕсли;
					
				Иначе
					
					ДокументОб = Документы.УстановкаСкидокНоменклатуры.СоздатьДокумент();
					ДокументОб.Дата = ТекущаяДата();
					
				КонецЕсли;
				
				ДокументОб.КлючСтрокиСкидок = СтрСкидок.УникальныйИдентификатор;
				ДокументОб.КлючСтрокиУсловий = СтрУсловий.КлючСтроки;
				ДокументОб.ДатаНачала = ПреобразоватьДатуМДМ(СтрСкидок.ДатаНачала);
				ДокументОб.ДатаОкончания = ПреобразоватьДатуМДМ(СтрСкидок.ДатаОкончания);
				ДокументОб.Комментарий = "Загружен из МДМ: " + ТекущаяДата();
				ДокументОб.ПроцентСкидкиНаценки = СтрСкидок.Скидка;
				ДокументОб.ВидОперации = Перечисления.ВидыОперацийУстановкаСкидокНоменклатуры.ПоГруппамНоменклатуры;
				ДокументОб.ВидСкидки = Перечисления.ВидыСкидок.Оптовая;		
				ДокументОб.Условие = Перечисления.УсловияСкидкиНаценки.БезУсловий;
				ДокументОб.Валюта = Константы.ВалютаУправленческогоУчета.Получить();
				
				ДокументОб.ПолучателиСкидки.Очистить();
				Получатель = ДокументОб.ПолучателиСкидки.Добавить();
				
				Если НовыйДоговор Тогда
					Получатель.Получатель = ДоговорОб.ПолучитьСсылкуНового();
				Иначе
					Получатель.Получатель = ДоговорОб.Ссылка;
				КонецЕсли;
				
				Получатель.Контрагент = ДоговорОб.Владелец;
				
				ДокументОб.Товары.Очистить();
				Товар = ДокументОб.Товары.Добавить();
				Товар.ПроцентСкидкиНаценки = ДокументОб.ПроцентСкидкиНаценки;
				Товар.Качество = Справочники.Качество.Новый;
				ЗаполнитьСвойствоПоПоискуКодаМДМ("Номенклатура", Товар, "Номенклатура", СтрСкидок.Бренд);
				
				Если Не ЗначениеЗаполнено(Товар.Номенклатура) Тогда                                                                        				
					
					ТекстОшибки = "Не найдена группа номенклатуры по коду МДМ при установке скидок номенклатуры для множественных условий";				
					ЗаписатьОшибкуВРС(ФабрикаСправочника, "ДоговорыКонтрагентов", ФабрикаСправочника.GUID,,, ТекстОшибки, Ложь);
					
					Если НЕ ДокументОб.Проведен Тогда
						ДокументОб.Записать(РежимЗаписиДокумента.Запись, РежимПроведенияДокумента.Неоперативный);
					КонецЕсли;
					
				Иначе
					ДокументОб.Записать(РежимЗаписиДокумента.Проведение);
				КонецЕсли;
				
				Если Булево(ФабрикаСправочника.ПометкаУдаления) ИЛИ Булево(СтрУсловий.Неактивное) Тогда
					ДокументОб.УстановитьПометкуУдаления(Истина);
				КонецЕсли;
				
				ОбработанныеДокументы.Добавить(ДокументОб.Ссылка);
				
			КонецЕсли;
			
		КонецЦикла;		
		
	КонецЦикла;
	
	Если Не НовыйДоговор Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	УстановкаСкидокНоменклатурыПолучателиСкидки.Ссылка
		|ИЗ
		|	Документ.УстановкаСкидокНоменклатуры.ПолучателиСкидки КАК УстановкаСкидокНоменклатурыПолучателиСкидки
		|ГДЕ
		|	УстановкаСкидокНоменклатурыПолучателиСкидки.Ссылка.КлючСтрокиСкидок <> """"
		|	И (ВЫРАЗИТЬ(УстановкаСкидокНоменклатурыПолучателиСкидки.Получатель КАК Справочник.ДоговорыКонтрагентов)) = &Договор
		|	И НЕ УстановкаСкидокНоменклатурыПолучателиСкидки.Ссылка.Ссылка В (&ОбработанныеДокументы)
		|	И НЕ УстановкаСкидокНоменклатурыПолучателиСкидки.Ссылка.ПометкаУдаления";
		
		Запрос.УстановитьПараметр("ОбработанныеДокументы", ОбработанныеДокументы);
		Запрос.УстановитьПараметр("Договор", ДоговорОб.Ссылка);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			ДокументОб = Выборка.Ссылка.ПолучитьОбъект();
			ДокументОб.УстановитьПометкуУдаления(Истина);
			
		КонецЦикла;
		
	КонецЕсли;
	
	
КонецПроцедуры

Функция ПолучитьУстановкуСкидокПоКлючам(КлючУсловий, КлючСкидок, Договор)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	УстановкаСкидокНоменклатурыПолучателиСкидки.Ссылка
	|ИЗ
	|	Документ.УстановкаСкидокНоменклатуры.ПолучателиСкидки КАК УстановкаСкидокНоменклатурыПолучателиСкидки
	|ГДЕ
	|	УстановкаСкидокНоменклатурыПолучателиСкидки.Ссылка.КлючСтрокиУсловий = &КлючУсловий
	|	И УстановкаСкидокНоменклатурыПолучателиСкидки.Ссылка.КлючСтрокиСкидок = &КлючСкидок
	|	И (ВЫРАЗИТЬ(УстановкаСкидокНоменклатурыПолучателиСкидки.Получатель КАК Справочник.ДоговорыКонтрагентов)) = &Договор";
	
	Запрос.УстановитьПараметр("КлючУсловий", Число(КлючУсловий));
	Запрос.УстановитьПараметр("КлючСкидок", КлючСкидок);
	Запрос.УстановитьПараметр("Договор", Договор);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;	
	
КонецФункции

Процедура ЗаполнитьСвойствоПоПоискуКодаМДМ(ИмяСправочника, СпрОбъект, ИмяРеквизита, Значение, ФабрикаСправочника = Неопределено, ИмяОбъектаМетаданных = "")
	
	Если ТипЗнч(Значение) = Тип("ОбъектXDTO") И Значение.Свойства().Количество() > 0 И Значение.Свойства().Получить("GUID") <> Неопределено Тогда		
		
		СпрОбъект[ИмяРеквизита] = Справочники[ИмяСправочника].НайтиПоРеквизиту("КодМДМ", Значение.GUID); 
		
		Если Не ЗначениеЗаполнено(СпрОбъект[ИмяРеквизита]) и ФабрикаСправочника <> Неопределено и ЗначениеЗаполнено(Значение.GUID) Тогда
			ЗаписатьОшибкуВРС(ФабрикаСправочника, ?(Не ЗначениеЗаполнено(ИмяОбъектаМетаданных), СпрОбъект.Метаданные().Имя, ИмяОбъектаМетаданных),
			ФабрикаСправочника.GUID, ИмяСправочника, Значение.GUID);
		КонецЕсли;
		
	КонецЕсли;  
	
КонецПроцедуры

Процедура ЗагрузитьКонтактнуюИнформацию(МассивКонтактнойИнформации, СпрОбъект, ИмяОчереди)
	
	глСоответствиеКвартир = Новый Соответствие;
	глСоответствиеКвартир.Вставить(Перечисления.ТипыКвартир.Квартира, "кв.");
	глСоответствиеКвартир.Вставить(Перечисления.ТипыКвартир.Офис, "оф.");
	глСоответствиеКвартир.Вставить(Перечисления.ТипыКвартир.Бокс, "б.");
	глСоответствиеКвартир.Вставить(Перечисления.ТипыКвартир.Помещение, "пом.");
	глСоответствиеКвартир.Вставить(Перечисления.ТипыКвартир.Комната, "комн.");
	глСоответствиеКвартир.Вставить(Перечисления.ТипыКвартир.Этаж, "эт.");
	
	СсылкаНаОбъект = Неопределено;
	
	Если СпрОбъект.ЭтоНовый() Тогда
		СсылкаНаОбъект = СпрОбъект.ПолучитьСсылкуНового();
	Иначе
		СсылкаНаОбъект = СпрОбъект.Ссылка;
	КонецЕсли;
	
	Набор = РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей();
	Набор.Отбор.Объект.Установить(СсылкаНаОбъект);
	Набор.Прочитать();
	Набор.Очистить();
	Набор.Записать();
	
	АдресЭППрайса = "";
	АдресЭПОбмена = "";

	Для каждого КонтактнаяИнформация Из МассивКонтактнойИнформации Цикл
		
		Вид = ПолучитьОбъектПоФабрике(КонтактнаяИнформация.Вид, "ВидыКонтактнойИнформации", ИмяОчереди, Ложь, Истина);
		
		Если Не ЗначениеЗаполнено(Вид) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Вид.Тип) Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяПоляПолучения = "";
		ЭтоАдрес = Ложь;
		
		Если Вид.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес Тогда
			ЭтоАдрес = Истина;
			ИмяПоляПолучения = "Представление"
		ИначеЕсли Вид.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты Тогда
			ИмяПоляПолучения = "Представление";
		ИначеЕсли Вид.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон Тогда
			ИмяПоляПолучения = "Представление";
		ИначеЕсли Вид.Тип = Перечисления.ТипыКонтактнойИнформации.ВебСтраница Тогда
			ИмяПоляПолучения = "Представление";
		Иначе
			ИмяПоляПолучения = "Представление";
		КонецЕсли;
		
		ЗначениеИнформации = СокрЛП(КонтактнаяИнформация[ИмяПоляПолучения]);

		Попытка
			
			Если Не ЗначениеЗаполнено(ЗначениеИнформации) Тогда
				Продолжить;
			КонецЕсли;
			
		Исключение
			Продолжить;
		КонецПопытки;
		
		МенеджерЗаписи = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Вид = Вид;
		МенеджерЗаписи.Объект = СсылкаНаОбъект;
		МенеджерЗаписи.Тип = Вид.Тип;
		
		Если Вид = Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыКонтрагентаДляРассылкиПрайса Тогда
			
			АдресЭППрайса = АдресЭППрайса + ?(АдресЭППрайса = "", "", "; ") + ЗначениеИнформации;
			МенеджерЗаписи.Представление = АдресЭППрайса;
			
		ИначеЕсли Вид = Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыКонтрагентаДляОбменаДокументами Тогда
			
			АдресЭПОбмена = АдресЭПОбмена + ?(АдресЭПОбмена = "", "", "; ") + ЗначениеИнформации;
			МенеджерЗаписи.Представление = АдресЭПОбмена;
			
		Иначе
			МенеджерЗаписи.Представление = ЗначениеИнформации;	
		КонецЕсли;		
		
		Если ЭтоАдрес Тогда
			
			ЗначенияПолей = КонтактнаяИнформация.ЗначенияПолей;
			
			ЗначенияПолей = СтрЗаменить(ЗначенияПолей, "&lt;", "<");
			ЗначенияПолей = СтрЗаменить(ЗначенияПолей, "&gt;", ">");
			
			XDTOАдрес = КонтактнаяИнформацияМДМ.КонтактнаяИнформацияИзXML(ЗначенияПолей, Перечисления.ТипыКонтактнойИнформации.Адрес);
			ЗданияИПомещения = КонтактнаяИнформацияМДМ.ЗданияИПомещенияАдреса(XDTOАдрес);
			
			МенеджерЗаписи.Поле1 = Формат(КонтактнаяИнформацияМДМ.ПочтовыйИндексАдреса(XDTOАдрес), "ЧГ=");
			МенеджерЗаписи.Поле2 = XDTOАдрес.Состав.Состав.СубъектРФ;
			
			Если XDTOАдрес.Состав.Состав.СвРайМО <> Неопределено Тогда
				МенеджерЗаписи.Поле3 = XDTOАдрес.Состав.Состав.СвРайМО.Район;
			Иначе
				МенеджерЗаписи.Поле3 = XDTOАдрес.Состав.Состав.ВнутригРайон;
			КонецЕсли;
			
			МенеджерЗаписи.Поле4 = XDTOАдрес.Состав.Состав.Город;
			МенеджерЗаписи.Поле5 = XDTOАдрес.Состав.Состав.НаселПункт;
			МенеджерЗаписи.Поле6 = XDTOАдрес.Состав.Состав.Улица;
			
			Если ЗданияИПомещения.Здания.Количество() > 0 Тогда
				
				Для каждого Здание ИЗ ЗданияИПомещения.Здания Цикл
					
					ТипЗдания = Здание.Тип;
					
					Если ТипЗдания = "Дом" ИЛИ ТипЗдания = "Владение" ИЛИ ТипЗдания = "Домовладение" Тогда 
						
						МенеджерЗаписи.Поле7 = Здание.Значение;
						МенеджерЗаписи.ТипДома = Перечисления.ТипыДомов[ТипЗдания];
						
					ИначеЕсли ТипЗдания = "Корпус" ИЛИ ТипЗдания = "Строение" ИЛИ ТипЗдания = "Литера" ИЛИ ТипЗдания = "Сооружение" ИЛИ ТипЗдания = "Участок" Тогда
						
						МенеджерЗаписи.Поле8 = Здание.Значение;
						МенеджерЗаписи.ТипКорпуса = Перечисления.ТипыКорпусов[ТипЗдания];	
						
					КонецЕсли;	
					
				КонецЦикла;
				
			КонецЕсли;
			
			Если ЗданияИПомещения.Помещения.Количество() > 0 Тогда

				ЗначениеПомещения = "";
				ПромТипПомещения = "";
				ТаблицаСокращения = Новый ТаблицаЗначений;
				ТаблицаСокращения.Колонки.Добавить("Приоритет");
				ТаблицаСокращения.Колонки.Добавить("ТипПомещенияИсходный");
				ТаблицаСокращения.Колонки.Добавить("ТипПомещенияСформированный");
				ТаблицаСокращения.Колонки.Добавить("НачальныйНомерВСтроке");
				ТаблицаСокращения.Колонки.Добавить("КонечныйНомерВСтроке");
				ТаблицаСокращения.Колонки.Добавить("ТипПомещенияСокращенный");
				
				Для каждого Помещение ИЗ ЗданияИПомещения.Помещения Цикл
					
					ПромТипПомещения = ?(ПромТипПомещения = "" ,Помещение.Тип,ПромТипПомещения);
					ТипПомещения = Помещение.Тип;
					СформированныйТип = глСоответствиеКвартир.Получить(Перечисления.ТипыКвартир[ТипПомещения]);
					
					Если ТипПомещения = "Квартира" Или ТипПомещения = "Офис" Или ТипПомещения = "Бокс" Или ТипПомещения = "Этаж" Тогда			
						
						ЗначениеПомещения = ЗначениеПомещения +?(ЗначениеЗаполнено(ЗначениеПомещения), "," +СформированныйТип, "") + " " +Помещение.Значение;
						
					ИначеЕсли ТипПомещения = "Помещение"  Тогда
						
						ЗначениеПомещения = ЗначениеПомещения +?(ЗначениеЗаполнено(ЗначениеПомещения), "," + СформированныйТип, "") + " " +Помещение.Значение;
						
						СтрСокращения = ТаблицаСокращения.Добавить();
						СтрСокращения.Приоритет = 2;
						СтрСокращения.ТипПомещенияИсходный = ТипПомещения;
						СтрСокращения.ТипПомещенияСформированный = СформированныйТип;
						
						НачальныйНомерВСтроке = Найти(ЗначениеПомещения, СформированныйТип);
						СтрСокращения.НачальныйНомерВСтроке = НачальныйНомерВСтроке;
						СтрСокращения.КонечныйНомерВСтроке = СтрДлина(ЗначениеПомещения) - СтрДлина(Помещение.Значение) - 1;
						СтрСокращения.ТипПомещенияСокращенный = "п.";
						
					ИначеЕсли ТипПомещения = "Комната"  Тогда
						
						ЗначениеПомещения = ЗначениеПомещения +?(ЗначениеЗаполнено(ЗначениеПомещения), "," + СформированныйТип, "") + " " +Помещение.Значение;
						
						СтрСокращения = ТаблицаСокращения.Добавить();
						СтрСокращения.Приоритет = 1;
						СтрСокращения.ТипПомещенияИсходный = ТипПомещения;
						СтрСокращения.ТипПомещенияСформированный = СформированныйТип;
						НачальныйНомерВСтроке = Найти(ЗначениеПомещения, СформированныйТип);
						СтрСокращения.НачальныйНомерВСтроке = НачальныйНомерВСтроке;
						СтрСокращения.КонечныйНомерВСтроке = СтрДлина(ЗначениеПомещения) - СтрДлина(Помещение.Значение) - 1;
						СтрСокращения.ТипПомещенияСокращенный = "к.";
						
					КонецЕсли;	
					
				КонецЦикла;
				
				ТаблицаСокращения.Сортировать("Приоритет");
				
				Для Каждого СтрокаСокращения Из ТаблицаСокращения Цикл
					
					Если СтрДлина(ЗначениеПомещения) <= 20 Тогда
						Прервать;
					КонецЕсли;
					
					НачПозиция = СтрокаСокращения.НачальныйНомерВСтроке;
					КонПозиция = СтрокаСокращения.КонечныйНомерВСтроке;
					
					СтрокаДо = Лев(ЗначениеПомещения, НачПозиция - 1);
					СтрокаПосле = Сред(ЗначениеПомещения, КонПозиция + 1);
					
					ЗначениеПомещения = СтрокаДо + СтрокаСокращения.ТипПомещенияСокращенный + СтрокаПосле;
					
				КонецЦикла;
				
				МенеджерЗаписи.Поле9 = СокрЛП(ЗначениеПомещения);
				МенеджерЗаписи.ТипКвартиры = Перечисления.ТипыКвартир[ПромТипПомещения];

			КонецЕсли;                   			
			
		КонецЕсли;
		
		МенеджерЗаписи.Записать(Истина);  
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьИмяОбъектаМетаданныхПоСообщению(Сообщение) Экспорт
	
	ИмяОбъектаМетаданных = "";
	
	Если МСК.ЭтоОчередьПрайсПМ(Сообщение.Подписка.ИмяОчереди) Тогда
	
		СтрПоиска = Сообщение.Параметры.Найти("price_type", "Имя");	
		
		Если СтрПоиска <> Неопределено И СтрПоиска.Значение = "ТОХ" Тогда
			Возврат "УстановкаЦенНоменклатурыКонтрагентов";		
		Иначе
			Возврат "";
		КонецЕсли;      
		
	КонецЕсли;
	
	ТекстСообщения = Сообщение.Данные;
	СтрВидДокумента = Найти(ТекстСообщения, "ВидДокумента");
	
	Если СтрВидДокумента = 0 Тогда
	
		тзСтрока = Сообщение.Параметры.Найти("document_type", "Имя");
		
		Если Не тзСтрока = Неопределено Тогда   
			
			ВидДокумента = тзСтрока.Значение;
			
			Если ВидДокумента = "ПоступлениеТоваровИУслуг" Тогда
				Возврат "ПоступлениеТоваровУслуг";  
			ИначеЕсли ВидДокумента = "СостояниеЗаказаНаЭмиссию" Тогда
				Возврат "ЗаказНаЭмиссиюКодовМаркировкиСУЗ";
			ИначеЕсли ВидДокумента = "СостояниеОтчетаОНанесении" Тогда
				Возврат "ОтчетОНанесенииКИЗ";
			ИначеЕсли ВидДокумента = "СостояниеВводВОборот" Тогда
				Возврат "ВводВОборотКИЗ";
			//+Белов А. 24.03.2026 #UT10-5761
			ИначеЕсли ВидДокумента = "СостояниеВыводаИзОборота" Тогда
				Возврат "ВыводИзОборотаКИЗ";
			//-Белов А. 24.03.2026 #UT10-5761  
			//+Белов А. 02.06.2026 #UT10-5894
			ИначеЕсли ВидДокумента = "СостояниеОбработкиГИСМТ" Тогда
				Возврат "ОбработкаГИСМТ";
			//-Белов А. 02.06.2026 #UT10-5894    
			//+Шульман А. 02.07.2026 #UT10-5944    
			ИначеЕсли ВидДокумента = "Перемещение" Тогда
				Возврат "ЗаказПоставщику";
			//-Шульман А. 02.07.2026 #UT10-5944
			Иначе	
				Возврат ВидДокумента;	
			КонецЕсли;
			
		КонецЕсли;   
		
		Возврат "";
	
	КонецЕсли;     
	
	Если СтрВидДокумента > 0 Тогда
		
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТекстСообщения);
		СообщениеJSON = ПрочитатьJSON(ЧтениеJSON);
		
		Если ТипЗнч(СообщениеJSON) = Тип("Массив") тогда
			
			СтруктураДокумента = СообщениеJSON[0];		
			ИмяОбъектаМетаданных = СтруктураДокумента.ВидДокумента;       
			
		ИначеЕсли ТипЗнч(СообщениеJSON) = Тип("Структура") тогда
			ИмяОбъектаМетаданных = СообщениеJSON.ВидДокумента;       
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ИмяОбъектаМетаданных;
	
КонецФункции

Функция ПолучитьКодИсточникаПоСообщению(Сообщение) Экспорт
	
	КодИсточника = "";
	
	СтруктураСообщения = ОбщегоНазначения.ВернутьСтруктуруИзJSON(Сообщение.Данные);	
	
	Если СтруктураСообщения.Свойство("УникальныйИдентификатор") Тогда
		КодИсточника = СтруктураСообщения.УникальныйИдентификатор;	
	ИначеЕсли СтруктураСообщения.Свойство("Id_edi") Тогда
		КодИсточника = СтруктураСообщения.Id_edi;	
	ИначеЕсли СтруктураСообщения.Свойство("number") Тогда
		КодИсточника = СтруктураСообщения.number;
	КонецЕсли; 
	
	Возврат КодИсточника;
	
КонецФункции


/////////////////Вспомогательные процедуры загрузки сообщений//////////////////

Процедура ОчиститьПустыеСвойства(ФабрикаСправочника)
	
	Для каждого Свойство Из ФабрикаСправочника.Свойства() Цикл
		
		Имя = Свойство.Имя;
		
		Если ТипЗнч(ФабрикаСправочника[Имя]) = Тип("ОбъектXDTO") И ФабрикаСправочника[Имя].Свойства().Количество() = 0 Тогда
			ФабрикаСправочника[Имя] = "";
		КонецЕсли;		
		
	КонецЦикла;	 
	
КонецПроцедуры

Функция ПреобразоватьДатуМДМ(СтроковаяДата)
	
	Попытка
		
		СтроковаяДата = СтрЗаменить(СтроковаяДата, "-", ""); 
		СтроковаяДата = СтрЗаменить(СтроковаяДата, ":", "");
		СтроковаяДата = СтрЗаменить(СтроковаяДата, "T", "");
		СтроковаяДата = СтрЗаменить(СтроковаяДата, " ", ""); 
		СтроковаяДата = Лев(СтроковаяДата, 14); 
		
		Возврат Дата(СтроковаяДата);
	
	Исключение    
		Возврат СтрокаВДату(СтроковаяДата);    
	КонецПопытки;
		
КонецФункции       

Функция СтрокаВДату(Знач ДатаСтрока) Экспорт
	
	ДатаСтрока = Лев(СОКРЛП(ДатаСтрока), 10);
	
	СначалаГод = Найти("0123456789", Сред(ДатаСтрока, 3, 1)) > 0;
	
	ДатаСтрока = СокрЛП(СтрЗаменить(ДатаСтрока, ".", "")); 
	ДатаСтрока = СтрЗаменить(ДатаСтрока, "-", "");
	ДатаСтрока = СтрЗаменить(ДатаСтрока, "/", "");
	ДатаСтрока = СтрЗаменить(ДатаСтрока, "\", "");
	
	Если СначалаГод Тогда 
		ДатаСтрока = Лев(ДатаСтрока, 4) + Сред(ДатаСтрока, 5, 2) + Прав(ДатаСтрока, 2);  
	Иначе
		
		ДатаСтрока = Сред(ДатаСтрока, 5) + Сред(ДатаСтрока, 3, 2) + Лев(ДатаСтрока, 2);  
	
		Если СтрДлина(ДатаСтрока) = 6 Тогда
			ДатаСтрока = "20" + ДатаСтрока;
		КонецЕсли;    
		
	КонецЕсли;
	
	ОписаниеТипа = Новый ОписаниеТипов("Дата");
	Результат    = ОписаниеТипа.ПривестиЗначение(ДатаСтрока);
	
	Возврат Результат;
	
КонецФункции    

// Преобразует исходную строку в число.
//   Превращает строку в число без вызова исключений. Стандартная функция преобразования.
//   Число() строго контролирует отсутствие каких-либо символов кроме числовых.
//
// Параметры:
//   ИсходнаяСтрока - Строка - Строка, которую необходимо привести к числу.
//
// Возвращаемое значение:
//   Число - Полученное число.
//   Неопределено - Если строка не является числом.
//
Функция СтрокаВЧисло(Знач ИсходнаяСтрока) Экспорт
	
	//+Макрушин Е. 12.02.2026 #UT10-5665
	//перенесена типовая функция
	ИсходнаяСтрока = СокрЛП(ИсходнаяСтрока);
	Результат = 0;
	ЗнаковПослеЗапятой = -1;
	ЗнакОтрицательный = Ложь;
	Длина = СтрДлина(ИсходнаяСтрока);
	
	Для НомерСимвола = 1 По Длина Цикл
		
		КодСимвола = КодСимвола(ИсходнаяСтрока, НомерСимвола);
		
		Если КодСимвола = 32 Или КодСимвола = 160 Тогда // Пробел или неразрывный пробел.
			// Пропуск (действие не требуется).
		ИначеЕсли КодСимвола = 45 Или КодСимвола = 40 Тогда // Минус или открывающая скобка.
			
			Если Результат <> 0 Тогда
				Возврат Неопределено;
			КонецЕсли;
			
			ЗнакОтрицательный = Истина;
			
		ИначеЕсли КодСимвола = 41 Тогда // Закрывающая скобка.
			
			Если Не ЗнакОтрицательный Или Результат = 0 Тогда // Не было открывающей скобки или нет числа.
				Возврат Неопределено;
			КонецЕсли;
			// Пропуск (действие не требуется).
			
		ИначеЕсли КодСимвола = 44 Или КодСимвола = 46 Тогда // Запятая или точка.
			
			Если ЗнаковПослеЗапятой <> -1 Тогда
				Возврат Неопределено; // Разделитель уже был, следовательно это не число.
			КонецЕсли;
			
			ЗнаковПослеЗапятой = 0; // Запуск отсчета знаков после запятой.
			
		ИначеЕсли КодСимвола > 47 И КодСимвола < 58 Тогда // Число.
			
			Если ЗнаковПослеЗапятой <> -1 Тогда
				ЗнаковПослеЗапятой = ЗнаковПослеЗапятой + 1;
			КонецЕсли;
			
			Число = КодСимвола - 48;
			Результат = Результат * 10 + Число;
			
		Иначе
			Возврат Неопределено;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗнаковПослеЗапятой > 0 Тогда
		Результат = Результат / Pow(10, ЗнаковПослеЗапятой);
	КонецЕсли;
	
	Если ЗнакОтрицательный Тогда
		Результат = -Результат;
	КонецЕсли;
	
	Возврат Результат;
	//-Макрушин Е. 12.02.2026 #UT10-5665
	
КонецФункции


Процедура ЗаписатьОшибкуВРС(ФабрикаСправочника, ИмяОбъектаМетаданных, КодМДМ, ИмяСопутствСправочника = "", КодМДМСопутствСправочника = "", 
	                        ТекстОшибки = "Не найден элемент по коду МДМ", НужноОбработать = Истина)
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	ФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ФабрикаСправочника);
	ФабрикаСправочникаСтрокой = ЗаписьXML.Закрыть();    
	
	НаборЗаписей = РегистрыСведений.ОшибкиЗагрузкиДанныхИзОчередиAMQP.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИмяОбъектаМетаданных.Установить(ИмяОбъектаМетаданных);
	НаборЗаписей.Отбор.КодМДМ.Установить(КодМДМ);
	
	Если ЗначениеЗаполнено(ИмяСопутствСправочника) и Строка(КодМДМСопутствСправочника) <> КодМДМ Тогда
		
		НаборЗаписей.Отбор.ИмяСопутствСправочника.Установить(ИмяСопутствСправочника);
		НаборЗаписей.Отбор.КодМДМСопутствСправочника.Установить(КодМДМСопутствСправочника);
		
	КонецЕсли;
	
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() > 0 Тогда
		
		ТекЗапись = НаборЗаписей[0];
		
		//Если штамп версии не изменился, то не сохраняем запись в РС
		Если ТекЗапись.ШтампВерсии >= Число(ФабрикаСправочника.ШтампВерсии) Тогда
			Возврат;
		КонецЕсли;
		
		ТекЗапись.КоличествоПопыток = ТекЗапись.КоличествоПопыток + 1;
		
	Иначе
		
		ТекЗапись = НаборЗаписей.Добавить();
		ТекЗапись.КоличествоПопыток = 1;
		
	КонецЕсли;
	
	ТекЗапись.МоментОшибки = ТекущаяДата() + 1;
	ТекЗапись.ИмяОбъектаМетаданных = ИмяОбъектаМетаданных;
	ТекЗапись.КодМДМ = КодМДМ;
	ТекЗапись.ТекстОшибки = ТекстОшибки;
	ТекЗапись.ОписаниеОшибки = ФабрикаСправочникаСтрокой;
	ТекЗапись.НужноОбработать = НужноОбработать;
	ТекЗапись.ШтампВерсии = Число(ФабрикаСправочника.ШтампВерсии);
	
	Если ЗначениеЗаполнено(ИмяСопутствСправочника) и Строка(КодМДМСопутствСправочника) <> КодМДМ Тогда
		
		ТекЗапись.ИмяСопутствСправочника = ИмяСопутствСправочника;
		ТекЗапись.КодМДМСопутствСправочника = КодМДМСопутствСправочника;
		
	КонецЕсли;
	
	Если ИмяОбъектаМетаданных = "Номенклатура" Тогда
		ТекЗапись.Комментарий = ФабрикаСправочника.КомментарийАварда;
	КонецЕсли;
	
	НаборЗаписей.Записать(); 
	
КонецПроцедуры

Функция СсылкаПоИдентификатору(ТипЗначения, Значение)     
	
	Если ТипЗначения = Тип("Null") Тогда
		Возврат Null;
	КонецЕсли;
	
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения);
	
	Если ОбъектМетаданных = Неопределено Тогда
		ВызватьИсключение "Не верный аргумент";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Значение) Тогда
		
		Если Метаданные.Перечисления.Содержит(ОбъектМетаданных) Тогда
			
			ТекстЗапроса =
			"ВЫБРАТЬ
			|	ABCКлассификация.Ссылка,
			|	ПРЕДСТАВЛЕНИЕ(ABCКлассификация.Ссылка) КАК Представление
			|ИЗ
			|	Перечисление.ABCКлассификация КАК ABCКлассификация";
			
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Перечисление.ABCКлассификация", ОбъектМетаданных.ПолноеИмя());
			Запрос = Новый Запрос(ТекстЗапроса);
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				Если Выборка.Представление = Значение Тогда
					Возврат Выборка.Ссылка;
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе
			
			ТекстЗапроса =
			"ВЫБРАТЬ
			|	Номенклатура.Ссылка
			|ИЗ
			|	Справочник.Номенклатура КАК Номенклатура
			|ГДЕ
			|	Номенклатура.КодМДМ = &КодМДМ";
			
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Справочник.Номенклатура", ОбъектМетаданных.ПолноеИмя());
			
			Запрос = Новый Запрос(ТекстЗапроса);
			Запрос.УстановитьПараметр("КодМДМ", Значение);
			
			Результат = Запрос.Выполнить();
			
			Если Не Результат.Пустой() Тогда
				
				Выборка = Результат.Выбрать();
				Выборка.Следующий();
				
				Возврат Выборка.Ссылка;
				
			КонецЕсли;
			
		КонецЕсли;                
		
	Иначе
		
		Если Метаданные.Перечисления.Содержит(ОбъектМетаданных) Тогда
			Менеджер = Перечисления[ОбъектМетаданных.Имя];
		ИначеЕсли Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
			Менеджер = Справочники[ОбъектМетаданных.Имя];
		Иначе
			ВызватьИсключение "Не правильный аргумент";
		КонецЕсли;  
		
		Возврат Менеджер.ПустаяСсылка();
		
	КонецЕсли;
	
	СтрокаОшибка = СтрШаблон("Не найден объект %1 с идентификатором %2", ОбъектМетаданных.ПолноеИмя(), Значение);
	
	ВызватьИсключение СтрокаОшибка;
	
КонецФункции

