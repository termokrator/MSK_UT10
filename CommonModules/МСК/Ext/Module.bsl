Функция ЭтоМежфилиальнаяПоставка(Контрагент) Экспорт
	
	//+Сёмин Р.И. 08.06.2026 #UT10-5900
	ЭтоМежфилиальнаяПоставка = Ложь;
	
	Если ЭтоМагистраль(Контрагент) Тогда
		Возврат ЭтоМежфилиальнаяПоставка;
	КонецЕсли;
	
	Если Контрагент = Константы.ОсновнойПоставщик.Получить() Тогда
		
		ЭтоМежфилиальнаяПоставка = Истина;
		Возврат ЭтоМежфилиальнаяПоставка;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СобственныеСклады.Ссылка
		|ИЗ
		|	Справочник.СобственныеСклады КАК СобственныеСклады
		|ГДЕ
		|	СобственныеСклады.Поставщик = &Поставщик
		|	И НЕ СобственныеСклады.ПометкаУдаления
		|	И СобственныеСклады.ИсключитьИзОбщегоЭкспресса";
	
	Запрос.УстановитьПараметр("Поставщик", Контрагент);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ЭтоМежфилиальнаяПоставка = Истина;
	КонецЕсли;
	
	Возврат ЭтоМежфилиальнаяПоставка;
	//-Сёмин Р.И. 08.06.2026 #UT10-5900
	
КонецФункции

Функция НадоУчитыватьКонстантуОстаточныйСрокГодности(ДокПТУ) Экспорт
	
	//+Сёмин Р.И. 22.06.2026 #UT10-5914
	УчитыватьКонстантуОстаточныйСрокГодности = Ложь;
	
	Для Каждого Стр Из ДокПТУ.Товары Цикл
		
		Если ЗначениеЗаполнено(Стр.ЗаказПоставщику) Тогда
			
			УчитыватьКонстантуОстаточныйСрокГодности = ДокПТУ.Экспресс И ЗначениеЗаполнено(Стр.ЗаказПоставщику.IDСклада);
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат УчитыватьКонстантуОстаточныйСрокГодности;
	//-Сёмин Р.И. 22.06.2026 #UT10-5914
		
КонецФункции

Процедура ЗаполнитьОстаточныеСрокиГодностиМаркировки(КодыМаркировки, ДатаОтсчета, ДоговорКонтрагента, ДатаДокумента, УчитыватьКонстантуОстаточныйСрокГодности) Экспорт
	
	//+Сёмин Р.И. 22.06.2026 #UT10-5914
	Для Каждого Стр Из КодыМаркировки Цикл
		
		Если НЕ ЗначениеЗаполнено(Стр.СрокГодностиИзЧЗ) Тогда
			
			ПроверкаКодаЧЗ = МенеджерОборудованияМаркировка.ПроверитьСостояниеКМ(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Стр.КодМаркировки, "КодМаркировки"));
			
			Если ПроверкаКодаЧЗ.Свойство("expirationDate") Тогда
				Стр.СрокГодностиИзЧЗ = ПреобразоватьДатуМДМ(ПроверкаКодаЧЗ.expirationDate);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.СрокГодностиИзЧЗ) Тогда
			Стр.ОсталосьДнейЧЗ = (Стр.СрокГодностиИзЧЗ - ДатаОтсчета) / 60 / 60 / 24;
		КонецЕсли;
		
		СтруктураМинимальныйСрок = ПолучитьМинимальныйСрокГодностиМаркировки(
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Стр.КодМаркировки, "Номенклатура"),
			ДоговорКонтрагента,
			ДатаДокумента,
			УчитыватьКонстантуОстаточныйСрокГодности
		);
		
		Стр.НашМинимальныйСрок = СтруктураМинимальныйСрок.Срок;
		Стр.СрокНарушен = Стр.НашМинимальныйСрок > Стр.ОсталосьДнейЧЗ;
		
	КонецЦикла;
	//-Сёмин Р.И. 22.06.2026 #UT10-5914
		
КонецПроцедуры

Функция ПолучитьМинимальныйСрокГодностиМаркировки(Номенклатура, Договор = Неопределено, ДатаДокумента = Неопределено, УчитыватьКонстантуОстаточныйСрокГодности = Ложь) Экспорт
	
	//+Сёмин Р.И. 22.06.2026 #UT10-5914
	Результат = Новый Структура("Срок,Источник", 0, "");
	
	СрокГодностиТоварнаяГруппаЧЗ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура.ТоварнаяГруппаЧестногоЗнака, "ОстаточныйСрокГодности");
	СрокГодностиНоменклатурнаяГруппа = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура.НоменклатурнаяГруппа, "ОстаточныйСрокГодности");
	СрокГодностиРодитель = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура.Родитель, "ОстаточныйСрокГодности");
	СрокГодностиНоменклатура = Номенклатура.ОстаточныйСрокГодности;
	
	СрокГодностиДоговор = 0;
	
	Если ЗначениеЗаполнено(Договор) И ЗначениеЗаполнено(ДатаДокумента) Тогда
		
		Для Каждого Стр Из Договор.ОстаточныйСрокГодности Цикл
			
			Если ДатаДокумента >= Стр.НачалоПериода И ДатаДокумента <= Стр.ОкончаниеПериода Тогда
				
				Если ЗначениеЗаполнено(СрокГодностиДоговор) Тогда
					СрокГодностиДоговор = Мин(СрокГодностиДоговор, Стр.СрокВДнях);
				Иначе
					СрокГодностиДоговор = Стр.СрокВДнях;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	тзСрокиГодности = Новый ТаблицаЗначений;
	тзСрокиГодности.Колонки.Добавить("Срок");
	тзСрокиГодности.Колонки.Добавить("Источник");
	
	ДобавитьСтрокуВТЗСрокиГодности(тзСрокиГодности, СрокГодностиТоварнаяГруппаЧЗ, "ТоварнаяГруппаЧЗ");
	ДобавитьСтрокуВТЗСрокиГодности(тзСрокиГодности, СрокГодностиНоменклатурнаяГруппа, "НоменклатурнаяГруппа");
	ДобавитьСтрокуВТЗСрокиГодности(тзСрокиГодности, СрокГодностиРодитель, "Родитель");
	ДобавитьСтрокуВТЗСрокиГодности(тзСрокиГодности, СрокГодностиНоменклатура, "Номенклатура");
	ДобавитьСтрокуВТЗСрокиГодности(тзСрокиГодности, СрокГодностиДоговор, "Договор");
	
	Если УчитыватьКонстантуОстаточныйСрокГодности Тогда
		ДобавитьСтрокуВТЗСрокиГодности(тзСрокиГодности, Константы.ОстаточныйСрокГодностиДляЭкспрессовСторСкл.Получить(), "КонстантаОстаточныйСрокГодности");
	КонецЕсли;
	
	Если тзСрокиГодности.Количество() > 0 Тогда
		
		тзСрокиГодности.Сортировать("Срок");
		ЗаполнитьЗначенияСвойств(Результат, тзСрокиГодности.Получить(0));
		
	КонецЕсли;
	
	Возврат Результат;
	//-Сёмин Р.И. 22.06.2026 #UT10-5914
	
КонецФункции

Процедура ДобавитьСтрокуВТЗСрокиГодности(ТЗ, Срок, Источник)
	
	//+Сёмин Р.И. 22.06.2026 #UT10-5914
	Если ЗначениеЗаполнено(Срок) Тогда
		
		НовСтр = ТЗ.Добавить();
		НовСтр.Срок = Срок;
		НовСтр.Источник = Источник;
		
	КонецЕсли;
	//-Сёмин Р.И. 22.06.2026 #UT10-5914
	
КонецПроцедуры
