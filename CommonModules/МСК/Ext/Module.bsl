Процедура ПринятьСообщениеПоВнутреннемуОбмену(ТекстСообщения, Отказ) Экспорт
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТекстСообщения);
	СтруктураСообщений = ПрочитатьJSON(ЧтениеJSON);
	
	Если ТипЗнч(СтруктураСообщений) = Тип("Массив") Тогда
		
		Для каждого СтруктураСообщения Из СтруктураСообщений Цикл
			
			ТипОбъекта = СтруктураСообщения.ТипОбъекта;
			Объект = СтруктураСообщения.Объект;
			
			Если ТипОбъекта = "Константы" Тогда		
				
				Тип = Метаданные.Константы[Объект].Тип;
				Значение = СтруктураСообщения.Реквизиты[0][Объект];
				
				Если ТипЗнч(Значение) = Тип("Структура") Тогда
					Константы[Объект].Установить(ПолучитьОбъектПоСтруктуре(Значение));						
				Иначе
					Константы[Объект].Установить(Значение); 					
				КонецЕсли;
				
			ИначеЕсли ТипОбъекта = "РегистрыСведений" Тогда
				
				МенеджерЗаписи = РегистрыСведений[Объект].СоздатьМенеджерЗаписи();
				
				Для каждого Реквизит Из СтруктураСообщения.Реквизиты Цикл 			
					
					Для каждого Элемент Из Реквизит Цикл 
						
						Если ТипЗнч(Элемент.Значение) = Тип("Структура") Тогда
							МенеджерЗаписи[Элемент.Ключ] = ПолучитьОбъектПоСтруктуре(Элемент.Значение);						
						Иначе
							МенеджерЗаписи[Элемент.Ключ] = Элемент.Значение; 					
						КонецЕсли;
						
					КонецЦикла;      
					
				КонецЦикла;
				
				МенеджерЗаписи.Записать();
				
			ИначеЕсли ТипОбъекта = "Справочники" Тогда
				
				НовыйЭлемент = Справочники[Объект].СоздатьЭлемент();
				
				Для каждого Реквизит Из СтруктураСообщения.Реквизиты Цикл 			
					
					Для каждого Элемент Из Реквизит Цикл 
						
						Если ТипЗнч(Элемент.Значение) = Тип("Структура") Тогда
							НовыйЭлемент[Элемент.Ключ] = ПолучитьОбъектПоСтруктуре(Элемент.Значение);						
						Иначе
							НовыйЭлемент[Элемент.Ключ] = Элемент.Значение; 					
						КонецЕсли;
						
					КонецЦикла;      
					
				КонецЦикла;
				
				НовыйЭлемент.ОбменДанными.Загрузка = Истина;
				НовыйЭлемент.Записать();
				
			ИначеЕсли ТипОбъекта = "Документы" Тогда
				
				НовыйЭлемент = Документы[Объект].СоздатьДокумент();
				
				Для каждого Реквизит Из СтруктураСообщения.Реквизиты Цикл 			
					
					Для каждого Элемент Из Реквизит Цикл 
						
						Если ТипЗнч(Элемент.Значение) = Тип("Структура") Тогда
							НовыйЭлемент[Элемент.Ключ] = ПолучитьОбъектПоСтруктуре(Элемент.Значение);						
						Иначе
							НовыйЭлемент[Элемент.Ключ] = Элемент.Значение; 					
						КонецЕсли;
						
					КонецЦикла;      
					
				КонецЦикла;
				
				НовыйЭлемент.Записать(РежимЗаписиДокумента.Запись);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	
КонецПроцедуры

Функция ПолучитьОбъектПоСтруктуре(СтруктураЗначения)
	
	Значение = СтруктураЗначения.Значение;
	ТипОбъекта = СтруктураЗначения.ТипОбъекта;
	Объект = СтруктураЗначения.Объект;
	
	Если ТипОбъекта = "Перечисление" Тогда
		Возврат Перечисления[Объект][Значение];
	ИначеЕсли ТипОбъекта = "Справочник" Тогда
		Возврат Справочники[Объект].ПолучитьСсылку(Новый УникальныйИдентификатор(Значение)); 
	ИначеЕсли ТипОбъекта = "Документ" Тогда
		Возврат Документы[Объект].ПолучитьСсылку(Новый УникальныйИдентификатор(Значение));
	ИначеЕсли ТипОбъекта = "ПланОбмена" Тогда
		Возврат ПланыОбмена[Объект].ПолучитьСсылку(Новый УникальныйИдентификатор(Значение));
	ИначеЕсли ТипОбъекта = "ПланВидовХарактеристик" Тогда
		Возврат ПланыВидовХарактеристик[Объект].ПолучитьСсылку(Новый УникальныйИдентификатор(Значение));
	КонецЕсли;
	
КонецФункции

Функция ЭтоСсылочныйТип(Тип)
	
