Функция СкорректироватьТоварЗаказаСервер(СтрокаJSON) Экспорт 
	
	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("HTTP-сервис OnlineStore.order_goods_update.СкорректироватьТоварЗаказа", УровеньЖурналаРегистрации.Информация,,, "HTTP-сервис:Запуск. СкорректироватьТоварЗаказаСервер");
	
	ПараметрыСтруктура 	= ОбщегоНазначения.ВернутьСтруктуруИзJSON(СтрокаJSON);
	
	СтруктураВозврата = ВыполнитьКорректировкуТовараЗаказа(ПараметрыСтруктура);
	
	ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("HTTP-сервис OnlineStore.order_goods_update.СкорректироватьТоварЗаказа", УровеньЖурналаРегистрации.Информация,,, 
	"HTTP-сервис:Завершение. СкорректироватьТоварЗаказаСервер. " + Формат(ВремяОкончанияUTC - ВремяНачалаUTC, "ЧН=0; ЧГ=0") + " м.сек." + " Запрос:" + Символы.ПС + СтрокаJSON);
		
	Возврат СтруктураВозврата;
	
КонецФункции 

Функция ВыполнитьКорректировкуТовараЗаказа(ПараметрыЗапроса) Экспорт 
	
	СтруктураВозврата = Новый Структура("Результат, Сообщение, КодОтвета", Ложь, "", 200);               
	
	МассивСтатусовПроверки = Новый Массив;     
	МассивСтатусовПроверки.Добавить("Заказан");
	МассивСтатусовПроверки.Добавить("Заказано поставщику");
	МассивСтатусовПроверки.Добавить("Зарезервирован");	
	МассивСтатусовПроверки.Добавить("На подборе");
	МассивСтатусовПроверки.Добавить("Готов к отгрузке");	
	
	ИдентификаторЗаказа = ПараметрыЗапроса.ИдентификаторЗаказа;   
	КодМДМНоменклатуры 	= ПараметрыЗапроса.КодМДМНоменклатуры; 
	ИдентификаторЗапроса = ПараметрыЗапроса.ИдентификаторЗапроса;
	Количество = Число(ПараметрыЗапроса.Количество);        
	Статус = ПараметрыЗапроса.Статус;  
	
	Если МассивСтатусовПроверки.Найти(Статус) = Неопределено Тогда
		
		СтруктураВозврата.Сообщение = "Запрещено изменять количество для товара со статусом: " + Статус;	
		Возврат СтруктураВозврата;
		
	КонецЕсли;

	Заказ = Документы.ЗаказПокупателя.ПолучитьСсылку(Новый УникальныйИдентификатор(ИдентификаторЗаказа));
	
	Если Заказ.ПолучитьОбъект() = Неопределено Тогда
   		
		СтруктураВозврата.Сообщение = "Не найден заказ клиента с ID: " + Строка(ИдентификаторЗаказа);	
		Возврат СтруктураВозврата;
		
	КонецЕсли;    
	
	Номенклатура = Справочники.Номенклатура.НайтиПоРеквизиту("КодМДМ", КодМДМНоменклатуры);
	
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		
		СтруктураВозврата.Сообщение = "Не найдена Номенклатура с кодом МДМ: " + Строка(КодМДМНоменклатуры);
		Возврат СтруктураВозврата;
		
	КонецЕсли;   
	
	ЭтоСтороннийСклад = ЗначениеЗаполнено(Заказ.IDСклада_СтороннийСклад); 
	
	Если ЭтоСтороннийСклад И Статус <> "Заказан" Тогда
		
		СтруктураВозврата.Сообщение = "Для сторонних складов изменять количество можно только из статуса Заказан" ;
		Возврат СтруктураВозврата;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗапросыИзмененияКоличестваВЗаказахНовые.Заказ
	|ИЗ
	|	РегистрСведений.ЗапросыИзмененияКоличестваВЗаказахНовые КАК ЗапросыИзмененияКоличестваВЗаказахНовые
	|ГДЕ
	|	ЗапросыИзмененияКоличестваВЗаказахНовые.Идентификатор = &Идентификатор
	|	И ЗапросыИзмененияКоличестваВЗаказахНовые.Номенклатура = &Номенклатура
	|	И ЗапросыИзмененияКоличестваВЗаказахНовые.Заказ = &Заказ";
	
	Запрос.УстановитьПараметр("Идентификатор", ИдентификаторЗапроса);
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	Выборка = Запрос.Выполнить().Выбрать();  
	
	Если Выборка.Следующий() Тогда
		
		СтруктураВозврата.Сообщение = "Уже найден запрос изменения с идентификатором: " + Строка(ИдентификаторЗапроса);
		Возврат СтруктураВозврата;
		
	КонецЕсли;
	
	МассивЗаказов = Новый Массив; 
	МассивЗаказов.Добавить(Заказ);  
	
	Попытка
		СтруктураРезультата = МодульИнтеграцииСПорталом.ПолучитьДанныеПоЗаказамСервер(Новый Структура("ДетальнаяИнформация", "1"), МассивЗаказов);	
	Исключение
		
		СтруктураВозврата.Сообщение = "Возникла ошибка при получении статусов по заказу: " + ОписаниеОшибки();
		Возврат СтруктураВозврата;
		
	КонецПопытки;
	
	Если СтруктураРезультата.Результат Тогда
		
		Данные = СтруктураРезультата.Данные; 
		
		Если Данные.Количество() > 0 Тогда
			
			ЗаказСтруктура = Данные[0]; 
			ТоварыТаблица = ОбщегоНазначения.ПреобразоватьМассивВТаблицуЗначений(ЗаказСтруктура.Товары);
			
			СтрокиПоиска = ТоварыТаблица.НайтиСтроки(Новый Структура("Статус, НомерНоменклатуры", Статус, Номенклатура.Код));   
			
			Если СтрокиПоиска.Количество() > 0 Тогда
				
				КоличествоПоСтатусу = СтрокиПоиска[0].Количество;
				
				Если КоличествоПоСтатусу < Количество Тогда
					
					СтруктураВозврата.Сообщение = "Количество товара по статусу " + Строка(Статус) + " в заказе меньше количества на уменьшение: " + Строка(КоличествоПоСтатусу) + " < " + Строка(Количество);  
					СтруктураВозврата.КодОтвета = 406;   
					
				Иначе    
					
					Менеджер = РегистрыСведений.ЗапросыИзмененияКоличестваВЗаказахНовые.СоздатьМенеджерЗаписи();
					Менеджер.Заказ = Заказ;
					Менеджер.Номенклатура = Номенклатура;
					Менеджер.Идентификатор = ИдентификаторЗапроса; 
					Менеджер.Количество = Количество; 
					Менеджер.ДатаСоздания = ТекущаяДата();
					Менеджер.СтатусТовара = Статус; 
					
					Если Заказ.ОбособленнаяОтгрузкаГМИзСтороннегоФилиала И (Статус <> "Готов к отгрузке" И Статус <> "Заказан") Тогда
						
						Менеджер.Статус = Перечисления.СтатусыЗапросовИзмененияКоличестваВЗаказах.Обрабатывается;
						Менеджер.ОжидаемыеСтатусы = "Готов к отгрузке";
						Менеджер.КомментарийОбработки = "Ожидаем готовности к отгрузке для отмены";
						
					Иначе						
						Менеджер.Статус = Перечисления.СтатусыЗапросовИзмененияКоличестваВЗаказах.Новый;					
					КонецЕсли;					
					
					Менеджер.Записать(Истина); 
					
					СтруктураВозврата.Результат = Истина;
					СтруктураВозврата.Сообщение = "Запрос на изменение количества успешно добавлен в очередь обработки";
				
				КонецЕсли;
				
			Иначе
				
				СтруктураВозврата.Сообщение = "Не найдены товар в заказе со статусом: " + Строка(Статус);  
				СтруктураВозврата.КодОтвета = 406;

			КонецЕсли;
			
		Иначе
			
			СтруктураВозврата.Сообщение = "Была полученая пустая таблица данных по заказу";
			Возврат СтруктураВозврата;	
			
		КонецЕсли;
		
	Иначе
		
		СтруктураВозврата.Сообщение = "Возникла ошибка при получении статусов по заказу: " + СтруктураРезультата.Сообщение;
		Возврат СтруктураВозврата;		
		
	КонецЕсли;
	
	Возврат СтруктураВозврата;
		
КонецФункции 

Процедура ОбработатьЗапросыИзмененияКоличестваВЗаказах() Экспорт
	
	МассивСтатусов = Новый Массив;  
	МассивСтатусов.Добавить(Перечисления.СтатусыЗапросовИзмененияКоличестваВЗаказах.Новый);
	МассивСтатусов.Добавить(Перечисления.СтатусыЗапросовИзмененияКоличестваВЗаказах.Обрабатывается);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗапросыИзмененияКоличестваВЗаказахНовые.Заказ КАК Заказ,
	|	ЗапросыИзмененияКоличестваВЗаказахНовые.Номенклатура,
	|	ЗапросыИзмененияКоличестваВЗаказахНовые.Идентификатор,
	|	ЗапросыИзмененияКоличестваВЗаказахНовые.Количество,
	|	ЗапросыИзмененияКоличестваВЗаказахНовые.Статус,
	|	ЗапросыИзмененияКоличестваВЗаказахНовые.ДатаСоздания,
	|	ЗапросыИзмененияКоличестваВЗаказахНовые.ДатаОбработки,
	|	ЗапросыИзмененияКоличестваВЗаказахНовые.Комментарий,
	|	ЗапросыИзмененияКоличестваВЗаказахНовые.СвязанныйДокумент,
	|	ЗапросыИзмененияКоличестваВЗаказахНовые.СтатусТовара,
	|	ЗапросыИзмененияКоличестваВЗаказахНовые.ОжидаемыеСтатусы
	|ИЗ
	|	РегистрСведений.ЗапросыИзмененияКоличестваВЗаказахНовые КАК ЗапросыИзмененияКоличестваВЗаказахНовые
	|ГДЕ
	|	ЗапросыИзмененияКоличестваВЗаказахНовые.Статус В(&МассивСтатусов)
	|	И НЕ ЗапросыИзмененияКоличестваВЗаказахНовые.Заказ.ПометкаУдаления
	|ИТОГИ ПО
	|	Заказ";
	
	Запрос.УстановитьПараметр("МассивСтатусов", МассивСтатусов);  
	
	ВыборкаЗаказы = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаЗаказы.Следующий() Цикл 		
		
		Заказ = ВыборкаЗаказы.Заказ;
		
		МассивЗаказов = Новый Массив; 
		МассивЗаказов.Добавить(Заказ);  
		
		Попытка
			СтруктураРезультата = МодульИнтеграцииСПорталом.ПолучитьДанныеПоЗаказамСервер(Новый Структура("ДетальнаяИнформация", "1"), МассивЗаказов);	
		Исключение
			
			ЗаписьЖурналаРегистрации("Изменения количества товаров в заказах новое", УровеньЖурналаРегистрации.Ошибка, , , "Возникла ошибка при получении статусов по заказу " + Строка(Заказ) + ": " + ОписаниеОшибки());     
			Продолжить;
			
		КонецПопытки;  
		
		Если СтруктураРезультата.Результат И СтруктураРезультата.Данные.Количество() > 0 Тогда
			
			ЗаказСтруктура = СтруктураРезультата.Данные[0]; 
			ТоварыТаблица = ОбщегоНазначения.ПреобразоватьМассивВТаблицуЗначений(ЗаказСтруктура.Товары);     
					
			Выборка = ВыборкаЗаказы.Выбрать();  
			
			Пока Выборка.Следующий() Цикл   
				
				ЖдемСтатус = Ложь;
				
				Количество = Выборка.Количество;    
				Номенклатура = Выборка.Номенклатура;
				Идентификатор = Выборка.Идентификатор;
				
				Если Выборка.Статус = Перечисления.СтатусыЗапросовИзмененияКоличестваВЗаказах.Обрабатывается Тогда
					
					Если ЗначениеЗаполнено(Выборка.ОжидаемыеСтатусы) Тогда 
						
						СтатусТовара = Выборка.ОжидаемыеСтатусы;     
						ЖдемСтатус = Истина;
						
					Иначе
						//Обработка таких записей происходит по подписке
						Продолжить;
					КонецЕсли;   
					
				Иначе
					СтатусТовара = Выборка.СтатусТовара;						
				КонецЕсли;                                  				
				
				СтрокиПоиска = ТоварыТаблица.НайтиСтроки(Новый Структура("Статус, НомерНоменклатуры", СтатусТовара, Выборка.Номенклатура.Код));  
				
				Если СтрокиПоиска.Количество() > 0 Тогда
					
					КоличествоПоСтатусу = СтрокиПоиска[0].Количество;
					
					Если КоличествоПоСтатусу < Количество Тогда
						
						Если Не ЖдемСтатус Тогда
							
							ДопПараметры = Новый Структура("ДатаОбработки, Комментарий", ТекущаяДата(), "Количество товара по статусу " + Строка(СтатусТовара) + " в заказе меньше количества на уменьшение: " + Строка(КоличествоПоСтатусу) + " < " + Строка(Количество));
							РегистрыСведений.ЗапросыИзмененияКоличестваВЗаказахНовые.ИзменитьСтатусЗапроса(Заказ, Номенклатура, Идентификатор, Перечисления.СтатусыЗапросовИзмененияКоличестваВЗаказах.Отменен, ДопПараметры); 
						
						КонецЕсли; 
						
					Иначе
						//Запускаем процесс обработки запроса
						
						Попытка
							ОбработатьЗапросИзмененияКоличества(Выборка, СтатусТовара);	
						Исключение
							ЗаписьЖурналаРегистрации("Изменения количества товаров в заказах новое", УровеньЖурналаРегистрации.Ошибка, , , "Возникла ошибка при обработке запроса по заказу " + Строка(Заказ) + " товар " + Строка(Номенклатура) + ": " + ОписаниеОшибки());     			
						КонецПопытки;						
						
					КонецЕсли;
					
				Иначе
					
					Если Не ЖдемСтатус Тогда
						
						ДопПараметры = Новый Структура("ДатаОбработки, Комментарий", ТекущаяДата(), "Не найдены товар в заказе со статусом: " + Строка(СтатусТовара));
						РегистрыСведений.ЗапросыИзмененияКоличестваВЗаказахНовые.ИзменитьСтатусЗапроса(Заказ, Номенклатура, Идентификатор, Перечисления.СтатусыЗапросовИзмененияКоличестваВЗаказах.Отменен, ДопПараметры); 						
						
					КонецЕсли; 				
					
				КонецЕсли;				
				
			КонецЦикла;
			
		Иначе
			ЗаписьЖурналаРегистрации("Изменения количества товаров в заказах новое", УровеньЖурналаРегистрации.Ошибка, , , "Не удалось получить данные по заказу " + Строка(Заказ));     			
		КонецЕсли;	
		
	КонецЦикла;  
	
КонецПроцедуры   

Процедура ОбработатьЗапросИзмененияКоличества(Выборка, СтатусТовара)
	
	Если СтатусТовара = "Заказан" ИЛИ СтатусТовара = "Зарезервирован" Тогда  
		
		ТаблицаТоваров = ПолучитьПустуюТаблицаТоваровКорректировкиЗаказа();  
		
		НСтр = ТаблицаТоваров.Добавить();
		НСтр.Номенклатура = Выборка.Номенклатура;
		НСтр.Количество = Выборка.Количество * -1;
		
		Корректировка = СоздатьКорректировкуЗаказаПокупателяПоТаблицеТоваров(Выборка.Заказ, Истина, ТаблицаТоваров, ?(СтатусТовара = "Зарезервирован", Истина, Ложь), Перечисления.ПричиныКорректировкиСборки.ОтказКлиента);
		
		Если ЗначениеЗаполнено(Корректировка) Тогда
			
			ДопПараметры = Новый Структура("ДатаОбработки, КомментарийОбработки", ТекущаяДата(), "Успешно создан документ корректировки заказа: " + Строка(Корректировка));
			РегистрыСведений.ЗапросыИзмененияКоличестваВЗаказахНовые.ИзменитьСтатусЗапроса(Выборка.Заказ, Выборка.Номенклатура, Выборка.Идентификатор, Перечисления.СтатусыЗапросовИзмененияКоличестваВЗаказах.Выполнен, ДопПараметры);
			
		КонецЕсли; 	
		
	ИначеЕсли СтатусТовара = "Заказано поставщику" Тогда 
		СкорректироватьПоСтатусуЗаказаноПоставщику(Выборка);	
	ИначеЕсли СтатусТовара = "На подборе" Тогда
		СкорректироватьПоСтатусуНаПодборе(Выборка);	
	ИначеЕсли СтатусТовара = "Готов к отгрузке" Тогда
		СкорректироватьПоСтатусуГотовКОтгрузке(Выборка);	
	КонецЕсли;
		
КонецПроцедуры

Процедура СкорректироватьПоСтатусуЗаказаноПоставщику(Выборка)
	
	ТаблицаТоваровКорректировкаЗаказаПоставщику = ПолучитьПустуюТаблицаТоваровКорректировкиЗаказаПоставщику(); 
	
	НСтр = ТаблицаТоваровКорректировкаЗаказаПоставщику.Добавить();
	НСтр.Номенклатура = Выборка.Номенклатура;
	НСтр.Количество = Выборка.Количество * -1;     
	
	ТаблицаТоваров = ПолучитьПустуюТаблицаТоваровКорректировкиЗаказа();
	
	НСтр = ТаблицаТоваров.Добавить();
	НСтр.Номенклатура = Выборка.Номенклатура;
	НСтр.Количество = Выборка.Количество * -1;
	
	Попытка			
		
		НачатьТранзакцию();
		
		КорректировкаЗаказаПоставщику = СоздатьКорректировкуЗаказаПоставщикуПоТаблицеТоваров(ПолучитьЗаказПоставщикуПоЗаказуИТовару(Выборка.Заказ, Выборка.Номенклатура), Истина, ТаблицаТоваровКорректировкаЗаказаПоставщику, Истина);
		
		Если ЗначениеЗаполнено(КорректировкаЗаказаПоставщику) Тогда				
			
			Корректировка = СоздатьКорректировкуЗаказаПокупателяПоТаблицеТоваров(Выборка.Заказ, Истина, ТаблицаТоваров, Ложь);   
			
			Если ЗначениеЗаполнено(Корректировка) Тогда   
				
				ДопПараметры = Новый Структура("ДатаОбработки, КомментарийОбработки", ТекущаяДата(), "Успешно создан документ корректировки заказа поставщику: " + Строка(КорректировкаЗаказаПоставщику) + Символы.ПС + "Успешно создан документ корректировки заказа: " + Строка(Корректировка));
				РегистрыСведений.ЗапросыИзмененияКоличестваВЗаказахНовые.ИзменитьСтатусЗапроса(Выборка.Заказ, Выборка.Номенклатура, Выборка.Идентификатор, Перечисления.СтатусыЗапросовИзмененияКоличестваВЗаказах.Выполнен, ДопПараметры);
				
				ЗафиксироватьТранзакцию();
				
			Иначе
				ВызватьИсключение("Не удалось создать корректировку заказа");	
			КонецЕсли;
			
		Иначе
			ВызватьИсключение("Не удалось создать корректировку заказа поставщику");
		КонецЕсли;
		
	Исключение               
		
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации("Изменения количества товаров в заказах новое", УровеньЖурналаРегистрации.Ошибка, , , "Не удалось создать документы по заказу: " + Строка(Выборка.Заказ) + " " + ОписаниеОшибки());     			
		
	КонецПопытки; 
		
КонецПроцедуры

Процедура СкорректироватьПоСтатусуНаПодборе(Выборка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТоварыВСборкеОстатки.Номенклатура,
	|	ТоварыВСборкеОстатки.ЗаказПокупателя,
	|	ТоварыВСборкеОстатки.Сборка,
	|	ТоварыВСборкеОстатки.КСборкеОстаток
	|ПОМЕСТИТЬ ТаблицаРезультат
	|ИЗ
	|	РегистрНакопления.ТоварыВСборке.Остатки(
	|			,
	|			ЗаказПокупателя = &Заказ
	|				И Номенклатура = &Номенклатура) КАК ТоварыВСборкеОстатки
	|ГДЕ
	|	ТоварыВСборкеОстатки.СобраноОстаток = 0
	|	И НЕ ТоварыВСборкеОстатки.КСборкеОстаток = 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаРезультат.ЗаказПокупателя,
	|	ТаблицаРезультат.Номенклатура,
	|	ТаблицаРезультат.Сборка,
	|	ТаблицаРезультат.КСборкеОстаток,
	|	НапечатанныеДокументы.ДатаПечати КАК Распечатан
	|ИЗ
	|	ТаблицаРезультат КАК ТаблицаРезультат
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НапечатанныеДокументы КАК НапечатанныеДокументы
	|		ПО ТаблицаРезультат.Сборка = НапечатанныеДокументы.Документ
	|ГДЕ
	|	НапечатанныеДокументы.ДатаПечати ЕСТЬ NULL
	|	И НЕ ТаблицаРезультат.ЗаказПокупателя ЕСТЬ NULL";  
	
	Запрос.УстановитьПараметр("Заказ", Выборка.Заказ); 
	Запрос.УстановитьПараметр("Номенклатура", Выборка.Номенклатура);
	
	ВыборкаСборок = Запрос.Выполнить().Выбрать(); 
	
	Если ВыборкаСборок.Следующий() И ВыборкаСборок.КСборкеОстаток >= Выборка.Количество Тогда
				
		КорректировкаСборки = СоздатьКорректировкуСборки(ВыборкаСборок.Сборка, ВыборкаСборок.ЗаказПокупателя, ВыборкаСборок.Номенклатура, Выборка.Количество);
		
		ДопПараметры = Новый Структура("ДатаОбработки, КомментарийОбработки", ТекущаяДата(), "Успешно создан документ корректировки сборки: " + Строка(КорректировкаСборки));
		РегистрыСведений.ЗапросыИзмененияКоличестваВЗаказахНовые.ИзменитьСтатусЗапроса(Выборка.Заказ, Выборка.Номенклатура, Выборка.Идентификатор, Перечисления.СтатусыЗапросовИзмененияКоличестваВЗаказах.Выполнен, ДопПараметры);	
		
	Иначе
		
		ДопПараметры = Новый Структура("ДатаОбработки, КомментарийОбработки", ТекущаяДата(), "Не удалось скорректировать количество по запросу. Заказ уже находится в сборке");
		РегистрыСведений.ЗапросыИзмененияКоличестваВЗаказахНовые.ИзменитьСтатусЗапроса(Выборка.Заказ, Выборка.Номенклатура, Выборка.Идентификатор, Перечисления.СтатусыЗапросовИзмененияКоличестваВЗаказах.Отменен, ДопПараметры);	

	КонецЕсли;
		
КонецПроцедуры

Процедура СкорректироватьПоСтатусуГотовКОтгрузке(Выборка)
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОстаткиПоЗаданиям.ЗаданиеНаСборку КАК ЗаданиеНаСборку,
		|	СУММА(ОстаткиПоЗаданиям.КоличествоОборот) КАК КоличествоОборот
		|ПОМЕСТИТЬ УжеВезем
		|ИЗ
		|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		ЗаданиеНаДоставкуОбороты.ЗаданиеНаСборку КАК ЗаданиеНаСборку,
		|		СУММА(ЗаданиеНаДоставкуОбороты.КоличествоОборот) КАК КоличествоОборот
		|	ИЗ
		|		РегистрНакопления.ЗаданиеНаДоставку.Обороты(&Д1, &Д2, Регистратор, ЗаданиеНаСборку.Заказано.Заказ = &Заказ) КАК ЗаданиеНаДоставкуОбороты
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ЗаданиеНаДоставкуОбороты.ЗаданиеНаСборку) КАК ОстаткиПоЗаданиям
		|ГДЕ
		|	НЕ ОстаткиПоЗаданиям.КоличествоОборот = 0
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиПоЗаданиям.ЗаданиеНаСборку
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТоварыВСборкеОстатки.Номенклатура,
		|	ТоварыВСборкеОстатки.ЗаказПокупателя,
		|	ТоварыВСборкеОстатки.Сборка,
		|	ТоварыВСборкеОстатки.СобраноОстаток
		|ПОМЕСТИТЬ ТаблицаРезультат
		|ИЗ
		|	РегистрНакопления.ТоварыВСборке.Остатки(
		|			,
		|			ЗаказПокупателя = &Заказ
		|				И Номенклатура = &Номенклатура) КАК ТоварыВСборкеОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ УжеВезем КАК УжеВезем
		|		ПО ТоварыВСборкеОстатки.Сборка = УжеВезем.ЗаданиеНаСборку
		|ГДЕ
		|	ТоварыВСборкеОстатки.Сборка.ДокументСобранИУпакован
		|	И УжеВезем.ЗаданиеНаСборку ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ГрузовоеМестоТовары.Ссылка КАК ГрузовоеМесто,
		|	ГрузовоеМестоТовары.Количество,
		|	ТаблицаРезультат.Сборка
		|ИЗ
		|	ТаблицаРезультат КАК ТаблицаРезультат
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ГрузовоеМесто.Товары КАК ГрузовоеМестоТовары
		|		ПО ТаблицаРезультат.Номенклатура = ГрузовоеМестоТовары.Номенклатура
		|			И ТаблицаРезультат.ЗаказПокупателя = ГрузовоеМестоТовары.Заказ
		|ГДЕ
		|	ГрузовоеМестоТовары.Ссылка.Проведен
		|	И НЕ ГрузовоеМестоТовары.Ссылка.Погружено
		|	И НЕ ГрузовоеМестоТовары.Ссылка.Неактуально_КорректировкаСборки
		|	И ГрузовоеМестоТовары.Заказ = &Заказ
		|	И ГрузовоеМестоТовары.Номенклатура = &Номенклатура";
		
		Запрос.УстановитьПараметр("Заказ", Выборка.Заказ); 
		Запрос.УстановитьПараметр("Номенклатура", Выборка.Номенклатура); 
		Запрос.УстановитьПараметр("Д1", ТекущаяДата() - 86400*14);
		Запрос.УстановитьПараметр("Д2", ТекущаяДата());
		
		ВыборкаГМ = Запрос.Выполнить().Выбрать(); 
		
		МассивСозданныхКорректировок = Новый Массив;
		
		КоличествоСкорректировать = Выборка.Количество;
		
		Пока ВыборкаГМ.Следующий() Цикл
			
			Если КоличествоСкорректировать <= 0 Тогда
				Прервать;
			КонецЕсли;
			
			КоличествоТекущегоСписания = 0;
			
			Если КоличествоСкорректировать > ВыборкаГМ.Количество Тогда
				
				КоличествоТекущегоСписания = ВыборкаГМ.Количество;
				КоличествоСкорректировать = КоличествоСкорректировать - КоличествоТекущегоСписания;
				
			Иначе			
				
				КоличествоТекущегоСписания = КоличествоСкорректировать;
				КоличествоСкорректировать = 0;
				
			КонецЕсли; 
			
			НачатьТранзакцию();
			
			КорректировкаГМ = СоздатьКорректировкуГрузоместа(ВыборкаГМ.ГрузовоеМесто, Выборка.Заказ, Выборка.Номенклатура, КоличествоТекущегоСписания);
			
			МассивСозданныхКорректировок.Добавить(КорректировкаГМ);
			
		КонецЦикла;
		
		Если КоличествоСкорректировать = 0 Тогда
			
			КомментарийОбработки = "";
			
			Для каждого Корр Из МассивСозданныхКорректировок Цикл
				КомментарийОбработки = КомментарийОбработки + ?(ЗначениеЗаполнено(КомментарийОбработки), Символы.ПС, "") + "Успешно создан документ корректировки ГМ: " + Строка(Корр);	
			КонецЦикла;
			
			ДопПараметры = Новый Структура("ДатаОбработки, КомментарийОбработки", ТекущаяДата(), КомментарийОбработки);
			РегистрыСведений.ЗапросыИзмененияКоличестваВЗаказахНовые.ИзменитьСтатусЗапроса(Выборка.Заказ, Выборка.Номенклатура, Выборка.Идентификатор, Перечисления.СтатусыЗапросовИзмененияКоличестваВЗаказах.Выполнен, ДопПараметры);
			
			ЗафиксироватьТранзакцию();
			
		Иначе
			
			//Отменяем созданные документы корректирвоки, если они были
			Если ТранзакцияАктивна() Тогда			
				ОтменитьТранзакцию();
			КонецЕсли;	
			
			//Не удалось значит скорректировать все количество, отменяем запрос	
			ДопПараметры = Новый Структура("ДатаОбработки, КомментарийОбработки", ТекущаяДата(), "Не удалось скорректироваь все количество по запросу");
			РегистрыСведений.ЗапросыИзмененияКоличестваВЗаказахНовые.ИзменитьСтатусЗапроса(Выборка.Заказ, Выборка.Номенклатура, Выборка.Идентификатор, Перечисления.СтатусыЗапросовИзмененияКоличестваВЗаказах.Отменен, ДопПараметры);	
			
		КонецЕсли;
		
КонецПроцедуры

Функция ПолучитьЗаказПоставщикуПоЗаказуИТовару(Заказ, Номенклатура)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РазмещениеЗаказовПокупателейОстатки.ЗаказПоставщику
	|ИЗ
	|	РегистрНакопления.РазмещениеЗаказовПокупателей.Остатки(
	|			,
	|			ЗаказПокупателя = &Заказ
	|				И Номенклатура = &Номенклатура) КАК РазмещениеЗаказовПокупателейОстатки";
	
	Запрос.УстановитьПараметр("Заказ", Заказ);  
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);  
	
	Выборка = Запрос.Выполнить().Выбрать(); 
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ЗаказПоставщику;
	КонецЕсли;                          
	
	Возврат Неопределено;	
	
КонецФункции

Функция ПолучитьПустуюТаблицаТоваровКорректировкиЗаказа()
	
	ТаблицаТоваров = Новый ТаблицаЗначений;  
	ТаблицаТоваров.Колонки.Добавить("Номенклатура"); 
	ТаблицаТоваров.Колонки.Добавить("СерияНоменклатуры");
	ТаблицаТоваров.Колонки.Добавить("Размещение"); 
	ТаблицаТоваров.Колонки.Добавить("Количество");
	
	Возврат ТаблицаТоваров;
	
КонецФункции 

Функция ПолучитьПустуюТаблицаТоваровКорректировкиЗаказаПоставщику()
	
	ТаблицаТоваров = Новый ТаблицаЗначений;  
	ТаблицаТоваров.Колонки.Добавить("Номенклатура"); 
	ТаблицаТоваров.Колонки.Добавить("Количество");
	
	Возврат ТаблицаТоваров;
	
КонецФункции

Функция СоздатьКорректировкуЗаказаПокупателяПоТаблицеТоваров(Заказ, Проведение, ТаблицаТоваров, ПоОстаткам = Ложь, Причина = Неопределено) 
	
	НовыйДок = Документы.КорректировкаЗаказаПокупателя.СоздатьДокумент();
	
	НовыйДок.Дата = ТекущаяДата();
	НовыйДок.ЗаказПокупателя = Заказ;
	НовыйДок.Заполнить(Заказ);
	НовыйДок.Комментарий = "Корректировка по запросу с портала";
	
	ТабЧастьТовары = НовыйДок.Товары;
	
	Если Не ПоОстаткам Тогда
			
		ТабЧастьТовары.Очистить();
		
		Для Каждого СтрокаТовары Из ТаблицаТоваров Цикл 
			
			НоваяСтрока = ТабЧастьТовары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТовары);
			НоваяСтрока.Причина = Перечисления.ПричиныКорректировкиСборки.ОтказКлиента;
			НоваяСтрока.ОтказПоставщика = Справочники.ПричиныЗакрытияЗаказов.ОтказПокупателя;     		
						
		КонецЦикла;          	
		
	Иначе          
		
		МассивУдаления = Новый Массив;
		
		Для каждого Стр Из ТаблицаТоваров Цикл   			
			
			СтрокиПоиска = ТабЧастьТовары.НайтиСтроки(Новый Структура("Номенклатура", Стр.Номенклатура));
			
			Для каждого СтрПоиска Из СтрокиПоиска Цикл
				
				Если Стр.Количество = 0 Тогда 
					
					МассивУдаления.Добавить(СтрПоиска);	    
					Продолжить;
					
				КонецЕсли;
				
				//-5, а в отмене -3
				Если СтрПоиска.Количество <= Стр.Количество Тогда
					
					СтрПоиска.Количество = Стр.Количество; 
					Стр.Количество = 0;	
					
				//-1, а в отмене -4
				ИначеЕсли СтрПоиска.Количество > Стр.Количество Тогда 				
					Стр.Количество = Стр.Количество - СтрПоиска.Количество;										
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;  
		
		//+Марков И. 29.07.2026 #UT10-5964
		Для Каждого Стр Из ТабЧастьТовары Цикл
			
			СтрокиПоиска = ТаблицаТоваров.НайтиСтроки(Новый Структура("Номенклатура", Стр.Номенклатура));
			
			Если СтрокиПоиска.Количество() = 0 И МассивУдаления.Найти(Стр) = Неопределено Тогда
				МассивУдаления.Добавить(Стр);	    
			КонецЕсли;	
			
		КонецЦикла;
		//-Марков И. 29.07.2026 #UT10-5964
		
		Для каждого СтрУдаления Из МассивУдаления Цикл
			ТабЧастьТовары.Удалить(СтрУдаления);	
		КонецЦикла;
		
	КонецЕсли;     
	
	Для Каждого СтрокаТовары Из ТабЧастьТовары Цикл 
		
		Если ЗначениеЗаполнено(Причина) Тогда
			СтрокаТовары.Причина = Причина;
		КонецЕсли;
		
		// Получаем среднюю цену закупки
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказПокупателяТовары.Номенклатура,
		|	СУММА(ЗаказПокупателяТовары.Количество * ЗаказПокупателяТовары.Цена) КАК СуммаПодсчит,
		|	СУММА(ЗаказПокупателяТовары.Количество) КАК Количество,
		|	ЗаказПокупателяТовары.ЕдиницаИзмерения,
		|	ЗаказПокупателяТовары.ЕдиницаИзмеренияМест,
		|	ЗаказПокупателяТовары.Коэффициент
		|ИЗ
		|	Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары
		|ГДЕ
		|	ЗаказПокупателяТовары.Ссылка = &Ссылка
		|	И ЗаказПокупателяТовары.Номенклатура = &Номенклатура
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказПокупателяТовары.Номенклатура,
		|	ЗаказПокупателяТовары.ЕдиницаИзмерения,
		|	ЗаказПокупателяТовары.ЕдиницаИзмеренияМест,
		|	ЗаказПокупателяТовары.Коэффициент";
		
		Запрос.УстановитьПараметр("Ссылка", Заказ);
		Запрос.УстановитьПараметр("Номенклатура", СтрокаТовары.Номенклатура);	
		
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаЗапроса = РезультатЗапроса.Выбрать();
		
		ЕдиницаИзмерения = СтрокаТовары.Номенклатура.ЕдиницаХраненияОстатков;
		ЕдиницаИзмеренияМест = Справочники.ЕдиницыИзмерения.ПустаяСсылка();
		Коэф = 1;
		
		Пока ВыборкаЗапроса.Следующий() Цикл
			
			ЦенаЗакупкиЗаЕдиницу = Окр(ВыборкаЗапроса.СуммаПодсчит / ВыборкаЗапроса.Количество, 2, 1);  
			ЕдиницаИзмерения = ВыборкаЗапроса.ЕдиницаИзмерения;
			ЕдиницаИзмеренияМест = ВыборкаЗапроса.ЕдиницаИзмеренияМест;
			Коэф = ВыборкаЗапроса.Коэффициент;
			
		КонецЦикла;	 			
		
		СтрокаТовары.ЕдиницаИзмерения = ЕдиницаИзмерения;
		СтрокаТовары.ЕдиницаИзмеренияМест = ЕдиницаИзмеренияМест;
		СтрокаТовары.Коэффициент = Коэф;
		
		СтрокаТовары.Цена = ЦенаЗакупкиЗаЕдиницу;
		
		ОбработкаТабличныхЧастей.ЗаполнитьСтавкуНДСТабЧасти(СтрокаТовары, НовыйДок);
		ОбработкаТабличныхЧастей.РассчитатьКоличествоМестТабЧасти(СтрокаТовары, НовыйДок);
		ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(СтрокаТовары, НовыйДок);
		ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(СтрокаТовары, НовыйДок);
		
	КонецЦикла;
	
	Попытка 	
		НовыйДок.Записать(РежимЗаписиДокумента.Проведение);				
	Исключение    
		
		#Если Клиент Тогда
			Сообщить(ОписаниеОшибки());
		#Иначе
			ЗаписьЖурналаРегистрации("Создание корректировки Заказа покупателя", УровеньЖурналаРегистрации.Ошибка,,, ОписаниеОшибки());
		#КонецЕсли	 
		
		Возврат Неопределено;
		
	КонецПопытки; 
	
	Возврат НовыйДок.Ссылка;

КонецФункции

Функция СоздатьКорректировкуЗаказаПоставщикуПоТаблицеТоваров(ЗаказПоставщику, Проведение, ТаблицаТоваров, ПоОстаткам = Ложь) 
	
	НовыйДок = Документы.КорректировкаЗаказаПоставщику.СоздатьДокумент();
	
	НовыйДок.Дата = ТекущаяДата();
	НовыйДок.Заполнить(ЗаказПоставщику);
	НовыйДок.Комментарий = "Корректировка по запросу с портала";
	
	ТабЧастьТовары = НовыйДок.Товары;
	
	Если Не ПоОстаткам Тогда
			
		ТабЧастьТовары.Очистить();
		
		Для Каждого СтрокаТовары Из ТаблицаТоваров Цикл 
			
			НоваяСтрока = ТабЧастьТовары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТовары);  		
						
		КонецЦикла;          	
		
	Иначе          
		
		МассивУдаления = Новый Массив;
		
		Для каждого Стр Из ТаблицаТоваров Цикл   			
			
			СтрокиПоиска = ТабЧастьТовары.НайтиСтроки(Новый Структура("Номенклатура", Стр.Номенклатура));
			
			Для каждого СтрПоиска Из СтрокиПоиска Цикл
				
				Если Стр.Количество = 0 Тогда 
					
					МассивУдаления.Добавить(СтрПоиска);	    
					Продолжить;
					
				КонецЕсли;
				
				//-5, а в отмене -3
				Если СтрПоиска.Количество <= Стр.Количество Тогда
					
					СтрПоиска.Количество = Стр.Количество; 
					Стр.Количество = 0;	
					
				//-1, а в отмене -4
				ИначеЕсли СтрПоиска.Количество > Стр.Количество Тогда 				
					Стр.Количество = Стр.Количество - СтрПоиска.Количество;										
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;  
		
		Для каждого СтрУдаления Из МассивУдаления Цикл
			ТабЧастьТовары.Удалить(СтрУдаления);	
		КонецЦикла;
		
	КонецЕсли;     
	
	Для Каждого СтрокаТовары Из ТабЧастьТовары Цикл
		
		ЗаказПоставщикаТоварыСтрока = ЗаказПоставщику.Товары.НайтиСтроки(Новый Структура("Номенклатура, Заказ", СтрокаТовары.Номенклатура, СтрокаТовары.Заказ));
		СтрокаТовары.Цена = ЗаказПоставщикаТоварыСтрока[0].Цена;
		
		ОбработкаТабличныхЧастей.ЗаполнитьЕдиницуТабЧасти(СтрокаТовары, НовыйДок);  
		ОбработкаТабличныхЧастей.ЗаполнитьСтавкуНДСТабЧасти(СтрокаТовары, НовыйДок);
		ОбработкаТабличныхЧастей.РассчитатьКоличествоМестТабЧасти(СтрокаТовары, НовыйДок);
		ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(СтрокаТовары, НовыйДок);
		ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(СтрокаТовары, НовыйДок); 
		
	КонецЦикла;
	
	Попытка 	
		НовыйДок.Записать(РежимЗаписиДокумента.Проведение);				
	Исключение    
		
		#Если Клиент Тогда
			Сообщить(ОписаниеОшибки());
		#Иначе
			ЗаписьЖурналаРегистрации("Создание корректировки Заказа покупателя", УровеньЖурналаРегистрации.Ошибка,,, ОписаниеОшибки());
		#КонецЕсли	 
		
		Возврат Неопределено;
		
	КонецПопытки; 
	
	Возврат НовыйДок.Ссылка;

КонецФункции

Функция СоздатьКорректировкуГрузоместа(ПромГрузоместо, ПромЗаказ, ПромТовар, ПромКоличество) 
	
	ПромКоличествоКорректировать = ПромКоличество;
	КорректировкаГрузовогоМеста = Документы.КорректировкаГрузовогоМеста.СоздатьДокумент();
	КорректировкаГрузовогоМеста.ГрузовоеМесто   = ПромГрузоместо;
	КорректировкаГрузовогоМеста.Исполнено		= Ложь;
	КорректировкаГрузовогоМеста.Контрагент		= ПромГрузоместо.Сборка.Контрагент;
	КорректировкаГрузовогоМеста.Грузополучатель = ПромГрузоместо.Сборка.Грузополучатель;
	КорректировкаГрузовогоМеста.Организация 	= ПромГрузоместо.Сборка.Организация;		
	КорректировкаГрузовогоМеста.Дата            = ТекущаяДата();
	КорректировкаГрузовогоМеста.Комментарий     = "Корректировка по запросу с портала";
	
	СтрокиПоТоваруГрузоместе = ПромГрузоместо.Товары.НайтиСтроки(Новый Структура("Заказ, Номенклатура", ПромЗаказ, ПромТовар));
	
	Если НЕ СтрокиПоТоваруГрузоместе.Количество() = 0 Тогда
		
		Для Каждого СтрокаИзГрузоместа ИЗ СтрокиПоТоваруГрузоместе Цикл
			
			Если НЕ ПромКоличествоКорректировать = 0 Тогда 
				
				НоваяСтрокаКорректировки = КорректировкаГрузовогоМеста.Товары.Добавить();
				НоваяСтрокаКорректировки.Заказ = СтрокаИзГрузоместа.Заказ;
				НоваяСтрокаКорректировки.Номенклатура = СтрокаИзГрузоместа.Номенклатура;
				НоваяСтрокаКорректировки.КоличествоВГрузоместе = СтрокаИзГрузоместа.Количество;
				НоваяСтрокаКорректировки.Количество = Мин(ПромКоличествоКорректировать, СтрокаИзГрузоместа.Количество);
				ПромКоличествоКорректировать = ?(ПромКоличествоКорректировать >= СтрокаИзГрузоместа.Количество, ПромКоличествоКорректировать - СтрокаИзГрузоместа.Количество, 0);
				
			КонецЕсли;
			
		КонецЦикла;		
		
	КонецЕсли;
	
	ПромКоличество = ПромКоличествоКорректировать; 
	КорректировкаГрузовогоМеста.Записать(РежимЗаписиДокумента.Проведение);	
	
	Возврат КорректировкаГрузовогоМеста.Ссылка;

КонецФункции

Функция СоздатьКорректировкуСборки(ПромСборка, ПромЗаказ, ПромТовар, ПромКоличество)
	
	ПромКоличествоКорректировать = ПромКоличество;
	
	КорректировкаСборкиЗаказов = Документы.КорректировкаСборкиЗаказовПокупателя.СоздатьДокумент();
	КорректировкаСборкиЗаказов.СборкаЗаказовПокупателя   =  ПромСборка;
	КорректировкаСборкиЗаказов.Исполнено				 =  Истина;
	КорректировкаСборкиЗаказов.Контрагент				 =  ПромСборка.Контрагент;
	КорректировкаСборкиЗаказов.Грузополучатель 		     =	ПромСборка.Грузополучатель;
	КорректировкаСборкиЗаказов.Организация 			     =	ПромСборка.Организация;		
	КорректировкаСборкиЗаказов.Ответственный		     =	Справочники.ФизическиеЛица.Автосборка;	
	КорректировкаСборкиЗаказов.Дата                      =  ТекущаяДата();
	КорректировкаСборкиЗаказов.Комментарий               =  "Корректировка по запросу с портала";
	
	СтрокиПоТоварувСборке = ПромСборка.Заказано.НайтиСтроки(Новый Структура("Заказ, Номенклатура", ПромЗаказ, ПромТовар));
	
	Если НЕ СтрокиПоТоварувСборке.Количество() = 0 Тогда
		
		Для Каждого СтрокаИзСборки ИЗ СтрокиПоТоварувСборке Цикл
			
			Если НЕ ПромКоличествоКорректировать = 0 Тогда 
				
				НоваяСтрокаКорректировки = КорректировкаСборкиЗаказов.Товары.Добавить();
				НоваяСтрокаКорректировки.ЗаказПокупателя = СтрокаИзСборки.Заказ;
				НоваяСтрокаКорректировки.Номенклатура = СтрокаИзСборки.Номенклатура;
				НоваяСтрокаКорректировки.Ячейка = СтрокаИзСборки.Ячейка;
				НоваяСтрокаКорректировки.Склад = СтрокаИзСборки.Заказ.СкладГруппа;
				НоваяСтрокаКорректировки.Причина = Перечисления.ПричиныКорректировкиСборки.ОтказКлиента;
				НоваяСтрокаКорректировки.Количество = Мин(ПромКоличествоКорректировать, СтрокаИзСборки.Количество);
				ПромКоличествоКорректировать = ?(ПромКоличествоКорректировать >= СтрокаИзСборки.Количество, ПромКоличествоКорректировать - СтрокаИзСборки.Количество, 0);
				
			КонецЕсли;
			
		КонецЦикла;		
		
	КонецЕсли;	
	
	КорректировкаСборкиЗаказов.ПровестиИСоздатьКорректировкиЗаказа();	
	
	Возврат КорректировкаСборкиЗаказов.Ссылка;
	
КонецФункции


