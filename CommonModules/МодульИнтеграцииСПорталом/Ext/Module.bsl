Функция ПроверитьТокенДоступа(ТокенДоступа) Экспорт 
	
	ТокенАктивен	= Ложь;
	СообщениеОшибки = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТокеныДоступа.Ссылка КАК ТокенДоступа,
	|	ТокеныДоступа.Наименование,
	|	ТокеныДоступа.Неактивен
	|ИЗ
	|	Справочник.ТокеныДоступа КАК ТокеныДоступа
	|ГДЕ
	|	ТокеныДоступа.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|	И ТокеныДоступа.Наименование = &ТокенДоступа";
	
	Запрос.УстановитьПараметр("ТокенДоступа", ТокенДоступа);
	
	ВыборкаРезультат = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаРезультат.Следующий() Тогда 
		
		Если ВыборкаРезультат.Неактивен Тогда 
			СообщениеОшибки = "Токен доступа не Активен..";
		Иначе 
			ТокенАктивен = Истина;	                     
		КонецЕсли;
		
	Иначе 	
		СообщениеОшибки = "Отсутствует Токен доступа.";
	КонецЕсли;
	
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("ТокенАктивен", 	ТокенАктивен);
	СтруктураОтвета.Вставить("СообщениеОшибки", СообщениеОшибки);
	
	Возврат СтруктураОтвета;
	
КонецФункции	


