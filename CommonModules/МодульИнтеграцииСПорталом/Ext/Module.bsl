Функция ПолучитьДанныеПоЗаказамСервер(ПараметрыСоответсвие, МассивЗаказов = Неопределено) Экспорт  

	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах(); 
	ПараметрыСтруктура = ПолучитьСтруктуруИзСоответствия(ПараметрыСоответсвие);
	
	ПараметрыЗапросаСтр = ПолучитьОписаниеПараметровЗапроса(ПараметрыСтруктура);  
	ПараметрыЗапросаСтр = ПараметрыЗапросаСтр + ?(МассивЗаказов <> Неопределено, " Количество заказов: " + Строка(МассивЗаказов.Количество()), "");
	
	ЗаписьЖурналаРегистрации("HTTP-сервис OnlineStore.Orders.ПолучитьДанныеПоЗаказам", УровеньЖурналаРегистрации.Информация,,, 
	"HTTP-сервис:Запуск. ПолучитьДанныеПоЗаказам. " + ПараметрыЗапросаСтр);
		
	СтруктураВозврата = ПолучитьДанныеПоЗаказам(ПараметрыСтруктура, МассивЗаказов);
	
	ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("HTTP-сервис OnlineStore.Orders.ПолучитьДанныеПоЗаказам", УровеньЖурналаРегистрации.Информация,,, 
	"HTTP-сервис:Завершение. ПолучитьДанныеПоЗаказам. "  
	+ Формат(ВремяОкончанияUTC - ВремяНачалаUTC, "ЧН=0; ЧГ=0") + " м.сек." + ПараметрыЗапросаСтр);
	
	Возврат СтруктураВозврата;
	
КонецФункции

Функция ПолучитьЗаказыПоИдентификатору(ИдентификаторЗаказаИМ)
	
	МассивИдентификторов = Новый Массив;
	МассивИдентификторовЧисло = Новый Массив;
	МассивИдентификторовСтрока = Новый Массив;
	
	Если ТипЗнч(ИдентификаторЗаказаИМ) = Тип("Массив") Тогда
		МассивИдентификторов = ИдентификаторЗаказаИМ;
	Иначе
		МассивИдентификторов.Добавить(ИдентификаторЗаказаИМ);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказПокупателя.Ссылка,
	|	1 КАК Приоритет
	|ПОМЕСТИТЬ ВТ_Документы
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|ГДЕ
	|	ЗаказПокупателя.IDЗаказаПортал В(&МассивИдентификторовЧисло)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	НеСозданныеЗаказыПокупателей.Ссылка,
	|	2
	|ИЗ
	|	Справочник.НеСозданныеЗаказыПокупателей КАК НеСозданныеЗаказыПокупателей
	|ГДЕ
	|	НеСозданныеЗаказыПокупателей.Код В(&МассивИдентификторовСтрока)
	|	И НеСозданныеЗаказыПокупателей.ЗаказПокупателяСсылка = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Документы.Ссылка
	|ИЗ
	|	ВТ_Документы КАК ВТ_Документы
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_Документы.Приоритет";   
	
	Для каждого Ид Из МассивИдентификторов Цикл     
		
		//+Белов А. 29.12.2025 #UT10-5607
		Если Число(Ид) = 0 Тогда
			Продолжить;
		КонецЕсли; 
		//-Белов А. 29.12.2025 #UT10-5607
		
		МассивИдентификторовЧисло.Добавить(Число(Ид));
		
	КонецЦикла;
	
	Для каждого Ид Из МассивИдентификторов Цикл
		
		//+Белов А. 29.12.2025 #UT10-5607
		Если Формат(Ид, "ЧГ=0") = "0" Тогда
			Продолжить;
		КонецЕсли; 
		//-Белов А. 29.12.2025 #UT10-5607
		
		МассивИдентификторовСтрока.Добавить(Формат(Ид, "ЧГ=0"));
		
	КонецЦикла;
	
	Запрос.УстановитьПараметр("МассивИдентификторовСтрока", МассивИдентификторовСтрока);  
	Запрос.УстановитьПараметр("МассивИдентификторовЧисло", МассивИдентификторовЧисло);  
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Функция ПолучитьДанныеПоЗаказам(ПараметрыЗапроса, МассивЗаказов) 
	
	СтруктураВозврата 	= Новый Структура("Результат, Данные, Сообщение", Ложь, Неопределено, ""); 
	СтрокаПараметров	= "ИдентификаторЗаказаИМ, ДатаОформленияЗаказа, НаименованиеГрузополучатель,ИдентификаторГрузополучатель, АдресДоставки, ТипДоставки, ДатаСамовывоза, НаименованиеОрганизации, ИдентификаторУчетнойСистемы, ИдентификаторТипаЦен, НаименованиеКонтрагент,ИдентификаторКонтрагент, НаименованиеДоговора, ИдентификаторДоговора, ИсточникЗаказа, Комментарий, НаименованиеВалюта,СуммаДокументаСНДС";
	
	
	//Дополнительные параметры по получению данных по заказку и номенклатуры
	//используется для дополнительного запроса по http сервису, детального запроса по номенклатуре 

	ИдентификаторДокумента 	= "";
	ДокументыЗаказа 		= Новый Массив;  
	ДанныеПоЗаказу 			= Ложь;
	ДетальнаяИнформация 	= Ложь;
	ДатаНачала 				= Дата(1, 1, 1);
	ДатаОкончания			= Дата(1, 1, 1);   
	ИдентификаторКонтрагента= "";
	Филиалы 				= "";
	СписокФилиалов 			= Новый Массив; 
	МассивРезультат 		= Новый Массив; 
	АртикулТовара 			= "";
	НомерДокумента 			= "";
	СтатусЗаказа 			= "";
	ИскатьПоКодуМДМ 		= Ложь;     
	
	Если ПараметрыЗапроса.Свойство("ИдентификаторЗаказаИМ") И Найти(ПараметрыЗапроса.ИдентификаторЗаказаИМ, "[") > 0 Тогда
		
		МассивИдентификаторов = ОбщегоНазначения.ВернутьСтруктуруИзJSON(ПараметрыЗапроса.ИдентификаторЗаказаИМ);
		МассивЗаказов = ПолучитьЗаказыПоИдентификатору(МассивИдентификаторов);   
		
		Если МассивЗаказов.Количество() = 0 Тогда
			
			СтруктураВозврата.Сообщение = "Данные заказа не получены. Причина: не найдены Заказы клиента с Идентификаторами: " + ПараметрыЗапроса.ИдентификаторЗаказаИМ;
			Возврат СтруктураВозврата;
			
		КонецЕсли;
		
		//+Сёмин Р.И. 23.03.2026 #P3-4087
	ИначеЕсли НЕ ПараметрыЗапроса.Свойство("ИдентификаторКонтрагента") И ПараметрыЗапроса.Свойство("НомерДокумента") И Найти(ПараметрыЗапроса.НомерДокумента, "[") > 0 Тогда
		
		НомераДокументов = СтрЗаменить(ПараметрыЗапроса.НомерДокумента, "[", "");
		НомераДокументов = СтрЗаменить(НомераДокументов, "]", "");
		
		МассивНомеров = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(НомераДокументов, ",");
		МассивЗаказов = ПолучитьЗаказыПоНомеру(МассивНомеров);   
		
		Если МассивЗаказов.Количество() = 0 Тогда
			
			СтруктураВозврата.Сообщение = "Данные заказа не получены. Причина: не найдены Заказы клиента с Номерами: " + ПараметрыЗапроса.НомерДокумента;
			Возврат СтруктураВозврата;
			
		КонецЕсли;
		//-Сёмин Р.И. 23.03.2026 #P3-4087
		
	КонецЕсли;
	
	Если МассивЗаказов <> Неопределено Тогда
		
		ДанныеПоЗаказу 			= Истина;
		ДокументыЗаказа = МассивЗаказов;
		
		ДатаНачала	  = ДокументыЗаказа[0].Дата;
		ДатаОкончания = ДокументыЗаказа[МассивЗаказов.Количество() - 1].Дата;
		
	ИначеЕсли ПараметрыЗапроса.Свойство("ИдентификаторЗаказаИМ") И ПараметрыЗапроса.ИдентификаторЗаказаИМ <> "" Тогда  
		
		ДанныеПоЗаказу 			= Истина;
		ИдентификаторЗаказаИМ 	= ПараметрыЗапроса.ИдентификаторЗаказаИМ;   
		
		ДокументыЗаказа = ПолучитьЗаказыПоИдентификатору(ИдентификаторЗаказаИМ);
		
		Если ДокументыЗаказа.Количество() = 0 Тогда
			
			СтруктураВозврата.Сообщение = "Данные заказа не получены. Причина: не найден Заказ клиента с ИдентификаторДокумента " + ИдентификаторЗаказаИМ;
			Возврат СтруктураВозврата;
			
		КонецЕсли;  
		
		ДатаНачала	  = ДокументыЗаказа[0].Дата;
		ДатаОкончания = ДокументыЗаказа[0].Дата;
		
	Иначе // общие параметры для др. частей запросов   
		
		Если Не ПараметрыЗапроса.Свойство("ДатаНачала") Или Не ЗначениеЗаполнено(ПараметрыЗапроса.ДатаНачала) Тогда
			ДатаНачала = НачалоДня(ТекущаяДата());			
		Иначе
			ДатаНачала = СтрокаВДату(ПараметрыЗапроса.ДатаНачала);	
		КонецЕсли;   
		
		Если Не ПараметрыЗапроса.Свойство("ДатаОкончания") Или Не ЗначениеЗаполнено(ПараметрыЗапроса.ДатаОкончания) Тогда
			ДатаОкончания = КонецДня(ТекущаяДата());
		Иначе
			ДатаОкончания = СтрокаВДату(ПараметрыЗапроса.ДатаОкончания);	
		КонецЕсли;  
		
		Если Не ПараметрыЗапроса.Свойство("ИдентификаторКонтрагента") Или Не ЗначениеЗаполнено(ПараметрыЗапроса.ИдентификаторКонтрагента) Тогда
			
			СтруктураВозврата.Сообщение = "Данные заказа не получены. Причина: не задан параметр ИдентификаторКонтрагента";
			Возврат СтруктураВозврата;
	
		КонецЕсли; 
		
		
		ИдентификаторКонтрагента = СтрЗаменить(СокрЛП(ПараметрыЗапроса.ИдентификаторКонтрагента), Символы.НПП, "");  
		
		Если ПараметрыЗапроса.Свойство("СписокФилиалов") Тогда
			Филиалы = СокрЛП(ПараметрыЗапроса.СписокФилиалов);	
		КонецЕсли;  
		
	КонецЕсли;	
	
	ДетальнаяИнформация = Неопределено;
	ПараметрыЗапроса.Свойство("ДетальнаяИнформация", ДетальнаяИнформация);  
	ДетальнаяИнформация = СтрокаВБулево(ДетальнаяИнформация);
	
	Если ДокументыЗаказа.Количество() = 0 И ПараметрыЗапроса.Свойство("НомерДокумента") Тогда
		
		НомерДокумента = СокрЛП(ПараметрыЗапроса.НомерДокумента);   
		
		Если ЗначениеЗаполнено(НомерДокумента) Тогда
			
			ЗапросДокумента = Новый Запрос;
			ЗапросДокумента.Текст = "ВЫБРАТЬ
			                        |	ЗаказыПокупателейОбороты.ЗаказПокупателя
			                        |ИЗ
			                        |	РегистрНакопления.ЗаказыПокупателей.Обороты(&ДатаНачала, &ДатаОкончания, , ЗаказПокупателя.Номер = &Номер) КАК ЗаказыПокупателейОбороты
			                        |
			                        |СГРУППИРОВАТЬ ПО
			                        |	ЗаказыПокупателейОбороты.ЗаказПокупателя
			                        |
			                        |ОБЪЕДИНИТЬ ВСЕ
			                        |
			                        |ВЫБРАТЬ
			                        |	ЗаказыПокупателейОбороты.ЗаказПокупателя
			                        |ИЗ
			                        |	РегистрНакопления.ЗаказыПокупателей.Обороты(&ДатаНачала, &ДатаОкончания, Регистратор, ) КАК ЗаказыПокупателейОбороты
			                        |ГДЕ
			                        |	ЗаказыПокупателейОбороты.Регистратор.Номер = &Номер";
			
			ЗапросДокумента.УстановитьПараметр("ДатаНачала", ДатаНачала);
			ЗапросДокумента.УстановитьПараметр("ДатаОкончания", ?(ЗначениеЗаполнено(ДатаОкончания), КонецДня(ДатаОкончания), КонецДня(ТекущаяДата())));
			ЗапросДокумента.УстановитьПараметр("Номер", НомерДокумента);
			
			ВыборкаДокумента = ЗапросДокумента.Выполнить().Выбрать();
			
			Если ВыборкаДокумента.Следующий() Тогда       
				
				ДокументыЗаказа.Добавить(ВыборкаДокумента.ЗаказПокупателя);      			
				ДанныеПоЗаказу = Истина;         
				
				ДатаНачала = ВыборкаДокумента.ЗаказПокупателя.Дата;
				ДатаОкончания = ВыборкаДокумента.ЗаказПокупателя.Дата;
				
			КонецЕсли;		
			
		КонецЕсли;  
		
	КонецЕсли;  
	
	Если ПараметрыЗапроса.Свойство("СтатусЗаказа") Тогда
		СтатусЗаказа = СокрЛП(ПараметрыЗапроса.СтатусЗаказа);	
	КонецЕсли;
	
	Если ДетальнаяИнформация Тогда
		
		Если ПараметрыЗапроса.Свойство("Артикул") И ПараметрыЗапроса.Артикул <> "" Тогда  
			
			Артикул = СокрЛП(ПараметрыЗапроса.Артикул);	
			АртикулТовара = Артикул;  
			
		КонецЕсли;    
										
	КонецЕсли;	
	
	Если ДанныеПоЗаказу И Не ДокументыЗаказа.Количество() = 0 Тогда 
		
		Если МассивЗаказов = Неопределено Тогда 
			
			НайденныйЗаказ = ДокументыЗаказа[0];
			
			Если ТипЗнч(НайденныйЗаказ) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
				
				Контрагент = ДокументыЗаказа[0].Контрагент;  	   
				
				Если ЗначениеЗаполнено(Контрагент.КодМДМ) Тогда
					
					ИдентификаторКонтрагента = Контрагент.КодМДМ;
					ИскатьПоКодуМДМ = Истина;       
					РеквизитПоиска = "КодМДМ";
					
				Иначе
					
					ИдентификаторКонтрагента 	= СтрЗаменить(СокрЛП(Контрагент.IDАварда), Символы.НПП, "");
					РеквизитПоиска = "IDАварда";
					
				КонецЕсли; 
				
				//Это несозданный заказ
			Иначе         
				
				Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту("КодМДМ", НайденныйЗаказ.KontragentID);   
				
				ИдентификаторКонтрагента = Контрагент.КодМДМ;
				ИскатьПоКодуМДМ = Истина;       
				РеквизитПоиска = "КодМДМ";
				
			КонецЕсли;    
			
		КонецЕсли;
				
	Иначе 	     
		
		Если СтрДлина(ИдентификаторКонтрагента) = 36 Тогда
			
			ИскатьПоКодуМДМ = Истина;       
			РеквизитПоиска = "КодМДМ";  
			
		Иначе
			
			РеквизитПоиска = "IDАварда";
			
		КонецЕсли;
				
		Если ЗначениеЗаполнено(Филиалы) И НЕ Константы.НеПроверятьФилиалВВэбСервисах.Получить() Тогда    
			
			Филиалы = СтрЗаменить(Филиалы, " ", "");
			СписокФилиалов = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(СокрЛП(Филиалы), ",");   
			
		КонецЕсли;
		
		Контрагент = НайтиКонтрагентаOnlineStore(ПараметрыЗапроса, СтруктураВозврата, "Данные заказов не получены. ");
		
	КонецЕсли;
	
	Если МассивЗаказов <> Неопределено ИЛИ (НЕ Контрагент.Пустая() ИЛИ НЕ СписокФилиалов.Количество() = 0) Тогда   
		                                                                                  
		ЗапросЗаказовПоСтатусам = Новый Запрос;    
		ЗапросЗаказовПоСтатусам.УстановитьПараметр("ДатаНач",			?(ЗначениеЗаполнено(ДатаНачала), НачалоДня(ДатаНачала), НачалоДня(ТекущаяДата() - 86400 * 14)));
		ЗапросЗаказовПоСтатусам.УстановитьПараметр("ДатаКон",			?(ЗначениеЗаполнено(ДатаОкончания), КонецДня(ДатаОкончания), КонецДня(ТекущаяДата())));
		ЗапросЗаказовПоСтатусам.УстановитьПараметр("Артикул", 			?(СокрЛП(АртикулТовара) <> "", "%" + АртикулТовара + "%", ""));  
		ЗапросЗаказовПоСтатусам.УстановитьПараметр("БезОтбораПоАртикулу", НЕ ЗначениеЗаполнено(СокрЛП(АртикулТовара))); 
		ЗапросЗаказовПоСтатусам.УстановитьПараметр("ДокументыЗаказа", 	ПолучитьТипИзМассива(ДокументыЗаказа, Тип("ДокументСсылка.ЗаказПокупателя")));
		ЗапросЗаказовПоСтатусам.УстановитьПараметр("ДокументыЗаказаНесозданные", 	ПолучитьТипИзМассива(ДокументыЗаказа, Тип("СправочникСсылка.НеСозданныеЗаказыПокупателей")));
		ЗапросЗаказовПоСтатусам.УстановитьПараметр("IDАварда",			ИдентификаторКонтрагента);
		ЗапросЗаказовПоСтатусам.УстановитьПараметр("СписокИД",			СписокФилиалов);  
		ЗапросЗаказовПоСтатусам.УстановитьПараметр("НомерДокумента", 	НомерДокумента);
		//+Гавриленков В. 05.12.2025 #UT10-5574
		ЗапросЗаказовПоСтатусам.УстановитьПараметр("СтавкаНДС",		 	Перечисления.СтавкиНДС.НДС20); 
		ЗапросЗаказовПоСтатусам.УстановитьПараметр("СтавкаНДС",		 	?(ТекущаяДата() >= Дата("20260101000000"), Перечисления.СтавкиНДС.НДС22, Перечисления.СтавкиНДС.НДС20));
		//-Гавриленков В. 05.12.2025 #UT10-5574
		ЗапросЗаказовПоСтатусам.УстановитьПараметр("ЧислоДней",		 	Константы.ЧислоДнейДляРегламентаПоКорректировкамСобранныхСборок.Получить());  
		
		УстановитьПривилегированныйРежим(Истина);
	 	СкладДопПоставщикаДляСтатусовНаПортале = Константы.СкладДопПоставщикаДляСтатусовНаПортале.Получить();
		
		ЗапросЗаказовПоСтатусам.УстановитьПараметр("ДопПоставщик", ?(Константы.ОтправлятьЗаказыВСтророннююУТ11.Получить(), 
		                                            Константы.ДопПоставщик.Получить(), Справочники.Контрагенты.ПустаяСсылка()));
	 	ЗапросЗаказовПоСтатусам.УстановитьПараметр("СкладДопПоставщикаДляСтатусовНаПортале", СкладДопПоставщикаДляСтатусовНаПортале);		
		ЗапросЗаказовПоСтатусам.Текст = ПолучитьТекстЗапросаСтатусовЗаказов(ИскатьПоКодуМДМ, СписокФилиалов, ДетальнаяИнформация, ДанныеПоЗаказу, МассивЗаказов);
		
		Попытка
			РезультатЗапросаЗаказовПоСтатусам = ЗапросЗаказовПоСтатусам.Выполнить();  	
		Исключение
			
			Ошибка = ОписаниеОшибки();
			
			СтруктураВозврата.Сообщение = Ошибка;
			Возврат СтруктураВозврата;
			
		КонецПопытки;
		  
		УстановитьПривилегированныйРежим(Ложь);
		
		Если НЕ РезультатЗапросаЗаказовПоСтатусам.Пустой() Тогда 
			ОбработатьЗапросПоЗаказу(РезультатЗапросаЗаказовПоСтатусам, ДетальнаяИнформация, СтрокаПараметров, МассивРезультат, СтатусЗаказа);  
		КонецЕсли;		

		//ДобавитьНеСозданныеЗаказыПокупателей(ДатаНачала, ДатаОкончания, ИдентификаторКонтрагента, МассивРезультат, СтрокаПараметров);  
		
	Иначе
		СтруктураВозврата.Сообщение = "Данные заказа не получены. Причина: не найден контрагент, не заданы филиалы.";
	КонецЕсли;    
	
	СтруктураВозврата.Результат = Истина;
	СтруктураВозврата.Данные 	= МассивРезультат;
	
	Возврат СтруктураВозврата;
	
КонецФункции 

Функция ПолучитьТипИзМассива(Массив, Тип)
	
	МассивВозврата = Новый Массив;
	
	Для каждого Эл Из Массив Цикл
		
		Если ТипЗнч(Эл) = Тип Тогда
			МассивВозврата.Добавить(Эл);
		КонецЕсли; 
		
	КонецЦикла;             
	
	Возврат МассивВозврата;
		
КонецФункции

Функция ПолучитьТекстЗапросаСтатусовЗаказов(ИскатьПоКодуМДМ, пСписокФилиалов, ДетальнаяИнформация, ДанныеПоЗаказу, МассивЗаказов) 
	
	ТекстЗапроса = ""; 
	
	Если МассивЗаказов <> Неопределено Тогда
		
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	Значение(Справочник.Контрагенты.ПустаяСсылка) КАК Ссылка
		|ПОМЕСТИТЬ ВТ_ТаблицаКлиентов"; 
		
	ИначеЕсли пСписокФилиалов.Количество() <> 0 Тогда  
		
		ТекстЗапроса = 			
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка
		|ПОМЕСТИТЬ ВТ_ИДАварда
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.IDАварда = &IDАварда
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Контрагенты.Ссылка
		|ПОМЕСТИТЬ ВТ_ТаблицаКлиентов
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	(Контрагенты.IDФилиала В (&СписокИД)
		|			ИЛИ Контрагенты.КодМДМ В (&СписокИД))
		|	И Контрагенты.ГоловнойКонтрагент В
		|			(ВЫБРАТЬ
		|				ИДАварда.Ссылка
		|			ИЗ
		|				ВТ_ИДАварда КАК ИДАварда)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Контрагенты.Ссылка"; 
		
	Иначе       
		
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка
		|ПОМЕСТИТЬ ВТ_ТаблицаКлиентов
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.ГоловнойКонтрагент.IDАварда = &IDАварда
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Контрагенты.Ссылка"; 
		
	КонецЕсли;
	
	Если ИскатьПоКодуМДМ Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ".IDАварда", ".КодМДМ");
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + ПолучитьТекстЗапросаДетальнойИнформации();   
	                                                
	Если пСписокФилиалов.Количество() = 0 Тогда 
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "
		|УНИЧТОЖИТЬ ВТ_ИДАварда
		|;", "");
		
	КонецЕсли;	
	
	Если ДанныеПоЗаказу Тогда
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И ТаблицаКлиентов.Ссылка = ЗаказПокупателя.Грузополучатель", "");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЗаказПокупателя.Ссылка.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаНач, ДЕНЬ) И КОНЕЦПЕРИОДА(&ДатаКон, ДЕНЬ)", "ЗаказПокупателя.Ссылка В (&ДокументыЗаказа)"); 	
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И ВТ_ТаблицаКлиентов.Ссылка.КодМДМ = НеСозданныеЗаказыПокупателейТовары.Ссылка.FilialID", "");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "НеСозданныеЗаказыПокупателейТовары.Ссылка.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаНач, ДЕНЬ) И КОНЕЦПЕРИОДА(&ДатаКон, ДЕНЬ)", "НеСозданныеЗаказыПокупателейТовары.Ссылка В (&ДокументыЗаказаНесозданные)"); 	
		
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции 

Функция ПолучитьТекстЗапросаДетальнойИнформации()
	
	Текст = ";";
	
	Текст = Текст + "ВЫБРАТЬ
	                |	ВЫБОР
	                |		КОГДА Константы.ОтправлятьЗаказыВСтророннююУТ11
	                |			ТОГДА Константы.ДопПоставщик
	                |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	                |	КОНЕЦ КАК ДопПоставщик,
	                |	Константы.СкладДопПоставщикаДляСтатусовНаПортале КАК СкладДопПоставщикаДляСтатусовНаПортале
	                |ПОМЕСТИТЬ ВТ_КонстантыПоставщика
	                |ИЗ
	                |	Константы КАК Константы
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	ЗаказПокупателя.Ссылка КАК Заказ,
	                |	МИНИМУМ(ВЫБОР
	                |			КОГДА СобственныеСклады.Ссылка ЕСТЬ NULL
	                |					ИЛИ СобственныеСклады.Ссылка = ЗНАЧЕНИЕ(Справочник.СобственныеСклады.ПустаяСсылка)
	                |					ИЛИ НЕ СобственныеСклады.ИсключитьИзОбщегоЭкспресса
	                |				ТОГДА """"
	                |			ИНАЧЕ СобственныеСклады.СкладПоставщикаДляСтатусовНаПортале
	                |		КОНЕЦ) КАК СкладДляПортала
	                |ПОМЕСТИТЬ ВТ_ОбщийЗаказыПокупателя
	                |ИЗ
	                |	ВТ_ТаблицаКлиентов КАК ТаблицаКлиентов
	                |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК ЗаказПокупателя
	                |		ПО (ИСТИНА)
	                |			И ТаблицаКлиентов.Ссылка = ЗаказПокупателя.Грузополучатель
	                |			И (ЗаказПокупателя.Ссылка.Проведен)
	                |			И (ЗаказПокупателя.Ссылка.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаНач, ДЕНЬ) И КОНЕЦПЕРИОДА(&ДатаКон, ДЕНЬ))
	                |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СобственныеСклады КАК СобственныеСклады
	                |		ПО (ЗаказПокупателя.IDСклада = СобственныеСклады.Идентификатор)
	                |ГДЕ
	                |	НЕ ЗаказПокупателя.Ссылка ЕСТЬ NULL
	                |
	                |СГРУППИРОВАТЬ ПО
	                |	ЗаказПокупателя.Ссылка
	                |
	                |ИНДЕКСИРОВАТЬ ПО
	                |	Заказ
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	ЗаказПокупателя.Заказ КАК Заказ,
	                |	ЗаказПокупателяТовары.Номенклатура КАК Номенклатура,
	                |	МАКСИМУМ(ЗаказПокупателяТовары.Цена) КАК Цена,
	                |	СУММА(ЗаказПокупателяТовары.Количество) КАК Количество,
	                |	МАКСИМУМ(ЗаказПокупателяТовары.Комментарий) КАК КомментарийНоменклатуры,
	                |	МАКСИМУМ(ЗаказПокупателяТовары.СтавкаНДС) КАК СтавкаНДС,
	                |	МИНИМУМ(ЗаказПокупателя.СкладДляПортала) КАК СкладДляПортала,
	                |	ЗаказПокупателя.Заказ.IDСклада КАК ИдентификаторСклад,
	                |	ЗаказПокупателя.Заказ.Грузополучатель КАК Грузополучатель,
	                |	ЗаказПокупателя.Заказ.ИсточникЗаказа.КодИсточника КАК ИсточникЗаказа,
	                |	ЗаказПокупателя.Заказ.ТаксиДоставка КАК ТаксиДоставка,
	                |	ЗаказПокупателя.Заказ.СпособДоставки КАК СпособДоставки,
	                |	ЗаказПокупателя.Заказ.ДоговорКонтрагента КАК Договор,
	                |	ВЫБОР
	                |		КОГДА ЗаказПокупателя.Заказ.СпособДоставки = ЗНАЧЕНИЕ(Перечисление.СпособДоставки.Самовывоз)
	                |			ТОГДА 1
	                |		ИНАЧЕ 2
	                |	КОНЕЦ КАК ТипДоставки,
	                |	ВЫБОР
	                |		КОГДА ЗаказПокупателя.Заказ.IDЗаказаПортал = 0
	                |			ТОГДА ЗаказПокупателя.Заказ.Номер
	                |		ИНАЧЕ СТРЗАМЕНИТЬ(СТРОКА(ЗаказПокупателя.Заказ.IDЗаказаПортал), "" "", """")
	                |	КОНЕЦ КАК ИдентификаторЗаказаИМ,
	                |	ВЫБОР
	                |		КОГДА ЗаказПокупателяТовары.Номенклатура.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	                |			ТОГДА """"
	                |		ИНАЧЕ ВЫРАЗИТЬ(ЗаказПокупателяТовары.Номенклатура.Родитель.Наименование КАК СТРОКА(80))
	                |	КОНЕЦ КАК Бренд,
	                |	ЗаказПокупателя.Заказ.Грузополучатель.Наименование КАК НаименованиеГрузополучатель,
	                |	ЗаказПокупателя.Заказ.Грузополучатель.КодМДМ КАК ИдентификаторГрузополучатель,
	                |	ЗаказПокупателя.Заказ.Контрагент.КодМДМ КАК ИдентификаторКонтрагент,
	                |	ВЫРАЗИТЬ(ЗаказПокупателя.Заказ.Комментарий КАК СТРОКА(200)) КАК Комментарий,
	                |	ЗаказПокупателя.Заказ.ДоговорКонтрагента.Наименование КАК НаименованиеДоговор,
	                |	ЗаказПокупателя.Заказ.ДоговорКонтрагента.КодМДМ КАК ИдентификаторДоговор,
	                |	ЗаказПокупателя.Заказ.СуммаДокумента КАК СуммаДокумента
	                |ПОМЕСТИТЬ ВТ_ЗаказыПокупателя
	                |ИЗ
	                |	ВТ_ОбщийЗаказыПокупателя КАК ЗаказПокупателя
	                |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары
	                |		ПО ЗаказПокупателя.Заказ = ЗаказПокупателяТовары.Ссылка
	                |ГДЕ
	                |	(&БезОтбораПоАртикулу
	                |			ИЛИ ЗаказПокупателяТовары.Номенклатура.НормализованныйКод ПОДОБНО &Артикул)
	                |
	                |СГРУППИРОВАТЬ ПО
	                |	ЗаказПокупателя.Заказ,
	                |	ЗаказПокупателяТовары.Номенклатура,
	                |	ЗаказПокупателя.Заказ.Грузополучатель,
	                |	ЗаказПокупателя.Заказ.ИсточникЗаказа.КодИсточника,
	                |	ЗаказПокупателя.Заказ.ТаксиДоставка,
	                |	ЗаказПокупателя.Заказ.СпособДоставки,
	                |	ЗаказПокупателя.Заказ.ДоговорКонтрагента,
	                |	ВЫБОР
	                |		КОГДА ЗаказПокупателя.Заказ.IDЗаказаПортал = 0
	                |			ТОГДА ЗаказПокупателя.Заказ.Номер
	                |		ИНАЧЕ СТРЗАМЕНИТЬ(СТРОКА(ЗаказПокупателя.Заказ.IDЗаказаПортал), "" "", """")
	                |	КОНЕЦ,
	                |	ВЫБОР
	                |		КОГДА ЗаказПокупателяТовары.Номенклатура.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	                |			ТОГДА """"
	                |		ИНАЧЕ ВЫРАЗИТЬ(ЗаказПокупателяТовары.Номенклатура.Родитель.Наименование КАК СТРОКА(80))
	                |	КОНЕЦ,
	                |	ЗаказПокупателя.Заказ.Грузополучатель.Наименование,
	                |	ЗаказПокупателя.Заказ.Грузополучатель.КодМДМ,
	                |	ЗаказПокупателя.Заказ.Контрагент.КодМДМ,
	                |	ЗаказПокупателя.Заказ.ДоговорКонтрагента.Наименование,
	                |	ЗаказПокупателя.Заказ.ДоговорКонтрагента.КодМДМ,
	                |	ЗаказПокупателя.Заказ.СуммаДокумента,
	                |	ВЫРАЗИТЬ(ЗаказПокупателя.Заказ.Комментарий КАК СТРОКА(200)),
	                |	ЗаказПокупателя.Заказ.IDСклада
	                |
	                |ИНДЕКСИРОВАТЬ ПО
	                |	Заказ,
	                |	Номенклатура
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ
	                |	НеСозданныеЗаказыПокупателейТовары.Ссылка,
	                |	Контрагенты.Ссылка КАК Контрагент,
	                |	КонтрагентыГрузополучатель.Ссылка КАК Грузополучатель,
	                |	СУММА(НеСозданныеЗаказыПокупателейТовары.Price * НеСозданныеЗаказыПокупателейТовары.Count) КАК Сумма,
	                |	ДоговорыКонтрагентов.Ссылка КАК Договор,
	                |	ЕСТЬNULL(НеСозданныеЗаказыПокупателейТовары.Ссылка.ТипЦенЗаказ.КодМДМ, """") КАК ИдентификаторТипЦен
	                |ПОМЕСТИТЬ ВТ_НесозданныеЗаказы
	                |ИЗ
	                |	ВТ_ТаблицаКлиентов КАК ВТ_ТаблицаКлиентов
	                |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НеСозданныеЗаказыПокупателей.Товары КАК НеСозданныеЗаказыПокупателейТовары
	                |			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
