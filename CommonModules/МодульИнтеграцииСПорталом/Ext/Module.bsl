		|	НомерСтроки
		|ИТОГИ
		|	СУММА(Количество),
		|	СУММА(ЦенаСНДС),
		|	СУММА(СуммаСНДС)
		|ПО
		|	Ссылка,
		|	Номенклатура";
	
	Если ИскатьПоКодуМДМ Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ".IDАварда", ".КодМДМ");
	КонецЕсли;
	
	Если ИскатьФилиалыПоКодуМДМ Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Контрагенты.IDАварда В(&СписокИД)", "Контрагенты.КодМДМ В(&СписокИД)");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Контрагенты.КодМДМ В(&СписокИД)", "Контрагенты.IDАварда В(&СписокИД)");
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	//-Сёмин Р.И. 27.03.2026 #UT10-5775
	
КонецФункции

Процедура ОбработатьЗапросПоДоступнымНоменклатурамДляВозврата(РезультатЗапросаДоступныеНоменклатурыКВозврату, СтрокаПараметров, МассивДанных, ТаблСФ)
	
	//+Сёмин Р.И. 27.03.2026 #UT10-5775
	ВыборкаРезультата1 = РезультатЗапросаДоступныеНоменклатурыКВозврату.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаРезультата1.Следующий() Цикл
		
		ВыборкаРезультата2 = ВыборкаРезультата1.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаРезультата2.Следующий() Цикл
			
			ВыборкаРезультата = ВыборкаРезультата2.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаРезультата.Следующий() Цикл
				
				СтрокаВозврата = Новый Структура(СтрокаПараметров);
				
				ЗаполнитьЗначенияСвойств(СтрокаВозврата, ВыборкаРезультата);
				
				ЕстьРН = ЗначениеЗаполнено(ВыборкаРезультата.Ссылка);
				
				Если ЕстьРН Тогда
					СтрокаВозврата.ГУИДРТУ = СокрЛП(ВыборкаРезультата.Ссылка.УникальныйИдентификатор());
					СтрокаВозврата.ДатаДокумента = Формат(ВыборкаРезультата.ДатаДокумента, "ДФ='yyyy-MM-ddTHH:mm:ss'");
					СтрокаВозврата.НомерДокумента = ВыборкаРезультата.НомерДокумента;
				КонецЕсли; 		  				
				
				СтрокаТЗ = ПолучитьДанныеСФ(ВыборкаРезультата.Ссылка, ВыборкаРезультата.СчетФактура, ТаблСФ);
				
				Если ЗначениеЗаполнено(СтрокаТЗ.НомерДокумента) Тогда 
					СтрокаВозврата.НомерДокумента = СтрокаТЗ.НомерДокумента;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(СтрокаТЗ.ДатаДокумента) Тогда 
					СтрокаВозврата.ДатаДокумента = СтрокаТЗ.ДатаДокумента;
				КонецЕсли; 
				
				МассивДанных.Добавить(СтрокаВозврата);
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;	
	//-Сёмин Р.И. 27.03.2026 #UT10-5775
	
КонецПроцедуры

Функция ПолучитьДанныеСФ(Документ, СФ, ТЗ)
	
	//+Сёмин Р.И. 27.03.2026 #UT10-5775
	Строка = ТЗ.Найти(Документ);
	
	Если Строка = Неопределено Тогда
		
		Строка = ТЗ.Добавить();
		Строка.Документ = Документ;
		СчетФактура = СФ;
		
		Если ЗначениеЗаполнено(СчетФактура) Тогда
			
			Строка.НомерДокумента = ОбщегоНазначения.ПолучитьНомерНаПечать(СчетФактура) + " от " + Формат(СчетФактура.Дата, "ДФ='дд ММММ гггг'") + " г.";
			Строка.ДатаДокумента = Формат(СчетФактура.Дата, "ДФ='yyyy-MM-ddTHH:mm:ss'");
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Строка;
	//-Сёмин Р.И. 27.03.2026 #UT10-5775

КонецФункции


///////////////////Процедуры общие процедуры и функции///////////////////

// Взвращает Структуру с заданным количеством соответсвий по заданному запросу данных
// Параметры:
//			ВидСоответствия - Тип "Строка",  возможные значение "Номенклатура.НормализованныйКод", "РегистрСведений.СинонимыПроизводителей"
Функция ПолучитьСоответсвиеДанных(ВидСоответствия, МассивЗначенийОтбора, КоличествоСоответствий = 1)  
	
	СтруктураСоответсвий = Новый Структура;
	
	Для Счетчик = 0 по КоличествоСоответствий - 1 Цикл 
		СтруктураСоответсвий.Вставить("СоотвествиеДанных_" + Строка(Счетчик), Новый Соответствие);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапросаСоответсвия(ВидСоответствия);
	
	Запрос.Параметры.Вставить("МассивЗначенийОтбора", МассивЗначенийОтбора);
	ВыборкаДанных = Запрос.Выполнить().Выбрать(); 
	
	Пока ВыборкаДанных.Следующий() Цикл 
		
		Для Счетчик = 0 по КоличествоСоответствий - 1 Цикл 
			
			СоответсвиеДанных = СтруктураСоответсвий["СоотвествиеДанных_" + Строка(Счетчик)];
			СоответсвиеДанных.Вставить(СокрЛП(ВыборкаДанных["Ключ_" + Строка(Счетчик)]), ВыборкаДанных["Значение_" + Строка(Счетчик)]);
			
		КонецЦикла;	
		
	КонецЦикла;	
		
    Возврат СтруктураСоответсвий;
	
КонецФункции

Функция ПолучитьТекстЗапросаСоответсвия(ВидСоответствия)  
	
	ТекстЗапроса = "";
	
	Если ВидСоответствия = "Номенклатура.НормализованныйКод" Тогда 
		
		ТекстЗапроса = "
		|ВЫБРАТЬ
		|	Номенклатура.НормализованныйКод КАК Ключ_0,
		|	Номенклатура.Ссылка КАК Значение_0
		|	//Номенклатура.Артикул КАК Ключ_1,	// второй ключ для второго соответсвия
		|	//Номенклатура.Ссылка КАК Значение_1  // второе значение для второго соответсвия 
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	НЕ Номенклатура.ПометкаУдаления
		|	И НЕ Номенклатура.ЭтоГруппа
		|	И Номенклатура.НормализованныйКод В(&МассивЗначенийОтбора)";
		
	ИначеЕсли ВидСоответствия = "Номенклатура.Артикул" Тогда 
		
		ТекстЗапроса = "
		|ВЫБРАТЬ
		|	Номенклатура.Артикул КАК Ключ_0,
		|	Номенклатура.Ссылка КАК Значение_0
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	НЕ Номенклатура.ПометкаУдаления
		|	И НЕ Номенклатура.ЭтоГруппа
		|	И Номенклатура.Артикул В(&МассивЗначенийОтбора)"; 	
		
	ИначеЕсли ВидСоответствия = "РегистрСведений.СинонимыПроизводителей" Тогда 
		
		ТекстЗапроса = "
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СинонимыПроизводителей.СинонимПроизводителя КАК Ключ_0,
		|	СинонимыПроизводителей.Производитель КАК Значение_0
		|ИЗ
		|	РегистрСведений.СинонимыПроизводителей КАК СинонимыПроизводителей
		|ГДЕ
		|	СинонимыПроизводителей.СинонимПроизводителя В(&МассивЗначенийОтбора)";
		
	КонецЕсли;	
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ПреобразоватьДатуМДМ(СтроковаяДата) Экспорт   
	
	СтроковаяДата = СтрЗаменить(СтроковаяДата , "-", "");   
	СтроковаяДата = СтрЗаменить(СтроковаяДата , ":", "");  
	СтроковаяДата = СтрЗаменить(СтроковаяДата , "T", "");  
	
	Возврат Дата(СтроковаяДата); 
	
КонецФункции      

Функция СтрокаВДату(Знач ДатаСтрока) 
	
	ДатаСтрока = Лев(СОКРЛП(ДатаСтрока), 10);
	
	СначалаГод = Найти("0123456789", Сред(ДатаСтрока, 3, 1)) > 0;
	
	ДатаСтрока = СокрЛП(СтрЗаменить(ДатаСтрока, ".", "")); 
	ДатаСтрока = СтрЗаменить(ДатаСтрока, "-", "");
	ДатаСтрока = СтрЗаменить(ДатаСтрока, "/", "");
	ДатаСтрока = СтрЗаменить(ДатаСтрока, "\", "");
	
	Если СначалаГод Тогда 
		ДатаСтрока = Лев(ДатаСтрока, 4) + Сред(ДатаСтрока, 5, 2) + Прав(ДатаСтрока, 2);  
	Иначе
		ДатаСтрока = Сред(ДатаСтрока, 5) + Сред(ДатаСтрока, 3, 2) + Лев(ДатаСтрока, 2);  
	
		Если СтрДлина(ДатаСтрока) = 6 Тогда
			ДатаСтрока = "20" + ДатаСтрока;
		КонецЕсли;    
		
	КонецЕсли;
	
	ОписаниеТипа = Новый ОписаниеТипов("Дата");
	Результат    = ОписаниеТипа.ПривестиЗначение(ДатаСтрока);
	
	Возврат Результат;
	
КонецФункции    

Функция СтрокаВБулево(Знач ЗначСтрока) 
	
	Если ПустаяСтрока(ЗначСтрока) Или ЗначСтрока = "0" Тогда 
		Возврат Ложь;
		
	ИначеЕсли ЗначСтрока = "1" Тогда  
		Возврат Истина;
	Иначе
	
		Попытка
			ЗначБулево = Булево(ЗначСтрока);
		Исключение
		    ЗначБулево = Ложь;
		КонецПопытки;
		
		Возврат ЗначБулево;
		
	КонецЕсли;

КонецФункции   

Функция ДвоичноеВДесятичное(Знач Стр2) 
	
	Стр = СокрЛП(Стр2);
	Рез = 0;
	
	Для Н = 1 по СтрДлина(Стр) Цикл
		Рез = Рез * 2 + Число(Сред(Стр, Н, 1));
	КонецЦикла;
	
	Возврат Рез;
	
КонецФункции   

Функция ВернутьСоответсвиеИзJSON(Строка) Экспорт
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Строка);
	
	Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
	
	Возврат Данные;
	
КонецФункции

Функция ПолучитьСтруктуруИзСоответствия(СоответвиеИсточник) Экспорт
	
	СтруктураВозврат = Новый Структура;
	
	Если ТипЗнч(СоответвиеИсточник) = Тип("Соответствие") Или ТипЗнч(СоответвиеИсточник) = Тип("ФиксированноеСоответствие") Тогда
				
		Для Каждого КлючЗначение Из СоответвиеИсточник Цикл   
			СтруктураВозврат.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение); 
		КонецЦикла;    
		
	ИначеЕсли ТипЗнч(СоответвиеИсточник) = Тип("Структура") Тогда 
		СтруктураВозврат = СоответвиеИсточник;
	КонецЕсли;
	
	Возврат СтруктураВозврат; 
	
КонецФункции

Функция ПолучитьПоляСтруктурыВыходныхПараметров(СтруктураПараметоровМетода)
	
	СтрокеПолей = "";
	
	Для Каждого ЭлементПоля Из СтруктураПараметоровМетода.СоответсвиеВыходныхПарамтров Цикл 
		
		Если СтрокеПолей <> "" Тогда
			СтрокеПолей = СтрокеПолей + ",";
		КонецЕсли;
		
		СтрокеПолей = СтрокеПолей + ЭлементПоля.Значение;
		
	КонецЦикла;	  
	
	Возврат СтрокеПолей;
	
КонецФункции			

Функция ПолучитьОписаниеПараметровЗапроса(ПараметрыЗапроса)
	
	ПараметрыСтр = "Параметры: ";
	
	Для каждого КлючЗначение Из ПараметрыЗапроса Цикл
		ПараметрыСтр = ПараметрыСтр + КлючЗначение.Ключ + "=" + КлючЗначение.Значение + Символы.ПС;
	КонецЦикла;		
	
	Возврат ПараметрыСтр;

КонецФункции 

///////////////////Вспомогательные процедуры /////////////////// 

Функция ПреобразованиеМассивВТаблицуЗначений(Массив)

   // Создаем новую пустую таблицу значений
   ТЗ = Новый ТаблицаЗначений;

   // Обрабатываем каждую строку (структуру) в массиве
   Для Каждого СтрокаМассива Из Массив Цикл

       // Если таблица еще не имеет колонок (первая строка)
       Если ТЗ.Колонки.Количество() = 0 Тогда
           // Создаем колонки на основе ключей первой структуры
           Для Каждого ЭлементМассива Из СтрокаМассива Цикл
               // Добавляем колонку с именем ключа структуры
               ТЗ.Колонки.Добавить(ЭлементМассива.Ключ);
           КонецЦикла;
       КонецЕсли;

       // Добавляем новую строку в таблицу
       НоваяСтрока = ТЗ.Добавить();

       // Заполняем значения строки из структуры
       Для Каждого ЭлементМассива Из СтрокаМассива Цикл
           // Устанавливаем значение в соответствующую колонку
           НоваяСтрока[ЭлементМассива.Ключ] = ЭлементМассива.Значение;
       КонецЦикла;

   КонецЦикла;

   // Возвращаем сформированную таблицу значений
   Возврат ТЗ;

КонецФункции

//Перенесена из МСКWEB.ПустойСтороннийСклад
Функция ПустойСтороннийСклад(НовыйДокЗаказ)
	Результат = Ложь;
	
	// Проверяем значение НовыйДокЗаказ.IDСклада, что это Собственный Склад	
	Если НЕ ЗначениеЗаполнено(НовыйДокЗаказ.IDСклада_СтороннийСклад)  Тогда
		Результат = МСК.ЭтоСтороннийСклад(НовыйДокЗаказ.IDСклада);		
		Если НЕ Результат Тогда
			Возврат Результат;
		КонецЕсли; 
	КонецЕсли; 
	
	
	Если  ЗначениеЗаполнено(НовыйДокЗаказ.IDСклада) И НЕ ЗначениеЗаполнено(НовыйДокЗаказ.IDСклада_СтороннийСклад)
		И Константы.НеСоздаватьСтороннийСклад.Получить() Тогда
		Результат = Истина;	   
	КонецЕсли;		
	
	
	Возврат Результат;
КонецФункции

//МСКWEB.СоздатьНовуюНоменклатуру - аналогична
Функция СоздатьНоменклатуру(ДаннныеТовара, НоменклатураРодитель, Товар, ЭтоНашТовар, Комментарий = "", EMailЗаказ = Ложь) Экспорт
	
	Если EMailЗаказ Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Попытка  
		
		Если НоменклатураРодитель = Справочники.Номенклатура.ПустаяСсылка() Тогда    
			
			ИскомаяГруппа = Справочники.Номенклатура.НайтиПоНаименованию(ВРег(ДаннныеТовара.Родитель), Истина); 
			
			Если ИскомаяГруппа = Неопределено Тогда   
				
				НоменклатураРодитель = Справочники.Номенклатура.СоздатьГруппу();
				НоменклатураРодитель.ВидНоменклатуры 	= Константы.ВидНоменклатурыПоУмолчанию.Получить();
				НоменклатураРодитель.Наименование 		= ВРег(ДаннныеТовара.Родитель);
				НоменклатураРодитель.ДополнительныеСвойства.Вставить("ПропуститьПроверкуAMQP", Истина);	
				НоменклатураРодитель.Записать();  
				
			Иначе 
				НоменклатураРодитель = ИскомаяГруппа;
			КонецЕсли;   
			
		КонецЕсли;
		
		НовыйЭлемент = Справочники.Номенклатура.СоздатьЭлемент();
		НовыйЭлемент.ВестиУчетПоСериям 				= Истина;
		НовыйЭлемент.Наименование 					= ДаннныеТовара.Наименование;
		НовыйЭлемент.ВидНоменклатуры 				= Константы.ВидНоменклатурыПоУмолчанию.Получить();
		//+Гавриленков В. 05.12.2025 #UT10-5574
		//НовыйЭлемент.СтавкаНДС 						= Перечисления.СтавкиНДС.НДС20;
		НовыйЭлемент.СтавкаНДС 						= ?(ТекущаяДата() >= Дата("20260101000000"), Перечисления.СтавкиНДС.НДС22, Перечисления.СтавкиНДС.НДС20);
		//-Гавриленков В. 05.12.2025 #UT10-5574

		Если НЕ ЭтоНашТовар Тогда 
			НовыйЭлемент.НаименованиеПолное = СтрЗаменить(ДаннныеТовара.КодПроизводителя + " " + ДаннныеТовара.Наименование, "'" , "");	
		Иначе
			НовыйЭлемент.НаименованиеПолное = ДаннныеТовара.КодПроизводителя + " " + ДаннныеТовара.Наименование;
		КонецЕсли;

		НовыйЭлемент.КодПроизводителя				= ДаннныеТовара.КодПроизводителя;
		НовыйЭлемент.ВестиПартионныйУчетПоСериям 	= Истина;
		НовыйЭлемент.БазоваяЕдиницаИзмерения 		= Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796");
		НовыйЭлемент.Комментарий 					= Комментарий;
		НовыйЭлемент.НеПодлежитВозврату 			= Ложь; 
		НовыйЭлемент.Кратность 						= 1;
		НовыйЭлемент.Родитель 						= НоменклатураРодитель.Ссылка;
		
		Если ЭтоНашТовар Тогда  
			
			НовыйЭлемент.Артикул                    = СокрЛП(ДаннныеТовара.Артикул);
			НовыйЭлемент.КодПоБазеМоскоречье        = СокрЛП(ДаннныеТовара.Артикул);   
			
		КонецЕсли;
		
		НовыйЭлемент.НоменклатурнаяГруппа = Справочники.НоменклатурныеГруппы.Прочее;
		НовыйЭлемент.ДополнительныеСвойства.Вставить("ПропуститьПроверкуAMQP", Истина);	
		НовыйЭлемент.Записать();
		
		НоваяЕдиница 							= Справочники.ЕдиницыИзмерения.СоздатьЭлемент();
		НоваяЕдиница.Владелец 					= НовыйЭлемент.Ссылка ;
		НоваяЕдиница.Наименование 				= НовыйЭлемент.БазоваяЕдиницаИзмерения.Наименование;
		НоваяЕдиница.ЕдиницаПоКлассификатору 	= НовыйЭлемент.БазоваяЕдиницаИзмерения;
		НоваяЕдиница.Коэффициент 				= 1;
		НоваяЕдиница.ДополнительныеСвойства.Вставить("ПропуститьПроверкуAMQP", Истина);	
		НоваяЕдиница.Записать();
		
		НовыйЭлемент.ЕдиницаХраненияОстатков	= НоваяЕдиница.Ссылка;
		НовыйЭлемент.ЕдиницаДляОтчетов			= НоваяЕдиница.Ссылка;
		НовыйЭлемент.ЕдиницаИзмеренияМест       = НоваяЕдиница.Ссылка;
		НовыйЭлемент.ДополнительныеСвойства.Вставить("ПропуститьПроверкуAMQP",Истина);	
		НовыйЭлемент.Записать();
		
		Товар = НовыйЭлемент.Ссылка;
		Возврат Истина;     
		
	Исключение    
		
		Товар = Неопределено;
		Возврат Ложь;
		
	КонецПопытки; 
	
КонецФункции

Функция НайтиКонтрагентаOnlineStore(ПараметрыЗапроса, СтруктураВозврата, ТекстОшибки)
	
	Если Не ПараметрыЗапроса.Свойство("ИдентификаторКонтрагента") Или ПустаяСтрока(ПараметрыЗапроса.ИдентификаторКонтрагента) Тогда  
		
		СтруктураВозврата.Сообщение = ТекстОшибки + "Причина: не задан параметр запроса ИдентификаторКонтрагента";
		Возврат Справочники.Контрагенты.ПустаяСсылка();
	
	КонецЕсли;
	
	ИдентификаторКонтрагента = СтрЗаменить(СокрЛП(ПараметрыЗапроса.ИдентификаторКонтрагента), Символы.НПП, "");
	
	Если СтрДлина(ИдентификаторКонтрагента) = 36 Тогда  
		РеквизитПоиска = "КодМДМ";
	Иначе
		РеквизитПоиска = "IDАварда";
	КонецЕсли;	   
	
	Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту(РеквизитПоиска, ИдентификаторКонтрагента);
	
	Если Контрагент.Пустая() Тогда               
		СтруктураВозврата.Сообщение = ТекстОшибки + "Причина: не найден контрагент по идентификатору " + ПараметрыЗапроса.ИдентификаторКонтрагента;
	КонецЕсли;  
	
	Возврат Контрагент;

КонецФункции // ()

Функция ПолучитьДокументПоИдентификатору(ИмяДокумента, ИдентификаторДокумента)

	Попытка
	
		ГУИД = Новый УникальныйИдентификатор(ИдентификаторДокумента);
		ДокСсылка = Документы[ИмяДокумента].ПолучитьСсылку(ГУИД);
		
		Если ДокСсылка.ПолучитьОбъект() = Неопределено Тогда
			ДокСсылка = Документы[ИмяДокумента].ПустаяСсылка();
		КонецЕсли;
		
	Исключение  
		ДокСсылка = Документы[ИмяДокумента].ПустаяСсылка();
	КонецПопытки;
	
    Возврат ДокСсылка;
	
КонецФункции // ()

// перенесена из МСКWEB.ЕстьСборка
Функция ЕстьСборка(Заказ) 
	
	ЕстьСборка = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СУММА(СобраноПоЗаказуОбороты.КоличествоОборот) КАК Количество
	|ИЗ
	|	РегистрНакопления.СобраноПоЗаказу.Обороты(, , , Заказ = &Заказ) КАК СобраноПоЗаказуОбороты";
	
	Запрос.УстановитьПараметр("Заказ", Заказ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Если Выборка.Количество <> NULL И Выборка.Количество > 0 Тогда
			ЕстьСборка = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ЕстьСборка;
	
КонецФункции

// перенесена из МСКWEB.ЕстьЗаказПоставщику
Функция ЕстьЗаказПоставщику(Заказ) 
	
	ЕстьЗаказ = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СУММА(РазмещениеЗаказовПокупателейОбороты.КоличествоПриход) КАК Количество
	|ИЗ
	|	РегистрНакопления.РазмещениеЗаказовПокупателей.Обороты(, , , ЗаказПокупателя = &Заказ) КАК РазмещениеЗаказовПокупателейОбороты";
	
	Запрос.УстановитьПараметр("Заказ", Заказ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Если Выборка.Количество <> NULL И Выборка.Количество > 0 Тогда
			ЕстьЗаказ = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
