Функция ЗаблокироватьРеализацию(ПараметрыЗапроса)   
	
	СтруктураВозврата = Новый Структура("Результат, Данные, Сообщение", Ложь, Неопределено, "");    
	
	Если Не ПараметрыЗапроса.Свойство("ИдентификаторДокумента") Или ПустаяСтрока(ПараметрыЗапроса.ИдентификаторДокумента) Тогда
		
		СтруктураВозврата.Сообщение = "Не задан параметр запроса ИдентификаторДокумента";
		Возврат СтруктураВозврата;
	
	КонецЕсли; 
	
	ИдентификаторДокумента = СокрЛП(ПараметрыЗапроса.ИдентификаторДокумента); 
	Реализация = ПолучитьДокументПоИдентификатору("РеализацияТоваровУслуг", ИдентификаторДокумента);
	
	Если Реализация.Пустая() Тогда   
		
		СтруктураВозврата.Сообщение = "В базе УТ не найдена реализация с идентификатором";	
		Возврат СтруктураВозврата;
		
	КонецЕсли;
	
	СтатусЗаблокировано = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
	СтатусЗаблокировано.Отбор.Объект.Установить(Реализация);
	СтатусЗаблокировано.Отбор.Свойство.Установить(ПланыВидовХарактеристик.СвойстваОбъектов.ЗаблокированоДляОплаты);
	
	УстановитьПривилегированныйРежим(Истина);	
	СтатусЗаблокировано.Прочитать();
	
	Если СтатусЗаблокировано.Количество() = 0 Тогда   
		
		НовыйСтатусЗаблокировано = СтатусЗаблокировано.Добавить();
		НовыйСтатусЗаблокировано.Объект = Реализация;
		НовыйСтатусЗаблокировано.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.ЗаблокированоДляОплаты;  
		
	Иначе
		НовыйСтатусЗаблокировано = СтатусЗаблокировано[0];
	КонецЕсли;
	
	НовыйСтатусЗаблокировано.Значение = Истина;
	СтатусЗаблокировано.Записать();
	УстановитьПривилегированныйРежим(Ложь);		
	
	СтруктураВозврата.Результат = Истина;
	
	Возврат СтруктураВозврата;

КонецФункции


