Функция ПолучитьДоступныеНоменклатурыДляВозвратаСервер(ПараметрыСоответсвие) Экспорт
	
	//+Сёмин Р.И. 26.03.2026 #UT10-5775
	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ПараметрыСтруктура = ПолучитьСтруктуруИзСоответствия(ПараметрыСоответсвие);
	
	ПараметрыЗапросаСтр = ПолучитьОписаниеПараметровЗапроса(ПараметрыСтруктура);
	
	ЗаписьЖурналаРегистрации(
		"HTTP-сервис OnlineStore.nom_for_return.ПолучитьНоменклатурыДляВозврата",
		УровеньЖурналаРегистрации.Информация,
		,
		,
		"HTTP-сервис:Запуск. ПолучитьНоменклатурыДляВозврата. " + ПараметрыЗапросаСтр
	);
		
	СтруктураВозврата = ПолучитьДоступныеНоменклатурыДляВозврата(ПараметрыСтруктура);
	
	ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ЗаписьЖурналаРегистрации(
		"HTTP-сервис OnlineStore.nom_for_return.ПолучитьНоменклатурыДляВозврата",
		УровеньЖурналаРегистрации.Информация,
		,
		,
		"HTTP-сервис:Завершение. ПолучитьНоменклатурыДляВозврата. "  + Формат(ВремяОкончанияUTC - ВремяНачалаUTC, "ЧН=0; ЧГ=0") + " м.сек." + ПараметрыЗапросаСтр
	);
	
	Возврат СтруктураВозврата;
	//-Сёмин Р.И. 26.03.2026 #UT10-5775
	
КонецФункции

Функция ПолучитьДоступныеНоменклатурыДляВозврата(ПараметрыЗапроса)
	
	//+Сёмин Р.И. 26.03.2026 #UT10-5775
	СтруктураВозврата = Новый Структура(
		"Результат,Данные,Сообщение",
		Ложь,
		Неопределено,
		""
	);
	
	СтрокаПараметров = "ГУИДРТУ,НомерДокумента,ДатаДокумента,НаименованиеФилиала,Комментарий,НаименованиеДоговора,НаименованиеСклада,ЮрЛицо,НаименованиеОрганизации,ИнвНомер,НаименованиеВалюта," +
						"КоэффициентНомеклатуры,Количество,ЦенаСНДС,КомментарийНоменклатуры,СуммаСНДС,КодПроизводителя,НаименованиеНоменклатура,Бренд,НаименованиеЕдиницаХранения,КоличествоДляВозврата,НомерСтроки,ДействияСЗаказом";
	
	МассивДанных = Новый Массив;
	
	Если НЕ ПараметрыЗапроса.Свойство("ДатаНачала") ИЛИ НЕ ЗначениеЗаполнено(ПараметрыЗапроса.ДатаНачала) Тогда
		
		СтруктураВозврата.Сообщение = "Данные по номенклатуре для возврата не получены. Причина: не задан параметр ДатаНачала";
		Возврат СтруктураВозврата;
		
	КонецЕсли;   
	
	Если НЕ ПараметрыЗапроса.Свойство("ДатаОкончания") ИЛИ НЕ ЗначениеЗаполнено(ПараметрыЗапроса.ДатаОкончания) Тогда
		
		СтруктураВозврата.Сообщение = "Данные по номенклатуре для возврата не получены. Причина: не задан параметр ДатаОкончания";
		Возврат СтруктураВозврата;
		
	КонецЕсли;  
	
	Если НЕ ПараметрыЗапроса.Свойство("ИдентификаторКонтрагента") ИЛИ НЕ ЗначениеЗаполнено(ПараметрыЗапроса.ИдентификаторКонтрагента) Тогда
		
		Если НЕ ПараметрыЗапроса.Свойство("ГУИДДокумента") ИЛИ НЕ ЗначениеЗаполнено(ПараметрыЗапроса.ГУИДДокумента) Тогда
			
			СтруктураВозврата.Сообщение = "Данные по номенклатуре для возврата не получены. Причина: надо указать ИдентификаторКонтрагента или ГУИДДокумента";
			Возврат СтруктураВозврата;
			
		КонецЕсли;
		
	КонецЕсли; 
	
	пДатаНачалаОтчета = СтрокаВДату(ПараметрыЗапроса.ДатаНачала);
	пДатаКонцаОтчета = СтрокаВДату(ПараметрыЗапроса.ДатаОкончания);
	
	Если ПараметрыЗапроса.Свойство("ИдентификаторКонтрагента") Тогда
		пКодКонтрагентаПортал = ПараметрыЗапроса.ИдентификаторКонтрагента;
	Иначе
		пКодКонтрагентаПортал = "";
	КонецЕсли;
	
	Если ПараметрыЗапроса.Свойство("ГУИДДокумента") Тогда
		пГУИДДокумента = СокрЛП(ПараметрыЗапроса.ГУИДДокумента);
	Иначе
		пГУИДДокумента = "";
	КонецЕсли;
	
	Если ПараметрыЗапроса.Свойство("Артикул") Тогда
		пАртикулТовара = ПараметрыЗапроса.Артикул;
	Иначе
		пАртикулТовара = "";
	КонецЕсли;
	
	Если ПараметрыЗапроса.Свойство("Филиалы") Тогда
		пФилиалы = СокрЛП(ПараметрыЗапроса.Филиалы);
	Иначе
		пФилиалы = "";
	КонецЕсли;
	
	пСписокФилиалов = Новый Массив;
	ИскатьФилиалыПоКодуМДМ = Ложь;
	
	Если ЗначениеЗаполнено(пФилиалы) Тогда
		
		пСписокФилиалов = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(СокрЛП(пФилиалы), ",");
		ИскатьФилиалыПоКодуМДМ = (пСписокФилиалов.Количество() > 0 И СтрДлина(пСписокФилиалов[0]) = 36);
		
	КонецЕсли;
	
	ИДАвардаКонтрагента = СтрЗаменить(СокрЛП(пКодКонтрагентаПортал), Символы.НПП, "");
	
	ИскатьПоКодуМДМ = СтрДлина(ИДАвардаКонтрагента) = 36;
	
	Если ЗначениеЗаполнено(ИДАвардаКонтрагента) Тогда
		
		Если ИскатьПоКодуМДМ Тогда
			пКонтрагент = Справочники.Контрагенты.НайтиПоРеквизиту("КодМДМ", ИДАвардаКонтрагента);
		Иначе
			пКонтрагент = Справочники.Контрагенты.НайтиПоРеквизиту("IDАварда", ИДАвардаКонтрагента);
		КонецЕсли;
		
	Иначе
		пКонтрагент = Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(пГУИДДокумента) Тогда
		ДокументРеализации = ПолучитьДокументПоИдентификатору("РеализацияТоваровУслуг", Новый УникальныйИдентификатор(пГУИДДокумента));
	Иначе
		ДокументРеализации = Документы.РеализацияТоваровУслуг.ПустаяСсылка();
	КонецЕсли;
	
	Если НЕ пКонтрагент.Пустая() ИЛИ пСписокФилиалов.Количество() <> 0 ИЛИ ЗначениеЗаполнено(ДокументРеализации) Тогда
		
		ТаблСФ = Новый ТаблицаЗначений;
		ТаблСФ.Колонки.Добавить("Документ");
		ТаблСФ.Колонки.Добавить("ДатаДокумента");
		ТаблСФ.Колонки.Добавить("НомерДокумента");
		
		
		ЗапросЗаказовПоСтатусам = Новый Запрос;
		ЗапросЗаказовПоСтатусам.Текст = ПолучитьТекстЗапросаДоступныеНоменклатурыДляВозврата(ИскатьПоКодуМДМ, ИскатьФилиалыПоКодуМДМ);
		
		ЗапросЗаказовПоСтатусам.УстановитьПараметр("ДатаНач", ?(ЗначениеЗаполнено(пДатаНачалаОтчета), НачалоДня(пДатаНачалаОтчета), НачалоДня(ТекущаяДата() - 86400 * 14)));
		ЗапросЗаказовПоСтатусам.УстановитьПараметр("ДатаКон", ?(ЗначениеЗаполнено(пДатаКонцаОтчета), КонецДня(пДатаКонцаОтчета), КонецДня(ТекущаяДата())));
		ЗапросЗаказовПоСтатусам.УстановитьПараметр("IDАварда", ИДАвардаКонтрагента);
		ЗапросЗаказовПоСтатусам.УстановитьПараметр("СписокИД", пСписокФилиалов);
		ЗапросЗаказовПоСтатусам.УстановитьПараметр("Артикул", ?(СокрЛП(пАртикулТовара) <> "", "%" + пАртикулТовара + "%", ""));
		ЗапросЗаказовПоСтатусам.УстановитьПараметр("АртикулНормализованный", ?(СокрЛП(пАртикулТовара) <> "", "%" + СтрЗаменить(СтрЗаменить(пАртикулТовара, " ", ""), "-", "") + "%", ""));
		ЗапросЗаказовПоСтатусам.УстановитьПараметр("ГУИДДокумента", пГУИДДокумента);
		ЗапросЗаказовПоСтатусам.УстановитьПараметр("ПоСпискуФилиалов", пСписокФилиалов.Количество() > 0);
		ЗапросЗаказовПоСтатусам.УстановитьПараметр("ДокументРеализации", ДокументРеализации);
		ЗапросЗаказовПоСтатусам.УстановитьПараметр("Грузополучатель", ДокументРеализации.Грузополучатель);
		ЗапросЗаказовПоСтатусам.УстановитьПараметр("Контрагент", ДокументРеализации.Контрагент);
		
		РезультатЗапросаЗаказовПоСтатусам = ЗапросЗаказовПоСтатусам.Выполнить();
		
		Если НЕ РезультатЗапросаЗаказовПоСтатусам.Пустой() Тогда
			ОбработатьЗапросПоДоступнымНоменклатурамДляВозврата(РезультатЗапросаЗаказовПоСтатусам, СтрокаПараметров, МассивДанных, ТаблСФ);
		КонецЕсли;
		
	КонецЕсли;
	
	СтруктураВозврата.Результат = Истина;
	СтруктураВозврата.Данные = МассивДанных;
	
	Возврат СтруктураВозврата;
	//-Сёмин Р.И. 26.03.2026 #UT10-5775
	
КонецФункции

