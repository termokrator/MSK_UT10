	 |;
	 |
	 |////////////////////////////////////////////////////////////////////////////////
	 |ВЫБРАТЬ
	 |	ВТ_РТУ.Реализация,
	 |	РеализацияТоваровУслугТовары.Номенклатура,
	 |	РеализацияТоваровУслугТовары.НомерСтроки,
	 |	РеализацияТоваровУслугТовары.ЕдиницаИзмерения,
	 |	РеализацияТоваровУслугТовары.Количество,
	 |	РеализацияТоваровУслугТовары.Цена,
	 |	ВТ_РТУ.КоличествоДнейДляВозврата,
	 |	РеализацияТоваровУслугТовары.ЗаказПокупателя,
	 |	РеализацияТоваровУслугТовары.ЗаказПокупателя.IDСклада_СтороннийСклад КАК СтороннийСклад,
	 |	ВТ_РТУ.ИстекСрокВозврата,
	 |	РеализацияТоваровУслугТовары.Сумма,
	 |	РеализацияТоваровУслугТовары.СтавкаНДС
	 |ПОМЕСТИТЬ ВТ_РТУизБазы
	 |ИЗ
	 |	ВТ_РТУ КАК ВТ_РТУ
	 |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	 |		ПО ВТ_РТУ.Реализация = РеализацияТоваровУслугТовары.Ссылка
	 |;
	 |
	 |////////////////////////////////////////////////////////////////////////////////
	 |ВЫБРАТЬ
	 |	ВТ_РТУизЗапроса.Реализация,
	 |	ВТ_РТУизЗапроса.ИдентификаторДокумента,
	 |	ВТ_РТУизЗапроса.НомСтр,
	 |	ВЫБОР
	 |		КОГДА ВТ_РТУизБазы.Реализация ЕСТЬ NULL
	 |			ТОГДА ""Не найдена строка реализации номер ==НомерСтроки==""
	 |		КОГДА ВТ_РТУизЗапроса.Количество > ЕСТЬNULL(ВТ_РТУизБазы.Количество, 0)
	 |			ТОГДА ""Количество в запросе превышает количество в реализации - ==КоличествоДок====НомерСтроки==""
	 |		ИНАЧЕ """"
	 |	КОНЕЦ КАК ТекстОшибки,
	 |	ВЫБОР
	 |		КОГДА ВТ_РТУизБазы.Реализация ЕСТЬ NULL
	 |			ТОГДА ЛОЖЬ
	 |		ИНАЧЕ ИСТИНА
	 |	КОНЕЦ КАК ДокументНайден,
	 |	ВТ_РТУизБазы.Номенклатура,
	 |	ВТ_РТУизБазы.НомерСтроки,
	 |	ВТ_РТУизБазы.ЕдиницаИзмерения,
	 |	ВТ_РТУизЗапроса.Количество КАК Количество,
	 |	ЕСТЬNULL(ВТ_РТУизБазы.Цена, 0) КАК Цена,
	 |	ВТ_РТУизБазы.СтороннийСклад,
	 |	ВТ_РТУизБазы.ИстекСрокВозврата,
	 |	ВТ_РТУизЗапроса.ПричинаВозврата,
	 |	ВТ_РТУизЗапроса.Комментарий,
	 //+Сёмин Р.И. 18.03.2026 #UT10-5766
	 |	ВТ_РТУизЗапроса.ЭлПочтаКлиента,
	 //-Сёмин Р.И. 18.03.2026 #UT10-5766
	 |	ЕСТЬNULL(ВТ_РТУизБазы.Количество, 0) КАК КоличествоДок,
	 |	ЕСТЬNULL(ВТ_РТУизБазы.Сумма, 0) КАК Сумма,
	 |	ВТ_РТУизБазы.ЗаказПокупателя
	 |ПОМЕСТИТЬ ВТ_Реализация
	 |ИЗ
	 |	ВТ_РТУизЗапроса КАК ВТ_РТУизЗапроса
	 |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РТУизБазы КАК ВТ_РТУизБазы
	 |		ПО ВТ_РТУизЗапроса.Реализация = ВТ_РТУизБазы.Реализация
	 |			И ВТ_РТУизЗапроса.НомСтр = ВТ_РТУизБазы.НомерСтроки
	 |;
	 |
	 |////////////////////////////////////////////////////////////////////////////////
	 |ВЫБРАТЬ
	 |	ВТ_Реализация.Реализация,
	 |	ВТ_Реализация.Номенклатура,
	 |	ВТ_Реализация.Количество,
	 |	ВТ_Реализация.НомерСтроки,
	 |	СУММА(ЕСТЬNULL(ЗаявкиНаВозврат.Количество, 0)) КАК ЗаявкиНаВозврат_Количество,
	 |	ЕСТЬNULL(ЗаявкиНаВозврат.НомерСтрокиИзРТУ, 0) КАК НомерСтрокиИзРТУ
	 |ПОМЕСТИТЬ ВТ_ЗаявкиНаВозврат
	 |ИЗ
	 |	ВТ_Реализация КАК ВТ_Реализация
	 |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаВозврат.Товары КАК ЗаявкиНаВозврат
	 |		ПО (ВТ_Реализация.ДокументНайден)
	 |			И ВТ_Реализация.Реализация = ЗаявкиНаВозврат.Ссылка.Реализация
	 |			И ВТ_Реализация.Номенклатура = ЗаявкиНаВозврат.Номенклатура
	 |			И ВТ_Реализация.НомерСтроки = ЗаявкиНаВозврат.НомерСтрокиИзРТУ
	 |			И (ЗаявкиНаВозврат.Ссылка.Статус <> ""Отменен"")
	 |			И (ЗаявкиНаВозврат.Ссылка.ПометкаУдаления = ЛОЖЬ)
	 |
	 |СГРУППИРОВАТЬ ПО
	 |	ВТ_Реализация.Реализация,
	 |	ВТ_Реализация.Номенклатура,
	 |	ВТ_Реализация.НомерСтроки,
	 |	ВТ_Реализация.Количество,
	 |	ЕСТЬNULL(ЗаявкиНаВозврат.НомерСтрокиИзРТУ, 0)
	 |;
	 |
	 |////////////////////////////////////////////////////////////////////////////////
	 |ВЫБРАТЬ
	 |	ВТ_Реализация.Реализация КАК Реализация,
	 |	ВТ_Реализация.Номенклатура,
	 |	ВТ_Реализация.Цена,
	 |	ВТ_Реализация.Количество,
	 |	ВЫБОР
	 |		КОГДА ВТ_Реализация.КоличествоДок > 0
	 |			ТОГДА ВТ_Реализация.Количество / ВТ_Реализация.КоличествоДок * ВТ_Реализация.Сумма
	 |		ИНАЧЕ ВТ_Реализация.Количество * ВТ_Реализация.Цена
	 |	КОНЕЦ КАК Сумма,
	 |	ВТ_Реализация.НомерСтроки,
	 |	ВТ_Реализация.КоличествоДок - ЕСТЬNULL(ЗаявкиНаВозврат.ЗаявкиНаВозврат_Количество, 0) КАК КоличествоДляВозврата,
	 |	ЗаявкиНаВозврат.ЗаявкиНаВозврат_Количество КАК ЗаявкиНаВозврат_Количество,
	 |	ВТ_Реализация.СтороннийСклад КАК СтороннийСклад,
	 |	ВТ_Реализация.ИдентификаторДокумента КАК ИдентификаторДокумента,
	 |	ВТ_Реализация.НомСтр,
	 |	ВТ_Реализация.ТекстОшибки,
	 |	ВТ_Реализация.ЕдиницаИзмерения,
	 |	ВТ_Реализация.ИстекСрокВозврата КАК ИстекСрокВозврата,
	 |	ВЫБОР
	 |		КОГДА ВТ_Реализация.Количество > ВТ_Реализация.КоличествоДок - ЕСТЬNULL(ЗаявкиНаВозврат.ЗаявкиНаВозврат_Количество, 0)
	 |			ТОГДА ИСТИНА
	 |		ИНАЧЕ ЛОЖЬ
	 |	КОНЕЦ КАК НедостаточноКоличества,
	 |	ВТ_Реализация.ПричинаВозврата,
	 |	ВТ_Реализация.Комментарий,
	 //+Сёмин Р.И. 18.03.2026 #UT10-5766
	 |	ВТ_Реализация.ЭлПочтаКлиента,
	 //-Сёмин Р.И. 18.03.2026 #UT10-5766
	 |	ВТ_Реализация.ЗаказПокупателя,
	 |	ВТ_Реализация.КоличествоДок
	 |ИЗ
	 |	ВТ_Реализация КАК ВТ_Реализация
	 |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗаявкиНаВозврат КАК ЗаявкиНаВозврат
	 |		ПО (ВТ_Реализация.ДокументНайден)
	 |			И ВТ_Реализация.Реализация = ЗаявкиНаВозврат.Реализация
	 |			И ВТ_Реализация.Номенклатура = ЗаявкиНаВозврат.Номенклатура
	 |			И ВТ_Реализация.НомерСтроки = ЗаявкиНаВозврат.НомерСтрокиИзРТУ
	 |			И (ЗаявкиНаВозврат.НомерСтрокиИзРТУ > 0)
	 |ИТОГИ
	 |	МАКСИМУМ(ИдентификаторДокумента),
	 //+Сёмин Р.И. 18.03.2026 #UT10-5766
	 |	МАКСИМУМ(ЭлПочтаКлиента),
	 //-Сёмин Р.И. 18.03.2026 #UT10-5766
	 |	МАКСИМУМ(ИстекСрокВозврата)
	 |ПО
	 |	Реализация
	 |;
	 |
	 |////////////////////////////////////////////////////////////////////////////////
	 |ВЫБРАТЬ
	 |	ВТ_Реализация.Реализация КАК Реализация,
	 |	ВТ_Реализация.ИдентификаторДокумента КАК ИдентификаторДокумента,
	 |	ВТ_Реализация.Номенклатура,
	 |	СУММА(ВТ_Реализация.Количество) КАК Количество,
	 |	МАКСИМУМ(ВТ_Реализация.ЗаказПокупателя) КАК ЗаказПокупателя,
	 |	МИНИМУМ(ВТ_Реализация.НомСтр) КАК НомСтр
	 |ИЗ
	 |	ВТ_Реализация КАК ВТ_Реализация
	 |ГДЕ
	 |	НЕ ВТ_Реализация.ЗаказПокупателя ЕСТЬ NULL
	 |
	 |СГРУППИРОВАТЬ ПО
	 |	ВТ_Реализация.Реализация,
	 |	ВТ_Реализация.ИдентификаторДокумента,
	 |	ВТ_Реализация.Номенклатура
	 |ИТОГИ
	 |	МАКСИМУМ(ИдентификаторДокумента)
	 |ПО
	 |	Реализация";
	
	Запрос.УстановитьПараметр("МассивРТУ", тзТолькоРТУ.ВыгрузитьКолонку("РТУ"));
	Запрос.УстановитьПараметр("тзРТУ",     тз);    
	Запрос.УстановитьПараметр("КоличествоДнейВозврата", Константы.КоличествоДнейВозврата.Получить());  
	Запрос.УстановитьПараметр("ТекДата", НачалоДня(ТекущаяДата())); 
	
	Пакет = Запрос.ВыполнитьПакет();
	ПоследнийПакет = Пакет.Количество() - 1;
	
	ВыборкаДок = Пакет[ПоследнийПакет].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	МассивОшибки = Новый Массив;
	
	// Проверка кратности
	Пока ВыборкаДок.Следующий() Цикл 
		
		Выборка = ВыборкаДок.Выбрать();  
		
		Пока Выборка.Следующий() Цикл
			
			ПроверятьКратность = мск.НеобходимоПроверятьКратностьВЗаказе(Выборка.ЗаказПокупателя);
			
			Если ПроверятьКратность И НЕ МСК.ПроверкаНоменклатурыНаКратность(Выборка.Номенклатура, Выборка.Количество)  Тогда  
				
				Коэф = МСК.ПолучитьКратностьНоменклатуры(Выборка.Номенклатура);  
				Коэф = ?(Коэф = 0, 1, Коэф);
				
				ТекстОшибкиВСтроке = "Количество должно быть кратно " + Строка(коэф) + ". НомерСтроки " + Строка(Выборка.НомСтр)
				+ ", ИдентификаторДокумента " + Выборка.ИдентификаторДокумента;
				
				МассивОшибки.Добавить(ТекстОшибкиВСтроке);
				
			КонецЕсли;
		
		КонецЦикла;
		
	КонецЦикла;  
	
	// Проверка количества
	ВыборкаДок = Пакет[ПоследнийПакет - 1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаДок.Следующий() Цикл 
		
		Выборка = ВыборкаДок.Выбрать();  
		
		Пока Выборка.Следующий() Цикл
		
			Если Не ПустаяСтрока(Выборка.ТекстОшибки) Тогда
				
				Если Найти(Выборка.ТекстОшибки, "Не найдена строка реализации номер") > 0 Тогда
					ТекстОшибкиВСтроке = СтрЗаменить(Выборка.ТекстОшибки, "==НомерСтроки==", " " + Строка(Выборка.НомСтр)); 
				Иначе
					ТекстОшибкиВСтроке = СтрЗаменить(Выборка.ТекстОшибки, "==НомерСтроки==", ". НомерСтроки " + Строка(Выборка.НомСтр)); 
				КонецЕсли;
				
				ТекстОшибкиВСтроке = СтрЗаменить(ТекстОшибкиВСтроке, "==КоличествоДок==", Строка(Выборка.КоличествоДок))
				+ ", ИдентификаторДокумента " + Выборка.ИдентификаторДокумента;    
				
				МассивОшибки.Добавить(ТекстОшибкиВСтроке);
				
			ИначеЕсли Выборка.НедостаточноКоличества Тогда
			
				ТекстОшибкиВСтроке = "Количество в запросе превышает количество, доступное к возврату - " 
				+ Строка(МАКС(Выборка.КоличествоДляВозврата, 0)) + ". НомерСтроки " + Строка(Выборка.НомСтр) 
				+ ", ИдентификаторДокумента " + Выборка.ИдентификаторДокумента;
				
				МассивОшибки.Добавить(ТекстОшибкиВСтроке);
				
			КонецЕсли;      
			
		КонецЦикла;
	
	КонецЦикла;
	
	СтруктураВозврата = Новый Структура("Результат, Данные, Сообщение", Ложь, Неопределено, "");    
	
	Если МассивОшибки.Количество() > 0 Тогда 
		
		СтруктураВозврата.Сообщение = МассивОшибки;
		Возврат СтруктураВозврата;
	
	КонецЕсли;
	
	ДокВозврат = Неопределено;
	ПромКомментарийОтмены = "";  
	ПромСтатусЗаявки = "";
	МассивРезультат = Новый Массив;
	
	ВыборкаДок.Сбросить();
	
	Пока ВыборкаДок.Следующий() Цикл 
		
		ДанныеВозврата = Новый Структура("НомерЗаявки, Статус");    
		//+Белов А. 03.03.2026 #UT10-5722                                 
		ГуидЗаявки = Новый УникальныйИдентификатор();
		СсылкаЗаявки = ДОкументы.ЗаявкаНаВозврат.ПолучитьСсылку(ГуидЗаявки);
		ДанныеВозврата.НомерЗаявки = Строка(ГуидЗаявки);
		//-Белов А. 03.03.2026 #UT10-5722
		
		ПромСтатусЗаявки = "На согласовании";
		
		Если ВыборкаДок.ИстекСрокВозврата Тогда 
			
			ПромСтатусЗаявки = "Отказ в возврате";
			ПромКомментарийОтмены = "Истек период для возврата.";    
				
		КонецЕсли;	      
		
		ДокВозврат = Документы.ЗаявкаНаВозврат.СоздатьДокумент(); 
		ДокВозврат.УстановитьСсылкуНового(СсылкаЗаявки);
		ДокВозврат.Дата       = ТекущаяДата();
		ДокВозврат.Реализация = ВыборкаДок.Реализация;    
		ДокВозврат.СертифицированнаяТорговаяТочка = ВыборкаДок.Реализация.Грузополучатель.СертифицированнаяТорговаяТочка; 
		
		ДокВозврат.Статус     = ПромСтатусЗаявки;     
		ДанныеВозврата.Статус = ПромСтатусЗаявки;
		
		//+Сёмин Р.И. 18.03.2026 #UT10-5766
		ДокВозврат.ЭлПочтаКлиента = ВыборкаДок.ЭлПочтаКлиента;
		//-Сёмин Р.И. 18.03.2026 #UT10-5766
		
		//+Сёмин Р.И. 12.05.2026 #UT10-5807
		ДокВозврат.ДополнительныеСвойства.Вставить("ЗаполнятьКомментарийДляРекламации", Ложь);
		//-Сёмин Р.И. 12.05.2026 #UT10-5807
		
		ЕстьРекламация = Ложь;
		
		Выборка = ВыборкаДок.Выбрать();  
		
		Пока Выборка.Следующий() Цикл
			
			СтрокаВозврат = ДокВозврат.Товары.Добавить();			
			
			СтрокаВозврат.Номенклатура     = Выборка.Номенклатура;
			СтрокаВозврат.Количество       = Выборка.Количество;
			СтрокаВозврат.ЕдиницаИзмерения = Выборка.ЕдиницаИзмерения;
			СтрокаВозврат.Комментарий      = Выборка.Комментарий;
			СтрокаВозврат.Цена             = Выборка.Цена;
			СтрокаВозврат.IDСклада_СтороннийСклад = Выборка.СтороннийСклад;			
			СтрокаВозврат.Сумма            = Выборка.Сумма;
			СтрокаВозврат.Тип              = ?(Выборка.ПричинаВозврата = "0", "Возврат", "Рекламация");
			СтрокаВозврат.НомерСтрокиИзРТУ = Выборка.НомерСтроки;

			Если СтрокаВозврат.Тип = "Рекламация" Тогда
				ЕстьРекламация = Истина;
			ИначеЕсли СтрокаВозврат.Тип = "Возврат" Тогда     
				
				Если ЗначениеЗаполнено(СтрокаВозврат.Комментарий)Тогда
					ДокВозврат.Комментарий = ДокВозврат.Комментарий + ?(ЗначениеЗаполнено(ДокВозврат.Комментарий), ", ", "") + СтрокаВозврат.Комментарий;
				КонецЕсли;  
				
			КонецЕсли; 
			
		КонецЦикла;       
		
		ДокВозврат.Комментарий = ?(ЕстьРекламация, "", ДокВозврат.Комментарий);
		
		ПромЕстьРекламация = Не ДокВозврат.Товары.Найти("Рекламация", "Тип") = Неопределено;
		
		Если ПромЕстьРекламация Тогда   
			
			ДокВозврат.Статус = "На согласовании";
			ПромКомментарийОтмены = ""; 
			
		Иначе            
			
			Если ПромСтатусЗаявки = "Отказ в возврате" Тогда   
				
				Для Каждого СтрокаТаблЧасти Из ДокВозврат.Товары Цикл
					СтрокаТаблЧасти.Статус = ПромСтатусЗаявки;
				КонецЦикла;   
				
			КонецЕсли; 	
			
		КонецЕсли;
		
		Если НЕ ПромКомментарийОтмены = "" Тогда
			ДокВозврат.Комментарий =  ПромКомментарийОтмены + " " + СокрЛП(ДокВозврат.Комментарий);
		КонецЕсли;	
			
		ДокВозврат.Записать(?(ДокВозврат.Статус = "Отказ в возврате", РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись));
		
		//+Белов А. 03.03.2026 #UT10-5722
		Если ДокВозврат.Статус = "На согласовании" Тогда
			
			Файлы = СоответствиеФайлыS3.Получить(ВыборкаДок.ИдентификаторДокумента); 
			
			Если Файлы <> Неопределено Тогда
				
				Для каждого СсылкаНаФайл Из Файлы Цикл
					
					МенеджерОчереди = РегистрыСведений.ОчередьЗагрузкиСсылокS3.СоздатьМенеджерЗаписи();
					МенеджерОчереди.Идентификатор = Строка(Новый УникальныйИдентификатор());
					МенеджерОчереди.Ссылка = СсылкаНаФайл;  
					МенеджерОчереди.Документ = ДокВозврат.Ссылка;
					МенеджерОчереди.Записать();				
					
				КонецЦикла;
				
			КонецЕсли;  
			
		КонецЕсли;
		//-Белов А. 03.03.2026 #UT10-5722
		
		ДанныеВозврата.Статус = ДокВозврат.Статус;
					
		МассивРезультат.Добавить(ДанныеВозврата);
		
	КонецЦикла;
	
	СтруктураВозврата.Данные = МассивРезультат;
	СтруктураВозврата.Результат = Истина;
	
	Возврат СтруктураВозврата;

КонецФункции


///////////////////order_run///////////////////
Функция ОтменитьРезервЗаказаСервер(СтрокаJSON) Экспорт 
	
	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("HTTP-сервис OnlineStore.order_run.ОтменитьРезервЗаказа", УровеньЖурналаРегистрации.Информация,,, "HTTP-сервис:Запуск. ОтменитьРезервЗаказа");
	
	ПараметрыСтруктура 	= ОбщегоНазначения.ВернутьСтруктуруИзJSON(СтрокаJSON);
	
	СтруктураВозврата = ОтменитьРезервПоЗаказу(ПараметрыСтруктура);
	
	ДанныеВозврата = ОбщегоНазначения.ВернутьJSON(СтруктураВозврата);
	
	ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("HTTP-сервис OnlineStore.order_run.ОтменитьРезервЗаказа", УровеньЖурналаРегистрации.Информация,,, 
	"HTTP-сервис:Завершение. ОтменитьРезервЗаказа. " + Формат(ВремяОкончанияUTC - ВремяНачалаUTC, "ЧН=0; ЧГ=0") + " м.сек." + " Запрос:" + Символы.ПС + СтрокаJSON);
		
	Возврат ДанныеВозврата;
	
КонецФункции	  

Функция ОтменитьРезервПоЗаказу(ПараметрыЗапроса)
	
	СтруктураВозврата = Новый Структура("Результат, Данные, Сообщение", Ложь, Неопределено, "");
	
	ИдентификаторДокумента 	= СокрЛП(ПараметрыЗапроса.ИдентификаторДокумента);
	ДокументЗаказКлиента 	= Документы.ЗаказПокупателя.ПолучитьСсылку(Новый УникальныйИдентификатор(ИдентификаторДокумента));
	
	Если ДокументЗаказКлиента.ПолучитьОбъект() = Неопределено Тогда	
		СтруктураВозврата.Сообщение = "Не найден заказ клиента с таким ID";	
	Иначе 	
		
		Если ДокументЗаказКлиента.ПометкаУдаления Тогда
			
			СтруктураВозврата.Сообщение = "Заказа покупателя помечен на удаление"; 
			Возврат СтруктураВозврата;
			
		КонецЕсли;   
		
		ОбъектЗаказа = ДокументЗаказКлиента.ПолучитьОбъект();
		
		Если ПараметрыЗапроса.Свойство("ТоварыВРезерве") Тогда
			
			ТаблицаОстатков = ПолучитьОстатокТоваровПоЗаказуСГалкойТолькоРезерв(ДокументЗаказКлиента);
			
			Для каждого СтрокаРезерва Из ПараметрыЗапроса.ТоварыВРезерве Цикл
				
				СтрокаРезерваДокумента = ОбъектЗаказа.Товары.Найти(СтрокаРезерва.ИдентификаторСтроки, "КлючСтроки");
				
				Если СтрокаРезерваДокумента = Неопределено Тогда
					
					СтруктураВозврата.Сообщение = "Не найдена строка резерва с ключем " + Строка(СтрокаРезерва.ИдентификаторСтроки); 
					Возврат СтруктураВозврата;
					
				КонецЕсли;   
				
				СтрокаПоиска = ТаблицаОстатков.Найти(СтрокаРезерваДокумента.Номенклатура, "Номенклатура");
				
				Если СтрокаПоиска = Неопределено ИЛИ СтрокаПоиска.Остаток <> СтрокаРезерва.Количество Тогда
					
					Если СтрокаПоиска = Неопределено Тогда
						СтруктураВозврата.Сообщение = "Отсутствует товар в резерве по строке с ключем " + Строка(СтрокаРезерва.ИдентификаторСтроки);
					Иначе
						СтруктураВозврата.Сообщение = "Отличается количество товара в резерве по строке с ключем " + Строка(СтрокаРезерва.ИдентификаторСтроки) + " (" + Строка(СтрокаПоиска.Остаток) + "<>" + Строка(СтрокаРезерва.Количество) + ")";
					КонецЕсли;
					
					СтатусыЗаказов.ПоместитьВОчередьВФоне(Новый Структура("Ссылка", ДокументЗаказКлиента));                               
					Возврат СтруктураВозврата;
					
				КонецЕсли;
				
				СтрокаРезерваДокумента.ТолькоРезерв = Ложь;	
				
				ОбъектЗаказа.ТолькоРезерв = ОбъектЗаказа.Товары.НайтиСтроки(Новый Структура("ТолькоРезерв", Истина)).Количество() > 0								
				
			КонецЦикла; 
						
		Иначе
			ОбъектЗаказа.ТолькоРезерв = Ложь;
		КонецЕсли;	
		
		Попытка		
			
			ОбъектЗаказа.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
			
			ДанныеДокумента = Новый Структура("ИдентификаторДокумента,НомерДокумента", Строка(ДокументЗаказКлиента.УникальныйИдентификатор()), СокрЛП(ДокументЗаказКлиента.Номер));
			
			СтруктураВозврата.Данные 	= ДанныеДокумента;
            СтруктураВозврата.Результат = Истина;
			СтруктураВозврата.Сообщение = "Заказ успешно снят с резерва и готов к сборке";		
			
		Исключение 		
			СтруктураВозврата.Сообщение = "Возникла ошибка при записи заказа" + Символы.ПС + ОписаниеОшибки();		
		КонецПопытки;  	  
		
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции

Функция ПолучитьОстатокТоваровПоЗаказуСГалкойТолькоРезерв(Заказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказыПокупателейОстатки.Номенклатура,
	|	СУММА(ЗаказыПокупателейОстатки.КоличествоОстаток) КАК Остаток
	|ИЗ
	|	РегистрНакопления.ЗаказыПокупателей.Остатки(
	|			,
	|			ЗаказПокупателя = &Заказ
	|				И ТолькоРезерв) КАК ЗаказыПокупателейОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказыПокупателейОстатки.Номенклатура";
	
	Запрос.УстановитьПараметр("Заказ", Заказ);  
	
	Возврат Запрос.Выполнить().Выгрузить();	
		
КонецФункции



