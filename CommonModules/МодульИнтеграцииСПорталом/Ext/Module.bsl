	СтруктураШапки.Вставить("ФактАдрес");
	СтруктураШапки.Вставить("ИДФактАдрес");
	СтруктураШапки.Вставить("Комментарий");
	СтруктураШапки.Вставить("ИдентификаторДоговора");
	СтруктураШапки.Вставить("ИдентификаторОрганизация");
	СтруктураШапки.Вставить("ИдентификаторКонтрагента");
	СтруктураШапки.Вставить("ИдентификаторФилиала");
	СтруктураШапки.Вставить("ТипДоставки");
	СтруктураШапки.Вставить("ИдентификаторВалюта");
	СтруктураШапки.Вставить("НаименованиеЗаказаПортала");
	СтруктураШапки.Вставить("Почта"); 
	СтруктураШапки.Вставить("ИНН");
	СтруктураШапки.Вставить("КПП");
	СтруктураШапки.Вставить("ИдентификаторСклад");
	СтруктураШапки.Вставить("ТипОплаты");
	СтруктураШапки.Вставить("ДатаДоставки");
	СтруктураШапки.Вставить("Контрагент");			// требуется совместно с параметром "EMailЗаказ" - истина
	СтруктураШапки.Вставить("ФилиалКонтрагента");	// требуется совместно с параметром "EMailЗаказ" - истина
	СтруктураШапки.Вставить("КодИсточника"); 		//Строки документа, Массив Структур
	
	СтруктураСтрок = Новый Структура;
	СтруктураСтрок.Вставить("КодПроизводителя");//Номенклатура.КодПроизводителя
	СтруктураСтрок.Вставить("Артикул");			//Номенклатура.Артикул
	СтруктураСтрок.Вставить("Родитель");		// Родитель Номенклатуры
	СтруктураСтрок.Вставить("Наименование");
	СтруктураСтрок.Вставить("Количество");
	СтруктураСтрок.Вставить("ЦенаКлиента");
	СтруктураСтрок.Вставить("ЦенаЗакупки");
	СтруктураСтрок.Вставить("ПроизводительПоставщика");
	СтруктураСтрок.Вставить("Комментарий"); 
	
    МассивСтрок = Новый Массив;
	МассивСтрок.Добавить(СтруктураСтрок);
	
	// Основная структура
	СтруктураСообщения = Новый Структура;   
	СтруктураСообщения.Вставить("Шапка", 	СтруктураШапки); 	//структура             
	СтруктураСообщения.Вставить("Строки", 	МассивСтрок); 		//Массив Структур     
	// Необязательные параметры
	СтруктураСообщения.Вставить("EMailЗаказ",			Ложь);// Булево
	СтруктураСообщения.Вставить("ТипЦенЗаказа", 		Неопределено);// СправочникСсылка.ТипыЦенНоменклатуры 
	
    Возврат СтруктураСообщения;
	
