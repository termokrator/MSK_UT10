	"HTTP-сервис:Завершение. ЗакрытьЗаказПокупателя. " + Формат(ВремяОкончанияUTC - ВремяНачалаUTC, "ЧН=0; ЧГ=0") + " м.сек." + " Запрос:" + Символы.ПС + СтрокаJSON);
		
	Возврат ДанныеВозврата;
	
КонецФункции  

Функция ВыполнитьЗакрытиеЗаказа(ПараметрыЗапроса)
	
	СтруктураВозврата = Новый Структура("Результат, Данные, Сообщение", Ложь, Неопределено, "");    
		
	ИдентификаторДокумента	= СокрЛП(ПараметрыЗапроса.ИдентификаторДокумента);
	ДокументЗаказКлиента 	= Документы.ЗаказПокупателя.ПолучитьСсылку(Новый УникальныйИдентификатор(ИдентификаторДокумента));
	
	Если ДокументЗаказКлиента.ПолучитьОбъект() = Неопределено Тогда	
		СтруктураВозврата.Сообщение = "Не найден заказ клиента с таким ID";	
	Иначе 
		
		Если МСКWEB.ЕстьСборка(ДокументЗаказКлиента) Тогда
			СтруктураВозврата.Сообщение = "Заказ уже отправлен на сборку";	
		ИначеЕсли МСКWEB.ЕстьЗаказПоставщику(ДокументЗаказКлиента) Тогда
			СтруктураВозврата.Сообщение = "По заказу уже сформирован заказ поставщику";	
		Иначе          		
			
			Попытка	  		
				
				ДокументЗакрытия = Документы.ЗакрытиеЗаказовПокупателей.СоздатьДокумент();
				ДокументЗакрытия.Заполнить(ДокументЗаказКлиента); 
				
				ДокументЗакрытия.Дата 			= ТекущаяДата();
				ДокументЗакрытия.ВидОперации 	= Перечисления.ВидыОперацийЗакрытиеЗаказовПокупателей.ЗакрытиеЗаказов;
				ДокументЗакрытия.Комментарий 	= "Документ сформирован через интернет-портал";
				ДокументЗакрытия.Записать(РежимЗаписиДокумента.Проведение);
				
				Если МСКWEB.ЕстьСборка(ДокументЗаказКлиента) Тогда
					
					ДокументЗакрытия.УстановитьПометкуУдаления(Истина);  
					
					СтруктураВозврата.Сообщение = "Заказ уже отправлен на сборку";	
					
				Иначе	
					
					СтруктураВозврата.Результат = Истина;
					СтруктураВозврата.Сообщение = "Заказ успешно отменен!";	
					
				КонецЕсли;
				
			Исключение 		
				СтруктураВозврата.Сообщение = "Возникла ошибка при записи документа снятия резервов" + Символы.ПС + ОписаниеОшибки();		
			КонецПопытки;  	
			
		КонецЕсли;
		
	КонецЕсли;
			
	Возврат СтруктураВозврата;
	
КонецФункции  


