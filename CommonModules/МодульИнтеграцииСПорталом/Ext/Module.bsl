Функция ПолучитьДанныеДокументаОтгрузкиСервер(ПараметрыСоответсвие) Экспорт 
	
	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();  
	ПараметрыСтруктура 	= ПолучитьСтруктуруИзСоответствия(ПараметрыСоответсвие);
	
	ПараметрыЗапросаСтр = ПолучитьОписаниеПараметровЗапроса(ПараметрыСтруктура);  
	
	ЗаписьЖурналаРегистрации("HTTP-сервис OnlineStore.docsale_goods.ПолучитьДанныеДокументаОтгрузки", УровеньЖурналаРегистрации.Информация,,, 
	"HTTP-сервис:Запуск. ПолучитьДанныеДокументаОтгрузки. " + ПараметрыЗапросаСтр);
	
	СтруктураВозврата = ПолучитьИнформациюПоДокументуОтгрузки(ПараметрыСтруктура);
	
	ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("HTTP-сервис OnlineStore.docsale_goods.ПолучитьДанныеДокументаОтгрузки", УровеньЖурналаРегистрации.Информация,,, 
	"HTTP-сервис:Завершение. ПолучитьДанныеДокументаОтгрузки "  
	+ ". Время ответа: " + Формат(ВремяОкончанияUTC - ВремяНачалаUTC, "ЧН=0; ЧГ=0") + " м.сек." + ПараметрыЗапросаСтр);
		
	Возврат СтруктураВозврата;
	
КонецФункции    

Функция ПолучитьИнформациюПоДокументуОтгрузки(ПараметрыЗапроса)
	
	СтруктураВозврата = Новый Структура("Результат, Данные, Сообщение", Ложь, Неопределено, "");    
	
	Если Не ПараметрыЗапроса.Свойство("ИдентификаторДокумента") Или ПустаяСтрока(ПараметрыЗапроса.ИдентификаторДокумента) Тогда
		
		СтруктураВозврата.Сообщение = "Товары не получены. Причина: не задан параметр запроса ИдентификаторДокумента";
		Возврат СтруктураВозврата;
	
	КонецЕсли; 
	
	ИдентификаторДокумента = СокрЛП(ПараметрыЗапроса.ИдентификаторДокумента); 
	
	НашлиДокумент = Ложь;    
	ДокументСФКлиента = ПолучитьДокументПоИдентификатору("СчетФактураВыданный", ИдентификаторДокумента);
	
	Если Не ДокументСФКлиента.Пустая() Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	СчетФактураВыданный.Ссылка КАК Ссылка,
		|	СчетФактураВыданный.ДокументОснование КАК ДокументОснование
		|ИЗ
		|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
		|ГДЕ
		|	СчетФактураВыданный.Ссылка = &Ссылка
		|	И СчетФактураВыданный.Проведен";
		
		Запрос.УстановитьПараметр("Ссылка", ДокументСФКлиента);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();  
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда        
			
			ДокументРеализация = ВыборкаДетальныеЗаписи.ДокументОснование;  
			НашлиДокумент 	   = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
		
	Если НЕ НашлиДокумент Тогда 
		
		ДокументРеализация = ПолучитьДокументПоИдентификатору("РеализацияТоваровУслуг", ИдентификаторДокумента);
		
		Если ДокументРеализация.Пустая() Тогда
		
			СтруктураВозврата.Сообщение = "Данные документа отгрузки не получены. Причина: не найдена счет-фактура/реализация с идентификатором " + ИдентификаторДокумента;
			Возврат СтруктураВозврата;  
			
		КонецЕсли;
		
	КонецЕсли;
	
	ЗапросПоШапкеРеализация = Новый Запрос;
	ЗапросПоШапкеРеализация.Текст = 
	"ВЫБРАТЬ
	|	РеализацияТоваровУслуг.Ссылка,
	|	РеализацияТоваровУслуг.Номер КАК НомерДокумента,
	|	ВЫБОР
	|		КОГДА РеализацияТоваровУслуг.Контрагент.ГоловнойКонтрагент.НеИспользоватьИдентификаторАвардыДляСвязиСПорталом
	|				ИЛИ РеализацияТоваровУслуг.Контрагент.ГоловнойКонтрагент.IDАварда = """"
	|			ТОГДА РеализацияТоваровУслуг.Контрагент.ГоловнойКонтрагент.КодМДМ
	|		ИНАЧЕ РеализацияТоваровУслуг.Контрагент.ГоловнойКонтрагент.IDАварда
	|	КОНЕЦ КАК ИдентификаторКлиента,
	|	РеализацияТоваровУслуг.Контрагент.ГоловнойКонтрагент.Наименование КАК НаименованиеГоловногоКлиента,
	|	РеализацияТоваровУслуг.Дата КАК ДатаДокумента,
	|	РеализацияТоваровУслуг.Контрагент.Наименование КАК НаименованиеФилиала,
	|	РеализацияТоваровУслуг.ВалютаДокумента.Наименование КАК НаименованиеВалюта,
	|	""Отгружен"" КАК СтатусОтгрузки,
	|	РеализацияТоваровУслуг.СуммаДокумента КАК СуммаДокумента,
	|	ЕСТЬNULL(РеализацияТоваровУслуг.Водитель.Наименование, """") КАК ФИОВодителя,
	|	ЕСТЬNULL(КонтактнаяИнформация.Представление, """") КАК КонтактыВодителя,
	|	ВЫБОР
	|		КОГДА РеализацияТоваровУслуг.ТаксиДоставка
	|			ТОГДА ЕСТЬNULL(Грузоместа.Грузоместо, 0)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Грузомест,
	|	РеализацияТоваровУслуг.ТаксиДоставка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|		ПО РеализацияТоваровУслуг.Водитель = КонтактнаяИнформация.Объект
	|			И (КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон))
	|			И (КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонФизЛицаСлужебный))
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ГрузовоеМесто.РеализацияСамовывоза КАК Реализация,
	|			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ГрузовоеМесто.Ссылка) КАК Грузоместо
	|		ИЗ
	|			Документ.ГрузовоеМесто КАК ГрузовоеМесто
	|		ГДЕ
	|			ГрузовоеМесто.РеализацияСамовывоза = &РеализацияПараметр
	|			И ГрузовоеМесто.Проведен
	|			И ГрузовоеМесто.Погружено
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ГрузовоеМесто.РеализацияСамовывоза) КАК Грузоместа
	|		ПО РеализацияТоваровУслуг.Ссылка = Грузоместа.Реализация
	|ГДЕ
	|	РеализацияТоваровУслуг.Ссылка = &РеализацияПараметр";	       
	
	ЗапросПоШапкеРеализация.УстановитьПараметр("РеализацияПараметр", ДокументРеализация);    
	
	МассивСтрок = Новый Массив; 
	
	ДетальнаяИнформация = Неопределено;
	ПараметрыЗапроса.Свойство("ДетальнаяИнформация", ДетальнаяИнформация);  
	ДетальнаяИнформация = СтрокаВБулево(ДетальнаяИнформация);
	
	РезультатЗапросаШапкиРеализация = ЗапросПоШапкеРеализация.Выполнить(); 
	
	Если НЕ РезультатЗапросаШапкиРеализация.Пустой() Тогда            
		
		ВыборкаРезультата = РезультатЗапросаШапкиРеализация.Выбрать();  
		                                                
		СтрокаПолей = ПолучитьПоляСтруктурыВыходныхПараметров(СоответствиеПолейСервис_PM_6051_DOC_FOR_PORTAL());

		ДанныеДокумента = Новый Структура(СтрокаПолей);
		
		Пока ВыборкаРезультата.Следующий()Цикл                      
			
			ЗаполнитьЗначенияСвойств(ДанныеДокумента, ВыборкаРезультата);
			
			ДанныеДокумента.ИдентификаторДокумента   = СокрЛП(ВыборкаРезультата.Ссылка.УникальныйИдентификатор());				
			ДанныеДокумента.ДатаДоставки 			= Формат(ВыборкаРезультата.ДатаДокумента, "ДФ=dd.MM.yyyy");
			
			Если Не ДокументСФКлиента.Пустая() Тогда 
										
				НомерНаПечатьСтрокой = ОбщегоНазначения.ПолучитьНомерНаПечать(ДокументСФКлиента,,, Истина);  
				
				ДанныеДокумента.НомерДокумента 	= НомерНаПечатьСтрокой;						
				ДанныеДокумента.Флаг 			= 1; 
				
			КонецЕсли;	
			
			Если КонецДня(ВыборкаРезультата.Ссылка.Дата) = КонецДня(ТекущаяДата()) И ВыборкаРезультата.Ссылка.ТаксиДоставка И НЕ ВыборкаРезультата.Грузомест = 0 Тогда
				ДанныеДокумента.СтатусОтгрузки = "Такси доставка (" + СокрЛП(ВыборкаРезультата.Грузомест) + " гр.мест)";
			КонецЕсли;	
			        
		КонецЦикла;	
		
	КонецЕсли;

	Если Не ДетальнаяИнформация Тогда   
		
		МассивСтрок.Добавить(ДанныеДокумента);
		
		СтруктураВозврата.Данные 	= МассивСтрок;
		СтруктураВозврата.Результат = Истина;  
		
		Возврат СтруктураВозврата; 
		
	КонецЕсли;   
	
	
	ЗапросТовары = Новый Запрос;
	ЗапросТовары.Текст = 
	"ВЫБРАТЬ
	|	РеализацияТоваровУслугТовары.НомерСтроки КАК НомерСтроки,
	|	РеализацияТоваровУслугТовары.Номенклатура.Код КАК КодТовара,
	|	РеализацияТоваровУслугТовары.Номенклатура.Родитель.Наименование КАК Производитель,
	|	РеализацияТоваровУслугТовары.Номенклатура.КодПроизводителя КАК КодПроизводителя,
	|	РеализацияТоваровУслугТовары.Номенклатура.Наименование КАК НаименованиеТовара,
	|	РеализацияТоваровУслугТовары.ЕдиницаИзмерения.Коэффициент КАК Коэффициент,
	|	РеализацияТоваровУслугТовары.Количество КАК Количество,
	|	РеализацияТоваровУслугТовары.ЕдиницаИзмерения.Наименование КАК ЕдиницаИзмерения,   
	|	ВЫРАЗИТЬ(РеализацияТоваровУслугТовары.Количество * РеализацияТоваровУслугТовары.ЕдиницаИзмерения.Коэффициент КАК Число(15,3)) КАК КоличествоЕдИзм,
	|	РеализацияТоваровУслугТовары.Цена КАК Цена,
	|	РеализацияТоваровУслугТовары.Сумма КАК Сумма,
	|	"""" КАК Комментарий
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|ГДЕ
	|	РеализацияТоваровУслугТовары.Ссылка = &Ссылка";
	
	ЗапросТовары.УстановитьПараметр("Ссылка", ДокументРеализация);
	
	СтрокаПолей = "НомерСтроки,КодТовара,Производитель,КодПроизводителя,НаименованиеТовара,Коэффициент,Количество,ЕдиницаИзмерения,КоличествоЕдИзм,Цена,Сумма,Комментарий";
	МассивТовары = Новый Массив;
	
	ВыборкаРезультата = ЗапросТовары.Выполнить().Выбрать();
	
	Пока ВыборкаРезультата.Следующий() Цикл
		
		ДанныеТоваров = Новый Структура(СтрокаПолей);
		ЗаполнитьЗначенияСвойств(ДанныеТоваров, ВыборкаРезультата);
		МассивТовары.Добавить(ДанныеТоваров);
		
	КонецЦикла;	 
	
	ДанныеДокумента.Вставить("Товары", МассивТовары);
	
	СтруктураВозврата.Данные = ДанныеДокумента;
	СтруктураВозврата.Результат = Истина;  
	
	Возврат СтруктураВозврата;     
	
КонецФункции


///////////////////payments_docsales///////////////////  
Функция ПолучитьСписокРеализацийДляОплатыСервер(ПараметрыСоответсвие) Экспорт 
	
	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах(); 
	ПараметрыЗапроса 	= ПолучитьСтруктуруИзСоответствия(ПараметрыСоответсвие);
	
	//ПараметрыЗапросаСтр = ПолучитьОписаниеПараметровЗапроса(ПараметрыЗапроса);  
	//
	//ЗаписьЖурналаРегистрации("HTTP-сервис OnlineStore.payments_docsales.ПолучитьСписокРеализацийДляОплаты", 
	//УровеньЖурналаРегистрации.Информация,,, "HTTP-сервис:Запуск. ПолучитьСписокРеализацийДляОплаты. " + ПараметрыЗапросаСтр);
	
	
	СтруктураВозврата 	= Новый Структура("Результат, Данные, Сообщение", Ложь, Неопределено, ""); 
	
	Если Не ПараметрыЗапроса.Свойство("ИдентификаторКонтрагента") Или Не ЗначениеЗаполнено(ПараметрыЗапроса.ИдентификаторКонтрагента) Тогда
		
		ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах(); 
		
		ЗаписьЖурналаРегистрации("HTTP-сервис OnlineStore.payments_docsales.ПолучитьСписокРеализацийДляОплаты", УровеньЖурналаРегистрации.Информация,,, 
		"HTTP-сервис OnlineStore.payments_docsales. ПолучитьСписокРеализацийДляОплаты. " 
		+ Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
		
		СтруктураВозврата.Сообщение = "Список реализаций для оплаты не получен. Причина: не задан параметр ИдентификторКонтрагента";
		Возврат СтруктураВозврата;

	КонецЕсли;  
	
	Если Не ПараметрыЗапроса.Свойство("ДатаНачала") Или Не ЗначениеЗаполнено(ПараметрыЗапроса.ДатаНачала) Тогда
		
		ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах(); 
		
		ЗаписьЖурналаРегистрации("HTTP-сервис OnlineStore.payments_docsales.ПолучитьСписокРеализацийДляОплаты", УровеньЖурналаРегистрации.Информация,,, 
		"HTTP-сервис OnlineStore.payments_docsales. ПолучитьСписокРеализацийДляОплаты. " 
		+ Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
		
		СтруктураВозврата.Сообщение = "Список реализаций для оплаты не получен. Причина: не задан параметр ДатаНачала";
		Возврат СтруктураВозврата;

	КонецЕсли;   
	
	Если Не ПараметрыЗапроса.Свойство("ДатаОкончания") Или Не ЗначениеЗаполнено(ПараметрыЗапроса.ДатаОкончания) Тогда
		
		ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах(); 
		
		ЗаписьЖурналаРегистрации("HTTP-сервис OnlineStore.payments_docsales.ПолучитьСписокРеализацийДляОплаты", УровеньЖурналаРегистрации.Информация,,, 
		"HTTP-сервис OnlineStore.payments_docsales. ПолучитьСписокРеализацийДляОплаты. " 
		+ Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
		
		СтруктураВозврата.Сообщение = "Список реализаций для оплаты не получен. Причина: не задан параметр ДатаОкончания";
		Возврат СтруктураВозврата;

	КонецЕсли;    
	
	ИдентификаторКонтрагента = ПараметрыЗапроса.ИдентификаторКонтрагента; 
	ДатаНачала	  		     = СтрокаВДату(ПараметрыЗапроса.ДатаНачала);
	ДатаОкончания            = СтрокаВДату(ПараметрыЗапроса.ДатаОкончания);
	
	Артикул = ""; 
	НомерДокумента = "";
	
	Если ПараметрыЗапроса.Свойство("Артикул") Тогда    
		Артикул = ПараметрыЗапроса.Артикул;
	КонецЕсли;

	Если ПараметрыЗапроса.Свойство("НомерДокумента") Тогда    
		НомерДокумента = ПараметрыЗапроса.НомерДокумента;
	КонецЕсли;
	
	ПараметрыЗапуска = "ИдентификаторКонтрагента: " + ИдентификаторКонтрагента + "ДатаНачала: " + ДатаНачала + "ДатаОкончания: " + ДатаОкончания +
	"Артикул: " + Артикул + "НомерДокумента: " + НомерДокумента;     
	
	ЗаписьЖурналаРегистрации("HTTP-сервис OnlineStore.payments_docsales.ПолучитьСписокРеализацийДляОплаты", УровеньЖурналаРегистрации.Информация,,, 
	"HTTP-сервис OnlineStore.payments_docsales. ПолучитьСписокРеализацийДляОплаты. Параметры:" 
	+ Символы.ПС + ПараметрыЗапуска);

	
	Если Не ЗначениеЗаполнено(ИдентификаторКонтрагента) Тогда		
		
		СтруктураВозврата.Сообщение = "Список реализаций для оплаты не получен. Причина: Не заполнен ИдентификаторКонтрагента"; 
		ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
		
		ЗаписьЖурналаРегистрации("HTTP-сервис OnlineStore.payments_docsales.ПолучитьСписокРеализацийДляОплаты", УровеньЖурналаРегистрации.Информация,,, 
		"HTTP-сервис OnlineStore.payments_docsales. ПолучитьСписокРеализацийДляОплаты. " 
		+ Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
		
		Возврат СтруктураВозврата;
		
	КонецЕсли;
	
	Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту("КодМДМ", ИдентификаторКонтрагента);	
	
	Если Не ЗначениеЗаполнено(Контрагент) Тогда		
		
		СтруктураВозврата.Сообщение = "Список реализаций для оплаты не получен. Причина: Не был найден филиал по идентификатору: " + ИдентификаторКонтрагента;
		ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
		
		ЗаписьЖурналаРегистрации("HTTP-сервис OnlineStore.payments_docsales.ПолучитьСписокРеализацийДляОплаты", УровеньЖурналаРегистрации.Информация,,, 
		"HTTP-сервис OnlineStore.payments_docsales. ПолучитьСписокРеализацийДляОплаты. " 
		+ Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
		
		Возврат СтруктураВозврата;		
		
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ПродажиОбороты.ДокументПродажи КАК Документ.РеализацияТоваровУслуг) КАК Реализация,
	|	СУММА(ПродажиОбороты.СтоимостьОборот) КАК Сумма,
	|	МАКСИМУМ(ПродажиОбороты.ЗаказПокупателя.ДатаОтгрузки) КАК ДатаДоставки,
	|	МАКСИМУМ(СчетФактураВыданный.Ссылка) КАК СчетФактура
	|ПОМЕСТИТЬ ВТ_Реализации
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(
	|			,
	|			,
	|			,
	|			ДокументПродажи ССЫЛКА Документ.РеализацияТоваровУслуг
	|				И ВЫРАЗИТЬ(ДокументПродажи КАК Документ.РеализацияТоваровУслуг).Грузополучатель = &Филиал
	|				И (ВЫРАЗИТЬ(ДокументПродажи КАК Документ.РеализацияТоваровУслуг).Дата МЕЖДУ &ДатаНачала И &ДатаОкончания)
	|				И ((ВЫРАЗИТЬ(&Артикул КАК СТРОКА(20))) = """"
	|					ИЛИ Номенклатура.НормализованныйКод ПОДОБНО &Артикул)) КАК ПродажиОбороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный КАК СчетФактураВыданный
	|		ПО ПродажиОбороты.ДокументПродажи = СчетФактураВыданный.ДокументОснование
	|			И (СчетФактураВыданный.Проведен)
	|ГДЕ
	|	((ВЫРАЗИТЬ(&Номер КАК СТРОКА(20))) = """"
	|			ИЛИ ВЫБОР
	|				КОГДА СчетФактураВыданный.Номер ЕСТЬ NULL
	|					ТОГДА ВЫРАЗИТЬ(ПродажиОбороты.ДокументПродажи КАК Документ.РеализацияТоваровУслуг).Номер ПОДОБНО &Номер
	|				ИНАЧЕ СчетФактураВыданный.Номер ПОДОБНО &Номер
	|			КОНЕЦ)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫРАЗИТЬ(ПродажиОбороты.ДокументПродажи КАК Документ.РеализацияТоваровУслуг)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Реализация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстатки.СуммаВзаиморасчетовОстаток, 0) КАК ИтогоКОплатеПоОстаткам,
	|	ВТ_Реализации.Реализация.СуммаДокумента КАК ИтогоКОплате,
	|	ВТ_Реализации.Реализация.Дата КАК Дата,
	|	ВТ_Реализации.Реализация.ВалютаДокумента.Наименование КАК Валюта,
	|	ВТ_Реализации.Реализация.Ссылка КАК Реализация,
	|	ЕСТЬNULL(ВТ_Реализации.Реализация.Водитель.Наименование, """") КАК Водитель,
	|	ВТ_Реализации.Реализация.Грузополучатель.Наименование КАК Филиал,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстатки.СуммаВзаиморасчетовОстаток, 0) > 0
	|				И ЕСТЬNULL(СвойствоЗаблокированоДляОплаты.Значение, ЛОЖЬ) = ЛОЖЬ
	|				И ВТ_Реализации.Реализация.Организация = &ОсновнаяОрганизация
	|				И &ВключенаОпцияОплатыКартой
	|				И ВТ_Реализации.Реализация.ДоговорКонтрагента.РозничнаяПродажа
	|				И НЕ ЕСТЬNULL(СвойствоСтатусДоставки.Значение, ЗНАЧЕНИЕ(Перечисление.СтатусыДоставки.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.СтатусыДоставки.ТоварНеДоставлен)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ВозможностьОплаты,
	|	ЕСТЬNULL(СвойствоСтатусДоставки.Значение, """") КАК Статус,
	|	ВТ_Реализации.Реализация.СуммаДокумента КАК Сумма,
	|	ВТ_Реализации.СчетФактура КАК СчетФактура,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстатки.СуммаВзаиморасчетовОстаток, 0) <= 0
	|			ТОГДА 0
	|		ИНАЧЕ ВТ_Реализации.Сумма - ЕСТЬNULL(ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстатки.СуммаВзаиморасчетовОстаток, 0)
	|	КОНЕЦ КАК Аванс,
	|	ВЫБОР
	|		КОГДА ВТ_Реализации.ДатаДоставки = &ПустаяДата
	|			ТОГДА ВТ_Реализации.Реализация.Дата
	|		ИНАЧЕ ВТ_Реализации.ДатаДоставки
	|	КОНЕЦ КАК ДатаДоставки,
	|	ЕСТЬNULL(ТелефонВодителя.Представление, """") КАК ТелефонВодителя,
	|	ВТ_Реализации.Реализация.Контрагент.Наименование КАК Контрагент
	|ИЗ
	|	ВТ_Реализации КАК ВТ_Реализации
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВзаиморасчетыСКонтрагентамиПоДокументамРасчетов.Остатки(
	|				,
	|				ДокументРасчетовСКонтрагентом ССЫЛКА Документ.РеализацияТоваровУслуг
	|					И ВЫРАЗИТЬ(ДокументРасчетовСКонтрагентом КАК Документ.РеализацияТоваровУслуг).Грузополучатель = &Филиал) КАК ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстатки
	|		ПО ВТ_Реализации.Реализация = ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстатки.ДокументРасчетовСКонтрагентом
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК СвойствоСтатусДоставки
	|		ПО (СвойствоСтатусДоставки.Свойство = &СвойствоДоставки)
	|			И ВТ_Реализации.Реализация = СвойствоСтатусДоставки.Объект
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК СвойствоЗаблокированоДляОплаты
	|		ПО ВТ_Реализации.Реализация = СвойствоЗаблокированоДляОплаты.Объект
	|			И (СвойствоЗаблокированоДляОплаты.Свойство = &СвойствоЗаблокировано)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК ТелефонВодителя
	|		ПО ВТ_Реализации.Реализация.Водитель = ТелефонВодителя.Объект
	|			И (ТелефонВодителя.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон))
	|			И (ТелефонВодителя.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонФизЛицаСлужебный))
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПродажиОбороты.Номенклатура.Родитель.Наименование КАК Бренд,
	|	ПродажиОбороты.Номенклатура.КодПроизводителя КАК Артикул,
	|	ПродажиОбороты.Номенклатура.Наименование КАК Наименование,
	|	ПродажиОбороты.КоличествоОборот КАК Количество,
	|	ПродажиОбороты.Номенклатура.БазоваяЕдиницаИзмерения.Наименование КАК ЕдиницаИзмерения,
	|	ПродажиОбороты.СтоимостьОборот / ПродажиОбороты.КоличествоОборот КАК Цена,
	|	ПродажиОбороты.СтоимостьОборот КАК Сумма,
	|	ВЫРАЗИТЬ(ПродажиОбороты.ДокументПродажи КАК Документ.РеализацияТоваровУслуг) КАК Реализация
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(
	|			,
	|			,
	|			Регистратор,
	|			ДокументПродажи В
	|					(ВЫБРАТЬ
	|						ВТ_Реализации.Реализация
	|					ИЗ
	|						ВТ_Реализации)
	|				И ((ВЫРАЗИТЬ(&Артикул КАК СТРОКА(20))) = """"
	|					ИЛИ Номенклатура.НормализованныйКод ПОДОБНО &Артикул)) КАК ПродажиОбороты
	|ГДЕ
	|	ПродажиОбороты.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг";
	
	Запрос.УстановитьПараметр("Филиал", Контрагент);
	Запрос.УстановитьПараметр("СвойствоДоставки", ПланыВидовХарактеристик.СвойстваОбъектов.СтатусДоставки);
	Запрос.УстановитьПараметр("СвойствоЗаблокировано", ПланыВидовХарактеристик.СвойстваОбъектов.ЗаблокированоДляОплаты);
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("ПустаяДата", Дата(1,1,1));
	Запрос.УстановитьПараметр("ОсновнаяОрганизация", Константы.ОсновнаяОрганизация.Получить());
	Запрос.УстановитьПараметр("ВключенаОпцияОплатыКартой", Константы.ИспользоватьОплатыКартой.Получить());
	
	ОчищенныйКодПроизводителя = "";
	СтрокаПроверки = СокрЛП(Артикул);
	Длина = СтрДлина(СтрокаПроверки);
	
	Для а = 1 По Длина Цикл
		
		Если Найти("0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyzАБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯабвгдеёжзийклмнопрстуфхцчшщъыьэюя", Сред(СтрокаПроверки, а, 1)) <> 0 Тогда
			ОчищенныйКодПроизводителя = ОчищенныйКодПроизводителя + Сред(СтрокаПроверки, а, 1);
		КонецЕсли; 
		
	КонецЦикла;
	
	Запрос.УстановитьПараметр("Артикул",?(СокрЛП(ОчищенныйКодПроизводителя) <> "", "%" + ОчищенныйКодПроизводителя + "%", ""));
	Запрос.УстановитьПараметр("Номер", ?(СокрЛП(НомерДокумента) <> "", "%" + СокрЛП(НомерДокумента) + "%", ""));
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	МассивДанных = Новый Массив;
	
	Пакет = Запрос.ВыполнитьПакетСПромежуточнымиДанными();
	
	ТаблицаШапок = Пакет[1].Выгрузить();
	ТаблицаТоваров = Пакет[2].Выгрузить();
	
	Для каждого СтрШапка ИЗ ТаблицаШапок Цикл
		
		СтрТовары = ТаблицаТоваров.НайтиСтроки(Новый Структура("Реализация", СтрШапка.Реализация));
		
		СтруктураДанных = Новый Структура("ИД, Дата, Номер, Валюта, Сумма, ИтогоКОплате, Аванс, Водитель, ТелефонВодителя, Контрагент, Филиал, ДатаДоставки, ВозможностьОплаты, Статус, Товары");
		
		ЗаполнитьЗначенияСвойств(СтруктураДанных, СтрШапка);
		
		СтруктураДанных.ИД = Строка(СтрШапка.Реализация.УникальныйИдентификатор());
		
		Если ЗначениеЗаполнено(СтруктураДанных.Статус) Тогда
			
			Если СтруктураДанных.Статус = Перечисления.СтатусыДоставки.ТоварДоставляется Тогда
				СтруктураДанных.Статус = "Доставляется";
			ИначеЕсли СтруктураДанных.Статус = Перечисления.СтатусыДоставки.ТоварНеДоставлен Тогда
				СтруктураДанных.Статус = "Доставляется";
			ИначеЕсли СтруктураДанных.Статус = Перечисления.СтатусыДоставки.ТоварПередан Тогда
				СтруктураДанных.Статус = "Отгружен";
			Иначе
				СтруктураДанных.Статус = "";
			КонецЕсли;
			
		Иначе
			СтруктураДанных.Статус = "Доставляется";	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрШапка.СчетФактура) Тогда
			СтруктураДанных.Номер = ОбщегоНазначения.ПолучитьНомерНаПечать(СтрШапка.СчетФактура);
		Иначе
			СтруктураДанных.Номер = ОбщегоНазначения.ПолучитьНомерНаПечать(СтрШапка.Реализация);
		КонецЕсли;
		
		МассивТоваров = Новый Массив;
		
		Для каждого СтрТовар ИЗ СтрТовары Цикл
			
			СтруктураТовара = Новый Структура("Бренд, Артикул, Наименование, Количество, ЕдиницаИзмерения, Цена, Сумма");
			
			ЗаполнитьЗначенияСвойств(СтруктураТовара, СтрТовар);
			
			МассивТоваров.Добавить(СтруктураТовара);
			
		КонецЦикла;
		
		СтруктураДанных.Товары = МассивТоваров;
		
		МассивДанных.Добавить(СтруктураДанных);
		
	КонецЦикла;
	
	СтруктураВозврата.Данные = МассивДанных;
	СтруктураВозврата.Результат = Истина;
	
	ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ЗаписьЖурналаРегистрации("HTTP-сервис OnlineStore.payments_docsales.ПолучитьСписокРеализацийДляОплаты", УровеньЖурналаРегистрации.Информация,,, 
	"HTTP-сервис OnlineStore.payments_docsales. ПолучитьСписокРеализацийДляОплаты. " 
	+ Формат((ВремяОкончанияUTC - ВремяНачалаUTC), "ЧН=0; ЧГ=0"));
	
	Возврат СтруктураВозврата;
	
КонецФункции 


///////////////////payments_docsale_summ///////////////////  
Функция ПолучитьСуммуДляОплатыПоРеализацииСервер(ПараметрыСоответсвие) Экспорт 
	
	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();  
	ПараметрыСтруктура 	= ПолучитьСтруктуруИзСоответствия(ПараметрыСоответсвие);
	
	ПараметрыЗапросаСтр = ПолучитьОписаниеПараметровЗапроса(ПараметрыСтруктура);  
	
	ЗаписьЖурналаРегистрации("HTTP-сервис OnlineStore.payments_docsale_summ.ПолучитьСуммуДляОплатыПоРеализации", УровеньЖурналаРегистрации.Информация,,, 
	"HTTP-сервис:Запуск. ПолучитьСуммуДляОплатыПоРеализации. " + ПараметрыЗапросаСтр);
	
	СтруктураВозврата = ПолучитьСуммуДляОплатыПоРеализации(ПараметрыСтруктура);
	
	ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("HTTP-сервис OnlineStore.payments_docsale_summ.ПолучитьСуммуДляОплатыПоРеализации", УровеньЖурналаРегистрации.Информация,,, 
	"HTTP-сервис:Завершение. ПолучитьСуммуДляОплатыПоРеализации "  
	+ ". Время ответа: " + Формат(ВремяОкончанияUTC - ВремяНачалаUTC, "ЧН=0; ЧГ=0"));
	//+ " м.сек." + ПараметрыЗапросаСтр);
		
	Возврат СтруктураВозврата;
	
КонецФункции    

Функция ПолучитьСуммуДляОплатыПоРеализации(ПараметрыЗапроса)
	
	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	СтруктураВозврата = Новый Структура("Результат, Сумма, Сообщение", Ложь, 0, "");
	
	Если Не ПараметрыЗапроса.Свойство("ИдентификаторДокумента") Или ПустаяСтрока(ПараметрыЗапроса.ИдентификаторДокумента) Тогда
		
		СтруктураВозврата.Сообщение = "Сумма для оплаты не получена. Причина: не задан параметр запроса ИдентификаторДокумента";
		Возврат СтруктураВозврата;
	
	КонецЕсли; 
	
	ИдентификаторДокумента = СокрЛП(ПараметрыЗапроса.ИдентификаторДокумента); 
	
	ДокументРеализация = ПолучитьДокументПоИдентификатору("РеализацияТоваровУслуг", ИдентификаторДокумента);
	
	Если ДокументРеализация.Пустая() Тогда
	
		СтруктураВозврата.Сообщение = "Сумма для оплаты не получена. Причина: не найдена реализация с идентификатором " + ИдентификаторДокумента;
		Возврат СтруктураВозврата;  
		
	КонецЕсли;

	Если НЕ ПроверитьРеализациюНаВозможностьОплаты(ДокументРеализация) Тогда
		
		СтруктураВозврата.Сообщение = "Сумма для оплаты не получена. Причина: Документ реализация не актуален"; 
		Возврат СтруктураВозврата;    
		
	КонецЕсли; 
	
	СтруктураВозврата.Сумма = ДокументРеализация.СуммаДокумента;
	СтруктураВозврата.Результат = Истина;

	Возврат СтруктураВозврата;     
	
КонецФункции

Функция ПроверитьРеализациюНаВозможностьОплаты(ПромРеализация)
	
	Если НЕ ПромРеализация.Проведен	Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	ЗапросСтатусаДоставки = Новый Запрос;
	ЗапросСтатусаДоставки.УстановитьПараметр("Ссылка", ПромРеализация); 
	ЗапросСтатусаДоставки.Текст =
	"ВЫБРАТЬ
	|	РеализацияТоваровУслуг.Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК СвойствоСтатусДоставки
	|		ПО РеализацияТоваровУслуг.Ссылка = СвойствоСтатусДоставки.Объект
	|			И (СвойствоСтатусДоставки.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СвойстваОбъектов.СтатусДоставки))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК СвойствоЗаблокирован
	|		ПО РеализацияТоваровУслуг.Ссылка = СвойствоЗаблокирован.Объект
	|			И (СвойствоЗаблокирован.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СвойстваОбъектов.ЗаблокированоДляОплаты))
	|ГДЕ
	|	РеализацияТоваровУслуг.Ссылка = &Ссылка
	|	И НЕ ЕСТЬNULL(СвойствоСтатусДоставки.Значение, ЗНАЧЕНИЕ(Перечисление.СтатусыДоставки.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.СтатусыДоставки.ТоварНеДоставлен)
	|	И ЕСТЬNULL(СвойствоЗаблокирован.Значение, ЛОЖЬ) = ЛОЖЬ";
	
	Возврат НЕ ЗапросСтатусаДоставки.Выполнить().Пустой(); 

КонецФункции


///////////////////order_create///////////////////
Функция СозданиеЗаказаСервер(СтрокаJSON, ВернутьJSON = Истина) Экспорт
	
	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("HTTP-сервис OnlineStore.order_create.СоздатьЗаказ", УровеньЖурналаРегистрации.Информация,,, "HTTP-сервис:Запуск. СоздатьЗаказ");
	
	ПараметрыСтруктура = ОбщегоНазначения.ВернутьСтруктуруИзJSON(СтрокаJSON);
	
	СтруктураВозврата = Новый Структура("Результат, Данные, Сообщение", Ложь, Неопределено, ""); 
	
	Если ПараметрыСтруктура.Свойство("Шапка") И ПараметрыСтруктура.Шапка.Свойство("ИдентификаторЗаказа") И ЗначениеЗаполнено(ПараметрыСтруктура.Шапка.ИдентификаторЗаказа) Тогда
		
		ИдентификаторЗаказа = Число(ПараметрыСтруктура.Шапка.ИдентификаторЗаказа);
		//СсылкаЗаказа	 	= Документы.ЗаказПокупателя.НайтиПоРеквизиту("IDЗаказаПортал", ИдентификаторЗаказа);        
		СсылкаЗаказа	 	= ЕстьТакойЗаказ(ИдентификаторЗаказа, ПараметрыСтруктура.Шапка.ИдентификаторСклад);
		
		Если СсылкаЗаказа.Пустая() Тогда
			СтруктураВозврата = СоздатьЗаказСПортала(ПараметрыСтруктура);
		Иначе
			
			Данные = Новый Структура("НомерЗаказа, Статус", СсылкаЗаказа.Номер, "0"); 
			
			СтруктураВозврата.Вставить("Данные", 	Данные); 
			СтруктураВозврата.Вставить("Результат", Ложь); 
			СтруктураВозврата.Вставить("Сообщение", "В базе данных уже есть Созданный Заказ Покупателю с ID: " + СокрЛП(СсылкаЗаказа.Номер));
			
		КонецЕсли;
		
		ДанныеВозврата = ?(ВернутьJSON, ОбщегоНазначения.ВернутьJSON(СтруктураВозврата), СтруктураВозврата);
		
	КонецЕсли; 
	
	ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("HTTP-сервис OnlineStore.order_create.СоздатьЗаказ", УровеньЖурналаРегистрации.Информация,,, "HTTP-сервис:Завершение. СоздатьЗаказ. " 
	+ Формат(ВремяОкончанияUTC - ВремяНачалаUTC, "ЧН=0; ЧГ=0") + " м.сек." + " Запрос:" + Символы.ПС + СтрокаJSON);
	
	Возврат ДанныеВозврата;
	
КонецФункции

Функция СоздатьЗаказСПортала(ПараметрыСтруктура) Экспорт 
		
	EMailЗаказ 				= ?(ПараметрыСтруктура.Свойство("EMailЗаказ"), ПараметрыСтруктура.EMailЗаказ, Ложь);
	
	Если EMailЗаказ Тогда
		ЗаписьЖурналаРегистрации("Запрос данных с эл почты", УровеньЖурналаРегистрации.Информация,,, "TransportOrderFromPortal начало ");	
	КонецЕсли;
	
	СтруктураВозврата 	= Новый Структура("Результат, Данные, Сообщение", Ложь, Неопределено, "");    
	ДанныеВозврата 		= Новый Структура("НомерЗаказа, Статус", "", "3");
	
	ТекДата 			= ТекущаяДата();
	Шапка				= ПараметрыСтруктура.Шапка;
	
	Если EMailЗаказ Тогда
		НеСозданныйЗаказПокупателей = Справочники.НеСозданныеЗаказыПокупателей.НайтиПоРеквизиту("ИдентификаторСообщения", СокрЛП(Шапка.ИдентификаторСообщения)); 
	Иначе		
		//НеСозданныйЗаказПокупателей = Справочники.НеСозданныеЗаказыПокупателей.НайтиПоКоду(СокрЛП(Шапка.ИдентификаторЗаказа));
		НеСозданныйЗаказПокупателей = ЕстьТакойЗаказВНесозданных(Шапка.ИдентификаторЗаказа, Шапка.ИдентификаторСклад);
	КонецЕсли;	
	
	Если НеСозданныйЗаказПокупателей <> Справочники.НеСозданныеЗаказыПокупателей.ПустаяСсылка() Тогда 

		Статус = ?(Константы.База.Получить() = Перечисления.НазваниеБазы.Казань, "1", "3");
		
		Если EMailЗаказ Тогда 
			
			ТекстСообщения 	= "Письмо " + СокрЛП(Шапка.ИдентификаторСообщения) + " было загружено ранее (см. справочник Несозданные заказы)";
			ТекстИнформации = "EMail-заказ";
			
		Иначе 
			
			ТекстСообщения 	= "В базе данных уже есть Несозданный заказ с ID " + СокрЛП(Шапка.ИдентификаторЗаказа) + ". На портал возвращается статус " + Статус + ".";	
			ТекстИнформации = "Оформление заказа с портала";
			
		КонецЕсли;
		
		ДанныеВозврата.Вставить("Статус", Статус);
		ЗаписьЖурналаРегистрации(ТекстИнформации, ?(EMailЗаказ, УровеньЖурналаРегистрации.Предупреждение, УровеньЖурналаРегистрации.Информация),,, ТекстСообщения);   
		
		СтруктураВозврата.Вставить("Результат", Ложь);
		СтруктураВозврата.Вставить("Данные", 	ДанныеВозврата);
		СтруктураВозврата.Вставить("Сообщение", ТекстСообщения);
		
		Возврат СтруктураВозврата;
		
	Иначе
		
		НовыйДокЗаказ = Документы.ЗаказПокупателя.СоздатьДокумент();
		НовыйДокЗаказ.Дата 		= ТекДата;
		НовыйДокЗаказ.Портал 	= Истина; 	
		ДопИнформация 			= "";
		
		НеСоздаватьНоменклатуруВУТ10 	 = Константы.НеСоздаватьНоменклатуруВУТ10.Получить();
		ИспользоватьДатуОтгрузкиИзЗаказа = Константы.ИспользоватьДатуОтгрузкиИзЗаказа.Получить();
		
		НеСозданныйЗП = Справочники.НеСозданныеЗаказыПокупателей.СоздатьЭлемент();
		НеСозданныйЗП.Дата 			= ТекДата;
		НеСозданныйЗП.Addres 		= Шапка.ЮрАдрес;
		НеСозданныйЗП.AddresFakt 	= СокрЛП(Шапка.ФактАдрес);
		НеСозданныйЗП.AddresFaktID 	= Шапка.ИдентификаторФактАдрес;
		НеСозданныйЗП.Comment 		= Шапка.Комментарий;
		НеСозданныйЗП.DogovorID 	= Шапка.ИдентификаторДоговора;	
		НеСозданныйЗП.FirmID 		= Шапка.ИдентификаторОрганизация;
		НеСозданныйЗП.KontragentID 	= Шапка.ИдентификаторКонтрагента;
		НеСозданныйЗП.FilialID 		= Шапка.ИдентификаторФилиала;
		НеСозданныйЗП.TipDost 		= Шапка.ТипДоставки;
		НеСозданныйЗП.ValutaID 		= СокрЛП(Шапка.ИдентификаторВалюта);
		НеСозданныйЗП.Код 			= СокрЛП(Шапка.ИдентификаторЗаказа);
		НеСозданныйЗП.Наименование 	= Шапка.НаименованиеЗаказаПортала;
		НеСозданныйЗП.INN 			= СокрЛП(Шапка.ИНН);
		НеСозданныйЗП.KPP 			= СокрЛП(Шапка.КПП);
		НеСозданныйЗП.SkladID 		= СокрЛП(Шапка.ИдентификаторСклад);
		//НеСозданныйЗП.PaymentType 	= СокрЛП(Шапка.ТипОплаты);   
		
		//+Белов А. 18.03.2025 #UT10-5136
		НеСозданныйЗП.IDПрайсЛиста = Шапка.ИдентификаторСклад;
		//-Белов А. 18.03.2025 #UT10-5136		
		
		ДатаДоставкиОтгрузки = Неопределено;   
		
		Если ИспользоватьДатуОтгрузкиИзЗаказа И НЕ EMailЗаказ Тогда   
			
			Если Шапка.Свойство("ДатаДоставки") И Шапка.ДатаДоставки <> Неопределено Тогда
				
				Если СтрДлина(Шапка.ДатаДоставки) = 19 Тогда     					
					ДатаДоставкиОтгрузки = ПреобразоватьДатуМДМ(Шапка.ДатаДоставки);					
				Иначе      
					ДатаДоставкиОтгрузки = ТекДата;
				КонецЕсли; 
				
			КонецЕсли; 
			
		ИначеЕсли ИспользоватьДатуОтгрузкиИзЗаказа И EMailЗаказ Тогда 
			ДатаДоставкиОтгрузки = ТекДата;
		КонецЕсли;	
		
		//+Белов А. 05.02.2026 #UT10-5641		
		////+Кабанов А.В. 19.05.2025 # UT10-5247
		//ЧасовойПоясФилиала   = Константы.ЧасовойПоясФилиала.Получить();
		//ДатаДоставкиОтгрузки = ДатаДоставкиОтгрузки - ЧасовойПоясФилиала*3600 ;				
		//+Кабанов А.В. 19.05.2025 # UT10-5247 
		//-Белов А. 05.02.2026 #UT10-5641
		
		НеСозданныйЗП.Dostavka 		= ДатаДоставкиОтгрузки;
		НовыйДокЗаказ.ДатаОтгрузки 	= ДатаДоставкиОтгрузки;     
		
		Контрагент 			= МСКWEB.НайтиКонтрагентаПоКодуИзПортала(СокрЛП(Шапка.ИдентификаторКонтрагента));
		ФилиалКонтрагента 	= МСКWEB.НайтиФилиалПоКодуИзПортала(СокрЛП(Шапка.ИдентификаторФилиала));
		
		Если EMailЗаказ Тогда 
			
			Если Не ЗначениеЗаполнено(Контрагент) И ЗначениеЗаполнено(Шапка.Контрагент) Тогда
				Контрагент = Шапка.Контрагент;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(ФилиалКонтрагента) И ЗначениеЗаполнено(Шапка.ФилиалКонтрагента) Тогда
				ФилиалКонтрагента = Шапка.ФилиалКонтрагента;
			КонецЕсли;
			
			НеСозданныйЗП.OrderSource 				= 6;
			НеСозданныйЗП.EMailЗаказ 				= Истина;		
			НеСозданныйЗП.ИдентификаторСообщения 	= Шапка.ИдентификаторСообщения;  
			СтрПараметры = 
			"OrderID_ = '"	    + СокрЛП(Шапка.ИдентификаторЗаказа) + "';" +
			"Addres_ = '"	    + СокрЛП(Шапка.ЮрАдрес) + "';" +
			"AddresFakt_ = '"	+ СокрЛП(Шапка.ФактАдрес) + "';" +
			"DogovorID_ = '"	+ Строка(Шапка.ИдентификаторДоговора) + "';" +
			"FirmID_ = '"		+ Строка(Шапка.ИдентификаторОрганизация) + "';" +
			"KontragentID_ = '"	+ Строка(Шапка.ИдентификаторКонтрагента) + "';" +
			"FilialID_ = '"		+ Строка(Шапка.ИдентификаторФилиала) + "';" +
			"TipDost_ = '"		+ Строка(Шапка.ТипДоставки) + "';" +
			"INN_ = '"		    + СокрЛП(Шапка.ИНН) + "';" +
			"SkladID_ = '"		+ СокрЛП(Шапка.ИдентификаторСклад) + "';" +
			//"PaymentType_ = '"	+ СокрЛП(Шапка.ТипОплаты) + "';";
			
			СтрПараметры = СтрПараметры + "ИД_Сообщения_ = '" + СокрЛП(Шапка.ИдентификаторСообщения) + "';";  	
			ЗаписьЖурналаРегистрации("Оформление заказа через EMail", УровеньЖурналаРегистрации.Информация,,, "TransportOrderFromPortal " + Символы.ПС + СтрПараметры);	
			
		Иначе
			
			Если Шапка.Свойство("КодИсточника") И Шапка.КодИсточника <> Неопределено Тогда 
				НеСозданныйЗП.OrderSource = СокрЛП(Шапка.КодИсточника);
			КонецЕсли; 
			
		КонецЕсли;
		
		Причина = "";
		
		Если ФилиалКонтрагента <> Неопределено Тогда
			НовыйДокЗаказ.Контрагент = ФилиалКонтрагента;
		ИначеЕсли Контрагент <> Неопределено Тогда
			НовыйДокЗаказ.Контрагент = Контрагент;
		Иначе 
			
			Причина = Причина + "Не найден клиент";	
			
			Если Не EMailЗаказ Тогда
				ЗаписьЖурналаРегистрации("Оформление заказа с портала", УровеньЖурналаРегистрации.Информация,,, "Не найдены контрагент по ID " + СокрЛП(Шапка.ИдентификаторКонтрагента) + " и филиал по ID " + СокрЛП(Шапка.ИдентификаторФилиала) + ".");
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НовыйДокЗаказ.Контрагент)
			И ЗначениеЗаполнено(НовыйДокЗаказ.Контрагент.ГоловнойКонтрагент)
			И НовыйДокЗаказ.Контрагент.ГоловнойКонтрагент <> НовыйДокЗаказ.Контрагент Тогда   
			
			НовыйДокЗаказ.Грузополучатель 	= НовыйДокЗаказ.Контрагент ;
			НовыйДокЗаказ.Контрагент 		= НовыйДокЗаказ.Контрагент.ГоловнойКонтрагент ;  
			
		ИначеЕсли Не EMailЗаказ или ЗначениеЗаполнено(ФилиалКонтрагента) Тогда 
			НовыйДокЗаказ.Грузополучатель = НовыйДокЗаказ.Контрагент;		
		КонецЕсли;
		
		////////////////////Заполнение способа доставки///////////////////////////
		//Значения "TipDost" из портала:
		//0 - только резерв
		//1 - самовывоз
		//2 - экспресс доставка
		//3 - трансп компания
		//4 - стандартная доставка
		//5 - такси доставка 	
		ТипДоставки = Число(Шапка.ТипДоставки);
		Если ТипДоставки = 1 ИЛИ ТипДоставки = 5 Тогда
			
			Если ТипДоставки = 5 И Константы.ТаксиДоставка.Получить() Тогда      
				
				НовыйДокЗаказ.УпаковыватьСамовывоз = Истина;
				НовыйДокЗаказ.ТаксиДоставка        = Истина; 
				
			КонецЕсли;
			
			НовыйДокЗаказ.СпособДоставки = Перечисления.СпособДоставки.Самовывоз;    
			
		ИначеЕсли ТипДоставки = 2 ИЛИ ТипДоставки = 3 ИЛИ ТипДоставки = 4 Тогда 	
			НовыйДокЗаказ.СпособДоставки = Перечисления.СпособДоставки.НашаДоставка; 	
		ИначеЕсли ТипДоставки = 0 И ЗначениеЗаполнено(НовыйДокЗаказ.Грузополучатель) Тогда
			
			НовыйДокЗаказ.ТолькоРезерв  = Истина;   
			
			Если ЗначениеЗаполнено(НовыйДокЗаказ.Грузополучатель.СпособДоставки) Тогда
				НовыйДокЗаказ.СпособДоставки = НовыйДокЗаказ.Грузополучатель.СпособДоставки;
			Иначе      
				
				Если ЗначениеЗаполнено(НовыйДокЗаказ.Грузополучатель.МаршрутДоставки) Тогда
					НовыйДокЗаказ.СпособДоставки = Перечисления.СпособДоставки.НашаДоставка;
				Иначе
					НовыйДокЗаказ.СпособДоставки = Перечисления.СпособДоставки.Самовывоз;
				КонецЕсли;
				
			КонецЕсли;	
			
		Иначе	
			Причина = ДополнитьТекстОписания(Причина, "Не указан способ доставки");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(НовыйДокЗаказ.Грузополучатель) Тогда
			Причина = ДополнитьТекстОписания(Причина, "Не заполнен филиал контрагента (выберите из справочника)");	
		КонецЕсли;
		
		Если НЕ EMailЗаказ Тогда 
			
			Если Шапка.Свойство("КодИсточника") И Шапка.КодИсточника <> Неопределено Тогда
				КодИсточника = Число(Шапка.КодИсточника);
			Иначе
				КодИсточника = 0;
			КонецЕсли;    
			
		Иначе        
			
			КодИсточника = 6; 
			
			Если ЗначениеЗаполнено(НовыйДокЗаказ.Грузополучатель) И НовыйДокЗаказ.Грузополучатель.ОбособленнаяОтгрузкаГМИзСтороннегоФилиала Тогда
				
				НеСозданныйЗП.ОбособленнаяОтгрузкаГМИзСтороннегоФилиала = Истина;
				НеСозданныйЗП.SkladID = "0";
				Причина = ДополнитьТекстОписания(Причина, "Обособленная отгрузка ГМ , выбор склада");
				
			КонецЕсли;
			
		КонецЕсли;             
		
		НовыйДокЗаказ.ИсточникЗаказа =  Справочники.ИсточникиЗаказов.НайтиПоРеквизиту("КодИсточника", КодИсточника); 
		
		Если Константы.ЗагружатьДоговораСПортала.Получить() Тогда
			
			СтруктураДоговора = МСКWEB.НайтиДоговорПоКодуИзПортала(СокрЛП(Шапка.ИдентификаторДоговора), НовыйДокЗаказ.СпособДоставки);
			Договор = СтруктураДоговора.ДоговорКонтрагента;
			НовыйДокЗаказ.ОплатаНаличными = СтруктураДоговора.ОплатаНаличными;
			
			Если СтрДлина(СокрЛП(Шапка.ИдентификаторДоговора)) > 36 Тогда
				
				МассивСтр = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(СокрЛП(Шапка.ИдентификаторДоговора), "|");
				
				Если МассивСтр.Количество() > 3 Тогда
					
					КлючСтрокиУсловий = МассивСтр[3];
					
					Попытка
						НовыйДокЗаказ.КлючСтрокиУсловий = Число(КлючСтрокиУсловий);
					Исключение
					КонецПопытки;
					
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе     
			
			Если EMailЗаказ Тогда
				Договор = ?(ЗначениеЗаполнено(НовыйДокЗаказ.Контрагент.EMailЗаказ_Договор), НовыйДокЗаказ.Контрагент.EMailЗаказ_Договор, НовыйДокЗаказ.Контрагент.ОсновнойДоговорКонтрагента);
			Иначе 
				Договор = НовыйДокЗаказ.Контрагент.ОсновнойДоговорКонтрагента;
			КонецЕсли;        
			
			НовыйДокЗаказ.ОплатаНаличными = Договор.ОплатаПоДоговоруНаличными;
			
		КонецЕсли;        
		
		Если Контрагент = Константы.ОсновнойПоставщик.Получить() 
			И (НовыйДокЗаказ.ИсточникЗаказа.КодИсточника = 2 
			ИЛИ НовыйДокЗаказ.ИсточникЗаказа.КодИсточника = 3) Тогда 
			
			ПромДоговорАПИ = Константы.ДоговорДляЗаказаЧерезАПИДляОсновногоПоставщика.Получить(); 
			
			Если НЕ ПромДоговорАПИ.Пустая() Тогда
				Договор = ПромДоговорАПИ;
			КонецЕсли;	
			
		КонецЕсли; 
		
		НовыйДокЗаказ.ДоговорКонтрагента = Договор;
		
		Если ЗначениеЗаполнено(Договор) Тогда   
			
			НовыйДокЗаказ.ВалютаДокумента 	= Договор.ВалютаВзаиморасчетов;
			НеСозданныйЗП.ТипЦенЗаказ 		= Договор.ТипЦен; 
			
		Иначе    
			
			Причина = ДополнитьТекстОписания(Причина, "Не найден основной договор с покупателем"); 
			
			Если EMailЗаказ Тогда
				ТекстОписания = "Оформление заказа через EMail";
			Иначе
				ТекстОписания = "Оформление заказа с портала";
			КонецЕсли;
			
			ЗаписьЖурналаРегистрации(ТекстОписания, УровеньЖурналаРегистрации.Предупреждение,,, "Не найден договор при создании Заказа");
			
		КонецЕсли;  
		
		НовыйДокЗаказ.Комментарий = СокрЛП(Шапка.Комментарий);
		
		Попытка   
			
			НовыйДокЗаказ.IDСклада = Число(СокрЛП(Шапка.ИдентификаторСклад));
			НовыйДокЗаказ.IDСклада_СтороннийСклад = МСК.НайтиСтороннийСкладПоID(НовыйДокЗаказ.IDСклада, Истина);	
			
		Исключение
		КонецПопытки;
		
		ЭтоСтороннийСклад = ЗначениеЗаполнено(НовыйДокЗаказ.IDСклада_СтороннийСклад);
		
		Если НЕ ЭтоСтороннийСклад И ПустойСтороннийСклад(НовыйДокЗаказ)  Тогда//???		
			ЭтоСтороннийСклад = Истина;	 	
		КонецЕсли; 	
		
		НовыйДокЗаказ.IDЗаказаПортал = СокрЛП(Шапка.ИдентификаторЗаказа);	
		
		//+Белов А. 18.03.2025 #UT10-5136
		НовыйДокЗаказ.IDПрайсЛиста = Шапка.ИдентификаторСклад;
		//-Белов А. 18.03.2025 #UT10-5136
		
		//+Белов А. 22.10.2024 UT10-4825#
		Если ЭтоСтороннийСклад И ЗначениеЗаполнено(НовыйДокЗаказ.IDСклада_СтороннийСклад) Тогда
			НовыйДокЗаказ.IDСклада = НовыйДокЗаказ.IDСклада_СтороннийСклад.IDСклада;		
		КонецЕсли;
		//-Белов А. 22.10.2024 #UT10-4825
		
		Если ЗначениеЗаполнено(НовыйДокЗаказ.Контрагент) И НовыйДокЗаказ.Контрагент.НеИспользоватьЦеныПортала 
			И НЕ Константы.ОформлятьВсеЗаказыСПортала.Получить() Тогда
			
			Если НЕ ЭтоСтороннийСклад Тогда 
				Причина = ДополнитьТекстОписания(Причина, "Не портальная цена; ");
			КонецЕсли;                                               
			
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(Договор) Тогда
			НовыйДокЗаказ.Организация = Договор.Организация;
		Иначе
			
			Если Найти(Причина, "Не найден основной договор с покупателем") = 0 Тогда
				Причина = ДополнитьТекстОписания(Причина,  "Не найден основной договор с покупателем");
			КонецЕсли;
			
		КонецЕсли;
		
		Если СокрЛП(НовыйДокЗаказ.Контрагент.ИНН) = "" Тогда
			
			Если (Константы.База.Получить() = Перечисления.НазваниеБазы.Казань ИЛИ Константы.База.Получить() = Перечисления.НазваниеБазы.Воронеж) 
				И НовыйДокЗаказ.Организация <> Константы.ОсновнаяОрганизация.Получить() Тогда 
			Иначе
				Причина = ДополнитьТекстОписания(Причина, "Нет ИНН контрагента");
			КонецЕсли;  
			
		КонецЕсли;
		
		Если (НовыйДокЗаказ.СпособДоставки = Перечисления.СпособДоставки.Самовывоз И ЗначениеЗаполнено(НовыйДокЗаказ.Грузополучатель))
			И (НЕ ТипДоставки = 5 ИЛИ (ТипДоставки = 5 И НЕ Константы.ТаксиДоставка.Получить())) Тогда		    
			НовыйДокЗаказ.УпаковыватьСамовывоз = НовыйДокЗаказ.Грузополучатель.УпаковыватьСамовывоз;		
		КонецЕсли;	
		
		//+Белов А. 02.04.2026 #UT10-5784 - заменил НовыйДокЗаказ.мВалютаРегламентированногоУчета на Константы.ВалютаРегламентированногоУчета.Получить() 
		ЗаполнениеДокументов.ЗаполнитьШапкуДокумента(НовыйДокЗаказ, глЗначениеПеременной("глТекущийПользователь"), Константы.ВалютаРегламентированногоУчета.Получить(), "Продажа", Неопределено, Неопределено, НовыйДокЗаказ.мСтруктураПараметровДляПолученияДоговора);
		
		Если ЗначениеЗаполнено(НовыйДокЗаказ.КлючСтрокиУсловий) Тогда
			
			СтрокаСКлючем = НовыйДокЗаказ.ДоговорКонтрагента.Условия.Найти(НовыйДокЗаказ.КлючСтрокиУсловий, "КлючСтроки");
			
			Если СтрокаСКлючем <> Неопределено И ЗначениеЗаполнено(СтрокаСКлючем.ТипЦен) Тогда
				НовыйДокЗаказ.ТипЦен = СтрокаСКлючем.ТипЦен;
			КонецЕсли;
			
		КонецЕсли;
		
		Если НовыйДокЗаказ.ДоговорКонтрагента.ВидДоговора <> Перечисления.ВидыДоговоровКонтрагентов.СПокупателем Тогда
			Причина = ДополнитьТекстОписания(Причина, "Вид основного договора не с покупателем");	
		КонецЕсли;	
		
		НовыйДокЗаказ.УчитыватьНДС 				= Истина;
		НовыйДокЗаказ.СуммаВключаетНДС 			= Истина; 
		//+Белов А. 02.04.2026 #UT10-5784		
		НовыйДокЗаказ.ВалютаДокумента 			= Константы.ВалютаРегламентированногоУчета.Получить();
		//НовыйДокЗаказ.ВалютаДокумента 			= НовыйДокЗаказ.мВалютаРегламентированногоУчета;
		//-Белов А. 02.04.2026 #UT10-5784		
		НовыйДокЗаказ.КратностьВзаиморасчетов 	= 1;
		НовыйДокЗаказ.КурсВзаиморасчетов 		= 1;
		НовыйДокЗаказ.СкладГруппа 				= Константы.ОсновнойСклад.Получить();
		НовыйДокЗаказ.Комментарий   			= СокрЛП(Шапка.Комментарий);   
		
		Если EMailЗаказ Тогда
			
			НеСозданныйЗП.Контрагент 		= НовыйДокЗаказ.Контрагент;
			НеСозданныйЗП.ФилиалКонтрагента = НовыйДокЗаказ.Грузополучатель;
			
		КонецЕсли;
		
		ДокСумма 		= 0;
		СтрокиЗаказа 	= ПараметрыСтруктура.Строки; 
		
		МассивКодовТовара 					= Новый Массив;
		МассивАртикул						= Новый Массив;
		МассивСинонимыПроизводителя 		= Новый Массив; 
		СоответсвиеСинонимыПроизводителей 	= Новый Соответствие;
		
		Для Поиск = 1 по 2 Цикл
			
			Для Каждого СтрокаЗаказа из СтрокиЗаказа Цикл
				
				Если Поиск = 1 Тогда   
					
					ОчищенныйПроизводитель 		= НормализоватьСтроку(СтрокаЗаказа.Родитель);
					ОчищенныйКодПроизводителя 	= НормализоватьСтроку(СтрокаЗаказа.КодПроизводителя, Истина); 
					
					НормализованныйКодТовара	= ОчищенныйПроизводитель + ОчищенныйКодПроизводителя; 
					СинонимПроизводителя		= ВРег(СокрЛП(СтрокаЗаказа.Родитель));
					
					СтрокаЗаказа.Вставить("НормализованныйКодТовара", 	НормализованныйКодТовара);
					СтрокаЗаказа.Вставить("СинонимПроизводителя", 		СинонимПроизводителя); 
					СтрокаЗаказа.Вставить("ОчищенныйКодПроизводителя", 	ОчищенныйКодПроизводителя); 
					
					МассивКодовТовара.Добавить(НормализованныйКодТовара);
					МассивСинонимыПроизводителя.Добавить(СинонимПроизводителя); 
					
					Артикул = СокрЛП(СтрокаЗаказа.Артикул);
					
					Если ЗначениеЗаполнено(Артикул) Тогда 
						МассивАртикул.Добавить(Артикул);
					КонецЕсли;	
					
				ИначеЕсли Поиск = 2 Тогда 
					
					// для вторичного поиска по нормализованному коду от синонима производителя
					ПроизводительТовара = СоответсвиеСинонимыПроизводителей.Получить(СокрЛП(СтрокаЗаказа.Родитель));
					
					Если ПроизводительТовара <> Неопределено Тогда
						
						ОчищенныйПроизводитель 		= НормализоватьСтроку(ПроизводительТовара);
						НормализованныйКодТовара	= ОчищенныйПроизводитель + СтрокаЗаказа.ОчищенныйКодПроизводителя;
						МассивКодовТовара.Добавить(НормализованныйКодТовара);						
						
					КонецЕсли;
					
				КонецЕсли;
					
			КонецЦикла;   
			
			Если Поиск = 1 Тогда
				СоответсвиеСинонимыПроизводителей 	= ПолучитьСоответсвиеДанных("РегистрСведений.СинонимыПроизводителей",МассивСинонимыПроизводителя).СоотвествиеДанных_0;
			КонецЕсли;	
				
		КонецЦикла;		
				
		//СоответсвиеНормализованныйКодТовара = ПолучитьСоответсвиеДанных("Номенклатура.НормализованныйКод",МассивКодовТовара).СоотвествиеДанных_0;
		СоответсвиеТоварАртикул 			= ПолучитьСоответсвиеДанных("Номенклатура.Артикул",МассивАртикул).СоотвествиеДанных_0;  
		СоответсвиеНормализованныйКодТовара = ПолучитьСоответсвиеДанных("Номенклатура.НормализованныйКод",МассивКодовТовара).СоотвествиеДанных_0;
		
		Для Каждого стр из СтрокиЗаказа Цикл
			
			НоваяСтрокаНеСозданныйЗП = НеСозданныйЗП.Товары.Добавить();
			НоваяСтрокаНеСозданныйЗП.Articul   = стр.КодПроизводителя;
			НоваяСтрокаНеСозданныйЗП.Brand     = стр.Родитель;
			НоваяСтрокаНеСозданныйЗП.Comment   = стр.Комментарий;
			НоваяСтрокаНеСозданныйЗП.Count     = стр.Количество;
			НоваяСтрокаНеСозданныйЗП.РазрешеноКОтгрузке = стр.Количество;
			НоваяСтрокаНеСозданныйЗП.Name      = стр.Наименование;
			НоваяСтрокаНеСозданныйЗП.NumberInv = стр.Артикул;
			НоваяСтрокаНеСозданныйЗП.Price     = стр.ЦенаКлиента;	
			НоваяСтрокаНеСозданныйЗП.Price_Zak = стр.ЦенаЗакупки;
			НоваяСтрокаНеСозданныйЗП.ПроизводительПоставщика = стр.ПроизводительПоставщика;
			НоваяСтрокаНеСозданныйЗП.Кратность = 1;// По умолчанию кратность ставим равной 1
			
			Артикул = СокрЛП(стр.Артикул);
			Товар = ?(ЗначениеЗаполнено(Артикул), СоответсвиеТоварАртикул.Получить(Артикул), Неопределено);
			
			Если Товар = Неопределено Тогда
				СтрокаПоиска = стр.НормализованныйКодТовара;
				
				Если Не ПустаяСтрока(СтрокаПоиска) Тогда                                                                                                                 
					Товар = СоответсвиеНормализованныйКодТовара.Получить(СтрокаПоиска);
				КонецЕсли;
				
				Если Товар = Неопределено Тогда 
					
					ПроизводительТовара = СоответсвиеСинонимыПроизводителей.Получить(СокрЛП(стр.Родитель));
					
					Если ПроизводительТовара <> Неопределено Тогда
						
						ОчищенныйПроизводитель 		= НормализоватьСтроку(ПроизводительТовара);
						СтрокаПоиска 				= ОчищенныйПроизводитель + стр.ОчищенныйКодПроизводителя;
						
						Если Не ПустаяСтрока(СтрокаПоиска) Тогда 
							
							Товар = СоответсвиеНормализованныйКодТовара.Получить(СтрокаПоиска);
							
							Если Товар = Неопределено Тогда 
								
								Если НеСоздаватьНоменклатуруВУТ10 Тогда  
									
									Товар 	= Неопределено;
									Причина =  ДополнитьТекстОписания(Причина, "Товар : не найден по нормализованному коду: "+ СтрокаПоиска);
									
								Иначе        
									
									Комментарий = "Создана автоматически при загрузке Заказа покупателя с портала";

									Если НЕ СоздатьНоменклатуру(Стр, ПроизводительТовара, Товар, Ложь, Комментарий, НЕ ЭтоСтороннийСклад ИЛИ EMailЗаказ) Тогда
										
										Причина =  ДополнитьТекстОписания(Причина, "Товар : не найден по нормализованному коду: " + СтрокаПоиска);
										Товар 	= Неопределено; 
										
									КонецЕсли;  
									
								КонецЕсли;
								
							КонецЕсли;
						Иначе   
							
							Причина =  ДополнитьТекстОписания(Причина, "Товар не найден" + СтрокаПоиска);
							Товар 	= Неопределено;  
							
						КонецЕсли;
						
					Иначе    
						
						Если НеСоздаватьНоменклатуруВУТ10 Тогда
							
							Товар 	= Неопределено;
							Причина =  ДополнитьТекстОписания(Причина, ?(EMailЗаказ, "Товар не найден", "Товар : не найден по нормализованному коду: " + СтрокаПоиска));
							
						Иначе                         
							
							Комментарий = "Создана автоматически при загрузке Заказа покупателя с портала";
							Если НЕ СоздатьНоменклатуру(Стр, Справочники.Номенклатура.ПустаяСсылка(), Товар, Ложь, Комментарий, НЕ ЭтоСтороннийСклад ИЛИ EMailЗаказ) Тогда
								Причина =  ДополнитьТекстОписания(Причина, ?(EMailЗаказ, "Товар не найден", "Товар : не найден по нормализованному коду: " + СтрокаПоиска));
							КонецЕсли;    
							
						КонецЕсли;
						
					КонецЕсли;							
					
				КонецЕсли;
				
			КонецЕсли;
			
			Если Товар = неопределено Тогда	
				
				Если НеСоздаватьНоменклатуруВУТ10 Тогда
					
					НеСозданныйЗП.НеНайденаНоменклатура 			= Истина; 
					НоваяСтрокаНеСозданныйЗП.НеНайденаНоменклатура 	= Истина; 
					
				КонецЕсли;			
				Продолжить;	
				
			ИначеЕсли EMailЗаказ Тогда 
				
				НоваяСтрокаНеСозданныйЗП.NumberInv 	= Товар.Артикул;
				НоваяСтрокаНеСозданныйЗП.Articul 	= Товар.КодПроизводителя;
				НоваяСтрокаНеСозданныйЗП.Name 		= Товар.Наименование;
				НоваяСтрокаНеСозданныйЗП.Brand 		= СокрЛП(Товар.Родитель.Наименование);
				НоваяСтрокаНеСозданныйЗП.Кратность 	= МСК.ПолучитьКратностьНоменклатуры(Товар); 
				
			КонецЕсли;
			
			НоваяСтрока = НовыйДокЗаказ.Товары.Добавить();	
			НоваяСтрока.Номенклатура 	= Товар;
			НоваяСтрока.ЦенаЗакупки 	= стр.ЦенаЗакупки;
			
			СоздаемНоменклатуруСкладаВМДМ = Ложь; 
			
			Если НЕ ЭтоСтороннийСклад Тогда
				СоздаемНоменклатуруСкладаВМДМ = Справочники.СобственныеСклады.НайтиПоРеквизиту("Идентификатор", НовыйДокЗаказ.IDСклада).СоздаватьНоменклатуруВМДМ;
			КонецЕсли;		   
			
			Если ЭтоСтороннийСклад ИЛИ СоздаемноменклатуруСкладаВМДМ И НЕ EMailЗаказ Тогда 
				НоваяСтрока.ПроизводительПоставщика = стр.ПроизводительПоставщика; 
			КонецЕсли;
			
			//+Гавриленков В. 19.12.2025 #UT10-5598
			//НоваяСтрока.СтавкаНДС 			= Товар.СтавкаНДС;
			НоваяСтрока.СтавкаНДС 			= УчетНДС.ПолучитьСтавкуНДСПоНоменклатуре(Товар, НовыйДокЗаказ.Дата);
			//-Гавриленков В. 19.12.2025 #UT10-5598
			НоваяСтрока.ЕдиницаИзмерения 	= Товар.ЕдиницаХраненияОстатков;   
			НоваяСтрока.Коэффициент 		= Товар.ЕдиницаХраненияОстатков.Коэффициент;
			НоваяСтрока.Количество 			= Число(СтрЗаменить(СокрЛП(стр.Количество), Символы.НПП, ""));
			НоваяСтрока.Комментарий 		= стр.Комментарий;
			
			Если EMailЗаказ Тогда  
				
				Если НЕ МСК.ПроверкаНоменклатурыНаКратность(Товар,НоваяСтрока.Количество) Тогда    
					
					Причина = ДополнитьТекстОписания(Причина, "Нарушена кратность");
					НоваяСтрокаНеСозданныйЗП.Причина 			= ?(НоваяСтрокаНеСозданныйЗП.Причина = "", НоваяСтрокаНеСозданныйЗП.Причина, НоваяСтрокаНеСозданныйЗП.Причина + ", ") + "Нарушена кратность";
					НоваяСтрокаНеСозданныйЗП.РазрешеноКОтгрузке = 0;  
					
				КонецЕсли;
				
			КонецЕсли;		
			
			Если НЕ НовыйДокЗаказ.Контрагент.НеИспользоватьЦеныПортала ИЛИ ЭтоСтороннийСклад ИЛИ EMailЗаказ Тогда 
				НоваяСтрока.Цена = Число(СтрЗаменить(СокрЛП(стр.ЦенаКлиента), Символы.НПП, ""));
			КонецЕсли;	
			
			СтрСумма = НоваяСтрока.Количество * НоваяСтрока.Цена;
			НоваяСтрока.Сумма = СтрСумма;      
			
			НоваяСтрока.СуммаНДС = УчетНДС.РассчитатьСуммуНДС(НоваяСтрока.Сумма,
																НовыйДокЗаказ.УчитыватьНДС, НовыйДокЗаказ.СуммаВключаетНДС,
																УчетНДС.ПолучитьСтавкуНДС(НоваяСтрока.СтавкаНДС));	
			
			ДокСумма = ДокСумма + СтрСумма;
			
		КонецЦикла;                                           	
		
		Если EMailЗаказ И ЗначениеЗаполнено(НовыйДокЗаказ.Контрагент) И ЗначениеЗаполнено(НовыйДокЗаказ.ДоговорКонтрагента) Тогда
			
			ТЗ = НовыйДокЗаказ.Товары.Выгрузить();
			ТЗ.Свернуть("Номенклатура,Цена");
			
			Запрос = Новый Запрос;
			Запрос.Текст = ПолучитьТекстЗапросаЦен(); 
			
			Запрос.УстановитьПараметр("ТипЦенЗаказ", НовыйДокЗаказ.ДоговорКонтрагента.ТипЦен);
			Запрос.УстановитьПараметр("ТЗ", ТЗ);
			
			Результат = Запрос.Выполнить().Выгрузить();
			ПроцентОтклонения = НовыйДокЗаказ.Контрагент.EMailЗаказ_КонтролироватьРасхождениеЦенВПроцентах;
			
			Для Каждого СтрРезультата Из Результат Цикл
				
				Отбор = Новый Структура("Articul,NumberInv,Price", СтрРезультата.Номенклатура.КодПроизводителя, СтрРезультата.Номенклатура.Артикул, СтрРезультата.ЦенаКлиента);
				СтрокиНеСоздЗП = НесозданныйЗП.Товары.НайтиСтроки(Отбор);
				
				Если (СтрРезультата.ЦенаКлиента = 0) И ЗначениеЗаполнено(СтрРезультата.ЦенаПоДоговору) Тогда   
					
					СтрокиДок = НовыйДокЗаказ.Товары.НайтиСтроки(Новый Структура("Номенклатура", СтрРезультата.Номенклатура));   
					
					Для Каждого СтрДок Из СТрокиДок Цикл
						
						СтрДок.Цена 	= СтрРезультата.ЦенаПоДоговору;
						СтрДок.Сумма 	= СтрДок.Цена * СтрДок.Количество;
						
						ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(СтрДок, НовыйДокЗаказ);
						
						ДокСумма = НовыйДокЗаказ.Товары.Итог("Сумма");
						
					КонецЦикла;   
					
					Для Каждого СтрНеСоздЗП Из СтрокиНеСоздЗП Цикл
						СтрНеСоздЗП.Price = СтрРезультата.ЦенаПоДоговору;
					КонецЦикла;
					
				Иначе   
					
					СтрПричина 		= "";
					ОтклонениеЦены 	= Ложь;                     
					
					Если СтрРезультата.ЦенаПоДоговору = 0 Тогда  
						
						СтрПричина = "Не задана цена по договору";
						Если Найти(Причина, "Не задана цена по договору") = 0 Тогда
							Причина = ДополнитьТекстОписания(Причина, "Не задана цена по договору для товара(ов)");
						КонецЕсли;            
						
					ИначеЕсли (СтрРезультата.ЦенаКлиента > 0) И (СтрРезультата.ЦенаКлиента < Окр(СтрРезультата.ЦенаПоДоговору * (1 - ПроцентОтклонения / 100), 2)) Тогда
						
						СтрПричина 		= Строка(Окр(СтрРезультата.ЦенаПоДоговору * (1-ПроцентОтклонения/100), 2));
						ОтклонениеЦены 	= Истина;
						
					КонецЕсли;
					
					Если ЗначениеЗаполнено(СтрПричина) Тогда      
						
						Для Каждого СтрНеСоздЗП Из СтрокиНеСоздЗП Цикл  
							
							Если СтрНеСоздЗП.Причина <> СтрПричина Тогда
								
								СтрНеСоздЗП.Причина 			= ?(СтрНеСоздЗП.Причина = "", СтрНеСоздЗП.Причина, СтрНеСоздЗП.Причина + ", ") + "Откл. цены";
								СтрНеСоздЗП.ЦенаОтгрузки 		= СтрПричина;
								СтрНеСоздЗП.РазрешеноКОтгрузке 	= 0;
								
								Если ОтклонениеЦены И Найти(Причина, "Отклонение цены") = 0 Тогда
									Причина = ДополнитьТекстОписания(Причина, "Отклонение цены более " + Строка(ПроцентОтклонения) + "%") ;
								КонецЕсли;
								
							КонецЕсли;					
							
						КонецЦикла; 
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла; 
			
		КонецЕсли;
		
		Если НЕ СокрЛП(Причина) = "" Или ПустойСтороннийСклад(НовыйДокЗаказ) Тогда 
			
			НеСозданныйЗП.Причина = Причина;
			
			Если ПустойСтороннийСклад(НовыйДокЗаказ) Тогда
				НеСозданныйЗП.Причина = ?(НеСозданныйЗП.Причина = "", "", НеСозданныйЗП.Причина + ", ") + "Отсутствует сторонний склад -> Запрет создания сторонних складов";
			КонецЕсли; 
			
			НеСозданныйЗП.Записать();
			НовыйЗаказ = НеСозданныйЗП.Ссылка;
			
			ДанныеВозврата.Статус = "1";
			
			Если Не EMailЗаказ Тогда
				ЗаписьЖурналаРегистрации("Оформление заказа с портала", УровеньЖурналаРегистрации.Информация,,, "Записан Несозданный заказ (код " + СокрЛП(НеСозданныйЗП.Код) + ")");
			КонецЕсли;
			
			СтруктураВозврата.Вставить("Данные", 	ДанныеВозврата);
			СтруктураВозврата.Вставить("Сообщение", Причина); 
			Возврат СтруктураВозврата;
			
		КонецЕсли;	      
		
		НовыйДокЗаказ.СуммаДокумента = ДокСумма;
		
		СтратегияАвторезервированияПоЗаказам = Перечисления.СтратегииАвторезервированияНоменклатуры.СначалаНаСкладахПотомВЗаказахПоставщикам;
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("ВидимостьСерии",     Истина);
		СтруктураПараметров.Вставить("Авторезервирование", Истина);
		СтруктураПараметров.Вставить("Авторазмещение",     Ложь);
		СтруктураПараметров.Вставить("СтратегияАвторезервированияПоЗаказам", СтратегияАвторезервированияПоЗаказам);
		
		НовыйДокЗаказ.ЗаполнитьТабличныеЧастиПередПроведениемУпр(СтруктураПараметров);
		
		//Флаг обособленной отгрузки заполняем именно здесь, если выше, то размещение не заполнится
		Если НовыйДокЗаказ.СпособДоставки = Перечисления.СпособДоставки.НашаДоставка 
			И ЗначениеЗаполнено(НовыйДокЗаказ.Грузополучатель)   
			И НовыйДокЗаказ.Грузополучатель.ОбособленнаяОтгрузкаГМИзСтороннегоФилиала Тогда
			
			НовыйДокЗаказ.ОбособленнаяОтгрузкаГМИзСтороннегоФилиала = Справочники.СобственныеСклады.IDСоответстуетОбособленнойОтгрузке(НовыйДокЗаказ.IDСклада);
			
		КонецЕсли;	
		
		СкладФильтр = Константы.ОсновнойСклад.Получить();
		
		Для каждого Стр Из НовыйДокЗаказ.Товары Цикл	
			
			Если НЕ Стр.Размещение = СкладФильтр ИЛИ НЕ ЗначениеЗаполнено(Стр.СерияНоменклатуры) Тогда					
				Стр.Размещение = "";    
			КонецЕсли; 
			
		КонецЦикла; 
		
		Если ТекущаяДата() >= Константы.РезервированиеЗаказовСУчетомЯчеек.Получить() Тогда 
			
			ТЗ = НовыйДокЗаказ.Товары.Выгрузить();
			ТЗ.Свернуть("Номенклатура,Размещение","Количество");
			
			Запрос = Новый Запрос;
			Запрос.Текст = ПолучитьТекстЗапросаНехваткиТоваров();
			
			Запрос.УстановитьПараметр("ТЗ", 				ТЗ);
			Запрос.УстановитьПараметр("ПустоеРазмещение", 	Неопределено);
			Табл = Запрос.Выполнить().Выгрузить();     
			
			Для Каждого  стр Из  Табл Цикл
				
				Отбор = Новый Структура;
				Отбор.Вставить("Номенклатура",Стр.Номенклатура);
				НайдСтроки 	= НовыйДокЗаказ.Товары.НайтиСтроки(Отбор);
				КУменьшению = Стр.Нехватка;             
				
				Для Каждого строка Из  НайдСтроки Цикл
					
					Если КУменьшению > 0 Тогда 
						
						Если Строка.Количество > КУменьшению Тогда
							
							НоваяСтрока = НовыйДокЗаказ.Товары.Добавить();
							ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);
							
							Строка.Количество 				= Строка.Количество - КУменьшению;
							НоваяСтрока.Количество 			= КУменьшению;
							НоваяСтрока.Размещение 			= "";
							НоваяСтрока.СерияНоменклатуры 	= "";
							НоваяСтрока.Сумма 				= НоваяСтрока.Количество * НоваяСтрока.Цена;  
							
							ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НоваяСтрока, НовыйДокЗаказ);
							
							Строка.Сумма = Строка.Количество * Строка.Цена; 
							
							ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(Строка, НовыйДокЗаказ);
							
							КУменьшению = 0;
							
						Иначе
							
							КУменьшению 				= КУменьшению - Строка.Количество;
							Строка.Размещение 			= "";
							Строка.СерияНоменклатуры 	= "";
							
						КонецЕсли; 
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЕсли;
		
		СобственныйСкладКакСторонний = Ложь;
		Если НЕ ЭтоСтороннийСклад Тогда
			СобственныйСкладКакСторонний = Справочники.СобственныеСклады.НайтиПоРеквизиту("Идентификатор", НовыйДокЗаказ.IDСклада).ИсключитьИзОбщегоЭкспресса;
		КонецЕсли;	
		
		Если ЭтоСтороннийСклад ИЛИ СобственныйСкладКакСторонний Тогда 
			
			ТЗ = НовыйДокЗаказ.Товары.Выгрузить();
			ТЗ.Свернуть("Номенклатура,Цена,Коэффициент,Размещение,СерияНоменклатуры","Количество");
			
			Запрос = Новый Запрос;
			Запрос.Текст = ПолучитьТекстЗапросаЦенПортала();	
			Запрос.УстановитьПараметр("ТипЦенЗаказ", 	НовыйДокЗаказ.ДоговорКонтрагента.ТипЦен);
			Запрос.УстановитьПараметр("Рубль", 			Константы.ВалютаРегламентированногоУчета.Получить());
			Запрос.УстановитьПараметр("ПустаяСерия", 	Справочники.СерииНоменклатуры.ПустаяСсылка());
			Запрос.УстановитьПараметр("ТЗ", 			ТЗ);
			
			Результат = Запрос.Выполнить().Выгрузить();
			
			Если Результат.Количество() = 0 Тогда 
				
				ВременнаяТЗ = НовыйДокЗаказ.Товары.Выгрузить();
				ВременнаяТЗ.ЗаполнитьЗначения("", "Размещение,СерияНоменклатуры");
				НовыйДокЗаказ.Товары.Загрузить(ВременнаяТЗ);
				ВременнаяТЗ = Неопределено;
				
			Иначе
				
				Для каждого Стр Из НовыйДокЗаказ.Товары Цикл  
					
					СтрРезультат = Результат.Найти(Стр.Номенклатура, "Номенклатура");
					Если СтрРезультат = Неопределено  Тогда   
						
						Стр.Размещение 			= "";
						Стр.СерияНоменклатуры 	= ""; 
						
					ИначеЕсли СтрРезультат.ЦенаПоДоговору = 0 Тогда
						Стр.Размещение = "";
					КонецЕсли;   
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если НовыйДокЗаказ.ТолькоРезерв Тогда  
			
			ПромТабличнаяЧасть = НовыйДокЗаказ.Товары.Выгрузить();
			ПромТабличнаяЧасть.ЗаполнитьЗначения(НовыйДокЗаказ.ТолькоРезерв, "ТолькоРезерв");
			НовыйДокЗаказ.Товары.Загрузить(ПромТабличнаяЧасть);
			ПромТабличнаяЧасть = Неопределено;
			
		КонецЕсли;
		
		//+Белов А. 18.09.2023 #
		МСКWEB.ОбработатьРезервОбособленнойОтгрузки(НовыйДокЗаказ);
		//-Белов А. 18.09.2023 #	
		
		Попытка        
			
			//+Белов А. 10.03.2026 #UT10-5729
			ВыделитьМаркировкуВОтдельныйЗаказ = Ложь;
			
			//Если основная организация
			Если НовыйДокЗаказ.Организация = Константы.ОсновнаяОрганизация.Получить() Тогда
				ВыделитьМаркировкуВОтдельныйЗаказ = Маркировка.ЕстьНоменклатураТребующаяМаркировки(НовыйДокЗаказ.Товары.Выгрузить()) И Константы.ВыделятьТоварыСМаркировкойПоОснОрганизацииВОтдельныйЗаказ.Получить() И МСКWEB.ПоДоворуНужноВыделениеЗаказаСМаркировкойВОтдельный(НовыйДокЗаказ.ДоговорКонтрагента);		
			Иначе
			//Если управленческая организация	
				ВыделитьМаркировкуВОтдельныйЗаказ = Маркировка.ЕстьНоменклатураТребующаяМаркировки(НовыйДокЗаказ.Товары.Выгрузить()) И Не Константы.НеВыделятьТоварыСМаркировкойПоУпрОрганизацииВОтдельныйЗаказ.Получить();  				
			КонецЕсли;
			
			Если ВыделитьМаркировкуВОтдельныйЗаказ Тогда
				
				СтруктураВыделения = МСКWEB.ВыделитьМаркировкуВОтдельныйЗаказ(НовыйДокЗаказ);	
				НовыйДокЗаказ = СтруктураВыделения.ЗаказИсходныйОбъект;  
				
			Иначе
				НовыйДокЗаказ.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Оперативный); 
			КонецЕсли;
			
			////+Белов А. 25.12.2025 #UT10-5586
			//Если Не Константы.НеВыделятьТоварыСМаркировкойПоУпрОрганизацииВОтдельныйЗаказ.Получить() 
			//	И НовыйДокЗаказ.Организация <> Константы.ОсновнаяОрганизация.Получить() 
			//	И Маркировка.ЕстьНоменклатураТребующаяМаркировки(НовыйДокЗаказ.Товары.Выгрузить()) Тогда
			//	
			//	СтруктураВыделения = МСКWEB.ВыделитьМаркировкуВОтдельныйЗаказ(НовыйДокЗаказ);	
			//	НовыйДокЗаказ = СтруктураВыделения.ЗаказИсходныйОбъект;
			//	
			////-Белов А. 25.12.2025 #UT10-5586	
			//Иначе
			//	
			//	НовыйДокЗаказ.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Оперативный); 
			//КонецЕсли;  
			//-Белов А. 10.03.2026 #UT10-5729
			
			ДанныеВозврата.Статус 		= "0";
			ДанныеВозврата.НомерЗаказа 	= НовыйДокЗаказ.Номер; 
			СтруктураВозврата.Вставить("Сообщение", "Создан новый Заказ покупателя: " + Строка(НовыйДокЗаказ));
			
		Исключение    
			
			ОшибкаЗаписи = ?( НеСозданныйЗП.Причина = "", "", НеСозданныйЗП.Причина + ", ") + "Ошибка при проведении заказа покупателя";
			НеСозданныйЗП.Причина = ОшибкаЗаписи; 
			НеСозданныйЗП.Записать();   
			
			ДанныеВозврата.Статус = "1";
			
			СтруктураВозврата.Вставить("Данные", 	ДанныеВозврата);
			СтруктураВозврата.Вставить("Сообщение", ОшибкаЗаписи);
			
			ЗаписьЖурналаРегистрации("Оформление заказа с портала", УровеньЖурналаРегистрации.Информация,,, "Ошибка при проведении заказа покупателя (" + ОписаниеОшибки() + "). Записан Несозданный заказ (код " + СокрЛП(НеСозданныйЗП.Код) + ")");
			Возврат СтруктураВозврата;
			
		КонецПопытки;	
		
		Коментарий = "Документ сформирован автоматически при загрузке заказа покупателя из портала";  
		
		Если Не ЗначениеЗаполнено(НовыйДокЗаказ.IDСклада_СтороннийСклад) Тогда
			
			Если МСК.НеобходимоПроверятьКратностьВЗаказе(НовыйДокЗаказ) Тогда 
				
				ДанныеСозданияКорректировки = МСКWEB.СоздатьКорректировкаЗаказаПокупателя(НовыйДокЗаказ,, Коментарий);
				
				Если ЗначениеЗаполнено(ДанныеСозданияКорректировки.Ошибка) Тогда
					ДанныеВозврата.Статус = "3";
				КонецЕсли;   
				
			КонецЕсли;		
			
		Иначе
			
			Если НовыйДокЗаказ.IDСклада_СтороннийСклад.ОтправлятьВАварду Тогда 
				
				ДанныеСозданияКорректировки = МСКWEB.ПроверитьКратностьИСоздатьКорректировкуЗаказаПокупателя(НовыйДокЗаказ, Коментарий);
				
				Если ЗначениеЗаполнено(ДанныеСозданияКорректировки.Ошибка) Тогда
					ДанныеВозврата.Статус = "3";
				КонецЕсли; 
				
			КонецЕсли;	
			
		КонецЕсли;  
		
		Если EMailЗаказ Тогда
			ЗаписьЖурналаРегистрации("Запрос данных с эл почты", УровеньЖурналаРегистрации.Информация,,, "TransportOrderFromPortal окончание ");	
		Иначе
		КонецЕсли; 
		
	КонецЕсли;
	
	СтруктураВозврата.Вставить("Данные", 	ДанныеВозврата);	
	СтруктураВозврата.Вставить("Результат", Истина);
	
	Возврат СтруктураВозврата;		
	
КонецФункции  

Функция НормализоватьСтроку(СтрокаИсточник, КраткаяПроверка = Ложь) Экспорт
	
	СимволыПроверки = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyzАБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯабвгдеёжзийклмнопрстуфхцчшщъыьэюя";
	
	Если КраткаяПроверка Тогда 
		СимволыПроверки = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";
	КонецЕсли;	

	СтрокаВозврата 	= "";
	СтрокаПроверки 	= ВРег(СокрЛП(СтрокаИсточник));
	Длина 			= СтрДлина(СтрокаПроверки);
	
	Для а = 1 По Длина Цикл
		
		Если Найти(СимволыПроверки, Сред(СтрокаПроверки, а, 1)) <> 0 Тогда
			СтрокаВозврата = СтрокаВозврата + Сред(СтрокаПроверки, а, 1);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СтрокаВозврата;	
	
КонецФункции	

Функция ДополнитьТекстОписания(ТекстПриемник, ТекстДобавочный) Экспорт
	
	Возврат ?(ТекстПриемник = "", ТекстПриемник, ТекстПриемник + ", ") + ТекстДобавочный;
	
КонецФункции  

Функция ПолучитьТекстЗапросаНехваткиТоваров()
	
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	Константы.ИспользоватьАлгоритмПроверкиКратностиФилиала КАК ЗначениеКонстанты
	|ПОМЕСТИТЬ КонстКратности
	|ИЗ
	|	Константы КАК Константы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТЗ.Номенклатура КАК Номенклатура,
	|	ТЗ.Количество КАК Количество,
	|	ТЗ.Размещение КАК Размещение
	|ПОМЕСТИТЬ ТаблицаНоменклатура
	|ИЗ
	|	&ТЗ КАК ТЗ
	|ГДЕ
	|	ТЗ.Размещение <> НЕОПРЕДЕЛЕНО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыВЯчейкахОстатки.Номенклатура,
	|	ТоварыВЯчейкахОстатки.КоличествоОстаток КАК Остаток,
	|	1 КАК Поле1
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	ТаблицаНоменклатура КАК ТаблицаНоменклатура
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках.Остатки(, НЕ Ячейка.НеУчитыватьВОперативномУчете) КАК ТоварыВЯчейкахОстатки
	|		ПО ТаблицаНоменклатура.Номенклатура = ТоварыВЯчейкахОстатки.Номенклатура
	|ГДЕ
	|	ТоварыВЯчейкахОстатки.Ячейка.НеУчитыватьВОперативномУчете = ЛОЖЬ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТоварыГотовыеКСборкеОстатки.Номенклатура,
	|	-ТоварыГотовыеКСборкеОстатки.КоличествоОстаток,
	|	3
	|ИЗ
	|	ТаблицаНоменклатура КАК ТаблицаНоменклатура
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыГотовыеКСборке.Остатки(, ) КАК ТоварыГотовыеКСборкеОстатки
	|		ПО ТаблицаНоменклатура.Номенклатура = ТоварыГотовыеКСборкеОстатки.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Номенклатура,
	|	СУММА(Остатки.Остаток) КАК Остаток,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА КонстКратности.ЗначениеКонстанты
	|				ТОГДА ВЫБОР
	|						КОГДА НЕ Остатки.Номенклатура.КратностьФилиала = 0
	|							ТОГДА Остатки.Номенклатура.КратностьФилиала
	|						ИНАЧЕ Остатки.Номенклатура.Кратность
	|					КОНЕЦ
	|			ИНАЧЕ Остатки.Номенклатура.Кратность
	|		КОНЕЦ) КАК Кратность
	|ПОМЕСТИТЬ ОстаткиГруппа
	|ИЗ
	|	Остатки КАК Остатки,
	|	КонстКратности КАК КонстКратности
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстаткиГруппа.Номенклатура,
	|	СУММА(ОстаткиГруппа.Остаток) КАК Остаток,
	|	СУММА(ВЫБОР
	|			КОГДА ОстаткиГруппа.Остаток > 0
	|				ТОГДА ВЫБОР
	|						КОГДА ОстаткиГруппа.Кратность > ОстаткиГруппа.Остаток
	|							ТОГДА 0
	|						ИНАЧЕ ВЫБОР
	|								КОГДА (ВЫРАЗИТЬ(ОстаткиГруппа.Остаток / ОстаткиГруппа.Кратность - 0.5 КАК ЧИСЛО(15, 0))) * ОстаткиГруппа.Кратность <= ОстаткиГруппа.Остаток
	|									ТОГДА (ВЫРАЗИТЬ(ОстаткиГруппа.Остаток / ОстаткиГруппа.Кратность - 0.5 КАК ЧИСЛО(15, 0))) * ОстаткиГруппа.Кратность
	|								ИНАЧЕ ВЫРАЗИТЬ(ОстаткиГруппа.Остаток / ОстаткиГруппа.Кратность - 0.5 КАК ЧИСЛО(15, 0))
	|							КОНЕЦ
	|					КОНЕЦ
	|			ИНАЧЕ ВЫБОР
	|					КОГДА (ВЫРАЗИТЬ(ОстаткиГруппа.Остаток / ОстаткиГруппа.Кратность + 0.5 КАК ЧИСЛО(15, 0))) * ОстаткиГруппа.Кратность <= ОстаткиГруппа.Остаток
	|						ТОГДА (ВЫРАЗИТЬ(ОстаткиГруппа.Остаток / ОстаткиГруппа.Кратность + 0.5 КАК ЧИСЛО(15, 0))) * ОстаткиГруппа.Кратность
	|					ИНАЧЕ ВЫРАЗИТЬ(ОстаткиГруппа.Остаток / ОстаткиГруппа.Кратность + 0.5 КАК ЧИСЛО(15, 0))
	|				КОНЕЦ
	|		КОНЕЦ) КАК ОстатокПоКратности
	|ПОМЕСТИТЬ ОстаткиИтог
	|ИЗ
	|	ОстаткиГруппа КАК ОстаткиГруппа
	|ГДЕ
	|	ОстаткиГруппа.Остаток > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиГруппа.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаНоменклатура.Номенклатура,
	|	ВЫБОР
	|		КОГДА ТаблицаНоменклатура.Количество - ЕСТЬNULL(ОстаткиИтог.Остаток, 0) > ТаблицаНоменклатура.Количество
	|			ТОГДА ТаблицаНоменклатура.Количество
	|		ИНАЧЕ ТаблицаНоменклатура.Количество - ЕСТЬNULL(ОстаткиИтог.Остаток, 0)
	|	КОНЕЦ КАК Нехватка_,
	|	ВЫБОР
	|		КОГДА ТаблицаНоменклатура.Количество - ЕСТЬNULL(ОстаткиИтог.ОстатокПоКратности, 0) > ТаблицаНоменклатура.Количество
	|			ТОГДА ТаблицаНоменклатура.Количество
	|		ИНАЧЕ ТаблицаНоменклатура.Количество - ЕСТЬNULL(ОстаткиИтог.ОстатокПоКратности, 0)
	|	КОНЕЦ КАК Нехватка
	|ПОМЕСТИТЬ Рез
	|ИЗ
	|	ТаблицаНоменклатура КАК ТаблицаНоменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиИтог КАК ОстаткиИтог
	|		ПО ТаблицаНоменклатура.Номенклатура = ОстаткиИтог.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Рез.Номенклатура,
	|	Рез.Нехватка
	|ИЗ
	|	Рез КАК Рез
	|ГДЕ
	|	Рез.Нехватка > 0";
	
	Возврат ТекстЗапроса;
	
КонецФункции	 

Функция ПолучитьТекстЗапросаЦенПортала()
	
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	ТЗ.Номенклатура КАК Номенклатура,
	|	ТЗ.Цена КАК ЦенаПортал,
	|	ТЗ.Коэффициент КАК Коэффициент,
	|	ТЗ.Количество КАК Количество,
	|	ТЗ.Размещение КАК Размещение,
	|	ТЗ.СерияНоменклатуры КАК СерияНоменклатуры
	|ПОМЕСТИТЬ ТаблицаНоменклатура
	|ИЗ
	|	&ТЗ КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаНоменклатура.Номенклатура,
	|	ТаблицаНоменклатура.ЦенаПортал,
	|	СправочникНоменклатура.Кратность КАК Коэффициент,
	|	ТаблицаНоменклатура.Количество,
	|	ТаблицаНоменклатура.Размещение,
	|	ТаблицаНоменклатура.СерияНоменклатуры
	|ПОМЕСТИТЬ ТабОстатков
	|ИЗ
	|	ТаблицаНоменклатура КАК ТаблицаНоменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	|		ПО ТаблицаНоменклатура.Номенклатура = СправочникНоменклатура.Ссылка
	|ГДЕ
	|	ТаблицаНоменклатура.СерияНоменклатуры <> &ПустаяСерия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабОстатков.Номенклатура,
	|	ТабОстатков.ЦенаПортал,
	|	ТабОстатков.Количество,
	|	ТабОстатков.Коэффициент,
	|	ВЫБОР
	|		КОГДА ЦеныНоменклатурыСрезПоследних.Цена ЕСТЬ NULL
	|			ТОГДА 0
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ЦеныНоменклатурыСрезПоследних.Валюта = &Рубль
	|					ТОГДА ЦеныНоменклатурыСрезПоследних.Цена
	|				ИНАЧЕ ВЫБОР
	|						КОГДА ЕСТЬNULL(КурсыВалютСрезПоследних.Кратность, 0) > 0
	|								И ЕСТЬNULL(КурсыВалютСрезПоследних.Курс, 0) > 0
	|								И ЕСТЬNULL(КурсРубля.Кратность, 0) > 0
	|								И ЕСТЬNULL(КурсРубля.Курс, 0) > 0
	|							ТОГДА ЦеныНоменклатурыСрезПоследних.Цена * (КурсыВалютСрезПоследних.Курс * КурсРубля.Кратность / (КурсРубля.Курс * КурсыВалютСрезПоследних.Кратность))
	|						ИНАЧЕ 0
	|					КОНЕЦ
	|			КОНЕЦ
	|	КОНЕЦ КАК ЦенаПоДоговору,
	|	ВЫРАЗИТЬ(ТабОстатков.Количество / ВЫБОР
	|			КОГДА ТабОстатков.Коэффициент > 0
	|				ТОГДА ТабОстатков.Коэффициент
	|			ИНАЧЕ 1
	|		КОНЕЦ КАК ЧИСЛО(15, 3)) КАК Дробное,
	|	ВЫРАЗИТЬ(ТабОстатков.Количество / ВЫБОР
	|			КОГДА ТабОстатков.Коэффициент > 0
	|				ТОГДА ТабОстатков.Коэффициент
	|			ИНАЧЕ 1
	|		КОНЕЦ КАК ЧИСЛО(15, 0)) КАК Целое
	|ИЗ
	|	ТабОстатков КАК ТабОстатков
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|				,
	|				Номенклатура В
	|						(ВЫБРАТЬ
	|							ТабОстатков.Номенклатура
	|						ИЗ
	|							ТабОстатков КАК ТабОстатков)
	|					И ТипЦен = &ТипЦенЗаказ) КАК ЦеныНоменклатурыСрезПоследних
	|		ПО ТабОстатков.Номенклатура = ЦеныНоменклатурыСрезПоследних.Номенклатура
	|			И (ЦеныНоменклатурыСрезПоследних.ТипЦен = &ТипЦенЗаказ)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(, ) КАК КурсыВалютСрезПоследних
	|		ПО (ЦеныНоменклатурыСрезПоследних.Валюта = КурсыВалютСрезПоследних.Валюта)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(, Валюта = &Рубль) КАК КурсРубля
	|		ПО (ИСТИНА)
	|ГДЕ
	|	ТабОстатков.ЦенаПортал >= ВЫБОР
	|			КОГДА ЦеныНоменклатурыСрезПоследних.Цена ЕСТЬ NULL
	|				ТОГДА 0
	|			ИНАЧЕ ВЫБОР
	|					КОГДА ЦеныНоменклатурыСрезПоследних.Валюта = &Рубль
	|						ТОГДА ЦеныНоменклатурыСрезПоследних.Цена
	|					ИНАЧЕ ВЫБОР
	|							КОГДА ЕСТЬNULL(КурсыВалютСрезПоследних.Кратность, 0) > 0
	|									И ЕСТЬNULL(КурсыВалютСрезПоследних.Курс, 0) > 0
	|									И ЕСТЬNULL(КурсРубля.Кратность, 0) > 0
	|									И ЕСТЬNULL(КурсРубля.Курс, 0) > 0
	|								ТОГДА ЦеныНоменклатурыСрезПоследних.Цена * (КурсыВалютСрезПоследних.Курс * КурсРубля.Кратность / (КурсРубля.Курс * КурсыВалютСрезПоследних.Кратность))
	|							ИНАЧЕ 0
	|						КОНЕЦ
	|				КОНЕЦ
	|		КОНЕЦ
	|	И (ВЫРАЗИТЬ(ТабОстатков.Количество / ВЫБОР
	|				КОГДА ТабОстатков.Коэффициент > 0
	|					ТОГДА ТабОстатков.Коэффициент
	|				ИНАЧЕ 1
	|			КОНЕЦ КАК ЧИСЛО(15, 3))) = (ВЫРАЗИТЬ(ТабОстатков.Количество / ВЫБОР
	|				КОГДА ТабОстатков.Коэффициент > 0
	|					ТОГДА ТабОстатков.Коэффициент
	|				ИНАЧЕ 1
	|			КОНЕЦ КАК ЧИСЛО(15, 0)))";
	
	Возврат ТекстЗапроса;
	
КонецФункции	

Функция ПолучитьТекстЗапросаЦен()
	
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	ТЗ.Номенклатура КАК Номенклатура,
	|	ТЗ.Цена КАК ЦенаКлиента
	|ПОМЕСТИТЬ ТаблицаНоменклатура
	|ИЗ
	|	&ТЗ КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаНоменклатура.Номенклатура,
	|	ЕСТЬNULL(ТаблицаНоменклатура.ЦенаКлиента,0) КАК ЦенаКлиента,
	|	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0) КАК ЦенаПоДоговору
	|ИЗ
	|	ТаблицаНоменклатура КАК ТаблицаНоменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|				,
	|				Номенклатура В
	|						(ВЫБРАТЬ
	|							ТаблицаНоменклатура.Номенклатура
	|						ИЗ
	|							ТаблицаНоменклатура)
	|					И 
	|					ТипЦен = &ТипЦенЗаказ) КАК ЦеныНоменклатурыСрезПоследних
	|		ПО ТаблицаНоменклатура.Номенклатура = ЦеныНоменклатурыСрезПоследних.Номенклатура";

	Возврат ТекстЗапроса;
	
КонецФункции

Функция ЕстьТакойЗаказ(ИдентификаторЗаказа, ИдентификаторСклад)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказПокупателя.Ссылка
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|ГДЕ
	|	ЗаказПокупателя.IDПрайсЛиста = &ИдентификаторСклад
	|	И ЗаказПокупателя.IDЗаказаПортал = &ИдентификаторЗаказа
	|	И НЕ ЗаказПокупателя.ПометкаУдаления";
	
	//+Белов А. 05.05.2026 #ITS-91643
	Запрос.УстановитьПараметр("ИдентификаторЗаказа", Число(ИдентификаторЗаказа));
	//Запрос.УстановитьПараметр("ИдентификаторЗаказа", ИдентификаторЗаказа);
	//-Белов А. 05.05.2026 #ITS-91643
	
	Запрос.УстановитьПараметр("ИдентификаторСклад", Число(ИдентификаторСклад));
	
	Выборка = Запрос.Выполнить().Выбрать();  
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;         
	
	Возврат Документы.ЗаказПокупателя.ПустаяСсылка(); 
		
КонецФункции  

Функция ЕстьТакойЗаказВНесозданных(ИдентификаторЗаказа, ИдентификаторСклад)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НеСозданныеЗаказыПокупателей.Ссылка
	|ИЗ
	|	Справочник.НеСозданныеЗаказыПокупателей КАК НеСозданныеЗаказыПокупателей
	|ГДЕ
	|	НеСозданныеЗаказыПокупателей.Код = &ИдентификаторЗаказа
	|	И НЕ НеСозданныеЗаказыПокупателей.ПометкаУдаления
	|	И НеСозданныеЗаказыПокупателей.IDПрайсЛиста = &ИдентификаторСклад";
	
	Запрос.УстановитьПараметр("ИдентификаторЗаказа", Строка(ИдентификаторЗаказа));
	Запрос.УстановитьПараметр("ИдентификаторСклад", Число(ИдентификаторСклад));
	
	Выборка = Запрос.Выполнить().Выбрать();  
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;         
	
	Возврат Справочники.НеСозданныеЗаказыПокупателей.ПустаяСсылка(); 
		
КонецФункции



