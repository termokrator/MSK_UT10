Функция ПолучитьДанныеПоВозвратамСервер(ПараметрыСоответсвие) Экспорт  

	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах(); 
	ПараметрыСтруктура = ПолучитьСтруктуруИзСоответствия(ПараметрыСоответсвие);
	
	ПараметрыЗапросаСтр = ПолучитьОписаниеПараметровЗапроса(ПараметрыСтруктура);  
	
	ЗаписьЖурналаРегистрации("HTTP-сервис OnlineStore.returns.ПолучитьДанныеПоВозвратам", УровеньЖурналаРегистрации.Информация,,, 
	"HTTP-сервис:Запуск. ПолучитьДанныеПоЗаказам. " + ПараметрыЗапросаСтр);
		
	СтруктураВозврата = ПолучитьДанныеПоВозвратам(ПараметрыСтруктура);
	
	ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("HTTP-сервис OnlineStore.returns.ПолучитьДанныеПоВозвратам", УровеньЖурналаРегистрации.Информация,,, 
	"HTTP-сервис:Завершение. ПолучитьДанныеПоВозвратам. "  
	+ Формат(ВремяОкончанияUTC - ВремяНачалаUTC, "ЧН=0; ЧГ=0") + " м.сек." + ПараметрыЗапросаСтр);
	
	Возврат СтруктураВозврата;
	
КонецФункции

Функция ПолучитьДанныеПоВозвратам(ПараметрыЗапроса) 
	
	СтруктураВозврата 	= Новый Структура("Результат, Данные, Сообщение", Ложь, Неопределено, ""); 
	СтрокаПараметров	= "НомерЗаявки, ДатаЗаявки, ИдентификаторДокумента, Статус,НаименованиеФилиала,Комментарий,НаименованиеВалюта," + 
						  "НаименованиеДоговора,НаименованиеСклада,НаименованиеОрганизации,ИНН,КПП,СуммаДокумента,СчетФактура,СчетФактураДата,ДокументРеализации";
	
	
	//Дополнительные параметры по получению данных по заказку и номенклатуры
	//используется для дополнительного запроса по http сервису, детального запроса по номенклатуре 

	ИдентификаторДокумента 	= "";
	ДокументЗаявки 			= Документы.ЗаказПокупателя.ПустаяСсылка();
	ДанныеПоЗаявке 			= Ложь;
	ДетальнаяИнформация 	= Ложь;
	ДатаНачала 				= Дата(1, 1, 1);
	ДатаОкончания			= Дата(1, 1, 1); 
	//+Гавриленков В. 06.03.2026 #UT10-5741
	//ИдентификаторКонтрагента= "";
	ТаблицаИдентификаторовКонтрагента = Новый ТаблицаЗначений;
	ТаблицаИдентификаторовКонтрагента.Колонки.Добавить("ИдентификаторКонтрагента");
	ТаблицаИдентификаторовКонтрагента.Колонки.Добавить("ПоКодуМДМ");
	//+Гавриленков В. 06.03.2026 #UT10-5741
	Филиалы 				= "";
	СписокФилиалов 			= Новый Массив; 
	МассивРезультат 		= Новый Массив; 
	АртикулТовара 			= "";
	НомерДокумента 			= "";
	СтатусЗаявки 			= "";
	ИскатьПоКодуМДМ 		= Ложь;
	
	Если ПараметрыЗапроса.Свойство("ИдентификаторДокумента") И ПараметрыЗапроса.ИдентификаторДокумента <> "" Тогда  
		
		ДанныеПоЗаявке 			= Истина;
		ИдентификаторДокумента 	= ПараметрыЗапроса.ИдентификаторДокумента;   
		
		ДокументЗаявки = ПолучитьДокументПоИдентификатору("ЗаявкаНаВозврат", ИдентификаторДокумента);
		
		Если ДокументЗаявки.Пустая() Тогда
			
			СтруктураВозврата.Сообщение = "Данные возвратов не получены. Причина: не найдена Заявка на возврат с ИдентификаторДокумента " + ИдентификаторДокумента;
			Возврат СтруктураВозврата;
			
		КонецЕсли;  
		
		ДатаНачала	  = ДокументЗаявки.Дата;
		ДатаОкончания = ДокументЗаявки.Дата;
		
	Иначе // общие параметры для др. частей запросов   
		
		Если Не ПараметрыЗапроса.Свойство("ДатаНачала") Или Не ЗначениеЗаполнено(ПараметрыЗапроса.ДатаНачала) Тогда
			
			СтруктураВозврата.Сообщение = "Данные возвратов не получены. Причина: не задан параметр ДатаНачала";
			Возврат СтруктураВозврата;
	
		КонецЕсли;   
		
		Если Не ПараметрыЗапроса.Свойство("ДатаОкончания") Или Не ЗначениеЗаполнено(ПараметрыЗапроса.ДатаОкончания) Тогда
			
			СтруктураВозврата.Сообщение = "Данные возвратов не получены. Причина: не задан параметр ДатаОкончания";
			Возврат СтруктураВозврата;
	
		КонецЕсли;  
		
		Если Не ПараметрыЗапроса.Свойство("ИдентификаторКонтрагента") Или Не ЗначениеЗаполнено(ПараметрыЗапроса.ИдентификаторКонтрагента) Тогда
			
			СтруктураВозврата.Сообщение = "Данные возвратов не получены. Причина: не задан параметр ИдентификаторКонтрагента";
			Возврат СтруктураВозврата;
	
		КонецЕсли; 
		
		ДатаНачала	  			 = СтрокаВДату(ПараметрыЗапроса.ДатаНачала);
		ДатаОкончания	  		 = СтрокаВДату(ПараметрыЗапроса.ДатаОкончания);  
		//+Гавриленков В. 06.03.2026 #UT10-5741
		//ИдентификаторКонтрагента = ПараметрыЗапроса.ИдентификаторКонтрагента;
		СтрокаКонтрагентовВТаблицу(ПараметрыЗапроса.ИдентификаторКонтрагента, ТаблицаИдентификаторовКонтрагента);
		//-Гавриленков В. 06.03.2026 #UT10-5741
		
		Если ПараметрыЗапроса.Свойство("СписокФилиалов") Тогда
			Филиалы = СокрЛП(ПараметрыЗапроса.СписокФилиалов);	
		КонецЕсли;  
		
	КонецЕсли;	
	
	ДетальнаяИнформация = Неопределено;
	ПараметрыЗапроса.Свойство("ДетальнаяИнформация", ДетальнаяИнформация);  
	ДетальнаяИнформация = СтрокаВБулево(ДетальнаяИнформация);
	
	Если ДокументЗаявки.Пустая() И ПараметрыЗапроса.Свойство("НомерДокумента") Тогда
		
		НомерДокумента = СокрЛП(ПараметрыЗапроса.НомерДокумента);   
		
		Если ЗначениеЗаполнено(НомерДокумента) Тогда
			
			ЗапросДокумента = Новый Запрос;
			ЗапросДокумента.Текст =  
			"ВЫБРАТЬ
			|	ЗаявкаНаВозврат.Ссылка,
			|	ЗаявкаНаВозврат.Дата
			|ИЗ
			|	Документ.ЗаявкаНаВозврат КАК ЗаявкаНаВозврат
			|ГДЕ
			|	ЗаявкаНаВозврат.Номер = &Номер
			|	И НЕ ЗаявкаНаВозврат.ПометкаУдаления
			|	И ЗаявкаНаВозврат.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания";
			
			ЗапросДокумента.УстановитьПараметр("ДатаНачала", ДатаНачала);
			ЗапросДокумента.УстановитьПараметр("ДатаОкончания", ?(ЗначениеЗаполнено(ДатаОкончания), КонецДня(ДатаОкончания), КонецДня(ТекущаяДата())));
			ЗапросДокумента.УстановитьПараметр("Номер", НомерДокумента);
			
			ВыборкаДокумента = ЗапросДокумента.Выполнить().Выбрать();
			
			Если ВыборкаДокумента.Следующий() Тогда       
				
				ДокументЗаявки = ВыборкаДокумента.Ссылка;      			
				ДанныеПоЗаявке = Истина;         
				
				ДатаНачала = ДокументЗаявки.Дата;
				ДатаОкончания = ДокументЗаявки.Дата;
				
			КонецЕсли;		
			
		КонецЕсли;  
		
	КонецЕсли;  

	
	Если ДетальнаяИнформация Тогда
		
		Если ПараметрыЗапроса.Свойство("Артикул") И ПараметрыЗапроса.Артикул <> "" Тогда  

			Артикул = СокрЛП(ПараметрыЗапроса.Артикул);	
			АртикулТовара = Артикул;
			
			//Длина = СтрДлина(Артикул);  
			//
			//Для а = 1 По Длина Цикл   
			//	
			//	Если Найти("0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyzАБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯабвгдеёжзийклмнопрстуфхцчшщъыьэюя", Сред(Артикул, а, 1)) <> 0 Тогда
			//		АртикулТовара = АртикулТовара + Сред(Артикул, а, 1);
			//	КонецЕсли;
			//	
			//КонецЦикла;   
			
		КонецЕсли;
						
	КонецЕсли;	
	
	//+Гавриленков В. 06.03.2026 #UT10-5741
	МассивКонтрагентов = Новый Массив;
	//-Гавриленков В. 06.03.2026 #UT10-5741
	
	Если ДанныеПоЗаявке И Не ДокументЗаявки.Пустая() Тогда 
		
		//+Гавриленков В. 06.03.2026 #UT10-5741
		//Контрагент = ДокументЗаявки.Реализация.Грузополучатель;
		МассивКонтрагентов.Добавить(ДокументЗаявки.Реализация.Грузополучатель);
		
		//Если ЗначениеЗаполнено(Контрагент.КодМДМ) Тогда
		Если ЗначениеЗаполнено(ДокументЗаявки.Реализация.Грузополучатель.КодМДМ) Тогда
			
			//ИдентификаторКонтрагента = Контрагент.КодМДМ;
			НоваяСтрока = ТаблицаИдентификаторовКонтрагента.Добавить();
			НоваяСтрока.ИдентификаторКонтрагента = ДокументЗаявки.Реализация.Грузополучатель.КодМДМ;
			НоваяСтрока.ПоКодуМДМ = Истина;
			
			//ИскатьПоКодуМДМ = Истина;       
			//РеквизитПоиска = "КодМДМ"; 
			//-Гавриленков В. 06.03.2026 #UT10-5741
			
		Иначе
			
			//+Гавриленков В. 06.03.2026 #UT10-5741
			//ИдентификаторКонтрагента 	= СтрЗаменить(СокрЛП(Контрагент.IDАварда), Символы.НПП, "");
			НоваяСтрока = ТаблицаИдентификаторовКонтрагента.Добавить();
			НоваяСтрока.ИдентификаторКонтрагента = СтрЗаменить(СокрЛП(ДокументЗаявки.Реализация.Грузополучатель.IDАварда), Символы.НПП, "");
			
			//РеквизитПоиска = "IDАварда";
			//-Гавриленков В. 06.03.2026 #UT10-5741
	
		КонецЕсли;
				
	Иначе 	
				
		Если ЗначениеЗаполнено(Филиалы) И НЕ Константы.НеПроверятьФилиалВВэбСервисах.Получить() Тогда  
			Филиалы = СтрЗаменить(Филиалы, " ", "");
			
			СписокФилиалов = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(СокрЛП(Филиалы), ","); 
		КонецЕсли;
		
		//+Гавриленков В. 06.03.2026 #UT10-5741
		//ИдентификаторКонтрагента = СтрЗаменить(СокрЛП(ИдентификаторКонтрагента), Символы.НПП, "");
		//
		//ИскатьПоКодуМДМ 		= СтрДлина(ИдентификаторКонтрагента) = 36;
		//
		//Если ИскатьПоКодуМДМ Тогда  
		//	РеквизитПоиска = "КодМДМ";	
		//Иначе
		//	РеквизитПоиска = "IDАварда";	
		//КонецЕсли;
		
		//Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту(РеквизитПоиска, ИдентификаторКонтрагента);
		Для Каждого СтрокаТаблицы Из ТаблицаИдентификаторовКонтрагента Цикл
			
			Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту(?(СтрокаТаблицы.ПоКодуМДМ, "КодМДМ", "IDАварда"), СтрокаТаблицы.ИдентификаторКонтрагента); 
			Если Не ЗначениеЗаполнено(Контрагент) Тогда
				Продолжить;
			КонецЕсли;
			
			МассивКонтрагентов.Добавить(Контрагент);
			
		КонецЦикла;
		//-Гавриленков В. 06.03.2026 #UT10-5741
		
	КонецЕсли;
	
	//+Гавриленков В. 06.03.2026 #UT10-5741
	//Если НЕ Контрагент.Пустая() Или НЕ СписокФилиалов.Количество() = 0 Тогда
	Если МассивКонтрагентов.Количество() > 0 Или НЕ СписокФилиалов.Количество() = 0 Тогда
	//-Гавриленков В. 06.03.2026 #UT10-5741
		                                                                                  
		Запрос = Новый Запрос;    
		Запрос.УстановитьПараметр("ДатаНач",			?(ЗначениеЗаполнено(ДатаНачала), НачалоДня(ДатаНачала), НачалоДня(ТекущаяДата() - 86400 * 14)));
		Запрос.УстановитьПараметр("ДатаКон",			?(ЗначениеЗаполнено(ДатаОкончания), КонецДня(ДатаОкончания), КонецДня(ТекущаяДата())));
		Запрос.УстановитьПараметр("Артикул", 			?(СокрЛП(АртикулТовара) <> "", "%" + АртикулТовара + "%", ""));  
		Запрос.УстановитьПараметр("БезОтбораПоАртикулу", НЕ ЗначениеЗаполнено(СокрЛП(АртикулТовара))); 
		Запрос.УстановитьПараметр("ДокументЗаявки", 	ДокументЗаявки);
		//+Гавриленков В. 06.03.2026 #UT10-5741
		//Запрос.УстановитьПараметр("IDАварда",			ИдентификаторКонтрагента); 
		Запрос.УстановитьПараметр("МассивКонтрагентов",			МассивКонтрагентов);
		//-Гавриленков В. 06.03.2026 #UT10-5741
		Запрос.УстановитьПараметр("СписокИД",			СписокФилиалов);  
		Запрос.УстановитьПараметр("НомерДокумента", 	НомерДокумента);  
		
		УстановитьПривилегированныйРежим(Истина);
		
		Запрос.Текст = ПолучитьТекстЗапросаЗаявкиНаВозврат(ИскатьПоКодуМДМ, СписокФилиалов, ДетальнаяИнформация, ДанныеПоЗаявке);
		РезультатЗапроса = Запрос.Выполнить();    
		
		УстановитьПривилегированныйРежим(Ложь);
		
		Если НЕ РезультатЗапроса.Пустой() Тогда 
			ОбработатьЗапросПоЗаявкам(РезультатЗапроса, ДетальнаяИнформация, СтрокаПараметров, МассивРезультат);  
		КонецЕсли;		

	Иначе
		СтруктураВозврата.Сообщение = "Данные возвратов не получены. Причина: не найден контрагент, не заданы филиалы.";
	КонецЕсли;    
	
	СтруктураВозврата.Результат = Истина;
	СтруктураВозврата.Данные 	= МассивРезультат;
	
	Возврат СтруктураВозврата;
	
КонецФункции

Процедура СтрокаКонтрагентовВТаблицу(Знач ИдентификаторКонтрагента, ТаблицаИдентификаторовКонтрагента)
//+Гавриленков В. 06.03.2026 #UT10-5741
	
	МассивСтрок = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(Сред(ИдентификаторКонтрагента, 2, СтрДлина(ИдентификаторКонтрагента) - 2), ",");
	
	Для Каждого Эл Из МассивСтрок Цикл
		
		НоваяСтрока = ТаблицаИдентификаторовКонтрагента.Добавить();
		НоваяСтрока.ИдентификаторКонтрагента = СтрЗаменить(СокрЛП(Эл), Символы.НПП, "");
		НоваяСтрока.ПоКодуМДМ = (СтрДлина(НоваяСтрока.ИдентификаторКонтрагента) = 36); 
		
	КонецЦикла;
	
//-Гавриленков В. 06.03.2026 #UT10-5741
КонецПроцедуры

Функция ПолучитьТекстЗапросаЗаявкиНаВозврат(ИскатьПоКодуМДМ, пСписокФилиалов, ДетальнаяИнформация, ДанныеПоЗаявке) 
		
	Если ДанныеПоЗаявке Тогда
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	ЗаявкаНаВозврат.Ссылка КАК Заявка,
		|	МАКСИМУМ(ЕСТЬNULL(СчетФактураВыданный.Ссылка, ЗНАЧЕНИЕ(Документ.СчетФактураВыданный.ПустаяСсылка))) КАК СчетФактура
		|ПОМЕСТИТЬ ВТ_Заявки
		|ИЗ
		|	Документ.ЗаявкаНаВозврат КАК ЗаявкаНаВозврат
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный КАК СчетФактураВыданный
		|		ПО ЗаявкаНаВозврат.Реализация = СчетФактураВыданный.ДокументОснование
		|ГДЕ
		|	ЗаявкаНаВозврат.Ссылка = &ДокументЗаявки
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаявкаНаВозврат.Ссылка
		|;";
		
	Иначе
		
		Если пСписокФилиалов.Количество() <> 0 Тогда  
			
			//+Гавриленков В. 06.03.2026 #UT10-5741
			//ТекстЗапроса = 			
			//"ВЫБРАТЬ
			//|	Контрагенты.Ссылка
			//|ПОМЕСТИТЬ ВТ_ИДАварда
			//|ИЗ
			//|	Справочник.Контрагенты КАК Контрагенты
			//|ГДЕ
			//|	Контрагенты.IDАварда = &IDАварда 
			//|;
			//|
			//|////////////////////////////////////////////////////////////////////////////////
			//|ВЫБРАТЬ
			//|	Контрагенты.Ссылка
			//|ПОМЕСТИТЬ ВТ_ТаблицаКлиентов
			//|ИЗ
			//|	Справочник.Контрагенты КАК Контрагенты
			//|ГДЕ                                     
			//|	(Контрагенты.IDФилиала В(&СписокИД) ИЛИ Контрагенты.КодМДМ В(&СписокИД))
			//|	И Контрагенты.ГоловнойКонтрагент В
			//|			(ВЫБРАТЬ
			//|				ИДАварда.Ссылка
			//|			ИЗ
			//|				ВТ_ИДАварда КАК ИДАварда)
			//|ИНДЕКСИРОВАТЬ ПО
			//|	Ссылка
			//|;";
			
			ТекстЗапроса = 			
			"ВЫБРАТЬ
			|	Контрагенты.Ссылка
			|ПОМЕСТИТЬ ВТ_ИДАварда
			|ИЗ
			|	Справочник.Контрагенты КАК Контрагенты
			|ГДЕ
			|	Контрагенты В (&МассивКонтрагентов) 
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Контрагенты.Ссылка
			|ПОМЕСТИТЬ ВТ_ТаблицаКлиентов
			|ИЗ
			|	Справочник.Контрагенты КАК Контрагенты
			|ГДЕ                                     
			|	(Контрагенты.IDФилиала В(&СписокИД) ИЛИ Контрагенты.КодМДМ В(&СписокИД))
			|	И Контрагенты.ГоловнойКонтрагент В
			|			(ВЫБРАТЬ
			|				ИДАварда.Ссылка
			|			ИЗ
			|				ВТ_ИДАварда КАК ИДАварда)
			|ИНДЕКСИРОВАТЬ ПО
			|	Ссылка
			|;";
			
			//-Гавриленков В. 06.03.2026 #UT10-5741
			
		Иначе       
			
			//+Гавриленков В. 06.03.2026 #UT10-5741
			//ТекстЗапроса = 
			//"ВЫБРАТЬ
			//|	Контрагенты.Ссылка
			//|ПОМЕСТИТЬ ВТ_ТаблицаКлиентов
			//|ИЗ
			//|	Справочник.Контрагенты КАК Контрагенты
			//|ГДЕ
			//|	Контрагенты.ГоловнойКонтрагент.IDАварда = &IDАварда
			//|ИНДЕКСИРОВАТЬ ПО
			//|	Ссылка
			//|;";  
			
			ТекстЗапроса = 
			"ВЫБРАТЬ
			|	Контрагенты.Ссылка
			|ПОМЕСТИТЬ ВТ_ТаблицаКлиентов
			|ИЗ
			|	Справочник.Контрагенты КАК Контрагенты
			|ГДЕ
			|	Контрагенты.ГоловнойКонтрагент В (&МассивКонтрагентов)
			|ИНДЕКСИРОВАТЬ ПО
			|	Ссылка
			|;";
			
			//-Гавриленков В. 06.03.2026 #UT10-5741
			
		КонецЕсли;
		
		//+Гавриленков В. 06.03.2026 #UT10-5741
		//Если ИскатьПоКодуМДМ Тогда
		//	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ".IDАварда", ".КодМДМ");
		//КонецЕсли;
		//-Гавриленков В. 06.03.2026 #UT10-5741
		
		ТекстЗапроса = ТекстЗапроса + 
		"ВЫБРАТЬ
		|	ЗаявкаНаВозврат.Ссылка КАК Заявка,
		|	МАКСИМУМ(ЕСТЬNULL(СчетФактураВыданный.Ссылка, ЗНАЧЕНИЕ(Документ.СчетФактураВыданный.ПустаяСсылка))) КАК СчетФактура
		|ПОМЕСТИТЬ ВТ_Заявки
		|ИЗ
		|	Документ.ЗаявкаНаВозврат КАК ЗаявкаНаВозврат
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТаблицаКлиентов КАК ТаблицаКлиентов
		|		ПО ЗаявкаНаВозврат.Реализация.Грузополучатель = ТаблицаКлиентов.Ссылка
		|			И (ЗаявкаНаВозврат.Дата МЕЖДУ &ДатаНач И &ДатаКон) И (НЕ ЗаявкаНаВозврат.ПометкаУдаления)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный КАК СчетФактураВыданный
		|		ПО ЗаявкаНаВозврат.Реализация = СчетФактураВыданный.ДокументОснование
		|ГДЕ
		|	НЕ ЗаявкаНаВозврат.Ссылка ЕСТЬ NULL
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаявкаНаВозврат.Ссылка
		|;";
		
		
	КонецЕсли;   
	
	ТекстЗапроса = ТекстЗапроса + "
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Заявки.Заявка,
		|	ЗаявкаНаВозвратТовары.Номенклатура,
		|	ЗаявкаНаВозвратТовары.Цена,   
		|	ЗаявкаНаВозвратТовары.Комментарий, 
		|	ЗаявкаНаВозвратТовары.Сумма,
		|	ЗаявкаНаВозвратТовары.Количество,
		|	ЗаявкаНаВозвратТовары.НомерСтроки,  
		|	ЗаявкаНаВозвратТовары.Статус, 
		|	ЗаявкаНаВозвратТовары.Тип,
		|	ВТ_Заявки.СчетФактура
		|ПОМЕСТИТЬ ВТ_ТаблЗаявки
		|ИЗ
		|	ВТ_Заявки КАК ВТ_Заявки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаВозврат.Товары КАК ЗаявкаНаВозвратТовары
		|		ПО ВТ_Заявки.Заявка = ЗаявкаНаВозвратТовары.Ссылка
		|			И (&Артикул = """"
		|				ИЛИ ЗаявкаНаВозвратТовары.Номенклатура.КодПроизводителя ПОДОБНО &Артикул)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ     
		|	ВТ_ТаблЗаявки.Заявка КАК Заявка,
		|	ВТ_ТаблЗаявки.Заявка.Номер КАК НомерЗаявки,
		|	ВТ_ТаблЗаявки.Заявка.Дата КАК ДатаЗаявки,    
		|	ВТ_ТаблЗаявки.Заявка.Статус КАК СтатусДокумента,  
		|	ВТ_ТаблЗаявки.Статус КАК Статус, 
		|	ВЫБОР
		|		КОГДА ВТ_ТаблЗаявки.Тип = ""Возврат""
		|			ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК ПризнакРекламации,
		|	ВТ_ТаблЗаявки.СчетФактура,
		|	ВТ_ТаблЗаявки.Заявка.Реализация.Грузополучатель.Наименование КАК НаименованиеФилиала,
		|	ВТ_ТаблЗаявки.Заявка.Комментарий КАК Комментарий,   
		|	ВТ_ТаблЗаявки.Заявка.Реализация КАК Реализация,
		|	ВТ_ТаблЗаявки.Заявка.Реализация.ВалютаДокумента.Наименование КАК ВалютаНаименование,
		|	ВТ_ТаблЗаявки.Заявка.Реализация.ДоговорКонтрагента.Наименование КАК НаименованиеДоговора,
		|	ВТ_ТаблЗаявки.Заявка.Реализация.Склад.Наименование КАК НаименованиеСклада,
		|	ВЫРАЗИТЬ(ВТ_ТаблЗаявки.Заявка.Реализация.Организация.Наименование КАК СТРОКА(80)) КАК НаименованиеОрганизации,
		|	ВТ_ТаблЗаявки.Номенклатура.Код КАК НомерНоменклатуры,
		|	ВТ_ТаблЗаявки.Номенклатура.ЕдиницаХраненияОстатков.Коэффициент КАК КоэффициентНомеклатуры,
		|	ВТ_ТаблЗаявки.Количество КАК Количество,
		|	ВТ_ТаблЗаявки.Цена КАК Цена,
		|	ВТ_ТаблЗаявки.Комментарий КАК КомментарийНоменклатуры,
		|	ВТ_ТаблЗаявки.Сумма КАК Сумма,   
		|	ВТ_ТаблЗаявки.Номенклатура.КодПроизводителя КАК КодПроизводителя,
		|	ВТ_ТаблЗаявки.Номенклатура.Наименование КАК НаименованиеНоменклатура,
		|	ВТ_ТаблЗаявки.Номенклатура.Родитель.Наименование КАК Бренд,
		|	ВТ_ТаблЗаявки.Номенклатура.ЕдиницаХраненияОстатков.Наименование КАК НаименованиеЕдиницаХранения,
		|	ВТ_ТаблЗаявки.Номенклатура КАК Номенклатура,
		|	ВТ_ТаблЗаявки.НомерСтроки КАК НомерСтроки, 
		|	ВЫБОР
		|		КОГДА ВТ_ТаблЗаявки.Тип = ""Возврат""
		|			ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК Рекламация,
		|	ВЫРАЗИТЬ(ВТ_ТаблЗаявки.Заявка.Реализация.Организация.Наименование КАК СТРОКА(80)) КАК ОрганизацияНаименование,
		|	ВЫБОР
		|		КОГДА ВТ_ТаблЗаявки.Заявка.Реализация.Организация.ИНН = """"
		|			ТОГДА ""-""
		|		ИНАЧЕ ВЫРАЗИТЬ(ВТ_ТаблЗаявки.Заявка.Реализация.Организация.ИНН КАК СТРОКА(10))
		|	КОНЕЦ КАК ИНН,
		|	ВЫБОР
		|		КОГДА ВТ_ТаблЗаявки.Заявка.Реализация.Организация.КПП = """"
		|			ТОГДА ""-""
		|		ИНАЧЕ ВЫРАЗИТЬ(ВТ_ТаблЗаявки.Заявка.Реализация.Организация.КПП КАК СТРОКА(9))
		|	КОНЕЦ КАК КПП,
		|	ВТ_ТаблЗаявки.СчетФактура
		|ИЗ
		|	ВТ_ТаблЗаявки КАК ВТ_ТаблЗаявки
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаЗаявки УБЫВ,
		|	НомерЗаявки УБЫВ,
		|	НомерСтроки
		|ИТОГИ
		|	СУММА(Количество),
		|	МАКСИМУМ(Цена),   
		|	МАКСИМУМ(ИНН),    
		|	МАКСИМУМ(КПП),    
		|	МАКСИМУМ(ПризнакРекламации),  
		|	МАКСИМУМ(КомментарийНоменклатуры),  
		|	МАКСИМУМ(СтатусДокумента),       
		|	МАКСИМУМ(Реализация), 
		|	МАКСИМУМ(СчетФактура),
		|	СУММА(Сумма)
		|ПО
		|	Заявка,      
		|	Статус,
		|	Номенклатура";
		
	
	Если пСписокФилиалов.Количество() = 0 Тогда 
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "
		|УНИЧТОЖИТЬ ВТ_ИДАварда
		|;", "");
		
	КонецЕсли;	
	
	Возврат ТекстЗапроса;
	
КонецФункции 

Процедура ОбработатьЗапросПоЗаявкам(РезультатЗапросаЗаказовПоСтатусам, ДетальнаяИнформация, СтрокаПараметров, МассивРезультат)
		
	ВыборкаРезультатаЗаказ = РезультатЗапросаЗаказовПоСтатусам.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);	
	
	Пока ВыборкаРезультатаЗаказ.Следующий() Цикл 
		
		СтрокаВозврата = Новый Структура(СтрокаПараметров);
		
		СтрокаВозврата.НомерЗаявки = СокрЛП(ВыборкаРезультатаЗаказ.НомерЗаявки);	
		СтрокаВозврата.ИдентификаторДокумента   = СокрЛП(ВыборкаРезультатаЗаказ.Заявка.УникальныйИдентификатор()); 
		СтрокаВозврата.НаименованиеФилиала 		= СокрЛП(ВыборкаРезультатаЗаказ.НаименованиеФилиала);
		СтрокаВозврата.Комментарий 				= СокрЛП(ВыборкаРезультатаЗаказ.Комментарий);
		СтрокаВозврата.НаименованиеВалюта 		= "RUB";
		СтрокаВозврата.НаименованиеДоговора 	= СокрЛП(ВыборкаРезультатаЗаказ.НаименованиеДоговора);
		СтрокаВозврата.НаименованиеСклада 		= СокрЛП(ВыборкаРезультатаЗаказ.НаименованиеСклада);
		СтрокаВозврата.НаименованиеОрганизации 	= СокрЛП(ВыборкаРезультатаЗаказ.НаименованиеОрганизации);
		СтрокаВозврата.СуммаДокумента 			= ВыборкаРезультатаЗаказ.Сумма;
		СтрокаВозврата.ДатаЗаявки 				= Формат(НачалоДня(ВыборкаРезультатаЗаказ.ДатаЗаявки), "ДФ='dd.MM.yyyy HH:mm'");     
		СтрокаВозврата.Статус                   = ВыборкаРезультатаЗаказ.СтатусДокумента;
		СтрокаВозврата.ИНН                      = ВыборкаРезультатаЗаказ.ИНН;
		СтрокаВозврата.КПП                      = ВыборкаРезультатаЗаказ.КПП;
		
		Если ЗначениеЗаполнено(ВыборкаРезультатаЗаказ.СчетФактура) тогда  
			
			СчетФактура = ВыборкаРезультатаЗаказ.СчетФактура;
			СтрокаВозврата.СчетФактура        = ОбщегоНазначения.ПолучитьНомерНаПечать(СчетФактура)+ " от " + Формат(СчетФактура.Дата, "ДЛФ=Д");
			СтрокаВозврата.СчетФактураДата    = Формат(СчетФактура.Дата,"ДФ='yyyy-MM-ddTHH:mm:ss'");
			СтрокаВозврата.ДокументРеализации = СтрокаВозврата.СчетФактура;   
			
		Иначе  
			
			СтрокаВозврата.СчетФактура        = СтрокаВозврата.Реализация.Номер + " от " + Формат(СтрокаВозврата.Реализация.Дата, "ДЛФ=Д"); 
			СтрокаВозврата.СчетФактураДата    = "0001-01-01T00:00:00";
			СтрокаВозврата.ДокументРеализации = СтрокаВозврата.СчетФактура;   
			
		КонецЕсли;
		
		ИтоговыйСтатус = "";
		МассивТоваров = Новый Массив;
		
		ВыборкаСтатус = ВыборкаРезультатаЗаказ.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаСтатус.Следующий() Цикл 
			
			ИтоговыйСтатус = ИтоговыйСтатус + ВыборкаСтатус.Статус + ";" + СокрЛП(ВыборкаСтатус.Количество) + ",";	
			
			Если ДетальнаяИнформация Тогда
				
				ВыборкаРезультатаНоменклатура = ВыборкаСтатус.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				
				Пока ВыборкаРезультатаНоменклатура.Следующий() Цикл  
					
					СтрокаНоменклатура 	= Новый Структура("Бренд, НаименованиеНоменклатура, КодПроизводителя, НомерНоменклатуры, НаименованиеЕдиницаХранения,
					|Количество, КоэффициентНомеклатуры, Цена, Сумма, Статус, ПризнакРекламации, КомментарийНоменклатуры");
					
					ЗаполнитьЗначенияСвойств(СтрокаНоменклатура, ВыборкаРезультатаНоменклатура);
					МассивТоваров.Добавить(СтрокаНоменклатура);	 
					
				КонецЦикла;	
			КонецЕсли;
			
		КонецЦикла;
			
		Если ДетальнаяИнформация Тогда   
			
			СтрокаВозврата.Вставить("Товары", МассивТоваров);   
			МассивРезультат.Добавить(СтрокаВозврата);
			
		Иначе      
			
			СтрокаВозврата.Статус = ИтоговыйСтатус;    
			МассивРезультат.Добавить(СтрокаВозврата);
			
		КонецЕсли;
		
	КонецЦикла;	

КонецПроцедуры


