Процедура ОбработатьЗапросПоЗаказу(РезультатЗапросаЗаказовПоСтатусам, ДетальнаяИнформация, СтрокаПараметров, МассивРезультат, СтатусЗаказа)
	
	ИдентификаторУчетнойСистемы = Константы.AMQP_ИдентификаторИнформацСистемы.Получить();
	
	ВыборкаПоИдентификаторам = РезультатЗапросаЗаказовПоСтатусам.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);	
	
	Пока ВыборкаПоИдентификаторам.Следующий() Цикл
		
		МассивСФ = Новый Массив;
		МассивДобавленныхНомеровСФ = Новый Массив;
		
		МассивТоваров = Новый Массив;  
		
		ИтоговаяСуммаДокументаСНДС = 0;
		
		ВыборкаРезультатаЗаказ = ВыборкаПоИдентификаторам.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);	
		
		Пока ВыборкаРезультатаЗаказ.Следующий() Цикл
			
			ИтоговаяСуммаДокументаСНДС = ИтоговаяСуммаДокументаСНДС + ВыборкаРезультатаЗаказ.СуммаДокументаСНДС;
			
			МассивСтруктурСтатусов = Новый Массив;
			
			ТаблицаСтатусов = Новый ТаблицаЗначений;
			ТаблицаСтатусов.Колонки.Добавить("Статус");
			ТаблицаСтатусов.Колонки.Добавить("Количество");
			
			ЗаказПокупателя = ВыборкаРезультатаЗаказ.ЗаказПокупателя; 
			
			СтрокаВозврата = Новый Структура(СтрокаПараметров);
			ЗаполнитьЗначенияСвойств(СтрокаВозврата, ВыборкаРезультатаЗаказ); 
			
			СтрокаВозврата.АдресДоставки = ?(ЗначениеЗаполнено(ЗначениеЗаполнено(ВыборкаРезультатаЗаказ.Грузополучатель)), ПолучитьАдресДоставки(ВыборкаРезультатаЗаказ.Грузополучатель), "");
			СтрокаВозврата.ДатаОформленияЗаказа 	= ЗаказПокупателя.Дата;
			
			//общие параметры из заказа   
			СтрокаВозврата.ИдентификаторУчетнойСистемы = ИдентификаторУчетнойСистемы;
			СтрокаВозврата.НаименованиеГрузополучатель 	= СокрЛП(ВыборкаРезультатаЗаказ.НаименованиеГрузополучатель);
			СтрокаВозврата.НаименованиеКонтрагент 		= СокрЛП(ВыборкаРезультатаЗаказ.НаименованиеКонтрагент);     
			СтрокаВозврата.ИдентификаторГрузополучатель 	= СокрЛП(ВыборкаРезультатаЗаказ.ИдентификаторГрузополучатель);
			СтрокаВозврата.ИдентификаторКонтрагент 		= СокрЛП(ВыборкаРезультатаЗаказ.ИдентификаторКонтрагент);
			СтрокаВозврата.Комментарий 				= СокрЛП(ВыборкаРезультатаЗаказ.Комментарий);
			СтрокаВозврата.НаименованиеВалюта 		= "RUB";
			СтрокаВозврата.НаименованиеДоговора 	= СокрЛП(ВыборкаРезультатаЗаказ.НаименованиеДоговор);
			СтрокаВозврата.ИдентификаторДоговора 	= СокрЛП(ВыборкаРезультатаЗаказ.ИдентификаторДоговор);	
			СтрокаВозврата.СуммаДокументаСНДС = ИтоговаяСуммаДокументаСНДС;
				
			СтрокаВозврата.НаименованиеОрганизации 	= СокрЛП(ВыборкаРезультатаЗаказ.НаименованиеОрганизация); 
						
			ВыборкаРезультатаНоменклатура = ВыборкаРезультатаЗаказ.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаРезультатаНоменклатура.Следующий() Цикл 
								
				//Формируем массив товаров
				МассивСтруктурСтатусов = ЗаполнитьСтрокуОтвета(ВыборкаРезультатаНоменклатура, ДетальнаяИнформация, СтрокаПараметров, МассивТоваров, СтатусЗаказа);
				
				Если Не ЗначениеЗаполнено(МассивСтруктурСтатусов) Тогда
					Продолжить;
				КонецЕсли;  
				
				Для каждого СтруктураСтатуса Из МассивСтруктурСтатусов Цикл
					
					НСтр = ТаблицаСтатусов.Добавить();
					НСтр.Статус = СтруктураСтатуса.Статус;
					НСтр.Количество = СтруктураСтатуса.Количество;
					
				КонецЦикла; 			
				
			КонецЦикла;	
		
			ТаблицаСтатусов.Свернуть("Статус", "Количество");
			ИтоговыйСтатус = "";
			
			Для каждого Стр Из ТаблицаСтатусов Цикл
				ИтоговыйСтатус = ИтоговыйСтатус + Стр.Статус + ";" + СокрЛП(Стр.Количество) + ",";	
			КонецЦикла;       
						
		КонецЦикла;	
				
		Если ДетальнаяИнформация Тогда		
			
			СтрокаВозврата.Вставить("Товары", МассивТоваров); 
			
			//+Белов А. 22.09.2025 #UT10-5334
			СтрокаВозврата.Вставить("ТоварыВРезерве", ПолучитьМассивТоваровВРезерве(МассивТоваров)); 
			//-Белов А. 22.09.2025 #UT10-5334  
			
			//+Белов А. 10.11.2025 #UT10-5495
			СтрокаВозврата.Вставить("ЗапросыИзмененияКоличества", ПолучитьМассивЗапросовНаИзменениеКоличества(МассивТоваров)); 	
			//-Белов А. 10.11.2025 #UT10-5495
						
		КонецЕсли;  
			
		МассивРезультат.Добавить(СтрокаВозврата);
		
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьМассивЗапросовНаИзменениеКоличества(МассивТоваров)
	
	МассивВозврата = Новый Массив;
	
	ТаблицаТоваров = ПреобразованиеМассивВТаблицуЗначений(МассивТоваров);
	
	ТаблицаТоваровКопия = ТаблицаТоваров.Скопировать();
	ТаблицаТоваровКопия.Свернуть("ИдентификаторДокумента");
	
	Для каждого СтрДокумента Из ТаблицаТоваровКопия Цикл
		
		Заказ = Документы.ЗаказПокупателя.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрДокумента.ИдентификаторДокумента)); 
		
		Если Заказ.ПолучитьОбъект() = Неопределено Тогда
			Продолжить;
		КонецЕсли;     
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗапросыИзмененияКоличестваВЗаказахНовые.Номенклатура.Код КАК НомерНоменклатуры,
		|	ЗапросыИзмененияКоличестваВЗаказахНовые.Статус,
		|	ЗапросыИзмененияКоличестваВЗаказахНовые.Количество,
		|	ЗапросыИзмененияКоличестваВЗаказахНовые.Комментарий,
		|	ЗапросыИзмененияКоличестваВЗаказахНовые.Идентификатор,
		|	ЗапросыИзмененияКоличестваВЗаказахНовые.Номенклатура.КодМДМ КАК КодМДМ
		|ИЗ
		|	РегистрСведений.ЗапросыИзмененияКоличестваВЗаказахНовые КАК ЗапросыИзмененияКоличестваВЗаказахНовые
		|ГДЕ
		|	ЗапросыИзмененияКоличестваВЗаказахНовые.Заказ = &Заказ";
		
		Запрос.УстановитьПараметр("Заказ", Заказ);  
		
		Выборка = Запрос.Выполнить().Выбрать(); 
		
		Пока Выборка.Следующий() Цикл
			
			СтруктураЗапроса = Новый Структура;
			СтруктураЗапроса.Вставить("НомерНоменклатуры", Выборка.НомерНоменклатуры);
			//+Белов А. 01.12.2025 #UT10-5450
			СтруктураЗапроса.Вставить("КодМДМНоменклатуры", Выборка.КодМДМ);
			//-Белов А. 01.12.2025 #UT10-5450
			СтруктураЗапроса.Вставить("Статус", Строка(Выборка.Статус));
			СтруктураЗапроса.Вставить("Количество", Выборка.Количество);
			СтруктураЗапроса.Вставить("Комментарий", Выборка.Комментарий);
			СтруктураЗапроса.Вставить("ИдентификаторЗапроса", Выборка.Идентификатор);
			
			МассивВозврата.Добавить(СтруктураЗапроса);
			
		КонецЦикла;                             		
					
	КонецЦикла;   
	
	Возврат МассивВозврата;
	
КонецФункции

Функция ПолучитьМассивТоваровВРезерве(МассивТоваров)
	//+Белов А. 22.09.2025 #UT10-5334
	
	МассивИерархииСтатусов = Новый Массив;  
	МассивИерархииСтатусов.Добавить("Заказан");
	МассивИерархииСтатусов.Добавить("ЗаказаноПоставщику");
	МассивИерархииСтатусов.Добавить("Зарезервирован");
	
	МассивВозврата = Новый Массив;
	
	ТаблицаТоваров = ПреобразованиеМассивВТаблицуЗначений(МассивТоваров);
	
	ТаблицаТоваровКопия = ТаблицаТоваров.Скопировать();
	ТаблицаТоваровКопия.Свернуть("ИдентификаторДокумента");
	
	Для каждого СтрДокумента Из ТаблицаТоваровКопия Цикл
		
		Заказ = Документы.ЗаказПокупателя.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрДокумента.ИдентификаторДокумента));
		
		Если Заказ.ПолучитьОбъект() = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		//+Сёмин Р. 13.11.2025 #UT10-5422
		ОбработкаКорректировкаРезервов = Обработки.КорректировкаРезервов.Создать();
		РезультатПакетаЗапросов = ОбработкаКорректировкаРезервов.ПолучитьДанныеПоРезервамЗаказовПокупателей(Заказ);
		РезультатЗапросаПоРезервам = РезультатПакетаЗапросов[2];
		
		Если РезультатЗапросаПоРезервам.Пустой() Тогда
			
			//+Сёмин Р.И. 10.03.2026 #UT10-5726
			//ДатаОкончанияРезерва = "";
			ДатаОкончанияРезерва = ОбработкаКорректировкаРезервов.ПолучитьДанныеПоРезервуЗаказаНеИзРегистра(Заказ);
			//+Сёмин Р.И. 10.03.2026 #UT10-5726
			
		Иначе
			
			Выборка = РезультатЗапросаПоРезервам.Выбрать();
			Выборка.Следующий();
			
			ДатаОкончанияРезерва = Выборка.ОкончаниеРезерва;
			
		КонецЕсли;
		//-Сёмин Р. 13.11.2025 #UT10-5422
		
		СтрокиСГалкой = Заказ.Товары.НайтиСтроки(Новый Структура("ТолькоРезерв", Истина)); 
		
		Для каждого СтрГалка Из СтрокиСГалкой Цикл
			
			СтрокаПоСтатусом = Неопределено; 
			СтатусОтбора = Неопределено;
			
			ВремТаблицаТоваров = ТаблицаТоваров.Скопировать(Новый Структура("ИдентификаторДокумента, НомерНоменклатуры", СтрДокумента.ИдентификаторДокумента, СтрГалка.Номенклатура.Код));
			ВремТаблицаТоваров.Свернуть("Статус");
			
			Если ВремТаблицаТоваров.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Для каждого СтатусИерархии Из МассивИерархииСтатусов Цикл
				
				СтрокаПоиска = ВремТаблицаТоваров.Найти(СтатусИерархии, "Статус");
				Если СтрокаПоиска <> Неопределено Тогда
					
					СтатусОтбора = СтрокаПоиска.Статус;
					Прервать;
					
				КонецЕсли;
				
			КонецЦикла;
			
			Если СтатусОтбора = Неопределено Тогда
				СтатусОтбора = ВремТаблицаТоваров[0].Статус; 	
			КонецЕсли;
						
			СтрокиТоваров = ТаблицаТоваров.НайтиСтроки(Новый Структура("ИдентификаторДокумента, НомерНоменклатуры, Статус", СтрДокумента.ИдентификаторДокумента, СтрГалка.Номенклатура.Код, СтатусОтбора));
			
			Если СтрокиТоваров.Количество() > 0 Тогда
				
				СтруктураВозврата = Новый Структура;
				
				Для каждого Кол Из ТаблицаТоваров.Колонки Цикл
					СтруктураВозврата.Вставить(Кол.Имя, СтрокиТоваров[0][Кол.Имя]);
				КонецЦикла;                                                        
				
				СтруктураВозврата.Вставить("ИдентификаторСтроки", СтрГалка.КлючСтроки); 
				СтруктураВозврата.Количество = СтрГалка.Количество;
				СтруктураВозврата.СуммаСНДС = СтрГалка.Количество * СтруктураВозврата.ЦенаСНДС; 
				
				//+Сёмин Р. 13.11.2025 #UT10-5422
				СтруктураВозврата.Вставить("ДатаОкончанияРезерва", ДатаОкончанияРезерва); 
				//-Сёмин Р. 13.11.2025 #UT10-5422      
								
				МассивВозврата.Добавить(СтруктураВозврата);
				
			КонецЕсли;			
			
		КонецЦикла;
		
	КонецЦикла;   
	
	Возврат МассивВозврата;
	
	//-Белов А. 22.09.2025 #UT10-5334
КонецФункции

Функция ПолучитьНаименованиеСтатусаДляПортала(ИмяСтатуса, Выборка)

	КодСтатуса = ПолучитьКодПоИмениСтатуса(ИмяСтатуса); 	
	ПредставлениеСтатуса = Строка(Перечисления.СостояниеЗаказаПокупателя[ИмяСтатуса]);
	
	//Возврат КодСтатуса + ";" + ПредставлениеСтатуса;
	Возврат ВРег(Лев(ПредставлениеСтатуса, 1)) + Сред(ПредставлениеСтатуса, 2);
	
КонецФункции

Функция ПолучитьКодПоИмениСтатуса(ИмяСтатуса)
	
	Если ИмяСтатуса = "ОтказПокупателя" Тогда
		Возврат "100";	
	ИначеЕсли ИмяСтатуса = "ЗаказаноПоставщику" Тогда
		Возврат "10";
	ИначеЕсли ИмяСтатуса = "ОтказПоставщика" Тогда 
		Возврат "110";
	ИначеЕсли ИмяСтатуса = "Выполнен" Тогда 
		Возврат "60";                         
	ИначеЕсли ИмяСтатуса = "НаДоставке" Тогда
		Возврат "50";
	ИначеЕсли ИмяСтатуса = "ГотовКОтгрузке" Тогда
		Возврат "40";
	ИначеЕсли ИмяСтатуса = "НаПодборе" Тогда
		Возврат "30";	
	ИначеЕсли ИмяСтатуса = "Зарезервирован" Тогда
		Возврат "10";
	ИначеЕсли ИмяСтатуса = "Заказан" Тогда
		Возврат "20";		
	КонецЕсли;

	Возврат "";
	
КонецФункции 	
		
Функция ЗаполнитьСтрокуОтвета(ВыборкаРезультата, ДетальнаяИнформация, СтрокаПараметров, МассивРезультат, СтатусЗаказа = "")     
	
	ЗаказПокупателя = ВыборкаРезультата.ЗаказПокупателя;
		
	МассивСтатусовПолученияОстатка = Новый Массив;
	МассивСтатусовПолученияОстатка.Добавить("Выполнен");
	МассивСтатусовПолученияОстатка.Добавить("НаДоставке");
	МассивСтатусовПолученияОстатка.Добавить("ГотовКОтгрузке");
	МассивСтатусовПолученияОстатка.Добавить("НаПодборе");
	МассивСтатусовПолученияОстатка.Добавить("Зарезервирован");
	МассивСтатусовПолученияОстатка.Добавить("Заказан");
	
	ЗаказаноПоставщику = ВыборкаРезультата.ЗаказаноПоставщикуОстаток;    
	ОтказаноПоставщиком = ВыборкаРезультата.КоличествоОтказПоставщика;   
	ОтказаноКлиентом = ВыборкаРезультата.КоличествоОтказКлиента;
	
	ВсегоЗаказано = ВыборкаРезультата.КоличествоЗаказано - (ОтказаноКлиентом + ОтказаноПоставщиком); 
	
	СтруктураСтатусов = Новый Структура();
	СтруктураСтатусов.Вставить("ОтказПокупателя",    ВыборкаРезультата.КоличествоОтказКлиента);
	СтруктураСтатусов.Вставить("ЗаказаноПоставщику", ВыборкаРезультата.ЗаказаноПоставщикуОстаток);
	СтруктураСтатусов.Вставить("ОтказПоставщика",    ВыборкаРезультата.КоличествоОтказПоставщика); 
	
	Набрано = 0;   
	
	Для каждого СтатусОстатка Из МассивСтатусовПолученияОстатка Цикл
		
		Если ВсегоЗаказано - Набрано > 0 Тогда
			
			Количество = 0;
			
			Если СтатусОстатка = "Выполнен" Тогда			
				Количество = ВыборкаРезультата.КоличествоВыполнено; 
			ИначеЕсли СтатусОстатка = "НаДоставке" Тогда			
				
				Количество = ВыборкаРезультата.КоличесвоНаДоставке - Набрано;
				
				//+Белов А. 26.02.2026 #
				//Такое срабатывает для самовывозов, там не может быть статуса на доставке
				Если Количество < 0 Тогда
					
					СтруктураСтатусов.Вставить(СтатусОстатка, 0);
					Продолжить;
					
				КонецЕсли;
				//-Белов А. 26.02.2026 #
				
			ИначеЕсли СтатусОстатка = "ГотовКОтгрузке" Тогда			
				
				//+Белов А. 26.02.2026 #Для самовывоза не делаются ГМ, поэтому статус готовности к отгрузки определяется по количеству собранного
				
				//+Сёмин Р.И. 13.03.2026 #UT10-5726
				//Если ВыборкаРезультата.СпособДоставки = Перечисления.СпособДоставки.Самовывоз Тогда
				Если ВыборкаРезультата.СпособДоставки = Перечисления.СпособДоставки.Самовывоз И ВыборкаРезультата.ДокументСобранИУпакован = Истина Тогда
				//-Сёмин Р.И. 13.03.2026 #UT10-5726
					Количество = ВыборкаРезультата.КоличествоСобрано;	
				//-Белов А. 26.02.2026 #
				Иначе
					Количество = ВыборкаРезультата.КоличествоКПогрузке;  
				КонецЕсли;
				
			ИначеЕсли СтатусОстатка = "НаПодборе" Тогда			
				Количество = ВыборкаРезультата.КоличествоСобрано - Набрано; 
			ИначеЕсли СтатусОстатка = "Зарезервирован" Тогда			
				Количество = (ВыборкаРезультата.КоличествоРезерв + ВыборкаРезультата.КоличествоВРелизацииНеПереданного) 
				           - СтруктураСтатусов.НаПодборе - СтруктураСтатусов.ГотовКОтгрузке - СтруктураСтатусов.НаДоставке;
			ИначеЕсли СтатусОстатка = "Заказан" Тогда			
				Количество = ВсегоЗаказано - Набрано - СтруктураСтатусов.ЗаказаноПоставщику;
			КонецЕсли;	
			
			Набрано = Набрано + Количество;
			СтруктураСтатусов.Вставить(СтатусОстатка, Количество);	
				
		КонецЕсли; 	
		
	КонецЦикла; 
	
	МассивСтруктурСтатусов = Новый Массив;  
	НаименованиеСтатусаДляПортала = "";
	
	Для каждого Статус Из СтруктураСтатусов Цикл
		
		Если Не Статус.Значение > 0 Тогда
			Продолжить;
		КонецЕсли;	 
		
		КодСтатуса = ПолучитьКодПоИмениСтатуса(Статус.Ключ);   
		
		Если ЗначениеЗаполнено(СокрЛП(СтатусЗаказа)) И СокрЛП(КодСтатуса) <> СокрЛП(СтатусЗаказа) Тогда
			Продолжить;	
		КонецЕсли;
		
		Если Статус.Ключ = "ЗаказаноПоставщику" Тогда
			НаименованиеСтатусаДляПортала = СформироватьСообщениеДляПортала(Статус.Ключ, Статус.Значение, ВыборкаРезультата.СтатусAvarda, 10, Ложь, ?(ВыборкаРезультата.СтатусПоДопПостащику = "", "ЦС в Москве", ВыборкаРезультата.СтатусПоДопПостащику));
		ИначеЕсли Статус.Ключ = "ОтказПоставщика" Тогда	
			НаименованиеСтатусаДляПортала = ?(ВыборкаРезультата.ТаксиДоставка, "Нет на складе", "Отказ поставщика");
		ИначеЕсли Статус.Ключ = "Выполнен" Тогда				
			
			Если ЗаказПокупателя.ТаксиДоставка И ?(ДетальнаяИнформация, КонецДня(ВыборкаРезультата.ДокументаОтгрузки.Дата) = КонецДня(ТекущаяДата()), КонецДня(ВыборкаРезультата.ДатаПоследнейОтгрузки) = КонецДня(ТекущаяДата())) Тогда
				//НаименованиеСтатусаДляПортала = "60;Такси доставка " + ?(Статус.Значение = 0 , "", "(" + СокрЛП(Статус.Значение) + " гр.мест)") + "";
				НаименованиеСтатусаДляПортала = "Такси доставка";
			Иначе
				НаименованиеСтатусаДляПортала = ПолучитьНаименованиеСтатусаДляПортала(Статус.Ключ, ВыборкаРезультата);	
			КонецЕсли;      	
			
		Иначе
			НаименованиеСтатусаДляПортала = ПолучитьНаименованиеСтатусаДляПортала(Статус.Ключ, ВыборкаРезультата);
		КонецЕсли; 		
		
		Если ДетальнаяИнформация Тогда
			
			СтрокаВозврата = ДобавитьСтрокуКЗаказуНаПортал(ВыборкаРезультата, НаименованиеСтатусаДляПортала, Статус.Значение);
			
			Если НЕ СтрокаВозврата = "" Тогда 
				МассивРезультат.Добавить(СтрокаВозврата);	
			КонецЕсли;
				
		КонецЕсли; 
		
		МассивСтруктурСтатусов.Добавить(Новый Структура("Статус, Количество", НаименованиеСтатусаДляПортала, Статус.Значение));	
		
	КонецЦикла; 
	
	Возврат МассивСтруктурСтатусов; 
	
КонецФункции

Функция СформироватьСообщениеДляПортала(ИмяПоля, Количество, СтатусAvarda, КодСообщения, ДобавитьТочкуСЗапятой = Ложь, СтатусПоДопПостащику = "ЦС в Москве") Экспорт
	
	Результат = "";
	
	Если ИмяПоля = "ЗаказаноПоставщику" И Количество > 0 Тогда
		
		Если НЕ ЗначениеЗаполнено(СтатусAvarda)  Тогда
			Результат = "Заказано поставщику"			
		Иначе

			Если СтатусAvarda = "10; составлен" Тогда                   
				Результат = "Размещен на складе";
			ИначеЕсли СтатусAvarda = "10; зарезервирован" Тогда                    
				Результат = "Зарезервирован на складе";
			ИначеЕсли СтатусAvarda = "30; на подборе" Тогда                     
				Результат = "Подбирается на складе";
			ИначеЕсли СтатусAvarda = "40; подобрано" Тогда                     
				Результат = "Подобрано на складе";
			ИначеЕсли СтатусAvarda = "40; готов к отгрузке" Тогда                    
				Результат = "Готов к отгрузке со склада";
			ИначеЕсли СтатусAvarda = "50; на доставке" Тогда
				Результат = "Отгружено со склада" ;
			ИначеЕсли СтатусAvarda = "300; принят в работу" Тогда
				Результат = "Размещен у поставщика";
			ИначеЕсли СтатусAvarda = "310; размещен у поставщика" Тогда
				Результат = "Размещен у поставщика";
			ИначеЕсли СтатусAvarda = "320; подтвежден поставщиком" Тогда
				Результат = "Подтвержден поставщиком";
			ИначеЕсли СтатусAvarda = "320; в пути на склад" Тогда
				Результат = "В пути на склад ЦС в Москве";
			ИначеЕсли СтатусAvarda = "330; поступило на склад" Тогда
				Результат = "Поступило на склад ЦС в Москве";
			ИначеЕсли Результат = "" Тогда
				Результат = "заказано поставщику";				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	Если ДобавитьТочкуСЗапятой Тогда
		Результат = Результат + ";";
	КонецЕсли; 
	
	Возврат Результат ;
	
КонецФункции

Функция ДобавитьСтрокуКЗаказуНаПортал(ВыборкаРезультата, СтрокаСтатус, КоличествоВСтатусе)
	
	СтрокаПолей 	= ПолучитьПоляЗаполненияЗаказаИТовара();
	СтрокаВозврата 	= Новый Структура(СтрокаПолей);
	
	ЗаполнитьЗначенияСвойств(СтрокаВозврата, ВыборкаРезультата); 
	
	ЭтоНеСозданныйЗазказ = ТипЗнч(ВыборкаРезультата.ЗаказПокупателя) = Тип("СправочникСсылка.НеСозданныеЗаказыПокупателей");
	
	Если Не ЭтоНеСозданныйЗазказ И Найти(СтрокаВозврата.КомментарийНоменклатуры, "Стор") = 0 Тогда
		
		Если НЕ ВыборкаРезультата.ЗаказПокупателя.IDСклада_СтороннийСклад.Пустая() Тогда
			
			Если (СтрДлина(СтрокаВозврата.КомментарийНоменклатуры) + СтрДлина(" Стор " + СокрЛП(ВыборкаРезультата.ЗаказПокупателя.IDСклада_СтороннийСклад.Идентификатор))) <= 80 Тогда
				//+Сёмин Р.И. 10.03.2026 #UT10-5721
				//СтрокаВозврата.КомментарийНоменклатуры = СтрокаВозврата.КомментарийНоменклатуры + " Стор " + СокрЛП(ВыборкаРезультата.ЗаказПокупателя.IDСклада_СтороннийСклад.Идентификатор);
				//-Сёмин Р.И. 10.03.2026 #UT10-5721
			КонецЕсли;
		
		КонецЕсли; 
		
	КонецЕсли;     
	
	СтрокаВозврата.ИдентификаторДокумента = СокрЛП(ВыборкаРезультата.ЗаказПокупателя.УникальныйИдентификатор());
	СтрокаВозврата.НомерЗаказаУчетнойСистемы = СокрЛП(ВыборкаРезультата.НомерЗаказа);
	СтрокаВозврата.Статус = СокрЛП(СтрокаСтатус);
	СтрокаВозврата.Количество = КоличествоВСтатусе;  
	СтрокаВозврата.СтавкаНДС = СтрЗаменить(Строка(СтрокаВозврата.СтавкаНДС), "%", "");
	
	Попытка                                      
		СтрокаВозврата.СуммаСНДС = КоличествоВСтатусе * ВыборкаРезультата.ЦенаСНДС;
	Исключение
		СтрокаВозврата.СуммаСНДС = 0;
	КонецПопытки;
	
	//Формируем массив СФ
	МассивСФ = Новый Массив; 
	МассивДобавленныхНомеровСФ = Новый Массив;
	
	Если ЗначениеЗаполнено(ВыборкаРезультата.СчетФактураВыданный) Тогда
		
		ВыборкаРезультатаПоСФ = ВыборкаРезультата.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);				
		
		Пока ВыборкаРезультатаПоСФ.Следующий() Цикл  
			
			Если Не ЗначениеЗаполнено(ВыборкаРезультатаПоСФ.НомерСчетФактуры) Тогда
				Продолжить;
			КонецЕсли;
			
			//+Белов А. 25.11.2025 #UT10-5530
			//Если Не ЗначениеЗаполнено(ВыборкаРезультатаПоСФ.ДатаОтгрузки) Тогда
			//	Продолжить;
			//КонецЕсли; 
			//-Белов А. 25.11.2025 #UT10-5530
			
			Если МассивДобавленныхНомеровСФ.Найти(ВыборкаРезультатаПоСФ.НомерСчетФактуры) <> Неопределено Тогда
				Продолжить;	
			КонецЕсли;
			
			МассивДобавленныхНомеровСФ.Добавить(ВыборкаРезультатаПоСФ.НомерСчетФактуры);
			
			//+Сёмин Р.И. 10.03.2026 #UT10-5721
			//МассивСФ.Добавить(Новый Структура("Номер, Дата, ДатаПередачиКлиенту", ОбщегоНазначения.ПолучитьНомерНаПечать(ВыборкаРезультатаПоСФ.СчетФактураВыданный), ВыборкаРезультатаПоСФ.ДатаСчетФактуры, ВыборкаРезультатаПоСФ.ДатаОтгрузки));
			
			МассивСФ.Добавить(
				Новый Структура("Номер, Дата, ДатаПередачиКлиенту, ИДРеализации , ИДСчетФактуры",
				ОбщегоНазначения.ПолучитьНомерНаПечать(ВыборкаРезультатаПоСФ.СчетФактураВыданный),
				ВыборкаРезультатаПоСФ.ДатаСчетФактуры,
				ВыборкаРезультатаПоСФ.ДатаОтгрузки,
				Строка(ВыборкаРезультатаПоСФ.СчетФактураВыданный.ДокументОснование.УникальныйИдентификатор()),
				Строка(ВыборкаРезультатаПоСФ.СчетФактураВыданный.УникальныйИдентификатор()))
			);
			//-Сёмин Р.И. 10.03.2026 #UT10-5721
			
		КонецЦикла;  
		
	КонецЕсли;
	
	СтрокаВозврата.Вставить("Отгрузки", МассивСФ);

	Возврат СтрокаВозврата; 
	
КонецФункции

Функция ПолучитьПоляЗаполненияЗаказаИТовара()
	
	СтруктураПараметоровМетода = СоответствиеПолейСервис_PM_6951_FOR_PORTAL_EX();  
	
	СтрокеПолей = "";
	
	Для Каждого ЭлементПоля Из СтруктураПараметоровМетода.МассивВыходныхПараметров Цикл 
		
		Если СтрокеПолей <> "" Тогда
			СтрокеПолей = СтрокеПолей + ",";
		КонецЕсли;
		
		СтрокеПолей = СтрокеПолей + ЭлементПоля;
		
	КонецЦикла;	

	Возврат СтрокеПолей;
	
КонецФункции	

Функция ПолучитьСписокДействийСЗаказом(Заказ, МожноКорректировать = Ложь)
		
	ДействияВДесятичномВиде = ?(Заказ.ТолькоРезерв, "1", "0") + "0"+ ?(МожноКорректировать, "1", "0") + "0";
	
	Возврат ДвоичноеВДесятичное(ДействияВДесятичномВиде);
	
КонецФункции  

Функция ПолучитьАдресДоставки(Грузополучатель)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА АдресДоставки.Объект ЕСТЬ NULL
	|			ТОГДА """"
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ПОДСТРОКА(АдресДоставки.Поле4, 1, 100) = """"
	|						И ПОДСТРОКА(АдресДоставки.Поле6, 1, 100) = """"
	|						И ПОДСТРОКА(АдресДоставки.Поле7, 1, 100) = """"
	|						И ПОДСТРОКА(АдресДоставки.Поле8, 1, 100) = """"
	|						И ПОДСТРОКА(АдресДоставки.Поле9, 1, 100) = """"
	|					ТОГДА АдресДоставки.Представление
	|				ИНАЧЕ АдресДоставки.Поле4 + "" "" + АдресДоставки.Поле6 + "" ул, дом № "" + АдресДоставки.Поле7 + "" "" + ВЫБОР
	|						КОГДА ПОДСТРОКА(АдресДоставки.Поле8, 1, 100) = """"
	|							ТОГДА """"
	|						ИНАЧЕ "" корпус "" + АдресДоставки.Поле8
	|					КОНЕЦ + "" "" + ВЫБОР
	|						КОГДА ПОДСТРОКА(АдресДоставки.Поле9, 1, 100) = """"
	|							ТОГДА """"
	|						ИНАЧЕ "" оф."" + АдресДоставки.Поле9
	|					КОНЕЦ + """"
	|			КОНЕЦ
	|	КОНЕЦ КАК АдресДоставки
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК АдресДоставки
	|ГДЕ
	|	АдресДоставки.Объект = &Грузополучатель
	|	И АдресДоставки.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)
	|	И АдресДоставки.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресДоставкиКонтрагента)";
	
	Запрос.УстановитьПараметр("Грузополучатель", Грузополучатель);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.АдресДоставки;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ПолучитьЗаказыПоНомеру(НомерЗаказа)
	
	//+Сёмин Р.И. 23.03.2026 #P3-4087
	МассивНомеров = Новый Массив;
	
	Если ТипЗнч(НомерЗаказа) = Тип("Массив") Тогда
		МассивНомеров = НомерЗаказа;
	Иначе
		МассивНомеров.Добавить(НомерЗаказа);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МАКСИМУМ(ЗаказПокупателя.Дата) КАК Дата,
		|	ЗаказПокупателя.Номер
		|ПОМЕСТИТЬ ВТ_ДатыНомераЗаказов
		|ИЗ
		|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
		|ГДЕ
		|	ЗаказПокупателя.Номер В(&МассивНомеров)
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказПокупателя.Номер
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗаказПокупателя.Ссылка
		|ПОМЕСТИТЬ ВТ_Документы
		|ИЗ
		|	ВТ_ДатыНомераЗаказов КАК ВТ_ДатыНомераЗаказов
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК ЗаказПокупателя
		|		ПО ВТ_ДатыНомераЗаказов.Дата = ЗаказПокупателя.Дата
		|			И ВТ_ДатыНомераЗаказов.Номер = ЗаказПокупателя.Номер
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Документы.Ссылка
		|ИЗ
		|	ВТ_Документы КАК ВТ_Документы";   
	
	Запрос.УстановитьПараметр("МассивНомеров", МассивНомеров);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	//-Сёмин Р.И. 23.03.2026 #P3-4087
	
КонецФункции


