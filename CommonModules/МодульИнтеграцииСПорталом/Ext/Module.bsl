	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("HTTP-сервис OnlineStore.order_delete.ЗакрытьЗаказПокупателя", УровеньЖурналаРегистрации.Информация,,, "HTTP-сервис:Запуск. ЗакрытьЗаказПокупателя");
	
