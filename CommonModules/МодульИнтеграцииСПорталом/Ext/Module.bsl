Функция СоответствиеПолейЗаказа() Экспорт
	                                                          
	СоответсвиеШапки = Новый Соответствие;  //по справочнику НеСозданныеЗаказыПокупателей 
	//Header/OrderHeader
	СоответсвиеШапки.Вставить("OrderID", 		"ИдентификаторЗаказа");//IDЗаказаПортал 
	СоответсвиеШапки.Вставить("Comment", 		"Комментарий"); 
	СоответсвиеШапки.Вставить("KlientID", 		"ИдентификаторКонтрагента"); //УИНКонтрагента
	СоответсвиеШапки.Вставить("FilialID", 		"ИдентификаторФилиала");//УИНФилиала 
	СоответсвиеШапки.Вставить("ValutaID", 		"ИдентификаторВалюта"); //УИНВалюта
	СоответсвиеШапки.Вставить("DogovorID", 		"ИдентификаторДоговора"); //УИНДоговора
	СоответсвиеШапки.Вставить("TipDost", 		"ТипДоставки"); 
	СоответсвиеШапки.Вставить("Name", 			"НаименованиеЗаказаПортала"); 
	СоответсвиеШапки.Вставить("Mail", 			"Почта"); 
	СоответсвиеШапки.Вставить("Addres", 		"ЮрАдрес"); 
	СоответсвиеШапки.Вставить("AddresFakt", 	"ФактАдрес"); 
	СоответсвиеШапки.Вставить("AddresFaktId", 	"ИдентификаторФактАдрес");// УИНФактАдрес
	СоответсвиеШапки.Вставить("INN", 			"ИНН"); 
	СоответсвиеШапки.Вставить("KPP", 			"КПП"); 
	СоответсвиеШапки.Вставить("FirmID", 		"ИдентификаторОрганизация");//УИНОрганизация 
	СоответсвиеШапки.Вставить("SkladID", 		"ИдентификаторСклад"); // ИдСклад
	СоответсвиеШапки.Вставить("PaymentType", 	"ТипОплаты");  	
	СоответсвиеШапки.Вставить("Dostavka", 		"ДатаДоставки");  	
	СоответсвиеШапки.Вставить("OrderSource", 	"КодИсточника");  	//ПромКодИсточника
	
	//OrderLine 
	СоответсвиеСтрок = Новый Соответствие; 
	СоответсвиеСтрок.Вставить("NumberInv", 		"Артикул");			//Номенклатура.Артикул
	СоответсвиеСтрок.Вставить("Brand", 			"Родитель");		// Родитель Номенклатуры
	СоответсвиеСтрок.Вставить("Articul", 		"КодПроизводителя");//Номенклатура.КодПроизводителя
	СоответсвиеСтрок.Вставить("Name", 			"Наименование");
	СоответсвиеСтрок.Вставить("Count", 			"Количество");
	СоответсвиеСтрок.Вставить("Price", 			"ЦенаКлиента");
	СоответсвиеСтрок.Вставить("Price_Zak", 		"ЦенаЗакупки");
	СоответсвиеСтрок.Вставить("PROIZV_SUPPLIER","ПроизводительПоставщика");
	СоответсвиеСтрок.Вставить("Comment", 		"Комментарий"); 
	
	//OutLine
	СоответсвиеВозврата = Новый Соответствие; 
	СоответсвиеВозврата.Вставить("OrderNumber", 	"НомерЗаказа");//Номер заказа
	СоответсвиеВозврата.Вставить("Status", 			"Статус");	// 0 - Создан заказ из письма, по признаку (в параметрах EMailЗаказ = Истина);
														  	// 1 - В справочнике "несозданные заказы" создана запись(в параметрах EMailЗаказ = Истина);
														  	// 2 - ;
														  	// 3 - Ошибка при создании заказа;ошибка создания корректировки заказа
															// Принадлежность базы по константе ?(Константы.База.Получить() = Перечисления.НазваниеБазы.Казань, 1, 3)
															
	СтруктураСоответсвий = Новый Структура;  
	СтруктураСоответсвий.Вставить("СоответсвиеШапки", 		СоответсвиеШапки);
	СтруктураСоответсвий.Вставить("СоответсвиеСтрок", 		СоответсвиеСтрок);
	СтруктураСоответсвий.Вставить("СоответсвиеВозврата", 	СоответсвиеВозврата);
															
	Возврат СтруктураСоответсвий;
	
КонецФункции	

