КонецФункции

//перенесен измодуля МСКWEB.ДобавитьНеСозданныеЗаказыПокупателей,- аналогична
Процедура ДобавитьНеСозданныеЗаказыПокупателей(пДатаНачалаОтчета, пДатаКонцаОтчета, ИДАвардаКонтрагента, МассивРезультат, СтрокаПараметров)
		
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	СУММА(НеСозданныеЗаказыПокупателейТовары.Price * НеСозданныеЗаказыПокупателейТовары.Count) КАК SUMMA,
	|	НеСозданныеЗаказыПокупателейТовары.Ссылка.Ссылка,
	|	НеСозданныеЗаказыПокупателейТовары.Ссылка.Дата КАК DATE_TIMESTAMP,
	|	НеСозданныеЗаказыПокупателейТовары.Ссылка.Наименование КАК FILIAL_NAME,
	|	ВЫРАЗИТЬ(НеСозданныеЗаказыПокупателейТовары.Ссылка.Comment КАК СТРОКА(100)) КАК DNOTE,
	|	""RUB"" КАК VALUTA_NAME,
	|	НеСозданныеЗаказыПокупателейТовары.Ссылка.FirmID КАК OUR_FIRM
	|ИЗ
	|	Справочник.НеСозданныеЗаказыПокупателей.Товары КАК НеСозданныеЗаказыПокупателейТовары
	|ГДЕ
	|	НеСозданныеЗаказыПокупателейТовары.Ссылка.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|	И НеСозданныеЗаказыПокупателейТовары.Ссылка.ПометкаУдаления = ЛОЖЬ
	|	И НеСозданныеЗаказыПокупателейТовары.Ссылка.KontragentID = &KontragentID
	|	И НеСозданныеЗаказыПокупателейТовары.Ссылка.ЗаказПокупателяСсылка = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	НеСозданныеЗаказыПокупателейТовары.Ссылка.FirmID,
	|	НеСозданныеЗаказыПокупателейТовары.Ссылка.Ссылка,
	|	НеСозданныеЗаказыПокупателейТовары.Ссылка.Дата,
	|	ВЫРАЗИТЬ(НеСозданныеЗаказыПокупателейТовары.Ссылка.Comment КАК СТРОКА(100)),
	|	ПРЕДСТАВЛЕНИЕ(НеСозданныеЗаказыПокупателейТовары.Ссылка.ФилиалКонтрагента)
	|
	|УПОРЯДОЧИТЬ ПО
	|	DATE_TIMESTAMP");
	
	Запрос.УстановитьПараметр("ДатаНач", 		?(ЗначениеЗаполнено(пДатаНачалаОтчета), НачалоДня(пДатаНачалаОтчета), НачалоДня(ТекущаяДата() - 86400 * 14)));
	Запрос.УстановитьПараметр("ДатаКон", 		?(ЗначениеЗаполнено(пДатаКонцаОтчета), КонецДня(пДатаКонцаОтчета), КонецДня(ТекущаяДата())));
	Запрос.УстановитьПараметр("KontragentID",	ИДАвардаКонтрагента);
	
	РезЗапроса = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрРез Из РезЗапроса Цикл  
		
		СтрокаВозврата = Новый Структура(СтрокаПараметров);       
		
		СтрокаВозврата.ДатаЗаказа = СтрРез.DATE_TIMESTAMP;
		
		СтрокаВозврата.НаименованиеКонтрагент 		= СтрРез.FILIAL_NAME;
		СтрокаВозврата.Комментарий 				= СтрРез.DNOTE;
		СтрокаВозврата.НаименованиеВалюта 		= СтрРез.VALUTA_NAME;
		СтрокаВозврата.НаименованиеДоговора 	= "";
		СтрокаВозврата.НаименованиеСклада 		= "";
		СтрокаВозврата.НаименованиеОрганизации 	= СтрРез.OUR_FIRM;		
		СтрокаВозврата.ИдентификаторДокумента 	= СокрЛП(СтрРез.Ссылка.УникальныйИдентификатор());
		СтрокаВозврата.ДатаОформленияЗаказа 	= Формат(СтрРез.DATE_TIMESTAMP, "ДФ='dd.MM.yyyy HH:mm'");
		СтрокаВозврата.НомерЗаказа 				= "Заказ от " + СтрокаВозврата.ДатаЗаказа;
		СтрокаВозврата.Статус 					= "10;принят в работу";
		СтрокаВозврата.СуммаДокументаСНДС 		= СтрРез.SUMMA;
		//СтрокаВозврата.ДействияСЗаказом 		= "0000";
		
		МассивРезультат.Добавить(СтрокаВозврата);
		
	КонецЦикла;		
	
КонецПроцедуры

//перенесен измодуля МСКWEB.ПроверитьСтатусСборки
Функция ПроверитьСтатусСборки(ПромЗаказ, ПромТовар) 
	
	ЗапросНаличияСборки = Новый Запрос;
	ЗапросНаличияСборки.УстановитьПараметр("Заказ",ПромЗаказ);
	ЗапросНаличияСборки.УстановитьПараметр("Товар",ПромТовар);
	ЗапросНаличияСборки.Текст = 
	"ВЫБРАТЬ
	|	ТоварыВСборкеОстатки.Сборка.Ссылка,
	|	ТоварыВСборкеОстатки.Сборка.ВремяОкончанияСборки
	|ИЗ
	|	РегистрНакопления.ТоварыВСборке.Остатки(
	|			,
	|			ЗаказПокупателя = &Заказ ";
	Если НЕ ПромТовар = NULL Тогда
		ЗапросНаличияСборки.Текст = ЗапросНаличияСборки.Текст +"
		|				И Номенклатура = &Товар";
	КонецЕсли;
	ЗапросНаличияСборки.Текст = ЗапросНаличияСборки.Текст +" 
	|) КАК ТоварыВСборкеОстатки";
	Если НЕ ЗапросНаличияСборки.Выполнить().Пустой()Тогда		
		ЗапросСтатусаСборки = Новый Запрос;
		ЗапросСтатусаСборки.УстановитьПараметр("Заказ",ПромЗаказ);
		ЗапросСтатусаСборки.УстановитьПараметр("Товар",ПромТовар);
		ЗапросСтатусаСборки.Текст = 
		"ВЫБРАТЬ
		|	ТоварыВСборкеОстатки.Сборка.Ссылка,
		|	ТоварыВСборкеОстатки.Сборка.ВремяОкончанияСборки
		|ИЗ
		|	РегистрНакопления.ТоварыВСборке.Остатки(
		|			,
		|			ЗаказПокупателя = &Заказ ";
		Если НЕ ПромТовар = NULL Тогда
			ЗапросСтатусаСборки.Текст = ЗапросСтатусаСборки.Текст +"
			|				И Номенклатура = &Товар";
		КонецЕсли;
		ЗапросСтатусаСборки.Текст = ЗапросСтатусаСборки.Текст +"		
		|) КАК ТоварыВСборкеОстатки
		|ГДЕ
		|	ТоварыВСборкеОстатки.Сборка.ВремяОкончанияСборки = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)";
		Возврат НЕ ЗапросСтатусаСборки.Выполнить().Пустой();
	Иначе
		Возврат Истина;
	КонецЕсли; 
	
КонецФункции

Функция ПоказатьВременнуюТаблицу(МенеджерВременныхТаблицИлиЗапрос, ИмяВременнойТаблицы) Экспорт
	
	ЗакрытьМенеджерВременныхТаблиц = Ложь;
	
	Если ТипЗнч(МенеджерВременныхТаблицИлиЗапрос) = Тип("Запрос") Тогда
		Если МенеджерВременныхТаблицИлиЗапрос.МенеджерВременныхТаблиц = Неопределено Тогда
			МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
			ЗакрытьМенеджерВременныхТаблиц = Истина;
			МенеджерВременныхТаблицИлиЗапрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц; 
		Иначе
			МенеджерВременныхТаблиц = МенеджерВременныхТаблицИлиЗапрос.МенеджерВременныхТаблиц;
		КонецЕсли;
		Попытка
			МенеджерВременныхТаблицИлиЗапрос.Выполнить();
		Исключение
			// Ничего не делаем.
		КонецПопытки;
	Иначе
		МенеджерВременныхТаблиц = МенеджерВременныхТаблицИлиЗапрос;
	КонецЕсли; 
	
	ДанныеТаблицы = ЗапросВыполнитьВыгрузить("ВЫБРАТЬ * ИЗ " + ИмяВременнойТаблицы,, МенеджерВременныхТаблиц);
	
	Если ЗакрытьМенеджерВременныхТаблиц Тогда
		МенеджерВременныхТаблиц.Закрыть();
		МенеджерВременныхТаблицИлиЗапрос.МенеджерВременныхТаблиц = Неопределено;
	КонецЕсли; 
	
	Возврат ДанныеТаблицы;
	
КонецФункции

Функция ЗапросВыполнитьВыгрузить(ТекстЗапроса, ПараметрыЗапроса = Неопределено, МенеджерВременныхТаблиц = Неопределено) Экспорт
	
	Запрос = Новый Запрос(ТекстЗапроса);
	
	Если МенеджерВременныхТаблиц <> Неопределено Тогда
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыЗапроса) Тогда
		Для Каждого Параметр Из ПараметрыЗапроса Цикл
			Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции
