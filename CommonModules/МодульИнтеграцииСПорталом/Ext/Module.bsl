Функция СозданиеЗаявкиНаВозвратСервер(СтрокаJSON, ВернутьJSON = Истина) Экспорт
	
	ВремяНачалаUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписьЖурналаРегистрации("HTTP-сервис OnlineStore.return_create.СоздатьЗаявкуНаВозврат", УровеньЖурналаРегистрации.Информация,,, 
	"HTTP-сервис:Запуск. СоздатьЗаявкуНаВозврат");
	
	МассивСтрок = ОбщегоНазначения.ВернутьСтруктуруИзJSON(СтрокаJSON);   
	
	СтруктураВозврата = Новый Структура("Результат, Данные, Сообщение", Ложь, Неопределено, ""); 
	
	Если ТипЗнч(МассивСтрок) = Тип("Массив") И ЗначениеЗаполнено(МассивСтрок) Тогда
		                      
		СтруктураВозврата = СозданиеЗаявкиНаВозврат(МассивСтрок);
		
		ДанныеВозврата = ?(ВернутьJSON, ОбщегоНазначения.ВернутьJSON(СтруктураВозврата), СтруктураВозврата); 
		
	Иначе
		
		СтруктураВозврата.Вставить("Результат", Ложь); 
		СтруктураВозврата.Вставить("Сообщение", "Заявка на возврат не создана. Не заданы строки для поиска реализаций и товаров."); 
		ДанныеВозврата = ?(ВернутьJSON, ОбщегоНазначения.ВернутьJSON(СтруктураВозврата), СтруктураВозврата); 
		
	КонецЕсли; 
	
	ВремяОкончанияUTC = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ЗаписьЖурналаРегистрации("HTTP-сервис OnlineStore.return_create.СоздатьЗаявкуНаВозврат", УровеньЖурналаРегистрации.Информация,,, 
	"HTTP-сервис:Завершение. СоздатьЗаявкуНаВозврат. " 
	+ Формат(ВремяОкончанияUTC - ВремяНачалаUTC, "ЧН=0; ЧГ=0") + " м.сек." + " Запрос:" + Символы.ПС + СтрокаJSON);
	
	Возврат ДанныеВозврата;
	
КонецФункции

Функция СозданиеЗаявкиНаВозврат(МассивПараметры) Экспорт
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Количество",         ОбщегоНазначения.ПолучитьОписаниеТиповЧисла(15, 3, ДопустимыйЗнак.Неотрицательный));
	ТЗ.Колонки.Добавить("Комментарий",        ОбщегоНазначения.ПолучитьОписаниеТиповСтроки(255));
	ТЗ.Колонки.Добавить("ПричинаВозврата",    ОбщегоНазначения.ПолучитьОписаниеТиповСтроки(1));
	ТЗ.Колонки.Добавить("НомСтр",             ОбщегоНазначения.ПолучитьОписаниеТиповЧисла(5, 0, ДопустимыйЗнак.Неотрицательный));
	ТЗ.Колонки.Добавить("ИдентификаторДокумента", ОбщегоНазначения.ПолучитьОписаниеТиповСтроки(36));
	ТЗ.Колонки.Добавить("Номенклатура",       Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗ.Колонки.Добавить("ПроверятьКратность", Новый ОписаниеТипов("Булево")); 
	ТЗ.Колонки.Добавить("РТУ",                Новый ОписаниеТипов("ДокументСсылка.РеализацияТоваровУслуг"));
	//+Сёмин Р.И. 18.03.2026 #UT10-5766
	ТЗ.Колонки.Добавить("ЭлПочтаКлиента",     ОбщегоНазначения.ПолучитьОписаниеТиповСтроки(100));
	//-Сёмин Р.И. 18.03.2026 #UT10-5766
	
	//+Белов А. 03.03.2026 #UT10-5722
	СоответствиеФайлыS3 = Новый Соответствие;
	//-Белов А. 03.03.2026 #UT10-5722	
	
	ДокументыРТУ = Новый Соответствие();
	
	СтруктураВозврата = Новый Структура("Результат, Данные, Сообщение", Ложь, Неопределено, "");    
	ДанныеВозврата 	  = Новый Структура("НомерЗаявки, Статус", "", "");

	// Проверки
	Для каждого строка из МассивПараметры Цикл  
		
		НомерСтрокиСтр = Строка(МассивПараметры.Найти(строка) + 1);
		
		Если Не строка.Свойство("ИдентификаторДокумента") Или ПустаяСтрока(строка.ИдентификаторДокумента) Тогда
			
			СтруктураВозврата.Сообщение = "Заявки на возврат не сформированы. Причина: в строке " + НомерСтрокиСтр 
			+ " не указан параметр запроса ИдентификаторДокумента";  
		    Возврат СтруктураВозврата;
			
		КонецЕсли;
		
		Если Не строка.Свойство("НомерСтроки") Или ПустаяСтрока(строка.НомерСтроки) Тогда
			
			СтруктураВозврата.Сообщение = "Заявки на возврат не сформированы. Причина: в строке " + НомерСтрокиСтр 
			+ " не указан параметр запроса НомерСтроки";        
		    Возврат СтруктураВозврата;
			
		КонецЕсли;   
		
		Попытка
		    НомСтр = Число(Строка.НомерСтроки);
		Исключение
			
			СтруктураВозврата.Сообщение = "Заявки на возврат не сформированы. Причина: в строке " + НомерСтрокиСтр + " параметр запроса НомерСтроки=" 
			+ Строка.НомерСтроки + " не является числом.";  
		    Возврат СтруктураВозврата;
			
		КонецПопытки;
		
		Если Не строка.Свойство("Количество") Или ПустаяСтрока(строка.Количество) Тогда
			
			СтруктураВозврата.Сообщение = "Заявки на возврат не сформированы. Причина: в строке " + НомерСтрокиСтр + " не указан параметр запроса Количество";
		    Возврат СтруктураВозврата;
			
		КонецЕсли;   
		
		Попытка
		    Количество = Число(Строка.Количество);
		Исключение
			
			СтруктураВозврата.Сообщение = "Заявки на возврат не сформированы. Причина: в строке " + НомерСтрокиСтр + " параметр запроса Количество=" 
			+ Строка.Количество + " не является числом.";   
		    Возврат СтруктураВозврата;
			
		КонецПопытки;
		
		ИД = строка.ИдентификаторДокумента;
		
		Если ДокументыРТУ.Получить(ИД) = Неопределено Тогда
			
			Попытка
				Реализация = Документы.РеализацияТоваровУслуг.ПолучитьСсылку(Новый УникальныйИдентификатор(ИД));	
			Исключение    
				Реализация = Документы.РеализацияТоваровУслуг.ПустаяСсылка();
			КонецПопытки;
			
			Если ЗначениеЗаполнено(Реализация) И Не Реализация.ПолучитьОбъект() = Неопределено Тогда             
				ДокументыРТУ.Вставить(ИД, Реализация);
			Иначе 
				
				СтруктураВозврата.Сообщение = "Заявки на возврат не сформированы. Причина: в строке " + НомерСтрокиСтр 
				+ " не найдена реализация по идентификатору " + ИД;   
			    Возврат СтруктураВозврата;
				
			КонецЕсли; 	

		КонецЕсли; 	
			
	КонецЦикла;
	
	Для каждого строка из МассивПараметры Цикл  
		
		СтрокаТЗ = ТЗ.Добавить();  
		СтрокаТЗ.ИдентификаторДокумента = Строка.ИдентификаторДокумента;
		СтрокаТЗ.РТУ                    = ДокументыРТУ.Получить(Строка.ИдентификаторДокумента);
		СтрокаТЗ.Количество             = Число(Строка.Количество);
		СтрокаТЗ.НомСтр                 = Число(Строка.НомерСтроки);
		СтрокаТЗ.ПричинаВозврата        = ?(Не строка.Свойство("ПричинаВозврата"), "0", Строка(строка.ПричинаВозврата));
		строка.Свойство("Комментарий", СтрокаТЗ.Комментарий);
		//+Сёмин Р.И. 18.03.2026 #UT10-5766
		строка.Свойство("ЭлПочтаКлиента", СтрокаТЗ.ЭлПочтаКлиента);
		//-Сёмин Р.И. 18.03.2026 #UT10-5766
		
		//+Белов А. 03.03.2026 #UT10-5722
		Если строка.Свойство("ФайлыS3") Тогда
			
			Файлы = СоответствиеФайлыS3.Получить(Строка.ИдентификаторДокумента); 
			
			Если Файлы = Неопределено Тогда
				СоответствиеФайлыS3.Вставить(Строка.ИдентификаторДокумента, строка.ФайлыS3);	
			Иначе   
				
				Для каждого СсылкаНаФайл Из строка.ФайлыS3 Цикл
					Файлы.Добавить(СсылкаНаФайл);	
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		//-Белов А. 03.03.2026 #UT10-5722
		
	КонецЦикла;
	
	тзТолькоРТУ = тз.Скопировать(, "РТУ, ИдентификаторДокумента");
