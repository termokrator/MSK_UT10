&НаСервере
Функция ОтправитьВходящийДокументНаПодпись(Идентификатор, Документ, МодульИнтеграции, ДанныеДокумента = Неопределено) Экспорт
	
	//+Макрушин Е. 19.03.2026 #UT10-5658
	СтруктураВозврата = Новый Структура("Результат, Сообщение", Ложь, "");
	
	Если МодульИнтеграции = Неопределено Тогда
		
		СтруктураВозвратаМодуля = ПолучитьМодульИнтеграции();  
		
		Если СтруктураВозвратаМодуля.Результат Тогда
			МодульИнтеграции = СтруктураВозвратаМодуля.МодульИнтеграции;
		Иначе
			
			СтруктураВозврата.Сообщение = СтруктураВозвратаМодуля.Сообщение;
			Возврат СтруктураВозврата;
			
		КонецЕсли;
		
	КонецЕсли; 
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("Ссылка", Документ);
	СтруктураДанных.Вставить("Идентификатор", Идентификатор);
	
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.КорректировкаПоступления") Тогда
		СтруктураДанных.Вставить("Тип", "Универсальный корректировочный документ");
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		СтруктураДанных.Вставить("Тип", "УПД");  
	//+Белов А. 28.09.2026 #UT10-6070
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.ТранспортнаяНакладная") Тогда
		СтруктураДанных.Вставить("Тип", "Транспортная накладная");
		СтруктураДанных.Ссылка = ДанныеДокумента;		
	//-Белов А. 28.09.2026 #UT10-6070
	Иначе
		ВызватьИсключение "Для данного типа документа не поддерживается подписание";
	КонецЕсли; 
	
	Результат = МодульИнтеграции.СоздатьXMLКвитанциюОПриемеИВернутьДляПодписания(СтруктураДанных);  
	
	Если Результат <> Неопределено И Результат.Получить("success") <> Неопределено И Результат.Получить("success") Тогда
		
		СтрокаКонтента = Результат.Получить("content"); 
		
		РезультатПодписания = МодульИнтеграции.ОтправитьПодписаннуюКвитанцию(Идентификатор, СтрокаКонтента, "", "Принять"); 
		
		Если РезультатПодписания <> Неопределено И РезультатПодписания.Получить("success") <> Неопределено И РезультатПодписания.Получить("success") Тогда 
			
			СтруктураВозврата.Результат = Истина; 
			
			//+Белов А. 28.09.2026 #UT10-6070			
			Если ЗначениеЗаполнено(Документ) Тогда
			//-Белов А. 28.09.2026 #UT10-6070
				
				ДопСвойство = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("DS_Документ_ID");
				
				Если ДопСвойство <> Неопределено Тогда
					МСКWEB.УстановитьЗначениеДопСвойства(Документ, ДопСвойство, Идентификатор);
				КонецЕсли;	
				
				Если ТипЗнч(Документ) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
					РезультатУстановкиДокументПодписан = Справочники.КатегорииОбъектов.УстановитьКатегориюОбъекта(Документ, Справочники.КатегорииОбъектов.ДокументПодписан);
				КонецЕсли;	
				
				ЗаписатьИсториюОбменаЭДО(Документ, Перечисления.СтатусыОбменаЭДО.Подписан, "", "Успешно подписан входящий документ");
				
			КонецЕсли;
			
		Иначе   							
			
			СтруктураВозврата.Сообщение = ПолучитьТекстОшибкиИзРезультата(РезультатПодписания);	
			
		КонецЕсли; 
		
	Иначе					
		
		СтруктураВозврата.Сообщение = ПолучитьТекстОшибкиИзРезультата(Результат);	
		
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	//-Макрушин Е. 19.03.2026 #UT10-5658
	
КонецФункции

&НаСервере
Процедура ПроставитьПризнакПолученУДокумента(Документ)
	
	//+Макрушин Е. 19.03.2026 #UT10-5658
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		
		РезультатУстановкиДокументПолучен = Справочники.КатегорииОбъектов.УстановитьКатегориюОбъекта(Документ, Справочники.КатегорииОбъектов.ДокументПолучен);
		
		Если НЕ РезультатУстановкиДокументПолучен.ВыполненоУспешно Тогда
			
			СтрокаОшибка = "Ошибка при установке категории ДокументПолучен " + РезультатУстановкиДокументПолучен.ОписаниеОшибки;     
			ВызватьИсключение СтрокаОшибка;
			
		КонецЕсли;
		
	КонецЕсли; 	
	//-Макрушин Е. 19.03.2026 #UT10-5658
	
КонецПроцедуры

