&НаСервере
Функция ЗаписатьИсториюОбменаЭДО(Объект, Статус, Ошибка = "", Комментарий = "", ЗаписыватьОшибкиВЖурнал = Ложь, ПрибавитьКПериоду = 0) Экспорт
	
	Менеджер = РегистрыСведений.ИсторияОбменовЭДО.СоздатьМенеджерЗаписи();
	Менеджер.Период = ТекущаяДата() + ПрибавитьКПериоду;
	Менеджер.Объект = Объект;
	Менеджер.Статус = Статус;
	Менеджер.Ошибка = Ошибка;
	Менеджер.Комментарий = Комментарий;
	Менеджер.Записать(Истина);       
	
	Если Статус = Перечисления.СтатусыОбменаЭДО.Подготовка Тогда		
		ЗаписатьСостояниеЭДО(Объект, Перечисления.СостояниеЭДО.ВПроцессеОтправки);		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Ошибка) Тогда
		
		Если ЗаписыватьОшибкиВЖурнал Тогда
			ЗаписьЖурналаРегистрации("ЭДО.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, "Ошибка при переводе документа " + Объект +  " в статус: " + Строка(Статус) + Символы.ПС + Ошибка);		
		КонецЕсли;         
		
	Иначе
		
		Если (Объект.Метаданные().Имя = "РеализацияТоваровУслуг" ИЛИ Объект.Метаданные().Имя = "КорректировкаРеализации")
			И Не ЗначениеЗаполнено(Ошибка) Тогда  
			
			Если (Статус = Перечисления.СтатусыОбменаЭДО.Завершен И (Комментарий = "Документооборот завершен" ИЛИ Комментарий = "Документ отклонен" ИЛИ Комментарий = "annulled"))
				ИЛИ (Статус = Перечисления.СтатусыОбменаЭДО.Отправка И Найти(Комментарий, "Документ успешно отправлен") > 0)
				ИЛИ Статус = Перечисления.СтатусыОбменаЭДО.ОтправкаАннулирования И Найти(Комментарий, "Квитанция для аннулирования была успешно отправлена") > 0 Тогда	
				ОбновитьСтатусДокументаЭДО(Объект, Комментарий); 
			КонецЕсли; 
			
			//+Белов А. 18.11.2024 #
			Если Менеджер.Статус = Перечисления.СтатусыОбменаЭДО.Завершен 
				ИЛИ Менеджер.Статус = Перечисления.СтатусыОбменаЭДО.Отправка
				ИЛИ Менеджер.Статус = Перечисления.СтатусыОбменаЭДО.ОжидаетПодписания
				ИЛИ Менеджер.Статус = Перечисления.СтатусыОбменаЭДО.ОтправкаАннулирования
				ИЛИ Менеджер.Статус = Перечисления.СтатусыОбменаЭДО.ОжидаетПодписанияАннулирования Тогда
				AMQP_РаботаСДокументами_ver2.СформироватьСообщениеСостояниеЭДО(Объект, Менеджер);				
			КонецЕсли;   
			//-Белов А. 18.11.2024 # 
			
			//+Белов А. 03.09.2026 #UT10-6035 
		ИначеЕсли Объект.Метаданные().Имя = "ЗаказЗаявка" Тогда			
			
			Если (Статус = Перечисления.СтатусыОбменаЭДО.Завершен И (Комментарий = "Документооборот завершен" ИЛИ Комментарий = "Документ отклонен" ИЛИ Комментарий = "annulled"))
				ИЛИ (Статус = Перечисления.СтатусыОбменаЭДО.Отправка И Найти(Комментарий, "Документ успешно отправлен") > 0) Тогда  
				ОбновитьСтатусДокументаЭДО(Объект, Комментарий); 
			КонецЕсли;         	
			
			Если ТипЗнч(Объект.Организация) = Тип("СправочникСсылка.Контрагенты") И Статус = Перечисления.СтатусыОбменаЭДО.Завершен Тогда
				AMQP_РаботаСДокументами_ver2.СформироватьСообщениеЗаказЗаявка(Объект, Менеджер);	
			КонецЕсли;					
	
		ИначеЕсли Объект.Метаданные().Имя = "ТранспортнаяНакладная" Тогда
			
			Если (Статус = Перечисления.СтатусыОбменаЭДО.Завершен И (Комментарий = "Документооборот завершен" ИЛИ Комментарий = "Документ отклонен" ИЛИ Комментарий = "annulled"))
				ИЛИ (Статус = Перечисления.СтатусыОбменаЭДО.Отправка И Найти(Комментарий, "Документ успешно отправлен") > 0) Тогда
				ОбновитьСтатусДокументаЭДО(Объект, Комментарий); 			
			КонецЕсли;
					
		//-Белов А. 03.09.2026 #UT10-6035			
		КонецЕсли;		
	
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПолучитьТекстОшибкиИзРезультата(Результат) Экспорт
	
	//+Макрушин Е. 19.03.2026 #UT10-5658
	ТекстОшибки = ""; 
	
	Если ЗначениеЗаполнено(Результат) И ТипЗнч(Результат) = Тип("Соответствие") Тогда
		
		Если Результат.Получить("details") <> Неопределено Тогда
			ТекстОшибки = Результат.Получить("details");		
		КонецЕсли;   
		
		Если Результат.Получить("codeDescription") <> Неопределено Тогда
			
			ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "") + Результат.Получить("codeDescription");	
			
			Если Результат.Получить("code") <> Неопределено Тогда
				ТекстОшибки = ТекстОшибки + " (код " + Результат.Получить("code") + ")";		
			КонецЕсли;  
			
		КонецЕсли;   
		
		//+Белов А. 28.09.2026 #UT10-6070
		Если Не ЗначениеЗаполнено(ТекстОшибки) И Результат.Получить("error") <> Неопределено Тогда
			ТекстОшибки = Результат.Получить("error");	
		КонецЕсли; 
		//-Белов А. 28.09.2026 #UT10-6070
		
	Иначе
		
		ТекстОшибки = "Не заполнена структура результата"	
		
	КонецЕсли; 
	
	Возврат ТекстОшибки;
	//-Макрушин Е. 19.03.2026 #UT10-5658
	
КонецФункции

&НаСервере
Функция ПолучитьМодульИнтеграции(Резерв = Ложь)
	
	//+Макрушин Е. 17.03.2026 #UT10-5658
	СтруктураВозврата = Новый Структура("Результат, Сообщение, МодульИнтеграции", Ложь, "", Неопределено);
	
	МодульИнтеграции = Обработки.МодульИнтеграцииDiState.Создать();
	
	Если Резерв Тогда
		ПараметрыВозврата = МодульИнтеграции.АвторизацияПоЛогинуИПаролю(Константы.ЭДО_Адрес_Резерв.Получить(), Константы.ЭДО_Логин_Резерв.Получить(), Константы.ЭДО_Пароль_Резерв.Получить());
	Иначе
		ПараметрыВозврата = МодульИнтеграции.АвторизацияПоЛогинуИПаролю(Константы.ЭДО_Адрес.Получить(), Константы.ЭДО_Логин.Получить(), Константы.ЭДО_Пароль.Получить());
	КонецЕсли;
	
	Если ПараметрыВозврата.ОшибкаАвторизации Тогда
		
		СтруктураВозврата.Сообщение = ПараметрыВозврата.ТекстОшибки; 
		Возврат СтруктураВозврата;
		
	КонецЕсли; 
	
	ПараметрыВозврата = МодульИнтеграции.ЗакончитьПроцессАвторизации(ПараметрыВозврата); 
	
	Если ПараметрыВозврата.Свойство("ОтпечатокСертификата") И ЗначениеЗаполнено(ПараметрыВозврата.ОтпечатокСертификата) Тогда
		МодульИнтеграции.ОтпечатокСертификата = ПараметрыВозврата.ОтпечатокСертификата;		
	Иначе
		
		СтруктураВозврата.Сообщение = "Не заполнен отпечаток сертификата при подключении к DiState"; 
		Возврат СтруктураВозврата;
		
	КонецЕсли;
	
	МодульИнтеграции.ВерсияСервера = 6; 
	
	МодульИнтеграции.Организация = Константы.ОсновнаяОрганизация.Получить(); 
	
	СтруктураВозврата.МодульИнтеграции = МодульИнтеграции; 
	
	СтруктураВозврата.Результат = Истина;
	
   	Возврат СтруктураВозврата;
	//-Макрушин Е. 17.03.2026 #UT10-5658
	
КонецФункции

&НаСервере
Функция ПолучитьЗначениеАтрибутаДОМ(Знач пЭлементДОМ, Знач пИмяАтрибута)
//+Бычков О. 07.09.2026 #UT11-6030
// Вставка
	
	ТекРезультат = Неопределено;
	
	Если ТипЗнч(пЭлементДОМ) = Тип("ЭлементDOM") Тогда
		
		ТекАтрибут = пЭлементДОМ.Атрибуты.ПолучитьИменованныйЭлемент(пИмяАтрибута);
		
		Если ТипЗнч(ТекАтрибут) = Тип("АтрибутDOM") Тогда
			ТекРезультат = ТекАтрибут.Значение;
		КонецЕсли;

	КонецЕсли;
	
	Возврат ТекРезультат;
	
//-Бычков О. 07.09.2026 #UT11-6030	
КонецФункции

&НаСервере
Функция ПолучитьДОМИзТекстаXML(пТекстXML)

	ЧтениеXML = Новый ЧтениеXML;
	
	ЧтениеXML.УстановитьСтроку(пТекстXML);
	
	ТекПостроительDOM = Новый ПостроительDOM;
	
	ТекРезультат = ТекПостроительDOM.Прочитать(ЧтениеXML);
	
	Возврат ТекРезультат;

КонецФункции

&НаСервере
Функция ПолучитьДОМИсходногоXML(пXMLВBase64)

	ТекРезультат = Неопределено;
	
	ТекТекстXML = ПолучитьТекстИсходногоXML(пXMLВBase64);

	Если ЗначениеЗаполнено(ТекТекстXML) Тогда
		ТекРезультат = ПолучитьДОМИзТекстаXML(ТекТекстXML);
	КонецЕсли;
	
	Возврат ТекРезультат;

КонецФункции 

&НаСервере
Функция ПолучитьТекстИсходногоXML(пXMLВBase64)

    ТекРезультат = Неопределено;
	
	Если ЗначениеЗаполнено(пXMLВBase64) Тогда
		
		ТекДвоичныйXML = Base64Значение(пXMLВBase64);
		
		ТекТекстовыйДокумент = Новый ТекстовыйДокумент;
		
		ТекТекстовыйДокумент.Прочитать(ТекДвоичныйXML.ОткрытьПотокДляЧтения());
		
		ТекРезультат = ТекТекстовыйДокумент.ПолучитьТекст();
		
	КонецЕсли;

	Возврат ТекРезультат;

КонецФункции


