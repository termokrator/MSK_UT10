///////////////////Регламентные процедуры///////////////////
&НаСервере
Процедура ОтправкаДокументовЭДО() Экспорт  
	
	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда 
		
		ЗаписьЖурналаРегистрации("Отправка документов ЭДО", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Отменена работа регламентного задания из-за несоответствия параметров подключения к ИБ");
		Возврат;
		
	КонецЕсли;
		
	МодульИнтеграции = Обработки.МодульИнтеграцииDiState.Создать();
	
	ПараметрыВозврата = МодульИнтеграции.АвторизацияПоЛогинуИПаролю(Константы.ЭДО_Адрес.Получить(), Константы.ЭДО_Логин.Получить(), Константы.ЭДО_Пароль.Получить());
	Если ПараметрыВозврата.ОшибкаАвторизации Тогда
		
		ЗаписьЖурналаРегистрации("ЭДО.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, "Ошибка при выполнении регламентного задания Отправка документов ЭДО" + Символы.ПС + ПараметрыВозврата.ТекстОшибки);
		Возврат;
		
	КонецЕсли;
	
	ПараметрыВозврата = МодульИнтеграции.ЗакончитьПроцессАвторизации(ПараметрыВозврата);
	
	Если ПараметрыВозврата.Свойство("ОтпечатокСертификата") И ЗначениеЗаполнено(ПараметрыВозврата.ОтпечатокСертификата) Тогда
		МодульИнтеграции.ОтпечатокСертификата = ПараметрыВозврата.ОтпечатокСертификата;		
	Иначе
		
		ЗаписьЖурналаРегистрации("ЭДО.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, "Ошибка при выполнении регламентного задания Отправка документов ЭДО" + Символы.ПС + "Не заполнен отпечаток сертификата при подключении к DiState");
		Возврат;
		
	КонецЕсли;

	МодульИнтеграции.ВерсияСервера = 6;
	
	МодульИнтеграции.Организация = Константы.ОсновнаяОрганизация.Получить();
	
	ДатаНачалаВыгрузкиДокументовЭДО = Константы.ДатаНачалаВыгрузкиДокументовЭДО.Получить();
	
	КонецПериода = ТекущаяДата();   
	
	Если Не ЗначениеЗаполнено(ДатаНачалаВыгрузкиДокументовЭДО) Тогда
		НачалоПериода = ТекущаяДата() - 86400 * 14;   		
	Иначе
		НачалоПериода = ДатаНачалаВыгрузкиДокументовЭДО;
	КонецЕсли;
	
	Попытка
		
		Валюты = МодульИнтеграции.ВыполнитьСинхронизациюВалют();
		МодульИнтеграции.СправочникВалюты.Загрузить(Валюты);
		
		Регионы = МодульИнтеграции.ВыполнитьСинхронизациюРегионов();
		МодульИнтеграции.СправочникРегионы.Загрузить(Регионы);
		
	Исключение
		//ОписаниеОшибки()
	КонецПопытки;
	
	ВидыДляОтправки = Новый Массив;
	ВидыДляОтправки.Добавить("Универсальный передаточный документ");
	ВидыДляОтправки.Добавить("Универсальный корректировочный документ");
	
	//+Белов А. 25.08.2026 #
	Если Константы.ЭДО_ВыгружатьЗаказЗаявки.Получить() Тогда		
		ВидыДляОтправки.Добавить("Заказ-заявка");           	
	КонецЕсли; 
	
	Если Константы.ЭДО_ВыгружатьТранспортныеНакладные.Получить() Тогда		
		ВидыДляОтправки.Добавить("Транспортная накладная");           	
	КонецЕсли;
	//-Белов А. 25.08.2026 #
	
	Для каждого ВидОтправки ИЗ ВидыДляОтправки Цикл
		
		УПД = Истина;

		Если ВидОтправки = "Транспортная накладная" ИЛИ ВидОтправки = "Заказ-заявка" Тогда
			УПД = Ложь;	
		КонецЕсли;

		ТаблицаДанных = МодульИнтеграции.ПолучитьДокументы(ВидОтправки, Неопределено, НачалоПериода, КонецПериода, Истина, "", УПД);
		
		Если ТипЗнч(ТаблицаДанных) = Тип("Строка") Тогда
			
			ЗаписьЖурналаРегистрации("ЭДО.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, "Внутренняя ошибка работы при выполнении регламентного задания Отправка документов ЭДО " + ТаблицаДанных);
			Продолжить; 
			
		КонецЕсли;
		
		Если ТаблицаДанных.Количество() = 0 Тогда
			
			Сообщить("Нет данных для выгрузки из 1С по установленным отборам");
			Продолжить;
			
		КонецЕсли;
		
		МодульИнтеграции.ИсходящиеДокументы.Загрузить(ТаблицаДанных);
		
		Для каждого СтрИсходящий ИЗ МодульИнтеграции.ИсходящиеДокументы Цикл
			СтрИсходящий.Отправлять = Истина;
		КонецЦикла;
				
		СоздатьИПодписатьДокументыПродолжение(МодульИнтеграции);
	
	КонецЦикла;
				
КонецПроцедуры

&НаСервере
Процедура ОбновлениеСтатусовДокументовЭДО() Экспорт

	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда 
		
		ЗаписьЖурналаРегистрации("Обновление статусов документов ЭДО", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Отменена работа регламентного задания из-за несоответствия параметров подключения к ИБ");
		Возврат;
		
	КонецЕсли;   
	
	ОбновитьСтатусыПоПараметрамПодключения(Константы.ЭДО_Адрес.Получить(), Константы.ЭДО_Логин.Получить(), Константы.ЭДО_Пароль.Получить());   
	
	Если Константы.ЭДО_ОбновлятьСтатусыПоРезервномуАдресу.Получить() Тогда
		ОбновитьСтатусыПоПараметрамПодключения(Константы.ЭДО_Адрес_Резерв.Получить(), Константы.ЭДО_Логин_Резерв.Получить(), Константы.ЭДО_Пароль_Резерв.Получить());   	
	КонецЕсли;
				
КонецПроцедуры

&НаСервере
Процедура ОбновитьСтатусыПоПараметрамПодключения(ЭДО_Адрес, ЭДО_Логин, ЭДО_Пароль)
	
	ЛимитДокументовПриОбновленииСтатусовДокументов = Константы.ЭДО_ЛимитДокументовПриОбновленииСтатусовДокументов.Получить();
	
	Если Не ЗначениеЗаполнено(ЛимитДокументовПриОбновленииСтатусовДокументов) Тогда
    	ЛимитДокументовПриОбновленииСтатусовДокументов = 500;
	КонецЕсли;
	
	МассивСтатусов = Новый Массив;
	МассивСтатусов.Добавить(Перечисления.СтатусыОбменаЭДО.Отправка);
	МассивСтатусов.Добавить(Перечисления.СтатусыОбменаЭДО.ОжидаетПодписания); 
	
	//+Белов А. 25.10.2023 #
	МассивСтатусов.Добавить(Перечисления.СтатусыОбменаЭДО.ОжидаетПодписанияАннулирования);
	МассивСтатусов.Добавить(Перечисления.СтатусыОбменаЭДО.ОтправкаАннулирования);   
	//-Белов А. 25.10.2023 #
	
	ТаблицаОтправленыхДокументов = ПолучитьДокументыПоСтатусам(МассивСтатусов);

	//Если нет документов для обновления статуса, то возвращаем
	Если ТаблицаОтправленыхДокументов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МодульИнтеграции = Обработки.МодульИнтеграцииDiState.Создать();
	
	ПараметрыВозврата = МодульИнтеграции.АвторизацияПоЛогинуИПаролю(ЭДО_Адрес, ЭДО_Логин, ЭДО_Пароль);
	Если ПараметрыВозврата.ОшибкаАвторизации Тогда
		
		ЗаписьЖурналаРегистрации("ЭДО.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, "Ошибка при выполнении регламентного задания Обновление статусов документов ЭДО" + Символы.ПС + ПараметрыВозврата.ТекстОшибки);
		Возврат; 
		
	КонецЕсли;
	
	ТаблицаКПодписаниюДокументовЭДО = МодульИнтеграции.ПолучитьДокументыОжидающиеПодписи(ТекущаяДата() - (86400 * 365) * 2, ТекущаяДата(), ЛимитДокументовПриОбновленииСтатусовДокументов);
	
	ОбновитьСтатусыДокументов(ТаблицаОтправленыхДокументов.Скопировать(Новый Структура("Статус", Перечисления.СтатусыОбменаЭДО.Отправка)), ТаблицаКПодписаниюДокументовЭДО, Перечисления.СтатусыОбменаЭДО.ОжидаетПодписания, МодульИнтеграции);
	
	ТаблицаЗавершенныхДокументовЭДО = МодульИнтеграции.ПолучитьДокументыЗавершенные(ТекущаяДата() - (86400 * 365) * 2, ТекущаяДата(), ЛимитДокументовПриОбновленииСтатусовДокументов);
	
	ОбновитьСтатусыДокументов(ТаблицаОтправленыхДокументов, ТаблицаЗавершенныхДокументовЭДО, Перечисления.СтатусыОбменаЭДО.Завершен, МодульИнтеграции);
	
	//+Белов А. 25.10.2023 #
	ОбновитьСтатусыДокументов(ТаблицаОтправленыхДокументов.Скопировать(Новый Структура("Статус", Перечисления.СтатусыОбменаЭДО.ОтправкаАннулирования)), ТаблицаКПодписаниюДокументовЭДО, Перечисления.СтатусыОбменаЭДО.ОжидаетПодписанияАннулирования, МодульИнтеграции);	
	//-Белов А. 25.10.2023 #
	
КонецПроцедуры

&НаСервере
Процедура ОбновлениеСтатусовВходящихДокументовЭДО() Экспорт 
	
	//+Макрушин Е. 17.03.2026 #UT10-5658
	Если Константы.ЭДО_ОбновлятьСтатусыПоРезервномуАдресу.Получить() Тогда
		СтруктураВозвратаМодуля = ПолучитьМодульИнтеграции(Истина);                 
	Иначе
		СтруктураВозвратаМодуля = ПолучитьМодульИнтеграции();                 
	КонецЕсли;
	
	Если СтруктураВозвратаМодуля.Результат Тогда
		МодульИнтеграции = СтруктураВозвратаМодуля.МодульИнтеграции;
	Иначе
		
		ЗаписьЖурналаРегистрации("ЭДО.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, "Ошибка при выполнении регламентного задания Обновление статусов входящих документов ЭДО" + Символы.ПС + СтруктураВозвратаМодуля.Сообщение);
		Возврат;
		
	КонецЕсли; 
	
	ЛимитДокументовПриОбновленииСтатусовВходящихДокументов = Константы.ЭДО_ЛимитДокументовПриОбновленииСтатусовВходящихДокументов.Получить();
	
	Если Не ЗначениеЗаполнено(ЛимитДокументовПриОбновленииСтатусовВходящихДокументов) Тогда
		ЛимитДокументовПриОбновленииСтатусовВходящихДокументов = 1000;
	КонецЕсли;
	
	//Обновление статусов поступлений 
	Если Константы.ОбновлятьСтатусыПоступленийЭДО.Получить() Тогда
		
		ТаблицаДокументовЭДО = МодульИнтеграции.ПолучитьДокументыВходящиеОжидающиеПодписи(ТекущаяДата() - (86400 * 180), ТекущаяДата(), "connector_utd_invoice_and_waybill", ЛимитДокументовПриОбновленииСтатусовВходящихДокументов); 
		
		ТаблицаПоступлений = Новый ТаблицаЗначений; 
		ТаблицаПоступлений.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(30)));
		ТаблицаПоступлений.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
		ТаблицаПоступлений.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Число"));   
		ТаблицаПоступлений.Колонки.Добавить("Отправитель", Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"));   
		ТаблицаПоступлений.Колонки.Добавить("ИдентификаторОтправителя", Новый ОписаниеТипов("Число")); 
		ТаблицаПоступлений.Колонки.Добавить("ДанныеДокумента");
		
		Для каждого СтрокаТаблицы Из ТаблицаДокументовЭДО Цикл
			
			Если СтрокаТаблицы.ГруппаПроцессинга = "universal_invoice_connector_utd_invoice_and_waybill" Тогда
				
				Если ЗначениеЗаполнено(СтрокаТаблицы.Отправитель) 
					И ТипЗнч(СтрокаТаблицы.Отправитель) = Тип("СправочникСсылка.ДоговорыКонтрагентов")
					И СтрокаТаблицы.Отправитель.ДатаНачалаОбменаЭДО <= СтрокаТаблицы.Дата Тогда
					
					НСтр = ТаблицаПоступлений.Добавить();        
					ЗаполнитьЗначенияСвойств(НСтр, СтрокаТаблицы);
					НСтр.Идентификатор = СтрокаТаблицы.ИдентификаторДокумента;
					НСтр.ИдентификаторОтправителя = СтрокаТаблицы.ИдентификаторОтправителя;
					
				КонецЕсли;
				
			КонецЕсли;		
			
		КонецЦикла; 
		
		Если ТаблицаПоступлений.Количество() > 0 Тогда
			ОбработатьВходящиеПоступлений(ТаблицаПоступлений, МодульИнтеграции);		
		КонецЕсли;   
		
	КонецЕсли; 
	//-Макрушин Е. 17.03.2026 #UT10-5658      
	
	//+Белов А. 25.09.2026 #UT10-6055
	//Обновление статусов транспортных накладных 
	Если Константы.ОбновлятьСтатусыТранспортныхНакладныхЭДО.Получить() Тогда
		
		ТаблицаДокументовЭДО = МодульИнтеграции.ПолучитьДокументыВходящиеОжидающиеПодписи(ТекущаяДата() - (86400 * 180), ТекущаяДата(), "electronic_waybill", ЛимитДокументовПриОбновленииСтатусовВходящихДокументов, "_consignee"); 
		
		ТаблицаТН = Новый ТаблицаЗначений; 
		ТаблицаТН.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(30)));
		ТаблицаТН.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
		ТаблицаТН.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Число"));   
		ТаблицаТН.Колонки.Добавить("Отправитель", Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"));   
		ТаблицаТН.Колонки.Добавить("ИдентификаторОтправителя", Новый ОписаниеТипов("Число")); 
		
		Для каждого СтрокаТаблицы Из ТаблицаДокументовЭДО Цикл
			
			Если Не ЗначениеЗаполнено(СтрокаТаблицы.Отправитель)
				Или ЗначениеЗаполнено(СтрокаТаблицы.Отправитель)
				И Не ТипЗнч(СтрокаТаблицы.Отправитель) = Тип("СправочникСсылка.ДоговорыКонтрагентов")
				Или ЗначениеЗаполнено(СтрокаТаблицы.Отправитель) 
				И ТипЗнч(СтрокаТаблицы.Отправитель) = Тип("СправочникСсылка.ДоговорыКонтрагентов")
				И СтрокаТаблицы.Отправитель.ДатаНачалаОбменаЭДО <= СтрокаТаблицы.Дата
				Тогда			
				
				НСтр = ТаблицаТН.Добавить();        
				ЗаполнитьЗначенияСвойств(НСтр, СтрокаТаблицы);
				НСтр.Идентификатор = СтрокаТаблицы.ИдентификаторДокумента;
				
			КонецЕсли;		
			
		КонецЦикла;
		
		ОбработатьВходящиеТН_Грузополучатель(ТаблицаТН, МодульИнтеграции);
		
	КонецЕсли;       
	//-Белов А. 25.09.2026 #UT10-6055
	
КонецПроцедуры  

&НаСервере
Процедура ОчисткаРегистраДокументовТребующихОбработки() Экспорт
	
	//+Макрушин Е. 20.03.2026 #UT10-5658
	УстановитьПривилегированныйРежим(Истина);
	
	Дата = ТекущаяДата() - 365*86400;     
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДокументыЭДОТребующиеОбработки.Идентификатор
	|ИЗ
	|	РегистрСведений.ДокументыЭДОТребующиеОбработки КАК ДокументыЭДОТребующиеОбработки
	|ГДЕ
	|	ДокументыЭДОТребующиеОбработки.Дата < &Дата";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл

		МенеджерЗаписи = РегистрыСведений.ДокументыЭДОТребующиеОбработки.СоздатьМенеджерЗаписи(); 
		МенеджерЗаписи.Идентификатор = Выборка.Идентификатор;
		МенеджерЗаписи.Удалить();
		
	КонецЦикла; 
	
	УстановитьПривилегированныйРежим(Ложь);
	//-Макрушин Е. 20.03.2026 #UT10-5658
	
КонецПроцедуры

///////////////////Процедуры для отправки документов в ЭДО///////////////////
&НаСервере
Процедура СоздатьИПодписатьДокументыПродолжение(Объект, ДополнительныеПараметры = Неопределено)
	
	ПорцияОтправки = 10;
	
	КоличествоДокументовКОтправке = Объект.ИсходящиеДокументы.Количество();
	СписокДокументовКОчистке = Новый Массив;	
	МаксКоличествоКОтправке = ПолучитьКоличествоДокументовКОтправке(Объект);
	СчетчикВыгруженных = 0;	
					
	МассивДокументов = Новый Массив;
	
	Для НомерДокумента = 1 По КоличествоДокументовКОтправке Цикл
		
		СтрокаТаблицы = Объект.ИсходящиеДокументы.Получить(НомерДокумента - 1);
		
		Если Объект.ИсходящиеДокументы.Получить(НомерДокумента - 1).Отправлять Тогда
			
			КонтентДляПодписи = СоздатьИВернутьДляПодписиДокумент(НомерДокумента, Объект);  
			
			Если ТипЗнч(КонтентДляПодписи) = Тип("Соответствие") Тогда
				
				Если КонтентДляПодписи.Получить("success") <> Неопределено И КонтентДляПодписи.Получить("success") Тогда
					
					СтрокаКонтента = КонтентДляПодписи.Получить("content");	
					ЗаписатьИсториюОбменаЭДО(СтрокаТаблицы.Ссылка, ПредопределенноеЗначение("Перечисление.СтатусыОбменаЭДО.Подготовка"),,"Документ успешно подготовлен", Истина); //Белов
					
				ИначеЕсли КонтентДляПодписи.Получить("success") <> Неопределено Тогда
					Объект.ИсходящиеДокументы.Получить(НомерДокумента - 1).ОписаниеОшибки = КонтентДляПодписи.Получить("codeDescription")
					+ Символы.ПС + ВернутьРазобранныйСписокПроблем(КонтентДляПодписи.Получить("violations"));
					
					ЗаписатьИсториюОбменаЭДО(СтрокаТаблицы.Ссылка, ПредопределенноеЗначение("Перечисление.СтатусыОбменаЭДО.Подготовка"), СтрокаТаблицы.ОписаниеОшибки, "Ошибка при подготовке документа к отправке", Истина); //Белов
					
					Продолжить;
				КонецЕсли;
				
			Иначе
				
				СтрокаКонтента = КонтентДляПодписи.content;	
				ЗаписатьИсториюОбменаЭДО(СтрокаТаблицы.Ссылка, ПредопределенноеЗначение("Перечисление.СтатусыОбменаЭДО.Подготовка"),,"Документ успешно подготовлен", Истина); //Белов
				
			КонецЕсли;
			
			Попытка
				
				ДвоичныеДанныеДокумента = Base64Значение(СтрокаКонтента);
				
				Если Объект.ОтпечатокСертификата = Неопределено Тогда
					Возврат;
				КонецЕсли;
				
				СтрокаПодписи = "";
				//СтрокаПодписи = ПодписатьДокументЭП(ДвоичныеДанныеДокумента, СтрокаПароля); 
				
				МассивДокументов.Добавить(ПодготовитьСтруктуруЗапросаНаСоздание(НомерДокумента, СтрокаКонтента, СтрокаПодписи, Объект) );
				
				СчетчикВыгруженных = СчетчикВыгруженных + 1;
				
				Если СчетчикВыгруженных % ПорцияОтправки = 0 ИЛИ СчетчикВыгруженных = МаксКоличествоКОтправке Тогда						
					
					ОтправитьМассивНовыхДокументов(МассивДокументов, Объект);
					МассивДокументов.Очистить();  
					
				КонецЕсли;  
				
			Исключение
				
				Сообщить(ИнформацияОбОшибке().Описание);
				Объект.ЗапомнитьПароль = Ложь; 
				
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если МассивДокументов.Количество() > 0 Тогда
		
		ОтправитьМассивНовыхДокументов(МассивДокументов, Объект);
		МассивДокументов.Очистить(); 
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПолучитьКоличествоДокументовКОтправке(Объект)
	
	Количество = 0;
	
	Для Каждого СтрокаТЧ Из Объект.ИсходящиеДокументы Цикл
		
		Если СтрокаТЧ.Отправлять Тогда
			Количество = Количество + 1;	
		КонецЕсли; 
		
	КонецЦикла; 
	
	Возврат Количество; 
	
КонецФункции

&НаСервере
Функция СоздатьИВернутьДляПодписиДокумент(НомерДокумента, Объект)

	Если ЗначениеЗаполнено(НомерДокумента) Тогда
		
		СтрокаТаблицы = Объект.ИсходящиеДокументы[НомерДокумента-1];
		СтруктураСтрокиТЧ = Новый Структура("Ссылка,УПД, СФ");
		ЗаполнитьЗначенияСвойств(СтруктураСтрокиТЧ, СтрокаТаблицы);
		
		Возврат Объект.СоздатьXMLДокументаИВернутьДляПодписания(СтруктураСтрокиТЧ);
		
	КонецЕсли;  
	
КонецФункции

&НаСервере
Функция ВернутьРазобранныйСписокПроблем(МассивОшибок)

	СтрокаТекста = "";
	Если НЕ ЗначениеЗаполнено(МассивОшибок) Тогда
		Возврат СтрокаТекста;
	КонецЕсли;
	
	Если ТипЗнч(МассивОшибок) = Тип("Массив") Тогда
		
		Для Каждого Ошибка Из МассивОшибок Цикл
			
			Если ЗначениеЗаполнено(СтрокаТекста) Тогда
				СтрокаТекста = СтрокаТекста + Символы.ПС;
			КонецЕсли; 
			
			Если ТипЗнч(Ошибка) = Тип("Строка") Тогда
				СтрокаТекста = СтрокаТекста + Ошибка;	
			Иначе
				
				Если Ошибка.Получить("propertyPath") <> Неопределено Тогда
					СтрокаТекста = СтрокаТекста + Ошибка.Получить("propertyPath") + ": ";
				КонецЕсли;
				
				Если Ошибка.Получить("violation") <> Неопределено Тогда
					СтрокаТекста = СтрокаТекста + Ошибка.Получить("violation");
				КонецЕсли;  
				
			КонецЕсли; 
			
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(МассивОшибок) = Тип("Соответствие") Тогда
		
		Если МассивОшибок.Получить("violations") <> Неопределено Тогда
			СтрокаТекста = ВернутьРазобранныйСписокПроблем(МассивОшибок.Получить("violations"));
		КонецЕсли;
		
	КонецЕсли; 
	
	Возврат СтрокаТекста;
	
КонецФункции

&НаСервере
Функция ПодготовитьСтруктуруЗапросаНаСоздание(НомерДокумента, Контент, Подпись, Объект)
	
	СтрокаДанных = Объект.ИсходящиеДокументы.Получить(НомерДокумента - 1);
	ТипДокумента = ВыдатьКорректныйТипДокумента(СтрокаДанных);
	
	СтруктураЗапроса = Новый Структура("Контрагент,ТипДокумента,Контент,Подпись,СсылкаНаДокумент");
		
	СтруктураЗапроса.Контрагент = Объект.ПолучитьКонтрагентаПоОбъектуЗаполнения(СтрокаДанных.Ссылка);//Белов СтрокаДанных.Контрагент;
	СтруктураЗапроса.ТипДокумента = ТипДокумента;
	СтруктураЗапроса.Контент = Контент;
	СтруктураЗапроса.Подпись = Подпись;
	СтруктураЗапроса.СсылкаНаДокумент = СтрокаДанных.Ссылка;
	
	Возврат СтруктураЗапроса;
	
КонецФункции

&НаСервере
Функция ВыдатьКорректныйТипДокумента(СтрокаДанных)
	
	ТипДокумента = СтрокаДанных.Тип;
	
	Если СтрокаДанных.УПД И НЕ Найти(ТипДокумента, "Счет на оплату") Тогда
		
		Если ТипДокумента <> "Акт сверки" Тогда
			
			Если НЕ Найти(Строка(СтрокаДанных.Ссылка), "фактур")  Тогда
				
				Если Найти(ТипДокумента, "коррект") Тогда
					ТипДокумента = "УКД";
				Иначе
					ТипДокумента = "УПД";
				КонецЕсли; 
				
			КонецЕсли;
			
		КонецЕсли;   
		
	КонецЕсли;
	
	Возврат ТипДокумента;
	
КонецФункции

&НаСервере
Функция ОтправитьМассивНовыхДокументов(МассивДокументов, Объект)
	
	РезультатОбработки = Объект.МассовоСоздатьДокументыВЭДО(МассивДокументов);
	
	Если ТипЗнч(РезультатОбработки) = Тип("Массив") Тогда
		
		Для Каждого ЭлементОшибка Из РезультатОбработки Цикл
			
			РезультатОтправки = ЭлементОшибка.Результат;
			МассивСтрокТаблицы = Объект.ИсходящиеДокументы.НайтиСтроки(Новый Структура("Ссылка", ЭлементОшибка.Ссылка));
			
			Если МассивСтрокТаблицы.Количество() = 1 Тогда
				
				СтрокаДанных = МассивСтрокТаблицы[0];
				
				Если РезультатОтправки.Получить("success") = Истина Тогда
					СтрокаДанных.Статус = "Документ отправлен";
					СтрокаДанных.Идентификатор = РезультатОтправки.Получить("documentId");
					
					ЗаписатьИсториюОбменаЭДО(СтрокаДанных.Ссылка, ПредопределенноеЗначение("Перечисление.СтатусыОбменаЭДО.Отправка"),, "Документ успешно отправлен: " + Символы.ПС + "Идентификатор документа: " + СтрокаДанных.Идентификатор, Истина); //Белов
			
					
				ИначеЕсли РезультатОтправки.Получить("success") = Ложь Тогда
					СтрокаДанных.ОписаниеОшибки = РезультатОтправки.Получить("codeDescription") 
										+ Символы.ПС + ВернутьРазобранныйСписокПроблем(РезультатОтправки.Получить("details") );
										
					ЗаписатьИсториюОбменаЭДО(СтрокаДанных.Ссылка, ПредопределенноеЗначение("Перечисление.СтатусыОбменаЭДО.Отправка"), СтрокаДанных.ОписаниеОшибки, "Ошибка при отправке документа", Истина); //Белов
					
				КонецЕсли;
				
		   КонецЕсли;
		   
		КонецЦикла;
		
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура АннулированиеДокументовЭДО() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	
	//+Гавриленков В. 13.11.2025 #UT10-5499
	//"ВЫБРАТЬ
