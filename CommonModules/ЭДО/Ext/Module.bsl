	|	ВТ_Документы.Порядок";
	//-Гавриленков В. 13.11.2025 #UT10-5499
	
	
	Запрос.УстановитьПараметр("ДатаНачала", Константы.ЭДО_ДатаНачалаАннулированияДокументов.Получить());     
	Запрос.УстановитьПараметр("Свойство", ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("DS_Документ_ID"));
	Запрос.УстановитьПараметр("Состояние", ПланыВидовХарактеристик.СвойстваОбъектов.СостояниеЭДО);	
	
	МассивСостояний = Новый Массив;
	МассивСостояний.Добавить(Перечисления.СостояниеЭДО.Отправлен);
	МассивСостояний.Добавить(Перечисления.СостояниеЭДО.Подписан);
	
	Запрос.УстановитьПараметр("МассивСостояний", МассивСостояний);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() > 0 Тогда
		
		МодульИнтеграции = Обработки.МодульИнтеграцииDiState.Создать();       
		
		ПараметрыВозврата = МодульИнтеграции.АвторизацияПоЛогинуИПаролю(Константы.ЭДО_Адрес.Получить(), Константы.ЭДО_Логин.Получить(), Константы.ЭДО_Пароль.Получить());
		Если ПараметрыВозврата.ОшибкаАвторизации Тогда
			
			ЗаписьЖурналаРегистрации("ЭДО.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, "Ошибка при выполнении регламентного задания Отправка аннулирований" + Символы.ПС + ПараметрыВозврата.ТекстОшибки);
			Возврат; 
			
		КонецЕсли; 
		
		ПараметрыВозврата = МодульИнтеграции.ЗакончитьПроцессАвторизации(ПараметрыВозврата);
		
		Если ПараметрыВозврата.Свойство("ОтпечатокСертификата") И ЗначениеЗаполнено(ПараметрыВозврата.ОтпечатокСертификата) Тогда
			МодульИнтеграции.ОтпечатокСертификата = ПараметрыВозврата.ОтпечатокСертификата;		
		Иначе 
			
			ЗаписьЖурналаРегистрации("ЭДО.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, "Ошибка при выполнении регламентного задания Отправка аннулирований" + Символы.ПС + "Не заполнен отпечаток сертификата при подключении к DiState");
			Возврат; 
			
		КонецЕсли;
		
		МодульИнтеграции.ВерсияСервера = 6;	
		МодульИнтеграции.Организация = Константы.ОсновнаяОрганизация.Получить();
			
		Пока Выборка.Следующий() Цикл  
			//+Гавриленков В. 13.11.2025 #UT10-5499
			//Аннулировать(Выборка.Реализация, Выборка.Идентификатор, МодульИнтеграции);
			Аннулировать(Выборка.Документ, Выборка.Идентификатор, МодульИнтеграции);
			//-Гавриленков В. 13.11.2025 #UT10-5499
		КонецЦикла; 
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура Аннулировать(ДокументАннулирования, ИдентификаторДокумента, МодульИнтеграции)
 			
	СтруктураАннулирования = Новый Структура;
	СтруктураАннулирования.Вставить("ПричинаАннулирования", "Отказ клиента");  
	СтруктураАннулирования.Вставить("Ссылка", ДокументАннулирования);
	СтруктураАннулирования.Вставить("Идентификатор", Число(ИдентификаторДокумента));
	
	КонтентДляПодписи = МодульИнтеграции.СоздатьXMLКвитанциюОбАннулированииИВернутьДляПодписания(СтруктураАннулирования);
	
	Если КонтентДляПодписи <> Неопределено И КонтентДляПодписи.Получить("success") <> Неопределено И КонтентДляПодписи.Получить("success") Тогда 		
		
		СтрокаКонтента = КонтентДляПодписи.Получить("content"); 
		
		ЭДО.ЗаписатьИсториюОбменаЭДО(ДокументАннулирования, Перечисления.СтатусыОбменаЭДО.ПодготовкаАннулирования,,"Квитанция для аннулирования была успешно подготовлена");
		
		Результат = МодульИнтеграции.ОтправитьПодписаннуюКвитанцию(ИдентификаторДокумента, СтрокаКонтента, "", "Аннулировать");     
		
		Если Результат <> Неопределено И Результат.Получить("success") <> Неопределено И Результат.Получить("success") Тогда			
			ЭДО.ЗаписатьИсториюОбменаЭДО(ДокументАннулирования, Перечисления.СтатусыОбменаЭДО.ОтправкаАннулирования,,"Квитанция для аннулирования была успешно отправлена",,1); 
		Иначе   
			
			Ошибка = "Возникла ошибка при подписании квитанции";
			
			Если Результат.Получить("details") <> Неопределено Тогда
				Ошибка = Ошибка + ": " + Результат.Получить("details");	
			КонецЕсли;
			
			Если Результат.Получить("code") <> Неопределено Тогда
				Ошибка = Ошибка + " (" + Результат.Получить("code") + ")";	
			КонецЕсли;
			
			ЭДО.ЗаписатьИсториюОбменаЭДО(ДокументАннулирования, Перечисления.СтатусыОбменаЭДО.ОтправкаАннулирования, Ошибка,, Истина, 1); 
			
		КонецЕсли;
		
	Иначе    
		
		Ошибка = "Не был создан контент для подписи"; 
		
		Если КонтентДляПодписи <> Неопределено Тогда
			
			Если КонтентДляПодписи.Получить("details") <> Неопределено Тогда
				Ошибка = Ошибка + ": " + Результат.Получить("details");	
			КонецЕсли;
			
			Если КонтентДляПодписи.Получить("code") <> Неопределено Тогда
				Ошибка = Ошибка + " (" + Результат.Получить("code") + ")";	
			КонецЕсли; 
			
		КонецЕсли;
	
		ЭДО.ЗаписатьИсториюОбменаЭДО(ДокументАннулирования, Перечисления.СтатусыОбменаЭДО.ПодготовкаАннулирования, Ошибка,, Истина);
		
	КонецЕсли; 

КонецПроцедуры

 &НаСервере
Процедура ОтправитьФормализованныйДокументПоЭдо(Документ) Экспорт
	
	//+Макрушин Е. 06.04.2026 #UT10-5800
	МассивДокументов = Новый Массив;
	МассивДокументов.Добавить(Документ);
	
	ОтправитьФормализованныеДокументыПоЭдо(МассивДокументов);
	//-Макрушин Е. 06.04.2026 #UT10-5800
		 
КонецПроцедуры

 &НаСервере
Процедура ОтправитьФормализованныеДокументыПоЭдо(МассивДокументов)
	
	//+Макрушин Е. 06.04.2026 #UT10-5800
	Если Константы.ЭДО_ОбновлятьСтатусыПоРезервномуАдресу.Получить() Тогда
		СтруктураВозвратаМодуля = ПолучитьМодульИнтеграции(Истина);           
	Иначе
		СтруктураВозвратаМодуля = ПолучитьМодульИнтеграции();  
	КонецЕсли;
	
	Если СтруктураВозвратаМодуля.Результат Тогда
		МодульИнтеграции = СтруктураВозвратаМодуля.МодульИнтеграции;
	Иначе          
		ЗаписьЖурналаРегистрации("ЭДО.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, "Ошибка при отправке документов по ЭДО" + Символы.ПС + СтруктураВозвратаМодуля.Сообщение);
		Возврат;
	КонецЕсли;
	
	Для каждого Документ Из МассивДокументов Цикл
			
		НСтр = МодульИнтеграции.ИсходящиеДокументы.Добавить();
		
		Если ТипЗнч(Документ) = Тип("ДокументСсылка.АктОРасхожденияхПослеПриемки") Тогда
			НСтр.Тип = "Торг-2";                                     
		КонецЕсли;
		
		НСтр.Ссылка = Документ; 
		НСтр.Отправлять = Истина;
		
	КонецЦикла;      
	
	СоздатьИПодписатьДокументыПродолжение(МодульИнтеграции);
	//-Макрушин Е. 06.04.2026 #UT10-5800
	
КонецПроцедуры

///////////////////Процедуры для обновления статусов документов в ЭДО///////////////////
&НаСервере
Функция ПолучитьДокументыПоСтатусам(МассивСтатусов) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИсторияОбменовЭДОСрезПоследних.Объект,
	               |	МАКСИМУМ(ИсторияОбменовЭДОСрезПоследних.Статус) КАК Статус
	               |ПОМЕСТИТЬ ВТ_Документы
	               |ИЗ
	               |	РегистрСведений.ИсторияОбменовЭДО.СрезПоследних КАК ИсторияОбменовЭДОСрезПоследних
	               |ГДЕ
	               |	ИсторияОбменовЭДОСрезПоследних.Ошибка ПОДОБНО """"
	               |	И ИсторияОбменовЭДОСрезПоследних.Статус В (&СписокСтатусов)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ИсторияОбменовЭДОСрезПоследних.Объект
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Документы.Объект КАК Документ,
	               |	МАКСИМУМ(ДополнительныеСведения.Значение) КАК ИдентификаторДокумента,
	               |	МАКСИМУМ(ВТ_Документы.Статус) КАК Статус
	               |ИЗ
	               |	ВТ_Документы КАК ВТ_Документы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ДополнительныеСведения
	               |		ПО ВТ_Документы.Объект = ДополнительныеСведения.Объект
	               |			И (ДополнительныеСведения.Свойство = &Свойство)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_Документы.Объект";
	
	СписокСтатусов = Новый СписокЗначений;
	
	Если ТипЗнч(МассивСтатусов) = Тип("Массив") Тогда
		СписокСтатусов.ЗагрузитьЗначения(МассивСтатусов);
	Иначе
		СписокСтатусов.Добавить(МассивСтатусов);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("СписокСтатусов", СписокСтатусов);
	Запрос.УстановитьПараметр("Свойство", ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("DS_Документ_ID"));
	
	ТаблицаДокументов = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаДокументов;

КонецФункции

&НаСервере
Функция ПолучитьСтатусДокумента(Документ) Экспорт
	
	СтруктураВозврата = Новый Структура("Статус, Комментарий", Перечисления.СтатусыОбменаЭДО.ПустаяСсылка(), "");
	
//+Макрушин Е. 09.04.2026 #UT10-5800
    СтруктураВозврата.Вставить("Ошибка", "");
//-Макрушин Е. 09.04.2026 #UT10-5800
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИсторияОбменовЭДОСрезПоследних.Статус,
	|	ИсторияОбменовЭДОСрезПоследних.Комментарий
//+Макрушин Е. 09.04.2026 #UT10-5800
	|	,ИсторияОбменовЭДОСрезПоследних.Ошибка
//-Макрушин Е. 09.04.2026 #UT10-5800
	|ИЗ
	|	РегистрСведений.ИсторияОбменовЭДО.СрезПоследних(, Объект = &Документ) КАК ИсторияОбменовЭДОСрезПоследних";
	
	Запрос.УстановитьПараметр("Документ", Документ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураВозврата, Выборка);		
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции

&НаСервере
Процедура ОбновитьСтатусыДокументов(ТаблицаДокументов, ТаблицаДокументовЭДО, Статус, МодульИнтеграции) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаблицаДокументов.Документ,
	               |	ТаблицаДокументов.ИдентификаторДокумента
	               |ПОМЕСТИТЬ ВТ_Документы
	               |ИЗ
	               |	&ТаблицаДокументов КАК ТаблицаДокументов
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаДокументовЭДО.ОжидаемыеДействия,
	               |	ТаблицаДокументовЭДО.ИдентификаторДокумента
	               |ПОМЕСТИТЬ ВТ_ДокументыЭДО
	               |ИЗ
	               |	&ТаблицаДокументовЭДО КАК ТаблицаДокументовЭДО
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Документы.Документ,
	               |	МАКСИМУМ(ВТ_ДокументыЭДО.ОжидаемыеДействия) КАК ОжидаемыеДействия,
	               |	ВТ_ДокументыЭДО.ИдентификаторДокумента
	               |ИЗ
	               |	ВТ_ДокументыЭДО КАК ВТ_ДокументыЭДО
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Документы КАК ВТ_Документы
	               |		ПО ВТ_ДокументыЭДО.ИдентификаторДокумента = ВТ_Документы.ИдентификаторДокумента
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_Документы.Документ,
	               |	ВТ_ДокументыЭДО.ИдентификаторДокумента";
	
	Запрос.УстановитьПараметр("ТаблицаДокументов", ТаблицаДокументов);
	Запрос.УстановитьПараметр("ТаблицаДокументовЭДО", ТаблицаДокументовЭДО);
	
	ТаблицаДляОбновленияСтатусов = Запрос.Выполнить().Выгрузить();
	
	Для каждого Стр Из ТаблицаДляОбновленияСтатусов Цикл
		
		//+Белов А. 07.09.2026 #UT10-6034
		Если ТипЗнч(Стр.Документ) = Тип("ДокументСсылка.ЗаказЗаявка")
			И Статус = Перечисления.СтатусыОбменаЭДО.Завершен 
			И ТипЗнч(Стр.Документ.Организация) = Тип("СправочникСсылка.Контрагенты") Тогда
			
			СтруктураВозврата = МодульИнтеграции.ЭДО_ПолучитьДанныеДокументаJSON(Стр.ИдентификаторДокумента); 
			
			Если ЗначениеЗаполнено(СтруктураВозврата.Контент) И СтруктураВозврата.Контент.Получить("carrierResponse") <> Неопределено Тогда
				
				Об = Стр.Документ.ПолучитьОбъект(); 
				Об.ОтветПеревозчика = ОбщегоНазначения.ВернутьJSON(СтруктураВозврата.Контент.Получить("carrierResponse"));
				Об.ОбменДанными.Загрузка = Истина;               
				Об.Записать();
				
			Иначе
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;
		//-Белов А. 07.09.2026 #UT10-6034
		
		ЭДО.ЗаписатьИсториюОбменаЭДО(Стр.Документ, Статус, "", Стр.ОжидаемыеДействия);
		
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ОбновитьСтатусДокументаЭДО(Документ, СостояниеЭДО)
	
	Если НЕ Найти(СостояниеЭДО,"Документ успешно отправлен") = 0 Тогда
		ТекСостояние = "Отправлен";
	ИначеЕсли СостояниеЭДО = "Документооборот завершен" Тогда
		ТекСостояние = "Подписан";
	ИначеЕсли СостояниеЭДО = "Документ отклонен" Тогда
		ТекСостояние = "Отклонен";
	ИначеЕсли СостояниеЭДО = "annulled" Тогда
		ТекСостояние = "Аннулирован"; 
	//+Белов А. 13.10.2023 #
	ИначеЕсли СостояниеЭДО = "Квитанция для аннулирования была успешно отправлена" Тогда
	//-Белов А. 13.10.2023 #  
		ТекСостояние = "ОтправленоАннулирование";
	КонецЕсли;
	
	Если СокрЛП(ТекСостояние) = "" Тогда 
		Возврат; 
	КонецЕсли;   
	
	ТекСостояниеЭДО = Перечисления.СостояниеЭДО[ТекСостояние]; 
	
	ЗаписатьСостояниеЭДО(Документ, ТекСостояниеЭДО);
	
	Если Документ.Метаданные().Имя = "РеализацияТоваровУслуг" Тогда
		
		Если ТекСостояниеЭДО = Перечисления.СостояниеЭДО.Аннулирован  Тогда 

			Рег = РегистрыСведений.ВозвращенныеДокументы.СоздатьНаборЗаписей();
			Рег.Отбор.Коробка.Установить(Справочники.КоробкиХраненияДокументов.КоробкаЭДО);
			Рег.Отбор.Документ.Установить(Документ);
			Рег.Отбор.НеАктуально.Установить(Ложь);
			Рег.Прочитать();
			
			Если Рег.Количество() = 0 Тогда 
				
				Запись = Рег.Добавить();
				запись.Документ = Документ;
				Запись.Коробка = Справочники.КоробкиХраненияДокументов.КоробкаЭДО;
				Запись.ОригиналыПолучены = Истина;
				Запись.ДатаПолучения = ТекущаяДата();
				Запись.НомерПоПорядку = Обработки.ВозвращенныеДокументы.Создать().ПолучитьМаксимальныйНомерПоПорядку(Справочники.КоробкиХраненияДокументов.КоробкаЭДО);
				
			Иначе
				Запись = Рег[0];
			КонецЕсли;
			
			Запись.НасУстраивает = Ложь; 
			Запись.НетПечати = Ложь;
			Запись.ФИО = "";
			Запись.СуммаДокумента = Документ.СуммаДокумента;
			Запись.ДатаПоследнегоИзменения = ТекущаяДата();
			Рег.Записать();
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Функция ЗаписатьСостояниеЭДО(Документ, Статус) Экспорт 
		
	МенеджерЗаписи = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Объект = Документ;
	МенеджерЗаписи.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.СостояниеЭДО;
	МенеджерЗаписи.Значение = Статус;
	МенеджерЗаписи.Записать(Истина);	 
	
КонецФункции

///////////////////Процедуры для обновления статусов входящих документов в ЭДО//////////////////
&НаСервере
Функция ПолучитьТаблицуДействийНадПоступлением()
	
	//+Макрушин Е. 18.03.2026 #UT10-5658
	ТаблицаДействий = Новый ТаблицаЗначений;
	ТаблицаДействий.Колонки.Добавить("Действие");
	ТаблицаДействий.Колонки.Добавить("ПредставлениеДействия"); 
	ТаблицаДействий.Колонки.Добавить("Ошибка"); 
	ТаблицаДействий.Колонки.Добавить("Успешно", Новый ОписаниеТипов("Булево"));  
	
	НСтр = ТаблицаДействий.Добавить();   
	НСтр.Действие = "НайтиСоответствие";
	НСтр.ПредставлениеДействия = "Найти соответствующий документ в базе 1С"; 
	
	НСтр = ТаблицаДействий.Добавить();   
	НСтр.Действие = "ПроставитьПризнакПолучен";
	НСтр.ПредставлениеДействия = "Проставить у документа признак Документ получен";  
	
	НСтр = ТаблицаДействий.Добавить();   
	НСтр.Действие = "ПроставитьПризнакВЭлектронномВидеУСчетФактурыПолученной";
	НСтр.ПредставлениеДействия = "Проставить признак 'В электронном виде' у Счет-фактуры полученной";   
	
	Если Константы.АвтоматическиПодписыватьПоступленияЭДО.Получить() Тогда
		
		НСтр = ТаблицаДействий.Добавить();   
		НСтр.Действие = "ПодписатьДокумент";
		НСтр.ПредставлениеДействия = "Подписать документ в ЭДО";
		
	КонецЕсли;
	
	Возврат ТаблицаДействий;
	//-Макрушин Е. 18.03.2026 #UT10-5658
	
КонецФункции

&НаСервере
Процедура ОбработатьВходящиеПоступлений(ТаблицаПоступлений, МодульИнтеграции)
	
	//+Макрушин Е. 17.03.2026 #UT10-5658
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДокументыЭДОТребующиеОбработки.Идентификатор
	|ИЗ
	|	РегистрСведений.ДокументыЭДОТребующиеОбработки КАК ДокументыЭДОТребующиеОбработки
	|ГДЕ
	|	ДокументыЭДОТребующиеОбработки.Идентификатор В(&МассивИдентификаторов)";
	
	Запрос.УстановитьПараметр("МассивИдентификаторов", ТаблицаПоступлений.ВыгрузитьКолонку("Идентификатор")); 
	
	Выборка = Запрос.Выполнить().Выбрать();   
	
	Пока Выборка.Следующий() Цикл 
		
		СтрокаПоиска = ТаблицаПоступлений.Найти(Выборка.Идентификатор, "Идентификатор");
		
		Если СтрокаПоиска <> Неопределено Тогда
			ТаблицаПоступлений.Удалить(СтрокаПоиска);
		КонецЕсли;
			
	КонецЦикла;
	
	Если ТаблицаПоступлений.Количество() > 0 Тогда
		
		ТаблицаПоискаДокументов = Новый ТаблицаЗначений;
		ТаблицаПоискаДокументов.Колонки.Добавить("НомерВходящегоДокумента", Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(30)));
		ТаблицаПоискаДокументов.Колонки.Добавить("ДатаВходящегоДокумента", Новый ОписаниеТипов("Дата"));
		ТаблицаПоискаДокументов.Колонки.Добавить("СуммаСНДС", Новый ОписаниеТипов("Число"));
		ТаблицаПоискаДокументов.Колонки.Добавить("СуммаНДС", Новый ОписаниеТипов("Число"));
		ТаблицаПоискаДокументов.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Число")); 
		ТаблицаПоискаДокументов.Колонки.Добавить("Отправитель", Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"));   
		ТаблицаПоискаДокументов.Колонки.Добавить("ИдентификаторОтправителя", Новый ОписаниеТипов("Число"));
		
		Для каждого СтрокаТаблицы Из ТаблицаПоступлений Цикл
			
			СтруктураВозврата = МодульИнтеграции.ЭДО_ПолучитьДанныеДокументаJSON(СтрокаТаблицы.Идентификатор);
			
			Если ЗначениеЗаполнено(СтруктураВозврата.Контент) Тогда
				
				Попытка
					
					ДанныеДокумента = СтруктураВозврата.Контент; 
					
					ДанныеТаблицы = ДанныеДокумента.Получить("table").Получить("total"); 
					
					РасхождениеСНДС = 0;
					НДСРасхождения = 0;
					
					СуммаСНДС = Число(ДанныеТаблицы.Получить("totalCostAfterTax"));
					СуммаНДС = Число(ДанныеТаблицы.Получить("totalAmountOfTax"));
					
					НСтр = ТаблицаПоискаДокументов.Добавить();
					НСтр.НомерВходящегоДокумента = СтрокаТаблицы.Номер;
					НСтр.ДатаВходящегоДокумента = СтрокаТаблицы.Дата;
					НСтр.СуммаСНДС = СуммаСНДС;
					НСтр.СуммаНДС = СуммаНДС;     			
					НСтр.Идентификатор = СтрокаТаблицы.Идентификатор; 
					НСтр.Отправитель = СтрокаТаблицы.Отправитель; 
					НСтр.ИдентификаторОтправителя = СтрокаТаблицы.ИдентификаторОтправителя; 
					
					СтрокаТаблицы.ДанныеДокумента = ДанныеДокумента;
					
				Исключение   
					Продолжить;
				КонецПопытки;
				
			КонецЕсли;                                       		                                      
			
		КонецЦикла;  
		
		Если ТаблицаПоискаДокументов.Количество() > 0 Тогда
			
			Запрос = Новый Запрос;
			//Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	Таблица.НомерВходящегоДокумента,
			|	Таблица.ДатаВходящегоДокумента,
			|	Таблица.СуммаСНДС,
			|	Таблица.СуммаНДС,
			|	Таблица.Идентификатор,
			|	Таблица.Отправитель,
			|	Таблица.ИдентификаторОтправителя
			|ПОМЕСТИТЬ ВТ_Таблица
			|ИЗ
			|	&Таблица КАК Таблица
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ДокументыЭДОТребующиеОбработки.Документ КАК Поступление
			|ПОМЕСТИТЬ ВТ_ПоступленияВРегистре
			|ИЗ
			|	РегистрСведений.ДокументыЭДОТребующиеОбработки КАК ДокументыЭДОТребующиеОбработки
			|ГДЕ
			|	ДокументыЭДОТребующиеОбработки.Документ ССЫЛКА Документ.ПоступлениеТоваровУслуг
			|
			|СГРУППИРОВАТЬ ПО
			|	ДокументыЭДОТребующиеОбработки.Документ
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	Поступление
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ПоступлениеТоваровУслуг.Ссылка КАК Поступление,
			|	ВТ_Таблица.СуммаСНДС,
			|	ВТ_Таблица.СуммаНДС,
			|	ВТ_Таблица.Идентификатор,
			|	ВТ_Таблица.Отправитель,
			|	ВТ_Таблица.НомерВходящегоДокумента,
			|	ВТ_Таблица.ДатаВходящегоДокумента
			|ПОМЕСТИТЬ ВТ_ПоступленияПоТаблице
			|ИЗ
			|	ВТ_Таблица КАК ВТ_Таблица
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
			|		ПО ВТ_Таблица.ДатаВходящегоДокумента = ПоступлениеТоваровУслуг.ДатаВходящегоДокумента
			|			И ВТ_Таблица.ИдентификаторОтправителя = ПоступлениеТоваровУслуг.ДоговорКонтрагента.DS_Подразделение_ID
			|			И (ПоступлениеТоваровУслуг.Проведен)
			|			И (ПоступлениеТоваровУслуг.Организация = &Организация)
			|ГДЕ
			|	НЕ ПоступлениеТоваровУслуг.Ссылка В
			|				(ВЫБРАТЬ
			|					ВТ_ПоступленияВРегистре.Поступление
			|				ИЗ
			|					ВТ_ПоступленияВРегистре)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ПоступлениеТоваровУслугТовары.Ссылка КАК Поступление,
			|	СУММА(ВЫБОР
			|			КОГДА ПоступлениеТоваровУслугТовары.Ссылка.СуммаВключаетНДС
			|				ТОГДА ПоступлениеТоваровУслугТовары.Сумма
			|			ИНАЧЕ ПоступлениеТоваровУслугТовары.Сумма + ПоступлениеТоваровУслугТовары.СуммаНДС
			|		КОНЕЦ) КАК СуммаСНДС,
			|	СУММА(ПоступлениеТоваровУслугТовары.СуммаНДС) КАК СуммаНДС
			|ПОМЕСТИТЬ ВТ_СуммыПоПоступлениям
			|ИЗ
			|	Документ.ПоступлениеТоваровУслуг.Товары КАК ПоступлениеТоваровУслугТовары
			|ГДЕ
			|	ПоступлениеТоваровУслугТовары.Ссылка В
			|			(ВЫБРАТЬ
			|				ВТ_ПоступленияПоТаблице.Поступление
			|			ИЗ
			|				ВТ_ПоступленияПоТаблице)
			|
			|СГРУППИРОВАТЬ ПО
			|	ПоступлениеТоваровУслугТовары.Ссылка
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ЕСТЬNULL(ВТ_СуммыПоПоступлениям.Поступление, НЕОПРЕДЕЛЕНО) КАК Поступление,
			|	ВТ_Таблица.Отправитель,
			|	ВТ_Таблица.Идентификатор,
			|	ВТ_Таблица.СуммаНДС,
			|	ВТ_Таблица.СуммаСНДС,
			|	МАКСИМУМ(ВЫБОР
			|			КОГДА СОКРЛП(ВТ_Таблица.НомерВходящегоДокумента) = СОКРЛП(ВТ_СуммыПоПоступлениям.Поступление.НомерВходящегоДокумента)
			|					И ВТ_СуммыПоПоступлениям.СуммаСНДС = ВТ_Таблица.СуммаСНДС
			|					И ВТ_СуммыПоПоступлениям.СуммаНДС = ВТ_Таблица.СуммаНДС
			|				ТОГДА """"
			|			ИНАЧЕ ""Несоответствие"" + ВЫБОР
			|					КОГДА СОКРЛП(ВТ_Таблица.НомерВходящегоДокумента) <> СОКРЛП(ВТ_СуммыПоПоступлениям.Поступление.НомерВходящегоДокумента)
			|						ТОГДА "" номера входящего документа""
			|					ИНАЧЕ """"
			|				КОНЕЦ + ВЫБОР
			|					КОГДА ВТ_СуммыПоПоступлениям.СуммаСНДС <> ВТ_Таблица.СуммаСНДС
			|						ТОГДА ВЫБОР
			|								КОГДА СОКРЛП(ВТ_Таблица.НомерВходящегоДокумента) <> СОКРЛП(ВТ_СуммыПоПоступлениям.Поступление.НомерВходящегоДокумента)
			|									ТОГДА "" и""
			|								ИНАЧЕ """"
			|							КОНЕЦ + "" суммы документа (Всего с НДС)""
			|					ИНАЧЕ """"
			|				КОНЕЦ + ВЫБОР
			|					КОГДА ВТ_СуммыПоПоступлениям.СуммаНДС <> ВТ_Таблица.СуммаНДС
			|						ТОГДА ВЫБОР
			|								КОГДА СОКРЛП(ВТ_Таблица.НомерВходящегоДокумента) <> СОКРЛП(ВТ_СуммыПоПоступлениям.Поступление.НомерВходящегоДокумента)
			|										ИЛИ ВТ_СуммыПоПоступлениям.СуммаСНДС <> ВТ_Таблица.СуммаСНДС
			|									ТОГДА "" и""
			|								ИНАЧЕ """"
			|							КОНЕЦ + "" суммы НДС""
			|					ИНАЧЕ """"
			|				КОНЕЦ
			|		КОНЕЦ) КАК ТекстОшибки,
			|	ВТ_Таблица.НомерВходящегоДокумента КАК Номер,
			|	ВТ_Таблица.ДатаВходящегоДокумента КАК Дата,
			|	ВЫБОР
			|		КОГДА СОКРЛП(ВТ_Таблица.НомерВходящегоДокумента) = СОКРЛП(ВТ_СуммыПоПоступлениям.Поступление.НомерВходящегоДокумента)
			|				И ВТ_СуммыПоПоступлениям.СуммаСНДС = ВТ_Таблица.СуммаСНДС
			|				И ВТ_СуммыПоПоступлениям.СуммаНДС = ВТ_Таблица.СуммаНДС
			|			ТОГДА 1
			|		КОГДА СОКРЛП(ВТ_Таблица.НомерВходящегоДокумента) = СОКРЛП(ВТ_СуммыПоПоступлениям.Поступление.НомерВходящегоДокумента)
			|				И ВТ_СуммыПоПоступлениям.СуммаСНДС = ВТ_Таблица.СуммаСНДС
			|			ТОГДА 2
			|		КОГДА СОКРЛП(ВТ_Таблица.НомерВходящегоДокумента) = СОКРЛП(ВТ_СуммыПоПоступлениям.Поступление.НомерВходящегоДокумента)
			|			ТОГДА 3
			|		ИНАЧЕ 4
			|	КОНЕЦ КАК Приоритет,
			|	ЕСТЬNULL(ЗапросСтатусыПоПоступлениям.СтатусПриемки, ЗНАЧЕНИЕ(Перечисление.СтатусыПриемки.ПустаяССылка)) КАК СтатусПриемки,
			|	ЕСТЬNULL(ЗапросСтатусыПоПоступлениям.ДокументПодписан, ЛОЖЬ) КАК ДокументПодписан,
			|	ЕСТЬNULL(ЗапросСтатусыПоПоступлениям.ДокументПолучен, ЛОЖЬ) КАК ДокументПолучен
			|ИЗ
			|	ВТ_Таблица КАК ВТ_Таблица
			|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СуммыПоПоступлениям КАК ВТ_СуммыПоПоступлениям
			|			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|				ВТ_СуммыПоПоступлениям.Поступление КАК Поступление,
			|				ЕСТЬNULL(ЗначенияСвойствОбъектов.Значение, ЗНАЧЕНИЕ(Перечисление.СтатусыПриемки.ПустаяССылка)) КАК СтатусПриемки,
			|				ВЫБОР
			|					КОГДА КатегорииОбъектовДокументПодписан.Объект ЕСТЬ NULL
			|						ТОГДА ЛОЖЬ
			|					ИНАЧЕ ИСТИНА
			|				КОНЕЦ КАК ДокументПодписан,
			|				ВЫБОР
			|					КОГДА КатегорииОбъектовДокументПолучен.Объект ЕСТЬ NULL
			|						ТОГДА ЛОЖЬ
			|					ИНАЧЕ ИСТИНА
			|				КОНЕЦ КАК ДокументПолучен
			|			ИЗ
			|				ВТ_СуммыПоПоступлениям КАК ВТ_СуммыПоПоступлениям
			|					ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
			|					ПО ВТ_СуммыПоПоступлениям.Поступление = ЗначенияСвойствОбъектов.Объект
			|						И (ЗначенияСвойствОбъектов.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СвойстваОбъектов.СтатусПриемки))
			|					ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КатегорииОбъектов КАК КатегорииОбъектовДокументПодписан
			|					ПО ВТ_СуммыПоПоступлениям.Поступление = КатегорииОбъектовДокументПодписан.Объект
			|						И (КатегорииОбъектовДокументПодписан.Категория = ЗНАЧЕНИЕ(Справочник.КатегорииОбъектов.ДокументПодписан))
			|					ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КатегорииОбъектов КАК КатегорииОбъектовДокументПолучен
			|					ПО ВТ_СуммыПоПоступлениям.Поступление = КатегорииОбъектовДокументПолучен.Объект
			|						И (КатегорииОбъектовДокументПолучен.Категория = ЗНАЧЕНИЕ(Справочник.КатегорииОбъектов.ДокументПолучен))) КАК ЗапросСтатусыПоПоступлениям
			|			ПО ВТ_СуммыПоПоступлениям.Поступление = ЗапросСтатусыПоПоступлениям.Поступление
			|		ПО (СОКРЛП(ВТ_Таблица.НомерВходящегоДокумента) = СОКРЛП(ВТ_СуммыПоПоступлениям.Поступление.НомерВходящегоДокумента)
			|				ИЛИ ВТ_СуммыПоПоступлениям.СуммаСНДС = ВТ_Таблица.СуммаСНДС
			|				ИЛИ ВТ_СуммыПоПоступлениям.СуммаНДС = ВТ_Таблица.СуммаНДС)
			|			И ВТ_Таблица.ДатаВходящегоДокумента = ВТ_СуммыПоПоступлениям.Поступление.ДатаВходящегоДокумента
			|			И ВТ_Таблица.ИдентификаторОтправителя = ВТ_СуммыПоПоступлениям.Поступление.ДоговорКонтрагента.DS_Подразделение_ID
			|
			|СГРУППИРОВАТЬ ПО
			|	ВТ_Таблица.Отправитель,
			|	ВТ_Таблица.Идентификатор,
			|	ВТ_Таблица.СуммаНДС,
			|	ВТ_Таблица.СуммаСНДС,
			|	ВТ_Таблица.НомерВходящегоДокумента,
			|	ВТ_Таблица.ДатаВходящегоДокумента,
			|	ВЫБОР
			|		КОГДА СОКРЛП(ВТ_Таблица.НомерВходящегоДокумента) = СОКРЛП(ВТ_СуммыПоПоступлениям.Поступление.НомерВходящегоДокумента)
			|				И ВТ_СуммыПоПоступлениям.СуммаСНДС = ВТ_Таблица.СуммаСНДС
			|				И ВТ_СуммыПоПоступлениям.СуммаНДС = ВТ_Таблица.СуммаНДС
			|			ТОГДА 1
			|		КОГДА СОКРЛП(ВТ_Таблица.НомерВходящегоДокумента) = СОКРЛП(ВТ_СуммыПоПоступлениям.Поступление.НомерВходящегоДокумента)
			|				И ВТ_СуммыПоПоступлениям.СуммаСНДС = ВТ_Таблица.СуммаСНДС
			|			ТОГДА 2
			|		КОГДА СОКРЛП(ВТ_Таблица.НомерВходящегоДокумента) = СОКРЛП(ВТ_СуммыПоПоступлениям.Поступление.НомерВходящегоДокумента)
			|			ТОГДА 3
			|		ИНАЧЕ 4
			|	КОНЕЦ,
			|	ЕСТЬNULL(ВТ_СуммыПоПоступлениям.Поступление, НЕОПРЕДЕЛЕНО),
			|	ЕСТЬNULL(ЗапросСтатусыПоПоступлениям.ДокументПодписан, ЛОЖЬ),
			|	ЕСТЬNULL(ЗапросСтатусыПоПоступлениям.ДокументПолучен, ЛОЖЬ),
			|	ЕСТЬNULL(ЗапросСтатусыПоПоступлениям.СтатусПриемки, ЗНАЧЕНИЕ(Перечисление.СтатусыПриемки.ПустаяССылка))
			|
			|УПОРЯДОЧИТЬ ПО
			|	Приоритет";
			
			Запрос.УстановитьПараметр("Таблица", ТаблицаПоискаДокументов); 
			Запрос.УстановитьПараметр("Организация", Константы.ОсновнаяОрганизация.Получить());	
			
			МассивОбработанныхПоступлений = Новый Массив;
			МассивСверенныхИдентификаторов = Новый Массив;
			
			Выборка = Запрос.Выполнить().Выбрать(); 
						
			Пока Выборка.Следующий() Цикл 
				
				ТаблицаДействий = ПолучитьТаблицуДействийНадПоступлением();
				
				Поступление = Выборка.Поступление; 
				
				Если МассивОбработанныхПоступлений.Найти(Поступление) <> Неопределено Тогда
					Продолжить;	
				КонецЕсли;     
				
				Если МассивСверенныхИдентификаторов.Найти(Выборка.Идентификатор) <> Неопределено Тогда
					Продолжить;	
				КонецЕсли;   				
				
				Если Не ЗначениеЗаполнено(Поступление) И (ТекущаяДата() - Выборка.Дата) / 86400 < Константы.КоличествоДнейОжиданияПоступленияЭДО.Получить() Тогда
					
					// не сопоставленные берем после даты из константы
					Продолжить;
					
				ИначеЕсли ЗначениеЗаполнено(Поступление) Тогда
					
					// сопоставленные должны иметь статусы для загрузки	
					Если НЕ ЗначениеЗаполнено(Выборка.СтатусПриемки) 
						ИЛИ Выборка.СтатусПриемки = Перечисления.СтатусыПриемки.ВПути 
						ИЛИ Выборка.ДокументПолучен 
						ИЛИ Выборка.ДокументПодписан Тогда
						
						Продолжить;
					КонецЕсли;
					
				КонецЕсли;
				
				ДанныеДокументаЭДО = Неопределено;
				
				СтрокаТаблицыПоступлений = ТаблицаПоступлений.Найти(Выборка.Идентификатор, "Идентификатор");  
				
				Если СтрокаТаблицыПоступлений <> Неопределено Тогда
					ДанныеДокументаЭДО = СтрокаТаблицыПоступлений.ДанныеДокумента;	
				КонецЕсли;
				
				ТекстОшибки = Выборка.ТекстОшибки;
				
				СтруктураВозврата = ИННПокупателяПоступленияСоответствует(ДанныеДокументаЭДО, Поступление);
				
				Если НЕ СтруктураВозврата.Результат Тогда
					ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "") + СтруктураВозврата.Сообщение;	
				КонецЕсли;
				
				МенеджерЗаписи = РегистрыСведений.ДокументыЭДОТребующиеОбработки.СоздатьМенеджерЗаписи();
				МенеджерЗаписи.Идентификатор = Выборка.Идентификатор;
				МенеджерЗаписи.ВидДокумента = "Поступление";
				МенеджерЗаписи.Дата = ТекущаяДата();                             
				
				ДанныеДокументаСтруктура = Новый Структура("Идентификатор, Номер, Дата, СуммаСНДС, СуммаНДС");
				ЗаполнитьЗначенияСвойств(ДанныеДокументаСтруктура, Выборка);      
				
				МенеджерЗаписи.ДатаВходящегоЭДО = ДанныеДокументаСтруктура.Дата;
				МенеджерЗаписи.НомерВходящегоЭДО = ДанныеДокументаСтруктура.Номер;  
	
				Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
					ВыполнитьДействияНадВходящимДокументом(Поступление, ТаблицаДействий, ДанныеДокументаСтруктура, МодульИнтеграции);
				КонецЕсли;
				
				Если ТаблицаДействий.НайтиСтроки(Новый Структура("Успешно", Ложь)).Количество() = 0 Тогда
					МенеджерЗаписи.Отработан = Истина;
				Иначе     	
					
					Если Не ЗначениеЗаполнено(Поступление) Тогда
						МенеджерЗаписи.ТекстОшибки = "Не найден документ соответствия";	
					ИначеЕсли ЗначениеЗаполнено(ТекстОшибки) Тогда	
						МенеджерЗаписи.ТекстОшибки = ТекстОшибки;	
					Иначе
						
						Для каждого СтрДействие Из ТаблицаДействий Цикл     
							
							Если СтрДействие.Успешно Тогда
								Продолжить;	
							КонецЕсли;
							
							МенеджерЗаписи.ТекстОшибки = СтрДействие.Ошибка;	
							
							Прервать;
							
						КонецЦикла;
						
					КонецЕсли;
					
				КонецЕсли; 
				
				//СтруктураВозврата = КПППокупателяПоступленияСоответствует(ДанныеДокументаЭДО, Поступление);
				//
				//Если НЕ СтруктураВозврата.Результат Тогда
				//	ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "") + СтруктураВозврата.Сообщение;	
				//	МенеджерЗаписи.ТекстОшибки = ТекстОшибки;	
				//КонецЕсли;
				
				МенеджерЗаписи.Документ = Поступление;  
				
				Если ЗначениеЗаполнено(Выборка.Поступление) Тогда 
					
					МенеджерЗаписи.Контрагент = Выборка.Поступление.Контрагент;
					МенеджерЗаписи.Договор = Выборка.Поступление.ДоговорКонтрагента; 
					
				ИначеЕсли ЗначениеЗаполнено(Выборка.Отправитель) Тогда 
					//+Гавриленков В. 15.04.2026 #UT10-5830
					//МенеджерЗаписи.Контрагент = Выборка.Отправитель.Контрагент;
					МенеджерЗаписи.Контрагент = Выборка.Отправитель.Владелец;
					//-Гавриленков В. 15.04.2026 #UT10-5830
				КонецЕсли; 
				
				МенеджерЗаписи.ДанныеДокумента = ЗначениеВСтрокуВнутр(ДанныеДокументаСтруктура);
				МенеджерЗаписи.Действия = ЗначениеВСтрокуВнутр(ТаблицаДействий);
				МенеджерЗаписи.Записать(Истина);      
				
				МассивОбработанныхПоступлений.Добавить(Поступление);   
				МассивСверенныхИдентификаторов.Добавить(Выборка.Идентификатор);
					
			КонецЦикла;         			
			
		КонецЕсли;
				
	КонецЕсли;                                           
	//-Макрушин Е. 17.03.2026 #UT10-5658
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьДействияНадВходящимДокументомИзУправляемойФормы(Документ, ТаблицаДействий, ДанныеДокумента, ВидДокумента = Неопределено) Экспорт
	
	ВыполнитьДействияНадВходящимДокументом(Документ, ТаблицаДействий, ДанныеДокумента,, ВидДокумента);
	
КонецПроцедуры 

&НаСервере
Процедура ВыполнитьДействияНадВходящимДокументом(Документ, ТаблицаДействий, ДанныеДокумента, МодульИнтеграции = Неопределено, ВидДокумента = Неопределено) Экспорт
	
	//+Макрушин Е. 19.03.2026 #UT10-5658
	//+Белов А. 28.09.2026 #UT10-6070 добавил ИЛИ ВидДокумента = "Транспортная накладная" 
	Если ЗначениеЗаполнено(Документ) ИЛИ ВидДокумента = "Транспортная накладная" Тогда 
		
		Для каждого СтрДействия Из ТаблицаДействий Цикл
			
			Если СтрДействия.Успешно Тогда
				Продолжить;				
			КонецЕсли;
			
			Попытка	
				
				Если СтрДействия.Действие = "НайтиСоответствие" Тогда 
					
					//Если передан Документ, то действие автоматически успешное!
					
				ИначеЕсли СтрДействия.Действие = "ПроставитьВходящиеДанные" Тогда				
					
					ОбДокумент = Документ.ПолучитьОбъект();
					ОбДокумент.НомерВходящегоДокумента = ДанныеДокумента.Номер;
					ОбДокумент.ДатаВходящегоДокумента = ДанныеДокумента.Дата;   
					ОбДокумент.ОбменДанными.Загрузка = Истина;			
					ОбДокумент.Записать(); 	  				
					
				ИначеЕсли СтрДействия.Действие = "ПроставитьПризнакПолучен" Тогда	
					
					ПроставитьПризнакПолученУДокумента(Документ);      
					
				//+Белов А. 28.09.2026 #UT10-6070
				ИначеЕсли СтрДействия.Действие = "СоздатьТитул3" Тогда
					
					СтруктураВозврата = ОтправитьВходящийДокументНаПодпись(ДанныеДокумента.Идентификатор, Документы.ТранспортнаяНакладная.ПустаяСсылка(), МодульИнтеграции, ДанныеДокумента);  
					
					Если НЕ СтруктураВозврата.Результат Тогда
						ВызватьИсключение СтруктураВозврата.Сообщение;						
					КонецЕсли;  
				//-Белов А. 28.09.2026 #UT10-6070
					
				ИначеЕсли СтрДействия.Действие = "ПодписатьДокумент" Тогда
					
					СтатусПриемкиПоДокументу = МСКWEB.ЗначениеДопСвойства(Документ, ПланыВидовХарактеристик.СвойстваОбъектов.СтатусПриемки);
					ДокументПолучен = Справочники.КатегорииОбъектов.КатегорияОбъектаУстановлена(Документ, Справочники.КатегорииОбъектов.ДокументПолучен);
					ДокументПодписан = Справочники.КатегорииОбъектов.КатегорияОбъектаУстановлена(Документ, Справочники.КатегорииОбъектов.ДокументПодписан);
					
					Если ТипЗнч(Документ) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") 
						И ЗначениеЗаполнено(СтатусПриемкиПоДокументу) И СтатусПриемкиПоДокументу <> Перечисления.СтатусыПриемки.ВПути
						И ДокументПолучен
						И НЕ ДокументПодписан Тогда
						
						//+Макрушин Е. 02.04.2026 #UT11-5849
						ИнициализированМодульИнтеграции = Ложь;
						//-Макрушин Е. 02.04.2026 #UT11-5849
						
						Если МодульИнтеграции = Неопределено Тогда
			
							Если Константы.ЭДО_ОбновлятьСтатусыПоРезервномуАдресу.Получить() Тогда
								СтруктураВозвратаМодуля = ПолучитьМодульИнтеграции(Истина);                 
							Иначе
								СтруктураВозвратаМодуля = ПолучитьМодульИнтеграции();                 
							КонецЕсли;
							
							Если СтруктураВозвратаМодуля.Результат Тогда
								МодульИнтеграции = СтруктураВозвратаМодуля.МодульИнтеграции;
							Иначе
								
								ТекОшибка = "Не удалось инициировать модуль интеграции DiState при отправке на документа подпись. " + Символы.ПС + СтруктураВозвратаМодуля.Сообщение;
								ЗаписьЖурналаРегистрации("ЭДО.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, ТекОшибка);
								ВызватьИсключение ТекОшибка; 
								
							КонецЕсли;
							
							//+Макрушин Е. 02.04.2026 #UT11-5849
							ИнициализированМодульИнтеграции = Истина;
							//-Макрушин Е. 02.04.2026 #UT11-5849
						КонецЕсли;
						
						СтруктураВозврата = ОтправитьВходящийДокументНаПодпись(ДанныеДокумента.Идентификатор, Документ, МодульИнтеграции);   
						
						//+Макрушин Е. 02.04.2026 #UT11-5849
						Если ИнициализированМодульИнтеграции Тогда
							МодульИнтеграции = Неопределено;
						КонецЕсли;
						//-Макрушин Е. 02.04.2026 #UT11-5849
						
						Если НЕ СтруктураВозврата.Результат Тогда
							ВызватьИсключение СтруктураВозврата.Сообщение;						
						КонецЕсли;
						
					Иначе
						Продолжить;
					КонецЕсли;
					
				ИначеЕсли СтрДействия.Действие = "ПроставитьПризнакВЭлектронномВидеУСчетФактурыПолученной" Тогда
					
					СчетФактура = УчетНДС.НайтиПодчиненныйДокумент(Документ, "СчетФактураПолученный",, Истина);
					
					Если ЗначениеЗаполнено(СчетФактура) Тогда
						
						СчетФактураОбъект = СчетФактура.ПолучитьОбъект();
						СчетФактураОбъект.ОбменДанными.Загрузка = Истина;
						СчетФактураОбъект.КодСпособаПолучения = 2; 						
						СчетФактураОбъект.Записать();
						
					Иначе
						ВызватьИсключение "Не найден СФ полученный по " + Документ;
					КонецЕсли;
					
				КонецЕсли;
				
				СтрДействия.Успешно = Истина;
				СтрДействия.Ошибка = "";
				
			Исключение      
				
				Инфо = ИнформацияОбОшибке();
				
				Если Инфо.Причина <> Неопределено Тогда		
					ТекстОшибки = ОписаниеОшибки();    		
				Иначе		
					ТекстОшибки = Инфо.Описание;		
				КонецЕсли;
					
				СтрДействия.Ошибка = ТекстОшибки;  
				
				Прервать;  
				
			КонецПопытки;    
			
		КонецЦикла;		
				
	КонецЕсли;         
	//-Макрушин Е. 19.03.2026 #UT10-5658
	
КонецПроцедуры  

&НаСервере
Процедура ОбработатьВходящиеТН_Грузополучатель(ТаблицаТН, МодульИнтеграции)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДокументыЭДОТребующиеОбработки.Идентификатор
	|ИЗ
	|	РегистрСведений.ДокументыЭДОТребующиеОбработки КАК ДокументыЭДОТребующиеОбработки
	|ГДЕ
	|	ДокументыЭДОТребующиеОбработки.Идентификатор В(&МассивИдентификаторов)
	|	И ДокументыЭДОТребующиеОбработки.Титул = ""3""";
	
	Запрос.УстановитьПараметр("МассивИдентификаторов", ТаблицаТН.ВыгрузитьКолонку("Идентификатор")); 
	
	Выборка = Запрос.Выполнить().Выбрать();   
	
	Пока Выборка.Следующий() Цикл 
		
		СтрокаПоиска = ТаблицаТН.Найти(Выборка.Идентификатор, "Идентификатор");
		
		Если СтрокаПоиска <> Неопределено Тогда
			ТаблицаТН.Удалить(СтрокаПоиска);
		КонецЕсли;      
			
	КонецЦикла;
	
	Если ТаблицаТН.Количество() > 0 Тогда 
		
		ТаблицаДействий = ПолучитьТаблицуДействийНадТН();
		
		Для каждого Выборка Из ТаблицаТН Цикл
			
			МенеджерЗаписи = РегистрыСведений.ДокументыЭДОТребующиеОбработки.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Идентификатор = Выборка.Идентификатор;
			МенеджерЗаписи.ВидДокумента = "Транспортная накладная";
			МенеджерЗаписи.Дата = ТекущаяДата();                             		
			МенеджерЗаписи.ДатаВходящегоЭДО = Выборка.Дата;
			МенеджерЗаписи.НомерВходящегоЭДО = Выборка.Номер; 
			МенеджерЗаписи.Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выборка.Отправитель, "Владелец");
			МенеджерЗаписи.Договор = Выборка.Отправитель; 
			МенеджерЗаписи.Титул = "3";
			
			ДанныеДокументаСтруктура = ПолучитьДанныеВходящейТН(Выборка.Идентификатор, МодульИнтеграции);
			
			Если Не ЗначениеЗаполнено(МенеджерЗаписи.Договор) Тогда
				МенеджерЗаписи.ТекстОшибки = "Не найден грузоотправитель.";
			КонецЕсли;
			
			МенеджерЗаписи.ДанныеДокумента = ЗначениеВСтрокуВнутр(ДанныеДокументаСтруктура);
			МенеджерЗаписи.Действия = ЗначениеВСтрокуВнутр(ТаблицаДействий);
			МенеджерЗаписи.Записать(Истина);
			
		КонецЦикла;
				
	КонецЕсли;                                           
	
КонецПроцедуры 

&НаСервере
Функция ПолучитьТаблицуДействийНадТН()
	
	ТаблицаДействий = Новый ТаблицаЗначений;
	ТаблицаДействий.Колонки.Добавить("Действие");
	ТаблицаДействий.Колонки.Добавить("ПредставлениеДействия"); 
	ТаблицаДействий.Колонки.Добавить("Ошибка"); 
	ТаблицаДействий.Колонки.Добавить("Успешно", Новый ОписаниеТипов("Булево"));  
	
	НСтр = ТаблицаДействий.Добавить();   
	НСтр.Действие = "СоздатьТитул3";
	НСтр.ПредставлениеДействия = "Создать титул 3 (грузополучателя)";
	
	Возврат ТаблицаДействий;
	
КонецФункции


&НаСервере
Функция ПолучитьДанныеВходящейТН(Знач пИдентификатор, пМодульИнтеграции)

	ТекРезультат = Новый Структура("Идентификатор", пИдентификатор);
	
	ТекКоличествоМест = 0;
	ТекВес = 0;
	ТекСуммаГруза = 0;
	
	ТекСлужебныеДанные = Новый Структура;
	
	ТекСведенияОГрузоотправителе = Неопределено;
	ТекСведенияОПеревозчике = Неопределено;
	ТекСведенияОЗаказчике = Неопределено;
	ТекСведенияАдресДоставки = Неопределено;
	ТекСведенияГруз = Неопределено; 
	ТекСведенияСопрДокументы = Неопределено;
	
	ТекОтвет = пМодульИнтеграции.ЭДО_ПолучитьДанныеДокументаJSON(пИдентификатор);
	
	Если ЗначениеЗаполнено(ТекОтвет.Контент) Тогда
		
		Если ТипЗнч(ТекОтвет.Контент) = Тип("Соответствие") Тогда
			
			Текwaybill = ТекОтвет.Контент.Получить("waybill");
			
			Если ТипЗнч(Текwaybill) = Тип("Соответствие") Тогда
				
				ТекКоличествоМест = Текwaybill.Получить("placesCount");
				
				ТекВес = Текwaybill.Получить("grossWeight");
				
				ТекСуммаГруза = Текwaybill.Получить("cargoValue"); 
				
				ТекСведенияОГрузоотправителе = Текwaybill.Получить("consignor");
				ТекСведенияОПеревозчике = Текwaybill.Получить("carrier");
				ТекСведенияОЗаказчике = Текwaybill.Получить("consignee"); 
				
				ТекСведенияГруз = Текwaybill.Получить("cargo");
				ТекСведенияСопрДокументы = Текwaybill.Получить("accompanyingDocuments");
				
				ТекСведенияАдресДоставки = Новый Структура("АдрТекст, АдрСтруктура", ТекСведенияОЗаказчике.Получить("address"), Неопределено);
								
			КонецЕсли;
		
		КонецЕсли;
		
	КонецЕсли;
	
	ТекРезультат.Вставить("КоличествоМест", ТекКоличествоМест);
	ТекРезультат.Вставить("Вес", ТекВес);
	ТекРезультат.Вставить("СуммаГруза", ТекСуммаГруза);
	
	Если ЗначениеЗаполнено(ТекСведенияАдресДоставки) Тогда                      
		
		Если ТекСведенияАдресДоставки.АдрСтруктура <> Неопределено Тогда
			ТекРезультат.Вставить("АдресДоставки", ТекСведенияАдресДоставки.АдрСтруктура);			
		Иначе
			ТекРезультат.Вставить("АдресДоставки", ТекСведенияАдресДоставки.АдрТекст);		
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекСведенияОГрузоотправителе) Тогда
		
		ТекРезультат.Вставить("ГрузоотправительИНН", ТекСведенияОГрузоотправителе.Получить("inn"));
		ТекРезультат.Вставить("ГрузоотправительНаименование", ТекСведенияОГрузоотправителе.Получить("name"));
		
		Если ЗначениеЗаполнено(ТекСведенияОГрузоотправителе.Получить("kpp")) Тогда
			ТекРезультат.Вставить("ГрузоотправительКПП", ТекСведенияОГрузоотправителе.Получить("kpp"));    
		КонецЕсли;
	
	КонецЕсли;

	Если ЗначениеЗаполнено(ТекСведенияОПеревозчике) Тогда
		
		ТекРезультат.Вставить("ПеревозчикИНН", ТекСведенияОПеревозчике.Получить("inn"));
		ТекРезультат.Вставить("ПеревозчикНаименование", ТекСведенияОПеревозчике.Получить("name"));
		
		Если ЗначениеЗаполнено(ТекСведенияОПеревозчике.Получить("kpp")) Тогда
			ТекРезультат.Вставить("ПеревозчикКПП", ТекСведенияОПеревозчике.Получить("kpp"));	
		КонецЕсли; 	
	
	КонецЕсли;

	Если ЗначениеЗаполнено(ТекСведенияОЗаказчике) Тогда
		
		ТекРезультат.Вставить("ЗаказчикИНН", ТекСведенияОЗаказчике.Получить("inn"));
		ТекРезультат.Вставить("ЗаказчикНаименование", ТекСведенияОЗаказчике.Получить("name"));
		
		Если ЗначениеЗаполнено(ТекСведенияОЗаказчике.Получить("kpp")) Тогда
			ТекРезультат.Вставить("ЗаказчикКПП", ТекСведенияОЗаказчике.Получить("kpp")); 
		КонецЕсли;
	
	КонецЕсли;   
	
	Если ЗначениеЗаполнено(ТекСведенияГруз) Тогда 	
		ТекРезультат.Вставить("Груз", ТекСведенияГруз);	
	КонецЕсли;    
	
	Если ЗначениеЗаполнено(ТекСведенияСопрДокументы) Тогда
		ТекРезультат.Вставить("СопроводительныеДокументы", ТекСведенияСопрДокументы);		
	КонецЕсли;
		
	Возврат ТекРезультат;
	
КонецФункции 

&НаСервере
Функция ИННПокупателяПоступленияСоответствует(ДанныеДокументаЭДО, Документ)
	
	//+Макрушин Е. 19.03.2026 #UT10-5658
	СтруктураВозврата = Новый Структура("Результат, Сообщение", Истина, ""); 
	
	Если ДанныеДокументаЭДО = Неопределено ИЛИ Не ЗначениеЗаполнено(Документ) Тогда
		Возврат СтруктураВозврата;	
	КонецЕсли;
	
	Инвойс = ДанныеДокументаЭДО["invoice"];
	
	Если ТипЗнч(Инвойс) = Тип("Соответствие") Тогда
		
		Покупатели = Инвойс.Получить("buyers");     
		
		Если ТипЗнч(Покупатели) = Тип("Массив") Тогда
			
			Для каждого СтрПокупатель Из Покупатели Цикл 
				
				ИНН = СтрПокупатель.Получить("inn");  
				
				Если ИНН <> Документ.Организация.ИНН Тогда
					
					СтруктураВозврата.Сообщение = "ИНН организации документа не соответствует ИНН покупателя (" + ИНН + ") в УПД";
					СтруктураВозврата.Результат = Ложь;	
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	//-Макрушин Е. 19.03.2026 #UT10-5658
	
КонецФункции

