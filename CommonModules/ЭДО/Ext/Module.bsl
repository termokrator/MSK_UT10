	//|
	//|СГРУППИРОВАТЬ ПО
	//|	ВЫРАЗИТЬ(ИсторияОбменовЭДО.Объект КАК Документ.РеализацияТоваровУслуг)
	//|;
	//|
	//|////////////////////////////////////////////////////////////////////////////////
	//|ВЫБРАТЬ
	//|	ВТ_Реализации.Реализация,
	//|	ВТ_Реализации.Идентификатор
	//|ИЗ
	//|	ВТ_Реализации КАК ВТ_Реализации
	//|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПопыткиАннулирования КАК ВТ_ПопыткиАннулирования
	//|		ПО ВТ_Реализации.Реализация = ВТ_ПопыткиАннулирования.Реализация
	//|ГДЕ
	//|	ВТ_Реализации.Состояние В(&МассивСостояний)
	//|	И ЕСТЬNULL(ВТ_ПопыткиАннулирования.КоличествоПопыток, 0) <= 2"; 
	
	
	"ВЫБРАТЬ
	|	РеализацияТоваровУслуг.Ссылка КАК Документ,
	|	ЕСТЬNULL(Идентификатор.Значение, 0) КАК Идентификатор,
