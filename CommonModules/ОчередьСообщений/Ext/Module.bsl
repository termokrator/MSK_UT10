// Выполняет низкоуровневое соединение с сервером RMQ
//
Процедура УстановитьСоединение(Знач Клиент) Экспорт

	Перем Адрес;
	Перем Порт;
	Перем Логин;
	Перем Пароль;
	Перем ВиртуальныйХост;
	
	ОчередьСообщенийПовтИсп.ПрисвоитьПараметрыАвторизации(
		Адрес,
		Порт,
		Логин,
		Пароль,
		ВиртуальныйХост
	);
	
	ОбработатьУмолчание(Порт,            5672);
	ОбработатьУмолчание(Логин,           "guest");
	ОбработатьУмолчание(Пароль,          "guest");
	ОбработатьУмолчание(ВиртуальныйХост, "/");
	
	Клиент.УстановитьСоединение(Адрес, Логин, Пароль, Порт, ВиртуальныйХост);
	Клиент.НастроитьСоединение();
	
КонецПроцедуры // УстановитьСоединение()

Процедура ОбработатьУмолчание(Значение, Знач Умолчание)

	Если Значение = Неопределено Тогда
		Значение = Умолчание;
	КонецЕсли;

КонецПроцедуры

// Инициализирует объект внешней компоненты
//
Функция СоздатьЭкземплярКомпоненты() Экспорт  
	
	КомпонентаПодключена = ПодключитьВнешнююКомпоненту("ОбщийМакет.V8RMQClient", "V8RMQClient", ТипВнешнейКомпоненты.Native);
	Если Не КомпонентаПодключена Тогда
		ВызватьИсключение НСтр("ru = 'Не удалось подключить внешнюю компоненту V8RMQClient'");
	КонецЕсли;
	
	КлиентСервераОчередей = Обработки.КлиентОчередиСообщений.Создать();
	Возврат КлиентСервераОчередей;

КонецФункции // СоздатьЭкземплярКомпоненты()

// Создает экземпляр компоненты и устанавливает соединение с сервером.
//
Функция ПолучитьЭкземплярКомпоненты() Экспорт

	Компонента = СоздатьЭкземплярКомпоненты();
	УстановитьСоединение(Компонента);
	
	Возврат Компонента;

КонецФункции // ПолучитьЭкземплярКомпоненты()


