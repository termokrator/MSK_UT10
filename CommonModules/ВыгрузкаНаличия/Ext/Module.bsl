
Функция ВыгрузитьВCSV(ИмяФайлаCSV);
	
	Разделитель = Символы.Таб;
	ТаблицаЗначений = ТаблицаНаличие();
	Текст = СоздатьДанныеCSV(ТаблицаЗначений, Разделитель);	 
	ЗаписатьCSV(Текст, ИмяФайлаCSV);
	
КонецФункции

Функция ТаблицаНаличие()
	
	ТабДок = Новый ТаблицаЗначений;
	ТабДок.Колонки.Добавить("Производитель");
	ТабДок.Колонки.Добавить("Артикул"); 
	ТабДок.Колонки.Добавить("НомерПроизводителя");
	ТабДок.Колонки.Добавить("Наименование"); 	
	ТабДок.Колонки.Добавить("ЕдИзмерения");
	ТабДок.Колонки.Добавить("МинимальнаяУп");
	ТабДок.Колонки.Добавить("Колво");
	ТабДок.Колонки.Добавить("Цена");
	
	СкладОсновной  = Константы.ОсновнойСклад.Получить();
	
	Запрос = Новый Запрос;   
	
	Запрос.Текст = "ВЫБРАТЬ
	
	|	ТоварыНаСкладахОстатки.КоличествоОстаток КАК Количество,
	|	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
	|	ТоварыНаСкладахОстатки.Номенклатура.Ссылка КАК НоменклатураСсылка
	|	ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки КАК ТоварыНаСкладахОстатки
	|	ГДЕ
	|	ТоварыНаСкладахОстатки.Склад = &Склад"; 
	
	Запрос.УстановитьПараметр("Склад", СкладОсновной);
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	
	Сч = 0;
	
	Пока Выборка.Следующий() Цикл 
		
		КоличествоВОстатке 	= Число(Выборка.Количество);
		ОстатокВРезерве 	= ПолучитьОстатокВРезерве(Выборка.НоменклатураСсылка, СкладОсновной);	
		Цена 				= ПолучитьЦену(Выборка.НоменклатураСсылка);
		Кратность			= Выборка.Номенклатура.Кратность;
		
		Если Кратность = 0 Тогда
			Кратность = 1;
		КонецЕсли; 
		
		НоваяСтрока = ТабДок.Добавить();
		
		Если ОстатокВРезерве = 0 И Цена <> 0 Тогда
			
			Сч = Сч + 1; 
			
			НоваяСтрока.Производитель 		=   Выборка.Номенклатура.Родитель;
			НоваяСтрока.Артикул 			=   Выборка.Номенклатура.Артикул;                 
			НоваяСтрока.НомерПроизводителя 	=   "'" + Выборка.Номенклатура.КодПроизводителя;
			НоваяСтрока.Наименование 		=   Выборка.Номенклатура;
			НоваяСтрока.ЕдИзмерения 		=   ПолучитьЕденицы(Выборка.Номенклатура);
			НоваяСтрока.МинимальнаяУп 		=   Кратность;
			НоваяСтрока.Колво 				=	КоличествоВОстатке;
			НоваяСтрока.Цена 				=   Цена;
			
		Иначе
			
			Если КоличествоВОстатке - ОстатокВРезерве > 0 И Цена <> 0 Тогда
				
				Сч = Сч + 1;         
				
				НоваяСтрока.Производитель 		=   Выборка.Номенклатура.Родитель;
				НоваяСтрока.Артикул 			=   Выборка.Номенклатура.Артикул;                 
				НоваяСтрока.НомерПроизводителя 	=   "'" + Выборка.Номенклатура.КодПроизводителя;
				НоваяСтрока.Наименование 		=   Выборка.Номенклатура;
				НоваяСтрока.ЕдИзмерения 		=   ПолучитьЕденицы(Выборка.Номенклатура);
				НоваяСтрока.МинимальнаяУп 		=   Кратность;
				НоваяСтрока.Колво 				=	КоличествоВОстатке - ОстатокВРезерве;
				НоваяСтрока.Цена 				=   Цена;      
				
			Иначе
				
				Сч = Сч + 1;
				
				НоваяСтрока.Производитель 		=   Выборка.Номенклатура.Родитель;
				НоваяСтрока.Артикул 			=   Выборка.Номенклатура.Артикул;                 
				НоваяСтрока.НомерПроизводителя 	=   "'" + Выборка.Номенклатура.КодПроизводителя;
				НоваяСтрока.Наименование 		=   Выборка.Номенклатура;
				НоваяСтрока.ЕдИзмерения 		=   ПолучитьЕденицы(Выборка.Номенклатура);
				НоваяСтрока.МинимальнаяУп 		=   Кратность;
				НоваяСтрока.Колво 				=	0;
				НоваяСтрока.Цена 				=   Цена;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТабДок;
	
КонецФункции	

Функция СоздатьДанныеCSV(ТаблицаЗначений, Разделитель)
	
	К = 0;
	Текст = "";
	
	Для каждого запись Из ТаблицаЗначений Цикл
		
		Если Текст = "" Тогда
			Текст = СоздатьЗаголовкиCSV(ТаблицаЗначений, Разделитель) + Символы.ПС;    
		КонецЕсли;    

		К = К + 1; 
		
		Если НЕ ПустаяСтрока(запись.Наименование) Тогда
			
			текст = текст  
			+ запись.Производитель
			+ разделитель + запись.Артикул
			+ разделитель + запись.НомерПроизводителя
			+ разделитель + запись.Наименование
			+ разделитель + запись.ЕдИзмерения
			+ разделитель + запись.МинимальнаяУп  
			+ разделитель + запись.Колво
			+ разделитель + запись.Цена
			+ Символы.ПС; 
			
		КонецЕсли; 
		
	КонецЦикла;

	Возврат Текст;
	
КонецФункции //

Функция СоздатьЗаголовкиCSV(ТаблицаЗначений, Разделитель)

	КолонкиТЗ = ТаблицаЗначений.колонки;
	
	Для каждого Колонка Из КолонкиТЗ Цикл
		стрКолонки = "" + стрКолонки + Колонка.Имя + Разделитель;
	КонецЦикла;
	
	Возврат стрКолонки; 
	
КонецФункции

Функция ЗаписатьCSV(Текст, ИмяФайла)   
	
	Кодировка = КодировкаТекста.ANSI;
	
	ТекстовыйФайлЗапись = Новый ЗаписьТекста(ИмяФайла, Кодировка);            
	ТекстовыйФайлЗапись.ЗаписатьСтроку(Текст); 
	ТекстовыйФайлЗапись.Закрыть(); 
	
	Возврат 0;
	
КонецФункции // ЗаписатьCSV()

Функция ДатаПропись()
		
	Перем Результат; 
	
	Дат = ТекущаяДата();
	Результат = "";
	
	Если ТипЗнч(Дат) = Тип("Дата") Тогда
		
		Результат = Формат(Дат, "ДФ=""дд_ММ_гг' 'ЧЧ'-'мм""");
		Результат = ("portal_" + Результат); 
		
	КонецЕсли;  
	
	Возврат Результат 
	
КонецФункции

Функция ПолучитьЦену(Номенклатура)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЦеныНоменклатуры.Период КАК Период,
	|	ЦеныНоменклатуры.Цена КАК Цена,
	|	ЦеныНоменклатуры.Валюта КАК Валюта
	|	ИЗ
	|	РегистрСведений.ЦеныНоменклатуры КАК ЦеныНоменклатуры
	|	ГДЕ
	|	ЦеныНоменклатуры.Номенклатура = &Номенклатура
	|  УПОРЯДОЧИТЬ ПО
	|  ЦеныНоменклатуры.Регистратор.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	
	Выборка.Следующий();
	
	Если Результат.Пустой() Тогда
		Возврат 0;
	Иначе
		Возврат Выборка.Цена;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьОстатокВРезерве(Номенклатура,Склад)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.Текст = "ВЫБРАТЬ
	|	ВЫРАЗИТЬ ((ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток) КАК ЧИСЛО(15,2)) КАК  КоличествоРезерв
	|	ИЗ
	|	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки КАК ТоварыВРезервеНаСкладахОстатки
	|	ГДЕ
	|	ТоварыВРезервеНаСкладахОстатки.Номенклатура.Ссылка = &Номенклатура И
	|	ТоварыВРезервеНаСкладахОстатки.Склад = &Склад";
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	
	Выборка.Следующий();
	
	Если Результат.Пустой() Тогда
		Возврат 0;
	Иначе
		Возврат Выборка.КоличествоРезерв;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьЕденицы(Номенклатура)
	
	Запрос = Новый Запрос;	
	Запрос.Текст = " ВЫБРАТЬ
	|	ЕдиницыИзмерения.Наименование как Наименование
	|	ИЗ
	|	Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	|	ГДЕ
	|	ЕдиницыИзмерения.Владелец = &Владелец";
	Запрос.УстановитьПараметр("Владелец", Номенклатура);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Выборка.Следующий();
	
	Если Результат.Пустой() Тогда
		Возврат 1;
	Иначе
		Возврат Выборка.Наименование;
	КонецЕсли;
	
КонецФункции 

