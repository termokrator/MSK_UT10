	|	БуферАРМКладовшикаПеремещение.ЯчейкаОткуда,
	|	БуферАРМКладовшикаПеремещение.ЯчейкаКуда
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ОборотыМеждуЯчейками.Количество, 0) КАК КоличествоПеремещено,
	|	ЕСТЬNULL(ВТОстаткиЯчейкиОткуда.КоличествоОстаток, 0) КАК КоличествоОстаток,
	|	ЕСТЬNULL(БуферАРМПеремещ.Quantity, 0) КАК КоличествоНабрано
	|ИЗ
	|	ОборотыМеждуЯчейками КАК ОборотыМеждуЯчейками
	|		ПОЛНОЕ СОЕДИНЕНИЕ ВТОстаткиЯчейкиОткуда КАК ВТОстаткиЯчейкиОткуда
	|			ПОЛНОЕ СОЕДИНЕНИЕ БуферАРМПеремещ КАК БуферАРМПеремещ
	|			ПО (ИСТИНА)
	|		ПО (ИСТИНА)";
	
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);	
	
	ЯчейкаОткуда = Справочники.Ячейки.ПолучитьСсылку( Новый УникальныйИдентификатор(FromCellIdGUID));
	ЯчейкаКуда = Справочники.Ячейки.ПолучитьСсылку( Новый УникальныйИдентификатор(WhereCellIdGUID));
	
	Запрос.УстановитьПараметр("UserIdСсылка", UserIdСсылка);
	Запрос.УстановитьПараметр("ЯчейкаОткуда", ЯчейкаОткуда);
	Запрос.УстановитьПараметр("ЯчейкаКуда", ЯчейкаКуда);
	Запрос.УстановитьПараметр("ДатаНачала", Новый Граница(ТекущаяДата() - 60 * 30, ВидГраницы.Включая)); 
	Запрос.УстановитьПараметр("ДатаКонца", Новый Граница(ТекущаяДата(), ВидГраницы.Включая));
	
	УстановитьПривилегированныйРежим(Истина);
	ТЗ = Запрос.Выполнить().Выгрузить();	
	УстановитьПривилегированныйРежим(Ложь);
	
	//Возврат Сериализовать(ТЗ);
	МассивВременный = ТаблицуВМассив(ТЗ);
	Результат = ДанныеВJSONХранилище(МассивВременный);
	
	ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Получить описание для перемещения между ячейками", 
	"ЯчейкаОткуда -> " + ЯчейкаОткуда.Код + " ЯчейкаКуда -> " + ЯчейкаКуда.Код + "; КоличествоПеремещено, КоличествоОстаток, КоличествоНабрано "); 	
	
	Возврат Результат;
	
КонецФункции

