	|	Справочник.ФизическиеЛица КАК ФизическиеЛица
	|ГДЕ
	|	ФизическиеЛица.Код ПОДОБНО &Код
	|	И ФизическиеЛица.АРМКладовщика";
		
	Запрос.УстановитьПараметр("Код", "%" + ЗначениеДляПоиска);
	РезультатЗапроса = Запрос.Выполнить().Выбрать();   
	
	Если РезультатЗапроса.Количество() = 0  Тогда
		
		ДанныеОтвета.Вставить("Ошибка", "Данный пользователь не имеет прав доступа.");	
		Результат = ДанныеВJSONХранилище(ДанныеОтвета);	
		Возврат Результат;     
		
	КонецЕсли; 
	
	РезультатЗапроса.Следующий();
	ДанныеОтвета.Вставить("Пользователь"                  , РезультатЗапроса.Код);
	ДанныеОтвета.Вставить("ПолноеИмя"                     , РезультатЗапроса.Наименование);		
	ДанныеОтвета.Вставить("ПользовательГУИД"              , XMLСтрока(РезультатЗапроса.Ссылка));		
	
	Результат = ДанныеВJSONХранилище(ДанныеОтвета);
	
	ЗаписатьЛог(РезультатЗапроса.Ссылка, ТекущаяДата(), "", "Find user", "Barcode " + Barcode + "; password " + РезультатЗапроса.Ссылка.Наименование);
	Возврат Результат;  
	//-Шульман А. 28.11.2025 #UT10-5548
	
КонецФункции                              


Функция ПолучитьИнформациюПоПользователю(UserIdGUID, Password) Экспорт
	
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);	
	
	Password = СокрЛП(Password);
	ЗначениеДляПоиска = Формат(Число(Password), "ЧЦ=5; ЧВН=; ЧГ=0");
	
	Запрос = Новый Запрос;                                                                 
	Запрос.Текст = 	
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ФизическиеЛица.Ссылка КАК ФизическоеЛицоГУИД,
	|	ПОДСТРОКА(ФизическиеЛица.Код, 5, 5) КАК Код,
	|	ФизическиеЛица.Наименование,
	|	ФизическиеЛица.АРМКладовщика,
	|	Пользователи.Должность
	|ИЗ
	|	Справочник.ФизическиеЛица КАК ФизическиеЛица
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
	|		ПО ФизическиеЛица.Ссылка = Пользователи.ФизЛицо
	|ГДЕ
	|	ФизическиеЛица.Код ПОДОБНО &Код
	|	И ФизическиеЛица.АРМКладовщика";   
	
	Запрос.УстановитьПараметр("Код", "%" + ЗначениеДляПоиска);
	
	УстановитьПривилегированныйРежим(Истина);
	ТЗ = Запрос.Выполнить().Выгрузить();                          
	УстановитьПривилегированныйРежим(Истина);
	
	МассивВременный = ТаблицуВМассив(ТЗ);
	Результат = ДанныеВJSONХранилище(МассивВременный);
	УстановитьПривилегированныйРежим(Ложь);	
	
	ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Получить информацию о физическом лице", ЗначениеДляПоиска); 
	
	Возврат Результат;                                                             	
	
КонецФункции

Функция ВыгрузитьДанныеИзРСвЗаданиеНаИнвентаризацию(UserIdGUID, DocumentGUID, Cells, DeleteRecordsFromBuffer) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Ошибка", "");
	
	МассивЯчеек = СериализаторXDTO.ПрочитатьXDTO(Cells);
	
	МассивЯчеекСсылок = Новый Массив;   
	
	Для каждого Элемент Из МассивЯчеек Цикл
		МассивЯчеекСсылок.Добавить(Справочники.Ячейки.ПолучитьСсылку(Новый УникальныйИдентификатор(Элемент)));
	КонецЦикла; 
	
	ДокументСсылка = Документы.ЗаданиеНаИнвентаризацию.ПолучитьСсылку(Новый УникальныйИдентификатор(DocumentGUID));
	ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
	
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);
	
	НачатьТранзакцию();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	БуферАРМКладовщикаИнвентПоЯчейкам.Объект,
	|	БуферАРМКладовщикаИнвентПоЯчейкам.UserId,
	|	БуферАРМКладовщикаИнвентПоЯчейкам.Номенклатура КАК Номенклатура,
	|	БуферАРМКладовщикаИнвентПоЯчейкам.Ячейка КАК Ячейка,
	|	МАКСИМУМ(БуферАРМКладовщикаИнвентПоЯчейкам.ВведеноВРучную) КАК ВведеноВРучную,
	|	СпрНоменклатура.КодПроизводителя КАК КодПроизводителя,
	|	МАКСИМУМ(ЕдиницыИзмерения.Коэффициент) КАК ЕдХранОстатковКоэффициент,
	|	МАКСИМУМ(СпрНоменклатура.Родитель.Наименование) КАК Производитель,
	|	СУММА(БуферАРМКладовщикаИнвентПоЯчейкам.Quantity) КАК КоличествоФакт,
	|	КОЛИЧЕСТВО(БуферАРМКладовщикаИнвентПоЯчейкам.Номенклатура) КАК КоличествоСтрок
	|ПОМЕСТИТЬ РегСведВТ
	|ИЗ
	|	РегистрСведений.БуферАРМКладовщикаИнвентПоЯчейкам КАК БуферАРМКладовщикаИнвентПоЯчейкам
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	|			ПО СпрНоменклатура.Ссылка = ЕдиницыИзмерения.Владелец
	|				И СпрНоменклатура.ЕдиницаХраненияОстатков = ЕдиницыИзмерения.Ссылка
	|		ПО БуферАРМКладовщикаИнвентПоЯчейкам.Номенклатура = СпрНоменклатура.Ссылка
	|ГДЕ
	|	БуферАРМКладовщикаИнвентПоЯчейкам.Объект = &Объект
	|	И БуферАРМКладовщикаИнвентПоЯчейкам.UserId = &UserId
	|
	|СГРУППИРОВАТЬ ПО
	|	БуферАРМКладовщикаИнвентПоЯчейкам.Объект,
	|	БуферАРМКладовщикаИнвентПоЯчейкам.UserId,
	|	БуферАРМКладовщикаИнвентПоЯчейкам.Номенклатура,
	|	БуферАРМКладовщикаИнвентПоЯчейкам.Ячейка,
	|	СпрНоменклатура.КодПроизводителя
	|
	|ДЛЯ ИЗМЕНЕНИЯ
	|	РегистрСведений.БуферАРМКладовщикаИнвентПоЯчейкам
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	Ячейка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыВЯчейкахОстатки.Номенклатура КАК Номенклатура,
	|	ТоварыВЯчейкахОстатки.КоличествоОстаток КАК КоличествоУчетное,
	|	ТоварыВЯчейкахОстатки.Ячейка КАК Ячейка,
	|	ЕдиницыИзмерения.Коэффициент КАК ЕдХранОстатковКоэффициент,
	|	СпрНоменклатура.Родитель.Наименование КАК Производитель,
	|	СпрНоменклатура.КодПроизводителя
	|ПОМЕСТИТЬ ОстаткиВТ
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Остатки(
	|			,
	|			Ячейка В (&МассивЯчеек)
	|				И Склад = &Склад) КАК ТоварыВЯчейкахОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	|			ПО СпрНоменклатура.Ссылка = ЕдиницыИзмерения.Владелец
	|				И СпрНоменклатура.ЕдиницаХраненияОстатков = ЕдиницыИзмерения.Ссылка
	|		ПО ТоварыВЯчейкахОстатки.Номенклатура = СпрНоменклатура.Ссылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	Ячейка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаданНаИнвентовары.Ссылка,
	|	ЗаданНаИнвентовары.Уровень,
	|	ЗаданНаИнвентовары.Номенклатура,
	|	ЗаданНаИнвентовары.Ячейка,
	|	ЗаданНаИнвентовары.КодПроизводителя,
	|	ЗаданНаИнвентовары.Производитель,
	|	ЕдиницыИзмерения.Коэффициент КАК ЕдХранОстатковКоэффициент
	|ПОМЕСТИТЬ ВТТаблЧастьТовары
	|ИЗ
	|	Документ.ЗаданиеНаИнвентаризацию.Товары КАК ЗаданНаИнвентовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	|			ПО СпрНоменклатура.Ссылка = ЕдиницыИзмерения.Владелец
	|				И СпрНоменклатура.ЕдиницаХраненияОстатков = ЕдиницыИзмерения.Ссылка
	|		ПО ЗаданНаИнвентовары.Номенклатура = СпрНоменклатура.Ссылка
	|ГДЕ
	|	ЗаданНаИнвентовары.Ссылка = &Объект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ОстаткиВТ.Номенклатура, РегСведВТ.Номенклатура) КАК Номенклатура,
	|	ЕСТЬNULL(ОстаткиВТ.Ячейка, РегСведВТ.Ячейка) КАК Ячейка,
	|	ЕСТЬNULL(ОстаткиВТ.КоличествоУчетное, 0) КАК КоличествоУчетное,
	|	ЕСТЬNULL(РегСведВТ.КоличествоФакт, 0) КАК КоличествоФакт,
	|	ЕСТЬNULL(РегСведВТ.КоличествоСтрок, 0) КАК КоличествоСтрок,
	|	ЕСТЬNULL(РегСведВТ.ВведеноВРучную, 0) КАК ВведеноВРучную,
	|	ЕСТЬNULL(РегСведВТ.ЕдХранОстатковКоэффициент, ОстаткиВТ.ЕдХранОстатковКоэффициент) КАК ЕдХранОстатковКоэффициент,
	|	ЕСТЬNULL(РегСведВТ.Производитель, ОстаткиВТ.Производитель) КАК Производитель,
	|	ЕСТЬNULL(РегСведВТ.КодПроизводителя, ОстаткиВТ.КодПроизводителя) КАК КодПроизводителя
	|ПОМЕСТИТЬ ВТИтогИнвент
	|ИЗ
	|	РегСведВТ КАК РегСведВТ
	|		ПОЛНОЕ СОЕДИНЕНИЕ ОстаткиВТ КАК ОстаткиВТ
	|		ПО РегСведВТ.Номенклатура = ОстаткиВТ.Номенклатура
	|			И РегСведВТ.Ячейка = ОстаткиВТ.Ячейка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ВТИтогИнвент.Номенклатура, ВТТаблЧастьТовары.Номенклатура) КАК Номенклатура,
	|	ЕСТЬNULL(ВТИтогИнвент.Ячейка, ВТТаблЧастьТовары.Ячейка) КАК Ячейка,
	|	ЕСТЬNULL(ВТИтогИнвент.КоличествоУчетное, 0) КАК КоличествоУчетное,
	|	ЕСТЬNULL(ВТИтогИнвент.КоличествоФакт, 0) КАК КоличествоФакт,
	|	ЕСТЬNULL(ВТИтогИнвент.КоличествоСтрок, 0) КАК КоличествоСтрок,
	|	ЕСТЬNULL(ВТИтогИнвент.ВведеноВРучную, 0) КАК ВведеноВРучную,
	|	ЕСТЬNULL(ВТИтогИнвент.ЕдХранОстатковКоэффициент, ВТТаблЧастьТовары.ЕдХранОстатковКоэффициент) КАК ЕдХранОстатковКоэффициент,
	|	ЕСТЬNULL(ВТИтогИнвент.Производитель, ВТТаблЧастьТовары.Производитель) КАК Производитель,
	|	ЕСТЬNULL(ВТИтогИнвент.КодПроизводителя, ВТТаблЧастьТовары.КодПроизводителя) КАК КодПроизводителя,
	|	ЕСТЬNULL(ВТТаблЧастьТовары.Уровень, 0) КАК Уровень
	|ПОМЕСТИТЬ ВТПредварРезультат
	|ИЗ
	|	ВТИтогИнвент КАК ВТИтогИнвент
	|		ПОЛНОЕ СОЕДИНЕНИЕ ВТТаблЧастьТовары КАК ВТТаблЧастьТовары
	|		ПО ВТИтогИнвент.Номенклатура = ВТТаблЧастьТовары.Номенклатура
	|			И ВТИтогИнвент.Ячейка = ВТТаблЧастьТовары.Ячейка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТПредварРезультат.Номенклатура,
	|	СУММА(ВТПредварРезультат.КоличествоФакт) КАК КоличествоФакт,
	|	СУММА(ВТПредварРезультат.КоличествоУчетное) КАК КоличествоУчетное,
	|	СУММА(ВТПредварРезультат.КоличествоФакт - ВТПредварРезультат.КоличествоУчетное) КАК РасхождениеПоКоличеству,
	|	СУММА(ВЫБОР
	|			КОГДА ВТПредварРезультат.КоличествоФакт > ВТПредварРезультат.КоличествоУчетное
	|				ТОГДА ВТПредварРезультат.КоличествоФакт - ВТПредварРезультат.КоличествоУчетное
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК НедостатокПоУчету,
	|	СУММА(ВЫБОР
	|			КОГДА ВТПредварРезультат.КоличествоФакт < ВТПредварРезультат.КоличествоУчетное
	|				ТОГДА ВТПредварРезультат.КоличествоФакт - ВТПредварРезультат.КоличествоУчетное
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК НедостатокПоФакту,
	|	МАКСИМУМ(ВТПредварРезультат.Уровень) КАК Уровень
	|ПОМЕСТИТЬ ВТИтогИнвентГруппир
	|ИЗ
	|	ВТПредварРезультат КАК ВТПредварРезультат
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТПредварРезультат.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТПредварРезультат.Номенклатура,
	|	ВТПредварРезультат.Ячейка,
	|	ВТПредварРезультат.КоличествоУчетное,
	|	ВТПредварРезультат.КоличествоФакт,
	|	ВТПредварРезультат.КоличествоСтрок,
	|	ВТПредварРезультат.ВведеноВРучную,
	|	ВТПредварРезультат.ЕдХранОстатковКоэффициент,
	|	ВТПредварРезультат.Производитель,
	|	ВТПредварРезультат.КодПроизводителя,
	|	ВТИтогИнвентГруппир.РасхождениеПоКоличеству,
	|	ISNULL(ВТИтогИнвентГруппир.Уровень, ВТПредварРезультат.Уровень) КАК Уровень
	|ИЗ
	|	ВТПредварРезультат КАК ВТПредварРезультат
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТИтогИнвентГруппир КАК ВТИтогИнвентГруппир
	|		ПО ВТПредварРезультат.Номенклатура = ВТИтогИнвентГруппир.Номенклатура";
	
	Запрос.УстановитьПараметр("UserId", UserIdСсылка);
	Запрос.УстановитьПараметр("Объект", ДокументСсылка);
	Запрос.УстановитьПараметр("МассивЯчеек", МассивЯчеекСсылок);
	Запрос.УстановитьПараметр("Склад", Константы.ОсновнойСклад.Получить());
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Количество() = 0  Тогда	
		
		ОтменитьТранзакцию();
		
		ТекстОшибки = "Отсутствуют проинвентаризируемые и учетные товары в ячейках.";				
		Результат.Вставить("Ошибка", ТекстОшибки);
		Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
		Возврат Результат;
		
	КонецЕсли;	                              
	
	ЕстьНеНулевоеОтклонение = Ложь; 
	
	Попытка
		
		ДокументОбъект.АРМКладовщика = Истина;
		ДокументОбъект.ДатаВыполнения = ТекущаяДата();
		ДокументОбъект.Комментарий = ДокументОбъект.Комментарий + " ТСД; ";
		
		ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Загружены данные из РС (БуферАРМКладовщикаИнвентПоЯчейкам) в документ задание на инвентаризацию", 
		Строка(ДокументОбъект.Номер)); 
		
		// Очищаем табличную часть товары, и заливаем данные с учетом текущих остатков		
		ДокументОбъект.Товары.Очистить();
		
		Пока РезультатЗапроса.Следующий() Цикл
			
			Товар = ДокументОбъект.Товары.Добавить();	
			ЗаполнитьЗначенияСвойств(Товар, РезультатЗапроса);  
			
			Если Товар.КоличествоФакт = 0 И РезультатЗапроса.КоличествоСтрок > 0 Тогда	
				
				Товар.КоличествоФакт = РезультатЗапроса.КоличествоСтрок * РезультатЗапроса.ЕдХранОстатковКоэффициент;
				ТекстОшибки = "ЗаданиеНаИнвентаризацию "+ ДокументСсылка + " Товар " + Товар.Номенклатура + " строк " + Строка(РезультатЗапроса.КоличествоСтрок) +
				" коэфф " + Строка(РезультатЗапроса.ЕдХранОстатковКоэффициент);
				ЗаписьЖурналаРегистрации("Android нулевое количество товара", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки); 		
				
			КонецЕсли; 
			
			Товар.ВведеноВручную = РезультатЗапроса.ВведеноВРучную;
			Товар.Отклонение = Товар.КоличествоФакт - Товар.КоличествоУчетное;

			Если РезультатЗапроса.РасхождениеПоКоличеству <> 0 Тогда
				Товар.РасхождениеНоменклатуры = Истина;
			КонецЕсли; 
			
			Если Товар.Отклонение <> 0 Тогда
				ЕстьНеНулевоеОтклонение = Истина;				
			КонецЕсли; 
			
			Если Товар.Уровень = 0 Тогда
				Товар.Уровень = 1;
			КонецЕсли; 
			
		КонецЦикла; 
		
		Попытка
			
			Если ЕстьНеНулевоеОтклонение И Не ДокументОбъект.РегламентноеЗадание Тогда		
				ДокументОбъект.ОтклонениеПоКоличеству = Истина;
			КонецЕсли;
			
			ДокументОбъект.Записать();						
			ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Записан документ задание на инвентаризацию", Строка(ДокументОбъект.Номер)); 
			
			Попытка				
				
				ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);								
				УстановитьБлокирокуЯчеек(DocumentGUID, Cells, Ложь, UserIdGUID);				
				ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Документ задание на инвентаризацию проведен", Строка(ДокументОбъект.Номер)); 
				
				Если DeleteRecordsFromBuffer = Истина Тогда
					
					РС = РегистрыСведений.БуферАРМКладовщикаИнвентПоЯчейкам.СоздатьНаборЗаписей();
					РС.Отбор.Объект.Установить(ДокументСсылка);
					РС.Отбор.UserId.Установить(UserIdСсылка);
					РС.Записать();
					
				КонецЕсли; 
				
				//===========================================================================================
				//===========================================================================================
				Если ЕстьНеНулевоеОтклонение Тогда		
					
					ЕстьОшибки = Ложь;
					НомерИнвент = Строка(ДокументОбъект.Ссылка);                              
					
					ТекстОшибки = СоздатьПеремещениеТовараДляСтрокСпризнакомРасхождениеНоменкатуры(ДокументОбъект.Ссылка);
					
					Если ЗначениеЗаполнено(ТекстОшибки) Тогда						
						
						ТекстОшибки = "Невозможно создать перемещ. факт.кол-во больше факта (РасхожденияПоНоменклатуре), " + ТекстОшибки;
						ЗаписьЖурналаРегистрации("Ошибка", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки); 												
						ЕстьОшибки = Истина;
						
					КонецЕсли; 
					
					ТекстОшибки = СоздатьПеремещениеТовараДляСтрокВторогоУровня(ДокументОбъект.Ссылка);
					
					Если ЗначениеЗаполнено(ТекстОшибки) Тогда						
						
						ТекстОшибки = "Невозможно создать перемещ.учет.кол-во больше факта, " + ТекстОшибки;
						ЗаписьЖурналаРегистрации("Ошибка", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки); 												
						ЕстьОшибки = Истина;
						
					КонецЕсли; 
					
					Если Не ЕстьОшибки  Тогда
						
						ТекстОшибки = СоздатьРазмещениеТовараДляСтрокВторогоУровня(ДокументОбъект.Ссылка);
						
						Если ЗначениеЗаполнено(ТекстОшибки) Тогда						
							
							ТекстОшибки = "Невозможно создать перемещ. факт.кол-во больше плана, " + ТекстОшибки;
							ЗаписьЖурналаРегистрации("Ошибка", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки); 												
							ЕстьОшибки = Истина;
							
						КонецЕсли; 											
						
					КонецЕсли; 
					
					Если Не ЕстьОшибки  Тогда						
						
						ТекстОшибки = ПроанализироватьСтрокиСРасхождениемДляОсновныхЯчеек(ДокументОбъект.Ссылка);									
						
						Если ЗначениеЗаполнено(ТекстОшибки) Тогда																						
							
							ТекстОшибки = "Невозможно создать задан на инвент для основ.ячеек, " + ТекстОшибки;
							ЗаписьЖурналаРегистрации("Ошибка", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки); 																		
							ЕстьОшибки = Истина;
							
						КонецЕсли;                                                      						
						
					КонецЕсли;
					
					Если ЗначениеЗаполнено(ТекстОшибки) Тогда						
						
						ОтменитьТранзакцию();			
						Результат.Вставить("Ошибка", ТекстОшибки);
						Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
						Возврат Результат;				
						
					КонецЕсли;
					
				КонецЕсли;
				//===========================================================================================
				//===========================================================================================
				
				ЗафиксироватьТранзакцию();
				
			Исключение	
				
				ОтменитьТранзакцию();
				
				ТекстОшибки = "Документ """ + ДокументОбъект.Ссылка + """ успешно записан в базу 1С, но не проведен.";				
				Результат.Вставить("Ошибка", ТекстОшибки);
				Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
				Возврат Результат;				
				
			КонецПопытки; 
			
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстОшибки = "Ошибка при записи документа в 1С: " + ОписаниеОшибки()+".";				
			Результат.Вставить("Ошибка", ТекстОшибки);
			Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
			Возврат Результат;
			
		КонецПопытки;           
		
		Результат.Вставить("Ошибка", "");
		Результат.Вставить("НомерДокумента", ДокументОбъект.Номер);
		Результат.Вставить("ДатаДокумента", ДокументОбъект.Дата);
		Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
		Возврат Результат;
		
	Исключение
		
		//ОтменитьТранзакцию();
		
		СтруктураОшибки = Новый Структура;
		СтруктураОшибки.Вставить("Ошибка", ОписаниеОшибки()); 
		Результат = ARMStoreKeeper.ДанныеВJSONХранилище(СтруктураОшибки);
		Возврат Результат;
		
	КонецПопытки;                                
	
КонецФункции

Функция СоздатьПеремещениеТовараДляСтрокСпризнакомРасхождениеНоменкатуры(ЗаданиеСсылка) Экспорт
	
	ЗаданиеОбъект = ЗаданиеСсылка.ПолучитьОбъект();	
	
	Если НЕ ЗаданиеОбъект.АРМКладовщика Или НЕ ЗначениеЗаполнено(ЗаданиеОбъект.ДатаВыполнения) Тогда
		Возврат "";
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ЗаданиеОбъект.ДокумПеремФактБольшеПланаРасхожНомен) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПеремещениеТовараПоЯчейкам.Ссылка КАК Ссылка,
		|	ПеремещениеТовараПоЯчейкам.Проведен
		|ИЗ
		|	Документ.ПеремещениеТовараПоЯчейкам КАК ПеремещениеТовараПоЯчейкам
		|ГДЕ
		|	ПеремещениеТовараПоЯчейкам.Ссылка = &Ссылка
		|	И ПеремещениеТовараПоЯчейкам.ДокументОснование = &ДокументОснование
		|	И ПеремещениеТовараПоЯчейкам.Проведен
		|
		|УПОРЯДОЧИТЬ ПО
		|	Ссылка УБЫВ
		|АВТОУПОРЯДОЧИВАНИЕ";                            
		
		Запрос.УстановитьПараметр("Ссылка", ЗаданиеОбъект.ДокумПеремФактБольшеПланаРасхожНомен);
		Запрос.УстановитьПараметр("ДокументОснование", ЗаданиеОбъект.Ссылка);
		РезультатЗапроса = Запрос.Выполнить().Выбрать();
		
		Если РезультатЗапроса.Количество() > 0 Тогда
			Возврат "";
		КонецЕсли; 				 
		
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаданиеНаИнвентаризациюТовары.Ссылка,
	|	ЗаданиеНаИнвентаризациюТовары.Номенклатура КАК Номенклатура,
	|	ЗаданиеНаИнвентаризациюТовары.Ячейка,
	|	ЗаданиеНаИнвентаризациюТовары.КоличествоФакт КАК КоличествоФакт,
	|	ЗаданиеНаИнвентаризациюТовары.КоличествоУчетное КАК КоличествоУчетное,
	|	ЗаданиеНаИнвентаризациюТовары.РасхождениеНоменклатуры
	|ИЗ
	|	Документ.ЗаданиеНаИнвентаризацию.Товары КАК ЗаданиеНаИнвентаризациюТовары
	|ГДЕ
	|	ЗаданиеНаИнвентаризациюТовары.Ссылка = &Ссылка
	|	И НЕ ЗаданиеНаИнвентаризациюТовары.РасхождениеНоменклатуры
	|	И ЗаданиеНаИнвентаризациюТовары.КоличествоФакт > ЗаданиеНаИнвентаризациюТовары.КоличествоУчетное
	|
	|УПОРЯДОЧИТЬ ПО
	|	КоличествоФакт УБЫВ";
	Запрос.УстановитьПараметр("Ссылка", ЗаданиеСсылка);
	
	ТоварыДляПеремещенияВячейки = Новый ТаблицаЗначений;
	ТоварыДляПеремещенияВячейки.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТоварыДляПеремещенияВячейки.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	ТоварыДляПеремещенияВячейки.Колонки.Добавить("ЯчейкаОткуда", Новый ОписаниеТипов("СправочникСсылка.Ячейки"));
	ТоварыДляПеремещенияВячейки.Колонки.Добавить("ЯчейкаКуда", Новый ОписаниеТипов("СправочникСсылка.Ячейки"));
	
	РезультатГлавный = Запрос.Выполнить().Выбрать();
	
	НоменклатураПоиск = "";
	ЯчейкаОткуда = "";
	КоличествоДляПередачи = 0;
	
	Пока РезультатГлавный.Следующий() Цикл
		
		НедостающееКоличествоПоУчету = РезультатГлавный.КоличествоФакт - РезультатГлавный.КоличествоУчетное;
		
		Если НоменклатураПоиск <> РезультатГлавный.Номенклатура Тогда
			
			НоменклатураПоиск = РезультатГлавный.Номенклатура;
			
			Запрос_2 = Новый Запрос;
			Запрос_2.Текст = 
			"ВЫБРАТЬ
			|	ЗаданиеНаИнвентаризациюТовары.Ссылка,
			|	ЗаданиеНаИнвентаризациюТовары.Номенклатура КАК Номенклатура,
			|	ЗаданиеНаИнвентаризациюТовары.Ячейка,
			|	ЗаданиеНаИнвентаризациюТовары.КоличествоФакт КАК КоличествоФакт,
			|	ЗаданиеНаИнвентаризациюТовары.КоличествоУчетное КАК КоличествоУчетное,
			|	ЗаданиеНаИнвентаризациюТовары.РасхождениеНоменклатуры
			|ИЗ
			|	Документ.ЗаданиеНаИнвентаризацию.Товары КАК ЗаданиеНаИнвентаризациюТовары
			|ГДЕ
			|	ЗаданиеНаИнвентаризациюТовары.Ссылка = &Ссылка
			|	И ЗаданиеНаИнвентаризациюТовары.Номенклатура = &Номенклатура
			|	И НЕ ЗаданиеНаИнвентаризациюТовары.РасхождениеНоменклатуры
			|	И ЗаданиеНаИнвентаризациюТовары.КоличествоФакт < ЗаданиеНаИнвентаризациюТовары.КоличествоУчетное
			|
			|УПОРЯДОЧИТЬ ПО
			|	КоличествоФакт УБЫВ";
			
			Запрос_2.УстановитьПараметр("Ссылка", ЗаданиеСсылка);
			Запрос_2.УстановитьПараметр("Номенклатура", НоменклатураПоиск);
			
			РезультатПодчиненый = Запрос_2.Выполнить().Выбрать();     
			РезультатПодчиненый.Следующий();
			
			ЯчейкаОткуда = РезультатПодчиненый.Ячейка;
			КоличествоДляПередачи = РезультатПодчиненый.КоличествоУчетное - РезультатПодчиненый.КоличествоФакт;
			
		КонецЕсли; 				
		
		Пока КоличествоДляПередачи > 0 Цикл
			
			СтрокаТЗ = ТоварыДляПеремещенияВячейки.Добавить();
			СтрокаТЗ.Номенклатура = РезультатГлавный.Номенклатура;
			СтрокаТЗ.ЯчейкаКуда = РезультатГлавный.Ячейка;
			
			Если КоличествоДляПередачи < НедостающееКоличествоПоУчету Тогда
				
				НедостающееКоличествоПоУчету = НедостающееКоличествоПоУчету - КоличествоДляПередачи;
				СтрокаТЗ.Количество = КоличествоДляПередачи;				
				СтрокаТЗ.ЯчейкаОткуда = ЯчейкаОткуда;
				КоличествоДляПередачи = 0;
				
			ИначеЕсли КоличествоДляПередачи >= НедостающееКоличествоПоУчету Тогда
				
				КоличествоДляПередачи = КоличествоДляПередачи - НедостающееКоличествоПоУчету;
				СтрокаТЗ.Количество = НедостающееКоличествоПоУчету;
				СтрокаТЗ.ЯчейкаОткуда = ЯчейкаОткуда;
				НедостающееКоличествоПоУчету = 0
				
			КонецЕсли; 
			
			Если НедостающееКоличествоПоУчету = 0 И КоличествоДляПередачи = 0 Тогда
				Прервать;
			КонецЕсли; 
			
			Если НедостающееКоличествоПоУчету > 0  И КоличествоДляПередачи = 0 Тогда
				
				Если РезультатПодчиненый.Следующий() Тогда				
					
					ЯчейкаОткуда = РезультатПодчиненый.Ячейка;
					КоличествоДляПередачи = РезультатПодчиненый.КоличествоУчетное - РезультатПодчиненый.КоличествоФакт;					
					Продолжить;
					
				Иначе
					Прервать;
				КонецЕсли; 				
				
			КонецЕсли; 
			
			Если НедостающееКоличествоПоУчету = 0 И КоличествоДляПередачи > 0 Тогда					 			
				Прервать;
			КонецЕсли; 
			
		КонецЦикла; 
		
	КонецЦикла; 
	
	Если ТоварыДляПеремещенияВячейки.Количество() > 0 Тогда
		
		ДокументОбъект = Неопределено;
		
		// Шапка документа	
		ДокументПеремещения = Документы.ПеремещениеТовараПоЯчейкам.СоздатьДокумент();
		ДокументПеремещения.Клеверенс = Ложь;        
		ДокументПеремещения.Ответственный = ЗаданиеОбъект.Ответственный;
		ДокументПеремещения.Дата        = ТекущаяДата();		
		ДокументПеремещения.Склад       = Константы.ОсновнойСклад.Получить();
		ДокументПеремещения.ДокументОснование = ЗаданиеОбъект.Ссылка;
		
		ЗаписатьЛог(ЗаданиеОбъект.Ответственный, ТекущаяДата(), "", "Создан  документ перемещ.товара между ячейками для строк расхождения уровня 1 (РасхождениеНоменклатуры(ГруппаПоНоменклатуре) = 0) ", Строка(ДокументПеремещения.Номер)); 
		
		СписокЯчеек = "";
		
		Для каждого Строка Из ТоварыДляПеремещенияВячейки Цикл		
			
			Товар = ДокументПеремещения.Товары.Добавить();	
			Товар.Номенклатура   = Строка.Номенклатура;		
			Товар.Количество     = Строка.Количество; 
			Товар.КоличествоПереместить   = Товар.Количество; 
			Товар.Ячейка         = Строка.ЯчейкаОткуда;
			Товар.ЯчейкаКуда     = Строка.ЯчейкаКуда;
			
			СписокЯчеек = СписокЯчеек + Строка.ЯчейкаКуда + ";";
			
		КонецЦикла;                                                        
		
		КомментарийТекст = "Создан для строк расхождения уровня 1 (РасхождениеНоменклатуры(ГруппаПоНоменклатуре) = 0) " + ЗаданиеОбъект.Ссылка + "; " + СписокЯчеек;
		ДокументПеремещения.Комментарий = КомментарийТекст;
		
		ТекстОшибки = "";
		
		Попытка
			
			ДокументПеремещения.Записать(РежимЗаписиДокумента.Запись);
			
			Попытка
				ДокументПеремещения.Записать(РежимЗаписиДокумента.Проведение);					
			Исключение
				
				ТекстОшибки = ОписаниеОшибки(); 
				Возврат ТекстОшибки;
				
			КонецПопытки;                          
			
			ЗаданиеОбъект.ДокумПеремФактБольшеПланаРасхожНомен = ДокументПеремещения.Ссылка;
			ЗаданиеОбъект.Записать();			
			ЗаписатьЛог(ЗаданиеОбъект.Ответственный, ТекущаяДата(), "", "Записан документ перемещения товара по ячейкам, на основ. строк расхождения (РасхождениеНоменклатуры(ГруппаПоНоменклатуре) = 0)", Строка(ДокументПеремещения.Номер)); 													
			
		Исключение
			
			ТекстОшибки = "Ошибка при записи документа перемещ.товара по ячейкам (РасхождениеНоменклатуры(ГруппаПоНоменклатуре) = 0) в 1С: " + ОписаниеОшибки()+".";
			Возврат ТекстОшибки;
			
		КонецПопытки; 		
		
	КонецЕсли; 
	
	Возврат "";
	
КонецФункции

Функция ПроанализироватьСтрокиСРасхождениемДляОсновныхЯчеек(ЗаданиеСсылка) Экспорт
	
	ЗаданиеОбъект = ЗаданиеСсылка.ПолучитьОбъект(); 
	
	Если НЕ ЗаданиеОбъект.АРМКладовщика Или НЕ ЗначениеЗаполнено(ЗаданиеОбъект.ДатаВыполнения) Тогда
		Возврат "";
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗаданиеНаИнвентаризациюТовары.Ссылка,
	|	ЗаданиеНаИнвентаризациюТовары.Номенклатура,
	|	ЗаданиеНаИнвентаризациюТовары.Ячейка КАК ЯчейкаИсходная,
	|	ЗаданиеНаИнвентаризациюТовары.Отклонение,
	|	ВЫБОР
	|		КОГДА ЗаданиеНаИнвентаризациюТовары.Уровень = 1
	|			ТОГДА 2
	|		ИНАЧЕ ЗаданиеНаИнвентаризациюТовары.Уровень
	|	КОНЕЦ КАК Уровень
	|ИЗ
	|	Документ.ЗаданиеНаИнвентаризацию.Товары КАК ЗаданиеНаИнвентаризациюТовары
	|ГДЕ
	|	ЗаданиеНаИнвентаризациюТовары.Ссылка = &Ссылка
	|	И ЗаданиеНаИнвентаризациюТовары.Уровень = 1 
	|	И ЗаданиеНаИнвентаризациюТовары.Отклонение <> 0
	|	И ЗаданиеНаИнвентаризациюТовары.РасхождениеНоменклатуры = Истина";
	
	Запрос.УстановитьПараметр("Ссылка", ЗаданиеОбъект.Ссылка);
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Количество() = 0 Тогда
		Возврат "";	
	КонецЕсли; 
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаданиеНаИнвентаризациюТовары.Ссылка,
	|	ЗаданиеНаИнвентаризациюТовары.Номенклатура,
	|	ЗаданиеНаИнвентаризациюТовары.Ячейка КАК ЯчейкаИсходная,
	|	ЗаданиеНаИнвентаризациюТовары.Отклонение,
	|	ВЫБОР
	|		КОГДА ЗаданиеНаИнвентаризациюТовары.Уровень = 1
	|			ТОГДА 2
	|		ИНАЧЕ ЗаданиеНаИнвентаризациюТовары.Уровень
	|	КОНЕЦ КАК Уровень
	|ПОМЕСТИТЬ ВТРасхожден
	|ИЗ
	|	Документ.ЗаданиеНаИнвентаризацию.Товары КАК ЗаданиеНаИнвентаризациюТовары
	|ГДЕ
	|	ЗаданиеНаИнвентаризациюТовары.Ссылка = &Ссылка
	|	И ЗаданиеНаИнвентаризациюТовары.Уровень = 1
	|	И ЗаданиеНаИнвентаризациюТовары.Отклонение <> 0
	|	И ЗаданиеНаИнвентаризациюТовары.РасхождениеНоменклатуры = Истина
	|
	|ДЛЯ ИЗМЕНЕНИЯ
	|	Документ.ЗаданиеНаИнвентаризацию
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	// Выбираем ячейки относящиеся к полке указанной в реквизите документа
	|ВЫБРАТЬ
	|	Ячейки.Ссылка КАК ЯчейкаИсходная
	|ПОМЕСТИТЬ ВТЯчейкиИсходные
	|ИЗ
	|	Справочник.Ячейки КАК Ячейки
	|
	|ГДЕ 
	|  Ячейки.Полка = &Полка
	|  И НЕ Ячейки.НеУчитыватьВОперативномУчете
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТРасхожден.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(ТоварыВЯчейкахОстатки.Ячейка, ЗНАЧЕНИЕ(Справочник.Ячейки.ПустаяСсылка)) КАК Ячейка,
	|	ВТРасхожден.Уровень,
	|	ВТРасхожден.ЯчейкаИсходная
	|ПОМЕСТИТЬ ВТТоварСЯчейками
	|ИЗ
	|	ВТРасхожден КАК ВТРасхожден
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках.Остатки(
	|				,
	|				Номенклатура В
	|						(ВЫБРАТЬ
	|							А.Номенклатура
	|						ИЗ
	|							ВТРасхожден КАК А)
	|					И Ячейка В
	|						(ВЫБРАТЬ
	|							Ячейки.Ссылка
	|						ИЗ
	|							Справочник.Ячейки КАК Ячейки
	|						ГДЕ
	|							НЕ Ячейки.НеУчитыватьВОперативномУчете)) КАК ТоварыВЯчейкахОстатки
	|		ПО ВТРасхожден.Номенклатура = ТоварыВЯчейкахОстатки.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТТоварСЯчейками.ЯчейкаИсходная КАК ЯчейкаИсходная,
	|	ВТТоварСЯчейками.Номенклатура КАК Номенклатура,
	|	МАКСИМУМ(ВТТоварСЯчейками.Уровень) КАК Уровень,
	|	МАКСИМУМ(ЕСТЬNULL(Инвентаризация.Регистратор, ЗНАЧЕНИЕ(Документ.ЗаданиеНаИнвентаризацию.ПустаяСсылка))) КАК Документ
	|ПОМЕСТИТЬ ВТДокумДляИсходЯчейки
	|ИЗ
	|	ВТТоварСЯчейками КАК ВТТоварСЯчейками
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Инвентаризация КАК Инвентаризация
	|		ПО ВТТоварСЯчейками.ЯчейкаИсходная = Инвентаризация.Ячейка
	|			И (Инвентаризация.ДатаСоздания > &Дата)
	|			И (Инвентаризация.ДатаЗавершения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
	|			И (НЕ Инвентаризация.РегламентноеЗадание)
	|			И (Инвентаризация.Регистратор <> &Ссылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТТоварСЯчейками.ЯчейкаИсходная,
	|	ВТТоварСЯчейками.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыВЯчейкахОстатки.Номенклатура КАК Номенклатура,
	|	ТоварыВЯчейкахОстатки.Ячейка КАК ЯчейкаИсходная,
	|	МАКСИМУМ(1) КАК Уровень,
	|	МАКСИМУМ(ЕСТЬNULL(Инвентаризация.Регистратор, ЗНАЧЕНИЕ(Документ.ЗаданиеНаИнвентаризацию.ПустаяСсылка))) КАК Документ
	|ПОМЕСТИТЬ ВТНоменклатураСостаткамиПоЯчейкамиОсновным
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Остатки(
	|			,
	|			Ячейка В
	|				(ВЫБРАТЬ
	|					ВТЯчейкиИсходные.ЯчейкаИсходная
	|				ИЗ
	|					ВТЯчейкиИсходные КАК ВТЯчейкиИсходные)) КАК ТоварыВЯчейкахОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Инвентаризация КАК Инвентаризация
	|		ПО ТоварыВЯчейкахОстатки.Ячейка = Инвентаризация.Ячейка
	|			И (Инвентаризация.ДатаСоздания > &Дата)
	|			И (Инвентаризация.ДатаЗавершения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
	|			И (НЕ Инвентаризация.РегламентноеЗадание)
	|			И (Инвентаризация.Регистратор <> &Ссылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыВЯчейкахОстатки.Номенклатура,
	|	ТоварыВЯчейкахОстатки.Ячейка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТДокумДляИсходЯчейки.Номенклатура,
	|	ВТДокумДляИсходЯчейки.ЯчейкаИсходная,
	|	ВТДокумДляИсходЯчейки.Уровень,
	|	ВТДокумДляИсходЯчейки.Документ
	|ИЗ
	|	ВТДокумДляИсходЯчейки КАК ВТДокумДляИсходЯчейки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТНоменклатураСостаткамиПоЯчейкамиОсновным.Номенклатура,
	|	ВТНоменклатураСостаткамиПоЯчейкамиОсновным.ЯчейкаИсходная КАК ЯчейкаИсходная,
	|	МАКСИМУМ(ВТНоменклатураСостаткамиПоЯчейкамиОсновным.Уровень) КАК Уровень,
	|	МАКСИМУМ(ВТНоменклатураСостаткамиПоЯчейкамиОсновным.Документ) КАК Документ,
	|	МАКСИМУМ(СпрНоменклатура.КодПроизводителя) КАК КодПроизводителя,
	|	МАКСИМУМ(СпрНоменклатура.Родитель.Наименование) КАК Производитель
	|ПОМЕСТИТЬ ВТБезТаблЧастиДокум
	|ИЗ
	|	ВТНоменклатураСостаткамиПоЯчейкамиОсновным КАК ВТНоменклатураСостаткамиПоЯчейкамиОсновным
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО ВТНоменклатураСостаткамиПоЯчейкамиОсновным.Номенклатура = СпрНоменклатура.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТНоменклатураСостаткамиПоЯчейкамиОсновным.Номенклатура,
	|	ВТНоменклатураСостаткамиПоЯчейкамиОсновным.ЯчейкаИсходная
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаданНаИнвенТов.Ссылка,
	|	ЗаданНаИнвенТов.Номенклатура,
	|	МАКСИМУМ(ЗаданНаИнвенТов.КодПроизводителя) КАК КодПроизводителя,
	|	МАКСИМУМ(ЗаданНаИнвенТов.Производитель) КАК Производитель,
	|	МАКСИМУМ(ЗаданНаИнвенТов.Ячейка) КАК Ячейка,
	|	МАКСИМУМ(ЗаданНаИнвенТов.Уровень) КАК Уровень,
	|	ЗаданНаИнвенТов.ДокументИсточник
	|ПОМЕСТИТЬ ВТТаблЧастиДокум
	|ИЗ
	|	ВТДокумДляИсходЯчейки КАК ВТДокумДляИсходЯчейки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаданиеНаИнвентаризацию.Товары КАК ЗаданНаИнвенТов
	|		ПО ВТДокумДляИсходЯчейки.Документ = ЗаданНаИнвенТов.Ссылка
	|
	|ГДЕ
	|	ЗаданНаИнвенТов.РасхождениеНоменклатуры = Истина
	|СГРУППИРОВАТЬ ПО
	|	ЗаданНаИнвенТов.Ссылка,
	|	ЗаданНаИнвенТов.Номенклатура,
	|	ЗаданНаИнвенТов.ДокументИсточник
	|
	|ДЛЯ ИЗМЕНЕНИЯ
	|	Документ.ЗаданиеНаИнвентаризацию
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ВТБезТаблЧастиДокум.Номенклатура, ВТТаблЧастиДокум.Номенклатура) КАК Номенклатура,
	|	ЕСТЬNULL(ВТБезТаблЧастиДокум.ЯчейкаИсходная, ВТТаблЧастиДокум.Ячейка) КАК Ячейка,
	|	&Полка КАК Полка, 
	|	ЕСТЬNULL(ВТБезТаблЧастиДокум.Уровень, 0) КАК Уровень,
	|	ЕСТЬNULL(ВТБезТаблЧастиДокум.Документ, ЗНАЧЕНИЕ(Документ.ЗаданиеНаИнвентаризацию.ПустаяСсылка)) КАК Документ,
	|	ЕСТЬNULL(ВТБезТаблЧастиДокум.КодПроизводителя, ВТТаблЧастиДокум.КодПроизводителя) КАК КодПроизводителя,
	|	ЕСТЬNULL(ВТБезТаблЧастиДокум.Производитель, ВТТаблЧастиДокум.Производитель) КАК Производитель,
	|	ЕСТЬNULL(ВТТаблЧастиДокум.Уровень, 0) КАК УровеньВТабЧастиДокумента,
	|	ВЫБОР
	|		КОГДА ВТТаблЧастиДокум.Номенклатура ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьНоменклатураВДокументе,
	|	ЕСТЬNULL(ВТТаблЧастиДокум.ДокументИсточник, ЗНАЧЕНИЕ(Документ.ЗаданиеНаИнвентаризацию.ПустаяСсылка)) КАК ДокументИсточник
	|ИЗ
	|	ВТБезТаблЧастиДокум КАК ВТБезТаблЧастиДокум
	|		ПОЛНОЕ СОЕДИНЕНИЕ ВТТаблЧастиДокум КАК ВТТаблЧастиДокум
	|		ПО ВТБезТаблЧастиДокум.Документ = ВТТаблЧастиДокум.Ссылка
	|			И ВТБезТаблЧастиДокум.Номенклатура = ВТТаблЧастиДокум.Номенклатура
	|			И ВТБезТаблЧастиДокум.ЯчейкаИсходная = ВТТаблЧастиДокум.Ячейка
	|ГДЕ
	|	ЕСТЬNULL(ВТБезТаблЧастиДокум.ЯчейкаИсходная, ВТТаблЧастиДокум.Ячейка) <> &ЯчейкаНедостачаПриИнвентаризации
	|ИТОГИ
	|	МАКСИМУМ(Документ)
	|ПО
	|	&Полка";	
	
	Запрос.УстановитьПараметр("Ссылка", ЗаданиеОбъект.Ссылка);
	Запрос.УстановитьПараметр("Дата", Константы.ДатаИнвентаризацииПоследнейЯчейки.Получить());
	Запрос.УстановитьПараметр("ЯчейкаНедостачаПриИнвентаризации",  Константы.НедостачаПриИнвентаризации.Получить());
	Запрос.УстановитьПараметр("Полка", ЗаданиеОбъект.Полка);
	
	// Создаем или update documents для ячеек, где были расхождения
	ВыборкаПолки = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ДокументОбъект = Неопределено;
	
	Пока ВыборкаПолки.Следующий() Цикл
		
		ДокументСсылка = ВыборкаПолки.Документ;
		
		Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
			
			ДокументОбъект = Документы.ЗаданиеНаИнвентаризацию.СоздатьДокумент();
			ДокументОбъект.Дата = ТекущаяДата();
			ДокументОбъект.Склад = ЗаданиеОбъект.Склад;
			ДокументОбъект.ДокументОснование = ЗаданиеОбъект.Ссылка;
			ДокументОбъект.ПолкаВторичная = ВыборкаПолки.Полка;
			ДокументОбъект.Полка = ВыборкаПолки.Полка;
			ДокументОбъект.Комментарий = "Источник-> " + Строка(ЗаданиеОбъект.Номер) + " " + Строка(ЗаданиеОбъект.Дата)+ "; ";   				
			
		Иначе
			ДокументОбъект = ДокументСсылка.ПолучитьОбъект();		
		КонецЕсли;                                  
		
		ДокументОбъект.Товары.Очистить();
		ВыборкаНоменклатуры = ВыборкаПолки.Выбрать();		
		
		ЗначениеЯчейки = "";
		
		Пока ВыборкаНоменклатуры.Следующий() Цикл
			
			Если ДокументОбъект.ЭтоНовый() И ЗначениеЯчейки <> ВыборкаНоменклатуры.Ячейка Тогда

				ЕстьЯчейкаВТЧ = ДокументОбъект.ИнвентаризируемыеЯчейки.Найти(ВыборкаНоменклатуры.Ячейка,"ЯчейкаДляИнвентаризации") ;
				
				Если ЕстьЯчейкаВТЧ = Неопределено Тогда
					
					СтрокаЯчейка = ДокументОбъект.ИнвентаризируемыеЯчейки.Добавить();
					СтрокаЯчейка.ЯчейкаДляИнвентаризации = ВыборкаНоменклатуры.Ячейка;
					ЗначениеЯчейки = ВыборкаНоменклатуры.Ячейка;
					
				КонецЕсли;
				
			КонецЕсли; 
			
			Товар = ДокументОбъект.Товары.Добавить();	
			ЗаполнитьЗначенияСвойств(Товар, ВыборкаНоменклатуры);
			
			Если Не ДокументОбъект.ЭтоНовый() Тогда
				
				Если Товар.Уровень = 2 Тогда
					Продолжить;
				КонецЕсли; 
				
				Если ВыборкаНоменклатуры.ЕстьНоменклатураВДокументе И ВыборкаНоменклатуры.УровеньВТабЧастиДокумента = 2 Тогда
					Товар.Уровень = ВыборкаНоменклатуры.УровеньВТабЧастиДокумента;
				КонецЕсли; 				
				
				Если ВыборкаНоменклатуры.ЕстьНоменклатураВДокументе И ВыборкаНоменклатуры.УровеньВТабЧастиДокумента = 1   
					И ВыборкаНоменклатуры.Уровень = 2 Тогда
					
					Товар.Уровень = ВыборкаНоменклатуры.Уровень;
					Товар.ДокументИсточник = ЗаданиеОбъект.Ссылка;
					
				КонецЕсли; 
				
			Иначе				
				Товар.Уровень = 2; 
			КонецЕсли; 
			
		КонецЦикла; 
		
		Попытка
			
			ДокументОбъект.Записать();	
			
			Попытка
				ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);						
			Исключение
				
				ТекстОшибки = ОписаниеОшибки();			
				Возврат ТекстОшибки;
				
			КонецПопытки;
			
		Исключение
			
			ТекстОшибки = "Ошибка при записи документа Задания на инвент в 1С: " + ОписаниеОшибки() + ".";
			Возврат ТекстОшибки;
			
		КонецПопытки;				
		
	КонецЦикла;  
	
	ТекстОшибки = ПроанализироватьСтрокиСРасхождениемДляДополнЯчеек(ЗаданиеСсылка);
	Возврат ТекстОшибки;
	
КонецФункции

Функция ПроанализироватьСтрокиСРасхождениемДляДополнЯчеек(ЗаданиеСсылка)
	
	ЗаданиеОбъект = ЗаданиеСсылка.ПолучитьОбъект();
	
	Если НЕ ЗаданиеОбъект.АРМКладовщика Или НЕ ЗначениеЗаполнено(ЗаданиеОбъект.ДатаВыполнения) Тогда
		Возврат "";
	КонецЕсли; 
	
	Запрос = Новый Запрос;                                         
	
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗаданиеНаИнвентаризациюТовары.Ссылка,
	|	ЗаданиеНаИнвентаризациюТовары.Номенклатура,
	|	ЗаданиеНаИнвентаризациюТовары.Ячейка КАК ЯчейкаИсходная,
	|	ЗаданиеНаИнвентаризациюТовары.Отклонение,
	|	ВЫБОР
	|		КОГДА ЗаданиеНаИнвентаризациюТовары.Уровень = 1
	|			ТОГДА 2
	|		ИНАЧЕ ЗаданиеНаИнвентаризациюТовары.Уровень
	|	КОНЕЦ КАК Уровень
	|ИЗ
	|	Документ.ЗаданиеНаИнвентаризацию.Товары КАК ЗаданиеНаИнвентаризациюТовары
	|ГДЕ
	|	ЗаданиеНаИнвентаризациюТовары.Ссылка = &Ссылка
	|	И ЗаданиеНаИнвентаризациюТовары.Уровень = 1
	|	И ЗаданиеНаИнвентаризациюТовары.Отклонение <> 0
	|	И ЗаданиеНаИнвентаризациюТовары.РасхождениеНоменклатуры = ИСТИНА";
	
	Запрос.УстановитьПараметр("Ссылка", ЗаданиеОбъект.Ссылка);	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Количество() = 0 Тогда
		Возврат "";	
	КонецЕсли; 
	
	Запрос.Текст = 	
	"ВЫБРАТЬ
	|	ЗаданиеНаИнвентаризациюТовары.Ссылка,
	|	ЗаданиеНаИнвентаризациюТовары.Номенклатура,
	|	ЗаданиеНаИнвентаризациюТовары.Ячейка КАК ЯчейкаИсходная,
	|	ЗаданиеНаИнвентаризациюТовары.Отклонение,
	|	ВЫБОР
	|		КОГДА ЗаданиеНаИнвентаризациюТовары.Уровень = 1
	|			ТОГДА 2
	|		ИНАЧЕ ЗаданиеНаИнвентаризациюТовары.Уровень
	|	КОНЕЦ КАК Уровень
	|ПОМЕСТИТЬ ВТРасхожден
	|ИЗ
	|	Документ.ЗаданиеНаИнвентаризацию.Товары КАК ЗаданиеНаИнвентаризациюТовары
	|ГДЕ
	|	ЗаданиеНаИнвентаризациюТовары.Ссылка = &Ссылка
	|	И ЗаданиеНаИнвентаризациюТовары.Уровень = 1
	|	И ЗаданиеНаИнвентаризациюТовары.Отклонение <> 0
	|	И ЗаданиеНаИнвентаризациюТовары.РасхождениеНоменклатуры = ИСТИНА
	|
	|ДЛЯ ИЗМЕНЕНИЯ
	|	Документ.ЗаданиеНаИнвентаризацию
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Ячейки.Ссылка КАК ЯчейкаИсходная
	|ПОМЕСТИТЬ ВТЯчейкиИсходные
	|ИЗ
	|	Справочник.Ячейки КАК Ячейки
	|ГДЕ
	|	Ячейки.Полка = &Полка
	|	И НЕ Ячейки.НеУчитыватьВОперативномУчете
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТРасхожден.Номенклатура КАК Номенклатура,
	|	ВТРасхожден.Уровень,
	|	ЕСТЬNULL(ТоварыВЯчейкахОстатки.Ячейка, ЗНАЧЕНИЕ(Справочник.Ячейки.ПустаяСсылка)) КАК Ячейка,
	|	ВЫБОР
	|		КОГДА ТоварыВЯчейкахОстатки.Ячейка ЕСТЬ НЕ NULL 
	|			ТОГДА ТоварыВЯчейкахОстатки.Ячейка.Полка
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК Полка
	|ПОМЕСТИТЬ ВТТоварСЯчейками
	|ИЗ
	|	ВТРасхожден КАК ВТРасхожден
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках.Остатки(
	|				,
	|				Номенклатура В
	|						(ВЫБРАТЬ
	|							А.Номенклатура
	|						ИЗ
	|							ВТРасхожден КАК А)
	|					И Ячейка В
	|						(ВЫБРАТЬ
	|							Ячейки.Ссылка
	|						ИЗ
	|							Справочник.Ячейки КАК Ячейки
	|						ГДЕ
	|							НЕ Ячейки.НеУчитыватьВОперативномУчете)
	|					И НЕ Ячейка В
	|							(ВЫБРАТЬ
	|								ВТЯчейкиИсходные.ЯчейкаИсходная
	|							ИЗ
	|								ВТЯчейкиИсходные КАК ВТЯчейкиИсходные)) КАК ТоварыВЯчейкахОстатки
	|		ПО ВТРасхожден.Номенклатура = ТоварыВЯчейкахОстатки.Номенклатура
	|ГДЕ
	|	ТоварыВЯчейкахОстатки.Ячейка ЕСТЬ НЕ NULL 
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Ячейки.Ссылка КАК Ячейка,
	|	Ячейки.Полка КАК Полка
	|ПОМЕСТИТЬ ВТПолкиДополнит
	|ИЗ
	|	Справочник.Ячейки КАК Ячейки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТТоварСЯчейками КАК ВТТоварСЯчейками
	|		ПО Ячейки.Полка = ВТТоварСЯчейками.Полка
	|
	|СГРУППИРОВАТЬ ПО
	|	Ячейки.Ссылка,
	|	Ячейки.Полка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТТоварСЯчейками.Ячейка КАК Ячейка,
	|	ВТТоварСЯчейками.Номенклатура КАК Номенклатура,
	|	МАКСИМУМ(ВТТоварСЯчейками.Уровень) КАК Уровень,
	|	МАКСИМУМ(ЕСТЬNULL(Инвентаризация_1.Регистратор, ЗНАЧЕНИЕ(Документ.ЗаданиеНаИнвентаризацию.ПустаяСсылка))) КАК ЗавершДокумент,
	|	МАКСИМУМ(ЕСТЬNULL(Инвентаризация_2.Регистратор, ЗНАЧЕНИЕ(Документ.ЗаданиеНаИнвентаризацию.ПустаяСсылка))) КАК НеЗавершДокумент
	|ПОМЕСТИТЬ ВТДокумДляЯчейкиДополн
	|ИЗ
	|	ВТТоварСЯчейками КАК ВТТоварСЯчейками
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Инвентаризация КАК Инвентаризация_1
	|		ПО ВТТоварСЯчейками.Ячейка = Инвентаризация_1.Ячейка
	|			И (Инвентаризация_1.ДатаСоздания > &Дата)
	|			И (Инвентаризация_1.ДатаЗавершения <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
	|			И (Инвентаризация_1.Регистратор <> &Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Инвентаризация КАК Инвентаризация_2
	|		ПО ВТТоварСЯчейками.Ячейка = Инвентаризация_2.Ячейка
	|			И (Инвентаризация_2.ДатаСоздания > &Дата)
	|			И (Инвентаризация_2.ДатаЗавершения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
	|			И (Инвентаризация_2.Регистратор <> &Ссылка)
	|			И (НЕ Инвентаризация_2.РегламентноеЗадание)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТТоварСЯчейками.Ячейка,
	|	ВТТоварСЯчейками.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыВЯчейкахОстатки.Номенклатура КАК Номенклатура,
	|	ТоварыВЯчейкахОстатки.Ячейка КАК Ячейка,
	|	МАКСИМУМ(1) КАК Уровень,
	|	МАКСИМУМ(ЕСТЬNULL(Инвентаризация_1.Регистратор, ЗНАЧЕНИЕ(Документ.ЗаданиеНаИнвентаризацию.ПустаяСсылка))) КАК ЗавершДокумент,
	|	МАКСИМУМ(ЕСТЬNULL(Инвентаризация_2.Регистратор, ЗНАЧЕНИЕ(Документ.ЗаданиеНаИнвентаризацию.ПустаяСсылка))) КАК НеЗавершДокумент
	|ПОМЕСТИТЬ ВТНоменклатураСостаткамиПоЯчейкамДополн
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Остатки(
	|			,
	|			Ячейка В
	|				(ВЫБРАТЬ
	|					ВТПолкиДополнит.Ячейка
	|				ИЗ
	|					ВТПолкиДополнит КАК ВТПолкиДополнит
	|				СГРУППИРОВАТЬ ПО
	|					ВТПолкиДополнит.Ячейка)) КАК ТоварыВЯчейкахОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Инвентаризация КАК Инвентаризация_1
	|		ПО ТоварыВЯчейкахОстатки.Ячейка = Инвентаризация_1.Ячейка
	|			И (Инвентаризация_1.ДатаСоздания > &Дата)
	|			И (Инвентаризация_1.ДатаЗавершения <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
	|			И (Инвентаризация_1.Регистратор <> &Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Инвентаризация КАК Инвентаризация_2
	|		ПО ТоварыВЯчейкахОстатки.Ячейка = Инвентаризация_2.Ячейка
	|			И (Инвентаризация_2.ДатаСоздания > &Дата)
	|			И (Инвентаризация_2.Регистратор <> &Ссылка)
	|			И (Инвентаризация_2.ДатаЗавершения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
	|			И (НЕ Инвентаризация_2.РегламентноеЗадание)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыВЯчейкахОстатки.Номенклатура,
	|	ТоварыВЯчейкахОстатки.Ячейка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТДокумДляЯчейкиДополн.Номенклатура,
	|	ВТДокумДляЯчейкиДополн.Ячейка,
	|	ВТДокумДляЯчейкиДополн.Уровень,
	|	ВТДокумДляЯчейкиДополн.ЗавершДокумент,
	|	ВТДокумДляЯчейкиДополн.НеЗавершДокумент
	|ИЗ
	|	ВТДокумДляЯчейкиДополн КАК ВТДокумДляЯчейкиДополн
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТНоменклатураСостаткамиПоЯчейкамДополн.Номенклатура,
	|	ВТНоменклатураСостаткамиПоЯчейкамДополн.Ячейка КАК Ячейка,
	|	МАКСИМУМ(ВТНоменклатураСостаткамиПоЯчейкамДополн.Уровень) КАК Уровень,
	|	МАКСИМУМ(ВТНоменклатураСостаткамиПоЯчейкамДополн.ЗавершДокумент) КАК ЗавершДокумент,
	|	МАКСИМУМ(ВТНоменклатураСостаткамиПоЯчейкамДополн.НеЗавершДокумент) КАК НеЗавершДокумент,
	|	МАКСИМУМ(СпрНоменклатура.КодПроизводителя) КАК КодПроизводителя,
	|	МАКСИМУМ(СпрНоменклатура.Родитель.Наименование) КАК Производитель
	|ПОМЕСТИТЬ ВТБезТаблЧастиДокум
	|ИЗ
	|	ВТНоменклатураСостаткамиПоЯчейкамДополн КАК ВТНоменклатураСостаткамиПоЯчейкамДополн
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО ВТНоменклатураСостаткамиПоЯчейкамДополн.Номенклатура = СпрНоменклатура.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТНоменклатураСостаткамиПоЯчейкамДополн.Номенклатура,
	|	ВТНоменклатураСостаткамиПоЯчейкамДополн.Ячейка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТБезТаблЧастиДокум.Номенклатура,
	|	ВТБезТаблЧастиДокум.Ячейка,
	|	ВТБезТаблЧастиДокум.Уровень,
	|	ВТБезТаблЧастиДокум.КодПроизводителя,
	|	ВТБезТаблЧастиДокум.Производитель,
	|	ВЫБОР
	|		КОГДА ВТБезТаблЧастиДокум.НеЗавершДокумент <> ЗНАЧЕНИЕ(Документ.ЗаданиеНаИнвентаризацию.ПустаяСсылка)
	|			ТОГДА ВТБезТаблЧастиДокум.НеЗавершДокумент
	|		КОГДА ВТБезТаблЧастиДокум.ЗавершДокумент <> ЗНАЧЕНИЕ(Документ.ЗаданиеНаИнвентаризацию.ПустаяСсылка)
	|				И ВТБезТаблЧастиДокум.НеЗавершДокумент = ЗНАЧЕНИЕ(Документ.ЗаданиеНаИнвентаризацию.ПустаяСсылка)
	|			ТОГДА ВТБезТаблЧастиДокум.ЗавершДокумент
	|		ИНАЧЕ ЗНАЧЕНИЕ(Документ.ЗаданиеНаИнвентаризацию.ПустаяСсылка)
	|	КОНЕЦ КАК Документ,
	|	ВЫБОР
	|		КОГДА ВТБезТаблЧастиДокум.НеЗавершДокумент <> ЗНАЧЕНИЕ(Документ.ЗаданиеНаИнвентаризацию.ПустаяСсылка)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК НеЗавершДокумент
	|ПОМЕСТИТЬ ВТБезТаблЧастиДокум_2
	|ИЗ
	|	ВТБезТаблЧастиДокум КАК ВТБезТаблЧастиДокум
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТБезТаблЧастиДокум_2.Ячейка,
	|	МАКСИМУМ(ВТБезТаблЧастиДокум_2.Документ.ДатаВыполнения) КАК ДокументДатаВыполнения
	|ПОМЕСТИТЬ ВТЯчейкиИзЗавершДокум
	|ИЗ
	|	ВТБезТаблЧастиДокум_2 КАК ВТБезТаблЧастиДокум_2
	|ГДЕ
	|	ВТБезТаблЧастиДокум_2.НеЗавершДокумент = ЛОЖЬ
	|	И ВТБезТаблЧастиДокум_2.Документ.ДатаВыполнения <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТБезТаблЧастиДокум_2.Ячейка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыВЯчейкахОбороты.Период,
	|	ТоварыВЯчейкахОбороты.КоличествоПриход,
	|	ТоварыВЯчейкахОбороты.КоличествоРасход,
	|	ТоварыВЯчейкахОбороты.Регистратор,
	|	ТоварыВЯчейкахОбороты.Ячейка
	|ПОМЕСТИТЬ ОборотыПоЯчейкам
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Обороты(
	|			,
	|			,
	|			Регистратор,
	|			Склад = &Склад
	|				И Ячейка В
	|					(ВЫБРАТЬ
	|						А.Ячейка
	|					ИЗ
	|						ВТЯчейкиИзЗавершДокум КАК А)) КАК ТоварыВЯчейкахОбороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТЯчейкиИзЗавершДокум.Ячейка,
	|	СУММА(ЕСТЬNULL(ОборотыПоЯчейкам.КоличествоПриход, 0)) КАК КоличествоПриход,
	|	СУММА(ЕСТЬNULL(ОборотыПоЯчейкам.КоличествоРасход, 0)) КАК КоличествоРасход
	|ПОМЕСТИТЬ ВТОборотыПоЯчейкам
	|ИЗ
	|	ВТЯчейкиИзЗавершДокум КАК ВТЯчейкиИзЗавершДокум
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОборотыПоЯчейкам КАК ОборотыПоЯчейкам
	|		ПО ВТЯчейкиИзЗавершДокум.Ячейка = ОборотыПоЯчейкам.Ячейка
	|ГДЕ
	|	ВЫБОР
	|			КОГДА ОборотыПоЯчейкам.Период ЕСТЬ NULL
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ОборотыПоЯчейкам.Период > ЕСТЬNULL(ВТЯчейкиИзЗавершДокум.ДокументДатаВыполнения, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
	|					И ОборотыПоЯчейкам.Период <= &ТекущаяДата
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТЯчейкиИзЗавершДокум.Ячейка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТБезТаблЧастиДокум_2.Номенклатура,
	|	ВТБезТаблЧастиДокум_2.Ячейка,
	|	МАКСИМУМ(ВТБезТаблЧастиДокум_2.Уровень) КАК Уровень,
	|	МАКСИМУМ(ВТБезТаблЧастиДокум_2.КодПроизводителя) КАК КодПроизводителя,
	|	МАКСИМУМ(ВТБезТаблЧастиДокум_2.Производитель) КАК Производитель,
	|	МАКСИМУМ(ВТБезТаблЧастиДокум_2.Документ) КАК Документ,
	|	МАКСИМУМ(ВТБезТаблЧастиДокум_2.НеЗавершДокумент) КАК НеЗавершДокумент,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ВТОборотыПоЯчейкам.КоличествоПриход <> 0
	|					ИЛИ ВТОборотыПоЯчейкам.КоличествоРасход <> 0
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ЕстьДвижения
	|ПОМЕСТИТЬ ВТБезТаблЧастиДокум_3
	|ИЗ
	|	ВТБезТаблЧастиДокум_2 КАК ВТБезТаблЧастиДокум_2
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОборотыПоЯчейкам КАК ВТОборотыПоЯчейкам
	|		ПО ВТБезТаблЧастиДокум_2.Ячейка = ВТОборотыПоЯчейкам.Ячейка
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТБезТаблЧастиДокум_2.Номенклатура,
	|	ВТБезТаблЧастиДокум_2.Ячейка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаданНаИнвенТов.Ссылка КАК Ссылка,
	|	ЗаданНаИнвенТов.Номенклатура,
	|	ЗаданНаИнвенТов.ДокументИсточник,
	|	МАКСИМУМ(ЗаданНаИнвенТов.КодПроизводителя) КАК КодПроизводителя,
	|	МАКСИМУМ(ЗаданНаИнвенТов.Производитель) КАК Производитель,
	|	МАКСИМУМ(ЗаданНаИнвенТов.Ячейка) КАК Ячейка,
	|	МАКСИМУМ(ЗаданНаИнвенТов.Уровень) КАК Уровень
	|ПОМЕСТИТЬ ВТТаблЧастиДокум
	|ИЗ
	|	ВТБезТаблЧастиДокум_3 КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаданиеНаИнвентаризацию.Товары КАК ЗаданНаИнвенТов
	|		ПО ВТ.Документ = ЗаданНаИнвенТов.Ссылка
	|ГДЕ
	|	ВТ.Документ <> ЗНАЧЕНИЕ(Документ.ЗаданиеНаИнвентаризацию.ПустаяСсылка)
	|	И ЗаданНаИнвенТов.РасхождениеНоменклатуры = ИСТИНА
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаданНаИнвенТов.Ссылка,
	|	ЗаданНаИнвенТов.Номенклатура,
	|	ЗаданНаИнвенТов.ДокументИсточник
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ВТБезТаблЧастиДокум.Номенклатура, ВТТаблЧастиДокум.Номенклатура) КАК Номенклатура,
	|	ЕСТЬNULL(ВТБезТаблЧастиДокум.Ячейка, ВТТаблЧастиДокум.Ячейка) КАК Ячейка,
	|	ЕСТЬNULL(ВТБезТаблЧастиДокум.Ячейка.Полка, ВТТаблЧастиДокум.Ячейка.Полка) КАК Полка,
	|	ЕСТЬNULL(ВТБезТаблЧастиДокум.Уровень, 0) КАК Уровень,
	|	ЕСТЬNULL(ВТБезТаблЧастиДокум.Документ, ЗНАЧЕНИЕ(Документ.ЗаданиеНаИнвентаризацию.ПустаяСсылка)) КАК Документ,
	|	ЕСТЬNULL(ВТБезТаблЧастиДокум.КодПроизводителя, ВТТаблЧастиДокум.КодПроизводителя) КАК КодПроизводителя,
	|	ЕСТЬNULL(ВТБезТаблЧастиДокум.Производитель, ВТТаблЧастиДокум.Производитель) КАК Производитель,
	|	ЕСТЬNULL(ВТТаблЧастиДокум.Уровень, 0) КАК УровеньВТабЧастиДокумента,
	|	ВТБезТаблЧастиДокум.НеЗавершДокумент КАК НезавершенныйДокумент,
	|	ВТБезТаблЧастиДокум.ЕстьДвижения КАК ЕстьДвижения,
	|	ВЫБОР
	|		КОГДА ВТТаблЧастиДокум.Номенклатура ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьНоменклатураВДокументе,
	|	ЕСТЬNULL(ВТТаблЧастиДокум.ДокументИсточник, ЗНАЧЕНИЕ(Документ.ЗаданиеНаИнвентаризацию.ПустаяСсылка)) КАК ДокументИсточник
	|ИЗ
	|	ВТБезТаблЧастиДокум_3 КАК ВТБезТаблЧастиДокум
	|		ПОЛНОЕ СОЕДИНЕНИЕ ВТТаблЧастиДокум КАК ВТТаблЧастиДокум
	|		ПО ВТБезТаблЧастиДокум.Документ = ВТТаблЧастиДокум.Ссылка
	|			И ВТБезТаблЧастиДокум.Номенклатура = ВТТаблЧастиДокум.Номенклатура
	|			И ВТБезТаблЧастиДокум.Ячейка = ВТТаблЧастиДокум.Ячейка
	|ГДЕ
	|	ЕСТЬNULL(ВТБезТаблЧастиДокум.Ячейка, ВТТаблЧастиДокум.Ячейка) <> &ЯчейкаНедостачаПриИнвентаризации
	|	И НЕ ЕСТЬNULL(ВТБезТаблЧастиДокум.Ячейка, ВТТаблЧастиДокум.Ячейка) В
	|				(ВЫБРАТЬ
	|					Т.ЯчейкаИсходная
	|				ИЗ
	|					ВТЯчейкиИсходные КАК Т)
	|ИТОГИ
	|	МАКСИМУМ(Документ),
	|	МАКСИМУМ(НезавершенныйДокумент),
	|	МАКСИМУМ(ЕстьДвижения)
	|ПО
	|	Полка";
	
	Запрос.УстановитьПараметр("Ссылка", ЗаданиеОбъект.Ссылка);
	Запрос.УстановитьПараметр("Дата", Константы.ДатаИнвентаризацииПоследнейЯчейки.Получить());
	Запрос.УстановитьПараметр("Склад", Константы.ОсновнойСклад.Получить());
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	Запрос.УстановитьПараметр("ЯчейкаНедостачаПриИнвентаризации",  Константы.НедостачаПриИнвентаризации.Получить());
	Запрос.УстановитьПараметр("Полка", ЗаданиеОбъект.Полка);
	
	// Создаем или update documents для ячеек, где были расхождения
	
	// Сначала получаем полку
	ВыборкаПолки = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ДокументОбъект = Неопределено;
	
	Пока ВыборкаПолки.Следующий() Цикл
		
		ДокументСсылка = ВыборкаПолки.Документ;
		
		Если Не ЗначениеЗаполнено(ДокументСсылка) Или 
			(ЗначениеЗаполнено(ДокументСсылка) И ВыборкаПолки.НезавершенныйДокумент = Ложь И ВыборкаПолки.ЕстьДвижения) Тогда
			
			ДокументОбъект = Документы.ЗаданиеНаИнвентаризацию.СоздатьДокумент();
			ДокументОбъект.Дата = ТекущаяДата();
			ДокументОбъект.Склад = ЗаданиеОбъект.Склад;
			ДокументОбъект.ДокументОснование = ЗаданиеОбъект.Ссылка;
			ДокументОбъект.ПолкаВторичная = ВыборкаПолки.Полка;
			ДокументОбъект.Полка = ВыборкаПолки.Полка;
			
			ДокументОбъект.Комментарий = "Источник-> " + Строка(ЗаданиеОбъект.Номер) + " " + Строка(ЗаданиеОбъект.Дата) + "; ";   	
			
		ИначеЕсли ВыборкаПолки.НезавершенныйДокумент = Истина Тогда 
			ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
		ИначеЕсли (ЗначениеЗаполнено(ДокументСсылка) И ВыборкаПолки.НезавершенныйДокумент = Ложь И Не ВыборкаПолки.ЕстьДвижения) Тогда 
			Продолжить;
		КонецЕсли;                                  
		
		ДокументОбъект.Товары.Очистить();
		ВыборкаНоменклатуры = ВыборкаПолки.Выбрать();		
		
		ЗначениеЯчейки = "";
		
		Пока ВыборкаНоменклатуры.Следующий() Цикл
			
			Если ДокументОбъект.ЭтоНовый() И ЗначениеЯчейки <> ВыборкаНоменклатуры.Ячейка Тогда
				
				ЕстьЯчейкаВТЧ = ДокументОбъект.ИнвентаризируемыеЯчейки.Найти(ВыборкаНоменклатуры.Ячейка, "ЯчейкаДляИнвентаризации") ;
				
				Если ЕстьЯчейкаВТЧ = Неопределено Тогда
					
					СтрокаЯчейка = ДокументОбъект.ИнвентаризируемыеЯчейки.Добавить();
					СтрокаЯчейка.ЯчейкаДляИнвентаризации = ВыборкаНоменклатуры.Ячейка;
					ЗначениеЯчейки = ВыборкаНоменклатуры.Ячейка;
					
				КонецЕсли;
				
			КонецЕсли; 
			
			Товар = ДокументОбъект.Товары.Добавить();	
			ЗаполнитьЗначенияСвойств(Товар, ВыборкаНоменклатуры);                    
			
			Если Не ДокументОбъект.ЭтоНовый() Тогда
				
				Если ВыборкаНоменклатуры.ЕстьНоменклатураВДокументе И ВыборкаНоменклатуры.УровеньВТабЧастиДокумента = 2 Тогда
					Товар.Уровень = ВыборкаНоменклатуры.УровеньВТабЧастиДокумента;
				КонецЕсли; 				
				
				Если ВыборкаНоменклатуры.ЕстьНоменклатураВДокументе И ВыборкаНоменклатуры.УровеньВТабЧастиДокумента = 1  И 
					ВыборкаНоменклатуры.Уровень = 2 Тогда
					
					Товар.Уровень = ВыборкаНоменклатуры.Уровень;
					Товар.ДокументИсточник = ЗаданиеОбъект.Ссылка;
					
				КонецЕсли; 
				
			КонецЕсли; 
			
		КонецЦикла;                                                        
		
		Попытка
			
			ДокументОбъект.Записать();	
			
			Попытка
				ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);						
			Исключение
				
				ТекстОшибки = "Задание на инвент """ + ДокументОбъект.Ссылка + """ успешно записан в базу 1С, но не проведен.";			
				Возврат ТекстОшибки;
				
			КонецПопытки;
			
		Исключение
			
			ТекстОшибки = "Ошибка при записи документа Задания на инвент в 1С: " + ОписаниеОшибки() + ".";
			Возврат ТекстОшибки;
			
		КонецПопытки;				
		
	КонецЦикла;  
	
	Возврат "";
	
КонецФункции

Функция СоздатьПеремещениеТовараДляСтрокВторогоУровня(ЗаданиеСсылка) Экспорт
	
	ЗаданиеОбъект = ЗаданиеСсылка.ПолучитьОбъект();	
	
	Если НЕ ЗаданиеОбъект.АРМКладовщика Или НЕ ЗначениеЗаполнено(ЗаданиеОбъект.ДатаВыполнения) Тогда
		Возврат "";
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ЗаданиеОбъект.ДокумПеремФактМеньшеПлана) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПеремещениеТовараПоЯчейкам.Ссылка КАК Ссылка,
		|	ПеремещениеТовараПоЯчейкам.Проведен
		|ИЗ
		|	Документ.ПеремещениеТовараПоЯчейкам КАК ПеремещениеТовараПоЯчейкам
		|ГДЕ
		|	ПеремещениеТовараПоЯчейкам.Ссылка = &Ссылка
		|	И ПеремещениеТовараПоЯчейкам.ДокументОснование = &ДокументОснование
		|	И ПеремещениеТовараПоЯчейкам.Проведен
		|
		|УПОРЯДОЧИТЬ ПО
		|	Ссылка УБЫВ
		|АВТОУПОРЯДОЧИВАНИЕ";
		
		Запрос.УстановитьПараметр("Ссылка", ЗаданиеОбъект.ДокумПеремФактМеньшеПлана);
		Запрос.УстановитьПараметр("ДокументОснование", ЗаданиеОбъект.Ссылка);
		РезультатЗапроса = Запрос.Выполнить().Выбрать();
		
		Если РезультатЗапроса.Количество() > 0 Тогда
			Возврат "";
		КонецЕсли; 				 
		
	КонецЕсли; 
	
	Запрос = Новый Запрос;               
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаданНаИнвентТов.Ссылка,
	|	ЗаданНаИнвентТов.Номенклатура,
	|	ЗаданНаИнвентТов.Ячейка КАК Ячейка,
	|	ЗаданНаИнвентТов.Отклонение,
	|	ЗаданНаИнвентТов.КоличествоФакт,
	|	ЗаданНаИнвентТов.КоличествоУчетное
	|ПОМЕСТИТЬ ВТЗаданНаИнвенТов
	|ИЗ
	|	Документ.ЗаданиеНаИнвентаризацию.Товары КАК ЗаданНаИнвентТов
	|ГДЕ
	|	ЗаданНаИнвентТов.Ссылка = &Ссылка
	|	И ЗаданНаИнвентТов.Уровень = 2
	|	И ЗаданНаИнвентТов.РасхождениеНоменклатуры        
	|	И ЗаданНаИнвентТов.КоличествоФакт < ЗаданНаИнвентТов.КоличествоУчетное
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыВЯчейкахОстатки.Номенклатура,
	|	ТоварыВЯчейкахОстатки.КоличествоОстаток,
	|	ТоварыВЯчейкахОстатки.Ячейка
	|ПОМЕСТИТЬ ВТОстатки
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Остатки(
	|			,
	|			(Номенклатура, Ячейка) В
	|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|					ВТЗаданНаИнвенТов.Номенклатура,
	|					ВТЗаданНаИнвенТов.Ячейка
	|				ИЗ
	|					ВТЗаданНаИнвенТов КАК ВТЗаданНаИнвенТов)) КАК ТоварыВЯчейкахОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТЗаданНаИнвенТов.Ссылка,
	|	ВТЗаданНаИнвенТов.Номенклатура,
	|	ВТЗаданНаИнвенТов.Ячейка КАК Ячейка,
	|	ВТЗаданНаИнвенТов.Отклонение,
	|	ВТЗаданНаИнвенТов.КоличествоФакт,
	|	ВТЗаданНаИнвенТов.КоличествоУчетное,
	|	ЕСТЬNULL(ВТОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток
	|ИЗ
	|	ВТЗаданНаИнвенТов КАК ВТЗаданНаИнвенТов
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОстатки КАК ВТОстатки
	|		ПО ВТЗаданНаИнвенТов.Номенклатура = ВТОстатки.Номенклатура
	|			И ВТЗаданНаИнвенТов.Ячейка = ВТОстатки.Ячейка
	|ИТОГИ ПО
	|	Ячейка";
	
	Запрос.УстановитьПараметр("Ссылка", ЗаданиеОбъект.Ссылка);
	
	ВыборкаЯчейки = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Если ВыборкаЯчейки.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли; 
	
	Пока ВыборкаЯчейки.Следующий() Цикл
		
		ДокументОбъект = Неопределено;
		
		// Шапка документа	
		ДокументПеремещения = Документы.ПеремещениеТовараПоЯчейкам.СоздатьДокумент();
		ДокументПеремещения.Клеверенс = Истина;        
		ДокументПеремещения.Ответственный = ЗаданиеОбъект.Ответственный;
		ДокументПеремещения.Дата        = ТекущаяДата();		
		ДокументПеремещения.Склад       = Константы.ОсновнойСклад.Получить();
		
		КомментарийТекст = "Создан для строк расхождения уровня 2 " + ЗаданиеОбъект.Ссылка;
		ДокументПеремещения.Комментарий = КомментарийТекст;
		ДокументПеремещения.ДокументОснование = ЗаданиеОбъект.Ссылка;
		////////////////////////					
		
		ВыборкаНоменклатуры = ВыборкаЯчейки.Выбрать();		
		
		Пока ВыборкаНоменклатуры.Следующий() Цикл
			
			Товар = ДокументПеремещения.Товары.Добавить();	
			Товар.Номенклатура   = ВыборкаНоменклатуры.Номенклатура;		
			Товар.Количество     = ВыборкаНоменклатуры.КоличествоУчетное - ВыборкаНоменклатуры.КоличествоФакт; 
			Товар.КоличествоПереместить   = Товар.Количество; 
			Товар.Ячейка         = ВыборкаЯчейки.Ячейка;
			Товар.ЯчейкаКуда     = Константы.НедостачаПриИнвентаризации.Получить();
			
		КонецЦикла;
		
		ТекстОшибки = "";
		
		Попытка
			
			ДокументПеремещения.Записать(РежимЗаписиДокумента.Запись);
			
			Попытка
				ДокументПеремещения.Записать(РежимЗаписиДокумента.Проведение);					
			Исключение
				
				ТекстОшибки = ОписаниеОшибки(); 
				Возврат ТекстОшибки;
				
			КонецПопытки;                          
			
			ЗаданиеОбъект.ДокумПеремФактМеньшеПлана = ДокументПеремещения.Ссылка;
			ЗаданиеОбъект.Записать();			
			ЗаписатьЛог(ЗаданиеОбъект.Ответственный, ТекущаяДата(), "", "Записан документ перемещения товара по ячейкам, на основ. строк расхождения", 
			Строка(ДокументПеремещения.Номер)); 													
			
		Исключение
			
			ТекстОшибки = "Ошибка при записи документа перемещ.товара по ячейкам в 1С: " + ОписаниеОшибки() + ".";
			Возврат ТекстОшибки;
			
		КонецПопытки; 		
		
	КонецЦикла; 
	
	Возврат "";
	
КонецФункции                                                            

Функция СоздатьРазмещениеТовараДляСтрокВторогоУровня(ЗаданиеСсылка) Экспорт
	
	ЗаданиеОбъект = ЗаданиеСсылка.ПолучитьОбъект();	
	
	Если НЕ ЗаданиеОбъект.АРМКладовщика Или НЕ ЗначениеЗаполнено(ЗаданиеОбъект.ДатаВыполнения) Тогда
		Возврат "";
	КонецЕсли; 
	
	//
	Если ЗначениеЗаполнено(ЗаданиеОбъект.ДокументРазмещенияПоЯчейкам) Тогда
		
		Запрос = Новый Запрос;                            
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	РазмещениеПоЯчейкам.Ссылка КАК Ссылка,
		|	РазмещениеПоЯчейкам.Проведен
		|ИЗ
		|	Документ.РазмещениеПоЯчейкам КАК РазмещениеПоЯчейкам
		|ГДЕ
		|	РазмещениеПоЯчейкам.ДокументОснование = &ДокументОснование
		|	И РазмещениеПоЯчейкам.Проведен
		|
		|УПОРЯДОЧИТЬ ПО
		|	Ссылка УБЫВ
		|АВТОУПОРЯДОЧИВАНИЕ";
		
		Запрос.УстановитьПараметр("ДокументОснование", ЗаданиеОбъект.Ссылка);
		РезультатЗапроса = Запрос.Выполнить().Выбрать();
		
		Если РезультатЗапроса.Количество() > 0 Тогда
			Возврат "";
		КонецЕсли; 				 
		
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ЗаданиеОбъект.ДокумПеремФактБольшеПлана) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПеремещениеТовараПоЯчейкам.Ссылка КАК Ссылка,
		|	ПеремещениеТовараПоЯчейкам.Проведен
		|ИЗ
		|	Документ.ПеремещениеТовараПоЯчейкам КАК ПеремещениеТовараПоЯчейкам
		|ГДЕ
		|	ПеремещениеТовараПоЯчейкам.Ссылка = &Ссылка
		|	И ПеремещениеТовараПоЯчейкам.ДокументОснование = &ДокументОснование
		|	И ПеремещениеТовараПоЯчейкам.Проведен
		|
		|УПОРЯДОЧИТЬ ПО
		|	Ссылка УБЫВ
		|АВТОУПОРЯДОЧИВАНИЕ";
		
		Запрос.УстановитьПараметр("Ссылка", ЗаданиеОбъект.ДокумПеремФактБольшеПлана);
		Запрос.УстановитьПараметр("ДокументОснование", ЗаданиеОбъект.Ссылка);
		РезультатЗапроса = Запрос.Выполнить().Выбрать();
		
		Если РезультатЗапроса.Количество() > 0 Тогда			
			
			Попытка		
				
				РезультатЗапроса.Следующий();
				Документ = РезультатЗапроса.Ссылка.ПолучитьОбъект();
				Документ.УстановитьПометкуУдаления(Истина);				
				
			Исключение
				
				ТекстОшибки = "Документ перемещ.товара по ячейкам (для строк уровня 2) """ + РезультатЗапроса.Ссылка + 
				""" невозможно пометить на удаление в базе 1С. " + ОписаниеОшибки();
				Возврат ТекстОшибки;			    
				
			КонецПопытки;			
			
		КонецЕсли; 				 		
		
	КонецЕсли; 
	
	
	Запрос = Новый Запрос;               
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаданиеНаИнвентаризациюТовары.Ссылка,
	|	ЗаданиеНаИнвентаризациюТовары.Номенклатура,
	|	ЗаданиеНаИнвентаризациюТовары.Ячейка КАК Ячейка,
	|	ЗаданиеНаИнвентаризациюТовары.Отклонение,
	|	ЗаданиеНаИнвентаризациюТовары.КоличествоФакт,
	|	ЗаданиеНаИнвентаризациюТовары.КоличествоУчетное
	|ПОМЕСТИТЬ ВТНомен
	|ИЗ
	|	Документ.ЗаданиеНаИнвентаризацию.Товары КАК ЗаданиеНаИнвентаризациюТовары
	|ГДЕ
	|	ЗаданиеНаИнвентаризациюТовары.Ссылка = &Ссылка
	|	И ЗаданиеНаИнвентаризациюТовары.Уровень = 2
	|	И ЗаданиеНаИнвентаризациюТовары.РасхождениеНоменклатуры        
	|	И ЗаданиеНаИнвентаризациюТовары.КоличествоФакт > ЗаданиеНаИнвентаризациюТовары.КоличествоУчетное
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыВЯчейкахОстатки.Номенклатура,
	|	ТоварыВЯчейкахОстатки.КоличествоОстаток
	|ПОМЕСТИТЬ ВТОстаткиПоНомен
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Остатки(
	|			,
	|			Номенклатура В
	|					(ВЫБРАТЬ
	|						ВТНомен.Номенклатура
	|					ИЗ
	|						ВТНомен КАК ВТНомен)
	|				И Ячейка В
	|					(ВЫБРАТЬ
	|						Константы.НедостачаПриИнвентаризации
	|					ИЗ
	|						Константы КАК Константы)) КАК ТоварыВЯчейкахОстатки
	|ГДЕ
	|	ТоварыВЯчейкахОстатки.КоличествоОстаток > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТНомен.Номенклатура,                             	
	|	ЕСТЬNULL(ВТОстаткиПоНомен.КоличествоОстаток, 0) КАК КоличествоОстаток,
	|	ВТНомен.Ячейка КАК Ячейка,
	|	ВТНомен.КоличествоФакт,
	|	ВТНомен.КоличествоУчетное
	|ИЗ
	|	ВТНомен КАК ВТНомен
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОстаткиПоНомен КАК ВТОстаткиПоНомен
	|		ПО ВТНомен.Номенклатура = ВТОстаткиПоНомен.Номенклатура
	|ГДЕ
	|	ЕСТЬNULL(ВТОстаткиПоНомен.КоличествоОстаток, 0) >= 0
	|ИТОГИ ПО
	|	Ячейка";
	
	Запрос.УстановитьПараметр("Ссылка", ЗаданиеОбъект.Ссылка);
	
	ВыборкаЯчейки = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Если ВыборкаЯчейки.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли; 
	
	ТоварыДляРазмещенияВячейках = Новый ТаблицаЗначений;
	ТоварыДляРазмещенияВячейках.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТоварыДляРазмещенияВячейках.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	ТоварыДляРазмещенияВячейках.Колонки.Добавить("ЯчейкаДляРазмещения", Новый ОписаниеТипов("СправочникСсылка.Ячейки"));
	
	ДокументОбъект = Неопределено;
	
	Пока ВыборкаЯчейки.Следующий() Цикл
		
		// Шапка документа	
		ДокументПеремещения = Документы.ПеремещениеТовараПоЯчейкам.СоздатьДокумент();
		ДокументПеремещения.Клеверенс = Истина;        
		ДокументПеремещения.Ответственный = ЗаданиеОбъект.Ответственный;
		ДокументПеремещения.Дата = ТекущаяДата();		
		ДокументПеремещения.Склад = Константы.ОсновнойСклад.Получить();
		
		КомментарийТекст = "Создан для строк расхождения уровня 2 " + ЗаданиеОбъект.Ссылка;
		ДокументПеремещения.Комментарий = КомментарийТекст;
		ДокументПеремещения.ДокументОснование = ЗаданиеОбъект.Ссылка;
		////////////////////////					
		
		ВыборкаНоменклатуры = ВыборкаЯчейки.Выбрать();		
		
		Пока ВыборкаНоменклатуры.Следующий() Цикл
			
			ИзбытокКоличество = ВыборкаНоменклатуры.КоличествоФакт - ВыборкаНоменклатуры.КоличествоУчетное;
			
			// Если Количество остаток = 0, то делаем только размещение товара по ячейкам
			Если ВыборкаНоменклатуры.КоличествоОстаток = 0 Тогда
				
				СтрокаТЗ                     = ТоварыДляРазмещенияВячейках.Добавить();
				СтрокаТЗ.Номенклатура        = ВыборкаНоменклатуры.Номенклатура;
				СтрокаТЗ.Количество          = ИзбытокКоличество;			
				СтрокаТЗ.ЯчейкаДляРазмещения = ВыборкаЯчейки.Ячейка;
				Продолжить;
				
			КонецЕсли; 
			
			Товар = ДокументПеремещения.Товары.Добавить();	
			Товар.Номенклатура   = ВыборкаНоменклатуры.Номенклатура;
			
			Если ИзбытокКоличество <= ВыборкаНоменклатуры.КоличествоОстаток Тогда			
				
				Товар.Количество = ИзбытокКоличество;
				Товар.КоличествоПереместить = Товар.Количество;
				
			Иначе 			
				
				Товар.Количество            = ВыборкаНоменклатуры.КоличествоОстаток; 
				Товар.КоличествоПереместить = Товар.Количество;
				
				// Нужен документ размещения на разницу ИзбытокКоличество - ВыборкаНоменклатуры.КоличествоОстаток;
				СтрокаТЗ 				     = ТоварыДляРазмещенияВячейках.Добавить();
				СтрокаТЗ.Номенклатура        = ВыборкаНоменклатуры.Номенклатура;
				СтрокаТЗ.Количество          = ИзбытокКоличество - ВыборкаНоменклатуры.КоличествоОстаток;
				СтрокаТЗ.ЯчейкаДляРазмещения = ВыборкаЯчейки.Ячейка;
				
			КонецЕсли; 
			
			Товар.Ячейка     = Константы.НедостачаПриИнвентаризации.Получить();
			Товар.ЯчейкаКуда = ВыборкаЯчейки.Ячейка;
			
		КонецЦикла;
		
		Если ДокументПеремещения.Товары.Количество() >  0 Тогда
			
			ЗаданиеОбъект.ДокумПеремФактБольшеПлана = ДокументПеремещения.Ссылка;	
			ТекстОшибки = "";			
			
			Попытка
				
				ДокументПеремещения.Записать();
				
				Попытка
					ДокументПеремещения.Записать(РежимЗаписиДокумента.Проведение);					
				Исключение
					
					ТекстОшибки = ОписаниеОшибки();
					Возврат ТекстОшибки;
					
				КонецПопытки;
				
				ЗаписатьЛог(ЗаданиеОбъект.Ответственный, ТекущаяДата(), "", "Записан(проведен) документ перемещения товара по ячейкам, на основ. строк расхождения", 
				Строка(ДокументПеремещения.Номер)); 													
				
			Исключение
				
				ТекстОшибки = "Ошибка при записи документа перемещ.товара по ячейкам на основ.строк.расхож в 1С: " + ОписаниеОшибки() + ".";
				Возврат ТекстОшибки;
				
			КонецПопытки; 		
			
		Иначе
			ДокументПеремещения = Неопределено;
		КонецЕсли; 
		
	КонецЦикла; 
	
	
	////////////////////////////////////////////////////////////////////////////////////////////////////////////
	// Создать документ размещение в ячейках на неучтенное количесто в ту же ячейку, где он обнаружен
	// чтобы факт совпал с планом
	
	Если ТоварыДляРазмещенияВячейках.Количество() > 0 Тогда
		
		ДокументРазмещения = Документы.РазмещениеПоЯчейкам.СоздатьДокумент();
		ДокументРазмещения.ДокументОснование = ЗаданиеОбъект.Ссылка;
		ДокументРазмещения.Дата = ТекущаяДата();
		ДокументРазмещения.Склад = Константы.ОсновнойСклад.Получить();							
		ДокументРазмещения.Ответственный = ЗаданиеОбъект.Ответственный;
		ДокументРазмещения.НомерСкладскогоДокумента = "";
		ДокументРазмещения.Клеверенс = Истина;
		ДокументРазмещения.Комментарий = "Создан для строк расхождения уровня 2 " + ЗаданиеОбъект.Ссылка;
		
		ЗаписатьЛог(ЗаданиеОбъект.Ответственный, ТекущаяДата(), "", "Создан документ размещения по ячейкам, для строк второго уровня", Строка(ДокументРазмещения.Номер)); 
		
		Для каждого Строка Из ТоварыДляРазмещенияВячейках Цикл		
			
			Товар = ДокументРазмещения.Товары.Добавить();	
			Товар.Номенклатура = Строка.Номенклатура;
			Товар.Количество = Строка.Количество;
			Товар.Ячейка = Строка.ЯчейкаДляРазмещения;		
			
		КонецЦикла; 
		
		Попытка
			
			ДокументРазмещения.Записать();
			
			Попытка
				ДокументРазмещения.Записать(РежимЗаписиДокумента.Проведение);					
			Исключение
				
				ТекстОшибки = ОписаниеОшибки();
				Возврат ТекстОшибки;                   
				
			КонецПопытки;                                  
			
			Если ДокументПеремещения <> Неопределено Тогда
				
				ЗаданиеОбъект.ДокумПеремФактБольшеПлана = ДокументПеремещения.Ссылка;	
				ЗаписатьЛог(ЗаданиеОбъект.Ответственный, ТекущаяДата(), "", 
				"Записан(проведен) документ перемещ. товара по ячейкам, на основ. строк расхождения", Строка(ДокументПеремещения.Номер));			
				
			КонецЕсли; 
			
			ЗаданиеОбъект.ДокументРазмещенияПоЯчейкам = ДокументРазмещения.Ссылка;
			ЗаданиеОбъект.Записать();			
			
			ЗаписатьЛог(ЗаданиеОбъект.Ответственный, ТекущаяДата(), "", "Записан(проведен) документ размещения товара по ячейкам, на основ. строк расхождения", 
			Строка(ДокументРазмещения.Номер));
			
		Исключение
			
			ТекстОшибки = "Ошибка при записи документа размещения.товара по ячейкам на основ.строк расхож в 1С: " + ОписаниеОшибки()+".";
			Возврат ТекстОшибки;
			
		КонецПопытки; 		
		
	КонецЕсли; 
	
	Возврат ""
	
КонецФункции

Функция СоздатьДокументРазмещенияПоМестамХраненияГМ(DocumentBaseGUID, UserIdGUID, DeleteRecordsFromBuffer = Ложь) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Ошибка", "");
	
	ПТУСсылка = Документы.ПоступлениеТоваровУслуг.ПолучитьСсылку( Новый УникальныйИдентификатор(DocumentBaseGUID)); 
	
	ПТУОбъект = ПТУСсылка.ПолучитьОбъект();
	
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);
	
	НачатьТранзакцию();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	БуферАрмКладовщика.Объект,
	|	БуферАрмКладовщика.Ячейка,
	|	БуферАрмКладовщика.ГМ,
	|	БуферАрмКладовщика.ВведеноВРучную
	|ПОМЕСТИТЬ ВТ_Буфер
	|ИЗ
	|	РегистрСведений.БуферАрмКладовщикаГМ КАК БуферАрмКладовщика
	|ГДЕ
	|	БуферАрмКладовщика.Объект = &Объект
	|	И БуферАрмКладовщика.UserId = &UserId
	|	И БуферАрмКладовщика.Объект ССЫЛКА Документ.ПоступлениеТоваровУслуг
	|
	|СГРУППИРОВАТЬ ПО
	|	БуферАрмКладовщика.Объект,
	|	БуферАрмКладовщика.Ячейка,
	|	БуферАрмКладовщика.ГМ,
	|	БуферАрмКладовщика.ВведеноВРучную
	|
	|ДЛЯ ИЗМЕНЕНИЯ
	|	РегистрСведений.БуферАрмКладовщикаГМ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПоступлениеТоваровУслугТовары.ГМ,
	|	ПоступлениеТоваровУслугТовары.Номенклатура,
	|	ВТ_Буфер.Ячейка,
	|	ПоступлениеТоваровУслугТовары.Количество,
	|	ВТ_Буфер.ВведеноВРучную
	|ИЗ
	|	ВТ_Буфер КАК ВТ_Буфер
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг.Товары КАК ПоступлениеТоваровУслугТовары
	|		ПО ВТ_Буфер.Объект = ПоступлениеТоваровУслугТовары.Ссылка
	|			И ВТ_Буфер.ГМ = ПоступлениеТоваровУслугТовары.ГМ";
	
	Запрос.УстановитьПараметр("Объект", ПТУСсылка);
	Запрос.УстановитьПараметр("UserId", UserIdСсылка); 
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Количество() = 0  Тогда	
		
		ОтменитьТранзакцию();
		
		ТекстОшибки = "Отсутствуют отсканированные строки документа";				
		Результат.Вставить("Ошибка", ТекстОшибки);
		Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
		Возврат Результат;
		
	КонецЕсли;	                              
	
	Попытка
		
		ДокументРазмещения = Документы.РазмещениеПоЯчейкам.СоздатьДокумент();
		
		ДокументРазмещения.ДокументОснование = ПТУСсылка;
		ДокументРазмещения.Дата = ТекущаяДата();
		ДокументРазмещения.Склад = ?(ОбщегоНазначения.ЕстьРеквизитДокумента("Склад", ПТУСсылка.Метаданные()), ПТУСсылка.Склад, ПТУСсылка.СкладОрдер);							
		ДокументРазмещения.Ответственный = UserIdСсылка;
		ДокументРазмещения.НомерСкладскогоДокумента = ПТУОбъект.НомерСкладскогоДокумента;
		ДокументРазмещения.Клеверенс = Истина;
		ДокументРазмещения.Комментарий = "Создан ТСД на платформе Андроид.";
		
		ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Создан документ размещения по ячейкам", Строка(ДокументРазмещения.Номер)); 
		
		Пока РезультатЗапроса.Следующий() Цикл
			
			Товар = ДокументРазмещения.Товары.Добавить();	
			Товар.Номенклатура = РезультатЗапроса.Номенклатура;
			Товар.Количество = РезультатЗапроса.Количество;
			Товар.Ячейка = РезультатЗапроса.Ячейка;
			Товар.ВведеноВручную = РезультатЗапроса.ВведеноВРучную;   
			Товар.ГМ = РезультатЗапроса.ГМ;
			
		КонецЦикла; 
		
		Попытка
			
			ДокументРазмещения.Записать();
			ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Записан документ размещения по ячейкам", Строка(ДокументРазмещения.Номер)); 
			
			Попытка				
				
				ДокументРазмещения.Записать(РежимЗаписиДокумента.Проведение);				
				ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Документ размещения по ячейкам проведен", Строка(ДокументРазмещения.Номер)); 
				
				Если DeleteRecordsFromBuffer = Истина Тогда
					
					РС = РегистрыСведений.БуферАрмКладовщикаГМ.СоздатьНаборЗаписей();
					РС.Отбор.Объект.Установить(ПТУСсылка);
					РС.Отбор.UserId.Установить(UserIdСсылка);
					РС.Записать();
					
				КонецЕсли; 
				
				ЗафиксироватьТранзакцию();
				
			Исключение	
				
				ОтменитьТранзакцию();
				
				ТекстОшибки = "Документ """ + ДокументРазмещения.Ссылка + """ успешно записан в базу 1С, но не проведен.";				
				Результат.Вставить("Ошибка", ТекстОшибки);
				Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
				Возврат Результат;				
				
			КонецПопытки; 
			
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстОшибки = "Ошибка при записи документа в 1С: " + ОписаниеОшибки() + ".";				
			Результат.Вставить("Ошибка", ТекстОшибки);
			Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
			Возврат Результат;
			
		КонецПопытки;           
		
		Результат.Вставить("Ошибка", "");
		Результат.Вставить("НомерДокумента", ДокументРазмещения.Номер);
		Результат.Вставить("ДатаДокумента", ДокументРазмещения.Дата);
		Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
		Возврат Результат;
		
	Исключение
		
		ОтменитьТранзакцию();
		
		СтруктураОшибки = Новый Структура;
		СтруктураОшибки.Вставить("Ошибка", ОписаниеОшибки()); 
		Результат = ARMStoreKeeper.ДанныеВJSONХранилище(СтруктураОшибки);
		Возврат Результат;
		
	КонецПопытки; 
	
КонецФункции

Функция СоздатьДокументРазмещенияПоМестамХранения(DocumentBaseGUID, UserIdGUID, DeleteRecordsFromBuffer = Ложь) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Ошибка", "");
	
	ПТУСсылка = Документы.ПоступлениеТоваровУслуг.ПолучитьСсылку(Новый УникальныйИдентификатор(DocumentBaseGUID)); 

	Если ПТУСсылка.ПолучитьОбъект() = Неопределено Тогда
		ПТУСсылка = Документы.ПоступлениеТоваровНаОтветственноеХранение.ПолучитьСсылку(Новый УникальныйИдентификатор(DocumentBaseGUID));
	КонецЕсли;

	ПТУОбъект = ПТУСсылка.ПолучитьОбъект();
	
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);
	
	НачатьТранзакцию();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	БуферАрмКладовщика.Объект,
	|	БуферАрмКладовщика.Номенклатура,
	|	БуферАрмКладовщика.UserId,
	|	БуферАрмКладовщика.Ячейка,
	|	СУММА(БуферАрмКладовщика.Quantity) КАК Quantity,
	|	КОЛИЧЕСТВО(БуферАрмКладовщика.Quantity) КАК КоличествоСтрок,
	|	МАКСИМУМ(БуферАрмКладовщика.ВведеноВРучную) КАК ВведеноВРучную,
	|	МАКСИМУМ(ЕдиницыИзмерения.Коэффициент) КАК ЕдХранОстатковКоэффициент
	|ИЗ
	|	РегистрСведений.БуферАрмКладовщика КАК БуферАрмКладовщика
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	|			ПО СпрНоменклатура.Ссылка = ЕдиницыИзмерения.Владелец
	|				И СпрНоменклатура.ЕдиницаХраненияОстатков = ЕдиницыИзмерения.Ссылка
	|		ПО БуферАрмКладовщика.Номенклатура = СпрНоменклатура.Ссылка
	|ГДЕ
	|	БуферАрмКладовщика.Объект = &Объект
	|	И БуферАрмКладовщика.UserId = &UserId
	|	И (БуферАрмКладовщика.Объект ССЫЛКА Документ.ПоступлениеТоваровУслуг
	|			ИЛИ БуферАрмКладовщика.Объект ССЫЛКА Документ.ПоступлениеТоваровНаОтветственноеХранение)
	|
	|СГРУППИРОВАТЬ ПО
	|	БуферАрмКладовщика.Объект,
	|	БуферАрмКладовщика.Номенклатура,
	|	БуферАрмКладовщика.UserId,
	|	БуферАрмКладовщика.Ячейка
	|
	|ДЛЯ ИЗМЕНЕНИЯ
	|	РегистрСведений.БуферАрмКладовщика";
	
	Запрос.УстановитьПараметр("Объект", ПТУСсылка);
	Запрос.УстановитьПараметр("UserId", UserIdСсылка);                                          
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Количество() = 0  Тогда	
		
		ОтменитьТранзакцию();
		
		ТекстОшибки = "Отсутствуют отсканированные строки документа";				
		Результат.Вставить("Ошибка", ТекстОшибки);
		Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
		Возврат Результат;
		
	КонецЕсли;	                              
	
	Попытка
		
		ДокументРазмещения = Документы.РазмещениеПоЯчейкам.СоздатьДокумент();
		ДокументРазмещения.ДокументОснование = ПТУСсылка;
		ДокументРазмещения.Дата = ТекущаяДата();
		ДокументРазмещения.Склад = ?(ОбщегоНазначения.ЕстьРеквизитДокумента("Склад", ПТУСсылка.Метаданные()), ПТУСсылка.Склад, ПТУСсылка.СкладОрдер);							
		ДокументРазмещения.Ответственный = UserIdСсылка;
		ДокументРазмещения.НомерСкладскогоДокумента = ПТУОбъект.НомерСкладскогоДокумента;
		ДокументРазмещения.Клеверенс = Истина;
		ДокументРазмещения.Комментарий = "Создан ТСД на платформе Андроид.";
		
		ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Создан документ размещения по ячейкам", Строка(ДокументРазмещения.Номер)); 
		
		Пока РезультатЗапроса.Следующий() Цикл
			
			Товар = ДокументРазмещения.Товары.Добавить();	
			Товар.Номенклатура = РезультатЗапроса.Номенклатура;
			Товар.Количество = РезультатЗапроса.Quantity;
			
			Если Товар.Количество = 0 Тогда				
				
				Товар.Количество = РезультатЗапроса.КоличествоСтрок * РезультатЗапроса.ЕдХранОстатковКоэффициент;
				ТекстОшибки = "ПТУ "+ ПТУСсылка + " Товар " + Товар.Номенклатура + " строк " + Строка(РезультатЗапроса.КоличествоСтрок) +
				" коэфф " + Строка(РезультатЗапроса.ЕдХранОстатковКоэффициент);
				ЗаписьЖурналаРегистрации("Android нулевое количество товара", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки); 		
				
			КонецЕсли; 
			
			Товар.Ячейка = РезультатЗапроса.Ячейка;
			Товар.ВведеноВручную = РезультатЗапроса.ВведеноВРучную;
			
		КонецЦикла; 
		
		Попытка
			
			ДокументРазмещения.Записать();
			ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Записан документ размещения по ячейкам", Строка(ДокументРазмещения.Номер)); 
			
			Попытка				
				
				ДокументРазмещения.Записать(РежимЗаписиДокумента.Проведение);				
				ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Документ размещения по ячейкам проведен", Строка(ДокументРазмещения.Номер)); 
				
				Если DeleteRecordsFromBuffer = Истина Тогда
					
					РС = РегистрыСведений.БуферАрмКладовщика.СоздатьНаборЗаписей();
					РС.Отбор.Объект.Установить(ПТУСсылка);
					РС.Отбор.UserId.Установить(UserIdСсылка);
					РС.Записать();
					
				КонецЕсли; 
				
				ЗафиксироватьТранзакцию();
				
			Исключение	
				
				ОтменитьТранзакцию();
				
				ТекстОшибки = "Документ """ + ДокументРазмещения.Ссылка + """ успешно записан в базу 1С, но не проведен.";				
				Результат.Вставить("Ошибка", ТекстОшибки);
				Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
				Возврат Результат;				
				
			КонецПопытки; 
			
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстОшибки = "Ошибка при записи документа в 1С: " + ОписаниеОшибки() + ".";				
			Результат.Вставить("Ошибка", ТекстОшибки);
			Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
			Возврат Результат;
			
		КонецПопытки;           
		
		Результат.Вставить("Ошибка", "");
		Результат.Вставить("НомерДокумента", ДокументРазмещения.Номер);
		Результат.Вставить("ДатаДокумента", ДокументРазмещения.Дата);
		Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
		Возврат Результат;
		
	Исключение
		
		ОтменитьТранзакцию();
		
		СтруктураОшибки = Новый Структура;
		СтруктураОшибки.Вставить("Ошибка", ОписаниеОшибки()); 
		Результат = ARMStoreKeeper.ДанныеВJSONХранилище(СтруктураОшибки);
		Возврат Результат;
		
	КонецПопытки; 
	
КонецФункции

Функция ЗаписатьМаркировкиВДокументПТУ(DocumentBaseGUID, UserIdGUID, DeleteRecordsFromBuffer = Ложь) Экспорт
	
	//+Кабанов А.В. 29.08.2025 # UT10-5361
	Результат = Новый Структура;
	Результат.Вставить("Ошибка", "");   
	
	УстановитьПривилегированныйРежим(Истина);
	
	ПТУСсылка = Документы.ПоступлениеТоваровУслуг.ПолучитьСсылку(Новый УникальныйИдентификатор(DocumentBaseGUID)); 

	ПТУОбъект = ПТУСсылка.ПолучитьОбъект();
	
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);
	
	НачатьТранзакцию();
	
	Запрос = Новый Запрос;     
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	БуферАрмКладовщикаМаркировки.Объект,
	|	БуферАрмКладовщикаМаркировки.Номенклатура,
	|	БуферАрмКладовщикаМаркировки.UserId,
	|	БуферАрмКладовщикаМаркировки.Barcode,
	|	БуферАрмКладовщикаМаркировки.BarcodeFull,
	|	БуферАрмКладовщикаМаркировки.CreateDate
	|ПОМЕСТИТЬ ВТ_БуферМаркировок
	|ИЗ
	|	РегистрСведений.БуферАрмКладовщикаМаркировки КАК БуферАрмКладовщикаМаркировки
	|ГДЕ
	|	БуферАрмКладовщикаМаркировки.Объект = &Объект
	|	И БуферАрмКладовщикаМаркировки.UserId = &UserId
	|	И (БуферАрмКладовщикаМаркировки.Объект ССЫЛКА Документ.ПоступлениеТоваровУслуг
	|			ИЛИ БуферАрмКладовщикаМаркировки.Объект ССЫЛКА Документ.ПоступлениеТоваровНаОтветственноеХранение)
	|
	|СГРУППИРОВАТЬ ПО
	|	БуферАрмКладовщикаМаркировки.Объект,
	|	БуферАрмКладовщикаМаркировки.Номенклатура,
	|	БуферАрмКладовщикаМаркировки.UserId,
	|	БуферАрмКладовщикаМаркировки.Barcode,
	|	БуферАрмКладовщикаМаркировки.BarcodeFull,
	|	БуферАрмКладовщикаМаркировки.CreateDate
	|
	|ДЛЯ ИЗМЕНЕНИЯ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_БуферМаркировок.Объект,
	|	ВТ_БуферМаркировок.Номенклатура,
	|	ВТ_БуферМаркировок.UserId,
	|	ВТ_БуферМаркировок.Barcode,
	|	МАКСИМУМ(ВТ_БуферМаркировок.BarcodeFull) КАК BarcodeFull,
	|	МАКСИМУМ(ЕСТЬNULL(ШтрихкодыНоменклатуры.Ссылка, ЗНАЧЕНИЕ(Справочник.ШтрихКодыНоменклатуры.ПустаяСсылка))) КАК КодМаркировки,
	|	ВТ_БуферМаркировок.CreateDate
	|ПОМЕСТИТЬ ВТ_БуферСоСправочником
	|ИЗ
	|	ВТ_БуферМаркировок КАК ВТ_БуферМаркировок
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
	|		ПО ВТ_БуферМаркировок.Номенклатура = ШтрихкодыНоменклатуры.Номенклатура
	|			И (ШтрихкодыНоменклатуры.КодМаркировки = ВТ_БуферМаркировок.Barcode
	|				ИЛИ ШтрихкодыНоменклатуры.КодМаркировки = ВТ_БуферМаркировок.BarcodeFull)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_БуферМаркировок.Объект,
	|	ВТ_БуферМаркировок.Номенклатура,
	|	ВТ_БуферМаркировок.UserId,
	|	ВТ_БуферМаркировок.Barcode,
	|	ВТ_БуферМаркировок.CreateDate
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_БуферСоСправочником.Объект,
	|	ВТ_БуферСоСправочником.Номенклатура,
	|	ВТ_БуферСоСправочником.UserId,
	|	ВТ_БуферСоСправочником.Barcode,
	|	ВТ_БуферСоСправочником.BarcodeFull,
	|	ВТ_БуферСоСправочником.КодМаркировки,
	|	ВТ_БуферСоСправочником.CreateDate
	|ИЗ
	|	ВТ_БуферСоСправочником КАК ВТ_БуферСоСправочником
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг.ОтсканированныеКодыМаркировки КАК ПоступлениеТоваровУслугОтсканированныеКодыМаркировки
	|		ПО ВТ_БуферСоСправочником.Объект = ПоступлениеТоваровУслугОтсканированныеКодыМаркировки.Ссылка
	|			И ВТ_БуферСоСправочником.КодМаркировки = ПоступлениеТоваровУслугОтсканированныеКодыМаркировки.КодМаркировки
	|ГДЕ
	|	ПоступлениеТоваровУслугОтсканированныеКодыМаркировки.НомерСтроки ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("Объект", ПТУСсылка);
	Запрос.УстановитьПараметр("UserId", UserIdСсылка);                                          
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Количество() = 0  Тогда	
		
		ОтменитьТранзакцию();
		
		//+Шульман А. 17.10.2025 #UT10-5472  
		Маркировка.СоздатьМаркировкуПриПоступлении(ПТУСсылка);
		//-Шульман А. 17.10.2025 #UT10-5472
		
		ТекстОшибки = "Отсутствуют отсканированные маркировки";				
		Результат.Вставить("Ошибка", ТекстОшибки);
		Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
		Возврат Результат;
		
	КонецЕсли;	                              
	
	Попытка
		
		ДобавлялиВПТУ = Ложь;
		
		Пока РезультатЗапроса.Следующий() Цикл
			
			мКодМаркировки = РезультатЗапроса.КодМаркировки;
			
			Если мКодМаркировки.Пустая() Тогда
				
				мКодМаркировки                = Справочники.ШтрихкодыНоменклатуры.СоздатьЭлемент();
				мКодМаркировки.Номенклатура   = РезультатЗапроса.Номенклатура;
			    мКодМаркировки.КодМаркировки  = РезультатЗапроса.Barcode;
				мКодМаркировки.ТипУпаковки    = Перечисления.ТипУпаковкиМаркировки.МаркированныйТовар;
				мКодМаркировки.ТипПоступления = 1;
                мКодМаркировки.Записать();
				
			КонецЕсли;
			
			ЕстьКодМаркировкиВДокументе = ПТУОбъект.ОтсканированныеКодыМаркировки.Найти(мКодМаркировки , "КодМаркировки");
			
			Если ЕстьКодМаркировкиВДокументе = Неопределено Тогда
				
				НоваяСтрокаОтсканированныхМаркировок = ПТУОбъект.ОтсканированныеКодыМаркировки.Добавить();
				НоваяСтрокаОтсканированныхМаркировок.КодМаркировки = мКодМаркировки.Ссылка;      
				//+Шульман А. 11.11.2025 #UT10-5502    
				НоваяСтрокаОтсканированныхМаркировок.Кладовщик = UserIdСсылка;
				//-Шульман А. 11.11.2025 #UT10-5502  
				//+Шульман А. 01.12.2025 #UT10-5559   
				НоваяСтрокаОтсканированныхМаркировок.ДатаСканирования = РезультатЗапроса.CreateDate;
				//-Шульман А. 01.12.2025 #UT10-5559
				ДобавлялиВПТУ = Истина;
				
			КонецЕсли;
						
		КонецЦикла;
		
		Если ДобавлялиВПТУ Тогда
			 ПТУОбъект.Записать(РежимЗаписиДокумента.Проведение);	 
		//+Шульман А. 17.10.2025 #UT10-5472         
		Иначе
			Маркировка.СоздатьМаркировкуПриПоступлении(ПТУСсылка);
		//-Шульман А. 17.10.2025 #UT10-5472
		КонецЕсли;
		
		Если DeleteRecordsFromBuffer = Истина Тогда
			
			РС = РегистрыСведений.БуферАрмКладовщикаМаркировки.СоздатьНаборЗаписей();
			РС.Отбор.Объект.Установить(ПТУСсылка);
			РС.Отбор.UserId.Установить(UserIdСсылка);
			РС.Записать();
			
		КонецЕсли; 
		
		ЗафиксироватьТранзакцию();
		
		Результат.Вставить("Ошибка"         , "");
		Результат.Вставить("НомерДокумента" , ПТУОбъект.Номер);
		Результат.Вставить("ДатаДокумента"  , ПТУОбъект.Дата);
		Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
		Возврат Результат;

	Исключение
		
		ОтменитьТранзакцию();
		
		СтруктураОшибки = Новый Структура;
		СтруктураОшибки.Вставить("Ошибка", ОписаниеОшибки()); 
		Результат = ARMStoreKeeper.ДанныеВJSONХранилище(СтруктураОшибки);
		Возврат Результат;
		
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	//+Кабанов А.В. 29.08.2025 # UT10-5361
КонецФункции

Функция СоздатьДокументПеремещенияТоваровМеждуЯчейками_Старая(UserIdGUID, CellFromGUID, CellToGUID) Экспорт
	
	Результат = Новый Структура;                                    
	Результат.Вставить("Ошибка", "");
	
	Если ЗначениеЗаполнено(CellFromGUID) Тогда
		ЯчейкаОткудаСсылка = Справочники.Ячейки.ПолучитьСсылку( Новый УникальныйИдентификатор(CellFromGUID));	
	Иначе 
		ЯчейкаОткудаСсылка = Справочники.Ячейки.ПустаяСсылка();	
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(CellToGUID) Тогда
		ЯчейкаКудаСсылка = Справочники.Ячейки.ПолучитьСсылку( Новый УникальныйИдентификатор(CellToGUID));		
	Иначе
		ЯчейкаКудаСсылка = Справочники.Ячейки.ПустаяСсылка();		
	КонецЕсли; 	
	
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);	
	
	ИспользоватьПоискПоЯчейкам = Ложь;
	
	Если ЗначениеЗаполнено(CellFromGUID) Или ЗначениеЗаполнено(CellToGUID) Тогда
		ИспользоватьПоискПоЯчейкам = Истина;
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	БуферАРМКладовшикаПеремещение.UserId КАК UserId,
	|	БуферАРМКладовшикаПеремещение.ЯчейкаОткуда КАК ЯчейкаОткуда,
	|	БуферАРМКладовшикаПеремещение.ЯчейкаКуда,
	|	БуферАРМКладовшикаПеремещение.Номенклатура,
	|	СУММА(БуферАРМКладовшикаПеремещение.Quantity) КАК Quantity,
	|	МАКСИМУМ(БуферАРМКладовшикаПеремещение.КодПроизводителя) КАК КодПроизводителя,
	|	МАКСИМУМ(БуферАРМКладовшикаПеремещение.ВведеноВРучную) КАК ВведеноВРучную
	|ИЗ
	|	РегистрСведений.БуферАРМКладовшикаПеремещение КАК БуферАРМКладовшикаПеремещение
	|ГДЕ
	|	БуферАРМКладовшикаПеремещение.UserId = &UserId
	|	И (&ИспользоватьПоискПоЯчейкам
	|				И БуферАРМКладовшикаПеремещение.ЯчейкаОткуда = &ЯчейкаОткуда
	|				И БуферАРМКладовшикаПеремещение.ЯчейкаКуда = &ЯчейкаКуда
	|			ИЛИ НЕ &ИспользоватьПоискПоЯчейкам)
	|
	|СГРУППИРОВАТЬ ПО
	|	БуферАРМКладовшикаПеремещение.UserId,
	|	БуферАРМКладовшикаПеремещение.ЯчейкаОткуда,
	|	БуферАРМКладовшикаПеремещение.ЯчейкаКуда,
	|	БуферАРМКладовшикаПеремещение.Номенклатура
	|
	|УПОРЯДОЧИТЬ ПО
	|	UserId,
	|	ЯчейкаОткуда
	|АВТОУПОРЯДОЧИВАНИЕ";	                    
	
	Запрос.УстановитьПараметр("ИспользоватьПоискПоЯчейкам", ИспользоватьПоискПоЯчейкам);	
	Запрос.УстановитьПараметр("UserId", UserIdСсылка);
	Запрос.УстановитьПараметр("ЯчейкаОткуда", ЯчейкаОткудаСсылка);	
	Запрос.УстановитьПараметр("ЯчейкаКуда", ЯчейкаКудаСсылка);	
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Количество() = 0  Тогда	
		
		ТекстОшибки = "Отсутствуют отсканированные товары для перемещения.";				
		Результат.Вставить("Ошибка", ТекстОшибки);
		Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
		Возврат Результат;
		
	КонецЕсли;	                      
	
	Попытка                                                              
		
		РезультатЗапроса.Следующий();
		// Шапка документа	
		ДокументПеремещения = Документы.ПеремещениеТовараПоЯчейкам.СоздатьДокумент();
		ДокументПеремещения.Клеверенс = Истина;        
		ДокументПеремещения.Ответственный = UserIdСсылка;
		ДокументПеремещения.Дата = ТекущаяДата();		
		ДокументПеремещения.Склад       = Константы.ОсновнойСклад.Получить();
		ДокументПеремещения.Ячейка      = РезультатЗапроса.ЯчейкаОткуда;
		ДокументПеремещения.ЯчейкаКуда  = РезультатЗапроса.ЯчейкаКуда;
		КомментарийТекст = "откуда: " + ДокументПеремещения.Ячейка + " куда: " + ДокументПеремещения.ЯчейкаКуда; 
		ДокументПеремещения.Комментарий = КомментарийТекст;
		////////////////////////	
		
		ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Создан документ перемещения товара по ячейкам", Строка(ДокументПеремещения.Номер)); 
		
		Товар = ДокументПеремещения.Товары.Добавить();	
		Товар.ВведеноВручную = РезультатЗапроса.ВведеноВРучную;
		Товар.Номенклатура   = РезультатЗапроса.Номенклатура;
		Товар.Количество     = РезультатЗапроса.Quantity;
		Товар.Ячейка         = РезультатЗапроса.ЯчейкаОткуда;
		Товар.ЯчейкаКуда     = РезультатЗапроса.ЯчейкаКуда;
		
		Пока РезультатЗапроса.Следующий() Цикл                                    
			
			Товар = ДокументПеремещения.Товары.Добавить();	
			Товар.ВведеноВручную = РезультатЗапроса.ВведеноВРучную;
			Товар.Номенклатура   = РезультатЗапроса.Номенклатура;
			Товар.Количество     = РезультатЗапроса.Quantity;               
			Товар.Ячейка         = РезультатЗапроса.ЯчейкаОткуда;
			Товар.ЯчейкаКуда     = РезультатЗапроса.ЯчейкаКуда;
			
		КонецЦикла;     
		
		Попытка
			
			ДокументПеремещения.Записать();
			ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Записан документ перемещения товара по ячейкам", Строка(ДокументПеремещения.Номер)); 
			
			Попытка				
				
				ДокументПеремещения.Записать(РежимЗаписиДокумента.Проведение);				
				ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Документ перемещения товара по ячейкам проведен", Строка(ДокументПеремещения.Номер)); 
				
				РС = РегистрыСведений.БуферАРМКладовшикаПеремещение.СоздатьНаборЗаписей();
				РС.Отбор.UserId.Установить(UserIdСсылка);
				
				Если ЯчейкаОткудаСсылка <>  Справочники.Ячейки.ПустаяСсылка()  Тогда
					РС.Отбор.ЯчейкаОткуда.Установить(ЯчейкаОткудаСсылка);					
				КонецЕсли; 
				
				РС.Записать();
				
			Исключение				
				
				ТекстОшибки = "Документ """ + ДокументПеремещения.Ссылка + """ успешно записан в базу 1С, но не проведен.";				
				Результат.Вставить("Ошибка", ТекстОшибки);
				Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
				Возврат Результат;				
				
			КонецПопытки; 
			
		Исключение
			
			ТекстОшибки = "Ошибка при записи документа в 1С: " + ОписаниеОшибки() + ".";				
			Результат.Вставить("Ошибка", ТекстОшибки);
			Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
			Возврат Результат;
			
		КонецПопытки; 
		
		Результат.Вставить("Ошибка", "");
		Результат.Вставить("НомерДокумента", ДокументПеремещения.Номер);                
		Результат.Вставить("ДатаДокумента", ДокументПеремещения.Дата);
		Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
		Возврат Результат;
		
	Исключение
		
		СтруктураОшибки = Новый Структура;
		СтруктураОшибки.Вставить("Ошибка", ОписаниеОшибки()); 
		Результат = ARMStoreKeeper.ДанныеВJSONХранилище(СтруктураОшибки);
		Возврат Результат;
		
	КонецПопытки; 
	
КонецФункции

Функция СоздатьДокументПеремещенияТоваровМеждуЯчейками(UserIdGUID, CellFromGUID, CellToGUID) Экспорт
	
	Результат = Новый Структура;                                    
	Результат.Вставить("Ошибка", "");
	
	Если ЗначениеЗаполнено(CellFromGUID) Тогда
		ЯчейкаОткудаСсылка = Справочники.Ячейки.ПолучитьСсылку(Новый УникальныйИдентификатор(CellFromGUID));	
	Иначе 
		ЯчейкаОткудаСсылка = Справочники.Ячейки.ПустаяСсылка();	
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(CellToGUID) Тогда
		ЯчейкаКудаСсылка = Справочники.Ячейки.ПолучитьСсылку(Новый УникальныйИдентификатор(CellToGUID));		
	Иначе
		ЯчейкаКудаСсылка = Справочники.Ячейки.ПустаяСсылка();		
	КонецЕсли; 	
	
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);	
	
	ИспользоватьПоискПоЯчейкам = Ложь;
	
	Если ЗначениеЗаполнено(CellFromGUID) Или ЗначениеЗаполнено(CellToGUID) Тогда
		ИспользоватьПоискПоЯчейкам = Истина;
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	БуферАРМКладовшикаПеремещение.UserId КАК UserId,
	|	БуферАРМКладовшикаПеремещение.ЯчейкаОткуда КАК ЯчейкаОткуда,
	|	БуферАРМКладовшикаПеремещение.ЯчейкаКуда,
	|	БуферАРМКладовшикаПеремещение.Номенклатура,
	|	СУММА(БуферАРМКладовшикаПеремещение.Quantity) КАК Quantity,
	|	МАКСИМУМ(БуферАРМКладовшикаПеремещение.КодПроизводителя) КАК КодПроизводителя,
	|	МАКСИМУМ(БуферАРМКладовшикаПеремещение.ВведеноВРучную) КАК ВведеноВРучную
	|ПОМЕСТИТЬ ТаблБуфера
	|ИЗ
	|	РегистрСведений.БуферАРМКладовшикаПеремещение КАК БуферАРМКладовшикаПеремещение
	|ГДЕ
	|	БуферАРМКладовшикаПеремещение.UserId = &UserId
	|	И (&ИспользоватьПоискПоЯчейкам
	|				И БуферАРМКладовшикаПеремещение.ЯчейкаОткуда = &ЯчейкаОткуда
	|				И БуферАРМКладовшикаПеремещение.ЯчейкаКуда = &ЯчейкаКуда
	|			ИЛИ НЕ &ИспользоватьПоискПоЯчейкам)
	|
	|СГРУППИРОВАТЬ ПО
	|	БуферАРМКладовшикаПеремещение.UserId,
	|	БуферАРМКладовшикаПеремещение.ЯчейкаОткуда,
	|	БуферАРМКладовшикаПеремещение.ЯчейкаКуда,
	|	БуферАРМКладовшикаПеремещение.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблБуфера.UserId,
	|	ТаблБуфера.ЯчейкаОткуда,
	|	ТаблБуфера.ЯчейкаКуда,
	|	ТаблБуфера.Номенклатура,
	|	СУММА(ВЫБОР
	|			КОГДА ЕСТЬNULL(ТоварыВЯчейкахОстатки.КоличествоОстаток, 0) <= ТаблБуфера.Quantity
	|				ТОГДА ЕСТЬNULL(ТоварыВЯчейкахОстатки.КоличествоОстаток, 0)
	|			ИНАЧЕ ТаблБуфера.Quantity
	|		КОНЕЦ) КАК Quantity,
	|	ТаблБуфера.КодПроизводителя,
	|	ТаблБуфера.ВведеноВРучную,
	|	СУММА(ВЫБОР
	|			КОГДА ЕСТЬNULL(ТоварыВЯчейкахОстатки.КоличествоОстаток, 0) >= ТаблБуфера.Quantity
	|				ТОГДА 0
	|			ИНАЧЕ ТаблБуфера.Quantity - ЕСТЬNULL(ТоварыВЯчейкахОстатки.КоличествоОстаток, 0)
	|		КОНЕЦ) КАК КоличествоВернуть
	|ИЗ
	|	ТаблБуфера КАК ТаблБуфера
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках.Остатки КАК ТоварыВЯчейкахОстатки
	|		ПО ТаблБуфера.ЯчейкаОткуда = ТоварыВЯчейкахОстатки.Ячейка
	|			И ТаблБуфера.Номенклатура = ТоварыВЯчейкахОстатки.Номенклатура
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблБуфера.UserId,
	|	ТаблБуфера.ЯчейкаОткуда,
	|	ТаблБуфера.ЯчейкаКуда,
	|	ТаблБуфера.Номенклатура,
	|	ТаблБуфера.КодПроизводителя,
	|	ТаблБуфера.ВведеноВРучную";
	
	Запрос.УстановитьПараметр("ИспользоватьПоискПоЯчейкам", ИспользоватьПоискПоЯчейкам);	
	Запрос.УстановитьПараметр("UserId", UserIdСсылка);
	Запрос.УстановитьПараметр("ЯчейкаОткуда", ЯчейкаОткудаСсылка);	
	Запрос.УстановитьПараметр("ЯчейкаКуда", ЯчейкаКудаСсылка);	
	
	РезультатЗапросаОсн = Запрос.Выполнить();
	
	Если НЕ РезультатЗапросаОсн.Пустой() Тогда
		
		// Шапка документа	
		ДокументПеремещения = Документы.ПеремещениеТовараПоЯчейкам.СоздатьДокумент();
		ДокументПеремещения.Клеверенс = Истина;        
		ДокументПеремещения.Ответственный = UserIdСсылка;
		ДокументПеремещения.Дата = ТекущаяДата();		
		ДокументПеремещения.Склад       = Константы.ОсновнойСклад.Получить();
		ДокументПеремещения.Ячейка      = ЯчейкаОткудаСсылка;
		ДокументПеремещения.ЯчейкаКуда  = ЯчейкаКудаСсылка;
		КомментарийТекст = "Откуда: " + ЯчейкаОткудаСсылка + " куда: " + ЯчейкаКудаСсылка; 
		ДокументПеремещения.Комментарий = КомментарийТекст;
		////////////////////////
		
		ТекстТоварыВернуть = "";
		РезультатЗапроса = РезультатЗапросаОсн.Выбрать();
		
		Пока РезультатЗапроса.Следующий() Цикл                                    
			
			Если НЕ РезультатЗапроса.Quantity = 0 Тогда
				
				Товар = ДокументПеремещения.Товары.Добавить();	
				Товар.ВведеноВручную = РезультатЗапроса.ВведеноВРучную;
				Товар.Номенклатура   = РезультатЗапроса.Номенклатура;
				Товар.Количество     = РезультатЗапроса.Quantity;               
				Товар.Ячейка         = РезультатЗапроса.ЯчейкаОткуда;
				Товар.ЯчейкаКуда     = РезультатЗапроса.ЯчейкаКуда;
				
			КонецЕсли;
			
			Если НЕ РезультатЗапроса.КоличествоВернуть = 0 Тогда
				ТекстТоварыВернуть = ТекстТоварыВернуть + ?(ТекстТоварыВернуть = "","",Символы.ПС) + "Необходимо вернуть "
				+ СокрЛП(РезультатЗапроса.КоличествоВернуть) + " шт. товара " + СокрЛП(РезультатЗапроса.КодПроизводителя)
				+ " " + СокрЛП(РезультатЗапроса.Номенклатура) + " в ячейку " + СокрЛП(РезультатЗапроса.ЯчейкаОткуда) + "";
			КонецЕсли;			
			
		КонецЦикла;                   
		
		Если НЕ ДокументПеремещения.Товары.Количество() = 0 Тогда  
			
			ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Создан документ перемещения товара по ячейкам", Строка(ДокументПеремещения.Номер));
			
			Попытка
				
				ДокументПеремещения.Записать();	
				ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Записан документ перемещения товара по ячейкам", Строка(ДокументПеремещения.Номер));
				
			Исключение            				
				
				ТекстОшибки = ТекстТоварыВернуть+?(ТекстТоварыВернуть = "","",Символы.ПС)+"Ошибка при записи документа в 1С: " + ОписаниеОшибки() + ".";				
				Результат.Вставить("Ошибка", ТекстОшибки);
				Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
				Возврат Результат;				
				
			КонецПопытки;
			
		Иначе
			
			РС = РегистрыСведений.БуферАРМКладовшикаПеремещение.СоздатьНаборЗаписей();
			РС.Отбор.UserId.Установить(UserIdСсылка);
			
			Если ЯчейкаОткудаСсылка <>  Справочники.Ячейки.ПустаяСсылка()  Тогда
				РС.Отбор.ЯчейкаОткуда.Установить(ЯчейкаОткудаСсылка);					
			КонецЕсли; 
			
			РС.Записать();
			ТекстОшибки = "Документ не создан . Отсутствуют товары для перемещения в ячейке " + СокрЛП(ЯчейкаОткудаСсылка) + "." 
			+ ?(ТекстТоварыВернуть = "","",Символы.ПС) + ТекстТоварыВернуть;				
			
			Результат.Вставить("Ошибка", ТекстОшибки);
			Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
			
			Возврат Результат;
			
		КонецЕсли;
		
		Попытка				
			
			ДокументПеремещения.Записать(РежимЗаписиДокумента.Проведение);				
			ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Документ перемещения товара по ячейкам проведен", Строка(ДокументПеремещения.Номер)); 
			
			РС = РегистрыСведений.БуферАРМКладовшикаПеремещение.СоздатьНаборЗаписей();
			РС.Отбор.UserId.Установить(UserIdСсылка);
			
			Если ЯчейкаОткудаСсылка <>  Справочники.Ячейки.ПустаяСсылка()  Тогда
				РС.Отбор.ЯчейкаОткуда.Установить(ЯчейкаОткудаСсылка);					
			КонецЕсли; 
			
			РС.Записать();
			
		Исключение				
			
			ТекстОшибки = ТекстТоварыВернуть+?(ТекстТоварыВернуть = "", "", Символы.ПС) + "Документ """ + ДокументПеремещения.Ссылка + """ успешно записан в базу 1С, но не проведен.";				
			Результат.Вставить("Ошибка", ТекстОшибки);
			Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
			
			Возврат Результат;				
			
		КонецПопытки; 
		
		Результат.Вставить("Ошибка", ТекстТоварыВернуть);
		Результат.Вставить("НомерДокумента", ДокументПеремещения.Номер);                
		Результат.Вставить("ДатаДокумента", ДокументПеремещения.Дата);
		Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
		Возврат Результат;
		
	Иначе
		
		ТекстОшибки = "Отсутствуют отсканированные товары для перемещения.";				
		Результат.Вставить("Ошибка", ТекстОшибки);
		Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
		Возврат Результат;
		
	КонецЕсли;

КонецФункции

Функция ПолучитьСписокЯчеекДляПеремещения(UserIdGUID) Экспорт
	
	Результат = Новый Структура;                                    
	Результат.Вставить("Ошибка", "");
	
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	БуферАРМКладовшикаПеремещение.ЯчейкаОткуда КАК СсылкаЯчейки,
	|	БуферАРМКладовшикаПеремещение.ЯчейкаКуда КАК СсылкаЯчейкиКуда
	|ИЗ
	|	РегистрСведений.БуферАРМКладовшикаПеремещение КАК БуферАРМКладовшикаПеремещение
	|ГДЕ
	|	БуферАРМКладовшикаПеремещение.UserId = &UserId
	|
	|СГРУППИРОВАТЬ ПО
	|	БуферАРМКладовшикаПеремещение.UserId,
	|	БуферАРМКладовшикаПеремещение.ЯчейкаОткуда,
	|	БуферАРМКладовшикаПеремещение.ЯчейкаКуда";	
	
	Запрос.УстановитьПараметр("UserId", UserIdСсылка);
	
	УстановитьПривилегированныйРежим(Истина);
	ТЗ = Запрос.Выполнить().Выгрузить();	
	УстановитьПривилегированныйРежим(Ложь);
	
	Если ТЗ.Количество() = 0 Тогда
		
		ТекстОшибки = "Отсутствуют отсканированные товары для перемещения.";				
		Результат.Вставить("Ошибка", ТекстОшибки);
		Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
		Возврат Результат;
		
	КонецЕсли;	                      
	
	МассивВременный = ТаблицуВМассив(ТЗ);                                    
	Результат = ДанныеВJSONХранилище(МассивВременный);
	
	ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Получить список ячеек для перемещения", ""); 
	Возврат Результат;
	
КонецФункции

Функция ЗначениеГУИД(СтрокаГУИД)
	
	Попытка
		
		ИД = Новый УникальныйИдентификатор(СтрокаГУИД);
		Результат = Истина;
		
	Исключение
		Результат = Ложь;
	КонецПопытки;	
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСписокЗаписейИзБуфераРазмещения(UserIdGUID, ОbjectIdGUID) Экспорт
	
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	БуферАрмКладовщика.Объект,
	|	СпрНоменклатура.Ссылка КАК СсылкаТовара,
	|	СпрНоменклатура.Наименование КАК НаименованиеТовара,
	|	БуферАрмКладовщика.КодПроизводителя КАК КодПроизводителяТовара,
	|	ЕСТЬNULL(СпрНоменклатура.Родитель.Наименование, """") КАК Производитель,
	|	БуферАрмКладовщика.Ячейка.Код КАК Ячейка,
	|	СУММА(БуферАрмКладовщика.Quantity) КАК КоличествоТовара,
	|	ЕСТЬNULL(СпрНоменклатура.ГруппаАВСФилиала.Наименование, ""Е"") КАК ГруппаАВСФилиала
	|ИЗ
	|	РегистрСведений.БуферАрмКладовщика КАК БуферАрмКладовщика
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО БуферАрмКладовщика.Номенклатура = СпрНоменклатура.Ссылка
	|ГДЕ
	|	БуферАрмКладовщика.Объект = &ОbjectIdGUID
	|	И БуферАрмКладовщика.UserId = &UserIdСсылка
	|
	|СГРУППИРОВАТЬ ПО
	|	БуферАрмКладовщика.Объект,
	|	СпрНоменклатура.Ссылка,
	|	СпрНоменклатура.Наименование,
	|	БуферАрмКладовщика.КодПроизводителя,
	|	БуферАрмКладовщика.Ячейка.Код,
	|	ЕСТЬNULL(СпрНоменклатура.ГруппаАВСФилиала.Наименование, ""Е""),
	|	ЕСТЬNULL(СпрНоменклатура.Родитель.Наименование, """")";
	
	
	ДокументСсылка = Документы.ПоступлениеТоваровУслуг.ПолучитьСсылку(Новый УникальныйИдентификатор(ОbjectIdGUID));

	Если ДокументСсылка.ПолучитьОбъект() = Неопределено Тогда
		ДокументСсылка = Документы.ПоступлениеТоваровНаОтветственноеХранение.ПолучитьСсылку(Новый УникальныйИдентификатор(ОbjectIdGUID));
	КонецЕсли;

	Запрос.УстановитьПараметр("ОbjectIdGUID", ДокументСсылка);
	Запрос.УстановитьПараметр("UserIdСсылка", UserIdСсылка);
	
	УстановитьПривилегированныйРежим(Истина);	
	ТЗ = Запрос.Выполнить().Выгрузить();	
	УстановитьПривилегированныйРежим(Ложь);
	
	//Возврат Сериализовать(ТЗ);                                             
	МассивВременный = ТаблицуВМассив(ТЗ);
	Результат = ДанныеВJSONХранилище(МассивВременный);
	
	ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Получить список записей из буфера размещения", Строка(ДокументСсылка.Номер)); 
	
	Возврат Результат;
	
КонецФункции 

