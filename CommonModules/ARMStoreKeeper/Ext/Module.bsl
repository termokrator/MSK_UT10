Функция РазностьВремени(Время1, Время2);
	
	Разность = Время1 - Время2;
	
	Если Разность > 0 Тогда
		
		Часов = Цел(Разность / 3600);
		Минут = Цел((Разность - Часов * 3600) / 60);
		
		Возврат Дата(1, 1, 1, Часов, Минут, 0);
		
	Иначе
		Возврат Дата(1,1,1,0,0,0);
	КонецЕсли;
	
КонецФункции

