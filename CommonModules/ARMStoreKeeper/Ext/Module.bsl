Функция ПолучитьОписаниеТовара(ГУИД, UserIdGUID) Экспорт  
	
	НоменклатураСсылка = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(ГУИД));
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК СсылкаТовара,
	|	Номенклатура.Код,
	|	Номенклатура.Наименование,
	|	Номенклатура.Артикул,
	|	Номенклатура.КодПроизводителя,
	|	Номенклатура.ЕдиницаХраненияОстатков.Наименование КАК ЕдИзмНаименование
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка",НоменклатураСсылка );
	
	УстановитьПривилегированныйРежим(Истина);
	ТЗ = Запрос.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);	 
	
	МассивВременный = ТаблицуВМассив(ТЗ);
	Результат = ДанныеВJSONХранилище(МассивВременный);
	
	ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Получить описание товара", НоменклатураСсылка.Наименование); 	
	
	Возврат Результат;
	
