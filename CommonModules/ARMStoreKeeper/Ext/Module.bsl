	|		ИЗ
	|			Документ.ПоступлениеТоваровУслуг.КодыМаркировки КАК ПоступлениеТоваровУслугКодыМаркировки
	|		ГДЕ
	|			ПоступлениеТоваровУслугКодыМаркировки.Ссылка = &ОbjectIdGUID
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ПоступлениеТоваровУслугКодыМаркировки.Ссылка,
	|			ПоступлениеТоваровУслугКодыМаркировки.КодМаркировки.Номенклатура) КАК ОжидаемыеКоды
	|		ПО ТоварВДокументе.Номенклатура = ОжидаемыеКоды.КодМаркировкиНоменклатура
	|			И ТоварВДокументе.СсылкаПТУ = ОжидаемыеКоды.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
	|			ПоступлениеТоваровУслугОтсканированныеКодыМаркировки.Ссылка КАК Ссылка,
	|			ПоступлениеТоваровУслугОтсканированныеКодыМаркировки.КодМаркировки.Номенклатура КАК КодМаркировкиНоменклатура,
	|			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПоступлениеТоваровУслугОтсканированныеКодыМаркировки.КодМаркировки) КАК КодМаркировки
	|		ИЗ
	|			Документ.ПоступлениеТоваровУслуг.ОтсканированныеКодыМаркировки КАК ПоступлениеТоваровУслугОтсканированныеКодыМаркировки
	|		ГДЕ
	|			ПоступлениеТоваровУслугОтсканированныеКодыМаркировки.Ссылка = &ОbjectIdGUID
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ПоступлениеТоваровУслугОтсканированныеКодыМаркировки.Ссылка,
	|			ПоступлениеТоваровУслугОтсканированныеКодыМаркировки.КодМаркировки.Номенклатура) КАК ОтсканированныеКоды
	|		ПО ТоварВДокументе.Номенклатура = ОтсканированныеКоды.КодМаркировкиНоменклатура
	|			И ТоварВДокументе.СсылкаПТУ = ОтсканированныеКоды.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_БуферМаркировок КАК ВТ_БуферМаркировок
	|		ПО ТоварВДокументе.Номенклатура = ВТ_БуферМаркировок.Номенклатура
	|			И ТоварВДокументе.СсылкаПТУ = ВТ_БуферМаркировок.Объект  
	//+Шульман А. 02.10.2025 #UT10-5438
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДокРазмещения КАК ДокРазмещения
	|		ПО ТоварВДокументе.Номенклатура = ДокРазмещения.Номенклатура
	|			И ТоварВДокументе.СсылкаПТУ = ДокРазмещения.Объект
	|			И (ДокРазмещения.Номенклатура.ТребуетсяМаркировка)   
	//-Шульман А. 02.10.2025 #UT10-5438
	|ГДЕ
	|	ТоварВДокументе.ТребуетсяМаркировка
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварВДокументе.СсылкаПТУ,
	|	ТоварВДокументе.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварВДокументе.СсылкаПТУ,
	|	ТоварВДокументе.Номенклатура КАК СсылкаТовара,  
	|	ВЫБОР
	|		КОГДА ТоварВДокументе.ТребуетсяМаркировка
	|			ТОГДА ЕСТЬNULL(ВТ_Маркировка.ОтсканированноКодов, 0)
	|		ИНАЧЕ ТоварВДокументе.КоличествоТовара
	|	КОНЕЦ КАК КоличествоТовара,
	|	ТоварВДокументе.НаименованиеТовара,
	|	ЕСТЬNULL(ТоварВДокументе.Производитель, """") КАК Производитель,
	|	ТоварВДокументе.КодПроизводителяТовара,
	|	ТоварВДокументе.КодЕдиИзм,
	|	ТоварВДокументе.ЕдИзмНаименование,
	|	ЕСТЬNULL(БуферРС.КоличествоТовараНабрано, 0) КАК КоличествоТовараНабрано,
	|	ЕСТЬNULL(ДокРазмещения.КоличествоВРазмещении, 0) КАК КоличествоВРазмещении,
	|	ТоварВДокументе.НормализованныйКод,
	|	ЕСТЬNULL(ТоварВДокументе.Номенклатура.ГруппаАВСФилиала.Наименование, ""Е"") КАК ГруппаАВСФилиала,
	|	ЕСТЬNULL(ВТ_Маркировка.ОжидаемыхКодов, 0) КАК КоличествоОжидаемыхМаркировок,
	|	ЕСТЬNULL(ВТ_Маркировка.КодовВБуфере, 0) КАК КоличествоВБуфереМаркировок,
	|	ЕСТЬNULL(ВТ_Маркировка.ОтсканированноКодов, 0) КАК КоличествоОтсканированныхМаркировок,
	|	ВЫБОР
	|		КОГДА ТоварВДокументе.ТребуетсяМаркировка
	|			ТОГДА ТоварВДокументе.КоличествоТовара
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК КоличествоТоваровСМаркировкой,
	|	ТоварВДокументе.ТребуетсяМаркировка КАК ТоварТребуетсяМаркировка,
	//+Шульман А. 17.10.2025 #UT10-5472
	|	ТоварВДокументе.ПревышенаДатаМаркировкиОстатков,
	|	ТоварВДокументе.ТоварнаяГруппа
	//-Шульман А. 17.10.2025 #UT10-5472
	|ИЗ
	|	ТоварВДокументе КАК ТоварВДокументе
	|		ЛЕВОЕ СОЕДИНЕНИЕ БуферРС КАК БуферРС
	|		ПО ТоварВДокументе.Номенклатура = БуферРС.Номенклатура
	|			И ТоварВДокументе.СсылкаПТУ = БуферРС.Объект
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДокРазмещения КАК ДокРазмещения
	|		ПО ТоварВДокументе.СсылкаПТУ = ДокРазмещения.Объект
	|			И ТоварВДокументе.Номенклатура = ДокРазмещения.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Маркировка КАК ВТ_Маркировка
	|		ПО ТоварВДокументе.СсылкаПТУ = ВТ_Маркировка.Объект
	|			И ТоварВДокументе.Номенклатура = ВТ_Маркировка.Номенклатура";	

	ДокументСсылка = Документы.ПоступлениеТоваровУслуг.ПолучитьСсылку( Новый УникальныйИдентификатор(ObjectIdGUID));

	Если ДокументСсылка.ПолучитьОбъект() = Неопределено Тогда
		ДокументСсылка = Документы.ПоступлениеТоваровНаОтветственноеХранение.ПолучитьСсылку( Новый УникальныйИдентификатор(ObjectIdGUID));
	КонецЕсли;

	Запрос.УстановитьПараметр("ОbjectIdGUID", ДокументСсылка);  
	
	УстановитьПривилегированныйРежим(Истина);   
	//+Шульман А. 14.10.2025 #UT10-5438                  
	//+Шульман А. 13.11.2025 #UT10-5504 
	//Запрос.УстановитьПараметр("ЯчейкаДляМаркировки", Константы.ЯчейкаДляМаркировки.Получить());
	МассивЯчейкаДляМаркировки = Новый Массив;
	МассивЯчейкаДляМаркировки.Добавить(Константы.ЯчейкаДляМаркировки.Получить());     
	МассивЯчейкаДляМаркировки.Добавить(Константы.ЯчейкаДляПеремаркировки.Получить());
	МассивЯчейкаДляМаркировки.Добавить(Константы.ЯчейкаДляВозвратаПоставщику.Получить());
	Запрос.УстановитьПараметр("ЯчейкаДляМаркировки", МассивЯчейкаДляМаркировки); 
	//Шульман А. 13.11.2025 #UT10-5504 
	//-Шульман А. 14.10.2025 #UT10-5438    
	//+Шульман А. 17.10.2025 #UT10-5472  
	Запрос.УстановитьПараметр("ТекДата", НачалоДня(ТекущаяДата()));
	//-Шульман А. 17.10.2025 #UT10-5472
	
	ТЗ = Запрос.Выполнить().Выгрузить();	
	УстановитьПривилегированныйРежим(Ложь);
	
	МассивВременный = ТаблицуВМассив(ТЗ);
	Результат = ДанныеВJSONХранилище(МассивВременный);
	
	ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Получить остаток по всем товарам из документа", "Документ ПТУ " + ДокументСсылка.Номер);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьОстатокПоВсемГМИзДокумента(ObjectIdGUID, UserIdGUID) Экспорт
	
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);
	ДокументСсылка = Документы.ПоступлениеТоваровУслуг.ПолучитьСсылку(Новый УникальныйИдентификатор(ObjectIdGUID));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПоступлениеТоваровУслугТовары.ГМ,
	|	ПоступлениеТоваровУслугТовары.Ссылка
	|ПОМЕСТИТЬ ВТ_ГМПоступлений
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.Товары КАК ПоступлениеТоваровУслугТовары
	|ГДЕ
	|	ПоступлениеТоваровУслугТовары.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ПоступлениеТоваровУслугТовары.ГМ,
	|	ПоступлениеТоваровУслугТовары.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РазмещениеПоЯчейкамТовары.ГМ
	|ПОМЕСТИТЬ ВТ_ГМРазмещений
	|ИЗ
	|	Документ.РазмещениеПоЯчейкам.Товары КАК РазмещениеПоЯчейкамТовары
	|ГДЕ
	|	РазмещениеПоЯчейкамТовары.Ссылка.ДокументОснование = &Ссылка
	|	И РазмещениеПоЯчейкамТовары.Ссылка.Проведен
	|
	|СГРУППИРОВАТЬ ПО
	|	РазмещениеПоЯчейкамТовары.ГМ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	БуферАрмКладовщикаГМ.ГМ
	|ПОМЕСТИТЬ ВТ_ГМВБуфере
	|ИЗ
	|	РегистрСведений.БуферАрмКладовщикаГМ КАК БуферАрмКладовщикаГМ
	|ГДЕ
	|	БуферАрмКладовщикаГМ.Объект = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	БуферАрмКладовщикаГМ.ГМ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ГМПоступлений.ГМ,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВТ_ГМРазмещений.ГМ, """") <> """"
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК КоличествоРазмещено,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВТ_ГМВБуфере.ГМ, """") <> """"
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК КоличествоНабрано,
	|	ВТ_ГМПоступлений.Ссылка КАК СсылкаПТУ
	|ИЗ
	|	ВТ_ГМПоступлений КАК ВТ_ГМПоступлений
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ГМРазмещений КАК ВТ_ГМРазмещений
	|		ПО ВТ_ГМПоступлений.ГМ = ВТ_ГМРазмещений.ГМ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ГМВБуфере КАК ВТ_ГМВБуфере
	|		ПО ВТ_ГМПоступлений.ГМ = ВТ_ГМВБуфере.ГМ";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	УстановитьПривилегированныйРежим(Истина);
	ТЗ = Запрос.Выполнить().Выгрузить();	
	УстановитьПривилегированныйРежим(Ложь);
	
	МассивВременный = ТаблицуВМассив(ТЗ);
	Результат = ДанныеВJSONХранилище(МассивВременный);
	
	ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Получить остаток по всем ГМ из документа", "Документ ПТУ " + ДокументСсылка.Номер);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьОстатокПоТоваруИзДокумента(UserIdGUID, ObjectIdGUID, Barcode, SelectedProductIdGUID, ПолучитьТЗ = Ложь) Экспорт
	
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	//+Кабанов А.В. 11.09.2025 # UT10-5419
	"ВЫБРАТЬ
	|	Константы.НеПроверятьМаркировкиВЭкспрессах
	|ПОМЕСТИТЬ ВТ_Константа
	|ИЗ
	|	Константы КАК Константы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПоступлениеТоваровУслугТовары.Номенклатура,
	|	СУММА(ПоступлениеТоваровУслугТовары.Количество) КАК Количество,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ПоступлениеТоваровУслугТовары.Ссылка.Экспресс
	|					И ВТ_Константа.НеПроверятьМаркировкиВЭкспрессах
	|				ТОГДА ЛОЖЬ
	|			ИНАЧЕ ПоступлениеТоваровУслугТовары.Номенклатура.ТребуетсяМаркировка
	|		КОНЕЦ) КАК ТребуетсяМаркировка
	|ПОМЕСТИТЬ ТоварВДокументе
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.Товары КАК ПоступлениеТоваровУслугТовары,
	|	ВТ_Константа КАК ВТ_Константа
	|ГДЕ
	|	ПоступлениеТоваровУслугТовары.Ссылка = &ОbjectIdGUID
	|	И ПоступлениеТоваровУслугТовары.Номенклатура = &Номенклатура
	|
	|СГРУППИРОВАТЬ ПО
	|	ПоступлениеТоваровУслугТовары.Номенклатура
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПоступлениеТоваровНаОтветственноеХранениеТовары.Номенклатура,
	|	СУММА(ПоступлениеТоваровНаОтветственноеХранениеТовары.Количество),
	|	ЛОЖЬ
	|ИЗ
	|	Документ.ПоступлениеТоваровНаОтветственноеХранение.Товары КАК ПоступлениеТоваровНаОтветственноеХранениеТовары
	|ГДЕ
	|	ПоступлениеТоваровНаОтветственноеХранениеТовары.Ссылка = &ОbjectIdGUID
	|	И ПоступлениеТоваровНаОтветственноеХранениеТовары.Номенклатура = &Номенклатура
	|
	|СГРУППИРОВАТЬ ПО
	|	ПоступлениеТоваровНаОтветственноеХранениеТовары.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	БуферАрмКладовщика.Номенклатура,
	|	СУММА(БуферАрмКладовщика.Quantity) КАК КоличествоВБуфере
	|ПОМЕСТИТЬ БуферРС
	|ИЗ
	|	РегистрСведений.БуферАрмКладовщика КАК БуферАрмКладовщика
	|ГДЕ
	|	БуферАрмКладовщика.Объект = &ОbjectIdGUID
	|	И БуферАрмКладовщика.Номенклатура = &Номенклатура
	|
	|СГРУППИРОВАТЬ ПО
	|	БуферАрмКладовщика.Номенклатура
	|
	|ДЛЯ ИЗМЕНЕНИЯ
	|	РегистрСведений.БуферАрмКладовщика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РазмещениеПоЯчейкамТовары.Номенклатура,
	|	СУММА(РазмещениеПоЯчейкамТовары.Количество) КАК КоличествоВРазмещении,
	//+Шульман А. 14.10.2025 #UT10-5438
	|	СУММА(ВЫБОР
	|			КОГДА РазмещениеПоЯчейкамТовары.Номенклатура.ТребуетсяМаркировка
	|					И РазмещениеПоЯчейкамТовары.Ячейка В(&ЯчейкаДляМаркировки)
	|				ТОГДА РазмещениеПоЯчейкамТовары.Количество
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоДляПеремаркировки   
	//-Шульман А. 14.10.2025 #UT10-5438
	|ПОМЕСТИТЬ ДокРазмещения
	|ИЗ
	|	Документ.РазмещениеПоЯчейкам.Товары КАК РазмещениеПоЯчейкамТовары
	|ГДЕ
	|	РазмещениеПоЯчейкамТовары.Ссылка.ДокументОснование = &ОbjectIdGUID
	|	И РазмещениеПоЯчейкамТовары.Номенклатура = &Номенклатура
	|	И РазмещениеПоЯчейкамТовары.Ссылка.Проведен = ИСТИНА
	|	И РазмещениеПоЯчейкамТовары.Ссылка.ПометкаУдаления = ЛОЖЬ
	|
	|СГРУППИРОВАТЬ ПО
	|	РазмещениеПоЯчейкамТовары.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	БуферАрмКладовщикаМаркировки.Номенклатура,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ БуферАрмКладовщикаМаркировки.Barcode) КАК Barcode
	|ПОМЕСТИТЬ ВТ_БуферМаркировок
	|ИЗ
