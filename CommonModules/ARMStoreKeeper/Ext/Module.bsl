
Процедура СозданиеДокументовРазмещенияВсвязиСпростоем() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	БуферАрмКладовщика.Объект,
	|	БуферАрмКладовщика.UserId,
	|	МАКСИМУМ(БуферАрмКладовщика.CreateDate) КАК CreateDate
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	РегистрСведений.БуферАрмКладовщика КАК БуферАрмКладовщика
	|
	|СГРУППИРОВАТЬ ПО
	|	БуферАрмКладовщика.Объект,
	|	БуферАрмКладовщика.UserId
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Объект,
	|	ВТ.UserId,
	|	ВТ.CreateDate
	|ИЗ
	|	ВТ КАК ВТ
	|ГДЕ
	|	РАЗНОСТЬДАТ(ВТ.CreateDate, &ТекущаяДата, МИНУТА) > &ВремяПростоя";
	
	Запрос.УстановитьПараметр("ВремяПростоя", Константы.ВремяПростояТСДкладовщика.Получить());
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Пока РезультатЗапроса.Следующий() Цикл
		СоздатьДокументРазмещенияПоМестамХранения( РезультатЗапроса.Объект.УникальныйИдентификатор(), РезультатЗапроса.UserId.УникальныйИдентификатор(), Истина);		
	КонецЦикла; 
	
КонецПроцедуры

Функция ЕстьЛиТоварыВЯчейке(CellGUID, UserIdGUID) Экспорт
	
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);
	
	Результат = Ложь;
	
	Ячейка = Справочники.Ячейки.ПолучитьСсылку( Новый УникальныйИдентификатор(CellGUID));
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТоварыВЯчейкахОстатки.Номенклатура,
	|	ТоварыВЯчейкахОстатки.КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Остатки(, Ячейка = &Ячейка) КАК ТоварыВЯчейкахОстатки";
	
	Запрос.УстановитьПараметр("Ячейка", Ячейка);
	УстановитьПривилегированныйРежим(Истина);			
	РезультатЗапроса = Запрос.Выполнить().Выбрать();	
	
	Если РезультатЗапроса.Количество() > 0 Тогда
		Результат = Истина;
	КонецЕсли;                                                                               
	
	УстановитьПривилегированныйРежим(Ложь);			
	ЗаписатьЛог( UserIdСсылка, ТекущаяДата(), "", "Проверка - Есть ли товары в ячейке", Ячейка.Код);
	
	Возврат Результат;
	
КонецФункции

Функция ЕстьЛиТоварВЯчейке(CellGUID, GoodGUID, UserIdGUID) Экспорт
	
	Результат = Ложь;
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);
	
	Ячейка = Справочники.Ячейки.ПолучитьСсылку(Новый УникальныйИдентификатор(CellGUID));
	Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(GoodGUID)); 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТоварыВЯчейкахОстатки.Номенклатура,
	|	ТоварыВЯчейкахОстатки.КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Остатки(
	|			,
	|			Ячейка = &Ячейка
	|				И Номенклатура = &Номенклатура) КАК ТоварыВЯчейкахОстатки";
	
	Запрос.УстановитьПараметр("Ячейка", Ячейка);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	УстановитьПривилегированныйРежим(Истина);			
	РезультатЗапроса = Запрос.Выполнить().Выбрать();	
	
	Если РезультатЗапроса.Количество() > 0 Тогда
		Результат = Истина;
	КонецЕсли;                                                                               
	
	УстановитьПривилегированныйРежим(Ложь);			
	ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Есть ли товар в ячейке", 
	"Ячейка " + Ячейка.Код + "; Номенклатура " + Номенклатура.Наименование + "; Код " + Строка(Номенклатура.Код));   
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьОстатокТовара(GoodGUID, UserIdGUID) Экспорт
	
	Результат = 0;
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);
	
	Номенклатура = Справочники.Номенклатура.ПолучитьСсылку( Новый УникальныйИдентификатор(GoodGUID));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТоварыВЯчейкахОстатки.КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Остатки(, Номенклатура = &Номенклатура) КАК ТоварыВЯчейкахОстатки";
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	УстановитьПривилегированныйРежим(Истина);			
	РезультатЗапроса = Запрос.Выполнить().Выбрать();	
	
	Если РезультатЗапроса.Количество() = 0 Тогда
		Результат = 0;
	Иначе       
		
		РезультатЗапроса.Следующий();
		Результат = РезультатЗапроса.КоличествоОстаток;     
		
	КонецЕсли; 
	
	УстановитьПривилегированныйРежим(Ложь);			
	
	ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Получить остаток товара", Номенклатура.Наименование + "; " + Строка(Номенклатура.Код));
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьОстатокНоменклатурыПоЯчейке(UserIdGUID, CellGUID, Barcode, GoodGUID) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СУММА(ТоварыВЯчейкахОстатки.КоличествоОстаток) КАК КоличествоОстаток,
	|	ТоварыВЯчейкахОстатки.Номенклатура
	|ПОМЕСТИТЬ ОстатокЯчейка
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Остатки(
	|			,
	|			Номенклатура = &Номенклатура
	|				И Ячейка = &Ячейка) КАК ТоварыВЯчейкахОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыВЯчейкахОстатки.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(БуферАРМ.Quantity) КАК Quantity,
	|	БуферАРМ.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ БуферАРМ
	|ИЗ
	|	РегистрСведений.БуферАРМКладовшикаПеремещение КАК БуферАРМ
	|ГДЕ
	|	БуферАРМ.UserId = &UserId
	|	И БуферАРМ.ЯчейкаОткуда = &Ячейка
	|	И БуферАРМ.Номенклатура = &Номенклатура
	|
	|СГРУППИРОВАТЬ ПО
	|	БуферАРМ.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ОстатокЯчейка.КоличествоОстаток, 0) КАК ОстатокВЯчейке,
	|	ЕСТЬNULL(БуферАРМ.Quantity, 0) КАК КоличествоНабрано
	|ИЗ
	|	ОстатокЯчейка КАК ОстатокЯчейка
	|		ЛЕВОЕ СОЕДИНЕНИЕ БуферАРМ КАК БуферАРМ
	|		ПО ОстатокЯчейка.Номенклатура = БуферАРМ.Номенклатура";                                        
	
	Ячейка = Справочники.Ячейки.ПолучитьСсылку(Новый УникальныйИдентификатор(CellGUID));
	Запрос.УстановитьПараметр("Ячейка", Ячейка);
	
	UserIdСсылка = Справочники.ФизическиеЛица.ПолучитьСсылку(Новый УникальныйИдентификатор(UserIdGUID));
	Запрос.УстановитьПараметр("UserId", UserIdСсылка);
	
	НоменклатураСсылка = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(GoodGUID));
	Запрос.УстановитьПараметр("Номенклатура", НоменклатураСсылка);
	
	УстановитьПривилегированныйРежим(Истина);			          
	ТЗ = Запрос.Выполнить().Выгрузить();			
	МассивВременный = ТаблицуВМассив(ТЗ);
	Результат = ДанныеВJSONХранилище(МассивВременный);
	УстановитьПривилегированныйРежим(Ложь);	
	
	ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Получить остаток номенклатуры по ячейке", НоменклатураСсылка.Наименование + " " + Ячейка.Код); 
	
	Возврат Результат;                                                             	
	
КонецФункции                    

