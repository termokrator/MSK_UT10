	|	ЕСТЬNULL(ДокРазмещения.КоличествоВРазмещении, 0) КАК КоличествоВРазмещении,
	|	ЕСТЬNULL(БуферРС.КоличествоВБуфере, 0) КАК КоличествоВБуфере,
	|	ЕСТЬNULL(ВТ_Маркировка.ОжидаемыхКодов, 0) КАК КоличествоОжидаемыхМаркировок,
	|	ЕСТЬNULL(ВТ_Маркировка.КодовВБуфере, 0) КАК КоличествоВБуфереМаркировок,
