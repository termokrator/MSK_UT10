Функция ПолучитьТоварПоШтрихкоду(UserIdGUID, Штрихкод, ТипДокумента = "", ГУИДДокумента = "", ПолучитьОбъектЗапрос = Ложь, ТоварГУИД = "") Экспорт
	
	Штрихкод = СокрЛП(Штрихкод);
	
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);	
	ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Получить товар по штрихкоду", "штрихкод " + Штрихкод + " ТоварГУИД " + ТоварГУИД);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(РегШК.Владелец КАК Справочник.Номенклатура) КАК Ссылка,
	|	""Штрихкод"" КАК ТипСтрокиЗапроса
	|ПОМЕСТИТЬ ВТШтрихкоды
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК РегШК
	|ГДЕ
	|	&Штрихкод <> """"
	|	И РегШК.Штрихкод = &Штрихкод
	|	И РегШК.Владелец ССЫЛКА Справочник.Номенклатура
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Номенклатура.Ссылка,
	|	""Штрихкод""
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка = &ТоварСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Штрихкоды.ЕдиницаИзмерения.Коэффициент,
	|	Штрихкоды.Владелец,
	|	Штрихкоды.ЕдиницаИзмерения.Наименование
	|ПОМЕСТИТЬ ВТКоэффициент
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК Штрихкоды
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТШтрихкоды КАК ВТШтрихкоды
	|		ПО Штрихкоды.Владелец = ВТШтрихкоды.Ссылка
	|ГДЕ
	|	Штрихкоды.Штрихкод = &Штрихкод
	|	И Штрихкоды.Владелец ССЫЛКА Справочник.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПТУТовары.Номенклатура КАК НоменклатураСсылка,
	|	ПТУТовары.Ссылка КАК ДокументПТУСсылка
	|ПОМЕСТИТЬ ПТУТовары
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.Товары КАК ПТУТовары
	|ГДЕ
	|	&ИскатьВПТУ
	|	И ПТУТовары.Ссылка = &ПТУСсылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ПТУТовары.Ссылка,
	|	ПТУТовары.Номенклатура
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПоступлениеТоваровНаОтветственноеХранениеТовары.Номенклатура,
	|	ПоступлениеТоваровНаОтветственноеХранениеТовары.Ссылка
	|ИЗ
	|	Документ.ПоступлениеТоваровНаОтветственноеХранение.Товары КАК ПоступлениеТоваровНаОтветственноеХранениеТовары
	|ГДЕ
	|	&ИскатьВПТУ
	|	И ПоступлениеТоваровНаОтветственноеХранениеТовары.Ссылка = &ПТУСсылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	НоменклатураСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 100
	|	ВТШтрихкоды.Ссылка КАК Владелец,
	|	ВТШтрихкоды.ТипСтрокиЗапроса КАК ТипСтрокиЗапроса,
	|	Номенклатура.Наименование КАК Наименование,
	|	&Штрихкод КАК Штрихкод,
	|	Номенклатура.КодПроизводителя КАК КодПроизводителя,
	|	ЕдиницыИзмерения.Наименование КАК ЕдИзмНаименование,
	|	ЕдиницыИзмерения.Коэффициент КАК ЕдХранОстатковКоэффициент,
	|	Номенклатура.Код КАК Код,
	|	Номенклатура.Кратность КАК Кратность,
	|	ЕСТЬNULL(Номенклатура.Родитель.Наименование, """") КАК Производитель,
	|	ЕСТЬNULL(ВТКоэффициент.ЕдиницаИзмеренияКоэффициент, ЕдиницыИзмерения.Коэффициент) КАК ШтрихкодЕдИзмКоэффициент,
	|	ЕСТЬNULL(ВТКоэффициент.ЕдиницаИзмеренияНаименование, ЕдиницыИзмерения.Наименование) КАК ШтрихкодЕдИзмНаименование
	|ПОМЕСТИТЬ РезультатВТ
	|ИЗ
	|	ВТШтрихкоды КАК ВТШтрихкоды
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	|			ПО Номенклатура.Ссылка = ЕдиницыИзмерения.Владелец
	|				И Номенклатура.ЕдиницаХраненияОстатков = ЕдиницыИзмерения.Ссылка
	|			ЛЕВОЕ СОЕДИНЕНИЕ ПТУТовары КАК ПТУТовары
	|			ПО (&ИскатьВПТУ)
	|				И Номенклатура.Ссылка = ПТУТовары.НоменклатураСсылка
	|		ПО ВТШтрихкоды.Ссылка = Номенклатура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТКоэффициент КАК ВТКоэффициент
	|		ПО ВТШтрихкоды.Ссылка = ВТКоэффициент.Владелец
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &ИскатьВПТУ
	|				ТОГДА ВЫБОР
	|						КОГДА ПТУТовары.ДокументПТУСсылка ЕСТЬ NULL
	|							ТОГДА ЛОЖЬ
	|						ИНАЧЕ ИСТИНА
	|					КОНЕЦ
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РезультатВТ.Владелец,
	|	РезультатВТ.ТипСтрокиЗапроса,
	|	РезультатВТ.Наименование,
	|	РезультатВТ.Штрихкод,
	|	РезультатВТ.КодПроизводителя,
	|	РезультатВТ.ЕдИзмНаименование,
	|	РезультатВТ.ЕдХранОстатковКоэффициент,
	|	РезультатВТ.Код,
	|	РезультатВТ.Кратность,
	|	РезультатВТ.Производитель,
	|	МИНИМУМ(РезультатВТ.ШтрихкодЕдИзмКоэффициент) КАК ШтрихкодЕдИзмКоэффициент,
	|	МАКСИМУМ(РезультатВТ.ШтрихкодЕдИзмНаименование) КАК ШтрихкодЕдИзмНаименование,
	|	ЕСТЬNULL(РезультатВТ.Владелец.ГруппаАВСФилиала.Наименование, ""Е"") КАК ГруппаАВСФилиала
	|ИЗ
	|	РезультатВТ КАК РезультатВТ
	|
	|СГРУППИРОВАТЬ ПО
	|	РезультатВТ.Штрихкод,
	|	РезультатВТ.Наименование,
	|	РезультатВТ.ЕдИзмНаименование,
	|	РезультатВТ.Код,
	|	РезультатВТ.КодПроизводителя,
	|	РезультатВТ.Производитель,
	|	РезультатВТ.ТипСтрокиЗапроса,
	|	РезультатВТ.Владелец,
	|	РезультатВТ.ЕдХранОстатковКоэффициент,
	|	РезультатВТ.Кратность,
	|	ЕСТЬNULL(РезультатВТ.Владелец.ГруппаАВСФилиала.Наименование, ""Е"")";
	
	Если ПолучитьОбъектЗапрос Тогда                
		Возврат Запрос;
	КонецЕсли; 
	
	ДополТекстЗапроса = "";
	
	Если ТипДокумента = "ПоступлениеТоваровУслуг" Или ТипДокумента = "ПеремещениеТовараИзЯчейки" Или ТипДокумента = "ЗаданиеНаИнвентаризацию" Тогда
		
		ЯчейкаGUID = ПолучитьЯчейкуПоШтрихкоду(Штрихкод, UserIdGUID);
		
		Если ЗначениеЗаполнено(ЯчейкаGUID) Тогда				
			
			ДополТекстЗапроса = ДополТекстЗапроса + "
			|ОБЪЕДИНИТЬ
			|	                                                              
			|ВЫБРАТЬ 
			|	&Ячейка КАК Владелец,
			|	""Ячейка""  КАК ТипСтрокиЗапроса,						
			|	&ЯчейкаНаименование КАК Наименование, 
			|	&Штрихкод КАК Штрихкод,                                              
			|	&Штрихкод КАК КодПроизводителя, 			
			|	"" "" КАК ЕдИзмНаименование, 
			|	"" "" КАК ЕдХранОстатковКоэффициент,			
			|	"" "" КАК Код, 
			|	"" "" КАК Кратность, 			
			|	"" "" КАК Производитель, 						
			|	"" "" КАК ШтрихкодЕдИзмКоэффициент,
			|	"" "" КАК ШтрихкодЕдИзмНаименование,
			|	"" "" КАК ГруппаАВСФилиала
			|";
			
			ЯчейкаСсылка = Справочники.Ячейки.ПолучитьСсылку(Новый УникальныйИдентификатор(ЯчейкаGUID) );
			ЯчейкаОбъект = ЯчейкаСсылка.ПолучитьОбъект();
			
			Запрос.УстановитьПараметр("Ячейка", ЯчейкаСсылка);
			Запрос.УстановитьПараметр("ЯчейкаНаименование", "ЯЧЕЙКА -> " + ЯчейкаОбъект.Код);			
			Запрос.УстановитьПараметр("Штрихкод", ЯчейкаОбъект.Код);
			
		КонецЕсли;
		
	КонецЕсли;							
	
	
	Запрос.Текст = Запрос.Текст + ДополТекстЗапроса + ";";
	Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
	
	Если ЗначениеЗаполнено(ТоварГУИД) Тогда
		Запрос.УстановитьПараметр("ТоварСсылка", Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(ТоварГУИД)));	
	Иначе
		Запрос.УстановитьПараметр("ТоварСсылка", Справочники.Номенклатура.ПустаяСсылка());
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ГУИДДокумента) И ТипДокумента = "ПоступлениеТоваровУслуг" Тогда  

		ДокументСсылка =Документы.ПоступлениеТоваровУслуг.ПолучитьСсылку(Новый УникальныйИдентификатор(ГУИДДокумента));
		
		Если ДокументСсылка.ПолучитьОбъект() = Неопределено Тогда
			ДокументСсылка = Документы.ПоступлениеТоваровНаОтветственноеХранение.ПолучитьСсылку(Новый УникальныйИдентификатор(ГУИДДокумента));
		КонецЕсли;
		
		Запрос.УстановитьПараметр("ПТУСсылка", ДокументСсылка);
		Запрос.УстановитьПараметр("ИскатьВПТУ", Истина);
		
	Иначе
		
		Запрос.УстановитьПараметр("ПТУСсылка", Документы.ПоступлениеТоваровУслуг.ПустаяСсылка());
		Запрос.УстановитьПараметр("ИскатьВПТУ", Ложь);		
		
	КонецЕсли;  
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Возврат ТЗ;                           
	
КонецФункции

Функция ПолучитьТоварПоШтрихкоду50(UserIdGUID, Штрихкод, ТипДокумента = "", ГУИДДокумента = "", ПолучитьОбъектЗапрос = Ложь, ТоварГУИД = "") Экспорт
	
	Штрихкод = СокрЛП(Штрихкод);
	
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);	
	ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Получить товар по штрихкоду", "штрихкод " + Штрихкод + " ТоварГУИД " + ТоварГУИД);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(РегШК.Владелец КАК Справочник.Номенклатура) КАК Ссылка,
	|	РегШК.ЕдиницаИзмерения.Ссылка,
	|	""Штрихкод"" КАК ТипСтрокиЗапроса
	|ПОМЕСТИТЬ ВТШтрихкоды
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК РегШК
	|ГДЕ
	|	&Штрихкод <> """"
	|	И РегШК.Штрихкод = &Штрихкод
	|	И РегШК.Владелец ССЫЛКА Справочник.Номенклатура
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Номенклатура.Ссылка,
	|	Номенклатура.ЕдиницаХраненияОстатков.Ссылка,
	|	""Штрихкод""
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка = &ТоварСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Штрихкоды.ЕдиницаИзмерения.Коэффициент,
	|	Штрихкоды.Владелец,
	|	Штрихкоды.ЕдиницаИзмерения.Наименование,
	|	Штрихкоды.ЕдиницаИзмерения.Ссылка
	|ПОМЕСТИТЬ ВТКоэффициент
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК Штрихкоды
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТШтрихкоды КАК ВТШтрихкоды
	|		ПО Штрихкоды.Владелец = ВТШтрихкоды.Ссылка
	|ГДЕ
	|	Штрихкоды.Штрихкод = &Штрихкод
	|	И Штрихкоды.Владелец ССЫЛКА Справочник.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПТУТовары.Номенклатура КАК НоменклатураСсылка,
	|	ПТУТовары.Ссылка КАК ДокументПТУСсылка
	|ПОМЕСТИТЬ ПТУТовары
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.Товары КАК ПТУТовары
	|ГДЕ
	|	&ИскатьВПТУ
	|	И ПТУТовары.Ссылка = &ПТУСсылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ПТУТовары.Ссылка,
	|	ПТУТовары.Номенклатура
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПоступлениеТоваровНаОтветственноеХранениеТовары.Номенклатура,
	|	ПоступлениеТоваровНаОтветственноеХранениеТовары.Ссылка
	|ИЗ
	|	Документ.ПоступлениеТоваровНаОтветственноеХранение.Товары КАК ПоступлениеТоваровНаОтветственноеХранениеТовары
	|ГДЕ
	|	&ИскатьВПТУ
	|	И ПоступлениеТоваровНаОтветственноеХранениеТовары.Ссылка = &ПТУСсылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	НоменклатураСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 100
	|	ВТШтрихкоды.Ссылка КАК Владелец,
	|	ВТШтрихкоды.ТипСтрокиЗапроса КАК ТипСтрокиЗапроса,
	|	Номенклатура.Наименование КАК Наименование,
	|	&Штрихкод КАК Штрихкод,
	|	Номенклатура.КодПроизводителя КАК КодПроизводителя,
	|	ЕдиницыИзмерения.Наименование КАК ЕдИзмНаименование,
	|	ЕдиницыИзмерения.Коэффициент КАК ЕдХранОстатковКоэффициент,
	|	Номенклатура.Код КАК Код,
	|	Номенклатура.Кратность КАК Кратность,
	//+Сёмин Р.И. 19.05.2026 #UT10-5855
	|	ЕСТЬNULL(Номенклатура.ТоварнаяГруппаЧестногоЗнака.ОбъемноСортовойУчет, ЛОЖЬ) КАК ОбъемноСортовойУчет,
	//-Сёмин Р.И. 19.05.2026 #UT10-5855
	|	ЕСТЬNULL(Номенклатура.Родитель.Наименование, """") КАК Производитель,
	|	ЕСТЬNULL(ВТКоэффициент.ЕдиницаИзмеренияКоэффициент, ЕдиницыИзмерения.Коэффициент) КАК ШтрихкодЕдИзмКоэффициент,
	|	ЕСТЬNULL(ВТКоэффициент.ЕдиницаИзмеренияНаименование, ЕдиницыИзмерения.Наименование) КАК ШтрихкодЕдИзмНаименование,
	|	ВТШтрихкоды.ЕдиницаИзмеренияСсылка
	|ПОМЕСТИТЬ РезультатВТ
	|ИЗ
	|	ВТШтрихкоды КАК ВТШтрихкоды
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	|			ПО Номенклатура.Ссылка = ЕдиницыИзмерения.Владелец
	|				И Номенклатура.ЕдиницаХраненияОстатков = ЕдиницыИзмерения.Ссылка
	|			ЛЕВОЕ СОЕДИНЕНИЕ ПТУТовары КАК ПТУТовары
	|			ПО (&ИскатьВПТУ)
	|				И Номенклатура.Ссылка = ПТУТовары.НоменклатураСсылка
	|		ПО ВТШтрихкоды.Ссылка = Номенклатура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТКоэффициент КАК ВТКоэффициент
	|		ПО ВТШтрихкоды.Ссылка = ВТКоэффициент.Владелец
	|			И ВТШтрихкоды.ЕдиницаИзмеренияСсылка = ВТКоэффициент.ЕдиницаИзмеренияСсылка
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &ИскатьВПТУ
	|				ТОГДА ВЫБОР
	|						КОГДА ПТУТовары.ДокументПТУСсылка ЕСТЬ NULL
	|							ТОГДА ЛОЖЬ
	|						ИНАЧЕ ИСТИНА
	|					КОНЕЦ
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РезультатВТ.Владелец,
	|	РезультатВТ.ЕдиницаИзмеренияСсылка,
	|	РезультатВТ.ТипСтрокиЗапроса,
	|	РезультатВТ.Наименование,
	|	РезультатВТ.Штрихкод,
	|	РезультатВТ.КодПроизводителя,
	|	РезультатВТ.ЕдИзмНаименование,
	|	РезультатВТ.ЕдХранОстатковКоэффициент,
	|	РезультатВТ.Код,
	|	РезультатВТ.Кратность,
	|	РезультатВТ.Производитель,
	|	РезультатВТ.ШтрихкодЕдИзмКоэффициент,
	|	РезультатВТ.ШтрихкодЕдИзмНаименование КАК ШтрихкодЕдИзмНаименование,
	|	ЕСТЬNULL(РезультатВТ.Владелец.ГруппаАВСФилиала.Наименование, ""Е"") КАК ГруппаАВСФилиала,
	|	РезультатВТ.Владелец.ТребуетсяМаркировка КАК ТребуетсяМаркировка,
	//+Сёмин Р.И. 19.05.2026 #UT10-5855
	|	РезультатВТ.ОбъемноСортовойУчет КАК ОбъемноСортовойУчет
	//-Сёмин Р.И. 19.05.2026 #UT10-5855
	|ИЗ
	|	РезультатВТ КАК РезультатВТ
	|
	|СГРУППИРОВАТЬ ПО
	|	РезультатВТ.Штрихкод,
	|	РезультатВТ.Наименование,
	|	РезультатВТ.ЕдИзмНаименование,
	|	РезультатВТ.Код,
	|	РезультатВТ.КодПроизводителя,
	|	РезультатВТ.Производитель,
	|	РезультатВТ.ТипСтрокиЗапроса,
	|	РезультатВТ.Владелец,
	|	РезультатВТ.ЕдХранОстатковКоэффициент,
	|	РезультатВТ.Кратность,
	|	РезультатВТ.ШтрихкодЕдИзмНаименование,
	|	РезультатВТ.ШтрихкодЕдИзмКоэффициент,
	|	РезультатВТ.ЕдиницаИзмеренияСсылка,
	|	ЕСТЬNULL(РезультатВТ.Владелец.ГруппаАВСФилиала.Наименование, ""Е""),
	|	РезультатВТ.Владелец.ТребуетсяМаркировка,
	//+Сёмин Р.И. 19.05.2026 #UT10-5855
	|	РезультатВТ.ОбъемноСортовойУчет
	//-Сёмин Р.И. 19.05.2026 #UT10-5855
	|";	
	
	///////////////////////////////////////////////////////////////////////////////////////////////////////////////	
	Если ПолучитьОбъектЗапрос Тогда                
		Возврат Запрос;
	КонецЕсли; 
	///////////////////////////////////////////////////////////////////////////////////////////////////////////////
	
	ДополТекстЗапроса = "";  
	
	Если ТипДокумента = "ПоступлениеТоваровУслуг" Или ТипДокумента = "ПеремещениеТовараИзЯчейки" Или ТипДокумента = "ЗаданиеНаИнвентаризацию" Тогда
		
		ЯчейкаGUID = ПолучитьЯчейкуПоШтрихкоду(Штрихкод, UserIdGUID); 
		
		Если ЗначениеЗаполнено(ЯчейкаGUID) Тогда				
			
			ДополТекстЗапроса = ДополТекстЗапроса + "
			|ОБЪЕДИНИТЬ
			|	                                                              
			|ВЫБРАТЬ 
			|	&Ячейка КАК Владелец,
			|   """" КАК ЕдиницаИзмеренияСсылка,
			|	""Ячейка""  КАК ТипСтрокиЗапроса,						
			|	&ЯчейкаНаименование КАК Наименование, 
			|	&Штрихкод КАК Штрихкод,                                              
			|	&Штрихкод КАК КодПроизводителя, 			
			|	"" "" КАК ЕдИзмНаименование, 
			|	"" "" КАК ЕдХранОстатковКоэффициент,			
			|	"" "" КАК Код, 
			|	"" "" КАК Кратность, 			
			|	"" "" КАК Производитель, 						
			|	"" "" КАК ШтрихкодЕдИзмКоэффициент,
			|	"" "" КАК ШтрихкодЕдИзмНаименование,
			|	"" "" КАК ГруппаАВСФилиала,
			|	ЛОЖЬ КАК ТребуетсяМаркировка,
			//+Сёмин Р.И. 19.05.2026 #UT10-5855
			|	ЛОЖЬ КАК ОбъемноСортовойУчет
			//-Сёмин Р.И. 19.05.2026 #UT10-5855
			|";                    
			
			ЯчейкаСсылка = Справочники.Ячейки.ПолучитьСсылку(Новый УникальныйИдентификатор(ЯчейкаGUID));
			ЯчейкаОбъект = ЯчейкаСсылка.ПолучитьОбъект();
			
			Запрос.УстановитьПараметр("Ячейка", ЯчейкаСсылка);
			Запрос.УстановитьПараметр("ЯчейкаНаименование", "ЯЧЕЙКА -> " + ЯчейкаОбъект.Код);			
			Запрос.УстановитьПараметр("Штрихкод", ЯчейкаОбъект.Код);
			
		КонецЕсли;
		
	КонецЕсли;							
	
	
	Запрос.Текст = Запрос.Текст + ДополТекстЗапроса + ";";
	Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
	
	Если ЗначениеЗаполнено(ТоварГУИД) Тогда
		Запрос.УстановитьПараметр("ТоварСсылка", Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(ТоварГУИД)));	
	Иначе
		Запрос.УстановитьПараметр("ТоварСсылка", Справочники.Номенклатура.ПустаяСсылка());
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ГУИДДокумента) И ТипДокумента = "ПоступлениеТоваровУслуг" Тогда
		
		ДокументСсылка =Документы.ПоступлениеТоваровУслуг.ПолучитьСсылку(Новый УникальныйИдентификатор(ГУИДДокумента ));
		
		Если ДокументСсылка.ПолучитьОбъект() = Неопределено Тогда
			ДокументСсылка = Документы.ПоступлениеТоваровНаОтветственноеХранение.ПолучитьСсылку(Новый УникальныйИдентификатор(ГУИДДокумента));
		КонецЕсли;
		
		Запрос.УстановитьПараметр("ПТУСсылка",ДокументСсылка);
		Запрос.УстановитьПараметр("ИскатьВПТУ", Истина);
		
	Иначе
		
		Запрос.УстановитьПараметр("ПТУСсылка", Документы.ПоступлениеТоваровУслуг.ПустаяСсылка());
		Запрос.УстановитьПараметр("ИскатьВПТУ", Ложь);		
		
	КонецЕсли; 
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Возврат ТЗ;                           
	
КонецФункции

Функция ПолучитьТоварПоGTIN(UserIdGUID, GTIN, ТипДокумента = "", ГУИДДокумента = "", ПолучитьОбъектЗапрос = Ложь, ТоварГУИД = "") Экспорт
	
	//+Шульман А. 20.11.2025 #UT10-5518     
	Результат = Новый Структура("ПроверкаПройдена, Ошибка", Ложь, "");
	GTIN = СокрЛП(GTIN);
	
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);	
	ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Проверить GTIN товара", "GTIN " + GTIN + " ТоварГУИД " + ТоварГУИД);    
	
	Если ЗначениеЗаполнено(ТоварГУИД) Тогда
		ТоварСсылка = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(ТоварГУИД));	
	Иначе
		ТоварСсылка = Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли; 
	
	Если ТоварСсылка.Пустая() Тогда     
		
		Результат.Ошибка = "По ГУИД " + ТоварГУИД + " товар не найден";
		Возврат Результат;
		
	КонецЕсли;       
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СправочникGTIN.Ссылка,
		|	СправочникGTIN.Владелец,
		|	СправочникGTIN.Владелец = &ТоварСсылка КАК ВладелецПроверен
		|ИЗ
		|	Справочник.GTIN КАК СправочникGTIN
		|ГДЕ
		|	СправочникGTIN.GTIN = &GTIN
		//|	И НЕ СправочникGTIN.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВладелецПроверен УБЫВ";
	
	Запрос.УстановитьПараметр("GTIN", GTIN);
	Запрос.УстановитьПараметр("ТоварСсылка", ТоварСсылка);    
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Результат.Ошибка = "Товар по GTIN " + GTIN + " не найден в базе";
	Иначе                        
		
		Выборка = РезультатЗапроса.Выбрать();  
		Выборка.Следующий();
		
		Если Выборка.ВладелецПроверен Тогда
			Результат.ПроверкаПройдена = Истина;
		Иначе
			Результат.Ошибка = "Код маркировки не соответствует товару (проверка GTIN)";
		КонецЕсли;    
		
	КонецЕсли;
	
	Возврат Результат;                           
	//-Шульман А. 20.11.2025 #UT10-5518

КонецФункции // ()

Функция ПолучитьТоварПоНормализованномуКоду(UserIdGUID, АртикулКод, ТипДокумента = "", ГУИДДокумента = "", ТекстОтбора = "")
	
	Запрос = Новый Запрос;
	
	//+Гавриленков В. 16.07.2026 #UT10-5963 Добавлен ОбъемноСортовойУчет
	ЗапросТекст = 
	"ВЫБРАТЬ ПЕРВЫЕ 100
	|	Номенклатура.Ссылка КАК Ссылка,
	|	ЕСТЬNULL(Номенклатура.Ссылка.ТоварнаяГруппаЧестногоЗнака.ОбъемноСортовойУчет, ЛОЖЬ) КАК ОбъемноСортовойУчет,
	|	Номенклатура.Наименование КАК Наименование,
	|	Номенклатура.КодПроизводителя КАК КодПроизводителя,
	|	Номенклатура.ЕдиницаХраненияОстатков.Наименование КАК ЕдИзмНаименование,
	|	""Номенклатура"" КАК ТипСтрокиЗапроса,
	|	Номенклатура.Код КАК Код,
	|	Номенклатура.Кратность КАК Кратность,
	|	ЕСТЬNULL(Номенклатура.Родитель.Наименование, """") КАК Производитель, 
	|	ЕСТЬNULL(Номенклатура.ГруппаАВСФилиала.Наименование, ""Е"") КАК ГруппаАВСФилиала,
	|	ЕдиницыИзмерения.Наименование 	   КАК ЕдХранОстатковНаименование,
	|	ЕдиницыИзмерения.Коэффициент       КАК ЕдХранОстатковКоэффициент,	
	|	"" ""                              КАК ШтрихкодЕдИзмКоэффициент,
	|	"" ""                              КАК ШтрихкодЕдИзмНаименование,
	|   Номенклатура.ТребуетсяМаркировка   КАК ТребуетсяМаркировка
	|
	|ПОМЕСТИТЬ ВТТовары_Old
	|
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	|		ПО Номенклатура.Ссылка = ЕдиницыИзмерения.Владелец
	|			И Номенклатура.ЕдиницаХраненияОстатков = ЕдиницыИзмерения.Ссылка
	
	|ГДЕ
	|	%%ПоискНоменклатуры%%
	|	И (НЕ Номенклатура.ПометкаУдаления)
	|	И (НЕ Номенклатура.ЭтоГруппа)
	|;";
	
	Если ТипДокумента = "ПоступлениеТоваровУслуг" Тогда		
		
		ДополТекстЗапроса = " 
		////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|А.Ссылка, 
		|МАКСИМУМ(А.ОбъемноСортовойУчет) КАК ОбъемноСортовойУчет,
		|МАКСИМУМ(А.Наименование) КАК Наименование,
		|МАКСИМУМ(А.ГруппаАВСФилиала) КАК ГруппаАВСФилиала,
		|МАКСИМУМ(А.КодПроизводителя) КАК КодПроизводителя,
		|МАКСИМУМ(А.ЕдИзмНаименование) КАК ЕдИзмНаименование,
		|МАКСИМУМ(А.ТипСтрокиЗапроса) КАК ТипСтрокиЗапроса,
		|МАКСИМУМ(ПТУТовары.Номенклатура.Код) КАК Код,
		|МАКСИМУМ(ПТУТовары.Номенклатура.Кратность) КАК Кратность,
		|МАКСИМУМ(ПТУТовары.Номенклатура.Родитель.Наименование) КАК Производитель,
		|МАКСИМУМ(А.ЕдХранОстатковНаименование) КАК ЕдХранОстатковНаименование,
		|МАКСИМУМ(А.ЕдХранОстатковКоэффициент) КАК ЕдХранОстатковКоэффициент,
		|МАКСИМУМ("" "") КАК ШтрихкодЕдИзмКоэффициент,
		|МАКСИМУМ("" "") КАК ШтрихкодЕдИзмНаименование,
		|МАКСИМУМ(А.ТребуетсяМаркировка)
		|ПОМЕСТИТЬ ВТТовары
		|ИЗ
		|ВТТовары_Old КАК А
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг.Товары КАК ПТУТовары
		|ПО А.Ссылка = ПТУТовары.Номенклатура
		|И (ПТУТовары.Ссылка = &ПТУIdСсылка)
		|
		|СГРУППИРОВАТЬ ПО
		|А.Ссылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|А.Ссылка,
		|МАКСИМУМ(А.ОбъемноСортовойУчет),
		|МАКСИМУМ(А.Наименование),
		|МАКСИМУМ(А.ГруппаАВСФилиала),
		|МАКСИМУМ(А.КодПроизводителя),
		|МАКСИМУМ(А.ЕдИзмНаименование),
		|МАКСИМУМ(А.ТипСтрокиЗапроса),
		|МАКСИМУМ(ПоступлениеТоваровНаОтветственноеХранениеТовары.Номенклатура.Код),
		|МАКСИМУМ(ПоступлениеТоваровНаОтветственноеХранениеТовары.Номенклатура.Кратность),
		|МАКСИМУМ(ПоступлениеТоваровНаОтветственноеХранениеТовары.Номенклатура.Родитель.Родитель.Наименование),
		|МАКСИМУМ(А.ЕдХранОстатковНаименование),
		|МАКСИМУМ(А.ЕдХранОстатковКоэффициент),
		|МАКСИМУМ("" ""),
		|МАКСИМУМ("" ""),
		|МАКСИМУМ(А.ТребуетсяМаркировка)
		|ИЗ
		|ВТТовары_Old КАК А
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровНаОтветственноеХранение.Товары КАК ПоступлениеТоваровНаОтветственноеХранениеТовары
		|ПО А.Ссылка = ПоступлениеТоваровНаОтветственноеХранениеТовары.Номенклатура
		|И (ПоступлениеТоваровНаОтветственноеХранениеТовары.Ссылка = &ПТУIdСсылка)
		|
		|СГРУППИРОВАТЬ ПО
		|А.Ссылка
		|";
		
		ЯчейкаGUID = ПолучитьЯчейкуПоШтрихкоду(АртикулКод, UserIdGUID);
		
		Если ЗначениеЗаполнено(ЯчейкаGUID) Тогда
			
			ДополТекстЗапроса = ДополТекстЗапроса + "
			|ОБЪЕДИНИТЬ
			|	                                                              
			|ВЫБРАТЬ 
			|	&Ячейка КАК Ссылка,
			|	ЛОЖЬ КАК ОбъемноСортовойУчет,
			|	&ЯчейкаНаименование КАК Наименование, 
			|	"" "" КАК ГруппаАВСФилиала, 
			|	"" "" КАК КодПроизводителя, 
			|	"" "" КАК ЕдИзмНаименование, 			
			|	""Ячейка""  КАК ТипСтрокиЗапроса,
			|	"" "" КАК Код,
			|	"" ""  КАК Кратность,
			|	"" ""  КАК Производитель,
			|	"" "" КАК ЕдХранОстатковНаименование,
			|	"" "" КАК ЕдХранОстатковКоэффициент,				
			|	"" "" КАК ШтрихкодЕдИзмКоэффициент,
			|	"" "" КАК ШтрихкодЕдИзмНаименование,
			|   Ложь  КАК ТребуетсяМаркировка
			|";
			
			ЯчейкаСсылка = Справочники.Ячейки.ПолучитьСсылку(Новый УникальныйИдентификатор(ЯчейкаGUID) );
			ЯчейкаОбъект = ЯчейкаСсылка.ПолучитьОбъект();
			
			Запрос.УстановитьПараметр("Ячейка", ЯчейкаСсылка);
			Запрос.УстановитьПараметр("ЯчейкаНаименование", ЯчейкаОбъект.Код);			
			
		КонецЕсли;
		
		ЗапросТекст = ЗапросТекст + ДополТекстЗапроса + ";";				
		ПТУIdСсылка = Документы.ПоступлениеТоваровУслуг.ПолучитьСсылку(Новый УникальныйИдентификатор(ГУИДДокумента)); 

		Если ПТУIdСсылка.ПолучитьОбъект() = Неопределено Тогда
			ПТУIdСсылка = Документы.ПоступлениеТоваровНаОтветственноеХранение.ПолучитьСсылку(Новый УникальныйИдентификатор(ГУИДДокумента));
		КонецЕсли;

		Запрос.УстановитьПараметр("ПТУIdСсылка", ПТУIdСсылка);
		
	Иначе
		ЗапросТекст = СтрЗаменить(ЗапросТекст, "ВТТовары_Old", "ВТТовары");
	КонецЕсли;	
	
	Запрос.Текст = ЗапросТекст +
	"
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 100
	|	ВТТовары.Ссылка КАК Владелец,
	|	ВТТовары.ОбъемноСортовойУчет КАК ОбъемноСортовойУчет,
	|	ВТТовары.Наименование КАК Наименование,	
	|	ВТТовары.ГруппаАВСФилиала КАК ГруппаАВСФилиала,	
	|	ВТТовары.КодПроизводителя КАК КодПроизводителя,	
	|	ВТТовары.ЕдИзмНаименование КАК ЕдИзмНаименование,		
	|	ВТТовары.ТипСтрокиЗапроса КАК ТипСтрокиЗапроса,
	|	ВТТовары.Код КАК Код,
	|	ВТТовары.Кратность КАК Кратность,	
	|	ЕСТЬNULL(ВТТовары.Производитель, """") КАК Производитель,
	|	ВЫБОР
	|		КОГДА ВТТовары.ШтрихкодЕдИзмНаименование <> "" "" ТОГДА
	|			ВТТовары.ШтрихкодЕдИзмНаименование 
	|		ИНАЧЕ
	|		    ВТТовары.ЕдХранОстатковНаименование                                     
	|	КОНЕЦ КАК ШтрихкодЕдИзмНаименование,		
	
	|	ВЫБОР
	|		КОГДА ВТТовары.ШтрихкодЕдИзмКоэффициент <> "" "" ТОГДА
	|			ВТТовары.ШтрихкодЕдИзмКоэффициент 
	|		ИНАЧЕ
	|		    ВТТовары.ЕдХранОстатковКоэффициент
	|	КОНЕЦ КАК ШтрихкодЕдИзмКоэффициент,
	|  ВТТовары.ТребуетсяМаркировка КАК ТребуетсяМаркировка
	|ИЗ
	|	ВТТовары КАК ВТТовары";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"%%ПоискНоменклатуры%%", ТекстОтбора);
	
	Запрос.УстановитьПараметр("АртикулКод",  АртикулКод );
	Запрос.УстановитьПараметр("АртикулКод2", Транслит(АртикулКод));
	Запрос.УстановитьПараметр("АртикулКод3", ВДругойРаскладкеКлавиатуры(АртикулКод));
	
	УстановитьПривилегированныйРежим(Истина);
	ТЗ = Запрос.Выполнить().Выгрузить();  
	УстановитьПривилегированныйРежим(Ложь);
	
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);	
	ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Получить товар по нормализованному коду", "АртикулКод " + АртикулКод);
	
	Возврат ТЗ;
	
КонецФункции                                                              

Функция ПолучитьТоварПоМаркировке(UserIdGUID , Штрихкод , ШтрихкодПолный , ТипДокумента = "" , ГУИДДокумента = "" , ПолучитьОбъектЗапрос = Ложь , ТоварГУИД = "") Экспорт
	//+Кабанов А.В. 15.08.2025 # # UT10-5360
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ШтрихкодыНоменклатуры.Ссылка,
	|	ШтрихкодыНоменклатуры.Номенклатура,
	|	ШтрихкодыНоменклатуры.Номенклатура.ЕдиницаХраненияОстатков КАК ЕдиницаХраненияОстатков
	|ПОМЕСТИТЬ ВТ_Маркировка
	|ИЗ
	|	Справочник.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
	|ГДЕ
	|	(ШтрихкодыНоменклатуры.КодМаркировки = &ШтрихКод
	|			ИЛИ ШтрихкодыНоменклатуры.КодМаркировки = &ШтрихКодПолный)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Маркировка.Номенклатура.Ссылка КАК Ссылка,
	|	ВТ_Маркировка.ЕдиницаХраненияОстатков КАК ЕдиницаИзмерения,
	|	""Штрихкод"" КАК ТипСтрокиЗапроса,
	|	ЕСТЬNULL(СостоянияКодовМаркировки.СостояниеКМ, ЗНАЧЕНИЕ(Перечисление.СостоянияКодовМаркировки.ПустаяСсылка)) КАК ВведенВОборот
	|ПОМЕСТИТЬ ВТШтрихкоды
	|ИЗ
	|	ВТ_Маркировка КАК ВТ_Маркировка
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			СостоянияКодовМаркировки.ШтрихКодНоменклатуры КАК ШтрихКодНоменклатуры,
	|			МАКСИМУМ(СостоянияКодовМаркировки.Регистратор) КАК Регистратор
	|		ИЗ
	|			РегистрСведений.СостоянияКодовМаркировки КАК СостоянияКодовМаркировки
	|		ГДЕ
	|			СостоянияКодовМаркировки.ШтрихКодНоменклатуры В
	|					(ВЫБРАТЬ
	|						ВТ_Маркировка.Ссылка
	|					ИЗ
	|						ВТ_Маркировка)
	|		
	|		СГРУППИРОВАТЬ ПО
	|			СостоянияКодовМаркировки.ШтрихКодНоменклатуры) КАК ВТ_СрезПоследних
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияКодовМаркировки КАК СостоянияКодовМаркировки
	|			ПО ВТ_СрезПоследних.ШтрихКодНоменклатуры = СостоянияКодовМаркировки.ШтрихКодНоменклатуры
	|				И ВТ_СрезПоследних.Регистратор = СостоянияКодовМаркировки.Регистратор
	|		ПО ВТ_Маркировка.Ссылка = ВТ_СрезПоследних.ШтрихКодНоменклатуры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Штрихкоды.ЕдиницаИзмерения.Коэффициент,
	|	Штрихкоды.Владелец,
	|	Штрихкоды.ЕдиницаИзмерения.Наименование,
	|	Штрихкоды.ЕдиницаИзмерения.Ссылка
	|ПОМЕСТИТЬ ВТКоэффициент
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК Штрихкоды
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТШтрихкоды КАК ВТШтрихкоды
	|		ПО Штрихкоды.Владелец = ВТШтрихкоды.Ссылка
	|ГДЕ
	|	Штрихкоды.Штрихкод = &Штрихкод
	|	И Штрихкоды.Владелец ССЫЛКА Справочник.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 100
	|	ВТШтрихкоды.Ссылка КАК Владелец,
	|	ВТШтрихкоды.ТипСтрокиЗапроса КАК ТипСтрокиЗапроса,
	|	Номенклатура.Наименование КАК Наименование,
	|	"""" КАК Штрихкод,
	|	Номенклатура.КодПроизводителя КАК КодПроизводителя,
	|	ЕдиницыИзмерения.Наименование КАК ЕдИзмНаименование,
	|	ЕдиницыИзмерения.Коэффициент КАК ЕдХранОстатковКоэффициент,
	|	Номенклатура.Код КАК Код,
	|	Номенклатура.Кратность КАК Кратность,
	|	ЕСТЬNULL(Номенклатура.Родитель.Наименование, """") КАК Производитель,
	|	ЕСТЬNULL(ВТКоэффициент.ЕдиницаИзмеренияКоэффициент, ЕдиницыИзмерения.Коэффициент) КАК ШтрихкодЕдИзмКоэффициент,
	|	ЕСТЬNULL(ВТКоэффициент.ЕдиницаИзмеренияНаименование, ЕдиницыИзмерения.Наименование) КАК ШтрихкодЕдИзмНаименование,
	|	ВТШтрихкоды.ВведенВОборот = ЗНАЧЕНИЕ(Перечисление.СостоянияКодовМаркировки.ВведенВОборот) КАК ВведенВОборот
	|ПОМЕСТИТЬ РезультатВТ
	|ИЗ
	|	ВТШтрихкоды КАК ВТШтрихкоды
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	|			ПО Номенклатура.Ссылка = ЕдиницыИзмерения.Владелец
	|				И Номенклатура.ЕдиницаХраненияОстатков = ЕдиницыИзмерения.Ссылка
	|		ПО ВТШтрихкоды.Ссылка = Номенклатура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТКоэффициент КАК ВТКоэффициент
	|		ПО ВТШтрихкоды.Ссылка = ВТКоэффициент.Владелец
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 1
	|	РезультатВТ.Владелец,
	|	РезультатВТ.ТипСтрокиЗапроса,
	|	РезультатВТ.Наименование,
	|	РезультатВТ.Штрихкод,
	|	РезультатВТ.КодПроизводителя,
	|	РезультатВТ.ЕдИзмНаименование,
	|	РезультатВТ.ЕдХранОстатковКоэффициент,
	|	РезультатВТ.Код,
	|	РезультатВТ.Кратность,
	|	РезультатВТ.Производитель,
	|	РезультатВТ.ШтрихкодЕдИзмКоэффициент,
	|	РезультатВТ.ШтрихкодЕдИзмНаименование КАК ШтрихкодЕдИзмНаименование,
	|	ЕСТЬNULL(РезультатВТ.Владелец.ГруппаАВСФилиала.Наименование, ""Е"") КАК ГруппаАВСФилиала,
	|	РезультатВТ.Владелец.ТребуетсяМаркировка КАК ТребуетсяМаркировка,
	|	РезультатВТ.ВведенВОборот
	|ИЗ
	|	РезультатВТ КАК РезультатВТ
	|
	|СГРУППИРОВАТЬ ПО
	|	РезультатВТ.Штрихкод,
	|	РезультатВТ.Наименование,
	|	РезультатВТ.ЕдИзмНаименование,
	|	РезультатВТ.Код,
	|	РезультатВТ.КодПроизводителя,
	|	РезультатВТ.Производитель,
	|	РезультатВТ.ТипСтрокиЗапроса,
	|	РезультатВТ.Владелец,
	|	РезультатВТ.ЕдХранОстатковКоэффициент,
	|	РезультатВТ.Кратность,
	|	РезультатВТ.ШтрихкодЕдИзмНаименование,
	|	РезультатВТ.ШтрихкодЕдИзмКоэффициент,
	|	ЕСТЬNULL(РезультатВТ.Владелец.ГруппаАВСФилиала.Наименование, ""Е""),
	|	РезультатВТ.Владелец.ТребуетсяМаркировка,
	|	РезультатВТ.ВведенВОборот";

	Запрос.УстановитьПараметр("Штрихкод"       , Штрихкод);
	Запрос.УстановитьПараметр("ШтрихКодПолный" , ШтрихКодПолный);

	ТЗ = Запрос.Выполнить().Выгрузить();	
	
	Возврат ТЗ; 
	//-Кабанов А.В. 15.08.2025 # # UT10-5360		
КонецФункции

Функция ПолучитьЯчейкуПоШтрихКоду(ШкЯчейки, UserIdGUID) Экспорт
	
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);	
	
	Массив = Новый Массив;		
	
	ИмяЯчейки = Сред(ШкЯчейки, 1, 2) + "-" + Сред(ШкЯчейки, 3, 1) + "-" + Сред(ШкЯчейки, 4, 2);
	Массив.Добавить(ИмяЯчейки);
	
	ИмяЯчейки = Сред(ШкЯчейки, 1, 1) + "-" + Сред(ШкЯчейки, 2, 1) + "-" + Сред(ШкЯчейки, 3, 2) + "-" + Сред(ШкЯчейки, 5, 1);
	Массив.Добавить(ИмяЯчейки);
	
	ИмяЯчейки = ШкЯчейки;
	Массив.Добавить(ИмяЯчейки);
	
	ИмяЯчейки = Сред(ШкЯчейки, 1, 1) + "-" + Сред(ШкЯчейки, 2, 2) + "-" + Сред(ШкЯчейки, 4, 1) + "-" + Сред(ШкЯчейки, 5, 1) + "-" + Сред(ШкЯчейки, 6, 2);
	Массив.Добавить(ИмяЯчейки);
	
	ИмяЯчейки = Сред(ШкЯчейки, 1, 1) + "-" + Сред(ШкЯчейки, 2, 2) + "-" + Сред(ШкЯчейки, 4, 2) + "-" + Сред(ШкЯчейки, 6, 1) + "-" + Сред(ШкЯчейки, 7, 2);		
	ИмяЯчейки = СокрЛП(ИмяЯчейки);	
	Массив.Добавить(ИмяЯчейки);
	
	ИмяЯчейки = Сред(ШкЯчейки, 1, 1) + "-" + Сред(ШкЯчейки, 2, 2) + "-" + Сред(ШкЯчейки, 4, 2) + "-" + Сред(ШкЯчейки, 6, 2);		
	ИмяЯчейки = СокрЛП(ИмяЯчейки);	
	Массив.Добавить(ИмяЯчейки);
	
	ИмяЯчейки = Сред(ШкЯчейки, 1, 1) + "-" + Сред(ШкЯчейки, 2, 1) + "-" + Сред(ШкЯчейки, 3, 2) + "-" + Сред(ШкЯчейки, 5, 2);		
	ИмяЯчейки = СокрЛП(ИмяЯчейки);	
	Массив.Добавить(ИмяЯчейки);
	
	ИмяЯчейки = Сред(ШкЯчейки, 1, 3) + "-" + Сред(ШкЯчейки, 4, 2) + "-" + Сред(ШкЯчейки, 6, 2) + "-" + Сред(ШкЯчейки, 8, 2) + "-" + Сред(ШкЯчейки, 10, 2);		
	ИмяЯчейки = СокрЛП(ИмяЯчейки);	
	Массив.Добавить(ИмяЯчейки);
	
	ИмяЯчейки = Сред(ШкЯчейки, 1, 1) + "-" + Сред(ШкЯчейки, 2, 2) + "-" + Сред(ШкЯчейки, 4, 2) + "-" + Сред(ШкЯчейки, 6, 2) + "-" + Сред(ШкЯчейки, 8, 2); 
	ИмяЯчейки = СокрЛП(ИмяЯчейки);	
	Массив.Добавить(ИмяЯчейки);
	
	Запрос = Новый Запрос;                                  
	Запрос.Текст = "
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Ячейки.Код,
	|	Ячейки.Ссылка
	|ИЗ
	|	Справочник.Ячейки КАК Ячейки
	|ГДЕ
	|	Ячейки.Код В (&Код)
	|   И Ячейки.ПометкаУдаления = Ложь";
	
	Запрос.УстановитьПараметр("Код", Массив); 
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Количество () > 0 Тогда		
		
		РезультатЗапроса.Следующий();
		Результат = XMLСтрока(РезультатЗапроса.Ссылка);
		
