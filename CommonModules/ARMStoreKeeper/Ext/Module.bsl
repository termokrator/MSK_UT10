	|	ВЫБОР
	|		КОГДА ТоварВДокументе.ТребуетсяМаркировка
	|			ТОГДА ТоварВДокументе.Количество
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК КоличествоТоваровСМаркировкой,
	|	ТоварВДокументе.ТребуетсяМаркировка КАК ТоварТребуетсяМаркировка
	|ИЗ
	|	ТоварВДокументе КАК ТоварВДокументе
	|		ЛЕВОЕ СОЕДИНЕНИЕ БуферРС КАК БуферРС
	|		ПО ТоварВДокументе.Номенклатура = БуферРС.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДокРазмещения КАК ДокРазмещения
	|		ПО ТоварВДокументе.Номенклатура = ДокРазмещения.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Маркировка КАК ВТ_Маркировка
	|		ПО ТоварВДокументе.Номенклатура = ВТ_Маркировка.Номенклатура";
	
	ДокументСсылка = Документы.ПоступлениеТоваровУслуг.ПолучитьСсылку(Новый УникальныйИдентификатор(ObjectIdGUID));

	Если ДокументСсылка.ПолучитьОбъект() = Неопределено Тогда
		ДокументСсылка = Документы.ПоступлениеТоваровНаОтветственноеХранение.ПолучитьСсылку(Новый УникальныйИдентификатор(ObjectIdGUID));
	КонецЕсли;

	Запрос.УстановитьПараметр("ОbjectIdGUID", ДокументСсылка);
	
	ProductIdСсылка  =  Справочники["Номенклатура"].ПолучитьСсылку(Новый УникальныйИдентификатор(SelectedProductIdGUID));
	Запрос.УстановитьПараметр("Номенклатура", ProductIdСсылка);
	
	УстановитьПривилегированныйРежим(Истина);    
	//+Шульман А. 14.10.2025 #UT10-5438
	//+Шульман А. 13.11.2025 #UT10-5504 
	//Запрос.УстановитьПараметр("ЯчейкаДляМаркировки", Константы.ЯчейкаДляМаркировки.Получить());
	МассивЯчейкаДляМаркировки = Новый Массив;
	МассивЯчейкаДляМаркировки.Добавить(Константы.ЯчейкаДляМаркировки.Получить());  
	МассивЯчейкаДляМаркировки.Добавить(Константы.ЯчейкаДляПеремаркировки.Получить());
	МассивЯчейкаДляМаркировки.Добавить(Константы.ЯчейкаДляВозвратаПоставщику.Получить());
	Запрос.УстановитьПараметр("ЯчейкаДляМаркировки", МассивЯчейкаДляМаркировки);       
	//Шульман А. 13.11.2025 #UT10-5504 
	//-Шульман А. 14.10.2025 #UT10-5438
	
	ТЗ = Запрос.Выполнить().Выгрузить();	
	УстановитьПривилегированныйРежим(Ложь);
	
	ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Получить остаток по товару из документа", "Документ ПТУ " + ДокументСсылка.Номер);
	
	Если ПолучитьТЗ Тогда
		Возврат ТЗ;
	КонецЕсли; 
	
	МассивВременный = ТаблицуВМассив(ТЗ);
	Результат = ДанныеВJSONХранилище(МассивВременный);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьМаркировкиПоДокументуПТУ(ObjectIdGUID, UserIdGUID) Экспорт 

	UserIdСсылка = ПолучитьПользователя(UserIdGUID);		
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПоступлениеТоваровУслугКодыМаркировки.Ссылка КАК СсылкаПТУ,
	|	ПоступлениеТоваровУслугКодыМаркировки.КодМаркировки.Номенклатура КАК СсылкаТовара,
	|	ПоступлениеТоваровУслугКодыМаркировки.КодМаркировки.Номенклатура.Наименование КАК НаименованиеТовара,
	|	ПоступлениеТоваровУслугКодыМаркировки.КодМаркировки.Номенклатура.Родитель.Наименование КАК Производитель,
	|	ПоступлениеТоваровУслугКодыМаркировки.КодМаркировки.Номенклатура.КодПроизводителя КАК КодПроизводителяТовара,
	|	ПоступлениеТоваровУслугКодыМаркировки.КодМаркировки,
	|	ПоступлениеТоваровУслугКодыМаркировки.КодМаркировки.Номенклатура.НормализованныйКод КАК НормализованныйКод,
	|	ПоступлениеТоваровУслугКодыМаркировки.КодМаркировки.КодМаркировки КАК ШтрихКод,
	|	"""" КАК ШтрихКодПолный,                             
	//+Шульман А. 17.03.2026 #UT10-5748
	|	ПоступлениеТоваровУслугКодыМаркировки.Причина,
	|	ПоступлениеТоваровУслугКодыМаркировки.Невалиден      
	//-Шульман А. 17.03.2026 #UT10-5748
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.КодыМаркировки КАК ПоступлениеТоваровУслугКодыМаркировки
	|ГДЕ
	|	ПоступлениеТоваровУслугКодыМаркировки.Ссылка = &ОbjectIdGUID
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПоступлениеТоваровУслугОтсканированныеКодыМаркировки.Ссылка КАК СсылкаПТУ,
	|	ПоступлениеТоваровУслугОтсканированныеКодыМаркировки.КодМаркировки.Номенклатура КАК СсылкаТовара,
	|	ПоступлениеТоваровУслугОтсканированныеКодыМаркировки.КодМаркировки.Номенклатура.Наименование КАК НаименованиеТовара,
	|	ПоступлениеТоваровУслугОтсканированныеКодыМаркировки.КодМаркировки.Номенклатура.Родитель.Наименование КАК Производитель,
	|	ПоступлениеТоваровУслугОтсканированныеКодыМаркировки.КодМаркировки.Номенклатура.КодПроизводителя КАК КодПроизводителяТовара,
	|	ПоступлениеТоваровУслугОтсканированныеКодыМаркировки.КодМаркировки,
	|	ПоступлениеТоваровУслугОтсканированныеКодыМаркировки.КодМаркировки.Номенклатура.НормализованныйКод КАК НормализованныйКод,
	|	ПоступлениеТоваровУслугОтсканированныеКодыМаркировки.КодМаркировки.КодМаркировки КАК ШтрихКод,
	|	"""" КАК ШтрихКодПолный
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.ОтсканированныеКодыМаркировки КАК ПоступлениеТоваровУслугОтсканированныеКодыМаркировки
	|ГДЕ
	|	ПоступлениеТоваровУслугОтсканированныеКодыМаркировки.Ссылка = &ОbjectIdGUID
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	БуферАрмКладовщикаМаркировки.Объект,
	|	БуферАрмКладовщикаМаркировки.Номенклатура КАК СсылкаТовара,
	|	БуферАрмКладовщикаМаркировки.Номенклатура.Наименование КАК НаименованиеТовара,
	|	БуферАрмКладовщикаМаркировки.Номенклатура.Родитель.Наименование КАК Производитель,
	|	БуферАрмКладовщикаМаркировки.Номенклатура.КодПроизводителя КАК КодПроизводителяТовара,
	|	БуферАрмКладовщикаМаркировки.Номенклатура.НормализованныйКод КАК НормализованныйКод,
	|	БуферАрмКладовщикаМаркировки.Barcode КАК ШтрихКод,
	|	БуферАрмКладовщикаМаркировки.BarcodeFull КАК ШтрихКодПолный
	|ИЗ
	|	РегистрСведений.БуферАрмКладовщикаМаркировки КАК БуферАрмКладовщикаМаркировки
	|ГДЕ
	|	БуферАрмКладовщикаМаркировки.Объект = &ОbjectIdGUID";	
	
	ДокументСсылка = Документы.ПоступлениеТоваровУслуг.ПолучитьСсылку( Новый УникальныйИдентификатор(ObjectIdGUID));

	Запрос.УстановитьПараметр("ОbjectIdGUID", ДокументСсылка);
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтруктураРезультатов = Новый Структура;
	
	ПакетРезультатов = Запрос.ВыполнитьПакет();
	
	ТаблицаОжидаемыхМаркировок       = ПакетРезультатов[0].Выгрузить();
	ТаблицаОтсканированныхМаркировок = ПакетРезультатов[1].Выгрузить(); 
	ТаблицаБуфераМаркировок          = ПакетРезультатов[2].Выгрузить(); 
	
	СтруктураРезультатов.Вставить("СписокОжидаемыхМаркировокДокументаПТУ"       , ?(ТаблицаОжидаемыхМаркировок.Количество() = 0 , Неопределено , ТаблицуВМассив(ТаблицаОжидаемыхМаркировок)));
	СтруктураРезультатов.Вставить("СписокОтсканированныхМаркировокДокументаПТУ" , ?(ТаблицаОтсканированныхМаркировок.Количество() = 0 , Неопределено , ТаблицуВМассив(ТаблицаОтсканированныхМаркировок)));
	СтруктураРезультатов.Вставить("СписокТоваровВБуфереМаркировок"              , ?(ТаблицаБуфераМаркировок.Количество() = 0 , Неопределено , ТаблицуВМассив(ТаблицаБуфераМаркировок)));

	УстановитьПривилегированныйРежим(Ложь);
	
	Результат = ДанныеВJSONХранилище(СтруктураРезультатов);
	
	ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Получить маркировки для документа", "Документ ПТУ " + ДокументСсылка.Номер);
	
	Возврат Результат;

КонецФункции

Функция ДобавитьШтрихкод(Штрихкод, ТоварГУИД, UserIdGUID) Экспорт
	
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);
	Штрихкод = СокрЛП(Штрихкод);   
	
	Попытка                             
		
		ДанныеВозврат = Новый Структура;
		УстановитьПривилегированныйРежим(Истина);	
		
		Запрос = ПолучитьТоварПоШтрихкоду(UserIdGUID, Штрихкод, "", "", Истина, "" );
		
		Запрос.Текст = Запрос.Текст + ";";		
		Запрос.УстановитьПараметр("ТоварСсылка", Справочники.Номенклатура.ПустаяСсылка());
		Запрос.УстановитьПараметр("ПТУСсылка", Документы.ПоступлениеТоваровУслуг.ПустаяСсылка());
		Запрос.УстановитьПараметр("ИскатьВПТУ", Ложь);
		
		Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		// Штрихкод был раннее привязан к номенклатуре                                                                              
		Если РезультатЗапроса.Пустой() Тогда
			
			Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(ТоварГУИД));
			НоменклатураОбъект = Номенклатура.ПолучитьОбъект();
			ЕдиницаИзмерения = НоменклатураОбъект.ЕдиницаХраненияОстатков;
			
			Качество = Справочники.Качество.Новый;
			
			Если ТипШтрихкодаEAN13ТО(Штрихкод) Тогда
				ТипШтрихкода = ПланыВидовХарактеристик.ТипыШтрихкодов.EAN13;
			Иначе
				ТипШтрихкода = ПланыВидовХарактеристик.ТипыШтрихкодов.Code39;
			КонецЕсли;
			
			МенеджерЗаписи = РегистрыСведений.Штрихкоды.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Штрихкод = Штрихкод;
			МенеджерЗаписи.Владелец = Номенклатура;
			МенеджерЗаписи.ЕдиницаИзмерения = ЕдиницаИзмерения;		
			МенеджерЗаписи.Качество = Качество;
			МенеджерЗаписи.ТипШтрихкода = ТипШтрихКода;
			МенеджерЗаписи.Записать();
			
			ДанныеВозврат.Вставить("BarcodeAdded", 1);
			ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", 
			"Добавить штрихкод к товару", "Штрихкод " + Штрихкод + "; Номенклатура " + Номенклатура.Наименование + " " + Строка(Номенклатура.Код));
			
		Иначе 
			
			ВыборкаИзРезультатаЗапроса = РезультатЗапроса.Выбрать();						
			
			Если ВыборкаИзРезультатаЗапроса.Следующий() Тогда
				
				Error = "Штрихкод " + Штрихкод + " уже есть в базе 1С, принадлежит номенклатуре ""(" +
				+ СокрЛП(ВыборкаИзРезультатаЗапроса.Код)+") " + СокрЛП(ВыборкаИзРезультатаЗапроса.Наименование) + """";
				
				ДанныеВозврат.Вставить("Ошибка", Error);	                                                    
				ДанныеВозврат.Вставить("BarcodeAdded", 0);	
				
			КонецЕсли;
			
		КонецЕсли; 				
		
		УстановитьПривилегированныйРежим(Ложь);		
		
	Исключение
		
		Error = "Ошибка при добавлнии штрихкода: " + ОписаниеОшибки();
		ДанныеВозврат.Вставить("Ошибка", Error);
		ДанныеВозврат.Вставить("BarcodeAdded", 0);
		
	КонецПопытки;
	
	Результат = ДанныеВJSONХранилище(ДанныеВозврат);	
	Возврат Результат;	
	
КонецФункции

Функция ПолучитьТоварПоНормализованномуКодуВызов(UserGUID, Код, ТипДокумента = Неопределено, ГУИДДокумента = Неопределено) Экспорт
	
	Результат = "";
	
	ТекстОтбора = "Номенклатура.НормализованныйКод ПОДОБНО ""%"" + &АртикулКод + ""%""
	|или Номенклатура.НормализованныйКод ПОДОБНО ""%"" + &АртикулКод2 + ""%""
	|или Номенклатура.НормализованныйКод ПОДОБНО ""%"" + &АртикулКод3 + ""%""";
	
	Результат = ПолучитьТоварПоНормализованномуКоду(UserGUID, Код, ТипДокумента, ГУИДДокумента, ТекстОтбора);	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьТоварПоКодуВызов(UserGUID, Код, ТипДокумента = Неопределено, ГУИДДокумента = Неопределено)  Экспорт
	
	ТекстОтбора = "Номенклатура.Код =&АртикулКод";
	
	Результат = ПолучитьТоварПоНормализованномуКоду(UserGUID, Код, ТипДокумента, ГУИДДокумента, ТекстОтбора);	
	Возврат Результат;
	
КонецФункции

Функция FindGoodByBarcode(UserGUID, Barcode, TypeDocument, GUIDDocument, GoodGUID, GetTableValues = False) Экспорт
	
	// "ПоискШтрихкодов"                                                                                             
	ТЗ =  ARMStoreKeeper.ПолучитьТоварПоШтрихкоду(UserGUID, Barcode, TypeDocument, GUIDDocument, Ложь, GoodGUID);
	
	Если ТЗ.Количество() <> 0  Тогда
		
		Если GetTableValues Тогда
			Возврат ТЗ;
		КонецЕсли; 
		МассивВременный = ARMStoreKeeper.ТаблицуВМассив(ТЗ);
		Результат = ARMStoreKeeper.ДанныеВJSONХранилище(МассивВременный);
		Возврат Результат	
		
	КонецЕсли; 
	
	// "ПоискПоНормализованномуКоду"
	ТЗ = ARMStoreKeeper.ПолучитьТоварПоНормализованномуКодуВызов(UserGUID, Barcode, TypeDocument, GUIDDocument);
	
	Если ТЗ.Количество() <>  0  Тогда
		
		Если GetTableValues Тогда
			Возврат ТЗ;
		КонецЕсли; 
		
		МассивВременный = ARMStoreKeeper.ТаблицуВМассив(ТЗ);
		Результат = ARMStoreKeeper.ДанныеВJSONХранилище(МассивВременный);
		Возврат Результат	
		
	КонецЕсли; 
	
	// "ПоискПоКоду" 
	ТЗ = ARMStoreKeeper.ПолучитьТоварПоКодуВызов(UserGUID, Barcode, TypeDocument, GUIDDocument);
	
	Если GetTableValues Тогда
		Возврат ТЗ;
	КонецЕсли; 
	
	МассивВременный = ARMStoreKeeper.ТаблицуВМассив(ТЗ);
	Результат = ARMStoreKeeper.ДанныеВJSONХранилище(МассивВременный);
	Возврат Результат	
	
КонецФункции

