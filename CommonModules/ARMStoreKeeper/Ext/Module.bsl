Функция ПолучитьСписокТранспортныхЕдиниц(DocumentGUID = Неопределено, UserGUID = Неопределено) Экспорт
	
	//+Сёмин Р. 19.12.2025 #UT10-5593
	УстановитьПривилегированныйРежим(Истина);
	
	СтатусыПриемки = Новый Массив;
	СтатусыПриемки.Добавить(Перечисления.СтатусыПриемки.ВПути);
	СтатусыПриемки.Добавить(Перечисления.СтатусыПриемки.ПоступилНаСклад);
	СтатусыПриемки.Добавить(Перечисления.СтатусыПриемки.Обработка);
	СтатусыПриемки.Добавить(Перечисления.СтатусыПриемки.ОбратитеВнимание);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПРЕДСТАВЛЕНИЕ(УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ПоступлениеТоваровУслугУпаковочныеЛисты.Ссылка)) КАК СсылкаПТУ,
		|	ПоступлениеТоваровУслугУпаковочныеЛисты.Ссылка.Дата КАК ДатаДокумента,
		|	ПоступлениеТоваровУслугУпаковочныеЛисты.Ссылка.Номер КАК НомерДокумента,
		|	ПоступлениеТоваровУслугУпаковочныеЛисты.НомерWMS КАК ТранспортнаяЕдиница,
		|	ПРЕДСТАВЛЕНИЕ(ЗначенияСвойствОбъектов.Значение) КАК СтатусПриемки,
		|	ПРЕДСТАВЛЕНИЕ(ПоступлениеТоваровУслугУпаковочныеЛисты.Ссылка) КАК Документ,
		|	ПоступлениеТоваровУслугУпаковочныеЛисты.Ссылка.НомерСкладскогоДокумента,
		|	ПоступлениеТоваровУслугУпаковочныеЛисты.Ссылка.Контрагент.Наименование КАК Контрагент,
		|	ПоступлениеТоваровУслугУпаковочныеЛисты.Ссылка.ДатаВходящегоДокумента
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг.УпаковочныеЛисты КАК ПоступлениеТоваровУслугУпаковочныеЛисты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
		|		ПО ПоступлениеТоваровУслугУпаковочныеЛисты.Ссылка = ЗначенияСвойствОбъектов.Объект
		|ГДЕ
		|	ЗначенияСвойствОбъектов.Значение В(&СтатусыПриемки)
		|	И НЕ ПоступлениеТоваровУслугУпаковочныеЛисты.Ссылка.ПометкаУдаления
		|	И ПоступлениеТоваровУслугУпаковочныеЛисты.Ссылка.Дата >= &Дата";
	
	Запрос.УстановитьПараметр("СтатусыПриемки", СтатусыПриемки);
	Запрос.УстановитьПараметр("Дата", НачалоДня(ДобавитьМесяц(ТекущаяДата(), -1)));
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	МассивВременный = ТаблицуВМассив(РезультатЗапроса);
	Результат = ДанныеВJSONХранилище(МассивВременный);
	
	Если ЗначениеЗаполнено(UserGUID) Тогда  
		UserСсылка = Справочники.ФизическиеЛица.ПолучитьСсылку(Новый УникальныйИдентификатор(UserGUID));
	Иначе 
		UserСсылка = Справочники.ФизическиеЛица.ПустаяСсылка();  
	КонецЕсли;
	
	ЗаписатьЛог(UserСсылка, ТекущаяДата(), "", "Получить список транспортных единиц", "");
	
	Возврат Результат;
	//-Сёмин Р. 19.12.2025 #UT10-5593
	
КонецФункции

Функция ПолучитьСтатусЭДОПТУ(DocumentGUID, UserGUID) Экспорт
	
	//+Сёмин Р.И. 08.06.2026 #UT10-5901
	ПТУ = Документы.ПоступлениеТоваровУслуг.ПолучитьСсылку(Новый УникальныйИдентификатор(DocumentGUID));
	СтатусЭДОПТУ = МСКWEB.ЗначениеДопСвойства(ПТУ, ПланыВидовХарактеристик.СвойстваОбъектов.СтатусПодтвержденияЭДОПТУ);
	
	Если НЕ ЗначениеЗаполнено(СтатусЭДОПТУ) Тогда
		СтатусЭДОПТУ = "";
	КонецЕсли;
	
	UserIdСсылка = ПолучитьПользователя(UserGUID);
	
	ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Получить статус ЭДО ПТУ", Строка(ПТУ.Номер)); 	
	
	Возврат ДанныеВJSONХранилище(Строка(СтатусЭДОПТУ));
	//-Сёмин Р.И. 08.06.2026 #UT10-5901
	
КонецФункции

Функция ПТУСодержитКодыМаркировкиСНарушеннымСроком(DocumentGUID, UserGUID) Экспорт
	
	//+Сёмин Р.И. 24.06.2026 #UT10-5915
	ПТУ = Документы.ПоступлениеТоваровУслуг.ПолучитьСсылку(Новый УникальныйИдентификатор(DocumentGUID));
	НарушенныеКодыМаркировки = ПТУ.КодыМаркировки.НайтиСтроки(Новый Структура("СрокНарушен", Истина));
	
	Результат = НарушенныеКодыМаркировки.Количество() > 0;
	
	UserIdСсылка = ПолучитьПользователя(UserGUID);
	
	ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "ПТУ содержит коды маркировки с нарушенным мроком", Строка(ПТУ.Номер)); 	
	
	Возврат ДанныеВJSONХранилище(Результат);
	//-Сёмин Р.И. 24.06.2026 #UT10-5915
	
КонецФункции

Функция ПолучитьСписокВходящихСлужебныхЗаписок(ДокументСсылка = Неопределено, ДокументГУИД = Неопределено, UserGUID = Неопределено) Экспорт  

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СлужебнаяЗаписка.Ссылка КАК СсылкаСлужебнаяЗаписка,
	|	СлужебнаяЗаписка.Дата КАК ДатаДокумента,
	|	СлужебнаяЗаписка.Номер КАК НомерДокумента,
	|	СлужебнаяЗаписка.НомерИнвойс ,
	|	СлужебнаяЗаписка.Получатель.Наименование КАК Контрагент,
	|	0 КАК КоличествоГрузомест
	|ИЗ
	|	Документ.СлужебнаяЗаписка КАК СлужебнаяЗаписка
	|ГДЕ
	|	СлужебнаяЗаписка.Проведен
	|	И СлужебнаяЗаписка.Входящая
	|	И НЕ СлужебнаяЗаписка.Погружено";
	
	Запрос.УстановитьПараметр("Дата" , НачалоДня(ДобавитьМесяц(ТекущаяДата(), -1)));
	
	УстановитьПривилегированныйРежим(Истина); 
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Строка Из ТЗ Цикл
		Строка.КоличествоГрузомест = Строка.СсылкаСлужебнаяЗаписка.ТранспортныеЕдиницы.Количество();
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	МассивВременный = ТаблицуВМассив(ТЗ);
	Результат = ДанныеВJSONХранилище(МассивВременный);
	
	Если ЗначениеЗаполнено(UserGUID) Тогда  
		UserСсылка = Справочники.ФизическиеЛица.ПолучитьСсылку( Новый УникальныйИдентификатор(UserGUID));
	Иначе 
		UserСсылка = Справочники.ФизическиеЛица.ПустаяСсылка();  
	КонецЕсли;
	
	ЗаписатьЛог(UserСсылка, ТекущаяДата(), "", "Получить список входящих служебных записок", "");
	
	Возврат Результат;

КонецФункции

Функция ПолучитьСписокОбъединений(UserGUID, UnionGUID, Завершенные = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	БуферАРМКладовщикаОбъединениеТЕ.Объединение,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ БуферАРМКладовщикаОбъединениеТЕ.ГрузовоеМесто) КАК КоличествоГМ
	|ПОМЕСТИТЬ ВТ_БуферПоКомплектовщику
	|ИЗ
	|	РегистрСведений.БуферАРМКладовщикаОбъединениеТЕ КАК БуферАРМКладовщикаОбъединениеТЕ
	|ГДЕ
	|	БуферАРМКладовщикаОбъединениеТЕ.UserId = &Комплектовщик
	|	И (&БезОтбораПоДокументу
	|			ИЛИ БуферАРМКладовщикаОбъединениеТЕ.Объединение = &Объединение)
	|
	|СГРУППИРОВАТЬ ПО
	|	БуферАРМКладовщикаОбъединениеТЕ.Объединение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОбъединениеГМВТЕ.Ссылка КАК СсылкаОбъединение,
	|	ОбъединениеГМВТЕ.Грузополучатель.Наименование КАК Контрагент,
	|	ОбъединениеГМВТЕ.Номер КАК НомерДокумента,
	|	ОбъединениеГМВТЕ.Дата КАК ДатаДокумента,
	|	ПРЕДСТАВЛЕНИЕ(ОбъединениеГМВТЕ.Статус) КАК Статус,
	|	ЕСТЬNULL(ВТ_БуферПоКомплектовщику.КоличествоГМ, 0) КАК КоличествоГрузоместВБуфере
	|ПОМЕСТИТЬ ВТ_Объединения
	|ИЗ
	|	Документ.ОбъединениеГМВТЕ КАК ОбъединениеГМВТЕ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_БуферПоКомплектовщику КАК ВТ_БуферПоКомплектовщику
	|		ПО ОбъединениеГМВТЕ.Ссылка = ВТ_БуферПоКомплектовщику.Объединение
	|ГДЕ
	|	ОбъединениеГМВТЕ.Проведен
	|	И ВЫБОР
	|			КОГДА &Завершенные
	|				ТОГДА ОбъединениеГМВТЕ.Комплектовщик = &Комплектовщик
	|						И ОбъединениеГМВТЕ.Статус В (&СписокЗавершенныхСтатусов)
	|			ИНАЧЕ ОбъединениеГМВТЕ.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОбъединений.Создано)
	|					ИЛИ ОбъединениеГМВТЕ.Комплектовщик = &Комплектовщик
	|						И ОбъединениеГМВТЕ.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОбъединений.ВПроцессеОбъединения)
	|		КОНЕЦ
	|	И (&БезОтбораПоДокументу
	|			ИЛИ ОбъединениеГМВТЕ.Ссылка = &Объединение)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ОбъединениеГМВТЕТранспортныеЕдиницы.ГрузовоеМесто) КАК КоличествоГМ,
	|	СУММА(ВЫБОР
	|			КОГДА НЕ ОбъединениеГМВТЕТранспортныеЕдиницы.ТранспортнаяЕдиница = ЗНАЧЕНИЕ(Документ.ТранспортнаяЕдиница.ПустаяСсылка)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоГМОбъединено,
	|	ОбъединениеГМВТЕТранспортныеЕдиницы.Ссылка КАК Объединение
	|ПОМЕСТИТЬ ВТ_КоличествоПоОбъединениям
	|ИЗ
	|	Документ.ОбъединениеГМВТЕ.ТранспортныеЕдиницы КАК ОбъединениеГМВТЕТранспортныеЕдиницы
	|
	|СГРУППИРОВАТЬ ПО
	|	ОбъединениеГМВТЕТранспортныеЕдиницы.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Объединения.СсылкаОбъединение,
	|	ВТ_Объединения.Контрагент,
	|	ВТ_Объединения.НомерДокумента,
	|	ВТ_Объединения.ДатаДокумента,
	|	ВТ_Объединения.Статус,
	|	ВТ_Объединения.КоличествоГрузоместВБуфере,
	|	ВТ_КоличествоПоОбъединениям.КоличествоГМ КАК КоличествоГрузомест,
	|	ВТ_КоличествоПоОбъединениям.КоличествоГМ - ВТ_КоличествоПоОбъединениям.КоличествоГМОбъединено - ВТ_Объединения.КоличествоГрузоместВБуфере КАК НеОбъединено,
	|	ВТ_Объединения.СсылкаОбъединение.Штрихкод КАК Штрихкод
	|ИЗ
	|	ВТ_Объединения КАК ВТ_Объединения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_КоличествоПоОбъединениям КАК ВТ_КоличествоПоОбъединениям
	|		ПО ВТ_Объединения.СсылкаОбъединение = ВТ_КоличествоПоОбъединениям.Объединение";

	UserСсылка = Справочники.ФизическиеЛица.ПолучитьСсылку(Новый УникальныйИдентификатор(UserGUID));
	
	Запрос.УстановитьПараметр("Комплектовщик", UserСсылка); 
	Запрос.УстановитьПараметр("Завершенные", Завершенные); 
	
	СписокЗавершенныхСтатусов = Новый СписокЗначений;
	СписокЗавершенныхСтатусов.Добавить(Перечисления.СтатусыОбъединений.ОжиданиеПогрузки);
	СписокЗавершенныхСтатусов.Добавить(Перечисления.СтатусыОбъединений.Погружено);
	
	Запрос.УстановитьПараметр("СписокЗавершенныхСтатусов", СписокЗавершенныхСтатусов);  
	
	ОбъединениеСсылка = Неопределено;
	
	Если ЗначениеЗаполнено(UnionGUID) Тогда 	
		ОбъединениеСсылка = Документы.ОбъединениеГМВТЕ.ПолучитьСсылку(Новый УникальныйИдентификатор(UnionGUID));		
	КонецЕсли;                              
	
	Запрос.УстановитьПараметр("Объединение", ОбъединениеСсылка);
	Запрос.УстановитьПараметр("БезОтбораПоДокументу", Не ЗначениеЗаполнено(ОбъединениеСсылка));

	
	УстановитьПривилегированныйРежим(Истина); 
	
	Пакет = Запрос.ВыполнитьПакет();
	ТЗ = Пакет[3].Выгрузить();
		
	УстановитьПривилегированныйРежим(Ложь);
	
	МассивВременный = ТаблицуВМассив(ТЗ);    
	
	Если ЗначениеЗаполнено(UnionGUID) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	БуферАРМКладовщикаОбъединениеТЕ.ГрузовоеМесто,
		//+Сёмин Р.И. 08.04.2026 #UT10-5772
		|	БуферАРМКладовщикаОбъединениеТЕ.ГрузовоеМесто.Сборка.ТребуетсяМаркировка КАК ТребуетсяМаркировка,
		//-Сёмин Р.И. 08.04.2026 #UT10-5772
		|	БуферАРМКладовщикаОбъединениеТЕ.ГрузовоеМесто.Сборка.Назначение КАК Назначение
		|ИЗ
		|	РегистрСведений.БуферАРМКладовщикаОбъединениеТЕ КАК БуферАРМКладовщикаОбъединениеТЕ
		|ГДЕ
		|	БуферАРМКладовщикаОбъединениеТЕ.Объединение = &Объединение
		|	И БуферАРМКладовщикаОбъединениеТЕ.UserId = &UserId";
		
		Запрос.УстановитьПараметр("UserId", UserСсылка);  
		Запрос.УстановитьПараметр("Объединение", ОбъединениеСсылка);
		
		ГМБуфер = Новый Массив;
		
		Выборка = Запрос.Выполнить().Выбрать();  
		
		Пока Выборка.Следующий() Цикл
			
			СтруктураГМ = Новый Структура();
			СтруктураГМ.Вставить("ГМ", ОбщегоНазначения.ПолучитьНомерНаПечать(Выборка.ГрузовоеМесто));
			СтруктураГМ.Вставить("Назначение", Строка(Выборка.Назначение));  
			СтруктураГМ.Вставить("ШК", Документы.ГрузовоеМесто.ПолучитьШтрихкодГрузоместа(Выборка.ГрузовоеМесто));
			СтруктураГМ.Вставить("ГУИД", Строка(Выборка.ГрузовоеМесто.УникальныйИдентификатор()));
			//+Сёмин Р.И. 08.04.2026 #UT10-5772
			СтруктураГМ.Вставить("ТребуетсяМаркировка", Выборка.ТребуетсяМаркировка);  
			//-Сёмин Р.И. 08.04.2026 #UT10-5772
			
			ГМБуфер.Добавить(СтруктураГМ);
			
		КонецЦикла;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОбъединениеГМВТЕТранспортныеЕдиницы.ГрузовоеМесто,
		//+Сёмин Р.И. 08.04.2026 #UT10-5772
		|	ОбъединениеГМВТЕТранспортныеЕдиницы.ГрузовоеМесто.Сборка.ТребуетсяМаркировка КАК ТребуетсяМаркировка,
		//-Сёмин Р.И. 08.04.2026 #UT10-5772
		|	ОбъединениеГМВТЕТранспортныеЕдиницы.ГрузовоеМесто.Сборка.Назначение КАК Назначение,
		|	ПРЕДСТАВЛЕНИЕ(ОбъединениеГМВТЕТранспортныеЕдиницы.Статус) КАК Статус
		|ИЗ
		|	Документ.ОбъединениеГМВТЕ.ТранспортныеЕдиницы КАК ОбъединениеГМВТЕТранспортныеЕдиницы
		|ГДЕ
		|	ОбъединениеГМВТЕТранспортныеЕдиницы.Ссылка = &Объединение";
		
		Запрос.УстановитьПараметр("Объединение", ОбъединениеСсылка);
		
		ГМ = Новый Массив;
		
		Выборка = Запрос.Выполнить().Выбрать();  
		
		Пока Выборка.Следующий() Цикл
			
			СтруктураГМ = Новый Структура();
			СтруктураГМ.Вставить("ГМ", ОбщегоНазначения.ПолучитьНомерНаПечать(Выборка.ГрузовоеМесто));
			СтруктураГМ.Вставить("Назначение", Строка(Выборка.Назначение));  
			СтруктураГМ.Вставить("ШК", Документы.ГрузовоеМесто.ПолучитьШтрихкодГрузоместа(Выборка.ГрузовоеМесто));
			СтруктураГМ.Вставить("ГУИД", Строка(Выборка.ГрузовоеМесто.УникальныйИдентификатор()));
			СтруктураГМ.Вставить("Статус", Выборка.Статус);
			//+Сёмин Р.И. 08.04.2026 #UT10-5772
			СтруктураГМ.Вставить("ТребуетсяМаркировка", Выборка.ТребуетсяМаркировка);  
			//-Сёмин Р.И. 08.04.2026 #UT10-5772
			
			ГМ.Добавить(СтруктураГМ);
			
		КонецЦикла;	
						
		Результат = ДанныеВJSONХранилище(Новый Структура("Шапка, ГМБуфер, ГМ", МассивВременный, ГМБуфер, ГМ));  
		
	Иначе
		Результат = ДанныеВJSONХранилище(МассивВременный);		
	КонецЕсли;
		
	ЗаписатьЛог(UserСсылка, ТекущаяДата(), "", "Получить список объединений", "");
	
	Возврат Результат;
	
КонецФункции

Функция ОткрытьЗакрытьТЕ(UnionGUID, UserGUID) Экспорт
	
	СтруктураОтвета = Новый Структура("Результат, Сообщение", Ложь, "");   
	
	Объединение = Документы.ОбъединениеГМВТЕ.ПолучитьСсылку(Новый УникальныйИдентификатор(UnionGUID));
	
	Если Объединение.ПолучитьОбъект() = Неопределено Тогда 
		
		СтруктураОтвета.Сообщение = "Не найдено объединение";
		Возврат СтруктураОтвета;  
		
	КонецЕсли;  
	
	UserIdСсылка = Справочники.ФизическиеЛица.ПолучитьСсылку(Новый УникальныйИдентификатор(UserGUID));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	БуферАРМКладовщикаОбъединениеТЕ.ГрузовоеМесто
	|ИЗ
	|	РегистрСведений.БуферАРМКладовщикаОбъединениеТЕ КАК БуферАРМКладовщикаОбъединениеТЕ
	|ГДЕ
	|	БуферАРМКладовщикаОбъединениеТЕ.UserId = &UserId
	|	И БуферАРМКладовщикаОбъединениеТЕ.Объединение = &Объединение
	|
	|СГРУППИРОВАТЬ ПО
	|	БуферАРМКладовщикаОбъединениеТЕ.ГрузовоеМесто";
	
	Запрос.УстановитьПараметр("UserId", UserIdСсылка);  
	Запрос.УстановитьПараметр("Объединение", Объединение);  
	
	Результат = Запрос.Выполнить().Выгрузить(); 
	
	Если Результат.Количество() > 0 Тогда
		
		ОбъединениеОб = Объединение.ПолучитьОбъект();

		ТЕ = Документы.ТранспортнаяЕдиница.СоздатьДокумент();
		ТЕ.Дата = ТекущаяДата();
		ТЕ.Ответственный = Объединение.Комплектовщик;  
		ТЕ.Объединение = Объединение;
		ТЕ.УстановитьСсылкуНового(Документы.ТранспортнаяЕдиница.ПолучитьСсылку(Новый УникальныйИдентификатор()));          
		
		Для каждого Стр Из Результат Цикл
			
			НСтр = ТЕ.ГрузовыеМеста.Добавить();
			НСтр.ГрузовоеМесто = Стр.ГрузовоеМесто;
			НСтр.Вес = Документы.ГрузовоеМесто.ПолучитьВесГМ(Стр.ГрузовоеМесто); 
			
			СтрокаПоиска = ОбъединениеОб.ТранспортныеЕдиницы.Найти(Стр.ГрузовоеМесто, "ГрузовоеМесто");   
			
			Если СтрокаПоиска <> Неопределено Тогда
				
				СтрокаПоиска.Статус = Перечисления.СтатусыОбъединенияГМ.Объединено;
				СтрокаПоиска.ТранспортнаяЕдиница = ТЕ.ПолучитьСсылкуНового();
				
			КонецЕсли;

		КонецЦикла;	  
		
		Если ОбъединениеОб.ТранспортныеЕдиницы.НайтиСтроки(Новый Структура("Статус", Перечисления.СтатусыОбъединенияГМ.Объединено)).Количество() = ОбъединениеОб.ТранспортныеЕдиницы.Количество() Тогда
			
			ОбъединениеОб.Статус = Перечисления.СтатусыОбъединений.ОжиданиеПогрузки;		
			ОбъединениеОб.Объединено = Истина;
			ОбъединениеОб.ВремяОкончанияОбъединения = ТекущаяДата();
			
		КонецЕсли;
		
		Попытка
			
			НачатьТранзакцию();  
			
			ТЕ.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);     
			ОбъединениеОб.Записать(); 
			
			НаборБуфера = РегистрыСведений.БуферАРМКладовщикаОбъединениеТЕ.СоздатьНаборЗаписей();	
			НаборБуфера.Отбор.Объединение.Установить(Объединение);
			НаборБуфера.Отбор.UserId.Установить(UserIdСсылка);
			НаборБуфера.Записать(Истина);	   
			
			СтруктураОтвета.Результат = Истина;
			СтруктураОтвета.Сообщение = "Документ: " + Строка(ТЕ) + " был успешно создан и проведен." + Символы.ПС + Символы.ПС + "Приклейте ШК ТЕ на сформированную транспортную единицу";
			
			ТабличныйДокумент = Документы.ТранспортнаяЕдиница.Печать(Объединение, ТЕ.Ссылка, Ложь, Истина);    
			
			Если ТабличныйДокумент <> Неопределено Тогда
				РегистрыСведений.ОчередьПечатиДокументов.ДобавитьТабличныйДокументВОчередь(UserIdСсылка, ТабличныйДокумент, "ТЕ");	
			КонецЕсли;

			ЗафиксироватьТранзакцию();      
			
		Исключение 			
			
		    ОтменитьТранзакцию();                        		
			СтруктураОтвета.Сообщение = ОписаниеОшибки();
			              
		КонецПопытки;
						
	Иначе   
		
		ОбъединениеОб = Объединение.ПолучитьОбъект(); 
		
		Если ЗначениеЗаполнено(ОбъединениеОб.Комплектовщик) И ОбъединениеОб.Комплектовщик <> UserIdСсылка Тогда 
			
			СтруктураОтвета.Сообщение = "Объединение уже начато другим комплектовщиком"; 
			Возврат СтруктураОтвета;  
			
		КонецЕсли; 
		
		СтруктураОтвета.Результат = Истина;
		
		ЧтоТоУжеУпаковано = ЧтоТоУжеУпаковано(Объединение);
		
		Если Не ЗначениеЗаполнено(ОбъединениеОб.Комплектовщик) Тогда
			
			Если Не ЗначениеЗаполнено(ОбъединениеОб.ВремяНачалаОбъединения) Тогда
				ОбъединениеОб.ВремяНачалаОбъединения = ТекущаяДата();   
			Иначе      
				
				Если Не ЧтоТоУжеУпаковано Тогда
					ВремяНачалаОбъединения = ТекущаяДата();	
				КонецЕсли;
				
			КонецЕсли;        
			
			ОбъединениеОб.Комплектовщик = UserIdСсылка;  
			ОбъединениеОб.Статус = Перечисления.СтатусыОбъединений.ВПроцессеОбъединения; 
			ОбъединениеОб.Записать();	
			
		КонецЕсли;	
		
	КонецЕсли; 
	
	Возврат СтруктураОтвета;
		
КонецФункции

Функция ЧтоТоУжеУпаковано(Объединение)
	
	ЧтоТоУжеУпаковано = Ложь;
	
	Для каждого СтрТовара Из Объединение.ТранспортныеЕдиницы Цикл
		
		Если ЗначениеЗаполнено(СтрТовара.ТранспортнаяЕдиница) Тогда
			
			ЧтоТоУжеУпаковано = Истина;
			Прервать;
			
		КонецЕсли; 					
		
	КонецЦикла; 
	
	Возврат ЧтоТоУжеУпаковано;
			
КонецФункции

Функция ПолучитьСписокГрузовыхМестСлужебныхЗаписок(DocumentGUID, UserIdGUID) Экспорт
	
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);
	СлужебнаяЗапискаСсылка = Документы.СлужебнаяЗаписка.ПолучитьСсылку(Новый УникальныйИдентификатор(DocumentGUID));
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СлужебнаяЗапискаТранспортныеЕдиницы.Ссылка КАК СсылкаСлужебнаяЗаписка,
	|	СлужебнаяЗапискаТранспортныеЕдиницы.Грузоместо КАК ШтрихкодГрузовогоМеста
	|ИЗ
	|	Документ.СлужебнаяЗаписка.ТранспортныеЕдиницы КАК СлужебнаяЗапискаТранспортныеЕдиницы
	|ГДЕ
	|	СлужебнаяЗапискаТранспортныеЕдиницы.Ссылка = &Ссылка
	|	И НЕ СлужебнаяЗапискаТранспортныеЕдиницы.Ссылка.Погружено";
	
	Запрос.УстановитьПараметр("Ссылка", СлужебнаяЗапискаСсылка);
	
	ТЗ = Запрос.Выполнить().Выгрузить();	         
	
	МассивВременный = ТаблицуВМассив(ТЗ);
	Результат = ДанныеВJSONХранилище(МассивВременный);
	
	ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Получить список грузовых мест из документа Служебная записка ", "Служебная записка " + СлужебнаяЗапискаСсылка);
	
	Возврат Результат;
	
КонецФункции

Функция ОбработатьСлужебнуюЗапискуВходящую(DocumentGUID, UserIdGUID) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Ошибка", "");
	ЭтоДокументПТУ = Истина;
	
	ДокументСлужебнаяЗаписка = Документы.СлужебнаяЗаписка.ПолучитьСсылку(Новый УникальныйИдентификатор(DocumentGUID));
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);
	
	Если ДокументСлужебнаяЗаписка.ПометкаУдаления Тогда
		
		ТекстОшибки = "" + ДокументСлужебнаяЗаписка + " помечен на удаление. Обработка невозможна";
		Результат.Вставить("Ошибка"             , ТекстОшибки);
		Результат.Вставить("КодРезультата"      , 0);
		Результат.Вставить("ЗначениеРезультата" , "");
		Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
		Возврат Результат;
		
	КонецЕсли;
	
	Попытка
		
		ДокОбъект           = ДокументСлужебнаяЗаписка.ПолучитьОбъект();
		ДокОбъект.Погружено = Истина;
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		
		Результат.Вставить("КодРезультата", 300);

	Исключение      
		
		ТекстОшибки = "" + ДокументСлужебнаяЗаписка + " невозможно записать. Обработка невозможна.";				
		Результат.Вставить("Ошибка"             , ТекстОшибки);
		Результат.Вставить("КодРезультата"      , 2);
		Результат.Вставить("ЗначениеРезультата" , "");
		Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
		Возврат Результат;
		
	КонецПопытки; 
	
	Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
	Возврат Результат;

КонецФункции
	
Функция ПолучитьСписокЗаданийНаДоставку(UserIdGUID) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДокЗаданиеНаДоставку.Ссылка КАК Документ,
	|	ДокЗаданиеНаДоставку.Водитель.Наименование
	|ПОМЕСТИТЬ ТаблЗаданий
	|ИЗ
	|	Документ.ЗаданиеНаДоставку КАК ДокЗаданиеНаДоставку
	|ГДЕ
	|	ДокЗаданиеНаДоставку.Проведен = ИСТИНА
	|	И ДокЗаданиеНаДоставку.Дата >= &Дата
	|
	|СГРУППИРОВАТЬ ПО
	|	ДокЗаданиеНаДоставку.Ссылка,
	|	ДокЗаданиеНаДоставку.Водитель.Наименование
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПогрузкаВАвто.Ссылка,
	|	ПогрузкаВАвто.ЗаданиеНаДоставку КАК ЗаданиеНаДоставку
	|ПОМЕСТИТЬ ТаблПогрузок
	|ИЗ
	|	Документ.ПогрузкаВАвто КАК ПогрузкаВАвто
	|ГДЕ
	|	ПогрузкаВАвто.ЗаданиеНаДоставку.Дата >= &Дата
	|	И ПогрузкаВАвто.Проведен = ИСТИНА
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ЗаданиеНаДоставку
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблЗаданий.Документ КАК Объект,
	|	ТаблЗаданий.Документ.Номер КАК Номер,
	|	ТаблЗаданий.Документ.Дата КАК ДатаДокумента,
	|	ВЫРАЗИТЬ(ЕСТЬNULL(ТаблЗаданий.ВодительНаименование, """") КАК СТРОКА(1000)) КАК ВодительНаименование,
	|	ВЫРАЗИТЬ("""" КАК СТРОКА(1000)) КАК Штрихкод,
	|	ЕСТЬNULL(МаршрутыДоставки.Наименование, """") КАК Маршрут
	|ПОМЕСТИТЬ ВТЗаданияНаДоставкуШапка
	|ИЗ
	|	ТаблЗаданий КАК ТаблЗаданий
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблПогрузок КАК ТаблПогрузок
	|		ПО ТаблЗаданий.Документ = ТаблПогрузок.ЗаданиеНаДоставку
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.МаршрутыДоставки КАК МаршрутыДоставки
	|		ПО ТаблЗаданий.Документ.Маршрут = МаршрутыДоставки.Ссылка
	|ГДЕ
	|	ТаблПогрузок.Ссылка ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТЧДоставка.ДокументСборки,
	|	ТЧДоставка.Ссылка.Маршрут,
	|	ТЧДоставка.Ссылка.Номер КАК НомерЗаданияНаДоставку,
	|	ТЧДоставка.Ссылка КАК СсылкаЗаданияНаДоставку
	|ПОМЕСТИТЬ ВТЗаданияНаДоставкуТаблица
	|ИЗ
	|	Документ.ЗаданиеНаДоставку.Доставка КАК ТЧДоставка
	|ГДЕ
	|	ТЧДоставка.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТЗаданияНаДоставкуШапка.Объект
	|			ИЗ
	|				ВТЗаданияНаДоставкуШапка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТЧДоставка.ДокументСборки,
	|	ТЧДоставка.Ссылка.Маршрут,
	|	ТЧДоставка.Ссылка.Номер,
	|	ТЧДоставка.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТЗаданияНаДоставкуТаблица.НомерЗаданияНаДоставку,
	|	ВТЗаданияНаДоставкуТаблица.СсылкаЗаданияНаДоставку,
	|	СУММА(ВЫБОР
	|			КОГДА ГрузовоеМесто.Погружено = ИСТИНА
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоПогружено,
	|	СУММА(ВЫБОР
	|			КОГДА ГрузовоеМесто.Погружено = ЛОЖЬ
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоНеЗагружено,
	|	СУММА(1) КАК КоличествоВсего
	|ПОМЕСТИТЬ ВТКоличествоГрузовыхМест
	|ИЗ
	|	ВТЗаданияНаДоставкуТаблица КАК ВТЗаданияНаДоставкуТаблица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ГрузовоеМесто КАК ГрузовоеМесто
	|		ПО ВТЗаданияНаДоставкуТаблица.ДокументСборки = ГрузовоеМесто.Сборка
	|ГДЕ
	|	ГрузовоеМесто.ПометкаУдаления = ЛОЖЬ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТЗаданияНаДоставкуТаблица.НомерЗаданияНаДоставку,
	|	ВТЗаданияНаДоставкуТаблица.СсылкаЗаданияНаДоставку
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТЗаданияНаДоставкуТаблица.НомерЗаданияНаДоставку,
	|	ВТЗаданияНаДоставкуТаблица.СсылкаЗаданияНаДоставку,
	|	СУММА(ВЫБОР
	|			КОГДА СлужебнаяЗапискаТранспортныеЕдиницы.Ссылка.Погружено
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ),
	|	СУММА(ВЫБОР
	|			КОГДА НЕ СлужебнаяЗапискаТранспортныеЕдиницы.Ссылка.Погружено
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ),
	|	СУММА(ВЫБОР
	|			КОГДА СлужебнаяЗапискаТранспортныеЕдиницы.Ссылка ЕСТЬ NULL
	|				ТОГДА 0
	|			ИНАЧЕ 1
	|		КОНЕЦ)
	|ИЗ
	|	ВТЗаданияНаДоставкуТаблица КАК ВТЗаданияНаДоставкуТаблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СлужебнаяЗаписка.ТранспортныеЕдиницы КАК СлужебнаяЗапискаТранспортныеЕдиницы
	|		ПО ВТЗаданияНаДоставкуТаблица.ДокументСборки = СлужебнаяЗапискаТранспортныеЕдиницы.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТЗаданияНаДоставкуТаблица.НомерЗаданияНаДоставку,
	|	ВТЗаданияНаДоставкуТаблица.СсылкаЗаданияНаДоставку
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТЗаданияНаДоставкуТаблица.НомерЗаданияНаДоставку,
	|	ВТЗаданияНаДоставкуТаблица.СсылкаЗаданияНаДоставку,
	|	СУММА(ВЫБОР
	|			КОГДА ОбъединенияСТЕ.ТранспортнаяЕдиница.Погружено
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ),
	|	СУММА(ВЫБОР
	|			КОГДА НЕ ОбъединенияСТЕ.ТранспортнаяЕдиница.Погружено
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ),
	|	СУММА(ВЫБОР
	|			КОГДА ОбъединенияСТЕ.ТранспортнаяЕдиница.Ссылка ЕСТЬ NULL
	|				ТОГДА 0
	|			ИНАЧЕ 1
	|		КОНЕЦ)
	|ИЗ
	|	ВТЗаданияНаДоставкуТаблица КАК ВТЗаданияНаДоставкуТаблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ОбъединениеГМВТЕТранспортныеЕдиницы.Ссылка КАК Объединение,
	|			ОбъединениеГМВТЕТранспортныеЕдиницы.ТранспортнаяЕдиница КАК ТранспортнаяЕдиница
	|		ИЗ
	|			Документ.ОбъединениеГМВТЕ.ТранспортныеЕдиницы КАК ОбъединениеГМВТЕТранспортныеЕдиницы
	|		ГДЕ
	|			ОбъединениеГМВТЕТранспортныеЕдиницы.Ссылка В
	|					(ВЫБРАТЬ
	|						ВТЗаданияНаДоставкуТаблица.ДокументСборки
	|					ИЗ
	|						ВТЗаданияНаДоставкуТаблица)
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ОбъединениеГМВТЕТранспортныеЕдиницы.Ссылка,
	|			ОбъединениеГМВТЕТранспортныеЕдиницы.ТранспортнаяЕдиница) КАК ОбъединенияСТЕ
	|		ПО ВТЗаданияНаДоставкуТаблица.ДокументСборки = ОбъединенияСТЕ.Объединение
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТЗаданияНаДоставкуТаблица.НомерЗаданияНаДоставку,
	|	ВТЗаданияНаДоставкуТаблица.СсылкаЗаданияНаДоставку
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТКоличествоГрузовыхМест.НомерЗаданияНаДоставку,
	|	ВТКоличествоГрузовыхМест.СсылкаЗаданияНаДоставку,
	|	СУММА(ВТКоличествоГрузовыхМест.КоличествоПогружено) КАК КоличествоПогружено,
	|	СУММА(ВТКоличествоГрузовыхМест.КоличествоНеЗагружено) КАК КоличествоНеЗагружено,
	|	СУММА(ВТКоличествоГрузовыхМест.КоличествоВсего) КАК КоличествоВсего
	|ПОМЕСТИТЬ ВТКоличествоГрузовыхМестИтог
	|ИЗ
	|	ВТКоличествоГрузовыхМест КАК ВТКоличествоГрузовыхМест
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТКоличествоГрузовыхМест.НомерЗаданияНаДоставку,
	|	ВТКоличествоГрузовыхМест.СсылкаЗаданияНаДоставку
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТЗаданияНаДоставкуШапка.Объект,
	|	ВТЗаданияНаДоставкуШапка.Номер,
	|	ВТЗаданияНаДоставкуШапка.ДатаДокумента,
	|	ВТЗаданияНаДоставкуШапка.ВодительНаименование,
	|	ВТЗаданияНаДоставкуШапка.Штрихкод,
	|	ВТЗаданияНаДоставкуШапка.Маршрут,
	|	ВТКоличествоГрузовыхМестИтог.КоличествоПогружено,
	|	ВТКоличествоГрузовыхМестИтог.КоличествоНеЗагружено,
	|	ВТКоличествоГрузовыхМестИтог.КоличествоВсего
	|ИЗ
	|	ВТЗаданияНаДоставкуШапка КАК ВТЗаданияНаДоставкуШапка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТКоличествоГрузовыхМестИтог КАК ВТКоличествоГрузовыхМестИтог
	|		ПО ВТЗаданияНаДоставкуШапка.Объект = ВТКоличествоГрузовыхМестИтог.СсылкаЗаданияНаДоставку";	
	
	Запрос.УстановитьПараметр("Дата",ТекущаяДата()- 86400*3);  
	
	УстановитьПривилегированныйРежим(Истина);
	ТЗ = Запрос.Выполнить().Выгрузить();	
	УстановитьПривилегированныйРежим(Ложь);
	
	Для каждого Запись Из ТЗ Цикл
		Запись.Штрихкод = ШтрихкодированиеПечатныхФорм.ЧисловойКодПоСсылке(Запись.Объект);
	КонецЦикла;                  
	
	//Возврат Сериализовать(ТЗ);
	МассивВременный = ТаблицуВМассив(ТЗ);
	Результат = ДанныеВJSONХранилище(МассивВременный);
	
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);
	ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Получить список заданий на доставку", "");
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСписокЗаданийНаДоставкуИзДокументовРазгрузкаАвто(UserIdGUID) Экспорт
	
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	РазгрузкаАвто.ЗаданиеНаДоставку КАК Объект,
	|	ВЫРАЗИТЬ(ЕСТЬNULL(РазгрузкаАвто.Водитель.Наименование, """") КАК СТРОКА(1000)) КАК ВодительНаименование,
	|	ВЫРАЗИТЬ("""" КАК СТРОКА(1000)) КАК Штрихкод,
	|	ДокЗаданиеНаДоставку.Номер КАК Номер,
	|	ДокЗаданиеНаДоставку.Дата КАК ДатаДокумента,
	|	ЕСТЬNULL(МаршрутыДоставки.Наименование, """") КАК Маршрут,
	|	РазгрузкаАвто.Ссылка КАК РазгрузкаАвтоГУИД,
	|	РазгрузкаАвто.Номер КАК РазгрузкаАвтоНомер,
	|	РазгрузкаАвто.Грузополучатель КАК ГрузополучательГУИД,
	|	РазгрузкаАвто.Грузополучатель.Наименование КАК ГрузополучательНаименование
	|ПОМЕСТИТЬ ВТРазрузкаАвто
	|ИЗ
	|	Документ.РазгрузкаАвто КАК РазгрузкаАвто
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаданиеНаДоставку КАК ДокЗаданиеНаДоставку
	|		ПО РазгрузкаАвто.ЗаданиеНаДоставку = ДокЗаданиеНаДоставку.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.МаршрутыДоставки КАК МаршрутыДоставки
	|		ПО (ДокЗаданиеНаДоставку.Маршрут = МаршрутыДоставки.Ссылка)
	|ГДЕ
	|	(РазгрузкаАвто.Водитель = &Водитель
	|			ИЛИ РазгрузкаАвто.Водитель = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка))
	|	И РазгрузкаАвто.Дата >= &Дата
	|	И РазгрузкаАвто.Проведен
	|	И РазгрузкаАвто.ГМПринял = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ГрузовыеМестаТабЧасть.Ссылка КАК РазгрузкаАвто,
	|	ДокРазгрузкаАвтоШапка.ЗаданиеНаДоставку КАК ЗаданиеНаДоставку,
	|	СУММА(1) КАК КоличествоВсего
	|ПОМЕСТИТЬ ВТГрузМестаВДокум
	|ИЗ
	|	Документ.РазгрузкаАвто.ГрузовыеМеста КАК ГрузовыеМестаТабЧасть
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РазгрузкаАвто КАК ДокРазгрузкаАвтоШапка
	|		ПО ГрузовыеМестаТабЧасть.Ссылка = ДокРазгрузкаАвтоШапка.Ссылка
	|ГДЕ
	|	(ДокРазгрузкаАвтоШапка.Водитель = &Водитель
	|			ИЛИ ДокРазгрузкаАвтоШапка.Водитель = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка))
	|	И ДокРазгрузкаАвтоШапка.Дата >= &Дата
	|	И ДокРазгрузкаАвтоШапка.Проведен
	|	И ДокРазгрузкаАвтоШапка.ГМПринял = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ГрузовыеМестаТабЧасть.Ссылка,
	|	ДокРазгрузкаАвтоШапка.ЗаданиеНаДоставку
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	БуферАРМКладовщикаРазгрузкаАвто.ЗаданиеНаДоставку,
	|	БуферАРМКладовщикаРазгрузкаАвто.Объект,
	|	СУММА(1) КАК Количество
	|ПОМЕСТИТЬ ВТРазгруженоРС
	|ИЗ
	|	РегистрСведений.БуферАРМКладовщикаРазгрузкаАвто КАК БуферАРМКладовщикаРазгрузкаАвто
	|ГДЕ
	|	БуферАРМКладовщикаРазгрузкаАвто.UserId = &Водитель
	|
	|СГРУППИРОВАТЬ ПО
	|	БуферАРМКладовщикаРазгрузкаАвто.ЗаданиеНаДоставку,
	|	БуферАРМКладовщикаРазгрузкаАвто.Объект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТРазрузкаАвто.Объект,
	|	ВТРазрузкаАвто.ВодительНаименование,
	|	ВТРазрузкаАвто.Штрихкод,
	|	ВТРазрузкаАвто.Номер,
	|	ВТРазрузкаАвто.ДатаДокумента,
	|	ВТРазрузкаАвто.Маршрут,
	|	ВТРазрузкаАвто.РазгрузкаАвтоГУИД,
	|	ВТРазрузкаАвто.РазгрузкаАвтоНомер,
	|	ВТРазрузкаАвто.ГрузополучательГУИД,
	|	ВТРазрузкаАвто.ГрузополучательНаименование,
	|	ЕСТЬNULL(ВТГрузМестаВДокум.КоличествоВсего, 0) КАК КоличествоВсего,
	|	ЕСТЬNULL(ВТРазгруженоРС.Количество, 0) КАК КоличествоРазгружено,
	|	ЕСТЬNULL(ВТГрузМестаВДокум.КоличествоВсего, 0) - ЕСТЬNULL(ВТРазгруженоРС.Количество, 0) КАК КоличествоНеРазгружено
	|ИЗ
	|	ВТРазрузкаАвто КАК ВТРазрузкаАвто
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТГрузМестаВДокум КАК ВТГрузМестаВДокум
	|		ПО ВТРазрузкаАвто.РазгрузкаАвтоГУИД = ВТГрузМестаВДокум.РазгрузкаАвто
	|			И ВТРазрузкаАвто.Объект = ВТГрузМестаВДокум.ЗаданиеНаДоставку
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТРазгруженоРС КАК ВТРазгруженоРС
	|		ПО ВТРазрузкаАвто.Объект = ВТРазгруженоРС.ЗаданиеНаДоставку
	|			И ВТРазрузкаАвто.РазгрузкаАвтоГУИД = ВТРазгруженоРС.Объект";
	
	Запрос.УстановитьПараметр("Водитель", UserIdСсылка);		
	Запрос.УстановитьПараметр("Дата",     ТекущаяДата() - 86400 * 10);
	
	УстановитьПривилегированныйРежим(Истина);
	ТЗ = Запрос.Выполнить().Выгрузить();	
	УстановитьПривилегированныйРежим(Ложь);
	
	Для каждого Запись Из ТЗ Цикл
		Запись.Штрихкод = ШтрихкодированиеПечатныхФорм.ЧисловойКодПоСсылке(Запись.Объект);
	КонецЦикла;                  
	
	МассивВременный = ТаблицуВМассив(ТЗ);
	Результат = ДанныеВJSONХранилище(МассивВременный);
	
	
	ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Получить список заданий на доставку из докуметов разгрузка авто ", "Разгрузка авто");
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСписокГрузовыхМестИзДокументаРазгрузкаАвто(DocumentGUID, UserIdGUID) Экспорт
	
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);
	РазгрузкаВАвтоСсылка = Документы.РазгрузкаАвто.ПолучитьСсылку(Новый УникальныйИдентификатор(DocumentGUID));
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ГрузовыеМестаТабЧасть.Ссылка КАК РазгрузкаАвтоГУИД,
	|	ГрузовыеМестаТабЧасть.ГрузовоеМесто.Ссылка КАК ГрузовоеМестоГУИД,
	|	ГрузовыеМестаТабЧасть.ГрузовоеМесто.Номер КАК ГрузовоеМестоНомер,
	|	ДокЗаданиеНаДоставку.Ссылка КАК ЗаданиеНаДоставкуГУИД,
	|	ДокЗаданиеНаДоставку.Номер КАК НомерЗаданияНаДоставку,
	|	ДокЗаданиеНаДоставку.Маршрут.Наименование КАК Маршрут,
	|	ДокРазгрузкаАвтоШапка.Грузополучатель.Наименование КАК ГрузополучательНаименование,
	|	ГрузовыеМестаТабЧасть.ГрузовоеМесто.ШтрихкодГрузовогоМеста КАК ШтрихкодГрузовогоМеста,
	|	ВЫБОР
	|		КОГДА ГрузовыеМестаТабЧасть.ГрузовоеМесто.ШтрихкодГрузовогоМеста = """"
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК НетШтрихкодаГМ   
	|ПОМЕСТИТЬ ВТГрузМестаВДокум
	|ИЗ
	|	Документ.РазгрузкаАвто.ГрузовыеМеста КАК ГрузовыеМестаТабЧасть
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РазгрузкаАвто КАК ДокРазгрузкаАвтоШапка
	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаданиеНаДоставку КАК ДокЗаданиеНаДоставку
	|			ПО ДокРазгрузкаАвтоШапка.ЗаданиеНаДоставку = ДокЗаданиеНаДоставку.Ссылка
	|		ПО ГрузовыеМестаТабЧасть.Ссылка = ДокРазгрузкаАвтоШапка.Ссылка
	|ГДЕ
	|	ДокРазгрузкаАвтоШапка.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	БуферАРМКладовщикаРазгрузкаАвто.Объект,
	|	БуферАРМКладовщикаРазгрузкаАвто.ГрузовоеМесто,
	|	БуферАРМКладовщикаРазгрузкаАвто.UserId,
	|	БуферАРМКладовщикаРазгрузкаАвто.CreatedDate
	|ПОМЕСТИТЬ ВТОтскан
	|ИЗ
	|	РегистрСведений.БуферАРМКладовщикаРазгрузкаАвто КАК БуферАРМКладовщикаРазгрузкаАвто
	|ГДЕ
	|	БуферАРМКладовщикаРазгрузкаАвто.Объект = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТГрузМестаВДокум.РазгрузкаАвтоГУИД,
	|	ВТГрузМестаВДокум.ГрузовоеМестоГУИД,
	|	ВТГрузМестаВДокум.ГрузовоеМестоНомер,
	|	ВТГрузМестаВДокум.ЗаданиеНаДоставкуГУИД,
	|	ВТГрузМестаВДокум.НомерЗаданияНаДоставку,
	|	ВТГрузМестаВДокум.Маршрут,
	|	ВТГрузМестаВДокум.ГрузополучательНаименование КАК Контрагент,
	|	ВТГрузМестаВДокум.ШтрихкодГрузовогоМеста, 
	|	ВТГрузМестаВДокум.НетШтрихкодаГМ, 
	|	ВЫБОР
	|		КОГДА ВТОтскан.Объект ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК Разгружено
	|ИЗ
	|	ВТГрузМестаВДокум КАК ВТГрузМестаВДокум
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОтскан КАК ВТОтскан
	|		ПО ВТГрузМестаВДокум.РазгрузкаАвтоГУИД = ВТОтскан.Объект
	|			И ВТГрузМестаВДокум.ГрузовоеМестоГУИД = ВТОтскан.ГрузовоеМесто";
	
	
	Запрос.УстановитьПараметр("Ссылка", РазгрузкаВАвтоСсылка);
	
	УстановитьПривилегированныйРежим(Истина);
	ТЗ = Запрос.Выполнить().Выгрузить();	         
	
	МассивСтрок = ТЗ.НайтиСтроки(Новый Структура("НетШтрихкодаГМ", Истина));    
	ДокГМ       = Документы.ГрузовоеМесто;
	
	Для каждого Запись Из МассивСтрок Цикл     
		
		ГМОбъект = Запись.ГрузовоеМестоГУИД.ПолучитьОбъект();
		
		Попытка
			
			ГМОбъект.ДополнительныеСвойства.Вставить("НеВыполнятьПроверкуНаДатыЗапрета", Истина);
			ГМОбъект.Записать(); 
			Запись.ШтрихкодГрузовогоМеста = ГМОбъект.ШтрихкодГрузовогоМеста;   
			
		Исключение
			Запись.ШтрихкодГрузовогоМеста = ДокГМ.ПолучитьШтрихкодГрузоместа(Запись.ГрузовоеМестоГУИД);                                                                                                   		
		КонецПопытки;
		
	КонецЦикла;  
	
	УстановитьПривилегированныйРежим(Ложь);
	
	МассивВременный = ТаблицуВМассив(ТЗ);
	Результат = ДанныеВJSONХранилище(МассивВременный);
	
	ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Получить список грузовых мест из документа разгрузка авто ", "Разгрузка авто " + РазгрузкаВАвтоСсылка);
	
	Возврат Результат;
	
КонецФункции

