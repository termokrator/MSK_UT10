	|		ПО ВТСписокЗДИтог.Документ = ВТБуферМаркировок.Объект
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_МаркируемыеТовары КАК ВТ_МаркируемыеТовары
	|		ПО ВТСписокЗДИтог.Документ = ВТ_МаркируемыеТовары.Ссылка
	|ГДЕ
	|	(НЕ ЕСТЬNULL(ВТСписокНеРазмещНомен.КоличествоНеРазмещеннныхСтрокНоменклатуры, 0) = 0
	|			ИЛИ НЕ ЕСТЬNULL(ВТСписокОсталосьРазмесНомен.КоличествоОсталостьРазместитьСтрокНоменклатуры, 0) = 0
	|			ИЛИ НЕ ЕСТЬNULL(ВТСписокОсталосьРазмесНомен.КоличествоТовараОсталостьРазместить, 0) = 0
	|			ИЛИ НЕ ЕСТЬNULL(ВТГМВПоступлении.КоличествоГМ, 0) - ЕСТЬNULL(ВТРазмещениеИтогГМ.КоличествоВРазмещенииГМ, 0) = 0)";
	
	Запрос.УстановитьПараметр("Дата", ТекущаяДата() - 3600 * 24 * 90);
	Запрос.УстановитьПараметр("ПустаяСтрока", "");       
	//+Шульман А. 14.10.2025 #UT10-5438
	//+Шульман А. 13.11.2025 #UT10-5504 
	//Запрос.УстановитьПараметр("ЯчейкаДляМаркировки", Константы.ЯчейкаДляМаркировки.Получить());
	МассивЯчейкаДляМаркировки = Новый Массив;
	МассивЯчейкаДляМаркировки.Добавить(Константы.ЯчейкаДляМаркировки.Получить());  
	МассивЯчейкаДляМаркировки.Добавить(Константы.ЯчейкаДляПеремаркировки.Получить());
	МассивЯчейкаДляМаркировки.Добавить(Константы.ЯчейкаДляВозвратаПоставщику.Получить());
	Запрос.УстановитьПараметр("ЯчейкаДляМаркировки", МассивЯчейкаДляМаркировки);
	//-Шульман А. 14.10.2025 #UT10-5438     
	//+Шульман А. 13.11.2025 #UT10-5504    
	Запрос.УстановитьПараметр("ПроверятьСостояниеКодаВЧЗ", Константы.ПроверятьСостояниеКодаВЧЗ.Получить());  
	Запрос.УстановитьПараметр("ОсновнойПоставщик", Константы.ОсновнойПоставщик.Получить()); 
	//-Шульман А. 13.11.2025 #UT10-5504 
	
	//+Белов А. 01.06.2026 #UT10-5893
	СтатусыНеДляПриемки = Новый Массив;
	СтатусыНеДляПриемки.Добавить(Перечисления.СтатусыПриемки.ВПути);
	СтатусыНеДляПриемки.Добавить(Перечисления.СтатусыПриемки.Завершено);
	СтатусыНеДляПриемки.Добавить(Перечисления.СтатусыПриемки.НеНайденВЭДО);
	СтатусыНеДляПриемки.Добавить(Перечисления.СтатусыПриемки.НаПроверкеВЧЗ); 
	СтатусыНеДляПриемки.Добавить(Перечисления.СтатусыПриемки.ОшибкаПроверкиЧЗ);
	
	Запрос.УстановитьПараметр("СтатусыНеДляПриемки", СтатусыНеДляПриемки); 
	//-Белов А. 01.06.2026 #UT10-5893
	
	Если ЗначениеЗаполнено(UserGUID) Тогда
		UserСсылка = Справочники.ФизическиеЛица.ПолучитьСсылку(Новый УникальныйИдентификатор(UserGUID));
	Иначе 
		UserСсылка = Справочники.ФизическиеЛица.ПустаяСсылка();
	КонецЕсли; 
	
	Запрос.УстановитьПараметр("UserId", UserСсылка);           
	
	Если ЗначениеЗаполнено(ДокументСсылка) Тогда
		Запрос.УстановитьПараметр("ВыбранныйДокумент", ДокументСсылка);
	ИначеЕсли ЗначениеЗаполнено(ДокументГУИД) Тогда

		ДокументСсылка = Документы.ПоступлениеТоваровУслуг.ПолучитьСсылку(Новый УникальныйИдентификатор(ДокументГУИД));
		
		Если ДокументСсылка.ПолучитьОбъект() = Неопределено Тогда
			ДокументСсылка = Документы.ПоступлениеТоваровНаОтветственноеХранение.ПолучитьСсылку(Новый УникальныйИдентификатор(ДокументГУИД));			
		КонецЕсли;		
		
		Запрос.УстановитьПараметр("ВыбранныйДокумент", ДокументСсылка);
		
	Иначе 
		Запрос.УстановитьПараметр("ВыбранныйДокумент", Документы.ПоступлениеТоваровУслуг.ПустаяСсылка());
	КонецЕсли; 
	
	УстановитьПривилегированныйРежим(Истина);
	ТЗ = Запрос.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	МассивВременный = ТаблицуВМассив(ТЗ);
	Результат = ДанныеВJSONХранилище(МассивВременный);
	
	ЗаписатьЛог(UserСсылка, ТекущаяДата(), "", "Получить список документов ПТУ", "");
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСписокДокументовПТУ_ЧЗ() Экспорт
//+Белов А. 05.06.2026 #UT10-5895
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПоступлениеТоваровУслуг.Ссылка КАК СсылкаПТУ,
	|	ЕСТЬNULL(ДокументыЭДОТребующиеОбработки.ТекстОшибкиЧЗ, """") КАК ТекстОшибкиЧЗ,
	|	ПРЕДСТАВЛЕНИЕ(ЗначенияСвойствОбъектов.Значение) КАК Статус,
	|	ПоступлениеТоваровУслуг.Контрагент.Наименование КАК Контрагент,
	|	ПоступлениеТоваровУслуг.Номер,
	|	ПоступлениеТоваровУслуг.Дата,
	|	ПоступлениеТоваровУслуг.НомерСкладскогоДокумента
	|ПОМЕСТИТЬ ВТ_Поступления
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	|		ПО ПоступлениеТоваровУслуг.Ссылка = ЗначенияСвойствОбъектов.Объект
	|			И (ЗначенияСвойствОбъектов.Свойство = &СтатусПриемки)
	|			И (ЗначенияСвойствОбъектов.Значение В (&ЗначенияСтатусовОтправки))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыЭДОТребующиеОбработки КАК ДокументыЭДОТребующиеОбработки
	|		ПО (ДокументыЭДОТребующиеОбработки.Документ = ПоступлениеТоваровУслуг.Ссылка)
	|ГДЕ
	|	ПоступлениеТоваровУслуг.Дата > &Дата
	|	И ПоступлениеТоваровУслуг.Проведен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ПоступлениеТоваровУслугТовары.НомерСтроки) КАК КоличествоСтрок,
	|	ПоступлениеТоваровУслугТовары.Ссылка
	|ПОМЕСТИТЬ ВТ_КоличествоСтрок
	|ИЗ
	|	ВТ_Поступления КАК ВТ_Поступления
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг.Товары КАК ПоступлениеТоваровУслугТовары
	|		ПО ВТ_Поступления.СсылкаПТУ = ПоступлениеТоваровУслугТовары.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ПоступлениеТоваровУслугТовары.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Поступления.СсылкаПТУ,
	|	ВТ_Поступления.ТекстОшибкиЧЗ,
	|	ВТ_Поступления.Статус,
	|	ВТ_Поступления.Контрагент,
	|	ВТ_Поступления.Номер КАК НомерДокумента,
	|	ВТ_Поступления.Дата КАК ДатаДокумента,
	|	ВТ_Поступления.НомерСкладскогоДокумента,
	|	ВТ_КоличествоСтрок.КоличествоСтрок КАК ВсегоСтрокСТР,
	|	ЛОЖЬ КАК ПриемкаГМ,
	|	ИСТИНА КАК ДокументТребуетсяМаркировка
	|ИЗ
	|	ВТ_Поступления КАК ВТ_Поступления
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_КоличествоСтрок КАК ВТ_КоличествоСтрок
	|		ПО ВТ_Поступления.СсылкаПТУ = ВТ_КоличествоСтрок.Ссылка";
	
	Запрос.УстановитьПараметр("СтатусПриемки", ПланыВидовХарактеристик.СвойстваОбъектов.СтатусПриемки);
	
	ЗначенияСтатусовОтправки = Новый Массив;
	ЗначенияСтатусовОтправки.Добавить(Перечисления.СтатусыПриемки.НаПроверкеВЧЗ);
	ЗначенияСтатусовОтправки.Добавить(Перечисления.СтатусыПриемки.НеНайденВЭДО);
	ЗначенияСтатусовОтправки.Добавить(Перечисления.СтатусыПриемки.ОшибкаПроверкиЧЗ);
	
	Запрос.УстановитьПараметр("ЗначенияСтатусовОтправки", ЗначенияСтатусовОтправки);
	
	Запрос.УстановитьПараметр("Дата", ТекущаяДата() - 3600 * 24 * 90);
			
	УстановитьПривилегированныйРежим(Истина);
	ТЗ = Запрос.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	МассивВременный = ТаблицуВМассив(ТЗ);
	Результат = ДанныеВJSONХранилище(МассивВременный);
		
	Возврат Результат;

//-Белов А. 05.06.2026 #UT10-5895	
КонецФункции



Функция ПолучитьСписокНепроведенныхДокументовПТУ(ДокументСсылка = Неопределено, ДокументГУИД = Неопределено, UserGUID = Неопределено, Transit = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	//+Кабанов А.В. 23.06.2025 # UT10-5295
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПоступлениеТоваровУслугТовары.Ссылка,
	|	МАКСИМУМ(ПоступлениеТоваровУслугТовары.ЗаказПоставщику) КАК ЗаказПоставщику
	|ПОМЕСТИТЬ ВТ_ТаблицаЗаказовПоставщику
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.Товары КАК ПоступлениеТоваровУслугТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК СвойствоВПути
	|		ПО ПоступлениеТоваровУслугТовары.Ссылка = СвойствоВПути.Объект
	|			И (СвойствоВПути.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СвойстваОбъектов.СтатусПриемки))
	|			И (СвойствоВПути.Значение = ЗНАЧЕНИЕ(Перечисление.СтатусыПриемки.ВПути))
	|ГДЕ
	|	(НЕ ПоступлениеТоваровУслугТовары.Ссылка.Проведен
	|			ИЛИ ПоступлениеТоваровУслугТовары.Ссылка.Проведен
	|				И НЕ СвойствоВПути.Значение ЕСТЬ NULL)
	|	И НЕ ПоступлениеТоваровУслугТовары.Ссылка.ПометкаУдаления
	|	И НЕ ПоступлениеТоваровУслугТовары.Ссылка.НомерСкладскогоДокумента = """"
	|	И ПоступлениеТоваровУслугТовары.Ссылка.Дата >= &Дата
	|	И ВЫБОР
	|			КОГДА &ВключатьТранзит
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ НЕ ПоступлениеТоваровУслугТовары.Ссылка.ТранзитнаяПоставка
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	ПоступлениеТоваровУслугТовары.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПоступлениеТоваровУслугТовары.Ссылка,
	|	МАКСИМУМ(НЕ ПоступлениеТоваровУслугТовары.ГМ = """") КАК ПриемкаГМ
	|ПОМЕСТИТЬ ВТ_ТаблицаПриемкаПоГМ
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.Товары КАК ПоступлениеТоваровУслугТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК СвойствоВПути
	|		ПО ПоступлениеТоваровУслугТовары.Ссылка = СвойствоВПути.Объект
	|			И (СвойствоВПути.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СвойстваОбъектов.СтатусПриемки))
	|			И (СвойствоВПути.Значение = ЗНАЧЕНИЕ(Перечисление.СтатусыПриемки.ВПути))
	|ГДЕ
	|	НЕ ПоступлениеТоваровУслугТовары.Ссылка.Проведен
	|	И ПоступлениеТоваровУслугТовары.Ссылка.Проведен
	|	И НЕ СвойствоВПути.Значение ЕСТЬ NULL
	|	И НЕ ПоступлениеТоваровУслугТовары.Ссылка.ПометкаУдаления
	|	И НЕ ПоступлениеТоваровУслугТовары.Ссылка.НомерСкладскогоДокумента = """"
	|	И ПоступлениеТоваровУслугТовары.Ссылка.Дата >= &Дата
	|	И ВЫБОР
	|			КОГДА &ВключатьТранзит
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ НЕ ПоступлениеТоваровУслугТовары.Ссылка.ТранзитнаяПоставка
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	ПоступлениеТоваровУслугТовары.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТаблицаЗаказовПоставщику.Ссылка,
	|	ВТ_ТаблицаЗаказовПоставщику.ЗаказПоставщику.IDСкладаСобственныйСклад.Наименование КАК НаименовниеСклада
	|ПОМЕСТИТЬ ВТ_ТаблицаСкладовПоПТУ
	|ИЗ
	|	ВТ_ТаблицаЗаказовПоставщику КАК ВТ_ТаблицаЗаказовПоставщику
	|ГДЕ
	|	НЕ ВТ_ТаблицаЗаказовПоставщику.ЗаказПоставщику.IDСкладаСобственныйСклад.Ссылка ЕСТЬ NULL
	|	И ВТ_ТаблицаЗаказовПоставщику.ЗаказПоставщику.IDСкладаСобственныйСклад.ИсключитьИзОбщегоЭкспресса
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПоступлениеТоваровУслуг.Ссылка КАК СсылкаПТУ,
	|	ПоступлениеТоваровУслуг.Экспресс,
	|	ПоступлениеТоваровУслуг.Контрагент.Наименование КАК Контрагент,
