Функция CheckCanUnlockCellsFromJobInventory(UserIdGUID, ObjectGUID, CellsXDTO) Экспорт
	
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);	
	МассивЯчеек = СериализаторXDTO.ПрочитатьXDTO(CellsXDTO);
	
	МассивЯчеекСсылок = Новый Массив;   
	
	Для каждого Элемент Из МассивЯчеек Цикл
		МассивЯчеекСсылок.Добавить(Справочники.Ячейки.ПолучитьСсылку(Новый УникальныйИдентификатор(Элемент)));
	КонецЦикла; 
	
	Запрос = Новый Запрос;
	Запрос.Текст =            
	"ВЫБРАТЬ Количество(1) КАК КоличествоСтрок
	|	
	|ИЗ
	|	РегистрСведений.БуферАРМКладовщикаИнвентПоЯчейкам КАК БуферАРМ
	|ГДЕ
	|	БуферАРМ.Объект   = &ObjectGUID
	|	И БуферАРМ.UserId = &UserId         
	|	И БуферАРМ.Ячейка В (&Ячейка)";                                        
	
	Запрос.УстановитьПараметр("Ячейка", МассивЯчеекСсылок);
	
	UserIdСсылка = Справочники.ФизическиеЛица.ПолучитьСсылку(Новый УникальныйИдентификатор(UserIdGUID));
	Запрос.УстановитьПараметр("UserId", UserIdСсылка);
	
	ОбъектСсылка = Документы.ЗаданиеНаИнвентаризацию.ПолучитьСсылку(Новый УникальныйИдентификатор(ObjectGUID) );		
	Запрос.УстановитьПараметр("ObjectGUID", ОбъектСсылка);
	
	УстановитьПривилегированныйРежим(Истина);			          
	РезультатЗапроса = Запрос.Выполнить().Выбрать();			
	РезультатЗапроса.Следующий();          
	
	Если РезультатЗапроса.КоличествоСтрок > 0 Тогда
		Результат = Ложь;
	Иначе
		Результат = Истина;
	КонецЕсли; 
	
	УстановитьПривилегированныйРежим(Ложь);	
	
	ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Возможно ли разблокировать ячейки", 
	СтроковыеФункцииКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(МассивЯчеекСсылок));
	
	Возврат Результат;                                                             	
	
КонецФункции

Функция ПолучитьСписокЗаписейИзБуфераИнвентаризации(UserIdGUID, ObjectGUID, Cell) Экспорт
	
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);	
	
	Запрос = Новый Запрос;
	Запрос.Текст =            
	"ВЫБРАТЬ
	|	БуферАРМ.Объект,
	|	БуферАРМ.Номенклатура КАК СсылкаТовара,
	|	БуферАРМ.Ячейка КАК СсылкаЯчейки,	
	|	МАКСИМУМ(СпрНоменклатура.Наименование) КАК НаименованиеТовара,		
	|	ЕСТЬNULL(СпрНоменклатура.Родитель.Наименование, """") КАК Производитель,
	|	СпрНоменклатура.КодПроизводителя  КАК КодПроизводителяТовара,
	|   МАКСИМУМ(БуферАРМ.Ячейка.Код) КАК ЯчейкаКод,
	|	СУММА(БуферАРМ.Quantity) КАК КоличествоТовара	
	|ИЗ
	|	РегистрСведений.БуферАРМКладовщикаИнвентПоЯчейкам КАК БуферАРМ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО БуферАРМ.Номенклатура = СпрНоменклатура.Ссылка
	|ГДЕ
	|	БуферАРМ.Объект = &ObjectGUID
	|	И БуферАРМ.UserId = &UserId
	|	И БуферАРМ.Ячейка = &Ячейка
	|
	|СГРУППИРОВАТЬ ПО
	|	БуферАРМ.Объект,
	|	БуферАРМ.Номенклатура,
	|	БуферАРМ.Ячейка,
	|	СпрНоменклатура.КодПроизводителя,
	|	ЕСТЬNULL(СпрНоменклатура.Родитель.Наименование, """")";                                        
	
	Ячейка = Справочники.Ячейки.ПолучитьСсылку(Новый УникальныйИдентификатор(Cell));                                                          
	Запрос.УстановитьПараметр("Ячейка", Ячейка);
	
	UserIdСсылка = Справочники.ФизическиеЛица.ПолучитьСсылку(Новый УникальныйИдентификатор(UserIdGUID));
	Запрос.УстановитьПараметр("UserId", UserIdСсылка);
	
	ОбъектСсылка = Документы.ЗаданиеНаИнвентаризацию.ПолучитьСсылку(Новый УникальныйИдентификатор(ObjectGUID));		
	Запрос.УстановитьПараметр("ObjectGUID", ОбъектСсылка);
	
	УстановитьПривилегированныйРежим(Истина);			          
	ТЗ = Запрос.Выполнить().Выгрузить();			
	МассивВременный = ТаблицуВМассив(ТЗ);
	Результат = ДанныеВJSONХранилище(МассивВременный);
	УстановитьПривилегированныйРежим(Ложь);	
	
	ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Получить список товаров из буфера инвентаризации", Ячейка);
	
	Возврат Результат;                                                             	
	
КонецФункции

// 1. Данный метод возвращает товары в ячейке 
// 2. Возвращает boolean, если есть ли товары в ячейке
Функция ПолучитьСписокНоменклатурПоЯчейке(UserIdGUID, CellGUID) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	БуферАРМ.Номенклатура КАК Номенклатура,
	|	СУММА(БуферАРМ.Quantity) КАК Количество
	|ПОМЕСТИТЬ ДанныеПоДокументу
	|ИЗ
	|	РегистрСведений.БуферАРМКладовшикаПеремещение КАК БуферАРМ
	|ГДЕ
	|	БуферАРМ.UserId = &UserId
	|	И БуферАРМ.ЯчейкаОткуда = &Ячейка
	|
	|СГРУППИРОВАТЬ ПО
	|	БуферАРМ.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыВЯчейкахОстатки.Номенклатура КАК Товар,
	|	ТоварыВЯчейкахОстатки.КоличествоОстаток
	|ПОМЕСТИТЬ ДанныеПоЯчейке
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Остатки(, Ячейка = &Ячейка) КАК ТоварыВЯчейкахОстатки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ТоварыВЯчейкахОстатки.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыВЯчейкахОбороты.Номенклатура,
	|	ТоварыВЯчейкахОбороты.Ячейка,
	|	ВЫБОР
	|		КОГДА ТоварыВЯчейкахОбороты.КоличествоОборот < 0
	|			ТОГДА ДОБАВИТЬКДАТЕ(ТоварыВЯчейкахОбороты.Период, СЕКУНДА, -1)
	|		ИНАЧЕ ТоварыВЯчейкахОбороты.Период
	|	КОНЕЦ КАК Период
	|ПОМЕСТИТЬ Обороты
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Обороты(
	|			,
	|			,
	|			Запись,
	|			Ячейка.НеУчитыватьВОперативномУчете = ЛОЖЬ
	|				И Номенклатура В
	|					(ВЫБРАТЬ
	|						ДанныеПоЯчейке.Товар
	|					ИЗ
	|						ДанныеПоЯчейке)
	|				И Ячейка = &Ячейка) КАК ТоварыВЯчейкахОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыВЯчейкахОбороты.Номенклатура,
	|	ТоварыВЯчейкахОбороты.Ячейка,
	|	ВЫБОР
	|		КОГДА ТоварыВЯчейкахОбороты.КоличествоОборот < 0
	|			ТОГДА ДОБАВИТЬКДАТЕ(ТоварыВЯчейкахОбороты.Период, СЕКУНДА, -1)
	|		ИНАЧЕ ТоварыВЯчейкахОбороты.Период
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.Номенклатура,
	|	Обороты.Ячейка КАК Ячейка
	|ПОМЕСТИТЬ ЯчейкиХранения
	|ИЗ
	|	(ВЫБРАТЬ
	|		Обороты.Номенклатура КАК Номенклатура,
	|		МАКСИМУМ(Обороты.Период) КАК Период
	|	ИЗ
	|		Обороты КАК Обороты
	|	
	|	СГРУППИРОВАТЬ ПО
	|		Обороты.Номенклатура) КАК ВложенныйЗапрос
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Обороты КАК Обороты
	|		ПО ВложенныйЗапрос.Номенклатура = Обороты.Номенклатура
	|			И ВложенныйЗапрос.Период = Обороты.Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеПоЯчейке.Товар КАК СсылкаТовара,
	|	ДанныеПоЯчейке.КоличествоОстаток КАК КоличествоОстаток,
	|	ЕСТЬNULL(ДанныеПоДокументу.Количество, 0) КАК КоличествоТовараНабрано,
	|	ЕСТЬNULL(Ячейки.Код, """") КАК Ячейка
	|ПОМЕСТИТЬ ПредварИтог
	|ИЗ
	|	ДанныеПоЯчейке КАК ДанныеПоЯчейке
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеПоДокументу КАК ДанныеПоДокументу
	|		ПО ДанныеПоЯчейке.Товар = ДанныеПоДокументу.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ ЯчейкиХранения КАК ЯчейкиХранения
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Ячейки КАК Ячейки
	|			ПО ЯчейкиХранения.Ячейка = Ячейки.Ссылка
	|		ПО ДанныеПоЯчейке.Товар = ЯчейкиХранения.Номенклатура
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	СсылкаТовара
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыВЯчейкахОбороты.Склад,
	|	ТоварыВЯчейкахОбороты.Номенклатура КАК СсылкаТовара,
	|	ТоварыВЯчейкахОбороты.Ячейка,
	|	СУММА(ТоварыВЯчейкахОбороты.КоличествоОборот) КАК КоличествоОборот,
	|	СУММА(ТоварыВЯчейкахОбороты.КоличествоПриход) КАК КоличествоПриход,
	|	СУММА(ТоварыВЯчейкахОбороты.КоличествоРасход) КАК КоличествоРасход
	|ПОМЕСТИТЬ ОборотыЗаПериод
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Обороты(
	|			&ДатаНачала,
	|			&ДатаКонца,
	|			Регистратор,
	|			Ячейка.НеУчитыватьВОперативномУчете = ЛОЖЬ
	|				И Номенклатура В
	|					(ВЫБРАТЬ
	|						ДанныеПоЯчейке.Товар
	|					ИЗ
	|						ДанныеПоЯчейке)
	|				И Ячейка = &Ячейка) КАК ТоварыВЯчейкахОбороты
	|ГДЕ
	|	ТоварыВЯчейкахОбороты.Регистратор ССЫЛКА Документ.ПеремещениеТовараПоЯчейкам
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыВЯчейкахОбороты.Номенклатура,
	|	ТоварыВЯчейкахОбороты.Склад,
	|	ТоварыВЯчейкахОбороты.Ячейка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПредварИтог.СсылкаТовара,
	|	ПредварИтог.КоличествоОстаток,
	|	ПредварИтог.КоличествоТовараНабрано,
	|	Номенклатура.Наименование КАК НаименованиеТовара,
	|	Номенклатура.КодПроизводителя КАК КодПроизводителяТовара,
	|	ЕдиницыИзмерения.Код КАК КодЕдиИзм,
	|	ЕдиницыИзмерения.Наименование КАК ЕдИзмНаименование,
	|	Номенклатура.Кратность,
	|	ПредварИтог.Ячейка,
	|	ЕСТЬNULL(Номенклатура.Родитель.Наименование, """") КАК Производитель,
	|	ЕСТЬNULL(ОборотыЗаПериод.КоличествоПриход, 0) КАК КоличествоПриходОбороты,
	|	ЕСТЬNULL(ОборотыЗаПериод.КоличествоРасход, 0) КАК КоличествоРасходОбороты,
	|	ЕстьNULL(ПредварИтог.СсылкаТовара.ГруппаАВСФилиала.Наименование,""Е"") КАК ГруппаАВСФилиала
	|ИЗ                                                       
	|	ПредварИтог КАК ПредварИтог
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	|			ПО Номенклатура.ЕдиницаХраненияОстатков = ЕдиницыИзмерения.Ссылка
	|		ПО ПредварИтог.СсылкаТовара = Номенклатура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОборотыЗаПериод КАК ОборотыЗаПериод
	|		ПО ПредварИтог.СсылкаТовара = ОборотыЗаПериод.СсылкаТовара";
	
	Ячейка = Справочники.Ячейки.ПолучитьСсылку(Новый УникальныйИдентификатор(CellGUID));
	Запрос.УстановитьПараметр("Ячейка", Ячейка);
	
	UserIdСсылка = Справочники.ФизическиеЛица.ПолучитьСсылку(Новый УникальныйИдентификатор(UserIdGUID));
	Запрос.УстановитьПараметр("UserId", UserIdСсылка);
	Запрос.УстановитьПараметр("ДатаНачала", Новый Граница(ТекущаяДата() - 60*30, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ДатаКонца", Новый Граница(ТекущаяДата(), ВидГраницы.Включая));
	
	УстановитьПривилегированныйРежим(Истина);			          
	ТЗ = Запрос.Выполнить().Выгрузить();			
	МассивВременный = ТаблицуВМассив(ТЗ);
	Результат = ДанныеВJSONХранилище(МассивВременный);
	УстановитьПривилегированныйРежим(Ложь);	
	
	ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Получить список номенклатур из ячейки", Ячейка.Код); 
	
	Возврат Результат;                                                             
	
КонецФункции

Функция ПроверитьДоступКARMStoreKeeper(Barcode, Password) Экспорт
	
	Результат = Ложь;    
	
	Если ЗначениеЗаполнено(Barcode) Тогда
		ЗначениеДляПоиска = СокрЛП(Barcode);	
	Иначе        
		
		Password = СокрЛП(Password);
		ЗначениеДляПоиска = Формат(Password, "ЧЦ=5; ЧВН=; ЧГ=0");   
		
	КонецЕсли;                       
	
	ДанныеОтвета = Новый Структура;
	ДанныеОтвета.Вставить("Ошибка", "");
	
	Запрос = Новый Запрос;                                                                 
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ФизическиеЛица.Ссылка,
	|	ПОДСТРОКА(ФизическиеЛица.Код, 5, 5) КАК Код,
	|	ФизическиеЛица.Наименование,
	|	ФизическиеЛица.АРМКладовщика,
	|	НЕ КатегорииОбъектов.Категория ЕСТЬ NULL КАК РазрешеноПроведениеПТУ,
	|	НЕ КатегорииОбъектовСлЗаписка.Категория ЕСТЬ NULL КАК ОтображатьСлужебныеЗапискиТСД,
	|	НЕ КатегорииОбъектовТЕ.Категория ЕСТЬ NULL КАК ОтображатьТЕ,
	|	НЕ КатегорииОбъектовМаркировка.Категория ЕСТЬ NULL КАК ОтображатьМаркировкуТоваров,   
	//+Шульман А. 13.11.2025 #UT10-5504
	|	НЕ КатегорииОбъектовПроверкаКМ.Категория ЕСТЬ NULL КАК РазрешитьПриниматьКМБезПроверкиСостояния   
	//-Шульман А. 13.11.2025 #UT10-5504
	|ИЗ
	|	Справочник.ФизическиеЛица КАК ФизическиеЛица
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КатегорииОбъектов КАК КатегорииОбъектов
	|		ПО ФизическиеЛица.Ссылка = КатегорииОбъектов.Объект
	|			И (КатегорииОбъектов.Категория = ЗНАЧЕНИЕ(Справочник.КатегорииОбъектов.РазрешеноПроведениеПТУСТСД))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КатегорииОбъектов КАК КатегорииОбъектовСлЗаписка
	|		ПО ФизическиеЛица.Ссылка = КатегорииОбъектовСлЗаписка.Объект
	|			И (КатегорииОбъектовСлЗаписка.Категория = ЗНАЧЕНИЕ(Справочник.КатегорииОбъектов.ОтображатьСлужебныеЗапискиТСД))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КатегорииОбъектов КАК КатегорииОбъектовТЕ
	|		ПО ФизическиеЛица.Ссылка = КатегорииОбъектовТЕ.Объект
	|			И (КатегорииОбъектовТЕ.Категория = ЗНАЧЕНИЕ(Справочник.КатегорииОбъектов.ОбъединятьГМВТЕ))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КатегорииОбъектов КАК КатегорииОбъектовМаркировка
	|		ПО ФизическиеЛица.Ссылка = КатегорииОбъектовМаркировка.Объект
	|			И (КатегорииОбъектовМаркировка.Категория = ЗНАЧЕНИЕ(Справочник.КатегорииОбъектов.ОтображатьМаркировкуТоваровТСД))   
	//+Шульман А. 13.11.2025 #UT10-5504
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КатегорииОбъектов КАК КатегорииОбъектовПроверкаКМ
	|		ПО ФизическиеЛица.Ссылка = КатегорииОбъектовПроверкаКМ.Объект
	|			И (КатегорииОбъектовПроверкаКМ.Категория = ЗНАЧЕНИЕ(Справочник.КатегорииОбъектов.РазрешитьПриниматьКМБезПроверкиСостояния))   
	//-Шульман А. 13.11.2025 #UT10-5504
	|ГДЕ
	|	ФизическиеЛица.Код ПОДОБНО &Код
	|	И ФизическиеЛица.АРМКладовщика";
		
	Запрос.УстановитьПараметр("Код", "%" + ЗначениеДляПоиска);
	РезультатЗапроса = Запрос.Выполнить().Выбрать();   
	
	Если РезультатЗапроса.Количество() = 0  Тогда
		
		ДанныеОтвета.Вставить("Ошибка", "Данный пользователь не имеет прав доступа.");	
		Результат = ДанныеВJSONХранилище(ДанныеОтвета);	
		Возврат Результат;     
		
	КонецЕсли; 
	
	РезультатЗапроса.Следующий();
	ДанныеОтвета.Вставить("Пользователь"                  , РезультатЗапроса.Код);
	ДанныеОтвета.Вставить("ПолноеИмя"                     , РезультатЗапроса.Наименование);		
	ДанныеОтвета.Вставить("ПользовательГУИД"              , XMLСтрока(РезультатЗапроса.Ссылка));		
	ДанныеОтвета.Вставить("РазрешеноПроведениеПТУ"        , РезультатЗапроса.РазрешеноПроведениеПТУ);
	ДанныеОтвета.Вставить("ОтображатьСлужебныеЗапискиТСД" , РезультатЗапроса.ОтображатьСлужебныеЗапискиТСД);
	ДанныеОтвета.Вставить("ОтображатьТЕ"                  , РезультатЗапроса.ОтображатьТЕ);
	
	//+Кабанов А.В. 21.07.2025 # UT10-5343 
	ДанныеОтвета.Вставить("ОтображатьМаркировкуТоваров"   , РезультатЗапроса.ОтображатьМаркировкуТоваров);
	//-Кабанов А.В. 21.07.2025 # UT10-5343 
	
	//+Шульман А. 13.11.2025 #UT10-5504    
	ДанныеОтвета.Вставить("РазрешитьПриниматьКМБезПроверкиСостояния" , РезультатЗапроса.РазрешитьПриниматьКМБезПроверкиСостояния);  
	ДанныеОтвета.Вставить("РасширеннаяПроверкаВалидностиКодовМаркировкиЧЗ" , Константы.РасширеннаяПроверкаВалидностиКодовМаркировкиЧЗ.Получить());
	//-Шульман А. 13.11.2025 #UT10-5504    
	
	//+Шульман А. 20.11.2025 #UT10-5518
	ДанныеОтвета.Вставить("ПроверятьСоответствиеКодаТоваруПоGTIN" , Константы.ПроверятьСоответствиеКодаТоваруПоGTIN.Получить());
	//-Шульман А. 20.11.2025 #UT10-5518
	
	//+Кабанов А.В. 13.08.2025 # UT10-5360
	Если ЗначениеЗаполнено(Константы.ЯчейкаДляМаркировки.Получить()) Тогда
		ДанныеОтвета.Вставить("ЯчейкаДляМаркировки"   , СокрЛП(XMLСтрока(Константы.ЯчейкаДляМаркировки.Получить())));
	КонецЕсли;
	//-Кабанов А.В. 13.08.2025 # UT10-5360  
	
	//+Шульман А. 13.11.2025 #UT10-5504      
	Если ЗначениеЗаполнено(Константы.ЯчейкаДляМаркировки.Получить()) Тогда
		ДанныеОтвета.Вставить("ЯчейкаДляПеремаркировки"   , СокрЛП(XMLСтрока(Константы.ЯчейкаДляПеремаркировки.Получить())));
	КонецЕсли;
	
	ДанныеОтвета.Вставить("ПроверятьСостояниеКодаВЧЗ", Константы.ПроверятьСостояниеКодаВЧЗ.Получить());   
	
	Если ЗначениеЗаполнено(Константы.ЯчейкаДляВозвратаПоставщику.Получить()) Тогда
		ДанныеОтвета.Вставить("ЯчейкаДляВозврата"   , СокрЛП(XMLСтрока(Константы.ЯчейкаДляВозвратаПоставщику.Получить())));
	КонецЕсли;    
	
	Если ЗначениеЗаполнено(Константы.ОсновнаяОрганизация.Получить()) Тогда
		ДанныеОтвета.Вставить("КодМДМГоловнойОрганизации"   , СокрЛП(Константы.ОсновнаяОрганизация.Получить().КодМДМГоловнойОрганизации));
	КонецЕсли;
	
	ДанныеОтвета.Вставить("АдресСервераЧестныйЗнак"   , СокрЛП(Константы.АдресСервераЧестныйЗнак.Получить()));
	//-Шульман А. 13.11.2025 #UT10-5504        
	
	//+Шульман А. 28.11.2025 #UT10-5550  
	ДанныеОтвета.Вставить("СверятьКодыСОжидаемымиПриПриемке" , Константы.СверятьКодыСОжидаемымиПриПриемке.Получить());   
	//-Шульман А. 28.11.2025 #UT10-5550
	
	//+Сёмин Р.И. 29.04.2026 #UT10-5814
	ДанныеОтвета.Вставить("ИспользоватьНовыйМеханизмПроверкиКодовМаркировки", Константы.ИспользоватьНовыйМеханизмПроверкиКодовМаркировки.Получить());
	//-Сёмин Р.И. 29.04.2026 #UT10-5814
	
	//+Сёмин Р.И. 24.06.2026 #UT10-5915
	ДанныеОтвета.Вставить("ПроверятьНарушенияСроковГодностиКИЗ", Константы.ПроверятьНарушенияСроковГодностиКИЗ.Получить());
	//-Сёмин Р.И. 24.06.2026 #UT10-5915
	
	Результат = ДанныеВJSONХранилище(ДанныеОтвета);
	
	ЗаписатьЛог(РезультатЗапроса.Ссылка, ТекущаяДата(), "", "Authentication User", "Barcode " + Barcode + "; password " + РезультатЗапроса.Ссылка.Наименование);
	Возврат Результат;                           
	
КонецФункции                              

