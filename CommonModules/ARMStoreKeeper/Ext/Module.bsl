// Функция возвращает результат проверки строки на предмет соответствия
// штрихкоду формата EAN13.
//
// Параметры:
//  Штрихкод - <Строка>
//           - Проверяемый штрихкод.
//
// Возвращаемое значение:
//  <Булево> - Результат проверки.
//
Функция ТипШтрихкодаEAN13ТО(Штрихкод) Экспорт
	
	Результат = (СтрДлина(Штрихкод) = 13
	И КонтрольныйСимволEAN13ТО(Штрихкод) = Прав(Штрихкод, 1));
	
	Возврат Результат;
	
КонецФункции // ТипШтрихкодаEAN13ТО()

// Функция возвращает контрольный символ штрихкода EAN13.
//
// Параметры:
//  Штрихкод - <Строка>
//           - Неполный штрихкод (12 символов), для которого вычисляется
//             контрольный 13-й символ.
//
// Возвращаемое значение:
//  <Строка> - Контрольный символ EAN13.
//  
Функция КонтрольныйСимволEAN13ТО(Штрихкод) Экспорт
	
	Результат   = "";
	Сумма       = 0;
	Коэффициент = 1;
	
	Индекс = Неопределено;
	
	Для Индекс = 1 По 12 Цикл
		
		КодСимв     = КодСимвола(Штрихкод, Индекс);
		Сумма       = Сумма + Коэффициент * (КодСимв - 48);
		Коэффициент = 4 - Коэффициент;
		
	КонецЦикла;
	
	Сумма     = (10 - Сумма % 10) % 10;
	Результат = Символ(Сумма + 48);
	
	Возврат Результат;
	
КонецФункции // КонтрольныйСимволEAN13ТО()

//Транслитерация текста
// Параметры
//   Текст       - Строка, строка для преобразования
// Возвращаемое значение:
//   преобразованная строка
Функция Транслит(Текст) 
	
	НовыйТекст = "";
	
	СЗСоответствиеБукв = Новый СписокЗначений;
	
	СЗСоответствиеБукв.Добавить("j","й");
	СЗСоответствиеБукв.Добавить("c","ц");
	СЗСоответствиеБукв.Добавить("u","у");
	СЗСоответствиеБукв.Добавить("k","к");
	СЗСоответствиеБукв.Добавить("e","е");
	СЗСоответствиеБукв.Добавить("n","н");
	СЗСоответствиеБукв.Добавить("g","г");
	СЗСоответствиеБукв.Добавить("sh","ш");
	СЗСоответствиеБукв.Добавить("sch","щ");
	СЗСоответствиеБукв.Добавить("z","з");
	СЗСоответствиеБукв.Добавить("h","х");
	СЗСоответствиеБукв.Добавить("#","ъ");
	СЗСоответствиеБукв.Добавить("f","ф");
	СЗСоответствиеБукв.Добавить("y","ы");
	СЗСоответствиеБукв.Добавить("v","в");
	СЗСоответствиеБукв.Добавить("a","а"); 
	СЗСоответствиеБукв.Добавить("p","п");
	СЗСоответствиеБукв.Добавить("r","р");
	СЗСоответствиеБукв.Добавить("o","о");
	СЗСоответствиеБукв.Добавить("l","л");
	СЗСоответствиеБукв.Добавить("d","д");
	СЗСоответствиеБукв.Добавить("zh","ж");
	СЗСоответствиеБукв.Добавить("je","э");
	СЗСоответствиеБукв.Добавить("ja","я");
	СЗСоответствиеБукв.Добавить("ch","ч"); 
	СЗСоответствиеБукв.Добавить("s","с");
	СЗСоответствиеБукв.Добавить("m","м");
	СЗСоответствиеБукв.Добавить("i","и");
	СЗСоответствиеБукв.Добавить("t","т");
	СЗСоответствиеБукв.Добавить("'","ь");
	СЗСоответствиеБукв.Добавить("b","б");
	СЗСоответствиеБукв.Добавить("ju","ю");
	СЗСоответствиеБукв.Добавить("jo","ё");
	
	СоответствиеБукв = Новый Соответствие;
	
	Для каждого ЭлементСписка из СЗСоответствиеБукв Цикл
		
		СоответствиеБукв.Вставить(ЭлементСписка.Значение,ЭлементСписка.Представление);
		СоответствиеБукв.Вставить(ЭлементСписка.Представление,ЭлементСписка.Значение);
		
	КонецЦикла;
	
	Для а=1 по СтрДлина(Текст) Цикл
		
		Соответствие1 = СоответствиеБукв[НРЕГ(Сред(Текст,а,1))];
		
		Если Соответствие1 =  Неопределено Тогда
			Соответствие1 = НРЕГ(Сред(Текст,а,1))
		КонецЕсли;
		
		НовыйТекст = НовыйТекст + Соответствие1;
		
	КонецЦикла;                 
	
	Возврат ВРЕГ(НовыйТекст);
	
КонецФункции

