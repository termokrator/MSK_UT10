	МассивСтрок = ТЗ.НайтиСтроки(Новый Структура("НетШтрихкодаГМ", Истина));    
	ДокГМ       = Документы.ГрузовоеМесто;
	
	Для каждого Запись Из МассивСтрок Цикл     
		
		ГМОбъект = Запись.ГрузовоеМестоГУИД.ПолучитьОбъект();
		
		Попытка
			
			ГМОбъект.ДополнительныеСвойства.Вставить("НеВыполнятьПроверкуНаДатыЗапрета", Истина);
			ГМОбъект.Записать(); 
			Запись.ШтрихкодГрузовогоМеста = ГМОбъект.ШтрихкодГрузовогоМеста;   
			
		Исключение
			Запись.ШтрихкодГрузовогоМеста = ДокГМ.ПолучитьШтрихкодГрузоместа(Запись.ГрузовоеМестоГУИД);                                                                                                   		
		КонецПопытки;
		
	КонецЦикла;   
	
	УстановитьПривилегированныйРежим(Ложь);
	
	МассивВременный = ТаблицуВМассив(ТЗ);
	Результат = ДанныеВJSONХранилище(МассивВременный);
	
	ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Получить список грузовых мест из документа разгрузка авто ", "Разгрузка авто - Постановка на маршрут" + РазгрузкаВАвтоСсылка);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСписокМаршрутовИзРазгрузкаАвтоДляПостановкиНаМаршрут(UserIdGUID) Экспорт
	
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	РазгрузкаАвто.ЗаданиеНаДоставку КАК ЗаданиеНаДоставку,
	|	ЕСТЬNULL(МаршрутыДоставки.Наименование, """") КАК Маршрут,
	|	ЕСТЬNULL(МаршрутыДоставки.Ссылка, ЗНАЧЕНИЕ(Справочник.МаршрутыДоставки.ПустаяСсылка)) КАК МаршрутСсылка,
	|	ДокЗаданиеНаДоставку.Номер КАК ЗаданиеНаДоставкуНомер,
	|	ДокЗаданиеНаДоставку.Дата КАК ЗаданиеНаДоставкуДата,
	|	РазгрузкаАвто.Ссылка КАК РазгрузкаАвто,
	|	РазгрузкаАвто.Номер КАК РазгрузкаАвтоНомер,
	|	РазгрузкаАвто.Грузополучатель КАК Грузополучатель,
	|	РазгрузкаАвто.Грузополучатель.Наименование КАК ГрузополучательНаименование
	|ПОМЕСТИТЬ ВТРазрузкаАвто
	|ИЗ
	|	Документ.РазгрузкаАвто КАК РазгрузкаАвто
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаданиеНаДоставку КАК ДокЗаданиеНаДоставку
	|		ПО РазгрузкаАвто.ЗаданиеНаДоставку = ДокЗаданиеНаДоставку.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.МаршрутыДоставки КАК МаршрутыДоставки
	|		ПО (ДокЗаданиеНаДоставку.Маршрут = МаршрутыДоставки.Ссылка)
	|ГДЕ
	|	РазгрузкаАвто.Дата >= &Дата
	|	И РазгрузкаАвто.Проведен
	|	И РазгрузкаАвто.ГМПринял <> ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
	|	И РазгрузкаАвто.ГМПоложилНаМаршрут = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ГрузовыеМестаТабЧасть.Ссылка КАК РазгрузкаАвто,
	|	ДокРазгрузкаАвтоШапка.ЗаданиеНаДоставку КАК ЗаданиеНаДоставку,
	|	СУММА(1) КАК КоличествоВсего
	|ПОМЕСТИТЬ ВТГрузМестаВДокум
	|ИЗ
	|	Документ.РазгрузкаАвто.ГрузовыеМеста КАК ГрузовыеМестаТабЧасть
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РазгрузкаАвто КАК ДокРазгрузкаАвтоШапка
	|		ПО ГрузовыеМестаТабЧасть.Ссылка = ДокРазгрузкаАвтоШапка.Ссылка
	|ГДЕ
	|	ДокРазгрузкаАвтоШапка.Дата >= &Дата
	|	И ДокРазгрузкаАвтоШапка.Проведен
	|	И ДокРазгрузкаАвтоШапка.ГМПринял <> ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
	|	И ДокРазгрузкаАвтоШапка.ГМПоложилНаМаршрут = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ГрузовыеМестаТабЧасть.Ссылка,
	|	ДокРазгрузкаАвтоШапка.ЗаданиеНаДоставку
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РСприемкаГрузМест.ЗаданиеНаДоставку,
	|	РСприемкаГрузМест.РазгрузкаАвто,
	|	СУММА(1) КАК КоличествоПоставленоНаМаршрут
	|ПОМЕСТИТЬ ВТПриемкаГрузовыхМест
	|ИЗ
	|	РегистрСведений.БуферАРМКладовщикаПостановкаГрузовыхМестНаМаршрут КАК РСприемкаГрузМест
	|
	|СГРУППИРОВАТЬ ПО
	|	РСприемкаГрузМест.ЗаданиеНаДоставку,
	|	РСприемкаГрузМест.РазгрузкаАвто
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТРазрузкаАвто.РазгрузкаАвто КАК РазгрузкаАвтоГУИД,
	|	ВТРазрузкаАвто.ЗаданиеНаДоставку КАК ЗаданиеНаДоставкуГУИД,
	|	ВТРазрузкаАвто.Маршрут,
	|	ВТРазрузкаАвто.МаршрутСсылка КАК МаршрутГУИД,
	|	ВТРазрузкаАвто.ЗаданиеНаДоставкуНомер КАК ЗаданиеНаДоставкуНомер,
	|	ВТРазрузкаАвто.ЗаданиеНаДоставкуДата КАК ЗаданиеНаДоставкуДата,
	|	ВТРазрузкаАвто.РазгрузкаАвтоНомер,
	|	ВТРазрузкаАвто.Грузополучатель КАК ГрузополучательГУИД,
	|	ВТРазрузкаАвто.Грузополучатель.Наименование КАК ГрузополучательНаименование,
	|	ЕСТЬNULL(ВТГрузМестаВДокум.КоличествоВсего, 0) КАК КоличествоВсего,
	|	ЕСТЬNULL(ВТПриемкаГрузовыхМест.КоличествоПоставленоНаМаршрут, 0) КАК КоличествоПоставленоНаМаршрут,
	|	ЕСТЬNULL(ВТГрузМестаВДокум.КоличествоВсего, 0) - ЕСТЬNULL(ВТПриемкаГрузовыхМест.КоличествоПоставленоНаМаршрут, 0) КАК КоличествоНеПоставленоНаМаршрут
	|ИЗ
	|	ВТРазрузкаАвто КАК ВТРазрузкаАвто
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТГрузМестаВДокум КАК ВТГрузМестаВДокум
	|		ПО ВТРазрузкаАвто.РазгрузкаАвто = ВТГрузМестаВДокум.РазгрузкаАвто
	|			И ВТРазрузкаАвто.ЗаданиеНаДоставку = ВТГрузМестаВДокум.ЗаданиеНаДоставку
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПриемкаГрузовыхМест КАК ВТПриемкаГрузовыхМест
	|		ПО ВТРазрузкаАвто.ЗаданиеНаДоставку = ВТПриемкаГрузовыхМест.ЗаданиеНаДоставку
	|			И ВТРазрузкаАвто.РазгрузкаАвто = ВТПриемкаГрузовыхМест.РазгрузкаАвто
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.БуферАРККладовщикаБлокировкаМаршрутаЗаданияНаДоставку КАК БуферАРККладовщикаБлокировкаМаршрутаЗаданияНаДоставку
	|		ПО ВТРазрузкаАвто.ЗаданиеНаДоставку = БуферАРККладовщикаБлокировкаМаршрутаЗаданияНаДоставку.ЗаданиеНаДоставку
	|			И ВТРазрузкаАвто.РазгрузкаАвто = БуферАРККладовщикаБлокировкаМаршрутаЗаданияНаДоставку.РазгрузкаАвто
	|ГДЕ
	|	(БуферАРККладовщикаБлокировкаМаршрутаЗаданияНаДоставку.РазгрузкаАвто ЕСТЬ NULL
	|			ИЛИ БуферАРККладовщикаБлокировкаМаршрутаЗаданияНаДоставку.UserIdCode = &UserId)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТРазрузкаАвто.Маршрут,
	|	ВТРазрузкаАвто.ЗаданиеНаДоставку,
	|	ВТРазрузкаАвто.РазгрузкаАвто";
	
	
	Запрос.УстановитьПараметр("Дата",     ТекущаяДата() - 86400 * 10);
	Запрос.УстановитьПараметр("UserId",   UserIdСсылка);
	
	УстановитьПривилегированныйРежим(Истина);
	ТЗ = Запрос.Выполнить().Выгрузить();	
	УстановитьПривилегированныйРежим(Ложь);
	
	МассивВременный = ТаблицуВМассив(ТЗ);
	Результат = ДанныеВJSONХранилище(МассивВременный);	
	
	ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Получить список маршрутов из докуметов разгрузка авто ", "Разгрузка авто");
	
	Возврат Результат;
	
КонецФункции

Функция УстановитьБлокировкуНаМаршрутИзРазгрузкаАвто(StoreKeeperGUID, UnloadAutoGUID, UserIdGUID) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Ошибка", "");
	
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);	
	ЗаданиеНаДоставкСсылка = Документы.ЗаданиеНаДоставку.ПолучитьСсылку(Новый УникальныйИдентификатор(StoreKeeperGUID));
	РазгрузкаАвтоСсылка = Документы.РазгрузкаАвто.ПолучитьСсылку(Новый УникальныйИдентификатор(UnloadAutoGUID));
	
	// Проверяем, что пользователь уже заблокировал документ разгрузка авто
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	БуферАРККладовщикаБлокировкаМаршрутаЗаданияНаДоставку.ЗаданиеНаДоставку,
	|	БуферАРККладовщикаБлокировкаМаршрутаЗаданияНаДоставку.РазгрузкаАвто,
	|	БуферАРККладовщикаБлокировкаМаршрутаЗаданияНаДоставку.UserIdCode
	|ИЗ
	|	РегистрСведений.БуферАРККладовщикаБлокировкаМаршрутаЗаданияНаДоставку КАК БуферАРККладовщикаБлокировкаМаршрутаЗаданияНаДоставку
	|ГДЕ
	|	БуферАРККладовщикаБлокировкаМаршрутаЗаданияНаДоставку.ЗаданиеНаДоставку = &ЗаданиеНаДоставку
	|	И БуферАРККладовщикаБлокировкаМаршрутаЗаданияНаДоставку.РазгрузкаАвто = &РазгрузкаАвто
	|	И БуферАРККладовщикаБлокировкаМаршрутаЗаданияНаДоставку.UserIdCode = &UserId";
	
	Запрос.УстановитьПараметр("ЗаданиеНаДоставку", ЗаданиеНаДоставкСсылка);
	Запрос.УстановитьПараметр("РазгрузкаАвто", РазгрузкаАвтоСсылка);
	Запрос.УстановитьПараметр("UserId", UserIdСсылка);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	РезультатЗапроса.Следующий();
	Если РезультатЗапроса.Количество() > 0 Тогда
		
		Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
		Возврат Результат;		
		
	КонецЕсли; 
	/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	
	// Если пользователь не заблокировал, то проверяем не заблокировал, кто то другой
	// если нет, то сами его блокируем
	НачатьТранзакцию();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	БуферАРККладовщикаБлокировкаМаршрутаЗаданияНаДоставку.ЗаданиеНаДоставку,
	|	БуферАРККладовщикаБлокировкаМаршрутаЗаданияНаДоставку.РазгрузкаАвто,
	|	БуферАРККладовщикаБлокировкаМаршрутаЗаданияНаДоставку.UserIdCode,
	|	ЕСТЬNULL(ЗаданиеНаДоставкуТаблица.Маршрут.Наименование, """") КАК Маршрут,
	|	РазгрузкаАвтоТаблица.Грузополучатель.Наименование КАК ГрузополучательНаименование
	|ИЗ
	|	РегистрСведений.БуферАРККладовщикаБлокировкаМаршрутаЗаданияНаДоставку КАК БуферАРККладовщикаБлокировкаМаршрутаЗаданияНаДоставку
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаданиеНаДоставку КАК ЗаданиеНаДоставкуТаблица
	|		ПО БуферАРККладовщикаБлокировкаМаршрутаЗаданияНаДоставку.ЗаданиеНаДоставку = ЗаданиеНаДоставкуТаблица.Ссылка
	|			И БуферАРККладовщикаБлокировкаМаршрутаЗаданияНаДоставку.ЗаданиеНаДоставку = ЗаданиеНаДоставкуТаблица.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РазгрузкаАвто КАК РазгрузкаАвтоТаблица
	|		ПО БуферАРККладовщикаБлокировкаМаршрутаЗаданияНаДоставку.РазгрузкаАвто = РазгрузкаАвтоТаблица.Ссылка
	|ГДЕ
	|	БуферАРККладовщикаБлокировкаМаршрутаЗаданияНаДоставку.ЗаданиеНаДоставку = &ЗаданиеНаДоставку
	|	И БуферАРККладовщикаБлокировкаМаршрутаЗаданияНаДоставку.РазгрузкаАвто = &РазгрузкаАвто
	|	И БуферАРККладовщикаБлокировкаМаршрутаЗаданияНаДоставку.UserIdCode <> &UserId
	|
	|ДЛЯ ИЗМЕНЕНИЯ
	|	РегистрСведений.БуферАРККладовщикаБлокировкаМаршрутаЗаданияНаДоставку";
	
	Запрос.УстановитьПараметр("ЗаданиеНаДоставку", ЗаданиеНаДоставкСсылка);
	Запрос.УстановитьПараметр("РазгрузкаАвто", РазгрузкаАвтоСсылка);
	Запрос.УстановитьПараметр("UserId", UserIdСсылка);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	РезультатЗапроса.Следующий();
	
	Если РезультатЗапроса.Количество() > 0 Тогда				
		
		ОтменитьТранзакцию();
		ТекстОшибки = "Маршрут " + РезультатЗапроса.Маршрут + " по грузополучателю " + РезультатЗапроса.ГрузополучательНаименование + " уже заблокирован " 
		+ РезультатЗапроса.UserId;
		
		ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", ТекстОшибки, РезультатЗапроса.РазгрузкаАвто); 			
		
		Результат.Вставить("Ошибка", ТекстОшибки);
		Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
		Возврат Результат;		
		
	Иначе 
		
		МенеджерЗаписи = РегистрыСведений.БуферАРККладовщикаБлокировкаМаршрутаЗаданияНаДоставку.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ЗаданиеНаДоставку = ЗаданиеНаДоставкСсылка;
		МенеджерЗаписи.РазгрузкаАвто = РазгрузкаАвтоСсылка;
		МенеджерЗаписи.UserIdCode = UserIdСсылка; 
		МенеджерЗаписи.DateCreated = ТекущаяДата();
		МенеджерЗаписи.Записать();
		
	КонецЕсли;                                                          
	
	ЗафиксироватьТранзакцию();	 
	
	Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
	Возврат Результат;		
	
КонецФункции

Функция ПолучитьОстаткиНоменклатуры(Barcode, GoodGUID, UserIdGUID) Экспорт
	
	Запрос = Новый Запрос;      
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Штрихкоды.Владелец КАК Справочник.Номенклатура) КАК Номенклатура
	|ПОМЕСТИТЬ Товары
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК Штрихкоды
	|ГДЕ
	|	&Штрихкод <> """"
	|	И Штрихкоды.Штрихкод = &Штрихкод
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ 
	|	Номенклатура.Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура		
	|ГДЕ
	|	Номенклатура.Ссылка = &Номенклатура
	|;		
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ISNULL(ТоварыВЯчейках.Ячейка.Код, &ЗначениеПустое) КАК Ячейка,
	|	ТоварыВЯчейках.КоличествоОстаток КАК КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Остатки(
	|			,
	|			Номенклатура В
	|				(ВЫБРАТЬ
	|					Товары.Номенклатура
	|				ИЗ
	|					Товары)) КАК ТоварыВЯчейках";
	
	НоменклатураСсылка  =  Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(GoodGUID));			
	
	Запрос.УстановитьПараметр("Штрихкод", Barcode);		
	Запрос.УстановитьПараметр("Номенклатура", НоменклатураСсылка);
	Запрос.УстановитьПараметр("ЗначениеПустое", "----");
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	МассивВременный = ТаблицуВМассив(ТЗ);
	Результат = ДанныеВJSONХранилище(МассивВременный);
	
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);
	ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Получить остатки номенклатуры", "Штрихкод " + Barcode + "; " + НоменклатураСсылка);	
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьОстаткиНоменклатуруПоТаблицеЗначений(ТЗ, ПолучитьТЗ = Ложь) Экспорт
	
	Запрос = Новый Запрос;      
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СписокТоваров.Владелец КАК Номенклатура,
	|	СписокТоваров.Наименование,
	|	СписокТоваров.ГруппаАВСФилиала,
	|	СписокТоваров.КодПроизводителя,
	|	СписокТоваров.Производитель
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&СписокТоваров КАК СписокТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыВЯчейках.КоличествоОстаток КАК КоличествоОстаток,
	|	ТоварыВЯчейках.Номенклатура,
	|	ТоварыВЯчейках.Ячейка.Код КАК Ячейка,
	|	ТоварыВЯчейках.Ячейка.НеУчитыватьВОперативномУчете КАК НеУчитыватьВОперативномУчете,
	|	ВЫРАЗИТЬ(""ТоварыНаСкладе"" КАК СТРОКА(50)) КАК ИмяТаблицы
	|ПОМЕСТИТЬ ВТНаСкладе
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Остатки(
	|			,
	|			Номенклатура В
	|				(ВЫБРАТЬ
	|					ВТ.Номенклатура
	|				ИЗ
	|					ВТ)) КАК ТоварыВЯчейках
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток,
	|	ТоварыВРезервеНаСкладахОстатки.Номенклатура,
	|	ЛОЖЬ КАК НеУчитыватьВОперативномУчете,
	|	ВЫРАЗИТЬ(""ТоварыВРезерве"" КАК СТРОКА(50)) КАК ИмяТаблицы,
	|	ВЫРАЗИТЬ("""" КАК СТРОКА(50)) КАК Ячейка
	|ПОМЕСТИТЬ ВТВРезерве
	|ИЗ
	|	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(
	|			,
	|			Номенклатура В
	|				(ВЫБРАТЬ
	|					ВТ.Номенклатура
	|				ИЗ
	|					ВТ)) КАК ТоварыВРезервеНаСкладахОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТНаСкладе.КоличествоОстаток,
	|	ВТНаСкладе.Номенклатура,
	|	ВТНаСкладе.НеУчитыватьВОперативномУчете,
	|	ВТНаСкладе.ИмяТаблицы,
	|	ВТНаСкладе.Ячейка
	|ПОМЕСТИТЬ ВТТоварыВрезервеИнаСкладе
	|ИЗ
	|	ВТНаСкладе КАК ВТНаСкладе
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТВРезерве.КоличествоОстаток,
	|	ВТВРезерве.Номенклатура,
	|	ВТВРезерве.НеУчитыватьВОперативномУчете,
	|	ВТВРезерве.ИмяТаблицы,
	|	ВТВРезерве.Ячейка
	|ИЗ
	|	ВТВРезерве КАК ВТВРезерве
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Номенклатура КАК Владелец,
	|	ВТ.Наименование,
	|	ВТ.ГруппаАВСФилиала,
	|	ВТ.КодПроизводителя,
	|	ВТ.Производитель,
	|	ЕСТЬNULL(ВТТоварыВрезервеИнаСкладе.КоличествоОстаток, 0) КАК КоличествоОстаток,
	|	ЕСТЬNULL(ВТТоварыВрезервеИнаСкладе.НеУчитыватьВОперативномУчете, ЛОЖЬ) КАК НеУчитыватьВОперативномУчете,
	|	ЕСТЬNULL(ВТТоварыВрезервеИнаСкладе.ИмяТаблицы, """") КАК ИмяТаблицы,
	|	ЕСТЬNULL(ВТТоварыВрезервеИнаСкладе.Ячейка, """") КАК Ячейка
	|ИЗ
	|	ВТ КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТТоварыВрезервеИнаСкладе КАК ВТТоварыВрезервеИнаСкладе
	|		ПО ВТ.Номенклатура = ВТТоварыВрезервеИнаСкладе.Номенклатура";
	
	Запрос.УстановитьПараметр("СписокТоваров", ТЗ);	
	УстановитьПривилегированныйРежим(Истина);
	РезультатТЗ = Запрос.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если ПолучитьТЗ = Истина Тогда
		Возврат РезультатТЗ;
	КонецЕсли; 
	
	МассивВременный = ТаблицуВМассив(ТЗ);
	Результат = ДанныеВJSONХранилище(МассивВременный);
	
	Возврат Результат;
	
КонецФункции

Функция ОбработатьГрузовоеМесто(DeliveryOrderGUID, CargoPlaceGUID, UserIDGUID) Экспорт
	
	UserIdСсылка = ПолучитьПользователя(UserIDGUID);
	Результат = Новый Структура;
	Результат.Вставить("Ошибка", "");
	
	ЗаданиеНаДоставку = Документы.ЗаданиеНаДоставку.ПолучитьСсылку(Новый УникальныйИдентификатор(DeliveryOrderGUID));
	ГрузовоеМесто = Документы.ГрузовоеМесто.ПолучитьСсылку(Новый УникальныйИдентификатор(CargoPlaceGUID));
	
	Если ГрузовоеМесто.ПолучитьОбъект() = Неопределено Тогда 
		
		 ГрузовоеМесто = Документы.СлужебнаяЗаписка.ПолучитьСсылку(Новый УникальныйИдентификатор(CargoPlaceGUID));  
		 
		 //+Белов А. 23.01.2025 #UT10-5050
		 Если ГрузовоеМесто.ПолучитьОбъект() = Неопределено Тогда 			 
			 ГрузовоеМесто = Документы.ТранспортнаяЕдиница.ПолучитьСсылку(Новый УникальныйИдентификатор(CargoPlaceGUID));  			 
		 КонецЕсли; 	
		 //-Белов А. 23.01.2025 #UT10-5050
		 
    КонецЕсли;
	
	Если ГрузовоеМесто = Неопределено ИЛИ ГрузовоеМесто.ПолучитьОбъект() = Неопределено Или ЗаданиеНаДоставку = Неопределено Тогда
		
		ТекстОшибки = "Не найдено задание на доставку или грузовое место";				
		Результат.Вставить("Ошибка", ТекстОшибки);
		Результат.Вставить("КодРезультата", 1);
		Результат.Вставить("ЗначениеРезультата", "");
		Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
		Возврат Результат;
		
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗаданиеНаДоставкуДоставка.ДокументСборки
	|ПОМЕСТИТЬ ЗаданиеНаДоставку
	|ИЗ
	|	Документ.ЗаданиеНаДоставку.Доставка КАК ЗаданиеНаДоставкуДоставка
	|ГДЕ
	|	ЗаданиеНаДоставкуДоставка.Ссылка = &ЗаданиеНаДоставку
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаданиеНаДоставкуДоставка.ДокументСборки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ГрузовоеМесто.Ссылка КАК Документ
	|ИЗ
	|	Документ.ГрузовоеМесто КАК ГрузовоеМесто
	|ГДЕ
	|	ГрузовоеМесто.Сборка В
	|			(ВЫБРАТЬ
	|				ЗаданиеНаДоставку.ДокументСборки
	|			ИЗ
	|				ЗаданиеНаДоставку)
	|	И ГрузовоеМесто.Ссылка = &ГрузовоеМесто
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СлужебнаяЗаписка.Ссылка
	|ИЗ
	|	Документ.СлужебнаяЗаписка КАК СлужебнаяЗаписка
	|ГДЕ
	|	НЕ СлужебнаяЗаписка.ПометкаУдаления
	|	И НЕ СлужебнаяЗаписка.Погружено
	|	И СлужебнаяЗаписка.Ссылка В
	|			(ВЫБРАТЬ
	|				ЗаданиеНаДоставку.ДокументСборки
	|			ИЗ
	|				ЗаданиеНаДоставку)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТранспортнаяЕдиница.Ссылка
	|ИЗ
	|	Документ.ТранспортнаяЕдиница КАК ТранспортнаяЕдиница
	|ГДЕ
	|	ТранспортнаяЕдиница.Ссылка = &ГрузовоеМесто";

	Запрос.УстановитьПараметр("ЗаданиеНаДоставку", ЗаданиеНаДоставку);
	Запрос.УстановитьПараметр("ГрузовоеМесто", ГрузовоеМесто);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ГрузовоеМесто = Выборка.Документ;
		
		Если ГрузовоеМесто.ПометкаУдаления Тогда
			
			ТекстОшибки = "Грузовое место " + Выборка.Документ + " помечен на удаление. Обработка невозможна";				
			Результат.Вставить("Ошибка", ТекстОшибки);
			Результат.Вставить("КодРезультата", 0);
			Результат.Вставить("ЗначениеРезультата", "");
			Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
			Возврат Результат;
			
		ИначеЕсли ГрузовоеМесто.Погружено Тогда
			
			ТекстОшибки = "Грузовое место " + Выборка.Документ + " уже погружено. Обработка невозможна";				
			Результат.Вставить("Ошибка", ТекстОшибки);
			Результат.Вставить("КодРезультата", 1);
			Результат.Вставить("ЗначениеРезультата", "");
			Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
			Возврат Результат;
			
		Иначе		
			
			Попытка
				
				ДокОбъект = ГрузовоеМесто.ПолучитьОбъект();
				ДокОбъект.Погружено = Истина;
				ДокОбъект.Записать();
				
			Исключение
				
				ТекстОшибки = "Документ грузовое место " + Выборка.Документ + " невозможно записать. Обработка невозможна.";				
				Результат.Вставить("Ошибка", ТекстОшибки);
				Результат.Вставить("КодРезультата", 2);
				Результат.Вставить("ЗначениеРезультата", "");
				Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
				Возврат Результат;
				
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Попытка	
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаданиеНаДоставку.Ссылка,                                                         
		|	ЗаданиеНаДоставку.Водитель КАК Водитель
		|ИЗ
		|	Документ.ЗаданиеНаДоставку КАК ЗаданиеНаДоставку
		|ГДЕ
		|	ЗаданиеНаДоставку.Ссылка = &ЗаданиеНаДоставку";
		
		Запрос.УстановитьПараметр("ЗаданиеНаДоставку", ЗаданиеНаДоставку);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		ВодительСсылка = Выборка.Водитель;				
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ПогрузкаВАвто.Ссылка
		|ИЗ
		|	Документ.ПогрузкаВАвто КАК ПогрузкаВАвто
		|ГДЕ
		|	ПогрузкаВАвто.Водитель = &Водитель 
		|   И ПогрузкаВАвто.ПометкаУдаления = Ложь
		|	И ПогрузкаВАвто.ЗаданиеНаДоставку = &ЗаданиеНаДоставку
		|	И НАЧАЛОПЕРИОДА(ПогрузкаВАвто.Дата, ДЕНЬ) = НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ)";						
		
		Запрос.УстановитьПараметр("ЗаданиеНаДоставку", ЗаданиеНаДоставку);
		Запрос.УстановитьПараметр("Водитель", ВодительСсылка);					
		Запрос.УстановитьПараметр("Дата", ТекущаяДата());
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
		Иначе
			
			ДокОбъект = Документы.ПогрузкаВАвто.СоздатьДокумент();
			ДокОбъект.Клеверенс = Истина;
			ДокОбъект.Дата = ТекущаяДата();			
			ДокОбъект.Водитель = ВодительСсылка;
			ДокОбъект.Ответственный = UserIdСсылка;
			ДокОбъект.ЗаданиеНаДоставку = ЗаданиеНаДоставку;
			
			ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Создан документ ""Погрузка в авто""", ДокОбъект);
			
		КонецЕсли;
		
		Стр = ДокОбъект.Погружено.Добавить();
		Стр.Грузоместо = ГрузовоеМесто;

		Если ТипЗнч(ГрузовоеМесто) = Тип("ДокументСсылка.СлужебнаяЗаписка") Тогда 			
			Стр.Контрагент = Стр.Грузоместо.Получатель;
		//+Белов А. 24.01.2025 #UT10-5050
		ИначеЕсли ТипЗнч(ГрузовоеМесто) = Тип("ДокументСсылка.ТранспортнаяЕдиница") Тогда 			
			Стр.Контрагент = Стр.Грузоместо.Объединение.Грузополучатель;
		//-Белов А. 24.01.2025 #UT10-5050
		Иначе
			Стр.Контрагент = Стр.Грузоместо.Сборка.Грузополучатель;
		КонецЕсли;

		ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", 
		"Добавлено грузовое место в документ ""Погрузка в авто""", "Погрузка в авто " + ДокОбъект + "; " + "Грузовое место " + ГрузовоеМесто);
		
		//// Проверить, есть ли еще грузовые места для документа "Задание на доставку"
		/////////////////////////////////////////////////////////////////////////////////////////////////////////		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗаданиеНаДоставкуДоставка.ДокументСборки
		|ПОМЕСТИТЬ ЗаданиеНаДоставку
		|ИЗ
		|	Документ.ЗаданиеНаДоставку.Доставка КАК ЗаданиеНаДоставкуДоставка
		|ГДЕ
		|	ЗаданиеНаДоставкуДоставка.Ссылка = &ЗаданиеНаДоставку
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаданиеНаДоставкуДоставка.ДокументСборки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ГрузовоеМесто.Ссылка
		|ИЗ
		|	Документ.ГрузовоеМесто КАК ГрузовоеМесто
		|ГДЕ
		|	ГрузовоеМесто.Сборка В
		|			(ВЫБРАТЬ
		|				ЗаданиеНаДоставку.ДокументСборки
		|			ИЗ
		|				ЗаданиеНаДоставку)
		|	И ГрузовоеМесто.ПометкаУдаления = ЛОЖЬ
		|	И ГрузовоеМесто.Погружено = ЛОЖЬ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СлужебнаяЗаписка.Ссылка
		|ИЗ
		|	Документ.СлужебнаяЗаписка КАК СлужебнаяЗаписка
		|ГДЕ
		|	СлужебнаяЗаписка.ПометкаУдаления = ЛОЖЬ
		|	И СлужебнаяЗаписка.Погружено = ЛОЖЬ
		|	И СлужебнаяЗаписка.Ссылка В
		|			(ВЫБРАТЬ
		|				ЗаданиеНаДоставку.ДокументСборки
		|			ИЗ
		|				ЗаданиеНаДоставку)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ОбъединениеГМВТЕТранспортныеЕдиницы.ТранспортнаяЕдиница
		|ИЗ
		|	Документ.ОбъединениеГМВТЕ.ТранспортныеЕдиницы КАК ОбъединениеГМВТЕТранспортныеЕдиницы
		|ГДЕ
		|	ОбъединениеГМВТЕТранспортныеЕдиницы.Ссылка В
		|			(ВЫБРАТЬ
		|				ЗаданиеНаДоставку.ДокументСборки
		|			ИЗ
		|				ЗаданиеНаДоставку)
		|	И НЕ ОбъединениеГМВТЕТранспортныеЕдиницы.ТранспортнаяЕдиница.Погружено
		|	И НЕ ОбъединениеГМВТЕТранспортныеЕдиницы.ТранспортнаяЕдиница.ПометкаУдаления";

		Запрос.УстановитьПараметр("ЗаданиеНаДоставку", ЗаданиеНаДоставку);
		Выборка = Запрос.Выполнить().Выбрать();
		/////////////////////////////////////////////////////////////////////////////////////////////////////////
		
		Если Выборка.Количество() Тогда
			
			ДокОбъект.Записать();			
			Результат.Вставить("Ошибка", "");
			Результат.Вставить("КодРезультата", 4);
			
			ЗначениеРезультата = СокрЛП(ГрузовоеМесто.Номер) + "; " + Стр.Контрагент.Наименование;
			Результат.Вставить("ЗначениеРезультата", ЗначениеРезультата);						
			
			Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
			ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Документ ""Погрузка в авто"" записан", ДокОбъект);
			
		Иначе			
			
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);						
			Результат.Вставить("Ошибка", "");
			Результат.Вставить("КодРезультата", 300);
			Результат.Вставить("ЗначениеРезультата", "");
			Результат.Вставить("Сообщение", "Документ Погрузка в авто: """ + ДокОбъект.Номер + """ " + Строка(ДокОбъект.Дата) + " создан и проведен.");
			Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
			
			ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Документ ""Погрузка в авто"" проведен", ДокОбъект);
		КонецЕсли;  
		
		//+Белов А. 31.01.2025 #UT10-5050
		Если ТипЗнч(ГрузовоеМесто) = Тип("ДокументСсылка.ТранспортнаяЕдиница")
			И ЗначениеЗаполнено(ГрузовоеМесто.Объединение) 
			И ГрузовоеМесто.Объединение.Статус <> Перечисления.СтатусыОбъединений.Завершено Тогда
			
			ОбъединениеОб = ГрузовоеМесто.Объединение.ПолучитьОбъект(); 
			ОбъединениеОб.Статус = Перечисления.СтатусыОбъединений.Завершено;
			ОбъединениеОб.Записать();     		
			
		КонецЕсли;
		//-Белов А. 31.01.2025 #UT10-5050
		
	Исключение	
		
		ТекстОшибки = "Ошибка записи грузовых мест. " + ОписаниеОшибки() + Символы.ПС;				
		ТекстОшибки = ТекстОшибки + "Документ записан и НЕ проведен.";
		Результат.Вставить("Ошибка", ТекстОшибки);
		Результат.Вставить("КодРезультата", 3);
		Результат.Вставить("ЗначениеРезультата", "");
		Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
		
	КонецПопытки;
	
	Возврат Результат;	
	
КонецФункции

Функция ЗаписатьВБуферРазмещенияСПроверкойОстатков(ObjectGUID, GoodGUID, UserIdGUID, CreatedDate,
	Barcode, Quantity, CellGUID, PutIntoManual) Экспорт           
	
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);
	
	GetTableValues = Истина;
	TypeDocument = "ПоступлениеТоваровУслуг";
	GUIDDocument = ObjectGUID;
	НайденныйТовар = FindGoodByBarcode(UserIdGUID, Barcode, TypeDocument, GUIDDocument, GoodGUID, GetTableValues);
	
	SelectedProductIdGUID = GoodGUID;
	ПолучитьТЗ = Истина;                         
	// КоличествоВДокументе, КоличествоВБуфере, СсылкаТовара, КоличествоВРазмещении
	ОстатокПоТоваруВДокументе = ПолучитьОстатокПоТоваруИзДокумента(UserIdGUID, ObjectGUID, Barcode, SelectedProductIdGUID, Истина);
	
	КоличествоНабрано = ОстатокПоТоваруВДокументе[0].КоличествоВБуфере + ОстатокПоТоваруВДокументе[0].КоличествоВРазмещении + Quantity;

	//+Кабанов А.В. 29.08.2025 # UT10-5361
	КоличествоСМаркой = ОстатокПоТоваруВДокументе[0].КоличествоТоваровСМаркировкой;
	
	Если Не КоличествоСМаркой = 0 Тогда
		
		Если  ОстатокПоТоваруВДокументе[0].КоличествоОтсканированныхМаркировок = 0 Тогда
			
			Ошибка = "Ошибка: Номенклатура со штрихкодом " + Barcode + " " + НайденныйТовар[0] .Наименование + " подлежит обязательной маркировке !";
			ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Записать в буфер размещения с проверкой остатков", Ошибка);				
			Возврат "НоменклатураСоШтрихкодомНеНайдена/НоменклатураПодлежитОбязательнойМаркировке:" + Ошибка;
			
		КонецЕсли;
		
		ОстатокПоТоваруВДокументе[0].КоличествоВДокументе = Мин(ОстатокПоТоваруВДокументе[0].КоличествоВДокументе , ОстатокПоТоваруВДокументе[0].КоличествоОтсканированныхМаркировок);		
		
		//Если (ОстатокПоТоваруВДокументе[0].КоличествоВДокументе - КоличествоНабрано) < 0 Тогда
		//	
		//	Ошибка = "Ошибка: По номенклатура со штрихкодом " + Barcode + " " + НайденныйТовар[0] .Наименование + " отсканированны не все марки !";		
		//	ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Записать в буфер размещения с проверкой остатков", Ошибка);				
		//	Возврат "НоменклатураПодлежитОбязательнойМаркировке:" + Ошибка;		
		//	
		//КонецЕсли; 
		
	КонецЕсли;
	//-Кабанов А.В. 29.08.2025 # UT10-5361

	Если ОстатокПоТоваруВДокументе.Количество() = 0 Тогда
		
		Ошибка = "Ошибка: Номенклатура со штрихкодом " + Barcode + " " + НайденныйТовар[0] .Наименование + " в документе не найдена.";	
		ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Записать в буфер размещения с проверкой остатков", Ошибка);
		Возврат "НоменклатураСоШтрихкодомНеНайдена:" + Ошибка;		
		
	КонецЕсли; 
		
 	Если (ОстатокПоТоваруВДокументе[0].КоличествоВДокументе - КоличествоНабрано) < 0 Тогда
		
		ШаблонТекстаОшибки = "Уже набрано %1 из %2 (%3)" + Символы.ПС;
		ШаблонТекстаОшибки = ШаблонТекстаОшибки + "всего в поставке: %2"+ Символы.ПС;		
		ШаблонТекстаОшибки = ШаблонТекстаОшибки + "ПЫТАЕТЕСЬ ВЗЯТЬ 1 (%3)";

		Если ОстатокПоТоваруВДокументе[0].ТоварТребуетсяМаркировка Тогда
			
			КоличествоНеотсканированныхСМаркировок  = ОстатокПоТоваруВДокументе[0].КоличествоТоваровСМаркировкой - ОстатокПоТоваруВДокументе[0].КоличествоОтсканированныхМаркировок;
			
			Если КоличествоНеотсканированныхСМаркировок > 0 Тогда
				ШаблонТекстаОшибки = ШаблонТекстаОшибки + Символы.ПС + "Необходимо отсканировать %4 QR-код";	
			КонецЕсли;
			
		Иначе
			КоличествоНеотсканированныхСМаркировок = 0 ;			
		КонецЕсли;
		
		Ошибка  = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекстаОшибки, 
		КоличествоНабрано,				
		ОстатокПоТоваруВДокументе[0].КоличествоВДокументе, 
		НайденныйТовар[0].ЕдИзмНаименование,
		КоличествоНеотсканированныхСМаркировок	
		);						
		
		ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Записать в буфер размещения с проверкой остатков", Ошибка);				
		Возврат "ПытаетсяВзятьБольшееКолво:" + Ошибка;		
		
	КонецЕсли; 
		
	ОбъектСсылка = Документы.ПоступлениеТоваровУслуг.ПолучитьСсылку(Новый УникальныйИдентификатор(ObjectGUID));
	
	Если ОбъектСсылка.ПолучитьОбъект() = Неопределено Тогда
		ОбъектСсылка = Документы.ПоступлениеТоваровНаОтветственноеХранение.ПолучитьСсылку(Новый УникальныйИдентификатор(ObjectGUID));
	КонецЕсли;
	
	НоменклатураСсылка = Справочники.Номенклатура.ПолучитьСсылку( Новый УникальныйИдентификатор(GoodGUID));	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.КодПроизводителя
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", НоменклатураСсылка);
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	РезультатЗапроса.Следующий();
	
	ЯчейкаСсылка = Справочники.Ячейки.ПолучитьСсылку(Новый УникальныйИдентификатор(CellGUID));	
	
	МЗ = РегистрыСведений.БуферАрмКладовщика.СоздатьМенеджерЗаписи();	
	МЗ.Объект = ОбъектСсылка;
	МЗ.UserId = UserIdСсылка;                      		
	МЗ.Номенклатура = НоменклатураСсылка;		
	МЗ.CreateDate = CreatedDate;
	МЗ.Прочитать();
	
	Если МЗ.Выбран() Тогда                                                  
		
		МЗ.Quantity = МЗ.Quantity + Quantity;
		
		Если Не МЗ.ВведеноВРучную И PutIntoManual Тогда
			МЗ.ВведеноВРучную = PutIntoManual;
		КонецЕсли; 
		
	Иначе
		
		МЗ.Объект = ОбъектСсылка;
		МЗ.UserId = UserIdСсылка;
		МЗ.CreateDate = CreatedDate;			
		МЗ.Номенклатура = НоменклатураСсылка;		
		МЗ.Barcode = Barcode;
		МЗ.Quantity = Quantity;
		МЗ.КодПроизводителя = РезультатЗапроса.КодПроизводителя;
		МЗ.Ячейка = ЯчейкаСсылка;
		МЗ.ВведеноВРучную = PutIntoManual;
		
	КонецЕсли;	
	
	МЗ.Записать();
	ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Создана запись в РС БуферАРМКладовщика", 
	"ПТУ " + ОбъектСсылка.Номер + ", СклДок "+ Строка(ОбъектСсылка.НомерСкладскогоДокумента) + 
	" , Номенклатура " + Строка(НоменклатураСсылка.КодПроизводителя) + ", " + НоменклатураСсылка.Наименование);
	
	Возврат "Истина: " + Строка(КоличествоНабрано) + ", " +  
	Строка(ОстатокПоТоваруВДокументе[0].КоличествоВДокументе) + ", " + 
	Строка(ОстатокПоТоваруВДокументе[0].КоличествоВБуфере  + Quantity) + ", " +
	Строка(ОстатокПоТоваруВДокументе[0].КоличествоВРазмещении) + ", " + 
	Строка(Quantity) ;
	
КонецФункции

Функция ЗаписатьВБуферМаркировок(ObjectGUID , UserIdGUID , CreatedDate , GoodGUID , MarkData) Экспорт
	
	UserIdСсылка       = ПолучитьПользователя(UserIdGUID);
	ОбъектСсылка       = Документы.ПоступлениеТоваровУслуг.ПолучитьСсылку(Новый УникальныйИдентификатор(ObjectGUID));
	НоменклатураСсылка = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(GoodGUID));
	ДанныеМаркировки   = ХранилищеJSONВСтруктуру(MarkData);
	
	ШтрихКодМаркировкиКраткий = ДанныеМаркировки.ШтрихКодКраткий;
	ШтрихКодМаркировкиПолный  = ДанныеМаркировки.ШтрихКодПолный; 
	
	//проверяем в буфере маркировок
	ЗаросПоБуферуМаркировок = Новый Запрос;
	ЗаросПоБуферуМаркировок.Текст = 
	"ВЫБРАТЬ
	|	БуферАрмКладовщикаМаркировки.Номенклатура
	|ИЗ
	|	РегистрСведений.БуферАрмКладовщикаМаркировки КАК БуферАрмКладовщикаМаркировки
	|ГДЕ
	|	(БуферАрмКладовщикаМаркировки.Barcode = &ШтрихКодМаркировкиКраткий
	|			ИЛИ БуферАрмКладовщикаМаркировки.Barcode = &ШтрихКодМаркировкиПолный)";
	
	ЗаросПоБуферуМаркировок.УстановитьПараметр("ШтрихКодМаркировкиКраткий", ШтрихКодМаркировкиКраткий);
	ЗаросПоБуферуМаркировок.УстановитьПараметр("ШтрихКодМаркировкиПолный" , ШтрихКодМаркировкиПолный);
	
	//+Шульман А. 20.11.2025 #UT10-5516
	ЗаписьЖурналаРегистрации("ЗаписатьВБуферМаркировок", УровеньЖурналаРегистрации.Информация, , , 
	"ШтрихкодМаркировки Краткий = " + ШтрихКодМаркировкиКраткий +  ", ШтрихкодМаркировки Полный = " + ШтрихКодМаркировкиПолный);   
	//-Шульман А. 20.11.2025 #UT10-5516
	
	РезультатЗапроса = ЗаросПоБуферуМаркировок.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		Ошибка = "Ошибка: Маркировка номенклатуры " + ШтрихКодМаркировкиКраткий + " для " + НоменклатураСсылка.Наименование + " уже была отсканированна.";	
		ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Записать в буфер маркировок", Ошибка);
		Возврат "МаркировкаСоШтрихКодомУжеОтсканированна:" + Ошибка;
		
	КонецЕсли;
	
	//Проверяем в справочнике 
	ЗапросПоСправочнику = Новый Запрос;
	ЗапросПоСправочнику.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 1
	|	ШтрихкодыНоменклатуры.Ссылка КАК ШтрихКодМаркировки
	|ИЗ
	|	Справочник.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
	|ГДЕ
	|	(ШтрихкодыНоменклатуры.КодМаркировки = &ШтрихКодМаркировкиКраткий
	|			ИЛИ ШтрихкодыНоменклатуры.КодМаркировки = &ШтрихКодМаркировкиПолный)";
	
	ЗапросПоСправочнику.УстановитьПараметр("ШтрихКодМаркировкиКраткий" , ШтрихКодМаркировкиКраткий);
	ЗапросПоСправочнику.УстановитьПараметр("ШтрихКодМаркировкиПолный"  , ШтрихКодМаркировкиПолный);
	
	РезультатЗапроса = ЗапросПоСправочнику.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		ВыборкаЗапроса = РезультатЗапроса.Выбрать();
		ВыборкаЗапроса.Следующий();
		мКодМаркировки = ВыборкаЗапроса.ШтрихКодМаркировки;
		
		//Проверяем в ПТУ
		ЗапросПоПТУ = Новый Запрос;
		ЗапросПоПТУ.Текст =
		"ВЫБРАТЬ
		|	ПоступлениеТоваровУслугОтсканированныеКодыМаркировки.НомерСтроки
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг.ОтсканированныеКодыМаркировки КАК ПоступлениеТоваровУслугОтсканированныеКодыМаркировки
		|ГДЕ
		|	ПоступлениеТоваровУслугОтсканированныеКодыМаркировки.Ссылка = &ОбъектСсылка
		|	И ПоступлениеТоваровУслугОтсканированныеКодыМаркировки.КодМаркировки = &КодМаркировки";
		
		ЗапросПоПТУ.УстановитьПараметр("ОбъектСсылка"  , ОбъектСсылка);
		ЗапросПоПТУ.УстановитьПараметр("КодМаркировки" , мКодМаркировки);
		
		РезультатЗапроса = ЗапросПоПТУ.Выполнить();
		
		Если НЕ РезультатЗапроса.Пустой() Тогда
			
			Ошибка = "Ошибка: Маркировка номенклатуры " + ШтрихКодМаркировкиКраткий + " для " + НоменклатураСсылка.Наименование + " уже внесена в ПТУ.";	
			ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Записать в буфер маркировок", Ошибка);
			Возврат "МаркировкаСоШтрихКодомУжеВнесена:" + Ошибка;
			
		КонецЕсли;
		
	КонецЕсли; 
	
	МЗ                  = РегистрыСведений.БуферАрмКладовщикаМаркировки.СоздатьМенеджерЗаписи();	
	МЗ.Объект           = ОбъектСсылка;
	МЗ.UserId           = UserIdСсылка;
	МЗ.CreateDate       = CreatedDate;			
	МЗ.Номенклатура     = НоменклатураСсылка;		
	МЗ.Barcode          = ШтрихКодМаркировкиКраткий;
	МЗ.BarcodeFull      = ШтрихКодМаркировкиПолный;  

	МЗ.Записать(); 
	
	ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Создана запись в РС БуферАрмКладовщикаМаркировки", 
	"ПТУ " + ОбъектСсылка.Номер + ", СклДок "+ Строка(ОбъектСсылка.НомерСкладскогоДокумента) + 
	" , Номенклатура " + Строка(НоменклатураСсылка.КодПроизводителя) + ", " + НоменклатураСсылка.Наименование);
	
	Возврат "Истина";	
	//-Кабанов А.В. 05.09.2025 # UT10-5361	
КонецФункции

Функция FindGoodByBarcodeWithRemains(Barcode, GoodGUID, UserIDGUID) Экспорт
	
	НоменклатураТЗ = FindGoodByBarcode(UserIDGUID, Barcode, "", "", GoodGUID, Истина);
	ОстаткиНоменклатурыТЗ = ПолучитьОстаткиНоменклатуруПоТаблицеЗначений(НоменклатураТЗ, Истина);
	
	МассивВременный = ТаблицуВМассив(ОстаткиНоменклатурыТЗ);
	Результат = ДанныеВJSONХранилище(МассивВременный);
	
	UserIDСсылка = ПолучитьПользователя(UserIDGUID);
	ЗаписатьЛог(UserIDСсылка, ТекущаяДата(), "", 
	"Найти товар по штрихкоду с остатками", "Штрихкод " + Barcode + "; Товар гуид " + GoodGUID);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСписокГрузовыхМест(DocumentGUID, GetAllRecords, UserIdGUID) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаданиеНаДоставкуДоставка.ДокументСборки,
	|	ЗаданиеНаДоставкуДоставка.Ссылка.Маршрут,
	|	ЗаданиеНаДоставкуДоставка.Ссылка.Номер КАК НомерЗаданияНаДоставку,
	|	ЗаданиеНаДоставкуДоставка.Контрагент.Наименование КАК Контрагент
	|ПОМЕСТИТЬ ЗаданиеНаДоставку
	|ИЗ
	|	Документ.ЗаданиеНаДоставку.Доставка КАК ЗаданиеНаДоставкуДоставка
	|ГДЕ
	|	ЗаданиеНаДоставкуДоставка.Ссылка = &ДокСсылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаданиеНаДоставкуДоставка.ДокументСборки,
	|	ЗаданиеНаДоставкуДоставка.Ссылка.Маршрут,
	|	ЗаданиеНаДоставкуДоставка.Ссылка.Номер,
	|	ЗаданиеНаДоставкуДоставка.Контрагент.Наименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ГрузовоеМесто.Ссылка КАК ГрузовоеМестоГУИД,
	|	ГрузовоеМесто.Номер КАК ГрузовоеМестоНомер,
	|	ЗаданиеНаДоставку.Маршрут.Наименование КАК Маршрут,
	|	""&ДокСсылка&"" КАК ЗаданиеНаДоставкуГУИД,
	|	ЗаданиеНаДоставку.НомерЗаданияНаДоставку,
	|	ГрузовоеМесто.Погружено КАК Погружено,
	|	ЗаданиеНаДоставку.Контрагент,
	|	ГрузовоеМесто.ШтрихкодГрузовогоМеста КАК ШтрихкодГрузовогоМеста,
	|	ВЫБОР
	|		КОГДА ГрузовоеМесто.ШтрихкодГрузовогоМеста = """"
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК НетШтрихкодаГМ
	|ИЗ
	|	Документ.ГрузовоеМесто КАК ГрузовоеМесто
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ЗаданиеНаДоставку КАК ЗаданиеНаДоставку
	|		ПО ГрузовоеМесто.Сборка = ЗаданиеНаДоставку.ДокументСборки
	|ГДЕ
	|	(НЕ &GetAllRecords
	|				И ГрузовоеМесто.Погружено = ЛОЖЬ
	|			ИЛИ &GetAllRecords)
	|	И ГрузовоеМесто.ПометкаУдаления = ЛОЖЬ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СлужебнаяЗапискаТранспортныеЕдиницы.Ссылка,
	|	СлужебнаяЗапискаТранспортныеЕдиницы.Ссылка.Номер,
	|	ЗаданиеНаДоставку.Маршрут.Наименование,
	|	""&ДокСсылка&"",
	|	ЗаданиеНаДоставку.НомерЗаданияНаДоставку,
	|	СлужебнаяЗапискаТранспортныеЕдиницы.Ссылка.Погружено,
	|	ЗаданиеНаДоставку.Контрагент,
	|	СлужебнаяЗапискаТранспортныеЕдиницы.Грузоместо,
	|	ВЫБОР
	|		КОГДА СлужебнаяЗапискаТранспортныеЕдиницы.Грузоместо = """"
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ
	|ИЗ
	|	ЗаданиеНаДоставку КАК ЗаданиеНаДоставку
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СлужебнаяЗаписка.ТранспортныеЕдиницы КАК СлужебнаяЗапискаТранспортныеЕдиницы
	|		ПО ЗаданиеНаДоставку.ДокументСборки = СлужебнаяЗапискаТранспортныеЕдиницы.Ссылка
	|ГДЕ
	|	(НЕ &GetAllRecords
	|				И СлужебнаяЗапискаТранспортныеЕдиницы.Ссылка.Погружено = ЛОЖЬ
	|			ИЛИ &GetAllRecords)
	|	И СлужебнаяЗапискаТранспортныеЕдиницы.Ссылка.Проведен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.ТранспортнаяЕдиница,
	|	ВложенныйЗапрос.ТранспортнаяЕдиница.Номер,
	|	ЗаданиеНаДоставку.Маршрут.Наименование,
	|	""&ДокСсылка&"",
	|	ЗаданиеНаДоставку.НомерЗаданияНаДоставку,
	|	ВложенныйЗапрос.ТранспортнаяЕдиница.Погружено,
	|	ЗаданиеНаДоставку.Контрагент,
	|	ВложенныйЗапрос.ТранспортнаяЕдиница.Штрихкод,
	|	ВЫБОР
	|		КОГДА ВложенныйЗапрос.ТранспортнаяЕдиница.Штрихкод = """"
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ
	|ИЗ
	|	ЗаданиеНаДоставку КАК ЗаданиеНаДоставку
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ОбъединениеГМВТЕТранспортныеЕдиницы.ТранспортнаяЕдиница КАК ТранспортнаяЕдиница,
	|			ОбъединениеГМВТЕТранспортныеЕдиницы.Ссылка КАК Объединение
	|		ИЗ
	|			Документ.ОбъединениеГМВТЕ.ТранспортныеЕдиницы КАК ОбъединениеГМВТЕТранспортныеЕдиницы
	|		ГДЕ
	|			ОбъединениеГМВТЕТранспортныеЕдиницы.Ссылка В
	|					(ВЫБРАТЬ
	|						ЗаданиеНаДоставку.ДокументСборки
	|					ИЗ
	|						ЗаданиеНаДоставку)
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ОбъединениеГМВТЕТранспортныеЕдиницы.ТранспортнаяЕдиница,
	|			ОбъединениеГМВТЕТранспортныеЕдиницы.Ссылка) КАК ВложенныйЗапрос
	|		ПО ЗаданиеНаДоставку.ДокументСборки = ВложенныйЗапрос.Объединение
	|ГДЕ
	|	(НЕ &GetAllRecords
	|				И ВложенныйЗапрос.ТранспортнаяЕдиница.Погружено = ЛОЖЬ
	|			ИЛИ &GetAllRecords)
	|	И ВложенныйЗапрос.ТранспортнаяЕдиница.Проведен" ;

	ДокСсылка = Документы.ЗаданиеНаДоставку.ПолучитьСсылку(Новый УникальныйИдентификатор(DocumentGUID));
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДокСсылка&", "" + DocumentGUID + "");
	
	Запрос.УстановитьПараметр("GetAllRecords", GetAllRecords);
	Запрос.УстановитьПараметр("ДокСсылка", ДокСсылка);    
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	МассивСтрок = ТЗ.НайтиСтроки(Новый Структура("НетШтрихкодаГМ", Истина));    
	ДокГМ       = Документы.ГрузовоеМесто;
	
	Для каждого Запись Из МассивСтрок Цикл     
		
		ГМОбъект = Запись.ГрузовоеМестоГУИД.ПолучитьОбъект();
		
		Попытка
			
			ГМОбъект.ДополнительныеСвойства.Вставить("НеВыполнятьПроверкуНаДатыЗапрета", Истина);
			ГМОбъект.Записать(); 
			Запись.ШтрихкодГрузовогоМеста = ГМОбъект.ШтрихкодГрузовогоМеста;   
			
		Исключение
			Запись.ШтрихкодГрузовогоМеста = ДокГМ.ПолучитьШтрихкодГрузоместа(Запись.ГрузовоеМестоГУИД);                                                                                                   		
		КонецПопытки;
		
	КонецЦикла;    
	
	УстановитьПривилегированныйРежим(Ложь);
	
	МассивВременный = ТаблицуВМассив(ТЗ);
	Результат = ДанныеВJSONХранилище(МассивВременный);
	
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);
	ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Получить список грузовых мест ", "Задание на доставку " + ДокСсылка);
	
	Возврат Результат;
	
КонецФункции

Функция ПроверитьЯчейкиДляБлокировкиПриИнвентаризации(ObjectGUID, CellsXDTO, UserIdGUID) Экспорт
	
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);	
	МассивЯчеек = СериализаторXDTO.ПрочитатьXDTO(CellsXDTO);
	
	МассивЯчеекСсылок = Новый Массив;
	
	Для каждого Элемент Из МассивЯчеек Цикл
		МассивЯчеекСсылок.Добавить(Справочники.Ячейки.ПолучитьСсылку(Новый УникальныйИдентификатор(Элемент)));
	КонецЦикла; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Ячейки.Ссылка
	|ПОМЕСТИТЬ ВТЯчейки
	|ИЗ
	|	Справочник.Ячейки КАК Ячейки
	|ГДЕ
	|	Ячейки.Ссылка В(&Ячейки)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СборкаЗаказовПокупателяЗаказано.Ячейка КАК ЯчейкаСборки,
	|	МИНИМУМ(ВЫБОР
	|			КОГДА СборкаЗаказовПокупателяЗаказано.Ссылка.ДокументСобранИУпакован
	|					ИЛИ НЕ СборкаЗаказовПокупателяЗаказано.Ссылка.ДокументСобранИУпакован
	|						И СборкаЗаказовПокупателяЗаказано.Ссылка.ПолностьюОткорректирована
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ПризнакИнвентаризации
	|ПОМЕСТИТЬ ВТСборки
	|ИЗ
	|	Документ.СборкаЗаказовПокупателя.Заказано КАК СборкаЗаказовПокупателяЗаказано
	|ГДЕ
	|	СборкаЗаказовПокупателяЗаказано.Ссылка.Проведен
	|	И СборкаЗаказовПокупателяЗаказано.Ячейка В(&Ячейки)
	|	И СборкаЗаказовПокупателяЗаказано.Ссылка.Дата >= &Дата
	|
	|СГРУППИРОВАТЬ ПО
	|	СборкаЗаказовПокупателяЗаказано.Ячейка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТЯчейки.Ссылка КАК СсылкаЯчейки,
	|	ВТЯчейки.Ссылка.Код КАК КодЯчейки,
	|	ISNULL(ВТСборки.ПризнакИнвентаризации, ИСТИНА) КАК ПризнакИнвентаризации
	|ИЗ
	|	ВТЯчейки КАК ВТЯчейки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСборки КАК ВТСборки
	|		ПО ВТЯчейки.Ссылка = ВТСборки.ЯчейкаСборки";
	
	Запрос.УстановитьПараметр("Ячейки", МассивЯчеекСсылок);
	Запрос.УстановитьПараметр("Дата", ТекущаяДата() - 3600 * 24 * 90);
	
	УстановитьПривилегированныйРежим(Истина);			
	ТЗ = Запрос.Выполнить().Выгрузить();	     
	УстановитьПривилегированныйРежим(Ложь);			
	
	МассивВременный = ТаблицуВМассив(ТЗ);                                    
	Результат = ДанныеВJSONХранилище(МассивВременный);
	
	ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Проверить ячейки на возможность блокировки при инвентаризации", 
	СтроковыеФункцииКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(МассивЯчеекСсылок)); 	
	
	ПараметрыОтбора = Новый Структура("ПризнакИнвентаризации", Ложь);	
	ТЗПризнакИнвент = ТЗ.Скопировать(ПараметрыОтбора);
	
	Если ТЗПризнакИнвент.Количество() = 0 Тогда
		УстановитьБлокирокуЯчеек(ObjectGUID, CellsXDTO, Истина, UserIdGUID)		 
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции

Функция УстановитьБлокирокуЯчеек(ObjectGUID, CellsXDTO, SetLock, UserIdGUID) Экспорт
	
	Результат = Ложь;
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);	
	ДокументСсылка = Документы.ЗаданиеНаИнвентаризацию.ПолучитьСсылку(Новый УникальныйИдентификатор(ObjectGUID));
	
	Если SetLock Тогда 
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	БуферАРМКладовщикаСтатусИнвентЯчеек.Объект,
		|	БуферАРМКладовщикаСтатусИнвентЯчеек.UserId
		|ИЗ
		|	РегистрСведений.БуферАРМКладовщикаСтатусИнвентЯчеек КАК БуферАРМКладовщикаСтатусИнвентЯчеек
		|ГДЕ
		|	БуферАРМКладовщикаСтатусИнвентЯчеек.Объект = &Объект
		|	И БуферАРМКладовщикаСтатусИнвентЯчеек.UserId = &UserId";
		
		Запрос.УстановитьПараметр("Объект", ДокументСсылка);
		Запрос.УстановитьПараметр("UserId", UserIdСсылка); 
		РезультатЗапроса = Запрос.Выполнить().Выбрать();
		
	КонецЕсли; 
	
	МассивЯчеек = СериализаторXDTO.ПрочитатьXDTO(CellsXDTO);
	МассивЯчеекСсылок = Новый Массив;
	
	НачатьТранзакцию();
	
	Для каждого Элемент Из МассивЯчеек Цикл
		
		СсылкаЯчейка = Справочники.Ячейки.ПолучитьСсылку(Новый УникальныйИдентификатор(Элемент));
		МассивЯчеекСсылок.Добавить(СсылкаЯчейка);
		
		ЯчейкаОбъект = СсылкаЯчейка.ПолучитьОбъект();
		ЯчейкаОбъект.НеУчитыватьВОперативномУчете = SetLock;
		ЯчейкаОбъект.Записать();
		
		Если SetLock И РезультатЗапроса.Количество() = 0 Тогда
			
			МЗ = РегистрыСведений.БуферАРМКладовщикаСтатусИнвентЯчеек.СоздатьМенеджерЗаписи();	
			МЗ.Объект = ДокументСсылка;
			МЗ.UserId = UserIdСсылка;                      		
			МЗ.Ячейка = СсылкаЯчейка;	
			МЗ.Статус = Перечисления.СтатусЯчейкиИзЗаданияНаИнвентаризацию.НеНачат;			
			МЗ.CreateDate = ТекущаяДата();
			МЗ.Записать();
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	Если Не SetLock Тогда
		
		РС = РегистрыСведений.БуферАРМКладовщикаСтатусИнвентЯчеек.СоздатьНаборЗаписей();
		РС.Отбор.Объект.Установить(ДокументСсылка);
		РС.Отбор.UserId.Установить(UserIdСсылка);
		РС.Записать();
		
	КонецЕсли; 
	
	Результат = Истина;
	
	ЗафиксироватьТранзакцию();
	
	Если SetLock Тогда
		ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Заблокировать ячейки", 
		СтроковыеФункцииКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(МассивЯчеекСсылок)); 			
	Иначе 
		ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Разблокировать ячейки", 
		СтроковыеФункцииКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(МассивЯчеекСсылок)); 							
	КонецЕсли; 
	
	Возврат Результат;	
	
КонецФункции

Функция ПолучитьСписокСборокДляЗаблокированнойЯчейки(CellGUID, UserIdGUID) Экспорт
	
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);		
	ЯчейкаСсылка = Справочники.Ячейки.ПолучитьСсылку(Новый УникальныйИдентификатор(CellGUID));
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СборкаЗаказовПокупателяЗаказано.Ссылка КАК СборкаГУИД,
	|	СборкаЗаказовПокупателяЗаказано.Ссылка.Номер КАК СборкаНомер,
	|	СборкаЗаказовПокупателяЗаказано.Ссылка.Дата КАК СборкаДата,
	|	СборкаЗаказовПокупателяЗаказано.Ячейка КАК ЯчейкаГУИД,
	|	СборкаЗаказовПокупателяЗаказано.Ячейка.Код КАК ЯчейкаКод,
	|	ВЫБОР
	|		КОГДА СборкаЗаказовПокупателяЗаказано.Ссылка.ДокументСобранИУпакован
	|				ИЛИ НЕ СборкаЗаказовПокупателяЗаказано.Ссылка.ДокументСобранИУпакован
	|					И СборкаЗаказовПокупателяЗаказано.Ссылка.ПолностьюОткорректирована
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ПризнакИнвентаризации
	|ИЗ
	|	Документ.СборкаЗаказовПокупателя.Заказано КАК СборкаЗаказовПокупателяЗаказано
	|ГДЕ
	|	СборкаЗаказовПокупателяЗаказано.Ссылка.Проведен
	|	И СборкаЗаказовПокупателяЗаказано.Ячейка = &Ячейка
	|	И СборкаЗаказовПокупателяЗаказано.Ссылка.Дата >= &Дата
	|	И ВЫБОР
	|			КОГДА СборкаЗаказовПокупателяЗаказано.Ссылка.ДокументСобранИУпакован
	|					ИЛИ НЕ СборкаЗаказовПокупателяЗаказано.Ссылка.ДокументСобранИУпакован
	|						И СборкаЗаказовПокупателяЗаказано.Ссылка.ПолностьюОткорректирована
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("Ячейка", ЯчейкаСсылка);                                                                     	
	Запрос.УстановитьПараметр("Дата", ТекущаяДата() - 3600 * 24 * 90);
	
	УстановитьПривилегированныйРежим(Истина);
	ТЗ = Запрос.Выполнить().Выгрузить();                 
	УстановитьПривилегированныйРежим(Ложь);
	
	МассивВременный = ТаблицуВМассив(ТЗ);
	Результат = ДанныеВJSONХранилище(МассивВременный);
	
	ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Получить список сборок для заблокированной ячейки", ""); 	
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСписокЗаданийНаИнвентаризацию(UserIdGUID) Экспорт
	
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаданиеНаИнвентаризацию.Ссылка КАК Ссылка,
	|	ЗаданиеНаИнвентаризацию.Номер КАК НомерДокумента,
	|	ЗаданиеНаИнвентаризацию.Дата КАК ДатаДокумента,
	|	ИнвентарЯчейки.ЯчейкаДляИнвентаризации.Ссылка КАК СсылкаЯчейки,
	|	ИнвентарЯчейки.ЯчейкаДляИнвентаризации.Код КАК КодЯчейки,
	|	ЗаданиеНаИнвентаризацию.Ответственный,
	|	ЗаданиеНаИнвентаризацию.РегламентноеЗадание
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	Документ.ЗаданиеНаИнвентаризацию.ИнвентаризируемыеЯчейки КАК ИнвентарЯчейки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаданиеНаИнвентаризацию КАК ЗаданиеНаИнвентаризацию
	|		ПО ИнвентарЯчейки.Ссылка = ЗаданиеНаИнвентаризацию.Ссылка
	|ГДЕ
	|	ЗаданиеНаИнвентаризацию.Ответственный = &Ответственный
	|	И ЗаданиеНаИнвентаризацию.ДатаВыполнения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|	И НЕ ЗаданиеНаИнвентаризацию.АРМКладовщика
	|	И НЕ ЗаданиеНаИнвентаризацию.ПометкаУдаления
	|	И ЗаданиеНаИнвентаризацию.Проведен
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка,
	|	КодЯчейки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Ссылка,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ВТ.РегламентноеЗадание = ИСТИНА
	|				ТОГДА 1
	|			КОГДА ВТ.РегламентноеЗадание = ЛОЖЬ
	|					И ЗаданНаИнвентТовары.Уровень ЕСТЬ NULL
	|				ТОГДА 1
	|			ИНАЧЕ ЗаданНаИнвентТовары.Уровень
	|		КОНЕЦ) КАК Уровень
	|ПОМЕСТИТЬ ВТУровень
	|ИЗ
	|	ВТ КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаданиеНаИнвентаризацию.Товары КАК ЗаданНаИнвентТовары
	|		ПО ВТ.Ссылка = ЗаданНаИнвентТовары.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Ссылка,
	|	ВТ.НомерДокумента,
	|	ВТ.ДатаДокумента,
	|	ВТ.СсылкаЯчейки,
	|	ВТ.КодЯчейки,
	|	ВТ.Ответственный,
	|	ВТ.РегламентноеЗадание,
	|	ВТУровень.Уровень
	|ПОМЕСТИТЬ ВТ2
	|ИЗ
	|	ВТ КАК ВТ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТУровень КАК ВТУровень
	|		ПО ВТ.Ссылка = ВТУровень.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ2.Ссылка,
	|	ВТ2.НомерДокумента,
	|	ВТ2.ДатаДокумента,
	|	ВТ2.СсылкаЯчейки,
	|	ВТ2.КодЯчейки,
	|	ВЫБОР
	|		КОГДА БуферАРМКладовщикаСтатусИнвентЯчеек.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусЯчейкиИзЗаданияНаИнвентаризацию.НеНачат)
	|			ТОГДА 0
	|		КОГДА БуферАРМКладовщикаСтатусИнвентЯчеек.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусЯчейкиИзЗаданияНаИнвентаризацию.ВРаботе)
	|			ТОГДА 1
	|		КОГДА БуферАРМКладовщикаСтатусИнвентЯчеек.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусЯчейкиИзЗаданияНаИнвентаризацию.Завершено)
	|			ТОГДА 2
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СтатусРаботы,
	|	ВЫБОР
	|		КОГДА БуферАРМКладовщикаСтатусИнвентЯчеек.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусЯчейкиИзЗаданияНаИнвентаризацию.НеНачат)
	|			ТОГДА 1
	|		КОГДА БуферАРМКладовщикаСтатусИнвентЯчеек.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусЯчейкиИзЗаданияНаИнвентаризацию.ВРаботе)
	|			ТОГДА 0
	|		КОГДА БуферАРМКладовщикаСтатусИнвентЯчеек.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусЯчейкиИзЗаданияНаИнвентаризацию.Завершено)
	|			ТОГДА 2
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ПризнакСортировки,
	|	ВТ2.Уровень
	|ИЗ
	|	ВТ2 КАК ВТ2
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.БуферАРМКладовщикаСтатусИнвентЯчеек КАК БуферАРМКладовщикаСтатусИнвентЯчеек
	|		ПО ВТ2.Ссылка = БуферАРМКладовщикаСтатусИнвентЯчеек.Объект
	|			И ВТ2.СсылкаЯчейки = БуферАРМКладовщикаСтатусИнвентЯчеек.Ячейка
	|			И ВТ2.Ответственный = БуферАРМКладовщикаСтатусИнвентЯчеек.UserId";
	Запрос.УстановитьПараметр("Ответственный", UserIdСсылка);
	
	УстановитьПривилегированныйРежим(Истина);
	ТЗ = Запрос.Выполнить().Выгрузить();                 
	УстановитьПривилегированныйРежим(Ложь);
	
	МассивВременный = ТаблицуВМассив(ТЗ);
	Результат = ДанныеВJSONХранилище(МассивВременный);
	
	ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Получить список заданий на инвентаризацию", ""); 	
	
	Возврат Результат;
	
КонецФункции

Функция ДобавитьЗаписьВБуферИнвентаризации(ObjectGUID, GoodGUID, UserIdGUID, CreatedDate, Barcode, Quantity, CellGUID, PutIntoManual) Экспорт
	
	ОбъектСсылка = Документы.ЗаданиеНаИнвентаризацию.ПолучитьСсылку(Новый УникальныйИдентификатор(ObjectGUID));	
	НоменклатураСсылка = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(GoodGUID));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.КодПроизводителя
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", НоменклатураСсылка);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	РезультатЗапроса.Следующий();
	
	ЯчейкаСсылка = Справочники.Ячейки.ПолучитьСсылку( Новый УникальныйИдентификатор(CellGUID));
	
	Если UserIdGUID <> Неопределено И ЗначениеЗаполнено(UserIdGUID) Тогда
		UserIdСсылка = Справочники.ФизическиеЛица.ПолучитьСсылку( Новый УникальныйИдентификатор(UserIdGUID));				
	Иначе 
		UserIdСсылка = Справочники.ФизическиеЛица.ПустаяСсылка();			
	КонецЕсли;                                
	
	
	МЗ = РегистрыСведений.БуферАРМКладовщикаИнвентПоЯчейкам.СоздатьМенеджерЗаписи();	
	МЗ.Объект = ОбъектСсылка;
	МЗ.UserId = UserIdСсылка;                      		
	МЗ.Номенклатура = НоменклатураСсылка;		
	МЗ.Ячейка = ЯчейкаСсылка;	
	МЗ.CreateDate = CreatedDate;
	МЗ.Прочитать();
	
	Если МЗ.Выбран() Тогда
		
		МЗ.Quantity = МЗ.Quantity + Quantity;
		
		Если Не МЗ.ВведеноВРучную И PutIntoManual Тогда       
			МЗ.ВведеноВРучную = PutIntoManual;
		КонецЕсли; 
		
	Иначе
		
		МЗ.Объект = ОбъектСсылка;
		МЗ.UserId = UserIdСсылка;
		МЗ.CreateDate = CreatedDate;			
		МЗ.Ячейка = ЯчейкаСсылка;	
		МЗ.Номенклатура = НоменклатураСсылка; 		
		МЗ.Barcode = Barcode;
		МЗ.Quantity = Quantity;
		МЗ.КодПроизводителя = РезультатЗапроса.КодПроизводителя;		
		МЗ.ВведеноВРучную = PutIntoManual;
		
	КонецЕсли;	
	
	МЗ.Записать();                                                            
	// Установить статус ячейки
	МЗ = РегистрыСведений.БуферАРМКладовщикаСтатусИнвентЯчеек.СоздатьМенеджерЗаписи();	
	МЗ.Объект = ОбъектСсылка;
	МЗ.UserId = UserIdСсылка;                      		
	МЗ.Ячейка = ЯчейкаСсылка;	
	МЗ.Прочитать();
	МЗ.Статус = Перечисления.СтатусЯчейкиИзЗаданияНаИнвентаризацию.ВРаботе;
	МЗ.Записать();
	
	ARMStoreKeeper.ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "БуферАРМКладовщикаИнвентПоЯчейкам" , 
	"ЗаданиеНаИнвентаризацию " + Строка(ОбъектСсылка.Номер) + "Номенклатура " + НоменклатураСсылка.КодПроизводителя + ", " + НоменклатураСсылка);
	
	Возврат Истина;
	
КонецФункции

Функция ОбработатьГрузовоеМестоИзРазгрузкаАвто(DeliveryOrderGUID, DocumentGUID, CargoPlaceGUID, UserIdGUID, CreatedDate) Экспорт
	
	РазгрузкаАвтоСсылка = Документы.РазгрузкаАвто.ПолучитьСсылку(Новый УникальныйИдентификатор(DocumentGUID));
	ЗаданиеНаДоставкуСсылка = Документы.ЗаданиеНаДоставку.ПолучитьСсылку(Новый УникальныйИдентификатор(DeliveryOrderGUID));
	ГрузовоеМестоСсылка = Документы.ГрузовоеМесто.ПолучитьСсылку(Новый УникальныйИдентификатор(CargoPlaceGUID));
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);
	
	МЗ = РегистрыСведений.БуферАРМКладовщикаРазгрузкаАвто.СоздатьМенеджерЗаписи();	
	
	МЗ.ЗаданиеНаДоставку = ЗаданиеНаДоставкуСсылка;
	МЗ.Объект = РазгрузкаАвтоСсылка;
	МЗ.ГрузовоеМесто = ГрузовоеМестоСсылка;
	МЗ.UserId = UserIdСсылка;                      		
	МЗ.CreatedDate = CreatedDate;                                  
	
	МЗ.Записать();                                                            
	
	ARMStoreKeeper.ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "БуферАРМКладовщикаРазгрузкаАвто" , "РазгрузкаАвто " + РазгрузкаАвтоСсылка );
	
	Возврат Истина;
	
КонецФункции

Функция ПровестиДокументПТУТранзит(DocumentGUID, UserIdGUID, ComingDate, QuantityPlaces) Экспорт
	
	//+Кабанов А.В. 10.12.2024 # UT10-4950
	Результат = Новый Структура;
	Результат.Вставить("Ошибка", "");
	ЭтоДокументПТУ = Истина;
	
	ДокументПТУ = Документы.ПоступлениеТоваровУслуг.ПолучитьСсылку(Новый УникальныйИдентификатор(DocumentGUID));
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);
	
	Если ДокументПТУ.ПолучитьОбъект() = Неопределено Тогда
		
		ДокументПТУ = Документы.ПоступлениеТоваровНаОтветственноеХранение.ПолучитьСсылку(Новый УникальныйИдентификатор(DocumentGUID));
		ЭтоДокументПТУ = Ложь;
		
		Если ДокументПТУ.ПолучитьОбъект() = Неопределено Тогда
			
			ТекстОшибки = "Не найден документ ПТУ";				
			Результат.Вставить("Ошибка", ТекстОшибки);
			Результат.Вставить("КодРезультата", 1);
			Результат.Вставить("ЗначениеРезультата", "");
			Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
			Возврат Результат;
			
		КонецЕсли;
		
	КонецЕсли; 
	
	Если ДокументПТУ.ПометкаУдаления Тогда
		
		ТекстОшибки = ?(ЭтоДокументПТУ,"ПТУ ","Поступление ТОХ ") + ДокументПТУ + " помечен на удаление. Обработка невозможна";
		Результат.Вставить("Ошибка", ТекстОшибки);
		Результат.Вставить("КодРезультата", 0);
		Результат.Вставить("ЗначениеРезультата", "");
		Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
		Возврат Результат;
		
	КонецЕсли;
	
	Попытка
		
		ДокОбъект = ДокументПТУ.ПолучитьОбъект();

		Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПоступлениеТоваровУслуг") Тогда 
			
			Если ДокОбъект.ТранзитнаяПоставка И ЗначениеЗаполнено(ComingDate) И ЗначениеЗаполнено(QuantityPlaces) Тогда
				
				ДокОбъект.ДатаПриходаТовараНаСклад = ?(НачалоДня(ComingDate) = НачалоДня(ТекущаяДата()), ТекущаяДата(), КонецДня(ComingDate));
				ДокОбъект.КоличествоПринятыхМест   = QuantityPlaces;
				
			КонецЕсли;
			
		КонецЕсли;
		
		ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
	
		ТекСтатусПриемки = МСКWEB.ЗначениеДопСвойства(ДокОбъект.Ссылка,ПланыВидовХарактеристик.СвойстваОбъектов.СтатусПриемки); 
		
		Если ТекСтатусПриемки = Неопределено ИЛИ ТекСтатусПриемки = Перечисления.СтатусыПриемки.ВПути  Тогда
			
			Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПоступлениеТоваровУслуг") И ДокОбъект.ТранзитнаяПоставка И  ДокОбъект.Статус = Перечисления.СтатусыПТУ.КПоступлению Тогда 
				
				РезультатЗапроса = МСКWEB.ИзменитьСтатусПТУВУТ11(ДокОбъект.ИДДокументаВСмежнойБазе, Перечисления.СтатусыПТУ.ВРаботе, 
				                   ДокОбъект.ДатаПриходаТовараНаСклад, ДокОбъект.КоличествоПринятыхМест); 
				
				Если РезультатЗапроса.Результат Тогда
					
					ДокОбъект.Статус = Перечисления.СтатусыПТУ.ВРаботе;					
					
				Иначе
					
					ТекстОшибки = "Не удалось передать статус транзита в УТ 11 по " + ДокОбъект.Ссылка + ". Повторите попытку."; 
					
					ЗаписьЖурналаРегистрации("Транзитные поставки.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, "Ошибка передачи статуса UT11_SetStatusPTU по " 
					+ ТекстОшибки + Символы.ПС + СокрЛП(РезультатЗапроса.ТекстОшибки));

					Результат.Вставить("Ошибка", ТекстОшибки);
					Результат.Вставить("КодРезультата", 0);
					Результат.Вставить("ЗначениеРезультата", "");
					Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
					Возврат Результат;
					
				КонецЕсли;
				
			КонецЕсли;
			
			//+Белов А. 01.06.2026 #UT10-5893
			Если ЭтоДокументПТУ Тогда

				Если Константы.ПроверкаПТУВЧЗ.Получить() И Документы.ПоступлениеТоваровУслуг.НужнаПроверкаВЧЗ(ДокОбъект.Ссылка) Тогда
					МСКWEB.УстановитьЗначениеДопСвойства(ДокОбъект.Ссылка, ПланыВидовХарактеристик.СвойстваОбъектов.СтатусПриемки, Перечисления.СтатусыПриемки.НаПроверкеВЧЗ);					
				Иначе
					МСКWEB.УстановитьЗначениеДопСвойства(ДокОбъект.Ссылка, ПланыВидовХарактеристик.СвойстваОбъектов.СтатусПриемки, Перечисления.СтатусыПриемки.ПоступилНаСклад);
				КонецЕсли;
				
			Иначе	
				//-Белов А. 01.06.2026 #UT10-5893
				МСКWEB.УстановитьЗначениеДопСвойства(ДокОбъект.Ссылка, ПланыВидовХарактеристик.СвойстваОбъектов.СтатусПриемки, Перечисления.СтатусыПриемки.ПоступилНаСклад); 
			КонецЕсли;
			
		КонецЕсли;
		
		ДокОбъект.Комментарий = СокрЛП(ДокОбъект.Комментарий) + " Проведен с ТСД " + СокрЛП(UserIdСсылка.Наименование) + " " + Формат(ТекущаяДата(), "ДЛФ=") + ".";
		
        УстановитьПривилегированныйРежим(Истина);
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		УстановитьПривилегированныйРежим(Ложь);

		ТекВремяПоступления = МСКWEB.ЗначениеДопСвойства(ДокОбъект.Ссылка,ПланыВидовХарактеристик.СвойстваОбъектов.ВремяПоступления); 
		
		Если ТекВремяПоступления = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ТекВремяПоступления)  Тогда
			МСКWEB.УстановитьЗначениеДопСвойства(ДокОбъект.Ссылка, ПланыВидовХарактеристик.СвойстваОбъектов.ВремяПоступления, ТекущаяДата());
		КонецЕсли;

	Исключение      
		
		ТекстОшибки = ?(ЭтоДокументПТУ, "ПТУ ", "Поступление ТОХ ") + ДокументПТУ + " невозможно записать. Обработка невозможна.";				
		Результат.Вставить("Ошибка", ТекстОшибки);
		Результат.Вставить("КодРезультата", 2);
		Результат.Вставить("ЗначениеРезультата", "");
		Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
		Возврат Результат;
		
	КонецПопытки; 
	
	Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
	Возврат Результат;

	//-Кабанов А.В. 10.12.2024 # UT10-4950
КонецФункции

Функция ПровестиДокументПТУ(DocumentGUID, UserIdGUID) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Ошибка", "");
	ЭтоДокументПТУ = Истина;
	
	ДокументПТУ = Документы.ПоступлениеТоваровУслуг.ПолучитьСсылку(Новый УникальныйИдентификатор(DocumentGUID));
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);
	
	Если ДокументПТУ.ПолучитьОбъект() = Неопределено Тогда
		
		ДокументПТУ = Документы.ПоступлениеТоваровНаОтветственноеХранение.ПолучитьСсылку(Новый УникальныйИдентификатор(DocumentGUID));
		ЭтоДокументПТУ = Ложь;
		
		Если ДокументПТУ.ПолучитьОбъект() = Неопределено Тогда
			
			ТекстОшибки = "Не найден документ ПТУ";				
			Результат.Вставить("Ошибка", ТекстОшибки);
			Результат.Вставить("КодРезультата", 1);
			Результат.Вставить("ЗначениеРезультата", "");
			Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
			Возврат Результат;
			
		КонецЕсли;
		
	КонецЕсли; 
	
	Если ДокументПТУ.ПометкаУдаления Тогда
		
		ТекстОшибки = ?(ЭтоДокументПТУ,"ПТУ ","Поступление ТОХ ") + ДокументПТУ + " помечен на удаление. Обработка невозможна";
		Результат.Вставить("Ошибка", ТекстОшибки);
		Результат.Вставить("КодРезультата", 0);
		Результат.Вставить("ЗначениеРезультата", "");
		Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
		Возврат Результат;
		
	КонецЕсли;
	
	Попытка
		
		ДокОбъект = ДокументПТУ.ПолучитьОбъект();
		ДокОбъект.Комментарий = СокрЛП(ДокОбъект.Комментарий)+" Проведен с ТСД "+СокрЛП(UserIdСсылка.Наименование) +" "+Формат(ТекущаяДата(),"ДЛФ=")+".";
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		
		//+Кабанов А.В. 13.11.2024 # UT10-4873
		ТекСтатусПриемки = МСКWEB.ЗначениеДопСвойства(ДокОбъект.Ссылка, ПланыВидовХарактеристик.СвойстваОбъектов.СтатусПриемки); 
		
		Если ТекСтатусПриемки = Неопределено ИЛИ ТекСтатусПриемки = Перечисления.СтатусыПриемки.ВПути Тогда
			МСКWEB.УстановитьЗначениеДопСвойства(ДокОбъект.Ссылка, ПланыВидовХарактеристик.СвойстваОбъектов.СтатусПриемки, Перечисления.СтатусыПриемки.ПоступилНаСклад);			
		КонецЕсли;
		//-Кабанов А.В. 13.11.2024 # UT10-4873
		
		//+Кабанов А.В. 03.12.2024 # UT10-4948
		ТекВремяПоступления = МСКWEB.ЗначениеДопСвойства(ДокОбъект.Ссылка,ПланыВидовХарактеристик.СвойстваОбъектов.ВремяПоступления); 
		
		Если ТекВремяПоступления = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ТекВремяПоступления)  Тогда
			МСКWEB.УстановитьЗначениеДопСвойства(ДокОбъект.Ссылка, ПланыВидовХарактеристик.СвойстваОбъектов.ВремяПоступления, ТекущаяДата());
		КонецЕсли;
		//-Кабанов А.В. 03.12.2024 # UT10-4948

	Исключение      
		
		ТекстОшибки = ?(ЭтоДокументПТУ,"ПТУ ","Поступление ТОХ ")+ ДокументПТУ + " невозможно записать. Обработка невозможна.";				
		Результат.Вставить("Ошибка", ТекстОшибки);
		Результат.Вставить("КодРезультата", 2);
		Результат.Вставить("ЗначениеРезультата", "");
		Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
		Возврат Результат;
		
	КонецПопытки; 
	
	Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
	Возврат Результат;
	
КонецФункции

Функция ОбработатьГрузовоеМестоИзРазгрузкаАвтоДляПостановкиНаМаршрут(DeliveryOrderGUID, UnloadAutoGUID, CargoPlaceGUID, UserIdGUID, CreatedDate) Экспорт
	
	ЗаданиеНаДоставкуСсылка = Документы.ЗаданиеНаДоставку.ПолучитьСсылку(Новый УникальныйИдентификатор(DeliveryOrderGUID));
	РазгрузкаАвтоСсылка = Документы.РазгрузкаАвто.ПолучитьСсылку(Новый УникальныйИдентификатор(UnloadAutoGUID));	
	ГрузовоеМестоСсылка = Документы.ГрузовоеМесто.ПолучитьСсылку(Новый УникальныйИдентификатор(CargoPlaceGUID));
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);
	
	МЗ = РегистрыСведений.БуферАРМКладовщикаПостановкаГрузовыхМестНаМаршрут.СоздатьМенеджерЗаписи();	
	
	МЗ.ЗаданиеНаДоставку = ЗаданиеНаДоставкуСсылка;
	МЗ.РазгрузкаАвто     = РазгрузкаАвтоСсылка;
	МЗ.ГрузовоеМесто     = ГрузовоеМестоСсылка;
	МЗ.UserId            = UserIdСсылка;                      		
	МЗ.DateCreated       = CreatedDate;
	
	МЗ.Записать();                                                            
	
	ARMStoreKeeper.ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "БуферАРМКладовщикаПостановкаГрузовыхМестНаМаршрут", "РазгрузкаАвто " + РазгрузкаАвтоСсылка );
	
	Возврат Истина;
	
КонецФункции

Функция ЗавершитьРазгрузкуГрузовыхМестИзРазгрузкаАвто(DeliveryOrderGUID, UserIdGUID, StoreKeeperGUID) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Ошибка", "");
	
	ЗаданиеНаДоставкуСсылка = Документы.ЗаданиеНаДоставку.ПолучитьСсылку(Новый УникальныйИдентификатор(DeliveryOrderGUID));
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);
	КладовщикСсылка = ПолучитьПользователя(StoreKeeperGUID);
	
	НачатьТранзакцию();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РазгрузкаАвтоГрузовыеМеста.Ссылка КАК Ссылка,
	|	РазгрузкаАвтоГрузовыеМеста.НомерСтроки,
	|	РазгрузкаАвтоГрузовыеМеста.ГрузовоеМесто,
	|	РазгрузкаАвтоГрузовыеМеста.ДатаПереноса,
	|	РазгрузкаАвтоГрузовыеМеста.РТУ,	
	|	ВЫБОР
	|		КОГДА БуферАРМКладовщикаРазгрузкаАвто.ГрузовоеМесто ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ПереданоНаСклад,
	|	РазгрузкаАвтоГрузовыеМеста.ПринятоСкладом
	|ИЗ
	|	Документ.РазгрузкаАвто.ГрузовыеМеста КАК РазгрузкаАвтоГрузовыеМеста
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.БуферАРМКладовщикаРазгрузкаАвто КАК БуферАРМКладовщикаРазгрузкаАвто
	|		ПО РазгрузкаАвтоГрузовыеМеста.Ссылка = БуферАРМКладовщикаРазгрузкаАвто.Объект
	|			И РазгрузкаАвтоГрузовыеМеста.ГрузовоеМесто = БуферАРМКладовщикаРазгрузкаАвто.ГрузовоеМесто
	|			И РазгрузкаАвтоГрузовыеМеста.Ссылка.Водитель = БуферАРМКладовщикаРазгрузкаАвто.UserId
	|ГДЕ
	|	РазгрузкаАвтоГрузовыеМеста.Ссылка.ЗаданиеНаДоставку = &ЗаданиеНаДоставку
	|	И РазгрузкаАвтоГрузовыеМеста.Ссылка.Водитель = &Водитель
	|	И РазгрузкаАвтоГрузовыеМеста.Ссылка.Проведен
	|	И РазгрузкаАвтоГрузовыеМеста.Ссылка.ГМПринял = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
	|
	|ДЛЯ ИЗМЕНЕНИЯ
	|	Документ.РазгрузкаАвто,
	|	РегистрСведений.БуферАРМКладовщикаРазгрузкаАвто
	|ИТОГИ ПО
	|	Ссылка";
	
	Запрос.УстановитьПараметр("ЗаданиеНаДоставку", ЗаданиеНаДоставкуСсылка);
	Запрос.УстановитьПараметр("Водитель", UserIdСсылка);
	
	ВыборкаРазгрузкаАвто = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Попытка
		
		Пока ВыборкаРазгрузкаАвто.Следующий() Цикл
			
			РазгрузкаАвтоСсылка = ВыборкаРазгрузкаАвто.Ссылка;
			РазгрузкаАвтоОбъект = РазгрузкаАвтоСсылка.ПолучитьОбъект();
			РазгрузкаАвтоОбъект.ГМПринял = КладовщикСсылка;
			
			РазгрузкаАвтоОбъект.ГрузовыеМеста.Очистить();
			
			ВыборкаГрузовыеМеста = ВыборкаРазгрузкаАвто.Выбрать();
			
			Пока ВыборкаГрузовыеМеста.Следующий() Цикл
				
				Запись = РазгрузкаАвтоОбъект.ГрузовыеМеста.Добавить();
				ЗаполнитьЗначенияСвойств(Запись, ВыборкаГрузовыеМеста);
				
			КонецЦикла; 
			
			РазгрузкаАвтоОбъект.Записать();
			ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Записан документ разгрузка авто (Передано на склад водителем)", Строка(РазгрузкаАвтоОбъект.Номер)); 			
			
			РазгрузкаАвтоОбъект.Записать(РежимЗаписиДокумента.Проведение);
			ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Проведен документ разгрузка авто (Передано на склад водителем)", Строка(РазгрузкаАвтоОбъект.Номер)); 			
			
			РС = РегистрыСведений.БуферАРМКладовщикаРазгрузкаАвто.СоздатьНаборЗаписей();
			РС.Отбор.ЗаданиеНаДоставку.Установить(ЗаданиеНаДоставкуСсылка);
			РС.Отбор.UserId.Установить(UserIdСсылка);
			РС.Отбор.Объект.Установить(РазгрузкаАвтоСсылка);
			РС.Записать();			
			
		КонецЦикла; 	
		
		ЗафиксироватьТранзакцию();
		Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
		Возврат Результат;
		
	Исключение
		
		ОтменитьТранзакцию();					
		ТекстОшибки = "Ошибка при записи/проведение документа в 1С: " + ЗаданиеНаДоставкуСсылка + " " + ОписаниеОшибки() + ".";				
		ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", ТекстОшибки, Строка(РазгрузкаАвтоОбъект.Номер)); 			
		
		Результат.Вставить("Ошибка", ТекстОшибки);
		Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
		Возврат Результат;
		
	КонецПопытки; 
	
КонецФункции

Функция ЗавершитьРазгрузкуГрузовыхМестИзРазгрузкаАвтоДляПостановкиНаМаршрут(DeliveryOrderGUID, UserIdGUID) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Ошибка", "");
	
	ЗаданиеНаДоставкуСсылка = Документы.ЗаданиеНаДоставку.ПолучитьСсылку(Новый УникальныйИдентификатор(DeliveryOrderGUID));
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);
	
	//+Гавриленков В. 05.04.2025 #UT10-5178 В запрос добавлено поле DateCreated
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РазгрузкаАвтоГрузовыеМеста.Ссылка КАК Ссылка,
	|	РазгрузкаАвтоГрузовыеМеста.НомерСтроки,
	|	РазгрузкаАвтоГрузовыеМеста.ГрузовоеМесто,
	|	РазгрузкаАвтоГрузовыеМеста.ДатаПереноса,
	|	ВЫБОР
	|		КОГДА БуферАРМКладовщикаПостановкаГрузовыхМестНаМаршрут.ГрузовоеМесто ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ПринятоСкладом,
	|	РазгрузкаАвтоГрузовыеМеста.ПереданоНаСклад,
	|	РазгрузкаАвтоГрузовыеМеста.РТУ,
	|	ЕСТЬNULL(БуферАРМКладовщикаПостановкаГрузовыхМестНаМаршрут.DateCreated, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаПринятияСкладом
	|ИЗ
	|	Документ.РазгрузкаАвто.ГрузовыеМеста КАК РазгрузкаАвтоГрузовыеМеста
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.БуферАРМКладовщикаПостановкаГрузовыхМестНаМаршрут КАК БуферАРМКладовщикаПостановкаГрузовыхМестНаМаршрут
	|		ПО РазгрузкаАвтоГрузовыеМеста.ГрузовоеМесто = БуферАРМКладовщикаПостановкаГрузовыхМестНаМаршрут.ГрузовоеМесто
	|			И РазгрузкаАвтоГрузовыеМеста.Ссылка = БуферАРМКладовщикаПостановкаГрузовыхМестНаМаршрут.РазгрузкаАвто
	|			И РазгрузкаАвтоГрузовыеМеста.Ссылка.ЗаданиеНаДоставку = БуферАРМКладовщикаПостановкаГрузовыхМестНаМаршрут.ЗаданиеНаДоставку
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.БуферАРККладовщикаБлокировкаМаршрутаЗаданияНаДоставку КАК БуферАРККладовщикаБлокировкаМаршрутаЗаданияНаДоставку
	|		ПО РазгрузкаАвтоГрузовыеМеста.Ссылка = БуферАРККладовщикаБлокировкаМаршрутаЗаданияНаДоставку.РазгрузкаАвто
	|			И РазгрузкаАвтоГрузовыеМеста.Ссылка.ЗаданиеНаДоставку = БуферАРККладовщикаБлокировкаМаршрутаЗаданияНаДоставку.ЗаданиеНаДоставку
	|ГДЕ
	|	РазгрузкаАвтоГрузовыеМеста.Ссылка.ЗаданиеНаДоставку = &ЗаданиеНаДоставку
	|	И БуферАРККладовщикаБлокировкаМаршрутаЗаданияНаДоставку.UserIdCode = &Водитель
	|
	|ДЛЯ ИЗМЕНЕНИЯ
	|	Документ.РазгрузкаАвто
	|ИТОГИ ПО
	|	Ссылка";
	
	Запрос.УстановитьПараметр("ЗаданиеНаДоставку", ЗаданиеНаДоставкуСсылка);
	Запрос.УстановитьПараметр("Водитель", UserIdСсылка);
	
	ВыборкаРазгрузкаАвто = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Попытка
		
		Пока ВыборкаРазгрузкаАвто.Следующий() Цикл
			
			НачатьТранзакцию();
			
			РазгрузкаАвтоСсылка = ВыборкаРазгрузкаАвто.Ссылка;
			РазгрузкаАвтоОбъект = РазгрузкаАвтоСсылка.ПолучитьОбъект();
			РазгрузкаАвтоОбъект.ГМПоложилНаМаршрут = UserIdСсылка;
			
			РазгрузкаАвтоОбъект.ГрузовыеМеста.Очистить();
			
			ВыборкаГрузовыеМеста = ВыборкаРазгрузкаАвто.Выбрать();
			
			Пока ВыборкаГрузовыеМеста.Следующий() Цикл
				
				Запись = РазгрузкаАвтоОбъект.ГрузовыеМеста.Добавить();				
				ЗаполнитьЗначенияСвойств(Запись, ВыборкаГрузовыеМеста);
				
			КонецЦикла; 
			
			РазгрузкаАвтоОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			РазгрузкаАвтоОбъект.Записать();
			ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Записан документ разгрузка авто (Положено на маршрут кладовщиком)", Строка(РазгрузкаАвтоОбъект.Номер)); 			
			
			РС = РегистрыСведений.БуферАРМКладовщикаПостановкаГрузовыхМестНаМаршрут.СоздатьНаборЗаписей();
			РС.Отбор.ЗаданиеНаДоставку.Установить(ЗаданиеНаДоставкуСсылка);
			РС.Отбор.UserId.Установить(UserIdСсылка);
			РС.Отбор.РазгрузкаАвто.Установить(РазгрузкаАвтоСсылка);
			РС.Записать();			
			
			
			РС = РегистрыСведений.БуферАРККладовщикаБлокировкаМаршрутаЗаданияНаДоставку.СоздатьНаборЗаписей();
			РС.Отбор.ЗаданиеНаДоставку.Установить(ЗаданиеНаДоставкуСсылка);
			РС.Отбор.РазгрузкаАвто.Установить(РазгрузкаАвтоСсылка);
			РС.Отбор.UserIdCode.Установить(UserIdСсылка);
			РС.Записать();			
			
			ЗафиксироватьТранзакцию();
			
			/// Запись и проведение документа в раздельных транзакций
			НачатьТранзакцию();
			РазгрузкаАвтоОбъект.Записать(РежимЗаписиДокумента.Проведение);
			ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Проведен документ разгрузка авто (Положено на маршрут кладовщиком)", Строка(РазгрузкаАвтоОбъект.Номер)); 			
			ЗафиксироватьТранзакцию();
			/// Запись и проведение документа в раздельных транзакций
			
		КонецЦикла; 	
		
		Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
		Возврат Результат;
		
	Исключение
		
		ОтменитьТранзакцию();					
		ТекстОшибки = "Ошибка при записи/проведение документа в 1С: " + ЗаданиеНаДоставкуСсылка + " " + ОписаниеОшибки() + ".";				
		ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", ТекстОшибки, Строка(РазгрузкаАвтоОбъект.Номер)); 			
		
		Результат.Вставить("Ошибка", ТекстОшибки);
		Результат = ARMStoreKeeper.ДанныеВJSONХранилище(Результат);
		Возврат Результат;
		
	КонецПопытки; 
	
КонецФункции

Функция УстановитьСтатусИнвентаризируемойЯчейки(UserIdGUID, DocumentGUID, CellGUID, StatusId) Экспорт
	
	ОбъектСсылка = Документы.ЗаданиеНаИнвентаризацию.ПолучитьСсылку(Новый УникальныйИдентификатор(DocumentGUID));	
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);		
	ЯчейкаСсылка = Справочники.Ячейки.ПолучитьСсылку( Новый УникальныйИдентификатор(CellGUID));
	
	МЗ = РегистрыСведений.БуферАРМКладовщикаСтатусИнвентЯчеек.СоздатьМенеджерЗаписи();	
	МЗ.Объект = ОбъектСсылка;
	МЗ.UserId = UserIdСсылка;                      		
	МЗ.Ячейка = ЯчейкаСсылка;	
	МЗ.Прочитать();
	
	ИмяПеречисления = Метаданные.Перечисления["СтатусЯчейкиИзЗаданияНаИнвентаризацию"].ЗначенияПеречисления[StatusId].Имя;
	МЗ.Статус = Перечисления["СтатусЯчейкиИзЗаданияНаИнвентаризацию"][ИмяПеречисления];
	
	МЗ.CreateDate = ТекущаяДата();
	МЗ.Записать();
	
	ARMStoreKeeper.ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "УстановитьСтатусИнвентаризируемойЯчейки" , 
	"ЗаданиеНаИнвентаризацию " + Строка(ОбъектСсылка.Номер) + " ячейка " + ЯчейкаСсылка + " статус " + МЗ.Статус);
	
	Результат = Истина;
	
	Возврат Результат;                  
	
КонецФункции

Функция ТаблицуВМассив(Таблица) Экспорт
	
	МассивДанных = Новый Массив;                                            
	
	Для каждого ТекСтрока Из Таблица Цикл
		
		СтруктураДанных = Новый Структура;
		
		Для каждого Колонка ИЗ Таблица.Колонки Цикл			
			
			Если Колонка.Имя = "СсылкаПТУ" Или Колонка.Имя = "СсылкаТовара"  Или Колонка.Имя = "СсылкаЯчейки" Или Колонка.Имя = "СсылкаЯчейкиКуда" 
				Или Колонка.Имя = "Владелец" Или Колонка.Имя = "Объект" Или Колонка.Имя = "ГрузовоеМестоГУИД" Или Колонка.Имя = "ДокументПТУСсылка"
				Или Колонка.Имя = "Документ" Или Колонка.Имя = "Ссылка" Или Колонка.Имя = "ГрузополучательГУИД" Или Колонка.Имя = "РазгрузкаАвтоГУИД"
				Или Колонка.Имя = "ЗаданиеНаДоставкуГУИД" Или Колонка.Имя = "ФизическоеЛицоГУИД" Или Колонка.Имя = "МаршрутГУИД" Или Колонка.Имя = "СборкаГУИД"
				Или Колонка.Имя = "ЯчейкаГУИД"
				ИЛИ Колонка.Имя = "ЕдиницаИзмеренияСсылка"
				Или Колонка.Имя = "СсылкаСлужебнаяЗаписка" 
				Или Колонка.Имя = "СсылкаОбъединение"
				//+Кабанов А.В. 03.09.2025 # UT10-5361
				ИЛИ Колонка.Имя = "КодМаркировки"
				//-Кабанов А.В. 03.09.2025 # UT10-5361
				Тогда
				
				Попытка
					СтруктураДанных.Вставить(Колонка.Имя, Строка(ТекСтрока[Колонка.Имя].УникальныйИдентификатор()));	
				Исключение
					СтруктураДанных.Вставить(Колонка.Имя, ТекСтрока[Колонка.Имя]);    
				КонецПопытки; 				
				
			Иначе
				СтруктураДанных.Вставить(Колонка.Имя, ТекСтрока[Колонка.Имя]);				
			КонецЕсли; 
			
		КонецЦикла;
		
		МассивДанных.Добавить(СтруктураДанных);
		
	КонецЦикла;         
	
	Возврат МассивДанных;
	
КонецФункции

