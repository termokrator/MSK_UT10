Функция ПолучитьСписокЗаписейИзБуфераПеремещения(UserIdGUID, FromCellIdGUID, WhereCellGUID) Экспорт
	
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);	
	
	Если ЗначениеЗаполнено(FromCellIdGUID) Тогда
		ЯчейкаОткуда = Справочники.Ячейки.ПолучитьСсылку( Новый УникальныйИдентификатор(FromCellIdGUID));	
	Иначе 
		ЯчейкаОткуда = Справочники.Ячейки.ПустаяСсылка();
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(WhereCellGUID) Тогда
		ЯчейкаКуда = Справочники.Ячейки.ПолучитьСсылку( Новый УникальныйИдентификатор(WhereCellGUID));	
	Иначе
		ЯчейкаКуда = Справочники.Ячейки.ПустаяСсылка();	
	КонецЕсли; 
	
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	БуферАРМКладовшикаПеремещение.Номенклатура КАК СсылкаТовара,
	|	ЕСТЬNULL(НоменклатураСпр.Родитель.Наименование, """") КАК Производитель,
	|	НоменклатураСпр.Наименование КАК НаименованиеТовара,
	|	БуферАРМКладовшикаПеремещение.КодПроизводителя КАК КодПроизводителяТовара,
	|	БуферАРМКладовшикаПеремещение.ЯчейкаОткуда.Код КАК ЯчейкаОткуда,
	|	БуферАРМКладовшикаПеремещение.ЯчейкаКуда.Код КАК ЯчейкаКуда,
	|	СУММА(БуферАРМКладовшикаПеремещение.Quantity) КАК КоличествоТовара,
	|	ЕСТЬNULL(НоменклатураСпр.ГруппаАВСФилиала.Наименование, ""Е"") КАК ГруппаАВСФилиала
	|ИЗ
	|	РегистрСведений.БуферАРМКладовшикаПеремещение КАК БуферАРМКладовшикаПеремещение
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК НоменклатураСпр
	|		ПО БуферАРМКладовшикаПеремещение.Номенклатура = НоменклатураСпр.Ссылка
	|ГДЕ
	|	БуферАРМКладовшикаПеремещение.UserId = &UserId
	|	И (&ИспользоватьПоискПоЯчейкам
	|				И БуферАРМКладовшикаПеремещение.ЯчейкаОткуда = &ЯчейкаОткуда
	|				И БуферАРМКладовшикаПеремещение.ЯчейкаКуда = &ЯчейкаКуда
	|			ИЛИ НЕ &ИспользоватьПоискПоЯчейкам)
	|
	|СГРУППИРОВАТЬ ПО
	|	БуферАРМКладовшикаПеремещение.Номенклатура,
	|	НоменклатураСпр.Наименование,
	|	БуферАРМКладовшикаПеремещение.КодПроизводителя,
	|	НоменклатураСпр.Родитель.Наименование,
	|	БуферАРМКладовшикаПеремещение.ЯчейкаОткуда,
	|	БуферАРМКладовшикаПеремещение.ЯчейкаКуда,
	|	БуферАРМКладовшикаПеремещение.ЯчейкаОткуда.Код,
	|	БуферАРМКладовшикаПеремещение.ЯчейкаКуда.Код,
	|	ЕСТЬNULL(НоменклатураСпр.ГруппаАВСФилиала.Наименование, ""Е"")"; 
	
	
	ИспользоватьПоискПоЯчейкам = Ложь;
	
	Если ЗначениеЗаполнено(FromCellIdGUID) Или  ЗначениеЗаполнено(WhereCellGUID) Тогда
		ИспользоватьПоискПоЯчейкам = Истина;
	КонецЕсли; 
	
	Запрос.УстановитьПараметр("ИспользоватьПоискПоЯчейкам", ИспользоватьПоискПоЯчейкам);
	Запрос.УстановитьПараметр("UserId", UserIdСсылка);
	Запрос.УстановитьПараметр("ЯчейкаОткуда", ЯчейкаОткуда);	
	Запрос.УстановитьПараметр("ЯчейкаКуда", ЯчейкаКуда);	
	
	УстановитьПривилегированныйРежим(Истина);	                                                  
	ТЗ = Запрос.Выполнить().Выгрузить();	
	УстановитьПривилегированныйРежим(Ложь);
	
	МассивВременный = ТаблицуВМассив(ТЗ);
	Результат = ДанныеВJSONХранилище(МассивВременный);
	
	Если ЯчейкаКуда = Справочники.Ячейки.ПустаяСсылка() Тогда
		ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Открыть форму перемещения товара", ""); 			
	Иначе		
		ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Получить список записей из буфера перемещения", "ЯчейкаОткуда -> " + ЯчейкаОткуда.Код + " ЯчейкаКуда -> " + ЯчейкаКуда.Код); 	
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции

Функция SendLogsFromTSD(UserIdGUID, Logs) Экспорт
	
	UserIdСсылка = ПолучитьПользователя(UserIdGUID);	
	РегСведНабор = РегистрыСведений.ЛогАРМКладовщикаИзТСД.СоздатьНаборЗаписей();
	
	СписокДанных = ХранилищеJSONВСтруктуру(Logs);	
	Номер = 0;
	
	Для каждого Данные Из СписокДанных Цикл                          
		
		НоваяЗапись = РегСведНабор.Добавить();			
		ЗаполнитьЗначенияСвойств(НоваяЗапись, Данные);		
		
		НоваяЗапись.ДатаЛогаТСД = Строка(Данные.ДатаСоздания);
		НоваяЗапись.ДатаЗагрузки = ТекущаяДата();      
		
		//+Шульман А. 05.12.2025 #UT10-5576    
		Если Данные.Свойство("НомерЗаписи") Тогда
			НоваяЗапись.Номер = Данные.НомерЗаписи;  
		//-Шульман А. 05.12.2025 #UT10-5576
		Иначе
			
			Номер = Номер + 1;
			НоваяЗапись.Номер = Номер;   
			
		КонецЕсли;
		
		НоваяЗапись.UserId = UserIdСсылка;
		
	КонецЦикла; 
	
	РегСведНабор.Записать(Ложь);
	
	ЗаписатьЛог(UserIdСсылка, ТекущаяДата(), "", "Записать логи из ТСД в РС", ""); 	
	
	Возврат Истина;
	
КонецФункции

Функция GetDescriptionForMoving(UserIdGUID, FromCellIdGUID, WhereCellIdGUID) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 100
	|	ТоварыВЯчейкахОбороты.Склад,
	|	ТоварыВЯчейкахОбороты.Номенклатура КАК Номенклатура,
	|	ТоварыВЯчейкахОбороты.Ячейка,
