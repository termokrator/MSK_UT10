Функция ОтправитьЗаказВАвардуПострочно(Заказ)  Экспорт
	
	Если Константы.ОтправлятьЗаказыПоСтороннимСкладамВУТ11.Получить() Тогда
		
		ОтправкаВыполнена = ОтправкаЗаказаВУТ11(Заказ, "СторонниеСклады");
		Возврат ОтправкаВыполнена;

	КонецЕсли;
	
	НомерПоследнейОтправляемойСтроки = 0;
	КоличествоСтрокТоваров = Заказ.Товары.Количество();

	Для к = 1 По КоличествоСтрокТоваров Цикл
		
		ТекущаяСтрока = Заказ.Товары[КоличествоСтрокТоваров - к];
		
		Если ТекущаяСтрока.УспешноОтправленаВАварду = Ложь Тогда 
			
			НомерПоследнейОтправляемойСтроки = ТекущаяСтрока.НомерСтроки;
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Подключение = Неопределено;
	RS = Неопределено;
	ОписаниеТиповСтрока = новый ОписаниеТипов("строка", новый квалификаторыстроки(80, ДопустимаяДлина.Переменная));
	ОписаниеТиповДата = новый ОписаниеТипов("Дата", новый квалификаторыДаты(ЧастиДаты.Дата));
	ОписаниеТиповЧисло = новый ОписаниеТипов("число", новый квалификаторычисла(12));
	
	Подключение = Новый COMObject("ADODB.Connection");
	КодДоговора = Константы.КодДоговораСторонниеСклады.Получить();
	ЗаказОб = Заказ.ПолучитьОбъект();
	
	Если Константы.СамовывозУдаленныхСкладов.Получить() тогда
		Доставка = "0";
	Иначе
		Доставка = "1";
	КонецЕсли;
	
	ОтправлятьВАварду = Истина;
	
	Если Константы.ВыборочнаяОтправкаЗаказовСторСкладовВУТ11.Получить() Тогда
		
		Если Заказ.IDСклада.ОтправлятьЗаказыПоСкладуВУТ11 Тогда
			ОтправлятьВАварду = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	ФлагОтправки = Истина;
	
	Если ОтправлятьВАварду Тогда
		
		Если Соединение(Подключение) И ЗначениеЗаполнено(КодДоговора) Тогда 
			
			Подключение.BeginTrans();
			Запросadd="SELECT GETBIT1(RESULT,0) as RES, RESULT, IDDOC, MSG FROM RA_CREATE_161104656_HEAD_SH(" + КодДоговора + ")"; 
			
			РСТ = СформироватьЗапрос(Запросadd, Подключение);
			
			Если РСТ = Неопределено Тогда
				
				ЗаписьЖурналаРегистрации("Выгрузка заказа поставщику в Аварду",УровеньЖурналаРегистрации.Ошибка,,,"Ошибка выгрузки заказа поставщику " + Запросadd);
				
				СоздатьОповещениеОбОшибкеОтправкиВАварду("Выгрузка заказа поставщику в Аварду",
				"Ошибка выгрузки заказа поставщику " + Запросadd,Заказ);
				
				Сообщить ("Ошибка выгрузки документа");
				
			Иначе	
				
				Если РСТ.EOF() = 0 Тогда
					
					Если РСТ.Fields("RES").Value = 1 тогда
						
						ИД = РСТ.Fields("IDDOC").Value;
						Сч = 0;
						
						Если Не ЗначениеЗаполнено(Заказ.IDСклада) тогда
							
							ЗаписьЖурналаРегистрации("Выгрузка заказа поставщику в Аварду", УровеньЖурналаРегистрации.Ошибка,,, "Не заполнен ID склада " + Заказ);
							
							СоздатьОповещениеОбИзмененииДляСтороннихСкладов("Выгрузка заказа поставщику в Аварду",
							"Ошибка выгрузки заказа поставщику в Аварда. строки заказа поставщику. Не заполнен ID склада ", Заказ);
							
							СоздатьОповещениеОбОшибкеОтправкиВАварду("Выгрузка заказа поставщику в Аварду",
							"Ошибка выгрузки заказа поставщику в Аварда. строки заказа поставщику. Не заполнен ID склада ", Заказ);
							
							Сообщить ("Ошибка выгрузки документа " + Заказ + " Не заполнен ID склада");
							Подключение.RollbackTrans();
							ФлагОтправки = Ложь;
							
						КонецЕсли;
						
						Если не ФлагОтправки = Ложь Тогда 
							
							Коэф = Заказ.IDСклада.КоэффициентЗакупки;
							
							Для Каждого строка из ЗаказОб.Товары Цикл
								
								Сч = Сч + 1;
								
								Если Строка.УспешноОтправленаВАварду Тогда 
									Продолжить;
								КонецЕсли;
																
								Если ЗначениеЗаполнено(строка.УИД) Тогда
									УИД = Заказ.Номер + "/" + Формат(Заказ.Дата, "ДЛФ=Д") + "/" + ФорматироватьСтроку(строка.УИД); 
								Иначе
									УИД = Заказ.Номер + "/" + Формат(Заказ.Дата, "ДЛФ=Д") + "/" + строка(Сч);	
								КонецЕсли;
								
								ПромНаименование = СтрЗаменить(Строка.Номенклатура.НаименованиеПолное, "'", "");
								ПромНаименование = СтрЗаменить(ПромНаименование,Символы.ПС,"");
								
								Если СЧ = Заказ.Товары.Количество()
									ИЛИ строка.НомерСтроки = НомерПоследнейОтправляемойСтроки  Тогда
									
									Запросadd = "SELECT GETBIT1(RESULT,0) as RES, DCODE, IDTOV, INV, MSG FROM PM_161104656_STR_IZPORTALA_SH2(" 
									          + ФорматироватьСтроку(Строка(ИД)) + "," + КодДоговора + "," + Заказ.IDСклада.Идентификатор + ",'" 
											  + Строка.Номенклатура.Родитель.Наименование + "','" + Строка.Номенклатура.КодПроизводителя + "','" 
											  + ПромНаименование + "'," + ФорматироватьСтроку(Строка(Строка.Количество)) + ",'" + УИД + "',301," 
											  + ФорматироватьСтроку(Строка(Строка.Цена)) + "," + ФорматироватьСтроку(Строка(Окр(Строка.Цена / Коэф, 2))) 
											  + "," + Доставка + ",'" + Формат(ТекущаяДата(),"ДЛФ=Д") + "',1,'" 
											  + СтрЗаменить(СокрЛП(Строка.ПроизводительПоставщика),"'","''") + "','" + Строка.Номенклатура.Артикул + "')"; 

								Иначе

									Запросadd = "SELECT GETBIT1(RESULT,0) as RES, DCODE, IDTOV, INV, MSG FROM PM_161104656_STR_IZPORTALA_SH2(" + ФорматироватьСтроку(Строка(ИД)) + "," + 
																																			КодДоговора + "," + 
																																			Заказ.IDСклада.Идентификатор + ",'" + 
																																			Строка.Номенклатура.Родитель.Наименование + "','" + 
																																			Строка.Номенклатура.КодПроизводителя + "','" + 
																																			ПромНаименование + "'," + 
																																			ФорматироватьСтроку(Строка(Строка.Количество)) + ",'" + 
																																			УИД + 
																																			"',301," + 
																																			ФорматироватьСтроку(Строка(Строка.Цена)) + "," + 
																																			ФорматироватьСтроку(Строка(Окр(Строка.Цена/Коэф,2))) + "," + 
																																			Доставка + ",'" + 
																																			Формат(ТекущаяДата(),"ДЛФ=Д") + "',0,'" + 
																																			СтрЗаменить(СокрЛП(Строка.ПроизводительПоставщика),"'","''") + "','" + 
																																			Строка.Номенклатура.Артикул + "')";
								КонецЕсли;
								
								РСТСтр = СформироватьЗапрос(Запросadd,Подключение);
								
								Если РСТСтр = Неопределено Тогда
									
									ЗаписьЖурналаРегистрации("Выгрузка заказа поставщику в Аварду", УровеньЖурналаРегистрации.Ошибка,,, "Ошибка выгрузки заказа поставщику " 
									+ Запросadd);
									
									СоздатьОповещениеОбИзмененииДляСтороннихСкладов("Выгрузка заказа поставщику в Аварду",
									"Ошибка выгрузки заказа поставщику " + Запросadd,Заказ);
									
									СоздатьОповещениеОбОшибкеОтправкиВАварду("Выгрузка заказа поставщику в Аварду",
									"Ошибка выгрузки заказа поставщику " + Запросadd,Заказ);
									
									Сообщить ("Ошибка выгрузки строки " + Строка.НомерСтроки + " документа");
									Подключение.RollbackTrans();
									
									ЗаказОб.Записать();

									ФлагОтправки = Ложь;
									
									Прервать;
									
								Иначе	
									
									Если РСТСтр.EOF() = 0 Тогда
										
										Если РСТСтр.Fields("RES").Value = 1 тогда

											ФлагЗапись = Ложь;
											Ном = Строка.Номенклатура.ПолучитьОбъект();
											
											Если не ЗначениеЗаполнено(СокрЛП(Строка.Номенклатура.КодПоБазеМоскоречье)) и ЗначениеЗаполнено(СокрЛП(РСТСтр.Fields("INV").Value)) тогда
												
												Ном.КодПоБазеМоскоречье = СокрЛП(РСТСтр.Fields("INV").Value);
												ФлагЗапись = Истина;
												
											КонецЕсли;
											
											Если не ЗначениеЗаполнено(СокрЛП(Строка.Номенклатура.Артикул)) и ЗначениеЗаполнено(СокрЛП(РСТСтр.Fields("INV").Value)) тогда
												
												Ном.Артикул = СокрЛП(РСТСтр.Fields("INV").Value);
												ФлагЗапись = Истина;
												
											КонецЕсли;
											
											Если (не ЗначениеЗаполнено(СокрЛП(Строка.Номенклатура.КодАварда)) или не СокрЛП(Строка.Номенклатура.КодАварда) = 0) 
												и ЗначениеЗаполнено(СокрЛП(РСТСтр.Fields("IDTOV").Value)) тогда
												
												Ном.КодАварда = РСТСтр.Fields("IDTOV").Value; 
												ФлагЗапись = Истина;
												
											КонецЕсли;
											
											Если ФлагЗапись Тогда
												
												Ном.ОбменДанными.Загрузка = Истина;
												Ном.Записать();
												
											КонецЕсли;
											
										Иначе

											ЗаписьЖурналаРегистрации("Выгрузка заказа поставщику в Аварду",,,, "Ошибка привязки строки заказа поставщику " + Запросadd 
											+ " " + РСТСтр.Fields("MSG").Value);
											
											СоздатьОповещениеОбИзмененииДляСтороннихСкладов("Выгрузка заказа поставщику в Аварду",
											"Ошибка привязки строки заказа поставщику " + Запросadd + " " + РСТСтр.Fields("MSG").Value,Заказ);
											
											СоздатьОповещениеОбОшибкеОтправкиВАварду("Выгрузка заказа поставщику в Аварду",
											"Ошибка привязки строки заказа поставщику " + Запросadd + " " + РСТСтр.Fields("MSG").Value,Заказ);
											
											Сообщить("Ошибка привязки строки заказа поставщику " + РСТСтр.Fields("MSG").Value);
											Подключение.RollbackTrans();							
											ЗаказОб.Записать();
											ФлагОтправки = Ложь;
											
											Прервать;
											
										КонецЕсли;
										
										Если СокрЛП(Строка.Номенклатура.КодПоБазеМоскоречье) = "" Тогда 
											
											Строка.УспешноОтправленаВАварду = Ложь;
											СоздатьОповещениеОбИзмененииДляСтороннихСкладов("Выгрузка заказа поставщику в Аварду",
											"Ошибка привязки строки №" + Строка.НомерСтроки + " заказа поставщику. Возможно номенклатура не найдена ( не заполнен код по базе Москворечье для номенклатуры с кодом " + Строка.Номенклатура.Код + ").",Заказ);
											
											СоздатьОповещениеОбОшибкеОтправкиВАварду("Выгрузка заказа поставщику в Аварду",
											"Ошибка привязки строки №" + Строка.НомерСтроки + " заказа поставщику. Возможно номенклатура не найдена ( не заполнен код по базе Москворечье для номенклатуры с кодом " + Строка.Номенклатура.Код + ").",Заказ);
											
										Иначе
											Строка.УспешноОтправленаВАварду = Истина;
