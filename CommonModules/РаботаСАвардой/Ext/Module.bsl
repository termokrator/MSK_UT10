							+ СтрЗаменить(Строка.Номенклатура.НаименованиеПолное,"'","") + "'," + ФорматироватьСтроку(Строка(Строка.Количество)) 
							+ ",'" + УИД + "',301," + ФорматироватьСтроку(Строка(Строка.Цена)) + "," + ФорматироватьСтроку(Строка(Окр(Строка.Цена/Коэф,2))) 
							+ "," + Доставка + ",'" + Формат(ТекущаяДата(),"ДЛФ=Д") + "',1,'" + СтрЗаменить(СокрЛП(Строка.ПроизводительПоставщика),"'","''") + "')"; 
						Иначе
							Запросadd = "SELECT GETBIT1(RESULT,0) as RES, DCODE, IDTOV, INV, MSG FROM AZ_161104656_STR_IZPORTALA_SH2(" 
							+ ФорматироватьСтроку(Строка(ИД)) + "," + КодДоговора + "," + Заказ.IDСклада.Идентификатор + ",'" 
