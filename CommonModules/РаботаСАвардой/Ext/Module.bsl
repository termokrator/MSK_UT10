Процедура СинхронизацияВесаОбъема(ЗаВесьПериод = ложь) Экспорт
	
	Подключение = Неопределено;
	RS = Неопределено;
	
	ОписаниеТиповСтрока = новый ОписаниеТипов("строка", новый квалификаторыстроки(80, ДопустимаяДлина.Переменная));
	ОписаниеТиповЧисло = новый ОписаниеТипов("число", новый квалификаторычисла(12));
	ОписаниеТиповЧислоСРазрядами = новый ОписаниеТипов("число", новый квалификаторычисла(10, 3));
	
	ТаблШК = Новый ТаблицаЗначений;
	Подключение = Новый COMObject("ADODB.Connection");	
	
	Если Соединение(Подключение) Тогда 		
		
		Если ЗаВесьПериод тогда
			ДатаНТ = "null";
			ДатаКТ = "null";			
		Иначе
			ДатаНТ = "'" + ПолучитьДату(ТекущаяДата() - 30*24*60*60) + "'";
			ДатаКТ = "'" + ПолучитьДату(КонецГода(ТекущаяДата())) + "'";
		КонецЕсли;
		
		ТекстЗапроса = "Select IDTOV,ID_OSN_EDIZM,LENGHT_OEI,WIDTH_OEI,HEIGHT_OEI,BARCODE_OEI,WEIGHT_NETTO,WEIGHT_BRUTTO,OBYEM,KOEF
		|From ({call PM_GET_TOV_FOR_ORA_2(null,null,null,null," + ДатаНТ + "," + ДатаКТ + ",null,null,null,null,null,null)})";
		
		RS = СформироватьЗапрос(ТекстЗапроса, Подключение);
		
		Если RS <> Неопределено тогда
			
			ПромТаблица = Новый ТаблицаЗначений;
			ПромТаблица.Очистить();
			
			Для Счетчик = 1 По RS.Fields.Count Цикл
				
				Поле = RS.Fields.Item(Счетчик - 1);
				
				Если СокрЛП(Поле.Name) = "IDTOV" ИЛИ СокрЛП(Поле.Name) = "ID_OSN_EDIZM" ИЛИ СокрЛП(Поле.Name) = "KOEF" Тогда
					Колонка = ПромТаблица.Колонки.Добавить(Поле.Name,ОписаниеТиповЧисло, Поле.Name); 					
				ИначеЕсли СокрЛП(Поле.Name) = "BARCODE_OEI" Тогда
					Колонка = ПромТаблица.Колонки.Добавить(Поле.Name,ОписаниеТиповСтрока, Поле.Name);
				Иначе
					Колонка = ПромТаблица.Колонки.Добавить(Поле.Name,ОписаниеТиповЧислоСРазрядами, Поле.Name); 					
				КонецЕсли;
				
			КонецЦикла;
			
			Пока RS.EOF() = 0 Цикл		
				
				НоваяСтрока = ПромТаблица.Добавить();           		
				
				Для Счетчик = 1 По RS.Fields.Count Цикл 
					
					Поле = RS.Fields.Item(Счетчик - 1);
					НоваяСтрока[Поле.Name] = Поле.Value;			
					
				КонецЦикла;    		
				
				RS.MoveNext(); 		
				
			КонецЦикла;
			
			RS.Close(); 			
			RS = Неопределено;
			
			Если ЗаВесьПериод тогда
				
				ТекстЗапроса = "select n.ntext1, n.nidlib from nab n where n.nconcept = 100802";
				
				RS = СформироватьЗапрос(ТекстЗапроса, Подключение);
				
				Если RS <> Неопределено тогда
					
					ТаблШК.Очистить();
					
					Для Счетчик = 1 По RS.Fields.Count Цикл
						
						Поле = RS.Fields.Item(Счетчик - 1);
						
						Если СокрЛП(Поле.Name) = "NIDLIB" Тогда
							Колонка = ТаблШК.Колонки.Добавить(Поле.Name, ОписаниеТиповЧисло, Поле.Name); 					
						Иначе
							Колонка = ТаблШК.Колонки.Добавить(Поле.Name, ОписаниеТиповСтрока, Поле.Name);
						КонецЕсли;
						
					КонецЦикла;
					
					Пока RS.EOF() = 0 Цикл		
						
						НоваяСтрока = ТаблШК.Добавить();           		
						
						Для Счетчик = 1 По RS.Fields.Count Цикл 
							
							Поле = RS.Fields.Item(Счетчик - 1);
							НоваяСтрока[Поле.Name] = Поле.Value;			
							
						КонецЦикла;    		
						
						RS.MoveNext(); 		
						
					КонецЦикла;
					
					RS.Close(); 			
					RS = Неопределено;
					
					ТаблШК.Индексы.Добавить("NIDLIB");			
					
				КонецЕсли;	
				
			КонецЕсли;
			
			НоменклатураПустаяСсылка = Справочники.Номенклатура.ПустаяСсылка();
			ВидНоменклатуры = Справочники.ВидыНоменклатуры.ПустаяСсылка();
			
			кол = 0;
			КолДес = 0;
			Текст = ("Обработано строк " + кол);
			ЗаписьЖурналаРегистрации("Обработка справочника",,,, Текст);	

			Для Каждого Строка Из ПромТаблица Цикл
				
				кол = кол + 1;	
				КолДес = КолДес + 1;					
				
				Если КолДес = 1000 Тогда			
					
					КолДес = 0;
					Текст = ("Обработано строк " + кол);
					ЗаписьЖурналаРегистрации("Обработка справочника",,,, Текст);	
					
				КонецЕсли;
				
				Товар = Справочники.Номенклатура.НайтиПоРеквизиту("КодАварда", Строка.IDTOV);

				Если Товар = Неопределено ИЛИ Товар = Справочники.Номенклатура.ПустаяСсылка() Тогда
					Продолжить;
				КонецЕсли;
				
				МодУ = Ложь;

				
				ЕдИзм = НайтиЕдИзм(Строка.ID_OSN_EDIZM);
				
				Если ЗначениеЗаполнено(ЕдИзм) тогда
					
					Уп = Справочники.ЕдиницыИзмерения.НайтиПоНаименованию(ЕдИзм.Наименование, Истина,, Товар);
					
					Если Не ЗначениеЗаполнено(Уп) тогда
						
						Упак = Справочники.ЕдиницыИзмерения.СоздатьЭлемент();
						Упак.Владелец = Товар;
						МодУ = Истина;
						
					Иначе
						Упак = Уп.ПолучитьОбъект();
					КонецЕсли;
					
					Если Упак.ЕдиницаПоКлассификатору <> ЕдИзм тогда
						
						Упак.ЕдиницаПоКлассификатору = ЕдИзм;
						МодУ = Истина;
						
					КонецЕсли;
					
					Если Упак.Наименование <> ЕдИзм.Наименование тогда
						
						Упак.Наименование = ЕдИзм.Наименование;
						МодУ = Истина;
						
					КонецЕсли;
					
					Если Упак.Вес <> Строка.WEIGHT_BRUTTO тогда
						
						Упак.Вес = Строка.WEIGHT_BRUTTO;
						МодУ = Истина;
						
					КонецЕсли;
					
					Если Упак.Объем <> Строка.OBYEM тогда
						
						Упак.Объем = Строка.OBYEM;
						МодУ = Истина;
						
					КонецЕсли;
					
					Если Упак.Коэффициент <> Строка.KOEF тогда
						
						Упак.Коэффициент = Строка.KOEF;
						МодУ = Истина;
						
					КонецЕсли;
					
					Если Упак.Длина <> Строка.LENGHT_OEI тогда
						
						Упак.Длина = Строка.LENGHT_OEI;
						МодУ = Истина;
						
					КонецЕсли;
					
					Если Упак.Ширина <> Строка.WIDTH_OEI тогда
						
						Упак.Ширина = Строка.WIDTH_OEI;
						МодУ = Истина;
						
					КонецЕсли;
					
					Если Упак.Высота <> Строка.HEIGHT_OEI тогда
						
						Упак.Высота = Строка.HEIGHT_OEI;
						МодУ = Истина;
						
					КонецЕсли;
					
					Если МодУ тогда
						Упак.Записать();
					КонецЕсли;
					
					Если Не ЗначениеЗаполнено(Товар.ЕдиницаХраненияОстатков) ИЛИ Товар.ЕдиницаХраненияОстатков <> Упак.Ссылка тогда
						
						НовыйЭлемент = Товар.ПолучитьОбъект();
						НовыйЭлемент.ЕдиницаХраненияОстатков = Упак.Ссылка;
						НовыйЭлемент.ЕдиницаДляОтчетов = Упак.Ссылка;
						НовыйЭлемент.ОбменДанными.Загрузка = Истина;
						НовыйЭлемент.Записать();
						
					КонецЕсли;
					
					Если ЗаВесьПериод Тогда
						
						Стр = Новый Структура;
						Стр.Вставить("NIDLIB", Товар.КодАварда);
						Массив = ТаблШК.НайтиСтроки(Стр);
						
						Для Каждого Элемент из Массив Цикл
							СоздатьШтрихкод(Элемент.NTEXT1, Товар);
						КонецЦикла;
						
					Иначе
						
						ТекстЗапроса = "Select BARCODE From ({call PM_GET_BARCODE_BY_TOVAR(" + ФорматироватьСтроку(Товар.КодАварда) + ")})";
						
						RS = СформироватьЗапрос(ТекстЗапроса, Подключение);
						
						Если RS <> Неопределено тогда
							
							Пока RS.EOF() = 0 Цикл		
								
								ШК = RS.Fields.Item(0).Value;
								СоздатьШтрихкод(ШК, Товар);
								RS.MoveNext(); 		
								
							КонецЦикла;
							
							RS.Close(); 			
							RS = Неопределено;
							
						КонецЕсли;	
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
			
			ПромТаблица.Очистить(); 
			ТаблШК.Очистить();
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновлениеВесаОбъема() Экспорт
	
	Подключение = Неопределено;
	RS = Неопределено;
	
	ОписаниеТиповСтрока = новый ОписаниеТипов("строка", новый квалификаторыстроки(80, ДопустимаяДлина.Переменная));
	ОписаниеТиповЧисло = новый ОписаниеТипов("число", новый квалификаторычисла(12));
	ОписаниеТиповЧислоСРазрядами = новый ОписаниеТипов("число", новый квалификаторычисла(10,3));
	
	ТаблШК = Новый ТаблицаЗначений;
	
	Подключение = Новый COMObject("ADODB.Connection");	
	
	Если Соединение(Подключение) Тогда 		
		
		ДатаНТ = "null";
		ДатаКТ = "null";			
		ТекстЗапроса = "Select IDTOV,ID_OSN_EDIZM,LENGHT_OEI,WIDTH_OEI,HEIGHT_OEI,BARCODE_OEI,WEIGHT_NETTO,WEIGHT_BRUTTO,OBYEM,KOEF
		|From ({call PM_GET_TOV_FOR_ORA_2(null,null,null,null," + ДатаНТ + "," + ДатаКТ + ",null,null,null,null,null,null)})";
		
		RS = СформироватьЗапрос(ТекстЗапроса, Подключение);
		
		Если RS <> Неопределено тогда
			
			ПромТаблица = Новый ТаблицаЗначений;
			ПромТаблица.Очистить();
			
			Для Счетчик = 1 По RS.Fields.Count Цикл
				
				Поле = RS.Fields.Item(Счетчик - 1);
				
				Если СокрЛП(Поле.Name) = "IDTOV" ИЛИ СокрЛП(Поле.Name) = "ID_OSN_EDIZM" ИЛИ СокрЛП(Поле.Name) = "KOEF" Тогда
					Колонка = ПромТаблица.Колонки.Добавить(Поле.Name, ОписаниеТиповЧисло, Поле.Name); 					
				ИначеЕсли СокрЛП(Поле.Name) = "BARCODE_OEI" Тогда
					Колонка = ПромТаблица.Колонки.Добавить(Поле.Name, ОписаниеТиповСтрока, Поле.Name);
				Иначе
					Колонка = ПромТаблица.Колонки.Добавить(Поле.Name, ОписаниеТиповЧислоСРазрядами, Поле.Name); 					
				КонецЕсли;
				
			КонецЦикла;
			
			Пока RS.EOF() = 0 Цикл		
				
				НоваяСтрока = ПромТаблица.Добавить();           		
				
				Для Счетчик = 1 По RS.Fields.Count Цикл 
					
					Поле = RS.Fields.Item(Счетчик - 1);
					НоваяСтрока[Поле.Name] = Поле.Value;			
					
				КонецЦикла;    		
				
				RS.MoveNext(); 		
				
			КонецЦикла;
			
			RS.Close(); 			
			RS = Неопределено;
			
			ТекстЗапроса = "select n.ntext1, n.nidlib from nab n where n.nconcept = 100802";
			
			RS = СформироватьЗапрос(ТекстЗапроса, Подключение);
			
			Если RS <> Неопределено тогда
				
				ТаблШК.Очистить();
				
				Для Счетчик = 1 По RS.Fields.Count Цикл
					
					Поле = RS.Fields.Item(Счетчик - 1);
					
					Если СокрЛП(Поле.Name) = "NIDLIB" Тогда
						Колонка = ТаблШК.Колонки.Добавить(Поле.Name, ОписаниеТиповЧисло, Поле.Name); 					
					Иначе
						Колонка = ТаблШК.Колонки.Добавить(Поле.Name, ОписаниеТиповСтрока, Поле.Name);
					КонецЕсли;
					
				КонецЦикла;
				
				Пока RS.EOF() = 0 Цикл		
					
					НоваяСтрока = ТаблШК.Добавить();           		
					
					Для Счетчик = 1 По RS.Fields.Count Цикл 
						
						Поле = RS.Fields.Item(Счетчик - 1);
						НоваяСтрока[Поле.Name] = Поле.Value;			
						
					КонецЦикла;    		
					
					RS.MoveNext(); 		
					
				КонецЦикла;
				
				RS.Close(); 			
				RS = Неопределено;
				
			КонецЕсли;	
			
			Запрос = Новый Запрос;
			Запрос.Текст= "ВЫБРАТЬ
			|	ПромТаблица.IDTOV
			|ПОМЕСТИТЬ ПТ
			|ИЗ
			|	&ПромТаблица КАК ПромТаблица
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Номенклатура.Ссылка,
			|	ПТ.IDTOV
			|ПОМЕСТИТЬ Ном
			|ИЗ
			|	ПТ КАК ПТ
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
			|		ПО ПТ.IDTOV = Номенклатура.КодАварда
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Ном.Ссылка,
			|	Ном.IDTOV
			|ПОМЕСТИТЬ НомФильтр
			|ИЗ
			|	Ном КАК Ном
			|ГДЕ
			|	НЕ Ном.Ссылка ЕСТЬ NULL
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	НомФильтр.Ссылка КАК Номенклатура,
			|	НомФильтр.IDTOV,
			|	УпаковкиЕдиницыИзмерения.Ссылка КАК Упаковка
			|ИЗ
			|	НомФильтр КАК НомФильтр
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЕдиницыИзмерения КАК УпаковкиЕдиницыИзмерения
			|		ПО НомФильтр.Ссылка = УпаковкиЕдиницыИзмерения.Владелец";
			
			НоменклатураПустаяСсылка = Справочники.Номенклатура.ПустаяСсылка();
			ВидНоменклатуры = Справочники.ВидыНоменклатуры.ПустаяСсылка();
			
			кол = 0;
			КолДес = 0;
			Текст = ("Обработано строк " + кол);
			ЗаписьЖурналаРегистрации("Обработка справочника",,,, Текст);	
			
			Для Каждого Строка Из ПромТаблица Цикл
				
				кол = кол + 1;	
				КолДес = КолДес+1;					
				
				Если КолДес = 1000 Тогда			
					
					КолДес = 0;
					Текст = ("Обработано строк " + кол);
					ЗаписьЖурналаРегистрации("Обработка справочника",,,, Текст);	
					
				КонецЕсли;
				
				Товар = Справочники.Номенклатура.НайтиПоРеквизиту("КодАварда", Строка.IDTOV);
				
				Если Товар = Неопределено ИЛИ Товар = Справочники.Номенклатура.ПустаяСсылка() Тогда
					Продолжить;
				КонецЕсли;
				
				МодУ = Ложь;
				ЕдИзм = НайтиЕдИзм(Строка.ID_OSN_EDIZM);
				
				Если ЗначениеЗаполнено(ЕдИзм) тогда
					
					Уп = Справочники.ЕдиницыИзмерения.НайтиПоНаименованию(ЕдИзм.Наименование, Истина,, Товар);
					
					Если Не ЗначениеЗаполнено(Уп) тогда
						
						Упак = Справочники.ЕдиницыИзмерения.СоздатьЭлемент();
						Упак.Владелец = Товар;
						МодУ = Истина;
						
					Иначе
						Упак = Уп.ПолучитьОбъект();
					КонецЕсли;
					
					Если Упак.ЕдиницаПоКлассификатору <> ЕдИзм тогда
						
						Упак.ЕдиницаПоКлассификатору = ЕдИзм;
						МодУ = Истина;
						
					КонецЕсли;
					
					Если Упак.Наименование <> ЕдИзм.Наименование тогда
						
						Упак.Наименование = ЕдИзм.Наименование;
						МодУ = Истина;
						
					КонецЕсли;
					
					Если Упак.Вес <> Строка.WEIGHT_BRUTTO тогда
						
						Упак.Вес = Строка.WEIGHT_BRUTTO;
						МодУ = Истина;
						
					КонецЕсли;
					
					Если Упак.Объем <> Строка.OBYEM тогда
						
						Упак.Объем = Строка.OBYEM;
						МодУ = Истина;
						
					КонецЕсли;
					
					Если Упак.Коэффициент <> Строка.KOEF тогда
						
						Упак.Коэффициент = Строка.KOEF;
						МодУ = Истина;
						
					КонецЕсли;
					
					Если Упак.Длина <> Строка.LENGHT_OEI тогда
						
						Упак.Длина = Строка.LENGHT_OEI;
						МодУ = Истина;
						
					КонецЕсли;
					
					Если Упак.Ширина <> Строка.WIDTH_OEI тогда
						
						Упак.Ширина = Строка.WIDTH_OEI;
						МодУ = Истина;
						
					КонецЕсли;
					
					Если Упак.Высота <> Строка.HEIGHT_OEI тогда
						
						Упак.Высота = Строка.HEIGHT_OEI;
						МодУ = Истина;
						
					КонецЕсли;
					
					Если МодУ тогда
						Упак.Записать();
					КонецЕсли;
					
					Если Не ЗначениеЗаполнено(Товар.ЕдиницаХраненияОстатков) тогда
						
						НовыйЭлемент = Товар.ПолучитьОбъект();
						НовыйЭлемент.ЕдиницаХраненияОстатков = Упак.Ссылка;
						НовыйЭлемент.ЕдиницаДляОтчетов = Упак.Ссылка;
						НовыйЭлемент.ОбменДанными.Загрузка = Истина;
						НовыйЭлемент.Записать();
						
					КонецЕсли;
					
					Стр = Новый Структура;
					Стр.Вставить("NIDLIB", Товар.КодАварда);
					Массив = ТаблШК.НайтиСтроки(Стр);
					
					Для Каждого Элемент из Массив Цикл
						СоздатьШтрихкод(Элемент.NTEXT1, Товар);
					КонецЦикла;
					
				КонецЕсли;
				
			КонецЦикла;
			
			ПромТаблица.Очистить(); 
			ТаблШК.Очистить();
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры


///////////////////Вспомогательные процедуры///////////////////
Функция Соединение(Подключение) Экспорт
	
	#Если Клиент Тогда
		Стр = "Provider=MSDASQL;Password=54321;Persist Security Info=True;User ID=TWUSER;Data Source=" + ПолучитьИмяАварды() + "32;Initial Catalog=" + ПолучитьИмяАварды() + "32";
	#ИначеЕсли Сервер Тогда
		Стр = "Provider=MSDASQL;Password=54321;Persist Security Info=True;User ID=TWUSER;Data Source=" + ПолучитьИмяАварды() + ";Initial Catalog=" + ПолучитьИмяАварды();
	#КонецЕсли 

	Попытка		
		
		Подключение.ConnectionTimeout = 30;
		Подключение.Open(Стр);      
		Возврат Истина;

	Исключение		
		
		глОшибкаАДО("Ошибка подключения ...", Подключение);
		Возврат Ложь;

	КонецПопытки; 
	
КонецФункции

Функция СформироватьЗапрос(СтрокаЗапроса,Подключение) Экспорт
	
	Попытка               
		
		Код = Новый ComObject("ADODB.Recordset");   
		Код.Open(СтрокаЗапроса, Подключение, 2, 3, 1);	
		Возврат Код;
		
	Исключение
		
		глОшибкаАДО("", Подключение); 
		Возврат Неопределено;
		
	КонецПопытки;
	
КонецФункции

Процедура глОшибкаАДО(стрФункция = "", Подключение) Экспорт
	
	Если Подключение.Errors.Count() <> 0 Тогда
		
		Для Ин = 0 По Подключение.Errors.Count() - 1 Цикл
			
			чКод = Подключение.Errors(Ин).Number();
			сОписание = Подключение.Errors(Ин).Description();
			сИсточник = Подключение.Errors(Ин).Source();
			Сообщить("ADO Error: " + чКод + " | " + стрФункция + " | " + сОписание);
			
		КонецЦикла;
		
		Подключение.Errors.Clear();
		
	Иначе
		
		Сообщить("Ошибка: " + ОписаниеОшибки());
		
	КонецЕсли;
	
КонецПроцедуры 

Функция ФорматироватьСтроку(КодАварда) Экспорт

	Стр = СтрЗаменить(Строка(КодАварда), " ", "");
	Стр = СтрЗаменить(Стр, ",", ".");
	Возврат Стр; 
	
КонецФункции

Функция ПолучитьИмяАварды() Экспорт
	
	Рез = Константы.ИмяБазыАварда.Получить();
	
	Если Не ЗначениеЗаполнено(Рез) тогда
		Рез = "AVARDA";
	КонецЕсли; 
	
	Возврат Рез;
	
КонецФункции

Функция ПолучитьДату(Дата)
	
	Возврат Формат(Дата, "ДЛФ=Д"); 
	
КонецФункции

Функция ПолучитьДатуИВремя(Дата) 
	
	Возврат Формат(Дата, "ДЛФ=ДВ"); 
	
КонецФункции

