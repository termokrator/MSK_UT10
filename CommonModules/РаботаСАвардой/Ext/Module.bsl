///////////////////Вызовы из регламентов///////////////////
Процедура ЗагрузкаНоменклатурыИзАварды() Экспорт    
	
	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда 
		
		ЗаписьЖурналаРегистрации("Синхронизироват номенклатуру с Авардой", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Отменена работа регламентного задания из-за несоответствия параметров подключения к ИБ");
		
		Возврат;
		
	КонецЕсли;
	
	Если Константы.СинхронизироватьНоменклатуруСАвардой.Получить() тогда
		
		СинхронизацияНоменклатурныхГрупп();
		СинхронизацияГрупп();
		СинхронизацияНоменклатуры();
		СинхронизацияВесаОбъема();
		
	КонецЕсли;  
	
КонецПроцедуры

Процедура ОбновлениеНоменклатурыИзАварды() Экспорт 
	
	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда 
		
		ЗаписьЖурналаРегистрации("Обновление номенклатуры из аварды", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Отменена работа регламентного задания из-за несоответствия параметров подключения к ИБ");
		
		Возврат;
		
	КонецЕсли;
	
	Если Константы.СинхронизироватьНоменклатуруСАвардой.Получить() тогда
		
		СинхронизацияНоменклатуры(Истина);		
		ОбновлениеНоменклатуры();				
		СинхронизацияВесаОбъема(Истина);
		
	КонецЕсли;  
	
КонецПроцедуры

Процедура ПараллельнаяОтправкаСтороннихСкладов() Экспорт

	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда 
		
		ЗаписьЖурналаРегистрации("Параллельная отправка сторонних складов", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Отменена работа регламентного задания из-за несоответствия параметров подключения к ИБ");
		
		Возврат;

	КонецЕсли;
	
	ЗаписьЖурналаРегистрации("Начало: Отправка параллельных заказов в другую базу", УровеньЖурналаРегистрации.Информация,,,);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	_НакоплениеДокументовДляПараллельнойОтправкиВБазу.Документ,
	|	_НакоплениеДокументовДляПараллельнойОтправкиВБазу.ПредполагаемаяДатаОтправки,
	|	_НакоплениеДокументовДляПараллельнойОтправкиВБазу.Отправлено,
	|	_НакоплениеДокументовДляПараллельнойОтправкиВБазу.ДатаОтправки
	|ИЗ
	|	РегистрСведений._НакоплениеДокументовДляПараллельнойОтправкиВБазу КАК _НакоплениеДокументовДляПараллельнойОтправкиВБазу
	|ГДЕ
	|	_НакоплениеДокументовДляПараллельнойОтправкиВБазу.Отправлено = ЛОЖЬ
	|	И _НакоплениеДокументовДляПараллельнойОтправкиВБазу.ПредполагаемаяДатаОтправки > 0
	|	И _НакоплениеДокументовДляПараллельнойОтправкиВБазу.ПредполагаемаяДатаОтправки < &ТД
	|	И _НакоплениеДокументовДляПараллельнойОтправкиВБазу.Документ.ПометкаУдаления = ЛОЖЬ
	|	И _НакоплениеДокументовДляПараллельнойОтправкиВБазу.Счетчик < 3";
	
	Запрос.УстановитьПараметр("ТД", ТекущаяДата());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		КодМТ = "";
		
		Попытка
			
			Если РаботаСАвардой.ОтправкаЗаказаВУТ11(ВыборкаДетальныеЗаписи.Документ, "СторонниеСкладыПарал", КодМТ) Тогда 
				
				// --- пишем отметку ---
				РСГ = РегистрыСведений._НакоплениеДокументовДляПараллельнойОтправкиВБазу.СоздатьНаборЗаписей();
				РСГ.Отбор.Документ.Установить(ВыборкаДетальныеЗаписи.Документ);
				РСГ.Прочитать();
				ТЗ = РСГ.Выгрузить();
				
				Для Каждого стрТЗ из ТЗ Цикл 
					
					стрТЗ.Отправлено = Истина;
					стрТЗ.ДатаОтправки = ТекущаяДата();
					стрТЗ.КодМТУТ = КодМТ;
					стрТЗ.Счетчик = стрТЗ.Счетчик + 1;
					
				КонецЦикла;
				
				РСГ.Загрузить(ТЗ);
				РСГ.Записать();
				
			Иначе
				
				РСГ = РегистрыСведений._НакоплениеДокументовДляПараллельнойОтправкиВБазу.СоздатьНаборЗаписей();
				РСГ.Отбор.Документ.Установить(ВыборкаДетальныеЗаписи.Документ);
				РСГ.Прочитать();
				ТЗ = РСГ.Выгрузить();
				
				Для Каждого стрТЗ из ТЗ Цикл 
					
					стрТЗ.Отправлено = Ложь;
					стрТЗ.Счетчик = стрТЗ.Счетчик + 1;
					
				КонецЦикла;
				
				РСГ.Загрузить(ТЗ);
				РСГ.Записать();
				
			КонецЕсли;
			
		Исключение
			
			строшибка = ОписаниеОшибки();
			ЗаписьЖурналаРегистрации("Ошибка: Отправка параллельных заказов в другую базу", УровеньЖурналаРегистрации.Информация,,, строшибка);
			
		КонецПопытки;
		
	КонецЦикла;
	
	ЗаписьЖурналаРегистрации("Операция завершена: Отправка параллельных заказов в другую базу", УровеньЖурналаРегистрации.Информация,,,); 
	
КонецПроцедуры

Процедура ОбновлениеНоменклатуры() Экспорт

	Подключение = Неопределено;
	RS = Неопределено;

	ОписаниеТиповСтрока = новый ОписаниеТипов("строка", новый квалификаторыстроки(80, ДопустимаяДлина.Переменная));
	ОписаниеТиповДата = новый ОписаниеТипов("Дата", новый квалификаторыДаты(ЧастиДаты.Дата));
	ОписаниеТиповЧисло = новый ОписаниеТипов("число", новый квалификаторычисла(12));
	
	Подключение = Новый COMObject("ADODB.Connection");	

	Если Соединение(Подключение) Тогда
		
		ДатаНТ = "null";
		ДатаКТ = "null";			
		
		ТекстЗапроса = "Select IGRUPPA,ISYSTEMA,IAGREGAT,IDETAL,IDEDIZM,INV,ARTICLE,PROIZV,IDPROIZV,TOVAR_NAME,IDTOV,DATE_SOZD,SOTRUDNIK,KOEF,ABC_XYZ
		|From ({call RA_GET_TOV_FOR_ORA(null,null,null,null," + ДатаНТ + "," + ДатаКТ + ",null,null,null,null,null,null)})";
		
		RS = СформироватьЗапрос(ТекстЗапроса, Подключение);
		
		Если RS <> Неопределено тогда
			
			ПромТаблица = Новый ТаблицаЗначений;
			ПромТаблица.Очистить();
			
			Для Счетчик = 1 По RS.Fields.Count Цикл
				
				Поле = RS.Fields.Item(Счетчик - 1);
				
				Если СокрЛП(Поле.Name) = "IDTOV" ИЛИ СокрЛП(Поле.Name) = "IDEDIZM" ИЛИ СокрЛП(Поле.Name) = "IDPROIZV" ИЛИ СокрЛП(Поле.Name) = "IGRUPPA"
					ИЛИ СокрЛП(Поле.Name) = "ISYSTEMA" ИЛИ СокрЛП(Поле.Name) = "IAGREGAT" ИЛИ СокрЛП(Поле.Name) = "IDETAL" ИЛИ СокрЛП(Поле.Name) = "KOEF" Тогда
					Колонка = ПромТаблица.Колонки.Добавить(Поле.Name,ОписаниеТиповЧисло, Поле.Name);
				ИначеЕсли  СокрЛП(Поле.Name) = "DATE_SOZD" тогда
					Колонка = ПромТаблица.Колонки.Добавить(Поле.Name,ОписаниеТиповДата, Поле.Name);
				Иначе					
					Колонка = ПромТаблица.Колонки.Добавить(Поле.Name,ОписаниеТиповСтрока, Поле.Name);
				КонецЕсли;
				
			КонецЦикла;
			
			Пока RS.EOF() = 0 Цикл		
				
				НоваяСтрока = ПромТаблица.Добавить();           		
				
				Для Счетчик = 1 По RS.Fields.Count Цикл 
					
					Поле = RS.Fields.Item(Счетчик - 1);
					НоваяСтрока[Поле.Name] = СокрЛП(Поле.Value);
					
				КонецЦикла;    		
				
				RS.MoveNext(); 		
				
			КонецЦикла;
			
			RS.Close(); 			
			RS = Неопределено;
			
			НоменклатураПустаяСсылка = Справочники.Номенклатура.ПустаяСсылка();
			ВидНоменклатуры = Справочники.ВидыНоменклатуры.ПустаяСсылка();
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	ПромТаблица.IDTOV,
			|	ПромТаблица.IGRUPPA,
			|	ПромТаблица.ISYSTEMA,
			|	ПромТаблица.IAGREGAT,
			|	ПромТаблица.IDETAL,
			|	ПромТаблица.IDEDIZM,
			|	ПромТаблица.INV,
			|	ПромТаблица.ARTICLE,
			|	ПромТаблица.PROIZV,
			|	ПромТаблица.TOVAR_NAME,
			|	ПромТаблица.DATE_SOZD,
			|	ПромТаблица.SOTRUDNIK,
			|	ПромТаблица.KOEF,
			|	ПромТаблица.ABC_XYZ,
			|	ПромТаблица.IDPROIZV
			|ПОМЕСТИТЬ ПТ
			|ИЗ
			|	&ПромТаблица КАК ПромТаблица
			|ИНДЕКСИРОВАТЬ ПО IDTOV 			
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Номенклатура.Ссылка,
			|	ПТ.IDTOV,
			|	ПТ.IGRUPPA,
			|	ПТ.ISYSTEMA,
			|	ПТ.IAGREGAT,
			|	ПТ.IDETAL,
			|	ПТ.IDEDIZM,
			|	ПТ.INV,
			|	ПТ.ARTICLE,
			|	ПТ.PROIZV,
			|	ПТ.TOVAR_NAME,
			|	ПТ.DATE_SOZD,
			|	ПТ.SOTRUDNIK,
			|	ПТ.KOEF,
			|	ПТ.ABC_XYZ,
			|	ПТ.IDPROIZV
			|ПОМЕСТИТЬ ВремТабл
			|ИЗ
			|	ПТ КАК ПТ
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
			|		ПО ПТ.IDTOV = Номенклатура.КодАварда
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВремТабл.IDTOV,
			|	ВремТабл.IAGREGAT,
			|	ВремТабл.IGRUPPA,
			|	ВремТабл.ISYSTEMA,
			|	ВремТабл.IDETAL,
			|	ВремТабл.IDEDIZM,
			|	ВремТабл.INV,
			|	ВремТабл.ARTICLE,
			|	ВремТабл.PROIZV,
			|	ВремТабл.TOVAR_NAME,
			|	ВремТабл.DATE_SOZD,
			|	ВремТабл.SOTRUDNIK,
			|	ВремТабл.IDPROIZV,
			|	ВремТабл.KOEF,
			|	ВремТабл.ABC_XYZ,
			|	ВремТабл.Ссылка
			|ИЗ
			|	ВремТабл КАК ВремТабл
			|ГДЕ
			|	НЕ ВремТабл.Ссылка ЕСТЬ NULL";
			
			Запрос.УстановитьПараметр("ПромТаблица", ПромТаблица);
			Строка = Запрос.Выполнить().Выбрать();
			
			кол = 0;
			КолДес = 0;
			
			ЗаписьЖурналаРегистрации("Обработка справочника",,,, "Синхронизация номенклатуры");
			
			ВидНоменклатуры = Константы.ВидНоменклатурыПоУмолчанию.Получить();
			
			Пока Строка.Следующий() Цикл
				
				кол = кол + 1;	
				КолДес = КолДес+1;					
				
				Если КолДес = 1000 Тогда			
					
					КолДес = 0;
					Текст = ("Обработано строк " + кол);
					ЗаписьЖурналаРегистрации("Обработка справочника",,,, Текст);	
					
				КонецЕсли;
				
				НП = СокрЛП(Строка.ARTICLE) + " " + СокрЛП(Строка.TOVAR_NAME);
				ЕИ = НайтиЕдИзм(Строка.IDEDIZM);
				АВС = НайтиГруппуАВС(СокрЛП(Строка.ABC_XYZ));
				НГ = Справочники.НоменклатурныеГруппы.НайтиПоКоду(ФорматироватьСтроку(Строка.IDETAL));
				Род = Справочники.Номенклатура.НайтиПоРеквизиту("КодАварда", Строка.IDPROIZV, НоменклатураПустаяСсылка);
				
				ОбъектДляПроверки = Строка.Ссылка.ПолучитьОбъект();
				
				Если ОбъектДляПроверки.Наименование <> СокрЛП(Строка.TOVAR_NAME) ИЛИ ОбъектДляПроверки.НаименованиеПолное <> НП 
					ИЛИ ОбъектДляПроверки.КодАварда <> Строка.IDTOV 
					ИЛИ ОбъектДляПроверки.КодПоБазеМоскоречье <> СокрЛП(Строка.INV) ИЛИ ОбъектДляПроверки.Артикул <> СокрЛП(Строка.INV) 
					ИЛИ ОбъектДляПроверки.БазоваяЕдиницаИзмерения <> ЕИ
					ИЛИ ОбъектДляПроверки.КодПроизводителя <> СокрЛП(Строка.ARTICLE) ИЛИ ОбъектДляПроверки.ГруппаАВС <> АВС
					ИЛИ ОбъектДляПроверки.НоменклатурнаяГруппа <> НГ ИЛИ ОбъектДляПроверки.Родитель <> Род тогда
					
					НовыйЭлемент = Строка.Ссылка.ПолучитьОбъект();
					НовыйЭлемент.ВидНоменклатуры = ВидНоменклатуры;
					НовыйЭлемент.Наименование = СокрЛП(Строка.TOVAR_NAME);
					НовыйЭлемент.НаименованиеПолное = НП;
					НовыйЭлемент.КодАварда = Строка.IDTOV;
					НовыйЭлемент.КодПоБазеМоскоречье = СокрЛП(Строка.INV);
					НовыйЭлемент.Артикул = СокрЛП(Строка.INV);						
					НовыйЭлемент.БазоваяЕдиницаИзмерения = ЕИ;
					НовыйЭлемент.КодПроизводителя = СокрЛП(Строка.ARTICLE);
					НовыйЭлемент.ВестиУчетПоСериям = Истина;
					НовыйЭлемент.ВестиПартионныйУчетПоСериям = Истина;
					НовыйЭлемент.ГруппаАВС = АВС;
					НовыйЭлемент.НоменклатурнаяГруппа = НГ;
					НовыйЭлемент.Родитель = Род; 
					//+Гавриленков В. 05.12.2025 #UT10-5574
					//НовыйЭлемент.СтавкаНДС = Перечисления.СтавкиНДС.НДС20;
					НовыйЭлемент.СтавкаНДС = ?(ТекущаяДата() >= Дата("20260101000000"), Перечисления.СтавкиНДС.НДС22, Перечисления.СтавкиНДС.НДС20);
					//-Гавриленков В. 05.12.2025 #UT10-5574
					
					Попытка
						НовыйЭлемент.Записать();
					Исключение
						
						
					КонецПопытки;
					
				КонецЕсли;
				
			КонецЦикла;
			
			ПромТаблица.Очистить(); 			
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

///////////////////Аварда///////////////////
Функция ОтправитьЗаказВАварду(Заказ)  Экспорт
	
	Подключение = Неопределено;
	RS = Неопределено;
	
	ОписаниеТиповСтрока = новый ОписаниеТипов("строка", новый квалификаторыстроки(80,ДопустимаяДлина.Переменная));
	ОписаниеТиповДата = новый ОписаниеТипов("Дата", новый квалификаторыДаты(ЧастиДаты.Дата));
	ОписаниеТиповЧисло = новый ОписаниеТипов("число", новый квалификаторычисла(12));
	
	Подключение = Новый COMObject("ADODB.Connection");
	
	КодДоговора = Константы.КодДоговораСторонниеСклады.Получить();
	ЗаказОб = Заказ.ПолучитьОбъект();
	
	Если Константы.СамовывозУдаленныхСкладов.Получить() тогда
		Доставка = "0";
	Иначе
		Доставка = "1";
	КонецЕсли;
	
	Если Соединение(Подключение) И ЗначениеЗаполнено(КодДоговора) Тогда 
		
		Подключение.BeginTrans();

		Запросadd = "SELECT GETBIT1(RESULT,0) as RES, RESULT, IDDOC, MSG FROM RA_CREATE_161104656_HEAD_SH(" + КодДоговора + ")"; 
		
		РСТ = СформироватьЗапрос(Запросadd,Подключение);

		Если РСТ = Неопределено Тогда
			
			ЗаписьЖурналаРегистрации("Выгрузка заказа поставщику в Аварду", УровеньЖурналаРегистрации.Ошибка,,, "Ошибка выгрузки заказа поставщику " + Запросadd);
			Сообщить ("Ошибка выгрузки документа");
			
		Иначе	
			
			Если РСТ.EOF() = 0 Тогда
				
				Если РСТ.Fields("RES").Value = 1 тогда
					
					ИД = РСТ.Fields("IDDOC").Value;
					Сч = 0;
					
					Если Не ЗначениеЗаполнено(Заказ.IDСклада) тогда
						
						ЗаписьЖурналаРегистрации("Выгрузка заказа поставщику в Аварду", УровеньЖурналаРегистрации.Ошибка,,, "Не заполнен ID склада " + Заказ);
						
						СоздатьОповещениеОбИзмененииДляСтороннихСкладов("Выгрузка заказа поставщику в Аварду",
						"Ошибка выгрузки заказа поставщику в Аварда. строки заказа поставщику. Не заполнен ID склада ", Заказ);
						
						Сообщить ("Ошибка выгрузки документа " + Заказ + " Не заполнен ID склада");
						
						Подключение.RollbackTrans();
						
						Возврат Ложь;
						
					КонецЕсли;
					
					Коэф = Заказ.IDСклада.КоэффициентЗакупки;
					
					Для каждого строка из Заказ.Товары Цикл
						
						Сч = Сч + 1;

						Если ЗначениеЗаполнено(строка.УИД) Тогда
							УИД = Заказ.Номер + "/" + Формат(Заказ.Дата, "ДЛФ=Д") + "/" + ФорматироватьСтроку(строка.УИД); 
						Иначе
							УИД = Заказ.Номер + "/" + Формат(Заказ.Дата, "ДЛФ=Д") + "/" + строка(Сч);	
						КонецЕсли;
						
						Если СЧ = Заказ.Товары.Количество() тогда
