			КолДес = 0;
			ЗаписьЖурналаРегистрации("Обработка справочника",,,, "Синхронизация групп номенклатуры");
			ПредГруппа = Неопределено;
			ПредСистема = Неопределено;
			ПредАгрегат = Неопределено;
			ПредДеталь = Неопределено;
			Группа = Неопределено;
			Система = Неопределено;
			Агрегат = Неопределено;
			Деталь = Неопределено;
			
			ПромТаблица.Сортировать("IDPROIZV");
			ПромТаблица.Свернуть("IDPROIZV, PROIZV");
			
			Для Каждого Строка Из ПромТаблица Цикл
				
				кол = кол + 1;	
				КолДес = КолДес + 1;					
				
				Если КолДес = 1000 Тогда			
					
					КолДес = 0;
					Текст = ("Обработано строк " + кол);
					ЗаписьЖурналаРегистрации("Обработка справочника",,,, Текст);	
					
				КонецЕсли;
				
				Группа = Справочники.Номенклатура.НайтиПоРеквизиту("КодАварда", Строка.IDPROIZV, НоменклатураПустаяСсылка);
				
				Если Группа = НоменклатураПустаяСсылка тогда 
					
					Группа = Справочники.Номенклатура.НайтиПоНаименованию(СокрЛП(Строка.PROIZV), Истина, НоменклатураПустаяСсылка);
					
					Если Группа = НоменклатураПустаяСсылка тогда
						ГруппаОб = Справочники.Номенклатура.СоздатьГруппу();
					Иначе
						ГруппаОб = Группа.ПолучитьОбъект();
					КонецЕсли;

					ГруппаОб.Наименование = Строка.PROIZV;
					ГруппаОб.КодАварда = Строка.IDPROIZV;
					ГруппаОб.Записать();
					
				КонецЕсли;				
				
			КонецЦикла;
			
			ЗаписьЖурналаРегистрации("Обработка справочника",,,, "Синхронизация групп номенклатуры завершено");			
			ПромТаблица.Очистить(); 
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

