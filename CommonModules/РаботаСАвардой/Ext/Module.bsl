							КонецЦикла;
							
							Если Не ФлагОтправки = Ложь Тогда 
								
								Подключение.CommitTrans();
								
								ЗаказОб.КодОтправкиАварда = РСТСтр.Fields("DCODE").Value;
								ЗаказОб.Записать();
								ФлагОтправки = Истина;
								
							КонецЕсли;
							
						КонецЕсли;

					Иначе

						ЗаписьЖурналаРегистрации("Выгрузка заказа поставщику в Аварду",,,, "Ошибка привязки заказа поставщику " + Запросadd + " " + РСТ.Fields("MSG").Value);
						
						СоздатьОповещениеОбИзмененииДляСтороннихСкладов("Выгрузка заказа поставщику в Аварду",
						"Ошибка привязки заказа поставщику " + Запросadd + " " + РСТ.Fields("MSG").Value, Заказ);
						
						СоздатьОповещениеОбОшибкеОтправкиВАварду("Выгрузка заказа поставщику в Аварду",
						"Ошибка привязки заказа поставщику " + Запросadd + " " + РСТ.Fields("MSG").Value, Заказ);
						
						Сообщить("Ошибка привязки заказа поставщику " + РСТ.Fields("MSG").Value);		 
						Подключение.RollbackTrans();
						
						ФлагОтправки = Ложь;

					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;

	Если Константы.ПараллельнаяОтправкаТестовыхЗаказовСтроСкладовВУТ11.Получить() и ОтправлятьВАварду и ФлагОтправки Тогда
		
		ЧислоСекунд = 0;
		ЧислоСекунд = Константы.ДопустимоеОтклонениеОтВремениОтправкиВАварду.Получить();
		
		Если Заказ.IDСклада.ПараллельнаяОтправкаЗаказовВУТ11 Тогда 

			РСГ = РегистрыСведений._НакоплениеДокументовДляПараллельнойОтправкиВБазу.СоздатьМенеджерЗаписи();
			РСГ.Документ = Заказ;
			
			Попытка
				РСГ.Поставщик = Заказ.IDСклада;
			Исключение
			КонецПопытки;
			
			РСГ.ПредполагаемаяДатаОтправки = ?(ЗначениеЗаполнено(ЧислоСекунд), ТекущаяДата() + ЧислоСекунд * 60, 0); 
			РСГ.Записать();
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если не ОтправлятьВАварду Тогда
		РаботаСАвардой.ОтправкаЗаказаВУТ11(Заказ, "СторонниеСкладыВыбор");
	Иначе 
	КонецЕсли;
	
	Возврат ФлагОтправки;
	
КонецФункции

Функция ОтправитьЗаказВЦСВАварду(Заказ, ПрямаяОтправкаВАварду = Ложь)  Экспорт
	
	Если НЕ ПрямаяОтправкаВАварду Тогда
		
		Если Заказ.ГорючиеЖидкости Тогда
			
			Если НЕ (Константы.ОтправлятьЗаказыВСтророннююУТ.Получить() И Заказ.Экспресс) Тогда
				
				Если Константы.ПополнениеДляОбособленногоПодразделенияЮЛ.Получить() И НЕ Заказ.Экспресс И Заказ.Контрагент = Константы.ДопПоставщик.Получить() Тогда
					
					ОтправкаВыполнена = ОтправкаЗаказаПополненияОбособленногоПодразделения(Заказ);
					Возврат ОтправкаВыполнена;
					
				КонецЕсли;
				
				Если Заказ.Экспресс ИЛИ (Не Заказ.Экспресс И Константы.ОтправлятьЗаказыНаГорючиеЖидкостиВУТ11.Получить()) Тогда
					
					Если Заказ.Экспресс И Константы.ОтправлятьЗаказыВСтророннююУТ.Получить() Тогда 
						
						ДокОбъект = Заказ.Получитьобъект();
						ПроверитьЗаказПередОтправкойВТомилино(ДокОбъект);
						
						Если ДокОбъект.ПометкаУдаления Тогда
							Возврат Ложь;
						КонецЕсли;
						
					КонецЕсли;
					
					ОтправкаВыполнена = ОтправкаЗаказаВУТ11(Заказ);
					Возврат ОтправкаВыполнена;	
					
				Иначе
					
					ОтправкаВыполнена = ОтправкаЗаказаВУТ10Восток(Заказ, "ГорючиеЖидкости");
					Возврат ОтправкаВыполнена;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если Константы.ПополнениеДляОбособленногоПодразделенияЮЛ.Получить() И НЕ Заказ.Экспресс И Заказ.Контрагент = Константы.ДопПоставщик.Получить() Тогда
			
			ОтправкаВыполнена = ОтправкаЗаказаПополненияОбособленногоПодразделения(Заказ);
			Возврат ОтправкаВыполнена;
			
		КонецЕсли;
		
		Если  ЗначениеЗаполнено(Заказ.IDСкладаСобственныйСклад) И Заказ.Экспресс  Тогда
			
			Если Заказ.IDСкладаСобственныйСклад.ВэбСервисУТ11 Тогда
				ОтправкаВыполнена = ОтправкаЗаказаПополненияОбособленногоПодразделенияУТ11(Заказ,Заказ.IDСкладаСобственныйСклад);
			Иначе			
				ОтправкаВыполнена = ОтправкаЗаказаПополненияОбособленногоПодразделения(Заказ,Заказ.IDСкладаСобственныйСклад);
			КонецЕсли;
			
			Возврат ОтправкаВыполнена;
			
		КонецЕсли;
		
		Если  Константы.ОтправлятьЗаказыВСтророннююУТ.Получить() И Заказ.РекламнаяПродукция = Ложь Тогда 
			
			Если ОтправкаЗаказаВУТ10Казань(Заказ) = Ложь Тогда
				Возврат Ложь;
			КонецЕсли;
			
		КонецЕсли;	 
		
		Если  Константы.ОтправлятьЗаказыВСтророннююУТ11.Получить() И Заказ.Экспресс = Ложь 
			И Константы.ПриоритетОтправкиЗаказаПоставщику.Получить() = Перечисления.ПриоритетыОтправкиЗаказовПоставщику.УТ11 Тогда
			
			ОтправкаВыполнена = ОтправкаЗаказаВСтороннююУТ11ДоАварды(Заказ);
			
			Если ОтправкаВыполнена Тогда
				Возврат ОтправкаВыполнена;
			КонецЕсли;		
			
		ИначеЕсли  Константы.ОтправлятьЭкспрессыВ.Получить() И Заказ.Экспресс Тогда
			
			Если Константы.ПриоритетОтправкиЭкспрессов.Получить() = Перечисления.ПриоритетыОтправкиЭкспрессов.УТ10 Тогда
				
				ОтправкаВыполнена = ОтправкаЗаказаВУТ10Восток(Заказ);
				Возврат ОтправкаВыполнена;
				
			ИначеЕсли Константы.ПриоритетОтправкиЭкспрессов.Получить() = Перечисления.ПриоритетыОтправкиЭкспрессов.УТ11 Тогда
				
				ОтправкаВыполнена = ОтправкаЗаказаВУТ11(Заказ);
				Возврат ОтправкаВыполнена;
				
			КонецЕсли;		

		КонецЕсли;

	КонецЕсли;	
	
	Подключение = Неопределено;
	RS = Неопределено;
	ОписаниеТиповСтрока = новый ОписаниеТипов("строка", новый квалификаторыстроки(80, ДопустимаяДлина.Переменная));
	ОписаниеТиповДата = новый ОписаниеТипов("Дата", новый квалификаторыДаты(ЧастиДаты.Дата));
	ОписаниеТиповЧисло = новый ОписаниеТипов("число", новый квалификаторычисла(12));
	
	
	Если Заказ.Экспресс тогда
		
		Если Константы.СамовывозПриЭкспрессе.Получить() тогда
			КодДоговора = Константы.КодДоговораЭкспрессСамовывоз.Получить();
		Иначе
			КодДоговора = Константы.КодДоговораЭкспрессДоставка.Получить();			
		КонецЕсли;

	Иначе
		
		Если Константы.СамовывозПриПополнении.Получить() тогда
			КодДоговора = Константы.КодДоговораПополнениеСамовывоз.Получить();
		Иначе
			КодДоговора = Константы.КодДоговораПополнениеДоставка.Получить();			
		КонецЕсли;

	КонецЕсли;

	КодКонтрагента = СокрЛП(Константы.КодКонтрагента.Получить());
	ЗаказОб = Заказ.ПолучитьОбъект();
	КодСотрудника = Константы.КодСотрудникаВАварде.Получить();
	ДобавлятьВРезерв = Ложь;

	Если Константы.НеОтправлятьПополнениеВАварду.Получить() И ПрямаяОтправкаВАварду = Ложь И Константы.ОтправлятьЗаказыВСтророннююУТ11.Получить() И  Заказ.Экспресс = Ложь 
		И Константы.ПриоритетОтправкиЗаказаПоставщику.Получить() = Перечисления.ПриоритетыОтправкиЗаказовПоставщику.Avarda Тогда
		
		Ответ = ОтправкаЗаказаВСтороннююУТ11ПослеАварды(Заказ);
		Возврат Ответ;

	Иначе

		Подключение = Новый COMObject("ADODB.Connection");

		Если Соединение(Подключение) И ЗначениеЗаполнено(КодДоговора) Тогда
			
			Если ЗначениеЗаполнено(КодКонтрагента) тогда
				
				НомерЗаказа = "";
				КодРезерва = СуществуетЗаказВАварде(КодКонтрагента, Заказ.Экспресс, Подключение,НомерЗаказа);
				
				Если КодРезерва <> 0 тогда
					
					#Если НаКлиенте Тогда
						
						СписокКнопок = Новый СписокЗначений;
						СписокКнопок.Добавить(КодВозвратаДиалога.Да, "Добавить в существующий резерв");
						СписокКнопок.Добавить(КодВозвратаДиалога.Нет, "Создать новый резерв");
						
						Ответ = Вопрос("В Аварде уже существует резерв товара по данному виду договора." + Символы.ПС + "Вы хотите добавить товары в резерв?", СписокКнопок, 0);
						
						Если Ответ = КодВозвратаДиалога.Да тогда
							ДобавлятьВРезерв = Истина;
						КонецЕсли;
					#Иначе
						ДобавлятьВРезерв = Истина;
					#КонецЕсли
					
				КонецЕсли;
				
			КонецЕсли;
			
			Если ДобавлятьВРЕзерв тогда
				
				Подключение.BeginTrans();
				Сч = 0;
				
				Для каждого строка из ЗаказОб.Товары Цикл
					
					Сч = Сч + 1;
					
					Если ЗначениеЗаполнено(строка.УИД) Тогда
						УИД = Заказ.Номер + "/" + Формат(Заказ.Дата, "ДЛФ=Д") + "/" + ФорматироватьСтроку(строка.УИД); 
					Иначе
						УИД = Заказ.Номер + "/" + Формат(Заказ.Дата, "ДЛФ=Д") + "/" + строка(Сч);	
					КонецЕсли;
					
					КодТовара = ?(ЗначениеЗаполнено(Строка.Номенклатура.КодАварда), ФорматироватьСтроку(Строка(Строка.Номенклатура.КодАварда)), "null");
					
					Если СЧ = Заказ.Товары.Количество() тогда
						
						Если ЗначениеЗаполнено(Строка.Заказ) тогда
							
							КодПокупателя = ?(ЗначениеЗаполнено(Строка.Заказ.Контрагент.IDАварда), ФорматироватьСтроку(Строка(Строка.Заказ.Контрагент.IDАварда)), 0);
							Запросadd = "SELECT GETBIT1(RESULT,0) as RES, NEWIDLIN, MSG FROM RA_INS_UPDATE_STROKA_IZ_PORT_1C(" + ФорматироватьСтроку(Строка(КодРезерва)) 
							          + "," + КодТовара + ",'" + Строка.Номенклатура.КодПоБазеМоскоречье + "'," + ФорматироватьСтроку(Строка(Строка.Количество)) 
									  + ",'" + УИД + "',1,null," + КодПокупателя + ")"; 									
							
						Иначе
							
							Запросadd = "SELECT GETBIT1(RESULT,0) as RES, NEWIDLIN, MSG FROM RA_INS_UPDATE_STROKA_IZ_PORT_1C(" + ФорматироватьСтроку(Строка(КодРезерва)) 
							          + "," + КодТовара + ",'" + Строка.Номенклатура.КодПоБазеМоскоречье + "'," + ФорматироватьСтроку(Строка(Строка.Количество)) 
									  + ",'" + УИД + "',1,null,0)"; 									
							
						КонецЕсли;
						
					Иначе
						
						Если ЗначениеЗаполнено(Строка.Заказ) тогда
							
							КодПокупателя = ?(ЗначениеЗаполнено(Строка.Заказ.Контрагент.IDАварда), ФорматироватьСтроку(Строка(Строка.Заказ.Контрагент.IDАварда)), 0);
							Запросadd = "SELECT GETBIT1(RESULT,0) as RES, NEWIDLIN, MSG FROM RA_INS_UPDATE_STROKA_IZ_PORT_1C(" + ФорматироватьСтроку(Строка(КодРезерва)) 
							          + "," + КодТовара + ",'" + Строка.Номенклатура.КодПоБазеМоскоречье + "'," + ФорматироватьСтроку(Строка(Строка.Количество)) 
									  + ",'" + УИД + "',0,null," + КодПокупателя + ")"; 									
							
						Иначе
							
							Запросadd = "SELECT GETBIT1(RESULT,0) as RES, NEWIDLIN, MSG FROM RA_INS_UPDATE_STROKA_IZ_PORT_1C(" 
							          + ФорматироватьСтроку(Строка(КодРезерва)) + "," + КодТовара + ",'" + Строка.Номенклатура.КодПоБазеМоскоречье 
									  + "'," + ФорматироватьСтроку(Строка(Строка.Количество)) + ",'" + УИД + "',0,null,0)"; 									
							
						КонецЕсли;
						
					КонецЕсли;
					
					РСТСтр = СформироватьЗапрос(Запросadd,Подключение);
					
					Если РСТСтр = Неопределено Тогда
						
						ЗаписьЖурналаРегистрации("Выгрузка заказа поставщику в Аварду", УровеньЖурналаРегистрации.Ошибка,,, "Ошибка выгрузки заказа поставщику " + Запросadd);
						
						СоздатьОповещениеОбИзмененииДляСтороннихСкладов("Выгрузка заказа поставщику в Аварду",
						"Ошибка выгрузки заказа поставщику " + Запросadd, Заказ);
						
						СоздатьОповещениеОбОшибкеОтправкиВАварду("Выгрузка заказа поставщику в Аварду",
						"Ошибка выгрузки заказа поставщику " + Запросadd, Заказ);
						
						Сообщить ("Ошибка выгрузки строки " + Строка.НомерСтроки + " документа");
						
						Подключение.RollbackTrans();
						Возврат Ложь;
						
					Иначе	
						
						Если РСТСтр.EOF() = 0 Тогда
							
							Если РСТСтр.Fields("RES").Value = 1 тогда
								
							Иначе
								
								ЗаписьЖурналаРегистрации("Выгрузка заказа поставщику в Аварду",,,,"Ошибка привязки строки заказа поставщику " + Запросadd + " " 
								+ РСТСтр.Fields("MSG").Value);
								
								СоздатьОповещениеОбИзмененииДляСтороннихСкладов("Выгрузка заказа поставщику в Аварду",
								"Ошибка привязки строки заказа поставщику " + Запросadd + " " + РСТСтр.Fields("MSG").Value,Заказ);
								
								Сообщить ("Ошибка привязки строки заказа поставщику " + РСТСтр.Fields("MSG").Value);
								
								СоздатьОповещениеОбОшибкеОтправкиВАварду("Выгрузка заказа поставщику в Аварду",
								"Ошибка привязки строки заказа поставщику " + Запросadd + " " + РСТСтр.Fields("MSG").Value,Заказ);								
								Строка.УспешноОтправленаВАварду = Ложь;
								
								Продолжить;
												
							КонецЕсли;
							
							Строка.УспешноОтправленаВАварду = Истина;
							
						КонецЕсли;
						
					КонецЕсли;	
					
				КонецЦикла;
				
				Подключение.CommitTrans();
				
				ЗаказОб.КодОтправкиАварда = НомерЗаказа;
				ЗаказОб.IDАварда = КодРезерва;
				ЗаказОб.Записать();
				
			Иначе
				
				Подключение.BeginTrans();
				Запросadd = "SELECT GETBIT1(RESULT,0) as RES, RESULT, IDDOC, MSG FROM RA_CREATE_6951_SHAPKA_IZPORTALA (" + КодДоговора + "," + КодСотрудника 
				          + ",'Документ отправлен из 1С')"; 
				
				РСТ = СформироватьЗапрос(Запросadd,Подключение);
				
				Если РСТ = Неопределено Тогда
					
					ЗаписьЖурналаРегистрации("Выгрузка заказа поставщику в Аварду",УровеньЖурналаРегистрации.Ошибка,,, "Ошибка выгрузки заказа поставщику " + Запросadd);
					
					СоздатьОповещениеОбОшибкеОтправкиВАварду("Выгрузка заказа поставщику в Аварду",
					"Ошибка выгрузки заказа поставщику " + Запросadd,Заказ);
					
					Сообщить("Ошибка выгрузки документа");
					
				Иначе	
					
					Если РСТ.EOF() = 0 Тогда
						
						Если РСТ.Fields("RES").Value = 1 тогда
							
							ИД = РСТ.Fields("IDDOC").Value;
							Сч = 0;
							
							Для каждого строка из ЗаказОб.Товары Цикл
								
								Сч = Сч + 1;
								КодТовара = ?(ЗначениеЗаполнено(Строка.Номенклатура.КодАварда), ФорматироватьСтроку(Строка(Строка.Номенклатура.КодАварда)), "null");
								
								Если ЗначениеЗаполнено(строка.УИД) Тогда
									УИД = Заказ.Номер + "/" + Формат(Заказ.Дата,"ДЛФ=Д") + "/" + ФорматироватьСтроку(строка.УИД); 
								Иначе
									УИД = Заказ.Номер + "/" + Формат(Заказ.Дата,"ДЛФ=Д") + "/" + строка(Сч);	
								КонецЕсли;
								
								Если СЧ = Заказ.Товары.Количество() тогда
									
									Если ЗначениеЗаполнено(Строка.Заказ) тогда
										
										КодПокупателя = ?(ЗначениеЗаполнено(Строка.Заказ.Контрагент.IDАварда), ФорматироватьСтроку(Строка(Строка.Заказ.Контрагент.IDАварда)), 0);
										Запросadd = "SELECT GETBIT1(RESULT,0) as RES, DCODE, NEWIDLIN, MSG FROM AZ_WRITE_6951_STROKA_IZPORTALA(" 
										          + ФорматироватьСтроку(Строка(ИД)) + "," + КодТовара + ",'" + Строка.Номенклатура.КодПоБазеМоскоречье 
												  + "'," + ФорматироватьСтроку(Строка(Строка.Количество)) + ",'" + УИД + "',1," + КодПокупателя + ")"; 									
										
									Иначе
										
										Запросadd = "SELECT GETBIT1(RESULT,0) as RES, DCODE, NEWIDLIN, MSG FROM RA_WRITE_6951_STR_IZPORTALA(" 
										          + ФорматироватьСтроку(Строка(ИД)) + "," + КодТовара + ",'" + Строка.Номенклатура.КодПоБазеМоскоречье 
												  + "'," + ФорматироватьСтроку(Строка(Строка.Количество)) + ",'" + УИД + "',1)"; 
										
									КонецЕсли;
									
								Иначе
									
									Если ЗначениеЗаполнено(Строка.Заказ) тогда
										
										КодПокупателя = ?(ЗначениеЗаполнено(Строка.Заказ.Контрагент.IDАварда), ФорматироватьСтроку(Строка(Строка.Заказ.Контрагент.IDАварда)), 0);
										Запросadd = "SELECT GETBIT1(RESULT,0) as RES, DCODE, NEWIDLIN, MSG FROM AZ_WRITE_6951_STROKA_IZPORTALA(" 
										          + ФорматироватьСтроку(Строка(ИД)) + "," + КодТовара + ",'" + Строка.Номенклатура.КодПоБазеМоскоречье 
												  + "'," + ФорматироватьСтроку(Строка(Строка.Количество)) + ",'" + УИД + "',0," + КодПокупателя + ")"; 									
										
									Иначе
										
										Запросadd = "SELECT GETBIT1(RESULT,0) as RES, DCODE, NEWIDLIN, MSG FROM RA_WRITE_6951_STR_IZPORTALA(" 
										          + ФорматироватьСтроку(Строка(ИД)) + "," + КодТовара + ",'" + Строка.Номенклатура.КодПоБазеМоскоречье + "'," 
												  + ФорматироватьСтроку(Строка(Строка.Количество)) + ",'" + УИД + "',0)"; 
										
									КонецЕсли;
									
								КонецЕсли;
								
								РСТСтр = СформироватьЗапрос(Запросadd,Подключение);
								
								Если РСТСтр = Неопределено Тогда
									
									ЗаписьЖурналаРегистрации("Выгрузка заказа поставщику в Аварду", УровеньЖурналаРегистрации.Ошибка,,, "Ошибка выгрузки заказа поставщику " 
									                         + Запросadd);
									
									СоздатьОповещениеОбИзмененииДляСтороннихСкладов("Выгрузка заказа поставщику в Аварду",
									"Ошибка выгрузки заказа поставщику " + Запросadd,Заказ);
									
									СоздатьОповещениеОбОшибкеОтправкиВАварду("Выгрузка заказа поставщику в Аварду",
									"Ошибка выгрузки заказа поставщику " + Запросadd,Заказ);
									
									Сообщить("Ошибка выгрузки строки " + Строка.НомерСтроки + " документа");
									
									Подключение.RollbackTrans();
									
									Возврат Ложь;
									
								Иначе	
									
									Если РСТСтр.EOF() = 0 Тогда
										
										Если  РСТСтр.Fields("RES").Value = 1 тогда
										иначе
									
											ЗаписьЖурналаРегистрации("Выгрузка заказа поставщику в Аварду",,,, "Ошибка привязки строки заказа поставщику " + Запросadd 
											+ " " + РСТСтр.Fields("MSG").Value);
											
											СоздатьОповещениеОбИзмененииДляСтороннихСкладов("Выгрузка заказа поставщику в Аварду",
											"Ошибка привязки строки заказа поставщику " + Запросadd + " " + РСТСтр.Fields("MSG").Value, Заказ);
											
											Сообщить("Ошибка привязки строки заказа поставщику " + РСТСтр.Fields("MSG").Value); 											                                                                                                           

											СоздатьОповещениеОбОшибкеОтправкиВАварду("Выгрузка " + СокрЛП(Заказ) + " в Аварду",
											"Ошибка выгрузки строки  " + Строка.НомерСтроки + " документа (резерв) " + Запросadd + " " + РСТСтр.Fields("MSG").Value,Заказ);									
											Строка.УспешноОтправленаВАварду = Ложь;
											
											Продолжить;											
											
										КонецЕсли;
										
										Строка.УспешноОтправленаВАварду = Истина;
										
									КонецЕсли;
									
								КонецЕсли;	
								
							КонецЦикла;
							
							Подключение.CommitTrans();
							
							ЗаказОб.КодОтправкиАварда = РСТСтр.Fields("DCODE").Value;
							ЗаказОб.IDАварда = РСТ.Fields("IDDOC").Value;
							ЗаказОб.Записать();
							
							Подключение.BeginTrans();
							Запросadd = "SELECT GETBIT1(RESULT,0) as RES, RESULT, MSG FROM RA_RESERVE_6951_FROM_PORTAL(" + ФорматироватьСтроку(Строка(ИД)) + ")"; 
							
							РСТ = СформироватьЗапрос(Запросadd,Подключение);
							
							Если РСТ = Неопределено Тогда
								
								ЗаписьЖурналаРегистрации("Выгрузка заказа поставщику в Аварду", УровеньЖурналаРегистрации.Ошибка,,, 
								"Ошибка резервирования заказа поставщику " + Запросadd);
								СоздатьОповещениеОбИзмененииДляСтороннихСкладов("Выгрузка заказа поставщику в Аварду",
								"Ошибка резервирования заказа поставщику " + Запросadd,Заказ);
								
								СоздатьОповещениеОбОшибкеОтправкиВАварду("Выгрузка заказа поставщику в Аварду",
								"Ошибка резервирования заказа поставщику " + Запросadd,Заказ);
								
								Сообщить ("Ошибка выгрузки документа");
								Подключение.RollbackTrans();
								
								Возврат Ложь;
								
							Иначе	
								
								Если РСТ.EOF() = 0 Тогда
									
									Если РСТСтр.Fields("RES").Value = 1 тогда
										
									Иначе
										
										ЗаписьЖурналаРегистрации("Выгрузка заказа поставщику в Аварду", УровеньЖурналаРегистрации.Ошибка,,,
										"Ошибка резервирования заказа поставщику " + Запросadd);
										
										Сообщить ("Ошибка выгрузки документа");							
										
										СоздатьОповещениеОбИзмененииДляСтороннихСкладов("Выгрузка заказа поставщику в Аварду",
										"Ошибка резервирования строки заказа поставщику " + Запросadd + " " + РСТСтр.Fields("MSG").Value,Заказ);

										СоздатьОповещениеОбОшибкеОтправкиВАварду("Выгрузка " + СокрЛП(Заказ) + " в Аварду",
										"" + СокрЛП(Заказ) + " не выгружен в Аварду ! Ошибка привязки последней строки заказа (резерв) " + Запросadd + " " 
										+ РСТСтр.Fields("MSG").Value,Заказ);
										
										ПромТаблЧастьТовары = ЗаказОб.Товары.Выгрузить();
										ПромТаблЧастьТовары.ЗаполнитьЗначения(Ложь, "УспешноОтправленаВАварду");
										ЗаказОб.Товары.Загрузить(ПромТаблЧастьТовары);
										ЗаказОб.Записать();
										
										Подключение.RollbackTrans();
										
										Возврат Ложь;								
										
									КонецЕсли;
									
								КонецЕсли;
								
							КонецЕсли;
							
							Подключение.CommitTrans();
							
							Если ПрямаяОтправкаВАварду = Ложь И Константы.ОтправлятьЗаказыВСтророннююУТ11.Получить() И  Заказ.Экспресс = Ложь 
								И Константы.ПриоритетОтправкиЗаказаПоставщику.Получить() = Перечисления.ПриоритетыОтправкиЗаказовПоставщику.Avarda Тогда
								
								Ответ = ОтправкаЗаказаВСтороннююУТ11ПослеАварды(Заказ);
								Возврат Ответ;
								
							КонецЕсли;
							
							Возврат Истина;
							
						Иначе

							ЗаписьЖурналаРегистрации("Выгрузка заказа поставщику в Аварду",,,, "Ошибка привязки заказа поставщику " + Запросadd + " " + РСТ.Fields("MSG").Value);
							
							СоздатьОповещениеОбИзмененииДляСтороннихСкладов("Выгрузка заказа поставщику в Аварду",
							"Ошибка привязки заказа поставщику " + Запросadd + " " + РСТ.Fields("MSG").Value,Заказ); 
							
							СоздатьОповещениеОбОшибкеОтправкиВАварду("Выгрузка заказа поставщику в Аварду",
							"Ошибка привязки заказа поставщику " + Запросadd + " " + РСТ.Fields("MSG").Value,Заказ);
							
							Сообщить ("Ошибка привязки заказа поставщику " + РСТ.Fields("MSG").Value);		 
							
							Подключение.RollbackTrans();
							
							Возврат Ложь;
							
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;	
	
КонецФункции

Функция ОтправитьЗаказВРаботу(Заказ) Экспорт
	
	Подключение = Неопределено;
	RS = Неопределено;
	
	ОписаниеТиповСтрока = новый ОписаниеТипов("строка", новый квалификаторыстроки(80, ДопустимаяДлина.Переменная));
	ОписаниеТиповДата = новый ОписаниеТипов("Дата", новый квалификаторыДаты(ЧастиДаты.ДатаВремя));
	ОписаниеТиповЧисло = новый ОписаниеТипов("число", новый квалификаторычисла(12));
	
	Подключение = Новый COMObject("ADODB.Connection");
	
	Доставка = Ложь;
	
	Если Заказ.Экспресс тогда
		
		Если Константы.СамовывозПриЭкспрессе.Получить() тогда
			КодДоговора = Константы.КодДоговораЭкспрессСамовывоз.Получить();
		Иначе
			
			КодДоговора = Константы.КодДоговораЭкспрессДоставка.Получить();			
			Доставка = Истина;
			
		КонецЕсли;
	Иначе
		
		Если Константы.СамовывозПриПополнении.Получить() тогда
			КодДоговора = Константы.КодДоговораПополнениеСамовывоз.Получить();
		Иначе
			
			КодДоговора = Константы.КодДоговораПополнениеДоставка.Получить();			
			Доставка = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
	КодКонтрагента = СокрЛП(Константы.КодКонтрагента.Получить());
	ЗаказОб = Заказ.ПолучитьОбъект();
	КодСотрудника = Константы.КодСотрудникаВАварде.Получить();
	МожноОтправлять = Ложь;

	Если Соединение(Подключение) И ЗначениеЗаполнено(КодДоговора) Тогда
		
		Если ЗначениеЗаполнено(КодКонтрагента) тогда
			
			ДатаНТ = "'" + ПолучитьДату(НачалоДня(Заказ.Дата) - 2*24*60*60) + "'";
			ДатаКТ = "'" + ПолучитьДату(КонецДня(ТекущаяДата())) + "'";
			Запросadd = "SELECT DID, DCODE, DDATE1, GETBIT1(FLAG_1,0) AS BIT0, GETBIT1(FLAG_1,1) AS BIT1, GETBIT1(FLAG_1,2) AS BIT2, GETBIT1(FLAG_1,3) AS BIT3  FROM PM_6951_FOR_PORTAL (" 
			+ КодКонтрагента + "," + ДатаНТ + "," + ДатаКТ + ", null, null)"; 
			
			RS = СформироватьЗапрос(Запросadd,Подключение);
			
			Если RS <> Неопределено тогда
				
				ПромТаблица = Новый ТаблицаЗначений;
				ПромТаблица.Очистить();
				
				Для Счетчик = 1 По RS.Fields.Count Цикл
					
					Поле = RS.Fields.Item(Счетчик - 1);
					
					Если СокрЛП(Поле.Name) = "DCODE" Тогда
						Колонка = ПромТаблица.Колонки.Добавить(Поле.Name, ОписаниеТиповСтрока, Поле.Name);
					ИначеЕсли  СокрЛП(Поле.Name) = "DDATE1" тогда
						Колонка = ПромТаблица.Колонки.Добавить(Поле.Name, ОписаниеТиповДата, Поле.Name);
					Иначе					
						Колонка = ПромТаблица.Колонки.Добавить(Поле.Name, ОписаниеТиповЧисло, Поле.Name);
					КонецЕсли;
					
				КонецЦикла;
				
				Пока RS.EOF() = 0 Цикл		
					
					НоваяСтрока = ПромТаблица.Добавить();           		
					
					Для Счетчик = 1 По RS.Fields.Count Цикл 
						
						Поле = RS.Fields.Item(Счетчик - 1);
						НоваяСтрока[Поле.Name] = СокрЛП(Поле.Value);
						
					КонецЦикла;    		
					
					RS.MoveNext(); 		
					
				КонецЦикла;
				
				RS.Close(); 			
				RS = Неопределено;
				
				Для каждого строка из ПромТаблица Цикл
					
					Если Строка.BIT3 = 1 И Строка.DID = Заказ.IDАварда тогда
						МожноОтправлять = Истина;
					КонецЕсли;
					
				КонецЦикла;				
				
			КонецЕсли;
			
			Если МожноОтправлять тогда
				
				Если Доставка тогда
					
					ДатаПодбора = "'" + ПолучитьДатуИВремя(ТекущаяДата() + 4*60*60) + "'";
					ДоставкаДней = 1;
					ИДМаршрута = "0";
					
					Запросadd = "SELECT DATE_TIME_ZAYAVKI, DATE_TIME_OTGRUZKI, DAYS_FOR_DOSTAVKA, DATE_TOVAR_U_CLIENTA, IDMARSHRUT, MARSHRUT FROM RA_CALC_DATES_DOSTAVKI(" 
					          + ФорматироватьСтроку(Строка(Заказ.IDАварда)) + ", " + "'" + ПолучитьДатуИВремя((ТекущаяДата())) + "'" + ", 1)"; 
					
					RS = СформироватьЗапрос(Запросadd,Подключение);
					
					Если RS <> Неопределено тогда
						
						ПромТаблица = Новый ТаблицаЗначений;
						ПромТаблица.Очистить();
						
						Для Счетчик = 1 По RS.Fields.Count Цикл
							
							Поле = RS.Fields.Item(Счетчик - 1);
							
							Если СокрЛП(Поле.Name) = "MARSHRUT" Тогда
								Колонка = ПромТаблица.Колонки.Добавить(Поле.Name,ОписаниеТиповСтрока, Поле.Name);
							ИначеЕсли  СокрЛП(Поле.Name) = "DAYS_FOR_DOSTAVKA" ИЛИ СокрЛП(Поле.Name) = "IDMARSHRUT" тогда
								Колонка = ПромТаблица.Колонки.Добавить(Поле.Name,ОписаниеТиповЧисло, Поле.Name);
							Иначе					
								Колонка = ПромТаблица.Колонки.Добавить(Поле.Name,ОписаниеТиповДата, Поле.Name);
							КонецЕсли;
							
						КонецЦикла;
						
						Пока RS.EOF() = 0 Цикл		
							
							НоваяСтрока = ПромТаблица.Добавить();           		
							
							Для Счетчик = 1 По RS.Fields.Count Цикл 
								
								Поле = RS.Fields.Item(Счетчик - 1);
								НоваяСтрока[Поле.Name] = СокрЛП(Поле.Value);
								
							КонецЦикла;    		
							
							RS.MoveNext(); 		
							
						КонецЦикла;
						
						RS.Close(); 			
						RS = Неопределено;
						
						Если ПромТаблица.Количество()>0 тогда
							
							ДатаПодбора = "'" + ПолучитьДатуИВремя(ПромТаблица[0].DATE_TIME_OTGRUZKI) + "'";
							ДоставкаДней = ПромТаблица[0].DAYS_FOR_DOSTAVKA;
							ИДМаршрута = ФорматироватьСтроку(ПромТаблица[0].IDMARSHRUT);
							
						КонецЕсли;
						
					КонецЕсли;
					
				Иначе
					
					ДатаПодбора = "null";
					ДоставкаДней = "null";
					ИДМаршрута = "null";
					
				КонецЕсли;
				
				Подключение.BeginTrans();
				Запросadd = "SELECT RN_ID, RN_DCODE, GETBIT1(RESULT,0) AS RES, MSG FROM RA_MOVE_DOC_FOR_PORTAL(" + ФорматироватьСтроку(Строка(Заказ.IDАварда)) 
				          + ", " + ДатаПодбора + ", " + ФорматироватьСтроку(ДоставкаДней) + ", " + ДатаПодбора + ",null, null, " + ФорматироватьСтроку(КодСотрудника) 
						  + ", " + ИДМаршрута + ")"; 
				
				RS = СформироватьЗапрос(Запросadd, Подключение);
				
				Если RS = Неопределено Тогда
					
					ЗаписьЖурналаРегистрации("Выгрузка заказа поставщику в Аварду", УровеньЖурналаРегистрации.Ошибка,,, "Ошибка выгрузки заказа поставщику " + Запросadd);
					
					СоздатьОповещениеОбИзмененииДляСтороннихСкладов("Выгрузка заказа поставщику в Аварду",
					"Ошибка выгрузки заказа поставщику " + Запросadd, Заказ);

					СоздатьОповещениеОбОшибкеОтправкиВАварду("Выгрузка заказа поставщику в Аварду",
					"Ошибка выгрузки заказа поставщику (сборка) " + Запросadd, Заказ);
					
					Подключение.RollbackTrans();
					Возврат "Ошибка отправки заказа на сборку";
					
				Иначе	
					
					Если RS.EOF() = 0 Тогда
						
						Если RS.Fields("RES").Value = 1 тогда
							
							ИД = RS.Fields("RN_DCODE").Value;
							Запрос = Новый Запрос;
							Запрос.Текст = "ВЫБРАТЬ
							|	ЗаказПоставщику.Ссылка
							|ИЗ
							|	Документ.ЗаказПоставщику КАК ЗаказПоставщику
							|ГДЕ
							|	ЗаказПоставщику.IDАварда = &IDАварда";
							
							Запрос.УстановитьПараметр("IDАварда", Заказ.IDАварда);
							
							Выб = Запрос.Выполнить().Выбрать();
							
							Пока Выб.Следующий() Цикл
								
								ЗаказОб = Выб.Ссылка.ПолучитьОбъект();
								ЗаказОб.КодОтправкиАварда = ИД;
								
								Попытка
									ЗаказОб.Записать();
								Исключение
								КонецПопытки;
								
							КонецЦикла;
							
							Подключение.CommitTrans();
							Возврат "Заказ отправлен на сборку";
							
						Иначе

							ЗаписьЖурналаРегистрации("Выгрузка заказа поставщику в Аварду",,,,"Ошибка привязки строки заказа поставщику " + Запросadd 
							+ " " + RS.Fields("MSG").Value);
							
							СоздатьОповещениеОбИзмененииДляСтороннихСкладов("Выгрузка заказа поставщику в Аварду",
							"Ошибка привязки строки заказа поставщику " + Запросadd + " " + RS.Fields("MSG").Value, Заказ);

							СоздатьОповещениеОбОшибкеОтправкиВАварду("Выгрузка заказа поставщику в Аварду",
							"Ошибка привязки строки заказа поставщику (сборка) " + Запросadd + " " + RS.Fields("MSG").Value, Заказ);
							
							Подключение.RollbackTrans();
							Возврат "Ошибка отправки заказа на сборку " + RS.Fields("MSG").Value;
							
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;	
								
			Иначе
				Возврат "Данный заказ нельзя отправить на сборку. Возможно он уже отправлен на сборку. Проверьте состояние заказа на портале.";
			КонецЕсли;
					
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат "Ошибка отправки заказа на сборку";   
	
КонецФункции

Функция ИмпортСтатусовЗаказаПоставщикуИзАварды(Заказ)  

	Подключение = Неопределено;
	Подключение = Новый COMObject("ADODB.Connection");
	
	Если Соединение(Подключение) Тогда
		
		КодКонтрагента = СокрЛП(Константы.КодКонтрагента.Получить());
		
		ОписаниеТиповСтрока = новый ОписаниеТипов("Строка", новый КвалификаторыСтроки(80, ДопустимаяДлина.Переменная));
		ОписаниеТиповДата = новый ОписаниеТипов("Дата", новый КвалификаторыДаты(ЧастиДаты.Дата));
		ОписаниеТиповЧисло = новый ОписаниеТипов("Число", новый Квалификаторычисла(12));
		ОписаниеТиповЗаказПоставщика = Новый ОписаниеТипов("ДокументСсылка.ЗаказПоставщику");		
		ОписаниеТиповНоменклатура = Новый ОписаниеТипов("СправочникСсылка.Номенклатура");
		
		СписокОтмененыхЗаказовПоставщика = Новый ТаблицаЗначений;
		
		СписокОтмененыхЗаказовПоставщика.Колонки.Добавить("ЗаказПоставщика", ОписаниеТиповЗаказПоставщика);
		СписокОтмененыхЗаказовПоставщика.Колонки.Добавить("Номенклатура", ОписаниеТиповНоменклатура);
		СписокОтмененыхЗаказовПоставщика.Колонки.Добавить("КодСтроки", ОписаниеТиповЧисло);
		СписокОтмененыхЗаказовПоставщика.Колонки.Добавить("Статус", ОписаниеТиповСтрока);
		
		ДатаНТ = "'" + ПолучитьДату( НачалоДня( ТекущаяДата())) + "'";
		ДатаКТ = "'" + ПолучитьДату( КонецДня( ТекущаяДата())) + "'";			
		
		//Входные параметры:
		//KONTRAGENT_ - идентификатор контрагента
		//BEGIN_DATE_ - начальная дата
		//END_DATE_ - конечная дата
		//DSTATE_ - идентификатор состояния документа (0 - все состояния)
		//FILIALS - список идентификаторов филиалов
		//ARTICUL -артикул для поиска документов с конкретным товаром.
		//     Если товар не найден, процедура ничего не выдает.
		//NOMER_DOC - номер документа (ЗП или РН). Если документ не найден,
		//     процедура ничего не возвращает.  Если найден, диапазон дат не учитывается
		// FIRST 3000
		
		ЗаказыПоставщикуТЗ = Новый ТаблицаЗначений;
		ЗаказыПоставщикуТЗ.Очистить();
		ЗаказыПоставщикуТЗ.Колонки.Добавить("TOVAR_PRIMECH", ОписаниеТиповСтрока, "TOVAR_PRIMECH");
		ЗаказыПоставщикуТЗ.Колонки.Добавить("STATUS", ОписаниеТиповСтрока, "STATUS");
		ЗаказыПоставщикуТЗ.Колонки.Добавить("TOVAR_NAME", ОписаниеТиповСтрока, "TOVAR_NAME");
		ЗаказыПоставщикуТЗ.Колонки.Добавить("KOL_VO", ОписаниеТиповЧисло, "KOL_VO");
		ЗаказыПоставщикуТЗ.Колонки.Добавить("KOEF", ОписаниеТиповЧисло, "KOEF");
		ЗаказыПоставщикуТЗ.Колонки.Добавить("КодЗаказаПоставщику", ОписаниеТиповСтрока, "КодЗаказаПоставщику");
		ЗаказыПоставщикуТЗ.Колонки.Добавить("ДатаЗаказПоставщику", ОписаниеТиповДата, "ДатаЗаказПоставщику");
		ЗаказыПоставщикуТЗ.Колонки.Добавить("КодСтроки", ОписаниеТиповЧисло, "КодСтроки");			
		ЗаказыПоставщикуТЗ.Колонки.Добавить("ЗаказПоставщику", ОписаниеТиповЗаказПоставщика,"ЗаказПоставщику");
		
		Запросadd = "SELECT TOVAR_PRIMECH,cast(STATUS as VARCHAR(1024)) AS STATUS,TOVAR_NAME,KOL_VO,KOEF FROM PM_6951_FOR_PORTAL_EX_NO_SS  (" 
		          + КодКонтрагента + "," + ДатаНТ + "," + ДатаКТ + ", null, null, null," + "'" 
				  + ?(ЗначениеЗаполнено(Заказ.КодОтправкиАварда), СокрЛП(Заказ.КодОтправкиАварда) + "'", "null") + ")"; 		
		
		RS = СформироватьЗапрос(Запросadd, Подключение);
		
		Если RS <> Неопределено тогда                                        

			Пока RS.EOF() = 0 Цикл		
				
				НоваяСтрока = ЗаказыПоставщикуТЗ.Добавить();           		
				
				Для Счетчик = 1 По RS.Fields.Count Цикл 
					
					Поле = RS.Fields.Item(Счетчик - 1);
					НоваяСтрока[Поле.Name] = СокрЛП(Поле.Value);
					
				КонецЦикла;   
				
				МассивСтрок = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(НоваяСтрока["TOVAR_PRIMECH"], "/");
				
				Если МассивСтрок.Количество() >= 3  Тогда
					
					НоваяСтрока["КодЗаказаПоставщику"] = МассивСтрок[0];   
					ДатаЗаказПоставщику = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(МассивСтрок[1], ".");
					
					НоваяСтрока["ДатаЗаказПоставщику"] = Дата(ДатаЗаказПоставщику[2] + ДатаЗаказПоставщику[1] + ДатаЗаказПоставщику[0]);
					НоваяСтрока["КодСтроки"] = МассивСтрок[2];
					НоваяСтрока["ЗаказПоставщику"] = Документы.ЗаказПоставщику.НайтиПоНомеру(НоваяСтрока["КодЗаказаПоставщику"], НачалоГода(НоваяСтрока["ДатаЗаказПоставщику"]));
					
				Иначе 
					
					НоваяСтрока["КодЗаказаПоставщику"] = "Ошибка";   
					НоваяСтрока["ДатаЗаказПоставщику"] = '1900.01.01';
					НоваяСтрока["КодСтроки"] = 0;
					НоваяСтрока["ЗаказПоставщику"] = Документы.ЗаказПоставщику.ПустаяСсылка();
					
				КонецЕсли; 
				
				RS.MoveNext(); 		
				
			КонецЦикла;
			
			RS.Close(); 			
			RS = Неопределено;

		КонецЕсли;
		
		Запрос = Новый Запрос;	

		Запрос.Текст =
		"ВЫБРАТЬ
		|	ВТ.TOVAR_PRIMECH,
		|	ВТ.KOL_VO,
		|	ВТ.KOEF,
		|	ВТ.STATUS,
		|	ВТ.TOVAR_NAME,
		|	ВТ.КодЗаказаПоставщику,
		|	ВТ.ДатаЗаказПоставщику,
		|	ВТ.КодСтроки,
		|	ВТ.ЗаказПоставщику КАК ЗП_ЗаказПоставщикуСсылка
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	&ТЗ КАК ВТ
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ВТ.КодЗаказаПоставщику
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.TOVAR_PRIMECH КАК ВТ_Товар_Примечание,
		|	ВТ.KOL_VO КАК ВТ_Количество,
		|	ВТ.KOEF КАК ВТ_Коэффициент,
		|	ВТ.STATUS КАК ВТ_Статус,
		|	ВТ.TOVAR_NAME КАК ВТ_Номенклатура,
		|	ВТ.КодСтроки КАК ВТ_КодСтроки,
		|	ВТ.ЗП_ЗаказПоставщикуСсылка КАК ЗП_ЗаказПоставщикуСсылка,
		|	ЗП_Товары.Ссылка.ПометкаУдаления КАК ЗП_ПометкаУдаления,
		|	ЕСТЬNULL(ЗП_Товары.Заказ, """") КАК ЗП_Товары_ЗаказПокупателя,
		|	ЕСТЬNULL(ЗП_Товары.УИД, 0) КАК ЗП_Товары_УИД,
		|	ЕСТЬNULL(ЗП_Товары.Номенклатура, """") КАК ЗП_Товары_Номенклатура,
		|	ЕСТЬNULL(ЗП_Товары.Количество, 0) КАК ЗП_Товары_Количество
		|ПОМЕСТИТЬ ВТСписокЗП
		|ИЗ
		|	Документ.ЗаказПоставщику.Товары КАК ЗП_Товары
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ КАК ВТ
		|		ПО (ВТ.ЗП_ЗаказПоставщикуСсылка = ЗП_Товары.Ссылка)
		|			И (ВТ.КодСтроки = ЗП_Товары.УИД)
		|ГДЕ
		|	ЗП_Товары.Ссылка.ПометкаУдаления = ЛОЖЬ
		|	И ЗП_Товары.Ссылка = &Заказ
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ЗП_ЗаказПоставщикуСсылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТСписокЗП.ЗП_ЗаказПоставщикуСсылка КАК ЗП_ЗаказПоставщикуСсылка,
		|	ВТСписокЗП.ЗП_Товары_Номенклатура КАК ЗП_Товары_Номенклатура,
		|	ВТСписокЗП.ВТ_Статус КАК ВТ_Статус,
		|	ВТСписокЗП.ВТ_КодСтроки КАК ВТ_КодСтроки,
		|	-1 * ЕСТЬNULL(ВложенныйЗапрос.Количество, 0) КАК КоличествоКорЗакПост
		|ПОМЕСТИТЬ ВТСписокЗП_2
		|ИЗ
		|	ВТСписокЗП КАК ВТСписокЗП
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			КорректировкаЗаказаПоставщику.ЗаказПоставщику КАК ЗаказПоставщику,
		|			СУММА(КорректировкаЗаказаПоставщикуТовары.Количество) КАК Количество,
		|			КорректировкаЗаказаПоставщикуТовары.Номенклатура КАК Номенклатура
		|		ИЗ
		|			Документ.КорректировкаЗаказаПоставщику.Товары КАК КорректировкаЗаказаПоставщикуТовары
		|				ЛЕВОЕ СОЕДИНЕНИЕ Документ.КорректировкаЗаказаПоставщику КАК КорректировкаЗаказаПоставщику
		|				ПО КорректировкаЗаказаПоставщикуТовары.Ссылка = КорректировкаЗаказаПоставщику.Ссылка
		|		ГДЕ
		|			КорректировкаЗаказаПоставщику.ПометкаУдаления = ЛОЖЬ
		|		
		|		СГРУППИРОВАТЬ ПО
		|			КорректировкаЗаказаПоставщику.ЗаказПоставщику,
		|			КорректировкаЗаказаПоставщикуТовары.Номенклатура) КАК ВложенныйЗапрос
		|		ПО ВТСписокЗП.ЗП_ЗаказПоставщикуСсылка = ВложенныйЗапрос.ЗаказПоставщику
		|			И ВТСписокЗП.ЗП_Товары_Номенклатура = ВложенныйЗапрос.Номенклатура
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ЗП_ЗаказПоставщикуСсылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(ЕСТЬNULL(ВТСписокЗП.ВТ_Количество, 0)) КАК ВТ_Количество,
		|	ЕСТЬNULL(ВТСписокЗП.ЗП_ЗаказПоставщикуСсылка, &Заказ) КАК ЗП_ЗаказПоставщикуСсылка,
		|	ВТСписокЗП.ЗП_Товары_УИД,
		|	ВТСписокЗП.ЗП_Товары_Номенклатура,
		|	ВТСписокЗП.ЗП_Товары_Количество
		|ИЗ
		|	ВТСписокЗП КАК ВТСписокЗП
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСписокЗП_2 КАК ВТСписокЗП_2
		|		ПО ВТСписокЗП.ЗП_ЗаказПоставщикуСсылка = ВТСписокЗП_2.ЗП_ЗаказПоставщикуСсылка
		|			И ВТСписокЗП.ЗП_Товары_Номенклатура = ВТСписокЗП_2.ЗП_Товары_Номенклатура
		|			И ВТСписокЗП.ВТ_Статус = ВТСписокЗП_2.ВТ_Статус
		|			И ВТСписокЗП.ВТ_КодСтроки = ВТСписокЗП_2.ВТ_КодСтроки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыПоставщикам.Остатки(
		|				,
		|				(ЗаказПоставщику, Номенклатура) В
		|					(ВЫБРАТЬ
		|						ВТСписокЗП.ЗП_ЗаказПоставщикуСсылка,
		|						ВТСписокЗП.ЗП_Товары_Номенклатура
		|					ИЗ
		|						ВТСписокЗП КАК ВТСписокЗП)) КАК ЗаказыПоставщикамОстатки
		|		ПО ВТСписокЗП.ЗП_ЗаказПоставщикуСсылка = ЗаказыПоставщикамОстатки.ЗаказПоставщику
		|			И ВТСписокЗП.ЗП_Товары_Номенклатура = ЗаказыПоставщикамОстатки.Номенклатура
		|
		|СГРУППИРОВАТЬ ПО
		|	ЕСТЬNULL(ВТСписокЗП.ЗП_ЗаказПоставщикуСсылка, &Заказ),
		|	ВТСписокЗП.ЗП_Товары_УИД,
		|	ВТСписокЗП.ЗП_Товары_Количество,
		|	ВТСписокЗП.ЗП_Товары_Номенклатура";

		Запрос.УстановитьПараметр("ТЗ", ЗаказыПоставщикуТЗ);
		Запрос.УстановитьПараметр("Заказ", Заказ);
		
		РезультатЗапроса = Запрос.Выполнить().Выгрузить();		
		
		ДокОбъект = Заказ.ПолучитьОбъект();
		Товары = ДокОбъект.Товары;
		ТаблНовЗаказа = Товары.Выгрузить();
		ТаблНовЗаказа.Очистить();

		Для Каждого СтрЗапроса Из РезультатЗапроса Цикл
			
			Если НЕ ЗначениеЗаполнено(СтрЗапроса.ЗП_ЗаказПоставщикуСсылка) Тогда
				Продолжить;
			КонецЕсли;                                                            
			
			Если СтрЗапроса.ВТ_Количество < СтрЗапроса.ЗП_Товары_Количество Тогда
				
				Отбор = Новый Структура("Номенклатура", СтрЗапроса.ЗП_Товары_Номенклатура);
				Отбор.Вставить("УИД", СтрЗапроса.ЗП_Товары_УИД);
				Рез = Товары.НайтиСтроки(Отбор);
				
				Для Каждого СтрРез Из Рез Цикл
					
					НовСтр = ТаблНовЗаказа.Добавить();
					ЗаполнитьЗначенияСвойств(НовСтр, СтрРез);
					
					Если СтрЗапроса.ВТ_Количество = 0 Тогда							
						Товары.Удалить(СтрРез);
					Иначе
						
						НовСтр.Количество = СтрЗапроса.ЗП_Товары_Количество - СтрЗапроса.ВТ_Количество;
						
						//корректировка строки документа
						СтрРез.Количество = СтрЗапроса.ВТ_Количество;
						ОбработкаТабличныхЧастей.РассчитатьКоличествоМестТабЧасти(СтрРез, ДокОбъект);
						ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(СтрРез, ДокОбъект);
						ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(СтрРез, ДокОбъект);														
						
					КонецЕсли;						
					
				КонецЦикла;				
				
			Иначе				
				Продолжить;				
			КонецЕсли; 			
			
		КонецЦикла;		
		
	КонецЕсли; 
	
	Подключение = Неопределено;

	Если Товары.Количество() > 0 Тогда
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);		
	Иначе
		ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		ДокОбъект.УстановитьПометкуУдаления(Истина);				
	КонецЕсли;	
	
	Если ТаблНовЗаказа.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;	
	
	НовЗаказ = ДокОбъект.Скопировать();
	НовЗаказ.Дата = ТекущаяДата();
	НовЗаказ.Комментарий = ""; 
	НовЗаказ.ГУИДЗаказаПокупателя = "";
	НовЗаказ.КодОтправкиАварда = "";
	НовЗаказ.Товары.Очистить(); 
	
	Для Каждого СтрТабл Из ТаблНовЗаказа Цикл
		
		НовСтр = НовЗаказ.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, СтрТабл);		
		НовСтр.Комментарий = "";
		НовСтр.УспешноОтправленаВАварду = Ложь;
		ОбработкаТабличныхЧастей.РассчитатьКоличествоМестТабЧасти(НовСтр, НовЗаказ);
		ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(НовСтр, НовЗаказ);
		ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НовСтр, НовЗаказ);
		
	КонецЦикла;
	
	Попытка
		
		НовЗаказ.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Оперативный);
		ТекстСообщения = "Создан новый документ: " + СокрЛП(НовЗаказ.Ссылка);
		ЗаписьЖурналаРегистрации("Запись заказа по даннывм из аварды до отправки в УТ11", УровеньЖурналаРегистрации.Информация,,, "GoodsReserve.запись_заказа " + ТекстСообщения);
		Сообщить(ТекстСообщения);		

	Исключение
		
		НовЗаказ.Записать(РежимЗаписиДокумента.Запись);
		ТекстСообщения = "Не удалось провести новый документ: " + СокрЛП(НовЗаказ.Ссылка); 
		ЗаписьЖурналаРегистрации("Запись заказа по даннывм из аварды до отправки в УТ11", УровеньЖурналаРегистрации.Ошибка,,, "GoodsReserve.запись_заказа " + ТекстСообщения);
		Сообщить(ТекстСообщения);
		
	КонецПопытки;	
	
	Возврат НовЗаказ;
	
КонецФункции

Функция СуществуетЗаказВАварде(КодКонтрагента, Экспресс, Подключение, НомерЗаказа)
	
	ДатаНТ = "'" + ПолучитьДату(НачалоДня(ТекущаяДата())) + "'";
	ДатаКТ = "'" + ПолучитьДату(КонецДня(ТекущаяДата())) + "'";
	
	ОписаниеТиповСтрока = новый ОписаниеТипов("строка", новый квалификаторыстроки(80, ДопустимаяДлина.Переменная));
	ОписаниеТиповДата   = новый ОписаниеТипов("Дата", новый квалификаторыДаты(ЧастиДаты.Дата));
	ОписаниеТиповЧисло  = новый ОписаниеТипов("число", новый квалификаторычисла(12));
	
	Запросadd = "SELECT DID, DCODE, DDATE1, GETBIT1(FLAG_1,0) AS BIT0, GETBIT1(FLAG_1,1) AS BIT1, GETBIT1(FLAG_1,2) AS BIT2, GETBIT1(FLAG_1,3) AS BIT3  FROM PM_6951_FOR_PORTAL (" 
	          + КодКонтрагента + "," + ДатаНТ + "," + ДатаКТ + ", null, null)"; 
	
	RS = СформироватьЗапрос(Запросadd,Подключение);
	
	Если RS <> Неопределено тогда
		
		ПромТаблица = Новый ТаблицаЗначений;
		ПромТаблица.Очистить();
		
		Для Счетчик = 1 По RS.Fields.Count Цикл
			
			Поле = RS.Fields.Item(Счетчик - 1);
			
			Если СокрЛП(Поле.Name) = "DCODE" Тогда
				Колонка = ПромТаблица.Колонки.Добавить(Поле.Name, ОписаниеТиповСтрока, Поле.Name);
			ИначеЕсли  СокрЛП(Поле.Name) = "DDATE1" тогда
				Колонка = ПромТаблица.Колонки.Добавить(Поле.Name, ОписаниеТиповДата, Поле.Name);
			Иначе					
				Колонка = ПромТаблица.Колонки.Добавить(Поле.Name, ОписаниеТиповЧисло, Поле.Name);
			КонецЕсли;
			
		КонецЦикла;
		
		Пока RS.EOF() = 0 Цикл		
			
			НоваяСтрока = ПромТаблица.Добавить();           		
			
			Для Счетчик = 1 По RS.Fields.Count Цикл 
				
				Поле = RS.Fields.Item(Счетчик - 1);
				НоваяСтрока[Поле.Name] = СокрЛП(Поле.Value);
				
			КонецЦикла;    		
			
			RS.MoveNext(); 		
			
		КонецЦикла;
		
		RS.Close(); 			
		RS = Неопределено;
		
		Табл = ПромТаблица.Скопировать();
		Табл.Очистить();
		
		Для Каждого строка из ПромТаблица Цикл
			
			Если Строка.BIT1 = 1 тогда
				
				Стр = Табл.Добавить();
				ЗаполнитьЗначенияСвойств(Стр, Строка);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ТЗ.DID,
		|	ТЗ.DCODE,
		|	ТЗ.DDATE1,
		|	ТЗ.BIT0,
		|	ТЗ.BIT1 КАК BIT1,
		|	ТЗ.BIT2,
		|	ТЗ.BIT3
		|ПОМЕСТИТЬ ТаблицаАварды
		|ИЗ
		|	&ТЗ КАК ТЗ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗаказПоставщику.Ссылка,
		|	ЗаказПоставщику.IDАварда,
		|	ЗаказПоставщику.Дата КАК Дата
		|ПОМЕСТИТЬ Таблица1С
		|ИЗ
		|	Документ.ЗаказПоставщику КАК ЗаказПоставщику
		|ГДЕ
		|	ЗаказПоставщику.Проведен = ИСТИНА
		|	И ЗаказПоставщику.Дата МЕЖДУ &ДатаН И &ДатаК
		|	И ЗаказПоставщику.Экспресс = &Экспресс
		|	И ЗаказПоставщику.IDАварда <> 0
		|	И ЗаказПоставщику.IDСклада = &ПустойСклад
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата УБЫВ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Таблица1С.IDАварда,
		|	ТаблицаАварды.DID,
		|	ТаблицаАварды.DCODE
		|ИЗ
		|	Таблица1С КАК Таблица1С
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаАварды КАК ТаблицаАварды
		|		ПО Таблица1С.IDАварда = ТаблицаАварды.DID";
		
		Запрос.УстановитьПараметр("ТЗ", Табл);
		Запрос.УстановитьПараметр("ДатаН", НачалоДня(ТекущаяДата()));
		Запрос.УстановитьПараметр("ДатаК", КонецДня(ТекущаяДата()));
		Запрос.УстановитьПараметр("Экспресс", Экспресс);
		Запрос.УстановитьПараметр("ПустойСклад", Справочники.СторонниеСклады.ПустаяСсылка());
		
		Выб = Запрос.Выполнить().Выбрать();
		
		Если Выб.Следующий() И ЗначениеЗаполнено(Выб.DID) тогда
			
			НомерЗаказа = Выб.DCODE; 
			Возврат Выб.DID;
			
		Иначе
			Возврат 0;
		КонецЕсли;
		
	КонецЕсли;

КонецФункции

Процедура ОбновлениеШКНоменклатурыИзАварды() Экспорт

	Если НЕ МСК.ПроверитьПараметрыПодключения() Тогда 
		
		ЗаписьЖурналаРегистрации("Обновление ШК номенклатуры из Аварды", УровеньЖурналаРегистрации.Предупреждение, , ,
		"Отменена работа регламентного задания из-за несоответствия параметров подключения к ИБ");
		Возврат;
		
	КонецЕсли;
	
	Подключение = Неопределено;
	RS = Неопределено;
	
	ОписаниеТиповСтрока = новый ОписаниеТипов("строка", новый квалификаторыстроки(80, ДопустимаяДлина.Переменная));
	ОписаниеТиповЧисло = новый ОписаниеТипов("число", новый квалификаторычисла(12));
	ОписаниеТиповЧислоСРазрядами = новый ОписаниеТипов("число", новый квалификаторычисла(10, 3));
	
	ТаблШК = Новый ТаблицаЗначений;
	Подключение = Новый COMObject("ADODB.Connection");	
	
	Если Соединение(Подключение) Тогда 	
		
		ТекстЗапроса = "select n.ntext1, n.nidlib from nab n where n.nconcept = 100802";
		
		RS = СформироватьЗапрос(ТекстЗапроса, Подключение);
		
		Если RS <> Неопределено тогда
			
			ТаблШК.Очистить();
			
			Для Счетчик = 1 По RS.Fields.Count Цикл
				
				Поле = RS.Fields.Item(Счетчик - 1);
				
				Если СокрЛП(Поле.Name) = "NIDLIB" Тогда
					Колонка = ТаблШК.Колонки.Добавить(Поле.Name,ОписаниеТиповЧисло, Поле.Name); 					
				Иначе
					Колонка = ТаблШК.Колонки.Добавить(Поле.Name,ОписаниеТиповСтрока, Поле.Name);
				КонецЕсли;
				
			КонецЦикла;
			
			Пока RS.EOF() = 0 Цикл		
				
				НоваяСтрока = ТаблШК.Добавить();           		
				
				Для Счетчик = 1 По RS.Fields.Count Цикл 
					
					Поле = RS.Fields.Item(Счетчик - 1);
					НоваяСтрока[Поле.Name] = Поле.Value;			
					
				КонецЦикла;    		
				
				RS.MoveNext(); 		
				
			КонецЦикла;
			
			RS.Close(); 			
			RS = Неопределено;
			
		КонецЕсли;
		
		Для каждого Стр ИЗ ТаблШК Цикл
			
			Товар = Справочники.Номенклатура.НайтиПоРеквизиту("КодАварда", Стр.NIDLIB);
			
			Если Не ЗначениеЗаполнено(Товар) Тогда
				Продолжить;
			КонецЕсли;
			
			СоздатьШтрихкод(Стр.NTEXT1, Товар);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СинхронизацияНоменклатуры(ЗаВесьПериод = ложь) Экспорт

	Подключение = Неопределено;
	RS = Неопределено;
	
	ОписаниеТиповСтрока = новый ОписаниеТипов("строка", новый квалификаторыстроки(80, ДопустимаяДлина.Переменная));
	ОписаниеТиповДата = новый ОписаниеТипов("Дата", новый квалификаторыДаты(ЧастиДаты.Дата));
	ОписаниеТиповЧисло = новый ОписаниеТипов("число", новый квалификаторычисла(12));
	Подключение = Новый COMObject("ADODB.Connection");	
	
	Если Соединение(Подключение) Тогда
		
		Если ЗаВесьПериод тогда
			
			ДатаНТ = "null";
			ДатаКТ = "null";			
			
		Иначе
			
			ДатаНТ = "'" + ПолучитьДату(ТекущаяДата() - 30*24*60*60) + "'";
			ДатаКТ = "'" + ПолучитьДату(КонецГода(ТекущаяДата())) + "'";
			
		КонецЕсли;
		
		ТекстЗапроса = "Select IGRUPPA,ISYSTEMA,IAGREGAT,IDETAL,IDEDIZM,INV,ARTICLE,PROIZV,IDPROIZV,TOVAR_NAME,IDTOV,DATE_SOZD,SOTRUDNIK,KOEF,ABC_XYZ
		|From ({call RA_GET_TOV_FOR_ORA(null,null,null,null," + ДатаНТ + "," + ДатаКТ + ",null,null,null,null,null,null)})";
		
		RS = СформироватьЗапрос(ТекстЗапроса, Подключение);
		
		Если RS <> Неопределено тогда
			
			ПромТаблица = Новый ТаблицаЗначений;
			ПромТаблица.Очистить();
			
			Для Счетчик = 1 По RS.Fields.Count Цикл
				
				Поле = RS.Fields.Item(Счетчик - 1);
				
				Если СокрЛП(Поле.Name) = "IDTOV" ИЛИ СокрЛП(Поле.Name) = "IDEDIZM" ИЛИ СокрЛП(Поле.Name) = "IDPROIZV" ИЛИ СокрЛП(Поле.Name) = "IGRUPPA"
					ИЛИ СокрЛП(Поле.Name) = "ISYSTEMA" ИЛИ СокрЛП(Поле.Name) = "IAGREGAT" ИЛИ СокрЛП(Поле.Name) = "IDETAL" ИЛИ СокрЛП(Поле.Name) = "KOEF" Тогда
					Колонка = ПромТаблица.Колонки.Добавить(Поле.Name,ОписаниеТиповЧисло, Поле.Name);
				ИначеЕсли  СокрЛП(Поле.Name) = "DATE_SOZD" тогда
					Колонка = ПромТаблица.Колонки.Добавить(Поле.Name,ОписаниеТиповДата, Поле.Name);
				Иначе					
					Колонка = ПромТаблица.Колонки.Добавить(Поле.Name,ОписаниеТиповСтрока, Поле.Name);
				КонецЕсли;
				
			КонецЦикла;
			
			Пока RS.EOF() = 0 Цикл		
				
				НоваяСтрока = ПромТаблица.Добавить();           		
				
				Для Счетчик = 1 По RS.Fields.Count Цикл 
					
					Поле = RS.Fields.Item(Счетчик - 1);
					НоваяСтрока[Поле.Name] = СокрЛП(Поле.Value);
					
				КонецЦикла;    		
				
				RS.MoveNext(); 		
				
			КонецЦикла;
			
			RS.Close(); 			
			RS = Неопределено;
			
			НоменклатураПустаяСсылка = Справочники.Номенклатура.ПустаяСсылка();
			ВидНоменклатуры = Справочники.ВидыНоменклатуры.ПустаяСсылка();
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	ПромТаблица.IDTOV,
			|	ПромТаблица.IGRUPPA,
			|	ПромТаблица.ISYSTEMA,
			|	ПромТаблица.IAGREGAT,
			|	ПромТаблица.IDETAL,
			|	ПромТаблица.IDEDIZM,
			|	ПромТаблица.INV,
			|	ПромТаблица.ARTICLE,
			|	ПромТаблица.PROIZV,
			|	ПромТаблица.TOVAR_NAME,
			|	ПромТаблица.DATE_SOZD,
			|	ПромТаблица.SOTRUDNIK,
			|	ПромТаблица.KOEF,
			|	ПромТаблица.ABC_XYZ,
			|	ПромТаблица.IDPROIZV
			|ПОМЕСТИТЬ ПТ
			|ИЗ
			|	&ПромТаблица КАК ПромТаблица
			|ИНДЕКСИРОВАТЬ ПО ПромТаблица.IDTOV 			
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Номенклатура.Ссылка,
			|	ПТ.IDTOV,
			|	ПТ.IGRUPPA,
			|	ПТ.ISYSTEMA,
			|	ПТ.IAGREGAT,
			|	ПТ.IDETAL,
			|	ПТ.IDEDIZM,
			|	ПТ.INV,
			|	ПТ.ARTICLE,
			|	ПТ.PROIZV,
			|	ПТ.TOVAR_NAME,
			|	ПТ.DATE_SOZD,
			|	ПТ.SOTRUDNIK,
			|	ПТ.KOEF,
			|	ПТ.ABC_XYZ,
			|	ПТ.IDPROIZV
			|ПОМЕСТИТЬ ВремТабл
			|ИЗ
			|	ПТ КАК ПТ
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
			|		ПО ПТ.IDTOV = Номенклатура.КодАварда
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВремТабл.IDTOV,
			|	ВремТабл.IAGREGAT,
			|	ВремТабл.IGRUPPA,
			|	ВремТабл.ISYSTEMA,
			|	ВремТабл.IDETAL,
			|	ВремТабл.IDEDIZM,
			|	ВремТабл.INV,
			|	ВремТабл.ARTICLE,
			|	ВремТабл.PROIZV,
			|	ВремТабл.TOVAR_NAME,
			|	ВремТабл.DATE_SOZD,
			|	ВремТабл.SOTRUDNIK,
			|	ВремТабл.IDPROIZV,
			|	ВремТабл.KOEF,
			|	ВремТабл.ABC_XYZ,
			|	ВремТабл.Ссылка
			|ИЗ
			|	ВремТабл КАК ВремТабл
			|ГДЕ
			|	ВремТабл.Ссылка ЕСТЬ NULL";
			
			Запрос.УстановитьПараметр("ПромТаблица", ПромТаблица);
			
			Строка = Запрос.Выполнить().Выбрать();
			
			кол = 0;
			КолДес = 0;
			
			ЗаписьЖурналаРегистрации("Обработка справочника",,,, "Синхронизация номенклатуры");	
			
			ВидНоменклатуры = Константы.ВидНоменклатурыПоУмолчанию.Получить();
			
			Пока Строка.Следующий() Цикл
				
				кол = кол + 1;	
				КолДес = КолДес + 1;					
				
				Если КолДес = 1000 Тогда			
					
					КолДес = 0;
					Текст = ("Обработано строк " + кол);
					ЗаписьЖурналаРегистрации("Обработка справочника",,,, Текст);	
					
				КонецЕсли;
				
				Если ЗначениеЗаполнено(Строка.Ссылка) тогда
					
					Если ЗначениеЗаполнено(Строка.Ссылка.КодАварда) И Не ЗаВесьПериод тогда
						Продолжить;
					Иначе
						
						Если ФорматироватьСтроку(Строка.IDETAL) = 62005750 ИЛИ ФорматироватьСтроку(Строка.IDETAL) = 62004869 
							ИЛИ Не ЗначениеЗаполнено(Строка.IDETAL) ИЛИ Найти(Строка.TOVAR_NAME, "!!!ЗАМЕНА!!!") <> 0 
							ИЛИ Найти(Строка.TOVAR_NAME, "НЕ ПОСТАВЛЯЕТСЯ") <> 0 тогда
							Продолжить
						Иначе
							НовыйЭлемент = Строка.Ссылка.ПолучитьОбъект();
						КонецЕсли;
						
					КонецЕсли;
					
				ИначеЕсли ЗаВесьПериод тогда
					
					Если ФорматироватьСтроку(Строка.IDETAL) = 62005750 ИЛИ ФорматироватьСтроку(Строка.IDETAL) = 62004869 
						ИЛИ Не ЗначениеЗаполнено(Строка.IDETAL) ИЛИ Найти(Строка.TOVAR_NAME, "!!!ЗАМЕНА!!!") <> 0 
						ИЛИ Найти(Строка.TOVAR_NAME, "НЕ ПОСТАВЛЯЕТСЯ") <> 0 тогда
						Продолжить;
					Иначе
						НовыйЭлемент = ПроверитьНоменклатуруПоНормализованномуКоду(СокрЛП(Строка.ARTICLE), 
						               Справочники.Номенклатура.НайтиПоРеквизиту("КодАварда", Строка.IDPROIZV, НоменклатураПустаяСсылка));
					КонецЕсли;					
					
				Иначе
					НовыйЭлемент = ПроверитьНоменклатуруПоНормализованномуКоду(СокрЛП(Строка.ARTICLE), 
					               Справочники.Номенклатура.НайтиПоРеквизиту("КодАварда", Строка.IDPROIZV, НоменклатураПустаяСсылка));
				КонецЕсли;
				
				НовыйЭлемент.ВидНоменклатуры = ВидНоменклатуры;
				НовыйЭлемент.Наименование = СокрЛП(Строка.TOVAR_NAME);
				НовыйЭлемент.НаименованиеПолное = СокрЛП(Строка.ARTICLE) + " " + СокрЛП(Строка.TOVAR_NAME);
				НовыйЭлемент.КодАварда = Строка.IDTOV;
				НовыйЭлемент.КодПоБазеМоскоречье = СокрЛП(Строка.INV);
				НовыйЭлемент.Артикул = СокрЛП(Строка.INV);						
				НовыйЭлемент.БазоваяЕдиницаИзмерения = НайтиЕдИзм(Строка.IDEDIZM);
				НовыйЭлемент.КодПроизводителя = СокрЛП(Строка.ARTICLE);
				НовыйЭлемент.ВестиУчетПоСериям = Истина;
				НовыйЭлемент.ВестиПартионныйУчетПоСериям = Истина;
				НовыйЭлемент.Кратность = Строка.KOEF ;
				НовыйЭлемент.ГруппаАВС = НайтиГруппуАВС(СокрЛП(Строка.ABC_XYZ));
				НовыйЭлемент.НоменклатурнаяГруппа = Справочники.НоменклатурныеГруппы.НайтиПоКоду(ФорматироватьСтроку(Строка.IDETAL));
				НовыйЭлемент.Родитель = Справочники.Номенклатура.НайтиПоРеквизиту("КодАварда", Строка.IDPROIZV, НоменклатураПустаяСсылка); 
				//+Гавриленков В. 05.12.2025 #UT10-5574
				//НовыйЭлемент.СтавкаНДС = Перечисления.СтавкиНДС.НДС20;  
				НовыйЭлемент.СтавкаНДС = ?(ТекущаяДата() >= Дата("20260101000000"), Перечисления.СтавкиНДС.НДС22, Перечисления.СтавкиНДС.НДС20);
				//-Гавриленков В. 05.12.2025 #UT10-5574
				
				Попытка
					
					НовыйЭлемент.Записать();
					
					Если Не ЗначениеЗаполнено(НовыйЭлемент.ЕдиницаХраненияОстатков) тогда
						
						Запрос = Новый Запрос;
						Запрос.Текст = "ВЫБРАТЬ
						|	ЕдиницыИзмерения.Ссылка
						|ИЗ
						|	Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
						|ГДЕ
						|	ЕдиницыИзмерения.Владелец = &Владелец
						|	И ЕдиницыИзмерения.ЕдиницаПоКлассификатору = &ЕдиницаПоКлассификатору";
						
						Запрос.УстановитьПараметр("Владелец", НовыйЭлемент.Ссылка);
						Запрос.УстановитьПараметр("ЕдиницаПоКлассификатору", Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796"));
						
						Выб = Запрос.Выполнить().Выбрать();
						
						Если Выб.Следующий() тогда
							
							НовыйЭлемент.ЕдиницаХраненияОстатков = Выб.Ссылка;
							НовыйЭлемент.ЕдиницаДляОтчетов = Выб.Ссылка;
							
						Иначе
							
							НоваяЕдиница = Справочники.ЕдиницыИзмерения.СоздатьЭлемент();
							НоваяЕдиница.Владелец = НовыйЭлемент.Ссылка;
							НоваяЕдиница.ЕдиницаПоКлассификатору = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796");
							НоваяЕдиница.Наименование = НоваяЕдиница.ЕдиницаПоКлассификатору.Наименование;
							НоваяЕдиница.Записать();
							НовыйЭлемент.ЕдиницаХраненияОстатков = НоваяЕдиница.Ссылка;
							НовыйЭлемент.ЕдиницаДляОтчетов = НоваяЕдиница.Ссылка;
							
						КонецЕсли;
						
						НовыйЭлемент.Записать();
						
					КонецЕсли;
					
				Исключение
					
				КонецПопытки;
				
			КонецЦикла;
			
			ПромТаблица.Очистить(); 			
			
		КонецЕсли;

	КонецЕсли;
	
КонецПроцедуры


///////////////////Филиалы и УТ11///////////////////
Функция ОтправкаЗаказаВУТ10Казань(Заказ)

	ОтправлятьВАварду = Истина;
	ДокОбъект = Заказ.ПолучитьОбъект();
	Товары = ДокОбъект.Товары;
	
	Если Не ДокОбъект.Экспресс Или ЗначениеЗаполнено(ДокОбъект.IDСклада) Тогда
		Возврат ОтправлятьВАварду;
	КонецЕсли;

	ТЗНоменклатуры = Новый ТаблицаЗначений;
	ТЗНоменклатуры.Колонки.Добавить("Номенклатура");
	ТЗНоменклатуры.Колонки.Добавить("Артикул"); //НормализованныйКод				
	ТЗНоменклатуры.Колонки.Добавить("Количество");
	ТЗНоменклатуры.Колонки.Добавить("УИД");		
	ТЗНоменклатуры.Колонки.Добавить("ЕдИзмКод");
	ТЗНоменклатуры.Колонки.Добавить("БазаПолучатель");
	
	Для Каждого СтрТовары Из Товары Цикл			
		
		НовСтрока = ТЗНоменклатуры.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтрока,СтрТовары);
		НовСтрока.Артикул = СокрЛП(СтрТовары.Номенклатура.Артикул); //СтрТовары.Номенклатура.НормализованныйКод;
		НовСтрока.УИД = Строка(СтрТовары.УИД);			
		НовСтрока.ЕдИзмКод = СтрТовары.ЕдиницаИзмерения.ЕдиницаПоКлассификатору.Код;
		НовСтрока.БазаПолучатель = "УТ10Казань";
		
	КонецЦикла;

	Результат = МСКWEB.ЗарезервироватьТоварыВСтороннейБазе(ТЗНоменклатуры);
	
	//Обработка таблицы с ответом
	Если Результат.Загружен Тогда
		
		СписокДанных = Результат.СписокДанных;
		ЗаказанныеТовары = ТЗНоменклатуры;
		ЗаказанныеТовары.Очистить();
		
		Для Каждого Элем Из СписокДанных Цикл
			
			НовСтрока = ЗаказанныеТовары.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока,Элем);
			НовСтрока.Номенклатура = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", Элем.Артикул); //Справочники.Номенклатура.НайтиПоРеквизиту("НормализованныйКод",Элем.НормализованныйКод);
			НовСтрока.УИД = Число(Элем.Комментарий);
			
		КонецЦикла;
		
		ЗаказНомерДата = СписокДанных[0].СтрЗаказ;
		ГУИДЗакПокуп = СписокДанных[0].Заказ;
		
	Иначе
		
		ПроверитьЗаказПередОтправкойВТомилино(ДокОбъект);
		
		ЗаказанныеТовары = Неопределено;
		
		#Если Клиент Тогда
			Сообщить("Получен пустой список строк из сторонней УТ10");
		#ИначеЕсли Сервер Тогда
			ЗаписьЖурналаРегистрации("Получен пустой список строк из сторонней УТ10", УровеньЖурналаРегистрации.Предупреждение,,, "GoodsReserve.получение_заказа");
		#КонецЕсли
		
		РаботаСАвардой.СоздатьОповещениеОбОшибкеОтправкиВАварду("Обратите внимание ! При отправке заказа поставщику возникли проблемы. Заказ не был отправлен",
		"Ошибка отправки " + СокрЛП(Заказ) + " в УТ10 (сервис GoodsReserve.получение_заказа)");
		
		Возврат ОтправлятьВАварду;

	КонецЕсли;
	
	ТаблНовЗаказа = Товары.Выгрузить();
	ТаблНовЗаказа.Очистить(); 	
	
	//Корректировка строк первоначального заказа поставщику и формирование таблицы для заказа по данным из веб-сервиса
	Для Каждого СтрЗаказ Из ЗаказанныеТовары Цикл
		
		Отбор = Новый Структура("Номенклатура",СтрЗаказ.Номенклатура);
		Отбор.Вставить("УИД",СтрЗаказ.УИД);
		Рез = Товары.НайтиСтроки(Отбор);
		КолвоРезерв = СтрЗаказ.Количество;
		
		Если Рез.Количество()>0 Тогда
			
			Для Каждого СтрРез Из Рез Цикл
				
				Если СтрРез.Количество <= КолвоРезерв Тогда
					
					НовСтр = ТаблНовЗаказа.Добавить();
					ЗаполнитьЗначенияСвойств(НовСтр,СтрРез);
					КолвоРезерв = КолвоРезерв - СтрРез.Количество;					
					Товары.Удалить(СтрРез);
					
				ИначеЕсли КолвоРезерв > 0 Тогда
					
					СтрРез.Количество = СтрРез.Количество - КолвоРезерв;
					ОбработкаТабличныхЧастей.РассчитатьКоличествоМестТабЧасти(СтрРез, ДокОбъект);
					ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(СтрРез, ДокОбъект);
					ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(СтрРез, ДокОбъект);
					НовСтр = ТаблНовЗаказа.Добавить();
					ЗаполнитьЗначенияСвойств(НовСтр,СтрРез);
					НовСтр.Количество = КолвоРезерв;					
					КолвоРезерв = 0;
					
				Иначе
					Продолжить;
				КонецЕсли;			
				
				
			КонецЦикла;
		Иначе
			Продолжить;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Товары.Количество() > 0 Тогда
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Иначе
		
		ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		ДокОбъект.УстановитьПометкуУдаления(Истина);		
		ОтправлятьВАварду = Ложь;
		
	КонецЕсли;	
	
	//Создание нового заказа поставщику и заполнение табличной части
	НовЗаказ = ДокОбъект.Скопировать();
	НовЗаказ.Дата = ТекущаяДата();
	НовЗаказ.Организация = Константы.ОсновнаяОрганизация.Получить();
	НовЗаказ.Склад = Константы.ОсновнойСклад.Получить();
	НовЗаказ.Контрагент = Константы.ДопПоставщик.Получить();
	НовЗаказ.ДоговорКонтрагента = НовЗаказ.Контрагент.ОсновнойДоговорКонтрагента;

	Если НЕ НовЗаказ.ДоговорКонтрагента.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком Тогда
		
		СтруктураПараметровДляПолученияДоговора = Новый Структура();
		СписокДопустимыхВидовДоговоров = Новый СписокЗначений();
		СписокДопустимыхВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);
		СтруктураПараметровДляПолученияДоговора.Вставить("СписокДопустимыхВидовДоговоров", СписокДопустимыхВидовДоговоров);
		НовЗаказ.ДоговорКонтрагента = ЗаполнениеДокументов.ПолучитьДоговорПоОрганизацииИКонтрагенту(НовЗаказ.Организация, НовЗаказ.Контрагент, СтруктураПараметровДляПолученияДоговора);
		
		Если НовЗаказ.ДоговорКонтрагента.Пустая() Тогда
			НовЗаказ.ДоговорКонтрагента = НовЗаказ.Контрагент.ОсновнойДоговорКонтрагента; 
		КонецЕсли;				

	КонецЕсли;

	НовЗаказ.Комментарий = ЗаказНомерДата; 
	НовЗаказ.ГУИДЗаказаПокупателя = ГУИДЗакПокуп;
	НовЗаказ.Товары.Очистить();
	НовЗаказ.Записать(РежимЗаписиДокумента.Запись);
	
	Для Каждого СтрТабл Из ТаблНовЗаказа Цикл
		
		НовСтр = НовЗаказ.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр,СтрТабл);		
		НовСтр.Комментарий = СокрЛП(НовЗаказ.Номер) + "/" + Формат(НовЗаказ.Дата,"ДЛФ=D") + "/" + СокрЛП(НовСтр.УИД);
		
		ОбработкаТабличныхЧастей.РассчитатьКоличествоМестТабЧасти(НовСтр, НовЗаказ);
		ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(НовСтр, НовЗаказ);
		ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НовСтр, НовЗаказ);
		
	КонецЦикла;
	
	Попытка
		
		НовЗаказ.Записать(РежимЗаписиДокумента.Проведение,РежимПроведенияДокумента.Оперативный);
		ТекстСообщения = "Создан новый документ: " + СокрЛП(НовЗаказ.Ссылка);
		ЗаписьЖурналаРегистрации("Создание заказа по данным из УТ10", УровеньЖурналаРегистрации.Информация,,, "GoodsReserve.запись_заказа " + ТекстСообщения);
		Сообщить(ТекстСообщения);

	Исключение
		
		НовЗаказ.Записать(РежимЗаписиДокумента.Запись);
		ТекстСообщения = "Не удалось провести новый документ: " + СокрЛП(НовЗаказ.Ссылка); 
		ЗаписьЖурналаРегистрации("Создание заказа по данным из УТ10", УровеньЖурналаРегистрации.Ошибка,,, "GoodsReserve.запись_заказа " + ТекстСообщения);
		Сообщить(ТекстСообщения);
		
	КонецПопытки;	
	
	//Отправка таблицы для заполнения УИД в строках заказа в сторонней базе
	ТЗНоменклатуры.Очистить();
	ТЗНоменклатуры.Колонки.Добавить("Комментарий");
	
	Для Каждого СтрТовары Из НовЗаказ.Товары Цикл			
		
		НовСтрока = ТЗНоменклатуры.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтрока,СтрТовары);
		НовСтрока.Артикул = СокрЛП(СтрТовары.Номенклатура.Артикул); //НормализованныйКод
		НовСтрока.УИД = Строка(СтрТовары.УИД);
		НовСтрока.Комментарий = Строка(СтрТовары.Комментарий);
		
	КонецЦикла;	
	
	МСКWEB.ЗаполнитьУИДвСтрокахЗаказа(ТЗНоменклатуры, ГУИДЗакПокуп);
	
	ПроверитьЗаказПередОтправкойВТомилино(ДокОбъект);
	
	Возврат ОтправлятьВАварду;

КонецФункции

Функция ОтправкаЗаказаВСтороннююУТ11ДоАварды(Заказ)
	
	Ответ = Ложь;
	ДокОбъект = Заказ.ПолучитьОбъект();
	Товары = ДокОбъект.Товары;
	
	//Отправка таблицы товаров в стороннюю базу	
	ТЗНоменклатуры = Новый ТаблицаЗначений;
	ТЗНоменклатуры.Колонки.Добавить("Номенклатура");
	ТЗНоменклатуры.Колонки.Добавить("Артикул");				
	ТЗНоменклатуры.Колонки.Добавить("Количество");
	ТЗНоменклатуры.Колонки.Добавить("ЕдИзмКод");
	ТЗНоменклатуры.Колонки.Добавить("УИД");		
	ТЗНоменклатуры.Колонки.Добавить("Комментарий");
	ТЗНоменклатуры.Колонки.Добавить("Экспресс");
	ТЗНоменклатуры.Колонки.Добавить("ПроверятьОстаток");
	ТЗНоменклатуры.Колонки.Добавить("КодФилиала"); 
	
	ТЗНоменклатуры.Колонки.Добавить("СпособДоставки");		
	
	Если ДокОбъект.Экспресс И Константы.СамовывозПриЭкспрессе.Получить() Или
		Не ДокОбъект.Экспресс И Константы.СамовывозПриПополнении.Получить() Тогда
		СпособДоставки = "Самовывоз";
	Иначе
		СпособДоставки = "НашаДоставка";
	КонецЕсли;

	ТЗНоменклатуры.Колонки.Добавить("СкладскойЗаказ", Новый ОписаниеТипов("Булево"));
    ТЗНоменклатуры.Колонки.Добавить("ГорючиеЖидкости", Новый ОписаниеТипов("Булево"));
	ТЗНоменклатуры.Колонки.Добавить("Секция");
	//+Шульман А. 01.04.2025 #UT10-5173 
	ТЗНоменклатуры.Колонки.Добавить("ПремиальнаяПерекупка", Новый ОписаниеТипов("Булево"));    
	//-Шульман А. 01.04.2025 #UT10-5173

	Для Каждого СтрТовары Из Товары Цикл
		
		СтрТовары.Комментарий = СокрЛП(ДокОбъект.Номер) + "/" + Формат(ДокОбъект.Дата,"ДЛФ=D") + "/" + СокрЛП(СтрТовары.УИД);
		НовСтрока = ТЗНоменклатуры.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтрока,СтрТовары);
		НовСтрока.Артикул = СокрЛП(СтрТовары.Номенклатура.Артикул);
		НовСтрока.ЕдИзмКод = СтрТовары.ЕдиницаИзмерения.ЕдиницаПоКлассификатору.Код;
		НовСтрока.УИД = Строка(СтрТовары.УИД);
		НовСтрока.Экспресс = ДокОбъект.Экспресс;  
		//+Шульман А. 01.04.2025 #UT10-5173 
		НовСтрока.ПремиальнаяПерекупка = ДокОбъект.ПремиальнаяПерекупка;    
		//-Шульман А. 01.04.2025 #UT10-5173
		
		НовСтрока.ПроверятьОстаток = Истина; 
		НовСтрока.СпособДоставки = СпособДоставки; 
		НовСтрока.КодФилиала = СокрЛП(Константы.КодФилиала.Получить());  
		НовСтрока.СкладскойЗаказ = ДокОбъект.СкладскойЗаказ; 
		НовСтрока.ГорючиеЖидкости = ДокОбъект.ГорючиеЖидкости; 		
		
		Если НЕ ДокОбъект.ГорючиеЖидкости И ЗначениеЗаполнено(ДокОбъект.Секция) Тогда
			НовСтрока.Секция = ДокОбъект.Секция; 		
		КонецЕсли;
		
	КонецЦикла;		

	Результат = МСКWEB.ЗарезервироватьТоварыВСтороннейБазе(ТЗНоменклатуры, Истина); 
	
	//Обработка таблицы с ответом
	Если Результат.Загружен Тогда
		
		СписокДанных = Результат.СписокДанных;
		ЗаказанныеТовары = ТЗНоменклатуры;
		ЗаказанныеТовары.Очистить();
		
		Для Каждого Элем Из СписокДанных Цикл
			
			НовСтрока = ЗаказанныеТовары.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока, Элем);
			НовСтрока.Номенклатура = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", Элем.Артикул);
			НовСтрока.УИД = Число(Элем.КодСтроки);
			
		КонецЦикла;
		
		ЗаказНомерДата = СписокДанных[0].СтрЗаказ;
		ГУИДЗакПокуп = СписокДанных[0].Заказ;
		
	Иначе
		
		ЗаказанныеТовары = Неопределено;      
		
		#Если Клиент Тогда
			Сообщить("Получен пустой список строк из сторонней УТ11");
		#ИначеЕсли Сервер Тогда
			ЗаписьЖурналаРегистрации("Получен пустой список строк из сторонней УТ11", УровеньЖурналаРегистрации.Предупреждение,,, "GoodsReserve.получение_заказа");
		#КонецЕсли

		РаботаСАвардой.СоздатьОповещениеОбОшибкеОтправкиВАварду("Обратите внимание, что при отправке заказа поставщику возникли проблемы. Заказ не был отправлен", 
		"Ошибка отправки " + СокрЛП(Заказ) + " в УТ11 (сервис GoodsReserve.получение_заказа)");

		Возврат Ответ;
		
	КонецЕсли;
	
	ТаблНовЗаказа = Товары.Выгрузить();
	ТаблНовЗаказа.Очистить();
	
	СтрокиДляУдаления = Новый Массив;
	
	//Корректировка строк первоначального заказа поставщику и формирование таблицы для нового заказа
	Для Каждого СтрТовары Из Товары Цикл
		
		Отбор = Новый Структура("Номенклатура", СтрТовары.Номенклатура);
		Отбор.Вставить("УИД", СтрТовары.УИД);
		
		Рез = ЗаказанныеТовары.НайтиСтроки(Отбор);
		
		Если Рез.Количество() = 0 Тогда
			
			//добавление в таблицу
			НовСтр = ТаблНовЗаказа.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр, СтрТовары);			
			СтрокиДляУдаления.Добавить(СтрТовары);
			
			Продолжить;
			
		КонецЕсли;			
		
		КолвоРезерв = Рез[0].Количество;		
		
		Если КолвоРезерв < СтрТовары.Количество Тогда
			
			//добавление в таблицу
			НовСтр = ТаблНовЗаказа.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр, СтрТовары);
			НовСтр.Количество = СтрТовары.Количество - КолвоРезерв;
			
			//корректировка текущей строки
			СтрТовары.Количество = КолвоРезерв;
			СтрТовары.УспешноОтправленаВАварду = Истина;
			ОбработкаТабличныхЧастей.РассчитатьКоличествоМестТабЧасти(СтрТовары, ДокОбъект);
			ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(СтрТовары, ДокОбъект);
			ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(СтрТовары, ДокОбъект);
			
		Иначе
			СтрТовары.УспешноОтправленаВАварду = Истина;
		КонецЕсли;				

	КонецЦикла;
	
	//Удаление строк из документа, которые не удалось заказать
	Для Каждого СтрУдаления Из СтрокиДляУдаления Цикл
		Товары.Удалить(СтрУдаления);
	КонецЦикла;
	
	ДокОбъект.Комментарий = ?(ДокОбъект.Экспресс, ЗаказНомерДата + " (УТ11)", ЗаказНомерДата + " (УТ11) " + СокрЛП(ДокОбъект.Комментарий));	
	ДокОбъект.ГУИДЗаказаПокупателя = ГУИДЗакПокуп;
	ДокОбъект.КодОтправкиАварда = ЗаказНомерДата;	
	
	//Перепроводим документ если есть заказанные товары или помечаем на удаление
	Если Товары.Количество() > 0 Тогда
		
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Ответ = Истина;
		
	Иначе
		
		ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		ДокОбъект.УстановитьПометкуУдаления(Истина);		
		Ответ = Истина;		
		
	КонецЕсли;	
	
	//Если все товары заказаны то не создаем нового заказа и прерываем процедуру
	Если ТаблНовЗаказа.Количество() = 0 Тогда
		Возврат Ответ;
	КонецЕсли;	
	
	//Создание нового заказа поставщику и заполнение табличной части
	НовЗаказ = ДокОбъект.Скопировать();
	НовЗаказ.Дата = ТекущаяДата();
	НовЗаказ.Комментарий = ""; 
	НовЗаказ.ГУИДЗаказаПокупателя = "";
	НовЗаказ.КодОтправкиАварда = "";
	НовЗаказ.Товары.Очистить();
	НовЗаказ.Записать(РежимЗаписиДокумента.Запись);
	
	Для Каждого СтрТабл Из ТаблНовЗаказа Цикл
		
		НовСтр = НовЗаказ.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, СтрТабл);		
		НовСтр.Комментарий = "";
		ОбработкаТабличныхЧастей.РассчитатьКоличествоМестТабЧасти(НовСтр, НовЗаказ);
		ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(НовСтр, НовЗаказ);
		ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НовСтр, НовЗаказ);
		
	КонецЦикла;
	
	Попытка
		
		НовЗаказ.Записать(РежимЗаписиДокумента.Проведение,РежимПроведенияДокумента.Оперативный);
		ТекстСообщения = "Создан новый документ: " + СокрЛП(НовЗаказ.Ссылка);
		ЗаписьЖурналаРегистрации("Создание заказа по данным из УТ11", УровеньЖурналаРегистрации.Информация,,, "GoodsReserve.запись_заказа " + ТекстСообщения);
		Сообщить(ТекстСообщения);		
		
	Исключение
		
		НовЗаказ.Записать(РежимЗаписиДокумента.Запись);
		ТекстСообщения = "Не удалось провести новый документ: " + СокрЛП(НовЗаказ.Ссылка); 
		ЗаписьЖурналаРегистрации("Создание заказа по данным из УТ11", УровеньЖурналаРегистрации.Ошибка,,, "GoodsReserve.запись_заказа " + ТекстСообщения);
		Сообщить(ТекстСообщения);
		
	КонецПопытки;	
	
	Если НовЗаказ.Проведен Тогда
		
		Попытка
			
			ПрямаяОтправкаВАварду = Истина;
			ОтправитьЗаказВЦСВАварду(НовЗаказ.Ссылка, ПрямаяОтправкаВАварду);
			ТекстСообщения = "В аварду был отправлен документ: " + СокрЛП(НовЗаказ.Ссылка); 
			ЗаписьЖурналаРегистрации("Отправка в аварду созданного заказа по данным из УТ11", УровеньЖурналаРегистрации.Информация,,,
			"GoodsReserve.отправка_заказа_вАварду " + ТекстСообщения);
			Сообщить(ТекстСообщения);
			
		Исключение
			
			ТекстСообщения = "Не удалось отправить в аварду документ: " + СокрЛП(НовЗаказ.Ссылка); 
			ЗаписьЖурналаРегистрации("Ошибка отправки в аварду созданного заказа по данным из УТ11", УровеньЖурналаРегистрации.Ошибка,,,
			"GoodsReserve.отправка_заказа_вАварду " + ТекстСообщения);
			Сообщить(ТекстСообщения);
			
		КонецПопытки;
		
	КонецЕсли;		
	
	Возврат Ответ;

КонецФункции

Функция ОтправкаЗаказаВСтороннююУТ11ПослеАварды(Заказ)
	
	Если Константы.НеОтправлятьПополнениеВАварду.Получить() тогда
		НовыйЗаказ = Заказ.ПолучитьОбъект();
	Иначе
		НовыйЗаказ = ИмпортСтатусовЗаказаПоставщикуИзАварды(Заказ);
	КонецЕсли;
	
	Если НовыйЗаказ = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Ответ = Ложь;
	ДокОбъект = НовыйЗаказ;
	Товары = ДокОбъект.Товары;
	
	//Отправка таблицы товаров в стороннюю базу
	ТЗНоменклатуры = Новый ТаблицаЗначений;
	ТЗНоменклатуры.Колонки.Добавить("Номенклатура");
	ТЗНоменклатуры.Колонки.Добавить("Артикул");				
	ТЗНоменклатуры.Колонки.Добавить("Количество");
	ТЗНоменклатуры.Колонки.Добавить("ЕдИзмКод");
	ТЗНоменклатуры.Колонки.Добавить("УИД");		
	ТЗНоменклатуры.Колонки.Добавить("Комментарий");
	ТЗНоменклатуры.Колонки.Добавить("Экспресс");
	ТЗНоменклатуры.Колонки.Добавить("ПроверятьОстаток");
	ТЗНоменклатуры.Колонки.Добавить("КодФилиала"); 
	ТЗНоменклатуры.Колонки.Добавить("СпособДоставки");		
	
	Если ДокОбъект.Экспресс И Константы.СамовывозПриЭкспрессе.Получить() Или
		Не ДокОбъект.Экспресс И Константы.СамовывозПриПополнении.Получить() Тогда
		СпособДоставки = "Самовывоз";
	Иначе
		СпособДоставки = "НашаДоставка";
	КонецЕсли;
	
	ТЗНоменклатуры.Колонки.Добавить("СкладскойЗаказ", Новый ОписаниеТипов("Булево"));
    ТЗНоменклатуры.Колонки.Добавить("ГорючиеЖидкости", Новый ОписаниеТипов("Булево")); 
	ТЗНоменклатуры.Колонки.Добавить("Секция");
	//+Шульман А. 01.04.2025 #UT10-5173 
	ТЗНоменклатуры.Колонки.Добавить("ПремиальнаяПерекупка", Новый ОписаниеТипов("Булево"));    
	//-Шульман А. 01.04.2025 #UT10-5173
	
	Для Каждого СтрТовары Из Товары Цикл
		
		СтрТовары.Комментарий = СокрЛП(ДокОбъект.Номер) + "/" + Формат(ДокОбъект.Дата,"ДЛФ=D") + "/" + СокрЛП(СтрТовары.УИД);
		НовСтрока = ТЗНоменклатуры.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтрока,СтрТовары);
		НовСтрока.Артикул = СокрЛП(СтрТовары.Номенклатура.Артикул);
		НовСтрока.ЕдИзмКод = СтрТовары.ЕдиницаИзмерения.ЕдиницаПоКлассификатору.Код;
		НовСтрока.УИД = Строка(СтрТовары.УИД);
		НовСтрока.Экспресс = ДокОбъект.Экспресс;   
		//+Шульман А. 01.04.2025 #UT10-5173 
		НовСтрока.ПремиальнаяПерекупка = ДокОбъект.ПремиальнаяПерекупка;   
		//-Шульман А. 01.04.2025 #UT10-5173
		
		НовСтрока.ПроверятьОстаток = Ложь;
		НовСтрока.СпособДоставки = СпособДоставки; 
		НовСтрока.КодФилиала = СокрЛП(Константы.КодФилиала.Получить()); 
		НовСтрока.СкладскойЗаказ = ДокОбъект.СкладскойЗаказ; 
		НовСтрока.ГорючиеЖидкости = ДокОбъект.ГорючиеЖидкости;  
		
		Если НЕ ДокОбъект.ГорючиеЖидкости И ЗначениеЗаполнено(ДокОбъект.Секция) Тогда
			НовСтрока.Секция = ДокОбъект.Секция; 		
		КонецЕсли;

	КонецЦикла;		
	
	Результат = МСКWEB.ЗарезервироватьТоварыВСтороннейБазе(ТЗНоменклатуры, Истина);	
	
	//Обработка таблицы с ответом
	Если Результат.Загружен Тогда
		
		СписокДанных = Результат.СписокДанных;
		ЗаказанныеТовары = ТЗНоменклатуры;
		ЗаказанныеТовары.Очистить();
		
		Для Каждого Элем Из СписокДанных Цикл
			
			КодСтроки = Число(Элем.КодСтроки);					
			НовСтрока = ЗаказанныеТовары.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока,Элем);
			НовСтрока.Номенклатура = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", Элем.Артикул);			
			НовСтрока.УИД = ?(КодСтроки > 10000, КодСтроки - 10000, КодСтроки);
			
		КонецЦикла;
		
		ЗаказНомерДата = СписокДанных[0].СтрЗаказ;
		ГУИДЗакПокуп = СписокДанных[0].Заказ;

	Иначе
		
		ЗаказанныеТовары = Неопределено;
		
		#Если Клиент Тогда
			Сообщить("Получен пустой список строк из сторонней УТ11");
		#ИначеЕсли Сервер Тогда
			ЗаписьЖурналаРегистрации("Получен пустой список строк из сторонней УТ11", УровеньЖурналаРегистрации.Предупреждение,,, "GoodsReserve.получение_заказа");
		#КонецЕсли
		
		РаботаСАвардой.СоздатьОповещениеОбОшибкеОтправкиВАварду("Обратите внимание, что при отправке заказа поставщику возникли проблемы. Заказ не был отправлен",
		"Ошибка отправки " + СокрЛП(Заказ) + " в УТ11 (сервис GoodsReserve.получение_заказа)");
		Возврат Ответ;
		
	КонецЕсли;
	
	//Заполнение строк
	Для Каждого СтрЗаказ Из ЗаказанныеТовары Цикл
		
		Отбор = Новый Структура("Номенклатура", СтрЗаказ.Номенклатура);
		Отбор.Вставить("УИД", СтрЗаказ.УИД);
		Рез = Товары.НайтиСтроки(Отбор);
		
		Если Рез.Количество() > 0 Тогда
			
			Для Каждого СтрРез Из Рез Цикл
				СтрРез.УспешноОтправленаВАварду = Истина;
			КонецЦикла;
			
		Иначе
			
			СоздатьОповещениеОбОшибкеОтправкиВАварду("Выгрузка заказа поставщику в УТ11",
			"Ошибка привязки строки заказа поставщику УИД " + СтрЗаказ.УИД + " арт. " + СтрЗаказ.Артикул, Заказ);
			
		КонецЕсли;

	КонецЦикла;
	
	ДокОбъект.Комментарий = ?(ДокОбъект.Экспресс, ЗаказНомерДата + " (УТ11)", ЗаказНомерДата + " (УТ11) " + СокрЛП(ДокОбъект.Комментарий));	
	ДокОбъект.ГУИДЗаказаПокупателя = ГУИДЗакПокуп;
	ДокОбъект.КодОтправкиАварда = ЗаказНомерДата;
	
	ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	
	ТекстСообщения = "Перезаписан документ: " + СокрЛП(ДокОбъект.Ссылка);
	ЗаписьЖурналаРегистрации("Перезаписан заказ по данным из УТ11", УровеньЖурналаРегистрации.Информация,,, "GoodsReserve.запись_заказа " + ТекстСообщения);
	
	Ответ = Истина;
	
	Возврат Ответ;	
	
КонецФункции

Функция ОтправкаЗаказаВУТ10Восток(Заказ, ВидОперации = "Экспрессы")

	Ответ = Ложь;
	ДокОбъект = Заказ.ПолучитьОбъект();
	Товары = ДокОбъект.Товары;
	
	//Отправка таблицы товаров в стороннюю базу	
	ТЗНоменклатуры = Новый ТаблицаЗначений;
	ТЗНоменклатуры.Колонки.Добавить("Номенклатура");
	ТЗНоменклатуры.Колонки.Добавить("Артикул");
	ТЗНоменклатуры.Колонки.Добавить("Количество");
	ТЗНоменклатуры.Колонки.Добавить("УИД");
	ТЗНоменклатуры.Колонки.Добавить("ЕдИзмКод");
	ТЗНоменклатуры.Колонки.Добавить("БазаПолучатель");	
	ТЗНоменклатуры.Колонки.Добавить("Комментарий");
	
	Для Каждого СтрТовары Из Товары Цикл			
		
		СтрТовары.Комментарий = СокрЛП(ДокОбъект.Номер) + "/" + Формат(ДокОбъект.Дата, "ДЛФ=D") + "/" + СокрЛП(СтрТовары.УИД);
		НовСтрока = ТЗНоменклатуры.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтрока,СтрТовары);
		НовСтрока.Артикул = СокрЛП(СтрТовары.Номенклатура.Артикул);
		НовСтрока.УИД = Строка(СтрТовары.УИД);			
		НовСтрока.ЕдИзмКод = СтрТовары.ЕдиницаИзмерения.ЕдиницаПоКлассификатору.Код;
		НовСтрока.БазаПолучатель = "УТ10Восток" + ВидОперации;				
		
	КонецЦикла;
	
	Результат = МСКWEB.ЗарезервироватьТоварыВСтороннейБазе(ТЗНоменклатуры, Ложь, ВидОперации); 
	
	//Обработка таблицы с ответом
	Если Результат.Загружен Тогда
		
		СписокДанных = Результат.СписокДанных;
		ЗаказанныеТовары = ТЗНоменклатуры;
		ЗаказанныеТовары.Очистить();
		
		Для Каждого Элем Из СписокДанных Цикл			
			
			НовСтрока = ЗаказанныеТовары.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока,Элем);
			НовСтрока.Номенклатура = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", Элем.Артикул);

		КонецЦикла;
		
		ЗаказНомерДата = СписокДанных[0].СтрЗаказ;
		ГУИДЗакПокуп = СписокДанных[0].Заказ;
		
	Иначе
		
		ЗаказанныеТовары = Неопределено;   
		
		#Если Клиент Тогда
			Сообщить("Получен пустой список строк из сторонней УТ10");
		#ИначеЕсли Сервер Тогда
			ЗаписьЖурналаРегистрации("Получен пустой список строк из сторонней УТ10", УровеньЖурналаРегистрации.Предупреждение,,, "GoodsReserve.получение_заказа");
		#КонецЕсли
		
		РаботаСАвардой.СоздатьОповещениеОбОшибкеОтправкиВАварду("Обратите внимание, что при отправке заказа поставщику возникли проблемы. Заказ не был отправлен",
		"Ошибка отправки " + СокрЛП(Заказ) + " в УТ10 (сервис GoodsReserve.получение_заказа)");
		Возврат Ответ;
		
	КонецЕсли;
	
	ТаблНовЗаказа = Товары.Выгрузить();
	ТаблНовЗаказа.Очистить();			
	
	//Заполнение строк
	Для Каждого СтрЗаказ Из ЗаказанныеТовары Цикл
		
		Отбор = Новый Структура("Номенклатура", СтрЗаказ.Номенклатура);
		Отбор.Вставить("Комментарий", СтрЗаказ.Комментарий);
		Рез = Товары.НайтиСтроки(Отбор);
		
		Если Рез.Количество()>0 Тогда
			
			Для Каждого СтрРез Из Рез Цикл
				СтрРез.УспешноОтправленаВАварду = Истина;
			КонецЦикла;
			
		Иначе
			
			СоздатьОповещениеОбОшибкеОтправкиВАварду("Выгрузка заказа поставщику в УТ10",
			"Ошибка привязки строки заказа поставщику УИД " + СтрЗаказ.УИД + " арт. " + СтрЗаказ.Артикул,Заказ);
			
		КонецЕсли;

	КонецЦикла;
	
	ОписаниеТиповСтрока = Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(80, ДопустимаяДлина.Переменная));
	ОписаниеТиповЧисло = Новый ОписаниеТипов("Число", Новый Квалификаторычисла(12));
	ОписаниеТиповЗаказПоставщика = Новый ОписаниеТипов("ДокументСсылка.ЗаказПоставщику");		
	ОписаниеТиповНоменклатура = Новый ОписаниеТипов("СправочникСсылка.Номенклатура");
	
	ОтмененныеСтрокиЗаказа = Новый ТаблицаЗначений;		
	ОтмененныеСтрокиЗаказа.Колонки.Добавить("ЗаказПоставщика", ОписаниеТиповЗаказПоставщика);
	ОтмененныеСтрокиЗаказа.Колонки.Добавить("Номенклатура", ОписаниеТиповНоменклатура);
	ОтмененныеСтрокиЗаказа.Колонки.Добавить("КодСтроки", ОписаниеТиповЧисло);
	ОтмененныеСтрокиЗаказа.Колонки.Добавить("Статус", ОписаниеТиповСтрока);
	
	МЗИстория = Неопределено;
	
	Отбор = Новый Структура("УспешноОтправленаВАварду",Ложь);
	Рез = Товары.НайтиСтроки(Отбор);
	
	Для Каждого СтрРез Из Рез Цикл
		
		//пишем в регистр
		МЗИстория = РегистрыСведений.ИсторияХраненияИзмененийЗагружСтатусов.СоздатьМенеджерЗаписи();
		МЗИстория.Документ = Заказ;
		МЗИстория.Номенклатура = СтрРез.Номенклатура;
		МЗИстория.КодСтроки	= СтрРез.УИД;
		МЗИстория.Статус = "120; нет на складе";			
		МЗИстория.КоличествоAvarda = 0;
		МЗИстория.КоличествоЗаказПоставщика = СтрРез.Количество;
		МЗИстория.КоличествоКорЗаказаПоставщика = 0;
		МЗИстория.КоличествоОстатокПоСкладу = СтрРез.Количество;
		МЗИстория.ЗаказПокупателя = СтрРез.Заказ;
		МЗИстория.ДатаЗагрузки = ТекущаяДата();
		МЗИстория.Записать();
		НоваяСтрока = ОтмененныеСтрокиЗаказа.Добавить();
		НоваяСтрока.ЗаказПоставщика = Заказ;
		НоваяСтрока.Номенклатура = СтрРез.Номенклатура;
		НоваяСтрока.КодСтроки 	= СтрРез.УИД;
		НоваяСтрока.Статус = "120; нет на складе";				
		СтрРез.УспешноОтправленаВАварду = Истина;

	КонецЦикла;
	
	ДокОбъект.Комментарий = ЗаказНомерДата + " (Восток)"; 
	ДокОбъект.ГУИДЗаказаПокупателя = ГУИДЗакПокуп;
	ДокОбъект.КодОтправкиАварда = ЗаказНомерДата;
	
	ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	ТекстСообщения = "Перезаписан документ: " + СокрЛП(ДокОбъект.Ссылка);
	ЗаписьЖурналаРегистрации("Перезаписан заказ по данным из УТ10", УровеньЖурналаРегистрации.Информация,,, "GoodsReserve.запись_заказа " + ТекстСообщения);
	Ответ = Истина;
	
	Если Не МЗИстория = Неопределено Тогда 
		
		ОбработкаИмпортаСтатусов = Обработки.ИмпортСтатусаЗаказаПоставщикаИзAvarda.Создать();
		СтатусТЗ = ОбработкаИмпортаСтатусов.СписокОтмененыхСтатусов();
		ОбработкаИмпортаСтатусов.ОбработатьСтатус120НетНаскладе(СтатусТЗ, ОтмененныеСтрокиЗаказа);

	КонецЕсли;
	
	Возврат Ответ;	
	
КонецФункции

Функция ОтправкаЗаказаВУТ11(Заказ, ВидОперации = "Экспрессы", КодМТ = Неопределено) Экспорт
	
	Ответ = Ложь;
	ДокОбъект = Заказ.ПолучитьОбъект();
	Товары = ДокОбъект.Товары;
	
	//Отправка таблицы товаров в стороннюю базу
	ТЗНоменклатуры = Новый ТаблицаЗначений;
	ТЗНоменклатуры.Колонки.Добавить("Номенклатура");
	ТЗНоменклатуры.Колонки.Добавить("Артикул");				
	ТЗНоменклатуры.Колонки.Добавить("Количество");
	ТЗНоменклатуры.Колонки.Добавить("ЕдИзмКод");
	ТЗНоменклатуры.Колонки.Добавить("УИД");		
	ТЗНоменклатуры.Колонки.Добавить("Комментарий");
	ТЗНоменклатуры.Колонки.Добавить("Экспресс");
	ТЗНоменклатуры.Колонки.Добавить("ПроверятьОстаток");
	ТЗНоменклатуры.Колонки.Добавить("КодФилиала"); 
	ТЗНоменклатуры.Колонки.Добавить("КодМДМСклада");
	ТЗНоменклатуры.Колонки.Добавить("Цена");
	ТЗНоменклатуры.Колонки.Добавить("ЦенаПоставщика");
	ТЗНоменклатуры.Колонки.Добавить("ПроизводительПоставщика"); 
	ТЗНоменклатуры.Колонки.Добавить("СкладскойЗаказ",Новый ОписаниеТипов("Булево")); 
	ТЗНоменклатуры.Колонки.Добавить("СпособДоставки");		
	
	Если ДокОбъект.Экспресс И Константы.СамовывозПриЭкспрессе.Получить() Или
		Не ДокОбъект.Экспресс И Константы.СамовывозПриПополнении.Получить() Тогда
		СпособДоставки = "Самовывоз";
	Иначе
		СпособДоставки = "НашаДоставка";
	КонецЕсли;

	ТЗНоменклатуры.Колонки.Добавить("ГорючиеЖидкости", Новый ОписаниеТипов("Булево"));    
	//+Шульман А. 01.04.2025 #UT10-5173 
	ТЗНоменклатуры.Колонки.Добавить("ПремиальнаяПерекупка", Новый ОписаниеТипов("Булево"));    
	//-Шульман А. 01.04.2025 #UT10-5173
	
	//+Шульман А. 28.07.2025 #UT10-5636
	ПремиальнаяПерекупка = ДокОбъект.ПремиальнаяПерекупка;
	//-Шульман А. 28.07.2025 #UT10-5636
	
	Для Каждого СтрТовары Из Товары Цикл
		
		ФлагОтказатьВОтгрузкеУжеОтгрууженного = Ложь;
		
		Попытка
			
			Если Найти(ВидОперации, "Сторонние") > 0 и СтрТовары.УспешноОтправленаВАварду Тогда 
				ФлагОтказатьВОтгрузкеУжеОтгрууженного = Истина;
			КонецЕсли;
			
		Исключение
			
			СтрОшибка = ОписаниеОшибки();
			ЗаписьЖурналаРегистрации("ошибка проверки уже отправенного в аварду", УровеньЖурналаРегистрации.Ошибка,,, СтрОшибка,);
			
		КонецПопытки;
		
		Если Не ФлагОтказатьВОтгрузкеУжеОтгрууженного Тогда 
			
			СтрТовары.Комментарий = СокрЛП(ДокОбъект.Номер) + "/" + Формат(ДокОбъект.Дата, "ДЛФ=D") + "/" + СокрЛП(СтрТовары.УИД);
			
			НовСтрока = ТЗНоменклатуры.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока, СтрТовары);
			
			НовСтрока.Артикул = СокрЛП(СтрТовары.Номенклатура.Артикул);
			НовСтрока.ЕдИзмКод = СтрТовары.ЕдиницаИзмерения.ЕдиницаПоКлассификатору.Код;
			НовСтрока.УИД = Строка(СтрТовары.УИД);
			НовСтрока.Экспресс = ДокОбъект.Экспресс; 
			НовСтрока.ПроверятьОстаток = Ложь;
			НовСтрока.СпособДоставки = СпособДоставки;
			НовСтрока.КодФилиала = СокрЛП(Константы.КодФилиала.Получить()); 
			НовСтрока.СкладскойЗаказ = ДокОбъект.СкладскойЗаказ;
			НовСтрока.ГорючиеЖидкости = ДокОбъект.ГорючиеЖидкости;
			
			//+Шульман А. 01.04.2025 #UT10-5173   
			НовСтрока.ПремиальнаяПерекупка = ПремиальнаяПерекупка;
			//-Шульман А. 01.04.2025 #UT10-5173 
			
			Если ЗначениеЗаполнено(Заказ.IDСклада) Тогда
				
				НовСтрока.КодМДМСклада = Заказ.IDСклада.КодМДМ;
				
				//+Шульман А. 28.07.2025 #UT10-5636  
				Если Не ПремиальнаяПерекупка Тогда
				//-Шульман А. 28.07.2025 #UT10-5636

					Коэф = Заказ.IDСклада.КоэффициентЗакупки;
					НовСтрока.ЦенаПоставщика = Окр(НовСтрока.Цена / Коэф, 2); 
					
				Иначе
					НовСтрока.ЦенаПоставщика = НовСтрока.Цена;  // Шульман А. 06.08.2025 #UT10-5374
				КонецЕсли;
				
			КонецЕсли;
			
			Если ДокОбъект.IDСклада.ПараллельнаяОтправкаЗаказовВУТ11 Тогда 
				СтрТовары.Комментарий = "";
			КонецЕсли;
			
		КонецЕсли;

	КонецЦикла;		
	
	Результат = МСКWEB.ЗарезервироватьТоварыВСтороннейБазе(ТЗНоменклатуры, Истина, ВидОперации);
	
	//Обработка таблицы с ответом
	Если Результат.Загружен Тогда
		
		СписокДанных = Результат.СписокДанных;
		ЗаказанныеТовары = ТЗНоменклатуры;
		ЗаказанныеТовары.Очистить();
		
		Для Каждого Элем Из СписокДанных Цикл
			
			КодСтроки = Число(Элем.КодСтроки);					
			НовСтрока = ЗаказанныеТовары.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока, Элем);
			НовСтрока.Номенклатура = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", Элем.Артикул);			
			НовСтрока.УИД = ?(КодСтроки > 10000, КодСтроки - 10000, КодСтроки);
			
		КонецЦикла;
		
		ЗаказНомерДата = СписокДанных[0].СтрЗаказ;
		ГУИДЗакПокуп = СписокДанных[0].Заказ;

	Иначе
		
		ЗаказанныеТовары = Неопределено;  
		
		#Если Клиент Тогда
			Сообщить("Получен пустой список строк из сторонней УТ11");
		#ИначеЕсли Сервер Тогда
			ЗаписьЖурналаРегистрации("Получен пустой список строк из сторонней УТ11", УровеньЖурналаРегистрации.Предупреждение,,, "GoodsReserve.получение_заказа");
		#КонецЕсли

		РаботаСАвардой.СоздатьОповещениеОбОшибкеОтправкиВАварду("Обратите внимание, что при отправке заказа поставщику возникли проблемы. Заказ не был отправлен",
		"Ошибка отправки " + СокрЛП(Заказ) + " в УТ11 (сервис GoodsReserve.получение_заказа)");

		Возврат Ответ;
		
	КонецЕсли;
	
	//Заполнение строк
	Для Каждого СтрЗаказ Из ЗаказанныеТовары Цикл
		
		Отбор = Новый Структура("Номенклатура", СтрЗаказ.Номенклатура);
		Отбор.Вставить("УИД", СтрЗаказ.УИД);
		Рез = Товары.НайтиСтроки(Отбор);
		
		Если Рез.Количество() > 0 Тогда
			
			Для Каждого СтрРез Из Рез Цикл
				
				СтрРез.УспешноОтправленаВАварду = Истина;

				Если ДокОбъект.IDСклада.ПараллельнаяОтправкаЗаказовВУТ11 Тогда 
					СтрРез.Комментарий = СокрЛП(ДокОбъект.Номер) + "/" + Формат(ДокОбъект.Дата, "ДЛФ=D") + "/" + СокрЛП(СтрРез.УИД);
				КонецЕсли;

			КонецЦикла;
			
		Иначе
			
			СоздатьОповещениеОбОшибкеОтправкиВАварду("Выгрузка заказа поставщику в УТ11",
			"Ошибка привязки строки заказа поставщику УИД " + СтрЗаказ.УИД + " арт. " + СтрЗаказ.Артикул,Заказ);
			
		КонецЕсли;

	КонецЦикла;
	
	Отбор = Новый Структура("УспешноОтправленаВАварду", Ложь);
	Рез = Товары.НайтиСтроки(Отбор);
	
	Для Каждого СтрРез Из Рез Цикл
		
		МЗИстория = РегистрыСведений.ИсторияХраненияИзмененийЗагружСтатусов.СоздатьМенеджерЗаписи();
		МЗИстория.Документ = Заказ;
		МЗИстория.Номенклатура = СтрРез.Номенклатура;
		МЗИстория.КодСтроки	= СтрРез.УИД;
		МЗИстория.Статус = "120; нет на складе";			
		МЗИстория.КоличествоAvarda = 0;
		МЗИстория.КоличествоЗаказПоставщика = СтрРез.Количество;
		МЗИстория.КоличествоКорЗаказаПоставщика = 0;
		МЗИстория.КоличествоОстатокПоСкладу = СтрРез.Количество;
		МЗИстория.ЗаказПокупателя = СтрРез.Заказ;
		МЗИстория.ДатаЗагрузки = ТекущаяДата();
		МЗИстория.Записать();

	КонецЦикла;
	
	Если ВидОперации = "СторонниеСкладыВыбор" Тогда 
		
		ДокОбъект.Комментарий = ЗаказНомерДата;
		ДокОбъект.КодОтправкиАварда = ЗаказНомерДата;
		
	КонецЕсли;
	
	Если ВидОперации = "Экспрессы" Тогда
		
		ДокОбъект.Комментарий = ?(ДокОбъект.Экспресс, ЗаказНомерДата + " (УТ11)", ЗаказНомерДата + " (УТ11) " + СокрЛП(ДокОбъект.Комментарий));	
		ДокОбъект.КодОтправкиАварда = ЗаказНомерДата;
		
	КонецЕсли;
	
	Если Не КодМТ = Неопределено Тогда 
		КодМТ = ЗаказНомерДата;
	КонецЕсли;

	ДокОбъект.ГУИДЗаказаПокупателя = ГУИДЗакПокуп;
	
	//+Сёмин Р. 13.11.2025 #UT10-5484
	//ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	
	Попытка
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		
		НаборЗаписей = РегистрыСведений.НеобработанныеОтветыИзУТ11ПоОтправленнымЗаказам.СоздатьНаборЗаписей();
		
		НаборЗаписей.Отбор.ЗаказПоставщику.Установить(ДокОбъект.Ссылка);
		
		Для Каждого Стр Из ДокОбъект.Товары Цикл
			
			НоваяЗапись = НаборЗаписей.Добавить(); 
			
			НоваяЗапись.ЗаказПоставщику = ДокОбъект.Ссылка; 
			НоваяЗапись.ГУИДЗаказаПокупателя = ДокОбъект.ГУИДЗаказаПокупателя;
			НоваяЗапись.КодОтправкиАварда = ДокОбъект.КодОтправкиАварда;
			НоваяЗапись.Комментарий = ДокОбъект.Комментарий;
			НоваяЗапись.Обработан = Ложь;
			
			НоваяЗапись.НомерСтрокиТовары = Стр.НомерСтроки;
			НоваяЗапись.КомментарийСтрокаТовар = Стр.Комментарий;
			НоваяЗапись.УспешноОтправленаВАварду = Стр.УспешноОтправленаВАварду;
			
			НоваяЗапись.Номенклатура = Стр.Номенклатура; 
			НоваяЗапись.Количество = Стр.Количество;
			НоваяЗапись.УИД = Стр.УИД;
			
		КонецЦикла;
		
		НаборЗаписей.Записать();
		
	КонецПопытки;
	//-Сёмин Р. 13.11.2025 #UT10-5484
	
	ТекстСообщения = "Перезаписан документ: " + СокрЛП(ДокОбъект.Ссылка);
	ЗаписьЖурналаРегистрации("Перезаписан заказ по данным из УТ11", УровеньЖурналаРегистрации.Информация,,, "GoodsReserve.запись_заказа " + ТекстСообщения);
	Ответ = Истина;
	
	Если Не МЗИстория = Неопределено Тогда
		Обработки.ИмпортСтатусаЗаказаПоставщикаИзAvarda.Создать().ПолучитьСтатусыИзСтороннейБазы(НачалоДня(ТекущаяДата()), КонецДня(ТекущаяДата()), Истина, ВидОперации);
	КонецЕсли;
	
	Возврат Ответ;  
	
КонецФункции

Функция ОтправкаЗаказаПополненияОбособленногоПодразделения(Заказ, Склад = Неопределено)
	
	Ответ = Ложь;
	ДокОбъект = Заказ.ПолучитьОбъект();
	Товары = ДокОбъект.Товары;
	
	//Отправка таблицы товаров в стороннюю базу	
	ТЗНоменклатуры = Новый ТаблицаЗначений;
	ТЗНоменклатуры.Колонки.Добавить("Номенклатура");
	ТЗНоменклатуры.Колонки.Добавить("Артикул");
	ТЗНоменклатуры.Колонки.Добавить("Количество");
	ТЗНоменклатуры.Колонки.Добавить("УИД");
	ТЗНоменклатуры.Колонки.Добавить("ЕдИзмКод");
	ТЗНоменклатуры.Колонки.Добавить("БазаПолучатель");	
	ТЗНоменклатуры.Колонки.Добавить("Комментарий");
	ТЗНоменклатуры.Колонки.Добавить("Назначение");
	ТЗНоменклатуры.Колонки.Добавить("ГУИДЗаказаПоставщику");
	//+Кабанов А.В. 03.06.2025 # UT10-5262
	ТЗНоменклатуры.Колонки.Добавить("ДоговорПоставщикаТОХ"); 
	мДоговорПоставщикаТОХ = СокрЛП(Заказ.ДоговорПоставщикаТОХ.КодМДМ); 
	//-Кабанов А.В. 03.06.2025 # UT10-5262
	ГУИДЗаказаПоставщику = Заказ.УникальныйИдентификатор();
	
	Для Каждого СтрТовары Из Товары Цикл
		
		СтрТовары.Комментарий = СокрЛП(ДокОбъект.Номер) + "/" + Формат(ДокОбъект.Дата, "ДЛФ=D") + "/" + СокрЛП(СтрТовары.УИД);
		
		НовСтрока = ТЗНоменклатуры.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтрока,СтрТовары);
		
		НовСтрока.Артикул = СокрЛП(СтрТовары.Номенклатура.Артикул);
		НовСтрока.УИД = Строка(СтрТовары.УИД);			
		НовСтрока.ЕдИзмКод = СтрТовары.ЕдиницаИзмерения.ЕдиницаПоКлассификатору.Код;
		НовСтрока.БазаПолучатель = "УТ10Обособленное"; 
		
		//+Кабанов А.В. 03.06.2025 # UT10-5262
		НовСтрока.ДоговорПоставщикаТОХ = мДоговорПоставщикаТОХ;
		//-Кабанов А.В. 03.06.2025 # UT10-5262
		
		Если ТипЗнч(СтрТовары.Заказ) = Тип("ДокументСсылка.ЗаказПокупателя") И СтрТовары.Заказ.ОбособленнаяОтгрузкаГМИзСтороннегоФилиала Тогда 
			
			НазначениеСтруктура = Новый Структура;
			НазначениеСтруктура.Вставить("НомерЗаказа", СтрТовары.Заказ.Номер);
			НазначениеСтруктура.Вставить("ДатаЗаказа", СтрТовары.Заказ.Дата);
			НазначениеСтруктура.Вставить("Маршрут", СтрТовары.Заказ.Грузополучатель.МаршрутДоставки.Наименование);
			НазначениеСтруктура.Вставить("Грузополучатель", СтрТовары.Заказ.Грузополучатель.Наименование);
			НазначениеСтруктура.Вставить("ГрузополучательКодМДМ", СтрТовары.Заказ.Грузополучатель.КодМДМ);
			НазначениеСтруктура.Вставить("ГрузополучательКод", СтрТовары.Заказ.Грузополучатель.Код);
			НазначениеСтруктура.Вставить("БазаОтправитель", Строка(Константы.База.Получить()));
			НазначениеСтруктура.Вставить("КодСоглашения", Константы.КодСоглашения.Получить());			
			НазначениеСтруктура.Вставить("ДатаОтгрузкиЗаказа", СтрТовары.Заказ.ДатаОтгрузки);
			НовСтрока.Назначение = НазначениеСтруктура;
			
		КонецЕсли;
		
		НовСтрока.ГУИДЗаказаПоставщику = СокрЛП(ГУИДЗаказаПоставщику);
		
	КонецЦикла;	
	
	Результат = МСКWEB.ЗарезервироватьТоварыВСтороннейБазе(ТЗНоменклатуры, Ложь, "ПополнениеОП", Склад);
	
	//Обработка таблицы с ответом
	Если Результат.Загружен Тогда 
		
		СписокДанных = Результат.СписокДанных;
		ЗаказанныеТовары = ТЗНоменклатуры;
		ЗаказанныеТовары.Очистить(); 
		
		Для Каждого Элем Из СписокДанных Цикл
			
			НовСтрока = ЗаказанныеТовары.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока,Элем);
			НовСтрока.Номенклатура = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", Элем.Артикул);
			
		КонецЦикла;   
		
		ЗаказНомерДата = СписокДанных[0].СтрЗаказ;
		ГУИДЗакПокуп = СписокДанных[0].Заказ; 
		
	Иначе  
		
		ЗаказанныеТовары = Неопределено;   
		
		//+Кабанов А.В. 01.07.2025 # UT10-5321
		Если ЗначениеЗаполнено(мДоговорПоставщикаТОХ) Тогда 
			#Если Клиент Тогда
				Сообщить("Получен пустой список строк из сторонней УТ10");	
			#ИначеЕсли Сервер Тогда
				
				Если Найти(ДокОбъект.Комментарий , "Получен пустой список строк из сторонней УТ10") = 0 Тогда
					ДокОбъект.Комментарий = СокрЛП(ДокОбъект.Комментарий) + " Получен пустой список строк из сторонней УТ10.";
				КонецЕсли;
				ДокОбъект.Записать();
				ДокОбъект.УстановитьПометкуУдаления(Истина);
				
				ЗаписьЖурналаРегистрации("Получен пустой список строк из сторонней УТ10", УровеньЖурналаРегистрации.Предупреждение,,, "GoodsReserve.получение_заказа. "+ СокрЛП(Заказ) +" помечен на удаление");

			#КонецЕсли
			
		Иначе 
			
			#Если Клиент Тогда
				Сообщить("Получен пустой список строк из сторонней УТ10");
			#ИначеЕсли Сервер Тогда
				ЗаписьЖурналаРегистрации("Получен пустой список строк из сторонней УТ10", УровеньЖурналаРегистрации.Предупреждение,,, "GoodsReserve.получение_заказа");
			#КонецЕсли
			
			РаботаСАвардой.СоздатьОповещениеОбОшибкеОтправкиВАварду("Обратите внимание, что при отправке заказа поставщику возникли проблемы. Заказ не был отправлен",
			"Ошибка отправки " + СокрЛП(Заказ) + " в УТ10 (сервис GoodsReserve.получение_заказа)");
			
		КонецЕсли;
		//-Кабанов А.В. 01.07.2025 # UT10-5321

		Возврат Ответ;
		
	КонецЕсли;
	
	ТаблНовЗаказа = Товары.Выгрузить();
	ТаблНовЗаказа.Очистить();			
	
	//Заполнение строк
	Для Каждого СтрЗаказ Из ЗаказанныеТовары Цикл
		
		Отбор = Новый Структура("Номенклатура", СтрЗаказ.Номенклатура);
		Отбор.Вставить("Комментарий", СтрЗаказ.Комментарий);
		
		Рез = Товары.НайтиСтроки(Отбор);
		
		Если Рез.Количество()>0 Тогда
			
			Для Каждого СтрРез Из Рез Цикл
				СтрРез.УспешноОтправленаВАварду = Истина;
			КонецЦикла; 
			
		Иначе   		
			СоздатьОповещениеОбОшибкеОтправкиВАварду("Выгрузка заказа поставщику в УТ10", "Ошибка привязки строки заказа поставщику УИД " 
			+ СтрЗаказ.УИД + " арт. " + СтрЗаказ.Артикул, Заказ);
		КонецЕсли;
		
	КонецЦикла;
	
	ОписаниеТиповСтрока = Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(80, ДопустимаяДлина.Переменная));
	ОписаниеТиповЧисло = Новый ОписаниеТипов("Число", Новый Квалификаторычисла(12));
	ОписаниеТиповЗаказПоставщика = Новый ОписаниеТипов("ДокументСсылка.ЗаказПоставщику");		
	ОписаниеТиповНоменклатура = Новый ОписаниеТипов("СправочникСсылка.Номенклатура");
	
	ОтмененныеСтрокиЗаказа = Новый ТаблицаЗначений;		
	ОтмененныеСтрокиЗаказа.Колонки.Добавить("ЗаказПоставщика", ОписаниеТиповЗаказПоставщика);
	ОтмененныеСтрокиЗаказа.Колонки.Добавить("Номенклатура", ОписаниеТиповНоменклатура);
	ОтмененныеСтрокиЗаказа.Колонки.Добавить("КодСтроки", ОписаниеТиповЧисло);
	ОтмененныеСтрокиЗаказа.Колонки.Добавить("Статус", ОписаниеТиповСтрока);
	
	МЗИстория = Неопределено;
	Отбор = Новый Структура("УспешноОтправленаВАварду",Ложь);
	Рез = Товары.НайтиСтроки(Отбор);  
	
	Для Каждого СтрРез Из Рез Цикл
		
		//пишем в регистр
		МЗИстория = РегистрыСведений.ИсторияХраненияИзмененийЗагружСтатусов.СоздатьМенеджерЗаписи();
		МЗИстория.Документ = Заказ;
		МЗИстория.Номенклатура = СтрРез.Номенклатура;
		МЗИстория.КодСтроки	= СтрРез.УИД;
		МЗИстория.Статус = "120; нет на складе";			
		МЗИстория.КоличествоAvarda = 0;
		МЗИстория.КоличествоЗаказПоставщика = СтрРез.Количество;
		МЗИстория.КоличествоКорЗаказаПоставщика = 0;
		МЗИстория.КоличествоОстатокПоСкладу = СтрРез.Количество;
		МЗИстория.ЗаказПокупателя = СтрРез.Заказ;
		МЗИстория.ДатаЗагрузки = ТекущаяДата();
		МЗИстория.Записать();
		
		НоваяСтрока = ОтмененныеСтрокиЗаказа.Добавить();
		НоваяСтрока.ЗаказПоставщика = Заказ;
		НоваяСтрока.Номенклатура = СтрРез.Номенклатура;
		НоваяСтрока.КодСтроки 	= СтрРез.УИД;
		НоваяСтрока.Статус = "120; нет на складе";				
		СтрРез.УспешноОтправленаВАварду = Истина; 
		
	КонецЦикла;
	
	ДокОбъект.Комментарий = ?(ДокОбъект.Экспресс,ЗаказНомерДата,ЗаказНомерДата + " " + СокрЛП(ДокОбъект.Комментарий));	
	ДокОбъект.ГУИДЗаказаПокупателя = ГУИДЗакПокуп;
	ДокОбъект.КодОтправкиАварда = ЗаказНомерДата;
	ДокОбъект.ТранзитнаяПоставкаЧерезСкладWMS = Документы.ЗаказПоставщику.ЭтоТранзитнаяПоставкаЧерезСкладWMS(ДокОбъект);
	ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	
	ТекстСообщения = "Перезаписан документ: " + СокрЛП(ДокОбъект.Ссылка);
	ЗаписьЖурналаРегистрации("Перезаписан заказ по данным из УТ10", УровеньЖурналаРегистрации.Информация,,, "GoodsReserve.запись_заказа " + ТекстСообщения);
	Ответ = Истина;
	
	Если Не МЗИстория = Неопределено Тогда 
		
		ОбработкаИмпортаСтатусов = Обработки.ИмпортСтатусаЗаказаПоставщикаИзAvarda.Создать();
		СтатусТЗ = ОбработкаИмпортаСтатусов.СписокОтмененыхСтатусов();
		ОбработкаИмпортаСтатусов.ОбработатьСтатус120НетНаскладе(СтатусТЗ, ОтмененныеСтрокиЗаказа);
		
	КонецЕсли;
	
	Возврат Ответ;	
	
КонецФункции

Функция ОтправкаЗаказаПополненияОбособленногоПодразделенияУТ11(Заказ,Склад = Неопределено) Экспорт
 
	Ответ = Ложь;
	ДокОбъект = Заказ.ПолучитьОбъект();
	Товары = ДокОбъект.Товары;
	
	//Отправка таблицы товаров в стороннюю базу
	ТЗНоменклатуры = Новый ТаблицаЗначений;
	ТЗНоменклатуры.Колонки.Добавить("Номенклатура");
	ТЗНоменклатуры.Колонки.Добавить("Артикул");				
	ТЗНоменклатуры.Колонки.Добавить("Количество");
	ТЗНоменклатуры.Колонки.Добавить("ЕдИзмКод");
	ТЗНоменклатуры.Колонки.Добавить("УИД");		
	ТЗНоменклатуры.Колонки.Добавить("Комментарий");
	ТЗНоменклатуры.Колонки.Добавить("Экспресс");
	ТЗНоменклатуры.Колонки.Добавить("ПроверятьОстаток");
	ТЗНоменклатуры.Колонки.Добавить("КодФилиала"); 
	ТЗНоменклатуры.Колонки.Добавить("КодМДМСклада");
	ТЗНоменклатуры.Колонки.Добавить("Цена");
	ТЗНоменклатуры.Колонки.Добавить("ЦенаПоставщика");
	ТЗНоменклатуры.Колонки.Добавить("ПроизводительПоставщика");
	ТЗНоменклатуры.Колонки.Добавить("СкладскойЗаказ",Новый ОписаниеТипов("Булево"));
	ТЗНоменклатуры.Колонки.Добавить("СпособДоставки");
	ТЗНоменклатуры.Колонки.Добавить("ГУИДЗаказаУТ10");
	//+Шульман А. 01.04.2025 #UT10-5173 
	ТЗНоменклатуры.Колонки.Добавить("ПремиальнаяПерекупка", Новый ОписаниеТипов("Булево"));    
	//-Шульман А. 01.04.2025 #UT10-5173
	
	СпособДоставки = "Самовывоз";
	
	Для Каждого СтрТовары Из Товары Цикл
		
		ФлагОтказатьВОтгрузкеУжеОтгрууженного = Ложь;
		
		Если НЕ ФлагОтказатьВОтгрузкеУжеОтгрууженного Тогда 
			
			СтрТовары.Комментарий = СокрЛП(ДокОбъект.Номер) + "/" + Формат(ДокОбъект.Дата,"ДЛФ=D") + "/" + СокрЛП(СтрТовары.УИД);
			
			НовСтрока = ТЗНоменклатуры.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока,СтрТовары);
			НовСтрока.Артикул = СокрЛП(СтрТовары.Номенклатура.Артикул);
			НовСтрока.ЕдИзмКод = СтрТовары.ЕдиницаИзмерения.ЕдиницаПоКлассификатору.Код;
			НовСтрока.УИД = Строка(СтрТовары.УИД);
			НовСтрока.Экспресс = ДокОбъект.Экспресс;   
			//+Шульман А. 01.04.2025 #UT10-5173 
			НовСтрока.ПремиальнаяПерекупка = ДокОбъект.ПремиальнаяПерекупка;   
			//-Шульман А. 01.04.2025 #UT10-5173
			НовСтрока.ПроверятьОстаток = Ложь;
			НовСтрока.СпособДоставки = СпособДоставки; 
			НовСтрока.КодФилиала = СокрЛП(Константы.КодФилиала.Получить()); 
			НовСтрока.СкладскойЗаказ = ДокОбъект.СкладскойЗаказ; 
			НовСтрока.КодМДМСклада = "";
			НовСтрока.ЦенаПоставщика = НовСтрока.Цена; 
			НовСтрока.ГУИДЗаказаУТ10 = СокрЛП(Заказ.УникальныйИдентификатор());
			
		КонецЕсли;
		
	КонецЦикла;		
	
	Результат = МСКWEB.ЗарезервироватьТоварыВСтороннейБазе(ТЗНоменклатуры, Истина, "", Склад);
	
	//Обработка таблицы с ответом
	Если Результат.Загружен Тогда
		
		СписокДанных = Результат.СписокДанных;
		ЗаказанныеТовары = ТЗНоменклатуры;
		ЗаказанныеТовары.Очистить();
		СтрокаОтветаВэбСервиса = "";
		
		Для Каждого Элем Из СписокДанных Цикл
			
			КодСтроки = Число(Элем.КодСтроки);					
			НовСтрока = ЗаказанныеТовары.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока,Элем);
			НовСтрока.Номенклатура = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", Элем.Артикул);			
			НовСтрока.УИД = ?(КодСтроки > 10000, КодСтроки - 10000, КодСтроки); 
			
			СтрокаОтветаВэбСервиса = СтрокаОтветаВэбСервиса + ?(СокрЛП(СтрокаОтветаВэбСервиса) = "", "", 
			Символы.ПС) + СокрЛП(КодСтроки) + "  " + СокрЛП(Элем.Артикул) + "  " + СокрЛП(Элем.Количество); 

		КонецЦикла;
		
		ЗаказНомерДата = СписокДанных[0].СтрЗаказ;
		ГУИДЗакПокуп = СписокДанных[0].Заказ;
		
		ЗаписьЖурналаРегистрации("Ответ вэб-сервиса  ", УровеньЖурналаРегистрации.Информация,,, ЗаказНомерДата + " " + ГУИДЗакПокуп + Символы.ПС + СокрЛП(СтрокаОтветаВэбСервиса)); 
		
	Иначе
		
		ЗаказанныеТовары = Неопределено;   
		
		#Если Клиент Тогда
			Сообщить("Получен пустой список строк из сторонней УТ11");
		#ИначеЕсли Сервер Тогда
			ЗаписьЖурналаРегистрации("Получен пустой список строк из сторонней УТ11", УровеньЖурналаРегистрации.Предупреждение,,, "GoodsReserve.получение_заказа");
		#КонецЕсли
		
		РаботаСАвардой.СоздатьОповещениеОбОшибкеОтправкиВАварду("Обратите внимание, что при отправке заказа поставщику возникли проблемы. Заказ не был отправлен",
		"Ошибка отправки " + СокрЛП(Заказ) + " в УТ11 (сервис GoodsReserve.получение_заказа)");
		
		Возврат Ответ;
		
	КонецЕсли;
	
	//Заполнение строк
	Для Каждого СтрЗаказ Из ЗаказанныеТовары Цикл
		
		Отбор = Новый Структура("Номенклатура", СтрЗаказ.Номенклатура);
		Отбор.Вставить("УИД", СтрЗаказ.УИД);
		Рез = Товары.НайтиСтроки(Отбор);
		
		Если Рез.Количество() > 0 Тогда
			
			Для Каждого СтрРез Из Рез Цикл
				СтрРез.УспешноОтправленаВАварду = Истина;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Заказ.IDСкладаСобственныйСклад) И Заказ.Экспресс И Заказ.IDСкладаСобственныйСклад.ВэбСервисУТ11 Тогда
		
		ОтмененныеСтрокиЗаказа = Новый ТаблицаЗначений;		
		ОтмененныеСтрокиЗаказа.Колонки.Добавить("ЗаказПоставщика", Новый ОписаниеТипов("ДокументСсылка.ЗаказПоставщику"));
		ОтмененныеСтрокиЗаказа.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		ОтмененныеСтрокиЗаказа.Колонки.Добавить("КодСтроки", Новый ОписаниеТипов("Число", Новый Квалификаторычисла(12)));
		ОтмененныеСтрокиЗаказа.Колонки.Добавить("Статус", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(80, ДопустимаяДлина.Переменная))); 		
		
	КонецЕсли;

	Отбор = Новый Структура("УспешноОтправленаВАварду", Ложь);
	Рез = Товары.НайтиСтроки(Отбор);
	
	Для Каждого СтрРез Из Рез Цикл
		
		//пишем в регистр
		МЗИстория = РегистрыСведений.ИсторияХраненияИзмененийЗагружСтатусов.СоздатьМенеджерЗаписи();
		МЗИстория.Документ = Заказ;
		МЗИстория.Номенклатура = СтрРез.Номенклатура;
		МЗИстория.КодСтроки	= СтрРез.УИД;
		МЗИстория.Статус = "120; нет на складе";			
		МЗИстория.КоличествоAvarda = 0;
		МЗИстория.КоличествоЗаказПоставщика = СтрРез.Количество;
		МЗИстория.КоличествоКорЗаказаПоставщика = 0;
		МЗИстория.КоличествоОстатокПоСкладу = СтрРез.Количество;
		МЗИстория.ЗаказПокупателя = СтрРез.Заказ;
		МЗИстория.ДатаЗагрузки = ТекущаяДата();
		МЗИстория.Записать();

		Если ЗначениеЗаполнено(Заказ.IDСкладаСобственныйСклад) И Заказ.Экспресс И Заказ.IDСкладаСобственныйСклад.ВэбСервисУТ11 Тогда  			
			
			НоваяСтрока = ОтмененныеСтрокиЗаказа.Добавить();
			НоваяСтрока.ЗаказПоставщика = Заказ;
			НоваяСтрока.Номенклатура = СтрРез.Номенклатура;
			НоваяСтрока.КодСтроки 	= СтрРез.УИД;
			НоваяСтрока.Статус = "120; нет на складе";				
			СтрРез.УспешноОтправленаВАварду = Истина;
			
		КонецЕсли;

	КонецЦикла;
	
	ДокОбъект.Комментарий = ?(ДокОбъект.Экспресс,ЗаказНомерДата,ЗаказНомерДата + " " + СокрЛП(ДокОбъект.Комментарий));	
	ДокОбъект.КодОтправкиАварда = ЗаказНомерДата; 	
	ДокОбъект.ГУИДЗаказаПокупателя = ГУИДЗакПокуп; 	
	ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	
	ТекстСообщения = "Перезаписан документ: " + СокрЛП(ДокОбъект.Ссылка);
	ЗаписьЖурналаРегистрации("Перезаписан заказ по данным из УТ11", УровеньЖурналаРегистрации.Информация,,, "GoodsReserve.запись_заказа " + ТекстСообщения);
	Ответ = Истина; 
	
	Обработки.ИмпортСтатусаЗаказаПоставщикаИзAvarda.Создать().ПолучитьСтатусыИзСтороннейБазы(НачалоДня(ТекущаяДата()), КонецДня(ТекущаяДата()), Истина, "", Склад);

	Возврат Ответ;
	
КонецФункции

Процедура ПроверитьЗаказПередОтправкойВТомилино(ДокОбъект) 
	
	Если ДокОбъект.Проведен И ДокОбъект.Товары.Количество() >  0 Тогда  
		
		Товары = ДокОбъект.Товары;

		ИДСобственногоСклада  = Число(Константы.FTPВыгрузкаОстатковКаталог.Получить());
		
		СписокСкладов = Новый СписокЗначений;
		СписокСкладов.Добавить(0);
		СписокСкладов.Добавить(1);
		СписокСкладов.Добавить(ИДСобственногоСклада);
		
		ЗапросСтрокНаКорректировку = Новый Запрос;
		ЗапросСтрокНаКорректировку.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗаказПоставщикуТовары.Заказ КАК ЗаказПокупателя
		|ИЗ
		|	Документ.ЗаказПоставщику КАК ЗаказПоставщику
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
		|		ПО (ЗаказПоставщикуТовары.Ссылка = ЗаказПоставщику.Ссылка)
		|ГДЕ
		|	ЗаказПоставщику.Ссылка = &Ссылка
		|	И ЗаказПоставщикуТовары.Заказ.Грузополучатель.НеОтправлятьЭкспрессВТомилино
		|	И ЗаказПоставщикуТовары.Заказ.IDСклада В (&IDСклада)";
		
		ЗапросСтрокНаКорректировку.УстановитьПараметр("Ссылка", ДокОбъект.Ссылка);
		ЗапросСтрокНаКорректировку.УстановитьПараметр("IDСклада", СписокСкладов); 
		
		РезультатЗапросаСтрокНаКорректировку = ЗапросСтрокНаКорректировку.Выполнить();
		
		Если НЕ РезультатЗапросаСтрокНаКорректировку.Пустой() Тогда 
			
			КоличествоСтрокТовары = Товары.Количество() - 1;
			ИндексСтроки = КоличествоСтрокТовары;
			
			Для Счетчик = 0 по КоличествоСтрокТовары Цикл
				
				СтрокаТовары = Товары.Получить(ИндексСтроки);
				
				Если (СтрокаТовары.Заказ.IDСклада = ИДСобственногоСклада ИЛИ СтрокаТовары.Заказ.IDСклада = 0 ИЛИ СтрокаТовары.Заказ.IDСклада = 1) 
					И  СтрокаТовары.Заказ.Грузополучатель.НеОтправлятьЭкспрессВТомилино Тогда
					Товары.Удалить(СтрокаТовары);
				КонецЕсли;
										
				ИндексСтроки = ИндексСтроки - 1;
				
			КонецЦикла; 
			
			Если Товары.Количество() > 0 Тогда
				ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);		
			Иначе
				
				ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
				ДокОбъект.УстановитьПометкуУдаления(Истина);				
				
			КонецЕсли;
			
			ВыборкаСтрокНакорректировку = РезультатЗапросаСтрокНаКорректировку.Выбрать();
			
			Пока ВыборкаСтрокНакорректировку.Следующий() Цикл
				
				НоваяКорректировкаЗаказаПокупателя = Документы.КорректировкаЗаказаПокупателя.СоздатьДокумент();
				НоваяКорректировкаЗаказаПокупателя.Дата = ТекущаяДата();			
				НоваяКорректировкаЗаказаПокупателя.Заполнить(ВыборкаСтрокНакорректировку.ЗаказПокупателя);
				
				Если НоваяКорректировкаЗаказаПокупателя.Товары.Количество() > 0 Тогда 
					
					ТоварыК = НоваяКорректировкаЗаказаПокупателя.Товары;
					
					КоличествоСтрокТовары = ТоварыК.Количество()-1;
					ИндексСтроки = КоличествоСтрокТовары;
					
					Для Счетчик = 0 по КоличествоСтрокТовары Цикл
						
						СтрокаТовары = ТоварыК.Получить(ИндексСтроки);
						
						Если ЗначениеЗаполнено(СтрокаТовары.Размещение) Тогда
							ТоварыК.Удалить(СтрокаТовары);
						КонецЕсли;
						
						ИндексСтроки = ИндексСтроки - 1;
						
					КонецЦикла; 
					
					Если ТоварыК.Количество() > 0 Тогда
						НоваяКорректировкаЗаказаПокупателя.Записать(РежимЗаписиДокумента.Проведение);
					КонецЕсли;	
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;	

КонецПроцедуры

///////////////////Общие процедуры и функции///////////////////
Функция ПроверитьНоменклатуруПоНормализованномуКоду(Артикул, Производитель) Экспорт
	
	ОчищенныйПроизводитель = "";
	СтрокаПроверки = ВРег(СокрЛП(Производитель.Наименование));
	Длина = СтрДлина(СтрокаПроверки);
	
	Для а = 1 По Длина Цикл
		
		Если Найти("0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyzАБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯабвгдеёжзийклмнопрстуфхцчшщъыьэюя", Сред(СтрокаПроверки, а, 1)) <> 0 Тогда
			ОчищенныйПроизводитель = ОчищенныйПроизводитель + Сред(СтрокаПроверки, а, 1);
		КонецЕсли; 
		
	КонецЦикла;	
	
	ОчищенныйКодПроизводителя = "";
	СтрокаПроверки = СокрЛП(Артикул);
	Длина = СтрДлина(СтрокаПроверки);
	
	Для а = 1 По Длина Цикл
		
		Если Найти("0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyzАБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯабвгдеёжзийклмнопрстуфхцчшщъыьэюя", Сред(СтрокаПроверки, а, 1)) <> 0 Тогда
			ОчищенныйКодПроизводителя = ОчищенныйКодПроизводителя + Сред(СтрокаПроверки, а, 1);
		КонецЕсли; 
		
	КонецЦикла;
	
	СтрокаПоиска = ОчищенныйПроизводитель+ОчищенныйКодПроизводителя;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.НормализованныйКод = &СтрокаПоиска
	|	И НЕ Номенклатура.ПометкаУдаления
	|	И Номенклатура.КодМДМ = """"
	|	И Номенклатура.КодАварда = 0";
	
	
	Запрос.УстановитьПараметр("СтрокаПоиска", СтрокаПоиска);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка.ПолучитьОбъект();
	Иначе 
		Возврат Справочники.Номенклатура.СоздатьЭлемент();
	КонецЕсли;
	
КонецФункции

Функция НайтиЕдИзм(КодАвардаЕдИзм)
	
	Результат = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796");
	
	Если КодАвардаЕдИзм = 60002644 Тогда
		Результат = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("839");
	КонецЕсли;
	
	Если КодАвардаЕдИзм = 60028724 Тогда
		Результат = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("006");
	КонецЕсли;
	
	Если Результат = Неопределено ИЛИ Результат = Справочники.ЕдиницыИзмерения.ПустаяСсылка() Тогда
		Возврат Неопределено;
	Иначе	
		Возврат Результат;
	КонецЕсли;
	
КонецФункции

Функция НайтиГруппуАВС(Код)
	
	Рез = Справочники.АВСКлассификацияНоменклатуры.НайтиПоКоду(Код, истина);
	
	Если Не ЗначениеЗаполнено(Рез) тогда
		
		СпрОб = Справочники.АВСКлассификацияНоменклатуры.СоздатьЭлемент();
		СпрОб.Код = Код;
		СпрОб.Наименование = Код;
		СпрОб.Записать();
		Рез = СпрОб.Ссылка;
		
	КонецЕсли;
	
	Возврат Рез; 
	
КонецФункции

Процедура СоздатьШтрихкод(знач ШК, Товар)
	
	Если ЗначениеЗаполнено(ШК) тогда
		
		ШК = СтрЗаменить(ШК, "¶", "");
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(ШтрихКод) КАК КоличествоСтрок
		|ИЗ
		|	РегистрСведений.Штрихкоды КАК Штрихкоды
		|ГДЕ
		|	Штрихкоды.Владелец ССЫЛКА Справочник.Номенклатура
		|	И Штрихкоды.Штрихкод = &Штрихкод
		|	И Штрихкоды.Владелец = &Владелец";
		
		Запрос.УстановитьПараметр("Штрихкод", Шк);
		Запрос.УстановитьПараметр("Владелец", Товар);
		
		РезультатЗапроса = Запрос.Выполнить().Выбрать();
		РезультатЗапроса.Следующий();
		
		Если РезультатЗапроса.КоличествоСтрок = 0 тогда
			
			Запись = РегистрыСведений.Штрихкоды.СоздатьМенеджерЗаписи();
			
			Запись.Штрихкод = ШК;
			Запись.Владелец = Товар;
			Запись.ЕдиницаИзмерения = Товар.ЕдиницаХраненияОстатков;
			
			Запись.Качество = Справочники.Качество.Новый;
			
			Попытка
				
				Значен =  Число(ШК);
				
				Если Значен >= 1000000000000 И  Значен <= 9999999999999 тогда
					Запись.ТипШтрихкода = ПланыВидовХарактеристик.ТипыШтрихкодов.EAN13;
				Иначе
					Запись.ТипШтрихкода = ПланыВидовХарактеристик.ТипыШтрихкодов.Code128;
				КонецЕсли;
				
			Исключение
				Запись.ТипШтрихкода = ПланыВидовХарактеристик.ТипыШтрихкодов.Code128;
			КонецПопытки;
			
			Попытка
				Запись.Записать();
			Исключение
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция СоздатьОповещениеОбИзмененииДляСтороннихСкладов(НаименованиеЗадачи, ОписаниеЗадачи, ОбъектЗадачи = Неопределено) Экспорт
	
	СписокПользователей = УправлениеПользователями.ВернутьСписокПользователейСУстановленнымПравом
	                         (ПланыВидовХарактеристик.ПраваПользователей.ПолучатьУведомленияПоСобытиямСвязаннымиСоСтороннимиСкладами);
	
	Если СписокПользователей.Количество() = 0 Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого ТекПользователь Из СписокПользователей Цикл
		
		НоваяЗадача = Задачи.ЗадачиПользователя.СоздатьЗадачу();
		НоваяЗадача.Дата           = ТекущаяДата();
		НоваяЗадача.Наименование   = НаименованиеЗадачи;
		НоваяЗадача.Исполнитель    = ТекПользователь.Значение;
		НоваяЗадача.СрокИсполнения = ТекущаяДата() + 60*30; 
		НоваяЗадача.Оповещение     = Истина;
		НоваяЗадача.СрокОповещения = ТекущаяДата() + 60;
		
		Если ОбъектЗадачи <> Неопределено Тогда 
			НоваяЗадача.Объект     = ОбъектЗадачи;
		КонецЕсли;
		
		НоваяЗадача.Описание       = ОписаниеЗадачи;
		
		Попытка
			НоваяЗадача.Записать();
		Исключение
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

функция СоздатьОповещениеОбОшибкеОтправкиВАварду(НаименованиеЗадачи, ОписаниеЗадачи, ОбъектЗадачи = Неопределено) Экспорт 

	ЗапросАдресов = Новый Запрос;
	ЗапросАдресов.Текст =
	"ВЫБРАТЬ
	|	КонтактнаяИнформация.Объект,
	|	КонтактнаяИнформация.Представление КАК АдресЭлПочты
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КатегорииОбъектов КАК КатегорииОбъектов
	|		ПО (КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.EmailРабочийФизическогоЛица)
	|				И КонтактнаяИнформация.Объект = КатегорииОбъектов.Объект
	|				И КатегорииОбъектов.Категория = ЗНАЧЕНИЕ(Справочник.КатегорииОбъектов.УведомлениеОбОшибкахОтправкиВАварду))";

	РезультатАдресов = ЗапросАдресов.Выполнить();

	Если НЕ РезультатАдресов.Пустой() Тогда
		
		УчетнаяЗапись = Константы.ОсновнаяУчетнаяЗаписьЭлектроннойПочты.Получить(); 		
		
		Если Константы.НеОтправлятьПочту.Получить() ИЛИ НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
			Возврат Истина;
		КонецЕсли; 		
		
		Профиль = УправлениеЭлектроннойПочтой.ПолучитьИнтернетПочтовыйПрофиль(УчетнаяЗапись);
		Почта = Новый ИнтернетПочта; 
		
		Попытка
			Почта.Подключиться(Профиль);
		Исключение 
			
			ЗаписьЖурналаРегистрации("Отправка оповещения об ошибке отправки Заказа поставщику", УровеньЖурналаРегистрации.Предупреждение,,, 
			"Ошибка при подключении к почтовому серверу. " + Символы.ПС + ОписаниеОшибки());
			Возврат Истина;
			
		КонецПопытки;
		
		ВыборкаВдресов = РезультатАдресов.Выбрать();
		
		Пока ВыборкаВдресов.Следующий() Цикл   
			
			МассивАдресов = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(ВыборкаВдресов.АдресЭлПочты, ";"); 
			
			Для Каждого ТекАдрес Из МассивАдресов Цикл
				
				ПромАдресОтправки = СокрЛП(ТекАдрес);			
				Сообщение = Новый ИнтернетПочтовоеСообщение;
				Сообщение.Тема = НаименованиеЗадачи;
				Сообщение.Получатели.Добавить(ПромАдресОтправки); 
				Сообщение.Отправитель = УчетнаяЗапись.АдресЭлектроннойПочты;
				Сообщение.Тексты.Добавить(ОписаниеЗадачи);
				Почта.Послать(Сообщение);
				
			КонецЦикла;  
			
		КонецЦикла;
		
		Почта.Отключиться();  
		
	КонецЕсли;	
	
	Возврат Истина;  
	
КонецФункции

Процедура СинхронизацияГрупп()

	СправочникЗагрузки = Справочники.AMQP_СправочникиЗагрузки.НайтиПоРеквизиту("ИмяСправочника", "Производители");
	
	Если ЗначениеЗаполнено(СправочникЗагрузки) И СправочникЗагрузки.Загружать Тогда
		Возврат;
	КонецЕсли; 
	
	
	Подключение = Неопределено;
	RS = Неопределено;
	ОписаниеТиповСтрока = новый ОписаниеТипов("строка", новый квалификаторыстроки(80, ДопустимаяДлина.Переменная));
	ОписаниеТиповЧисло = новый ОписаниеТипов("число", новый квалификаторычисла(12));
	
	Подключение = Новый COMObject("ADODB.Connection");	
	
	Если Соединение(Подключение) Тогда 		
		
		ТекстЗапроса = "Select DISTINCT IDPROIZV,PROIZV
		|From ({call RA_GET_TOV_FOR_ORA(null,null,null,null,null,null,null,null,null,null,null,null)})";
		
		RS = СформироватьЗапрос(ТекстЗапроса, Подключение);
		
		Если RS <> Неопределено тогда
			
			ПромТаблица = Новый ТаблицаЗначений;
			ПромТаблица.Очистить();
			
			Для Счетчик = 1 По RS.Fields.Count Цикл
				
				Поле = RS.Fields.Item(Счетчик - 1);
				
				Если СокрЛП(Поле.Name) = "IDPROIZV" Тогда
					Колонка = ПромТаблица.Колонки.Добавить(Поле.Name,ОписаниеТиповЧисло, Поле.Name); 					
				Иначе					
					Колонка = ПромТаблица.Колонки.Добавить(Поле.Name,ОписаниеТиповСтрока, Поле.Name);
				КонецЕсли;
				
			КонецЦикла;
			
			Пока RS.EOF() = 0 Цикл		
				
				НоваяСтрока = ПромТаблица.Добавить();           		
				
				Для Счетчик = 1 По RS.Fields.Count Цикл 
					
					Поле = RS.Fields.Item(Счетчик - 1);
					НоваяСтрока[Поле.Name] = Поле.Value;			
					
				КонецЦикла;    		
				
				RS.MoveNext(); 		
				
			КонецЦикла;
			
