// Возвращает заполненный настройками учетной записи почтовый профиль интернет
//
Функция ПолучитьИнтернетПочтовыйПрофиль(УчетнаяЗапись)
	
	Профиль = Новый ИнтернетПочтовыйПрофиль;
	
	ВерсияПодсистемыУТ = ВерсияУТ();
	
	Если ТипЗнч(УчетнаяЗапись) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(Профиль, УчетнаяЗапись);
		Если УчетнаяЗапись.ТребуетсяSMTPАутентификация Тогда
			Профиль.АутентификацияSMTP  = СпособSMTPАутентификации.ПоУмолчанию;
			Профиль.ПользовательSMTP    = УчетнаяЗапись.Пользователь;
			Профиль.ПарольSMTP          = УчетнаяЗапись.Пароль;
		Иначе
			Профиль.АутентификацияSMTP = СпособSMTPАутентификации.БезАутентификации;
			Профиль.ПарольSMTP         = "";
			Профиль.ПользовательSMTP   = "";
		КонецЕсли;
	Иначе
		Если ВерсияПодсистемыУТ = "10" Тогда
			
			Если Метаданные.ОбщиеМодули.Найти("ЭлектроннаяПочта") <> Неопределено Тогда
				
				Попытка
					Выполнить("Профиль = ЭлектроннаяПочта.СформироватьИнтернетПрофиль(УчетнаяЗапись,,, Ложь)");
				Исключение
					ТекстСообщения = НСтр("ru = 'Не удалось сформировать интернет почтовый профиль по причине: %Причина%'");
					ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
					ЗаписьЖурналаРегистрации(НСтр("ru = 'Отправка уведомления о событии'"),
						УровеньЖурналаРегистрации.Предупреждение,
						УчетнаяЗапись.Метаданные(),
						УчетнаяЗапись,
						ТекстСообщения);
				КонецПопытки;
				
			ИначеЕсли Метаданные.ОбщиеМодули.Найти("УправлениеЭлектроннойПочтой") <> Неопределено Тогда
				
				Попытка
					Выполнить("Профиль = УправлениеЭлектроннойПочтой.ПолучитьИнтернетПочтовыйПрофиль(УчетнаяЗапись)");
				Исключение
					ТекстСообщения = НСтр("ru = 'Не удалось сформировать интернет почтовый профиль по причине: %Причина%'");
					ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
					ЗаписьЖурналаРегистрации(НСтр("ru = 'Отправка уведомления о событии'"),
						УровеньЖурналаРегистрации.Предупреждение,
						УчетнаяЗапись.Метаданные(),
						УчетнаяЗапись,
						ТекстСообщения);
				КонецПопытки;
			КонецЕсли;
			
			//<<Макарова
			// -- у нас нет реквизита ИспользоватьЗащищенноеСоединениеДляИсходящейПочты
			//Попытка
			//	Если Платформа83() И Не Профиль.ИспользоватьSSLSMTP Тогда
			//		Выполнить("Профиль.ИспользоватьSSLSMTP = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УчетнаяЗапись, ""ИспользоватьЗащищенноеСоединениеДляИсходящейПочты"")");
			//	КонецЕсли;
			//Исключение
			//	ТекстСообщения = НСтр("ru = 'Не удалось сформировать интернет почтовый профиль по причине: %Причина%'");
			//	ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			//	ЗаписьЖурналаРегистрации(НСтр("ru = 'Отправка уведомления о событии'"),
			//		УровеньЖурналаРегистрации.Предупреждение,
			//		УчетнаяЗапись.Метаданные(),
			//		УчетнаяЗапись,
			//		ТекстСообщения);
			//КонецПопытки;
			//Макарова >>
			
		ИначеЕсли ВерсияПодсистемыУТ = "11" Или ВерсияПодсистемыУТ = "Бухгалтерия_3.0" Или ВерсияПодсистемыУТ = "Розница" Или ВерсияПодсистемыУТ = "ЗУП" Тогда
			
			ВерсияБСП = ВерсияБСП();
			Если ВерсияБСП <> Неопределено Тогда
				
				Если ВесВерсии(ВерсияБСП) >= ВесВерсии("2.1.0.0") Тогда
					
					Попытка
						Выполнить("Профиль = РаботаСПочтовымиСообщениямиСлужебный.ИнтернетПочтовыйПрофиль(УчетнаяЗапись)");
					Исключение
						ТекстСообщения = НСтр("ru = 'Не удалось сформировать интернет почтовый профиль по причине: %Причина%'");
						ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
						ЗаписьЖурналаРегистрации(НСтр("ru = 'Отправка уведомления о событии'"),
							УровеньЖурналаРегистрации.Предупреждение,
							УчетнаяЗапись.Метаданные(),
							УчетнаяЗапись,
							ТекстСообщения);
					КонецПопытки;
					
				ИначеЕсли ВесВерсии(ВерсияБСП) >= ВесВерсии("2.0.0.0") Тогда
					
					Попытка
						Выполнить("Профиль = ЭлектроннаяПочта.СформироватьИнтернетПрофиль(УчетнаяЗапись)");
					Исключение
						ТекстСообщения = НСтр("ru = 'Не удалось сформировать интернет почтовый профиль по причине: %Причина%'");
						ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
						ЗаписьЖурналаРегистрации(НСтр("ru = 'Отправка уведомления о событии'"),
							УровеньЖурналаРегистрации.Предупреждение,
							УчетнаяЗапись.Метаданные(),
							УчетнаяЗапись,
							ТекстСообщения);
					КонецПопытки;
				
				КонецЕсли;
			КонецЕсли;
		Иначе
			
			Попытка
				
				Пароль = Неопределено;
				ФормироватьSMTPПрофиль = Истина;
				
				НастройкиСоединения = ЗначенияРеквизитовОбъекта(
					УчетнаяЗапись,
					"Логин,
					|Пароль,
					|ВремяОжиданияСервера,
					|SMTPСервер,
					|ПортSMTP,
					|ТребуетсяSMTPАутентификация,
					|ЛогинSMTP,
					|ПарольSMTP");
				
				Профиль.Пользователь = НастройкиСоединения.Логин;
				Если НастройкиСоединения.ВремяОжиданияСервера > 0 Тогда
					Профиль.ВремяОжидания = НастройкиСоединения.ВремяОжиданияСервера;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(Пароль) Тогда
					Профиль.Пароль = Пароль;
				Иначе
					Профиль.Пароль = НастройкиСоединения.Пароль;
				КонецЕсли;
				
				Если Платформа83() Тогда
					Выполнить("Профиль.ИспользоватьSSLSMTP = Истина;");
				КонецЕсли;
				
				Если ФормироватьSMTPПрофиль Тогда
					Профиль.АдресСервераSMTP = НастройкиСоединения.SMTPСервер;
					Профиль.ПортSMTP         = НастройкиСоединения.ПортSMTP;
					
					Если НастройкиСоединения.ТребуетсяSMTPАутентификация Тогда
						Профиль.АутентификацияSMTP = СпособSMTPАутентификации.ПоУмолчанию;
						Профиль.ПользовательSMTP   = НастройкиСоединения.ЛогинSMTP;
						Профиль.ПарольSMTP         = НастройкиСоединения.ПарольSMTP;
					Иначе
						Профиль.АутентификацияSMTP = СпособSMTPАутентификации.БезАутентификации;
						Профиль.ПользовательSMTP   = "";
						Профиль.ПарольSMTP         = "";
					КонецЕсли;
				КонецЕсли;
				
			Исключение
				ТекстСообщения = НСтр("ru = 'Не удалось сформировать интернет почтовый профиль по причине: %Причина%'");
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				ЗаписьЖурналаРегистрации(НСтр("ru = 'Отправка уведомления о событии'"),
					УровеньЖурналаРегистрации.Предупреждение,
					УчетнаяЗапись.Метаданные(),
					УчетнаяЗапись,
					ТекстСообщения);
			КонецПопытки;
			
		КонецЕсли;
	КонецЕсли;
	
	Возврат Профиль;

КонецФункции

// Возвращает подготовленное почтовое сообщение интернет
//
Функция СформироватьПочтовоеСообщение(Уведомление)
	
	Если Уведомление.ОбычныйТекст Тогда
		ТипТекста = ТипТекстаПочтовогоСообщения.ПростойТекст;
	Иначе
		ТипТекста = ТипТекстаПочтовогоСообщения.HTML;
	КонецЕсли;
	
	Сообщение = Новый ИнтернетПочтовоеСообщение;
	
	Если Уведомление.ДелениеПоАдресатам = Перечисления.ПЛ_ДелениеУведомленийПоАдресатам.СкрытыеКопии Тогда
		ИмяСписка = "СлепыеКопии";
	Иначе
		ИмяСписка = "Получатели";
	КонецЕсли;
	
	Для каждого СтруктураАдресата Из Уведомление.АдресатыРасширенно Цикл
		Сообщение[ИмяСписка].Добавить(СтруктураАдресата.Адрес);
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Уведомление.ОбратныйАдрес) Тогда
		Сообщение.ОбратныйАдрес.Добавить(Уведомление.ОбратныйАдрес);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Уведомление.ИмяОтправителя) Тогда
		Сообщение.ИмяОтправителя = Уведомление.ИмяОтправителя;
	КонецЕсли;
	
	Сообщение.Тема = Уведомление.Тема;
	
	ТекстСообщения = Уведомление.Текст;
	Сообщение.Тексты.Добавить(ТекстСообщения, ТипТекста);
	
	Если Уведомление.ТаблицаВложений <> Неопределено Тогда
		Для Каждого СтрокаВложения Из Уведомление.ТаблицаВложений Цикл
			ДанныеВложения = СтрокаВложения.Вложение.Получить();
			Если ДанныеВложения <> Неопределено Тогда
				Вложение = Сообщение.Вложения.Добавить(ДанныеВложения, СтрокаВложения.Идентификатор);
				Вложение.Идентификатор = СтрокаВложения.Идентификатор;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если Уведомление.ПечатныеФормы <> Неопределено Тогда
		Для каждого ПечатнаяФорма из Уведомление.ПечатныеФормы Цикл
			Если ПечатнаяФорма.ДвоичныеДанные <> Неопределено Тогда
				Вложение = Сообщение.Вложения.Добавить(ПечатнаяФорма.ДвоичныеДанные, ПечатнаяФорма.ИмяФайла);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если Уведомление.ПрисоединенныеФайлы <> Неопределено Тогда
		Для каждого ПрисоединенныйФайл из Уведомление.ПрисоединенныеФайлы Цикл
			ДанныеПрисоединенногоФайла = ПрисоединенныйФайл.Вложение.Получить();
			Если ДанныеПрисоединенногоФайла <> Неопределено Тогда
				Вложение = Сообщение.Вложения.Добавить(ДанныеПрисоединенногоФайла, ПрисоединенныйФайл.Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Сообщение.ОбработатьТексты();
	
	Возврат Сообщение;
	
КонецФункции

// Осуществляет отправку почтового сообщения интернет при помощи указанной учетной записи
//
Процедура ОтправитьПочтовыеСообщения(Сообщения, Источник, УчетнаяЗапись, Профиль, Результат)
	
	Если ТипЗнч(УчетнаяЗапись) = Тип("Структура") Тогда
		Отправитель = УчетнаяЗапись.Пользователь;
	Иначе
		Отправитель = УчетнаяЗапись.АдресЭлектроннойПочты;
	КонецЕсли;
	
	Почта = Новый ИнтернетПочта;
	Попытка
		
		ЗаписьЖурналаРегистрации("ПЛ_УведомленияПоРегламентнымПроверкам",,,,"Подключаемся к почте: начало");	
		Почта.Подключиться(Профиль);
		
		Для каждого ЭлементМассива Из Сообщения Цикл
			
			Отправлено = Ложь;
			
			ПочтовоеСообщение = ЭлементМассива.ПочтовоеСообщение;
			ПочтовоеСообщение.Отправитель = Отправитель;
			
			Попытка
				
				ЗаписьЖурналаРегистрации("ПЛ_УведомленияПоРегламентнымПроверкам",,,,"Отправляем письмо: начало");	
				Почта.Послать(ПочтовоеСообщение);
				ЗаписьЖурналаРегистрации("ПЛ_УведомленияПоРегламентнымПроверкам",,,,"Отправляем письмо: окончание");	
				Отправлено = Истина;
				
			Исключение
				
				ТекстСообщения = НСтр("ru = 'Не удалось отправить электронное письмо по причине: %Причина%'");
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				ЗаписьЖурналаРегистрации(НСтр("ru = 'Отправка уведомления о событии'"),
					УровеньЖурналаРегистрации.Предупреждение,,,
					ТекстСообщения);
					
				Отправлено = Ложь;
				Результат.ОписаниеОшибки = ТекстСообщения;
				
			КонецПопытки;
			
			Если Отправлено Тогда
				РегистрыСведений.ПЛ_Уведомления.СделатьЗаписьОбОтправкеУведомления(ЭлементМассива.Уведомление, Источник, Истина);
				Результат.ОтправленныеСообщения.Добавить(ЭлементМассива.Уведомление);
			КонецЕсли;
		КонецЦикла;
		
		Почта.Отключиться();
		ЗаписьЖурналаРегистрации("ПЛ_УведомленияПоРегламентнымПроверкам",,,,"Отключились от почты: окончание");	
		
	Исключение
		ТекстСообщения = НСтр("ru = 'Не удалось отправить электронные письма по причине: %Причина%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Отправка уведомления о событии'"),
			УровеньЖурналаРегистрации.Предупреждение,,,
			ТекстСообщения);
			
		Результат.ОписаниеОшибки = ТекстСообщения;
	КонецПопытки;
	
КонецПроцедуры

// Сохраняет почтовые сообщения в документах конфигурации
//
Процедура СохранитьПочтовыеСообщения(Сообщения, Источник, УчетнаяЗапись, Результат)
	
	ВерсияУТ = ВерсияУТ();
	
	Если ВерсияУТ = "11" Или ВерсияУТ = "ЗУП" Тогда
	
		ОписаниеОшибки = "";
		ИдентификаторСообщения = "";
		
		Попытка
		
			Для каждого ЭлементМассива Из Сообщения Цикл
				
				Сообщение = ЭлементМассива.ПочтовоеСообщение;
				
				Письмо = Неопределено;
				Выполнить("Письмо = Документы.ЭлектронноеПисьмоИсходящее.СоздатьДокумент()");
				
				Для каждого Получатель Из Сообщение.Получатели Цикл
					НовыйПолучатель = Письмо.ПолучателиПисьма.Добавить();
					НовыйПолучатель.Адрес         = Получатель.Адрес;
					НовыйПолучатель.Представление = Получатель.ОтображаемоеИмя;
				КонецЦикла;
				
				Для каждого Получатель Из Сообщение.СлепыеКопии Цикл
					НовыйПолучатель = Письмо.ПолучателиСкрытыхКопий.Добавить();
					НовыйПолучатель.Адрес         = Получатель.Адрес;
					НовыйПолучатель.Представление = Получатель.ОтображаемоеИмя;
				КонецЦикла;
				
				Если Письмо.ПолучателиПисьма.Количество() = 0 И Письмо.ПолучателиСкрытыхКопий.Количество() = 0 Тогда
					Возврат;
				КонецЕсли;
				
				Выполнить("Письмо.Автор         = Пользователи.ТекущийПользователь()");
				Выполнить("Письмо.Ответственный = Пользователи.ТекущийПользователь()");
				Письмо.Дата                     = ТекущаяДатаСеанса();
				Выполнить("Письмо.Важность = Перечисления.ВариантыВажностиВзаимодействия.Обычная");
				Письмо.Кодировка                = "UTF-8";
				Письмо.УчетнаяЗапись            = УчетнаяЗапись;
				
				Письмо.ОтправительПредставление = Сообщение.ИмяОтправителя;
				
				Выполнить("Письмо.СтатусПисьма = Перечисления.СтатусыИсходящегоЭлектронногоПисьма.Исходящее");
				Выполнить("Письмо.ТипТекста = ?(Сообщение.Тексты[0].ТипТекста = ТипТекстаПочтовогоСообщения.HTML,
					|Перечисления.ТипыТекстовЭлектронныхПисем.HTML,
					|Перечисления.ТипыТекстовЭлектронныхПисем.ПростойТекст)");
				
				Письмо.Тема                     = Сообщение.Тема;
				
				Если Сообщение.Тексты[0].ТипТекста = ТипТекстаПочтовогоСообщения.HTML Тогда
					Письмо.ТекстHTML = Сообщение.Тексты[0].Текст;
					Выполнить("Письмо.Текст = Взаимодействия.ПолучитьОбычныйТекстИзHTML(Письмо.ТекстHTML)");
				Иначе
					Письмо.Текст = Сообщение.Тексты[0].Текст;
				КонецЕсли;
				
				Выполнить("Письмо.СписокПолучателейПисьма = ВзаимодействияКлиентСервер.ПолучитьПредставлениеСпискаАдресатов(Письмо.ПолучателиПисьма, Ложь)");
				Выполнить("Письмо.СписокПолучателейСкрытыхКопий = ВзаимодействияКлиентСервер.ПолучитьПредставлениеСпискаАдресатов(Письмо.ПолучателиСкрытыхКопий, Ложь)");
				
				Письмо.Записать();
				
				Для каждого Вложение Из Сообщение.Вложения Цикл
					АдресВременногоХранилища = ПоместитьВоВременноеХранилище(Вложение.Данные);
					ПрисоединенныйФайл = Неопределено;
					Выполнить("ПрисоединенныйФайл = УправлениеЭлектроннойПочтой.ЗаписатьВложениеЭлектронногоПисьмаИзВременногоХранилища(
						|Письмо.Ссылка, АдресВременногоХранилища, Вложение.Идентификатор, 0)");
					ПрисоединенныйФайлОбъект = ПрисоединенныйФайл.ПолучитьОбъект();
					ПрисоединенныйФайлОбъект.ИДФайлаЭлектронногоПисьма = Вложение.Идентификатор;
					ПрисоединенныйФайлОбъект.Записать();
				КонецЦикла;
				
				РегистрыСведений.ПЛ_Уведомления.СделатьЗаписьОбОтправкеУведомления(ЭлементМассива.Уведомление, Источник, Истина);
				Результат.ОтправленныеСообщения.Добавить(ЭлементМассива.Уведомление);
			КонецЦикла;
			
			Реквизиты = Неопределено;
			Выполнить("Реквизиты = ВзаимодействияКлиентСервер.СтруктураРеквизитовВзаимодействияДляЗаписи(, Письмо.Ссылка, Истина)");
			Выполнить("ВзаимодействияВызовСервера.ЗаписьРегистрРеквизитыВзаимодействия(Письмо.Ссылка, Реквизиты)");
			
		Исключение
			
			ТекстСообщения = НСтр("ru = 'Не удалось создать электронные письма по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Отправка уведомления о событии'"),
				УровеньЖурналаРегистрации.Предупреждение,,,
				ТекстСообщения);
				
			Результат.ОписаниеОшибки = ТекстСообщения;
		КонецПопытки;
		
	ИначеЕсли ВерсияУТ = "10" Тогда
		
		Попытка
			
			Для каждого ЭлементМассива Из Сообщения Цикл
				
				Сообщение = ЭлементМассива.ПочтовоеСообщение;
				
				Письмо = Неопределено;
				Выполнить("Письмо = Документы.ЭлектронноеПисьмо.СоздатьДокумент()");
				
				Для каждого Получатель Из Сообщение.Получатели Цикл
					НовыйПолучатель = Письмо.КомуТЧ.Добавить();
					НовыйПолучатель.АдресЭлектроннойПочты  = Получатель.Адрес;
					НовыйПолучатель.Представление          = Получатель.ОтображаемоеИмя;
					
					Если Не ПустаяСтрока(Письмо.Кому) Тогда
						Письмо.Кому = Письмо.Кому + ", ";
					КонецЕсли;
						
					Если ПустаяСтрока(Получатель.ОтображаемоеИмя) Тогда
						Письмо.Кому = Письмо.Кому + Получатель.Адрес;
					Иначе
						Письмо.Кому = Письмо.Кому + Получатель.ОтображаемоеИмя + " <" + Получатель.Адрес + ">";
					КонецЕсли;
				КонецЦикла;
				
				Для каждого Получатель Из Сообщение.СлепыеКопии Цикл
					НовыйПолучатель = Письмо.СкрытыеКопииТЧ.Добавить();
					НовыйПолучатель.АдресЭлектроннойПочты  = Получатель.Адрес;
					НовыйПолучатель.Представление          = Получатель.ОтображаемоеИмя;
				КонецЦикла;
				
				Если Письмо.КомуТЧ.Количество() = 0 И Письмо.СкрытыеКопииТЧ.Количество() = 0 Тогда
					Возврат;
				КонецЕсли;
				
				Выполнить("Письмо.Ответственный = Пользователи.ТекущийПользователь()");
				Письмо.Дата                     = ТекущаяДатаСеанса();
				Письмо.КодировкаПисьма          = "UTF-8";
				Письмо.УчетнаяЗапись            = УчетнаяЗапись;
				
				Письмо.ОтправительИмя           = Сообщение.ИмяОтправителя;
				Письмо.ОтправительПредставление = Сообщение.ИмяОтправителя;
				
				Выполнить("Письмо.СтатусПисьма = Перечисления.СтатусыПисем.Исходящее");
				Выполнить("Письмо.ВидТекстаПисьма = ?(Сообщение.Тексты[0].ТипТекста = ТипТекстаПочтовогоСообщения.HTML,
					|Перечисления.ВидыТекстовЭлектронныхПисем.HTMLСКартинками,
					|Перечисления.ТипыТекстовЭлектронныхПисем.Текст)");
				
				Письмо.Тема                     = Сообщение.Тема;
				Письмо.Предмет                  = "";
				Письмо.ТекстПисьма              = Сообщение.Тексты[0].Текст;
				
				Письмо.ЕстьВложения = Сообщение.Вложения.Количество();
				
				Для каждого Вложение Из Сообщение.Вложения Цикл
					Если ЗначениеЗаполнено(Вложение.Идентификатор) Тогда
						Картинка = Новый Картинка(Вложение.Данные);
						ИмяВременногоФайла = ПолучитьИмяВременногоФайла(Строка(Картинка.Формат()));
						Картинка.Записать(ИмяВременногоФайла);
						Письмо.ТекстПисьма = СтрЗаменить(Письмо.ТекстПисьма, "cid:" + Вложение.Идентификатор, "file://" + ИмяВременногоФайла);
					КонецЕсли;
				КонецЦикла;
				
				Письмо.Записать();
				
				Для каждого Вложение Из Сообщение.Вложения Цикл
					
					Если ЗначениеЗаполнено(Вложение.Идентификатор) Тогда
						Продолжить;
					КонецЕсли;
					
					ПрисоединенныйФайл = Неопределено;
					Выполнить("ПрисоединенныйФайл = Справочники.ВложенияЭлектронныхПисем.СоздатьЭлемент()");
					ПрисоединенныйФайл.Объект = Письмо.Ссылка;
					ПрисоединенныйФайл.ИмяФайла = Вложение.ИмяФайла;
					ПрисоединенныйФайл.Хранилище = Новый ХранилищеЗначения(Вложение.Данные);
					ПрисоединенныйФайл.Записать();
				КонецЦикла;
				
				РегистрыСведений.ПЛ_Уведомления.СделатьЗаписьОбОтправкеУведомления(ЭлементМассива.Уведомление, Источник, Истина);
				Результат.ОтправленныеСообщения.Добавить(ЭлементМассива.Уведомление);
			КонецЦикла;
			
		Исключение
			
			ТекстСообщения = НСтр("ru = 'Не удалось создать электронные письма по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Отправка уведомления о событии'"),
				УровеньЖурналаРегистрации.Предупреждение,,,
				ТекстСообщения);
				
			Результат.ОписаниеОшибки = ТекстСообщения;
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

// Осуществляет отправку почтового сообщения через сервис рассылки
//
Процедура ОтправитьПочтовыеСообщенияЧерезСервис(Сообщения, Результат)
	
	Результат = ПЛ_Рассылки.ОтправитьСообщения(Сообщения);
	
	Если Результат <> Неопределено Тогда
		Если Результат.ОтправленныеСообщения.Количество() Тогда
			
			Для каждого Сообщение Из Сообщения Цикл
				Для каждого ОтправленноеСообщение Из Результат.ОтправленныеСообщения Цикл
					
					Если ОтправленноеСообщение.Уведомление = Сообщение.Уведомление Тогда
						Если ОтправленноеСообщение.ИдентификаторСообщения <> Неопределено Тогда
							РегистрыСведений.ПЛ_Уведомления.СделатьЗаписьОбОтправкеУведомления(Сообщение, "", Истина);
						КонецЕсли;
					КонецЕсли;
					
				КонецЦикла;
			КонецЦикла;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// СМС

Процедура ОтправитьСМС(Сообщение, Источник, НастройкиСМС, СМСДоступны, Результат)
	
	Результат = "";
	
	Если СМСДоступны Тогда
		
		Попытка
			Выполнить("Результат = ОтправкаSMS.ОтправитьSMS(Сообщение.НомераПолучателей, Сообщение.Текст, НастройкиСМС.ИмяОтправителяСМС);");
			
			Если Результат <> Неопределено Тогда
				Если Не ЗначениеЗаполнено(Результат.ОписаниеОшибки) Тогда
					РегистрыСведений.ПЛ_Уведомления.СделатьЗаписьОбОтправкеУведомления(Сообщение.Уведомление, Источник, Истина);
					Результат.ОтправленныеСообщения.Добавить(Сообщение.Уведомление);
				Иначе
					ТекстСообщения = НСтр("ru = 'Не удалось отправить SMS по причине: %Причина%'");
					ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", Результат.ОписаниеОшибки);
					ЗаписьЖурналаРегистрации(НСтр("ru = 'Отправка уведомления о событии'"),
						УровеньЖурналаРегистрации.Предупреждение,,,
						ТекстСообщения);
						
					Результат.ОписаниеОшибки = ТекстСообщения;
				КонецЕсли;
			КонецЕсли;
		Исключение
		
			ТекстСообщения = НСтр("ru = 'Не удалось отправить SMS по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Отправка уведомления о событии'"),
				УровеньЖурналаРегистрации.Предупреждение,,,
				ТекстСообщения);
				
			Результат.ОписаниеОшибки = ТекстСообщения;
		КонецПопытки;
	Иначе
		
		Попытка
			Результат = ПЛ_ОтправкаСМС.ОтправитьСМС(Сообщение, НастройкиСМС);
			Если Результат <> Неопределено Тогда
				РегистрыСведений.ПЛ_Уведомления.СделатьЗаписьОбОтправкеУведомления(Сообщение.Уведомление, Источник, Истина);
				Результат.ОтправленныеСообщения.Добавить(Сообщение.Уведомление);
			Иначе
				ТекстСообщения = НСтр("ru = 'Не удалось отправить SMS по причине: %Причина%'");
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", Результат.ОписаниеОшибки);
				ЗаписьЖурналаРегистрации(НСтр("ru = 'Отправка уведомления о событии'"),
					УровеньЖурналаРегистрации.Предупреждение,,,
					ТекстСообщения);
					
				Результат.ОписаниеОшибки = ТекстСообщения;
			КонецЕсли;
		Исключение
			
			ТекстСообщения = НСтр("ru = 'Не удалось отправить SMS по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Отправка уведомления о событии'"),
				УровеньЖурналаРегистрации.Предупреждение,,,
				ТекстСообщения);
				
			Результат.ОписаниеОшибки = ТекстСообщения;
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

Процедура СохранитьСМС(Сообщение, Источник, НастройкиСМС, Результат)
	
	Попытка
		
		СообщениеСМС = Неопределено;
		Выполнить("СообщениеСМС = Документы.СообщениеSMS.СоздатьДокумент()");
		
		Для каждого СтрокаАдресата Из Сообщение.Уведомление.АдресатыРасширенно Цикл
			НоваяСтрока = СообщениеСМС.Адресаты.Добавить();
			НоваяСтрока.Контакт               = СтрокаАдресата.Адресат;
			НоваяСтрока.ПредставлениеКонтакта = Строка(СтрокаАдресата.Адресат);
			НоваяСтрока.КакСвязаться          = СтрокаАдресата.Адрес;
			НоваяСтрока.НомерДляОтправки      = ФорматироватьНомер(СтрокаАдресата.Адрес);
			Выполнить("НоваяСтрока.СостояниеСообщения = Перечисления.СостоянияСообщенияSMS.Исходящее");
		КонецЦикла;
		
		СообщениеСМС.ТекстСообщения = Сообщение.Текст;
		СообщениеСМС.Дата           = ТекущаяДатаСеанса();
		Выполнить("СообщениеСМС.Ответственный = Пользователи.ТекущийПользователь()");
		СообщениеСМС.Записать();
		
		РегистрыСведений.ПЛ_Уведомления.СделатьЗаписьОбОтправкеУведомления(Сообщение.Уведомление, Источник, Истина);
		Результат.ОтправленныеСообщения.Добавить(Сообщение.Уведомление);
		
	Исключение
		
		ТекстСообщения = НСтр("ru = 'Не удалось создать сообщение SMS по причине: %Причина%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Отправка уведомления о событии'"),
			УровеньЖурналаРегистрации.Предупреждение,,,
			ТекстСообщения);
			
		Результат.ОписаниеОшибки = ТекстСообщения;
	КонецПопытки;
	
КонецПроцедуры

Функция ФорматироватьНомер(Номер)
	
	Результат = "";
	ДопустимыеСимволы = "1234567890";
	Для Позиция = 1 По СтрДлина(Номер) Цикл
		Символ = Сред(Номер,Позиция,1);
		Если Найти(ДопустимыеСимволы, Символ) > 0 Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

// Напоминания

Процедура СоздатьНапоминание(Сообщение, Источник, ВидНапоминаний, Результат)
	
	Для каждого Адресат из Сообщение.Пользователи Цикл
		
		Попытка
			
			ДатаНапоминания = ТекущаяДата();
			
			Если ВидНапоминаний = "БСП" Тогда
				
				ВремяНапоминания = ТекущаяДата();
				
				ЗаписьРегистра = "";
				Выполнить("ЗаписьРегистра = РегистрыСведений.НапоминанияПользователя.СоздатьМенеджерЗаписи();");
				
				Если ТипЗнч(ЗаписьРегистра.Пользователь) = ТипЗнч(Адресат) Тогда
					
					ЗаписьРегистра.Пользователь               = Адресат;
					ЗаписьРегистра.ВремяСобытия               = ВремяНапоминания;
					ЗаписьРегистра.Источник                   = Сообщение.Источник;
					ЗаписьРегистра.СрокНапоминания            = ВремяНапоминания;
					ЗаписьРегистра.ИнтервалВремениНапоминания = 0;
				
					ЗаписьРегистра.Описание                 = Лев(СокрЛП(Сообщение.Текст), 255);
					Выполнить("ЗаписьРегистра.СпособУстановкиВремениНапоминания = Перечисления.СпособыУстановкиВремениНапоминания.ВУказанноеВремя;");
				
					ЗаписьРегистра.Записать();
				КонецЕсли;
				
			ИначеЕсли ВидНапоминаний = "CRM" Тогда
				
				ЗаписьРегистра = "";
				Выполнить("ЗаписьРегистра = РегистрыСведений.CRM_Напоминания.СоздатьМенеджерЗаписи();");
				
				ЗаписьРегистра.Пользователь             = Адресат;
				ЗаписьРегистра.Активность               = Истина;
				ЗаписьРегистра.РеальнаяДатаОповещения   = ДатаНапоминания;
				ЗаписьРегистра.Автор                    = Адресат;
				ЗаписьРегистра.Объект                   = Сообщение.Источник;
				
				ЗаписьРегистра.ТипПериода               = "00";
				ЗаписьРегистра.УдалитьПоИстеченииСрока  = Истина;
				
				ЗаписьРегистра.ДатаНачала               = ДатаНапоминания;
				ЗаписьРегистра.ДатаОповещения           = ДатаНапоминания;
				ЗаписьРегистра.Тема                     = Сообщение.Тема;
				ЗаписьРегистра.Описание                 = Сообщение.Текст;
				
				ЗаписьРегистра.Записать();
				
			ИначеЕсли ВидНапоминаний = "События" Тогда
				
				ДокументСобытие = "";
				Выполнить("ДокументСобытие = Документы.Событие.СоздатьДокумент();");
				
				ДокументСобытие.Дата                    = ДатаНапоминания;
				
				Выполнить("ДокументСобытие.ВидСобытия = Перечисления.ВидыСобытий.Прочее;");
				Выполнить("ДокументСобытие.СостояниеСобытия = Перечисления.СостоянияСобытий.Запланировано;");
				
				ДокументСобытие.Ответственный           = Адресат;
				ДокументСобытие.Основание               = Сообщение.Источник;
				
				ДокументСобытие.ОписаниеСобытия         = Сообщение.Тема;
				ДокументСобытие.СодержаниеСобытия       = Сообщение.Текст;
				
				ДокументСобытие.НапомнитьОСобытии       = Истина;
				ДокументСобытие.НачалоСобытия           = ДатаНапоминания;
				ДокументСобытие.ОкончаниеСобытия        = ДатаНапоминания;
				
				ДокументСобытие.Записать(РежимЗаписиДокумента.Проведение);
				
			ИначеЕсли ВидНапоминаний = "Задачи" Тогда
				
				НоваяЗадача = "";
				Выполнить("НоваяЗадача = Задачи.ЗадачиПользователя.СоздатьЗадачу();");
				НоваяЗадача.Дата                        = ТекущаяДата();
				НоваяЗадача.Наименование                = Сообщение.Тема;
				НоваяЗадача.Описание                    = Сообщение.Текст;
				НоваяЗадача.ПамятнаяДата                = Истина;
				НоваяЗадача.Исполнитель                 = Адресат;
				НоваяЗадача.Инициатор                   = Адресат;
				НоваяЗадача.СрокИсполнения              = ДатаНапоминания;
				НоваяЗадача.Оповещение                  = Истина;
				НоваяЗадача.СрокОповещения              = ДатаНапоминания;
				НоваяЗадача.Объект                      = Сообщение.Источник;
				
				НоваяЗадача.Записать();
				
			КонецЕсли;
			
			РегистрыСведений.ПЛ_Уведомления.СделатьЗаписьОбОтправкеУведомления(Сообщение.Уведомление, Источник, Истина);
			Результат.ОтправленныеСообщения.Добавить(Сообщение.Уведомление);
			
		Исключение
			
			ТекстСообщения = НСтр("ru = 'Не удалось создать напоминание пользователю по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Отправка уведомления о событии'"),
				УровеньЖурналаРегистрации.Предупреждение,,,
				ТекстСообщения);
				
			Результат.ОписаниеОшибки = ТекстСообщения;
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

// Шаблоны

// Выбирает из шаблона текста все переменные и возвращает соответствие
//
Функция РеквизитыШаблонаСообщения(Знач Текст)
	
	МассивРеквизитов = Новый Массив;
	
	НачПоз = Найти(Текст, "%%");
	Пока НачПоз > 0 Цикл
		Текст = Сред(Текст, НачПоз + 2);
		КонПоз = Найти(Текст, "%%");
		Если КонПоз > 0 Тогда
			Реквизит = Лев(Текст, КонПоз - 1);
			Если МассивРеквизитов.Найти(Реквизит) = Неопределено Тогда
				МассивРеквизитов.Добавить(Реквизит);
			КонецЕсли;
			Текст = Сред(Текст, КонПоз + 2);
		КонецЕсли;
		НачПоз = Найти(Текст, "%%");
	КонецЦикла;
	
	СоответствиеРеквизитов = Новый Соответствие;
	Для каждого Реквизит из МассивРеквизитов Цикл
		Ключ = Реквизит;
		Ключ = СтрЗаменить(Ключ, ".", "");
		Ключ = СтрЗаменить(Ключ, " ", "");
		Ключ = СтрЗаменить(Ключ, "[", "_");
		Ключ = СтрЗаменить(Ключ, "]", "_");
		Ключ = СтрЗаменить(Ключ, "(", "_");
		Ключ = СтрЗаменить(Ключ, ")", "_");
		СоответствиеРеквизитов.Вставить(Ключ, Реквизит);
	КонецЦикла;
	
	Возврат СоответствиеРеквизитов;
	
КонецФункции

// Формирует табличный документ по СКД таблицы и преобразует его в текстовый формат
//
Функция ПолучитьТаблицуВВидеТекста(ТипИсточника, Источник, АдресСхемы, АдресНастроек, ОбычныйТекст, ПоляВыбораАдресатов = Неопределено, Адресат = Неопределено)
	
	СхемаКомпоновкиДанных = ПолучитьИзВременногоХранилища(АдресСхемы);
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемы));
	
	НастройкиКомпоновкиДанных = ПолучитьИзВременногоХранилища(АдресНастроек);
	КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиКомпоновкиДанных);
	
	ПолеПараметр = Новый ПараметрКомпоновкиДанных("Источник");
	ЗначениеПараметра = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(ПолеПараметр);
	Если ЗначениеПараметра <> Неопределено Тогда
		ЗначениеПараметра.Использование = Истина;
		ЗначениеПараметра.Значение      = Источник;
	КонецЕсли;
	
	Если ПоляВыбораАдресатов <> Неопределено И Адресат <> Неопределено Тогда
		
		ГруппаОтбора = КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
		
		Для каждого Поле Из ПоляВыбораАдресатов Цикл
			ЭлементОтбора = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементОтбора.ЛевоеЗначение = Поле;
			ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
			ЭлементОтбора.ПравоеЗначение = Адресат;
			ЭлементОтбора.Использование = Истина;
		КонецЦикла;
	КонецЕсли;
	
	// Отборы набора записей регистра
	Если ТипИсточника = Перечисления.ПЛ_ИсточникиСобытий.ИсточникРегистрСведений Тогда
		Для каждого Элемент из Источник Цикл
			ЭлементОтбора = КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Элемент.Ключ);
			ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
			ЭлементОтбора.ПравоеЗначение = Элемент.Значение;
			ЭлементОтбора.Использование = Истина;
		КонецЦикла;
	КонецЕсли;
	
	КомпоновщикНастроек.Восстановить();
	
	КомпоновщикМакетаКомпоновкиДанных = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновкиДанных = КомпоновщикМакетаКомпоновкиДанных.Выполнить(СхемаКомпоновкиДанных, КомпоновщикНастроек.ПолучитьНастройки(),,,);
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновкиДанных,,, Истина);
	
	ДокументРезультат = Новый ТабличныйДокумент;
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	Если ОбычныйТекст Тогда
		ТипФайла = ТипФайлаТабличногоДокумента.TXT;
	Иначе
		ТипФайла = ТипФайлаТабличногоДокумента.HTML4;
	КонецЕсли;
	
	ВременныйФайл = ПолучитьИмяВременногоФайла();
	ДокументРезультат.Записать(ВременныйФайл, ТипФайла);
	
	ВременныйТекстовыйДокумент = Новый ТекстовыйДокумент;
	ВременныйТекстовыйДокумент.Прочитать(ВременныйФайл);
	
	УдалитьФайлы(ВременныйФайл);
	
	ТекстТаблицы = ВременныйТекстовыйДокумент.ПолучитьТекст();
	
	Возврат ТекстТаблицы;
	
КонецФункции

// Компоновка

// Очищает все элементы настройки компоновки данных из объекта
// Параметры:
//	Настройки - настройки КД
//
Процедура ОчиститьНастройкиКомпоновкиДанных(Настройки)
	
	Если ТипЗнч(Настройки) <> Тип("НастройкиКомпоновкиДанных") Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого Параметр Из Настройки.ПараметрыДанных.Элементы Цикл
		Параметр.Значение = Неопределено;
		Параметр.Использование = ложь;
	КонецЦикла;
	
	Для каждого Параметр Из Настройки.ПараметрыВывода.Элементы Цикл
		Параметр.Использование = ложь;
	КонецЦикла;
	
	Настройки.Отбор.Элементы.Очистить();
	
КонецПроцедуры

// Копирует настройки компоновки данных
//
// Параметры:
//	НастройкиПриемник	- коллекция настроек КД, куда копируются настройки
//	НастройкиИсточник	- коллекция настроек КД, откуда копируются настройки
//
Процедура СкопироватьНастройкиКомпоновкиДанных(НастройкиПриемник, НастройкиИсточник) Экспорт
	
	Если НастройкиИсточник = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(НастройкиПриемник) = Тип("НастройкиКомпоновкиДанных") Тогда
		
		Для каждого Параметр Из НастройкиИсточник.ПараметрыДанных.Элементы Цикл
			ЗначениеПараметра = НастройкиПриемник.ПараметрыДанных.НайтиЗначениеПараметра(Параметр.Параметр);
			Если ЗначениеПараметра <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(ЗначениеПараметра, Параметр);
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого ЭлементОтбора из НастройкиИсточник.Отбор.Элементы Цикл
			Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
				ДобавитьЭлементВОтбор(НастройкиПриемник.Отбор, ЭлементОтбора);
			Иначе
				ДобавитьГруппуЭлементовВОтбор(НастройкиПриемник.Отбор, ЭлементОтбора);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьЭлементВОтбор(ОтборПриемник, ЭлементОтбора, СтрокаПоиска = Неопределено, СтрокаЗамены = Неопределено)
	
	НовыйЭлемент = ОтборПриемник.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЗаполнитьЗначенияСвойств(НовыйЭлемент, ЭлементОтбора);
	
	Если СтрокаПоиска <> Неопределено
		И СтрокаЗамены <> Неопределено Тогда
		СтрокаУсловия = Строка(НовыйЭлемент.ЛевоеЗначение);
		СтрокаУсловия = СтрЗаменить(СтрокаУсловия, СтрокаПоиска, СтрокаЗамены);
		НовыйЭлемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(СтрокаУсловия);
	КонецЕсли;
		
КонецПроцедуры

Процедура ДобавитьГруппуЭлементовВОтбор(ОтборПриемник, ГруппаЭлементов, СтрокаПоиска = Неопределено, СтрокаЗамены = Неопределено)
	
	НоваяГруппа = ОтборПриемник.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ЗаполнитьЗначенияСвойств(НоваяГруппа, ГруппаЭлементов);
	
	Для Каждого ЭлементОтбора из ГруппаЭлементов.Элементы Цикл
		Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			ДобавитьЭлементВОтбор(НоваяГруппа, ЭлементОтбора, СтрокаПоиска, СтрокаЗамены);
		Иначе
			ДобавитьГруппуЭлементовВОтбор(НоваяГруппа, ЭлементОтбора, СтрокаПоиска, СтрокаЗамены);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Прочее

// Возвращает набор полей структуры проверки уникальности сообщений
//
Функция ИнициализироватьСтруктуруПроверкиУникальности()
	
	Возврат Новый Структура(
		"Уведомление,
		|Источник,
		|СпособДоставки,
		|Тема,
		|Текст,
		|Адресат,
		|КонтрольнаяСумма
		|");
	
КонецФункции

// Вычисляет и возвращает числовой вес версии подсистемы
//
Функция ВесВерсии(Знач Версия)
	
	РазрядыВерсии = РазложитьСтрокуВМассивПодстрок(Версия);
	
	Возврат 0
		+ Число(РазрядыВерсии[0]) * 1000000
		+ Число(РазрядыВерсии[1]) * 10000
		+ Число(РазрядыВерсии[2]) * 100
		+ Число(РазрядыВерсии[3]) * 1;
	
КонецФункции

// Разбивает строку на несколько строк по разделителю. Разделитель может иметь любую длину
//
// Параметры:
//  Строка                 - Строка - текст с разделителями;
//  Разделитель            - Строка - разделитель строк текста, минимум 1 символ;
//
// Возвращаемое значение: массив строк
//
Функция РазложитьСтрокуВМассивПодстрок(Знач Строка, Знач Разделитель = ".")
	
	Результат = Новый Массив;
	
	Позиция = Найти(Строка, Разделитель);
	Пока Позиция > 0 Цикл
		Подстрока = Лев(Строка, Позиция - 1);
		Если НЕ ПустаяСтрока(Подстрока) Тогда
			Результат.Добавить(Подстрока);
		КонецЕсли;
		Строка = Сред(Строка, Позиция + СтрДлина(Разделитель));
		Позиция = Найти(Строка, Разделитель);
	КонецЦикла;
	
	Если НЕ ПустаяСтрока(Строка) Тогда
		Результат.Добавить(Строка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СтрокаИзМассиваПодстрок(Массив, Разделитель = ",", СокращатьНепечатаемыеСимволы = Ложь) Экспорт
	
	Результат = "";
	
	Для Индекс = 0 По Массив.ВГраница() Цикл
		Подстрока = Массив[Индекс];
		
		Если СокращатьНепечатаемыеСимволы Тогда
			Подстрока = СокрЛП(Подстрока);
		КонецЕсли;
		
		Если ТипЗнч(Подстрока) <> Тип("Строка") Тогда
			Подстрока = Строка(Подстрока);
		КонецЕсли;
		
		Если Индекс > 0 Тогда
			Результат = Результат + Разделитель;
		КонецЕсли;
		
		Результат = Результат + Подстрока;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПодставитьПараметрыВСтроку(Знач СтрокаПодстановки,
	Знач Параметр1, Знач Параметр2 = Неопределено, Знач Параметр3 = Неопределено,
	Знач Параметр4 = Неопределено, Знач Параметр5 = Неопределено, Знач Параметр6 = Неопределено,
	Знач Параметр7 = Неопределено, Знач Параметр8 = Неопределено, Знач Параметр9 = Неопределено) Экспорт
	
	ИспользоватьАльтернативныйАлгоритм = 
		Найти(Параметр1, "%")
		Или Найти(Параметр2, "%")
		Или Найти(Параметр3, "%")
		Или Найти(Параметр4, "%")
		Или Найти(Параметр5, "%")
		Или Найти(Параметр6, "%")
		Или Найти(Параметр7, "%")
		Или Найти(Параметр8, "%")
		Или Найти(Параметр9, "%");
		
	Если ИспользоватьАльтернативныйАлгоритм Тогда
		СтрокаПодстановки = ПодставитьПараметрыВСтрокуАльтернативныйАлгоритм(СтрокаПодстановки, Параметр1,
			Параметр2, Параметр3, Параметр4, Параметр5, Параметр6, Параметр7, Параметр8, Параметр9);
	Иначе
		СтрокаПодстановки = СтрЗаменить(СтрокаПодстановки, "%1", Параметр1);
		СтрокаПодстановки = СтрЗаменить(СтрокаПодстановки, "%2", Параметр2);
		СтрокаПодстановки = СтрЗаменить(СтрокаПодстановки, "%3", Параметр3);
		СтрокаПодстановки = СтрЗаменить(СтрокаПодстановки, "%4", Параметр4);
		СтрокаПодстановки = СтрЗаменить(СтрокаПодстановки, "%5", Параметр5);
		СтрокаПодстановки = СтрЗаменить(СтрокаПодстановки, "%6", Параметр6);
		СтрокаПодстановки = СтрЗаменить(СтрокаПодстановки, "%7", Параметр7);
		СтрокаПодстановки = СтрЗаменить(СтрокаПодстановки, "%8", Параметр8);
		СтрокаПодстановки = СтрЗаменить(СтрокаПодстановки, "%9", Параметр9);
	КонецЕсли;
	
	Возврат СтрокаПодстановки;
КонецФункции

Функция ПодставитьПараметрыВСтрокуАльтернативныйАлгоритм(Знач СтрокаПодстановки,
	Знач Параметр1, Знач Параметр2 = Неопределено, Знач Параметр3 = Неопределено,
	Знач Параметр4 = Неопределено, Знач Параметр5 = Неопределено, Знач Параметр6 = Неопределено,
	Знач Параметр7 = Неопределено, Знач Параметр8 = Неопределено, Знач Параметр9 = Неопределено)
	
	Результат = "";
	Позиция = Найти(СтрокаПодстановки, "%");
	Пока Позиция > 0 Цикл 
		Результат = Результат + Лев(СтрокаПодстановки, Позиция - 1);
		СимволПослеПроцента = Сред(СтрокаПодстановки, Позиция + 1, 1);
		ПодставляемыйПараметр = "";
		Если СимволПослеПроцента = "1" Тогда
			ПодставляемыйПараметр =  Параметр1;
		ИначеЕсли СимволПослеПроцента = "2" Тогда
			ПодставляемыйПараметр =  Параметр2;
		ИначеЕсли СимволПослеПроцента = "3" Тогда
			ПодставляемыйПараметр =  Параметр3;
		ИначеЕсли СимволПослеПроцента = "4" Тогда
			ПодставляемыйПараметр =  Параметр4;
		ИначеЕсли СимволПослеПроцента = "5" Тогда
			ПодставляемыйПараметр =  Параметр5;
		ИначеЕсли СимволПослеПроцента = "6" Тогда
			ПодставляемыйПараметр =  Параметр6;
		ИначеЕсли СимволПослеПроцента = "7" Тогда
			ПодставляемыйПараметр =  Параметр7
		ИначеЕсли СимволПослеПроцента = "8" Тогда
			ПодставляемыйПараметр =  Параметр8;
		ИначеЕсли СимволПослеПроцента = "9" Тогда
			ПодставляемыйПараметр =  Параметр9;
		КонецЕсли;
		Если ПодставляемыйПараметр = "" Тогда
			Результат = Результат + "%";
			СтрокаПодстановки = Сред(СтрокаПодстановки, Позиция + 1);
		Иначе
			Результат = Результат + ПодставляемыйПараметр;
			СтрокаПодстановки = Сред(СтрокаПодстановки, Позиция + 2);
		КонецЕсли;
		Позиция = Найти(СтрокаПодстановки, "%");
	КонецЦикла;
	Результат = Результат + СтрокаПодстановки;
	
	Возврат Результат;
КонецФункции

// Получает расширение для имени переданного файла
//
// Параметры:
//    ИмяФайла - Строка - Имя файла
//
// Возвращаемое значение:
//    Строка - Расширение
//
Функция ИмяФайлаБезРасширения(Знач ИмяФайла) Экспорт
	
	ИмяФайлаБезРасширения = "";
	МассивСтрок = РазложитьСтрокуВМассивПодстрок(ИмяФайла, ".");
	Если МассивСтрок.Количество() > 1 Тогда
		ИмяФайлаБезРасширения = МассивСтрок[0];
	КонецЕсли;
	
	Возврат ИмяФайлаБезРасширения;
	
КонецФункции

// Возвращает структуру, содержащую значения реквизитов прочитанные из информационной базы
// по ссылке на объект.
// 
//  Если доступа к одному из реквизитов нет, возникнет исключение прав доступа.
//  Если необходимо зачитать реквизит независимо от прав текущего пользователя,
//  то следует использовать предварительный переход в привилегированный режим.
// 
// Параметры:
//  Ссылка    - Ссылка на объект - элемент справочника, документ, ...
//
//  Реквизиты - Строка - имена реквизитов, перечисленные через запятую, в формате
//              требований к свойствам структуры.
//              Например, "Код, Наименование, Родитель".
//            - Структура, ФиксированнаяСтруктура - в качестве ключа передается
//              псевдоним поля для возвращаемой структуры с результатом, а в качестве
//              значения (опционально) фактическое имя поля в таблице.
//              Если значение не определено, то имя поля берется из ключа.
//            - Массив, ФиксированныйМассив - имена реквизитов в формате требований
//              к свойствам структуры.
//
// Возвращаемое значение:
//  Структура - содержит имена (ключи) и значения затребованных реквизитов.
//              Если строка затребованных реквизитов пуста, то возвращается пустая структура
//
Функция ЗначенияРеквизитовОбъекта(Ссылка, Реквизиты) Экспорт
	
	Если ТипЗнч(Реквизиты) = Тип("Строка") Тогда
		Если ПустаяСтрока(Реквизиты) Тогда
			Возврат Новый Структура;
		КонецЕсли;
		
		СтруктураРеквизитов = Новый Структура(Реквизиты);
		
	ИначеЕсли ТипЗнч(Реквизиты) = Тип("Структура")
		ИЛИ ТипЗнч(Реквизиты) = Тип("ФиксированнаяСтруктура") Тогда
		
		СтруктураРеквизитов = Реквизиты;
		
	ИначеЕсли ТипЗнч(Реквизиты) = Тип("Массив")
		ИЛИ ТипЗнч(Реквизиты) = Тип("ФиксированныйМассив") Тогда
		
		СтруктураРеквизитов = Новый Структура;
		Для каждого Реквизит Из Реквизиты Цикл
			СтруктураРеквизитов.Вставить(Реквизит);
		КонецЦикла;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	ТекстПолей = "";
	Для Каждого КлючИЗначение Из СтруктураРеквизитов Цикл
		
		ИмяПоля   = ?(ЗначениеЗаполнено(КлючИЗначение.Значение),
			СокрЛП(КлючИЗначение.Значение),
			СокрЛП(КлючИЗначение.Ключ));
		
		Псевдоним = СокрЛП(КлючИЗначение.Ключ);
		
		ТекстПолей  = ТекстПолей + ?(ПустаяСтрока(ТекстПолей), "", ",") + "
		|	" + ИмяПоля + " КАК " + Псевдоним;
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|" + ТекстПолей + "
	|ИЗ
	|	" + Ссылка.Метаданные().ПолноеИмя() + " КАК ПсевдонимЗаданнойТаблицы
	|ГДЕ
	|	ПсевдонимЗаданнойТаблицы.Ссылка = &Ссылка
	|";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Результат = Новый Структура;
	Для Каждого КлючИЗначение Из СтруктураРеквизитов Цикл
		Результат.Вставить(КлючИЗначение.Ключ);
	КонецЦикла;
	ЗаполнитьЗначенияСвойств(Результат, Выборка);
	
	Возврат Результат;
	
КонецФункции

// Возвращает значение реквизита, прочитанного из информационной базы по ссылке на объект.
// 
//  Если доступа к реквизиту нет, возникнет исключение прав доступа.
//  Если необходимо зачитать реквизит независимо от прав текущего пользователя,
//  то следует использовать предварительный переход в привилегированный режим.
//
// Функция не предназначена для получения значений реквизитов пустых ссылок.
// 
// Параметры:
//  Ссылка       - ссылка на объект, - элемент справочника, документ, ...
//  ИмяРеквизита - Строка, например, "Код".
// 
// Возвращаемое значение:
//  Произвольный    - зависит от типа значения прочитанного реквизита.
// 
Функция ЗначениеРеквизитаОбъекта(Ссылка, ИмяРеквизита) Экспорт
	
	Результат = ЗначенияРеквизитовОбъекта(Ссылка, ИмяРеквизита);
	Возврат Результат[СтрЗаменить(ИмяРеквизита, ".", "")];
	
КонецФункции

// Определяет, является ли запущенная информационная база файловой
//
Функция ЭтоФайловаяИБ()
	
	Возврат Найти(Врег(СтрокаСоединенияИнформационнойБазы()), "FILE=") = 1;
	
КонецФункции

// Возвращает название доступной подсистемы напоминаний
//
Функция ПодсистемаНапоминаний()
	
	Если ЭтоКонфигурация("УПП") Или ЭтоКонфигурация("КА1") Тогда
		ВерсияУТ = "10УПП";
	ИначеЕсли ЭтоКонфигурация("УТ10") Тогда
		ВерсияУТ = "10УТ";
	ИначеЕсли ЭтоКонфигурация("УП") Или ЭтоКонфигурация("УТ11") Или ЭтоКонфигурация("УТ11CRM")
		Или ЭтоКонфигурация("КА2") Или ЭтоКонфигурация("Розница") Или ЭтоКонфигурация("ЗУП") Тогда
		ВерсияУТ = "11";
	Иначе
		ВерсияУТ = "";
	КонецЕсли;
	
	ВидНапоминаний = "";
	
	Если ВерсияУТ = "11" Тогда // есть поддержка БСП
		ВидНапоминаний = "БСП";
		
	ИначеЕсли ВерсияУТ = "10УПП" Тогда // поищем, вдруг есть CRM
		Если ЭтоКонфигурация("CRM") Тогда
			ВидНапоминаний = "CRM";
			
		Иначе // будем использовать документы "Событие"
			ВидНапоминаний = "События";
			
		КонецЕсли;
	ИначеЕсли ВерсияУТ = "10УТ" Тогда // поищем, вдруг есть CRM
		Если ЭтоКонфигурация("CRM") Тогда
			ВидНапоминаний = "CRM";
			
		Иначе // будем использовать документы "Задача"
			ВидНапоминаний = "Задачи";
			
		КонецЕсли;
	// поищем БСП
	ИначеЕсли Метаданные.РегистрыСведений.Найти("НапоминанияПользователя") <> Неопределено Тогда
			ВидНапоминаний = "БСП";
			
	// остаются задачи
	ИначеЕсли Метаданные.Задачи.Найти("ЗадачиПользователя") <> Неопределено Тогда
			ВидНапоминаний = "Задачи";
			
	КонецЕсли;
	
	Возврат ВидНапоминаний;
	
КонецФункции

// Возвращает номер текущей версии БСП
//
Функция ВерсияБСП()
	
	Попытка
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ВерсииПодсистем.Версия
		|ИЗ
		|	РегистрСведений.ВерсииПодсистем КАК ВерсииПодсистем
		|ГДЕ
		|	ВерсииПодсистем.ИмяПодсистемы = &ИмяПодсистемы";
		
		Запрос.УстановитьПараметр("ИмяПодсистемы", "СтандартныеПодсистемы");
		ТаблицаЗначений = Запрос.Выполнить().Выгрузить();
		Версия = "";
		Если ТаблицаЗначений.Количество() > 0 Тогда
			Версия = СокрЛП(ТаблицаЗначений[0].Версия);
		КонецЕсли;
		
		Возврат Версия;
		
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

// Возвращает ссылку на общий модуль по имени
//
// Параметры:
//    Имя - Строка - имя общего модуля
//
// Возвращаемое значение:
//    ОбщийМодуль
//
Функция ОбщийМодуль(Имя) Экспорт
	
	Если Метаданные.ОбщиеМодули.Найти(Имя) <> Неопределено Тогда
		Модуль = Вычислить(Имя);
	Иначе
		Модуль = Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(Модуль) <> Тип("ОбщийМодуль") Тогда
		ВызватьИсключение ПодставитьПараметрыВСтроку(НСтр("ru = 'Общий модуль ""%1"" не найден.'"), Имя);
	КонецЕсли;
	
	Возврат Модуль;
	
КонецФункции

