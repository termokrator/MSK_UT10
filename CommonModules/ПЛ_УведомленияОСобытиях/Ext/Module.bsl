// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Обновление

// Возвращает текущую версию подсистемы уведомлений. Редактируется при выпуске новых версий
//
// Возвращаемое значение
//    Структура, содержащая номер новой версии в формате "1.2.3" и ее вес, равный 1 * 10000 + 2 * 100 + 3.
//
Функция ТекущаяВерсияПодсистемыУведомлений()
	
	НомерВерсии = "2.0.1.16";
	Вес = ВесВерсии(НомерВерсии);
	
	Возврат Новый Структура("НомерВерсии, Вес", СокрЛП(НомерВерсии), Вес);
	
КонецФункции

// Возвращает таблицу, содержащую названия процедур обработчиков для различных версий подсистемы
//
Функция ТаблицаОбработчиковОбновления()
	
	ТаблицаОбработчиков = Новый ТаблицаЗначений();
	ТаблицаОбработчиков.Колонки.Добавить("Версия", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(0)));
	ТаблицаОбработчиков.Колонки.Добавить("Вес", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10)));
	ТаблицаОбработчиков.Колонки.Добавить("Процедура", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(0)));
	
	Обработчик = ТаблицаОбработчиков.Добавить();
	Обработчик.Версия    = "1.0.2.0";
	Обработчик.Процедура = "ДобавитьНастройкиСоединенияСРабочейБазой";
	
	Обработчик = ТаблицаОбработчиков.Добавить();
	Обработчик.Версия    = "1.0.5.1";
	Обработчик.Процедура = "УстановитьСпособУведомленияПоЭлПочте";
	
	Обработчик = ТаблицаОбработчиков.Добавить();
	Обработчик.Версия    = "1.0.5.4";
	Обработчик.Процедура = "ДобавитьНастройкиСМС";
	
	Обработчик = ТаблицаОбработчиков.Добавить();
	Обработчик.Версия    = "1.0.6.3";
	Обработчик.Процедура = "СоздатьПреднастроенныеСобытия1_0_6_3";
	
	Обработчик = ТаблицаОбработчиков.Добавить();
	Обработчик.Версия    = "1.0.6.8";
	Обработчик.Процедура = "ДобавитьНастройкиSSL";
	
	Обработчик = ТаблицаОбработчиков.Добавить();
	Обработчик.Версия    = "1.1.1.1";
	Обработчик.Процедура = "ДобавитьПолеТекущийПользователь";
	
	Обработчик = ТаблицаОбработчиков.Добавить();
	Обработчик.Версия    = "1.1.1.1";
	Обработчик.Процедура = "УстановитьСпособОтдельноКаждомуДляНапоминаний";
	
	Обработчик = ТаблицаОбработчиков.Добавить();
	Обработчик.Версия    = "1.2.1.1";
	Обработчик.Процедура = "РасширитьНастройкиСМС";
	
	Обработчик = ТаблицаОбработчиков.Добавить();
	Обработчик.Версия    = "1.2.1.3";
	Обработчик.Процедура = "УстановитьФильтрПоАдресатам";
	
	Обработчик = ТаблицаОбработчиков.Добавить();
	Обработчик.Версия    = "2.0.1.1";
