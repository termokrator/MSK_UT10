// Создает преднастроенные события версии 1_0_6_3
//
Процедура СоздатьПреднастроенныеСобытия1_0_6_3()
	
	ВерсияПодсистемыУТ = ВерсияУТ();
	
	ГруппаПреднастроенные = Справочники.ПЛ_События.НайтиПоНаименованию(НСтр("ru = 'Преднастроенные'"), Истина);
	
	Если НЕ ЗначениеЗаполнено(ГруппаПреднастроенные)
		И (ВерсияПодсистемыУТ = "10" Или ВерсияПодсистемыУТ = "11") Тогда
		ГруппаПреднастроенные = Справочники.ПЛ_События.СоздатьГруппу();
		ГруппаПреднастроенные.Наименование = НСтр("ru = 'Преднастроенные'");
		ГруппаПреднастроенные.Записать();
		ГруппаПреднастроенные = ГруппаПреднастроенные.Ссылка;
	КонецЕсли;
	
	НаименованиеСобытия = "";
	Если ВерсияПодсистемыУТ = "10" Тогда
		НаименованиеСобытия = НСтр("ru = 'Оплата по заказу'");
	ИначеЕсли ВерсияПодсистемыУТ = "11" Тогда
		НаименованиеСобытия = НСтр("ru = 'Оплата по графику'");
	КонецЕсли;
	
	Ссылка = Справочники.ПЛ_События.НайтиПоНаименованию(НаименованиеСобытия, Истина);
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Попытка
			
			Если ВерсияПодсистемыУТ = "10" Тогда
				
				Объект = Справочники.ПЛ_События.ОплатаПоЗаказуУТ10(НаименованиеСобытия);
				Объект.Родитель = ГруппаПреднастроенные;
				Объект.Записать();
				
			ИначеЕсли ВерсияПодсистемыУТ = "11" Тогда
				
				Объект = Справочники.ПЛ_События.ОплатаПоГрафикуУТ11(НаименованиеСобытия);
				Объект.Родитель = ГруппаПреднастроенные;
				Объект.Записать();
				
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

// Добавляет в настройки подсистемы признак использования SSL для учетной записи эл. почты
//
