// 1.1.1

// В СКД уведомлений добавляет вычисляемое поле ТекущийПользователь
//
Процедура ДобавитьПолеТекущийПользователь()
	
	ВыборкаУведомлений = Справочники.ПЛ_УведомленияОСобытиях.Выбрать();
	Пока ВыборкаУведомлений.Следующий() Цикл
		
		Если Не ВыборкаУведомлений.ЭтоГруппа Тогда
			
			Уведомление = ВыборкаУведомлений.ПолучитьОбъект();
			ИсточникСобытия = ЗначениеРеквизитаОбъекта(Уведомление.Событие, "ИсточникСобытия");
			Если ИсточникСобытия <> Перечисления.ПЛ_ИсточникиСобытий.РегламентнаяПроверка
				И ИсточникСобытия <> Перечисления.ПЛ_ИсточникиСобытий.Рассылка Тогда
				
				СхемаКомпоновки = Уведомление.СхемаШаблонаТекстовСообщения.Получить();
				Если СхемаКомпоновки <> Неопределено Тогда
					ДобавитьВКомпоновкуПолеТекущийПользователь(СхемаКомпоновки);
					Уведомление.СхемаШаблонаТекстовСообщения = Новый ХранилищеЗначения(СхемаКомпоновки);
					Уведомление.Записать();
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Возможны только индивидуальные напоминания
//
Процедура УстановитьСпособОтдельноКаждомуДляНапоминаний()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ДанныеСправочника.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПЛ_УведомленияОСобытиях КАК ДанныеСправочника
	|ГДЕ
	|	ДанныеСправочника.Напоминание
	|	И ДанныеСправочника.ДелениеПоАдресатам <> ЗНАЧЕНИЕ(Перечисление.ПЛ_ДелениеУведомленийПоАдресатам.ОтдельноКаждому)
	|";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СправочникОбъект = Выборка.Ссылка.ПолучитьОбъект();
		СправочникОбъект.ДелениеПоАдресатам = Перечисления.ПЛ_ДелениеУведомленийПоАдресатам.ОтдельноКаждому;
		СправочникОбъект.Записать();
	КонецЦикла;
	
КонецПроцедуры

// 1.2.1

// Расширяет настройки СМС
//
Процедура РасширитьНастройкиСМС()
	
	НастройкиУведомленийМенеджер = Константы.ПЛ_НастройкиУведомлений.СоздатьМенеджерЗначения();
	
	НастройкиСМС = НастройкиУведомленийМенеджер.ПолучитьНастройку("НастройкиСМС");
	НастройкиСМС.Вставить("ПровайдерСМС");
	НастройкиСМС.Вставить("ЛогинСМС", "");
	НастройкиСМС.Вставить("ПарольСМС", "");
	НастройкиУведомленийМенеджер.СохранитьНастройку("НастройкиСМС", НастройкиСМС);
	
КонецПроцедуры

// Устанавливает в уведомлениях фильтрацию по адресатам
//
Процедура УстановитьФильтрПоАдресатам()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ДанныеСправочника.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПЛ_УведомленияОСобытиях КАК ДанныеСправочника
	|ГДЕ
	|	НЕ ДанныеСправочника.ФильтрПоАдресатам
	|	И ДанныеСправочника.ДелениеПоАдресатам = ЗНАЧЕНИЕ(Перечисление.ПЛ_ДелениеУведомленийПоАдресатам.ОтдельноКаждому)
	|	И ДанныеСправочника.ЭлПочта
	|";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СправочникОбъект = Выборка.Ссылка.ПолучитьОбъект();
		СправочникОбъект.ФильтрПоАдресатам = Истина;
		СправочникОбъект.Записать();
	КонецЦикла;
	
КонецПроцедуры

// 2.0.1

// Добавляет в настройки подсистемы параметры почтовой рассылки
//
Процедура ДобавитьНастройкиПочтовойРассылки()
	
	НастройкиСервисаПочтовойРассылки = Новый Структура;
	НастройкиСервисаПочтовойРассылки.Вставить("СервисПочтовойРассылки", Неопределено);
	НастройкиСервисаПочтовойРассылки.Вставить("ЛогинПочтовойРассылки", "");
	НастройкиСервисаПочтовойРассылки.Вставить("ПарольПочтовойРассылки", "");
	
	НастройкиУведомленийМенеджер = Константы.ПЛ_НастройкиУведомлений.СоздатьМенеджерЗначения();
	НастройкиУведомленийМенеджер.СохранитьНастройку("ПодключенСервисПочтовойРассылки", Ложь);
	НастройкиУведомленийМенеджер.СохранитьНастройку("НастройкиСервисаПочтовойРассылки", НастройкиСервисаПочтовойРассылки);
	
КонецПроцедуры

// Добавляет в настройки подсистемы сохрание почтовых и СМС сообщений
//
Процедура ДобавитьНастройкиСохраненияСообщений()
	
	НастройкиУведомленийМенеджер = Константы.ПЛ_НастройкиУведомлений.СоздатьМенеджерЗначения();
	
	НастройкиУведомленийМенеджер.СохранитьНастройку("СохранятьЭлектронныеПисьма", Ложь);
	
	НастройкиСМС = НастройкиУведомленийМенеджер.ПолучитьНастройку("НастройкиСМС");
	НастройкиСМС.Вставить("СохранятьСообщенияСМС", Ложь);
	НастройкиУведомленийМенеджер.СохранитьНастройку("НастройкиСМС", НастройкиСМС);
	
КонецПроцедуры

// Добавляет настройку сохранения текущей формы списка уведомлений
//
Процедура ДобавитьНастройкиОткрытияНовойФормыУведомлений()
	
	НастройкиУведомленийМенеджер = Константы.ПЛ_НастройкиУведомлений.СоздатьМенеджерЗначения();
	НастройкиУведомленийМенеджер.СохранитьНастройку("НоваяФормаУведомлений", Истина);
	
КонецПроцедуры

// Управление активностью отправки сообщений переностится в уведомления
//
Процедура ПеренестиФлагВключенияИзСобытийВУведомления()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ДанныеСправочника.Ссылка КАК Ссылка,
	|	ДанныеСправочника.Событие.УдалитьАктивно КАК Статус
	|ИЗ
	|	Справочник.ПЛ_УведомленияОСобытиях КАК ДанныеСправочника
	|";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СправочникОбъект = Выборка.Ссылка.ПолучитьОбъект();
		СправочникОбъект.Статус = 1;
		СправочникОбъект.Записать();
	КонецЦикла;
	
КонецПроцедуры

// Теги "[" и "]" заменяет на "%%"
//
Процедура ЗаменитьТегиВШаблонах()
	
	Выборка = Справочники.ПЛ_УведомленияОСобытиях.Выбрать();
	Пока Выборка.Следующий() Цикл
		СправочникОбъект = Выборка.ПолучитьОбъект();
		СправочникОбъект.ТекстСообщения = СтрЗаменить(СправочникОбъект.ТекстСообщения, "[", "%%");
		СправочникОбъект.ТекстСообщения = СтрЗаменить(СправочникОбъект.ТекстСообщения, "]", "%%");
		СправочникОбъект.Наименование = СтрЗаменить(СправочникОбъект.Наименование, "[", "%%");
		СправочникОбъект.Наименование = СтрЗаменить(СправочникОбъект.Наименование, "]", "%%");
		СправочникОбъект.Записать();
	КонецЦикла;
	
КонецПроцедуры

// Проверяет наличие настройки кода страны и добавляет настройку, если ее нет
//
Процедура ПроверитьНастройкиКодаСтраны()
	
	НастройкиУведомленийМенеджер = Константы.ПЛ_НастройкиУведомлений.СоздатьМенеджерЗначения();
	
	НастройкиСМС = НастройкиУведомленийМенеджер.ПолучитьНастройку("НастройкиСМС");
	Если НастройкиСМС <> Неопределено И ТипЗнч(НастройкиСМС) = Тип("Структура") И Не НастройкиСМС.Свойство("ТелефонныйКодСтраны") Тогда
		НастройкиСМС.Вставить("ТелефонныйКодСтраны", "");
		НастройкиУведомленийМенеджер.СохранитьНастройку("НастройкиСМС", НастройкиСМС);
	КонецЕсли;
	
КонецПроцедуры

