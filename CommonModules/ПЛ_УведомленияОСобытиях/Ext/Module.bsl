// Вывести в табличный документ описания изменений в указанной версии
//
// Параметры
//   НомерВерсии – Строка - номер версии, для которого выводится описание изменений
//   ДокументОписаниеИзменений - табличный документ, в который выводится описание изменений
//   МакетОписаниеОбновлений - макет, содержащий описания изменений для всех версий
//
Процедура ВывестиОписаниеИзменений(Знач НомерВерсии, ДокументОписаниеИзменений, МакетОписаниеИзменений)
	
	Номер = СтрЗаменить(НомерВерсии, ".", "_");
	
	Если МакетОписаниеИзменений.Области.Найти("Шапка" + Номер) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДокументОписаниеИзменений.Вывести(МакетОписаниеИзменений.ПолучитьОбласть("Шапка" + Номер));
	ДокументОписаниеИзменений.НачатьГруппуСтрок("Версия" + Номер);
	ДокументОписаниеИзменений.Вывести(МакетОписаниеИзменений.ПолучитьОбласть("Версия" + Номер));
	ДокументОписаниеИзменений.ЗакончитьГруппуСтрок();
	ДокументОписаниеИзменений.Вывести(МакетОписаниеИзменений.ПолучитьОбласть("Отступ"));
	
КонецПроцедуры

