Функция ПолучитьТаблицуРеализацийДляВозврата(ОплатаПлатежнойКартой) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстатки.ДокументРасчетовСКонтрагентом КАК Реализация,
	|	ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстатки.СуммаВзаиморасчетовОстаток * -1 КАК СуммаВозврата
	|ИЗ
	|	РегистрНакопления.ВзаиморасчетыСКонтрагентамиПоДокументамРасчетов.Остатки(
	|			,
	|			ДоговорКонтрагента.РозничнаяПродажа
	|				И ДокументРасчетовСКонтрагентом В (&СписокДокументовРасчетов)) КАК ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстатки
	|ГДЕ
	|	ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстатки.СуммаВзаиморасчетовОстаток < 0";
	
	СписокДокументовРасчетов = Новый СписокЗначений;
	
	Для каждого Строка Из ОплатаПлатежнойКартой.РасшифровкаПлатежа Цикл
		
		Если ТипЗнч(Строка.ДокументРасчетовСКонтрагентом) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			СписокДокументовРасчетов.Добавить(Строка.ДокументРасчетовСКонтрагентом);	
		КонецЕсли; 
		
	КонецЦикла; 
	
	Запрос.УстановитьПараметр("СписокДокументовРасчетов", СписокДокументовРасчетов);
	
	ТаблицаДляВозврата = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаДляВозврата;
	
КонецФункции

Функция СоздатьДокументВозврата(ОплатаПлатежнойКартой, СтрокаВозврата) Экспорт
	
	ДоговорЭквайринга = ОплатаПлатежнойКартой.ДоговорЭквайринга;
	Реализация = СтрокаВозврата.Реализация;
	Сумма = СтрокаВозврата.СуммаВозврата;
	
	НовыйДокумент = Документы.ОплатаОтПокупателяПлатежнойКартой.СоздатьДокумент();
	
	ЗаполнитьЗначенияСвойств(НовыйДокумент, ОплатаПлатежнойКартой, , "Номер, ИДПлатежа, RRNКодОперации, НомерЧекаККМ, ШтампВерсии");
	
	НовыйДокумент.Дата = ТекущаяДата();
	НовыйДокумент.Ответственный = Пользователи.ТекущийПользователь();
	НовыйДокумент.ВидОперации = Перечисления.ВидыОперацийОплатаОтПокупателяПлатежнойКартой.ВозвратДенежныхСредствПокупателю;
	НовыйДокумент.СуммаДокумента = Сумма; 
	
	НовыйДокумент.КурсДокумента = 1;
	НовыйДокумент.КратностьДокумента = 1;
	
	Если НЕ ДоговорЭквайринга.ТарифыЗаРасчетноеОбслуживание.Количество() = 0 Тогда
		
		НовыйДокумент.ВидОплаты = ДоговорЭквайринга.ТарифыЗаРасчетноеОбслуживание[0].ВидОплаты;			
		ПроцентТорговойУступки = УправлениеРозничнойТорговлей.ПолучитьПроцентТорговойУступки(ДоговорЭквайринга, НовыйДокумент.ВидОплаты);
		НовыйДокумент.СуммаТорговойУступки = Сумма * ПроцентТорговойУступки / 100;
		НовыйДокумент.ПроцентТорговойУступки = ПроцентТорговойУступки; 
		
	КонецЕсли;		
			
	РасшифровкаПлатежа = НовыйДокумент.РасшифровкаПлатежа.Добавить();	

	РасшифровкаПлатежа.ДоговорКонтрагента = Реализация.ДоговорКонтрагента;
	РасшифровкаПлатежа.ДокументРасчетовСКонтрагентом = Реализация; 
	РасшифровкаПлатежа.КратностьВзаиморасчетов = НовыйДокумент.КратностьДокумента;
	РасшифровкаПлатежа.КурсВзаиморасчетов = НовыйДокумент.КурсДокумента;
	
	//+Гавриленков В. 05.12.2025 #UT10-5574
	//РасшифровкаПлатежа.СтавкаНДС = Перечисления.СтавкиНДС.НДС20; 
	РасшифровкаПлатежа.СтавкаНДС = ?(НовыйДокумент.Дата >= Дата("20260101000000"), Перечисления.СтавкиНДС.НДС22, Перечисления.СтавкиНДС.НДС20);
	//-Гавриленков В. 05.12.2025 #UT10-5574
	
	РасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств = РасшифровкаПлатежа.ДоговорКонтрагента.ОсновнаяСтатьяДвиженияДенежныхСредств;
	УправлениеДенежнымиСредствами.УстановитьСтатьюДДСПоУмолчанию(РасшифровкаПлатежа, НовыйДокумент.ВидОперации);
	РасшифровкаПлатежа.СуммаВзаиморасчетов = НовыйДокумент.СуммаДокумента;
	РасшифровкаПлатежа.СуммаПлатежа = НовыйДокумент.СуммаДокумента;
	ЗначениеСтавкиНДС = УчетНДС.ПолучитьСтавкуНДС(РасшифровкаПлатежа.СтавкаНДС);
	РасшифровкаПлатежа.СуммаНДС = РасшифровкаПлатежа.СуммаПлатежа*ЗначениеСтавкиНДС/(100+ЗначениеСтавкиНДС);
	РасшифровкаПлатежа.ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.ПредоплатаПолная;
	РасшифровкаПлатежа.Проект = РасшифровкаПлатежа.ДоговорКонтрагента.ОсновнойПроект;
	РасшифровкаПлатежа.Сделка = Реализация.Сделка;
	
	Если Чеки.ИспользоватьПечатьЧековЧерезСервер() Тогда
		Чеки.ЗаполнитьСоставЧекаККМДляОПК_Возврат(НовыйДокумент);	
	КонецЕсли;
	
	НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Оперативный);

	Возврат НовыйДокумент;
	
КонецФУнкции
 
Функция ПолучитьСтатусПлатежа(ОплатаПлатежнойКартой) Экспорт
	
	СтруктураРезультата = Новый Структура;	
	СтруктураРезультата.Вставить("Результат", Ложь); 
	СтруктураРезультата.Вставить("Сообщение", "");
	СтруктураРезультата.Вставить("Статус", "");
	
	СписокПараметровДляТокена = Новый СписокЗначений;
	СписокПараметровДляТокена.Добавить("Password", ОплатаПлатежнойКартой.ДоговорЭквайринга.Пароль);
	СписокПараметровДляТокена.Добавить("TerminalKey", ОплатаПлатежнойКартой.ДоговорЭквайринга.Номер);
	СписокПараметровДляТокена.Добавить("PaymentId", ОплатаПлатежнойКартой.ИДПлатежа);
	
	Токен = ПолучитьТокен(СписокПараметровДляТокена);
	
	СтруктураЗапроса = Новый Структура();
	СтруктураЗапроса.Вставить("TerminalKey", ОплатаПлатежнойКартой.ДоговорЭквайринга.Номер);
	СтруктураЗапроса.Вставить("PaymentId", ОплатаПлатежнойКартой.ИДПлатежа);      	       
	СтруктураЗапроса.Вставить("Token", Токен);
	
	СтруктураВыполненияЗапроса = ВыполнитьPOSTЗапрос("/v2/GetState", СтруктураЗапроса);
	
	ЗаполнитьЗначенияСвойств(СтруктураРезультата, СтруктураВыполненияЗапроса);
	
	Если СтруктураРезультата.Результат Тогда
		СтруктураРезультата.Статус = СтруктураВыполненияЗапроса.Данные.Status;	
	КонецЕсли; 
	
	Возврат СтруктураРезультата;
	
КонецФункции

Функция ПолучитьТокен(СписокПараметровДляТокена)
	
	СписокПараметровДляТокена.СортироватьПоЗначению();
	
	СтрокаТокена = "";
	
	Для каждого Параметр Из СписокПараметровДляТокена Цикл
		СтрокаТокена = СтрокаТокена + Параметр.Представление;
	КонецЦикла; 
	
	Хэш = Новый ХешированиеДанных(ХешФункция.SHA256); 
	Хэш.Добавить(СтрокаТокена);
    ХешСтроки = НРег(СтрЗаменить(Строка(Хэш.ХешСумма), " ", ""));
	
	Возврат ХешСтроки;
	
КонецФункции

