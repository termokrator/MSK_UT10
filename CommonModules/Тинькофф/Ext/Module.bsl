Функция ПроверитьОплатуПлатежнойКартойДляВозврата(ОплатаПлатежнойКартой) Экспорт
	
	СтруктураРезультата = Новый Структура;	
	СтруктураРезультата.Вставить("Результат", Ложь); 
	СтруктураРезультата.Вставить("Сообщение", "");
	
	Если Не ЗначениеЗаполнено(ОплатаПлатежнойКартой) Тогда
		
		СтруктураРезультата.Сообщение = "Не заполнен документ возврата";
		Возврат СтруктураРезультата;
		
	КонецЕсли; 
	
	Если ТипЗнч(ОплатаПлатежнойКартой) <> Тип("ДокументСсылка.ОплатаОтПокупателяПлатежнойКартой") Тогда
		
		СтруктураРезультата.Сообщение = "Передан неверный тип документа возврата";
		Возврат СтруктураРезультата;
		
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(ОплатаПлатежнойКартой.ИДПлатежа) Тогда
		
		СтруктураРезультата.Сообщение = "Не заполнен идентификатор платежа возврата";
		Возврат СтруктураРезультата;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОплатаПлатежнойКартой.НомерЧекаККМ) Тогда
		
		СтруктураРезультата.Сообщение = "Документ не пробит на кассе ККМ";
		Возврат СтруктураРезультата;
		
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(ОплатаПлатежнойКартой.ДоговорЭквайринга.Номер) Тогда
		
		СтруктураРезультата.Сообщение = "В договоре эквайринга не заполнен реквизит Номер (номер терминала)";
		Возврат СтруктураРезультата;	
		
	КонецЕсли; 
	
	СтруктураРезультата.Результат = Истина;
	
	Возврат СтруктураРезультата;
	
КонецФункции
 
Функция ВыполнитьPOSTЗапрос(СтрокаЗапроса, СтруктураЗапроса) Экспорт	
	
	СтруктураРезультата = Новый Структура;	
	СтруктураРезультата.Вставить("Результат", Ложь); 
	СтруктураРезультата.Вставить("Сообщение", "");
	СтруктураРезультата.Вставить("Данные", "");
	
	HTTPСоединение = Новый HTTPСоединение(Константы.ТинькоффАдресБанковскогоСервера.Получить(), , , , , 10, Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Неопределено));
	
	Заголовки = Новый Соответствие;
   	Заголовки.Вставить("Content-Type", "application/json");
	
	HTTPЗапрос = Новый HTTPЗапрос(СтрокаЗапроса, Заголовки); 
	HTTPЗапрос.УстановитьТелоИзСтроки(ВернутьJSON(СтруктураЗапроса));
	
	ОтветJSONСтрока = "";                                                                                                         
	
	Попытка
				
		Ответ = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
		
		ОтветJSONСтрока =   Ответ.ПолучитьТелоКакСтроку();
		
		Если ЗначениеЗаполнено(СокрЛП(ОтветJSONСтрока)) Тогда
			
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(ОтветJSONСтрока);
			СтруктураВозврата = ПрочитатьJSON(ЧтениеJSON);	
			
			Если СтруктураВозврата.Свойство("Success") Тогда
				
				Если СтруктураВозврата.Success Тогда
					
					СтруктураРезультата.Результат = Истина;	
					СтруктураРезультата.Данные = СтруктураВозврата;  
					
				Иначе
					
					Если СтруктураВозврата.Свойство("Message") Тогда						
						СтруктураРезультата.Сообщение = СтруктураВозврата.Message;						
					КонецЕсли;
					
					Если СтруктураВозврата.Свойство("Details") Тогда						
						СтруктураРезультата.Сообщение = СтруктураРезультата.Сообщение + ?(ЗначениеЗаполнено(СтруктураРезультата.Сообщение), " (", "") + СтруктураВозврата.Details + ?(ЗначениеЗаполнено(СтруктураРезультата.Сообщение), ")", "");						
					КонецЕсли;
					
				КонецЕсли; 
				
			КонецЕсли; 
			
		КонецЕсли;
		
	Исключение 	
		СтруктураРезультата.Сообщение = ОписаниеОшибки();		
	КонецПопытки;
	
