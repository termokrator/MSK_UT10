#Область Основные

Функция ПолучитьКомпоненту(Знач ИмяКомпоненты, Знач Класс = "Main") Экспорт

    Компонента    = Неопределено;
    Ошибка        = "";
    ИмяКомпоненты = СтрШаблон("OPI_%1", ИмяКомпоненты);

    Если Не ИнициализироватьВнешнююКомпоненту(ИмяКомпоненты, Класс, Компонента) Тогда

        Ошибка     = Неопределено;
        Компонента = ПодключитьКомпонентуНаСервере(ИмяКомпоненты, Класс, Ошибка);

        Если ЗначениеЗаполнено(Ошибка) Тогда
            СформироватьИсключениеКомпоненты(Ошибка);
        КонецЕсли;

    КонецЕсли;

    Возврат Компонента;

КонецФункции

Функция ЭтоКомпонента(Знач Значение) Экспорт

    ТипЗначения = Строка(ТипЗнч(Значение));
    Возврат СтрНачинаетсяС(ТипЗначения, "AddIn.");

КонецФункции

Функция ТребуетсяПередачаЧерезФайл() Экспорт

    // BSLLS:CommentedCode-off

    // Компоненты в 1С на Linux не могут стабильно отдавать и принимать данные свыше 30 КБ
    // https://github.com/Bayselonarrend/OpenIntegrations/issues/72

    // UPD: В неизолированном режиме не падает

    // Возврат Не OPI_Инструменты.ЭтоWindows() И Не OPI_Инструменты.ЭтоOneScript();

    // BSLLS:CommentedCode-on

    Возврат Ложь;

КонецФункции

#КонецОбласти

#Область TCP

Функция УстановитьTls(Знач Компонета, Знач Tls) Экспорт

    Результат = Новый Структура("result", Истина);

    Если ЗначениеЗаполнено(Tls) Тогда

        СообщениеОшибки = "Переданы некорректные настройки Tls!";
        OPI_ПреобразованиеТипов.ПолучитьКоллекциюКлючИЗначение(Tls, СообщениеОшибки);

        ИспользоватьTls    = OPI_Инструменты.ПолучитьИли(Tls, "use_tls"             , Ложь);
        ОтключитьВалидацию = OPI_Инструменты.ПолучитьИли(Tls, "accept_invalid_certs", Ложь);
        ПутьКСертификату   = OPI_Инструменты.ПолучитьИли(Tls, "ca_cert_path"        , "");

        OPI_ПреобразованиеТипов.ПолучитьБулево(ИспользоватьTls);
        OPI_ПреобразованиеТипов.ПолучитьБулево(ОтключитьВалидацию);
        OPI_ПреобразованиеТипов.ПолучитьСтроку(ПутьКСертификату);

        Результат = Компонета.SetTLS(ИспользоватьTls, ОтключитьВалидацию, ПутьКСертификату);
        Результат = OPI_Инструменты.JsonВСтруктуру(Результат);

    КонецЕсли;

    Возврат Результат;

КонецФункции

Функция ПолучитьНастройкиTls(Знач ОтключитьПроверкуСертификатов, Знач ПутьКСертификату = "") Экспорт

    СтруктураСертификата = Новый Структура;
    OPI_Инструменты.ДобавитьПоле("use_tls"             , Истина                       , "Булево", СтруктураСертификата);
    OPI_Инструменты.ДобавитьПоле("accept_invalid_certs", ОтключитьПроверкуСертификатов, "Булево", СтруктураСертификата);
    OPI_Инструменты.ДобавитьПоле("ca_cert_path"        , ПутьКСертификату             , "Строка", СтруктураСертификата);

    Возврат СтруктураСертификата;

КонецФункции

Функция ПолучитьНастройкиПрокси(Знач Адрес
    , Знач Порт
    , Знач Вид    = "socks5"
    , Знач Логин  = Неопределено
    , Знач Пароль = Неопределено) Экспорт

    СтруктураНастроек = Новый Структура;
    OPI_Инструменты.ДобавитьПоле("server"    , Адрес, "Строка", СтруктураНастроек);
    OPI_Инструменты.ДобавитьПоле("port"      , Порт , "Число" , СтруктураНастроек);
    OPI_Инструменты.ДобавитьПоле("proxy_type", Вид  , "Строка", СтруктураНастроек);

    Если Не Логин = Неопределено Тогда
        OPI_ПреобразованиеТипов.ПолучитьСтроку(Логин);
        СтруктураНастроек.Вставить("login", Логин);
    КонецЕсли;

    Если Не Пароль = Неопределено Тогда
        OPI_ПреобразованиеТипов.ПолучитьСтроку(Пароль);
        СтруктураНастроек.Вставить("password", Пароль);
    КонецЕсли;

    //@skip-check constructor-function-return-section
    Возврат СтруктураНастроек;

КонецФункции

#КонецОбласти

#Область ВнутреннееХранилище

Функция ПоместитьДанные(Знач Компонента, Знач Значение) Экспорт

    Обработано = Ложь;

    Если ТипЗнч(Значение) = Тип("Строка") Тогда

        ФайлДанных = Новый Файл(Значение);

        Если ФайлДанных.Существует() Тогда
            Результат  = Компонента.LoadFileToVault(ФайлДанных.ПолноеИмя);
            Результат  = OPI_Инструменты.JsonВСтруктуру(Результат);
            Обработано = Истина;
        Иначе
            Результат  = Компонента.LoadBase64ToVault(Значение);
            Результат  = OPI_Инструменты.JsonВСтруктуру(Результат);
            Обработано = Результат["result"];
        КонецЕсли;

    КонецЕсли;

    Если Не Обработано Тогда

        OPI_ПреобразованиеТипов.ПолучитьДвоичныеДанные(Значение, Истина, Истина);
        Результат = Компонента.LoadBinaryToVault(Значение);
        Результат = OPI_Инструменты.JsonВСтруктуру(Результат);

    КонецЕсли;

    Возврат Результат;

КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИнициализироватьВнешнююКомпоненту(Знач ИмяКомпоненты, Знач Класс, Компонента)

    Попытка
        Компонента = Новый(СтрШаблон("AddIn.%1.%2", ИмяКомпоненты, Класс));
        Возврат Истина;
    Исключение
        Возврат Ложь;
    КонецПопытки;

КонецФункции

Функция ПодключитьКомпонентуНаСервере(Знач ИмяКомпоненты, Знач Класс, Ошибка)

    Если OPI_Инструменты.ЭтоOneScript() Тогда
        ИмяМакета = СтрШаблон("%1%2.zip"     , КаталогКомпонентOS(), ИмяКомпоненты);
    Иначе
        ИмяМакета = СтрШаблон("ОбщийМакет.%1", ИмяКомпоненты);
    КонецЕсли;

    Попытка
        ПодключитьКомпонентуНеИзолированно(ИмяМакета, ИмяКомпоненты);
        Компонента = Новый(СтрШаблон("AddIn.%1.%2", ИмяКомпоненты, Класс));
        Ошибка     = Неопределено;
        Возврат Компонента;
    Исключение
        Ошибка     = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
        Возврат Неопределено;
    КонецПопытки;

КонецФункции

Функция ПодключитьКомпонентуНеИзолированно(ИмяМакета, ИмяКомпоненты)

    ЭтоOneScript          = OPI_Инструменты.ЭтоOneScript();
    НеобходимТипПоСистеме = Не ЭтоOneScript И Не OPI_Инструменты.ЭтоWindows();

    Если ЭтоOneScript Тогда

        НеобходимТипПоВерсии = Ложь;

    Иначе

        СистемнаяИнформация = Новый СистемнаяИнформация();

        Версия1С = СистемнаяИнформация.ВерсияПриложения;
        Версия1С = СтрРазделить(Версия1С, ".");

        Часть1 = Число(Версия1С[0]);
        Часть2 = Число(Версия1С[1]);
        Часть3 = Число(Версия1С[2]);

        НеобходимТипПоВерсии = Часть1 > 8 Или Часть2 > 3 Или Часть3 > 20;

    КонецЕсли;

    НеобходимТип = НеобходимТипПоВерсии И НеобходимТипПоСистеме;

    Если Не НеобходимТип Тогда

        Если Не НеобходимТипПоВерсии Тогда
            ТипПодключенияВнешнейКомпоненты = Неопределено;
        КонецЕсли;

        Результат = ПодключитьВнешнююКомпоненту(ИмяМакета, ИмяКомпоненты, ТипВнешнейКомпоненты.Native);

    Иначе

        // BSLLS:UnusedLocalVariable-off

        //@skip-check module-unused-local-variable
        ТипПодключения = ТипПодключенияВнешнейКомпоненты.НеИзолированно;
        //@skip-check server-execution-safe-mode

        // BSLLS:UnusedLocalVariable-on

        // BSLLS:LineLength-off
        Результат = Вычислить("ПодключитьВнешнююКомпоненту(ИмяМакета, ИмяКомпоненты, ТипВнешнейКомпоненты.Native, ТипПодключения)");
        // BSLLS:LineLength-on

    КонецЕсли;

    Возврат Результат;

КонецФункции

Функция КаталогКомпонентOS() Экспорт

    КаталогБиблиотеки = OPI_Инструменты.ПолучитьКаталогБиблиотеки();

    // BSLLS:UsingHardcodePath-off

    КаталогКомпонент = СтрШаблон("%1/%2/", КаталогБиблиотеки, "addins");

    // BSLLS:UsingHardcodePath-on

    Возврат КаталогКомпонент;

КонецФункции

Процедура СформироватьИсключениеКомпоненты(Знач Ошибка)

    Текст = "Не удалось инициализировать внешнюю компоненту. Возможно, она несовместима с вашей операционной системой.";

    Если Не OPI_Инструменты.ЭтоWindows() Тогда

        Текст                                          = СтрШаблон("%1
        |
        |Важно: Для работы компоненты требуется GLIBC >=2.18 и OpenSSL версии 3.x
        |Проверьте, что данные зависимости удовлетворены в вашей системе!", Текст);

    КонецЕсли;

    Текст = СтрШаблон("%1
    |
    |Подробнее: https://openintegrations.dev/docs/Start/Component-requirements
    |
    |Системная информация:
    |%2", Текст, Ошибка);

    ВызватьИсключение Текст;

КонецПроцедуры

#КонецОбласти


Функция СтрЗаканчиваетсяНа(Знач ИсходнаяСтрока, Знач СтрокаПоиска) Экспорт
    
    ДлинаПодстроки = СтрДлина(СтрокаПоиска);
    
    // Поведение типовой функции: вызов исключения при пустой строке поиска
    Если ДлинаПодстроки = 0 Тогда
        ВызватьИсключение "Недопустимое значение параметра (пустая строка поиска)";
    КонецЕсли;
    
    // Отрезаем справа от исходной строки кусок нужной длины и сравниваем
    Возврат Прав(ИсходнаяСтрока, ДлинаПодстроки) = СтрокаПоиска;
    
КонецФункции 

Функция СтрСоединить(Знач МассивСтрок, Знач Разделитель = "") Экспорт
    
    Результат = "";
    ЭтоПервыйЭлемент = Истина;
    
    Для Каждого Элемент Из МассивСтрок Цикл
        
        // Принудительно приводим к строке, чтобы функция не падала, 
        // если в массиве окажутся числа или булево
        СтроковоеПредставление = Строка(Элемент);
        
        Если ЭтоПервыйЭлемент Тогда
            Результат = СтроковоеПредставление;
            ЭтоПервыйЭлемент = Ложь;
        Иначе
            Результат = Результат + Разделитель + СтроковоеПредставление;
        КонецЕсли;
        
    КонецЦикла;
    
    Возврат Результат;
    
КонецФункции

Функция СтрНачинаетсяС(Знач Строка, Знач ПодстрокаПоиска) Экспорт
    
    ДлинаПодстроки = СтрДлина(ПодстрокаПоиска);
    
    // Обработка исключения: если искомая подстрока пустая, 
    // логично возвращать Истина (или Ложь, в зависимости от ваших задач).
    Если ДлинаПодстроки = 0 Тогда
        Возврат Истина;
    КонецЕсли;
    
    // Отрезаем слева от исходной строки кусок нужной длины и сравниваем
    Возврат Лев(Строка, ДлинаПодстроки) = ПодстрокаПоиска;
    
КонецФункции  

Функция СтрНайти(Знач ИсходнаяСтрока, Знач ПодстрокаПоиска, 
                       Знач Направление = "СНачала", 
                       Знач НачальнаяПозиция = 0, 
                       Знач НомерВхождения = 1) Экспорт
    
    ДлинаСтроки = СтрДлина(ИсходнаяСтрока);
    ДлинаПодстроки = СтрДлина(ПодстрокаПоиска);
    
    // Согласно документации, если подстрока пустая, всегда возвращается 1
    Если ДлинаПодстроки = 0 Тогда
        Возврат 1;
    КонецЕсли;
    
    Если ДлинаСтроки = 0 Тогда
        Возврат 0;
    КонецЕсли;
    
    НомерВхожденияФакт = Макс(1, НомерВхождения);
    ИскатьСначала = (ВРег(Направление) <> "СКОНЦА");
    
    // Определяем начальную позицию по умолчанию
    Если НачальнаяПозиция = 0 Тогда
        НачальнаяПозФакт = ?(ИскатьСначала, 1, ДлинаСтроки);
    Иначе
        НачальнаяПозФакт = НачальнаяПозиция;
    КонецЕсли;
    
    Если ИскатьСначала Тогда
        
        ТекущаяПозиция = НачальнаяПозФакт;
        НайденоРаз = 0;
        
        Пока ТекущаяПозиция <= ДлинаСтроки Цикл
            
            РабочийОстаток = Сред(ИсходнаяСтрока, ТекущаяПозиция);
            ПозицияВхожд = Найти(РабочийОстаток, ПодстрокаПоиска);
            
            Если ПозицияВхожд = 0 Тогда
                Возврат 0; // Больше вхождений нет
            КонецЕсли;
            
            АбсолютнаяПозиция = ТекущаяПозиция + ПозицияВхожд - 1;
            НайденоРаз = НайденоРаз + 1;
            
            Если НайденоРаз = НомерВхожденияФакт Тогда
                Возврат АбсолютнаяПозиция;
            КонецЕсли;
            
            ТекущаяПозиция = АбсолютнаяПозиция + ДлинаПодстроки;
            
        КонецЦикла;
        
        Возврат 0;
        
    Иначе
        
        // Поиск с конца.
        // Поскольку базовая Найти() ищет только слева направо,
        // мы отрезаем строку до НачальнойПозиции, собираем все вхождения в массив,
        // а потом берем нужный элемент массива с конца.
        
        РабочаяСтрока = Лев(ИсходнаяСтрока, НачальнаяПозФакт);
        МассивВхождений = Новый Массив;
        
        ТекущаяПозиция = 1;
        
        Пока Истина Цикл
            РабочийОстаток = Сред(РабочаяСтрока, ТекущаяПозиция);
            ПозицияВхожд = Найти(РабочийОстаток, ПодстрокаПоиска);
            
            Если ПозицияВхожд = 0 Тогда
                Прервать;
            КонецЕсли;
            
            АбсолютнаяПозиция = ТекущаяПозиция + ПозицияВхожд - 1;
            МассивВхождений.Добавить(АбсолютнаяПозиция);
            
            ТекущаяПозиция = АбсолютнаяПозиция + ДлинаПодстроки;
        КонецЦикла;
        
        ВсегоВхождений = МассивВхождений.Количество();
        Если ВсегоВхождений = 0 Или НомерВхожденияФакт > ВсегоВхождений Тогда
            Возврат 0;
        КонецЕсли;
        
        // Если просят 1-е вхождение с конца - берем последний элемент массива
        ИндексМассива = ВсегоВхождений - НомерВхожденияФакт;
        Возврат МассивВхождений[ИндексМассива];
        
    КонецЕсли;
    
КонецФункции

Функция СтрРазделить(Знач ИсходнаяСтрока, Знач Разделители, Знач ВключатьПустые = Истина) Экспорт
    
    МассивПодстрок = Новый Массив;
    ДлинаРазделителей = СтрДлина(Разделители);
    
    // Если разделитель не указан, возвращаем всю строку целиком в массиве
    Если ДлинаРазделителей = 0 Тогда
        МассивПодстрок.Добавить(ИсходнаяСтрока);
        Возврат МассивПодстрок;
    КонецЕсли;
    
    // Сводим все символы-разделители к одному (первому символу)
    // Это позволит нам использовать быструю встроенную функцию Найти()
    ОсновнойРазделитель = Лев(Разделители, 1);
    Для Индекс = 2 По ДлинаРазделителей Цикл
        ТекСимвол = Сред(Разделители, Индекс, 1);
        ИсходнаяСтрока = СтрЗаменить(ИсходнаяСтрока, ТекСимвол, ОсновнойРазделитель);
    КонецЦикла;
    
    // Теперь режем строку по ОсновномуРазделителю
    РабочаяСтрока = ИсходнаяСтрока;
    Позиция = Найти(РабочаяСтрока, ОсновнойРазделитель);
    
    Пока Позиция > 0 Цикл
        
        Фрагмент = Лев(РабочаяСтрока, Позиция - 1);
        
        // Пустая строка для данной функции - это именно "", а не пробелы
        Если ВключатьПустые Или Фрагмент <> "" Тогда
            МассивПодстрок.Добавить(Фрагмент);
        КонецЕсли;
        
        РабочаяСтрока = Сред(РабочаяСтрока, Позиция + 1);
        Позиция = Найти(РабочаяСтрока, ОсновнойРазделитель);
        
    КонецЦикла;
    
    // Добавляем последний "хвост"
    Если ВключатьПустые Или РабочаяСтрока <> "" Тогда
        МассивПодстрок.Добавить(РабочаяСтрока);
    КонецЕсли;
    
    Возврат МассивПодстрок;
    
КонецФункции

