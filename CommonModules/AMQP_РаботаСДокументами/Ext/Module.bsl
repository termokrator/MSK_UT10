Процедура ЗаписатьВозвратТоваровПоставщику(Документ, СтруктураДокумента, ПеречитатьРегистры)
	
	Префикс = Лев(Документ.Организация.Префикс,2);
	ЧислоСимволов = 5;   
	
	НовыйНомер = Прав(Документ.Номер, ЧислоСимволов);
	
	Пока СтрДлина(НовыйНомер) < ЧислоСимволов Цикл
		НовыйНомер = "0" + НовыйНомер;
	КонецЦикла;     
	
	НомерУТ11 = ?(Префикс = "", "00", Префикс) + "00-В" + НовыйНомер;	
	
	СтруктураДокумента.Вставить("НомерУТ11", НомерУТ11);
	СтруктураДокумента.Вставить("app_id", ПолучитьКодПрикладнойСистемы());	
	СтруктураДокумента.Вставить("ВидДокумента", "ВозвратТоваровПоставщику");
	СтруктураДокумента.Вставить("Валюта", Документ.ВалютаДокумента.КодМДМ);
	СтруктураДокумента.Вставить("Ответственный", Строка(Документ.Ответственный));

	Если ЗначениеЗаполнено(Документ.КодМДМОрганизацииВСмежнойБазе) Тогда
		СтруктураДокумента.Вставить("ОрганизацияКодМДМ", СокрЛП(Документ.КодМДМОрганизацииВСмежнойБазе));
	Иначе
		СтруктураДокумента.Вставить("ОрганизацияКодМДМ", СокрЛП(Документ.Организация.КодМДМГоловнойОрганизации));
	КонецЕсли;
	
	СтруктураДокумента.Вставить("Предварительный", НЕ ЗначениеЗаполнено(Документ.КодМДМОрганизацииВСмежнойБазе));
	СтруктураДокумента.Вставить("СкладКодМДМ", СокрЛП(Документ.Склад.КодМДМ));
	СтруктураДокумента.Вставить("Контрагент", СокрЛП(Документ.Контрагент));
	СтруктураДокумента.Вставить("ВозвратРекламационногоТовара", Документ.ВозвратРекламационногоТовара);
	СтруктураДокумента.Вставить("УникальныйИдентификатор", Строка(Документ.Ссылка.УникальныйИдентификатор()));
	СтруктураДокумента.Вставить("СтатусСогласования", XMLСтрока(Документ.СтатусСогласования));
	СтруктураДокумента.Вставить("ПометкаУдаления", Документ.ПометкаУдаления);
	СтруктураДокумента.Вставить("Проведен", Документ.Проведен);  
	СтруктураДокумента.Вставить("ШтампВерсии", Документ.ШтампВерсии);
	СтруктураДокумента.Вставить("КодСкладаПолучателяМДМ", Константы.ГрузополучательДляВозвратов.Получить().ТранзитныйСкладКодМДМ);

	Результат = ВозвратСтороннимСкладам(Документ);
	СтруктураДокумента.Вставить("ВозвратСтороннимСкладам", Результат.ВозвратСтороннимСкладам);
	СтруктураДокумента.Вставить("ОтправлятьЗаказыПоСкладуВУТ11", Результат.ОтправлятьЗаказыПоСкладуВУТ11);
	СтруктураДокумента.Вставить("КодСторСклада", Результат.КодСторСклада);
	
	Если Результат.ОтправлятьЗаказыПоСкладуВУТ11 Тогда
		СтруктураДокумента.ВозвратРекламационногоТовара = Ложь;
	КонецЕсли;	

	СтруктураДокумента.Вставить("ДокументОснованиеВид", ?(ЗначениеЗаполнено(Документ.ДокументОснование), Документ.ДокументОснование.Метаданные().Имя, ""));
	СтруктураДокумента.Вставить("ДокументОснованиеУникальныйИдентификатор", 
	                  ?(ЗначениеЗаполнено(Документ.ДокументОснование), Строка(Документ.ДокументОснование.УникальныйИдентификатор()), ""));
	
	ТЧ = Документ.Товары.Выгрузить();
	ТЧ.Свернуть("ДокументПоступления");
	
	СписокПТУ = "";
	
	Для Каждого Стр Из ТЧ Цикл
		
		НомерВхДок = СокрЛП(Стр.ДокументПоступления.НомерВходящегоДокумента);  
		
		Если ЗначениеЗаполнено(НомерВхДок) Тогда
			СписокПТУ = СписокПТУ + ?(ЗначениеЗаполнено(СписокПТУ), ", ", "") + НомерВхДок;
		КонецЕсли; 
		
	КонецЦикла; 
	
	Комментарий = "Возврат из филиала № " + Документ.Номер;
	
	Если ЗначениеЗаполнено(СписокПТУ) Тогда
		Комментарий = Комментарий + " (" + СписокПТУ + ")";
	КонецЕсли;	 
	
	Если ЗначениеЗаполнено(Документ.Комментарий) Тогда
		Комментарий = Комментарий + " (" + СокрЛП(Документ.Комментарий) + ")";
	КонецЕсли;	
	
	Комментарий = Комментарий + " от " + Строка(Документ.Дата);	
	СтруктураДокумента.Вставить("Комментарий", Комментарий);
	
	Товары = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВозвратТоваровПоставщикуТовары.Номенклатура КАК Номенклатура,
	               |	ВозвратТоваровПоставщикуТовары.Номенклатура.КодМДМ КАК НоменклатураКодМДМ,
	               |	ВозвратТоваровПоставщикуТовары.Номенклатура.КодПоБазеМоскоречье КАК КодПоБазеМоскоречье,
	               |	ВозвратТоваровПоставщикуТовары.Количество,
	               |	ВозвратТоваровПоставщикуТовары.СтавкаНДС,
	               |	ВозвратТоваровПоставщикуТовары.Сумма,
	               |	ВозвратТоваровПоставщикуТовары.СуммаНДС,
	               |	ВозвратТоваровПоставщикуТовары.Цена,
	               |	ВозвратТоваровПоставщикуТовары.СерияНоменклатуры.НомерГТД.Представление КАК НомерГТД,
				   |	ВозвратТоваровПоставщикуТовары.Комментарий
	               |ИЗ
	               |	Документ.ВозвратТоваровПоставщику.Товары КАК ВозвратТоваровПоставщикуТовары
	               |ГДЕ
	               |	ВозвратТоваровПоставщикуТовары.Ссылка = &Ссылка";   
				   
	Запрос.УстановитьПараметр("Ссылка", Документ.Ссылка);      
	
	Выб = Запрос.Выполнить().Выбрать(); 
	
	Пока Выб.Следующий() Цикл 
		
		ТоварыСтруктура = Новый Структура;
		ТоварыСтруктура.Вставить("Номенклатура", Строка(Выб.Номенклатура));  
		ТоварыСтруктура.Вставить("КодМДМНоменклатуры", Выб.НоменклатураКодМДМ);
		ТоварыСтруктура.Вставить("КодПоБазеМоскоречье", Выб.КодПоБазеМоскоречье);
		ТоварыСтруктура.Вставить("Количество", Выб.Количество);
		ТоварыСтруктура.Вставить("СтавкаНДС", Строка(Выб.СтавкаНДС));
		ТоварыСтруктура.Вставить("Сумма", Выб.Сумма);
		ТоварыСтруктура.Вставить("СуммаНДС", Выб.СуммаНДС);
		ТоварыСтруктура.Вставить("Цена", Выб.Цена);
		ТоварыСтруктура.Вставить("НомерГТД", СокрЛП(Выб.НомерГТД));
		ТоварыСтруктура.Вставить("Комментарий", СокрЛП(Выб.Комментарий));
		
		Товары.Добавить(ТоварыСтруктура); 
		
	КонецЦикла;                
	
	СтруктураДокумента.Вставить("Товары", Товары);

КонецПроцедуры

