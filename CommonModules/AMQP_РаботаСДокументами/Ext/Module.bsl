Процедура ЗаписатьПриходныйКассовыйОрдер(Документ, СтруктураДокумента, ПеречитатьРегистры)
	
	СтруктураДокумента.Вставить("КодОрганизацииМДМ", Документ.Организация.КодМДМГоловнойОрганизации);
	СтруктураДокумента.Вставить("Сумма", Документ.СуммаДокумента);
	
	Если ЗначениеЗаполнено(Документ.Контрагент) ТОгда
		
		Если ТипЗнч(Документ.Контрагент) = Тип("СправочникСсылка.Контрагенты") Тогда
			СтруктураДокумента.Вставить("КодКонтрагентаМДМ", Документ.Контрагент.КодМДМ);
		ИначеЕсли ТипЗнч(Документ.Контрагент) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
			СтруктураДокумента.Вставить("ПодотчетноеЛицоКодМДМ", Документ.Контрагент.КодМДМ);
		КонецЕсли; 
		
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(Документ.ДоговорКонтрагента) тогда
		СтруктураДокумента.Вставить("КодДоговораМДМ", Документ.ДоговорКонтрагента.КодМДМ);
	КонецЕсли;
	
	СтруктураДокумента.Вставить("ШтампВерсии", Документ.ШтампВерсии);
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ПриходныйКассовыйОрдер.Касса.КодМДМГоловнойКассы КАК КодКассыМДМ,
	|	ПриходныйКассовыйОрдер.СуммаДокумента
	|ИЗ
	|	Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
	|ГДЕ
	|	ПриходныйКассовыйОрдер.Ссылка = &Ссылка";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", Документ.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Для Каждого Колонка Из Выборка.Владелец().Колонки Цикл
		СтруктураДокумента.Вставить(Колонка.Имя, Выборка[Колонка.Имя]);    	
	КонецЦикла;
		
	Валюта = Документ.ВалютаДокумента;
	СтруктураДокумента.Вставить("Валюта", Валюта.КодМДМ);
	
	Если ЗначениеЗаполнено(Документ.ДокументОснование) Тогда 
		
		СтруктураДокумента.Вставить("ОснованиеГУИД", Строка(Документ.ДокументОснование.УникальныйИдентификатор()));
		СтруктураДокумента.Вставить("ОснованиеНомер", Документ.ДокументОснование.Номер);
		СтруктураДокумента.Вставить("ОснованиеДата", Документ.ДокументОснование.Дата);
		СтруктураДокумента.Вставить("ОснованиеТип", Документ.ДокументОснование.Метаданные().Имя); 
		
	Иначе 
		
		СтруктураДокумента.Вставить("ОснованиеГУИД", "");
		СтруктураДокумента.Вставить("ОснованиеНомер", "");
		СтруктураДокумента.Вставить("ОснованиеДата", "");
		СтруктураДокумента.Вставить("ОснованиеТип", "");  
		
	КонецЕсли; 
	
	СтруктураДокумента.Вставить("Касса", Строка(Документ.Касса));
	СтруктураДокумента.Вставить("НомерЧекаККМ", Документ.НомерЧекаККМ);
	СтруктураДокумента.Вставить("Основание", Документ.Основание);
	СтруктураДокумента.Вставить("Приложение", Документ.Приложение);
	СтруктураДокумента.Вставить("ПринятоОт", Документ.ПринятоОт);
	СтруктураДокумента.Вставить("СтатьяДвиженияДенежныхСредств", Строка(Документ.СтатьяДвиженияДенежныхСредств));
	СтруктураДокумента.Вставить("ВидОперации", Строка(Документ.ВидОперации));
	СтруктураДокумента.Вставить("ПринятоОт", Документ.ПринятоОт);
	СтруктураДокумента.Вставить("ПометкаУдаления", Документ.ПометкаУдаления);
	СтруктураДокумента.Вставить("НалогообложениеНДС", "ПродажаОблагаетсяНДС");  
	СтруктураДокумента.Вставить("ЧекККМ", ?(ЗначениеЗаполнено(Документ.НомерЧекаККМ), 1, 0)); 	
	
	РасшифровкаПлатежа = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПриходныйКассовыйОрдер.Контрагент.КодМДМПартнера КАК КодПартнераМДМ,
	|	ПРЕДСТАВЛЕНИЕ(ПриходныйКассовыйОрдерРасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств) КАК СтатьяДвиженияДенежныхСредств,
	|	ПриходныйКассовыйОрдерРасшифровкаПлатежа.СуммаВзаиморасчетов КАК СуммаВзаиморасчетов,
	|	ПриходныйКассовыйОрдерРасшифровкаПлатежа.СуммаПлатежа КАК СуммаПлатежа,
	|	ПриходныйКассовыйОрдер.ВалютаДокумента.КодМДМ КАК ВалютаВзаиморасчетов,
	|	"""" КАК КодДоговораКредитаИДепозитаМДМ,
	|	ПриходныйКассовыйОрдер.Организация.КодМДМГоловнойОрганизации КАК КодОрганизацииМДМ,
	|	ПриходныйКассовыйОрдерРасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств.КодМДМ КАК КодСтатьиДвиженияДенежныхСредствМДМ,
	|	ПриходныйКассовыйОрдерРасшифровкаПлатежа.СуммаНДС,         
	|	ПриходныйКассовыйОрдерРасшифровкаПлатежа.ДоговорКонтрагента.КодМДМ КАК КодДоговораМДМ,
	|	ПриходныйКассовыйОрдерРасшифровкаПлатежа.ДокументРасчетовСКонтрагентом КАК _ДокументРасчетовСКонтрагентом,
	|	ПриходныйКассовыйОрдерРасшифровкаПлатежа.СтавкаНДС КАК _СтавкаНДС
	|ИЗ
	|	Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПриходныйКассовыйОрдер.РасшифровкаПлатежа КАК ПриходныйКассовыйОрдерРасшифровкаПлатежа
	|		ПО ПриходныйКассовыйОрдер.Ссылка = ПриходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка
	|ГДЕ
	|	ПриходныйКассовыйОрдер.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка",Документ.Ссылка);
	
	Результат = Запрос.Выполнить(); 
	
	Если Не Результат.Пустой() Тогда  
		
		Выборка = Результат.Выбрать();
		Массив = AMQP_РаботаСДокументами_ver2.МассивПоддерживаемыхТиповJSON();
		
		Пока Выборка.Следующий() Цикл 
			
			Структура = Новый Структура;
			AMQP_РаботаСДокументами_ver2.ЗаполнитьКоллекциюЗначений(Структура, Выборка, Результат.Колонки, Массив);
			Структура.Вставить("СтавкаНДС", УчетНДС.ПолучитьСтавкуНДС(Выборка._СтавкаНДС));
			Структура.Вставить("ДокументРасчетовСКонтрагентом", AMQP_РаботаСДокументами_ver2.ЗначениеJSON(Выборка._ДокументРасчетовСКонтрагентом, Массив));
			
			РасшифровкаПлатежа.Добавить(Структура);

		КонецЦикла;
		
	КонецЕсли;
	
	СтруктураДокумента.Вставить("РасшифровкаПлатежа", РасшифровкаПлатежа);
	
КонецПроцедуры

Процедура ЗаписатьРасходныйКассовыйОрдер(Документ, СтруктураДокумента, ПеречитатьРегистры)
		
	Валюта = Документ.ВалютаДокумента;
	СтруктураДокумента.Вставить("Валюта", Валюта.КодМДМ);
	СтруктураДокумента.Вставить("ПометкаУдаления", Документ.ПометкаУдаления);
	
	СтруктураДокумента.Вставить("КодОрганизацииМДМ", Документ.Организация.КодМДМГоловнойОрганизации);
	СтруктураДокумента.Вставить("Сумма", Документ.СуммаДокумента);
	
	Если ЗначениеЗаполнено(Документ.Контрагент) тогда
		СтруктураДокумента.Вставить("КодКонтрагента", Документ.Контрагент.КодМДМ);
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(Документ.ДоговорКонтрагента) тогда
		СтруктураДокумента.Вставить("КодДоговора", Документ.ДоговорКонтрагента.КодМДМ);
	КонецЕсли;
	
	СтруктураДокумента.Вставить("ШтампВерсии", Документ.ШтампВерсии);
	
	Если ЗначениеЗаполнено(Документ.ДокументОснование) Тогда  
		
		СтруктураДокумента.Вставить("ОснованиеГУИД", Строка(Документ.ДокументОснование.УникальныйИдентификатор()));
		СтруктураДокумента.Вставить("ОснованиеНомер", Документ.ДокументОснование.Номер);
		СтруктураДокумента.Вставить("ОснованиеДата", Документ.ДокументОснование.Дата);
		СтруктураДокумента.Вставить("ОснованиеТип", Документ.ДокументОснование.Метаданные().Имя); 
		
	Иначе   
		
		СтруктураДокумента.Вставить("ОснованиеГУИД", "");
		СтруктураДокумента.Вставить("ОснованиеНомер", "");
		СтруктураДокумента.Вставить("ОснованиеДата", "");
		СтруктураДокумента.Вставить("ОснованиеТип", "");    
		
	КонецЕсли;  
	
	СтруктураДокумента.Вставить("Касса", Строка(Документ.Касса));  
	СтруктураДокумента.Вставить("НомерЧекаККМ", Документ.НомерЧекаККМ);
	СтруктураДокумента.Вставить("Основание", Документ.Основание);
	СтруктураДокумента.Вставить("ПоДокументу", Документ.ПоДокументу);
	СтруктураДокумента.Вставить("Выдать", Документ.Выдать);
	СтруктураДокумента.Вставить("Приложение", Документ.Приложение);
	СтруктураДокумента.Вставить("СтатьяДвиженияДенежныхСредств", Строка(Документ.СтатьяДвиженияДенежныхСредств));
	СтруктураДокумента.Вставить("КодСтатьиДвиженияДенежныхСредствМДМ", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ.РасшифровкаПлатежа[0].СтатьяДвиженияДенежныхСредств, "КодМДМ"));
	СтруктураДокумента.Вставить("ВидОперации", Строка(Документ.ВидОперации)); 
	СтруктураДокумента.Вставить("КодКассыМДМ", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ.Касса, "КодМДМГоловнойКассы"));
	СтруктураДокумента.Вставить("НалогообложениеНДС", "ПродажаОблагаетсяНДС");

	Если Документ.ВидОперации = Перечисления.ВидыОперацийРКО.ВзносНаличнымиВБанк и 
		НЕ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ.Касса, "ИнкасацияЧерезОсновнуюКассу") Тогда
		СтруктураДокумента.Вставить("СчетОрганизацииКодМДМ", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ.СчетОрганизации, "КодМДМ"));
	КонецЕсли; 
	
	СтруктураДокумента.Вставить("ЧекККМ", ?(ЗначениеЗаполнено(Документ.НомерЧекаККМ), 1, 0)); 	
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА РасходныйКассовыйОрдер.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРКО.ВозвратДенежныхСредствПокупателю)
	|			ТОГДА ""ВозвратОплатыКлиенту""
	|		КОГДА РасходныйКассовыйОрдер.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРКО.РасчетыПоКредитамИЗаймамСКонтрагентами)
	|			ТОГДА ""ОплатаПоКредитам""
	|		КОГДА РасходныйКассовыйОрдер.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРКО.ОплатаПоставщику)
	|			ТОГДА ""ОплатаПоставщику""
	|		КОГДА РасходныйКассовыйОрдер.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРКО.ПрочиеРасчетыСКонтрагентами)
	|			ТОГДА ""ОплатаПоставщику""
	|		КОГДА РасходныйКассовыйОрдер.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРКО.ВыдачаДенежныхСредствПодотчетнику)
	|			ТОГДА ""ВыдачаДенежныхСредствПодотчетнику""
	|		КОГДА РасходныйКассовыйОрдер.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРКО.ВыдачаДенежныхСредствКассеККМ)
	|			ТОГДА ""ВыдачаДенежныхСредствВДругуюКассу""
	|		КОГДА РасходныйКассовыйОрдер.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРКО.ВзносНаличнымиВБанк)  и РасходныйКассовыйОрдер.Касса.ИнкасацияЧерезОсновнуюКассу
	|			ТОГДА ""ВыдачаДенежныхСредствВДругуюКассу"" 
	|		КОГДА РасходныйКассовыйОрдер.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРКО.ВзносНаличнымиВБанк)
	|			ТОГДА ""ИнкассацияДенежныхСредствВБанк""
	|		КОГДА РасходныйКассовыйОрдер.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРКО.РасходДенежныхСредствПрочее)
	|			ТОГДА ""ВыплатаЗарплатыЧерезКассу""  
	|		КОГДА РасходныйКассовыйОрдер.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРКО.ВыплатаЗаработнойПлаты)
	|			ТОГДА ""ВыплатаЗарплатыЧерезКассу"" 
	|		ИНАЧЕ ""ПрочаяВыдачаДенежныхСредств""
	|	КОНЕЦ КАК ХозяйственнаяОперация,
	|	РасходныйКассовыйОрдер.СуммаДокумента,
	|	РасходныйКассовыйОрдер.Контрагент
	|ИЗ
	|	Документ.РасходныйКассовыйОрдер КАК РасходныйКассовыйОрдер
	|ГДЕ
	|	РасходныйКассовыйОрдер.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РасходныйКассовыйОрдерРасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств КАК _СтатьяДвиженияДенежныхСредств,
	|	РасходныйКассовыйОрдерРасшифровкаПлатежа.СуммаВзаиморасчетов КАК СуммаВзаиморасчетов,
	|	РасходныйКассовыйОрдерРасшифровкаПлатежа.СуммаПлатежа КАК СуммаПлатежа,
	|	ЕСТЬNULL(РасходныйКассовыйОрдерРасшифровкаПлатежа.ДоговорКонтрагента.Владелец.КодМДМПартнера, """") КАК КодПартнераМДМ,
	|	ЕСТЬNULL(РасходныйКассовыйОрдерРасшифровкаПлатежа.ДоговорКонтрагента.Организация.КодМДМГоловнойОрганизации, """") КАК КодОрганизацииМДМ,
	|	РасходныйКассовыйОрдерРасшифровкаПлатежа.СтавкаНДС КАК _СтавкаНДС,
	|	РасходныйКассовыйОрдерРасшифровкаПлатежа.СуммаНДС,
	|	РасходныйКассовыйОрдерРасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств.КодМДМ КАК КодСтатьиДвиженияДенежныхСредствМДМ,
	|	"""" КАК КодДоговораКредитаИДепозитаМДМ,
	|	РасходныйКассовыйОрдерРасшифровкаПлатежа.ДокументРасчетовСКонтрагентом,
	|	ЕСТЬNULL(РасходныйКассовыйОрдерРасшифровкаПлатежа.ДоговорКонтрагента.КодМДМ, """") КАК КодДоговораМДМ
	|ИЗ
	|	Документ.РасходныйКассовыйОрдер.РасшифровкаПлатежа КАК РасходныйКассовыйОрдерРасшифровкаПлатежа
	|ГДЕ
	|	РасходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка = &Ссылка";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", Документ.Ссылка);               
	
	Результат = Запрос.ВыполнитьПакет();
	
	Массив = AMQP_РаботаСДокументами_ver2.МассивПоддерживаемыхТиповJSON();
	
	Выборка = Результат[0].Выбрать();
	Выборка.Следующий();
	
	AMQP_РаботаСДокументами_ver2.ЗаполнитьКоллекциюЗначений(СтруктураДокумента, Выборка, Выборка.Владелец().Колонки, Массив);
	
	РасшифровкаПлатежа = Новый Массив;
	
	Выборка = Результат[1].Выбрать(); 
	
	Пока Выборка.Следующий() Цикл 
		
		Структура = Новый Структура;
		AMQP_РаботаСДокументами_ver2.ЗаполнитьКоллекциюЗначений(Структура, Выборка, Выборка.Владелец().Колонки, Массив);
		РасшифровкаПлатежа.Добавить(Структура);
		
		Структура.Вставить("СтатьяДвиженияДенежныхСредств", Строка(Выборка._СтатьяДвиженияДенежныхСредств));
		Структура.Вставить("СтавкаНДС", УчетНДС.ПолучитьСтавкуНДС(Выборка._СтавкаНДС));
		Структура.Вставить("ВалютаВзаиморасчетов", СтруктураДокумента.Валюта);
		Структура.Вставить("КодОрганизацииМДМ", СтруктураДокумента.КодОрганизацииМДМ);
		
	КонецЦикла;
	
	СтруктураДокумента.Вставить("РасшифровкаПлатежа", РасшифровкаПлатежа);
	
КонецПроцедуры

Процедура ЗаписатьВозвратТоваровОтПокупателя(Документ, СтруктураДокумента, ПеречитатьРегистры)
		
	СтруктураДокумента.Вставить("Валюта", Документ.ВалютаДокумента.КодМДМ);
	
	РеализациМассив = Новый Массив;
	
	ТаблицаТоваров = Документ.Товары.Выгрузить();
	ТаблицаТоваров.Свернуть("ДокументПартии", "Сумма");
	
	Для каждого Строка Из ТаблицаТоваров Цикл
		
		Если Не ЗначениеЗаполнено(Строка.ДокументПартии) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(Строка.ДокументПартии) <> Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			Продолжить;
		КонецЕсли;
		
		РеализацияСтруктура = Новый Структура;
		РеализацияСтруктура.Вставить("УникальныйИдентификатор", Строка(Строка.ДокументПартии.УникальныйИдентификатор()));
		РеализацияСтруктура.Вставить("Номер", Строка.ДокументПартии.Номер);
		РеализацияСтруктура.Вставить("Дата", Строка.ДокументПартии.Дата);
		РеализацияСтруктура.Вставить("Сумма", Строка.Сумма);
		РеализациМассив.Добавить(РеализацияСтруктура);   		
		
	КонецЦикла;
	
	СтруктураДокумента.Вставить("Реализации", РеализациМассив);
	СтруктураДокумента.Вставить("СуммаВключаетНДС", ?(Документ.СуммаВключаетНДС,1,0));
	
	Товары = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВозвратТоваровОтПокупателяТовары.Номенклатура.КодМДМ КАК Номенклатура,
	               |	ВозвратТоваровОтПокупателяТовары.Количество,
	               |	ВозвратТоваровОтПокупателяТовары.СтавкаНДС,
	               |	ВозвратТоваровОтПокупателяТовары.Сумма,
	               |	ВозвратТоваровОтПокупателяТовары.СуммаНДС,
	               |	ВозвратТоваровОтПокупателяТовары.Цена,
	               |	ВозвратТоваровОтПокупателяТовары.СерияНоменклатуры.НомерГТД.Представление КАК НомерГТД,
	               |	ВозвратТоваровОтПокупателяТовары.ЗаказПокупателя,
	               |	ВозвратТоваровОтПокупателяТовары.ДокументПартии
	               |ИЗ
	               |	Документ.ВозвратТоваровОтПокупателя.Товары КАК ВозвратТоваровОтПокупателяТовары
	               |ГДЕ
	               |	ВозвратТоваровОтПокупателяТовары.Ссылка = &Ссылка"; 
	
	Запрос.УстановитьПараметр("Ссылка",Документ.Ссылка);  
	
	Выб = Запрос.Выполнить().Выбрать();  
	
	Пока Выб.Следующий() Цикл 
		
		ТоварыСтруктура = Новый Структура; 
		ТоварыСтруктура.Вставить("Номенклатура", Выб.Номенклатура); 
		
		Если ЗначениеЗаполнено(Выб.ЗаказПокупателя) тогда
			ТоварыСтруктура.Вставить("Заказ", Строка(Выб.ЗаказПокупателя.УникальныйИдентификатор()));
		Иначе
			ТоварыСтруктура.Вставить("Заказ", "");
		КонецЕсли;
		
		ТоварыСтруктура.Вставить("Количество", Выб.Количество);
		ТоварыСтруктура.Вставить("СтавкаНДС", Строка(Выб.СтавкаНДС));
		ТоварыСтруктура.Вставить("Сумма", Выб.Сумма);
		ТоварыСтруктура.Вставить("СуммаНДС", Выб.СуммаНДС);
		ТоварыСтруктура.Вставить("Цена", Выб.Цена);
		ТоварыСтруктура.Вставить("НомерГТД", СокрЛП(Выб.НомерГТД));
		
		Если ЗначениеЗаполнено(Выб.ДокументПартии) Тогда 
			
			ТоварыСтруктура.Вставить("ОснованиеГУИД", Строка(Выб.ДокументПартии.УникальныйИдентификатор()));
			ТоварыСтруктура.Вставить("ОснованиеНомер", Выб.ДокументПартии.Номер);
			ТоварыСтруктура.Вставить("ОснованиеДата", Выб.ДокументПартии.Дата);
			ТоварыСтруктура.Вставить("ОснованиеТип", Выб.ДокументПартии.Метаданные().Имя);
			
		Иначе 
			
			ТоварыСтруктура.Вставить("ОснованиеГУИД", "");
			ТоварыСтруктура.Вставить("ОснованиеНомер", "");
			ТоварыСтруктура.Вставить("ОснованиеДата", "");
			ТоварыСтруктура.Вставить("ОснованиеТип", ""); 
			
		КонецЕсли; 
		
		Товары.Добавить(ТоварыСтруктура);   		

	КонецЦикла; 
	
	СтруктураДокумента.Вставить("Товары", Товары);
	
КонецПроцедуры

Процедура ЗаписатьКорректировкаДолга(Документ, СтруктураДокумента, ПеречитатьРегистры)
	
	СтруктураДокумента.Вставить("ШтампВерсии", Документ.ШтампВерсии);
	СтруктураДокумента.Вставить("ПометкаУдаления", Документ.ПометкаУдаления);

	Если Документ.Движения.Найти("ВзаиморасчетыСКонтрагентами") <> Неопределено Тогда
		
		ВзаиморасчетыМассив = Новый Массив;
		
		Если ПеречитатьРегистры Тогда
			Документ.Движения.ВзаиморасчетыСКонтрагентами.Прочитать();
		КонецЕсли;
		
		ТаблицаВзаиморасчетов = Документ.Движения.ВзаиморасчетыСКонтрагентами.Выгрузить();
		ТаблицаВзаиморасчетов.Свернуть("ВидДвижения, Контрагент, ДоговорКонтрагента", "СуммаВзаиморасчетов");
		
		Для каждого Взаиморасчет Из ТаблицаВзаиморасчетов Цикл
				
			Если Не Взаиморасчет.ДоговорКонтрагента.ВыгружаетсяВБиллинг Тогда
				Продолжить;
			КонецЕсли; 		
			
			ВзаиморасчетыСтруктура = Новый Структура;
			ВзаиморасчетыСтруктура.Вставить("Валюта", Взаиморасчет.ДоговорКонтрагента.ВалютаВзаиморасчетов.КодМДМ);
			ВзаиморасчетыСтруктура.Вставить("КодКонтрагентаМДМ", Взаиморасчет.Контрагент.КодМДМ);
			ВзаиморасчетыСтруктура.Вставить("КодОрганизацииМДМ", Взаиморасчет.ДоговорКонтрагента.Организация.КодМДМГоловнойОрганизации);
			ВзаиморасчетыСтруктура.Вставить("КодДоговораМДМ", Взаиморасчет.ДоговорКонтрагента.КодМДМ);
			ВзаиморасчетыСтруктура.Вставить("Сумма", Взаиморасчет.СуммаВзаиморасчетов * ?(Взаиморасчет.ВидДвижения = ВидДвиженияНакопления.Расход, -1, 1));
			ВзаиморасчетыМассив.Добавить(ВзаиморасчетыСтруктура);   		
			
		КонецЦикла;
		
		СтруктураДокумента.Вставить("Взаиморасчеты", ВзаиморасчетыМассив);
		
	КонецЕсли;
	
	СтруктураДокумента.Вставить("Валюта", Документ.ВалютаДокумента.КодМДМ);
	
	Если ЗначениеЗаполнено(Документ.КонтрагентДебитор) тогда
		СтруктураДокумента.Вставить("КонтрагентДебитор", Документ.КонтрагентДебитор.КодМДМ);
	Иначе
		СтруктураДокумента.Вставить("КонтрагентДебитор", "");
	КонецЕсли;  
	
	Если ЗначениеЗаполнено(Документ.КонтрагентКредитор) тогда
		СтруктураДокумента.Вставить("КонтрагентКредитор", Документ.КонтрагентКредитор.КодМДМ);
	Иначе
		СтруктураДокумента.Вставить("КонтрагентКредитор", "");
	КонецЕсли;   
	
	Если ЗначениеЗаполнено(Документ.ДоговорКонтрагента) тогда
		СтруктураДокумента.Вставить("ДоговорКонтрагента", Документ.ДоговорКонтрагента.КодМДМ);
	Иначе
		СтруктураДокумента.Вставить("ДоговорКонтрагента", "");
	КонецЕсли;  
	
	Долги = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КорректировкаДолгаСуммыДолга.Сумма,
	               |	КорректировкаДолгаСуммыДолга.ДоговорКонтрагента,
	               |	КорректировкаДолгаСуммыДолга.ВидЗадолженности,
	               |	КорректировкаДолгаСуммыДолга.ДокументРасчетовСКонтрагентом
	               |ИЗ
	               |	Документ.КорректировкаДолга.СуммыДолга КАК КорректировкаДолгаСуммыДолга
	               |ГДЕ
	               |	КорректировкаДолгаСуммыДолга.Ссылка = &Ссылка"; 
	
	Запрос.УстановитьПараметр("Ссылка",Документ.Ссылка);  
	
	Выб = Запрос.Выполнить().Выбрать();  
	
	Пока Выб.Следующий() Цикл   
		
		ДолгиСтруктура = Новый Структура;
		
		Если ЗначениеЗаполнено(Выб.ДоговорКонтрагента) Тогда
			ДолгиСтруктура.Вставить("ДоговорКонтрагента", Строка(Выб.ДоговорКонтрагента.КодМДМ));
		Иначе
			ДолгиСтруктура.Вставить("ДоговорКонтрагента", "");
		КонецЕсли; 
		
		ДолгиСтруктура.Вставить("Сумма", Выб.Сумма);
		ДолгиСтруктура.Вставить("ВидЗадолженности", СокрЛП(Выб.ВидЗадолженности));
		
		Если ЗначениеЗаполнено(Выб.ДокументРасчетовСКонтрагентом) Тогда    
			
			ДолгиСтруктура.Вставить("ОснованиеГУИД", Строка(Выб.ДокументРасчетовСКонтрагентом.УникальныйИдентификатор()));
			ДолгиСтруктура.Вставить("ОснованиеНомер", Выб.ДокументРасчетовСКонтрагентом.Номер);
			ДолгиСтруктура.Вставить("ОснованиеДата", Выб.ДокументРасчетовСКонтрагентом.Дата);
			ДолгиСтруктура.Вставить("ОснованиеТип", Выб.ДокументРасчетовСКонтрагентом.Метаданные().Имя);   
			
		Иначе     
			
			ДолгиСтруктура.Вставить("ОснованиеГУИД", "");
			ДолгиСтруктура.Вставить("ОснованиеНомер", "");
			ДолгиСтруктура.Вставить("ОснованиеДата", "");
			ДолгиСтруктура.Вставить("ОснованиеТип", ""); 
			
		КонецЕсли; 
		
		Долги.Добавить(ДолгиСтруктура);   		

	КонецЦикла;         
	
	СтруктураДокумента.Вставить("Долги", Долги);
	
КонецПроцедуры
	
