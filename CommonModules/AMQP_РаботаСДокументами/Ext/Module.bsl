
///////////////////Вызовы из подписок и регламентов///////////////////
Процедура ОбработкаПроведенияДокументаОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт	
	
	ПроверитьДокументИСоздатьСообщение(Источник);
	
КонецПроцедуры

Процедура ПередЗаписьюДокументаПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	Источник.ДополнительныеСвойства.Вставить("ЭтоНовый", Источник.ЭтоНовый());
	Источник.ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписи); 	 
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
		
	Если ОбщегоНазначения.ЕстьРеквизитДокумента("ШтампВерсии", Источник.Метаданные()) Тогда

		ПродолжитьПроверку = Истина;
		
		// Для документа "ВозвратТовровПоставщкику" необходимо формировать штамп версии, даже если документ  не проведен
		Если (ТипЗнч(Источник) = Тип("ДокументОбъект.ВозвратТоваровПоставщику") или ТипЗнч(Источник) = Тип("ДокументОбъект.ЗаявкаНаВозврат")) и Не Источник.Проведен Тогда 
			ПродолжитьПроверку = Ложь;	
		КонецЕсли; 
		
		Если ПродолжитьПроверку И Не ЗначениеЗаполнено(Источник.Ссылка) И РежимЗаписи = РежимЗаписиДокумента.Запись тогда
			Возврат; //Не делаем штамп версии для впервые записываемого, но не проводимого документа
		КонецЕсли;  
		
		НовыйШтамп = Число(Формат(ТекущаяДата(), "ДФ=yyMMddHHmmss"));
		
		Если Источник.ШтампВерсии >= НовыйШтамп Тогда
			Источник.ШтампВерсии = Источник.ШтампВерсии + 1;	
		Иначе
			Источник.ШтампВерсии = НовыйШтамп;
		КонецЕсли;  
		
	КонецЕсли;   
	                                                                                                         
КонецПроцедуры                                                 

Процедура ПриЗаписиДокументаПриЗаписи(Источник, Отказ) Экспорт
	
	Если (ТипЗнч(Источник) = Тип("ДокументОбъект.ВозвратТоваровПоставщику") 
		ИЛИ ТипЗнч(Источник) = Тип("ДокументОбъект.ЗаявкаНаВозврат")) И Не Источник.Проведен Тогда	
		//Если проведен, то выгрузка произойдет в подписке AMQP_ОбработкаПроведенияДокумента
		ПроверитьДокументИСоздатьСообщение(Источник);  
	ИначеЕсли Источник.ДополнительныеСвойства.Свойство("РежимЗаписи") 
		И Источник.ДополнительныеСвойства.РежимЗаписи = РежимЗаписиДокумента.Запись 
		//+Марков И. 13.08.2025 #UT10-5378
		И НЕ Источник.ДополнительныеСвойства.Свойство("НеФормироватьИсходящееСообщение") 
		//-Марков И. 13.08.2025 #UT10-5378
		И ОбщегоНазначения.ЕстьРеквизитДокумента("НомерЧекаККМ", Источник.Метаданные())
		И Источник.Проведен Тогда	
		ПроверитьДокументИСоздатьСообщение(Источник);  
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведенияОбработкаУдаленияПроведения(Источник, Отказ) Экспорт
	
	ПроверитьДокументИСоздатьСообщение(Источник, Истина);		
	
КонецПроцедуры 

Функция СоздатьИсходящееСообщение(ДокументОбъект, ОтменаПроведения = Ложь, ПеречитатьРегистры = Истина, 
								  ДополнСвойства = Неопределено, ДополнЗаголовки = Неопределено, Точка = "", НеЗаписыватьСообщение = Ложь) Экспорт

	Если ДополнСвойства = Неопределено Тогда
		ДополнСвойства = Новый СписокЗначений;
	КонецЕсли; 
	
	Если ДополнЗаголовки = Неопределено Тогда
		ДополнЗаголовки = Новый СписокЗначений;	
	КонецЕсли; 
	
	ЭтоНовый = Ложь;
	
	Если ДокументОбъект.ДополнительныеСвойства.Свойство("ЭтоНовый") Тогда
		ЭтоНовый = ДокументОбъект.ДополнительныеСвойства.ЭтоНовый;
	КонецЕсли;
	
	Документ = ДокументОбъект.Ссылка;
	
	ТипДокумента = Документ.Метаданные().Имя;
	                                                                          
	ДатаВремяСобытия = ТекущаяДата();
		
	НовоеСообщение = Справочники.ИсходящиеСообщения.СоздатьЭлемент();
	НовоеСообщение.ОбменДанными.Загрузка = Истина;
	НовоеСообщение.ДатаВремяСобытия = ДатаВремяСобытия; 
	
	Если ЗначениеЗаполнено(Точка) Тогда
		НовоеСообщение.ТочкаПубликации = Точка		
	Иначе
		НовоеСообщение.ТочкаПубликации = Константы.AMQP_Exchange.Получить(); 
	КонецЕсли; 
	
	ID = Новый УникальныйИдентификатор();     	
	НовоеСообщение.УстановитьСсылкуНового(Справочники.ИсходящиеСообщения.ПолучитьСсылку(ID));
	
	ДобавитьJSONВСообщение(НовоеСообщение, Документ, ДокументОбъект, ОтменаПроведения, ПеречитатьРегистры);
	
	НовоеСообщение.Объект = Документ.Ссылка;  	
	
	ДобавитьДанныеВСвойстваИЗаголовки(ДокументОбъект, ДополнСвойства, ДополнЗаголовки);	
	ДобавитьСвойстваИЗаголовкиВСообщение(НовоеСообщение, ТипДокумента, ДополнСвойства, ДополнЗаголовки);                                                             	
	
	Если НеЗаписыватьСообщение Тогда
		Возврат НовоеСообщение; 
	Иначе     
		
		Если ЗначениеЗаполнено(НовоеСообщение.Сообщение) Тогда
			НовоеСообщение.Записать();	
		КонецЕсли;
				
		Возврат Не НовоеСообщение.БылаОшибка;  
		
	КонецЕсли;
	
КонецФункции

Процедура СоздатьИсходящееСообщениеТоварыSM(Источник)
	
	//+Шульман А. 13.05.2025 #UT10-5232
	ДатаВремяСобытия = ТекущаяДата();
	
	НовоеСообщение = Справочники.ИсходящиеСообщения.СоздатьЭлемент();
	НовоеСообщение.ОбменДанными.Загрузка = Истина;
	НовоеСообщение.ДатаВремяСобытия = ДатаВремяСобытия;
	НовоеСообщение.ТочкаПубликации = Константы.AMQP_Exchange.Получить();
	НовоеСообщение.Объект = Источник.ВидОстатка;
	
	ID = Новый УникальныйИдентификатор();     	
	НовоеСообщение.УстановитьСсылкуНового(Справочники.ИсходящиеСообщения.ПолучитьСсылку(ID));
	
	СтруктураДокумента = Новый Структура;
	СтруктураДокумента.Вставить("ВидСостояния",  Источник.ВидОстатка);
	СтруктураДокумента.Вставить("ДатаСостояния", Источник.ДатаСостояния);
	СтруктураДокумента.Вставить("ДатаВыгрузки",  ДатаВремяСобытия);

	//Табличная часть	
	МассивТоваров = ОбщегоНазначения.ТаблицаЗначенийВМассив(Источник.Товары);
	СтруктураДокумента.Вставить("Товары", МассивТоваров);
	
	//Запись в JSON
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, СтруктураДокумента);
	JsonСтрока = ЗаписьJSON.Закрыть();	
	
	НовоеСообщение.Сообщение = JsonСтрока;
	
	Заголовки = Новый СписокЗначений;
	Заголовки.Добавить("message_ver",  "2.0"); 
 	Заголовки.Добавить("status_type",  Источник.ВидОстатка);
	
	Если ЗначениеЗаполнено(Заголовки) Тогда
		
		Для каждого Заголовок Из Заголовки Цикл
			
			НоваяСтрока = НовоеСообщение.Заголовки.Добавить();
			НоваяСтрока.Наименование = Заголовок.Значение;
			НоваяСтрока.Значение = Заголовок.Представление;
			
		КонецЦикла; 
		
	КонецЕсли;
	
	Свойства = Новый СписокЗначений;
	Свойства.Добавить("ТипСодержимого",	"application/json"); 
	Свойства.Добавить("ОтметкаВремени",	ДатуВTimestamp(НовоеСообщение.ДатаВремяСобытия));   	
	Свойства.Добавить("Тип",			"status"); 
	Свойства.Добавить("ИмяПриложения",  Константы.AMQP_ИдентификаторИнформацСистемы.Получить());
	Свойства.Добавить("РежимДоставки",	2);
	Свойства.Добавить("НомерСообщения",	Строка(НовоеСообщение.ПолучитьСсылкуНового().УникальныйИдентификатор()));
	
	Для каждого Свойство Из Свойства Цикл
		
		НоваяСтрока = НовоеСообщение.Свойства.Добавить();
		НоваяСтрока.Наименование = Свойство.Значение;
		НоваяСтрока.Значение = Свойство.Представление;
		
	КонецЦикла; 	
	
	НовоеСообщение.Записать(); 	
	//-Шульман А. 13.05.2025 #UT10-5232
	
КонецПроцедуры

Процедура СоздатьИсходящееСообщениеПоИтогамЗагрузкиПТУ(Сообщение, ДокПТУ, ТекстОшибки) Экспорт
	
	//+Шульман А. 26.03.2026 #UT10-5785
	ДатаВремяСобытия = ТекущаяДата();
	
	НовоеСообщение = Справочники.ИсходящиеСообщения.СоздатьЭлемент();
	НовоеСообщение.ОбменДанными.Загрузка = Истина;
	НовоеСообщение.ДатаВремяСобытия = ДатаВремяСобытия;
	НовоеСообщение.ТочкаПубликации = Константы.AMQP_Exchange.Получить();
	НовоеСообщение.Объект = Сообщение;
	
	ID = Новый УникальныйИдентификатор();     	
	НовоеСообщение.УстановитьСсылкуНового(Справочники.ИсходящиеСообщения.ПолучитьСсылку(ID));
	
	ДобавитьСвойстваИЗаголовкиВСообщение(НовоеСообщение, "Р_ВходящиеСообщения", Неопределено, Неопределено);                                                             	
	
	СтруктураДокумента = ОбщегоНазначения.ВернутьСтруктуруИзJSON(Сообщение.Данные); 
	
	СтруктураСообщения = Новый Структура();
	СтруктураСообщения.Вставить("api_id", СтруктураДокумента.api_id);
	
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		
		СтруктураСообщения.Вставить("number", "");    
		СтруктураСообщения.Вставить("date", "");
		СтруктураСообщения.Вставить("conducted", "");
		СтруктураСообщения.Вставить("agreement", "");
		СтруктураСообщения.Вставить("processed", Ложь);
		СтруктураСообщения.Вставить("error", ТекстОшибки);
		
	Иначе
		
		ТекстОшибки = СтрЗаменить(ТекстОшибки, Символы.ПС, " ");
		ТекстОшибки = СтрЗаменить(ТекстОшибки, """", "");
		
		СтруктураСообщения.Вставить("number",    СОКРЛП(ДокПТУ.Номер));
		СтруктураСообщения.Вставить("date",      Формат(ДокПТУ.Дата, "ДФ='yyyy.MM.dd HH:mm:ss'"));     
		СтруктураСообщения.Вставить("conducted", ДокПТУ.Проведен);  
		
		// Данные соглашения
		СтруктураСоглашение = Новый Структура(); 
		СтруктураСоглашение.Вставить("name",    СОКРЛП(ДокПТУ.ДоговорКонтрагента.Наименование)); 
		СтруктураСоглашение.Вставить("stor",    Ложь); 
		СтруктураСоглашение.Вставить("prem",    ДокПТУ.ПремиальнаяПерекупка); 
		СтруктураСоглашение.Вставить("perekup", Ложь); 
		СтруктураСоглашение.Вставить("zapas",   ДокПТУ.ПополнениеЗапасов); 
		
		СтруктураСообщения.Вставить("agreement", СтруктураСоглашение);    
		СтруктураСообщения.Вставить("processed", Истина);
		СтруктураСообщения.Вставить("error", "");
		
	КонецЕсли;
	
	ТекстСообщения = ОбщегоНазначения.ВернутьJSON(СтруктураСообщения);    	
	
	НовоеСообщение.Сообщение = ТекстСообщения;  
	НовоеСообщение.Записать();
    //-Шульман А. 26.03.2026 #UT10-5785

КонецПроцедуры


///////////////////Общие процедуры и функции///////////////////
Функция ПроверитьНужноЛиВыгружатьДокумент(Документ) Экспорт
	
	ИмяДокумента = Документ.Метаданные().Имя;
	
	ДокументВыгрузки = Справочники.AMQP_ДокументыВыгрузки.НайтиПоРеквизиту("ИмяДокумента", ИмяДокумента);
	
	Если Не ЗначениеЗаполнено(ДокументВыгрузки) ИЛИ Не ДокументВыгрузки.Выгружать Или ДокументВыгрузки.ПометкаУдаления Тогда
		Возврат Ложь;
	КонецЕсли;
	                          
	ПродолжитьПроверку = Ложь;
	
	Если ДокументВыгрузки.ВерсияВыгрузки =  Перечисления.ВерсияВыгрузкиСообщенийДляРаббит.Ver1_Ver2 
		Или ДокументВыгрузки.ВерсияВыгрузки =  Перечисления.ВерсияВыгрузкиСообщенийДляРаббит.Ver_1 Тогда
		ПродолжитьПроверку = Истина;
	КонецЕсли; 
	
	Если Не ПродолжитьПроверку Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	Если Документ.Дата < Константы.AMQP_ДатаНачалаВыгрузки.Получить() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ОбщегоНазначения.ЕстьРеквизитДокумента("ШтампВерсии", Документ.Метаданные()) Тогда
		
		Если Документ.ШтампВерсии = 0 тогда
			Возврат Ложь
		КонецЕсли; 
		
	КонецЕсли;
	
	Если ИмяДокумента = "ВозвратТоваровПоставщику" Тогда
		
		Возврат Документ.Контрагент = Константы.ОсновнойПоставщик.Получить();
		
	// Документы СборкаЗаказовПокупателей, РеализацияТоваровУслуг, ВозвратТоваровОтПокупателя проверка идет, через реквизит договор.
	ИначеЕсли ИмяДокумента = "КорректировкаСборкиЗаказовПокупателя" Тогда
		
		Результат = ПроверитьДокументКорректировкаСборкиЗаказовПокупателя(Документ);
		Возврат Результат;
		
	ИначеЕсли ИмяДокумента = "КорректировкаРеализации" Тогда
		
		Результат = ПроверитьДокументКорректировкаРеализации(Документ);
		Возврат Результат;
		
	ИначеЕсли ИмяДокумента = "КорректировкаДолга" Тогда	
		
		Результат = НЕ Документ.НеОтправлятьДокументВУчетныеСистемы;
		Возврат Результат;
		
	ИначеЕсли ИмяДокумента = "ПлатежноеПоручениеВходящее" Тогда
		
		Результат = ПроверитьДокументПлатежноеПоручениеВходящее(Документ);
		Возврат Результат;
		
	ИначеЕсли ИмяДокумента = "ПлатежноеПоручениеИсходящее" Тогда
		
		Результат = ПроверитьДокументПлатежноеПоручениеИсходящее(Документ);
		Возврат Результат;
		
	ИначеЕсли ИмяДокумента = "ПриходныйКассовыйОрдер" ИЛИ ИмяДокумента = "РасходныйКассовыйОрдер" Тогда
		Возврат Истина;	
		
	ИначеЕсли ИмяДокумента = "ОприходованиеТоваров" Или ИмяДокумента = "СписаниеТоваров" Тогда
		Возврат Истина;	
		
	//+ Пашкин О.А. 07.07.2025 #UT10-5299
	ИначеЕсли ИмяДокумента = "ЗаказНаЭмиссиюКодовМаркировкиСУЗ" Тогда	
		
		Результат = Документ.Статус = Перечисления.СтатусыЗаказаНаМаркировку.Отправлен;
		Возврат Результат;

	ИначеЕсли ИмяДокумента = "ОтчетОНанесенииКИЗ" Тогда	
		
		Результат = Документ.Статус = Перечисления.СтатусыОтчетОНанесенииКИЗ.Отправлен;
		Возврат Результат;

	ИначеЕсли ИмяДокумента = "ВводВОборотКИЗ" Тогда	
		
		Результат = Документ.Статус = Перечисления.СтатусыОтчетОНанесенииКИЗ.Отправлен;
		Возврат Результат;
	//- Пашкин О.А. 07.07.2025 #UT10-5299
	//+Белов А. 24.03.2026 #UT10-5761
	ИначеЕсли ИмяДокумента = "ВыводИзОборотаКИЗ" Тогда	
		
		Результат = Документ.Статус = Перечисления.СтатусыВыводИзОборотаКИЗ.Отправлен;
		Возврат Результат;
	//-Белов А. 24.03.2026 #UT10-5761
	КонецЕсли; 
	
	Если ОбщегоНазначения.ЕстьРеквизитДокумента("Договор", Документ.Метаданные()) Тогда
		
		Если Не ПроверитьДоговор(Документ.Договор) Тогда
			Возврат Ложь;
		КонецЕсли;
		
	КонецЕсли;	                                  
	
	Если ОбщегоНазначения.ЕстьРеквизитДокумента("ДоговорКонтрагента", Документ.Метаданные()) Тогда
		
		Если Не ПроверитьДоговор(Документ.ДоговорКонтрагента) Тогда
			Возврат Ложь;
		КонецЕсли;
		
	КонецЕсли;	                                        
	
	Возврат Истина;
	          	                                       
КонецФункции

Процедура ПроверитьДокументИСоздатьСообщение(Источник, ОтменаПроведения = Ложь)
	
	СоздатьСообщение = Истина;
	
	Если Не ПроверитьНужноЛиВыгружатьДокумент(Источник) Тогда
		СоздатьСообщение = Ложь;
	КонецЕсли;
	
	Если СоздатьСообщение Тогда
		
		Попытка
			СоздатьИсходящееСообщение(Источник, ОтменаПроведения, Ложь); 
		Исключение
			ЗаписьЖурналаРегистрации("СозданиеСообщений.Ошибка", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Не записано исходящее сообщение для документа: " + Строка(Источник) + Символы.ПС + ОписаниеОшибки());			
		КонецПопытки;
		
	КонецЕсли; 
	
	СоздатьСообщение = Истина;
	
	Если Не AMQP_РаботаСДокументами_ver2.ПроверитьНужноЛиВыгружатьДокумент(Источник) Тогда
		СоздатьСообщение = Ложь;
	КонецЕсли;
	
	Если СоздатьСообщение Тогда
		
		Попытка
			AMQP_РаботаСДокументами_ver2.СоздатьИсходящееСообщение(Источник, ОтменаПроведения, Ложь); 
		Исключение
			ЗаписьЖурналаРегистрации("СозданиеСообщений.Ошибка", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Не записано исходящее сообщение ver 2.0 для документа: " + Строка(Источник) + Символы.ПС + ОписаниеОшибки());			
		КонецПопытки;	
		
	КонецЕсли; 
	
КонецПроцедуры

Функция ПроверитьДокументПлатежноеПоручениеВходящее(ДокументОбъект) 
	
	Результат = Ложь;
	
	Если ДокументОбъект.РасшифровкаПлатежа.Количество() = 1 Тогда		
		
		Результат = ПроверитьДоговор(ДокументОбъект.ДоговорКонтрагента);
		Возврат Результат;
		
	КонецЕсли;
	
	Для каждого Стр Из ДокументОбъект.РасшифровкаПлатежа Цикл
		
		Результат = ПроверитьДоговор(Стр.ДоговорКонтрагента);  
		
		Если Результат Тогда
			Прервать;
		КонецЕсли; 	
		
	КонецЦикла; 
		
	Возврат Результат;
	
КонецФункции 

Функция ПроверитьДокументПлатежноеПоручениеИсходящее(ДокументОбъект) 
	
	Результат = Ложь;
	
	Если ДокументОбъект.РасшифровкаПлатежа.Количество() = 1 Тогда		
		
		Результат = ПроверитьДоговор(ДокументОбъект.ДоговорКонтрагента);
		Возврат Результат;
		
	КонецЕсли;
	
	Для каждого Стр Из ДокументОбъект.РасшифровкаПлатежа Цикл
		
		Результат = ПроверитьДоговор(Стр.ДоговорКонтрагента);   
		
		Если Результат Тогда
			Прервать;
		КонецЕсли; 	
		
	КонецЦикла; 
		
	Возврат Результат;
	
КонецФункции  

Функция ПроверитьДокументКорректировкаДолга(ДокументОбъект) 
	
	Результат = Ложь;
	
	Запрос = Новый Запрос;                             
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВзаиморасчетыСКонтрагентами.Регистратор,
	|	ВзаиморасчетыСКонтрагентами.ДоговорКонтрагента
	|ИЗ
	|	РегистрНакопления.ВзаиморасчетыСКонтрагентами КАК ВзаиморасчетыСКонтрагентами
	|ГДЕ
	|	ВзаиморасчетыСКонтрагентами.Регистратор = &Регистратор
	|	И ВзаиморасчетыСКонтрагентами.ДоговорКонтрагента.ВыгружаетсяВБиллинг"; 
	
	Запрос.УстановитьПараметр("Регистратор", ДокументОбъект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Количество() > 0 Тогда		
		Результат = Истина;			
	КонецЕсли; 
	 	
	Возврат Результат;
	
КонецФункции

Функция ПроверитьДокументКорректировкаРеализации(ДокументОбъект) 
	
	Результат = Ложь;	
	
	Искать = Истина;
	Запрос = Новый Запрос;
	ПараметрСсылка = ДокументОбъект.Ссылка;
	
	Пока Искать Цикл

		Запрос.Текст = 
		"ВЫБРАТЬ
		|	КорректировкаРеализации.Ссылка КАК Ссылка,
		|	КорректировкаРеализации.ДокументРеализации КАК ДокументОснование
		|ИЗ
		|	Документ.КорректировкаРеализации КАК КорректировкаРеализации
		|ГДЕ
		|	КорректировкаРеализации.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", ПараметрСсылка);
		
		РезультатЗапроса = Запрос.Выполнить().Выбрать();
		РезультатЗапроса.Следующий();
		ПараметрСсылка = РезультатЗапроса.ДокументОснование;
		
		Если ТипЗнч(РезультатЗапроса.ДокументОснование) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда			
			Продолжить;
		КонецЕсли; 
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	РеализацияТоваровУслуг.Ссылка,
		|	РеализацияТоваровУслуг.ДоговорКонтрагента,
		|	РеализацияТоваровУслуг.ДоговорКонтрагента.ВыгружаетсяВБиллинг КАК ВыгружаетсяВБиллинг
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|ГДЕ
		|	РеализацияТоваровУслуг.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", ПараметрСсылка);
		
		РезультатЗапроса = Запрос.Выполнить().Выбрать();
		РезультатЗапроса.Следующий();
		Результат = РезультатЗапроса.ВыгружаетсяВБиллинг;
		Искать = Ложь;		
		
	КонецЦикла; 
		
	Возврат Результат;
	
КонецФункции

Функция ПроверитьДокументКорректировкаСборкиЗаказовПокупателя(ДокументОбъект) 
	
	Результат = Ложь;	 
	
	Запрос = Новый Запрос;		
	Запрос.Текст = "ВЫБРАТЬ
	               |	СборкаЗаказовПокупателя.Ссылка,
	               |	СборкаЗаказовПокупателя.Договор,
	               |	ЕСТЬNULL(ДоговорыКонтрагентов.ВыгружаетсяВБиллинг, ЛОЖЬ) КАК ВыгружаетсяВБиллинг,
	               |	ЕСТЬNULL(ДоговорыКонтрагентов.Ссылка, """") КАК Договор
	               |ИЗ
	               |	Документ.СборкаЗаказовПокупателя КАК СборкаЗаказовПокупателя
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	               |		ПО СборкаЗаказовПокупателя.Договор = ДоговорыКонтрагентов.Ссылка
	               |ГДЕ
	               |	СборкаЗаказовПокупателя.Ссылка = &СборкаЗаказовПокупателя";	
	
	Запрос.УстановитьПараметр("СборкаЗаказовПокупателя", ДокументОбъект.СборкаЗаказовПокупателя);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Количество() > 0 Тогда    
		
		РезультатЗапроса.Следующий();
		Результат =  РезультатЗапроса.ВыгружаетсяВБиллинг;   
		
	КонецЕсли; 
	
	Возврат Результат;	
	
КонецФункции

Функция ПроверитьДоговор(Договор) 
	
	Если ТипЗнч(Договор) = Тип("СправочникСсылка.ДоговорыКонтрагентов") И НЕ Договор.ВыгружаетсяВБиллинг Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Процедура ДобавитьДанныеВСвойстваИЗаголовки(ДокументОбъект, ДополнСвойства, ДополнЗаголовки)
	
	Документ = ДокументОбъект.Ссылка;
	ТипДокумента = Документ.Метаданные().Имя;
	
	Если ТипДокумента = "КорректировкаДолга" Тогда
		ДополнЗаголовки.Добавить("kind_operation", XMLСтрока(ДокументОбъект.ВидОперации));
		
	ИначеЕсли ТипДокумента = "ВозвратТоваровПоставщику" Тогда 
	
		ДополнЗаголовки.Добавить("app_id", ПолучитьКодПрикладнойСистемы());
		ДополнЗаголовки.Добавить("app_Recipient_id", "UT10");
		
		Если ЗначениеЗаполнено(ДокументОбъект.КодМДМОрганизацииВСмежнойБазе) Тогда
			ДополнЗаголовки.Добавить("operation_type", "Перемещение");
		Иначе
			ДополнЗаголовки.Добавить("operation_type", "Предварительный");
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры
 
Процедура ДобавитьJSONВСообщение(НовоеСообщение, Документ, ДокументОбъект, ОтменаПроведения, ПеречитатьРегистры = Истина) Экспорт
	
	СтруктураДокумента = Новый Структура;
	
	ТипДокумента = Документ.Метаданные().Имя;
	
	ЗаписатьПредопределенныеРеквизитыДокумента(Документ, СтруктураДокумента, ОтменаПроведения);
	
	Если ТипДокумента <> "КорректировкаДолга"  И ТипДокумента <> "РасходныйКассовыйОрдер" и ТипДокумента <> "ВозвратТоваровПоставщику" 
	   И ТипДокумента <> "ПриходныйКассовыйОрдер" 
	   И ТипДокумента <> "ОприходованиеТоваров"   
	   И ТипДокумента <> "СписаниеТоваров" Тогда  
		ЗаписатьОсновныеРеквизитыДокумента(Документ, СтруктураДокумента);
	КонецЕсли;
	
	//+ Пашкин О.А. 07.07.2025 #UT10-5299
	ОбработкаМаркировки = ЛОЖЬ;
	//- Пашкин О.А. 07.07.2025 #UT10-5299
	
	Если ТипДокумента = "СборкаЗаказовПокупателя" Тогда			
		ЗаписатьСборкаЗаказовПокупателяДляБиллинга(ДокументОбъект, СтруктураДокумента, ПеречитатьРегистры);			
	ИначеЕсли ТипДокумента = "РеализацияТоваровУслуг" Тогда						
		ЗаписатьРеализацияТоваровУслуг(ДокументОбъект, СтруктураДокумента, ПеречитатьРегистры);		
	ИначеЕсли ТипДокумента = "КорректировкаРеализации" Тогда	                               				
		ЗаписатьКорректировкаРеализации(ДокументОбъект, СтруктураДокумента, ПеречитатьРегистры);		
	ИначеЕсли ТипДокумента = "ПлатежноеПоручениеВходящее" Тогда	                                				
		ЗаписатьПлатежноеПоручениеВходящее(ДокументОбъект, СтруктураДокумента, ПеречитатьРегистры);		
	ИначеЕсли ТипДокумента = "ПлатежноеПоручениеИсходящее" Тогда	                               				
		ЗаписатьПлатежноеПоручениеИсходящее(ДокументОбъект, СтруктураДокумента, ПеречитатьРегистры);		
	ИначеЕсли ТипДокумента = "ПриходныйКассовыйОрдер" Тогда	                                        				
		ЗаписатьПриходныйКассовыйОрдер(ДокументОбъект, СтруктураДокумента, ПеречитатьРегистры);     	
	ИначеЕсли ТипДокумента = "РасходныйКассовыйОрдер" Тогда	                                        				
		ЗаписатьРасходныйКассовыйОрдер(ДокументОбъект, СтруктураДокумента, ПеречитатьРегистры);     	
	ИначеЕсли ТипДокумента = "ВозвратТоваровОтПокупателя" Тогда                                     	
		ЗаписатьВозвратТоваровОтПокупателя(ДокументОбъект, СтруктураДокумента, ПеречитатьРегистры); 	
	ИначеЕсли ТипДокумента = "КорректировкаДолга" Тогда                                             	
		ЗаписатьКорректировкаДолга(ДокументОбъект, СтруктураДокумента, ПеречитатьРегистры);         		
	ИначеЕсли ТипДокумента = "КорректировкаСборкиЗаказовПокупателя" Тогда 
		ЗаписатьКорректировкуСборкиЗаказаПокупателя(ДокументОбъект, СтруктураДокумента, ПеречитатьРегистры);
	ИначеЕсли ТипДокумента = "ВозвратТоваровПоставщику" Тогда
		ЗаписатьВозвратТоваровПоставщику(ДокументОбъект, СтруктураДокумента, ПеречитатьРегистры);  
	ИначеЕсли ТипДокумента = "ОприходованиеТоваров" Тогда
		ЗаписатьОприходованиеТоваров(ДокументОбъект, СтруктураДокумента, ПеречитатьРегистры); 
	ИначеЕсли ТипДокумента = "СписаниеТоваров" Тогда
		ЗаписатьСписаниеТоваров(ДокументОбъект, СтруктураДокумента, ПеречитатьРегистры); 
	//+ Пашкин О.А. 07.07.2025 #UT10-5299
	ИначеЕсли ТипДокумента = "ОтчетОНанесенииКИЗ" Тогда
		ОбработкаМаркировки = ИСТИНА;
		ЗаписатьОтчетОНанесении(ДокументОбъект, СтруктураДокумента, ПеречитатьРегистры); 
	ИначеЕсли ТипДокумента = "ЗаказНаЭмиссиюКодовМаркировкиСУЗ" Тогда
		ОбработкаМаркировки = ИСТИНА;
		ЗаписатьЗаказНаЭмиссиюКодовМаркировкиСУЗ(ДокументОбъект, СтруктураДокумента, ПеречитатьРегистры); 
	ИначеЕсли ТипДокумента = "ВводВОборотКИЗ" Тогда
		ОбработкаМаркировки = ИСТИНА;
		ЗаписатьВводВОборот(ДокументОбъект, СтруктураДокумента, ПеречитатьРегистры); 
	//- Пашкин О.А. 07.07.2025 #UT10-5299 
	//+Белов А. 24.03.2026 #ВыводИзОборотаКИЗ
	ИначеЕсли ТипДокумента = "ВыводИзОборотаКИЗ" Тогда
		
		ОбработкаМаркировки = ИСТИНА;
		ЗаписатьВыводИзОборота(ДокументОбъект, СтруктураДокумента, ПеречитатьРегистры); 
		
	//-Белов А. 24.03.2026 #ВыводИзОборотаКИЗ
	КонецЕсли;
	
	ЕстьОшибки = Ложь;
	СписокОшибок = "";
	
	Для каждого Стр Из СтруктураДокумента Цикл
		
		Если Найти(Стр.Ключ, "МДМ") <> 0 И Не ЗначениеЗаполнено(СокрЛП(Стр.Значение)) Тогда
			
			ЕстьОшибки = Истина;
			СписокОшибок = СписокОшибок + ?(ЗначениеЗаполнено(СписокОшибок), Символы.ПС, "") + "Не заполнен Код МДМ для реквизита: " + Стр.Ключ;
			
		КонецЕсли;		
		
	КонецЦикла;
	
	Если ЕстьОшибки Тогда
		
		НовоеСообщение.Сообщение = "";
		НовоеСообщение.БылаОшибка = Истина;
		
		Если НовоеСообщение.ЭтоНовый() Тогда
			AMQP_РаботаСДокументами.ОповеститьСерверМониторинга(Ложь, Истина,, СписокОшибок, Строка(НовоеСообщение.ПолучитьСсылкуНового().УникальныйИдентификатор()));
		Иначе
			AMQP_РаботаСДокументами.ОповеститьСерверМониторинга(Ложь, Истина,, СписокОшибок, Строка(НовоеСообщение.Ссылка.УникальныйИдентификатор()));
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ЕстьОшибки Или Найти("ОприходованиеТоваров, СписаниеТоваров", ТипДокумента) > 0 Тогда
		

		ЗаписьJSON = Новый ЗаписьJSON();
		ЗаписьJSON.УстановитьСтроку(); 
		ЗаписатьJSON(ЗаписьJSON, СтруктураДокумента);
		JsonСтрока = ЗаписьJSON.Закрыть(); 	
		//+ Пашкин О.А. 07.07.2025 #UT10-5299
		Если ОбработкаМаркировки Тогда
			JsonСтрока = СтрЗаменить(JsonСтрока,"\\u001","\u001");
		КонецЕсли;
		//- Пашкин О.А. 07.07.2025 #UT10-5299
		НовоеСообщение.Сообщение = JsonСтрока;	
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьСвойстваИЗаголовкиВСообщение(НовоеСообщение, ТипДокумента, ДополнСвойства = Неопределено, ДополнЗаголовки = Неопределено)	
	                                                         
	Заголовки = Новый СписокЗначений;
	
	//+Шульман А. 26.03.2026 #UT10-5785
	Если ТипДокумента = "Р_ВходящиеСообщения" Тогда
		Заголовки.Добавить("status_type", "СостояниеОбработкиУПД"); 
	//-Шульман А. 26.03.2026 #UT10-5785
	Иначе
		Заголовки.Добавить("document_type", ПолучитьТипДокументаИзБиллингаДля1С(ТипДокумента));  
	КонецЕсли;
	
	НужноДобавлятьЗаголовокПолучателя = Истина; 
	
	Если ЗначениеЗаполнено(ДополнЗаголовки) И ДополнЗаголовки.НайтиПоЗначению("app_Receiver_id") <> Неопределено Тогда
		НужноДобавлятьЗаголовокПолучателя = Ложь;	
	КонецЕсли;  

	//+ Пашкин О.А. 07.07.2025 #UT10-5299
	Если ТипДокумента = "ОтчетОНанесенииКИЗ" 
		ИЛИ ТипДокумента = "ЗаказНаЭмиссиюКодовМаркировкиСУЗ" 
		ИЛИ ТипДокумента = "ВводВОборотКИЗ"
		//+Белов А. 24.03.2026 #UT10-5761
		ИЛИ ТипДокумента = "ВыводИзОборотаКИЗ"
		//-Белов А. 24.03.2026 #UT10-5761Т
		Тогда  
		
		Заголовки.Добавить("message_ver",  "2.0"); 
		НужноДобавлятьЗаголовокПолучателя = ЛОЖЬ;  
		
	КонецЕсли;
	//- Пашкин О.А. 07.07.2025 #UT10-5299
 
	Если НужноДобавлятьЗаголовокПолучателя Тогда
		Заголовки.Добавить("app_Receiver_id", "None");	
	КонецЕсли;  
	
	Если Найти("ОприходованиеТоваров, СписаниеТоваров", ТипДокумента) > 0 тогда
		Заголовки.Добавить("warehouse_id", НовоеСообщение.Объект.Склад.КодМДМ);     
	КонецЕсли;
	
	Свойства = Новый СписокЗначений;
	Свойства.Добавить("ТипСодержимого", "application/json"); 
	Свойства.Добавить("ОтметкаВремени", ДатуВTimestamp(НовоеСообщение.ДатаВремяСобытия));   	
	Свойства.Добавить("Тип", "document"); 
	Свойства.Добавить("ИмяПриложения", Константы.AMQP_ИдентификаторИнформацСистемы.Получить());
	Свойства.Добавить("РежимДоставки", 2);
	Свойства.Добавить("НомерСообщения", Строка(НовоеСообщение.ПолучитьСсылкуНового().УникальныйИдентификатор()));
	
	Для каждого Свойство Из Свойства Цикл
		
		НоваяСтрока = НовоеСообщение.Свойства.Добавить();
		НоваяСтрока.Наименование = Свойство.Значение;
		НоваяСтрока.Значение = Свойство.Представление;
		
	КонецЦикла;   	
	
	Если ЗначениеЗаполнено(Заголовки) Тогда
		
		Для каждого Заголовок Из Заголовки Цикл
			
			НоваяСтрока = НовоеСообщение.Заголовки.Добавить();
			НоваяСтрока.Наименование = Заголовок.Значение;
			НоваяСтрока.Значение = Заголовок.Представление;
			
		КонецЦикла;   
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДополнЗаголовки) Тогда
		
		Для каждого Заголовок Из ДополнЗаголовки Цикл
			
			НоваяСтрока = НовоеСообщение.Заголовки.Добавить();
			НоваяСтрока.Наименование = Заголовок.Значение;
			НоваяСтрока.Значение = Заголовок.Представление;
			
		КонецЦикла;   
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДополнСвойства) Тогда
		
		Для каждого Свойство Из ДополнСвойства Цикл
			
			НоваяСтрока = НовоеСообщение.Свойства.Добавить();
			НоваяСтрока.Наименование = Свойство.Значение;
			НоваяСтрока.Значение = Свойство.Представление;
			
		КонецЦикла;   
		
	КонецЕсли;		
	
КонецПроцедуры

Функция ПолучитьТипДокументаИзБиллингаДля1С(ТипДокумента) Экспорт
	
	Соотв = Новый Соответствие;
	Соотв.Вставить("СборкаЗаказа", "СборкаЗаказовПокупателя");
	Соотв.Вставить("Возврат", "ВозвратТоваровОтПокупателя");
	Соотв.Вставить("ОприходованиеТоваров", "ОприходованиеИзлишковТоваров");
	Соотв.Вставить("СписаниеТоваров", "СписаниеНедостачТоваров");
	//+ Пашкин О.А. 07.07.2025 #UT10-5299
	Соотв.Вставить("ОтчетОНанесенииКИЗ", "ОтчетОНанесении");
	Соотв.Вставить("ЗаказНаЭмиссиюКодовМаркировкиСУЗ", "ЗаказНаЭмиссию");
	Соотв.Вставить("ВводВОборотКИЗ", "ВводВОборот");
	//- Пашкин О.А. 07.07.2025 #UT10-5299  
	//+Белов А. 24.03.2026 #UT10-5761
	Соотв.Вставить("ВыводИзОборотаКИЗ", "ВыводИзОборота");
	//-Белов А. 24.03.2026 #UT10-5761
	
	Имя = Соотв.Получить(ТипДокумента);
	
	Если Имя = Неопределено Тогда
		Возврат ТипДокумента;
	Иначе
		Возврат Имя;
	КонецЕсли;   	
	
КонецФункции      

