Функция ВернутьЗапросТоварыВЗаказахПоставщикамТоварВПути(ДатаОстатка)
	
	//+Шульман А. 13.05.2025 #UT10-5232
	Запрос = Новый Запрос;
	Запрос.Текст =   
	"ВЫБРАТЬ
	|	ЗаказыПоставщикамОстатки.ЗаказПоставщику.Склад КАК Склад,
	|	ЗаказыПоставщикамОстатки.ЗаказПоставщику.Контрагент КАК Контрагент,
	|	ЗаказыПоставщикамОстатки.Номенклатура,
	|	ЗаказыПоставщикамОстатки.ЗаказПоставщику.ДатаПоступления КАК ДатаПоступления,
	|	СУММА(ЗаказыПоставщикамОстатки.КоличествоОстаток) КАК ЗаказаноОстаток
	|ПОМЕСТИТЬ ВТ_ОстаткиСуммы
	|ИЗ
	|	РегистрНакопления.ЗаказыПоставщикам.Остатки(&Дата,    
	//+Шульман А. 02.06.2025 #UT10-5270 
	|          НЕ ЗаказПоставщику.Экспресс  
	//-Шульман А. 02.06.2025 #UT10-5270 
	|) КАК ЗаказыПоставщикамОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказыПоставщикамОстатки.Номенклатура,
	|	ЗаказыПоставщикамОстатки.ЗаказПоставщику.ДатаПоступления,
	|	ЗаказыПоставщикамОстатки.ЗаказПоставщику.Контрагент,
	|	ЗаказыПоставщикамОстатки.ЗаказПоставщику.Склад
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОстаткиСуммы.Склад.КодМДМ,
	|	ВТ_ОстаткиСуммы.Контрагент.КодМДМ,
	|	ВТ_ОстаткиСуммы.Номенклатура.КодМДМ КАК НоменклатураКодМДМ,
	|	ВТ_ОстаткиСуммы.ДатаПоступления КАК ПлановаяДатаПоставки,
	|	ВТ_ОстаткиСуммы.ЗаказаноОстаток КАК Бэкордер,
	|	0 КАК ВПути
	|ИЗ
	|	ВТ_ОстаткиСуммы КАК ВТ_ОстаткиСуммы";  
	
	Запрос.УстановитьПараметр("Дата", ДатаОстатка);
	
	Возврат Запрос.Выполнить();  
	//-Шульман А. 13.05.2025 #UT10-5232

КонецФункции // ()

Функция ВернутьЗапросТоварыВЗаказахПоставщикам(ДатаОстатка)
	
	//+Шульман А. 08.09.2025 #UT10-5415
	Запрос = Новый Запрос;
	//Марков И. 17.09.2025 #UT10-5426 Изменен выбор КодМДМ Организации в запросе
	Запрос.Текст =   
	"ВЫБРАТЬ
	|	ЗаказыПоставщикамОстатки.ЗаказПоставщику КАК ЗаказПоставщику,
	|	ЗаказыПоставщикамОстатки.Номенклатура,
	|	СУММА(ЗаказыПоставщикамОстатки.КоличествоОстаток) КАК ЗаказаноОстаток,
	|	СУММА(ЗаказыПоставщикамОстатки.СуммаВзаиморасчетовОстаток) КАК СуммаВзаиморасчетовОстаток
	|ПОМЕСТИТЬ ВТ_ОстаткиСуммы
	|ИЗ
	|	РегистрНакопления.ЗаказыПоставщикам.Остатки(&Дата, ) КАК ЗаказыПоставщикамОстатки
	|ГДЕ
	|	ЗаказыПоставщикамОстатки.КоличествоОстаток > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказыПоставщикамОстатки.ЗаказПоставщику,
	|	ЗаказыПоставщикамОстатки.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПРЕДСТАВЛЕНИЕ(УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ВТ_ОстаткиСуммы.ЗаказПоставщику)) КАК ЗаказПоставщикуКодМДМ,
	|	ВЫБОР
	|		КОГДА ВТ_ОстаткиСуммы.ЗаказПоставщику.Организация.КодМДМГоловнойОрганизации <> """"
	|			ТОГДА ВТ_ОстаткиСуммы.ЗаказПоставщику.Организация.КодМДМГоловнойОрганизации
	|		ИНАЧЕ ВТ_ОстаткиСуммы.ЗаказПоставщику.Организация.КодМДМ
	|	КОНЕЦ КАК ОрганизацияКодМДМ,
	|	ВТ_ОстаткиСуммы.ЗаказПоставщику.Склад.КодМДМ КАК СкладКодМДМ,
	|	ВТ_ОстаткиСуммы.ЗаказПоставщику.Контрагент.КодМДМ КАК КонтрагентКодМДМ,
	|	ВТ_ОстаткиСуммы.Номенклатура.КодМДМ КАК НоменклатураКодМДМ,
	|	ВТ_ОстаткиСуммы.Номенклатура.КодПроизводителя КАК Артикул,
	|	ВТ_ОстаткиСуммы.ЗаказаноОстаток КАК КолвоЗаказано,
	|	ВТ_ОстаткиСуммы.СуммаВзаиморасчетовОстаток КАК СуммаЗаказано
	|ИЗ
	|	ВТ_ОстаткиСуммы КАК ВТ_ОстаткиСуммы";  
	
	Запрос.УстановитьПараметр("Дата", ДатаОстатка);
	
	Возврат Запрос.Выполнить(); 
	//-Шульман А. 08.09.2025 #UT10-5415

КонецФункции // ()



