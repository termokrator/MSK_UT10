	СтруктураДокумента.Вставить("ПометкаУдаления",  Документ.ПометкаУдаления);
	СтруктураДокумента.Вставить("КодОрганизацииМДМ",  Строка(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ.Организация,"КодМДМГоловнойОрганизации")));
	СтруктураДокумента.Вставить("ТоварнаяГруппа",  Документ.ВидПродукции.Алиас);
	
	//+Макрушин Е. 29.07.2026 #UT10-5973
	Если ЗначениеЗаполнено(Документ.ВидПродукции) И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ.ВидПродукции, "ИспользуетсяМОД") = Истина Тогда
		СтруктураДокумента.Вставить("Кпп",  ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Константы.ОсновнаяОрганизация.Получить(), "КПП"));
	КонецЕсли;
	//-Макрушин Е. 29.07.2026 #UT10-5973

	//Табличная часть 
	СтрокаТип = Новый ОписаниеТипов("Строка");
	ЧислоТип = Новый ОписаниеТипов("Число");
	ДатаТип = Новый ОписаниеТипов("Дата");
	ТаблицаТоваров = Новый ТаблицаЗначений;
	ТаблицаТоваров.Колонки.Добавить("КодСтроки",ЧислоТип);
	ТаблицаТоваров.Колонки.Добавить("КодМаркировки",СтрокаТип);
	ТаблицаТоваров.Колонки.Добавить("КодМДМНоменклатуры",СтрокаТип);
	ТаблицаТоваров.Колонки.Добавить("ДатаПроизводства",СтрокаТип);
	ТаблицаТоваров.Колонки.Добавить("СрокГодности",СтрокаТип);
	
	Для Каждого СтрокаТовары Из Документ.Товары Цикл
		
		//+Кабанов А.В. 21.08.2025 # UT10-5345 
		Если НЕ СтрокаТовары.ЧужойКИЗ И ЗначениеЗаполнено(СтрокаТовары.ШтрихКодМаркировки) И НЕ СтрокаТовары.ШтрихКодМаркировки.СрокГодности < Документ.Дата Тогда 
			
			НоваяСтрокаТТ                    = ТаблицаТоваров.Добавить(); 
			НоваяСтрокаТТ.КодСтроки          = СтрокаТовары.НомерСтроки;
			НоваяСтрокаТТ.КодМДМНоменклатуры = Строка(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТовары.Номенклатура,"КодМДМ"));
			НоваяСтрокаТТ.КодМаркировки      = СтрокаТовары.ШтрихКодМаркировки.ПолныйКодМаркировки.Получить();
			НоваяСтрокаТТ.ДатаПроизводства   = Формат(СтрокаТовары.ШтрихКодМаркировки.ДатаПроизводства, "ДФ=dd.MM.yyyy");
			НоваяСтрокаТТ.СрокГодности       = Формат(СтрокаТовары.ШтрихКодМаркировки.СрокГодности, "ДФ=dd.MM.yyyy");
			
		КонецЕсли;
		//+Кабанов А.В. 21.08.2025 # UT10-5345
		
	КонецЦикла;
	
	МассивТоваров = ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаТоваров);
	СтруктураДокумента.Вставить("Товары", МассивТоваров);
