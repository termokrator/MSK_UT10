	СтруктураЗапроса.Вставить("date_from" , СокрЛП(Формат(ДобавитьМесяц(ТекущаяДата(), -2), "ДЛФ=D")));
	СтруктураЗапроса.Вставить("date_to"   , Формат(ТекущаяДата(), "ДЛФ=D"));

	СтрокаЗапроса = "/api/v2/client/debt-documents";
	ПредставлениеЗапроса = "Получение неоплаченных документов";
	
	Для Сч = 1 По КолвоПопыток Цикл				
		
		СтруктураРезультата = AMQP_РаботаСДокументами.ОтправитьЗапросВБиллинг(СтрокаЗапроса, ПредставлениеЗапроса, "POST",,,, Чеки.ВернутьJSON(СтруктураЗапроса));
		
		Если СтруктураРезультата.Результат < 2 Тогда
			Прервать;
		КонецЕсли; 
		
		Если СтруктураРезультата.Результат = 2 И Сч <> КолвоПопыток Тогда
			AMQP_РаботаСДокументами.ПаузаИсполнения(ЗадержкаПоВремени);	
		КонецЕсли;  
		
	КонецЦикла; 		
	
	Если СтруктураРезультата.Данные <> Неопределено И ТипЗнч(СтруктураРезультата.Данные) = Тип("Массив") Тогда
		
		НеоплаченныеДокументы = Новый ТаблицаЗначений;
		НеоплаченныеДокументы.Колонки.Добавить("Контрагент");
		НеоплаченныеДокументы.Колонки.Добавить("ДоговорКонтрагента");
		НеоплаченныеДокументы.Колонки.Добавить("Документ");
		НеоплаченныеДокументы.Колонки.Добавить("ДатаДокумента");
		НеоплаченныеДокументы.Колонки.Добавить("Сумма");
		НеоплаченныеДокументы.Колонки.Добавить("ПросроченоДней");
		НеоплаченныеДокументы.Колонки.Добавить("Грузополучатель");
		НеоплаченныеДокументы.Колонки.Добавить("ДопустимоеЧислоДнейЗадолженности");
		НеоплаченныеДокументы.Колонки.Добавить("ДопустимаяСуммаЗадолженности");
		
		ИмяБазы = Константы.AMQP_ИдентификаторИнформацСистемы.Получить();
		
		БылиОшибки = Ложь;
		ТекстОшибок = "";
		
		Для Каждого Долг ИЗ СтруктураРезультата.Данные Цикл
			
			Попытка
				
				Дата = XmlЗначение(Тип("Дата"), Долг.date);
				
				НоваяСтрока = НеоплаченныеДокументы.Добавить();
				НоваяСтрока.Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту("КодМДМ", Долг.kontragent_mdm_id);
				НоваяСтрока.ДоговорКонтрагента = Справочники.ДоговорыКонтрагентов.НайтиПоРеквизиту("КодМДМ", Долг.agreement_mdm_id);
				
				ИмяБазыБиллинг = Долг.app_id;
				ТипДокумента = "";
				ТипДокументаПредставление = "";
				
				Если НРег(Долг.Type_Code) = "realization" Тогда
					
					ТипДокумента = "РеализацияТоваровУслуг";
					ТипДокументаПредставление = Метаданные.Документы[ТипДокумента].Синоним;
					
				КонецЕсли;
				
				Если НРег(ИмяБазыБиллинг) = НРег(Строка(ИмяБазы)) ИЛИ НРег(ИмяБазыБиллинг) = НРег(Строка(Константы.База.Получить())) Тогда
					
					Если ТипДокумента <> "" Тогда
						
						НоваяСтрока.Документ = Документы[ТипДокумента].ПолучитьСсылку(Новый УникальныйИдентификатор(Долг.source_id));
						ОбъектДокумент = НоваяСтрока.Документ.ПолучитьОбъект();
						
						Если ОбъектДокумент = Неопределено Тогда
							НоваяСтрока.Документ = ТипДокументаПредставление + " " + Долг.number + " от " + Формат(Дата, "ДЛФ=DT") + " - документ не найден";	
						Иначе
							НоваяСтрока.Грузополучатель = НоваяСтрока.Документ.Грузополучатель;
						КонецЕсли; 
						
					КонецЕсли; 
					
				Иначе
					НоваяСтрока.Документ = ТипДокументаПредставление + " " + Долг.number + " от " + Формат(Дата, "ДЛФ=DT") + " - " + ИмяБазыБиллинг;
				КонецЕсли;
				
				НоваяСтрока.ДатаДокумента = Дата;
				НоваяСтрока.Сумма = -Число(Долг.amount);
				НоваяСтрока.ПросроченоДней = Долг.overdue_days;  
				
			Исключение
				БылиОшибки = Истина;
				ТекстОшибок = ТекстОшибок + Символы.ПС + ОписаниеОшибки();
			КонецПопытки; 
			
		КонецЦикла;	
		
		Если БылиОшибки И ЗаписыватьВЖурнал Тогда
			ЗаписьЖурналаРегистрации("РаботаСБиллингом.Ошибка", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Ошибка выполнения запроса: " + ПредставлениеЗапроса + Символы.ПС + "Текст ошибки: " + ТекстОшибок + Символы.ПС + "Текст запроса: " + СтрокаЗапроса);
		КонецЕсли;
		
		СтруктураРезультата.Данные = НеоплаченныеДокументы;	
		
	КонецЕсли;     
	
	Возврат СтруктураРезультата; 
	
КонецФункции

Функция СформироватьСтрокуКорректировкиЗаказов(Документ, ПолучитьТЗ = Ложь ) Экспорт
	
	Рез = "";
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("ЗаказПокупателя",Новый ОписаниеТипов("ДокументСсылка.ЗаказПокупателя"));
	ТЗ.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗ.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));

	Т1 = Документ.Товары.Выгрузить(,"ЗаказПокупателя,Номенклатура,Количество");
	Т1.Свернуть("ЗаказПокупателя,Номенклатура","Количество");
	
	Для каждого стр из Т1 Цикл
		
		Строка = Тз.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Стр);
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЗ.ЗаказПокупателя,
	|	ТЗ.Номенклатура,
	|	ТЗ.Количество                           
	|ПОМЕСТИТЬ ИсхТабл
	|ИЗ
	|	&ТЗ КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказПокупателяТовары.Номенклатура,
	|	ЗаказПокупателяТовары.Ссылка,
	|	СУММА(ЗаказПокупателяТовары.Количество) КАК Количество,
	|	СУММА(ЗаказПокупателяТовары.Сумма) / СУММА(ЗаказПокупателяТовары.Количество) КАК ЦенаЗаОднуНоменклатуру,
	|	СУММА(ЗаказПокупателяТовары.Сумма) / СУММА(ЗаказПокупателяТовары.Количество) * МАКСИМУМ(ИсхТабл.Количество) КАК Сумма	
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	ИсхТабл КАК ИсхТабл
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары
	|		ПО ИсхТабл.ЗаказПокупателя = ЗаказПокупателяТовары.Ссылка
	|			И ИсхТабл.Номенклатура = ЗаказПокупателяТовары.Номенклатура
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказПокупателяТовары.Ссылка,
	|	ЗаказПокупателяТовары.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Ссылка,
	|	СУММА(ВТ.Сумма) КАК Сумма
	|ИЗ
	|	ВТ КАК ВТ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ.Ссылка";
	
	Запрос.УстановитьПараметр("ТЗ", ТЗ);

	Если ПолучитьТЗ Тогда
		Возврат Запрос.Выполнить().Выгрузить();
	КонецЕсли;                                                  
	
	Выб = Запрос.Выполнить().Выбрать();
	Сч = 0;  
	
	Пока Выб.Следующий() Цикл
		
		Рез = Рез + "&transactions[" + Строка(сч) + "][source_order_id]=" + Выб.Ссылка.УникальныйИдентификатор() + "&transactions[" + Строка(сч) 
		    + "][amount]=-" + ПреобразоватьЧисло(Выб.Сумма);
		сч = сч + 1; 
		
	КонецЦикла;  
	
	Возврат Рез;
	
КонецФункции

Процедура ДобавитьЗаписьВНеотправленныеДокументы(Документ, Проведение, Сообщение = "") Экспорт
	
	Рег = РегистрыСведений.НеотправленныеВБиллингДокументы.СоздатьНаборЗаписей();
	Рег.Отбор.Документ.Установить(Документ);
	Рег.Отбор.Проведение.Установить(Проведение);
	Рег.Прочитать();
	
	Если Рег.Количество() = 0 тогда
		
		Запись = Рег.Добавить();
		Запись.Документ = Документ;
		Запись.Проведение = Проведение;
		
	Иначе
		Запись = Рег[0];
	КонецЕсли;
	
	Запись.Сообщение = Сообщение;
	
	Запись.Дата = ТекущаяДата();
	Рег.Записать();
	
КонецПроцедуры

Функция СформироватьСтрокуЗаказов(Документ, ПолучитьТЗ = Ложь) Экспорт
	
	Рез = "";
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Заказ", Новый ОписаниеТипов("ДокументСсылка.ЗаказПокупателя"));
	ТЗ.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗ.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	
	Т1 = Документ.Заказано.Выгрузить(,"Заказ,Номенклатура,Количество");
	Т1.Свернуть("Заказ,Номенклатура","Количество");
	
	Для каждого стр из Т1 Цикл
		
		Строка = Тз.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Стр);
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТЗ.Заказ,
	               |	ТЗ.Номенклатура,
	               |	ТЗ.Количество
	               |ПОМЕСТИТЬ ИсхТабл
	               |ИЗ
	               |	&ТЗ КАК ТЗ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЗаказПокупателяТовары.Номенклатура,
	               |	ЗаказПокупателяТовары.Ссылка,
	               |	СУММА(ЗаказПокупателяТовары.Количество) КАК Количество,
	               |	СУММА(ЗаказПокупателяТовары.Сумма) КАК Сумма
	               |ПОМЕСТИТЬ ТаблТов
	               |ИЗ
	               |	ИсхТабл КАК ИсхТабл
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары
	               |		ПО ИсхТабл.Заказ = ЗаказПокупателяТовары.Ссылка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЗаказПокупателяТовары.Ссылка,
	               |	ЗаказПокупателяТовары.Номенклатура
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблТов.Ссылка,
	               |	ТаблТов.Номенклатура,
	               |	СУММА(ТаблТов.Количество) КАК Количество,
	               |	СУММА(ТаблТов.Сумма / ТаблТов.Количество * ИсхТабл.Количество) КАК Сумма
	               |ПОМЕСТИТЬ ВТ
	               |ИЗ
	               |	ИсхТабл КАК ИсхТабл
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ТаблТов КАК ТаблТов
	               |		ПО ИсхТабл.Номенклатура = ТаблТов.Номенклатура
	               |			И ИсхТабл.Заказ = ТаблТов.Ссылка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТаблТов.Номенклатура,
	               |	ТаблТов.Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ.Ссылка,
	               |	СУММА(ВТ.Сумма) КАК Сумма
	               |ИЗ
	               |	ВТ КАК ВТ
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ.Ссылка";
	
	Запрос.УстановитьПараметр("ТЗ", ТЗ);
		
	Если ПолучитьТЗ Тогда
		Возврат Запрос.Выполнить().Выгрузить();	
	КонецЕсли; 			
	
	Выб = Запрос.Выполнить().Выбрать();
	Сч = 0;
	
	Пока Выб.Следующий() Цикл

		Если ЗначениеЗаполнено(Выб.Ссылка) Тогда		
			
			Рез = Рез + 
			      "&orders[" + Строка(сч) + "][order_id]=" + Выб.Ссылка.УникальныйИдентификатор() +
			      "&orders[" + Строка(сч) + "][amount]=" + ПреобразоватьЧисло(Выб.Сумма)+
			      "&orders[" + Строка(сч) + "][order_id_name]=" + Выб.Ссылка.Номер + 
			      "&orders[" + Строка(сч) + "][order_id_date]=" + Формат(Выб.Ссылка.Дата, "ДФ=""гггг-ММ-дд'T'ЧЧ:мм:сс""");
			сч = сч + 1;	
			
		КонецЕсли; 	
	
	КонецЦикла;
	
	Возврат Рез; 
	
КонецФункции

Функция ПолучитьДолгПоДоговору(КодМДМДоговора,ПолучилиИзБиллинга = Истина) Экспорт
	
	ДолгПоДоговору = 0;
	
	МассивДоговоров = Новый  Массив;
	МассивДоговоров.Добавить(КодМДМДоговора);
	
	МассивЗапрашиваемыхПараметров = Новый Массив;
	МассивЗапрашиваемыхПараметров.Добавить("document_sum");
	
	СтруктураРезультатаДанныеКонтрагента = ПолучитьДанныеПоМассивуДоговоров_V2(МассивДоговоров,МассивЗапрашиваемыхПараметров); 
	
	Если СтруктураРезультатаДанныеКонтрагента.Результат = 0 Тогда                                                     		
		
		Если СтруктураРезультатаДанныеКонтрагента.Данные <> Неопределено И ТипЗнч(СтруктураРезультатаДанныеКонтрагента.Данные) = Тип("Массив") Тогда	
			
			ДанныеМассив = СтруктураРезультатаДанныеКонтрагента.Данные;                                                   			
			ТаблицаДанныхДолговБиллинг = ОбщегоНазначения.ПреобразоватьМассивВТаблицуЗначений(ДанныеМассив);
			
			Если НЕ ТаблицаДанныхДолговБиллинг.Количество() = 0 Тогда
				ДолгПоДоговору = ТаблицаДанныхДолговБиллинг.Итог("document_sum") * -1;
			КонецЕсли; 
			
		Иначе
			ПолучилиИзБиллинга = Ложь;		
		КонецЕсли;	
		
	Иначе
		ПолучилиИзБиллинга = Ложь;		
	КонецЕсли;             
	
	Возврат ДолгПоДоговору;

КонецФункции

Функция ПовторноВыгрузитьСборкиВБиллинг(НомерЗаказаКлиента, ИдентификаторЗаказа, ИдентификаторКонтрагента) Экспорт 
	
	ЗаказПокупателя = Документы.ЗаказПокупателя.ПолучитьСсылку(Новый УникальныйИдентификатор(ИдентификаторЗаказа));	
	
	Если ЗаказПокупателя.ПолучитьОбъект() = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли; 
	                                                    
	Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту("КодМДМ", ИдентификаторКонтрагента);
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТоварыВСборкеОбороты.Сборка
	|ПОМЕСТИТЬ ВТСборка
	|ИЗ
	|	РегистрНакопления.ТоварыВСборке КАК ТоварыВСборкеОбороты
	|ГДЕ
	|	ТоварыВСборкеОбороты.Регистратор ССЫЛКА Документ.СборкаЗаказовПокупателя
	|	И ТоварыВСборкеОбороты.ЗаказПокупателя = &ЗаказПокупателя
	|	И ТоварыВСборкеОбороты.Контрагент = &Контрагент
	|	И ТоварыВСборкеОбороты.Сборка.Договор.ВыгружаетсяВБиллинг = ИСТИНА
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыВСборкеОбороты.Сборка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыВСборкеОбороты.Регистратор КАК ДокументЗаписи,
	|	ВЫБОР
	|		КОГДА ТоварыВСборкеОбороты.Регистратор ССЫЛКА Документ.КорректировкаСборкиЗаказовПокупателя
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоКорректировка,
	|	ТоварыВСборкеОбороты.Сборка КАК Сборка,
	|	ТоварыВСборкеОбороты.Контрагент.КодМДМ КАК Контрагент,
	|	ТоварыВСборкеОбороты.Сборка.Договор.КодМДМ КАК Договор,
	|	ТоварыВСборкеОбороты.ЗаказПокупателя.Номер КАК Номер,
	|	ТоварыВСборкеОбороты.ЗаказПокупателя.Дата КАК Дата,
	|	ТоварыВСборкеОбороты.ЗаказПокупателя,
	|	СУММА(ТоварыВСборкеОбороты.СуммаСобрано) КАК Сумма
	|ИЗ
	|	РегистрНакопления.ТоварыВСборке КАК ТоварыВСборкеОбороты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСборка КАК ВТСборка
	|		ПО ТоварыВСборкеОбороты.Сборка = ВТСборка.Сборка
	|ГДЕ
	|	(ТоварыВСборкеОбороты.Регистратор ССЫЛКА Документ.СборкаЗаказовПокупателя
	|			ИЛИ ТоварыВСборкеОбороты.Регистратор ССЫЛКА Документ.КорректировкаСборкиЗаказовПокупателя)
	|	И ТоварыВСборкеОбороты.Контрагент = &Контрагент
	|	И ТоварыВСборкеОбороты.Сборка.Договор.ВыгружаетсяВБиллинг = ИСТИНА
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыВСборкеОбороты.Сборка,
	|	ТоварыВСборкеОбороты.Контрагент,
	|	ТоварыВСборкеОбороты.ЗаказПокупателя,
	|	ТоварыВСборкеОбороты.Контрагент.КодМДМ,
	|	ТоварыВСборкеОбороты.Сборка.Договор.КодМДМ,
	|	ТоварыВСборкеОбороты.ЗаказПокупателя.Номер,
	|	ТоварыВСборкеОбороты.ЗаказПокупателя.Дата,
	|	ТоварыВСборкеОбороты.Регистратор
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	ЭтоКорректировка
	|ИТОГИ ПО
	|	Сборка";
	
	Запрос.УстановитьПараметр("ЗаказПокупателя", ЗаказПокупателя);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
			
	РезультатЗапроса = Запрос.Выполнить();
	Попытка
		
		Если РезультатЗапроса.Пустой() Тогда
			Возврат Ложь;
		Иначе
			
			ВыборкаСборка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Сборка");								       
			
			Пока ВыборкаСборка.Следующий() Цикл
				
				ПроверкаДокументаВБиллинге(ВыборкаСборка.Сборка, Истина);
				ПодтверждениеДокументаВБиллинге(ВыборкаСборка.Сборка);
				
				Выборка = ВыборкаСборка.Выбрать();
				
				Пока Выборка.Следующий() Цикл										
					
					Если Выборка.ЭтоКорректировка  Тогда
						ОтправитьДокументКорректировкиВБиллинг(Выборка.ДокументЗаписи);	
					КонецЕсли; 										
					
				КонецЦикла; 
				
			КонецЦикла;
			
		КонецЕсли;
		
		Возврат Истина;
		
	Исключение 
		Возврат Ложь;
	КонецПопытки; 

КонецФункции


///////////////////Вспомогательные процедуры///////////////////
Функция ДатуВTimestamp(Знач пДата = Неопределено) Экспорт
	
	Если ТипЗнч(пДата) = Тип("Дата") Тогда
		пДата = УниверсальноеВремя(пДата);	
	КонецЕсли;
	
	Возврат Формат(Число(?(ТипЗнч(пДата) = Тип("Дата"), пДата, УниверсальноеВремя(ТекущаяДата())) - Дата("19700101")), "ЧН=0; ЧГ=0");
	
КонецФункции

Процедура ОповеститьСерверМониторинга(Успешно, ЗаписыватьВЖурналОшибку = Истина, ИсходящееСообщение = Неопределено, ТекстОшибки = "", НомерСообщения = "") Экспорт 
	
КонецПроцедуры

Функция ПолучитьКодПрикладнойСистемы()
	
	Выборка = Справочники.ПодпискиНаОчередиСообщений.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Лев(Выборка.ИмяОчереди, Найти(Выборка.ИмяОчереди, ".") - 1);
	Иначе
		Возврат "Test";
	КонецЕсли;
	
КонецФункции

Функция ЭтоСсылка(Значение)
	
	Если ТипЗнч(Значение) = Тип("Число") ИЛИ ТипЗнч(Значение) = Тип("Строка") ИЛИ ТипЗнч(Значение) = Тип("Дата") ИЛИ ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

Процедура ЗаписатьРеквизитДокументаВСтруктуру(Структура, Документ, ИмяРеквизита, ИмяРеквизитаДоп = "", Представление = "") 	
		
	Если ОбщегоНазначения.ЕстьРеквизитДокумента(ИмяРеквизита, Документ.Метаданные()) Тогда
		
		Значение = Документ[ИмяРеквизита];
		ЭтоСсылка = ЭтоСсылка(Значение);			
		
		Если Не ЭтоСсылка Тогда
			Структура.Вставить(?(ЗначениеЗаполнено(ИмяРеквизитаДоп), ИмяРеквизитаДоп, ИмяРеквизита), Значение);	
		Иначе 
			
			Если ЗначениеЗаполнено(ИмяРеквизитаДоп) Тогда 
				
				ЗначениеДоп = Значение[ИмяРеквизитаДоп];  					   					
				Структура.Вставить(?(ЗначениеЗаполнено(Представление), Представление, ИмяРеквизитаДоп), ЗначениеДоп);
				
			КонецЕсли; 
			
		КонецЕсли;   
		
	КонецЕсли;	
	
КонецПроцедуры

Функция ПрисвоитьШтрихКод(Владелец) Экспорт
	
	ТекЗапись = РегистрыСведений.Штрихкоды.СоздатьМенеджерЗаписи();
	ТекЗапись.Владелец = Владелец;
	ТекЗапись.ТипШтрихкода = ПланыВидовХарактеристик.ТипыШтрихкодов.EAN13;
	ШК = РаботаСТорговымОборудованием.СформироватьШтрихКод();
	ТекЗапись.Штрихкод = ?(ШК = Неопределено, "", ШК); 
	
	Попытка
		
		ТекЗапись.Записать();
		Возврат Истина; 
		
	Исключение
		Возврат Ложь;
	КонецПопытки;    	
	
КонецФУнкции

Процедура ПаузаИсполнения(Секунд) Экспорт	
	
	Перем ИмяВременногоФайла;
	
	//имя файла, куда сохраним скрипт
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("vbs");
	
	Попытка
		
		Скрипт = Новый ТекстовыйДокумент;
		Скрипт.УстановитьТекст("WScript.sleep " + XMLСтрока(Цел(Секунд * 1000)));
		Скрипт.Вывод = ИспользованиеВывода.Разрешить;
		Скрипт.Записать(ИмяВременногоФайла, КодировкаТекста.Системная);
		
		WshShell = Новый COMОбъект("WScript.Shell");
		WshShell.Run("wscript.exe """ + ИмяВременногоФайла + """", 0, -1);
		
		УдалитьФайлы(ИмяВременногоФайла);
		
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры //ПаузаИсполнения()

Функция ПреобразоватьЧисло(Знач Число) Экспорт
	
	Число = Окр(Число, 2);
	Строка = Строка(Число);
	Строка = СтрЗаменить(Строка, ",", ".");
	Строка = СтрЗаменить(Строка, " ", "");
	Возврат Строка; 
	
КонецФункции 

Функция ПреобразоватьДатуБиллинг(СтроковаяДата)	
	
	СтроковаяДата = СтрЗаменить(СтроковаяДата, "-", ""); 
	СтроковаяДата = СтрЗаменить(СтроковаяДата, ":", "");
	СтроковаяДата = СтрЗаменить(СтроковаяДата, "T", "");
	СтроковаяДата = СтрЗаменить(СтроковаяДата, "Z", "");
	СтроковаяДата = СтрЗаменить(СтроковаяДата, "+", "");
	
	Возврат Дата(Лев(СтроковаяДата, 14)); 
	
КонецФункции

