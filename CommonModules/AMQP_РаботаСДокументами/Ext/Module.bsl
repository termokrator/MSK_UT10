	               |	СписаниеТоваров.Номенклатура КАК Номенклатура,
	               |	СписаниеТоваров.Номенклатура.КодМДМ КАК КодНоменклатурыМДМ,
	               |	СписаниеТоваров.Количество,
	               |	СписаниеТоваров.Сумма,
	               |	СписаниеТоваров.Цена,
	               |	СписаниеТоваров.СерияНоменклатуры.НомерГТД.Представление КАК НомерГТД,
	               |	СписаниеТоваров.СерияНоменклатуры.СтранаПроисхождения.КодМДМ КАК КодМДМСтранаПроисхождения
	               |ИЗ
	               |	Документ.СписаниеТоваров.Товары КАК СписаниеТоваров
	               |ГДЕ
	               |	СписаниеТоваров.Ссылка = &Ссылка";   
				   
	Запрос.УстановитьПараметр("Ссылка", Документ.Ссылка);      
	
	Выб = Запрос.Выполнить().Выбрать(); 
	
	Пока Выб.Следующий() Цикл 
		
		ТоварыСтруктура = Новый Структура;  
		ТоварыСтруктура.Вставить("НомерСтроки", Выб.НомерСтроки);  
		ТоварыСтруктура.Вставить("КодНоменклатурыМДМ", Выб.КодНоменклатурыМДМ);
		ТоварыСтруктура.Вставить("Количество", Выб.Количество);
		ТоварыСтруктура.Вставить("Цена", Выб.Цена);
		ТоварыСтруктура.Вставить("НомерГТД", СокрЛП(Выб.НомерГТД));   
		ТоварыСтруктура.Вставить("КодМДМСтранаПроисхождения", СОКРЛП(Выб.КодМДМСтранаПроисхождения));
		
		Товары.Добавить(ТоварыСтруктура); 
		
	КонецЦикла;                
	
	СтруктураДокумента.Вставить("Товары", Товары);
	
