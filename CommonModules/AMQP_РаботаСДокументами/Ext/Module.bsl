Функция ОтправитьЗапросВБиллинг(СтрокаЗапроса, ПредставлениеЗапроса, ТипЗапроса = "POST", ЗаписыватьВЖурнал = Истина, 
	           Данные = Неопределено, ВыводитьСообщение = Истина, Тело = "") Экспорт
	
	ЗаписьЖурналаРегистрации("Биллинг_АПИ", УровеньЖурналаРегистрации.Информация,,, "Биллинг_АПИ:Запуск. " + СокрЛП(ПредставлениеЗапроса) + "");
	
	СтруктураРезультата = Новый Структура;	
	СтруктураРезультата.Вставить("Данные", Неопределено);
	СтруктураРезультата.Вставить("Результат", 2); //2 - ошибка связи с биллингом, 1 - ошибка на строне биллинга, 0 - успешно
	СтруктураРезультата.Вставить("Сообщение", "");
	
	АдресСервера = Константы.AMQP_АдресСервераБиллинга.Получить();
	
	HTTPСоединение = Новый HTTPСоединение(АдресСервера, , , , , Константы.AMQP_ТаймаутЗапросовВБиллинг.Получить(), Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Неопределено));
	HTTPЗапрос = Новый HTTPЗапрос(СтрокаЗапроса); 	
	HTTPЗапрос.Заголовки.Вставить("Cookie", "token=" + Константы.AMQP_ТокенБиллинга.Получить());
	HTTPЗапрос.Заголовки.Вставить("Cache-Control", "no-cache");  
	
	Если Тело <> "" Тогда 
		
		HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json"); 
		HTTPЗапрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		
	КонецЕсли;
	
	ОтветJSONСтрока = "";                                                                                                         
	ЗаписьЖурналаРегистрации("Биллинг_АПИ", УровеньЖурналаРегистрации.Информация,,, "Биллинг_АПИ:Выполнение. " + СокрЛП(ПредставлениеЗапроса) + " Текст запроса: " + СтрокаЗапроса);
	
	Попытка
				
		Если ТипЗапроса = "POST" Тогда
			Ответ = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
		Иначе
			Ответ = HTTPСоединение.Получить(HTTPЗапрос);
		КонецЕсли;
		
		ОтветJSONСтрока = Ответ.ПолучитьТелоКакСтроку();
		
		Если ЗначениеЗаполнено(СокрЛП(ОтветJSONСтрока)) Тогда
			
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(ОтветJSONСтрока);
			СтруктураВозврата = ПрочитатьJSON(ЧтениеJSON);	
			
			Если СтруктураВозврата.status = "OK" Тогда
				
				СтруктураРезультата.Результат = 0;
				
				Если СтруктураВозврата.Свойство("data") Тогда
					СтруктураРезультата.Данные = СтруктураВозврата.data;	
				КонецЕсли;
				
			ИначеЕсли СтруктураВозврата.status = "ERROR" Тогда
				СтруктураРезультата.Результат = 1;
			КонецЕсли;

			Если СтруктураВозврата.Свойство("message") Тогда
				СтруктураРезультата.Сообщение = СтруктураВозврата.message;		
			КонецЕсли;
						
		КонецЕсли;
		
	Исключение
		СтруктураРезультата.Сообщение = "Ошибка связи с биллингом: " + ОписаниеОшибки();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(СтруктураРезультата.Сообщение) И СтруктураРезультата.Результат = 2 Тогда
		СтруктураРезультата.Сообщение = "Ошибка связи с биллингом";	
	КонецЕсли;
	
	Если СтруктураРезультата.Результат <> 0 И ЗаписыватьВЖурнал Тогда
		ЗаписьЖурналаРегистрации("Биллинг_АПИ", УровеньЖурналаРегистрации.Информация,,, "Биллинг_АПИ:Ошибка. " + СокрЛП(ПредставлениеЗапроса) +
		"Ошибка выполнения запроса: " + ПредставлениеЗапроса + Символы.ПС + "Текст ошибки: " + СтруктураРезультата.Сообщение + ""); 		
	КонецЕсли;
	
	Если ВыводитьСообщение И СтруктураРезультата.Результат = 2 Тогда
		#Если Клиент Тогда
			Сообщить(СтруктураРезультата.Сообщение);
		#КонецЕсли
	КонецЕсли; 
	
	ЗаписьЖурналаРегистрации("Биллинг_АПИ", УровеньЖурналаРегистрации.Информация,,, "Биллинг_АПИ:Завершение. " + СокрЛП(ПредставлениеЗапроса) 
	               + " Текст ответа: " + СокрЛП(ОтветJSONСтрока));

	Возврат СтруктураРезультата; 
	
КонецФункции

Функция ПроверкаДокументаВБиллинге(Документ, Принудительно = Ложь) Экспорт
	
	КолвоПопыток = 2;
	ЗадержкаПоВремени = 2;
	
	Тело = "";
	
	Если Константы.ИспользоватьМетодV2ПроверкиСборок.Получить() Тогда
		
		СтрокаЗапроса = "/api/v2/client/assemble";
		
		ТелоСтруктура = Новый Структура; 
		ТелоСтруктура.Вставить("skip_shipment_control", ?(Принудительно, Истина, Ложь));
		ТелоСтруктура.Вставить("kontragent_mdm_id", Документ.Контрагент.КодМДМ);
		ТелоСтруктура.Вставить("agreement_mdm_id", Документ.Договор.КодМДМ);
		ТелоСтруктура.Вставить("request_id", ?(ТипЗнч(Документ) = Тип("ДокументОбъект.СборкаЗаказовПокупателя"), 
		                       Строка(Документ.ПолучитьСсылкуНового().УникальныйИдентификатор()), Строка(Документ.УникальныйИдентификатор())));
		ТелоСтруктура.Вставить("request_id_name", Документ.Номер);
		ТелоСтруктура.Вставить("request_id_date", Формат(Документ.Дата, "ДФ=""гггг-ММ-дд'T'ЧЧ:мм:сс"""));
		ТелоСтруктура.Вставить("app_id", Строка(Константы.AMQP_ИдентификаторИнформацСистемы.Получить()));
		
		МассивСтруктураЗаказов = Новый Массив;  
		
		ТЗ = СформироватьСтрокуЗаказов(Документ, Истина); 
		
		Для каждого СтрокаЗаказа Из ТЗ Цикл
			
			Если Не ЗначениеЗаполнено(СтрокаЗаказа.Ссылка) Тогда
				Продолжить;
			КонецЕсли;
			
			СтруктураЗаказа = Новый Структура;
			СтруктураЗаказа.Вставить("id", Строка(СтрокаЗаказа.Ссылка.УникальныйИдентификатор()));
			СтруктураЗаказа.Вставить("amount", СтрокаЗаказа.Сумма); 
			СтруктураЗаказа.Вставить("name", СтрокаЗаказа.Ссылка.Номер); 
			СтруктураЗаказа.Вставить("date", Формат(СтрокаЗаказа.Ссылка.Дата, "ДФ=""гггг-ММ-дд'T'ЧЧ:мм:сс""")); 
			
			МассивСтруктураЗаказов.Добавить(СтруктураЗаказа);

		КонецЦикла;
		
		ТелоСтруктура.Вставить("orders", МассивСтруктураЗаказов);
		
		Тело = ОбщегоНазначения.ВернутьJSON(ТелоСтруктура);	
		
	Иначе
		
		СтрокаЗапроса = "/api/v1/client/assemble?kontragent_mdm_id=" + Документ.Контрагент.КодМДМ + 
					"&agreement_mdm_id=" + Документ.Договор.КодМДМ + 
					"&app_id=" + Строка(Константы.AMQP_ИдентификаторИнформацСистемы.Получить()) + 
					"&request_id=" + ?(ТипЗнч(Документ) = Тип("ДокументОбъект.СборкаЗаказовПокупателя"), 
						Строка(Документ.получитьСсылкуНового().УникальныйИдентификатор()),
						Строка(Документ.УникальныйИдентификатор())) + 
					"&request_id_name=" + Документ.Номер + 
					"&request_id_date=" + Формат(Документ.Дата, "ДФ=""гггг-ММ-дд'T'ЧЧ:мм:сс""") +
					?(Принудительно, "&skip_shipment_control=Y", "") + 
					СформироватьСтрокуЗаказов(Документ);

	КонецЕсли;	
						
	ПредставлениеЗапроса = "Проверка документа в Биллинге";
			
	Для Сч = 1 По КолвоПопыток Цикл		
		
		СтруктураРезультата = ОтправитьЗапросВБиллинг(СтрокаЗапроса, ПредставлениеЗапроса,,, Документ.Ссылка,, Тело);
		
		Если СтруктураРезультата.Результат < 2 Тогда
			Прервать;
		КонецЕсли;  
		
		Если СтруктураРезультата.Результат = 2 И Сч <> КолвоПопыток Тогда
			ПаузаИсполнения(ЗадержкаПоВремени);	
		КонецЕсли;
		
	КонецЦикла; 		
	
	Если СтруктураРезультата.Данные <> Неопределено И ТипЗнч(СтруктураРезультата.Данные) = Тип("Массив") Тогда
		
		Для каждого Строка из СтруктураРезультата.Данные Цикл

			Если Не Строка.status Тогда	

				СтруктураРезультата.Результат = 1;
				СтруктураРезультата.Сообщение = "По клиенту " + Документ.Контрагент + " сборка не создана. По данным Биллинга у клиента имеется задолженность";
				Прервать; 
				
			КонецЕсли;
			
		КонецЦикла; 
		
	КонецЕсли; 

	
	Если СтруктураРезультата.Результат = 2 Тогда
		
		Попытка
			
			ДокументОбъект = Документ.ПолучитьОбъект();
			ДокументОбъект.ДополнительныеСвойства.Вставить("api_v1_client_assemble", Истина);
			ДокументОбъект.ДополнительныеСвойства.Вставить("Принудительно", Принудительно);
			
			ДополнЗаголовки = Новый СписокЗначений;
			ДополнЗаголовки.Добавить("DirectSaveDocument", "true");
			СоздатьИсходящееСообщение(ДокументОбъект, Ложь, Ложь, Неопределено, ДополнЗаголовки); 
			
		Исключение
			ЗаписьЖурналаРегистрации("СозданиеСообщений.Ошибка", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Не записано исходящее сообщение для документа: " + Строка(ДокументОбъект) + Символы.ПС + ОписаниеОшибки());			
		КонецПопытки;
		
		ДобавитьЗаписьВНеотправленныеДокументы(Документ.Ссылка, Ложь, СтруктураРезультата.Сообщение); 
		
	КонецЕсли;

	Возврат СтруктураРезультата;                                           
	
КонецФункции
                                    
Функция ПодтверждениеДокументаВБиллинге(Документ) Экспорт
	
	КолвоПопыток = 2;
	ЗадержкаПоВремени = 2;
	
	СтрокаЗапроса = "/api/v1/client/confirm-request?request_id=" + Документ.Ссылка.УникальныйИдентификатор() + "&app_id=" 
	              + Строка(Константы.AMQP_ИдентификаторИнформацСистемы.Получить()) + "&request_id_name=" + Документ.Номер;
	ПредставлениеЗапроса = "Подтверждение документа в Биллинге";     
	
	Для Сч = 1 По КолвоПопыток Цикл		
		
		СтруктураРезультата = ОтправитьЗапросВБиллинг(СтрокаЗапроса, ПредставлениеЗапроса,,, Документ.Ссылка);  
		
		Если СтруктураРезультата.Результат < 2 Тогда
			Прервать;
		КонецЕсли;  
		
		Если СтруктураРезультата.Результат = 2 И Сч <> КолвоПопыток Тогда
			ПаузаИсполнения(ЗадержкаПоВремени);	
		КонецЕсли; 
		
	КонецЦикла; 		

	
	Если СтруктураРезультата.Данные <> Неопределено И ТипЗнч(СтруктураРезультата.Данные) = Тип("Массив") Тогда
		
		Для каждого Строка из СтруктураРезультата.Данные Цикл
			
			Если Не Строка.confirmed тогда				
				
				СтруктураРезультата.Результат = 1;
				СтруктураРезультата.Сообщение = "По клиенту " + Документ.Контрагент + " сборка не подтверждена. По данным Биллинга у клиента имеется задолженность";
				Прервать; 
				
			КонецЕсли; 
			
		КонецЦикла; 
		
	КонецЕсли;

	Если СтруктураРезультата.Результат = 2 Тогда
		ДобавитьЗаписьВНеотправленныеДокументы(Документ.Ссылка, Истина, СтруктураРезультата.Сообщение);
	КонецЕсли;       
	
	Возврат СтруктураРезультата; 
	
КонецФункции

