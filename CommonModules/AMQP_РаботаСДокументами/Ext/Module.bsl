///////////////////Процедуры записи документов///////////////////
Процедура ЗаписатьПредопределенныеРеквизитыДокумента(Документ, СтруктураДокумента, ОтменаПроведения)
	
	СтруктураДокумента.Вставить("НомерДокумента", СокрЛП(Документ.Номер));
	СтруктураДокумента.Вставить("ДатаДокумента", Документ.Дата);
	СтруктураДокумента.Вставить("УникальныйИдентификатор", Строка(Документ.УникальныйИдентификатор()));
	СтруктураДокумента.Вставить("Статус", ?(Документ.Проведен, ?(ОтменаПроведения, 0, 1), 0)); 
	СтруктураДокумента.Вставить("Комментарий", ?(ОбщегоНазначения.ЕстьРеквизитДокумента("Комментарий", Документ.Метаданные()), Документ.Комментарий, ""));
	
КонецПроцедуры

Процедура ЗаписатьОсновныеРеквизитыДокумента(Документ, СтруктураДокумента) 
	
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "Организация", "КодМДМГоловнойОрганизации", "КодОрганизацииМДМ");  
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "СуммаДокумента","Сумма");     	
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "Контрагент", "КодМДМ", "КодКонтрагентаМДМ");
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "Договор", "КодМДМ", "КодДоговораМДМ");
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "ДоговорКонтрагента", "КодМДМ", "КодДоговораМДМ");
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "Грузополучатель", "КодМДМ", "КодФилиалаМДМ");
	ЗаписатьРеквизитДокументаВСтруктуру(СтруктураДокумента, Документ, "ШтампВерсии");
	
КонецПроцедуры

Процедура ЗаписатьСборкаЗаказовПокупателя(Документ, СтруктураДокумента, ПеречитатьРегистры)
	
	СтруктураДокумента.Вставить("ДокументСобран", ?(Документ.ДокументСобранИУпакован, 1, 0));
	
	Валюта = Константы.ВалютаУправленческогоУчета.Получить();
	СтруктураДокумента.Вставить("Валюта", Валюта.КодМДМ);
		
	Если Документ.Движения.Найти("ТоварыВСборке") <> Неопределено Тогда
		
		Если ПеречитатьРегистры Тогда
			Документ.Движения.ТоварыВСборке.Прочитать();
		КонецЕсли;
		
		СтруктураДокумента.Вставить("Сумма", Документ.Движения.ТоварыВСборке.Итог("СуммаКСборке") + Документ.Движения.ТоварыВСборке.Итог("СуммаСобрано"));
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаписатьСборкаЗаказовПокупателяДляБиллинга(ДокументОбъект, СтруктураДокумента, ПеречитатьРегистры) Экспорт 
	
	Если ПеречитатьРегистры Тогда
		ДокументОбъект.Движения.ТоварыВСборке.Прочитать();
	КонецЕсли;
	
	СтруктураДокумента.Вставить("agreement_mdm_id", Строка(ДокументОбъект.Договор.КодМДМ));
	СтруктураДокумента.Вставить("app_id", Строка(Константы.AMQP_ИдентификаторИнформацСистемы.Получить()));
	СтруктураДокумента.Вставить("request_id", Строка(ДокументОбъект.Ссылка.УникальныйИдентификатор()));	
	СтруктураДокумента.Вставить("request_id_name", ДокументОбъект.Номер);
	СтруктураДокумента.Вставить("request_id_date", Формат(ДокументОбъект.Дата, "ДФ=""гггг-ММ-дд'T'ЧЧ:мм:сс"""));
	
	Если ДокументОбъект.ДополнительныеСвойства.Свойство("Принудительно") Тогда
		СтруктураДокумента.Вставить("skip_shipment_control", "Y");	
	КонецЕсли; 
		
	ТЗ = СформироватьСтрокуЗаказов(ДокументОбъект, Истина);
	
	МассивТранзакций = Новый Массив;
	
	Для каждого Стр Из ТЗ Цикл
		
		СтруктураДанных = Новый Структура;

		Если ЗначениеЗаполнено(Стр.Ссылка) Тогда
			
			СтруктураДанных.Вставить("order_id", Строка(Стр.Ссылка.УникальныйИдентификатор()));
			СтруктураДанных.Вставить("amount", ПреобразоватьЧисло(Стр.Сумма));
			СтруктураДанных.Вставить("order_id_name", Стр.Ссылка.Номер);
			СтруктураДанных.Вставить("order_id_date", Формат(Стр.Ссылка.Дата, "ДФ=""гггг-ММ-дд'T'ЧЧ:мм:сс"""));			
			МассивТранзакций.Добавить(СтруктураДанных);
			
		КонецЕсли; 
		
	КонецЦикла; 	
		
	СтруктураДокумента.Вставить("orders", МассивТранзакций);

КонецПроцедуры

Процедура ЗаписатьРеализацияТоваровУслуг(Документ, СтруктураДокумента, ПеречитатьРегистры)
		
	Валюта = Документ.ВалютаДокумента;
	СтруктураДокумента.Вставить("Валюта", Валюта.КодМДМ);
	
	КодСоглашенияАварда = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДоговорыАварды.КодАварда
	               |ИЗ
	               |	РегистрСведений.ДоговорыАварды КАК ДоговорыАварды
	               |ГДЕ
	               |	ДоговорыАварды.ДоговорКонтрагента = &ДоговорКонтрагента";
	
	Запрос.УстановитьПараметр("ДоговорКонтрагента", Документ.ДоговорКонтрагента);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		КодСоглашенияАварда = КодСоглашенияАварда + ?(ЗначениеЗаполнено(КодСоглашенияАварда), ",", "") + СтрЗаменить(Строка(Выборка.КодАварда), " ", "");
	КонецЦикла;
	
	СтруктураДокумента.Вставить("КодСоглашенияАварда", КодСоглашенияАварда);
	
	Если Документ.Товары.Количество() > 0 И ЗначениеЗаполнено(Документ.Товары[0].ЗаказПокупателя) Тогда
		СтруктураДокумента.Вставить("КлючСтрокиУсловий", Документ.Товары[0].ЗаказПокупателя.КлючСтрокиУсловий);
	Иначе
		СтруктураДокумента.Вставить("КлючСтрокиУсловий", 0);
	КонецЕсли;
	
	Если Документ.Движения.Найти("Продажи") <> Неопределено Тогда
		
		ПродажиМассив = Новый Массив;
		
		Если ПеречитатьРегистры Тогда
			Документ.Движения.Продажи.Прочитать();
		КонецЕсли;
		
		ТаблицаПродаж = Документ.Движения.Продажи.Выгрузить();
		ТаблицаПродаж.Свернуть("ЗаказПокупателя", "Стоимость");
		
		Для каждого Продажа Из ТаблицаПродаж Цикл
			
			Если Не ЗначениеЗаполнено(Продажа.ЗаказПокупателя) Тогда
				Продолжить;
			КонецЕсли;
			
			ПродажиСтруктура = Новый Структура;
			ПродажиСтруктура.Вставить("УникальныйИдентификатор", Строка(Продажа.ЗаказПокупателя.УникальныйИдентификатор()));
			ПродажиСтруктура.Вставить("Номер", СокрЛП(Продажа.ЗаказПокупателя.Номер));
			ПродажиСтруктура.Вставить("Дата", Продажа.ЗаказПокупателя.Дата);
			ПродажиСтруктура.Вставить("Сумма", Продажа.Стоимость);    
			
			ПродажиМассив.Добавить(ПродажиСтруктура);   		
			
		КонецЦикла;
		
		СтруктураДокумента.Вставить("Заказы", ПродажиМассив);
		
	КонецЕсли;

	СтруктураДокумента.Вставить("Водитель", Строка(Документ.Водитель));
	
	Товары = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РеализацияТоваровУслугТовары.Номенклатура.КодМДМ КАК Номенклатура,
	               |	РеализацияТоваровУслугТовары.Количество,
	               |	РеализацияТоваровУслугТовары.СтавкаНДС,
	               |	РеализацияТоваровУслугТовары.Сумма,
	               |	РеализацияТоваровУслугТовары.СуммаНДС,
	               |	РеализацияТоваровУслугТовары.Цена,
	               |	РеализацияТоваровУслугТовары.СерияНоменклатуры.НомерГТД.Представление КАК НомерГТД,
	               |	РеализацияТоваровУслугТовары.ЗаказПокупателя
	               |ИЗ
	               |	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	               |ГДЕ
	               |	РеализацияТоваровУслугТовары.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка",Документ.Ссылка);
	
	Выб = Запрос.Выполнить().Выбрать();
	
	Пока Выб.Следующий() Цикл
		
		ТоварыСтруктура = Новый Структура;
		ТоварыСтруктура.Вставить("Номенклатура", Выб.Номенклатура);
		ТоварыСтруктура.Вставить("Заказ", Строка(Выб.ЗаказПокупателя.УникальныйИдентификатор()));
		ТоварыСтруктура.Вставить("Количество", Выб.Количество);
		ТоварыСтруктура.Вставить("СтавкаНДС", Строка(Выб.СтавкаНДС));
		ТоварыСтруктура.Вставить("Сумма", Выб.Сумма);
		ТоварыСтруктура.Вставить("СуммаНДС", Выб.СуммаНДС);
		ТоварыСтруктура.Вставить("Цена", Выб.Цена);
		ТоварыСтруктура.Вставить("НомерГТД", СокрЛП(Выб.НомерГТД)); 
		
		Товары.Добавить(ТоварыСтруктура);   		

	КонецЦикла;  
	
	СтруктураДокумента.Вставить("Товары", Товары);
	
КонецПроцедуры

Процедура ЗаписатьКорректировкаРеализации(Документ, СтруктураДокумента, ПеречитатьРегистры)
	
	СтруктураДокумента.Вставить("Валюта", Документ.ВалютаДокумента.КодМДМ);
	
	ДокументРеализации = Документ.ДокументРеализации;  
	
	Пока ЗначениеЗаполнено(ДокументРеализации) И ТипЗнч(ДокументРеализации) = Тип("ДокументСсылка.КорректировкаРеализации") Цикл
		ДокументРеализации = ДокументРеализации.ДокументРеализации;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ДокументРеализации) И ТипЗнч(ДокументРеализации) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		СтруктураДокумента.Вставить("ДокументРеализации", Строка(ДокументРеализации.УникальныйИдентификатор()));
	КонецЕсли;

	Если Документ.Движения.Найти("Продажи") <> Неопределено Тогда
		
		Если ПеречитатьРегистры Тогда
			Документ.Движения.Продажи.Прочитать();
		КонецЕсли;
	
		ТаблицаПродаж = Документ.Движения.Продажи.Выгрузить();
		СуммаКорректировки = ТаблицаПродаж.Итог("Стоимость");
		СтруктураДокумента.Вставить("Сумма", СуммаКорректировки);

	КонецЕсли;

	Если ЗначениеЗаполнено(ДокументРеализации) И ТипЗнч(ДокументРеализации) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		
		СтруктураДокумента.Вставить("НомерДокументаРеализации", ДокументРеализации.Номер);
		СтруктураДокумента.Вставить("ДатаДокументаРеализации", ДокументРеализации.Дата); 
		
	КонецЕсли;  
	
	СтруктураДокумента.Вставить("СуммаВключаетНДС", ?(Документ.СуммаВключаетНДС, 1, 0));
	СтруктураДокумента.Вставить("ВидОперации", Строка(Документ.ВидОперации)); 
	
	Товары = Новый Массив;
	
	Запрос = Новый Запрос; 
	Запрос.Текст = "ВЫБРАТЬ
	               |	КорректировкаРеализацииТовары.Номенклатура.КодМДМ КАК Номенклатура,
	               |	КорректировкаРеализацииТовары.Количество,
	               |	КорректировкаРеализацииТовары.СтавкаНДС,
	               |	КорректировкаРеализацииТовары.Сумма,
	               |	КорректировкаРеализацииТовары.СуммаНДС,
	               |	КорректировкаРеализацииТовары.Цена,
	               |	КорректировкаРеализацииТовары.СерияНоменклатуры.НомерГТД.Представление КАК НомерГТД,
	               |	КорректировкаРеализацииТовары.ЗаказПокупателя,
	               |	КорректировкаРеализацииТовары.КоличествоДоИзменения,
	               |	КорректировкаРеализацииТовары.ЦенаДоИзменения,
	               |	КорректировкаРеализацииТовары.СуммаДоИзменения,
	               |	КорректировкаРеализацииТовары.СуммаНДСДоИзменения,
	               |	КорректировкаРеализацииТовары.СтавкаНДСДоИзменения
	               |ИЗ
	               |	Документ.КорректировкаРеализации.Товары КАК КорректировкаРеализацииТовары
	               |ГДЕ
	               |	КорректировкаРеализацииТовары.Ссылка = &Ссылка"; 
	
	Запрос.УстановитьПараметр("Ссылка", Документ.Ссылка); 
	
	Выб = Запрос.Выполнить().Выбрать(); 
	
	Пока Выб.Следующий() Цикл 
		
		ТоварыСтруктура = Новый Структура;
		ТоварыСтруктура.Вставить("Номенклатура", Выб.Номенклатура);
		ТоварыСтруктура.Вставить("Заказ", Строка(Выб.ЗаказПокупателя.УникальныйИдентификатор()));
		ТоварыСтруктура.Вставить("Количество", Выб.Количество);
		ТоварыСтруктура.Вставить("СтавкаНДС", Строка(Выб.СтавкаНДС));
		ТоварыСтруктура.Вставить("Сумма", Выб.Сумма);
		ТоварыСтруктура.Вставить("СуммаНДС", Выб.СуммаНДС);
		ТоварыСтруктура.Вставить("Цена", Выб.Цена);
		ТоварыСтруктура.Вставить("КоличествоДоИзменения",Выб.КоличествоДоИзменения);
		ТоварыСтруктура.Вставить("СтавкаНДСДоИзменения", Строка(Выб.СтавкаНДСДоИзменения));
		ТоварыСтруктура.Вставить("СуммаДоИзменения"  , Выб.СуммаДоИзменения);
		ТоварыСтруктура.Вставить("СуммаНДСДоИзменения", Выб.СуммаНДСДоИзменения);
		ТоварыСтруктура.Вставить("ЦенаДоИзменения", Выб.ЦенаДоИзменения);
		ТоварыСтруктура.Вставить("НомерГТД", СокрЛП(Выб.НомерГТД));
		Товары.Добавить(ТоварыСтруктура);   		

	КонецЦикла;
	
	СтруктураДокумента.Вставить("Товары", Товары);

КонецПроцедуры

