				НоваяСтрока = ЗаблокированныеЗаказы.Добавить();
				НоваяСтрока.Контрагент = Контрагент;
				НоваяСтрока.ДоговорКонтрагента = ДоговорКонтрагента;
				
				ИмяБазыБиллинг = Долг.AppID;
				
				ТипДокумента = "ЗаказПокупателя";
				ТипДокументаПредставление = Метаданные.Документы.ЗаказПокупателя.Синоним;
				
				Если НРег(ИмяБазыБиллинг) = НРег(Строка(ИмяБазы)) ИЛИ НРег(ИмяБазыБиллинг) = НРег(Строка(Константы.База.Получить())) Тогда
					
					Если ТипДокумента <> "" Тогда       					
						
						НоваяСтрока.Документ = Документы[ТипДокумента].ПолучитьСсылку(Новый УникальныйИдентификатор(Долг.SourceOrderID));
						
						ОбъектДокумент = НоваяСтрока.Документ.ПолучитьОбъект();
						
						Если ОбъектДокумент = Неопределено Тогда
							НоваяСтрока.Документ = ТипДокументаПредставление + " " + Долг.OrderIdName + " от " + Формат(Дата, "ДЛФ=DT") + " - документ не найден";	
						Иначе
							
							Если ТипДокумента = "РеализацияТоваровУслуг" Тогда 
								НоваяСтрока.Грузополучатель = НоваяСтрока.Документ.Грузополучатель;
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЕсли; 
					
				Иначе
					НоваяСтрока.Документ = ТипДокументаПредставление + " " + Долг.OrderIdName + " от " + Формат(Дата, "ДЛФ=DT") + " - " + ИмяБазыБиллинг;
				КонецЕсли;	
				
				НоваяСтрока.ДатаДокумента = Дата;									
				НоваяСтрока.Сумма = Число(Долг.AmountHoldSubRealization);
				
			Исключение
				
				БылиОшибки = Истина;
				ТекстОшибок = ТекстОшибок + Символы.ПС + ОписаниеОшибки();
				
			КонецПопытки;
			
		КонецЦикла;
		
		Если БылиОшибки И ЗаписыватьВЖурнал Тогда
			
			ЗаписьЖурналаРегистрации("РаботаСБиллингом.Ошибка", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Ошибка выполнения запроса: " + ПредставлениеЗапроса + Символы.ПС + "Текст ошибки: " + ТекстОшибок + Символы.ПС + "Текст запроса: " + СтрокаЗапроса);
			
		КонецЕсли;
		
		СтруктураРезультата.Данные = ЗаблокированныеЗаказы; 
		
	КонецЕсли;
	
	Возврат СтруктураРезультата;
		
КонецФункции

Функция ПолучитьЗаблокированныеЗаказы_V2(МассивДоговоров, ЗаписыватьВЖурнал = Истина) Экспорт
	
	КолвоПопыток = 2;
	ЗадержкаПоВремени = 2; 
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("agreements", МассивДоговоров);
	
	СтрокаЗапроса = "/api/v2/client/hold-orders";
	ПредставлениеЗапроса = "Получение заблокированных заказов";
		
	Для Сч = 1 По КолвоПопыток Цикл				
		
		СтруктураРезультата = ОтправитьЗапросВБиллинг(СтрокаЗапроса, ПредставлениеЗапроса, "POST",,,, Чеки.ВернутьJSON(СтруктураЗапроса));
		
		Если СтруктураРезультата.Результат < 2 Тогда
			Прервать;
		КонецЕсли; 
		
		Если СтруктураРезультата.Результат = 2 И Сч <> КолвоПопыток Тогда
			ПаузаИсполнения(ЗадержкаПоВремени);	
		КонецЕсли;      		
		
	КонецЦикла; 		
	
	Если СтруктураРезультата.Данные <> Неопределено И ТипЗнч(СтруктураРезультата.Данные) = Тип("Массив") Тогда
		
		ЗаблокированныеЗаказы = Новый ТаблицаЗначений;
		ЗаблокированныеЗаказы.Колонки.Добавить("Контрагент");
		ЗаблокированныеЗаказы.Колонки.Добавить("ДоговорКонтрагента");
		ЗаблокированныеЗаказы.Колонки.Добавить("Документ");
		ЗаблокированныеЗаказы.Колонки.Добавить("ДатаДокумента");
		ЗаблокированныеЗаказы.Колонки.Добавить("Сумма");
		ЗаблокированныеЗаказы.Колонки.Добавить("ДопустимоеЧислоДнейЗадолженности");
		ЗаблокированныеЗаказы.Колонки.Добавить("ДопустимаяСуммаЗадолженности"); 
		ЗаблокированныеЗаказы.Колонки.Добавить("Грузополучатель");

		
		ИмяБазы = Константы.AMQP_ИдентификаторИнформацСистемы.Получить();
		
		БылиОшибки = Ложь;
		ТекстОшибок = "";
		
		Для Каждого СтрокаДанных ИЗ СтруктураРезультата.Данные Цикл
			
			Если НЕ СтрокаДанных.hold_orders.Количество() = 0 Тогда
				
				Для Каждого Долг Из  СтрокаДанных.hold_orders Цикл
					
					Попытка
						
						Дата = ПреобразоватьДатуБиллинг(Долг.order_id_date);
						
						НоваяСтрока = ЗаблокированныеЗаказы.Добавить();
						НоваяСтрока.Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту("КодМДМ", СтрокаДанных.kontragent_mdm_id);
						НоваяСтрока.ДоговорКонтрагента = Справочники.ДоговорыКонтрагентов.НайтиПоРеквизиту("КодМДМ", СтрокаДанных.agreement_mdm_id);
						
						ИмяБазыБиллинг = Долг.app_id;
						ТипДокумента = "ЗаказПокупателя";
						ТипДокументаПредставление = Метаданные.Документы.ЗаказПокупателя.Синоним;
						
						Если НРег(ИмяБазыБиллинг) = НРег(Строка(ИмяБазы)) ИЛИ НРег(ИмяБазыБиллинг) = НРег(Строка(Константы.База.Получить())) Тогда
							
							Если ТипДокумента <> "" Тогда       					
								
								НоваяСтрока.Документ = Документы[ТипДокумента].ПолучитьСсылку(Новый УникальныйИдентификатор(Долг.source_order_id));
								ОбъектДокумент = НоваяСтрока.Документ.ПолучитьОбъект();
								
								Если ОбъектДокумент = Неопределено Тогда
									НоваяСтрока.Документ = ТипДокументаПредставление + " " + Долг.order_id_name + " от " + Формат(Дата, "ДЛФ=DT") + " - документ не найден";	
								Иначе
									НоваяСтрока.Грузополучатель = НоваяСтрока.Документ.Грузополучатель;
								КонецЕсли; 	
								
							КонецЕсли; 
							
						Иначе
							НоваяСтрока.Документ = ТипДокументаПредставление + " " + Долг.order_id_name + " от " + Формат(Дата, "ДЛФ=DT") + " - " + ИмяБазыБиллинг;
						КонецЕсли;	
						
						НоваяСтрока.ДатаДокумента = Дата;									
						НоваяСтрока.Сумма = Число(Долг.amount); 
						
					Исключение   
						
						БылиОшибки = Истина;
						ТекстОшибок = ТекстОшибок + Символы.ПС + ОписаниеОшибки();   
						
					КонецПопытки;
					
				КонецЦикла; 
				
			КонецЕсли; 
			
		КонецЦикла; 
		
		Если БылиОшибки И ЗаписыватьВЖурнал Тогда
			ЗаписьЖурналаРегистрации("РаботаСБиллингом.Ошибка", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Ошибка выполнения запроса: " + ПредставлениеЗапроса + Символы.ПС + "Текст ошибки: "+ ТекстОшибок + Символы.ПС + "Текст запроса: " + СтрокаЗапроса);
		КонецЕсли; 
		
		СтруктураРезультата.Данные = ЗаблокированныеЗаказы;    
		
	КонецЕсли;  
	
	Возврат СтруктураРезультата;   
	
КонецФункции

Функция ПолучитьНеоплаченныеДокументы_V2(МассивДоговоров, ЗаписыватьВЖурнал = Истина) Экспорт 
	
	КолвоПопыток = 2;
