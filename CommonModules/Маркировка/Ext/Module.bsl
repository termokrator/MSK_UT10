КонецПроцедуры

Процедура ЗагрузитьОбработкуГИСМТ(СтруктураДокумента, ВидДокумента, ИмяОчереди, Отказ = Ложь, ТекстСообщения = "", ТекстОшибки = "") Экспорт
//+Белов А. 24.06.2026 #UT10-5894

	ДокументыМассив = СтруктураДокумента.docs;
	
	Для каждого Док Из ДокументыМассив Цикл
		
		Документ = Документы.ПоступлениеТоваровУслуг.ПолучитьСсылку(Новый УникальныйИдентификатор(Док.sourceId));
		
		Если Документ.ПолучитьОбъект() <> Неопределено Тогда 
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	МАКСИМУМ(ДокументыЭДОТребующиеОбработки.Идентификатор) КАК Идентификатор
			|ИЗ
			|	РегистрСведений.ДокументыЭДОТребующиеОбработки КАК ДокументыЭДОТребующиеОбработки
			|ГДЕ
			|	ДокументыЭДОТребующиеОбработки.Документ = &Документ
			|	И ДокументыЭДОТребующиеОбработки.ОтправленНаПроверкуВЧЗ";
			
			Запрос.УстановитьПараметр("Документ", Документ);  
			
			Выборка = Запрос.Выполнить().Выбрать(); 
			
			Если Выборка.Следующий() Тогда
				
				Менеджер = РегистрыСведений.ДокументыЭДОТребующиеОбработки.СоздатьМенеджерЗаписи();		
				Менеджер.Идентификатор = Выборка.Идентификатор;
				Менеджер.Прочитать();
				
				Если Менеджер.Выбран() Тогда
					
					Если НРег(Док.state) = "success" Тогда
						
						Менеджер.ПроверенВЧЗ = Истина;
						Менеджер.ТекстОшибкиЧЗ = "";  
						
					ИначеЕсли НРег(Док.state) = "failed" Тогда  
						
						Если Док.Свойство("errors") Тогда    
							
							//+Белов А. 14.07.2026 #UT10-5957							
							Если ЗначениеЗаполнено(Док.errors) Тогда
								Менеджер.ТекстОшибкиЧЗ = Док.errors;
							Иначе
								Менеджер.ТекстОшибкиЧЗ = "Неизвестная ошибка";	
							КонецЕсли;			             
							//-Белов А. 14.07.2026 #UT10-5957
							
						Иначе
							Менеджер.ТекстОшибкиЧЗ = "Неизвестная ошибка";
						КонецЕсли;                 					
						
					КонецЕсли;
					
					Менеджер.Записать();  
					
				КонецЕсли;
				
			КонецЕсли;              	
			
		КонецЕсли;
		
	КонецЦикла;                       

