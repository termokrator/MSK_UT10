Процедура МаркировкаОбработкаПроведения(Источник, Отказ) Экспорт
	
	Если Не Источник.Проведен Тогда
		Возврат;
	КонецЕсли; 
	
	//+Шульман А. 02.10.2025 #UT10-5438                           
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.ПоступлениеТоваровУслуг") Тогда   
		СоздатьМаркировкуПриПоступлении(Источник.Ссылка);
	КонецЕсли;
	//-Шульман А. 02.10.2025 #UT10-5438 	
	
КонецПроцедуры

Процедура СоздатьМаркировкуПриПоступлении(ДокСсылка) Экспорт
	
	//+Шульман А. 02.10.2025 #UT10-5438   
	тзТовары = ПолучитьНоменклатуруДляМаркировкиПриПоступлении(ДокСсылка);  
	
	Если Не ЗначениеЗаполнено(тзТовары) Тогда
		Возврат;
	КонецЕсли;
	
	тзТовГруппы = тзТовары.Скопировать();
	тзТовГруппы.Свернуть("ВидПродукции, Кладовщик");   
	
	Для каждого тзСтрокаВидПродукции Из тзТовГруппы Цикл
		
		//+Шульман А. 08.10.2025 #UT10-5444 
		Если НачалоДня(ТекущаяДата()) >= тзСтрокаВидПродукции.ВидПродукции.ДатаОкончанияМаркировкиОстатков Тогда
			Продолжить;
		КонецЕсли;
		//-Шульман А. 08.10.2025 #UT10-5444 
		
		ДокОбъект = Документы.МаркировкаТоваровГИСМ.СоздатьДокумент();
		ДокОбъект.Дата = ТекущаяДата();           
		ДокОбъект.ВидПродукции = тзСтрокаВидПродукции.ВидПродукции;   
		ДокОбъект.ДокументОснование = ДокСсылка;
		ДокОбъект.Организация = ДокСсылка.Организация;    
		ДокОбъект.СпособВводаВОборот = Перечисления.СпособВводаВОборот.МаркировкаОстатков;   
		ДокОбъект.СпособИзготовления = Перечисления.ВидыСервисПровайдеровСУЗ.Самостоятельно;
		ДокОбъект.Ответственный = ПараметрыСеанса.ТекущийПользователь;                 
		ДокОбъект.Кладовщик = тзСтрокаВидПродукции.Кладовщик;
		ДокОбъект.Комментарий = "Создан при проведении поступления товаров " + ТекущаяДата();
	    ДокОбъект.Статус = Перечисления.СтатусыМаркировкиТоваров.ЗаказНаЭмиссию;    
		
		МассивСтрок = тзТовары.НайтиСтроки(Новый Структура("ВидПродукции", тзСтрокаВидПродукции.ВидПродукции));
		
		Для каждого тзСтрока Из МассивСтрок Цикл
		
			ДобСтрока = ДокОбъект.Товары.Добавить();
			ДобСтрока.Номенклатура = тзСтрока.Номенклатура;
			ДобСтрока.GTIN = тзСтрока.Номенклатура.GTIN;
			ДобСтрока.Количество = тзСтрока.Количество; 
			ДобСтрока.КоличествоФакт = тзСтрока.Количество;
		
		КонецЦикла;
		
		ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		
		Попытка
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
		
		КонецПопытки; 

	КонецЦикла;
	//-Шульман А. 02.10.2025 #UT10-5438 
	
КонецПроцедуры // ()

// ДокСсылка - ДокументСсылка.ПоступлениеТоваровУслуг
Функция ПолучитьНоменклатуруДляМаркировкиПриПоступлении(ДокСсылка)  
	
	//+Шульман А. 02.10.2025 #UT10-5438   
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МаркировкаТоваровГИСМТовары.Номенклатура,
		|	СУММА(МаркировкаТоваровГИСМТовары.КоличествоФакт) КАК Количество
		|ПОМЕСТИТЬ ВТ_Маркировка
		|ИЗ
		|	Документ.МаркировкаТоваровГИСМ.Товары КАК МаркировкаТоваровГИСМТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.МаркировкаТоваровГИСМ КАК МаркировкаТоваровГИСМ
		|		ПО МаркировкаТоваровГИСМТовары.Ссылка = МаркировкаТоваровГИСМ.Ссылка
		|ГДЕ
		|	МаркировкаТоваровГИСМ.Проведен
		|	И МаркировкаТоваровГИСМ.ДокументОснование = &ДокСсылка
		|
		|СГРУППИРОВАТЬ ПО
		|	МаркировкаТоваровГИСМТовары.Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТоварыВЯчейкахОбороты.Номенклатура,
		|	СУММА(ТоварыВЯчейкахОбороты.КоличествоПриход) КАК Количество,
		|	МАКСИМУМ(ТоварыВЯчейкахОбороты.Регистратор.Ответственный) КАК Кладовщик
		|ПОМЕСТИТЬ ВТ_ТоварыВЯчейках
		|ИЗ
		|	РегистрНакопления.ТоварыВЯчейках.Обороты(
		|			,
		|			,
		|			Регистратор,
		|			Ячейка = &ЯчейкаДляМаркировки
		|				И Номенклатура.ТребуетсяМаркировка) КАК ТоварыВЯчейкахОбороты
		|ГДЕ
		|	ТоварыВЯчейкахОбороты.Регистратор ССЫЛКА Документ.РазмещениеПоЯчейкам
		|	И ТоварыВЯчейкахОбороты.Регистратор.ДокументОснование = &ДокСсылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ТоварыВЯчейкахОбороты.Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ТоварыВЯчейках.Номенклатура,
		|	ВТ_ТоварыВЯчейках.Количество - ЕСТЬNULL(ВТ_Маркировка.Количество, 0) КАК Количество,
		|	ВТ_ТоварыВЯчейках.Номенклатура.ТоварнаяГруппаЧестногоЗнака КАК ВидПродукции,
		|	ВТ_ТоварыВЯчейках.Кладовщик
		|ИЗ
		|	ВТ_ТоварыВЯчейках КАК ВТ_ТоварыВЯчейках
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Маркировка КАК ВТ_Маркировка
		|		ПО ВТ_ТоварыВЯчейках.Номенклатура = ВТ_Маркировка.Номенклатура
		|ГДЕ
		|	ВТ_ТоварыВЯчейках.Количество - ЕСТЬNULL(ВТ_Маркировка.Количество, 0) > 0";
	
	Запрос.УстановитьПараметр("ДокСсылка", ДокСсылка);
	Запрос.УстановитьПараметр("ЯчейкаДляМаркировки", Константы.ЯчейкаДляМаркировки.Получить());
	
	РезультатЗапроса = Запрос.Выполнить();  
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;     
	Иначе
		Возврат РезультатЗапроса.Выгрузить();
	КонецЕсли;
    //-Шульман А. 02.10.2025 #UT10-5438   

КонецФункции // ()

Процедура ОбработатьСообщениеПоМаркировке(ТекстСообщения, Отказ, Подписка, СвойстваСообщения = "", ВходящееСообщение = Неопределено, ПовторнаяОбработка = Ложь) Экспорт	
	
	ВремяНачала = ОценкаПроизводительности.НачатьЗамерВремени();
	ИмяОчереди = "UT11.documents.Mark";
	
	СтруктураДокумента = ОбщегоНазначения.ВернутьСтруктуруИзJSON(ТекстСообщения);
	ВидДокумента = "";
	СтруктураДокумента.Свойство("ВидДокумента", ВидДокумента);		
	
	ТекстОшибки = "";

	Если Не ЗначениеЗаполнено(ВидДокумента) Тогда
		
		Если ТипЗнч(СвойстваСообщения) = Тип("Структура") Тогда
		
			Заголовки = СвойстваСообщения.headers;
			ВидДокумента = Заголовки.Получить("document_type");
		
		ИначеЕсли ТипЗнч(СвойстваСообщения) = Тип("СправочникТабличнаяЧасть.Р_ВходящиеСообщения.Параметры") Тогда
			
			тзСтрока = СвойстваСообщения.Найти("document_type", "Имя");
			
			Если Не тзСтрока = Неопределено Тогда
				ВидДокумента = тзСтрока.Значение;
			КонецЕсли;  
			
		КонецЕсли;
		
	КонецЕсли;
	
	Попытка
		
		Если ВидДокумента = "СостояниеЗаказаНаЭмиссию" Тогда
			ЗагрузитьЗаказНаМаркировку(СтруктураДокумента, ВидДокумента, ИмяОчереди, Отказ, ТекстСообщения, ТекстОшибки);
		ИначеЕсли ВидДокумента = "СостояниеОтчетаОНанесении" Тогда
			ЗагрузитьОтчетОНанесении(СтруктураДокумента, ВидДокумента, ИмяОчереди, Отказ, ТекстСообщения, ТекстОшибки);
		ИначеЕсли ВидДокумента = "СостояниеВводВОборот" Тогда
			ЗагрузитьВводВОборот(СтруктураДокумента, ВидДокумента, ИмяОчереди, Отказ, ТекстСообщения, ТекстОшибки); 
		//+Белов А. 24.03.2026 #UT10-5761
		ИначеЕсли ВидДокумента = "СостояниеВыводаИзОборота" Тогда
			ЗагрузитьВыводИзОборота(СтруктураДокумента, ВидДокумента, ИмяОчереди, Отказ, ТекстСообщения, ТекстОшибки);	
		//-Белов А. 24.03.2026 #UT10-5761
		//+Белов А. 02.06.2026 #UT10-5894
		ИначеЕсли ВидДокумента = "СостояниеОбработкиГИСМТ" Тогда
			ЗагрузитьОбработкуГИСМТ(СтруктураДокумента, ВидДокумента, ИмяОчереди, Отказ, ТекстСообщения, ТекстОшибки);
		//-Белов А. 02.06.2026 #UT10-5894
		Иначе	
			ТекстОшибки = "Неизвестный тип сообщения";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			
			Справочники.Р_ВходящиеСообщения.ЗаписатьОшибкуПоВходящемуСообщению(ВходящееСообщение, ТекстОшибки);		
			Возврат;
			
		КонецЕсли;
		
		Справочники.Р_ВходящиеСообщения.ПометитьВходящееОбработанным(ВходящееСообщение);   
		
	Исключение
		
		Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
			ТекстОшибки = "Не удалось загрузить!";
		КонецЕсли;
		
		Справочники.Р_ВходящиеСообщения.ЗаписатьОшибкуПоВходящемуСообщению(ВходящееСообщение, ТекстОшибки);		
		ЗаписьЖурналаРегистрации("ПолучениеСообщений.Прием", УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
		
	КонецПопытки;	
	
КонецПроцедуры

Функция ЭтоОчередьПоМаркировке(ИмяОчереди) Экспорт

	Возврат ВРЕГ(Лев(ИмяОчереди, 4)) = "UT10" И ВРЕГ(Прав(ИмяОчереди, 15)) = ".DOCUMENTS.MARK";

КонецФункции // ()

Процедура ЗагрузитьЗаказНаМаркировку(СтруктураДокумента, ВидДокумента, ИмяОчереди, Отказ = Ложь, ТекстСообщения = "", ТекстОшибки = "") Экспорт
	
	СтатусДокумента = Перечисления.СтатусыЗаказаНаМаркировку.Обработан;
	
	Попытка 
		
		ДокументЗагрузки = Документы.ЗаказНаЭмиссиюКодовМаркировкиСУЗ.ПолучитьСсылку(Новый УникальныйИдентификатор(СтруктураДокумента.source_id)); 
		
		Если ДокументЗагрузки.ПолучитьОбъект() <> Неопределено Тогда
			
			Для Каждого СтрокаДетайл ИЗ СтруктураДокумента.Detail Цикл
				
				Номенклатура = Справочники.Номенклатура.НайтиПоРеквизиту("КодМДМ",СтрокаДетайл.Product_mdm);
				
				Если СтрокаДетайл.Свойство("codes") Тогда
					
					Если ЗначениеЗаполнено(СтрокаДетайл.codes) Тогда
						
						Для Каждого СтрокаКодес ИЗ СтрокаДетайл.codes Цикл    
							
							ЗаписьПКМ = РегистрыСведений.ПулКодовМаркировкиСУЗ.СоздатьМенеджерЗаписи();
							ЗаписьПКМ.ДокументОснование = ДокументЗагрузки;
							ЗаписьПКМ.Организация = ДокументЗагрузки.Организация;
							ЗаписьПКМ.ВидПродукции = ДокументЗагрузки.ВидПродукции;
							
							//+Сёмин Р.И. 03.06.2026 #UT10-5906
							//ЗаписьПКМ.КодМаркировки = Лев(СтрокаКодес.km, 18) + Сред(СтрокаКодес.km, 19, 13);
							НомерПозицииПервогоРазделителяGS = Найти(СтрокаКодес.km, Символ(29));
							
							Если ЗначениеЗаполнено(НомерПозицииПервогоРазделителяGS) Тогда
								ЗаписьПКМ.КодМаркировки = Лев(СтрокаКодес.km, НомерПозицииПервогоРазделителяGS - 1);
							Иначе
								ЗаписьПКМ.КодМаркировки = Лев(СтрокаКодес.km, 18) + Сред(СтрокаКодес.km, 19, 13);
							КонецЕсли;
							//-Сёмин Р.И. 03.06.2026 #UT10-5906
							
							ЗаписьПКМ.СпособВводаВОборот = ДокументЗагрузки.СпособВводаВОборот;
							ЗаписьПКМ.ДатаЭмиссииУниверсальная = Дата(СтруктураДокумента.date);
							ЗаписьПКМ.ЗаказНаЭмиссию = ДокументЗагрузки; 
							ЗаписьПКМ.GTIN = Сред(СтрокаКодес.km, 3, 14);
							ЗаписьПКМ.ПолныйКодМаркировки = Новый ХранилищеЗначения(СтрокаКодес.km);
							
							//+Сёмин Р.И. 03.06.2026 #UT10-5906
							//ЗаписьПКМ.ХешСуммаКодаМаркировки = Прав(СтрокаКодес.km,СтрДлина(СтрокаКодес.km) - 32);
							
							Если ЗначениеЗаполнено(НомерПозицииПервогоРазделителяGS) Тогда
								ЗаписьПКМ.ХешСуммаКодаМаркировки = Прав(СтрокаКодес.km, СтрДлина(СтрокаКодес.km) - НомерПозицииПервогоРазделителяGS);
							Иначе
								ЗаписьПКМ.ХешСуммаКодаМаркировки = Прав(СтрокаКодес.km, СтрДлина(СтрокаКодес.km) - 32);
							КонецЕсли;
							//-Сёмин Р.И. 03.06.2026 #UT10-5906
							
							ЗаписьПКМ.Номенклатура = Номенклатура;   
							ЗаписьПКМ.Статус = Перечисления.СтатусыКодовМаркировкиСУЗ.Эмитирован;  
							
							СтрокаИзДокумента = ДокументЗагрузки.Товары.Найти(ЗаписьПКМ.GTIN, "GTIN");
							
							Если ЗначениеЗаполнено(ДокументЗагрузки.ВидПродукции) Тогда  
								ЗаписьПКМ.Шаблон = ДокументЗагрузки.ВидПродукции.ШаблонМаркировки;
							КонецЕсли;  
							
							ЗаписьПКМ.ТекстОшибки = СтрокаДетайл.error_text; 
							
							Если ЗначениеЗаполнено(ЗаписьПКМ.ТекстОшибки) Тогда
								СтатусДокумента = Перечисления.СтатусыЗаказаНаМаркировку.Ошибка;
							КонецЕсли;
							
							ЗаписьПКМ.Записать();
							
						КонецЦикла; 
						
					Иначе
						
						ТекстОшибки =  "Пустые данные в codes"; 
						СтатусДокумента = Перечисления.СтатусыЗаказаНаМаркировку.Ошибка;
						
					КонецЕсли;
					
				Иначе
					
					ТекстОшибки =  "Нет тега codes";
					СтатусДокумента = Перечисления.СтатусыЗаказаНаМаркировку.Ошибка;
					
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе
			
			ТекстОшибки =  "Не найден заказ на маркировку по id - " + СтруктураДокумента.source_id;
            Возврат;
			
		КонецЕсли;
		
	Исключение
		СтатусДокумента = Перечисления.СтатусыЗаказаНаМаркировку.Ошибка;
	КонецПопытки;
	
	ОбъектДокумента = ДокументЗагрузки.ПолучитьОбъект();
	ОбъектДокумента.Статус = СтатусДокумента;
	ОбъектДокумента.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

Процедура ЗагрузитьОтчетОНанесении(СтруктураДокумента, ВидДокумента, ИмяОчереди, Отказ = Ложь, ТекстСообщения = "", ТекстОшибки = "") Экспорт
	
	СтатусДокумента = Перечисления.СтатусыОтчетОНанесенииКИЗ.Обработан;
	
	Попытка 
		
		ДокументЗагрузки = Документы.ОтчетОНанесенииКИЗ.ПолучитьСсылку(Новый УникальныйИдентификатор(СтруктураДокумента.source_id)); 
		
		Если ДокументЗагрузки.ПолучитьОбъект() <> Неопределено Тогда
			
			Для Каждого СтрокаДетайл ИЗ СтруктураДокумента.Detail Цикл
				
				//+Сёмин Р.И. 04.06.2026 #UT10-5906
				//НайденныйШН = Справочники.ШтрихкодыНоменклатуры.НайтиПоРеквизиту("КодМаркировки", Лев(СтрокаДетайл.code, 18) + Сред(СтрокаДетайл.code, 19, 13));
				
				НомерПозицииПервогоРазделителяGS = Найти(СтрокаДетайл.code, Символ(29));
				
				Если ЗначениеЗаполнено(НомерПозицииПервогоРазделителяGS) Тогда
					НайденныйШН = Справочники.ШтрихкодыНоменклатуры.НайтиПоРеквизиту("КодМаркировки", Лев(СтрокаДетайл.code, НомерПозицииПервогоРазделителяGS - 1));
				Иначе
					НайденныйШН = Справочники.ШтрихкодыНоменклатуры.НайтиПоРеквизиту("КодМаркировки", Лев(СтрокаДетайл.code, 18) + Сред(СтрокаДетайл.code, 19, 13));
				КонецЕсли;
				//-Сёмин Р.И. 04.06.2026 #UT10-5906

				Если НЕ НайденныйШН.Пустая() Тогда
					
					НаборЗаписей = РегистрыСведений.СостоянияКодовМаркировки.СоздатьНаборЗаписей();
					НаборЗаписей.Отбор.Регистратор.Установить(ДокументЗагрузки);
					НаборЗаписей.Прочитать();
					
					Для Каждого ЗаписьСКМ ИЗ НаборЗаписей Цикл  
						
						Если ЗаписьСКМ.ШтрихКодНоменклатуры <> НайденныйШН Тогда
							Продолжить;
		 				КонецЕсли;
						
						ЗаписьСКМ.Документ = ДокументЗагрузки;
						ЗаписьСКМ.СостояниеКМ = Перечисления.СостоянияКодовМаркировки.Нанесен;    
						ЗаписьСКМ.Признак = Перечисления.ПризнакКодовМаркировки.СвойКИЗ;  
						ЗаписьСКМ.СтатусКМ = СтрокаДетайл.status_km;
						ЗаписьСКМ.Ошибка = СтрокаДетайл.error_text;
						ЗаписьСКМ.ИДДокументаЧЗ = СтрокаДетайл.report_id;  
						
					КонецЦикла;
					
					Если НаборЗаписей.Количество() > 0 Тогда
						НаборЗаписей.Записать();          
					КонецЕсли;
					
				Иначе
					
					СтатусДокумента = Перечисления.СтатусыОтчетОНанесенииКИЗ.Ошибка;
					ТекстОшибки =  "Не найден код маркировки в табличной части ";
					
				КонецЕсли;
				
			КонецЦикла;  
			
		Иначе
			
			СтатусДокумента = Перечисления.СтатусыОтчетОНанесенииКИЗ.Ошибка;
			ТекстОшибки =  "Не найден отчет о нанесении по id - " + СтруктураДокумента.source_id; 
			Возврат;
			
		КонецЕсли;
		
	Исключение
		СтатусДокумента = Перечисления.СтатусыОтчетОНанесенииКИЗ.Ошибка;
	КонецПопытки;
	
	ОбъектДокументаЗагрузки = ДокументЗагрузки.ПолучитьОбъект();  
	ОбъектДокумента = ОбъектДокументаЗагрузки;
	ОбъектДокумента.Статус = СтатусДокумента;
	ОбъектДокумента.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

Процедура ЗагрузитьВводВОборот(СтруктураДокумента, ВидДокумента, ИмяОчереди, Отказ = Ложь, ТекстСообщения = "", ТекстОшибки = "") Экспорт
	
	СтатусДокумента = ""; 
	
	Если СтруктураДокумента.Свойство("status") Тогда
		
		Если СтруктураДокумента.status = "ERROR" Тогда 
			СтатусДокумента = Перечисления.СтатусыОтчетОНанесенииКИЗ.Ошибка; 
		ИначеЕсли СтруктураДокумента.status = "CHECKED_OK" Тогда 
			СтатусДокумента = Перечисления.СтатусыОтчетОНанесенииКИЗ.Обработан; 
		КонецЕсли;
		
	КонецЕсли;
	
	Попытка   
		
		Если СтатусДокумента = Перечисления.СтатусыОтчетОНанесенииКИЗ.Обработан Тогда
			
			ДокументЗагрузки = Документы.ВводВОборотКИЗ.ПолучитьСсылку(Новый УникальныйИдентификатор(СтруктураДокумента.source_id)); 
			
			Если ДокументЗагрузки.ПолучитьОбъект() <> Неопределено Тогда
				
				НаборЗаписей = РегистрыСведений.СостоянияКодовМаркировки.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.Регистратор.Установить(ДокументЗагрузки);
				
				Для Каждого СтрокаДокументЗагрузки ИЗ ДокументЗагрузки.Товары Цикл
					
					ЗаписьСКМ = НаборЗаписей.Добавить();
					ЗаписьСКМ.Документ = ДокументЗагрузки;
					ЗаписьСКМ.ШтрихКодНоменклатуры = СтрокаДокументЗагрузки.ШтрихКодМаркировки;
					ЗаписьСКМ.СостояниеКМ = Перечисления.СостоянияКодовМаркировки.ВведенВОборот;    
					ЗаписьСКМ.Признак = Перечисления.ПризнакКодовМаркировки.СвойКИЗ;  
					
				КонецЦикла;
				
				Если НаборЗаписей.Количество() > 0 Тогда
					НаборЗаписей.Записать();          
				КонецЕсли;
				
			Иначе
				
				СтатусДокумента = Перечисления.СтатусыОтчетОНанесенииКИЗ.Ошибка;
				ТекстОшибки =  "Не найден отчет о нанесении по id - " + СтруктураДокумента.source_id; 
				Возврат;
				
			КонецЕсли; 
			
		КонецЕсли;     
		
	Исключение
		СтатусДокумента = Перечисления.СтатусыОтчетОНанесенииКИЗ.Ошибка;
	КонецПопытки;
	
	Если НЕ ЗначениеЗаполнено(СтатусДокумента) Тогда 
		
		ТекстОшибки =  "Неизвестный статус документа"; 
		Возврат;
		
	КонецЕсли;
	
	ОбъектДокументаЗагрузки = ДокументЗагрузки.ПолучитьОбъект();  
	ОбъектДокумента = ОбъектДокументаЗагрузки;
	ОбъектДокумента.Статус = СтатусДокумента;
	ОбъектДокумента.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

Процедура ЗагрузитьВыводИзОборота(СтруктураДокумента, ВидДокумента, ИмяОчереди, Отказ = Ложь, ТекстСообщения = "", ТекстОшибки = "") Экспорт
//+Белов А. 24.03.2026 #UT10-5761

	СтатусДокумента = ""; 
	
	Если СтруктураДокумента.Свойство("status") Тогда
		
		Если СтруктураДокумента.status = "ERROR" Тогда 
			СтатусДокумента = Перечисления.СтатусыВыводИзОборотаКИЗ.Ошибка; 
		ИначеЕсли СтруктураДокумента.status = "UNLOAD" Тогда 
			СтатусДокумента = Перечисления.СтатусыВыводИзОборотаКИЗ.Обработан; 
		КонецЕсли;
		
	КонецЕсли;
	
	Попытка  
		
		ДокументЗагрузки = Документы.ВыводИзОборотаКИЗ.ПолучитьСсылку(Новый УникальныйИдентификатор(СтруктураДокумента.source_id)); 
		
		Если ДокументЗагрузки.ПолучитьОбъект() = Неопределено Тогда
			
			СтатусДокумента = Перечисления.СтатусыВыводИзОборотаКИЗ.Ошибка;
			ТекстОшибки =  "Не найден вывод из оборота по id - " + СтруктураДокумента.source_id; 
			Возврат;
			
		КонецЕсли;
				
	Исключение
		СтатусДокумента = Перечисления.СтатусыВыводИзОборотаКИЗ.Ошибка;
	КонецПопытки;
	
	Если НЕ ЗначениеЗаполнено(СтатусДокумента) Тогда 
		
		ТекстОшибки =  "Неизвестный статус документа"; 
		Возврат;
		
	КонецЕсли;
	
	ОбъектДокументаЗагрузки = ДокументЗагрузки.ПолучитьОбъект();  
	ОбъектДокумента = ОбъектДокументаЗагрузки;
	
	Если СтатусДокумента = Перечисления.СтатусыВыводИзОборотаКИЗ.Ошибка Тогда
		
		Если ОбъектДокумента.Статус <> Перечисления.СтатусыВыводИзОборотаКИЗ.Обработан Тогда
			ОбъектДокумента.Статус = СтатусДокумента;	
		КонецЕсли;
		
	Иначе
		ОбъектДокумента.Статус = СтатусДокумента;
	КонецЕсли;
	
	ОбъектДокумента.Записать(РежимЗаписиДокумента.Проведение);

