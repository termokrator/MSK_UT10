	ТаблицаТоваров.Колонки.Добавить("КодМаркировки", СтрокаТип);
	ТаблицаТоваров.Колонки.Добавить("КодМДМНоменклатуры", СтрокаТип);
	ТаблицаТоваров.Колонки.Добавить("ДатаПроизводства", СтрокаТип);
	ТаблицаТоваров.Колонки.Добавить("СрокГодности", СтрокаТип);
	
	Для Каждого СтрокаТовары Из Источник.Товары Цикл
		
		НоваяСтрокаТТ = ТаблицаТоваров.Добавить(); 
		НоваяСтрокаТТ.КодСтроки = СтрокаТовары.НомерСтроки;
		НоваяСтрокаТТ.КодМДМНоменклатуры = Строка(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТовары.Номенклатура, "КодМДМ"));
		НоваяСтрокаТТ.КодМаркировки = СтрокаТовары.ШтрихКодМаркировки.КодМаркировки + СтрокаТовары.ШтрихКодМаркировки.Криптохвост;
		НоваяСтрокаТТ.ДатаПроизводства = Формат(СтрокаТовары.ШтрихКодМаркировки.ДатаПроизводства, "ДФ=dd.MM.yyyy");
		НоваяСтрокаТТ.СрокГодности = Формат(СтрокаТовары.ШтрихКодМаркировки.СрокГодности, "ДФ=dd.MM.yyyy");
		
	КонецЦикла;
	
	МассивТоваров = ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаТоваров);
	СтруктураДокумента.Вставить("КодыМаркировки", МассивТоваров);
	
	//Запись в JSON
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, СтруктураДокумента);
	JsonСтрока = ЗаписьJSON.Закрыть();	
	
	НовоеСообщение.Сообщение = JsonСтрока;
	
	Заголовки = Новый СписокЗначений;
	Заголовки.Добавить("message_ver",  "2.0"); 
	Заголовки.Добавить("document_type",  "ОтчетОНанесении");
	
	Если ЗначениеЗаполнено(Заголовки) Тогда
		
		Для каждого Заголовок Из Заголовки Цикл
			
			НоваяСтрока = НовоеСообщение.Заголовки.Добавить();
			НоваяСтрока.Наименование = Заголовок.Значение;
			НоваяСтрока.Значение = Заголовок.Представление;
			
		КонецЦикла; 
		
	КонецЕсли;
	
	Свойства = Новый СписокЗначений;
	Свойства.Добавить("ТипСодержимого", "application/json"); 
	Свойства.Добавить("ОтметкаВремени", ДатуВTimestamp(НовоеСообщение.ДатаВремяСобытия));   	
	Свойства.Добавить("Тип",            "document"); 
	Свойства.Добавить("ИмяПриложения",  Константы.AMQP_ИдентификаторИнформацСистемы.Получить());
	Свойства.Добавить("РежимДоставки",  2);
	Свойства.Добавить("НомерСообщения", Строка(НовоеСообщение.ПолучитьСсылкуНового().УникальныйИдентификатор()));
	
	Для каждого Свойство Из Свойства Цикл
		
		НоваяСтрока = НовоеСообщение.Свойства.Добавить();
		НоваяСтрока.Наименование = Свойство.Значение;
		НоваяСтрока.Значение = Свойство.Представление;
		
	КонецЦикла; 	
	
	НовоеСообщение.Записать(); 	 
	
КонецПроцедуры

Процедура СоздатьИсходящееСообщениеВводВОборотКИЗ(Источник)  Экспорт
	
	ДатаВремяСобытия = ТекущаяДата();
	
	НовоеСообщение = Справочники.ИсходящиеСообщения.СоздатьЭлемент();
	НовоеСообщение.ОбменДанными.Загрузка = Истина;
	НовоеСообщение.ДатаВремяСобытия = ДатаВремяСобытия;
	НовоеСообщение.ТочкаПубликации = Константы.AMQP_Exchange.Получить();
	НовоеСообщение.Объект = Источник;
	
	ID = Новый УникальныйИдентификатор();     	
	НовоеСообщение.УстановитьСсылкуНового(Справочники.ИсходящиеСообщения.ПолучитьСсылку(ID));
	
	СтруктураДокумента = Новый Структура;
