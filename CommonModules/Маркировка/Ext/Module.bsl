Процедура ЗаполнениеРеквизитовВШтрихкодахМаркировки() Экспорт
	
	//+Макрушин Е. 28.11.2025 #UT10-5554
	// перенесено из УТ 11
	ИмяРегЗадания = "Заполнение реквизитов в штрихкодах маркировки";
	ЗаписьЖурналаРегистрации(ИмяРегЗадания + ".Начало", УровеньЖурналаРегистрации.Информация,,,);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ШтрихКодыНоменклатуры.КодМаркировки,
		|	АВТОНОМЕРЗАПИСИ() КАК НомерПП
		|ПОМЕСТИТЬ ВТ_Коды
		|ИЗ
		|	Справочник.ШтрихКодыНоменклатуры КАК ШтрихКодыНоменклатуры
		|ГДЕ
		|	НЕ ШтрихКодыНоменклатуры.ПометкаУдаления
		|	И (ШтрихКодыНоменклатуры.ТипПоступления = 1 ИЛИ ШтрихКодыНоменклатуры.ТипПоступления = 2)
		|	И (ШтрихКодыНоменклатуры.СрокГодности = ДАТАВРЕМЯ(1, 1, 1)
		|	ИЛИ ШтрихКодыНоменклатуры.ДатаПроизводства = ДАТАВРЕМЯ(1, 1, 1))
		|	И НЕ ШтрихКодыНоменклатуры.КодМаркировки = """"
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЦЕЛ(ВТ_Коды.НомерПП / 1000) КАК Порция,
		|	ВТ_Коды.КодМаркировки,
		|	ВТ_Коды.НомерПП
		|ИЗ
		|	ВТ_Коды КАК ВТ_Коды
		|
		|УПОРЯДОЧИТЬ ПО
		|	Порция
		|ИТОГИ ПО
		|	Порция";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;  
	
	Метод = "/api/v1/km_info?orgId=" + Константы.ОсновнаяОрганизация.Получить().КодМДМ;
	
	АдресСервиса = Константы.АдресСервераЧестныйЗнак.Получить();
	Если НЕ ЗначениеЗаполнено(АдресСервиса) Тогда
		АдресСервиса = "10.90.100.31:30209";
	КонецЕсли;
	
	Соединение = Новый HTTPСоединение(АдресСервиса,,,,,, ); //Новый ЗащищенноеСоединениеOpenSSL());
	
	ПараметрыЗапроса = Новый Структура();  
	
	ВыборкаПорция = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаПорция.Следующий() Цикл
	
		МассивКодов = Новый Массив;  
		//МассивКодов.Добавить("010461001553774121e9(PGgjUFOghk");
		
		Выборка = ВыборкаПорция.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			МассивКодов.Добавить(Выборка.КодМаркировки);
		КонецЦикла;     
		                            
		ПараметрыЗапроса.Вставить("codes", МассивКодов);
		
		Попытка

			СтрокаЗапроса = ОбщегоНазначения.ВернутьJSON(ПараметрыЗапроса);
			
			Заголовки = Новый Соответствие;  
			Заголовки.Вставить("Content-type", "application/json");
			Заголовки.Вставить("Cache-Control", "no-cache");  
			
			HTTPЗапрос = Новый HTTPЗапрос();  
			HTTPЗапрос.АдресРесурса = Метод;
			HTTPЗапрос.Заголовки = Заголовки;     

	    	HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаЗапроса, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
			
			Результат  = Соединение.ВызватьHTTPМетод("POST", HTTPЗапрос);
			
		Исключение
			
			ЗаписьЖурналаРегистрации(
				ИмяРегЗадания,
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));  
			ЗаписьЖурналаРегистрации(ИмяРегЗадания + ".Окончание", УровеньЖурналаРегистрации.Информация,,,);
			Возврат;
			
		КонецПопытки;
		
		//Ответ = ОбщегоНазначения.HTTPОтветВСтруктуру(Результат);
		
        Ответ = Результат;

		
		Если Не Ответ.КодСостояния = 200 Тогда
			
			ЗаписьЖурналаРегистрации(ИмяРегЗадания, УровеньЖурналаРегистрации.Ошибка, , , "Ошибка при чтении данных");  
			ЗаписьЖурналаРегистрации(ИмяРегЗадания + ".Окончание", УровеньЖурналаРегистрации.Информация,,,);
			Возврат;
		
		КонецЕсли;    
	
		ОтветТелоСтрокой = Ответ.ПолучитьТелоКакСтроку();
		
		Попытка
			
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(ОтветТелоСтрокой);    
			
		Исключение
			
			ЗаписьЖурналаРегистрации(ИмяРегЗадания, УровеньЖурналаРегистрации.Ошибка, , , "Ошибка при разборе JSON-данных"); 
			ЗаписьЖурналаРегистрации(ИмяРегЗадания + ".Окончание", УровеньЖурналаРегистрации.Информация,,,);
			Возврат;  
			
		КонецПопытки;
	
		СтруктураДанных = ПрочитатьJSON(ЧтениеJSON, Ложь);     
		
		Если Не СтруктураДанных.Свойство("list") Тогда
			Продолжить;
		КонецЕсли;
		
		Для каждого ЭлементМассива Из СтруктураДанных.list Цикл
			
			Если ПустаяСтрока(ЭлементМассива.producedDate) И ПустаяСтрока(ЭлементМассива.expirationDate) Тогда
				Продолжить;
			КонецЕсли;  
			
			СпрШтрихкод = Справочники.ШтрихКодыНоменклатуры.НайтиПоРеквизиту("КодМаркировки", ЭлементМассива.cis);
			
			Если СпрШтрихкод.Пустая() Тогда
				Продолжить;
			КонецЕсли;   
			
			СпрОбъект = СпрШтрихкод.ПолучитьОбъект();     
			
			Если Не ПустаяСтрока(ЭлементМассива.producedDate) Тогда
				СпрОбъект.ДатаПроизводства = МСК.СтрокаВДату(Лев(ЭлементМассива.producedDate, 10));
			КонецЕсли;  
			
			Если Не ПустаяСтрока(ЭлементМассива.expirationDate) Тогда
				СпрОбъект.СрокГодности = МСК.СтрокаВДату(Лев(ЭлементМассива.expirationDate, 10));
			КонецЕсли;  
			
		    СпрОбъект.Записать();
			
		КонецЦикла;
		
	КонецЦикла;
		
	ЗаписьЖурналаРегистрации(ИмяРегЗадания + ".Окончание", УровеньЖурналаРегистрации.Информация,,,);
	//-Макрушин Е. 28.11.2025 #UT10-5554
	
КонецПроцедуры

Функция ПроверитьКодыМаркировки(МассивКодов) Экспорт
		
	Метод = "/api/v1/km_check?orgId=" + Константы.ОсновнаяОрганизация.Получить().КодМДМГоловнойОрганизации;
	
	АдресСервиса = Константы.АдресСервераЧестныйЗнак.Получить();
	Если НЕ ЗначениеЗаполнено(АдресСервиса) Тогда
		АдресСервиса = "10.90.100.31:30209";
	КонецЕсли;
	
	Соединение = Новый HTTPСоединение(АдресСервиса,,,,,, ); //Новый ЗащищенноеСоединениеOpenSSL());
	
	ПараметрыЗапроса = Новый Структура(); 
	
	ПараметрыЗапроса.Вставить("codes", МассивКодов);
	
	Попытка
		
		СтрокаЗапроса = ОбщегоНазначения.ВернутьJSON(ПараметрыЗапроса);
		
		Заголовки = Новый Соответствие;  
		Заголовки.Вставить("Content-type", "application/json");
		Заголовки.Вставить("Cache-Control", "no-cache");  
		
		HTTPЗапрос = Новый HTTPЗапрос();  
		HTTPЗапрос.АдресРесурса = Метод;
		HTTPЗапрос.Заголовки = Заголовки;     
		
		HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаЗапроса, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		
		Результат  = Соединение.ВызватьHTTPМетод("POST", HTTPЗапрос);
		
	Исключение
		
		ЗаписьЖурналаРегистрации(
		"ПроверитьКодыМаркировки",
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));  
		ЗаписьЖурналаРегистрации("ПроверитьКодыМаркировки.Окончание", УровеньЖурналаРегистрации.Информация,,,);
		Возврат Неопределено;
		
	КонецПопытки;
	
	Ответ = Результат;
	
	
	Если Не Ответ.КодСостояния = 200 Тогда
		
		ЗаписьЖурналаРегистрации("ПроверитьКодыМаркировки", УровеньЖурналаРегистрации.Ошибка, , , "Ошибка при чтении данных");  
		ЗаписьЖурналаРегистрации("ПроверитьКодыМаркировки.Окончание", УровеньЖурналаРегистрации.Информация,,,);
		Возврат Неопределено;
		
	КонецЕсли;    
	
	ОтветТелоСтрокой = Ответ.ПолучитьТелоКакСтроку();
	
	Попытка
		
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ОтветТелоСтрокой);    
		
	Исключение
		
		ЗаписьЖурналаРегистрации("ПроверитьКодыМаркировки", УровеньЖурналаРегистрации.Ошибка, , , "Ошибка при разборе JSON-данных"); 
		ЗаписьЖурналаРегистрации("ПроверитьКодыМаркировки.Окончание", УровеньЖурналаРегистрации.Информация,,,);
		Возврат Неопределено;  
		
	КонецПопытки;
	
	СтруктураДанных = ПрочитатьJSON(ЧтениеJSON, Ложь);     
		
	Возврат СтруктураДанных.result; 
		
КонецФункции


