Процедура ОтправитьДокументыНаПроверкуВЧЗ() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПоступлениеТоваровУслуг.Ссылка,
	|	МАКСИМУМ(ЕСТЬNULL(ДокументыЭДОТребующиеОбработки.Идентификатор, НЕОПРЕДЕЛЕНО)) КАК Идентификатор
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	|		ПО ПоступлениеТоваровУслуг.Ссылка = ЗначенияСвойствОбъектов.Объект
	|			И (ЗначенияСвойствОбъектов.Свойство = &СтатусПриемки)
	|			И (ЗначенияСвойствОбъектов.Значение В (&ЗначенияСтатусовОтправки))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыЭДОТребующиеОбработки КАК ДокументыЭДОТребующиеОбработки
	|		ПО (ДокументыЭДОТребующиеОбработки.Документ = ПоступлениеТоваровУслуг.Ссылка)
	|ГДЕ
	|	ЕСТЬNULL(ДокументыЭДОТребующиеОбработки.Отработан, ИСТИНА) = ИСТИНА
	|	И ЕСТЬNULL(ДокументыЭДОТребующиеОбработки.КоличествоПопытокОтправкиНаПроверкуВЧЗ, 0) <= 3
	|	И ПоступлениеТоваровУслуг.Проведен
	|
	|СГРУППИРОВАТЬ ПО
	|	ПоступлениеТоваровУслуг.Ссылка";
	
	Запрос.УстановитьПараметр("СтатусПриемки", ПланыВидовХарактеристик.СвойстваОбъектов.СтатусПриемки);
	
	ЗначенияСтатусовОтправки = Новый Массив;
	ЗначенияСтатусовОтправки.Добавить(Перечисления.СтатусыПриемки.НаПроверкеВЧЗ);
	ЗначенияСтатусовОтправки.Добавить(Перечисления.СтатусыПриемки.НеНайденВЭДО);
	
	Запрос.УстановитьПараметр("ЗначенияСтатусовОтправки", ЗначенияСтатусовОтправки);
	
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		
		Если Не ЗначениеЗаполнено(Выборка.Идентификатор) Тогда
			МСКWEB.УстановитьЗначениеДопСвойства(Выборка.Ссылка, ПланыВидовХарактеристик.СвойстваОбъектов.СтатусПриемки, Перечисления.СтатусыПриемки.НеНайденВЭДО);			
		Иначе
			
			Менеджер = РегистрыСведений.ДокументыЭДОТребующиеОбработки.СоздатьМенеджерЗаписи();		
			Менеджер.Идентификатор = Выборка.Идентификатор;
			Менеджер.Прочитать();
			
			Если Менеджер.Выбран() Тогда
				
				Если Не Менеджер.ОтправленНаПроверкуВЧЗ Тогда	
					
					Если ЗначениеЗаполнено(Выборка.Ссылка.file_id) Тогда
						
						РезультатОтправки = ОтправитьНаПроверкуВЧЗ(Выборка.Ссылка);
						
						Если РезультатОтправки.Результат Тогда 
							
							Менеджер.ОтправленНаПроверкуВЧЗ = Истина;
							Менеджер.ТекстОшибкиЧЗ = "";  
							
						Иначе       
							
							Менеджер.КоличествоПопытокОтправкиНаПроверкуВЧЗ = Менеджер.КоличествоПопытокОтправкиНаПроверкуВЧЗ + 1;
							Менеджер.ТекстОшибкиЧЗ = РезультатОтправки.Сообщение;	
	
						КонецЕсли;
						
						МСКWEB.УстановитьЗначениеДопСвойства(Выборка.Ссылка, ПланыВидовХарактеристик.СвойстваОбъектов.СтатусПриемки, Перечисления.СтатусыПриемки.НаПроверкеВЧЗ);			
						
					Иначе     					
						
						Менеджер.ТекстОшибкиЧЗ = "У поступления не заполнен реквизит file_id";	
						МСКWEB.УстановитьЗначениеДопСвойства(Выборка.Ссылка, ПланыВидовХарактеристик.СвойстваОбъектов.СтатусПриемки, Перечисления.СтатусыПриемки.ОшибкаПроверкиЧЗ);					
						
					КонецЕсли;
					
					Менеджер.Записать(); 	
					
				Иначе
					
					Если Менеджер.ПроверенВЧЗ Тогда
						МСКWEB.УстановитьЗначениеДопСвойства(Выборка.Ссылка, ПланыВидовХарактеристик.СвойстваОбъектов.СтатусПриемки, Перечисления.СтатусыПриемки.ПоступилНаСклад);				
					ИначеЕсли ЗначениеЗаполнено(Менеджер.ТекстОшибкиЧЗ) Тогда
						МСКWEB.УстановитьЗначениеДопСвойства(Выборка.Ссылка, ПланыВидовХарактеристик.СвойстваОбъектов.СтатусПриемки, Перечисления.СтатусыПриемки.ОшибкаПроверкиЧЗ);					
					КонецЕсли;
					
				КонецЕсли;     						
				
			КонецЕсли;
			
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры 

Функция ОтправитьНаПроверкуВЧЗ(Документ) Экспорт
	
	СтруктураВозврата = Новый Структура("Результат, Сообщение", Ложь, "");
	
	Метод = "/api/v1/documents/status?orgId=" + Константы.ОсновнаяОрганизация.Получить().КодМДМГоловнойОрганизации + "&sourceName=" + Константы.AMQP_ИдентификаторИнформацСистемы.Получить();
	
	АдресСервиса = Константы.АдресСервераЧестныйЗнак.Получить();
	Если НЕ ЗначениеЗаполнено(АдресСервиса) Тогда
		АдресСервиса = "10.90.100.31:30209";
	КонецЕсли;            
	
	МассивДокументов = Новый Массив;
	МассивДокументов.Добавить(Новый Структура("sourceId, fileId", Строка(Документ.УникальныйИдентификатор()), Документ.file_id));
	
	Тело = Новый Структура;
	Тело.Вставить("docs", МассивДокументов);
	
	АдресЗапроса = "http://" + АдресСервиса + Метод;
	
	ЗаписьЖурналаРегистрации("Проверка в ЧЗ.Подготовка", УровеньЖурналаРегистрации.Информация, , , "Подготовка запроса на проверку в ЧЗ: " + Символы.ПС + "Адрес запроса: " + АдресЗапроса + Символы.ПС + "Тело запроса: " + ОбщегоНазначения.ВернутьJSON(Тело));
	
	Попытка
		Ответ = OPI_ЗапросыHTTP.PostСТелом(АдресЗапроса, Тело,,,Истина,,1,10);	
	Исключение
		
		СтруктураВозврата.Сообщение = "Не удалось установить соединение: " + ОписаниеОшибки();	
		Возврат СтруктураВозврата;
		
	КонецПопытки;         
	
	Если Ответ.КодСостояния = 200 Тогда
		
		ОтветСтрока = Ответ.ПолучитьТелоКакСтроку();
		
		ОтветСтруктура = ОбщегоНазначения.ВернутьСтруктуруИзJSON(ОтветСтрока);
		
		ЗаписьЖурналаРегистрации("Проверка в ЧЗ.Ответ", УровеньЖурналаРегистрации.Информация, , , "Был получен ответ при отправке на проверку: " + ОтветСтрока);
		
		Если ОтветСтруктура.Свойство("result") Тогда
			
			Если ОтветСтруктура.result Тогда
				
				СтруктураВозврата.Результат = Истина;  
				ЗаписьЖурналаРегистрации("Проверка в ЧЗ.Успешно", УровеньЖурналаРегистрации.Информация, , , "Был успешно выполнен запрос на проверку в ЧЗ");
				
			Иначе
				СтруктураВозврата.Сообщение = ОтветСтруктура.error;
			КонецЕсли;
			
		Иначе
			СтруктураВозврата.Сообщение = "При отправке запроса на проверку в ЧЗ не удалось получить результат. Ответ: " + ОтветСтрока;		
		КонецЕсли;
		
	Иначе		
		СтруктураВозврата.Сообщение = "Не удалось отправить запрос на проверку в ЧЗ. Код ответа: " + Строка(Ответ.КодСостояния);		
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции

// Преобразовывает текстовое представление типа документа в значение перечисления и наоборот.
//
// Параметры:
//  ЗначениеПоиска      - ПеречислениеСсылка.ВидыОперацийИСМП, Строка - значение для перекодировки.
//	ВидПродукции        - Неопределено, ПеречислениеСсылка.ВидыПродукцииИС - Вид продукции.
//	ОбъемноСортовойУчет - Булево - Признак объемно-сортового учета.
// Возвращаемое значение:
//  ПеречислениеСсылка.ВидыОперацийИСМП, Строка - Тип документа.
Функция ВидОперации(Знач ЗначениеПоиска, ВидПродукции = Неопределено, ОбъемноСортовойУчет = Ложь) Экспорт
	
	Если ТипЗнч(ЗначениеПоиска) = Тип("Строка") Тогда
		ЗначениеПоиска = ВРег(ЗначениеПоиска);
		Если ЗначениеПоиска = "LP_INTRODUCE_GOODS" Тогда
			Возврат Перечисления.ВидыОперацийИСМП.ВводВОборотПроизводствоРФ;
		ИначеЕсли ЗначениеПоиска = "LP_GOODS_IMPORT" Тогда
			Возврат Перечисления.ВидыОперацийИСМП.ВводВОборотПроизводствоВнеЕАЭС;
		ИначеЕсли ЗначениеПоиска = "LP_FTS_INTRODUCE" Тогда
			Возврат Перечисления.ВидыОперацийИСМП.ВводВОборотИмпортСФТС;
		ИначеЕсли ЗначениеПоиска = "FURS_FTS_INTRODUCE" Тогда
			Возврат Перечисления.ВидыОперацийИСМП.ВводВОборотИмпортСФТСМех;
		ИначеЕсли ЗначениеПоиска = "LK_CONTRACT_COMMISSIONING" Тогда
