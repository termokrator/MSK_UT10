Функция ПолучитьОстаткиНоменклатурыДляМаркировки(МассивНоменклатура, УсловиеЯчейки) Экспорт
	
	//+Шульман А. 01.10.2025 #UT10-5445   
	// Запрос взят из УправлениеЗапасами.ПолучитьДеревоОстатковНоменклатуры() и модифицирован
	Запрос = Новый Запрос;
	Запрос.Текст =         
	"ВЫБРАТЬ
	|	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатуры,
	|	ТоварыНаСкладахОстатки.Склад КАК Склад,
	|	СУММА(ТоварыНаСкладахОстатки.КоличествоОстаток) КАК ТоварыНаСкладахОстатки,
	|	0 КАК ТоварыВРезервеСкладахОстатки,
	|	0 КАК ТоварыВЯчейкахОстатки,
	|	0 КАК ТоварыВСборкеОстатки
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(, Номенклатура В (&МассивНоменклатура)) КАК ТоварыНаСкладахОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыНаСкладахОстатки.Номенклатура,
	|	ТоварыНаСкладахОстатки.Склад
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТоварыВРезервеСкладахОстатки.Номенклатура,
	|	ТоварыВРезервеСкладахОстатки.Склад,
	|	0,
	|	СУММА(ТоварыВРезервеСкладахОстатки.КоличествоОстаток),
	|	0,
	|	0
	|ИЗ
	|	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(, Номенклатура В (&МассивНоменклатура)) КАК ТоварыВРезервеСкладахОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыВРезервеСкладахОстатки.Номенклатура,
	|	ТоварыВРезервеСкладахОстатки.Склад
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТоварыВЯчейкахОстатки.Номенклатура,
	|	ТоварыВЯчейкахОстатки.Склад,
	|	0,
	|	0,
	|	СУММА(ТоварыВЯчейкахОстатки.КоличествоОстаток),
	|	0
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Остатки(
	|			,
	|			Номенклатура В (&МассивНоменклатура)
	|				И &УсловиеЯчейки) КАК ТоварыВЯчейкахОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыВЯчейкахОстатки.Номенклатура,
	|	ТоварыВЯчейкахОстатки.Склад
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТоварыВСборкеОстатки.Номенклатура,
	|	&ОсновнойСклад,
	|	0,
	|	0,
	|	0,
	|	СУММА(ТоварыВСборкеОстатки.КСборкеОстаток + ТоварыВСборкеОстатки.СобраноОстаток)
	|ИЗ
	|	РегистрНакопления.ТоварыВСборке.Остатки(, Номенклатура В (&МассивНоменклатура)) КАК ТоварыВСборкеОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыВСборкеОстатки.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Остатки.Номенклатуры КАК Номенклатура,
	|	СУММА(ВТ_Остатки.ТоварыНаСкладахОстатки) КАК Общий,
	|	СУММА(ВТ_Остатки.ТоварыНаСкладахОстатки - ВТ_Остатки.ТоварыВРезервеСкладахОстатки) КАК Свободный,
	|	СУММА(ВЫБОР
	|			КОГДА &Перемаркировка
	|				ТОГДА ВТ_Остатки.ТоварыВЯчейкахОстатки
	|			ИНАЧЕ ВТ_Остатки.ТоварыВЯчейкахОстатки + ВТ_Остатки.ТоварыВСборкеОстатки - ВТ_Остатки.ТоварыВРезервеСкладахОстатки
	|		КОНЕЦ) КАК СвободныйСРазмещением,
	|	СУММА(ВТ_Остатки.ТоварыВРезервеСкладахОстатки) КАК ВРезерве
	|ИЗ
	|	ВТ_Остатки КАК ВТ_Остатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Остатки.Номенклатуры
	|
	|ИМЕЮЩИЕ
	|	СУММА(ВТ_Остатки.ТоварыНаСкладахОстатки - ВТ_Остатки.ТоварыВРезервеСкладахОстатки) >= 0";
	
	Запрос.УстановитьПараметр("ОсновнойСклад", Константы.ОсновнойСклад.Получить());
	Запрос.УстановитьПараметр("МассивНоменклатура", МассивНоменклатура);   
	Запрос.УстановитьПараметр("ЯчейкаДляПеремаркировки", Константы.ЯчейкаДляПеремаркировки.Получить());
	//+Марков И. 01.11.2025 #UT10-5488
	Запрос.УстановитьПараметр("Перемаркировка", НЕ ВРЕГ(СОКРЛП(УсловиеЯчейки)) = "ИСТИНА");
	//-Марков И. 01.11.2025 #UT10-5488
	
	Если ВРЕГ(СОКРЛП(УсловиеЯчейки)) = "ИСТИНА" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеЯчейки", "НЕ Ячейка.НеУчитыватьВОперативномУчете");
	Иначе	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеЯчейки", УсловиеЯчейки);      
	КонецЕсли;
		
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();
	//-Шульман А. 01.10.2025 #UT10-5445

КонецФункции // ()

