// Перекодирует вид сервис провайдера для обмена с СУЗ ИС МП.
//
// Параметры:
//  ЗначениеПоиска - Неопределено - сервис-провайдер не используется, коды маркировки получаются самостоятельно,
//                   Строка, ПеречислениеСсылка.ВидыСервисПровайдеровСУЗ - значение для перекодировки.
// 
// Возвращаемое значение:
//  Строка, ПеречислениеСсылка.ВидыСервисПровайдеровСУЗ - Результат перекодирования.
//
Функция СпособИзготовленияКодовМаркировки(ЗначениеПоиска) Экспорт
	
	Если ЗначениеПоиска = Неопределено Тогда
		Результат = "SELF_MADE";
	ИначеЕсли ЗначениеПоиска = Перечисления.ВидыСервисПровайдеровСУЗ.Самостоятельно Тогда
		Результат =  "SELF_MADE";
		
	Иначе
		ВызватьИсключение
		СтрШаблон(
		НСтр("ru = 'Неизвестный вид сервис-провайдера: %1'"),
		ЗначениеПоиска);
	КонецЕсли;
	
	Возврат Результат;
	
	Если ЗначениеПоиска = Неопределено Тогда
		Результат = "SELF_MADE";
	Иначе
		
		Если ЗначениеПоиска = Перечисления.ВидыСервисПровайдеровСУЗ.ЦЭМ Тогда
			Результат =  "CEM";
		ИначеЕсли ЗначениеПоиска = Перечисления.ВидыСервисПровайдеровСУЗ.КонтрактноеПроизводство Тогда
			Результат =  "CM";
		ИначеЕсли ЗначениеПоиска = Перечисления.ВидыСервисПровайдеровСУЗ.ЛогистическийСклад Тогда
			Результат =  "CL";
		ИначеЕсли ЗначениеПоиска = Перечисления.ВидыСервисПровайдеровСУЗ.КомиссионнаяПлощадка Тогда
			Результат =  "CA";
		ИначеЕсли ЗначениеПоиска = Перечисления.ВидыСервисПровайдеровСУЗ.Самостоятельно Тогда
			Результат =  "SELF_MADE";
		ИначеЕсли ЗначениеПоиска = "CEM" Тогда
			Результат = Перечисления.ВидыСервисПровайдеровСУЗ.ЦЭМ;
		ИначеЕсли ЗначениеПоиска = "CM" Тогда
			Результат = Перечисления.ВидыСервисПровайдеровСУЗ.КонтрактноеПроизводство;
		ИначеЕсли ЗначениеПоиска = "CL" Тогда
			Результат = Перечисления.ВидыСервисПровайдеровСУЗ.ЛогистическийСклад;
		ИначеЕсли ЗначениеПоиска = "CA" Тогда
			Результат = Перечисления.ВидыСервисПровайдеровСУЗ.КомиссионнаяПлощадка;
		Иначе
			ВызватьИсключение
			СтрШаблон(
			НСтр("ru = 'Неизвестный вид сервис-провайдера: %1'"),
			ЗначениеПоиска);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Перекодирует шаблон кода маркировки и тип кода для обмена с СУЗ ИС МП.
//
// Параметры:
//  ЗначениеПоиска - Строка, ПеречислениеСсылка.ШаблоныКодовМаркировкиСУЗ - значение для перекодировки.
// 
// Возвращаемое значение:
//  Строка, ПеречислениеСсылка.ШаблоныКодовМаркировкиСУЗ - Результат перекодирования.
//
Функция ТипКодаМаркировки(Знач ЗначениеПоиска) Экспорт
	
	Если ТипЗнч(ЗначениеПоиска) = Тип("ПеречислениеСсылка.ШаблоныКодовМаркировкиСУЗ") Тогда
		
		ВидУпаковки = ВидУпаковкиПоШаблонуКодаМаркировки(ЗначениеПоиска);
		Если ВидУпаковки = Перечисления.ВидыУпаковокИС.Групповая Тогда
			Результат = "GROUP";
		ИначеЕсли ВидУпаковки = Перечисления.ВидыУпаковокИС.Набор Тогда
			Результат = "SET";
		ИначеЕсли ЗначениеПоиска = Перечисления.ШаблоныКодовМаркировкиСУЗ.ДухиКомплект
			Или ЗначениеПоиска = Перечисления.ШаблоныКодовМаркировкиСУЗ.ФотоаппаратыКомплект
			Или ЗначениеПоиска = Перечисления.ШаблоныКодовМаркировкиСУЗ.ЛегкаяПромышленностьКомплект Тогда
			Результат = "BUNDLE";
		Иначе
			Результат = "UNIT";
		КонецЕсли;
	
	ИначеЕсли ЗначениеПоиска = "UNIT" Тогда
		Результат = Перечисления.ШаблоныКодовМаркировкиСУЗ.Духи;
	ИначеЕсли ЗначениеПоиска = "BUNDLE" Тогда
		Результат = Перечисления.ШаблоныКодовМаркировкиСУЗ.ДухиКомплект;
	ИначеЕсли ЗначениеПоиска = "GROUP" Тогда
		Результат = Перечисления.ШаблоныКодовМаркировкиСУЗ.АнтисептикиГрупповаяУпаковка;
	ИначеЕсли ЗначениеПоиска = "SET" Тогда
		Результат = Перечисления.ШаблоныКодовМаркировкиСУЗ.АнтисептикиНабор;
	
	Иначе
		ВызватьИсключение
			СтрШаблон(
				НСтр("ru = 'Неизвестный тип кода маркировки: %1'"),
				ЗначениеПоиска);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

