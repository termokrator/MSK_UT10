ПОМЕСТИТЬ ВТ_ЗаданияНаДоставку
ИЗ
	Документ.ЗаданиеНаДоставку КАК ЗаданиеНаДоставку
ГДЕ
	ЗаданиеНаДоставку.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
	И ЗаданиеНаДоставку.Проведен = ИСТИНА
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ЗаданияНаДоставку.Ссылка КАК ЗадениеНаДоставку,
	КОЛИЧЕСТВО(ЕСТЬNULL(ЗаданиеНаДоставкуДоставка.Возврат, 0)) КАК Количество
ПОМЕСТИТЬ ВТ_Количество
ИЗ
	ВТ_ЗаданияНаДоставку КАК ВТ_ЗаданияНаДоставку
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаданиеНаДоставку.ДоставкаПоказная КАК ЗаданиеНаДоставкуДоставка
		ПО ВТ_ЗаданияНаДоставку.Ссылка = ЗаданиеНаДоставкуДоставка.Ссылка
			И (ЗаданиеНаДоставкуДоставка.Возврат = ЛОЖЬ)

СГРУППИРОВАТЬ ПО
	ВТ_ЗаданияНаДоставку.Ссылка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	ВТ_ЗаданияНаДоставку.Ссылка КАК ЗаданиеНаДоставку,
	ЗаданиеНаДоставкуДоставка.ДокументСборки
ПОМЕСТИТЬ ВТ_Сборки
ИЗ
	ВТ_ЗаданияНаДоставку КАК ВТ_ЗаданияНаДоставку
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаданиеНаДоставку.Доставка КАК ЗаданиеНаДоставкуДоставка
		ПО ВТ_ЗаданияНаДоставку.Ссылка = ЗаданиеНаДоставкуДоставка.Ссылка
ГДЕ
	ЗаданиеНаДоставкуДоставка.ДокументСборки ССЫЛКА Документ.СборкаЗаказовПокупателя
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_Сборки.ЗаданиеНаДоставку КАК ЗаданиеНаДоставку,
	СУММА(ЕСТЬNULL(ТоварыВСборкеОбороты.СуммаСобраноРасход, 0)) КАК Сумма
ПОМЕСТИТЬ ВТ_Сумма
ИЗ
	ВТ_Сборки КАК ВТ_Сборки
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВСборке.Обороты(, , Регистратор, ) КАК ТоварыВСборкеОбороты
		ПО ВТ_Сборки.ДокументСборки = ТоварыВСборкеОбороты.Сборка
			И (НЕ ТоварыВСборкеОбороты.Регистратор ССЫЛКА Документ.СборкаЗаказовПокупателя)

СГРУППИРОВАТЬ ПО
	ВТ_Сборки.ЗаданиеНаДоставку
;

