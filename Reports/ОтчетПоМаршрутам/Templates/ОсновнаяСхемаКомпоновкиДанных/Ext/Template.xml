	ВТ_Количество.ЗадениеНаДоставку КАК ЗадениеНаДоставку,
	ВТ_Количество.Количество,
	ВТ_Сумма.Сумма КАК Сумма
ИЗ
	ВТ_Количество КАК ВТ_Количество
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаданиеНаДоставку.ОчередьДоставки КАК ЗаданиеНаДоставкуОчередьДоставки
		ПО ВТ_Количество.ЗадениеНаДоставку = ЗаданиеНаДоставкуОчередьДоставки.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Сумма КАК ВТ_Сумма
		ПО ВТ_Количество.ЗадениеНаДоставку = ВТ_Сумма.ЗаданиеНаДоставку

