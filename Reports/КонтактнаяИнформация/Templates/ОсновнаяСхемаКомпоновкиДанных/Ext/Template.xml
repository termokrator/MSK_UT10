	ТелефонКонтрагекнта.Объект КАК Контрагент
ПОМЕСТИТЬ Тел1
ИЗ
	РегистрСведений.КонтактнаяИнформация КАК ТелефонКонтрагекнта
ГДЕ
	ТелефонКонтрагекнта.Тип = &amp;ТипТелефон
	И ТелефонКонтрагекнта.Вид = &amp;ВидТелефон
	И ТелефонКонтрагекнта.Объект ССЫЛКА Справочник.Контрагенты
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЭлПочта.Объект,
	ЭлПочта.Представление
ПОМЕСТИТЬ ЭлПочта
ИЗ
	РегистрСведений.КонтактнаяИнформация КАК ЭлПочта
ГДЕ
	ЭлПочта.Тип = &amp;ТипЭлПочта
	И ЭлПочта.Вид = &amp;ВидЭлПочта
	И ЭлПочта.Объект ССЫЛКА Справочник.Контрагенты
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ФактАдрес.Объект,
	ФактАдрес.Представление
ПОМЕСТИТЬ ФактАдрес
ИЗ
	РегистрСведений.КонтактнаяИнформация КАК ФактАдрес
ГДЕ
	ФактАдрес.Объект ССЫЛКА Справочник.Контрагенты
	И ФактАдрес.Тип = &amp;ТипФактАдрес
	И ФактАдрес.Вид = &amp;ВидФактАдрес
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	АдресДоставки.Объект,
	АдресДоставки.Представление КАК АдресДоставки
ПОМЕСТИТЬ АдрДоставки
ИЗ
	РегистрСведений.КонтактнаяИнформация КАК АдресДоставки
ГДЕ
	АдресДоставки.Объект ССЫЛКА Справочник.Контрагенты
	И АдресДоставки.Тип = &amp;ТипАдресДоставки
	И АдресДоставки.Вид = &amp;АдресДоставки
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЕСТЬNULL(КонтактнаяИнформацияКонтМоды.Представление, "") КАК РабТелефонКонтактногоЛица,
	КонтактнаяИнформацияКонтМоды.Объект
ПОМЕСТИТЬ Морда
ИЗ
	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформацияКонтМоды
ГДЕ
	КонтактнаяИнформацияКонтМоды.Вид = &amp;Вид
	И КонтактнаяИнформацияКонтМоды.Тип = &amp;Тип
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Контрагенты.Ссылка КАК Контрагент,
	Контрагенты.IDАварда,
	ЕСТЬNULL(Тел1.ТелефонКонтрагента, "") КАК ТелефонКонтрагента,
	ЕСТЬNULL(ЭлПочта.Представление, "") КАК ЭлПочта,
	ЕСТЬNULL(ФактАдрес.Представление, "") КАК ФактАдрес,
	ЕСТЬNULL(АдресаДоставки.АдресДоставки, "") КАК АдресДоставки,
	ЕСТЬNULL(Морда.РабТелефонКонтактногоЛица, "") КАК РабТелКонтактоногоЛица
ИЗ
	Справочник.Контрагенты КАК Контрагенты
		ЛЕВОЕ СОЕДИНЕНИЕ Тел1 КАК Тел1
		ПО Контрагенты.Ссылка = Тел1.Контрагент
		ЛЕВОЕ СОЕДИНЕНИЕ ЭлПочта КАК ЭлПочта
		ПО Контрагенты.Ссылка = ЭлПочта.Объект
		ЛЕВОЕ СОЕДИНЕНИЕ ФактАдрес КАК ФактАдрес
		ПО Контрагенты.Ссылка = ФактАдрес.Объект
		ЛЕВОЕ СОЕДИНЕНИЕ АдрДоставки КАК АдресаДоставки
		ПО Контрагенты.Ссылка = АдресаДоставки.Объект
		ЛЕВОЕ СОЕДИНЕНИЕ Морда КАК Морда
		ПО Контрагенты.Ссылка = Морда.Объект
ГДЕ
	Контрагенты.ЭтоГруппа = ЛОЖЬ</query>
