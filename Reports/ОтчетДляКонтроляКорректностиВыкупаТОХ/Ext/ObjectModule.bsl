Перем Филиал Экспорт;
Перем СтруктураПараметров Экспорт;
Перем ДатаНачалаУчетаВФилиалах Экспорт;

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	
	КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	Если ПолучитьЗначениеПараметра("УчитыватьСерии") = Ложь Тогда
		Для Каждого Группировка Из КомпоновщикНастроек.Настройки.Структура Цикл
			Для Каждого Таблица Из Группировка.Структура Цикл
				Для Каждого Строка Из Таблица.Строки Цикл
					Для Каждого ЭлементСтруктуры Из Строка.Структура Цикл
						ОтключитьИспользованиеСерииНоменклатуры(ЭлементСтруктуры);
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;		
		
	Для Каждого КлючИЗначение Из СтруктураПараметров Цикл
		Если ЗначениеЗаполнено(КлючИЗначение.Значение) Тогда
			Если Найти(КлючИЗначение.Ключ, "Отбор") = 0 Тогда
				УстановитьЗначениеПараметра(КлючИЗначение.Ключ, КлючИЗначение.Значение);
			Иначе
				УстановитьЗначениеОтбора(КлючИЗначение.Ключ, КлючИЗначение.Значение);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Филиал = СтруктураПараметров.Филиал;
	ДатаНачалаУчетаВФилиалах = СтруктураПараметров.ДатаНачалаУчетаВФилиалах;
	
	Отказ = Ложь;
	Если Не ЗначениеЗаполнено(Филиал) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен параметр Филиал", , , , Отказ);
	Иначе
		СтруктураПодключения = ПолучитьПараметрыПодключения();
		Если Не ЗначениеЗаполнено(СтруктураПодключения.ИмяСервера) ИЛИ Не ЗначениеЗаполнено(СтруктураПодключения.ИмяИнформационнойБазы)
			ИЛИ Не ЗначениеЗаполнено(СтруктураПодключения.Логин) ИЛИ Не ЗначениеЗаполнено(СтруктураПодключения.Пароль) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Не заполнены параметры подключения к базе филиала %1 (РС Информационные базы филиалов)", Филиал), , , , Отказ);
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ПолучитьЗначениеПараметра("Период").ДатаНачала) ИЛИ Не ЗначениеЗаполнено(ПолучитьЗначениеПараметра("Период").ДатаОкончания) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Некорректно заполнен параметр Период", , , , Отказ);
	КонецЕсли;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеФилиалов = ПолучитьДанныеФилиалов();
	Если ДанныеФилиалов = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибки при подключении к базе УТ10 филиала. Проверьте параметры подключения в РС Информационные базы филиалов");
		Возврат;
	КонецЕсли;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки   = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, КомпоновщикНастроек.Настройки, ДанныеРасшифровки);
	
	ВнешниеНаборыДанных = Новый Структура;
	ВнешниеНаборыДанных.Вставить("ТаблицаРаздела4", ДанныеФилиалов.ТаблицаРаздела4);	//Сопоставление маленьких выкупов ЦП и ОП построчно
	ВнешниеНаборыДанных.Вставить("ТаблицаРаздела5", ДанныеФилиалов.ТаблицаРаздела5);	//Сопоставление маленьких выкупов ЦП и ОП по свойствам документов
	ВнешниеНаборыДанных.Вставить("ТаблицаРаздела7", ДанныеФилиалов.ТаблицаРаздела7);	//Сопоставление остатков регистра ЦП и ОП
	ВнешниеНаборыДанных.Вставить("ТаблицаРаздела8", ДанныеФилиалов.ТаблицаРаздела8);	//Сопоставление документов РТУ ОХ И ПТОХ
	ВнешниеНаборыДанных.Вставить("ТаблицаРаздела9", ДанныеФилиалов.ТаблицаРаздела9);	//Сопоставление документов РТУ ОХ И ПТОХ по номенклатуре

	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);	
	
КонецПроцедуры

Процедура ОтключитьИспользованиеСерииНоменклатуры(РодСтруктура)
	
	Для Каждого ЭлементСтруктуры Из РодСтруктура.Структура Цикл
		Если ЭлементСтруктуры.Структура.Количество() = 0 Тогда
			Для Каждого ЭлементПоляГруппировки Из ЭлементСтруктуры.ПоляГруппировки.Элементы Цикл
				Если Найти(Строка(ЭлементПоляГруппировки.Поле), "СерияНоменклатуры") > 0 Тогда
					ЭлементПоляГруппировки.Использование = Ложь;
				КонецЕсли;
			КонецЦикла;			
		Иначе
			ОтключитьИспользованиеСерииНоменклатуры(ЭлементСтруктуры);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьДанныеФилиалов()
	
	БазаФилиал = ПодключитьсяКБазе();
	Если БазаФилиал = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	УчитыватьСерии = ПолучитьЗначениеПараметра("УчитыватьСерии");
	
	ОтборПоКонтрагенту = ПолучитьЗначениеПараметра("Контрагент");
    Если ЗначениеЗаполнено(ОтборПоКонтрагенту) Тогда
		МассивКонтрагентов = Новый Массив;
		МассивКонтрагентовБазаФилиал = БазаФилиал.NewObject("Массив");
		Если ТипЗнч(ОтборПоКонтрагенту) = Тип("СписокЗначений") Тогда
			Для Каждого ЭлементСписка Из ОтборПоКонтрагенту Цикл
				МассивКонтрагентов.Добавить(ЭлементСписка.Значение.КодМДМ);
				МассивКонтрагентовБазаФилиал.Добавить(ЭлементСписка.Значение.КодМДМ);
			КонецЦикла;
		Иначе
			МассивКонтрагентов.Добавить(ОтборПоКонтрагенту.КодМДМ);
			МассивКонтрагентовБазаФилиал.Добавить(ОтборПоКонтрагенту.КодМДМ);
		КонецЕсли;
	КонецЕсли;	
	
	ОтборПоДоговору = ПолучитьЗначениеПараметра("ДоговорКонтрагента");
    Если ЗначениеЗаполнено(ОтборПоДоговору) Тогда
		МассивДоговоров = Новый Массив;
		МассивДоговоровБазаФилиал = БазаФилиал.NewObject("Массив");
		Если ТипЗнч(ОтборПоДоговору) = Тип("СписокЗначений") Тогда
			Для Каждого ЭлементСписка Из ОтборПоДоговору Цикл
				МассивДоговоров.Добавить(ЭлементСписка.Значение.КодМДМ);
				МассивДоговоровБазаФилиал.Добавить(ЭлементСписка.Значение.КодМДМ);
			КонецЦикла;
		Иначе
			МассивДоговоров.Добавить(ОтборПоДоговору.КодМДМ);
			МассивДоговоровБазаФилиал.Добавить(ОтборПоДоговору.КодМДМ);
		КонецЕсли;
	КонецЕсли;	
	
	ДатаНачала = СтруктураПараметров.Период.ДатаНачала;
	ДатаОкончания = СтруктураПараметров.Период.ДатаОкончания;
	
	Запрос = БазаФилиал.NewObject("Запрос");
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ВыкупСОтветственногоХраненияТовары.Ссылка.Контрагент.КодМДМ КАК КодМДМКонтрагента,
	               |	ВыкупСОтветственногоХраненияТовары.Ссылка КАК ГУИДФилиалВыкупа,
	               |	ВыкупСОтветственногоХраненияТовары.Ссылка.Номер КАК НомерФилиалВыкупа,
	               |	ВыкупСОтветственногоХраненияТовары.Ссылка.Дата КАК ДатаФилиалВыкупа,
	               |	ВыкупСОтветственногоХраненияТовары.Номенклатура.КодМДМ КАК КодМДМНоменклатуры,
	               |	СУММА(ВыкупСОтветственногоХраненияТовары.Количество) КАК КоличествоИсточника,
	               |	ВЫБОР
	               |		КОГДА &УчитыватьСерии
	               |			ТОГДА ВыкупСОтветственногоХраненияТовары.СерияНоменклатуры.НомерГТД.Код
	               |		ИНАЧЕ """"
	               |	КОНЕЦ КАК СерияНоменклатуры
	               |ИЗ
	               |	Документ.ВыкупСОтветственногоХранения.Товары КАК ВыкупСОтветственногоХраненияТовары
	               |ГДЕ
	               |	ВыкупСОтветственногоХраненияТовары.Ссылка.Дата >= &ДатаНачала
	               |	И ВыкупСОтветственногоХраненияТовары.Ссылка.Дата <= &ДатаОкончания
	               |	И ВыкупСОтветственногоХраненияТовары.Количество <> 0
	               |	И НЕ ВыкупСОтветственногоХраненияТовары.Ссылка.ПометкаУдаления
	               |	И &УсловиеПоКонтрагенту
	               |	И &УсловиеПоДоговору
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВыкупСОтветственногоХраненияТовары.Ссылка.Контрагент.КодМДМ,
	               |	ВЫБОР
	               |		КОГДА &УчитыватьСерии
	               |			ТОГДА ВыкупСОтветственногоХраненияТовары.СерияНоменклатуры.НомерГТД.Код
	               |		ИНАЧЕ """"
	               |	КОНЕЦ,
	               |	ВыкупСОтветственногоХраненияТовары.Номенклатура.КодМДМ,
	               |	ВыкупСОтветственногоХраненияТовары.Ссылка.Номер,
	               |	ВыкупСОтветственногоХраненияТовары.Ссылка.Дата,
	               |	ВыкупСОтветственногоХраненияТовары.Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВыкупСОтветственногоХраненияТовары.Ссылка.Контрагент.КодМДМ КАК КодМДМКонтрагента,
	               |	ВыкупСОтветственногоХраненияТовары.Ссылка КАК ГУИДФилиалВыкупа,
	               |	ВыкупСОтветственногоХраненияТовары.Ссылка.Номер КАК НомерФилиалВыкупа,
	               |	ВыкупСОтветственногоХраненияТовары.Ссылка.Дата КАК ДатаФилиалВыкупа,
	               |	ВыкупСОтветственногоХраненияТовары.ПометкаУдаления КАК ПометкаУдаления,
	               |	ВыкупСОтветственногоХраненияТовары.Проведен КАК Проведен
	               |ИЗ
	               |	Документ.ВыкупСОтветственногоХранения КАК ВыкупСОтветственногоХраненияТовары
	               |ГДЕ
	               |	ВыкупСОтветственногоХраненияТовары.Ссылка.Дата >= &ДатаНачала
	               |	И ВыкупСОтветственногоХраненияТовары.Ссылка.Дата <= &ДатаОкончания
	               |	И &УсловиеПоКонтрагенту
	               |	И &УсловиеПоДоговору
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВыкупСОтветственногоХраненияТовары.Ссылка.Контрагент.КодМДМ,
	               |	ВыкупСОтветственногоХраненияТовары.Ссылка,
	               |	ВыкупСОтветственногоХраненияТовары.Ссылка.Номер,
	               |	ВыкупСОтветственногоХраненияТовары.Ссылка.Дата,
	               |	ВыкупСОтветственногоХраненияТовары.ПометкаУдаления,
	               |	ВыкупСОтветственногоХраненияТовары.Проведен";
	
	Запрос.УстановитьПараметр("ДатаНачала", Макс(ДатаНачала, ДатаНачалаУчетаВФилиалах));
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	Запрос.УстановитьПараметр("УчитыватьСерии", УчитыватьСерии);
	
    Если ЗначениеЗаполнено(ОтборПоКонтрагенту) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоКонтрагенту", "ВыкупСОтветственногоХраненияТовары.Ссылка.Контрагент.КодМДМ В(&КодМДМКонтрагента)");
		Запрос.УстановитьПараметр("КодМДМКонтрагента", МассивКонтрагентовБазаФилиал);
	Иначе
		Запрос.УстановитьПараметр("УсловиеПоКонтрагенту", Истина);
	КонецЕсли;	
    Если ЗначениеЗаполнено(ОтборПоДоговору) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоДоговору", "ВыкупСОтветственногоХраненияТовары.Ссылка.ДоговорКонтрагента.КодМДМ = &КодМДМДоговораКонтрагента");
		Запрос.УстановитьПараметр("КодМДМДоговораКонтрагента", МассивДоговоровБазаФилиал);
	Иначе
		Запрос.УстановитьПараметр("УсловиеПоДоговору", Истина);
	КонецЕсли;	
	
	Запрос.Текст = ТекстЗапроса;	
	
	РезультатБазаФилиал = Запрос.ВыполнитьПакетСПромежуточнымиДанными();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВЫРАЗИТЬ("""" КАК СТРОКА(50)) КАК КодМДМКонтрагента,
	               |	ВЫРАЗИТЬ("""" КАК СТРОКА(50)) КАК ГУИДФилиалВыкупа,
	               |	ВЫРАЗИТЬ(ДАТАВРЕМЯ(1, 1, 1) КАК ДАТА) КАК ДатаФилиалВыкупа,
	               |	ВЫРАЗИТЬ("""" КАК СТРОКА(50)) КАК НомерФилиалВыкупа,
	               |	ВЫРАЗИТЬ("""" КАК СТРОКА(50)) КАК КодМДМНоменклатуры,
	               |	ВЫРАЗИТЬ(0 КАК ЧИСЛО(15, 3)) КАК КоличествоИсточника,
	               |	ВЫРАЗИТЬ("""" КАК СТРОКА(50)) КАК СерияНоменклатуры";
	Результат = Запрос.Выполнить();
	ТЗ = Результат.Выгрузить();
	ТЗ.Очистить();

	Выборка = РезультатБазаФилиал.Получить(0).Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТЗ.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.ГУИДФилиалВыкупа = БазаФилиал.XMLСтрока(Выборка.ГУИДФилиалВыкупа);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ТаблицаВыкуповИсточника.КодМДМКонтрагента КАК КодМДМКонтрагента,
	               |	ТаблицаВыкуповИсточника.ГУИДФилиалВыкупа КАК ГУИДФилиалВыкупа,
	               |	ТаблицаВыкуповИсточника.ДатаФилиалВыкупа КАК ДатаФилиалВыкупа,
	               |	ТаблицаВыкуповИсточника.НомерФилиалВыкупа КАК НомерФилиалВыкупа,
	               |	ТаблицаВыкуповИсточника.КодМДМНоменклатуры КАК КодМДМНоменклатуры,
	               |	ТаблицаВыкуповИсточника.СерияНоменклатуры КАК СерияНоменклатуры,
	               |	ТаблицаВыкуповИсточника.КоличествоИсточника КАК КоличествоИсточника
	               |ПОМЕСТИТЬ ВТТаблицаВыкуповИсточника
	               |ИЗ
	               |	&ТЗ КАК ТаблицаВыкуповИсточника
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВыкупСОтветственногоХраненияТовары.Номенклатура.КодМДМ КАК КодМДМНоменклатуры,
	               |	ВЫБОР
	               |		КОГДА &УчитыватьСерии
	               |			ТОГДА ВыкупСОтветственногоХраненияТовары.СерияНоменклатуры.НомерГТД.Код
	               |		ИНАЧЕ """"
	               |	КОНЕЦ КАК СерияНоменклатуры,
	               |	СУММА(ВыкупСОтветственногоХраненияТовары.Количество) КАК КоличествоПриемника,
	               |	ВыкупСОтветственногоХраненияТовары.Ссылка.ИДДокументаВСмежнойБазе
	               |ПОМЕСТИТЬ ВТТаблицаВыкуповПриемника
	               |ИЗ
	               |	Документ.ВыкупСОтветственногоХранения.Товары КАК ВыкупСОтветственногоХраненияТовары
	               |ГДЕ
	               |	ВыкупСОтветственногоХраненияТовары.Ссылка.Дата >= &ДатаНачала
	               |	И ВыкупСОтветственногоХраненияТовары.Ссылка.Дата <= &ДатаОкончания
	               |	И &УсловиеПоКонтрагенту
	               |	И &УсловиеПоДоговору
	               |	И НЕ ВыкупСОтветственногоХраненияТовары.Ссылка.ПометкаУдаления
	               |	И ВыкупСОтветственногоХраненияТовары.Ссылка.Филиал = &Филиал
	               |	И ВыкупСОтветственногоХраненияТовары.Ссылка.ИДДокументаВСмежнойБазе <> ""                                    ""
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВыкупСОтветственногоХраненияТовары.Номенклатура.КодМДМ,
	               |	ВЫБОР
	               |		КОГДА &УчитыватьСерии
	               |			ТОГДА ВыкупСОтветственногоХраненияТовары.СерияНоменклатуры.НомерГТД.Код
	               |		ИНАЧЕ """"
	               |	КОНЕЦ,
	               |	ВыкупСОтветственногоХраненияТовары.Ссылка.ИДДокументаВСмежнойБазе
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТТаблицаВыкуповИсточника.ГУИДФилиалВыкупа,
	               |	ВТТаблицаВыкуповИсточника.КодМДМНоменклатуры,
	               |	ВТТаблицаВыкуповИсточника.СерияНоменклатуры,
	               |	ВТТаблицаВыкуповИсточника.КоличествоИсточника КАК КоличествоИсточника,
	               |	0 КАК КоличествоПриемника
	               |ПОМЕСТИТЬ ВТТаблицаСопоставления
	               |ИЗ
	               |	ВТТаблицаВыкуповИсточника КАК ВТТаблицаВыкуповИсточника
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВТТаблицаВыкуповПриемника.ИДДокументаВСмежнойБазе,
	               |	ВТТаблицаВыкуповПриемника.КодМДМНоменклатуры,
	               |	ВТТаблицаВыкуповПриемника.СерияНоменклатуры,
	               |	0,
	               |	ВТТаблицаВыкуповПриемника.КоличествоПриемника
	               |ИЗ
	               |	ВТТаблицаВыкуповПриемника КАК ВТТаблицаВыкуповПриемника
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТТаблицаСопоставления.ГУИДФилиалВыкупа,
	               |	ВТТаблицаСопоставления.КодМДМНоменклатуры,
	               |	ВТТаблицаСопоставления.СерияНоменклатуры,
	               |	СУММА(ВТТаблицаСопоставления.КоличествоИсточника) КАК КоличествоИсточника,
	               |	СУММА(ВТТаблицаСопоставления.КоличествоПриемника) КАК КоличествоПриемника
	               |ПОМЕСТИТЬ ВТВремИтоги
	               |ИЗ
	               |	ВТТаблицаСопоставления КАК ВТТаблицаСопоставления
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТТаблицаСопоставления.ГУИДФилиалВыкупа,
	               |	ВТТаблицаСопоставления.КодМДМНоменклатуры,
	               |	ВТТаблицаСопоставления.СерияНоменклатуры
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	""Малые выкупы в ГП не соответствуют Малым выкупам в ОП"" КАК Раздел4,
	               |	ВТВремИтоги.ГУИДФилиалВыкупа КАК ГУИДФилиалВыкупаРаздел4,
	               |	ВТВремИтоги.КодМДМНоменклатуры КАК КодМДМНоменклатурыРаздел4,
	               |	ВТВремИтоги.СерияНоменклатуры КАК СерияНоменклатурыРаздел4,
	               |	ВТВремИтоги.КоличествоИсточника КАК КоличествоИсточникаРаздел4,
	               |	ВТВремИтоги.КоличествоПриемника КАК КоличествоПриемникаРаздел4,
	               |	ВТВремИтоги.КоличествоИсточника - ВТВремИтоги.КоличествоПриемника КАК ОтклонениеРаздел4,
	               |	ВыкупСОтветственногоХранения.Ссылка КАК ФилиалВыкупРаздел4,
	               |	Номенклатура.Ссылка КАК НоменклатураРаздел4,
	               |	ВТТаблицаВыкуповИсточника.ДатаФилиалВыкупа КАК ДатаФилиалВыкупаРаздел4,
	               |	ВТТаблицаВыкуповИсточника.НомерФилиалВыкупа КАК НомерФилиалВыкупаРаздел4,
	               |	ВЫБОР
	               |		КОГДА ВТТаблицаВыкуповИсточника.КодМДМКонтрагента ЕСТЬ NULL
	               |			ТОГДА ВыкупСОтветственногоХранения.Ссылка.Контрагент
	               |		ИНАЧЕ Контрагенты.Ссылка
	               |	КОНЕЦ КАК КонтрагентРаздел4
	               |ИЗ
	               |	ВТВремИтоги КАК ВТВремИтоги
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВыкупСОтветственногоХранения КАК ВыкупСОтветственногоХранения
	               |		ПО ВТВремИтоги.ГУИДФилиалВыкупа = ВыкупСОтветственногоХранения.ИДДокументаВСмежнойБазе
	               |			И (НЕ ВыкупСОтветственногоХранения.ПометкаУдаления)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	               |		ПО ВТВремИтоги.КодМДМНоменклатуры = Номенклатура.КодМДМ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТТаблицаВыкуповИсточника КАК ВТТаблицаВыкуповИсточника
	               |			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	               |			ПО (Контрагенты.КодМДМ = ВТТаблицаВыкуповИсточника.КодМДМКонтрагента)
	               |		ПО ВТВремИтоги.ГУИДФилиалВыкупа = ВТТаблицаВыкуповИсточника.ГУИДФилиалВыкупа
	               |			И ВТВремИтоги.КодМДМНоменклатуры = ВТТаблицаВыкуповИсточника.КодМДМНоменклатуры
	               |			И ВТВремИтоги.СерияНоменклатуры = ВТТаблицаВыкуповИсточника.СерияНоменклатуры
	               |ГДЕ
	               |	ВТВремИтоги.КоличествоИсточника <> ВТВремИтоги.КоличествоПриемника
	               |	И НЕ Номенклатура.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ТЗ", ТЗ);
	Запрос.УстановитьПараметр("Филиал", Филиал);
	Запрос.УстановитьПараметр("ДатаНачала", Макс(ДатаНачала, ДатаНачалаУчетаВФилиалах));
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	Запрос.УстановитьПараметр("УчитыватьСерии", УчитыватьСерии);
	
	Если ЗначениеЗаполнено(ОтборПоКонтрагенту) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоКонтрагенту", "ВыкупСОтветственногоХраненияТовары.Ссылка.Контрагент.КодМДМ В(&КодМДМКонтрагента)");
		Запрос.УстановитьПараметр("КодМДМКонтрагента", МассивКонтрагентов);
	Иначе
		Запрос.УстановитьПараметр("УсловиеПоКонтрагенту", Истина);
	КонецЕсли;	
    Если ЗначениеЗаполнено(ОтборПоДоговору) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоДоговору", "ВыкупСОтветственногоХраненияТовары.Ссылка.ДоговорКонтрагента.КодМДМ = &КодМДМДоговораКонтрагента");
		Запрос.УстановитьПараметр("КодМДМДоговораКонтрагента", МассивДоговоров);
	Иначе
		Запрос.УстановитьПараметр("УсловиеПоДоговору", Истина);
	КонецЕсли;	
	Запрос.Текст = ТекстЗапроса;	
	
	Результат = Запрос.Выполнить();
	ТаблицаРаздела4 = Результат.Выгрузить();
	Для Каждого Строка Из ТаблицаРаздела4 Цикл
		Если Не ЗначениеЗаполнено(Строка.НомерФилиалВыкупаРаздел4) Тогда
			ДокументВФилиале = БазаФилиал.Документы.ВыкупСОтветственногоХранения.ПолучитьСсылку(БазаФилиал.NewObject("УникальныйИдентификатор", СокрЛП(Строка.ГУИДФилиалВыкупаРаздел4)));
			Строка.НомерФилиалВыкупаРаздел4 = ДокументВФилиале.Номер;
			Строка.ДатаФилиалВыкупаРаздел4 = ДокументВФилиале.Дата;
			Строка.КонтрагентРаздел4 = Справочники.Контрагенты.НайтиПоРеквизиту("КодМДМ", ДокументВФилиале.Контрагент.КодМДМ);
		КонецЕсли;
	КонецЦикла;			

	//Раздел 5
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВЫРАЗИТЬ("""" КАК СТРОКА(50)) КАК КодМДМКонтрагента,
	               |	ВЫРАЗИТЬ("""" КАК СТРОКА(50)) КАК ГУИДФилиалВыкупа,
	               |	ВЫРАЗИТЬ(ДАТАВРЕМЯ(1, 1, 1) КАК ДАТА) КАК ДатаФилиалВыкупа,
	               |	ВЫРАЗИТЬ("""" КАК СТРОКА(50)) КАК НомерФилиалВыкупа,
	               |	ЛОЖЬ КАК Проведен,
	               |	ЛОЖЬ КАК ПометкаУдаления";

	Результат = Запрос.Выполнить();
	ТЗ = Результат.Выгрузить();
	ТЗ.Очистить();

	Выборка = РезультатБазаФилиал.Получить(1).Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТЗ.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.ГУИДФилиалВыкупа = БазаФилиал.XMLСтрока(Выборка.ГУИДФилиалВыкупа);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ТаблицаВыкуповИсточника.КодМДМКонтрагента КАК КодМДМКонтрагента,
	               |	ТаблицаВыкуповИсточника.ГУИДФилиалВыкупа КАК ГУИДФилиалВыкупа,
	               |	ТаблицаВыкуповИсточника.ДатаФилиалВыкупа КАК ДатаФилиалВыкупа,
	               |	ТаблицаВыкуповИсточника.НомерФилиалВыкупа КАК НомерФилиалВыкупа,
	               |	ТаблицаВыкуповИсточника.Проведен КАК Проведен,
	               |	ТаблицаВыкуповИсточника.ПометкаУдаления КАК ПометкаУдаления
	               |ПОМЕСТИТЬ ВТТаблицаВыкуповИсточника
	               |ИЗ
	               |	&ТЗ КАК ТаблицаВыкуповИсточника
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВыкупСОтветственногоХранения.Ссылка КАК ФилиалВыкупРаздел5,
	               |	ВыкупСОтветственногоХранения.ПометкаУдаления КАК ПометкаУдаленияРаздел5,
	               |	ВыкупСОтветственногоХранения.Проведен КАК ПроведенРаздел5,
	               |	ВТТаблицаВыкуповИсточника.Проведен КАК ПроведенФилиалВыкупРаздел5,
	               |	ВТТаблицаВыкуповИсточника.ПометкаУдаления КАК ПометкаУдаленияФилиалВыкупРаздел5,
	               |	ВТТаблицаВыкуповИсточника.ГУИДФилиалВыкупа КАК ГУИДФилиалВыкупаРаздел5,
	               |	ВТТаблицаВыкуповИсточника.ДатаФилиалВыкупа КАК ДатаФилиалВыкупаРаздел5,
	               |	ВТТаблицаВыкуповИсточника.НомерФилиалВыкупа КАК НомерФилиалВыкупаРаздел5,
	               |	ВЫБОР
	               |		КОГДА ВТТаблицаВыкуповИсточника.КодМДМКонтрагента ЕСТЬ NULL
	               |			ТОГДА ВыкупСОтветственногоХранения.Ссылка.Контрагент
	               |		ИНАЧЕ Контрагенты.Ссылка
	               |	КОНЕЦ КАК КонтрагентРаздел5,
	               |	ВЫБОР
	               |		КОГДА ВыкупСОтветственногоХранения.Ссылка <> НЕОПРЕДЕЛЕНО
	               |			ТОГДА ВЫБОР
	               |					КОГДА ВТТаблицаВыкуповИсточника.Проведен <> ВыкупСОтветственногоХранения.Проведен
	               |							ИЛИ ВТТаблицаВыкуповИсточника.ПометкаУдаления <> ВыкупСОтветственногоХранения.ПометкаУдаления
	               |						ТОГДА ИСТИНА
	               |					ИНАЧЕ ЛОЖЬ
	               |				КОНЕЦ
	               |		ИНАЧЕ ИСТИНА
	               |	КОНЕЦ КАК ОтклонениеРаздел5
	               |ПОМЕСТИТЬ ВТСопоставленияФилиалВыкупов
	               |ИЗ
	               |	ВТТаблицаВыкуповИсточника КАК ВТТаблицаВыкуповИсточника
	               |		ПОЛНОЕ СОЕДИНЕНИЕ Документ.ВыкупСОтветственногоХранения КАК ВыкупСОтветственногоХранения
	               |		ПО ВТТаблицаВыкуповИсточника.ГУИДФилиалВыкупа = ВыкупСОтветственногоХранения.ИДДокументаВСмежнойБазе
	               |			И (ВыкупСОтветственногоХранения.Ссылка.Дата >= &ДатаНачала)
	               |			И (ВыкупСОтветственногоХранения.Ссылка.Дата <= &ДатаОкончания)
	               |			И (ВыкупСОтветственногоХранения.Ссылка.Филиал = &Филиал)
	               |			И (&УсловиеПоКонтрагенту)
	               |			И (&УсловиеПоДоговору)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	               |		ПО (Контрагенты.КодМДМ = ВТТаблицаВыкуповИсточника.КодМДМКонтрагента)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	""Непроведенные, не помеченные на удаление Большие и Малые выкупы"" КАК Раздел5,
	               |	ВТСопоставленияФилиалВыкупов.ФилиалВыкупРаздел5,
	               |	ВТСопоставленияФилиалВыкупов.ДатаФилиалВыкупаРаздел5,
	               |	ВТСопоставленияФилиалВыкупов.НомерФилиалВыкупаРаздел5,
	               |	ВТСопоставленияФилиалВыкупов.ПометкаУдаленияРаздел5,
	               |	ВТСопоставленияФилиалВыкупов.ПроведенРаздел5,
	               |	ВТСопоставленияФилиалВыкупов.ПроведенФилиалВыкупРаздел5,
	               |	ВТСопоставленияФилиалВыкупов.ПометкаУдаленияФилиалВыкупРаздел5,
	               |	ВТСопоставленияФилиалВыкупов.КонтрагентРаздел5,
	               |	ВТСопоставленияФилиалВыкупов.ГУИДФилиалВыкупаРаздел5
	               |ИЗ
	               |	ВТСопоставленияФилиалВыкупов КАК ВТСопоставленияФилиалВыкупов
	               |ГДЕ
	               |	ВТСопоставленияФилиалВыкупов.ОтклонениеРаздел5 = ИСТИНА";
	
	Запрос.УстановитьПараметр("ТЗ", ТЗ);
	Запрос.УстановитьПараметр("Филиал", Филиал);
	Запрос.УстановитьПараметр("ДатаНачала", Макс(ДатаНачала, ДатаНачалаУчетаВФилиалах));
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);

	Если ЗначениеЗаполнено(ОтборПоКонтрагенту) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоКонтрагенту", "ВыкупСОтветственногоХранения.Ссылка.Контрагент.КодМДМ В(&КодМДМКонтрагента)");
		Запрос.УстановитьПараметр("КодМДМКонтрагента", МассивКонтрагентов);
	Иначе
		Запрос.УстановитьПараметр("УсловиеПоКонтрагенту", Истина);
	КонецЕсли;	
    Если ЗначениеЗаполнено(ОтборПоДоговору) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоДоговору", "ВыкупСОтветственногоХранения.Ссылка.ДоговорКонтрагента.КодМДМ = &КодМДМДоговораКонтрагента");
		Запрос.УстановитьПараметр("КодМДМДоговораКонтрагента", МассивДоговоров);
	Иначе
		Запрос.УстановитьПараметр("УсловиеПоДоговору", Истина);
	КонецЕсли;	
	Запрос.Текст = ТекстЗапроса;	
	
	Результат = Запрос.Выполнить();
	ТаблицаРаздела5 = Результат.Выгрузить();

	//Раздел 7. Сопоставление остатков регистра
	Запрос = БазаФилиал.NewObject("Запрос");
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ТоварыТОХпоДаннымПоставщиковОстатки.Контрагент.КодМДМ КАК КодМДМКонтрагента,
	               |	ТоварыТОХпоДаннымПоставщиковОстатки.Договор.КодМДМ КАК КодМДМДоговораКонтрагента,
	               |	ТоварыТОХпоДаннымПоставщиковОстатки.Номенклатура.КодМДМ КАК КодМДМНоменклатуры,
	               |	СУММА(ТоварыТОХпоДаннымПоставщиковОстатки.КоличествоОстаток) КАК Количество
	               |ПОМЕСТИТЬ ВТИтоги
	               |ИЗ
	               |	РегистрНакопления.ТоварыТОХпоДаннымПоставщиков.Остатки(
	               |			&ДатаОкончания,
	               |			&УсловиеПоКонтрагенту
	               |				И &УсловиеПоДоговору) КАК ТоварыТОХпоДаннымПоставщиковОстатки
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТоварыТОХпоДаннымПоставщиковОстатки.Номенклатура.КодМДМ,
	               |	ТоварыТОХпоДаннымПоставщиковОстатки.Контрагент.КодМДМ,
	               |	ТоварыТОХпоДаннымПоставщиковОстатки.Договор.КодМДМ
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ПоступлениеТоваровНаОХ.Ссылка.Контрагент.КодМДМ,
	               |	ПоступлениеТоваровНаОХ.Ссылка.ДоговорКонтрагента.КодМДМ,
	               |	ПоступлениеТоваровНаОХ.Номенклатура.КодМДМ,
	               |	СУММА(ПоступлениеТоваровНаОХ.Количество)
	               |ИЗ
	               |	Документ.ПоступлениеТоваровНаОтветственноеХранение.Товары КАК ПоступлениеТоваровНаОХ
	               |ГДЕ
	               |	&УсловиеПоКонтрагентуПТОХ И &УсловиеПоДоговоруПТОХ
	               |	И ПоступлениеТоваровНаОХ.Ссылка.Проведен
	               |	И ПоступлениеТоваровНаОХ.Ссылка.ДатаВходящегоДокумента <= &ДатаОкончания
