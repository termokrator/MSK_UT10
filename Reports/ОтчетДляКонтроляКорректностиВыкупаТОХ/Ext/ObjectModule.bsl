	               |	ИнформационныеБазыФилиалов.ИмяСервера,
	               |	ИнформационныеБазыФилиалов.ИмяИнформационнойБазы,
	               |	ИнформационныеБазыФилиалов.Логин,
	               |	ИнформационныеБазыФилиалов.Пароль
	               |ИЗ
	               |	РегистрСведений.ИнформационныеБазыФилиалов КАК ИнформационныеБазыФилиалов
	               |ГДЕ
	               |	ИнформационныеБазыФилиалов.Филиал = &Филиал";
	Запрос.УстановитьПараметр("Филиал", Филиал);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураПодключения, Выборка);
	КонецЕсли;
	
	Возврат СтруктураПодключения;
		
КонецФункции

Функция ПолучитьЗначениеПараметра(ИмяПараметра)
	
	ЗначениеПараметра = Неопределено;

	Параметр = КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти(ИмяПараметра);
	Если Параметр <> Неопределено  Тогда
		ЗначениеПараметра = Параметр.Значение;
	Иначе
		ПолеКомпоновкиДанных = Новый ПолеКомпоновкиДанных(ИмяПараметра);
		Для Каждого ЭлементОтбора Из КомпоновщикНастроек.Настройки.Отбор.Элементы Цикл
			Если ЭлементОтбора.ЛевоеЗначение = ПолеКомпоновкиДанных И ЭлементОтбора.Использование Тогда
				ЗначениеПараметра = ЭлементОтбора.ПравоеЗначение;
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;
	
	Возврат ЗначениеПараметра;
	
КонецФункции

Функция УстановитьЗначениеПараметра(ИмяПараметра, ЗначениеПараметра)
	
	Параметр = КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти(ИмяПараметра);
	Если Параметр <> Неопределено  Тогда
		Параметр.Значение = ЗначениеПараметра;
	Иначе
		ПолеКомпоновкиДанных = Новый ПолеКомпоновкиДанных(ИмяПараметра);
		Для Каждого ЭлементОтбора Из КомпоновщикНастроек.Настройки.Отбор.Элементы Цикл
			Если ЭлементОтбора.ЛевоеЗначение = ПолеКомпоновкиДанных И ЭлементОтбора.Использование Тогда
				ЭлементОтбора.ПравоеЗначение = ЗначениеПараметра;
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;
	
	Возврат ЗначениеПараметра;
	
КонецФункции

Функция УстановитьЗначениеОтбора(знач ИмяПараметра, ЗначениеПараметра)
	
	ИмяПараметра = СтрЗаменить(Имяпараметра, "Отбор", "");
	
	Для Каждого ЭлементОтбора Из КомпоновщикНастроек.Настройки.Отбор.Элементы Цикл
		Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПараметра) Тогда
			ЭлементОтбора.ПравоеЗначение = ЗначениеПараметра;
			ЭлементОтбора.Использование = Истина;
		КонецЕсли;
	КонецЦикла;	
	
	Возврат ЗначениеПараметра;
	
КонецФункции
