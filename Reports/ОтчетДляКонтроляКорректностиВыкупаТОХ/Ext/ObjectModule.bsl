Функция ПодключитьсяКБазе()
	
	СтруктураПодключения = ПолучитьПараметрыПодключения();

	v8 = Новый COMОбъект("V83.COMConnector");
	ПутьКБазе = СтрШаблон("Srvr=""%1"";Ref=""%2"";Usr=""%3"";Pwd = ""%4"";", 
		СтруктураПодключения.ИмяСервера, 
		СтруктураПодключения.ИмяИнформационнойБазы, 
		СтруктураПодключения.Логин, 
		СтруктураПодключения.Пароль);
		
	База = v8.Connect(ПутьКБазе);
	Возврат База;
		
КонецФункции

