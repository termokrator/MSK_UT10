		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ТоварыВЯчейкахОстатки.Номенклатура,
	ВЫБОР
		КОГДА &amp;ПроверятьКратностьФилиала
			ТОГДА ТоварыВЯчейкахОстатки.Номенклатура.КратностьФилиала
		ИНАЧЕ ТоварыВЯчейкахОстатки.Номенклатура.Кратность
	КОНЕЦ КАК Кратность
ПОМЕСТИТЬ ВТ_Номенклатура
ИЗ
	РегистрНакопления.ТоварыВЯчейках.Остатки(
			,
			ВЫБОР
				КОГДА &amp;ПроверятьКратностьФилиала
					ТОГДА Номенклатура.КратностьФилиала
				ИНАЧЕ Номенклатура.Кратность
			КОНЕЦ &gt; 1) КАК ТоварыВЯчейкахОстатки
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	ТоварыВЯчейкахОстатки.Склад,
	ТоварыВЯчейкахОстатки.Номенклатура,
	ТоварыВЯчейкахОстатки.Ячейка,
	СУММА(ТоварыВЯчейкахОстатки.КоличествоОстаток) КАК КоличествоОстаток,
	СУММА(ВЫРАЗИТЬ(ТоварыВЯчейкахОстатки.КоличествоОстаток / ВЫБОР
				КОГДА &amp;ПроверятьКратностьФилиала
					ТОГДА ТоварыВЯчейкахОстатки.Номенклатура.КратностьФилиала
				ИНАЧЕ ТоварыВЯчейкахОстатки.Номенклатура.Кратность
			КОНЕЦ КАК ЧИСЛО(15, 0))) КАК ЦелаяЧастьДеления,
	СУММА(ТоварыВЯчейкахОстатки.КоличествоОстаток / ВЫБОР
			КОГДА &amp;ПроверятьКратностьФилиала
				ТОГДА ТоварыВЯчейкахОстатки.Номенклатура.КратностьФилиала
			ИНАЧЕ ТоварыВЯчейкахОстатки.Номенклатура.Кратность
		КОНЕЦ - (ВЫРАЗИТЬ(ТоварыВЯчейкахОстатки.КоличествоОстаток / ВЫБОР
				КОГДА &amp;ПроверятьКратностьФилиала
					ТОГДА ТоварыВЯчейкахОстатки.Номенклатура.КратностьФилиала
				ИНАЧЕ ТоварыВЯчейкахОстатки.Номенклатура.Кратность
			КОНЕЦ КАК ЧИСЛО(15, 0)))) КАК ДробнаяЧасть
ПОМЕСТИТЬ ВТ_Промежуточная
ИЗ
	РегистрНакопления.ТоварыВЯчейках.Остатки(
			,
			Номенклатура В
				(ВЫБРАТЬ
					ВТ_Номенклатура.Номенклатура
				ИЗ
					ВТ_Номенклатура КАК ВТ_Номенклатура)) КАК ТоварыВЯчейкахОстатки
ГДЕ
	НЕ ТоварыВЯчейкахОстатки.КоличествоОстаток / ВЫБОР
				КОГДА &amp;ПроверятьКратностьФилиала
					ТОГДА ТоварыВЯчейкахОстатки.Номенклатура.КратностьФилиала
				ИНАЧЕ ТоварыВЯчейкахОстатки.Номенклатура.Кратность
			КОНЕЦ - (ВЫРАЗИТЬ(ТоварыВЯчейкахОстатки.КоличествоОстаток / ВЫБОР
					КОГДА &amp;ПроверятьКратностьФилиала
						ТОГДА ТоварыВЯчейкахОстатки.Номенклатура.КратностьФилиала
					ИНАЧЕ ТоварыВЯчейкахОстатки.Номенклатура.Кратность
				КОНЕЦ КАК ЧИСЛО(15, 0))) = 0

СГРУППИРОВАТЬ ПО
	ТоварыВЯчейкахОстатки.Склад,
	ТоварыВЯчейкахОстатки.Номенклатура,
	ТоварыВЯчейкахОстатки.Ячейка
;

