	ЦеныНоменклатурыСрезПоследних.Номенклатура
ПОМЕСТИТЬ ТоварыСНаличиемЦен
ИЗ
	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
			,
			ТипЦен В
				(ВЫБРАТЬ
					ТаблТиповЦен.ТипЦены
				ИЗ
					ТаблТиповЦен)) КАК ЦеныНоменклатурыСрезПоследних
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ТоварыНаСкладахОстатки.Номенклатура,
	ЕСТЬNULL(ВЫБОР
			КОГДА ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0) &lt;= ЕСТЬNULL(ТоварыВЯчейкахОстатки.КоличествоОстаток, 0) - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0) + ЕСТЬNULL(ТоварыВСборкеОстатки.СобраноОстаток, 0) + ЕСТЬNULL(ТоварыВСборкеОстатки.КСборкеОстаток, 0)
				ТОГДА ТоварыНаСкладахОстатки.КоличествоОстаток
			ИНАЧЕ ТоварыВЯчейкахОстатки.КоличествоОстаток - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0) + ЕСТЬNULL(ТоварыВСборкеОстатки.СобраноОстаток, 0) + ЕСТЬNULL(ТоварыВСборкеОстатки.КСборкеОстаток, 0)
		КОНЕЦ, 0) КАК Остаток
ПОМЕСТИТЬ Остатки
ИЗ
	РегистрНакопления.ТоварыНаСкладах.Остатки(
			,
			Склад В
					(ВЫБРАТЬ
						КонстОсновнойСклад.ОсновнойСклад
					ИЗ
						КонстОсновнойСклад)
				И ВЫБОР
					КОГДА &amp;ТолькоСОстатком
						ТОГДА ИСТИНА
					ИНАЧЕ Номенклатура В
							(ВЫБРАТЬ
								ТоварыСНаличиемЦен.Номенклатура
							ИЗ
								ТоварыСНаличиемЦен)
				КОНЕЦ) КАК ТоварыНаСкладахОстатки
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(
				,
				Склад В
					(ВЫБРАТЬ
						КонстОсновнойСклад.ОсновнойСклад
					ИЗ
						КонстОсновнойСклад)) КАК ТоварыВРезервеНаСкладахОстатки
		ПО ТоварыНаСкладахОстатки.Номенклатура = ТоварыВРезервеНаСкладахОстатки.Номенклатура
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВСборке.Остатки КАК ТоварыВСборкеОстатки
		ПО ТоварыНаСкладахОстатки.Номенклатура = ТоварыВСборкеОстатки.Номенклатура
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках.Остатки(, НЕ Ячейка.НеУчитыватьВОперативномУчете) КАК ТоварыВЯчейкахОстатки
		ПО ТоварыНаСкладахОстатки.Номенклатура = ТоварыВЯчейкахОстатки.Номенклатура
ГДЕ
	ВЫБОР
			КОГДА &amp;ТолькоСОстатком
				ТОГДА ЕСТЬNULL(ВЫБОР
							КОГДА ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0) &lt;= ЕСТЬNULL(ТоварыВЯчейкахОстатки.КоличествоОстаток, 0) - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0) + ЕСТЬNULL(ТоварыВСборкеОстатки.СобраноОстаток, 0) + ЕСТЬNULL(ТоварыВСборкеОстатки.КСборкеОстаток, 0)
								ТОГДА ТоварыНаСкладахОстатки.КоличествоОстаток
							ИНАЧЕ ТоварыВЯчейкахОстатки.КоличествоОстаток - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0) + ЕСТЬNULL(ТоварыВСборкеОстатки.СобраноОстаток, 0) + ЕСТЬNULL(ТоварыВСборкеОстатки.КСборкеОстаток, 0)
						КОНЕЦ, 0) &gt; 0
			ИНАЧЕ ИСТИНА
		КОНЕЦ
;

