			<dataPath>Комментарий</dataPath>
			<field>Комментарий</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Статус</dataPath>
			<field>Статус</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Номер</dataPath>
			<field>Номер</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Номенклатура</dataPath>
			<field>Номенклатура</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Сумма</dataPath>
			<field>Сумма</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Контрагент</dataPath>
			<field>Контрагент</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Грузополучатель</dataPath>
			<field>Грузополучатель</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Ссылка</dataPath>
			<field>Ссылка</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ЗаявкаНаВозврат.Дата,
	ЗаявкаНаВозврат.Реализация,
	ЗаявкаНаВозврат.Номер,
	ЗаявкаНаВозврат.Статус,
	ЗаявкаНаВозврат.Комментарий,
	ЗаявкаНаВозвратТовары.Номенклатура,
	ЗаявкаНаВозвратТовары.Количество,
	ЗаявкаНаВозвратТовары.Сумма,
	РеализацияТоваровУслуг.Контрагент,
	РеализацияТоваровУслуг.Грузополучатель,
	ЗаявкаНаВозврат.Ссылка
ИЗ
	Документ.ЗаявкаНаВозврат.Товары КАК ЗаявкаНаВозвратТовары
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаВозврат КАК ЗаявкаНаВозврат
			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
			ПО ЗаявкаНаВозврат.Реализация = РеализацияТоваровУслуг.Ссылка
		ПО ЗаявкаНаВозвратТовары.Ссылка = ЗаявкаНаВозврат.Ссылка
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК НоменклатураСпр
		ПО ЗаявкаНаВозвратТовары.Номенклатура = НоменклатураСпр.Ссылка
ГДЕ
	ВЫБОР
			КОГДА &amp;Параметр &lt;&gt; ""
				ТОГДА  НоменклатураСпр.НаименованиеПолное ПОДОБНО "%" + &amp;Параметр + "%"
						ИЛИ НоменклатураСпр.КодПроизводителя ПОДОБНО "%" + &amp;Параметр + "%"
						ИЛИ НоменклатураСпр.Артикул ПОДОБНО "%" + &amp;Параметр + "%"
						ИЛИ НоменклатураСпр.НормализованныйКод ПОДОБНО "%" + &amp;Параметр + "%" 
			ИНАЧЕ ЛОЖЬ
		КОНЕЦ</query>
	</dataSet>
