		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ТоварыВРезервеНаСкладахОстатки.Номенклатура,
	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва КАК ЗаказПокупателя,
	ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток КАК КоличествоРезерв
ПОМЕСТИТЬ Резервы
ИЗ
	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки КАК ТоварыВРезервеНаСкладахОстатки
ГДЕ
	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва ССЫЛКА Документ.ЗаказПокупателя
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗаказыПокупателейОстатки.ЗаказПокупателя,
	ЕСТЬNULL(ЗаказыПокупателейОстатки.КоличествоОстаток, 0) КАК КоличествоЗаказано,
	ЗаказыПокупателейОстатки.Номенклатура
ПОМЕСТИТЬ ЗаказыПокупателей
ИЗ
	РегистрНакопления.ЗаказыПокупателей.Остатки(
			,
			ЗаказПокупателя В
					(ВЫБРАТЬ
						Резервы.ЗаказПокупателя
					ИЗ
						Резервы КАК Резервы)
				И Номенклатура В
					(ВЫБРАТЬ
						Резервы.Номенклатура
					ИЗ
						Резервы КАК Резервы)) КАК ЗаказыПокупателейОстатки
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Резервы.Номенклатура,
	Резервы.ЗаказПокупателя,
	СУММА(Резервы.КоличествоРезерв) КАК КоличествоРезерв,
	СУММА(ЕСТЬNULL(ЗаказыПокупателей.КоличествоЗаказано, 0)) КАК КоличествоЗаказано,
	Резервы.КоличествоРезерв - ЕСТЬNULL(ЗаказыПокупателей.КоличествоЗаказано, 0) КАК Дельта
ИЗ
	Резервы КАК Резервы
		ЛЕВОЕ СОЕДИНЕНИЕ ЗаказыПокупателей КАК ЗаказыПокупателей
		ПО Резервы.ЗаказПокупателя = ЗаказыПокупателей.ЗаказПокупателя
			И Резервы.Номенклатура = ЗаказыПокупателей.Номенклатура
ГДЕ
	Резервы.КоличествоРезерв - ЕСТЬNULL(ЗаказыПокупателей.КоличествоЗаказано, 0) &gt; 0

СГРУППИРОВАТЬ ПО
	Резервы.Номенклатура,
	Резервы.ЗаказПокупателя,
	Резервы.КоличествоРезерв - ЕСТЬNULL(ЗаказыПокупателей.КоличествоЗаказано, 0)</query>
	</dataSet>
	<totalField>
