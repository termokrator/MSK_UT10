		<group>Номенклатура</group>
	</totalField>
	<totalField>
		<dataPath>Цена</dataPath>
		<expression>Максимум(Цена)</expression>
		<group>Номенклатура</group>
	</totalField>
	<totalField>
		<dataPath>ЦенаСРЗВ</dataPath>
		<expression>Максимум(ЦенаСРЗВ)</expression>
		<group>Номенклатура</group>
	</totalField>
	<totalField>
		<dataPath>Наценка</dataPath>
