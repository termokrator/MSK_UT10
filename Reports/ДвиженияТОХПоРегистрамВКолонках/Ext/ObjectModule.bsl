		|	ВТ_Общая.Раздел
		|ИЗ
		|	ВТ_Общая КАК ВТ_Общая
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_Общая.Склад,
		|	ВТ_Общая.Номенклатура,
		|	ВЫБОР
		|		КОГДА ВТ_Общая.Склад = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
		|			ТОГДА 10
		|		КОГДА ВТ_Общая.Склад = &ОсновнойСклад
		|			ТОГДА 11
		|		ИНАЧЕ ПОДСТРОКА(ВТ_Общая.Склад.Наименование, 1, 10)
		|	КОНЕЦ,
		|	ВТ_Общая.Раздел";
	
	Запрос.УстановитьПараметр("ОсновнойСклад", ОсновнойСклад);  
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	Если тзСтрокаДокумент = Неопределено Тогда
		
		Запрос.УстановитьПараметр("Момент", Неопределено);
		Запрос.УстановитьПараметр("НачалоПериодаВыкупа", Неопределено);
		
	Иначе
		Запрос.УстановитьПараметр("Момент", тзСтрокаДокумент.Регистратор.МоментВремени()); 
	КонецЕсли;
		
	Запрос.УстановитьПараметр("Склады", МассивСклады);
	
	РезультатЗапроса = Запрос.Выполнить();      
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции // ()

Процедура ЗаполнитьОстаткиНаНачалоВыкуп(тзСтрокаДокумент, Номенклатура, Склад)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТоварыОрганизацийМТОстаткиИОбороты.Склад КАК Склад,
		|	ТоварыОрганизацийМТОстаткиИОбороты.Номенклатура КАК Номенклатура,
		|	ТоварыОрганизацийМТОстаткиИОбороты.КоличествоОстаток КАК МТНачОст
		|ИЗ
		|	РегистрНакопления.ТоварыОрганизацийМТ.Остатки(&НачалоПериодаВыкупа, Склад = &Склад И Номенклатура = &Номенклатура) КАК ТоварыОрганизацийМТОстаткиИОбороты";
	
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("НачалоПериодаВыкупа", тзСтрокаДокумент.Регистратор.НачалоПериода);
	
	РезультатЗапроса = Запрос.Выполнить();      
	
	Если Не РезультатЗапроса.Пустой() Тогда
	
		Выборка = РезультатЗапроса.Выбрать();  
		
		Выборка.Следующий();
		тзСтрокаДокумент.МТНачОст = Выборка.МТНачОст;
	
	КонецЕсли;
	
КонецПроцедуры

Процедура РасчетВычисляемыхПолей(тзСтрока, ТолькоОстатки)  
	
	Если тзСтрока.Раздел = "ТОХ" Тогда
		
		тзСтрока.ТОХМинусПерНачОст = тзСтрока.ТОХНачОст - тзСтрока.ТОХПерНачОст;
		тзСтрока.ТОХМинусПерКонОст = тзСтрока.ТОХКонОст - тзСтрока.ТОХПерКонОст;
		
		тзСтрока.ТовСклМинусТОХНачОст = тзСтрока.ОснСклНачОст - тзСтрока.ТОХМинусПерНачОст;
		тзСтрока.ТовСклМинусТОХКонОст = тзСтрока.ОснСклКонОст - тзСтрока.ТОХМинусПерКонОст;
		
		// Вычисление доп.метрик по ТОХ и основному складу
		//тзСтрока.Скл1ТОХПостТОХКонОст = тзСтрока.ТОХПостКонОст - тзСтрока.ТОХКонОст;     // М3
		//тзСтрока.Скл1ТовСклМтТОХПостТОХПерКонОст = тзСтрока.Скл1ТовСклМтТОХПостТОХПерКонОст - тзСтрока.МТКонОст - тзСтрока.ТОХПостКонОст + тзСтрока.ТОХПерКонОст;   // М2 
		
		Если Не ТолькоОстатки Тогда
			
			тзСтрока.ТОХМинусПерПриход    = тзСтрока.ТОХПриход - тзСтрока.ТОХПерПриход;
			тзСтрока.ТОХМинусПерРасход    = тзСтрока.ТОХРасход - тзСтрока.ТОХПерРасход;
			тзСтрока.ТовСклМинусТОХПриход = тзСтрока.ОснСклПриход - тзСтрока.ТОХМинусПерПриход;
			тзСтрока.ТовСклМинусТОХРасход = тзСтрока.ОснСклРасход - тзСтрока.ТОХМинусПерРасход;  
		
		КонецЕсли;             
		
	ИначеЕсли тзСтрока.Склад = ОсновнойСклад Тогда
		
		Если тзСтрока.Раздел = "Склад" Тогда
		
			// Вычисление доп.метрик по ТОХ и основному складу     
			//тзСтрока.Скл1ТовСклМтТОХПостТОХПерКонОст = тзСтрока.ТовСклКонОст;    // М2
		
		ИначеЕсли тзСтрока.Раздел = "МТ" Тогда
		
			// Вычисление доп.метрик по ТОХ и основному складу     
			//тзСтрока.Скл1ТовСклМтТОХПостТОХПерКонОст = -тзСтрока.МТКонОст;
			//тзСтрока.Скл1МТКонОст = тзСтрока.МТКонОст;       // М1 
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

