Процедура ЗаполнениеТаблицыССериями(дзДокументы, тзРезультатНов)
	
	тзДокумент    = тзРезультатНов.Скопировать();
	тзПустыеСерии = тзРезультатНов.Скопировать();
	
	Для каждого СтрокаДокумент Из дзДокументы Цикл        // СтрокаДокумент
		
		тзДокумент.Очистить();  
		тзПустыеСерии.Очистить();

		Для каждого СтрокаСерия Из СтрокаДокумент.Строки Цикл         // СтрокаСерия
		
			Для каждого СтрокаСклад Из СтрокаСерия.Строки Цикл         // СтрокаСклад
			
				ДобСтрока = тзДокумент.Добавить();
				ЗаполнитьЗначенияСвойств(ДобСтрока, СтрокаСклад);        
				
				Если СтрокаСклад.СерияНоменклатуры.Пустая() Тогда
					
					ДобСтрока = тзПустыеСерии.Добавить();
					ЗаполнитьЗначенияСвойств(ДобСтрока, СтрокаСклад);        
					
				КонецЕсли;
					
			КонецЦикла;

		КонецЦикла;
			
		//Для каждого СтрокаДокумент Из тзСтрокаДокумент.Строки Цикл      
		//	
		//	ДобСтрока = тзРезультатНов.Добавить();
		//	ЗаполнитьЗначенияСвойств(ДобСтрока, СтрокаДокумент);
		//	
		//КонецЦикла;
		
	КонецЦикла;   // дзДокументы    
	

КонецПроцедуры

