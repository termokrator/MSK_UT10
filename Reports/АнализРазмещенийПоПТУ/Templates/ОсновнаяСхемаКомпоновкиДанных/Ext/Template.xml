////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВложенныйЗапрос.ПТУ КАК ПТУ,
	ВложенныйЗапрос.Номенклатура КАК Номенклатура,
	МАКСИМУМ(ВложенныйЗапрос.КоличествоЯчеек) КАК КоличествоЯчеек,
	МАКСИМУМ(ВложенныйЗапрос.КоличествоРазмещений) КАК КоличествоРазмещений
ПОМЕСТИТЬ ВТ_ЯчейкиИРазмещения
ИЗ
	(ВЫБРАТЬ
		ВТ_ПТУ.ПТУ КАК ПТУ,
		ТоварыВЯчейкахОстаткиИОбороты.Номенклатура КАК Номенклатура,
		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ТоварыВЯчейкахОстаткиИОбороты.Ячейка) КАК КоличествоЯчеек,
		NULL КАК КоличествоРазмещений
	ИЗ
		ВТ_ПТУ КАК ВТ_ПТУ
			ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках КАК ТоварыВЯчейкахОстаткиИОбороты
			ПО ВТ_ПТУ.ПТУ = ТоварыВЯчейкахОстаткиИОбороты.Регистратор.ДокументОснование
				И (НЕ ВЫРАЗИТЬ(ТоварыВЯчейкахОстаткиИОбороты.Регистратор КАК Документ.РазмещениеПоЯчейкам).Ссылка ЕСТЬ NULL)
	
	СГРУППИРОВАТЬ ПО
		ТоварыВЯчейкахОстаткиИОбороты.Номенклатура,
		ВТ_ПТУ.ПТУ
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		ВТ_ПТУ.ПТУ,
		ТоварыВЯчейкахОстаткиИОбороты.Номенклатура,
		NULL,
		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ТоварыВЯчейкахОстаткиИОбороты.Регистратор)
	ИЗ
		ВТ_ПТУ КАК ВТ_ПТУ
			ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках КАК ТоварыВЯчейкахОстаткиИОбороты
			ПО ВТ_ПТУ.ПТУ = ТоварыВЯчейкахОстаткиИОбороты.Регистратор.ДокументОснование
				И (НЕ ВЫРАЗИТЬ(ТоварыВЯчейкахОстаткиИОбороты.Регистратор КАК Документ.РазмещениеПоЯчейкам).Ссылка ЕСТЬ NULL)
	
	СГРУППИРОВАТЬ ПО
		ТоварыВЯчейкахОстаткиИОбороты.Номенклатура,
		ВТ_ПТУ.ПТУ) КАК ВложенныйЗапрос

СГРУППИРОВАТЬ ПО
	ВложенныйЗапрос.ПТУ,
	ВложенныйЗапрос.Номенклатура

ИНДЕКСИРОВАТЬ ПО
	ПТУ,
	Номенклатура
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ПТУ.ПТУ КАК ПТУ,
	ТоварыВЯчейкахОстаткиИОбороты.Регистратор КАК Размещение,
	ТоварыВЯчейкахОстаткиИОбороты.Номенклатура,
	ТоварыВЯчейкахОстаткиИОбороты.Ячейка,
	СУММА(ТоварыВЯчейкахОстаткиИОбороты.КоличествоОборот) КАК КоличествоОборот,
	ВТ_ЯчейкиИРазмещения.КоличествоЯчеек,
	ВТ_ЯчейкиИРазмещения.КоличествоРазмещений
ПОМЕСТИТЬ ВТ_РазмещённыеТовары
ИЗ
	ВТ_ПТУ КАК ВТ_ПТУ
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках.ОстаткиИОбороты(, , Регистратор, , ) КАК ТоварыВЯчейкахОстаткиИОбороты
			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЯчейкиИРазмещения КАК ВТ_ЯчейкиИРазмещения
			ПО ТоварыВЯчейкахОстаткиИОбороты.Регистратор.ДокументОснование = ВТ_ЯчейкиИРазмещения.ПТУ
				И ТоварыВЯчейкахОстаткиИОбороты.Номенклатура = ВТ_ЯчейкиИРазмещения.Номенклатура
		ПО ВТ_ПТУ.ПТУ = ТоварыВЯчейкахОстаткиИОбороты.Регистратор.ДокументОснование
			И (НЕ ВЫРАЗИТЬ(ТоварыВЯчейкахОстаткиИОбороты.Регистратор КАК Документ.РазмещениеПоЯчейкам).Ссылка ЕСТЬ NULL)

СГРУППИРОВАТЬ ПО
	ВТ_ПТУ.ПТУ,
	ТоварыВЯчейкахОстаткиИОбороты.Регистратор,
	ТоварыВЯчейкахОстаткиИОбороты.Номенклатура,
	ВТ_ЯчейкиИРазмещения.КоличествоЯчеек,
	ВТ_ЯчейкиИРазмещения.КоличествоРазмещений,
	ТоварыВЯчейкахОстаткиИОбороты.Ячейка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ПТУ.ПТУ КАК ПТУ,
	ПоступлениеТоваровУслугТовары.Номенклатура КАК Номенклатура,
	СУММА(ПоступлениеТоваровУслугТовары.Количество) КАК Количество
ПОМЕСТИТЬ ВТ_ТоварыПТУ
ИЗ
	ВТ_ПТУ КАК ВТ_ПТУ
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг.Товары КАК ПоступлениеТоваровУслугТовары
		ПО ВТ_ПТУ.ПТУ = ПоступлениеТоваровУслугТовары.Ссылка

СГРУППИРОВАТЬ ПО
	ВТ_ПТУ.ПТУ,
	ПоступлениеТоваровУслугТовары.Номенклатура

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВТ_ПТУ.ПТУ,
	ПТОХТовары.Номенклатура,
	СУММА(ПТОХТовары.Количество)
ИЗ
	ВТ_ПТУ КАК ВТ_ПТУ
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровНаОтветственноеХранение.Товары КАК ПТОХТовары
		ПО ВТ_ПТУ.ПТУ = ПТОХТовары.Ссылка

СГРУППИРОВАТЬ ПО
	ВТ_ПТУ.ПТУ,
	ПТОХТовары.Номенклатура

ИНДЕКСИРОВАТЬ ПО
	ПТУ,
	Номенклатура
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ТоварыПТУ.Номенклатура КАК Номенклатура,
	ВТ_ТоварыПТУ.ПТУ КАК ПТУ,
	ВТ_РазмещённыеТовары.Размещение.Ответственный КАК Ответственный,
	ВТ_РазмещённыеТовары.Размещение,
	ВТ_РазмещённыеТовары.Ячейка,
	ВТ_ТоварыПТУ.Количество КАК КоличествоВПТУ,
	ВТ_РазмещённыеТовары.КоличествоОборот КАК КоличествоРазмещено,
	ВТ_РазмещённыеТовары.КоличествоЯчеек,
	ВТ_РазмещённыеТовары.КоличествоРазмещений
ИЗ
	ВТ_ТоварыПТУ КАК ВТ_ТоварыПТУ
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РазмещённыеТовары КАК ВТ_РазмещённыеТовары
		ПО ВТ_ТоварыПТУ.Номенклатура = ВТ_РазмещённыеТовары.Номенклатура
			И ВТ_ТоварыПТУ.ПТУ = ВТ_РазмещённыеТовары.ПТУ
ГДЕ
	(ВТ_РазмещённыеТовары.КоличествоЯчеек &gt; 1
			ИЛИ ВТ_РазмещённыеТовары.КоличествоРазмещений &gt; 1)

УПОРЯДОЧИТЬ ПО
	ПТУ,
	Номенклатура</query>
