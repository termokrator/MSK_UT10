<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>КоличествоПоездокВОдномДокументе</dataPath>
			<field>КоличествоПоездокВОдномДокументе</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Количество поездок</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Водитель</dataPath>
			<field>Водитель</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Водитель</v8:content>
				</v8:item>
			</title>
			<valueType>
				<v8:Type xmlns:d5p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d5p1:CatalogRef.ФизическиеЛица</v8:Type>
			</valueType>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Ссылка</dataPath>
			<field>Ссылка</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Задание на развоз</v8:content>
				</v8:item>
			</title>
			<valueType>
				<v8:Type xmlns:d5p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d5p1:DocumentRef.ЗаданиеНаДоставку</v8:Type>
			</valueType>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ТарифыДоставки</dataPath>
			<field>ТарифыДоставки</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Тарифы доставки</v8:content>
				</v8:item>
			</title>
			<presentationExpression>"Тариф """+Строка(ТарифыДоставки)+""""</presentationExpression>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Вес</dataPath>
			<field>Вес</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Вес</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Объем</dataPath>
			<field>Объем</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Объем</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаданиеНаДоставкуДоставка.Контрагент) КАК КоличествоПоездокВОдномДокументе,
	ЗаданиеНаДоставкуДоставка.Ссылка,
	ВЫБОР
		КОГДА ЗаданиеНаДоставкуДоставка.Ссылка.Водитель.ИндивидуальныйПредприниматель = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
			ТОГДА ЗаданиеНаДоставкуДоставка.Ссылка.Маршрут.ТарифДоставкиШтат
		ИНАЧЕ ЗаданиеНаДоставкуДоставка.Ссылка.Маршрут.ТарифДоставкиДляИП
	КОНЕЦ КАК ТарифыДоставки
ПОМЕСТИТЬ ВТ_КолВДокументе
ИЗ
	Документ.ЗаданиеНаДоставку.Доставка КАК ЗаданиеНаДоставкуДоставка
ГДЕ
	ЗаданиеНаДоставкуДоставка.Ссылка.Проведен
{ГДЕ
	(ЗаданиеНаДоставкуДоставка.Ссылка.Дата МЕЖДУ &amp;Дата1 И &amp;Дата2)}

СГРУППИРОВАТЬ ПО
	ЗаданиеНаДоставкуДоставка.Ссылка,
	ВЫБОР
		КОГДА ЗаданиеНаДоставкуДоставка.Ссылка.Водитель.ИндивидуальныйПредприниматель = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
			ТОГДА ЗаданиеНаДоставкуДоставка.Ссылка.Маршрут.ТарифДоставкиШтат
		ИНАЧЕ ЗаданиеНаДоставкуДоставка.Ссылка.Маршрут.ТарифДоставкиДляИП
	КОНЕЦ
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_КолВДокументе.Ссылка,
	ПогрузкаВАвтоПогружено.Грузоместо
ПОМЕСТИТЬ ВТ_ГрузоместаПоЗаданию
ИЗ
	ВТ_КолВДокументе КАК ВТ_КолВДокументе
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПогрузкаВАвто.Погружено КАК ПогрузкаВАвтоПогружено
		ПО ВТ_КолВДокументе.Ссылка = ПогрузкаВАвтоПогружено.Ссылка.ЗаданиеНаДоставку
ГДЕ
	ПогрузкаВАвтоПогружено.Грузоместо.Погружено
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	ВТ_ГрузоместаПоЗаданию.Ссылка,
	СУММА(ГрузовоеМестоТовары.Количество * ГрузовоеМестоТовары.Номенклатура.ЕдиницаХраненияОстатков.Вес) КАК Вес,
	СУММА(ГрузовоеМестоТовары.Количество * ГрузовоеМестоТовары.Номенклатура.ЕдиницаХраненияОстатков.Объем) КАК Объем
ПОМЕСТИТЬ ВТ_ВесИОбъемПоЗаданию
ИЗ
	ВТ_ГрузоместаПоЗаданию КАК ВТ_ГрузоместаПоЗаданию
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ГрузовоеМесто.Товары КАК ГрузовоеМестоТовары
		ПО ВТ_ГрузоместаПоЗаданию.Грузоместо = ГрузовоеМестоТовары.Ссылка

СГРУППИРОВАТЬ ПО
	ВТ_ГрузоместаПоЗаданию.Ссылка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	ЗаданиеНаДоставку.Водитель
ПОМЕСТИТЬ Водители
ИЗ
	Документ.ЗаданиеНаДоставку КАК ЗаданиеНаДоставку
ГДЕ
	ЗаданиеНаДоставку.Ссылка В
			(ВЫБРАТЬ
				ВТ_КолВДокументе.Ссылка
			ИЗ
				ВТ_КолВДокументе КАК ВТ_КолВДокументе)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Водители.Водитель,
	СУММА(ВТ_КолВДокументе.КоличествоПоездокВОдномДокументе) КАК КоличествоПоездокВОдномДокументе,
	ВТ_КолВДокументе.Ссылка,
	ВЫБОР
		КОГДА ВТ_КолВДокументе.ТарифыДоставки = ЗНАЧЕНИЕ(Справочник.ТарифыДоставки.ПустаяСсылка)
			ТОГДА "Не указан"
		ИНАЧЕ ВТ_КолВДокументе.ТарифыДоставки.Наименование
	КОНЕЦ КАК ТарифыДоставки,
	СУММА(ВТ_ВесИОбъемПоЗаданию.Вес) КАК Вес,
	СУММА(ВТ_ВесИОбъемПоЗаданию.Объем) КАК Объем
ИЗ
	ВТ_КолВДокументе КАК ВТ_КолВДокументе
		ЛЕВОЕ СОЕДИНЕНИЕ Водители КАК Водители
		ПО ВТ_КолВДокументе.Ссылка.Водитель = Водители.Водитель
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ВесИОбъемПоЗаданию КАК ВТ_ВесИОбъемПоЗаданию
		ПО ВТ_КолВДокументе.Ссылка = ВТ_ВесИОбъемПоЗаданию.Ссылка

СГРУППИРОВАТЬ ПО
	Водители.Водитель,
	ВТ_КолВДокументе.Ссылка,
	ВЫБОР
		КОГДА ВТ_КолВДокументе.ТарифыДоставки = ЗНАЧЕНИЕ(Справочник.ТарифыДоставки.ПустаяСсылка)
			ТОГДА "Не указан"
		ИНАЧЕ ВТ_КолВДокументе.ТарифыДоставки.Наименование
	КОНЕЦ</query>
	</dataSet>
	<totalField>
		<dataPath>КоличествоПоездокВОдномДокументе</dataPath>
		<expression>Сумма(КоличествоПоездокВОдномДокументе)</expression>
	</totalField>
	<totalField>
		<dataPath>Вес</dataPath>
		<expression>Сумма(Вес)</expression>
	</totalField>
	<totalField>
		<dataPath>Объем</dataPath>
		<expression>Сумма(Объем)</expression>
	</totalField>
