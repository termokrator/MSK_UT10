Процедура ВыполнитьРаботу(Интерактивно = Ложь) Экспорт 
	
	Если Не ЗначениеЗаполнено(ДатаОтчета) Тогда 
		ДатаОтчета = ТекущаяДата();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Константы.ГруппаMILES.Получить()) Тогда 
		
		ТекстСообщения = "Не заполнена константа 'Группа MILES'!";
		
		#Если Клиент Тогда
			Сообщить(ТекстСообщения, СтатусСообщения.Важное);
		#Иначе
			ЗаписьЖурналаРегистрации("РассылкаДневногоОтчета", УровеньЖурналаРегистрации.Информация, , , ТекстСообщения);
		#КонецЕсли
		
		Возврат;
		
	КонецЕсли;	
	
	ОсновнойСклад = Константы.ОсновнойСклад.Получить();
	
	Если ОтправлятьНаЭлектроннуюПочту Тогда 	
		
		УчетнаяЗаписьЭлектроннойПочты = Константы.ОсновнаяУчетнаяЗаписьЭлектроннойПочты.Получить();
		
		Если НЕ ЗначениеЗаполнено(УчетнаяЗаписьЭлектроннойПочты) Тогда 
			
			ТекстСообщения = "Не заполнена константа основной записи электронной почты!";
			
			#Если Клиент Тогда
				Сообщить(ТекстСообщения, СтатусСообщения.Важное);
			#Иначе
				ЗаписьЖурналаРегистрации("РассылкаДневногоОтчета", УровеньЖурналаРегистрации.Информация, , , ТекстСообщения);
			#КонецЕсли
			
			Возврат;
			
		КонецЕсли;		
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Пользователи.Ссылка КАК КонтрагентСсылка,
		|	ЕСТЬNULL(КонтактнаяИнформация.Представление, """") КАК АдресЭлектроннойПочтыПользователяДляРассылкиОтчета
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КатегорииОбъектов КАК КатегорииОбъектов
		|			ПО КонтактнаяИнформация.Объект = КатегорииОбъектов.Объект
		|				И (КатегорииОбъектов.Категория = ЗНАЧЕНИЕ(Справочник.КатегорииОбъектов.ОтправлятьДневнойОтчет))
		|		ПО (КонтактнаяИнформация.Объект = Пользователи.ФизЛицо.Ссылка)
		|			И (КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты))
		|			И (КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.EmailРабочийФизическогоЛица))
		|ГДЕ
		|	(ВЫРАЗИТЬ(ЕСТЬNULL(КонтактнаяИнформация.Представление, """""""") КАК СТРОКА(200))) <> """"""""";
		
		ТаблицаЭлектронныхАдресовДляОтправки = Запрос.Выполнить().Выгрузить();
		
		Если Не Интерактивно И ТаблицаЭлектронныхАдресовДляОтправки.Количество() = 0 Тогда 
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	//Марков И. 10.07.2024 #UT10-4592 Изменен параметр отбора СборкаЗаказовПокупателя с "Дата" на "ВремяОкончанияСборки"
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ТоварыНаСкладахОстатки.Номенклатура), 0) КАК КоличествоРазличныхАртикуловНаКонецДня
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(&Д, Склад = &Склад) КАК ТоварыНаСкладахОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(КОЛИЧЕСТВО(РазмещениеПоЯчейкамТовары.НомерСтроки), 0) КАК КоличествоПринятоПаллета
	|ИЗ
	|	Документ.РазмещениеПоЯчейкам.Товары КАК РазмещениеПоЯчейкамТовары
	|ГДЕ
	|	РазмещениеПоЯчейкамТовары.Ссылка.Дата МЕЖДУ &Дата1 И &Дата2
	|	И РазмещениеПоЯчейкамТовары.Ссылка.Проведен
	|	И РазмещениеПоЯчейкамТовары.Ссылка.ПалетноеХранение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(КОЛИЧЕСТВО(РазмещениеПоЯчейкамТовары.НомерСтроки), 0) КАК КоличествоПринятоНЕПаллета
	|ИЗ
	|	Документ.РазмещениеПоЯчейкам.Товары КАК РазмещениеПоЯчейкамТовары
	|ГДЕ
	|	РазмещениеПоЯчейкамТовары.Ссылка.Дата МЕЖДУ &Дата1 И &Дата2
	|	И РазмещениеПоЯчейкамТовары.Ссылка.Проведен
	|	И НЕ РазмещениеПоЯчейкамТовары.Ссылка.ПалетноеХранение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(КОЛИЧЕСТВО(ПеремещениеТовараПоЯчейкамТовары.НомерСтроки), 0) КАК КоличествоСтрокПеремещено
	|ИЗ
	|	Документ.ПеремещениеТовараПоЯчейкам.Товары КАК ПеремещениеТовараПоЯчейкамТовары
	|ГДЕ
	|	ПеремещениеТовараПоЯчейкамТовары.Ссылка.Проведен
	|	И ПеремещениеТовараПоЯчейкамТовары.Ссылка.Дата МЕЖДУ &Дата1 И &Дата2
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(КОЛИЧЕСТВО(СборкаЗаказовПокупателяЗаказано.НомерСтроки), 0) КАК КоличествоНеСобрано
	|ИЗ
	|	Документ.СборкаЗаказовПокупателя.Заказано КАК СборкаЗаказовПокупателяЗаказано
	|ГДЕ
	|	СборкаЗаказовПокупателяЗаказано.Ссылка.Проведен
	|	И СборкаЗаказовПокупателяЗаказано.Ссылка.ВремяОкончанияСборки МЕЖДУ &Дата1 И &Дата2
	|	И СборкаЗаказовПокупателяЗаказано.Ссылка.ДокументСобранИУпакован = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ВЫБОР
	|			КОГДА КорректировкаСборкиЗаказовПокупателяТовары.Ячейка = &ЯчейкаДоВыяснения
	|				ТОГДА КОЛИЧЕСТВО(КорректировкаСборкиЗаказовПокупателяТовары.НомерСтроки)
	|			ИНАЧЕ 0
	|		КОНЕЦ, 0) КАК КоличествоСборокВЯчейку_ДоВыяснения
	|ИЗ
	|	Документ.КорректировкаСборкиЗаказовПокупателя.Товары КАК КорректировкаСборкиЗаказовПокупателяТовары
	|ГДЕ
	|	КорректировкаСборкиЗаказовПокупателяТовары.Ссылка.Проведен
	|	И КорректировкаСборкиЗаказовПокупателяТовары.Ссылка.Дата МЕЖДУ &Дата1 И &Дата2
	|	И КорректировкаСборкиЗаказовПокупателяТовары.Ячейка = &ЯчейкаДоВыяснения
	|
	|СГРУППИРОВАТЬ ПО
	|	КорректировкаСборкиЗаказовПокупателяТовары.Ячейка
	|;
