	|ПОМЕСТИТЬ Вт_1
	|ИЗ
	|	РегистрНакопления.ЗаказыПоставщикам.Остатки(&Д, ЗаказПоставщику.Склад = &Склад) КАК ЗаказыПоставщикамОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаказПоставщикуТовары.Ссылка,
	|	ЗаказПоставщикуТовары.Номенклатура,
	|	ЗаказПоставщикуТовары.Заказ
	|ПОМЕСТИТЬ ВТ_2
	|ИЗ
	|	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
	|ГДЕ
	|	ЗаказПоставщикуТовары.Ссылка В
	|			(ВЫБРАТЬ
	|				Вт_1.ЗаказПоставщику
	|			ИЗ
	|				Вт_1 КАК Вт_1)
	|	И ЗаказПоставщикуТовары.Номенклатура В
	|			(ВЫБРАТЬ
	|				Вт_1.Номенклатура
	|			ИЗ
	|				Вт_1 КАК Вт_1)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_2.Номенклатура
	|ИЗ
	|	ВТ_2 КАК ВТ_2
	|ГДЕ
	|	ВТ_2.Заказ = НЕОПРЕДЕЛЕНО";
	
	Запрос.УстановитьПараметр("Д", КонецДня(ДатаОтчета));
	Запрос.УстановитьПараметр("Склад", ОсновнойСклад);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	МассивСНужнойНоменклатурой = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		МассивСНужнойНоменклатурой.Добавить(Выборка.Номенклатура);
	КонецЦикла;
	
	// Получили массив нужной номенклатуры. Теперь определяем для неё СВОБОДНЫЙ остаток. И если он = 0 -> это то , что нужно!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СУММА(ТоварыНаСкладахОстатки.КоличествоОстаток - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0)) КАК СвободныйОстаткок,
	|	ТоварыНаСкладахОстатки.Номенклатура
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(
	|			&Д,
	|			Склад = &ОсновнойСклад
	|				И Номенклатура В (&МассивНоменклатуры)) КАК ТоварыНаСкладахОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(&Д, Склад = &ОсновнойСклад) КАК ТоварыВРезервеНаСкладахОстатки
	|		ПО ТоварыНаСкладахОстатки.Номенклатура = ТоварыВРезервеНаСкладахОстатки.Номенклатура
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыНаСкладахОстатки.Номенклатура";
	
	Запрос.УстановитьПараметр("Д", КонецДня(ДатаОтчета) );
	Запрос.УстановитьПараметр("ОсновнойСклад", ОсновнойСклад );
	Запрос.УстановитьПараметр("МассивНоменклатуры", МассивСНужнойНоменклатурой);
	
	ТаблицаСвободныхОстатков = Запрос.Выполнить().Выгрузить();
	Выборка = Результат.Выбрать();
	ЖдуРазъяснений = 0;
	
	Для Каждого ТекСтр из МассивСНужнойНоменклатурой Цикл 
		
		СтрокаТЗ = ТаблицаСвободныхОстатков.Найти(ТекСтр);
		
		Если СтрокаТЗ = Неопределено Тогда 
			ЖдуРазъяснений = ЖдуРазъяснений + 1;
		Иначе 
			
			Если СтрокаТЗ.СвободныйОстаткок = 0 Тогда 
				ЖдуРазъяснений = ЖдуРазъяснений + 1;	
			КонецЕсли;
			
		КонецЕсли;
		
		
	КонецЦикла;
	
	ТабДок = Новый ТабличныйДокумент;
	
	Макет = ПолучитьМакет("Макет");
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	ОбластьМакета.Параметры.Заг = "Данные на конец дня : " + Формат(ДатаОтчета, "ДФ = dd.MM.yyyy");
	
	ТабДок.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Строка");
	ОбластьМакета.Параметры.ОстаткиНаКонецДня = ОстаткиНаКонецДня;
	ОбластьМакета.Параметры.КоличествоСтрокПринятоНЕПаллета = КоличествоСтрокПринятоНЕПаллета;
	ОбластьМакета.Параметры.КоличествоСтрокПринятоПаллета = КоличествоСтрокПринятоПаллета;
	ОбластьМакета.Параметры.КоличествоСтрокПеремещено = КоличествоСтрокПеремещено;
	ОбластьМакета.Параметры.КоличествоНеСобрано = КоличествоНеСобрано;
	ОбластьМакета.Параметры.ПринятоСобраноПеремещено = ПринятоСобраноПеремещено;
	ОбластьМакета.Параметры.КоличествоСборокВЯчейку_ДоВыяснения = КоличествоСборокВЯчейку_ДоВыяснения;
	ОбластьМакета.Параметры.КоличествоРаботающихСотрудников = КоличествоРаботающихСотрудников;
	ОбластьМакета.Параметры.СредняяЭффективностьСотрудниковСклада = СредняяЭффективностьСотрудниковСклада;
	ОбластьМакета.Параметры.ОборотЗаДень_RUB = ОборотЗаДень_RUB;
	ОбластьМакета.Параметры.ОборотЗаДень_Евро = ОборотЗаДень_Евро;
	ОбластьМакета.Параметры.ОборотЗаМесяц_RUB = ОборотЗаМесяц_RUB;
	ОбластьМакета.Параметры.ОборотЗаМесяц_Евро = ОборотЗаМесяц_Евро;
	ОбластьМакета.Параметры.ВаловаяПрибыльЗаДень_RUB = ВаловаяПрибыльЗаДень_RUB;
	ОбластьМакета.Параметры.ВаловаяПрибыльЗаДень_Евро = ВаловаяПрибыльЗаДень_Евро;
	ОбластьМакета.Параметры.ВаловаяПрибыльЗаМесяц_RUB = ВаловаяПрибыльЗаМесяц_RUB;
	ОбластьМакета.Параметры.ВаловаяПрибыльЗаМесяц_Евро = ВаловаяПрибыльЗаМесяц_Евро;
	ОбластьМакета.Параметры.Рентабельность_EUR = Рентабельность_EUR;
	ОбластьМакета.Параметры.КоличествоСработавшихКлиентов = КоличествоСработавшихКлиентов;
	ОбластьМакета.Параметры.КоличествоСработавшихКлиентовЗаТекущийМесяц = КоличествоСработавшихКлиентовЗаТекущийМесяц;
	ОбластьМакета.Параметры.КоличествоСработавшихКлиентовЗаГод = КоличествоСработавшихКлиентовЗаГод;
	ОбластьМакета.Параметры.ОборотПоБрендуMILES = ОборотПоБрендуMILES;
	ОбластьМакета.Параметры.ГрузополучателиКупилиБрэндMILESЗаДень = ГрузополучателиКупилиБрэндMILESЗаДень;
	ОбластьМакета.Параметры.ГрузополучателиКупилиБрэндMILESЗаМесяц = ГрузополучателиКупилиБрэндMILESЗаМесяц;
	ОбластьМакета.Параметры.ГрузополучателиКупилиБрэндMILESЗаГод = ГрузополучателиКупилиБрэндMILESЗаГод;
	
	ОбластьМакета.Параметры.ЖдуРазъяснений = ЖдуРазъяснений;
	
	ОбластьМакета.Параметры.КоличествоСтрокСобрано = КоличествоСтрокСобрано;
	ОбластьМакета.Параметры.КоличествоСтрокВЗаказеПоставщику = КоличествоСтрокВЗаказеПоставщику;
	
	ТабДок.Вывести(ОбластьМакета);
	
	Если Интерактивно Тогда 
		ТабДок.Показать();
	КонецЕсли;
	
	Если ОтправлятьНаЭлектроннуюПочту И ТаблицаЭлектронныхАдресовДляОтправки.Количество() > 0 Тогда 
		
		ИмяТекущегоФайла = "ДневнойОтчетНа" + "_" + Формат(Год(ДатаОтчета), "ЧГ = 0") + "_" + Прав("0" + Месяц(ДатаОтчета), 2) + "_" + Прав("0" + День(ДатаОтчета), 2) + Перечисления.ТипыФайловРассылок.XLSx;		
		ИмяТекущегоФайла = СтрЗаменить(ИмяТекущегоФайла, ":", "_");
		ПолноеИмяФайла = КаталогВременныхФайлов() + ИмяТекущегоФайла;
		
		ТабДок.Записать(ПолноеИмяФайла, ТипФайлаТабличногоДокумента.XLSX); 
		
		Для каждого ТекАдрес Из ТаблицаЭлектронныхАдресовДляОтправки Цикл
			
			Профиль = УправлениеЭлектроннойПочтой.ПолучитьИнтернетПочтовыйПрофиль(УчетнаяЗаписьЭлектроннойПочты);
			Почта = Новый ИнтернетПочта; 
			УдалосьПодключиться = Ложь;
			
			Попытка
				
				Почта.Подключиться(Профиль);
				УдалосьПодключиться = Истина;
				
			Исключение
				
				ТекстСообщения = "Не удалось подключиться к учетной записи электронной почты " + УчетнаяЗаписьЭлектроннойПочты;
				
				#Если Клиент Тогда
					ТекстЛога = ТекстЛога + Символы.ПС + " ERR: " + ТекстСообщения;
				#Иначе
					ЗаписьЖурналаРегистрации("РассылкаДневногоОтчета", УровеньЖурналаРегистрации.Информация, , , ТекстСообщения);
				#КонецЕсли 
				
			КонецПопытки;
			
			Сообщение = Новый ИнтернетПочтовоеСообщение;
			Сообщение.Тема = "Дневной отчет на " + Формат(ДатаОтчета, "ДФ = dd.MM.yyyy");
			Сообщение.Получатели.Добавить(ТекАдрес.АдресЭлектроннойПочтыПользователяДляРассылкиОтчета); 
			Сообщение.Отправитель = УчетнаяЗаписьЭлектроннойПочты.АдресЭлектроннойПочты;
			
			УспешноОтправленПоПочте = Ложь;
			
			Попытка
				
				Файл = Новый Файл(ПолноеИмяФайла);
				
				Если Файл.Существует() Тогда
					
					Сообщение.Вложения.Добавить(ПолноеИмяФайла);
					Почта.Послать(Сообщение);
					ТекстСообщения = "Отправлен дневной отчет на дату " + Формат(ДатаОтчета, "ДФ = dd.MM.yyyy") + " на адрес " + ТекАдрес.АдресЭлектроннойПочтыПользователяДляРассылкиОтчета;
					
					#Если Клиент Тогда
						Сообщить(ТекстСообщения);
					#Иначе
						ЗаписьЖурналаРегистрации("РассылкаДневногоОтчета", УровеньЖурналаРегистрации.Информация, , , ТекстСообщения);
					#КонецЕсли
					
				КонецЕсли;
				
			Исключение
				
				ТекстСообщения = "Не удалось отправить письмос дневной отчет на дату " + Формат(ДатаОтчета, "ДФ = dd.MM.yyyy") + " на адрес " + ТекАдрес.АдресЭлектроннойПочтыПользователяДляРассылкиОтчета;
				
				#Если Клиент Тогда
					Сообщить(ТекстСообщения);
				#Иначе
					ЗаписьЖурналаРегистрации("РассылкаДневногоОтчета", УровеньЖурналаРегистрации.Информация, , , ТекстСообщения);
				#КонецЕсли
				
			КонецПопытки;
			
		КонецЦикла;
		
	КонецЕсли;
	
	
КонецПроцедуры

Функция ПолучитьТЗ(НачПериода)
	
	ТабДок = Новый ТабличныйДокумент;	
	
	СКД = ПолучитьМакет("ОборотыИВаловка");
	
	СКД.НастройкиПоУмолчанию.ПараметрыДанных.Элементы[0].Значение = НачПериода;
	СКД.НастройкиПоУмолчанию.ПараметрыДанных.Элементы[0].Использование = Истина;
	СКД.НастройкиПоУмолчанию.ПараметрыДанных.Элементы[1].Значение = КонецДня(ДатаОтчета); 
	СКД.НастройкиПоУмолчанию.ПараметрыДанных.Элементы[1].Использование = Истина;
	
	Если НЕ СписокКонтрагентов.Количество() = 0 Тогда
		
		СКД.НастройкиПоУмолчанию.ПараметрыДанных.Элементы[2].Значение = СписокКонтрагентов; 
		СКД.НастройкиПоУмолчанию.ПараметрыДанных.Элементы[2].Использование = Истина;
		НовыйФильтр = СКД.НастройкиПоУмолчанию.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		НовыйФильтр.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке;
		НовыйФильтр.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Контрагент"); 
		НовыйФильтр.ПравоеЗначение = СписокКонтрагентов;
		НовыйФильтр.Использование = Истина;
		
	КонецЕсли;
	
	КомпановщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпановщикНастроек.ЗагрузитьНастройки(СКД.НастройкиПоУмолчанию);
	
	КомпановщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпановки = КомпановщикМакета.Выполнить(СКД, СКД.НастройкиПоУмолчанию, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпановкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпановкиДанных.Инициализировать(МакетКомпановки, , , Истина);
	
	ТЗ = Новый ТаблицаЗначений;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(ТЗ);
	ПроцессорВывода.Вывести(ПроцессорКомпановкиДанных);
	
	Возврат ТЗ;
	
КонецФункции

Процедура ВосстановитьНастройкиРегламентаИзСтруктуры(СохраненнаяНастройка) Экспорт
	
	СохраненнаяНастройка.Свойство("СписокКонтрагентов", СписокКонтрагентов);
	
КонецПроцедуры

Процедура СохранитьНастройкиРегламентаВСтруктуру(СохраненнаяНастройка) Экспорт
	
	СохраненнаяНастройка.Вставить("СписокКонтрагентов", СписокКонтрагентов);
	
КонецПроцедуры