;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВЫБОР
		КОГДА ВТ_ОстаткиНАСкладах.Номенклатура = NULL
			ТОГДА ВЫБОР
					КОГДА ВТ_ОстаткиВЯчейках.Номенклатура = NULL
						ТОГДА ВТ_Собрано.Номенклатура
					ИНАЧЕ ВТ_ОстаткиВЯчейках.Номенклатура
				КОНЕЦ
		ИНАЧЕ ВТ_ОстаткиНАСкладах.Номенклатура
	КОНЕЦ КАК Номенклатура,
	ЕСТЬNULL(ВТ_ОстаткиВЯчейках.ОстатокЯчейки, 0) КАК ОстаткиВЯчейках,
	ЕСТЬNULL(ВТ_ОстаткиНАСкладах.ОстатокНаСкладах, 0) КАК ОстаткиНаСкладах,
	ЕСТЬNULL(ВТ_Собрано.ОстатокСобрано, 0) КАК ОстаткиСобрано,
	ВЫБОР
		КОГДА ВТ_ОстаткиНАСкладах.Номенклатура = NULL
			ТОГДА ВЫБОР
					КОГДА ВТ_ОстаткиВЯчейках.Номенклатура = NULL
						ТОГДА ВТ_Собрано.Номенклатура.КодПроизводителя
					ИНАЧЕ ВТ_ОстаткиВЯчейках.Номенклатура.КодПроизводителя
				КОНЕЦ
		ИНАЧЕ ВТ_ОстаткиНАСкладах.Номенклатура.КодПроизводителя
	КОНЕЦ КАК КодПроизводителя,
	ЕСТЬNULL(ВТ_Собрано.КСборкеОстаток, 0) КАК ОстатокКСборке,
	ЕСТЬNULL(ВТ_ОстаткиНАСкладах.ОстатокНаСкладах, 0) - (ЕСТЬNULL(ВТ_Собрано.ОстатокСобрано, 0) + ЕСТЬNULL(ВТ_Собрано.КСборкеОстаток, 0) + ЕСТЬNULL(ВТ_ОстаткиВЯчейках.ОстатокЯчейки, 0)) КАК Дельта
ИЗ
	ВТ_ОстаткиНАСкладах КАК ВТ_ОстаткиНАСкладах
		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_ОстаткиВЯчейках КАК ВТ_ОстаткиВЯчейках
		ПО ВТ_ОстаткиНАСкладах.Номенклатура = ВТ_ОстаткиВЯчейках.Номенклатура
		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_Собрано КАК ВТ_Собрано
		ПО ВТ_ОстаткиНАСкладах.Номенклатура = ВТ_Собрано.Номенклатура</query>
