Перем мПериод          Экспорт; // Период движений
Перем мТаблицаДвижений Экспорт; // Таблица движений
Перем МетаданныеДокумента, МетаданныеТабЧасти, ИмяДокумента, ИмяТабличнойЧасти, ИмяТаблицы, Заголовок, СтруктураШапкиДокумента, Отказ; 

// Выполняет приход по регистру.
//
// Параметры:
//  Нет.
//
Процедура ВыполнитьПриход() Экспорт

	ОбщегоНазначения.ВыполнитьДвижениеПоРегистру(ЭтотОбъект, ВидДвиженияНакопления.Приход);

КонецПроцедуры // ВыполнитьПриход()

// Выполняет расход по регистру.
//
// Параметры:
//  Нет.
//
Процедура ВыполнитьРасход() Экспорт

	ОбщегоНазначения.ВыполнитьДвижениеПоРегистру(ЭтотОбъект, ВидДвиженияНакопления.Расход);

КонецПроцедуры // ВыполнитьРасход()

// Выполняет движения по регистру.
//
// Параметры:
//  Нет.
//
Процедура ВыполнитьДвижения() Экспорт

	Загрузить(мТаблицаДвижений);

КонецПроцедуры // ВыполнитьДвижения()

// Процедура контролирует остаток по данному регистру по переданному документу
// и его табличной части. В случае недостатка товаров выставляется флаг отказа и 
// выдается сообщение.
//
// Параметры:
//  ДокументОбъект     - объект проводимого документа, 
//  ТабЯчеек        	- таблица значений, 
//  СтруктураШапки     - структура, содержащая значения "через точку" ссылочных реквизитов по шапке документа,
//  ОтказПроведения    - флаг отказа в проведении,
//  ЗаголовокСообщения - строка, заголовок сообщения об ошибке проведения.
Процедура КонтрольОстатков(ДокументОбъект, ТабЯчеек, СтруктураШапки, ОтказПроведения, ЗаголовокСообщения) Экспорт
		
	МетаданныеДокумента = ДокументОбъект.Метаданные();
	ИмяДокумента        = МетаданныеДокумента.Имя;
	
	Если ИмяДокумента = "КорректировкаПоступления" ИЛИ ИмяДокумента = "ВыкупСОтветственногоХранения" Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ВидДвижения", ВидДвиженияНакопления.Расход);
		Запрос.УстановитьПараметр("МоментВремени", ДокументОбъект.МоментВремени());
		Запрос.УстановитьПараметр("ТЗ", ТабЯчеек);
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТЗ.Номенклатура КАК Номенклатура,
		|	ТЗ.Склад КАК Склад,
		|	ТЗ.Ячейка КАК Ячейка,
		|	ТЗ.ВидДвижения КАК ВидДвижения,
		|	ТЗ.Количество КАК Количество
		|ПОМЕСТИТЬ ТЗ
		|ИЗ
		|	&ТЗ КАК ТЗ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТЗ.Номенклатура,
		|	ТЗ.Склад,
		|	ТЗ.Ячейка,
		|	СУММА(ТЗ.Количество) КАК Количество
		|ПОМЕСТИТЬ ТЗСвернутая
		|ИЗ
		|	ТЗ КАК ТЗ
		|ГДЕ
		|	ТЗ.ВидДвижения = &ВидДвижения
		|
		|СГРУППИРОВАТЬ ПО
		|	ТЗ.Склад,
		|	ТЗ.Ячейка,
		|	ТЗ.Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТЗСвернутая.Номенклатура,
		|	ТЗСвернутая.Склад,
		|	ТЗСвернутая.Ячейка,
		|	ЕСТЬNULL(ТоварыВЯчейкахОстатки.КоличествоОстаток, 0) - ТЗСвернутая.Количество КАК Количество,
		|	ТоварыВЯчейкахОстатки.КоличествоОстаток КАК Свободно,
		|	ТЗСвернутая.Количество КАК Требуется
		|ИЗ
		|	ТЗСвернутая КАК ТЗСвернутая,
		|	РегистрНакопления.ТоварыВЯчейках.Остатки(
		|			&МоментВремени,
		|			(Номенклатура, Склад, Ячейка) В
		|				(ВЫБРАТЬ
		|					ТЗСвернутая.Номенклатура,
		|					ТЗСвернутая.Склад,
		|					ТЗСвернутая.Ячейка
		|				ИЗ
		|					ТЗСвернутая КАК ТЗСвернутая)) КАК ТоварыВЯчейкахОстатки
		|ГДЕ
		|	ЕСТЬNULL(ТоварыВЯчейкахОстатки.КоличествоОстаток, 0) - ТЗСвернутая.Количество < 0
		|
		|ДЛЯ ИЗМЕНЕНИЯ";
		
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ОтказПроведения = Истина;
			СтрокаСообщения = "Остатка товара "+ Выборка.Номенклатура +" на складе "+ Выборка.Склад + " в ячейке "+ Выборка.Ячейка+" недостаточно.";
			УправлениеЗапасами.ОшибкаНетОстатка(СтрокаСообщения, Выборка.Свободно , Выборка.Требуется, "", ОтказПроведения, Заголовок);
		КонецЦикла;
		
	Иначе
		// Сообщить("Для документа "+ДокументОбъект+" не предусмотрен вызов процедуры 'Контроль остатков' модуля регистра 'Товары на складах'");
	КонецЕсли;

КонецПроцедуры // КонтрольОстатков()

