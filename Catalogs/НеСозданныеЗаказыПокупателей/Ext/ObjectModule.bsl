
Процедура ПриКопировании(ОбъектКопирования)
	
	Наименование = "";
	Addres = "";
	AddresFakt = "";
	AddresFaktID = "";
	Comment = "";
	DogovorID = "";
	FilialID = "";
	FirmID = "";
	INN = "";
	KontragentID = "";
	KPP = "";
	Mail = "";	
	TipDost = "";
	ValutaID = "";
	Дата = Дата(1,1,1);	
	Причина	 = "";
	ЗаказПокупателяСсылка = Документы.ЗаказПокупателя.ПустаяСсылка();
	SkladID	= 0;
	PaymentType	= 0;
	
	Товары.Очистить();

КонецПроцедуры

Функция ПустойСтороннийСклад(НовыйДокЗаказ)
	
	Результат = Ложь;	
	
	Если НЕ ЗначениеЗаполнено(НовыйДокЗаказ.IDСклада_СтороннийСклад)  Тогда
		
		Результат = МСК.ЭтоСтороннийСклад(НовыйДокЗаказ.IDСклада);		
		
		Если НЕ Результат Тогда
			Возврат Результат;
		КонецЕсли; 
		
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(НовыйДокЗаказ.IDСклада) И НЕ ЗначениеЗаполнено(НовыйДокЗаказ.IDСклада_СтороннийСклад)
		И Константы.НеСоздаватьСтороннийСклад.Получить() Тогда
		Результат = Истина;	   
	КонецЕсли;	
	
	Возврат Результат;

КонецФункции

Функция СоздатьЗаказ(ПроверятьЦеныДляEmailЗаказов = Истина, КомментарийЗаказа = "") Экспорт 

	Если SkladID = 0 Тогда
		
		Причина = "Не выбран склад";		
		Возврат Причина; 	
		
	КонецЕсли;

	ПромНомерЗаказа = СокрЛП(Код);
	
	НеСоздаватьНоменклатуруВУТ10 = Константы.НеСоздаватьНоменклатуруВУТ10.Получить(); 
	
	НовыйДокЗаказ = Документы.ЗаказПокупателя.СоздатьДокумент();
	НовыйДокЗаказ.Дата 	 = ТекущаяДата();
	НовыйДокЗаказ.Портал = Истина;
	Причина = ""; 
	
	//+Белов А. 01.12.2025 #НовыйДокЗаказ
	НовыйДокЗаказ.IDЗаказаПортал = IDЗаказаПортал;	
	//-Белов А. 01.12.2025 #НовыйДокЗаказ
	
	ИспользоватьДатуОтгрузкиИзЗаказа = Константы.ИспользоватьДатуОтгрузкиИзЗаказа.Получить();
	
	Если ИспользоватьДатуОтгрузкиИзЗаказа Тогда
		НовыйДокЗаказ.ДатаОтгрузки = Dostavka;
	КонецЕсли;
	
	Если СтрДлина(DogovorID) = 110 Тогда 

		ФилиалGUID			=	СтрПолучитьСтроку(СтрЗаменить(DogovorID, "|", Символы.ПС), 2);
		
		ФилиалКонтрагента	=	Справочники.Контрагенты.НайтиПоРеквизиту("КодМДМ", ФилиалGUID);
		Контрагент			=	ФилиалКонтрагента.ГоловнойКонтрагент;

	Иначе	
		
		Контрагент 			= ?(EMailЗаказ,Контрагент,МСКWEB.НайтиКонтрагентаПоКодуИзПортала(СокрЛП(KontragentID)));
		ФилиалКонтрагента 	= ?(EMailЗаказ,ФилиалКонтрагента,МСКWEB.НайтиФилиалПоКодуИзПортала(СокрЛП(FilialID)));
		
	КонецЕсли;	
	
	Если НЕ ФилиалКонтрагента  = Неопределено И НЕ ФилиалКонтрагента.Пустая() Тогда
		НовыйДокЗаказ.Контрагент = ФилиалКонтрагента;
	ИначеЕсли НЕ Контрагент = Неопределено И НЕ Контрагент.Пустая() Тогда
	    НовыйДокЗаказ.Контрагент = Контрагент;
	Иначе
		
		Причина = "Не найден клиент";		
		Возврат Причина;
		
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(НовыйДокЗаказ.Контрагент) 
		И ЗначениеЗаполнено(НовыйДокЗаказ.Контрагент.ГоловнойКонтрагент)
		И НовыйДокЗаказ.Контрагент.ГоловнойКонтрагент <> НовыйДокЗаказ.Контрагент Тогда
		
		НовыйДокЗаказ.Грузополучатель 		= НовыйДокЗаказ.Контрагент;
		НовыйДокЗаказ.Контрагент 			= НовыйДокЗаказ.Контрагент.ГоловнойКонтрагент;
		НовыйДокЗаказ.ДоговорКонтрагента 	= ?(EMailЗаказ, 
		                                       ?(ЗначениеЗаполнено(НовыйДокЗаказ.Контрагент.ГоловнойКонтрагент.EMailЗаказ_Договор),
		                                         НовыйДокЗаказ.Контрагент.ГоловнойКонтрагент.EMailЗаказ_Договор,
												 НовыйДокЗаказ.Контрагент.ГоловнойКонтрагент.ОсновнойДоговорКонтрагента),
												 НовыйДокЗаказ.Контрагент.ОсновнойДоговорКонтрагента);
		
	Иначе 
		НовыйДокЗаказ.Грузополучатель = НовыйДокЗаказ.Контрагент;		
	КонецЕсли;
	
	Если СтрДлина(DogovorID) >= 110 Тогда               
		
		КодМДМДоговора = СтрПолучитьСтроку(СтрЗаменить(DogovorID, "|", Символы.ПС), 1);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДоговорыКонтрагентов.Ссылка КАК ДоговорКонтрагента
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	ДоговорыКонтрагентов.КодМДМ = &КодМДМ";
		
		Запрос.УстановитьПараметр("КодМДМ", КодМДМДоговора);
		
	ИначеЕсли СтрДлина(DogovorID) >= 36 Тогда

		Если СтрДлина(DogovorID) = 36 Тогда
			КодМДМДоговора = DogovorID;
		Иначе
			КодМДМДоговора = Лев(DogovorID, 36);			
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка,
		|	Контрагенты.ГоловнойКонтрагент
		|ПОМЕСТИТЬ КонтрагентИГоловной
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Ссылка = &Контрагент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДоговорыКонтрагентов.Ссылка КАК ДоговорКонтрагента
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	(ДоговорыКонтрагентов.Владелец В
		|				(ВЫБРАТЬ
		|					КонтрагентИГоловной.Ссылка
		|				ИЗ
		|					КонтрагентИГоловной КАК КонтрагентИГоловной)
		|			ИЛИ ДоговорыКонтрагентов.Владелец В
		|				(ВЫБРАТЬ
		|					КонтрагентИГоловной.ГоловнойКонтрагент
		|				ИЗ
		|					КонтрагентИГоловной КАК КонтрагентИГоловной))
		|	И ДоговорыКонтрагентов.КодМДМ = &КодМДМ";
		
		Запрос.УстановитьПараметр("КодМДМ", КодМДМДоговора);
		Запрос.УстановитьПараметр("Контрагент", НовыйДокЗаказ.Контрагент);	
		
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка,
		|	Контрагенты.ГоловнойКонтрагент
		|ПОМЕСТИТЬ КонтрагентИГоловной
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Ссылка = &Контрагент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДоговорыАварды.ДоговорКонтрагента
		|ИЗ
		|	РегистрСведений.ДоговорыАварды КАК ДоговорыАварды
		|ГДЕ
		|	ДоговорыАварды.КодАварда = &DogovorID
		|	И (ДоговорыАварды.ДоговорКонтрагента.Владелец В
		|				(ВЫБРАТЬ
		|					КонтрагентИГоловной.Ссылка
		|				ИЗ
		|					КонтрагентИГоловной КАК КонтрагентИГоловной)
		|			ИЛИ ДоговорыАварды.ДоговорКонтрагента.Владелец В
		|				(ВЫБРАТЬ
		|					КонтрагентИГоловной.ГоловнойКонтрагент
		|				ИЗ
		|					КонтрагентИГоловной КАК КонтрагентИГоловной))";
		
		Запрос.УстановитьПараметр("DogovorID", DogovorID);
		Запрос.УстановитьПараметр("Контрагент", НовыйДокЗаказ.Контрагент);	
		
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		НовыйДокЗаказ.ДоговорКонтрагента = ВыборкаДетальныеЗаписи.ДоговорКонтрагента;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НовыйДокЗаказ.ДоговорКонтрагента) Тогда
		
		Если EMailЗаказ Тогда
			НовыйДокЗаказ.ДоговорКонтрагента = ?(ЗначениеЗаполнено(НовыйДокЗаказ.Контрагент.EMailЗаказ_Договор),
			                                     НовыйДокЗаказ.Контрагент.EMailЗаказ_Договор,
												 НовыйДокЗаказ.Контрагент.ОсновнойДоговорКонтрагента);
		Иначе
			НовыйДокЗаказ.ДоговорКонтрагента = НовыйДокЗаказ.Контрагент.ОсновнойДоговорКонтрагента;
		КонецЕсли;		
		
	КонецЕсли;
	
	
	НовыйДокЗаказ.ИсточникЗаказа =  Справочники.ИсточникиЗаказов.НайтиПоРеквизиту("КодИсточника", OrderSource); 
	
	Если НовыйДокЗаказ.Контрагент = Константы.ОсновнойПоставщик.Получить() И НовыйДокЗаказ.ИсточникЗаказа = Справочники.ИсточникиЗаказов.НайтиПоРеквизиту("КодИсточника", 2) Тогда
		
		ПромДоговорАПИ = Константы.ДоговорДляЗаказаЧерезАПИДляОсновногоПоставщика.Получить();
		
		Если НЕ ПромДоговорАПИ.Пустая() Тогда
			НовыйДокЗаказ.ДоговорКонтрагента = ПромДоговорАПИ;
		КонецЕсли;		
		
	КонецЕсли;
	
	ОсновнойСклад 							= Константы.ОсновнойСклад.Получить();
	НовыйДокЗаказ.СкладГруппа 				= ОсновнойСклад;
	НовыйДокЗаказ.IDСклада 					= SkladID;
	НовыйДокЗаказ.IDСклада_СтороннийСклад 	= МСК.НайтиСтороннийСкладПоID(НовыйДокЗаказ.IDСклада, Истина);
	
	ЭтоСтороннийСклад 						= ЗначениеЗаполнено(НовыйДокЗаказ.IDСклада_СтороннийСклад); 
	
	Если НЕ ЭтоСтороннийСклад И ПустойСтороннийСклад(НовыйДокЗаказ) Тогда		
		ЭтоСтороннийСклад = Истина;	 	
	КонецЕсли; 	
	
	Если ПустойСтороннийСклад(НовыйДокЗаказ) Тогда
		
		Если ПустойСтороннийСклад(НовыйДокЗаказ) Тогда
			Причина = ?(Причина = "", "", Причина + ", ") + "Отсутствует сторонний склад -> Запрет создания сторонних складов";
		КонецЕсли; 
		
	КонецЕсли; 
	
	//+Белов А. 22.10.2024 UT10-4825#
	Если ЭтоСтороннийСклад И ЗначениеЗаполнено(НовыйДокЗаказ.IDСклада_СтороннийСклад) Тогда
		НовыйДокЗаказ.IDСклада = НовыйДокЗаказ.IDСклада_СтороннийСклад.IDСклада;		
	КонецЕсли;
	//-Белов А. 22.10.2024 #UT10-4825

	НовыйДокЗаказ.ВалютаДокумента = НовыйДокЗаказ.ДоговорКонтрагента.ВалютаВзаиморасчетов;		
	
	//+Белов А. 01.12.2025 #UT10-5562
	Если ЗначениеЗаполнено(КомментарийЗаказа) Тогда
		НовыйДокЗаказ.Комментарий 	  = КомментарийЗаказа; 		
	Иначе
	//-Белов А. 01.12.2025 #UT10-5562
		НовыйДокЗаказ.Комментарий 	  = СокрЛП(Comment); 	
	КонецЕсли;
		
	Если ЗначениеЗаполнено(НовыйДокЗаказ.Контрагент) И НовыйДокЗаказ.Контрагент.НеИспользоватьЦеныПортала 
		И НЕ Константы.ОформлятьВсеЗаказыСПортала.Получить()
		Тогда
		
		Если ЭтоСтороннийСклад Тогда 
			// для сторонних складов берем цены портала
		Иначе
			Причина = ?(Причина = "", Причина, Причина + ", ") + "Не портальная цена; ";
		КонецЕсли;
		
	КонецЕсли;		
    
	////////////////////Заполнение способа доставки///////////////////////////
	//Значения "TipDost" из портала:
	//0 - только резерв
	//1 - самовывоз
	//2 - экспресс доставка
	//3 - трансп компания
	//4 - стандартная доставка
	//5 - такси доставка 
	Если TipDost="1" ИЛИ TipDost = "5" Тогда
		
		Если TipDost = "5" И Константы.ТаксиДоставка.Получить() Тогда 
			
			НовыйДокЗаказ.УпаковыватьСамовывоз = Истина;
			НовыйДокЗаказ.ТаксиДоставка        = Истина; 
			
		КонецЕсли;
		
		НовыйДокЗаказ.СпособДоставки = Перечисления.СпособДоставки.Самовывоз;
		
	ИначеЕсли TipDost = "2" ИЛИ TipDost = "3" ИЛИ TipDost = "4" Тогда
		НовыйДокЗаказ.СпособДоставки = Перечисления.СпособДоставки.НашаДоставка;
	ИначеЕсли TipDost = "0" Тогда	
		НовыйДокЗаказ.ТолькоРезерв  = Истина;
		НовыйДокЗаказ.СпособДоставки = НовыйДокЗаказ.Грузополучатель.СпособДоставки;
	Иначе	
		Причина = ?(Причина="",Причина,Причина+", ")+"Не указан способ доставки";
	КонецЕсли; 
	
	НовыйДокЗаказ.Организация = НовыйДокЗаказ.ДоговорКонтрагента.Организация;
	
	Если СокрЛП(НовыйДокЗаказ.Контрагент.ИНН) = "" Тогда 
		
		Если (Константы.База.Получить() = Перечисления.НазваниеБазы.Казань или Константы.База.Получить() = Перечисления.НазваниеБазы.Воронеж) 
			И НовыйДокЗаказ.Организация <> Константы.ОсновнаяОрганизация.Получить() Тогда 
		Иначе
			Причина = ?(Причина = "", Причина, Причина + ", ") + "Нет ИНН контрагента";
		КонецЕсли;
		
	КонецЕсли;
	
	Если НовыйДокЗаказ.СпособДоставки = Перечисления.СпособДоставки.Самовывоз И ЗначениеЗаполнено(НовыйДокЗаказ.Грузополучатель) 
		И (НЕ TipDost = "5" ИЛИ (TipDost = "5" И НЕ Константы.ТаксиДоставка.Получить()))  Тогда		    
		НовыйДокЗаказ.УпаковыватьСамовывоз = НовыйДокЗаказ.Грузополучатель.УпаковыватьСамовывоз;		
	КонецЕсли;	
	
	Если НовыйДокЗаказ.СпособДоставки = Перечисления.СпособДоставки.НашаДоставка И НовыйДокЗаказ.Грузополучатель.ОбособленнаяОтгрузкаГМИзСтороннегоФилиала Тогда
		НовыйДокЗаказ.ОбособленнаяОтгрузкаГМИзСтороннегоФилиала = Справочники.СобственныеСклады.IDСоответстуетОбособленнойОтгрузке(НовыйДокЗаказ.IDСклада);	
	КонецЕсли;
	
	ЗаполнениеДокументов.ЗаполнитьШапкуДокумента(НовыйДокЗаказ, глЗначениеПеременной("глТекущийПользователь"), 
	                            НовыйДокЗаказ.мВалютаРегламентированногоУчета, "Продажа", Неопределено, Неопределено, 
								НовыйДокЗаказ.мСтруктураПараметровДляПолученияДоговора);
	
	Если ЗначениеЗаполнено(НовыйДокЗаказ.ДоговорКонтрагента) Тогда 
		НовыйДокЗаказ.ОплатаНаличными = НовыйДокЗаказ.ДоговорКонтрагента.ОплатаПоДоговоруНаличными;
	КонецЕсли;		

	Если НЕ НовыйДокЗаказ.ДоговорКонтрагента.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем Тогда
		Причина = ?(Причина = "", Причина, Причина + ", ") + "Выбран договор не с покупателем";	
	КонецЕсли;
	
	Если НовыйДокЗаказ.ДоговорКонтрагента.Потенциальный Тогда
		Причина = ?(Причина = "", Причина, Причина + ", ") + "В договоре установлен признак Потенциальный";	
	КонецЕсли;		
	
	НовыйДокЗаказ.УчитыватьНДС 		= Истина;
	НовыйДокЗаказ.СуммаВключаетНДС 	= Истина;
	НовыйДокЗаказ.ВалютаДокумента 	= НовыйДокЗаказ.мВалютаРегламентированногоУчета;
	НовыйДокЗаказ.КратностьВзаиморасчетов = 1;
	НовыйДокЗаказ.КурсВзаиморасчетов = 1;
	НовыйДокЗаказ.СкладГруппа 		= ОсновнойСклад;
	
	//+Белов А. 01.12.2025 #UT10-5562
	Если ЗначениеЗаполнено(КомментарийЗаказа) Тогда
		НовыйДокЗаказ.Комментарий 	  = КомментарийЗаказа; 		
	Иначе
	//-Белов А. 01.12.2025 #UT10-5562
		НовыйДокЗаказ.Комментарий 	  = СокрЛП(Comment); 	
	КонецЕсли;
	
	//#############################Заполнение табличной части Заказа ###########################
	ДокСумма = 0;
	
	ТЗКорректировкаЗП = Новый ТаблицаЗначений;
	ТЗКорректировкаЗП.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗКорректировкаЗП.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,3)));
	ТЗКорректировкаЗП.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	ТЗКорректировкаЗП.Колонки.Добавить("РазрешеноКОтгрузке", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,3)));
	ТЗКорректировкаЗП.Колонки.Добавить("Отклонение", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,3)));
	
	СобственныйСкладКакСторонний = Ложь;
	
	Если НЕ ЭтоСтороннийСклад Тогда
		СобственныйСкладКакСторонний = Справочники.СобственныеСклады.НайтиПоРеквизиту("Идентификатор", НовыйДокЗаказ.IDСклада).СоздаватьНоменклатуруВМДМ;
	КонецЕсли;	
	
	Для Каждого стр из Товары Цикл
		
		Артикул = СокрЛП(стр.NumberInv);
		
		Если Артикул = "" И НЕ СобственныйСкладКакСторонний Тогда 
			Причина = ?(Причина = "", Причина, Причина + ", ") + "Не заполнен артикул для позиции в строке " + стр.НомерСтроки + "; ";
		КонецЕсли;	
		
		Товар = ?(ЗначениеЗаполнено(Артикул), МСКWEB.НайтиТоварПоАртикулу(Артикул), Неопределено);
		
		Если Товар = Неопределено Тогда
			
			ОчищенныйПроизводитель = "";
			СтрокаПроверки = ВРег(СокрЛП(стр.Brand));
			Длина = СтрДлина(СтрокаПроверки);
			
			Для а = 1 По Длина Цикл
				
				Если Найти("0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyzАБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯабвгдеёжзийклмнопрстуфхцчшщъыьэюя", Сред(СтрокаПроверки, а, 1)) <> 0 Тогда
					ОчищенныйПроизводитель = ОчищенныйПроизводитель + Сред(СтрокаПроверки, а, 1);
				КонецЕсли; 
				
			КонецЦикла;	
			
			ОчищенныйКодПроизводителя = "";
			СтрокаПроверки = СокрЛП(стр.Articul);
			Длина = СтрДлина(СтрокаПроверки); 
			
			Для а = 1 По Длина Цикл           
				
				Если Найти("0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyzАБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯабвгдеёжзийклмнопрстуфхцчшщъыьэюя", Сред(СтрокаПроверки, а, 1)) <> 0 Тогда
					ОчищенныйКодПроизводителя = ОчищенныйКодПроизводителя + Сред(СтрокаПроверки, а, 1);
				КонецЕсли;   
				
			КонецЦикла;
			
			СтрокаПоиска = ОчищенныйПроизводитель + ОчищенныйКодПроизводителя;
			
			Если Не ПустаяСтрока(СтрокаПоиска) Тогда
				
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ
				|	Номенклатура.Ссылка
				|ИЗ
				|	Справочник.Номенклатура КАК Номенклатура
				|ГДЕ
				|	Номенклатура.НормализованныйКод = &СтрокаПоиска
				|	И НЕ Номенклатура.ПометкаУдаления";
				
				Запрос.УстановитьПараметр("СтрокаПоиска",СтрокаПоиска);
				
				Выборка = Запрос.Выполнить().Выбрать();
				
				Если Выборка.Количество() >= 1 И Выборка.Следующий() Тогда
					Товар = Выборка.Ссылка;
				Иначе 
					Товар = Неопределено;	
				КонецЕсли;
				
			КонецЕсли;
			
			Если Товар = Неопределено Тогда 
				
				// ищем бренд в синонимах
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ РАЗЛИЧНЫЕ
				|	СинонимыПроизводителей.Производитель КАК Производитель,
				|	СинонимыПроизводителей.СинонимПроизводителя
				|ИЗ
				|	РегистрСведений.СинонимыПроизводителей КАК СинонимыПроизводителей
				|ГДЕ
				|	СинонимыПроизводителей.СинонимПроизводителя = &СинонимПроизводителя";
				
				Запрос.УстановитьПараметр("СинонимПроизводителя", ВРег(СокрЛП(стр.Brand)));
				
				Выборка = Запрос.Выполнить().Выбрать();
				
				Если Выборка.Количество() >= 1 И Выборка.Следующий() Тогда
					
					ОчищенныйПроизводитель = "";
					СтрокаПроверки = ВРег(СокрЛП(Выборка.Производитель));
					Длина = СтрДлина(СтрокаПроверки);
					
					Для а = 1 По Длина Цикл
						
						Если Найти("0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyzАБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯабвгдеёжзийклмнопрстуфхцчшщъыьэюя", Сред(СтрокаПроверки, а, 1)) <> 0 Тогда
							ОчищенныйПроизводитель = ОчищенныйПроизводитель + Сред(СтрокаПроверки, а, 1);
						КонецЕсли; 
						
					КонецЦикла;				
					
					СтрокаПоиска = ОчищенныйПроизводитель + ОчищенныйКодПроизводителя;
					
					Если Не ПустаяСтрока(СтрокаПоиска) Тогда
						
						Запрос = Новый Запрос;
						Запрос.Текст = 
						"ВЫБРАТЬ
						|	Номенклатура.Ссылка
						|ИЗ
						|	Справочник.Номенклатура КАК Номенклатура
						|ГДЕ
						|	Номенклатура.НормализованныйКод = &СтрокаПоиска
						|	И НЕ Номенклатура.ПометкаУдаления";
						
						Запрос.УстановитьПараметр("СтрокаПоиска", СтрокаПоиска);
						ВыборкаТовар = Запрос.Выполнить().Выбрать();
						
						Если ВыборкаТовар.Количество() >= 1 И ВыборкаТовар.Следующий() Тогда
							Товар = ВыборкаТовар.Ссылка;
						Иначе 
							
							Если НеСоздаватьНоменклатуруВУТ10 Тогда
								
								Товар = Неопределено;
								Причина =  ?(Причина = "", Причина, Причина + ", ") + ?(EMailЗаказ, "Товар не найден", "Товар : не найден по нормализованному коду: " + СтрокаПоиска);
								
							Иначе
								
								Если НЕ МСКWEB.СоздатьНовуюНоменклатуру(Стр, Выборка.Производитель, Товар, Ложь, "", НЕ ЭтоСтороннийСклад или EMailЗаказ) Тогда 
									
									Причина = ?(Причина = "", Причина, Причина + ", ") + ?(EMailЗаказ, "Товар не найден", "Товар : не найден по нормализованному коду: " + СтрокаПоиска);
									Товар = Неопределено;
									
								КонецЕсли;
								
							КонецЕсли;							
							
						КонецЕсли;
						
					Иначе
						
						Причина =  ?(Причина = "", Причина, Причина + ", ") + "Товар не найден " + СтрокаПоиска;
						Товар = Неопределено;
						
					КонецЕсли;
					
				Иначе
					
					Если НеСоздаватьНоменклатуруВУТ10 Тогда
						
						Товар = Неопределено;
						Причина = ?(Причина = "", Причина, Причина + ", ") + ?(EMailЗаказ, "Товар не найден", "Товар : не найден по нормализованному коду: " + СтрокаПоиска);
						
					Иначе
						
						Если НЕ МСКWEB.СоздатьНовуюНоменклатуру(Стр, Справочники.Номенклатура.ПустаяСсылка(), Товар, Ложь, "", НЕ ЭтоСтороннийСклад или EMailЗаказ) Тогда 
							Причина = ?(Причина = "", Причина, Причина + ", ") + ?(EMailЗаказ, "Товар не найден", "Товар : не найден по нормализованному коду: "+СтрокаПоиска);
						КонецЕсли;
						
					КонецЕсли;					
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если Товар = Неопределено Тогда
			
			Причина = ?(Причина = "", Причина, Причина + ", ") + "Не найден товар с артикулом: " + Артикул;
			Продолжить;
			
		ИначеЕсли EMailЗаказ Тогда
			
			стр.NumberInv = Товар.Артикул;
			стр.Articul = Товар.КодПроизводителя;
			стр.Name = Товар.Наименование;
			стр.Brand = СокрЛП(Товар.Родитель.Наименование);
			
		КонецЕсли;
		
		ПромКоличество = стр.Count;    
		
		Если EMailЗаказ Тогда    
			
			РезультатДеления = ПромКоличество / ?(стр.Кратность = 0, 1, стр.Кратность);
			ЦелаяЧасть = Цел(РезультатДеления);
			
			Если НЕ РезультатДеления = ЦелаяЧасть Тогда
				
				Если стр.РазрешеноКОтгрузке = 0 Тогда
					
					Сообщить("В строке " + стр.НомерСтроки + " нарушена кратность, строка не будет добавлена в заказ !");
					Продолжить;        
					
				КонецЕсли;  
				
				ПромКоличество = стр.РазрешеноКОтгрузке;
				
			КонецЕсли;
			
		КонецЕсли;
		
		НоваяСтрока = НовыйДокЗаказ.Товары.Добавить();	
		НоваяСтрока.Номенклатура 		= Товар;
		НоваяСтрока.ЕдиницаИзмерения 	= Товар.ЕдиницаХраненияОстатков;
		НоваяСтрока.ЦенаЗакупки 		= стр.Price_Zak;
		
		Попытка
			НоваяСтрока.ПроизводительПоставщика = СокрЛП(стр.ПроизводительПоставщика);
		Исключение
		КонецПопытки;

		НовыйДокЗаказ.ПриИзмененииНоменклатурыТоваров(НоваяСтрока);
		НоваяСтрока.Количество = ПромКоличество;
		
		Если НЕ НовыйДокЗаказ.Контрагент.НеИспользоватьЦеныПортала ИЛИ ЭтоСтороннийСклад ИЛИ EMailЗаказ Тогда 
			НоваяСтрока.Цена = стр.Price;
		КонецЕсли;	
		
		СтрСумма = НоваяСтрока.Количество*НоваяСтрока.Цена;
		НоваяСтрока.Сумма = СтрСумма;
		ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НоваяСтрока, НовыйДокЗаказ);
		
		НоваяСтрока.Комментарий = стр.Comment;
		ДокСумма = ДокСумма + СтрСумма;
		
		Если EMailЗаказ И ПромКоличество > Стр.РазрешеноКОтгрузке Тогда 
			
			СтрКорректировки = ТЗКорректировкаЗП.Добавить();
			СтрКорректировки.Номенклатура = Товар;
			СтрКорректировки.Цена = Стр.Price;
			СтрКорректировки.Количество = ПромКоличество;
			СтрКорректировки.РазрешеноКОтгрузке = Стр.РазрешеноКОтгрузке;
			СтрКорректировки.Отклонение = ПромКоличество - Стр.РазрешеноКОтгрузке;
			
		КонецЕсли;
		
	КонецЦикла;   
	
	НовыйДокЗаказ.СуммаДокумента = ДокСумма;
	
	//Сравниваем цены, если отклонение до % допустимого отклонения, то пропускаем
	Если EMailЗаказ                   
		И ПроверятьЦеныДляEmailЗаказов //+Белов А. 01.12.2025 #UT10-5562
		И ЗначениеЗаполнено(НовыйДокЗаказ.Контрагент) 
		И ЗначениеЗаполнено(НовыйДокЗаказ.ДоговорКонтрагента) Тогда
		
		ТЗ = НовыйДокЗаказ.Товары.Выгрузить();
		ТЗ.Свернуть("Номенклатура,Цена");
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		
		"ВЫБРАТЬ
		|	ТЗ.Номенклатура КАК Номенклатура,
		|	ТЗ.Цена КАК ЦенаКлиента
		|ПОМЕСТИТЬ ТаблицаНоменклатура
		|ИЗ
		|	&ТЗ КАК ТЗ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаНоменклатура.Номенклатура,
		|	ЕСТЬNULL(ТаблицаНоменклатура.ЦенаКлиента,0) КАК ЦенаКлиента,
		|	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0) КАК ЦенаПоДоговору
		|ИЗ
		|	ТаблицаНоменклатура КАК ТаблицаНоменклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
		|				,
		|				Номенклатура В
		|						(ВЫБРАТЬ
		|							ТаблицаНоменклатура.Номенклатура
		|						ИЗ
		|							ТаблицаНоменклатура)
		|					И ТипЦен = &ТипЦенЗаказ) КАК ЦеныНоменклатурыСрезПоследних
		|		ПО ТаблицаНоменклатура.Номенклатура = ЦеныНоменклатурыСрезПоследних.Номенклатура";
		
		Запрос.УстановитьПараметр("ТипЦенЗаказ", ?(ЗначениеЗаполнено(ТипЦенЗаказ), ТипЦенЗаказ, НовыйДокЗаказ.ДоговорКонтрагента.ТипЦен));
		Запрос.УстановитьПараметр("ТЗ", ТЗ);
		
		Результат = Запрос.Выполнить().Выгрузить();
		ПроцентОтклонения = НовыйДокЗаказ.Контрагент.EMailЗаказ_КонтролироватьРасхождениеЦенВПроцентах;
		
		Для Каждого СтрРезультата Из Результат Цикл
			
			Отбор = Новый Структура("Articul,NumberInv,Price", СтрРезультата.Номенклатура.КодПроизводителя, СтрРезультата.Номенклатура.Артикул, СтрРезультата.ЦенаКлиента);
			СтрокиНеСоздЗП = Товары.НайтиСтроки(Отбор);
			
			//Если в файле клиента нет цены
			Если (СтрРезультата.ЦенаКлиента = 0) и ЗначениеЗаполнено(СтрРезультата.ЦенаПоДоговору) Тогда
				
				СтрокиДок = НовыйДокЗаказ.Товары.НайтиСтроки(Новый Структура("Номенклатура", СтрРезультата.Номенклатура));
				
				Для Каждого СтрДок Из СТрокиДок Цикл
					
					СтрДок.Цена = СтрРезультата.ЦенаПоДоговору;
					СтрДок.Сумма = СтрДок.Цена * СтрДок.Количество;
					ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(СтрДок, НовыйДокЗаказ);
					ДокСумма = НовыйДокЗаказ.Товары.Итог("Сумма");
					
				КонецЦикла;
				
				Для Каждого СтрНеСоздЗП Из СтрокиНеСоздЗП Цикл
					СтрНеСоздЗП.Price = СтрРезультата.ЦенаПоДоговору;
				КонецЦикла;
				
			Иначе
				
				СтрПричина = "";
				ОтклонениеЦены = Ложь;
				
				Если СтрРезультата.ЦенаПоДоговору = 0 Тогда
					
					СтрПричина = "Не задана цена по договору";
					
					Если Найти(Причина, "Не задана цена по договору") = 0 Тогда
						Причина = ?(Причина = "", Причина, Причина + ", ") + "Не задана цена по договору для товара(ов)";
					КонецЕсли;
					
				ИначеЕсли (СтрРезультата.ЦенаКлиента > 0) И (СтрРезультата.ЦенаКлиента < Окр(СтрРезультата.ЦенаПоДоговору * (1 - ПроцентОтклонения / 100), 2)) Тогда
					
					СтрПричина = Окр(СтрРезультата.ЦенаПоДоговору*(1-ПроцентОтклонения/100), 2);
					ОтклонениеЦены = Истина;
					
				КонецЕсли;
				
				Если ЗначениеЗаполнено(СтрПричина) Тогда
					
					Для Каждого СтрНеСоздЗП Из СтрокиНеСоздЗП Цикл
						
						Если СтрНеСоздЗП.ЦенаОтгрузки <> СтрПричина Тогда
							
							Если Найти(СтрНеСоздЗП.Причина, "Откл. цены") = 0 Тогда 
								СтрНеСоздЗП.Причина = ?(СтрНеСоздЗП.Причина = "", СтрНеСоздЗП.Причина, СтрНеСоздЗП.Причина + ", ") + "Откл. цены";
							КонецЕсли;
							
							СтрНеСоздЗП.ЦенаОтгрузки = СтрПричина; 
							СтрНеСоздЗП.РазрешеноКОтгрузке = 0;
							
							Если ОтклонениеЦены И Найти(Причина, "Отклонение цены") = 0 Тогда
								Причина = ?(Причина = "", Причина, Причина + ", ") + "Отклонение цены более " + Строка(ПроцентОтклонения) + "%";
							КонецЕсли;
							
						КонецЕсли;					
						
					КонецЦикла;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если НЕ СокрЛП(Причина) = "" Тогда		
		Возврат Причина;
	КонецЕсли;		   
	
	ЕстьНоменклатураТребующаяМаркировки = Маркировка.ЕстьНоменклатураТребующаяМаркировки(НовыйДокЗаказ.Товары.Выгрузить());
	
	//+Шульман А. 20.10.2025 #UT10-5457
	Если НовыйДокЗаказ.ОбособленнаяОтгрузкаГМИзСтороннегоФилиала И ЕстьНоменклатураТребующаяМаркировки Тогда  
		НовыйДокЗаказ.ОбособленнаяОтгрузкаГМИзСтороннегоФилиала = Ложь;     
	КонецЕсли;
	//-Шульман А. 20.10.2025 #UT10-5457
	
	Попытка		
		НовыйДокЗаказ.Записать(РежимЗаписиДокумента.Запись);		
	Исключение
		
		Результат = "Произошла ошибка при создании документа!"; 
		Возврат Результат;
		
	КонецПопытки;
	
	ЗаказПокупателяСсылка = НовыйДокЗаказ.Ссылка;
	ЭтотОбъект.Записать(); 
	
	//_Заполнить и провести
	ВидимостьСерии = Истина;
	Авторезервирование = Истина;
	Авторазмещение = Ложь;
