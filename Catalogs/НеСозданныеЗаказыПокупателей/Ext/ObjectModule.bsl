		|					ТОГДА ТабОстатков.Коэффициент
		|				ИНАЧЕ 1
		|			КОНЕЦ КАК ЧИСЛО(15, 1))) = (ВЫРАЗИТЬ(ТабОстатков.Количество / ВЫБОР
		|				КОГДА ТабОстатков.Коэффициент > 0
		|					ТОГДА ТабОстатков.Коэффициент
		|				ИНАЧЕ 1
		|			КОНЕЦ КАК ЧИСЛО(15, 0)))";
		
		
		Запрос.УстановитьПараметр("ТипЦенЗаказ", НовыйДокЗаказ.ДоговорКонтрагента.ТипЦен);
		Запрос.УстановитьПараметр("Рубль", Константы.ВалютаРегламентированногоУчета.Получить());
		Запрос.УстановитьПараметр("ПустаяСерия", Справочники.СерииНоменклатуры.ПустаяСсылка());
		Запрос.УстановитьПараметр("ТЗ", ТЗ);
		
		Результат = Запрос.Выполнить().Выгрузить();
		
		Если Результат.Количество() = 0 ИЛИ НовыйДокЗаказ.ОбособленнаяОтгрузкаГМИзСтороннегоФилиала Тогда 
			
			Для каждого Стр Из НовыйДокЗаказ.Товары Цикл
				
				Стр.Размещение = "";
				Стр.СерияНоменклатуры = "";
				
			КонецЦикла;
			
		Иначе
			
			Для каждого Стр Из НовыйДокЗаказ.Товары Цикл
				
				Если Результат.Найти(Стр.Номенклатура, "Номенклатура") = Неопределено Тогда 
					
					Стр.Размещение = "";
					Стр.СерияНоменклатуры = "";
					
				Иначе
					// возможно меняем цену на нашу ?
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если НовыйДокЗаказ.ТолькоРезерв Тогда
		
		ПромТабличнаяЧасть = НовыйДокЗаказ.Товары.Выгрузить();
		ПромТабличнаяЧасть.ЗаполнитьЗначения(НовыйДокЗаказ.ТолькоРезерв, "ТолькоРезерв");
		НовыйДокЗаказ.Товары.Загрузить(ПромТабличнаяЧасть);
		
	КонецЕсли;
	
	Попытка
		
		//+Белов А. 10.03.2026 #UT10-5729
		ВыделитьМаркировкуВОтдельныйЗаказ = Ложь;
		
		//Если основная организация
		Если НовыйДокЗаказ.Организация = Константы.ОсновнаяОрганизация.Получить() Тогда
			ВыделитьМаркировкуВОтдельныйЗаказ = Маркировка.ЕстьНоменклатураТребующаяМаркировки(НовыйДокЗаказ.Товары.Выгрузить()) И Константы.ВыделятьТоварыСМаркировкойПоОснОрганизацииВОтдельныйЗаказ.Получить() И МСКWEB.ПоДоворуНужноВыделениеЗаказаСМаркировкойВОтдельный(НовыйДокЗаказ.ДоговорКонтрагента);		
		Иначе
			//Если управленческая организация	
			ВыделитьМаркировкуВОтдельныйЗаказ = Маркировка.ЕстьНоменклатураТребующаяМаркировки(НовыйДокЗаказ.Товары.Выгрузить()) И Не Константы.НеВыделятьТоварыСМаркировкойПоУпрОрганизацииВОтдельныйЗаказ.Получить();  				
		КонецЕсли;
		
		Если ВыделитьМаркировкуВОтдельныйЗаказ Тогда
			
			СтруктураВыделения = МСКWEB.ВыделитьМаркировкуВОтдельныйЗаказ(НовыйДокЗаказ);	
			НовыйДокЗаказ = СтруктураВыделения.ЗаказИсходныйОбъект;  
			
		Иначе
			НовыйДокЗаказ.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Оперативный); 
		КонецЕсли;
		
		////+Белов А. 25.12.2025 #UT10-5586
		//Если Не Константы.НеВыделятьТоварыСМаркировкойПоУпрОрганизацииВОтдельныйЗаказ.Получить() 
		//	И НовыйДокЗаказ.Организация <> Константы.ОсновнаяОрганизация.Получить() 
		//	И Маркировка.ЕстьНоменклатураТребующаяМаркировки(НовыйДокЗаказ.Товары.Выгрузить()) Тогда
		//	
		//	СтруктураВыделения = МСКWEB.ВыделитьМаркировкуВОтдельныйЗаказ(НовыйДокЗаказ);	
		//	НовыйДокЗаказ = СтруктураВыделения.ЗаказИсходныйОбъект;
		//	
		////-Белов А. 25.12.2025 #UT10-5586	
		//Иначе
		//	
		//	НовыйДокЗаказ.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Оперативный); 
		//КонецЕсли;  
		//-Белов А. 10.03.2026 #UT10-5729
	
		Результат = "";
		
		ТЗКорректировкаЗП.Свернуть("Номенклатура,Цена", "Количество, РазрешеноКОтгрузке, Отклонение");
		
		Если ТЗКорректировкаЗП.Количество() > 0 Тогда
			
			СоздатьКорректировкаЗаказаПокупателя(НовыйДокЗаказ, ТЗКорректировкаЗП); 
			
			НовыйДок = Документы.КорректировкаЗаказаПокупателя.СоздатьДокумент();
			НовыйДок.Дата = ТекущаяДата() + 1;
			
			СтруктураЗаполнения = Новый Структура;
			СтруктураЗаполнения.Вставить("ДокументОснование", НовыйДокЗаказ.Ссылка);
			СтруктураЗаполнения.Вставить("ТипЗаполнения", "ПоНесозданнымЗаказам");
			СтруктураЗаполнения.Вставить("ТЗКорректировкаЗП", ТЗКорректировкаЗП);
			
			НовыйДок.Заполнить(СтруктураЗаполнения);
			
			Если НовыйДок.Товары.Количество() > 0 Тогда
				
				Попытка
					
					НовыйДок.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный); 
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Автоматически создана " + Строка(НовыйДок.Ссылка) + " к документу " + Строка(НовыйДокЗаказ.Ссылка));
					
				Исключение
					
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка при создании корректировки заказа покупателя. Проверьте и проведите документ вручную!");
					НовыйДок.ПолучитьФорму("ФормаДокумента").Открыть();
					
				КонецПопытки;
				
			КонецЕсли;
			
		Иначе
			
			мКоментарий = "Документ сформирован автоматически при создании заказа из несозданных";			
			МСКWEB.СоздатьКорректировкаЗаказаПокупателя(НовыйДокЗаказ,, мКоментарий); 
			
		КонецЕсли;
		
		Возврат "";	
		
	Исключение
		
		Результат = "Произошла ошибка при записи и проведении документа!";
		Возврат Результат;	
		
	КонецПопытки;
			
КонецФункции

Функция СоздатьКорректировкаЗаказаПокупателя(НовыйДокЗаказ, ТЗКорректировкаЗП)
	                                                                          
	ТоварыТолькоСоСклада = НовыйДокЗаказ.Грузополучатель.ТоварыТолькоСоСклада ИЛИ НовыйДокЗаказ.ТаксиДоставка;  

	Если Не ТоварыТолькоСоСклада Тогда
		
		Если Константы.ИспользоватьАлгоритмПроверкиКратностиФилиала.Получить() Тогда
			Возврат СоздатьКорректировкаЗаказаПокупателяПоКратностиФилиала(НовыйДокЗаказ, ТЗКорректировкаЗП);
		Иначе
			Возврат ТЗКорректировкаЗП; 
		КонецЕсли;		
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказПокупателяТовары.Ссылка,
	|	ЗаказПокупателяТовары.Номенклатура,
	|	ЗаказПокупателяТовары.Цена,
	|	ЗаказПокупателяТовары.ХарактеристикаНоменклатуры,
	|	ЗаказПокупателяТовары.СерияНоменклатуры,
	|	ЗаказПокупателяТовары.Ссылка.СкладГруппа КАК Склад,
	|	ЗаказПокупателяТовары.Количество
	|ПОМЕСТИТЬ ТабЗакПокуп
	|ИЗ
	|	Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары
	|ГДЕ
	|	ЗаказПокупателяТовары.Ссылка = &ЗаказПокупателя
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыВРезервеНаСкладахОстатки.Склад,
	|	ТоварыВРезервеНаСкладахОстатки.Номенклатура,
	|	ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры,
	|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва,
	|	ТоварыВРезервеНаСкладахОстатки.СерияНоменклатуры,
	|	ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток КАК КоличествоВРезерве
	|ПОМЕСТИТЬ ТабТоварыВРезерве
	|ИЗ
	|	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(, ДокументРезерва = &ЗаказПокупателя) КАК ТоварыВРезервеНаСкладахОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабЗакПокуп.Ссылка,
	|	ТабЗакПокуп.Номенклатура КАК Номенклатура,
	|	ТабЗакПокуп.Цена КАК Цена,
	|	ТабЗакПокуп.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ТабЗакПокуп.СерияНоменклатуры КАК СерияНоменклатуры,
	|	ТабЗакПокуп.Склад,
	|	СУММА(ТабЗакПокуп.Количество) КАК Количество,
	|	СУММА(ЕСТЬNULL(ТабТоварыВРезерве.КоличествоВРезерве, 0)) КАК КоличествоВРезерве
	|ИЗ
	|	ТабЗакПокуп КАК ТабЗакПокуп
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТабТоварыВРезерве КАК ТабТоварыВРезерве
	|		ПО ТабЗакПокуп.Ссылка = ТабТоварыВРезерве.ДокументРезерва
	|			И ТабЗакПокуп.Номенклатура = ТабТоварыВРезерве.Номенклатура
	|			И ТабЗакПокуп.ХарактеристикаНоменклатуры = ТабТоварыВРезерве.ХарактеристикаНоменклатуры
	|			И ТабЗакПокуп.СерияНоменклатуры = ТабТоварыВРезерве.СерияНоменклатуры
	|			И ТабЗакПокуп.Склад = ТабТоварыВРезерве.Склад
	|
	|СГРУППИРОВАТЬ ПО
	|	ТабЗакПокуп.Ссылка,
	|	ТабЗакПокуп.Номенклатура,
	|	ТабЗакПокуп.ХарактеристикаНоменклатуры,
	|	ТабЗакПокуп.СерияНоменклатуры,
	|	ТабЗакПокуп.Склад,
	|	ТабЗакПокуп.Цена
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура,
	|	ХарактеристикаНоменклатуры,
	|	СерияНоменклатуры";
	
	Запрос.УстановитьПараметр("ЗаказПокупателя", НовыйДокЗаказ.Ссылка);
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Номенклатура = Неопределено;
	ХарактеристикаНоменклатуры = Неопределено;
	СерияНоменклатуры = Неопределено;
	
	КоличествоВРезерве = 0;
	
	Пока РезультатЗапроса.Следующий() Цикл
		
		Если Номенклатура <> РезультатЗапроса.Номенклатура Или 
			ХарактеристикаНоменклатуры <> РезультатЗапроса.ХарактеристикаНоменклатуры Или 
			СерияНоменклатуры <> РезультатЗапроса.СерияНоменклатуры Тогда
			
			ХарактеристикаНоменклатуры = РезультатЗапроса.ХарактеристикаНоменклатуры;
			СерияНоменклатуры = РезультатЗапроса.СерияНоменклатуры;
			Номенклатура = РезультатЗапроса.Номенклатура;
			
			КоличествоВРезерве = РезультатЗапроса.КоличествоВРезерве;
			
		КонецЕсли; 
		
		Если РезультатЗапроса.Количество <= КоличествоВРезерве Тогда
			КоличествоВРезерве = КоличествоВРезерве - РезультатЗапроса.Количество;
		Иначе
			
			КоличествоКорректировки = РезультатЗапроса.Количество - КоличествоВРезерве;
			КоличествоВРезерве = 0;
			
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("Номенклатура", РезультатЗапроса.Номенклатура);
			ПараметрыОтбора.Вставить("Цена", РезультатЗапроса.Цена);
			
			Если ТЗКорректировкаЗП.НайтиСтроки(ПараметрыОтбора).Количество() = 0 Тогда
				
				НоваяСтрока = ТЗКорректировкаЗП.Добавить();	
				НоваяСтрока.Номенклатура = РезультатЗапроса.Номенклатура;
				НоваяСтрока.Цена = РезультатЗапроса.Цена;
				НоваяСтрока.Количество = РезультатЗапроса.Количество;
				НоваяСтрока.РазрешеноКОтгрузке = КоличествоВРезерве;
				НоваяСтрока.Отклонение = КоличествоКорректировки;
				
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТЗКорректировкаЗП;

КонецФункции

Функция СоздатьКорректировкаЗаказаПокупателяПоКратностиФилиала(НовыйДокЗаказ, ТЗКорректировкаЗП)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказПокупателяТовары.Ссылка,
	|	ЗаказПокупателяТовары.НомерСтроки,
	|	ЗаказПокупателяТовары.Номенклатура,
	|	ЗаказПокупателяТовары.ХарактеристикаНоменклатуры,
	|	ЗаказПокупателяТовары.СерияНоменклатуры,
	|	ЗаказПокупателяТовары.Ссылка.СкладГруппа КАК Склад,
	|	ЗаказПокупателяТовары.Количество
	|ПОМЕСТИТЬ ТабЗакПокуп
	|ИЗ
	|	Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары
	|ГДЕ
	|	ЗаказПокупателяТовары.Ссылка = &ЗаказПокупателя
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыВРезервеНаСкладахОстатки.Склад,
	|	ТоварыВРезервеНаСкладахОстатки.Номенклатура,
	|	ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры,
	|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва,
	|	ТоварыВРезервеНаСкладахОстатки.СерияНоменклатуры,
	|	ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток КАК КоличествоВРезерве
	|ПОМЕСТИТЬ ТабТоварыВРезерве
	|ИЗ
	|	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(, ДокументРезерва = &ЗаказПокупателя) КАК ТоварыВРезервеНаСкладахОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабЗакПокуп.Ссылка,
	|	ТабЗакПокуп.НомерСтроки,
	|	ТабЗакПокуп.Номенклатура КАК Номенклатура,
	|	ТабЗакПокуп.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ТабЗакПокуп.СерияНоменклатуры КАК СерияНоменклатуры,
	|	ТабЗакПокуп.Склад,
	|	ТабЗакПокуп.Количество,
	|	ЕСТЬNULL(ТабТоварыВРезерве.КоличествоВРезерве, 0) КАК КоличествоВРезерве
	|ПОМЕСТИТЬ ИтоговаяТаблица
	|ИЗ
	|	ТабЗакПокуп КАК ТабЗакПокуп
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТабТоварыВРезерве КАК ТабТоварыВРезерве
	|		ПО ТабЗакПокуп.Ссылка = ТабТоварыВРезерве.ДокументРезерва
	|			И ТабЗакПокуп.Номенклатура = ТабТоварыВРезерве.Номенклатура
	|			И ТабЗакПокуп.ХарактеристикаНоменклатуры = ТабТоварыВРезерве.ХарактеристикаНоменклатуры
	|			И ТабЗакПокуп.СерияНоменклатуры = ТабТоварыВРезерве.СерияНоменклатуры
	|			И ТабЗакПокуп.Склад = ТабТоварыВРезерве.Склад
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИтоговаяТаблица.Ссылка,
	|	ИтоговаяТаблица.НомерСтроки,
	|	ИтоговаяТаблица.Номенклатура,
	|	ИтоговаяТаблица.ХарактеристикаНоменклатуры,
	|	ИтоговаяТаблица.СерияНоменклатуры,
	|	ИтоговаяТаблица.Склад,
	|	ИтоговаяТаблица.Количество,
	|	ИтоговаяТаблица.КоличествоВРезерве
	|ИЗ
	|	ИтоговаяТаблица КАК ИтоговаяТаблица
	|ГДЕ
	|	ИтоговаяТаблица.КоличествоВРезерве = 0
	|	И НЕ ИтоговаяТаблица.Номенклатура.НеОчищатьКратностьПриНулевыхОстатках
	|	И ВЫБОР
	|			КОГДА НЕ ЦЕЛ(ИтоговаяТаблица.Количество / ИтоговаяТаблица.Номенклатура.Кратность) = ИтоговаяТаблица.Количество / ИтоговаяТаблица.Номенклатура.Кратность
	|					И НЕ ИтоговаяТаблица.Номенклатура.Кратность = ИтоговаяТаблица.Номенклатура.КратностьФилиала
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ";
	
	Запрос.УстановитьПараметр("ЗаказПокупателя", НовыйДокЗаказ.Ссылка);
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Номенклатура = Неопределено;
	ХарактеристикаНоменклатуры = Неопределено;
	СерияНоменклатуры = Неопределено;
	КоличествоВРезерве = 0;
	
	Пока РезультатЗапроса.Следующий() Цикл
		
		Если Номенклатура <> РезультатЗапроса.Номенклатура Или 
			ХарактеристикаНоменклатуры <> РезультатЗапроса.ХарактеристикаНоменклатуры Или 
			СерияНоменклатуры <> РезультатЗапроса.СерияНоменклатуры Тогда
			
			ХарактеристикаНоменклатуры = РезультатЗапроса.ХарактеристикаНоменклатуры;
			СерияНоменклатуры = РезультатЗапроса.СерияНоменклатуры;
			Номенклатура = РезультатЗапроса.Номенклатура;
			КоличествоВРезерве = РезультатЗапроса.КоличествоВРезерве;
			
		КонецЕсли; 
		
		Если РезультатЗапроса.Количество <= КоличествоВРезерве Тогда
			КоличествоВРезерве = КоличествоВРезерве - РезультатЗапроса.Количество;
		Иначе
			
			КоличествоКорректировки = РезультатЗапроса.Количество - КоличествоВРезерве;
			КоличествоВРезерве = 0;
			
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("Номенклатура", РезультатЗапроса.Номенклатура);
			ПараметрыОтбора.Вставить("Цена", РезультатЗапроса.Цена);
			
			Если ТЗКорректировкаЗП.НайтиСтроки(ПараметрыОтбора).Количество() = 0 Тогда
				
				НоваяСтрока = ТЗКорректировкаЗП.Добавить();	
				НоваяСтрока.Номенклатура = РезультатЗапроса.Номенклатура;
				НоваяСтрока.Цена = РезультатЗапроса.Цена;
				НоваяСтрока.Количество = РезультатЗапроса.Количество;
				НоваяСтрока.РазрешеноКОтгрузке = КоличествоВРезерве;
				НоваяСтрока.Отклонение = КоличествоКорректировки;
				
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТЗКорректировкаЗП;

КонецФункции

