
////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтоНовый = Объект.Ссылка.Пустая();
	ЗначениеКопирования = Параметры.ЗначениеКопирования;
	СозданКопированием = НЕ ЗначениеКопирования.Пустая();
	
	Если Объект.Событие.ЭтоГруппа Тогда
		Объект.Событие = Справочники.ПЛ_События.ПустаяСсылка();
	КонецЕсли;
	
	НастройкиУведомлений = Константы.ПЛ_НастройкиУведомлений.СоздатьМенеджерЗначения().ПолучитьНастройки();
	
	Если ЭтоНовый Тогда
		ПодписиСообщений = "";
		Если НастройкиУведомлений.Свойство("ПодписиСообщений", ПодписиСообщений) <> Неопределено Тогда
			Объект.Наименование = ПодписиСообщений.ПрефиксТемы;
			Объект.ТекстСообщения = ПЛ_УведомленияОСобытияхКлиентСервер.ПолучитьHTMLИзТекста(Символы.ПС + ПодписиСообщений.ПодписьСообщения);
		КонецЕсли;
	КонецЕсли;
	
	Если НастройкиУведомлений.Свойство("НастройкиСМС") <> Неопределено Тогда
		ТелефонныйКодСтраны = СокрЛП(НастройкиУведомлений.НастройкиСМС.ТелефонныйКодСтраны);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если Объект.Статус = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.СпособДоставки = Перечисления.ПЛ_СпособыДоставкиУведомлений.СервисПочтовойРассылки Тогда
		
		Если Не ЗначениеЗаполнено(Объект.ИмяОтправителя) Тогда
			Отказ = Истина;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru = '""Имя отправителя"" обязательно должно быть указано для рассылок и сообщений, отправляемых через сервисы почтовых рассылок.'");
			Сообщение.ПутьКДанным = "ПараметрыОтправки";
			Сообщение.Сообщить();
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Объект.ОбратныйАдрес) Тогда
			Отказ = Истина;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru = '""Обратный адрес"" обязательно должен быть указан для рассылок и сообщений, отправляемых через сервисы почтовых рассылок.'");
			Сообщение.ПутьКДанным = "ПараметрыОтправки";
			Сообщение.Сообщить();
		КонецЕсли;
	КонецЕсли;
	
	Если ИсточникСобытия = Перечисления.ПЛ_ИсточникиСобытий.Рассылка И Не ОтправкаВручную Тогда
		Если ЗначениеЗаполнено(Объект.ДатаОтправки) И Объект.ДатаОтправки < ТекущаяДатаСеанса() Тогда
			Отказ = Истина;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru = '""Дата отправки"" не должна быть меньше текущей.
				|Можно сохранить черновик, если не требуется отправлять сообщения.'");
			Сообщение.Поле = "Объект.ДатаОтправки";
			Сообщение.Сообщить();
		КонецЕсли;
	КонецЕсли;
	
	Если Отказ Тогда
		ТекстШаблона = ТекстШаблонаДоЗаписи;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ТекстШаблонаДоЗаписи = ТекстШаблона;
	ПолучитьТекстШаблона();
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	СписокПолучателей = "";
	
	// Сохранение условий для получателей уведомлений
	Для каждого Строка Из ТекущийОбъект.Получатели Цикл
		
		Если ЭтоАдресВременногоХранилища(Строка.АдресСхемыУсловий) Тогда
			СхемаУсловий = ПолучитьИзВременногоХранилища(Строка.АдресСхемыУсловий);
			Строка.СхемаУсловийОтправкиУведомления = Новый ХранилищеЗначения(СхемаУсловий);
		КонецЕсли;
		Если ЭтоАдресВременногоХранилища(Строка.АдресНастроекУсловий) Тогда
			НастройкиУсловий = ПолучитьИзВременногоХранилища(Строка.АдресНастроекУсловий);
			Строка.НастройкиУсловийОтправкиУведомления = Новый ХранилищеЗначения(НастройкиУсловий);
		КонецЕсли;
		
		Если ЭтоАдресВременногоХранилища(Строка.АдресСхемыВыборкиАдресатов) Тогда
			СхемаВыборкиАдресатов = ПолучитьИзВременногоХранилища(Строка.АдресСхемыВыборкиАдресатов);
			Строка.СхемаВыборкиАдресатов = Новый ХранилищеЗначения(СхемаВыборкиАдресатов);
		КонецЕсли;
		Если ЭтоАдресВременногоХранилища(Строка.АдресНастроекВыборкиАдресатов) Тогда
			НастройкиВыборкиАдресатов = ПолучитьИзВременногоХранилища(Строка.АдресНастроекВыборкиАдресатов);
			Строка.НастройкиВыборкиАдресатов = Новый ХранилищеЗначения(НастройкиВыборкиАдресатов);
		КонецЕсли;
		
		Если Строка.Включен Тогда
			СписокПолучателей = СписокПолучателей + СокрЛП(Строка(Строка.Адресат)) + "; ";
		КонецЕсли;
	КонецЦикла;
	
	ТекущийОбъект.СписокПолучателей = СписокПолучателей;
	
	ТекущийОбъект.ТекстСообщения = ТекстШаблона;
	
	// Сохранение шаблонов и таблиц текста сообщения
	Если ЭтоАдресВременногоХранилища(АдресСхемыКомпоновкиШаблонов) Тогда
		ТекущийОбъект.СхемаШаблонаТекстовСообщения = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(АдресСхемыКомпоновкиШаблонов));
	Иначе
		ТекущийОбъект.СхемаШаблонаТекстовСообщения = Новый ХранилищеЗначения(Неопределено);
	КонецЕсли;
	
	Если ЭтоАдресВременногоХранилища(АдресНастроекКомпоновкиШаблонов) Тогда
		ТекущийОбъект.НастройкиШаблонаТекстовСообщения = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(АдресНастроекКомпоновкиШаблонов));
	Иначе
		ТекущийОбъект.НастройкиШаблонаТекстовСообщения = Новый ХранилищеЗначения(Неопределено);
	КонецЕсли;
	
	Для каждого Строка Из ТекущийОбъект.ТаблицыШаблонов Цикл
		Если ЭтоАдресВременногоХранилища(Строка.АдресНастроек) Тогда
			НастройкиТаблицы = ПолучитьИзВременногоХранилища(Строка.АдресНастроек);
			Строка.Настройки = Новый ХранилищеЗначения(НастройкиТаблицы);
		КонецЕсли;
	КонецЦикла;
	
	ТекущийОбъект.Вложения.Очистить();
	ТекущийОбъект.ПрисоединенныеФайлы.Очистить();
	
	Если Не Объект.ОбычныйТекст Тогда
		// Вложения картинок
		Для Каждого Строка Из СписокИзображений Цикл
			ОписаниеФайла = Строка.Значение;
			НовоеВложение = ТекущийОбъект.Вложения.Добавить();
			ДвоичныеДанныеИзображения = ПолучитьИзВременногоХранилища(ОписаниеФайла.Адрес);
			Изображение = Новый Картинка(ДвоичныеДанныеИзображения);
			//Изображение
			НовоеВложение.Вложение = Новый ХранилищеЗначения(ДвоичныеДанныеИзображения);
			НовоеВложение.Идентификатор = ОписаниеФайла.Идентификатор;
			НовоеВложение.Имя = ОписаниеФайла.ИмяФайла;
			НовоеВложение.Картинка = Истина;
		КонецЦикла;
		
		// Присоединенные файлы
		Для каждого СтрокаФайла из ТаблицаПрисоединенныхФайлов Цикл
			НовоеВложение = ТекущийОбъект.ПрисоединенныеФайлы.Добавить();
			ЗаполнитьЗначенияСвойств(НовоеВложение, СтрокаФайла);
		КонецЦикла;
		
		ВставитьКартинкиВТекстHTML(ТекущийОбъект);
		ПЛ_УведомленияОСобытияхКлиентСервер.ВключитьРежимРедактированияHTML(ТекстШаблона);
	КонецЕсли;
	
	ТекущийОбъект.ДополнительныеСвойства.Вставить("ОтправкаВручную", ОтправкаВручную);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Оповестить("Запись_Уведомления");
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ЗаполнитьСостояние();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Завершено_редактирование_условий_получателя" Тогда
		
		Если ЗначениеЗаполнено(Параметр) Тогда
			ПрименитьИзменениеУсловий(Параметр);
		КонецЕсли;
		
	ИначеЕсли ИмяСобытия = "Завершено_редактирование_выборки_адресатов" Тогда
		
		Если ЗначениеЗаполнено(Параметр) Тогда
			ПрименитьИзменениеВыборкиАдресатов(Параметр);
			Элементы.Получатели.ЗакончитьРедактированиеСтроки(Ложь);
		КонецЕсли;
		
	ИначеЕсли ИмяСобытия = "Завершено_редактирование_текстов_сообщения" Тогда
		
		Если ЗначениеЗаполнено(Параметр) Тогда
			ПрименитьИзменениеШаблоновСообщения(Параметр);
		КонецЕсли;
		
	ИначеЕсли ИмяСобытия = "Запись_События_Для_Уведомлений" Тогда
		
		СобытиеПриИзмененииНаСервере();
		
	ИначеЕсли ИмяСобытия = "Запись_НастройкиУведомлений"
		Или ИмяСобытия = "Запись_НастройкиОтправкиSMS" Тогда
		
		ПроверитьНастройкиСпособовДоставки();
		УстановитьВидимостьДоступность();
		
	ИначеЕсли ИмяСобытия = "Настроены_Параметры_Отправки" Тогда
		
		ЗаполнитьЗначенияСвойств(Объект, Параметр);
		УстановитьПараметрыОтправки();
		ЭтаФорма.Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.ПЛ_События") Тогда
		Объект.Событие = ВыбранноеЗначение;
		СобытиеПриИзмененииНаСервере();
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

///////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ШАПКИ ФОРМЫ

&НаКлиенте
Процедура СобытиеПриИзменении(Элемент)
	
	СобытиеПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура СобытиеПриИзмененииНаСервере()
	
	Если Событие <> Объект.Событие Тогда
		
		РеквизитыСобытия = Справочники.ПЛ_События.РеквизитыСобытия(Объект.Событие);
		
		Если Не (ИсточникСобытия <> РеквизитыСобытия.ИсточникСобытия
			Или Регистратор <> РеквизитыСобытия.Регистратор) Тогда
			Возврат;
		КонецЕсли;
		
		Для каждого Получатель из Объект.Получатели Цикл
			Получатель.АдресСхемыУсловий = "";
			Получатель.АдресНастроекУсловий = "";
			Получатель.СтрокаУсловий = "<задать условие>";
			Получатель.ВидУсловийОтправкиУведомления = Перечисления.ПЛ_ВидыУсловийУведомлений.БезУсловия;
		КонецЦикла;
		
		АдресСхемыКомпоновкиШаблонов = "";
		АдресНастроекКомпоновкиШаблонов = "";
		
		Событие = Объект.Событие;
		ИсточникСобытия = РеквизитыСобытия.ИсточникСобытия;
		Регистратор = РеквизитыСобытия.Регистратор;
		
		Элементы.Событие.Подсказка = Строка(ИсточникСобытия);
		
		ЗапускВручную =
			ИсточникСобытия = Перечисления.ПЛ_ИсточникиСобытий.РегламентнаяПроверка
			Или ИсточникСобытия = Перечисления.ПЛ_ИсточникиСобытий.Рассылка;
			
		ЗапускПоПлану = (ИсточникСобытия = Перечисления.ПЛ_ИсточникиСобытий.Рассылка);
	КонецЕсли;
	
	УстановитьВидимостьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура СпособДоставкиПриИзменении(Элемент)
	
	Объект.ЭлПочта = (Объект.СпособДоставки = ПредопределенноеЗначение("Перечисление.ПЛ_СпособыДоставкиУведомлений.ЭлектроннаяПочта"));
	Объект.СервисПочтовойРассылки = (Объект.СпособДоставки = ПредопределенноеЗначение("Перечисление.ПЛ_СпособыДоставкиУведомлений.СервисПочтовойРассылки"));
	Объект.СМС = (Объект.СпособДоставки = ПредопределенноеЗначение("Перечисление.ПЛ_СпособыДоставкиУведомлений.СМС"));
	Объект.Напоминание = (Объект.СпособДоставки = ПредопределенноеЗначение("Перечисление.ПЛ_СпособыДоставкиУведомлений.ВнутреннееСообщение"));
	
	Если Объект.СМС Или Объект.Напоминание Тогда
		Если Не Объект.ОбычныйТекст Тогда
			ПолучитьHTMLИзПоляHTMLДокумента();
			ВыполнитьПереключениеОбычныйТекст();
		КонецЕсли;
		Объект.ДелениеПоАдресатам = ПредопределенноеЗначение("Перечисление.ПЛ_ДелениеУведомленийПоАдресатам.ОтдельноКаждому");
	ИначеЕсли Объект.ЭлПочта Или Объект.СервисПочтовойРассылки Тогда
		Если Объект.ОбычныйТекст Тогда
			ВыполнитьПереключениеHTML();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НадписьНастроитьНажатие(Элемент)
	
	Если Объект.ЭлПочта Или Объект.СервисПочтовойРассылки Тогда
		ОткрытьФорму("Справочник.ПЛ_УведомленияОСобытиях.Форма.НастройкиПараметровУведомлений");
	ИначеЕсли Объект.СМС Тогда
		Если СМСДоступны Тогда
			ОткрытьФорму("ОбщаяФорма.НастройкаОтправкиSMS");
		Иначе
			ОткрытьФорму("Справочник.ПЛ_УведомленияОСобытиях.Форма.НастройкиПараметровУведомлений");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТемаСообщенияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ВыбранноеЗначение <> Неопределено И Объект.Наименование <> ВыбранноеЗначение Тогда
		Модифицированность = Истина;
		Объект.Наименование = ВыбранноеЗначение;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаголовокПараметрыОтправкиНажатие(Элемент)
	
	СтруктураПараметровОтправки = Новый Структура;
	СтруктураПараметровОтправки.Вставить("ДелениеПоАдресатам",        Объект.ДелениеПоАдресатам);
	СтруктураПараметровОтправки.Вставить("ФильтрПоАдресатам",         Объект.ФильтрПоАдресатам);
	СтруктураПараметровОтправки.Вставить("ОбратныйАдрес",             Объект.ОбратныйАдрес);
	СтруктураПараметровОтправки.Вставить("ИмяОтправителя",            Объект.ИмяОтправителя);
	СтруктураПараметровОтправки.Вставить("КонтрольПовторнойОтправки", Объект.КонтрольПовторнойОтправки);
	СтруктураПараметровОтправки.Вставить("ЭлПочта",                   Объект.ЭлПочта Или Объект.СервисПочтовойРассылки);
	СтруктураПараметровОтправки.Вставить("СМС",                       Объект.СМС);
	СтруктураПараметровОтправки.Вставить("Напоминание",               Объект.Напоминание);
	СтруктураПараметровОтправки.Вставить("ИсточникСобытия",           ИсточникСобытия);
	
	ПараметрыФормы = Новый Структура("СтруктураПараметровОтправки", СтруктураПараметровОтправки);
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		ОткрытьФормуМодально("Справочник.ПЛ_УведомленияОСобытиях.Форма.РедактированиеПараметровОтправки", ПараметрыФормы, ЭтаФорма);
	#Иначе
		Выполнить("ОткрытьФорму(""Справочник.ПЛ_УведомленияОСобытиях.Форма.РедактированиеПараметровОтправки"", ПараметрыФормы, ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца)");
	#КонецЕсли
	
КонецПроцедуры

