КонецФункции

&НаСервереБезКонтекста
Процедура СтандартнаяСхемаУсловийДляСобытияНаСервере(Знач Событие, АдресСхемыКомпоновкиДанных, АдресНастроекКомпоновкиДанных)
	
	ОбъектСобытие = Событие.ПолучитьОбъект();
	
	СхемаИНастройки = ОбъектСобытие.СтандартнаяСхемаУсловийДляСобытия();
	АдресСхемыКомпоновкиДанных = ПоместитьВоВременноеХранилище(СхемаИНастройки.СКД, Новый УникальныйИдентификатор());
	АдресНастроекКомпоновкиДанных = ПоместитьВоВременноеХранилище(СхемаИНастройки.Настройки, Новый УникальныйИдентификатор());
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СтандартнаяСхемаШаблоновДляСобытияНаСервере(Знач Событие, АдресСхемыКомпоновкиДанных, АдресНастроекКомпоновкиДанных)
	
	ОбъектСобытие = Событие.ПолучитьОбъект();
	
	СхемаИНастройки = ОбъектСобытие.СтандартнаяСхемаШаблоновДляСобытия();
	АдресСхемыКомпоновкиДанных = ПоместитьВоВременноеХранилище(СхемаИНастройки.СКД, Новый УникальныйИдентификатор());
	АдресНастроекКомпоновкиДанных = ПоместитьВоВременноеХранилище(СхемаИНастройки.Настройки, Новый УникальныйИдентификатор());
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СтандартнаяСхемаВыборкиАдресатовДляСобытияНаСервере(Знач Событие, АдресСхемыКомпоновкиДанных, АдресНастроекКомпоновкиДанных)
	
	ОбъектСобытие = Событие.ПолучитьОбъект();
	
	СхемаИНастройки = ОбъектСобытие.СтандартнаяСхемаШаблоновДляСобытия();
	АдресСхемыКомпоновкиДанных = ПоместитьВоВременноеХранилище(СхемаИНастройки.СКД, Новый УникальныйИдентификатор());
	
	Настройки = СхемаИНастройки.Настройки;
	Если ТипЗнч(Настройки) = Тип("НастройкиКомпоновкиДанных") Тогда
		Настройки.Выбор.Элементы.Очистить();
	КонецЕсли;
	
	АдресНастроекКомпоновкиДанных = ПоместитьВоВременноеХранилище(Настройки, Новый УникальныйИдентификатор());
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыОтправки()
	
	ПараметрыОтправки = "";
	
	Если Объект.ДелениеПоАдресатам = Перечисления.ПЛ_ДелениеУведомленийПоАдресатам.СкрытыеКопии Тогда
		ДелениеПоАдресатам = НСтр("ru = 'Скрытыми копиями'");
	ИначеЕсли Объект.ДелениеПоАдресатам = Перечисления.ПЛ_ДелениеУведомленийПоАдресатам.ОтдельноКаждому Тогда
		Если Объект.ФильтрПоАдресатам Тогда
			ДелениеПоАдресатам = НСтр("ru = 'Отдельно каждому получателю с фильтром данных по получателям'");
		Иначе
			ДелениеПоАдресатам = НСтр("ru = 'Отдельно каждому получателю'");
		КонецЕсли;
	Иначе
		ДелениеПоАдресатам = НСтр("ru = 'Общие для всех получателей'");
	КонецЕсли;
	ПараметрыОтправки = ДелениеПоАдресатам;
	
	Если Объект.ЭлПочта Или Объект.СервисПочтовойРассылки Тогда
		Если ЗначениеЗаполнено(Объект.ИмяОтправителя) Тогда
			ПараметрыОтправки = ПараметрыОтправки + "; " + НСтр("ru = 'От: '") + Объект.ИмяОтправителя;
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.ЭлПочта Или Объект.СервисПочтовойРассылки Тогда
		Если ЗначениеЗаполнено(Объект.ОбратныйАдрес) Тогда
			ПараметрыОтправки = ПараметрыОтправки + "; " + НСтр("ru = 'Обратный адрес: '") + Объект.ОбратныйАдрес;
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.КонтрольПовторнойОтправки Тогда
		ПараметрыОтправки = ПараметрыОтправки
			+ ?(ЗначениеЗаполнено(ПараметрыОтправки), "; ", "")
			+ НСтр("ru = 'Контролировать уникальность'");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОтправитьНаСервере()
	
	Попытка
		АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, ЭтаФорма.УникальныйИдентификатор);
		ПЛ_УведомленияОСобытиях.УведомленияПоРегламентнымПроверкам(Объект.Событие, Объект.Ссылка, АдресРезультата);
		
		Если ИсточникСобытия = Перечисления.ПЛ_ИсточникиСобытий.Рассылка Тогда
		
			Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
			
			СправочникОбъект = РеквизитФормыВЗначение("Объект");
			СправочникОбъект.Статус = -1;
			
			Если Результат <> Неопределено Тогда
				Если Результат.ОтправленныеСообщения.Количество() Тогда
					Для каждого ОтправленноеСообщение Из Результат.ОтправленныеСообщения Цикл
						Если ОтправленноеСообщение.Уведомление = Объект.Ссылка Тогда
							Если ОтправленноеСообщение.СпособДоставки = Перечисления.ПЛ_СпособыДоставкиУведомлений.СервисПочтовойРассылки Тогда
								Если ОтправленноеСообщение.Свойство("ИдентификаторСообщения") И ОтправленноеСообщение.ИдентификаторСообщения <> Неопределено Тогда
									СправочникОбъект.Статус = 2;
									СправочникОбъект.ИдентификаторСообщения = ОтправленноеСообщение.ИдентификаторСообщения;
								КонецЕсли;
							Иначе
								СправочникОбъект.Статус = 2;
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
				ИначеЕсли ЗначениеЗаполнено(Результат.ОписаниеОшибки) Тогда
					Сообщить(НСтр("ru='Не удалось отправить рассылку по причине:'") + " " + Результат.ОписаниеОшибки
						+ " " + НСтр("ru='Подробное описание см. в журнале регистрации.'"));
				КонецЕсли;
			КонецЕсли;
			
			СправочникОбъект.Записать();
			ЗначениеВРеквизитФормы(СправочникОбъект, "Объект");
			
			ЗаполнитьСостояние();
			УстановитьВидимостьДоступность();
		КонецЕсли;
		
	Исключение
		
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Отправка уведомления о событии'"),
			УровеньЖурналаРегистрации.Предупреждение,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
	КонецПопытки;
	
КонецПроцедуры

// Применение СКД

&НаСервере
Процедура ПрименитьИзменениеУсловий(СтруктураРезультата)
	
	НомерСтроки = СтруктураРезультата.НомерСтроки;
	Объект.Получатели[НомерСтроки - 1].АдресСхемыУсловий = СтруктураРезультата.АдресСхемы;
	Объект.Получатели[НомерСтроки - 1].АдресНастроекУсловий = СтруктураРезультата.АдресНастроек;
	
	НастройкиУсловий = ПолучитьИзВременногоХранилища(СтруктураРезультата.АдресНастроек);
	Если ЗначениеЗаполнено(НастройкиУсловий)
		И НастройкиУсловий.Отбор.Элементы.Количество() Тогда
		Объект.Получатели[НомерСтроки - 1].СтрокаУсловий = Строка(НастройкиУсловий.Отбор);
		Объект.Получатели[НомерСтроки - 1].ВидУсловийОтправкиУведомления = Перечисления.ПЛ_ВидыУсловийУведомлений.ОтборПоИсточнику;
	Иначе
		Объект.Получатели[НомерСтроки - 1].СтрокаУсловий = "<" + НСтр("ru = 'задать условие'") + ">";
		Объект.Получатели[НомерСтроки - 1].ВидУсловийОтправкиУведомления = Перечисления.ПЛ_ВидыУсловийУведомлений.БезУсловия;
	КонецЕсли;
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ПрименитьИзменениеВыборкиАдресатов(СтруктураРезультата)
	
	НомерСтроки = СтруктураРезультата.НомерСтроки;
	Объект.Получатели[НомерСтроки - 1].АдресСхемыВыборкиАдресатов = СтруктураРезультата.АдресСхемы;
	Объект.Получатели[НомерСтроки - 1].АдресНастроекВыборкиАдресатов = СтруктураРезультата.АдресНастроек;
	Объект.Получатели[НомерСтроки - 1].СпособАдресацииУведомления = Перечисления.ПЛ_СпособыАдресацииУведомлений.Запрос;
	Объект.Получатели[НомерСтроки - 1].Включен = Истина;
	Объект.Получатели[НомерСтроки - 1].Адресат = СтруктураРезультата.АдресатСтрокой;
	Если Не ЗначениеЗаполнено(Объект.Получатели[НомерСтроки - 1].ВидУсловийОтправкиУведомления) Тогда
		Объект.Получатели[НомерСтроки - 1].ВидУсловийОтправкиУведомления = Перечисления.ПЛ_ВидыУсловийУведомлений.БезУсловия;
	КонецЕсли;
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ПрименитьИзменениеШаблоновСообщения(СтруктураРезультата)
	
	ЭтаФорма.АдресСхемыКомпоновкиШаблонов = СтруктураРезультата.АдресСхемы;
	ЭтаФорма.АдресНастроекКомпоновкиШаблонов = СтруктураРезультата.АдресНастроек;
	
	ТекстШаблона = СтруктураРезультата.ТекстСообщения;
	
	Если СтруктураРезультата.ТипСообщения = Перечисления.ПЛ_СпособыДоставкиУведомлений.ЭлектроннаяПочта
		Или СтруктураРезультата.ТипСообщения = Перечисления.ПЛ_СпособыДоставкиУведомлений.СервисПочтовойРассылки Тогда
		
		Объект.ОбычныйТекст    = СтруктураРезультата.ОбычныйТекст;
		Объект.Наименование    = СтруктураРезультата.ТемаСообщения;
		
		Если Не Объект.ОбычныйТекст Тогда
			ПЛ_УведомленияОСобытияхКлиентСервер.ВключитьРежимРедактированияHTML(ТекстШаблона);
		КонецЕсли;
		
		Объект.ТаблицыШаблонов.Загрузить(ПолучитьИзВременногоХранилища(СтруктураРезультата.АдресТаблиц));
		
		ТаблицаПечатныхФорм = ПолучитьИзВременногоХранилища(СтруктураРезультата.АдресПечатныхФорм);
		Отбор = Новый Структура;
		Отбор.Вставить("Пометка", Истина);
		ВыбранныеПечатныеФормы = ТаблицаПечатныхФорм.НайтиСтроки(Отбор);
		
		Объект.ПечатныеФормы.Очистить();
		Для каждого ВыбраннаяПечатнаяФорма Из ВыбранныеПечатныеФормы Цикл
			НоваяПечатнаяФорма = Объект.ПечатныеФормы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяПечатнаяФорма, ВыбраннаяПечатнаяФорма);
		КонецЦикла;
		Объект.ФорматВложений = СтруктураРезультата.ФорматВложений;
		
		ТаблицаПрисоединенныхФайлов.Очистить();
		ТаблицаПрисоединенныхФайлов.Загрузить(ПолучитьИзВременногоХранилища(СтруктураРезультата.АдресПрисоединенныхФайлов));
		
		ОбновитьЗаголовокВложений();
		УстановитьВидимостьДоступность();
		
	ИначеЕсли СтруктураРезультата.ТипСообщения = Перечисления.ПЛ_СпособыДоставкиУведомлений.СМС Тогда
		
		Объект.ОбычныйТекст    = Истина;
		Объект.ТекстСообщения  = СтруктураРезультата.ТекстСообщения;
		
	ИначеЕсли СтруктураРезультата.ТипСообщения = Перечисления.ПЛ_СпособыДоставкиУведомлений.ВнутреннееСообщение Тогда
		
		Объект.ОбычныйТекст    = Истина;
		Объект.Наименование    = СтруктураРезультата.ТемаСообщения;
		Объект.ТекстСообщения  = СтруктураРезультата.ТекстСообщения;
		
	КонецЕсли;
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

// Прочее

&НаСервере
Процедура ПроверитьНастройкиСпособовДоставки()
	
	ПЛ_УведомленияОСобытиях.ПроверитьНастройкиСпособовДоставки(ПочтаНастроена, СМСДоступны, СМСНастроены, НапоминанияДоступны, РассылкиНастроены);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьЗаголовокВложений()
	
	ЗаголовокВложений = "";
	Для каждого СтрокаПечатныхФорм ИЗ Объект.ПечатныеФормы Цикл
		ЗаголовокВложений = ЗаголовокВложений + ?(ЗаголовокВложений = "", "", "; ") + СтрокаПечатныхФорм.ПечатнаяФорма;
	КонецЦикла;
	
	Для каждого СтрокаВложений Из ТаблицаПрисоединенныхФайлов Цикл
		ЗаголовокВложений = ЗаголовокВложений + ?(ЗаголовокВложений = "", "", "; ") + СтрокаВложений.Имя;
	КонецЦикла;
	
	Элементы.ГруппаВложения.Видимость = ЗначениеЗаполнено(ЗаголовокВложений);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСостояние()
	
	Если Объект.Статус = 0 Тогда
		Заголовок = НСтр("ru = '<Черновик>'");
	ИначеЕсли Объект.Статус = 2 Тогда
		Элементы.ЗаголовокВыполнить.Заголовок = НСтр("ru = '<Отправлено>'");
	ИначеЕсли Объект.Статус = -1 Тогда
		Заголовок = НСтр("ru = '<Ошибка отправки>'");
	Иначе
		Заголовок = "";
	КонецЕсли;
	
	Если Объект.Статус = 2 Тогда
		Элементы.ЗаголовокВыполнить.Заголовок = НСтр("ru = 'Отправлено:'");
	Иначе
		Элементы.ЗаголовокВыполнить.Заголовок = НСтр("ru = 'Отправить:'");
	КонецЕсли;
	
КонецПроцедуры

// HTML

&НаКлиенте
Процедура ПолучитьHTMLИзПоляHTMLДокумента()
	
	Если Не Объект.ОбычныйТекст Тогда
		HTMLДокумент = Элементы.ТекстСообщенияHTML.Документ;
		Если HTMLДокумент <> Неопределено Тогда
			Head = HTMLДокумент.head.innerHTML;
			Body = HTMLДокумент.body.innerHTML;
			ТекстШаблона = "<html><head>" + Head + "</head>" + "<body>" + Body + "</body></html>";
			ЗапомнитьПозициюHTML();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапомнитьПозициюHTML()
	
	#Если ВебКлиент Тогда
		Возврат;
	#КонецЕсли
	
	HTMLДокумент = Элементы.ТекстСообщенияHTML.Документ;
	
	Попытка
		ie9_body = HTMLДокумент.ie9_body;
	Исключение
		Возврат;
	КонецПопытки;
	
	Попытка
		
		Выделение = HTMLДокумент.getSelection();
		
		Узел = Выделение.getRangeAt(0).startContainer;
		ТекущееПоложениеНачало = Выделение.getRangeAt(0).startOffset;
		ТекущееПоложениеКонец = Выделение.getRangeAt(0).endOffset;
		
		Счетчик = 0;
		НайденныйНомерУзла = -1;
		Результат = НайтиНомерУзла(HTMLДокумент, Узел, Счетчик, НайденныйНомерУзла);
		
		ТекущийНомерУзла = НайденныйНомерУзла;
		
		ГоризонтальнаяПрокруткаHTML = HTMLДокумент.body.scrollLeft;
		ВертикальнаяПрокруткаHTML = HTMLДокумент.body.scrollTop;
		
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Функция НайтиНомерУзла(ТекущийУзел, ВыделенныйУзел, Счетчик, НайденныйНомерУзла)
	
	Если ТекущийУзел.childNodes.length = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого Узел Из ТекущийУзел.childNodes Цикл
		
		Счетчик = Счетчик + 1;
		
		Если Узел = ВыделенныйУзел Тогда
			НайденныйНомерУзла = Счетчик;
			Возврат Истина;
		КонецЕсли;
		
		Результат = НайтиНомерУзла(Узел, ВыделенныйУзел, Счетчик, НайденныйНомерУзла);
		Если Результат = Истина Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Процедура ВыполнитьПереключениеОбычныйТекст()
	
	ТекстШаблона = ПЛ_УведомленияОСобытияхКлиентСервер.ПолучитьТекстИзHTML(ТекстШаблона);
	Объект.ТекстСообщения = ТекстШаблона;
	Объект.ОбычныйТекст = Истина;
	
	УстановитьВидимостьДоступность();
	УстановитьПараметрыОтправки();
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьПереключениеHTML()
	
	ТекстШаблона = ПЛ_УведомленияОСобытияхКлиентСервер.ПолучитьHTMLИзТекста(ТекстШаблона);
	ПЛ_УведомленияОСобытияхКлиентСервер.ВключитьРежимРедактированияHTML(ТекстШаблона);
	Объект.ОбычныйТекст = Ложь;
	
	УстановитьВидимостьДоступность();
	УстановитьПараметрыОтправки();
	
КонецПроцедуры

&НаСервере
Процедура ВставитьКартинкиВТекстHTML(СправочникОбъект)
	
	ДокументHTML = ПЛ_УведомленияОСобытияхКлиентСервер.ПолучитьДокументHTMLИзТекстаHTML(ТекстШаблона);
	
	Для каждого Картинка Из ДокументHTML.Картинки Цикл
		
		АтрибутИсточникКартинки = Картинка.Атрибуты.ПолучитьИменованныйЭлемент("src");
		ИдентификаторКартинки = Сред(АтрибутИсточникКартинки.ТекстовоеСодержимое, СтрДлина("cid:") + 1);
		
		СтрокаВложения = СправочникОбъект.Вложения.Найти(ИдентификаторКартинки, "Идентификатор");
		Если СтрокаВложения <> Неопределено Тогда
			
			ИмяВремФайла = КаталогВременныхФайлов() + СтрокаВложения.Имя;
			СтрокаВложения.Вложение.Получить().Записать(ИмяВремФайла);
			
			НовыйАтрибутКартинки = АтрибутИсточникКартинки.КлонироватьУзел(Ложь);
			НовыйАтрибутКартинки.ТекстовоеСодержимое = "file://" + ИмяВремФайла;
			Картинка.Атрибуты.УстановитьИменованныйЭлемент(НовыйАтрибутКартинки);
		КонецЕсли;
	КонецЦикла;
	
	КоллекцияТаблиц = ДокументHTML.ПолучитьЭлементыПоИмени("TABLE");
	Для каждого ЭлементКоллекции Из КоллекцияТаблиц Цикл
		Для каждого Атрибут Из ЭлементКоллекции.Атрибуты Цикл
			Если ВРег(Атрибут.Имя) = "BACKGROUND" Тогда
				
				Если Найти(Атрибут.Значение, "cid") Тогда
					
					ИдентификаторКартинки = Сред(Атрибут.Значение, СтрДлина("cid:") + 1);
					
					СтрокаВложения = СправочникОбъект.Вложения.Найти(ИдентификаторКартинки, "Идентификатор");
					Если СтрокаВложения <> Неопределено Тогда
						ИмяВремФайла = КаталогВременныхФайлов() + СтрокаВложения.Имя;
						СтрокаВложения.Вложение.Получить().Записать(ИмяВремФайла);
						Атрибут.ЗначениеУзла = "file://" + ИмяВремФайла;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ТекстШаблона = ПЛ_УведомленияОСобытияхКлиентСервер.ПолучитьТекстHTMLИзДокументаHTML(ДокументHTML);
	
КонецПроцедуры

