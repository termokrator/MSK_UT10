&НаСервере
Процедура ПолучитьДанныеФайлов(МассивФайлов)
	
	Для каждого ИмяФайла Из МассивФайлов Цикл
		ВыбФайл = Новый Файл(ИмяФайла);
		
		Если ВыбФайл.Существует() Тогда
			Данные = Новый ДвоичныеДанные(ИмяФайла);
		
			НовоеВложение = ТаблицаПрисоединенныхФайлов.Добавить();
			НовоеВложение.Имя = ВыбФайл.Имя;
			НовоеВложение.Вложение = Новый ХранилищеЗначения(Данные);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры


