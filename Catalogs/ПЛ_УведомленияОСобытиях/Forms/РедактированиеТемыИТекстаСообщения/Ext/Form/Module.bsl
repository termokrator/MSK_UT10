Перем ТекущееПоложениеКонец; // позиция конца выделения в блоке текста в HTML письме

&НаКлиенте
Перем ТекущийНомерУзла; // номер текущего узла в HTML письме

&НаКлиенте
Перем ГоризонтальнаяПрокруткаHTML; // положение гор прокрутки в HTML письме
&НаКлиенте
Перем ВертикальнаяПрокруткаHTML; // положение вертикальной прокрутки в HTML письме

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВерсияУТ    = ПЛ_УведомленияОСобытиях.ВерсияУТ();
	Платформа83 = ПЛ_УведомленияОСобытиях.Платформа83();
	ЭтоТакси    = ПЛ_Функции83.ЭтоТакси();
	
	ТипСообщения = Параметры.ТипСообщения;
	
	ТипСообщенияЭлПочта = (ТипСообщения = Перечисления.ПЛ_СпособыДоставкиУведомлений.ЭлектроннаяПочта
		Или ТипСообщения = Перечисления.ПЛ_СпособыДоставкиУведомлений.СервисПочтовойРассылки);
	
	ВидимостьТемы = ТипСообщенияЭлПочта Или (ТипСообщения = Перечисления.ПЛ_СпособыДоставкиУведомлений.ВнутреннееСообщение);
	Элементы.ТемаСообщения.Видимость          = ВидимостьТемы;
	Элементы.ПроверкаТемыСообщения.Видимость  = ВидимостьТемы;
	
	ОбычныйТекст                   = Параметры.ОбычныйТекст;
	Элементы.ОбычныйТекст.Пометка  = ОбычныйТекст;
	
	ТемаСообщения.Добавить(Параметры.ТемаСообщения);
	
	СтруктураВложений = Новый Структура;
	Если Параметры.Свойство("СтруктураВложений") Тогда
		СтруктураВложений = Параметры.СтруктураВложений;
	КонецЕсли;
	
	Если Параметры.Свойство("ФорматВложений") Тогда
		ФорматВложений = Параметры.ФорматВложений;
	КонецЕсли;
	
	ТекстШаблона = Параметры.ТекстСообщения;
	Если ПустаяСтрока(ТекстШаблона) Тогда
		ТекстШаблона = " ";
	КонецЕсли;
	
	Если Не ОбычныйТекст Тогда
		ПЛ_УведомленияОСобытияхКлиентСервер.ВключитьРежимРедактированияHTML(ТекстШаблона);
	КонецЕсли;
	
	ИдентификаторВладельца = Параметры.УникальныйИдентификатор;
	
	// Исходная схема компоновки данных копируется в редактируемую схему компоновки данных
	ПЛ_УведомленияОСобытиях.СкопироватьСхемуКомпоновкиДанных(АдресСхемыКомпоновкиШаблонов, Параметры.АдресСхемыКомпоновкиШаблонов);
	
	Если ЗначениеЗаполнено(АдресСхемыКомпоновкиШаблонов) Тогда
		ПЛ_УведомленияОСобытиях.ИнициализироватьКомпоновщикНастроек(КомпоновщикНастроек, АдресСхемыКомпоновкиШаблонов, Параметры.АдресНастроекКомпоновкиШаблонов);
	КонецЕсли;
	
	Если Параметры.Свойство("ИсточникСобытия", ТипОбъекта)
		И Параметры.Свойство("Регистратор", Регистратор) Тогда
		
		Если ТипОбъекта = Перечисления.ПЛ_ИсточникиСобытий.ИсточникСправочник Тогда
			
			СинонимРегистратора = Метаданные["Справочники"][Регистратор].Синоним;
			
			СтрокаЗаголовка = НСтр("ru = 'Справочник ""%Регистратор%""'");
			СтрокаЗаголовка = СтрЗаменить(СтрокаЗаголовка, "%Регистратор%", СинонимРегистратора);
			Элементы.ОбъектПроверки.Заголовок = СтрокаЗаголовка;
			
			МассивТипов = Новый Массив;
			МассивТипов.Добавить(Тип("СправочникСсылка." + Регистратор));
			ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
			Элементы.ОбъектПроверки.ОграничениеТипа = ОписаниеТипов;
			
		ИначеЕсли ТипОбъекта = Перечисления.ПЛ_ИсточникиСобытий.ИсточникДокумент
			Или ТипОбъекта = Перечисления.ПЛ_ИсточникиСобытий.ИсточникЗаписьДокумента Тогда
			
			СинонимРегистратора = Метаданные["Документы"][Регистратор].Синоним;
			
			СтрокаЗаголовка = НСтр("ru = 'Документ ""%Регистратор%""'");
			СтрокаЗаголовка = СтрЗаменить(СтрокаЗаголовка, "%Регистратор%", СинонимРегистратора);
			Элементы.ОбъектПроверки.Заголовок = СтрокаЗаголовка;
			
			МассивТипов = Новый Массив;
			МассивТипов.Добавить(Тип("ДокументСсылка." + Регистратор));
			ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
			Элементы.ОбъектПроверки.ОграничениеТипа = ОписаниеТипов;
			
		ИначеЕсли ТипОбъекта = Перечисления.ПЛ_ИсточникиСобытий.ИсточникРегистрСведений Тогда
			
			Элементы.ГруппаКнопкиПроверки.Видимость = Ложь;
			
		ИначеЕсли ТипОбъекта = Перечисления.ПЛ_ИсточникиСобытий.РегламентнаяПроверка
			Или ТипОбъекта = Перечисления.ПЛ_ИсточникиСобытий.Рассылка Тогда
			
			Элементы.ОбъектПроверки.Видимость = Ложь;
			
		КонецЕсли;
	КонецЕсли;
	
	ДелениеПоАдресатам  = Параметры.ДелениеПоАдресатам;
	ФильтрПоАдресатам   = Параметры.ФильтрПоАдресатам;
	Если ФильтрПоАдресатам И (ДелениеПоАдресатам = Перечисления.ПЛ_ДелениеУведомленийПоАдресатам.ОтдельноКаждому) Тогда
		ТаблицаПолучателей.Загрузить(ПолучитьИзВременногоХранилища(Параметры.АдресТаблицыПолучателей));
		Элементы.ПроверкаТемыСообщения.Видимость = Ложь;
		Элементы.ПроверкаТекстаСообщения.Заголовок = "Проверка темы и текста сообщения для каждого из адресатов";
	КонецЕсли;
	
	// Таблицы
	Таблицы.Загрузить(ПолучитьИзВременногоХранилища(Параметры.АдресТаблицШаблонов));
	
	СтрокаДобавить = Таблицы.Добавить();
	СтрокаДобавить.Имя = "<добавить таблицу>";
	ИдентификаторСтрокиТаблицДобавить = СтрокаДобавить.ПолучитьИдентификатор();
	
	Элементы.ГруппаТаблицы.Видимость = ТипСообщенияЭлПочта;
	
	// Печатные формы
	ПечатныеФормыДоступны = Ложь;
	
	Если ТипСообщенияЭлПочта
		И (ТипОбъекта = Перечисления.ПЛ_ИсточникиСобытий.ИсточникДокумент
			Или ТипОбъекта = Перечисления.ПЛ_ИсточникиСобытий.ИсточникЗаписьДокумента
			Или ТипОбъекта = Перечисления.ПЛ_ИсточникиСобытий.ИсточникСправочник) Тогда
			
		Если ВерсияУТ = "10" Тогда
			ЗаполнитьСписокПечатныхФормУТ10(ПолучитьИзВременногоХранилища(Параметры.АдресПечатныхФорм));
			ПечатныеФормыДоступны = Истина;
		ИначеЕсли ВерсияУТ = "11" Тогда
			ЗаполнитьСписокПечатныхФормУТ11(ПолучитьИзВременногоХранилища(Параметры.АдресПечатныхФорм));
			ПечатныеФормыДоступны = Истина;
		КонецЕсли;
		
		ЗаполнитьСписокВыбораФорматаВложений();
	КонецЕсли;
	
	// Присоединенные файлы
	ТаблицаПрисоединенныхФайлов.Загрузить(ПолучитьИзВременногоХранилища(Параметры.АдресПрисоединенныхФайлов));
	
	Элементы.ПечатныеФормы.Видимость       = ПечатныеФормыДоступны;
	Элементы.ФорматВложений.Видимость      = ПечатныеФормыДоступны;
	Элементы.ДобавитьВложение.Видимость    = ТипСообщенияЭлПочта;
	
	Элементы.ГруппаПроверкаШаблона.Видимость = Ложь;
	
	Элементы.ЗаголовокВложений82.Видимость   = Не Платформа83;
	Элементы.УдалитьВложения.Видимость       = Не Платформа83;
	
	УправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	#Если ТолстыйКлиентОбычноеПриложение ИЛИ ТолстыйКлиентУправляемоеПриложение Тогда
		Если ТипЗнч(ИсточникВыбора) = Тип("КонструкторСхемыКомпоновкиДанных") Тогда // Отредактирована схема компоновки
			ИзмененаСхемаКомпоновкиДанных(ВыбранноеЗначение, АдресСхемыКомпоновкиШаблонов, КомпоновщикНастроек);
		КонецЕсли;
	#КонецЕсли
	
	Если ТипЗнч(ИсточникВыбора) = Тип("УправляемаяФорма") Тогда // Отредактирована структура таблицы
		ОбработатьДобавлениеИзменениеТаблицы(ВыбранноеЗначение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьЗаголовокВложений();
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура ДоступныеПоляНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	
	ТекстЭлемента = Строка(КомпоновщикНастроек.Настройки.ДоступныеПоляВыбора.ПолучитьОбъектПоИдентификатору(Элементы.ДоступныеПоля.ТекущаяСтрока).Поле);
	ПараметрыПеретаскивания.Значение = ОбработатьТекстОперанда(ТекстЭлемента);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицыНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	
	Если Элемент.ТекущиеДанные.Имя = "<добавить таблицу>" Тогда
		Выполнение = Ложь;
	Иначе
		ТекстЭлемента = "Таблицы." + Элемент.ТекущиеДанные.Имя;
		ПараметрыПеретаскивания.Значение = ОбработатьТекстОперанда(ТекстЭлемента);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектПроверкиПриИзменении(Элемент)
	
	ПроверкаТемыСообщения.Удалить();
	ПроверкаТекстаСообщения = "";
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	ИдентификаторСтроки = ТекущиеДанные.ПолучитьИдентификатор();
	
	ОткрытьФормуРедактированияТаблицы(ТекущиеДанные.АдресНастроек, ИдентификаторСтроки);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
	ОткрытьФормуРедактированияТаблицы(, ИдентификаторСтрокиТаблицДобавить);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицыПередНачаломИзменения(Элемент, Отказ)
	
	Если Элемент.ТекущиеДанные.Имя = "<добавить таблицу>" Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицыПередУдалением(Элемент, Отказ)
	
	Если Элемент.ТекущиеДанные.Имя = "<добавить таблицу>" Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатныеФормыПриИзменении(Элемент)
	
	ОбновитьЗаголовокВложений();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаголовокВложенийОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ИмяФайла = Лев(НавигационнаяСсылкаФорматированнойСтроки,
		СтрДлина(НавигационнаяСсылкаФорматированнойСтроки) - СтрДлина("ОткрытьФайл_d8d4e005-6748-46a3-b48f-7216f988a286") - 1);
	
	Если Найти(НавигационнаяСсылкаФорматированнойСтроки, "ОткрытьФайл_d8d4e005-6748-46a3-b48f-7216f988a286") Тогда
		
		Отбор = Новый Структура;
		Отбор.Вставить("Имя", ИмяФайла);
		СтрокиПрисоединенныхФайлов = ТаблицаПрисоединенныхФайлов.НайтиСтроки(Отбор);
		Для каждого СтрокаПрисоединенногоФайла Из СтрокиПрисоединенныхФайлов Цикл
			ОткрытьФайл(СтрокаПрисоединенногоФайла);
		КонецЦикла;
		
	ИначеЕсли Найти(НавигационнаяСсылкаФорматированнойСтроки, "УдалитьФайл_f11fba53-abab-4616-a7e2-2faec7bba8e1") Тогда
		
		Отбор = Новый Структура;
		Отбор.Вставить("ПечатнаяФорма", ИмяФайла);
		СтрокиПечатныхФорм = ПечатныеФормы.НайтиСтроки(Отбор);
		Для каждого СтрокаПечатнойФормы Из СтрокиПечатныхФорм Цикл
			СтрокаПечатнойФормы.Пометка = Ложь;
		КонецЦикла;
		
		УдаляемыеФайлы = Новый Массив;
		
		Отбор = Новый Структура;
		Отбор.Вставить("Имя", ИмяФайла);
		СтрокиПрисоединенныхФайлов = ТаблицаПрисоединенныхФайлов.НайтиСтроки(Отбор);
		Для каждого СтрокаПрисоединенногоФайла Из СтрокиПрисоединенныхФайлов Цикл
			ТаблицаПрисоединенныхФайлов.Удалить(СтрокаПрисоединенногоФайла);
		КонецЦикла;
		
		ОбновитьЗаголовокВложений();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппаСообщениеПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	ПриСменеСтраницыСообщения();
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверкаТекстаСообщенияПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если ДанныеСобытия.Href <> Неопределено Тогда
		ПерейтиПоНавигационнойСсылке(ДанныеСобытия.Href);
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура КомандаГотово(Команда)
	
	ЗавершитьРедактированиеТекстов();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПроверить(Команда)
	
	Если ЗначениеЗаполнено(ОбъектПроверки)
		Или ТипОбъекта = ПредопределенноеЗначение("Перечисление.ПЛ_ИсточникиСобытий.РегламентнаяПроверка")
		Или ТипОбъекта = ПредопределенноеЗначение("Перечисление.ПЛ_ИсточникиСобытий.Рассылка") Тогда
		
		Если Элементы.ГруппаСообщение.ТекущаяСтраница = Элементы.СтраницаТекстШаблона Тогда
			ПолучитьHTMLИзПоляHTMLДокумента();
		Иначе
			ТекстШаблона = КодHTML.ПолучитьТекст();
		КонецЕсли;
		
		ПроверитьШаблоныНаСервере();
		
		Если Не ОбычныйТекст Тогда
			ПЛ_УведомленияОСобытияхКлиентСервер.ВключитьРежимРедактированияHTML(ТекстШаблона);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидимостьЭлементовПроверки(Команда)

	Элементы.ГруппаПроверкаШаблона.Видимость = НЕ Элементы.ГруппаПроверкаШаблона.Видимость;
	Элементы.ПроверкаШаблонов.Картинка =
		?(Элементы.ГруппаПроверкаШаблона.Видимость, БиблиотекаКартинок.ПЛ_Свернуть, БиблиотекаКартинок.ПЛ_Развернуть);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбычныйТекст(Команда)
	
	Если Не ОбычныйТекст Тогда
		ПолучитьHTMLИзПоляHTMLДокумента();
		ВыполнитьПереключениеОбычныйТекст();
	Иначе
		ВыполнитьПереключениеHTML();
	КонецЕсли;
	
	Элементы.ОбычныйТекст.Пометка = ОбычныйТекст;
	
КонецПроцедуры

&НаКлиенте
Процедура РедактироватьСхему(Команда)
	
	#Если ТолстыйКлиентОбычноеПриложение ИЛИ ТолстыйКлиентУправляемоеПриложение Тогда
		
		ПоместитьНастройкиВСхемуКомпоновкиДанных(КомпоновщикНастроек, АдресСхемыКомпоновкиШаблонов);
		
		// Создается копия редактируемой схемы
		СхемаКомпоновкиДанных = СериализаторXDTO.ПрочитатьXDTO(СериализаторXDTO.ЗаписатьXDTO(ПолучитьИзВременногоХранилища(АдресСхемыКомпоновкиШаблонов)));
		
		// Копия редактируемой схемы открывается в конструкторе
		Конструктор = Новый КонструкторСхемыКомпоновкиДанных(СхемаКомпоновкиДанных);
		Конструктор.Редактировать(ЭтаФорма);
		
	#Иначе
		
		Предупреждение(НСтр("ru='Для редактирования схемы компоновки необходимо запустить конфигурацию в режиме толстого клиента.'"));
		
	#КонецЕсли
	
