&НаСервере
Процедура ПроверитьШаблоныНаСервере()
	
	СтрокаТемыСообщения = ТемаСообщения.ПолучитьТекст();
	СтрокаТекстаСообщения = "";
	СтруктураВложений = Новый Структура;
	
	СтрокаТекстаСообщения = ТекстШаблона;
	
	ШаблоныТаблиц = Таблицы.Выгрузить();
	ШаблоныТаблиц.Удалить(ШаблоныТаблиц[ШаблоныТаблиц.Количество()-1]);
	
	ПоместитьНастройкиВСхемуКомпоновкиДанных(КомпоновщикНастроек, АдресСхемыКомпоновкиШаблонов);
	АдресНастроек = ПолучитьНастройкиКомпоновщика(КомпоновщикНастроек, ИдентификаторВладельца);
	
	Если Не ФильтрПоАдресатам Тогда
		
		Попытка
			ПЛ_УведомленияОСобытиях.ТекстыПоШаблонам(ТипОбъекта, ОбъектПроверки,
				АдресСхемыКомпоновкиШаблонов, АдресНастроек,
				ШаблоныТаблиц, ОбычныйТекст,
				СтрокаТемыСообщения, СтрокаТекстаСообщения);
		Исключение
		КонецПопытки;
		
		ПроверкаТемыСообщения.Удалить();
		ПроверкаТемыСообщения.Добавить(СтрокаТемыСообщения);
		
		Если ОбычныйТекст Тогда
			ФорматированныйДокумент = Новый ФорматированныйДокумент;
			ФорматированныйДокумент.Добавить(СтрокаТекстаСообщения);
			ФорматированныйДокумент.ПолучитьHTML(ПроверкаТекстаСообщения, Новый Структура);
		Иначе
			ДокументHTML = ПЛ_УведомленияОСобытияхКлиентСервер.ПолучитьДокументHTMLИзТекстаHTML(СтрокаТекстаСообщения);
			ПроверкаТекстаСообщения = ПЛ_УведомленияОСобытияхКлиентСервер.ПолучитьТекстHTMLИзДокументаHTML(ДокументHTML);
		КонецЕсли;
		
	// Выборка при отправке отдельно каждому адресату фильтруется для отбора данных каждого адресата в отдельности
	Иначе
		
		ТаблицаАдресатов = Новый ТаблицаЗначений;
		ТаблицаАдресатов.Колонки.Добавить("Адресат");
		ТаблицаАдресатов.Колонки.Добавить("Тема");
		ТаблицаАдресатов.Колонки.Добавить("Текст");
		
		ПоляВыбораАдресатов = Новый Массив;
		
		Для Каждого Получатель Из ТаблицаПолучателей Цикл
			
			Если Получатель.СпособАдресацииУведомления = Перечисления.ПЛ_СпособыАдресацииУведомлений.Запрос Тогда
				
				СписокАдресатов = ПЛ_УведомленияОСобытиях.ПолучитьСписокАдресатов(ТипОбъекта, ОбъектПроверки,
					Получатель.АдресСхемыВыборкиАдресатов, Получатель.АдресНастроекВыборкиАдресатов, ПоляВыбораАдресатов);
				Для каждого Адресат из СписокАдресатов Цикл
					СтрокаАдресата = ТаблицаАдресатов.Добавить();
					СтрокаАдресата.Адресат = Адресат;
				КонецЦикла;
				
			ИначеЕсли Получатель.СпособАдресацииУведомления = Перечисления.ПЛ_СпособыАдресацииУведомлений.СписокРассылки Тогда
				
				СписокРассылки = Получатель.Адресат.ПолучитьОбъект();
				АдресСхемыВыборкиАдресатов = ПоместитьВоВременноеХранилище(СписокРассылки.СхемаВыборки.Получить(), Новый УникальныйИдентификатор);
				АдресНастроекВыборкиАдресатов = ПоместитьВоВременноеХранилище(СписокРассылки.НастройкиВыборки.Получить(), Новый УникальныйИдентификатор);
				СписокАдресатов = ПЛ_УведомленияОСОбытиях.ПолучитьСписокАдресатов("", "", АдресСхемыВыборкиАдресатов, АдресНастроекВыборкиАдресатов);
				Для каждого Адресат из СписокАдресатов Цикл
					СтрокаАдресата = ТаблицаАдресатов.Добавить();
					СтрокаАдресата.Адресат = Адресат;
				КонецЦикла;
				
			Иначе
				СтрокаАдресата = ТаблицаАдресатов.Добавить();
				СтрокаАдресата.Адресат = Получатель.Адресат;
			КонецЕсли;
		КонецЦикла;
		
		Справочники.ПЛ_УведомленияОСобытиях.УдалитьПовторяющиесяЭлементыТаблицыЗначений(ТаблицаАдресатов, "Адресат");
		
		Попытка
			ПЛ_УведомленияОСобытиях.ДополнитьТаблицуАдресатовТекстамиПоШаблонам(ТипОбъекта, ОбъектПроверки,
				АдресСхемыКомпоновкиШаблонов, АдресНастроек,
				ШаблоныТаблиц, ОбычныйТекст,
				СтрокаТемыСообщения, СтрокаТекстаСообщения,
				ТаблицаАдресатов, ПоляВыбораАдресатов);
		Исключение
		КонецПопытки;
		
		Построитель = Новый ПостроительDOM;
		ЧтениеHTML = Новый ЧтениеHTML;
		
		ДокументHTMLИтог = Новый ДокументHTML("");
		ЭлементТело = ДокументHTMLИтог.СоздатьЭлемент("body");
		ДокументHTMLИтог.Тело = ЭлементТело;
		
		Для Каждого СтрокаАдресата из ТаблицаАдресатов Цикл
			
			ТекстовыйУзел = ДокументHTMLИтог.СоздатьТекстовыйУзел(Строка(СтрокаАдресата.Адресат));
			ДокументHTMLИтог.Тело.ДобавитьДочерний(ТекстовыйУзел);
			
			ЧтениеHTML.УстановитьСтроку(СтрокаАдресата.Тема);
			ДокументHTML = Построитель.Прочитать(ЧтениеHTML);
			
			Если ДокументHTML.Тело <> Неопределено Тогда
				ДочерниеУзлы = ПЛ_УведомленияОСобытияхКлиентСервер.ДочерниеУзлыСодержащиеHTML(ДокументHTML.Тело);
				Для каждого ТекЭлемент Из ДочерниеУзлы Цикл
					НовыйЭлемент = ДокументHTMLИтог.ИмпортироватьУзел(ТекЭлемент, Истина);
					ДокументHTMLИтог.Тело.ДобавитьДочерний(НовыйЭлемент);
				КонецЦикла;
			КонецЕсли;
			
			ЧтениеHTML.УстановитьСтроку(СтрокаАдресата.Текст);
			ДокументHTML = Построитель.Прочитать(ЧтениеHTML);
			
			Если ДокументHTML.Тело <> Неопределено Тогда
				ДочерниеУзлы = ПЛ_УведомленияОСобытияхКлиентСервер.ДочерниеУзлыСодержащиеHTML(ДокументHTML.Тело);
				Для каждого ТекЭлемент Из ДочерниеУзлы Цикл
					НовыйЭлемент = ДокументHTMLИтог.ИмпортироватьУзел(ТекЭлемент, Истина);
					ДокументHTMLИтог.Тело.ДобавитьДочерний(НовыйЭлемент);
				КонецЦикла;
			КонецЕсли;
			
		КонецЦикла;
		
		ПроверкаТекстаСообщения = ПЛ_УведомленияОСобытияхКлиентСервер.ПолучитьТекстHTMLИзДокументаHTML(ДокументHTMLИтог);
	КонецЕсли;
	
КонецПроцедуры

