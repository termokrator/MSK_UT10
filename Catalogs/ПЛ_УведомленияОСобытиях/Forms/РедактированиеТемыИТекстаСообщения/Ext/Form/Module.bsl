&НаСервере
Функция СохранитьФайл(ИндексСтроки)
	
	СтрокаПрисоединенногоФайла = ТаблицаПрисоединенныхФайлов[ИндексСтроки];
	
	ИмяФайла = КаталогВременныхФайлов() + СтрокаПрисоединенногоФайла.Имя;
	
	ДанныеФайла = СтрокаПрисоединенногоФайла.Вложение.Получить();
	Если ДанныеФайла <> Неопределено Тогда
		ДанныеФайла.Записать(ИмяФайла);
	КонецЕсли;
	
	Возврат ИмяФайла;
	
