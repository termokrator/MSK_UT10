&НаКлиенте
Процедура Форматирование(Команда) Экспорт
	
	Если ОбычныйТекст Тогда
		ВыделенныйТекст = Элементы.ТекстСообщения.ВыделенныйТекст;
		ОбычныйТекст(Команда);
		ПодключитьОбработчикОжидания("ФорматированиеОтложенно", 0.1, Истина);
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыделенныйТекст) Тогда
		HTMLДокумент = Элементы.ТекстСообщенияHTML.Документ;
		Область = HTMLДокумент.body.createTextRange();
		Область.findText(ВыделенныйТекст);
		Область.select();
	КонецЕсли;
	
	Если Команда.Имя = "ФорматированиеПолужирный" Тогда
		ВыполнитьHTMLКоманду("bold");
		
	ИначеЕсли Команда.Имя = "ФорматированиеНаклонный" Тогда
		ВыполнитьHTMLКоманду("italic");
		
	ИначеЕсли Команда.Имя = "ФорматированиеПодчеркнутый" Тогда
		ВыполнитьHTMLКоманду("underline");
		
	ИначеЕсли Команда.Имя = "ФорматированиеМаркированныйСписок" Тогда
		ВыполнитьHTMLКоманду("insertUnorderedList");
		
	ИначеЕсли Команда.Имя = "ФорматированиеНумерованныйСписок" Тогда
		ВыполнитьHTMLКоманду("insertOrderedList");
		
	ИначеЕсли Команда.Имя = "ФорматированиеОтступВлево" Тогда
		ВыполнитьHTMLКоманду("outdent");
		
	ИначеЕсли Команда.Имя = "ФорматированиеОтступВправо" Тогда
		ВыполнитьHTMLКоманду("indent");
		
	ИначеЕсли Команда.Имя = "ФорматированиеВыравниваниеВлево" Тогда
		ВыполнитьHTMLКоманду("justifyLeft");
		
	ИначеЕсли Команда.Имя = "ФорматированиеВыравниваниеПоЦентру" Тогда
		ВыполнитьHTMLКоманду("justifyCenter");
		
	ИначеЕсли Команда.Имя = "ФорматированиеВыравниваниеВправо" Тогда
		ВыполнитьHTMLКоманду("justifyRight");
		
	ИначеЕсли Команда.Имя = "ФорматированиеИзменитьШрифт" Тогда
		ДиалогВыбораШрифта = Новый ДиалогВыбораШрифта;
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершениеИзменитьШрифт", ЭтаФорма);
		ДиалогВыбораШрифта.Показать(ОписаниеОповещения);
		
	ИначеЕсли Команда.Имя = "ФорматированиеЦветТекста" Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершениеВыборЦветаТекста", ЭтаФорма);
		ПараметрыФормы = Новый Структура("Заголовок", НСтр("ru = 'Цвет текста'"));
		ОткрытьФорму("Справочник.ПЛ_УведомленияОСобытиях.Форма.ВыборЦвета", ПараметрыФормы, ЭтаФорма,,,, ОписаниеОповещения);
		
	ИначеЕсли Команда.Имя = "ФорматированиеЦветФона" Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершениеВыборЦветаФона", ЭтаФорма);
		ПараметрыФормы = Новый Структура("Заголовок", НСтр("ru = 'Цвет фона'"));
		ОткрытьФорму("Справочник.ПЛ_УведомленияОСобытиях.Форма.ВыборЦвета", ПараметрыФормы, ЭтаФорма,,,, ОписаниеОповещения);
		
	ИначеЕсли Команда.Имя = "ФорматированиеОчиститьФормат" Тогда
		ВыполнитьHTMLКоманду("removeFormat");
	КонецЕсли;
	
	ВыделенныйТекст = "";
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеИзменитьШрифт(Шрифт, Параметры) Экспорт

	Если Шрифт = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПустаяСтрока(Шрифт.Имя) Тогда
		HTMLДокумент = Элементы.ТекстСообщенияHTML.Документ;
		HTMLДокумент.execCommand("fontName", Ложь, Шрифт.Имя);
	КонецЕсли;
	
	РазмерШрифта = 2;
	
	Если Шрифт.Размер <> -1 Тогда
		Если Шрифт.Размер < 8 Тогда
			РазмерШрифта = 1;
		ИначеЕсли Шрифт.Размер <= 10 Тогда
			РазмерШрифта = 2;
		ИначеЕсли Шрифт.Размер <= 12 Тогда
			РазмерШрифта = 3;
		ИначеЕсли Шрифт.Размер <= 14 Тогда
			РазмерШрифта = 4;
		ИначеЕсли Шрифт.Размер <= 16 Тогда
			РазмерШрифта = 5;
		ИначеЕсли Шрифт.Размер <= 18 Тогда
			РазмерШрифта = 6;
		Иначе
			РазмерШрифта = 7;
		КонецЕсли;
	КонецЕсли;
	
	HTMLДокумент = Элементы.ТекстСообщенияHTML.Документ;
	HTMLДокумент.execCommand("fontSize", Ложь, РазмерШрифта);
	
	Если Шрифт.Зачеркивание = Истина Тогда
		HTMLДокумент = Элементы.ТекстПисьмаHTML.Документ;
		ВыполнитьHTMLКоманду("strikeThrough");
	КонецЕсли;
	
	Если Шрифт.Жирный = Истина Тогда
		HTMLДокумент = Элементы.ТекстСообщенияHTML.Документ;
		ВыполнитьHTMLКоманду("Bold");
	КонецЕсли;
	
	Если Шрифт.Наклонный = Истина Тогда
		HTMLДокумент = Элементы.ТекстСообщенияHTML.Документ;
		ВыполнитьHTMLКоманду("italic");
	КонецЕсли;
	
	Если Шрифт.Подчеркивание = Истина Тогда
		HTMLДокумент = Элементы.ТекстСообщенияHTML.Документ;
		ВыполнитьHTMLКоманду("underline");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеВыборЦветаТекста(Цвет, Параметры) Экспорт
	
