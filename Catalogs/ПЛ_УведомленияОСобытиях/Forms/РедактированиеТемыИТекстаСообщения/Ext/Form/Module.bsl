КонецПроцедуры

&НаКлиенте
Процедура ИзменитьРазмерШрифта(Команда)
	
	Если Команда.Имя = "ФорматированиеУвеличитьШрифт" Тогда
		РазмерПоУмолчанию = 2;
		ИзменениеРазмера = 1;
	ИначеЕсли Команда.Имя = "ФорматированиеУменьшитьШрифт" Тогда
		РазмерПоУмолчанию = 3;
		ИзменениеРазмера = -1;
	Иначе
		Возврат;
	КонецЕсли;
	
	HTMLДокумент = Элементы.ТекстСообщенияHTML.Документ;
	Размер = HTMLДокумент.queryCommandValue("fontSize");
	
	Если Не ЗначениеЗаполнено(Размер) Тогда 
		Размер = РазмерПоУмолчанию;
	КонецЕсли;
	HTMLДокумент.execCommand("fontSize", Ложь, Размер + ИзменениеРазмера);
	
	ЭтаФорма.ТекущийЭлемент = Элементы.ТекстСообщенияHTML;
	
КонецПроцедуры

&НаКлиенте
Процедура ФорматированиеВставитьКартинку(Команда)
	
	Фильтр = НСтр("ru = 'Все картинки (*.bmp;*.gif;*.png;*.jpeg;*.dib;*.rle;*.tif;*.jpg;*.ico;*.wmf;*.emf)|*.bmp;*.gif;*.png;*.jpeg;*.dib;*.rle;*.tif;*.jpg;*.ico;*.wmf;*.emf'")
		+ НСтр("ru = '|Все файлы(*.*)|*.*'")
