Функция ПолучитьНастройкиКомпоновщика(КомпоновщикНастроек, УникальныйИдентификатор)
	
	КомпоновщикНастроек.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.Полное);
	
	Возврат ПоместитьВоВременноеХранилище(КомпоновщикНастроек.ПолучитьНастройки(), УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Процедура ЗагрузитьСхемуИзФайлаНаСервере(ТекстXML)
	
	Попытка
		ЧтениеXML = Новый ЧтениеXML();
		ЧтениеXML.УстановитьСтроку(ТекстXML);
		СхемаКомпоновкиДанных = СериализаторXDTO.ПрочитатьXML(ЧтениеXML);
		ИзмененаСхемаКомпоновкиДанных(СхемаКомпоновкиДанных, АдресСхемыКомпоновкиШаблонов, КомпоновщикНастроек);
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ИзмененаСхемаКомпоновкиДанных(СхемаКомпоновкиДанных, АдресСхемыКомпоновкиДанных, КомпоновщикНастроек)
	
	ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, АдресСхемыКомпоновкиДанных);
	
	// Компоновщик настроек инициализируется редактируемой схемой
	ПЛ_УведомленияОСобытиях.ИнициализироватьКомпоновщикНастроек(КомпоновщикНастроек, АдресСхемыКомпоновкиДанных);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьРедактированиеТекстов()
	
	Результат = Новый Структура;
	Результат.Вставить("ТипСообщения", ТипСообщения);
	
	Таблицы.Удалить(Таблицы.Индекс(Таблицы.НайтиПоИдентификатору(ИдентификаторСтрокиТаблицДобавить)));
	ЗаполнитьСтруктуруПараметровРедактированияШаблона(
		Результат,
		КомпоновщикНастроек,
		АдресСхемыКомпоновкиШаблонов,
		ИдентификаторВладельца,
		Таблицы,
		ПечатныеФормы,
		ТаблицаПрисоединенныхФайлов);
		
	Если ТипСообщения = ПредопределенноеЗначение("Перечисление.ПЛ_СпособыДоставкиУведомлений.ЭлектроннаяПочта")
		Или ТипСообщения = ПредопределенноеЗначение("Перечисление.ПЛ_СпособыДоставкиУведомлений.СервисПочтовойРассылки") Тогда
		
		Если Элементы.ГруппаСообщение.ТекущаяСтраница = Элементы.СтраницаТекстШаблона Тогда
			ПолучитьHTMLИзПоляHTMLДокумента();
		Иначе
			ТекстШаблона = КодHTML.ПолучитьТекст();
		КонецЕсли;
		
		Результат.Вставить("ТемаСообщения",     СокрЛП(ТемаСообщения.ПолучитьТекст()));
		Результат.Вставить("ТекстСообщения",    ТекстШаблона);
		Результат.Вставить("ОбычныйТекст",      ОбычныйТекст);
		Результат.Вставить("ФорматВложений",    ФорматВложений);
		
	ИначеЕсли ТипСообщения = ПредопределенноеЗначение("Перечисление.ПЛ_СпособыДоставкиУведомлений.СМС") Тогда
		
		Результат.Вставить("ТекстСообщения",   ТекстШаблона);
		
	ИначеЕсли ТипСообщения = ПредопределенноеЗначение("Перечисление.ПЛ_СпособыДоставкиУведомлений.ВнутреннееСообщение") Тогда
		
		Результат.Вставить("ТемаСообщения",    СокрЛП(ТемаСообщения.ПолучитьТекст()));
		Результат.Вставить("ТекстСообщения",   ТекстШаблона);
		
	КонецЕсли;
	
	Оповестить("Завершено_редактирование_текстов_сообщения", Результат, ЭтаФорма);
	
	Закрыть();

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьСтруктуруПараметровРедактированияШаблона(
		Результат,
		КомпоновщикНастроек,
		АдресСхемыКомпоновкиШаблонов,
		ИдентификаторВладельца,
		Знач Таблицы,
		Знач ПечатныеФормы,
		Знач ТаблицаПрисоединенныхФайлов)
	
	// Настройки компоновщика настроек помещаются в редактируемую схему
	ПоместитьНастройкиВСхемуКомпоновкиДанных(КомпоновщикНастроек, АдресСхемыКомпоновкиШаблонов);
	
	Результат.Вставить("АдресСхемы",        АдресСхемыКомпоновкиШаблонов);
	Результат.Вставить("АдресНастроек",     ПолучитьНастройкиКомпоновщика(КомпоновщикНастроек, ИдентификаторВладельца));
	
	Результат.Вставить("АдресТаблиц",       ПолучитьАдресТаблиц(Таблицы));
	Результат.Вставить("АдресПечатныхФорм", ПолучитьАдресТаблиц(ПечатныеФормы));
	Результат.Вставить("АдресПрисоединенныхФайлов", ПолучитьАдресТаблиц(ТаблицаПрисоединенныхФайлов));
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуРедактированияТаблицы(АдресНастроекКомпоновки = "", ИдентификаторСтроки = -1)
	
	ПараметрыРедактированияТаблицы = Новый Структура;
	
	ПараметрыРедактированияТаблицы.Вставить("АдресСхемыКомпоновки",     АдресСхемыКомпоновкиШаблонов);
	ПараметрыРедактированияТаблицы.Вставить("АдресНастроекКомпоновки",  АдресНастроекКомпоновки);
	ПараметрыРедактированияТаблицы.Вставить("ИдентификаторСтроки",      ИдентификаторСтроки);
	ПараметрыРедактированияТаблицы.Вставить("УникальныйИдентификатор",  ИдентификаторВладельца); // ИД формы уведомлений для размещения возвращаемых значений
	
	ОткрытьФорму("Справочник.ПЛ_УведомленияОСобытиях.Форма.НастройкаСтруктурыТаблицы",
		ПараметрыРедактированияТаблицы,
		ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьДобавлениеИзменениеТаблицы(СтруктураРезультата)
	
	Если СтруктураРезультата.ИдентификаторСтроки = ИдентификаторСтрокиТаблицДобавить Тогда
		СтрокаТаблицы = Таблицы.Вставить(Таблицы.Количество() - 1);
		СтрокаТаблицы.Имя = "Таблица " + Строка(Таблицы.Количество() - 1);
		СтрокаТаблицы.АдресНастроек = СтруктураРезультата.АдресНастроек;
		Элементы.Таблицы.ТекущаяСтрока = Таблицы.Индекс(СтрокаТаблицы);
	Иначе
		СтрокаТаблицы = Таблицы.НайтиПоИдентификатору(СтруктураРезультата.ИдентификаторСтроки);
		Если СтрокаТаблицы <> Неопределено Тогда
			СтрокаТаблицы.АдресНастроек = СтруктураРезультата.АдресНастроек;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьАдресТаблиц(Знач Таблицы)
	
	Возврат ПоместитьВоВременноеХранилище(Таблицы.Выгрузить(), Новый УникальныйИдентификатор());
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСписокПечатныхФормУТ10(ТаблицаПечатныхФорм)
	
	Если Не ЗначениеЗаполнено(Регистратор) Тогда
		Возврат;
	КонецЕсли;
	
	// Встроенные печатные формы
	//СтруктураПечатныхФорм = Неопределено;
	//Попытка
	//	Выполнить("СтруктураПечатныхФорм = Документы[Регистратор].СоздатьДокумент().ПолучитьСтруктуруПечатныхФорм()");
	//Исключение
	//КонецПопытки;
	//
	//Если ТипЗнч(СтруктураПечатныхФорм) = Тип("Структура") Тогда
	//	Для каждого ЭлементСтруктуры Из СтруктураПечатныхФорм Цикл
	//		
	//		НоваяСтрока = ПечатныеФормы.Добавить();
	//		НоваяСтрока.ПечатнаяФорма = ЭлементСтруктуры.Значение;
	//		
	//		Если ТаблицаПечатныхФорм.Найти(ЭлементСтруктуры.Значение) <> Неопределено Тогда
	//			НоваяСтрока.Пометка = Истина;
	//		КонецЕсли;
	//	КонецЦикла;
	//КонецЕсли;
	
	// Внешние печатные формы
	Попытка
		
		Запрос = Новый Запрос;
		Запрос.Текст = "
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеСправочника.Ссылка,
		|	ДанныеСправочника.Ссылка.Наименование       КАК Наименование,
		|	ДанныеСправочника.ЗаменяемаяПечатнаяФорма   КАК ЗаменяемаяПечатнаяФорма
		|ИЗ
		|	Справочник.ВнешниеОбработки.Принадлежность КАК ДанныеСправочника
		|ГДЕ
		|	ДанныеСправочника.СсылкаОбъекта = &ПустаяСсылка
		|	И ДанныеСправочника.Ссылка.ВидОбработки = ЗНАЧЕНИЕ(Перечисление.ВидыДополнительныхВнешнихОбработок.ПечатнаяФорма)
		|	И (НЕ ДанныеСправочника.ЗаменяемаяПечатнаяФорма ССЫЛКА Справочник.ВнешниеОбработки)
		|	И (НЕ ДанныеСправочника.Ссылка.ПометкаУдаления)
		|";
		
		Если ТипОбъекта = Перечисления.ПЛ_ИсточникиСобытий.ИсточникДокумент
			Или ТипОбъекта = Перечисления.ПЛ_ИсточникиСобытий.ИсточникЗаписьДокумента Тогда
			Запрос.УстановитьПараметр("ПустаяСсылка", Документы[Регистратор].ПустаяСсылка());
		ИначеЕсли ТипОбъекта = Перечисления.ПЛ_ИсточникиСобытий.ИсточникСправочникт Тогда
			Запрос.УстановитьПараметр("ПустаяСсылка", Справочники[Регистратор].ПустаяСсылка());
		Иначе
			Возврат;
		КонецЕсли;
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			Если ЗначениеЗаполнено(Выборка.ЗаменяемаяПечатнаяФорма) Тогда
				ИмяПечатнойФормы = Выборка.ЗаменяемаяПечатнаяФорма;
			Иначе
				ИмяПечатнойФормы = Выборка.Наименование;
			КонецЕсли;
			
			НоваяСтрока = ПечатныеФормы.Добавить();
			НоваяСтрока.Внешняя = Истина;
			НоваяСтрока.ПечатнаяФорма = ИмяПечатнойФормы;
			
			Если ТаблицаПечатныхФорм.Найти(ИмяПечатнойФормы) <> Неопределено Тогда
				НоваяСтрока.Пометка = Истина;
			КонецЕсли;
		КонецЦикла;
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокПечатныхФормУТ11(ТаблицаПечатныхФорм)
	
	Если Не ЗначениеЗаполнено(Регистратор) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ПолноеИмяОбъектаМетаданных = "";
		Если ТипОбъекта = Перечисления.ПЛ_ИсточникиСобытий.ИсточникДокумент
			Или ТипОбъекта = Перечисления.ПЛ_ИсточникиСобытий.ИсточникЗаписьДокумента Тогда
			ПолноеИмяОбъектаМетаданных = "Документ." + Регистратор;
		ИначеЕсли ТипОбъекта = Перечисления.ПЛ_ИсточникиСобытий.ИсточникСправочник Тогда
			ПолноеИмяОбъектаМетаданных = "Справочник." + Регистратор;
		Иначе
			Возврат;
		КонецЕсли;
		
		// Встроенные печатные формы
		КоллекцияКомандПечати = "";
		Выполнить("КоллекцияКомандПечати = УправлениеПечатью.СоздатьКоллекциюКомандПечати()");
		Выполнить("ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмяОбъектаМетаданных).ДобавитьКомандыПечати(КоллекцияКомандПечати)");
		
		Для каждого СтрокаКомандыПечати из КоллекцияКомандПечати Цикл
			Если Не СтрокаКомандыПечати.СразуНаПринтер Тогда
				
				НоваяСтрока = ПечатныеФормы.Добавить();
				НоваяСтрока.ПечатнаяФорма = СтрокаКомандыПечати.Представление;
				
				Если ТаблицаПечатныхФорм.Найти(СтрокаКомандыПечати.Представление) <> Неопределено Тогда
					НоваяСтрока.Пометка = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		// Внешние печатные формы
		//ВнешниеПечатныеФормы = УправлениеПечатью.СписокПечатныхФормИзВнешнихИсточников(ПолноеИмяОбъектаМетаданных);
		//Для каждого СтрокаВнешнейПечатнойФормы из ВнешниеПечатныеФормы Цикл
		//	
		//	НоваяСтрока = ПечатныеФормы.Добавить();
		//	НоваяСтрока.ПечатнаяФорма = СтрокаВнешнейПечатнойФормы.Представление;
		//	НоваяСтрока.Внешняя = Истина;
		//	
		//	Если ТаблицаПечатныхФорм.Найти(СтрокаВнешнейПечатнойФормы.Представление) <> Неопределено Тогда
		//		НоваяСтрока.Пометка = Истина;
		//	КонецЕсли;
		//КонецЦикла;
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЗаголовокВложений()
	
	Если Платформа83 Тогда
		
		ЗаголовокВложений = "";
		
		МассивСтрок = Новый Массив;
		
		Для каждого СтрокаПечатныхФорм Из ПечатныеФормы Цикл
			Если СтрокаПечатныхФорм.Пометка Тогда
				ДобавитьСтрокуВложения(МассивСтрок, СтрокаПечатныхФорм.ПечатнаяФорма);
			КонецЕсли;
		КонецЦикла;
		
		Для каждого СтрокаВложений Из ТаблицаПрисоединенныхФайлов Цикл
			ДобавитьСтрокуВложения(МассивСтрок, СтрокаВложений.Имя, Истина);
		КонецЦикла;
		
		ЗаголовокВложений = ПЛ_Функции83.ФорматированнаяСтрокаИзМассиваСтрок(МассивСтрок);
		
	Иначе
		
		ЗаголовокВложений82 = "";
		
		Для каждого СтрокаПечатныхФорм Из ПечатныеФормы Цикл
			Если СтрокаПечатныхФорм.Пометка Тогда
				ЗаголовокВложений82 = ЗаголовокВложений82 + ?(ЗаголовокВложений82 = "", "", "  ") + СтрокаПечатныхФорм.ПечатнаяФорма;
			КонецЕсли;
		КонецЦикла;
		
		Для каждого СтрокаВложений Из ТаблицаПрисоединенныхФайлов Цикл
			ЗаголовокВложений82 = ЗаголовокВложений82 + ?(ЗаголовокВложений82 = "", "", "  ") + СтрокаВложений.Имя;
		КонецЦикла;
	КонецЕсли;
	
	Если Платформа83 Тогда
		Подстроки = РазложитьСтрокуВМассивПодстрок(ЗаголовокВложений, Символы.ПС);
		КоличествоФайлов = Подстроки.Количество();
		Элементы.ЗаголовокВложений.Видимость = КоличествоФайлов;
		Элементы.ЗаголовокВложений.Высота = КоличествоФайлов;
	Иначе
		Подстроки = РазложитьСтрокуВМассивПодстрок(ЗаголовокВложений82, Символы.ПС);
		КоличествоФайлов = Подстроки.Количество();
		Элементы.ЗаголовокВложений82.Видимость = КоличествоФайлов;
		Элементы.ЗаголовокВложений82.Высота = КоличествоФайлов;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьСтрокуВложения(МассивСтрок, ИмяВложения, Гиперссылка = Ложь)
	
	СтрокаГиперссылки = ПЛ_Функции83.ФорматированнаяСтрокаПоОписанию(ИмяВложения,,,,
		?(Гиперссылка, ИмяВложения + "_ОткрытьФайл_d8d4e005-6748-46a3-b48f-7216f988a286", ""));
	СтрокаУдаления = ПЛ_Функции83.ФорматированнаяСтрокаПоОписанию(БиблиотекаКартинок.Очистить,,,,
		ИмяВложения + "_УдалитьФайл_f11fba53-abab-4616-a7e2-2faec7bba8e1");
	
	МассивСтрок.Добавить(СтрокаГиперссылки);
	МассивСтрок.Добавить(" ");
	МассивСтрок.Добавить(СтрокаУдаления);
	МассивСтрок.Добавить("  ");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораФорматаВложений()
	
	ДоступныеФорматы = Новый ТаблицаЗначений;
	ДоступныеФорматы.Колонки.Добавить("Порядок");
	ДоступныеФорматы.Колонки.Добавить("Значение");
	ДоступныеФорматы.Колонки.Добавить("Представление");
	
	Для каждого ТипФайла Из ТипФайлаТабличногоДокумента Цикл
		
		Если Строка(ТипФайла) = "PDF" Тогда
			НоваяСтрока = ДоступныеФорматы.Добавить();
			НоваяСтрока.Порядок = 1;
			НоваяСтрока.Значение = "PDF";
			НоваяСтрока.Представление = "Документ Adobe PDF (.pdf)";
			
		ИначеЕсли Строка(ТипФайла) = "DOCX" Тогда
			НоваяСтрока = ДоступныеФорматы.Добавить();
			НоваяСтрока.Порядок = 2;
			НоваяСтрока.Значение = "DOCX";
			НоваяСтрока.Представление = "Документ Word 2007 (.docx)";
			
		ИначеЕсли Строка(ТипФайла) = "XLS97" Тогда
			НоваяСтрока = ДоступныеФорматы.Добавить();
			НоваяСтрока.Порядок = 3;
			НоваяСтрока.Значение = "XLS97";
			НоваяСтрока.Представление = "Лист Microsoft Excel 97-2003 (.xls)";
			
		ИначеЕсли Строка(ТипФайла) = "XLSX" Тогда
			НоваяСтрока = ДоступныеФорматы.Добавить();
			НоваяСтрока.Порядок = 4;
			НоваяСтрока.Значение = "XLSX";
			НоваяСтрока.Представление = "Лист Microsoft Excel 2007 (.xlsx)";
			
		ИначеЕсли Строка(ТипФайла) = "ODS" Тогда
			НоваяСтрока = ДоступныеФорматы.Добавить();
			НоваяСтрока.Порядок = 5;
			НоваяСтрока.Значение = "ODS";
			НоваяСтрока.Представление = "Электронная таблица Open Document (.ods)";
			
		ИначеЕсли Строка(ТипФайла) = "HTML5" Тогда
			НоваяСтрока = ДоступныеФорматы.Добавить();
			НоваяСтрока.Порядок = 6;
			НоваяСтрока.Значение = "HTML5";
			НоваяСтрока.Представление = "Веб-страница (.html)";
			
		ИначеЕсли Строка(ТипФайла) = "HTML4" Тогда
			НоваяСтрока = ДоступныеФорматы.Добавить();
			НоваяСтрока.Порядок = 7;
			НоваяСтрока.Значение = "HTML4";
			НоваяСтрока.Представление = "Веб-страница (.html)";
			
		ИначеЕсли Строка(ТипФайла) = "TXT" Тогда
			НоваяСтрока = ДоступныеФорматы.Добавить();
			НоваяСтрока.Порядок = 8;
			НоваяСтрока.Значение = "TXT";
			НоваяСтрока.Представление = "Текстовый документ UTF-8 (.txt)";
			
		КонецЕсли;
	КонецЦикла;
	
	Если ДоступныеФорматы.Найти("HTML5", "Значение") <> Неопределено Тогда
		СтрокаКУдалению = ДоступныеФорматы.Найти("HTML4", "Значение");
		Если СтрокаКУдалению <> Неопределено Тогда
			ДоступныеФорматы.Удалить(СтрокаКУдалению);
		КонецЕсли;
	КонецЕсли;
	
	ДоступныеФорматы.Сортировать("Порядок");
	
	Для каждого ДоступныйФормат Из ДоступныеФорматы Цикл
		Элементы.ФорматВложений.СписокВыбора.Добавить(ДоступныйФормат.Значение, ДоступныйФормат.Представление);
	КонецЦикла;
	
	Если Элементы.ФорматВложений.СписокВыбора.Количество() И Не ЗначениеЗаполнено(ФорматВложений)  Тогда
		ФорматВложений = Элементы.ФорматВложений.СписокВыбора[0].Значение;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция РазложитьСтрокуВМассивПодстрок(Знач Строка, Знач Разделитель = ".")
	
	Результат = Новый Массив;
	
	Позиция = Найти(Строка, Разделитель);
	Пока Позиция > 0 Цикл
		Подстрока = Лев(Строка, Позиция - 1);
		Если НЕ ПустаяСтрока(Подстрока) Тогда
			Результат.Добавить(Подстрока);
		КонецЕсли;
		Строка = Сред(Строка, Позиция + СтрДлина(Разделитель));
		Позиция = Найти(Строка, Разделитель);
	КонецЦикла;
	
	Если НЕ ПустаяСтрока(Строка) Тогда
		Результат.Добавить(Строка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

