				<QueryText>ВЫБРАТЬ
	ДанныеСправочника.Ссылка,
	ДанныеСправочника.ПометкаУдаления,
	ДанныеСправочника.Код,
	ДанныеСправочника.Наименование,
	ДанныеСправочника.Событие,
	ДанныеСправочника.СписокПолучателей,
	ДанныеСправочника.ТекстСообщения,
	ДанныеСправочника.ОбычныйТекст,
	ДанныеСправочника.ДелениеПоАдресатам,
	ДанныеСправочника.ФильтрПоАдресатам,
	ДанныеСправочника.КонтрольПовторнойОтправки,
	ДанныеСправочника.СпособДоставки,
	ДанныеСправочника.ЭлПочта,
	ДанныеСправочника.СервисПочтовойРассылки,
	ДанныеСправочника.СМС,
	ДанныеСправочника.Напоминание,
	ДанныеСправочника.ОбратныйАдрес,
	ДанныеСправочника.ИмяОтправителя,
	ДанныеСправочника.ЕстьВложения,
	ДанныеСправочника.ФорматВложений,
	ДанныеСправочника.Статус,
	ВЫБОР
		КОГДА ДанныеСправочника.Событие.ИсточникСобытия = ЗНАЧЕНИЕ(Перечисление.ПЛ_ИсточникиСобытий.Рассылка) ТОГДА
			ДанныеСправочника.ДатаОтправки
		ИНАЧЕ
			ПротоколУведомлений.ДатаОтправки
	КОНЕЦ КАК ДатаОтправки,
	ДанныеСправочника.Комментарий
ИЗ
	Справочник.ПЛ_УведомленияОСобытиях КАК ДанныеСправочника
	
	ЛЕВОЕ СОЕДИНЕНИЕ
		(ВЫБРАТЬ
			Уведомления.Уведомление КАК Уведомление,
			МАКСИМУМ(Уведомления.Период) КАК ДатаОтправки
		ИЗ
			РегистрСведений.ПЛ_Уведомления КАК Уведомления
		ГДЕ
			Уведомления.Отправлено
		СГРУППИРОВАТЬ ПО
			Уведомления.Уведомление
		) КАК ПротоколУведомлений
	ПО
		ПротоколУведомлений.Уведомление = ДанныеСправочника.Ссылка
</QueryText>
				<MainTable>Catalog.ПЛ_УведомленияОСобытиях</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:item xsi:type="dcsset:FilterItemComparison">
							<dcsset:use>false</dcsset:use>
							<dcsset:left xsi:type="dcscor:Field">Событие.ИсточникСобытия</dcsset:left>
							<dcsset:comparisonType>Equal</dcsset:comparisonType>
							<dcsset:userSettingID>64e05d26-ae2a-47a2-94ca-9df9491f2e7e</dcsset:userSettingID>
						</dcsset:item>
						<dcsset:item xsi:type="dcsset:FilterItemComparison">
							<dcsset:use>false</dcsset:use>
							<dcsset:left xsi:type="dcscor:Field">СпособДоставки</dcsset:left>
							<dcsset:comparisonType>Equal</dcsset:comparisonType>
							<dcsset:userSettingID>5f525c4a-f034-4a72-b382-ce6fe7dcadd0</dcsset:userSettingID>
