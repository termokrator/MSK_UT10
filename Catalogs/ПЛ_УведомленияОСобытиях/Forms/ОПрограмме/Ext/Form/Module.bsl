///////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаСервере
Функция ПроверитьДоступноеОбновление()
	
	ДоступноОбновление = Ложь;
	
	
	Если 1 = 2 Тогда
		ДоступноОбновление = Истина;
	КонецЕсли;
	
	Возврат ДоступноОбновление;
	
КонецФункции
