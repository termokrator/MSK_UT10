// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СтруктураВерсии = Константы.ПЛ_НастройкиУведомлений.СоздатьМенеджерЗначения().ПолучитьНастройку("Версия");
	Версия = СтруктураВерсии.НомерВерсии;
	
	Если ПроверитьДоступноеОбновление() Тогда
		Элементы.СкачатьОбновление.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры

