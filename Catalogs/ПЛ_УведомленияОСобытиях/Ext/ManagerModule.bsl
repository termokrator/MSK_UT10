				Возврат ПечатныеФормы;
				
			КонецПопытки;
			
			Для Каждого ПечатнаяФорма Из КоллекцияПечатныхФорм.КоллекцияПечатныхФорм Цикл
				
				Если ПечатнаяФорма = Неопределено Или ПечатнаяФорма.ТабличныйДокумент.ВысотаТаблицы = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				ТабДокумент = ПечатнаяФорма.ТабличныйДокумент;
				
				ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
				
				ТабДокумент.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.TXT);
				ВремДокумент = Новый ТекстовыйДокумент;
				ВремДокумент.Прочитать(ИмяВременногоФайла);
				ТекстФайла = ВремДокумент.ПолучитьТекст();
				
				ПЛ_Функции83.ДобавитьДанныеВХеш(ХешКонтрольнойСуммы, ТекстФайла);
				
