				СтруктураВложения.Вставить("ДвоичныеДанные",    ПолучитьДвоичныеДанные(ИмяВременногоФайла));
				СтруктураВложения.Вставить("ИмяФайла",          СтрокаПечатныхФорм.ПечатнаяФорма + " " + ИмяИсточника + "." + ?(Найти(Строка(ФорматФайла), "HTML"), "HTML", Строка(ФорматФайла)));
				СтруктураВложения.Вставить("Наименование",      СтрокаПечатныхФорм.ПечатнаяФорма + "_" + ИмяИсточника);
				
				ПечатныеФормы.Добавить(СтруктураВложения);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ПечатныеФормы;
	
КонецФункции

