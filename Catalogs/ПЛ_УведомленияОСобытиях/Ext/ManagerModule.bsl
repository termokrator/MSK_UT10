	Возврат "";
	
КонецФункции

Процедура ДобавитьТаблицуШаблонаВМассивПечатныхФорм(ПечатныеФормы, ТаблицаШаблона, АдресСхемы, ФорматФайла, ХешКонтрольнойСуммы)
	
	СхемаКомпоновкиДанных = ПолучитьИзВременногоХранилища(АдресСхемы);
	АдресНастроек = ТаблицаШаблона.АдресНастроек;
	
	Если СхемаКомпоновкиДанных = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемы));
	
	НастройкиКомпоновкиДанных = ПолучитьИзВременногоХранилища(АдресНастроек);
	КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиКомпоновкиДанных);
	
	КомпоновщикНастроек.Восстановить();
	
	КомпоновщикМакетаКомпоновкиДанных = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновкиДанных = КомпоновщикМакетаКомпоновкиДанных.Выполнить(СхемаКомпоновкиДанных, КомпоновщикНастроек.ПолучитьНастройки(),,,);
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновкиДанных,,, Истина);
	
	ТабДокумент = Новый ТабличныйДокумент;
	
	ЗаписьЖурналаРегистрации("ПЛ_УведомленияПоРегламентнымПроверкам",,,, "Загружает СКД в таб документ: начало");	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ТабДокумент);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	ЗаписьЖурналаРегистрации("ПЛ_УведомленияПоРегламентнымПроверкам",,,, "Загружает СКД в таб документ: окончание");	

	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	
	ТабДокумент.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.TXT);
	ВремДокумент = Новый ТекстовыйДокумент;
	ВремДокумент.Прочитать(ИмяВременногоФайла);
	ТекстФайла = ВремДокумент.ПолучитьТекст();
	
	ПЛ_Функции83.ДобавитьДанныеВХеш(ХешКонтрольнойСуммы, ТекстФайла);
	
	ЗаписьЖурналаРегистрации("ПЛ_УведомленияПоРегламентнымПроверкам",,,, "Сохраняем таб документ в файл: начало");	
	ТабДокумент.Записать(ИмяВременногоФайла, ФорматФайла);
	ЗаписьЖурналаРегистрации("ПЛ_УведомленияПоРегламентнымПроверкам",,,, "Сохраняем таб документ в файл: окончание");	
	
	СтруктураВложения = Новый Структура;
	СтруктураВложения.Вставить("ДвоичныеДанные",    ПолучитьДвоичныеДанные(ИмяВременногоФайла));
	СтруктураВложения.Вставить("ИмяФайла",          ТаблицаШаблона.Имя + "." + ?(Найти(Строка(ФорматФайла), "HTML"), "HTML", Строка(ФорматФайла)));
	СтруктураВложения.Вставить("Наименование",      ТаблицаШаблона.Имя);
	
	ПечатныеФормы.Добавить(СтруктураВложения);
	
КонецПроцедуры

#КонецЕсли



