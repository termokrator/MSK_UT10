		Выполнить("ВидРодителя.Добавить(Перечисления.ВидыОбъектовКонтактнойИнформации.Пользователи)");
		Выполнить("ВидРодителя.Добавить(Перечисления.ВидыОбъектовКонтактнойИнформации.КонтактныеЛица)");
		Выполнить("ВидРодителя.Добавить(Перечисления.ВидыОбъектовКонтактнойИнформации.КонтактныеЛицаКонтрагентов)");
		//UT10-2429 Кривова
		Выполнить("ВидРодителя.Добавить(Перечисления.ВидыОбъектовКонтактнойИнформации.ФизическиеЛица)");
		///
		
		ДоступныеЗначенияКонтактнойИнформации.Загрузить(ВидыКонтактнойИнформацииУТ10(ВидРодителя));
		
	ИначеЕсли ВерсияУТ = "ЗУП" Тогда
		
		Массив = Новый Массив;
		Массив.Добавить(Тип("СправочникСсылка.ВидыКонтактнойИнформации"));
		ТипВидовКИ = Новый ОписаниеТипов(Массив, , );
		
		ВидыКонтактнойИнформацииДополнительно.ТипЗначения = ТипВидовКИ;
		
		ВидРодителя = Новый Массив;
		Выполнить("ВидРодителя.Добавить(Справочники.ВидыКонтактнойИнформации.СправочникПользователи)");
		Выполнить("ВидРодителя.Добавить(Справочники.ВидыКонтактнойИнформации.СправочникФизическиеЛица)");
		
		ДоступныеЗначенияКонтактнойИнформации.Загрузить(ВидыКонтактнойИнформацииУТ11(ВидРодителя));
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеОтборВидовКонтактнойИнформации(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		Модифицированность = Истина;
		Если ДополнительныеПараметры = "ВидыКИ" Тогда
			ВидыКонтактнойИнформации.ЗагрузитьЗначения(Результат.ВыгрузитьЗначения());
			ИнициализироватьСтрокиОтборовКИ(ВидыКонтактнойИнформации, СтрокаВидыКонтактнойИнформации);
		Иначе
			ВидыКонтактнойИнформацииДополнительно.ЗагрузитьЗначения(Результат.ВыгрузитьЗначения());
			ИнициализироватьСтрокиОтборовКИ(ВидыКонтактнойИнформацииДополнительно, СтрокаВидыКонтактнойИнформацииДополнительно);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ИнициализироватьСтрокиОтборовКИ(ВидыКонтактнойИнформации, СтрокаВидыКонтактнойИнформации)
	
	Если ВидыКонтактнойИнформации.Количество() Тогда
		СтрокаВидыКИ = "";
		Для каждого СтрокаСписка Из ВидыКонтактнойИнформации Цикл
			СтрокаВидыКИ = СтрокаВидыКИ + " " + Строка(СтрокаСписка.Значение) + ";";
		КонецЦикла;
		СтрокаВидыКонтактнойИнформации = СтрокаВидыКИ;
	Иначе
		СтрокаВидыКонтактнойИнформации = НСтр("ru='<Все адреса электронной почты и номера телефонов>'")
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ВидыКонтактнойИнформацииУТ11(Родители)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ВидыКонтактнойИнформации.Ссылка КАК ВидКИ,
	|	ВидыКонтактнойИнформации.Родитель КАК Родитель
	|ИЗ
	|	Справочник.ВидыКонтактнойИнформации КАК ВидыКонтактнойИнформации
	|ГДЕ
	|	ВидыКонтактнойИнформации.Родитель В (&Родители)
	|	И ВидыКонтактнойИнформации.Тип В (
	|		ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон),
	|		ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
	|	)
	|";
	
	Запрос.УстановитьПараметр("Родители", Родители);
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

