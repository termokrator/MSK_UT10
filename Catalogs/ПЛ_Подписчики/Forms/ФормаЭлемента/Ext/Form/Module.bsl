
////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	СхемаВыборки = ТекущийОбъект.СхемаВыборки.Получить();
	НастройкиВыборки = ТекущийОбъект.НастройкиВыборки.Получить();
	
	Если СхемаВыборки <> Неопределено Тогда
		АдресСхемыВыборки = ПоместитьВоВременноеХранилище(СхемаВыборки, Новый УникальныйИдентификатор());
	Иначе
		АдресСхемыВыборки = "";
	КонецЕсли;
	Если НастройкиВыборки <> Неопределено Тогда
		АдресНастроекВыборки = ПоместитьВоВременноеХранилище(НастройкиВыборки, Новый УникальныйИдентификатор());
	Иначе
		АдресНастроекВыборки = "";
	КонецЕсли;
	
	ИнициализироватьКомпоновщикНастроекВыборки();
	
	ВидыКИ = ТекущийОбъект.ВидыКонтактнойИнформации.Получить();
	Если ВидыКИ <> Неопределено Тогда
		ВидыКонтактнойИнформации.ЗагрузитьЗначения(ВидыКИ);
	Иначе
		ВидыКонтактнойИнформации.Очистить();
	КонецЕсли;
	
	ВидыКИ = ТекущийОбъект.ВидыКонтактнойИнформацииДополнительно.Получить();
	Если ВидыКИ <> Неопределено Тогда
		ВидыКонтактнойИнформацииДополнительно.ЗагрузитьЗначения(ВидыКИ);
	Иначе
		ВидыКонтактнойИнформацииДополнительно.Очистить();
	КонецЕсли;
	
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ЭтоАдресВременногоХранилища(АдресСхемыВыборки) Тогда
		КомпоновщикНастроекВыборки.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.Полное);
		НастройкиВыборки = ПолучитьИзВременногоХранилища(АдресНастроекВыборки);
		НастройкиВыборки.Отбор.Элементы.Очистить();
		ПЛ_УведомленияОСобытиях.СкопироватьНастройкиКомпоновкиДанных(НастройкиВыборки, КомпоновщикНастроекВыборки.ПолучитьНастройки());
		
		ТекущийОбъект.СхемаВыборки = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(АдресСхемыВыборки));
		ТекущийОбъект.НастройкиВыборки = Новый ХранилищеЗначения(НастройкиВыборки);
	Иначе
		ТекущийОбъект.СхемаВыборки = Новый ХранилищеЗначения(Неопределено);
		ТекущийОбъект.НастройкиВыборки = Новый ХранилищеЗначения(Неопределено);
	КонецЕсли;
	
	Если ВидыКонтактнойИнформации.Количество() Тогда
		ТекущийОбъект.ВидыКонтактнойИнформации = Новый ХранилищеЗначения(ВидыКонтактнойИнформации.ВыгрузитьЗначения());
	Иначе
		ТекущийОбъект.ВидыКонтактнойИнформации = Новый ХранилищеЗначения(Неопределено);
	КонецЕсли;
	
	Если ВидыКонтактнойИнформацииДополнительно.Количество() Тогда
		ТекущийОбъект.ВидыКонтактнойИнформацииДополнительно = Новый ХранилищеЗначения(ВидыКонтактнойИнформацииДополнительно.ВыгрузитьЗначения());
	Иначе
		ТекущийОбъект.ВидыКонтактнойИнформацииДополнительно = Новый ХранилищеЗначения(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	Элементы.СтраницаКомментарий.Картинка = ?(ЗначениеЗаполнено(Объект.Комментарий), БиблиотекаКартинок.ПЛ_Комментарий, Новый Картинка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	#Если ТолстыйКлиентОбычноеПриложение ИЛИ ТолстыйКлиентУправляемоеПриложение Тогда
		
		ИзменениеСхемыКомпоновкиДанных(ВыбранноеЗначение);
		
	#КонецЕсли
	
КонецПроцедуры

&НаСервере
Процедура ИзменениеСхемыКомпоновкиДанных(СхемаКомпоновкиДанных)
	
	Модифицированность = Истина;
	
	БылиИзменения = Ложь;
	УстановитьСхемуКомпоновкиДанных(АдресСхемыВыборки, СхемаКомпоновкиДанных, Истина, БылиИзменения);
	
	Если БылиИзменения Тогда
		Объект.Выборка = "Произвольная";
		ТекущаяВыборка = "Произвольная";
	КонецЕсли;
	
	ПЛ_УведомленияОСобытиях.ИнициализироватьКомпоновщикНастроек(КомпоновщикНастроекВыборки, АдресСхемыВыборки);
	
КонецПроцедуры

///////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура ВыборкаПриИзменении(Элемент)
	
	ЭлементСписка = Элемент.СписокВыбора.НайтиПоЗначению(Объект.Выборка);
	Если ЭлементСписка <> Неопределено Тогда
		Объект.ВыборкаПредставление = ЭлементСписка.Представление;
	Иначе
		Объект.ВыборкаПредставление = "";
	КонецЕсли;
	
	Если Объект.Выборка <> ТекущаяВыборка Тогда
		Если ТекущаяВыборка = "Произвольная" Тогда
			
			ПоказатьВопрос(
				Новый ОписаниеОповещения("ИзменениеПроизвольнойВыборкиЗавершение", ЭтаФорма),
				НСтр("ru='Настройки произвольной выборки будут потеряны. Продолжить?'"),
				РежимДиалогаВопрос.ДаНет);
		Иначе
			ТекущаяВыборка = Объект.Выборка;
			ВыборкаПриИзмененииНаСервере();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменениеПроизвольнойВыборкиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ТекущаяВыборка = Объект.Выборка;
		ВыборкаПриИзмененииНаСервере();
	Иначе
		Объект.Выборка = ТекущаяВыборка;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВыборкаПриИзмененииНаСервере()
	
	Если ЗначениеЗаполнено(Объект.Выборка)
		И Объект.Выборка <> "Произвольная" Тогда
		
		СКД = Справочники.ПЛ_Подписчики.ПолучитьМакет(Объект.Выборка);
		АдресСхемыВыборки = ПоместитьВоВременноеХранилище(СКД, УникальныйИдентификатор);
		АдресНастроекВыборки = ПоместитьВоВременноеХранилище(СКД.НастройкиПоУмолчанию, УникальныйИдентификатор);
		
		ПЛ_УведомленияОСобытиях.ИнициализироватьКомпоновщикНастроек(КомпоновщикНастроекВыборки, АдресСхемыВыборки, АдресНастроекВыборки);
		
	Иначе
		АдресСхемыВыборки = "";
		АдресНастроекВыборки = "";
		
		КомпоновщикНастроекВыборки.Настройки.Отбор.Элементы.Очистить();
	КонецЕсли;
	
	ВидыКонтактнойИнформации.Очистить();
	
	ИнициализироватьОтборВидовКИ();
	УстановитьПодсказкуВыборки();
	УправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура СтрокаВидыКонтактнойИнформацииНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВидыКонтактнойИнформации", ВидыКонтактнойИнформации);
	
	Если Объект.Выборка = "Произвольная" Тогда
		ПараметрыФормы.Вставить("ДоступныеЗначенияКонтактнойИнформации", ДоступныеЗначенияКонтактнойИнформации);
	КонецЕсли;
	
	ОткрытьФорму("Справочник.ПЛ_Подписчики.Форма.ОтборВидовКонтактнойИнформации",
		ПараметрыФормы,
		ЭтаФорма,,,,
		Новый ОписаниеОповещения("ЗавершениеОтборВидовКонтактнойИнформации", ЭтаФорма, "ВидыКИ"),
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура СтрокаВидыКонтактнойИнформацииДополнительноНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВидыКонтактнойИнформации", ВидыКонтактнойИнформацииДополнительно);
	ПараметрыФормы.Вставить("ДоступныеЗначенияКонтактнойИнформации", ДоступныеЗначенияКонтактнойИнформации);
	
	ОткрытьФорму("Справочник.ПЛ_Подписчики.Форма.ОтборВидовКонтактнойИнформации",
		ПараметрыФормы,
		ЭтаФорма,,,,
		Новый ОписаниеОповещения("ЗавершениеОтборВидовКонтактнойИнформации", ЭтаФорма, "ВидыКИДополнительно"),
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппаСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если ТекущаяСтраница = Элементы.СтраницаПроверка Тогда
		ЗаполнитьПолеПроверки();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатПроверкиОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ЗначениеРасшифровки = ПолучитьДанныеРасшифровки(Расшифровка);
	
	Если ЗначениеРасшифровки <> Неопределено
		И ТипЗнч(ЗначениеРасшифровки) <> Тип("Число")
		И ТипЗнч(ЗначениеРасшифровки) <> Тип("Строка") Тогда
		ПоказатьЗначение(, ЗначениеРасшифровки);
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура РедактироватьСКД(Команда)
	
	#Если ТолстыйКлиентОбычноеПриложение ИЛИ ТолстыйКлиентУправляемоеПриложение Тогда
		
		Если ЭтоАдресВременногоХранилища(АдресСхемыВыборки) Тогда
			ПоместитьНастройкиВСхемуКомпоновкиДанных(КомпоновщикНастроекВыборки, АдресСхемыВыборки);
			СхемаКомпоновкиДанных = СериализаторXDTO.ПрочитатьXDTO(СериализаторXDTO.ЗаписатьXDTO(ПолучитьИзВременногоХранилища(АдресСхемыВыборки)));
			Конструктор = Новый КонструкторСхемыКомпоновкиДанных(СхемаКомпоновкиДанных);
		Иначе
			Конструктор = Новый КонструкторСхемыКомпоновкиДанных;
		КонецЕСли;
		
		Конструктор.Редактировать(ЭтаФорма);
		
	#Иначе
		
		ПоказатьПредупреждение(,НСтр("ru='Для редактирования схемы компоновки необходимо запустить конфигурацию в режиме толстого клиента.'"));
		
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписок(Команда)
	
	ЗаполнитьПолеПроверки();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВСервисРассылок(Команда)
	
	Если ВыгрузитьВСервисРассылокНаСервере() Тогда
		ПоказатьОповещениеПользователя(НСтр("ru='Данные адресатов выгружены.'"));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ВыгрузитьВСервисРассылокНаСервере()
	
	Если Модифицированность Тогда
		Записать();
	КонецЕсли;
	
	АдресатыРасширенно = Новый ТаблицаЗначений;
	АдресатыРасширенно.Колонки.Добавить("Адресат");
	АдресатыРасширенно.Колонки.Добавить("Адрес");
	АдресатыРасширенно.Колонки.Добавить("Идентификатор");
	
	Справочники.ПЛ_Подписчики.ЗаполнитьАдресатовПоСпискуРассылки(
		Объект.Ссылка,
		АдресатыРасширенно,
		Перечисления.ПЛ_СпособыДоставкиУведомлений.СервисПочтовойРассылки);
		
	Результат = ПЛ_Рассылки.ЭкспортироватьПодписчиков(Объект, АдресатыРасширенно);
	
	Если Результат <> Неопределено Тогда
		Записать();
	КонецЕсли;
	
	Если Результат = Неопределено Тогда
		Сообщить(НСтр("ru='Не удалось выгрузить данные. Подробности ошибки см. в журнале регистрации.'"));
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

///////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	ВерсияУТ = ПЛ_УведомленияОСобытиях.ВерсияУТ();
	
	СписокШаблоновВыборки.Загрузить(Справочники.ПЛ_Подписчики.СписокШаблоновВыборки());
	Для каждого Шаблон Из СписокШаблоновВыборки Цикл
		Элементы.Выборка.СписокВыбора.Добавить(Шаблон.Имя, Шаблон.Синоним);
	КонецЦикла;
	Элементы.Выборка.СписокВыбора.Добавить("Произвольная", НСтр("ru='<Произвольная>'"));
	
	ТекущаяВыборка = Объект.Выборка;
	
	ИнициализироватьОтборВидовКИ();
	ИнициализироватьОтборВидовКИДополнительно();
	ИнициализироватьДополнительныеАдресаты();
	ИнициализироватьСтрокиОтборовКИ(ВидыКонтактнойИнформации, СтрокаВидыКонтактнойИнформации);
	ИнициализироватьСтрокиОтборовКИ(ВидыКонтактнойИнформацииДополнительно, СтрокаВидыКонтактнойИнформацииДополнительно);
	
	УстановитьПодсказкуВыборки();
	УправлениеЭлементамиФормы();
	
	Элементы.СтраницаКомментарий.Картинка = ?(ЗначениеЗаполнено(Объект.Комментарий), БиблиотекаКартинок.ПЛ_Комментарий, Новый Картинка);
	
КонецПроцедуры

&НаСервере
Процедура УправлениеЭлементамиФормы()
	
	ВыборкаЗаполнена = ЗначениеЗаполнено(Объект.Выборка);
	
	Элементы.КомпоновщикНастроекНастройкиОтбор.Доступность = ВыборкаЗаполнена;
	Элементы.СтрокаВидыКонтактнойИнформации.Доступность = ВыборкаЗаполнена;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПодсказкуВыборки()
	
	СтрокаШаблона = СписокШаблоновВыборки.НайтиСтроки(Новый Структура("Имя", Объект.Выборка));
	Если СтрокаШаблона.Количество() Тогда
		Элементы.Выборка.Подсказка = СтрокаШаблона[0].Комментарий;
	Иначе
		Элементы.Выборка.Подсказка = "";
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПоместитьНастройкиВСхемуКомпоновкиДанных(КомпоновщикНастроек, АдресСхемыКомпоновкиДанных)
	
	ПЛ_УведомленияОСобытиях.ПоместитьНастройкиВСхемуКомпоновкиДанных(КомпоновщикНастроек, АдресСхемыКомпоновкиДанных);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПолеПроверки()
	
	РезультатПроверки.Очистить();
	
	//Попытка
		
		// Выборка адресатов
		
		КомпоновщикНастроекВыборки.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.Полное);
		АдресНастроекВыборки = ПоместитьВоВременноеХранилище(КомпоновщикНастроекВыборки.ПолучитьНастройки(), УникальныйИдентификатор);
		
		Если ЭтоАдресВременногоХранилища(АдресСхемыВыборки)
			И ЭтоАдресВременногоХранилища(АдресНастроекВыборки) Тогда
			
			СписокАдресатов = ПЛ_УведомленияОСОбытиях.ПолучитьСписокАдресатов("", "", АдресСхемыВыборки, АдресНастроекВыборки);
			КонтактнаяИнформация = ПЛ_УведомленияОСОбытиях.КонтактнаяИнформация(СписокАдресатов);
		Иначе
			СписокАдресатов = Новый Массив;
			КонтактнаяИнформация = Неопределено;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(КонтактнаяИнформация) Тогда
			КонтактнаяИнформация = Новый ТаблицаЗначений;
			КонтактнаяИнформация.Колонки.Добавить("Объект");
			КонтактнаяИнформация.Колонки.Добавить("Тип");
			КонтактнаяИнформация.Колонки.Добавить("Вид");
			КонтактнаяИнформация.Колонки.Добавить("Представление");
		КонецЕсли;
		
		Адресаты = Новый ТаблицаЗначений;
		Адресаты.Колонки.Добавить("Ссылка");
		
		Для Инд = 1 По СписокАдресатов.Количество() Цикл
			Адресаты.Добавить();
		КонецЦикла;
		Адресаты.ЗагрузитьКолонку(СписокАдресатов, "Ссылка");
		
		// Дополнительные адресаты
		
		СписокАдресатовДополнительно = Новый Массив;
		СписокАдресатовДополнительноСтрокой = Новый Массив;
		
		Для каждого СтрокаДополнительныеАдресаты Из Объект.ДополнительныеАдресаты Цикл
			Если ТипЗнч(СтрокаДополнительныеАдресаты.Адресат) = Тип("Строка") Тогда
				СписокАдресатовДополнительноСтрокой.Добавить(СтрокаДополнительныеАдресаты.Адресат);
			Иначе
				СписокАдресатовДополнительно.Добавить(СтрокаДополнительныеАдресаты.Адресат);
			КонецЕсли;
		КонецЦикла;
		
		КонтактнаяИнформацияДополнительно = ПЛ_УведомленияОСОбытиях.КонтактнаяИнформация(СписокАдресатовДополнительно);
		
		Если Не ЗначениеЗаполнено(КонтактнаяИнформацияДополнительно) Тогда
			КонтактнаяИнформацияДополнительно = Новый ТаблицаЗначений;
			КонтактнаяИнформацияДополнительно.Колонки.Добавить("ОбъектДополнительно");
			КонтактнаяИнформацияДополнительно.Колонки.Добавить("ТипДополнительно");
			КонтактнаяИнформацияДополнительно.Колонки.Добавить("ВидДополнительно");
			КонтактнаяИнформацияДополнительно.Колонки.Добавить("ПредставлениеДополнительно");
		Иначе
			КонтактнаяИнформацияДополнительно.Колонки.Объект.Имя = "ОбъектДополнительно";
			КонтактнаяИнформацияДополнительно.Колонки.Вид.Имя = "ВидДополнительно";
			КонтактнаяИнформацияДополнительно.Колонки.Тип.Имя = "ТипДополнительно";
			КонтактнаяИнформацияДополнительно.Колонки.Представление.Имя = "ПредставлениеДополнительно";
		КонецЕсли;
		
		АдресатыДополнительно = Новый ТаблицаЗначений;
		АдресатыДополнительно.Колонки.Добавить("СсылкаДополнительно");
		
		Для Инд = 1 По СписокАдресатовДополнительно.Количество() Цикл
			АдресатыДополнительно.Добавить();
		КонецЦикла;
		АдресатыДополнительно.ЗагрузитьКолонку(СписокАдресатовДополнительно, "СсылкаДополнительно");
		
		Для каждого АдресатДополнительноСтрокой Из СписокАдресатовДополнительноСтрокой Цикл
			НоваяСтрокаАдресатыДополнительно = АдресатыДополнительно.Добавить();
			НоваяСтрокаАдресатыДополнительно.СсылкаДополнительно = АдресатДополнительноСтрокой;
		КонецЦикла;
		
		// Вывод в таблицу
		
		СхемаКомпоновкиДанных = Справочники.ПЛ_Подписчики.ПолучитьМакет("КонтактнаяИнформация");
		НастройкиКомпоновки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
		
		ВнешниеНаборыДанных = Новый Структура;
		ВнешниеНаборыДанных.Вставить("КонтактнаяИнформация", КонтактнаяИнформация);
		ВнешниеНаборыДанных.Вставить("Адресаты", Адресаты);
		ВнешниеНаборыДанных.Вставить("КонтактнаяИнформацияДополнительно", КонтактнаяИнформацияДополнительно);
		ВнешниеНаборыДанных.Вставить("АдресатыДополнительно", АдресатыДополнительно);
		
		ОтборВидовКИ = Новый Массив;
		Для каждого СтрокаВидКИ Из ВидыКонтактнойИнформации Цикл
			Если ЗначениеЗаполнено(СтрокаВидКИ.Значение) Тогда
				ОтборВидовКИ.Добавить(СтрокаВидКИ.Значение);
			КонецЕсли;
		КонецЦикла;
		
		Если ОтборВидовКИ.Количество() Тогда
			
			Поле = Новый ПолеКомпоновкиДанных("Вид");
			
			ГруппаОтбора = НастройкиКомпоновки.Структура[0].Настройки.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
			ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
			
			ЭлементОтбора = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементОтбора.Использование     = Истина;
			ЭлементОтбора.ЛевоеЗначение     = Поле;
			ЭлементОтбора.ВидСравнения      = ВидСравненияКомпоновкиДанных.ВСписке;
			ЭлементОтбора.ПравоеЗначение    = ОтборВидовКИ;
			
			ЭлементОтбора = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементОтбора.Использование     = Истина;
			ЭлементОтбора.ЛевоеЗначение     = Поле;
			ЭлементОтбора.ВидСравнения      = ВидСравненияКомпоновкиДанных.НеЗаполнено;
		КонецЕсли;
		
		ОтборВидовКИДополнительно = Новый Массив;
		Для каждого СтрокаВидКИ Из ВидыКонтактнойИнформацииДополнительно Цикл
			Если ЗначениеЗаполнено(СтрокаВидКИ.Значение) Тогда
				ОтборВидовКИДополнительно.Добавить(СтрокаВидКИ.Значение);
			КонецЕсли;
		КонецЦикла;
		
		Если ОтборВидовКИДополнительно.Количество() Тогда
			
			Поле = Новый ПолеКомпоновкиДанных("ВидДополнительно");
			
			ГруппаОтбора = НастройкиКомпоновки.Структура[1].Настройки.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
			ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
			
			ЭлементОтбора = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементОтбора.Использование     = Истина;
			ЭлементОтбора.ЛевоеЗначение     = Поле;
			ЭлементОтбора.ВидСравнения      = ВидСравненияКомпоновкиДанных.ВСписке;
			ЭлементОтбора.ПравоеЗначение    = ОтборВидовКИДополнительно;
			
			ЭлементОтбора = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементОтбора.Использование     = Истина;
			ЭлементОтбора.ЛевоеЗначение     = Поле;
			ЭлементОтбора.ВидСравнения      = ВидСравненияКомпоновкиДанных.НеЗаполнено;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Заголовок) Тогда
			НастройкиКомпоновки.ПараметрыВывода.УстановитьЗначениеПараметра("Заголовок", Заголовок);
		КонецЕсли;
		
		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
		ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
		
		ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
		МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиКомпоновки, ДанныеРасшифровки);
		ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки, Истина);
		
		ПроцессорВыводаВТабличныйДокумент = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
		ПроцессорВыводаВТабличныйДокумент.УстановитьДокумент(РезультатПроверки);
		ПроцессорВыводаВТабличныйДокумент.Вывести(ПроцессорКомпоновкиДанных);
		
		АдресРасшифровки = ПоместитьВоВременноеХранилище(ДанныеРасшифровки, УникальныйИдентификатор);
		
	//Исключение
	//
	//КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьКомпоновщикНастроекВыборки()
	
	Если ЭтоАдресВременногоХранилища(АдресСхемыВыборки)
		И ЭтоАдресВременногоХранилища(АдресНастроекВыборки) Тогда
		ПЛ_УведомленияОСобытиях.ИнициализироватьКомпоновщикНастроек(КомпоновщикНастроекВыборки, АдресСхемыВыборки, АдресНастроекВыборки);
	КонецЕсли;
	
КонецПроцедуры

