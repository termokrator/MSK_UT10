Функция IDСоответстуетОбособленнойОтгрузке(IDСклада) Экспорт	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СобственныеСклады.Ссылка
	|ИЗ
	|	Справочник.СобственныеСклады КАК СобственныеСклады
	|ГДЕ
	|	СобственныеСклады.Идентификатор = &Идентификатор
	|	И СобственныеСклады.ИсключитьИзОбщегоЭкспресса
	|	И НЕ СобственныеСклады.ВэбСервисУТ11 
	|	И НЕ СобственныеСклады.НеИспользуетОбособленнуюОтгрузку";

	Запрос.УстановитьПараметр("Идентификатор", IDСклада);  
	
	Выборка = Запрос.Выполнить().Выбрать();   
	
	Если Выборка.Следующий() Тогда
		Возврат Истина;				
	КонецЕсли;         
	
	Возврат Ложь;
	
КонецФункции  

