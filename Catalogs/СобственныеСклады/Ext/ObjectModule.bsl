
Процедура ПередЗаписью(Отказ)   
	
	Если ИсключитьИзОбщегоЭкспресса Тогда 
		
		Если НЕ ЗначениеЗаполнено(Поставщик) 
			ИЛИ НЕ ЗначениеЗаполнено(АдресВебСервиса)
			ИЛИ НЕ ЗначениеЗаполнено(КодДоговора)
			ИЛИ НЕ ЗначениеЗаполнено(КодКонтрагента)
			Тогда Отказ = Истина;
		КонецЕсли;	
		
		Если Не Отказ Тогда
			
			Если ЗначениеЗаполнено(ДоговорКонтрагента) И (Не (ДоговорКонтрагента.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком)) Тогда
				
				#Если Клиент Тогда
					Сообщить("Вид договора должен быть ""С поставщиком"".");
				#КонецЕсли
				Отказ = Истина;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;	 
	
КонецПроцедуры
