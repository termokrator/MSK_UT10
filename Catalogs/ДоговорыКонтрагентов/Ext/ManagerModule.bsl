
Функция КоличествоДнейОтсрочки(ДоговорКонтрагента, КлючСтрокиУсловий) Экспорт
//+ Кривова З. 24.06.2024 #UT10-4544

	КоличествоДнейОтсрочки = 0;

	НайдСтроки = ДоговорКонтрагента.Условия.НайтиСтроки(Новый Структура("КлючСтроки", КлючСтрокиУсловий));
	Если НайдСтроки.Количество() > 0 Тогда
		КоличествоДнейОтсрочки = НайдСтроки[0].КоличествоДнейОтсрочки;
	//+ Кривова З. 27.11.2024 #UT10-4842
	Иначе
		КоличествоДнейОтсрочки = ДоговорКонтрагента.ДопустимоеЧислоДнейЗадолженности;
	//- Кривова З. 27.11.2024 #UT10-4842
	КонецЕсли;
	
	Возврат КоличествоДнейОтсрочки;

//- Кривова З. 24.06.2024 #UT10-4544	
КонецФункции