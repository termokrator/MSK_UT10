// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Создает и возвращает событие по регламентной проверке по переданному наименованию макета СКД
//
Функция СоздатьСобытиеРегламентнойПроверки(НаименованиеСобытия, НаименованиеМакета)
	
	Событие = СоздатьЭлемент();
	Событие.Наименование                        = НаименованиеСобытия;
	Событие.ИсточникСобытия                     = Перечисления.ПЛ_ИсточникиСобытий.РегламентнаяПроверка;
	Событие.ПериодичностьРегламентнойПроверки   = Перечисления.ПЛ_ПериодичностьРегламентныхПроверок.Никогда;
	
	Расписание = Новый РасписаниеРегламентногоЗадания;
	Расписание.ДатаНачала = ТекущаяДата();
	Расписание.ВремяНачала = ТекущаяДата();
	
	Задание = РегламентныеЗадания.СоздатьРегламентноеЗадание(Метаданные.РегламентныеЗадания.ПЛ_УведомленияПоРегламентнымПроверкам);
	Задание.Использование = Истина;
	Задание.Наименование = НаименованиеЗадания(НаименованиеСобытия);
	Задание.Расписание = Расписание;
	Задание.Записать();
	
	Событие.РегламентноеЗадание                 = Задание.УникальныйИдентификатор;
	
	Схема = ПолучитьМакет(НаименованиеМакета);
	
	Событие.СхемаРегламентнойПроверки           = Новый ХранилищеЗначения(Схема);
	Событие.НастройкиРегламентнойПроверки       = Новый ХранилищеЗначения(Схема.НастройкиПоУмолчанию);
	
	Возврат Событие;
	
КонецФункции

// Возвращает список преднастроенных событий для поддерживаемых конфигураций
//
Функция СписокПреднастроенныхСобытий()
	
	ВерсияПодсистемыУТ = ПЛ_УведомленияОСобытиях.ВерсияУТ();
	
	СписокСобытий = Новый Массив;
	
	Если ВерсияПодсистемыУТ = "10" Тогда
		
		ОписаниеСобытия = Новый Структура;
		ОписаниеСобытия.Вставить("Наименование", НСтр("ru = 'Оплата по заказу'"));
		ОписаниеСобытия.Вставить("ПроцедураСоздания", "ОплатаПоЗаказуУТ10");
		СписокСобытий.Добавить(ОписаниеСобытия);
		
	ИначеЕсли ВерсияПодсистемыУТ = "11" Тогда
		
		ОписаниеСобытия = Новый Структура;
		ОписаниеСобытия.Вставить("Наименование", НСтр("ru = 'Оплата по графику'"));
		ОписаниеСобытия.Вставить("ПроцедураСоздания", "ОплатаПоГрафикуУТ11");
		СписокСобытий.Добавить(ОписаниеСобытия);
		
	КонецЕсли;
	
	Возврат СписокСобытий;
	
КонецФункции

// Создает преднастроенное событие "Оплата по графику"
//
Функция ОплатаПоЗаказуУТ10(Наименование) Экспорт
	
	Возврат СоздатьСобытиеРегламентнойПроверки(Наименование, "ОплатаПоЗаказуУТ10");
	
КонецФункции

// Создает преднастроенное событие "Оплата по графику"
//
Функция ОплатаПоГрафикуУТ11(Наименование) Экспорт
	
	Возврат СоздатьСобытиеРегламентнойПроверки(Наименование, "ОплатаПоГрафикуУТ11");
	
КонецФункции

#КонецЕсли
