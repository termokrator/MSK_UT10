// ПРОГРАММНЫЙ ИНТЕРФЕЙС

// Возвращает список событий для указанного источника события
//
// Параметры
//    ТипИсточника - ПеречислениеСсылка.ПЛ_ИсточникиСобытий - тип источника события
//    Источник - ЛюбаяСсылка - ссылка на источник события
//
// Возвращаемое значение: массив событий, либо Неопределено, если ни одного события не нашлось
//
Функция СобытияПоИсточнику(ТипИсточника, Источник) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	События.Ссылка                                КАК Ссылка,
	|	События.ВидУсловийРегистрацииСобытия          КАК ВидУсловийРегистрацииСобытия,
	|	События.СхемаУсловийРегистрацииСобытия        КАК СхемаУсловийРегистрацииСобытия,
	|	События.НастройкиУсловийРегистрацииСобытия    КАК НастройкиУсловийРегистрацииСобытия
	|ИЗ
	|	Справочник.ПЛ_События КАК События
	|ГДЕ
	|	События.ИсточникСобытия = &ТипИсточника
	|	И События.Регистратор ПОДОБНО &Регистратор
	|	И НЕ События.ПометкаУдаления
	|	";
	
	ИмяОбъекта = Источник.Метаданные().Имя;
	Запрос.УстановитьПараметр("ТипИсточника", ТипИсточника);
	Запрос.УстановитьПараметр("Регистратор", ИмяОбъекта);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Проверка условия
	ОтобранныеСобытия = Новый Массив;
	
	ВыборкаСобытий = РезультатЗапроса.Выбрать();
	Пока ВыборкаСобытий.Следующий() Цикл
		
		Если ВыборкаСобытий.ВидУсловийРегистрацииСобытия = Перечисления.ПЛ_ВидыУсловийУведомлений.БезУсловия Тогда
			
			ОтобранныеСобытия.Добавить(ВыборкаСобытий.Ссылка);
			
		ИначеЕсли ВыборкаСобытий.ВидУсловийРегистрацииСобытия = Перечисления.ПЛ_ВидыУсловийУведомлений.ОтборПоИсточнику Тогда
			
			АдресСхемыУсловий = ПоместитьВоВременноеХранилище(ВыборкаСобытий.СхемаУсловийРегистрацииСобытия.Получить(), Новый УникальныйИдентификатор);
			АдресНастроекУсловий = ПоместитьВоВременноеХранилище(ВыборкаСобытий.НастройкиУсловийРегистрацииСобытия.Получить(), Новый УникальныйИдентификатор);
			Если ПЛ_УведомленияОсобытиях.ПроверитьУсловие(ТипИсточника, Источник, АдресСхемыУсловий, АдресНастроекУсловий) Тогда
				ОтобранныеСобытия.Добавить(ВыборкаСобытий.Ссылка);
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	Если Не ОтобранныеСобытия.Количество() Тогда
		Возврат Неопределено;
	Иначе
		Возврат ОтобранныеСобытия;
	КонецЕсли;
	
КонецФункции

// Создает события по-умолчанию при первом запуске подсистемы и помещает их в группу "Преднастроенные"
//
Процедура ЗаполнитьПреднастроенныеСобытия() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	СписокСобытий = СписокПреднастроенныхСобытий();
	
	Если СписокСобытий.Количество() Тогда
		
		ГруппаПреднастроенные = НайтиПоНаименованию(НСтр("ru = 'Преднастроенные'"), Истина);
		
		Если Не ЗначениеЗаполнено(ГруппаПреднастроенные) Тогда
			ГруппаПреднастроенные = Справочники.ПЛ_События.СоздатьГруппу();
			ГруппаПреднастроенные.Наименование = НСтр("ru = 'Преднастроенные'");
			ГруппаПреднастроенные.Записать();
			ГруппаПреднастроенные = ГруппаПреднастроенные.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Для каждого ПреднастроенноеСобытие из СписокСобытий Цикл
		
		Ссылка = НайтиПоНаименованию(ПреднастроенноеСобытие.Наименование, Истина);
		Если Не ЗначениеЗаполнено(Ссылка) Тогда
			Попытка
				Объект = "";
				Выполнить("Объект = " + ПреднастроенноеСобытие.ПроцедураСоздания + "(""" + ПреднастроенноеСобытие.Наименование + """)");
				Объект.Родитель = ГруппаПреднастроенные;
				Объект.Записать();
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Формирует наименование задания для событий вида "Регламентная проверка"
//
// Параметры
//    НаименованиеСобытия - Строка - Наименование события, для которого формируется наименование задания
//
// Возвращаемое значение: наименование регламентного задания
//
Функция НаименованиеЗадания(НаименованиеСобытия) Экспорт
	
	НаименованиеЗадания = НСтр("ru = 'Уведомления по регламентной проверке: %1'");
	Возврат СтрЗаменить(НаименованиеЗадания, "%1", СокрЛП(НаименованиеСобытия));
	
КонецФункции

// Возвращает Реквизиты
Функция РеквизитыСобытия(Ссылка) Экспорт
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("ИсточникСобытия");
	СтруктураРеквизитов.Вставить("Регистратор");
	СтруктураРеквизитов.Вставить("КодПодписки");
	СтруктураРеквизитов.Вставить("РегламентноеЗадание");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ИсточникСобытия,
	|	Регистратор,
	|	КодПодписки,
	|	РегламентноеЗадание
	|ИЗ
	|	Справочник.ПЛ_События
	|ГДЕ
	|	Ссылка = &Ссылка
	|";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураРеквизитов, Выборка);
	КонецЕсли;
	
	Возврат СтруктураРеквизитов;
	
КонецФункции

