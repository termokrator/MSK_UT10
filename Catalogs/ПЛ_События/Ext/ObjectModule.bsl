////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ИсточникСобытия = Перечисления.ПЛ_ИсточникиСобытий.РегламентнаяПроверка
		Или ИсточникСобытия = Перечисления.ПЛ_ИсточникиСобытий.Рассылка Тогда
		Индекс = ПроверяемыеРеквизиты.Найти("ПредставлениеРегистратора");
		Если Индекс <> Неопределено Тогда
			ПроверяемыеРеквизиты.Удалить(Индекс);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	Если ИсточникСобытия = Перечисления.ПЛ_ИсточникиСобытий.РегламентнаяПроверка
		И ДополнительныеСвойства.Свойство("Запуск")
		И ДополнительныеСвойства.Запуск Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		
		Задание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(РегламентноеЗадание);
		Если Задание = Неопределено Тогда
			
			Задание = РегламентныеЗадания.СоздатьРегламентноеЗадание(Метаданные.РегламентныеЗадания.ПЛ_УведомленияПоРегламентнымПроверкам);
			Задание.Использование = Истина;
			Задание.Наименование = Справочники.ПЛ_События.НаименованиеЗадания(Наименование);
			Задание.Расписание = ДополнительныеСвойства.Расписание;
			Задание.Записать();
			
			РегламентноеЗадание = Задание.УникальныйИдентификатор;
			
		КонецЕсли;
		УстановитьПривилегированныйРежим(Ложь);
	Иначе
		
		Задание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(РегламентноеЗадание);
		Если Задание <> Неопределено Тогда
			Задание.Удалить();
		КонецЕсли;
		
		РегламентноеЗадание = "";
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередУдалением(Отказ)
	
	Если ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	Задание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(РегламентноеЗадание);
	Если Задание <> Неопределено Тогда
		Задание.Удалить();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	РегламентноеЗадание = Неопределено;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	Если ИсточникСобытия = Перечисления.ПЛ_ИсточникиСобытий.РегламентнаяПроверка Тогда
		
		УстановитьПривилегированныйРежим(Истина);
	
		Задание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(РегламентноеЗадание);
		Если Задание <> Неопределено Тогда
			
			ЗаданиеИзменено = Ложь;
			Если ДополнительныеСвойства.Свойство("Расписание")
				И ТипЗнч(ДополнительныеСвойства.Расписание) = Тип("РасписаниеРегламентногоЗадания")
				И Строка(ДополнительныеСвойства.Расписание) <> Строка(Задание.Расписание) Тогда
				Задание.Расписание = ДополнительныеСвойства.Расписание;
				ЗаданиеИзменено = Истина;
			КонецЕсли;
			
			НаименованиеЗадания = Справочники.ПЛ_События.НаименованиеЗадания(Наименование);
			Если Задание.Наименование <> НаименованиеЗадания Тогда
				Задание.Наименование = НаименованиеЗадания;
				ЗаданиеИзменено = Истина;
			КонецЕсли;
			
			Если Не Задание.Использование Тогда
				Задание.Использование = Истина;
				ЗаданиеИзменено = Истина;
			КонецЕсли;
			
			Если Задание.Параметры.Количество() <> 1 ИЛИ Задание.Параметры[0] <> Ссылка Тогда
				ПараметрыЗадания = Новый Массив;
				ПараметрыЗадания.Добавить(Ссылка);
				Задание.Параметры = ПараметрыЗадания;
				ЗаданиеИзменено = Истина;
			КонецЕсли;
				
			Если ЗаданиеИзменено Тогда
				Задание.Записать();
			КонецЕсли;
			
		КонецЕсли;
		
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
КонецПроцедуры

#КонецЕсли
