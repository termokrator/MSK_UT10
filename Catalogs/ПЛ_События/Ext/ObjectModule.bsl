// ПРОГРАММНЫЙ ИНТЕРФЕЙС

// Возвращает стандартную схему и настройки компоновки условий для переданного события
//
// Для документов и справочников схема в отборах будет содержать их реквизиты
// Для регистра сведений схема в отборах будет содержать поля регистра
// Для регламентной проверки вернется схема проверки
//
// Параметры
//    Событие - СправочникСсылка.ПЛ_События - событие, для которого необходимо получить схему и настройки
//
// Возвращаемое значение
//    Структура с полями "СКД" - схема компоновки данных и "Настройки" - настройки схемы компоновки данных
//
Функция СтандартнаяСхемаУсловийДляСобытия() Экспорт
	
	СхемаИНастройки = Новый Структура;
	СхемаИНастройки.Вставить("СКД", Неопределено);
	СхемаИНастройки.Вставить("Настройки", Неопределено);
	
	ТипИсточника = ИсточникСобытия;
	ИмяИсточника = Регистратор;
	
	Если Не ПустаяСтрока(ИмяИсточника)
		И (ТипИсточника = Перечисления.ПЛ_ИсточникиСобытий.ИсточникДокумент
		Или ТипИсточника = Перечисления.ПЛ_ИсточникиСобытий.ИсточникЗаписьДокумента
		Или ТипИсточника = Перечисления.ПЛ_ИсточникиСобытий.ИсточникСправочник) Тогда
		
		СКД = ПолучитьМакет("ПроверкаУсловий");
		
		ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	1 КАК Поле1
		|ИЗ
		|	%ИсточникСобытия%.%ИмяРегистратора% КАК %ИмяРегистратора%
		|ГДЕ
		|	%ИмяРегистратора%.Ссылка = &Источник
		|{ГДЕ
		|	%ИмяРегистратора%.Ссылка.* КАК %ИмяРегистратора%}
		|";
		
		Если ТипИсточника = Перечисления.ПЛ_ИсточникиСобытий.ИсточникСправочник Тогда
			ВидИсточника = "Справочник";
		Иначе
			ВидИсточника = "Документ";
		КонецЕсли;
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ИсточникСобытия%", ВидИсточника);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ИмяРегистратора%", ИмяИсточника);
		
		СКД.НаборыДанных.Объект.Запрос = ТекстЗапроса;
		
		СхемаИНастройки.СКД = СКД;
		СхемаИНастройки.Настройки = СКД.НастройкиПоУмолчанию;
		
	ИначеЕсли Не ПустаяСтрока(ИмяИсточника)
		И (ТипИсточника = Перечисления.ПЛ_ИсточникиСобытий.ИсточникРегистрСведений) Тогда
		
		СКД = ПолучитьМакет("ПроверкаУсловий");
		
		ТипыСправочников = Справочники.ТипВсеСсылки();
		ТипыДокументов = Документы.ТипВсеСсылки();
		
		ТекстУсловий = "";
		ТаблицаКолонок = РегистрыСведений[ИмяИсточника].СоздатьНаборЗаписей().ВыгрузитьКолонки();
		Для каждого Колонка из ТаблицаКолонок.Колонки Цикл
			
			ИмяПоля = ИмяИсточника + "." + Колонка.Имя;
			
			ЕстьСсылка = Ложь;
			МассивТипов = Колонка.ТипЗначения.Типы();
			Для каждого ТипКолонки из МассивТипов Цикл
				Если ТипыСправочников.СодержитТип(ТипКолонки)
					ИЛИ ТипыДокументов.СодержитТип(ТипКолонки) Тогда
					ЕстьСсылка = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если ЕстьСсылка Тогда
				ИмяПоля = ИмяПоля + ".*";
			КонецЕсли;
			
			ИмяПоля = ИмяПоля + " КАК " + Колонка.Имя;
			
			ТекстУсловий = ТекстУсловий + ?(ПустаяСтрока(ТекстУсловий), "", ",") + "
			|	" + ИмяПоля;
			
		КонецЦикла;
		
		ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	1 КАК Поле1
		|ИЗ
		|	РегистрСведений.%ИмяРегистратора% КАК %ИмяРегистратора%
		|{ГДЕ
		|	" + ТекстУсловий + "}
		|";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ИмяРегистратора%", ИмяИсточника);
		
		СКД.НаборыДанных.Объект.Запрос = ТекстЗапроса;
		
		СхемаИНастройки.СКД = СКД;
		СхемаИНастройки.Настройки = СКД.НастройкиПоУмолчанию;
		
	ИначеЕсли ТипИсточника = Перечисления.ПЛ_ИсточникиСобытий.РегламентнаяПроверка Тогда
		
		СхемаИНастройки.СКД = СхемаРегламентнойПроверки.Получить();
		СхемаИНастройки.Настройки = НастройкиРегламентнойПроверки.Получить();
		
	КонецЕсли;
	
	Возврат СхемаИНастройки;
	
КонецФункции

// Возвращает стандартную схему и настройки компоновки шаблонов сообщения для переданного события
//
// Для документов и справочников схема в выбранных полях будет содержать их реквизиты
// Для регистра сведений схема в выбранных полях будет содержать поля регистра
// Для регламентной проверки вернется схема проверки
//
// Параметры
//    Событие - СправочникСсылка.ПЛ_События - событие, для которого необходимо получить схему и настройки
//
// Возвращаемое значение
//    Структура с полями "СКД" - схема компоновки данных и "Настройки" - настройки схемы компоновки данных
//
Функция СтандартнаяСхемаШаблоновДляСобытия() Экспорт
	
	СхемаИНастройки = Новый Структура;
	СхемаИНастройки.Вставить("СКД", Неопределено);
	СхемаИНастройки.Вставить("Настройки", Неопределено);
	
	ТипИсточника = ИсточникСобытия;
	ИмяИсточника = Регистратор;
	
	Если Не ПустаяСтрока(ИмяИсточника)
		И (ТипИсточника = Перечисления.ПЛ_ИсточникиСобытий.ИсточникДокумент
		Или ТипИсточника = Перечисления.ПЛ_ИсточникиСобытий.ИсточникЗаписьДокумента
		Или ТипИсточника = Перечисления.ПЛ_ИсточникиСобытий.ИсточникСправочник) Тогда
		
		ТекстЗапроса = "
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	*
		|ИЗ
		|	%ИсточникСобытия%.%ИмяРегистратора% КАК %ИмяРегистратора%
		|ГДЕ
		|	%ИмяРегистратора%.Ссылка = &Источник
		|";
		
		Если ТипИсточника = Перечисления.ПЛ_ИсточникиСобытий.ИсточникСправочник Тогда
			ВидИсточника = "Справочник";
		Иначе
			ВидИсточника = "Документ";
		КонецЕсли;
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ИсточникСобытия%", ВидИсточника);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ИмяРегистратора%", ИмяИсточника);
		
		СКД = ПЛ_УведомленияОСобытиях.СхемаКомпоновкиДанныхДляЗапроса(ТекстЗапроса);
		
		ПЛ_УведомленияОСобытиях.ДобавитьВКомпоновкуПолеТекущийПользователь(СКД);
		
		СхемаИНастройки.СКД = СКД;
		СхемаИНастройки.Настройки = СКД.НастройкиПоУмолчанию;
		
	// В запросе для регистра сведений нужны отборы компоновки, чтобы фильтровать выборку по набору записей
	ИначеЕсли НЕ ПустаяСтрока(ИмяИсточника)
		И (ТипИсточника = Перечисления.ПЛ_ИсточникиСобытий.ИсточникРегистрСведений) Тогда
		
		ТипыСправочников = Справочники.ТипВсеСсылки();
		ТипыДокументов = Документы.ТипВсеСсылки();
		
		ТекстУсловий = "";
		ТаблицаКолонок = РегистрыСведений[ИмяИсточника].СоздатьНаборЗаписей().ВыгрузитьКолонки();
		Для каждого Колонка из ТаблицаКолонок.Колонки Цикл
			
			ИмяПоля = ИмяИсточника + "." + Колонка.Имя;
			
			ЕстьСсылка = Ложь;
			МассивТипов = Колонка.ТипЗначения.Типы();
			Для каждого ТипКолонки из МассивТипов Цикл
				Если ТипыСправочников.СодержитТип(ТипКолонки)
					ИЛИ ТипыДокументов.СодержитТип(ТипКолонки) Тогда
					ЕстьСсылка = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если ЕстьСсылка Тогда
				ИмяПоля = ИмяПоля + ".*";
			КонецЕсли;
			
			ИмяПоля = ИмяПоля + " КАК " + Колонка.Имя;
			
			ТекстУсловий = ТекстУсловий + ?(ПустаяСтрока(ТекстУсловий), "", ",") + "
			|	" + ИмяПоля;
			
		КонецЦикла;
		
		ТекстЗапроса = "
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	*
		|ИЗ
		|	РегистрСведений.%ИмяРегистратора% КАК %ИмяРегистратора%
		|{ГДЕ
		|	" + ТекстУсловий + "}
		|";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ИмяРегистратора%", ИмяИсточника);
		
		СКД = ПЛ_УведомленияОСобытиях.СхемаКомпоновкиДанныхДляЗапроса(ТекстЗапроса);
		
		ПЛ_УведомленияОСобытиях.ДобавитьВКомпоновкуПолеТекущийПользователь(СКД);
		
		СхемаИНастройки.СКД = СКД;
		СхемаИНастройки.Настройки = СКД.НастройкиПоУмолчанию;
		
	ИначеЕсли ТипИсточника = Перечисления.ПЛ_ИсточникиСобытий.РегламентнаяПроверка Тогда
		
		СхемаИНастройки.СКД = СхемаРегламентнойПроверки.Получить();
		СхемаИНастройки.Настройки = НастройкиРегламентнойПроверки.Получить();
	КонецЕсли;
	
	Возврат СхемаИНастройки;
	
КонецФункции

