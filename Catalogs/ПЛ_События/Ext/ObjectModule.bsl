		СхемаИНастройки.СКД = СКД;
		СхемаИНастройки.Настройки = СКД.НастройкиПоУмолчанию;
		
	// В запросе для регистра сведений нужны отборы компоновки, чтобы фильтровать выборку по набору записей
	ИначеЕсли НЕ ПустаяСтрока(ИмяИсточника)
		И (ТипИсточника = Перечисления.ПЛ_ИсточникиСобытий.ИсточникРегистрСведений) Тогда
		
