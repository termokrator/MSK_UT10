				<QueryText>ВЫБРАТЬ
	События.Ссылка,
	События.ВерсияДанных,
	События.ПометкаУдаления,
	События.Предопределенный,
	События.Наименование,
	События.ВидУсловийРегистрацииСобытия,
	
	ВЫБОР КОГДА События.ИсточникСобытия = ЗНАЧЕНИЕ(Перечисление.ПЛ_ИсточникиСобытий.ИсточникСправочник) ТОГДА
		"Справочник " + События.ПредставлениеРегистратора
	КОГДА События.ИсточникСобытия = ЗНАЧЕНИЕ(Перечисление.ПЛ_ИсточникиСобытий.ИсточникДокумент) ТОГДА
		"Документ " + События.ПредставлениеРегистратора
	КОГДА События.ИсточникСобытия = ЗНАЧЕНИЕ(Перечисление.ПЛ_ИсточникиСобытий.ИсточникРегистрСведений) ТОГДА
		"Сведения " + События.ПредставлениеРегистратора
	КОГДА События.ИсточникСобытия = ЗНАЧЕНИЕ(Перечисление.ПЛ_ИсточникиСобытий.РегламентнаяПроверка) ТОГДА
		ПРЕДСТАВЛЕНИЕ(События.ИсточникСобытия)
	КОНЕЦ КАК ИсточникСобытия,
	
	ВЫБОР КОГДА События.ИсточникСобытия = ЗНАЧЕНИЕ(Перечисление.ПЛ_ИсточникиСобытий.ИсточникСправочник) ТОГДА
		"При записи"
	КОГДА События.ИсточникСобытия = ЗНАЧЕНИЕ(Перечисление.ПЛ_ИсточникиСобытий.ИсточникДокумент) ТОГДА
		"При проведении"
	КОГДА События.ИсточникСобытия = ЗНАЧЕНИЕ(Перечисление.ПЛ_ИсточникиСобытий.ИсточникРегистрСведений) ТОГДА
		"При записи"
	КОГДА События.ИсточникСобытия = ЗНАЧЕНИЕ(Перечисление.ПЛ_ИсточникиСобытий.РегламентнаяПроверка) ТОГДА
		События.ПериодичностьРегламентнойПроверки
	КОНЕЦ КАК Расписание
ИЗ
	Справочник.ПЛ_События КАК События</QueryText>
