
Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ПроверитьУникальностьЗадания(Отказ);
	
	Если Не Отказ Тогда
		ОбновитьРегламентноеЗадание();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьУникальностьЗадания(Отказ)
	
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("Справочник.ПодпискиНаОчередиСообщений");
	Блокировка.Заблокировать();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА
	|ИЗ
	|	Справочник.ПодпискиНаОчередиСообщений КАК ПодпискиНаОчередиСообщений
	|ГДЕ
	|	ПодпискиНаОчередиСообщений.Ссылка <> &Ссылка
	|	И ПодпискиНаОчередиСообщений.ИмяОчереди = &ИмяОчереди";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("ИмяОчереди", ИмяОчереди);
	
	Отказ = Не Запрос.Выполнить().Пустой();
	
	Если Отказ Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Текст = СтрШаблон(НСтр("ru = 'Подписка на очередь %1 уже существует!'"), ИмяОчереди);
		Сообщение.Сообщить();
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьРегламентноеЗадание()
	
	Перем Задание;
	
	Если ЗначениеЗаполнено(ИдентификаторЗадания) Тогда
		Задание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
	КонецЕсли;
	
	Если Задание = Неопределено Тогда
		// TODO: Корявенько.
		МетаданноеРегламентного = 
			?(Асинхронно = Истина, 
						Метаданные.РегламентныеЗадания.ПолучениеСообщенийИзОчередейАсинх,
						Метаданные.РегламентныеЗадания.ПолучениеСообщенийИзОчередей
			);
		Задание = РегламентныеЗадания.СоздатьРегламентноеЗадание(МетаданноеРегламентного);
		ИдентификаторЗадания = Задание.УникальныйИдентификатор;
	КонецЕсли;
	
	Задание.Наименование = Наименование;
	Задание.Расписание = РасписаниеЗадания.Получить();
	Задание.Использование = Не ПометкаУдаления И Активно;
	Задание.Ключ = ИмяОчереди;
	
	ПараметрыЗадания = Новый Массив;
	ПараметрыЗадания.Добавить(ИмяОчереди);
	ПараметрыЗадания.Добавить(ИнтервалОжиданияСобытия);
	
	Задание.Параметры = ПараметрыЗадания;

	Задание.Записать();
	
КонецПроцедуры

Процедура ПередУдалением(Отказ)
	
	Если ЗначениеЗаполнено(ИдентификаторЗадания) Тогда
		Задание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
		Если Задание <> Неопределено Тогда
			Задание.Удалить();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	ИдентификаторЗадания = Неопределено;
КонецПроцедуры
