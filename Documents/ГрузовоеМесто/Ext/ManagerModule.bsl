
Функция ПолучитьШтрихкодГрузоместа(ГМ) Экспорт
	
	Если ГМ.Дата < НачалоДня(Дата(2020,03,31,00,00,00)) Тогда		
		Возврат Формат(ГМ.Дата, "ДФ=ddMMyyyy") + "" + СокрЛП(ГМ.Номер);		
	Иначе        
		
		Если ЗначениеЗаполнено(ГМ.Сборка.Назначение) Тогда
			Возврат Формат(ГМ.ДатаПечатиШтрихкода, "ДФ=ddMMyyyyЧЧммсс") + "1" + Формат(Число(ГМ.Номер), "ЧЦ=10; ЧВН=; ЧГ=0"); 				
		Иначе
			
			Если ЗначениеЗаполнено(ГМ.ШКОбособленного) Тогда                                                                                     
				Возврат ГМ.ШКОбособленного; 	
			Иначе
				Возврат Формат(ГМ.Дата, "ДФ=ddMMyyyy") + "" + Формат(Число(ГМ.Номер), "ЧЦ=17; ЧВН=; ЧГ=0");					
			КонецЕсли;
			
		КонецЕсли;  
		
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ПолучитьВесГМ(ГМ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ГрузовоеМестоТовары.Номенклатура,
	|	ГрузовоеМестоТовары.Количество,
	|	ГрузовоеМестоТовары.Заказ
	|ПОМЕСТИТЬ ВТ_ТоварыГМ
	|ИЗ
	|	Документ.ГрузовоеМесто.Товары КАК ГрузовоеМестоТовары
	|ГДЕ
	|	ГрузовоеМестоТовары.Ссылка = &ГМ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказПокупателяТовары.Ссылка КАК Заказ,
	|	МАКСИМУМ(ЗаказПокупателяТовары.ЕдиницаИзмерения) КАК ЕдиницаИзмерения,
	|	ЗаказПокупателяТовары.Номенклатура
	|ПОМЕСТИТЬ ВТ_ЕдиницыЗаказа
	|ИЗ
	|	Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары
	|ГДЕ
	|	ЗаказПокупателяТовары.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТ_ТоварыГМ.Заказ
	|			ИЗ
	|				ВТ_ТоварыГМ)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказПокупателяТовары.Ссылка,
	|	ЗаказПокупателяТовары.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТоварыГМ.Количество,
	|	ВТ_ЕдиницыЗаказа.ЕдиницаИзмерения,
	|	ВТ_ТоварыГМ.Номенклатура
	|ПОМЕСТИТЬ ВТ_Итоговая
	|ИЗ
	|	ВТ_ТоварыГМ КАК ВТ_ТоварыГМ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЕдиницыЗаказа КАК ВТ_ЕдиницыЗаказа
	|		ПО ВТ_ТоварыГМ.Номенклатура = ВТ_ЕдиницыЗаказа.Номенклатура
	|			И ВТ_ТоварыГМ.Заказ = ВТ_ЕдиницыЗаказа.Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ВТ_Итоговая.Количество * ВТ_Итоговая.ЕдиницаИзмерения.Вес) КАК Вес
	|ИЗ
	|	ВТ_Итоговая КАК ВТ_Итоговая";
	
	Запрос.УстановитьПараметр("ГМ", ГМ);  
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Вес;
	КонецЕсли;              
	
	Возврат 0;
	
КонецФункции
