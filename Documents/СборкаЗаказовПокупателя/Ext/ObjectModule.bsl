Процедура УстановитьЭкспресс(РежимЗаписи)  
	
	ЯчейкаЭкспресс = Константы.ЯчейкаЭкспресс.Получить();
	
	Если ЗначениеЗаполнено(ЯчейкаЭкспресс) Тогда 
		
		Если РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения Тогда 
			
			СтруктураПоиска = Новый Структура("Ячейка", ЯчейкаЭкспресс);
			
			МассивСтрок = Заказано.НайтиСтроки(СтруктураПоиска);
			
			Если МассивСтрок.Количество() <> 0 и СпособДоставки = Перечисления.СпособДоставки.НашаДоставка Тогда 
				Экспресс = ЯчейкаЭкспресс;
			Иначе
				Экспресс = Справочники.Ячейки.ПустаяСсылка();
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		Экспресс = Справочники.Ячейки.ПустаяСсылка();
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьЭтаж()
	
	Этаж = 0;
	СписокЭтажей = Новый СписокЗначений;
	
	Для Каждого Стр Из Заказано Цикл
		
		ТекущийЭтаж = Стр.Ячейка.Этаж;
		
		Если СписокЭтажей.НайтиПоЗначению(ТекущийЭтаж) = Неопределено Тогда 
			СписокЭтажей.Добавить(ТекущийЭтаж);
		КонецЕсли;
		
	КонецЦикла;
	
	Если СписокЭтажей.Количество() = 1 Тогда 
		Этаж = СписокЭтажей[0].Значение;
	КонецЕсли;

КонецПроцедуры

Процедура ПолучитьОтправлен(РежимЗаписи)
	
	Если ЗначениеЗаполнено(Ссылка) И Константы.AMQP_ВыгружатьДанные.Получить() И Договор.ВыгружаетсяВБиллинг И 
		(Договор <> ПредДоговор ИЛИ (Не Проведен И РежимЗаписи = РежимЗаписиДокумента.Проведение)) Тогда
		
		Принудительно = НЕ (Константы.AMQP_ПроверятьВзаиморасчетыЧерезБиллинг.Получить() И Договор.КонтролироватьВзаиморасчетыЧерезСистемуБиллинг);
		Рез = AMQP_РаботаСДокументами.ПроверкаДокументаВБиллинге(Ссылка, Принудительно);
		
		Отправлен = Истина;
		
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьКлючСтроки()   
	
	Для каждого Стр Из Заказано Цикл		
		
		Если Не ЗначениеЗаполнено(Стр.КлючСтроки) Тогда
			Стр.КлючСтроки = УправлениеЗапасами.ПолучитьНовыйКлючСтроки(ЭтотОбъект, "Заказано");
		КонецЕсли;		
		
	КонецЦикла;      

КонецПроцедуры


ПредДоговор = Ссылка.Договор;
