Функция ПолучитьИмяПринтераЭтикеток()
	
	СистемнаяИнформация = Новый СистемнаяИнформация();
	ИдентификаторКлиента = ВРег(СистемнаяИнформация.ИдентификаторКлиента);
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	РабочиеМестаОборудование.Значение
	                      |ИЗ
	                      |	Справочник.РабочиеМеста.Оборудование КАК РабочиеМестаОборудование
	                      |ГДЕ
	                      |	РабочиеМестаОборудование.Ссылка.Код = &Идентификатор
	                      |	И РабочиеМестаОборудование.Вид = ЗНАЧЕНИЕ(Перечисление.ВидыТорговогоОборудования.ПринтерЭтикеток)");
	
	Запрос.УстановитьПараметр("Идентификатор", ИдентификаторКлиента);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Значение;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ПолучитьЗначениеТипаШтрихкодаДляЭУ(ТипКода)

	Перем Значение;
	
	Если ТипКода = ПланыВидовХарактеристик.ТипыШтрихкодов.EAN8 Тогда
		Значение = 0;
	ИначеЕсли ТипКода = ПланыВидовХарактеристик.ТипыШтрихкодов.EAN13 Тогда
		Значение = 1;
	ИначеЕсли ТипКода = ПланыВидовХарактеристик.ТипыШтрихкодов.EAN128 Тогда
		Значение = 2;
	ИначеЕсли ТипКода = ПланыВидовХарактеристик.ТипыШтрихкодов.Code39 Тогда
		Значение = 3;
	ИначеЕсли ТипКода = ПланыВидовХарактеристик.ТипыШтрихкодов.Code128 Тогда
		Значение = 4;
	Иначе
		Значение = -1;
	КонецЕсли;
	
	Возврат Значение;  
	
КонецФункции 

Процедура ПечатьСтекара(Сборка, ГрузовоеМесто, СразуНаПринтер = Истина) Экспорт

	Если НЕ ГрузовоеМесто.Проведен Тогда
		
		Сообщить("Документ грузовое место не проведен !");
		Возврат;  
		
	КонецЕсли;
	
	Принтер = "";
	
	Если СразуНаПринтер Тогда
		
		Принтер = ПолучитьИмяПринтераЭтикеток();
		
		Если Не ЗначениеЗаполнено(Принтер) Тогда
			Сообщить("В базе не настроен принтер этикеток для текущего рабочего места");
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Константы.ЭтикеткаГрузоместаРостов.Получить() Тогда
		
		ПечатьСтикераРостов(Принтер,Сборка, ГрузовоеМесто, СразуНаПринтер);
		Возврат; 
		
	КонецЕсли;
	
	ДокументШтрихКода = ГрузовоеМесто;
	
	ТабличныйДокумент	= Новый ТабличныйДокумент;
	Макет               = ПолучитьМакет("ШтрихКодыГУИД");
	ОбластьЭтикетка 	= Макет.ПолучитьОбласть("ЭтикеткаШирина|ЭтикеткаВысота");
	
	Если ЗначениеЗаполнено(Сборка.Назначение) Тогда
		
		ОбластьЭтикетка.Параметры.Контрагент = "ТРАНЗИТ_" + Строка(Сборка.Назначение.Грузополучатель);
		ОбластьЭтикетка.Параметры.Маршрут = СокрЛП(Сборка.Назначение.Маршрут) + " (" + ВРег(Лев(Сборка.Назначение.БазаОтправитель, 3)) + ")";  
		ОбластьЭтикетка.Параметры.КодКлиента = Сборка.Назначение.ГрузополучательКод; 
		ОбластьЭтикетка.Параметры.М = ?(ЗначениеЗаполнено(Сборка.Назначение.ДатаОтгрузкиЗаказа), СокрЛП(Сборка.Назначение.ДатаОтгрузкиЗаказа), СокрЛП(Сборка.ДатаДоставкиКлиенту));

	Иначе
		
		ОбластьЭтикетка.Параметры.Контрагент = Строка(Сборка.Грузополучатель);
		ОбластьЭтикетка.Параметры.Маршрут = ?(Сборка.ТаксиДоставка, "ТАКСИ",СокрЛП(Сборка.Грузополучатель.МаршрутДоставки));
		ОбластьЭтикетка.Параметры.КодКлиента = СокрЛП(Строка(Сборка.Грузополучатель.Код));
		ОбластьЭтикетка.Параметры.М = СокрЛП(Сборка.ДатаДоставкиКлиенту); 
		
	КонецЕсли;     
	
	ШтрихкодированиеПечатныхФорм.ВывестиШтрихкодВТабличныйДокумент(ТабличныйДокумент,Макет,ОбластьЭтикетка,ДокументШтрихКода);  	 
	
	ОбластьЭтикетка.Параметры.Сборка = "Сборка №" + Сборка.Номер + " от " + Формат(Сборка.Дата, "ДЛФ=D");
	
	ОбластьЭтикетка.Параметры.Мест = "ГМ" + ОбщегоНазначения.ПолучитьНомерНаПечать(ГрузовоеМесто,,,Истина);
	ОбластьЭтикетка.Параметры.Ответственный = Лев(СокрЛП(Сборка.Комплектовщик.Наименование),25);
	ТабличныйДокумент.Вывести(ОбластьЭтикетка);
	ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц(); 		
	
	ТабличныйДокумент.ПолеСверху = 0.1;
	ТабличныйДокумент.ПолеСлева = 1;
	ТабличныйДокумент.ПолеСнизу = 0.1;
	ТабличныйДокумент.ПолеСправа = 1;
	
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ИмяПринтера = Принтер;
	
	Если СразуНаПринтер Тогда
		ТабличныйДокумент.Напечатать(); 
	Иначе
		ТабличныйДокумент.Показать();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПечатьСтикераРостов(Принтер,Сборка, ГрузовоеМесто, СразуНаПринтер = Истина) ЭКСПОРТ

	ТабличныйДокумент	= Новый ТабличныйДокумент;
	Макет               = ПолучитьМакет("ШтрихКодыРостов");
	ОбластьЭтикетка 	= Макет.ПолучитьОбласть("ЭтикеткаШирина|ЭтикеткаВысота");

	Если ЗначениеЗаполнено(Сборка.Назначение) Тогда

		ПромИмяСклада = ВРег(Лев(Константы.ИмяИБВКластере.Получить(),3));
		ОбластьЭтикетка.Параметры.Контрагент = ПромИмяСклада+"_ТРАНЗИТ_" + Строка(Сборка.Назначение.Грузополучатель);
		ОбластьЭтикетка.Параметры.Маршрут = СокрЛП(Сборка.Назначение.Маршрут) + " (" + ВРег(Лев(Сборка.Назначение.БазаОтправитель, 3)) + ")";  
		
	Иначе
		ОбластьЭтикетка.Параметры.Контрагент = Строка(Сборка.Грузополучатель);
		ОбластьЭтикетка.Параметры.Маршрут = ?(Сборка.ТаксиДоставка, "ТАКСИ",СокрЛП(Сборка.Грузополучатель.МаршрутДоставки));
	КонецЕсли; 

	ОбластьЭтикетка.Параметры.Дата = ТекущаяДата();
	
	ШтрихкодированиеПечатныхФорм.ВывестиШтрихкодВТабличныйДокумент(ТабличныйДокумент,Макет,ОбластьЭтикетка,ГрузовоеМесто); 
	
	ОбластьЭтикетка.Параметры.Сборка = ОбщегоНазначения.ПолучитьНомерНаПечать(ГрузовоеМесто,,,Истина);//Строка(Число(Сборка.Номер));// + " от " + Формат(Дата, "ДЛФ=D");
	ОбластьЭтикетка.Параметры.Ответственный = ?(НЕ ЗначениеЗаполнено(Сборка.Комплектовщик), ПараметрыСеанса.ТекущийПользователь.ФизЛицо, Сборка.Ответственный) ;
	
	ТабличныйДокумент.Вывести(ОбластьЭтикетка);
	ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	ТабличныйДокумент.ПолеСверху = 0.1;
	ТабличныйДокумент.ПолеСлева = 1;
	ТабличныйДокумент.ПолеСнизу = 0.1;
	ТабличныйДокумент.ПолеСправа = 1;
	ТабличныйДокумент.ВысотаСтраницы = 58;
	ТабличныйДокумент.ШиринаСтраницы = 28;
	
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ИмяПринтера = Принтер;
	
	Если СразуНаПринтер Тогда
		ТабличныйДокумент.Напечатать();
	Иначе
		ТабличныйДокумент.Показать();
	КонецЕсли;

КонецПроцедуры

Функция СоздатьСборкиПоЗаказуПокупателя(ДокЗаказ, ТекстОшибки, Отказ) Экспорт
	
	тзДляСборки = Новый ТаблицаЗначений;
	тзДляСборки.Колонки.Добавить("Отметка");   
	тзДляСборки.Колонки.Добавить("ЗаказНаСборку");
	тзДляСборки.Колонки.Добавить("ДоговорКонтрагента");
	тзДляСборки.Колонки.Добавить("Грузополучатель");
	тзДляСборки.Колонки.Добавить("Контрагент");
	тзДляСборки.Колонки.Добавить("СпособДоставки");
	тзДляСборки.Колонки.Добавить("Принудительно");
	
	ДобСтрока = тзДляСборки.Добавить();
	ДобСтрока.Отметка = Истина;
	ДобСтрока.ЗаказНаСборку = ДокЗаказ.Ссылка;   
	ДобСтрока.Контрагент = ДокЗаказ.Контрагент;
	ДобСтрока.ДоговорКонтрагента = ДокЗаказ.ДоговорКонтрагента;
	ДобСтрока.Грузополучатель = ДокЗаказ.Грузополучатель;  
	ДобСтрока.Принудительно = Ложь;
	ДобСтрока.СпособДоставки = ДокЗаказ.СпособДоставки;  
	
	МассивСборок = Новый Массив;
	
	Попытка
		
		ОбработкаСборки = Обработки.СоздатьДокументыПриказНаСборку.Создать();  
		ОбработкаСборки.СоздатьДокументы(тзДляСборки, Ложь, 0, Ложь, Ложь, МассивСборок);  

	Исключение
		
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Отказ = Истина;  
		
	КонецПопытки;
	
	Возврат МассивСборок;

КонецФункции

Процедура ЗаполнитьСборкуПоЗаказуПокупателя(ДокЗаказ, ДанныеСборки, ТекстОшибки, Отказ) Экспорт
	
	ДокСборка = Документы.СборкаЗаказовПокупателя.СоздатьДокумент();
	ДокСборка.Дата 				  = ДанныеСборки.Дата;
	ДокСборка.Контрагент 		  = ДокЗаказ.Контрагент;
	ДокСборка.Грузополучатель 	  = ДокЗаказ.Грузополучатель;
	ДокСборка.МаршрутДоставки 	  = ДанныеСборки.МаршрутДоставки;
	ДокСборка.Договор 			  = ДокЗаказ.ДоговорКонтрагента;
	ДокСборка.СпособДоставки 	  = ДокЗаказ.СпособДоставки;
	ДокСборка.ВремяНачалаСборки   = ДанныеСборки.ВремяНачалаСборки;
	ДокСборка.ВремяОкончанияСборки= ДанныеСборки.ВремяОкончанияСборки;
	ДокСборка.ДатаДоставкиКлиенту = ДанныеСборки.ДатаДоставкиКлиенту;
	ДокСборка.Организация 		  = ДокЗаказ.Организация;
	
	Для каждого тзСтрока Из ДанныеСборки.ТоварыЗаказа Цикл
	
		НоваяСтрокаСборки = ДокСборка.Заказано.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаСборки, тзСтрока);
		НоваяСтрокаСборки.Подборка = Перечисления.ПодборкаНоменклатуры.Собрано;
		НоваяСтрокаСборки.Заказ = ДокЗаказ;

	КонецЦикла;

	ДокСборка.КоличествоУпаковочныхМест = ДанныеСборки.КоличествоУпаковочныхМест;
	ДокСборка.ДокументСобранИУпакован = ДанныеСборки.ДокументСобранИУпакован;
	
	Попытка
		ДокСборка.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Отказ = Истина;  
		Возврат;
		
	КонецПопытки;   
	
	Попытка
		ДокСборка.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Отказ = Истина; 
		
	КонецПопытки;   

КонецПроцедуры


