	Пакет = Запрос.ВыполнитьПакет();
	
	ТоварыПоНедопоставке = Пакет[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ТоварыПоНедопоставке.Следующий() Цикл
		
		НовыйДок = Документы.ПеремещениеТоваров.СоздатьДокумент();
		НовыйДок.СкладОтправитель = ТоварыПоНедопоставке.Размещение;
		НовыйДок.Дата = ТекущаяДата();
		НовыйДок.УстановитьВремя(РежимАвтоВремя.ТекущееИлиПоследним);
		НовыйДок.ОтражатьВУправленческомУчете = Истина;
		НовыйДок.СкладПолучатель = СкладНедопоставка;
		НовыйДок.Организация = ОрганизацияДляПеремещения;
		НовыйДок.Ответственный = Ссылка.Ответственный;
		НовыйДок.Комментарий = "Заполнен автоматически при проведении документа " + Ссылка;
		НовыйДок.КорректировкаЗаказаПокупателя = Ссылка;
		
		Выборка = ТоварыПоНедопоставке.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			НоваяСтрока = НовыйДок.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,Выборка);
			
		КонецЦикла;

		НовыйДок.ЗаполнитьПоСериям();
		
		НовыйДок.ПолучитьФорму("ФормаДокумента").Открыть();
		
	КонецЦикла;
	
	ТоварыПоНедосдачеПересорту = Пакет[4].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ТоварыПоНедосдачеПересорту.Следующий() Цикл
		
		НовыйДок = Документы.ПеремещениеТоваров.СоздатьДокумент();
		НовыйДок.СкладОтправитель = ТоварыПоНедосдачеПересорту.Размещение;
		НовыйДок.Дата = ТекущаяДата();
		НовыйДок.УстановитьВремя(РежимАвтоВремя.ТекущееИлиПоследним);
		НовыйДок.ОтражатьВУправленческомУчете = Истина;
		НовыйДок.СкладПолучатель = СкладНедостачаПересорт;
		НовыйДок.Организация = ОрганизацияДляПеремещения;
		НовыйДок.Ответственный = Ссылка.Ответственный;
		НовыйДок.Комментарий = "Заполнен автоматически при проведении документа " + Ссылка;
		НовыйДок.КорректировкаЗаказаПокупателя = Ссылка;
		
		Выборка = ТоварыПоНедосдачеПересорту.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			НоваяСтрока = НовыйДок.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,Выборка);
			
		КонецЦикла;
		
		НовыйДок.ЗаполнитьПоСериям();
		
		Если ВыполнятьВФоне Тогда
			
			Попытка
				
				НовыйДок.Дата = Ссылка.Дата + 1;
				НовыйДок.Записать();
				НовыйДок.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создано " + Строка(НовыйДок.Ссылка) + " к документу " + Строка(Ссылка));
				
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка при проведении Перемещения товаров к документу " + Строка(Ссылка) 
				                + ". Проверьте и проведите вручную документ " + Строка(НовыйДок.Ссылка));
			КонецПопытки;
			
		Иначе
			НовыйДок.ПолучитьФорму("ФормаДокумента").Открыть();
		КонецЕсли;

	КонецЦикла;
	
КонецПроцедуры 


Функция ПровестиИСоздатьПеремещения() Экспорт

	Если НачалоДня(Дата) = НачалоДня(ТекущаяДата()) Тогда 
		УстановитьВремя(РежимАвтоВремя.ТекущееИлиПоследним);
	КонецЕсли;

	Записать(РежимЗаписиДокумента.Проведение);
	СоздатьПеремещения();
	Возврат Истина;

КонецФункции 

