// ОБРАБОТЧИКИ СОБЫТИЙ

// Процедура - обработчик события "ОбработкаЗаполнения".
//
Процедура ОбработкаЗаполнения(Основание)
	
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		
		// Заполним реквизиты из стандартного набора по документу основанию.
		ЗаполнениеДокументов.ЗаполнитьШапкуДокументаПоОснованию(ЭтотОбъект, Основание);
		
		ЗаказПокупателя = Основание;
		
		СтруктурнаяЕдиница      = Основание.СтруктурнаяЕдиница;
		КурсВзаиморасчетов      = Основание.КурсВзаиморасчетов;
		КратностьВзаиморасчетов = Основание.КратностьВзаиморасчетов;
		
		Если Основание.Проведен Тогда
			
			// Заполним табличные части неотгруженными товарами по заказу покупателя. 
			#Если Клиент Тогда
				Если Основание.ОбособленнаяОтгрузкаГМИзСтороннегоФилиала Тогда    
					
					//+Шульман А. 10.10.2025 #UT10-5452
					//Если ЕстьЗаказПоставщикуПоОбособленнойОтгрузке(Основание) Тогда  
					Если Документы.КорректировкаЗаказаПокупателя.ЕстьЗаказПоставщикуПоОбособленнойОтгрузке(Основание) Тогда  
					//-Шульман А. 10.10.2025 #UT10-5452
						ОтобратьТоварыИСоздатьЗапросыНаИзменениеКоличества(Основание);						
					Иначе
						ЗаполнитьТоварыПоОстаткам();		
					КонецЕсли;
				Иначе
					ЗаполнитьТоварыПоОстаткам();
				КонецЕсли;				
			#Иначе
				ЗаполнитьТоварыПоОстаткам();				
			#КонецЕсли

			ЗаполнитьТаруПоОстаткам();
			ЗаполнитьУслугиПоОстаткам();
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Основание) = Тип("Структура") Тогда
		
		Если Основание.ТипЗаполнения = "ПоКорректировкеСборки" Тогда 
			
			ДокументОснование = Основание.ДокументОснование;
			КорректировкаСборки = Основание.КорректировкаСборки;
			
			ЗаполнениеДокументов.ЗаполнитьШапкуДокументаПоОснованию(ЭтотОбъект, ДокументОснование);
			
			ЭтотОбъект.СозданАвтоматически = Истина;
			
			ЗаказПокупателя = ДокументОснование;
			
			СтруктурнаяЕдиница      = ДокументОснование.СтруктурнаяЕдиница;
			КурсВзаиморасчетов      = ДокументОснование.КурсВзаиморасчетов;
			КратностьВзаиморасчетов = ДокументОснование.КратностьВзаиморасчетов;
			Ответственный 			= ПараметрыСеанса.ТекущийПользователь;
			
			ЗаполнитьТоварыПоОстаткамСУчетомКорректировки(КорректировкаСборки);
			ЗаполнитьТаруПоОстаткам();
			ЗаполнитьУслугиПоОстаткам();
			
		ИначеЕсли Основание.ТипЗаполнения = "ПоВозвратуОтПокупателя" Тогда 
			
			ДокументОснование = Основание.ДокументОснование;
			ВозвратТоваровОтПокупателя = Основание.ВозвратТоваровОтПокупателя;
			
			ЗаполнениеДокументов.ЗаполнитьШапкуДокументаПоОснованию(ЭтотОбъект, ДокументОснование);
			
			ЭтотОбъект.СозданАвтоматически = Истина;
			
			ЗаказПокупателя = ДокументОснование;
			
			СтруктурнаяЕдиница      = ДокументОснование.СтруктурнаяЕдиница;
			КурсВзаиморасчетов      = ДокументОснование.КурсВзаиморасчетов;
			КратностьВзаиморасчетов = ДокументОснование.КратностьВзаиморасчетов;
			Ответственный 			= ПараметрыСеанса.ТекущийПользователь;
			
			ЗаполнитьТоварыПоОстаткамСУчетомВозвратаОтПокупателя(ВозвратТоваровОтПокупателя);
			ЗаполнитьТаруПоОстаткам();
			ЗаполнитьУслугиПоОстаткам();
			
		ИначеЕсли Основание.ТипЗаполнения = "ПоКорректировкеЗаказаПоставщику" Тогда 
			
			ДокументОснование = Основание.ДокументОснование;
			ДокументЗаполнения = Основание.КорректировкаЗаказаПоставщику;
			
			ЗаполнениеДокументов.ЗаполнитьШапкуДокументаПоОснованию(ЭтотОбъект, ДокументОснование);
			
			ЭтотОбъект.СозданАвтоматически = Истина;
			
			ЗаказПокупателя = ДокументОснование;
			
			СтруктурнаяЕдиница      = ДокументОснование.СтруктурнаяЕдиница;
			КурсВзаиморасчетов      = ДокументОснование.КурсВзаиморасчетов;
			КратностьВзаиморасчетов = ДокументОснование.КратностьВзаиморасчетов;
			Ответственный 			= ПараметрыСеанса.ТекущийПользователь;
			
			ЗаполнитьТоварыПоОстаткамСУчетомКорректировкиЗаказаПоставщика(ДокументЗаполнения);
			ЗаполнитьТаруПоОстаткам();
			ЗаполнитьУслугиПоОстаткам();
			
		ИначеЕсли Основание.ТипЗаполнения = "ПоНесозданнымЗаказам" Тогда 
			
			ДокументОснование = Основание.ДокументОснование;
			ЗаполнениеДокументов.ЗаполнитьШапкуДокументаПоОснованию(ЭтотОбъект, ДокументОснование);
			ЭтотОбъект.СозданАвтоматически = Истина;
			ЗаказПокупателя = ДокументОснование;
			
			СтруктурнаяЕдиница      = ДокументОснование.СтруктурнаяЕдиница;
			КурсВзаиморасчетов      = ДокументОснование.КурсВзаиморасчетов;
			КратностьВзаиморасчетов = ДокументОснование.КратностьВзаиморасчетов;
			Ответственный 			= ПараметрыСеанса.ТекущийПользователь;
			
			ЗаполнитьТоварыПоНесозданнымЗаказам(Основание.ТЗКорректировкаЗП);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // ОбработкаЗаполнения()

// Процедура вызывается перед записью документа 
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка  Тогда
		Возврат;
	КонецЕсли;
	
	мУдалятьДвижения = НЕ ЭтоНовый();
	
	Если ЭтоНовый() И Ответственный.Пустая() Тогда 
		Ответственный = ПараметрыСеанса.ТекущийПользователь;
	КонецЕсли;
	
	ДатаНачалаПроверкиКратностиНоменклатуры = Константы.ДатаНачалаПроверкиКратностиНоменклатуры.Получить();
	
	ЭтоСтороннийСклад = ЗначениеЗаполнено(ЭтотОбъект.ЗаказПокупателя.IDСклада_СтороннийСклад); 
	
	Если РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения Тогда 
		
		Если Не ДополнительныеСвойства.Свойство("НеПроверятьНоменклатуруНаКратность") Тогда
			
			//   проверка на кратность должна учитывать возможность разбивки на несколько строк из-за серий!!
			Если РежимЗаписи = РежимЗаписиДокумента.Проведение И 
				ЗначениеЗаполнено(ДатаНачалаПроверкиКратностиНоменклатуры)
				И НачалоДня(ДатаНачалаПроверкиКратностиНоменклатуры) <= НачалоДня(Дата) Тогда 
				
				//   Документ может быть новым, поэтому проверку делаю через табл. значений!
				ТЗ = Товары.ВыгрузитьКолонки("Номенклатура,Количество");
				
				Для Каждого ТекСтр из Товары Цикл 
					
					НС = ТЗ.Добавить();
					НС.Номенклатура = ТекСтр.Номенклатура;
					НС.Количество   = ТекСтр.Количество;
					
				КонецЦикла;
				
				ТЗ.Свернуть("Номенклатура", "Количество");
				
				Если МСК.НеобходимоПроверятьКратностьВЗаказе(ЗаказПокупателя) Тогда
					
					Для каждого ТекСтр Из ТЗ Цикл			
						
						Если НЕ МСК.ПроверкаНоменклатурыНаКратность(ТекСтр.Номенклатура,ТекСтр.Количество) Тогда
							
							Отказ = Истина;
							
							#Если Клиент Тогда
								Сообщить("У номенклатуры : " + ТекСтр.Номенклатура + " нарушена КРАТНОСТЬ!!");
							#КонецЕсли
							
						КонецЕсли;	
						
					КонецЦикла; 
					
				КонецЕсли;
				
			КонецЕсли; 
			
		КонецЕсли;
		
		ЕстьПричинаОтказКлиента = Ложь;
		
		Для Каждого ТекСтрока Из Товары Цикл 
			
			Если ТекСтрока.Причина = Перечисления.ПричиныКорректировкиСборки.ОтказКлиента Тогда 
				ЕстьПричинаОтказКлиента = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
		Если ЕстьПричинаОтказКлиента Тогда 
			
			//+Белов А. 10.03.2026 #UT10-5729
			Если Не ДополнительныеСвойства.Свойство("НеПроверятьНаСтороннийСклад") Тогда
			//-Белов А. 10.03.2026 #UT10-5729
				
				ЭтоСтороннийСклад = ЗначениеЗаполнено(ЗаказПокупателя.IDСклада_СтороннийСклад);
				
				Если ЭтоСтороннийСклад Тогда 
					
					ТекстОтвета = МСК.ПроверкаНаСтороннийСклад(ЭтотОбъект);
					
					Если ТекстОтвета <> "" Тогда 
						
						#Если Клиент Тогда
							Сообщить(ТекстОтвета,СтатусСообщения.ОченьВажное);
						#КонецЕсли
						Отказ = Истина;
						Возврат;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Контрагент = ЗаказПокупателя.Контрагент;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Организация	= ЗаказПокупателя.Организация;
	КонецЕсли;
	
	// Если договор с комиссионером, то надо почистить закладку "Услуги".
	Если Услуги.Количество() > 0
		И ЗаказПокупателя.ДоговорКонтрагента.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СКомиссионером Тогда
		
		Услуги.Очистить();
		
	КонецЕсли;
	
	// Проверка заполнения единицы измерения мест и количества мест
	ОбработкаТабличныхЧастей.ПриЗаписиПроверитьЕдиницуИзмеренияМест(Товары);
	
	ОбработкаТабличныхЧастей.ПриЗаписиПроверитьСтавкуНДС(ЭтотОбъект, Товары);
	ОбработкаТабличныхЧастей.ПриЗаписиПроверитьСтавкуНДС(ЭтотОбъект, Услуги);
	
	// Посчитать суммы документа и записать ее в соответствующий реквизит шапки для показа в журналах
	СуммаДокумента = УчетНДС.ПолучитьСуммуДокументаСНДС(ЭтотОбъект);
	
	// Посчитать итоговую сумму плановой себестоимости документа и записать ее в соответствующий реквизит шапки
	ИтогПлановаяСебестоимость = Ценообразование.ИтогПлановаяСебестоимость(ЭтотОбъект);
	
КонецПроцедуры // ПередЗаписью()

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// Дерево значений, содержащее имена необходимых полей в запросе по шапке.
	Перем ДеревоПолейЗапросаПоШапке;
	
	
	Если мУдалятьДвижения Тогда
		ОбщегоНазначения.УдалитьДвиженияРегистратора(ЭтотОбъект, Отказ);
	КонецЕсли;
	
	// Сформируем структуру реквизитов шапки документа
	СтруктураШапкиДокумента = ОбщегоНазначения.СформироватьСтруктуруШапкиДокумента(ЗаказПокупателя);
	
	// Заполним по шапке документа дерево параметров, нужных при проведении.
	ДеревоПолейЗапросаПоШапке      = ОбщегоНазначения.СформироватьДеревоПолейЗапросаПоШапке();
	ОбщегоНазначения.ДобавитьСтрокуВДеревоПолейЗапросаПоШапке(ДеревоПолейЗапросаПоШапке, "Константы"             , "ВалютаУправленческогоУчета", "ВалютаУправленческогоУчета");
	ОбщегоНазначения.ДобавитьСтрокуВДеревоПолейЗапросаПоШапке(ДеревоПолейЗапросаПоШапке, "Константы"             , "КурсВалютыУправленческогоУчета"    , "КурсВалютыУправленческогоУчета");
	ОбщегоНазначения.ДобавитьСтрокуВДеревоПолейЗапросаПоШапке(ДеревоПолейЗапросаПоШапке, "ДоговорыКонтрагентов", "ВедениеВзаиморасчетов"             , "ВедениеВзаиморасчетов");
	ОбщегоНазначения.ДобавитьСтрокуВДеревоПолейЗапросаПоШапке(ДеревоПолейЗапросаПоШапке, "ДоговорыКонтрагентов", "ВалютаВзаиморасчетов"              , "ВалютаВзаиморасчетов");
	ОбщегоНазначения.ДобавитьСтрокуВДеревоПолейЗапросаПоШапке(ДеревоПолейЗапросаПоШапке, "ДоговорыКонтрагентов", "Организация"                       , "ДоговорОрганизация");
	ОбщегоНазначения.ДобавитьСтрокуВДеревоПолейЗапросаПоШапке(ДеревоПолейЗапросаПоШапке, "УчетнаяПолитика"       , "ВестиПартионныйУчетПоСкладам"      , "ВестиПартионныйУчетПоСкладам");
	ОбщегоНазначения.ДобавитьСтрокуВДеревоПолейЗапросаПоШапке(ДеревоПолейЗапросаПоШапке, "ДоговорыКонтрагентов", "ОбособленныйУчетТоваровПоЗаказамПокупателей", "ОбособленныйУчетТоваровПоЗаказамПокупателей");
	
	Если ЗначениеЗаполнено(ЗаказПокупателя.СкладГруппа) 
		И ТипЗнч(ЗаказПокупателя.СкладГруппа) = Тип("СправочникСсылка.Склады") Тогда
		ОбщегоНазначения.ДобавитьСтрокуВДеревоПолейЗапросаПоШапке(ДеревоПолейЗапросаПоШапке, "СкладГруппа", "ВидСклада", "ВидСклада");
	Иначе
		ОбщегоНазначения.ДобавитьСтрокуВДеревоПолейЗапросаПоШапке(ДеревоПолейЗапросаПоШапке, "NULL", "NULL", "ВидСклада");
	КонецЕсли;
	
	// Сформируем запрос на дополнительные параметры, нужные при проведении, по данным шапки документа
	СтруктураШапкиДокумента = УправлениеЗапасами.СформироватьЗапросПоДеревуПолей(ЗаказПокупателя, ДеревоПолейЗапросаПоШапке, СтруктураШапкиДокумента, мВалютаРегламентированногоУчета);
	
	// Заголовок для сообщений об ошибках проведения.
	Заголовок = ОбщегоНазначения.ПредставлениеДокументаПриПроведении(СтруктураШапкиДокумента);
	
	// Проверим правильность заполнения шапки документа
	ПроверитьЗаполнениеШапки(СтруктураШапкиДокумента, Отказ, Заголовок);
	
	// Проверим допустимость для пользователя цен документа
	УправлениеДопПравамиПользователей.ПроверитьДопустимостьЦенОтпуска(ЭтотОбъект, "Товары", Отказ);
	
	// Получим необходимые данные для проведения и проверки заполнения данных по табличной части "Товары".
	СтруктураПолей = Новый Структура();
	СтруктураПолей.Вставить("Номенклатура"              , "Номенклатура");
	СтруктураПолей.Вставить("Услуга"                    , "Номенклатура.Услуга");
	СтруктураПолей.Вставить("Набор"                     , "Номенклатура.Набор");
	СтруктураПолей.Вставить("Комплект"                  , "Номенклатура.Комплект");
	СтруктураПолей.Вставить("Количество"                , "Количество * Коэффициент /Номенклатура.ЕдиницаХраненияОстатков.Коэффициент");
	СтруктураПолей.Вставить("Цена"                      , "Цена");
	СтруктураПолей.Вставить("ЕдиницаИзмерения"          , "ЕдиницаИзмерения");
	СтруктураПолей.Вставить("ПроцентСкидкиНаценки"      , "ПроцентСкидкиНаценки");
	СтруктураПолей.Вставить("ПроцентАвтоматическихСкидок", "ПроцентАвтоматическихСкидок");
	СтруктураПолей.Вставить("УсловиеАвтоматическойСкидки", "УсловиеАвтоматическойСкидки");
	СтруктураПолей.Вставить("ЗначениеУсловияАвтоматическойСкидки", "ЗначениеУсловияАвтоматическойСкидки");
	СтруктураПолей.Вставить("Сумма"                     , "Сумма");
	СтруктураПолей.Вставить("СтавкаНДС"                 , "СтавкаНДС");
	СтруктураПолей.Вставить("НДС"                       , "СуммаНДС");
	СтруктураПолей.Вставить("ХарактеристикаНоменклатуры", "ХарактеристикаНоменклатуры");
	СтруктураПолей.Вставить("Размещение"                , "Размещение");
	СтруктураПолей.Вставить("СерияНоменклатуры"         , "СерияНоменклатуры");
	СтруктураПолей.Вставить("ВидСкладаРазмещения"       , "Размещение.ВидСклада");
	СтруктураПолей.Вставить("Причина"       			, "Причина");
	СтруктураПолей.Вставить("ТолькоРезерв"				, "ТолькоРезерв");
	СтруктураПолей.Вставить("Назначение"				, "Назначение");

	
	РезультатЗапросаПоТоварам = ОбщегоНазначения.СформироватьЗапросПоТабличнойЧасти(ЭтотОбъект, "Товары", СтруктураПолей);
	
	// Подготовим таблицу товаров для проведения.
	ТаблицаПоТоварам = ПодготовитьТаблицуТоваров(РезультатЗапросаПоТоварам, СтруктураШапкиДокумента);
	
	// Проверим допустимость для пользователя цен документа
	УправлениеДопПравамиПользователей.ПроверитьДопустимостьЦенОтпуска(ЭтотОбъект, "Услуги", Отказ);
	
	// Получим необходимые данные для проведения и проверки заполнения данных по табличной части "Услуги".
	СтруктураПолей = Новый Структура();
	СтруктураПолей.Вставить("Номенклатура"              , "Номенклатура");
	СтруктураПолей.Вставить("Услуга"                    , "Номенклатура.Услуга");
	СтруктураПолей.Вставить("Набор"                     , "Номенклатура.Набор");
	СтруктураПолей.Вставить("Комплект"                  , "Номенклатура.Комплект");
	СтруктураПолей.Вставить("Количество"                , "Количество");
	СтруктураПолей.Вставить("Цена"                      , "Цена");
	СтруктураПолей.Вставить("ПроцентСкидкиНаценки"      , "ПроцентСкидкиНаценки");
	СтруктураПолей.Вставить("ПроцентАвтоматическихСкидок", "ПроцентАвтоматическихСкидок");
	СтруктураПолей.Вставить("УсловиеАвтоматическойСкидки", "УсловиеАвтоматическойСкидки");
	СтруктураПолей.Вставить("ЗначениеУсловияАвтоматическойСкидки", "ЗначениеУсловияАвтоматическойСкидки");
	СтруктураПолей.Вставить("Сумма"                     , "Сумма");
	СтруктураПолей.Вставить("СтавкаНДС"                 , "СтавкаНДС");
	СтруктураПолей.Вставить("НДС"                       , "СуммаНДС");
	
	РезультатЗапросаПоУслугам = ОбщегоНазначения.СформироватьЗапросПоТабличнойЧасти(ЭтотОбъект, "Услуги", СтруктураПолей);
	
	// Подготовим таблицу товаров для проведения.
	ТаблицаПоУслугам = ПодготовитьТаблицуУслуг(РезультатЗапросаПоУслугам, СтруктураШапкиДокумента);
	
	// Получим необходимые данные для проведения и проверки заполнения данных 
	// по табличной части "Возвратная тара".
	СтруктураПолей = Новый Структура();
	СтруктураПолей.Вставить("Номенклатура"              , "Номенклатура");
	СтруктураПолей.Вставить("Услуга"                    , "Номенклатура.Услуга");
	СтруктураПолей.Вставить("Набор"                     , "Номенклатура.Набор");
	СтруктураПолей.Вставить("Комплект"                  , "Номенклатура.Комплект");
	СтруктураПолей.Вставить("Количество"                , "Количество");
	СтруктураПолей.Вставить("Цена"                      , "Цена");
	СтруктураПолей.Вставить("Сумма"                     , "Сумма");
	СтруктураПолей.Вставить("ВестиУчетПоХарактеристикам", "Номенклатура.ВестиУчетПоХарактеристикам");
	СтруктураПолей.Вставить("Размещение"                , "Размещение");
	СтруктураПолей.Вставить("ЕдиницаИзмерения"          , "Номенклатура.ЕдиницаХраненияОстатков");
	СтруктураПолей.Вставить("ВидСкладаРазмещения"       , "Размещение.ВидСклада");
	
	РезультатЗапросаПоТаре = ОбщегоНазначения.СформироватьЗапросПоТабличнойЧасти(ЭтотОбъект, "ВозвратнаяТара", СтруктураПолей);
	
	// Подготовим таблицу тары для проведения.
	ТаблицаПоТаре = ПодготовитьТаблицуТары(РезультатЗапросаПоТаре, СтруктураШапкиДокумента);
	
	// Проверить заполнение ТЧ "Товары" и "Возвратная тара".
	ПроверитьЗаполнениеТабличнойЧастиТовары(ТаблицаПоТоварам, СтруктураШапкиДокумента, Отказ, Заголовок);
	ПроверитьЗаполнениеТабличнойЧастиУслуги(ТаблицаПоУслугам, СтруктураШапкиДокумента, Отказ, Заголовок);
	ПроверитьЗаполнениеТабличнойЧастиВозвратнаяТара(ТаблицаПоТаре, СтруктураШапкиДокумента, Отказ, Заголовок);
	
	// Движения по документу
	Если Не Отказ Тогда
		
		ДвиженияПоРегистрам(РежимПроведения, СтруктураШапкиДокумента, ТаблицаПоТоварам, ТаблицаПоУслугам, 
		ТаблицаПоТаре, Отказ, Заголовок);
		
	КонецЕсли;
	
	
	Если Не Отказ Тогда
		
		Если Дата < Константы.ДатаНачалаИспользованияДокументаКорректировкаСборки.Получить() Тогда  
			//Теперь движения по этим регистрам делаются документом КорректировкаСборкиЗаказовПокупателя.
			
			Движения.ТоварыГотовыеКСборке.Записывать = Истина;
			Движения.ТоварыВЯчейках.Записывать = Истина;
			Движения.НоменклатураГотоваяЕхатьККлиенту.Записывать = Истина;
			Движения.СобраноПоЗаказу.Записывать = Истина;
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	КорректировкаЗаказаПокупателяТовары.Номенклатура,
			|	СУММА(КорректировкаЗаказаПокупателяТовары.Количество) КАК Количество,
			|	СУММА(ВЫБОР
			|			КОГДА КорректировкаЗаказаПокупателяТовары.Ссылка.СуммаВключаетНДС
			|				ТОГДА КорректировкаЗаказаПокупателяТовары.Сумма * -1
			|			ИНАЧЕ (КорректировкаЗаказаПокупателяТовары.Сумма + КорректировкаЗаказаПокупателяТовары.СуммаНДС) * -1
			|		КОНЕЦ) КАК Сумма,
			|	МАКСИМУМ(КорректировкаЗаказаПокупателяТовары.Ссылка.Контрагент) КАК Контрагент,
			|	МАКСИМУМ(КорректировкаЗаказаПокупателяТовары.Ссылка.Организация) КАК Организация
			|ПОМЕСТИТЬ ЗаказыПокупателей
			|ИЗ
			|	Документ.КорректировкаЗаказаПокупателя.Товары КАК КорректировкаЗаказаПокупателяТовары
			|ГДЕ
			|	КорректировкаЗаказаПокупателяТовары.Ссылка = &Ссылка
			|	И КорректировкаЗаказаПокупателяТовары.Количество < 0
			|
			|СГРУППИРОВАТЬ ПО
			|	КорректировкаЗаказаПокупателяТовары.Номенклатура
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ТоварыГотовыеКСборкеОстатки.Номенклатура,
			|	ТоварыГотовыеКСборкеОстатки.ЗаказПокупателя,
			|	ТоварыГотовыеКСборкеОстатки.КоличествоОстаток
			|ПОМЕСТИТЬ ГотовыКСборке
			|ИЗ
			|	РегистрНакопления.ТоварыГотовыеКСборке.Остатки(
			|			&Д,
			|			ЗаказПокупателя = &ЗаказПокупателя
			|				И Номенклатура В
			|					(ВЫБРАТЬ
			|						ЗаказыПокупателей.Номенклатура
			|					ИЗ
			|						ЗаказыПокупателей КАК ЗаказыПокупателей)) КАК ТоварыГотовыеКСборкеОстатки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	СобраноПоЗаказуОбороты.Номенклатура,
			|	ВЫРАЗИТЬ(СобраноПоЗаказуОбороты.Регистратор КАК Документ.СборкаЗаказовПокупателя) КАК ДокСборкаЗаказов,
			|	СобраноПоЗаказуОбороты.КоличествоОборот
			|ПОМЕСТИТЬ СобраноНоменклатуры
			|ИЗ
			|	РегистрНакопления.СобраноПоЗаказу.Обороты(
			|			,
			|			,
			|			Регистратор,
			|			Заказ = &ЗаказПокупателя
			|				И Номенклатура В
			|					(ВЫБРАТЬ
			|						ЗаказыПокупателей.Номенклатура
			|					ИЗ
			|						ЗаказыПокупателей КАК ЗаказыПокупателей)) КАК СобраноПоЗаказуОбороты
			|ГДЕ
			|	СобраноПоЗаказуОбороты.Регистратор ССЫЛКА Документ.СборкаЗаказовПокупателя
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ЗаказыПокупателей.Номенклатура,
			|	ЗаказыПокупателей.Количество КАК КоличествоКорректировка,
			|	ЕСТЬNULL(ГотовыКСборке.КоличествоОстаток, 0) КАК КоличествоГотовоКСборке
			|ИЗ
			|	ЗаказыПокупателей КАК ЗаказыПокупателей
			|		ЛЕВОЕ СОЕДИНЕНИЕ ГотовыКСборке КАК ГотовыКСборке
			|		ПО ЗаказыПокупателей.Номенклатура = ГотовыКСборке.Номенклатура
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ТоварыВЯчейкахОбороты.Номенклатура КАК Номенклатура,
			|	ТоварыВЯчейкахОбороты.Ячейка КАК Ячейка,
			|	ТоварыВЯчейкахОбороты.Склад КАК Склад,
			|	ТоварыВЯчейкахОбороты.КоличествоРасход КАК КоличествоСписаноСЯчейки,
			|	ЕСТЬNULL(ЗаказыПокупателей.Количество * -1, 0) КАК КоличествоОткорректировано
			|ИЗ
			|	ЗаказыПокупателей КАК ЗаказыПокупателей
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках.Обороты(
			|				,
			|				,
			|				Регистратор,
			|				Номенклатура В
			|					(ВЫБРАТЬ
			|						СобраноНоменклатуры.Номенклатура
			|					ИЗ
			|						СобраноНоменклатуры КАК СобраноНоменклатуры)) КАК ТоварыВЯчейкахОбороты
			|		ПО ЗаказыПокупателей.Номенклатура = ТоварыВЯчейкахОбороты.Номенклатура
			|ГДЕ
			|	ТоварыВЯчейкахОбороты.Регистратор В
			|			(ВЫБРАТЬ
			|				СобраноНоменклатуры.ДокСборкаЗаказов
			|			ИЗ
			|				СобраноНоменклатуры КАК СобраноНоменклатуры)
			|ИТОГИ
			|	СУММА(КоличествоСписаноСЯчейки)
			|ПО
			|	КоличествоОткорректировано,
			|	Номенклатура,
			|	Склад,
			|	Ячейка
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	НоменклатураГотоваяЕхатьККлиентуОстатки.ДокументСборкиНоменклатуры,
			|	ЕСТЬNULL(НоменклатураГотоваяЕхатьККлиентуОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток
			|ИЗ
			|	РегистрНакопления.НоменклатураГотоваяЕхатьККлиенту.Остатки(
			|			&Д,
			|			Организация = &Организация
			|				И ДокументСборкиНоменклатуры В
			|					(ВЫБРАТЬ
			|						СобраноНоменклатуры.ДокСборкаЗаказов
			|					ИЗ
			|						СобраноНоменклатуры КАК СобраноНоменклатуры)) КАК НоменклатураГотоваяЕхатьККлиентуОстатки";
			
			Запрос.УстановитьПараметр("Д", МоментВремени());
			Запрос.УстановитьПараметр("Ссылка", Ссылка);
			Запрос.УстановитьПараметр("ЗаказПокупателя", ЗаказПокупателя);
			Запрос.УстановитьПараметр("Контрагент", Контрагент);
			Запрос.УстановитьПараметр("Организация", Организация);
			
			Пакетник =  Запрос.ВыполнитьПакет();
			
			Движения.ТоварыГотовыеКСборке.Записывать = Истина;
			
			Если Движения.ТоварыВРезервеНаСкладах.Количество() > 0 Тогда
				
				Для каждого ТекСтр Из Движения.ТоварыВРезервеНаСкладах Цикл 		
					
					Движение = Движения.ТоварыГотовыеКСборке.Добавить();
					Движение.Период = Дата;
					Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
					Движение.Номенклатура =ТекСтр.Номенклатура;
					Движение.ЗаказПокупателя = Ссылка.ЗаказПокупателя; 
					Движение.Количество = ТекСтр.Количество;    
					Движение.Назначение = ТекСтр.Назначение;
					
				КонецЦикла; 	
				
			КонецЕсли; 		
			
			ВыборкаКоличествоОткорректировано = Пакетник[5].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаКоличествоОткорректировано.Следующий() Цикл
				
				ВсегоОткорректировано = ВыборкаКоличествоОткорректировано.КоличествоОткорректировано;
				
				ВыборкаНоменклатура = ВыборкаКоличествоОткорректировано.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				
				Пока ВыборкаНоменклатура.Следующий() Цикл
					
					ВыборкаСклад = ВыборкаНоменклатура.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					
					Пока ВыборкаСклад.Следующий() Цикл
						
						ВыборкаЯчейка = ВыборкаСклад.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
						
						Пока ВыборкаЯчейка.Следующий() Цикл
							
							Если ВсегоОткорректировано = 0 Тогда 
								Прервать;
							КонецЕсли;
							
							Движение = Движения.ТоварыВЯчейках.Добавить();
							Движение.Период = Дата;
							Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
							Движение.Склад  = ВыборкаСклад.Склад;
							Движение.Номенклатура = ВыборкаНоменклатура.Номенклатура;
							Движение.Ячейка = ВыборкаЯчейка.Ячейка;
							Движение.Количество = Мин(ВыборкаЯчейка.КоличествоСписаноСЯчейки, ВсегоОткорректировано);
							ВсегоОткорректировано =  ВсегоОткорректировано - Движение.Количество;
							
						КонецЦикла;
						
					КонецЦикла;
					
				КонецЦикла;
				
			КонецЦикла;
			
			//  По регистру "НоменклатураГотоваяЕхатьККлиенту"
			
			Выборка = Пакетник[6].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока Выборка.Следующий() Цикл
				
				Движение = Движения.НоменклатураГотоваяЕхатьККлиенту.Добавить();
				Движение.Период = Дата;
				Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
				Движение.ДокументСборкиНоменклатуры  = Выборка.ДокументСборкиНоменклатуры;
				Движение.Организация = Организация;
				Движение.Количество =  Выборка.КоличествоОстаток;
				
			КонецЦикла;
			
		Иначе
			
			ДатаОстатков = ОбщегоНазначения.ПолучитьДатуОстатков(ЭтотОбъект); 
			
			Если Не ЗначениеЗаполнено(ДатаОстатков) И ТекущаяДата() = ЗаказПокупателя.Дата Тогда
				ДатаОстатков = ЗаказПокупателя.Дата + 1;	
			КонецЕсли;  
			
			СтатусПартии = Перечисления.СтатусыПартийТоваров.Купленный;
			
			ТабОстатки = УправлениеЗаказами.ОстаткиТоваровПоЗаказуПокупателяСтабличнойЧастью(ЗаказПокупателя, ЗаказПокупателя.ДоговорКонтрагента, ДатаОстатков, СтатусПартии);
			
			ТабОстатки.Свернуть("Номенклатура", "КолОстаток, КолКСписанию");
			
			ТабОстатки.Колонки.Добавить("КоличествоПоДокументу", ОбщегоНазначения.ПолучитьОписаниеТиповЧисла(15, 3));
			
			СтруктураПоиска  = Новый Структура;
			
			Для Каждого ТекСтрока Из Товары Цикл
				
				Если ТекСтрока.Количество > 0 Тогда
					Продолжить;
				КонецЕсли;
				
				КолвоККорректировке = ?(ТекСтрока.Количество < 0, -ТекСтрока.Количество, 0);
				
				СтруктураПоиска.Вставить("Номенклатура", ТекСтрока.Номенклатура);
				
				НайденныеСтроки = ТабОстатки.НайтиСтроки(СтруктураПоиска);
				
				Если НайденныеСтроки.Количество() <> 0 Тогда 
					
					Для каждого Стр ИЗ НайденныеСтроки Цикл
						
						Стр.КоличествоПоДокументу = Стр.КоличествоПоДокументу + КолвоККорректировке;
						Стр.КолКСписанию = Стр.КолКСписанию - КолвоККорректировке;
						
					КонецЦикла;
					
				Иначе
					
					Отказ = Истина;
					Сообщить("Невозможно откорректировать " + ТекСтрока.Номенклатура + " в количестве " + (-ТекСтрока.Количество) + ". Доступно 0 шт.!");
					
				КонецЕсли;
				
			КонецЦикла;
			
			ТабОстатки.Сортировать("КолКСписанию");
			
			Для каждого ТекСтр Из ТабОстатки Цикл 	
				
				Если ТекСтр.КолКСписанию < 0 Тогда 
					
					Сообщить("Невозможно откорректировать " + ТекСтр.Номенклатура + " в количестве: " + ТекСтр.КоличествоПоДокументу + " доступно только " + ТекСтр.КолОстаток + " !");
					Отказ = Истина;
					
				КонецЕсли;	
				
			КонецЦикла; 	
			
			
			Если Не Отказ Тогда 
				
				Если Движения.ТоварыВРезервеНаСкладах.Количество() > 0 Тогда

					Запрос = Новый Запрос;
					Запрос.Текст = 
					"ВЫБРАТЬ
					|	ТоварыГотовыеКСборкеОстатки.Номенклатура,
					|	ТоварыГотовыеКСборкеОстатки.ЗаказПокупателя,
					|	ТоварыГотовыеКСборкеОстатки.Назначение,
					|	СУММА(ТоварыГотовыеКСборкеОстатки.КоличествоОстаток) КАК Количество
					|ИЗ
					|	РегистрНакопления.ТоварыГотовыеКСборке.Остатки(
					|			&Д,
					|			ЗаказПокупателя = &ЗаказПокупателя
					|				И Номенклатура В (&МассивНоменклатуры)) КАК ТоварыГотовыеКСборкеОстатки
					|
					|СГРУППИРОВАТЬ ПО
					|	ТоварыГотовыеКСборкеОстатки.Номенклатура,
					|	ТоварыГотовыеКСборкеОстатки.ЗаказПокупателя,
					|	ТоварыГотовыеКСборкеОстатки.Назначение";
					
					Запрос.УстановитьПараметр("Д", МоментВремени());
					Запрос.УстановитьПараметр("ЗаказПокупателя", ЗаказПокупателя);
					Запрос.УстановитьПараметр("МассивНоменклатуры", Движения.ТоварыВРезервеНаСкладах.Выгрузить().ВыгрузитьКолонку("Номенклатура")); 
					
					ТаблицаГотовыеКСборке = Запрос.Выполнить().Выгрузить(); 
					
					Для каждого ТекСтр Из Движения.ТоварыВРезервеНаСкладах Цикл 
						
						СтруктураПоиска = Новый Структура("Номенклатура, ЗаказПокупателя, Назначение", ТекСтр.Номенклатура, ЗаказПокупателя, ТекСтр.Назначение);
						МассивНайденных = ТаблицаГотовыеКСборке.НайтиСтроки(СтруктураПоиска);
						
						Если МассивНайденных.Количество() = 0 Тогда
							Продолжить;
						КонецЕсли;
						
						Если МассивНайденных[0].Количество <= 0 Тогда
							Продолжить;
						КонецЕсли;                   
						
						КоличествоЗаписать = Мин(МассивНайденных[0].Количество, -ТекСтр.Количество); 
						
						Движение = Движения.ТоварыГотовыеКСборке.Добавить();
						Движение.Период = Дата;
						Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
						Движение.Номенклатура =ТекСтр.Номенклатура;
						Движение.ЗаказПокупателя = ЗаказПокупателя;
						Движение.Количество = -КоличествоЗаписать;   
						Движение.Назначение = ТекСтр.Назначение; 
						
						МассивНайденных[0].Количество = МассивНайденных[0].Количество - КоличествоЗаписать;
						
					КонецЦикла; 	
					
				КонецЕсли;
				
			КонецЕсли;
			
			Если НЕ Отказ И КорректировкаГМИзСтороннегоФилиала Тогда
				
				ЗапросТоваровПоГМ = Новый Запрос;
				ЗапросТоваровПоГМ.УстановитьПараметр("Ссылка", Ссылка);
				
				ЗапросТоваровПоГМ.Текст =
				"ВЫБРАТЬ
				|	КорректировкаЗаказаПокупателяТовары.Ссылка,
				|	КорректировкаЗаказаПокупателяТовары.Ссылка.ЗаказПокупателя,
				|	КорректировкаЗаказаПокупателяТовары.Номенклатура,
				|	КорректировкаЗаказаПокупателяТовары.Количество * -1 КАК Количество
				|ПОМЕСТИТЬ ТоварыКорректировки
				|ИЗ
				|	Документ.КорректировкаЗаказаПокупателя.Товары КАК КорректировкаЗаказаПокупателяТовары
				|ГДЕ
				|	КорректировкаЗаказаПокупателяТовары.Ссылка = &Ссылка
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ПоступлениеТоваровУслугТовары.Ссылка,
				|	ПоступлениеТоваровУслугТовары.Заказ,
				|	ПоступлениеТоваровУслугТовары.Номенклатура,
				|	ПоступлениеТоваровУслугТовары.Количество,
				|	ПоступлениеТоваровУслугТовары.ГМ
				|ПОМЕСТИТЬ ТоварысГМ
				|ИЗ
				|	Документ.ПоступлениеТоваровУслуг.Товары КАК ПоступлениеТоваровУслугТовары
				|ГДЕ
				|	(ПоступлениеТоваровУслугТовары.Заказ, ПоступлениеТоваровУслугТовары.Номенклатура) В
				|			(ВЫБРАТЬ
				|				ТоварыКорректировки.ЗаказПокупателя КАК Заказ,
				|				ТоварыКорректировки.Номенклатура КАК Номенклатура
				|			ИЗ
				|				ТоварыКорректировки КАК ТоварыКорректировки)
				|	И ПоступлениеТоваровУслугТовары.Ссылка.Проведен
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ТоварыКорректировки.Ссылка,
				|	ТоварыКорректировки.ЗаказПокупателя,
				|	ТоварыКорректировки.Номенклатура,
				|	СУММА(ТоварыКорректировки.Количество) КАК Количество
				|ИЗ
				|	ТоварыКорректировки КАК ТоварыКорректировки
				|
				|СГРУППИРОВАТЬ ПО
				|	ТоварыКорректировки.Ссылка,
				|	ТоварыКорректировки.ЗаказПокупателя,
				|	ТоварыКорректировки.Номенклатура
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ТоварыВЯчейкахОстаткиИОбороты.Регистратор,
				|	ТоварыВЯчейкахОстаткиИОбороты.Склад,
				|	ТоварыВЯчейкахОстаткиИОбороты.Номенклатура,
				|	ТоварыВЯчейкахОстаткиИОбороты.Ячейка,
				|	ТоварыВЯчейкахОстаткиИОбороты.ГМ,
				|	СУММА(ТоварыВЯчейкахОстаткиИОбороты.КоличествоКонечныйОстаток) КАК Количество
				|ИЗ
				|	РегистрНакопления.ТоварыВЯчейках.ОстаткиИОбороты(
				|			,
				|			,
				|			Регистратор,
				|			,
				|			(Номенклатура, ГМ) В
				|				(ВЫБРАТЬ
				|					ТоварыСГМ.Номенклатура КАК Номенклатура,
				|					ТоварыСГМ.ГМ КАК ГМ
				|				ИЗ
				|					ТоварыСГМ КАК ТоварыСГМ)) КАК ТоварыВЯчейкахОстаткиИОбороты
				|ГДЕ
				|	ТоварыВЯчейкахОстаткиИОбороты.Регистратор.ДокументОснование В
				|			(ВЫБРАТЬ
				|				ТоварыСГМ.Ссылка
				|			ИЗ
				|				ТоварыСГМ КАК ТоварыСГМ)
				|	И ТоварыВЯчейкахОстаткиИОбороты.КоличествоКонечныйОстаток > 0
				|
				|СГРУППИРОВАТЬ ПО
				|	ТоварыВЯчейкахОстаткиИОбороты.Регистратор,
				|	ТоварыВЯчейкахОстаткиИОбороты.Склад,
				|	ТоварыВЯчейкахОстаткиИОбороты.Номенклатура,
				|	ТоварыВЯчейкахОстаткиИОбороты.Ячейка,
				|	ТоварыВЯчейкахОстаткиИОбороты.ГМ"; 
				
				Результат = ЗапросТоваровПоГМ.ВыполнитьПакет();
				
				ВыборкаТовары = Результат[2].Выбрать();
				ТаблицаТоварыВЯчейках = Результат[3].Выгрузить();
				
				Пока ВыборкаТовары.Следующий() Цикл  
					
					КоличествоОсталосьПогасить = ВыборкаТовары.Количество; 
					
					Если КоличествоОсталосьПогасить <= 0 Тогда
						Продолжить;
					КонецЕсли;
					
					СтруктураПоиска = Новый Структура("Номенклатура", ВыборкаТовары.Номенклатура);
					
					МассивНайденных = ТаблицаТоварыВЯчейках.НайтиСтроки(СтруктураПоиска);
					
					Для Каждого НайденнаяСтрока Из МассивНайденных Цикл    
						
						Если КоличествоОсталосьПогасить <= 0 Тогда
							Прервать;
						КонецЕсли;
						
						Если НайденнаяСтрока.Количество <= 0 Тогда
							Продолжить;
						КонецЕсли;
						
						КоличествоКЗаполнению = Мин(НайденнаяСтрока.Количество, КоличествоОсталосьПогасить); 
						
						Движение = Движения.ТоварыВЯчейках.Добавить();
						Движение.Период = Дата;
						Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
						Движение.Склад = НайденнаяСтрока.Склад;
						Движение.Номенклатура = НайденнаяСтрока.Номенклатура;
						Движение.Ячейка = НайденнаяСтрока.Ячейка;
						Движение.Количество = НайденнаяСтрока.Количество;
						Движение.ГМ = НайденнаяСтрока.ГМ;
						
						Движение = Движения.ТоварыВЯчейках.Добавить();
						Движение.Период = Дата;
						Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
						Движение.Склад = НайденнаяСтрока.Склад;
						Движение.Номенклатура = НайденнаяСтрока.Номенклатура;
						Движение.Ячейка = НайденнаяСтрока.Ячейка;
						Движение.Количество = НайденнаяСтрока.Количество;
						
						КоличествоОсталосьПогасить = КоличествоОсталосьПогасить - КоличествоКЗаполнению;
						НайденнаяСтрока.Количество = НайденнаяСтрока.Количество - КоличествоКЗаполнению;						
						
					КонецЦикла;
					
				КонецЦикла;

			КонецЕсли;

		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ Отказ И НЕ Константы.НеОтправлятьПочту.Получить() И ЗаказПокупателя.Грузополучатель.ОтправлятьИнформациюОбОтказах Тогда 
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	РассылкаДокументов.Контрагент,
		|	РассылкаДокументов.ТипРассылки,
		|	РассылкаДокументов.Документ,
		|	РассылкаДокументов.ВремяОтправки КАК ВремяОтправки,
		|	РассылкаДокументов.Комментарий
		|ИЗ
		|	РегистрСведений.РассылкаДокументов КАК РассылкаДокументов
		|ГДЕ
		|	РассылкаДокументов.ТипРассылки = ЗНАЧЕНИЕ(Перечисление.ТипыРассылокЭлектроннойПочты.ПроведениеКорректировкиЗаказа)
		|	И (ВЫРАЗИТЬ(РассылкаДокументов.Документ КАК Документ.КорректировкаЗаказаПокупателя)) = &ТекДокумент
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	NULL,
		|	ДокументыКОтправке.ТипСообщения,
		|	ДокументыКОтправке.ДокументКОтправке,
		|	NULL,
		|	NULL
		|ИЗ
		|	РегистрСведений.ДокументыКОтправке КАК ДокументыКОтправке
		|ГДЕ
		|	ДокументыКОтправке.ТипСообщения = ЗНАЧЕНИЕ(Перечисление.ТипыРассылокЭлектроннойПочты.ПроведениеКорректировкиЗаказа)
		|	И (ВЫРАЗИТЬ(ДокументыКОтправке.ДокументКОтправке КАК Документ.КорректировкаЗаказаПокупателя)) = &ТекДокумент
		|	И (ДокументыКОтправке.АктуальноДо >= &ТекДата
		|			ИЛИ ДокументыКОтправке.АктуальноДо = ДАТАВРЕМЯ(1, 1, 1))";
		
		Запрос.УстановитьПараметр("ТекДокумент", Ссылка);
		Запрос.УстановитьПараметр("ТекДата", ТекущаяДата());
		
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			// уже отправляли по этому документу или есть актуальное задание на отправку
		Иначе
			
			// создадим задание для отправки
			ЗаданиеДляОтправки 				= РегистрыСведений.ДокументыКОтправке.СоздатьМенеджерЗаписи();
			ЗаданиеДляОтправки.ДокументКОтправке 	= Ссылка;
			ЗаданиеДляОтправки.ТипСообщения = Перечисления.ТипыРассылокЭлектроннойПочты.ПроведениеКорректировкиЗаказа;
			ЗаданиеДляОтправки.АктуальноДо 	= ТекущаяДата() + 60*60*24;
			ЗаданиеДляОтправки.Записать();
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // ОбработкаПроведения()

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ОбщегоНазначения.УдалитьДвиженияРегистратора(ЭтотОбъект, Отказ);

	ЗапросПеремещенийНаОснование	 = Новый Запрос;
	ЗапросПеремещенийНаОснование.УстановитьПараметр("КорректировкаЗаказаПокупателя", Ссылка);
	ЗапросПеремещенийНаОснование.Текст =
	"ВЫБРАТЬ
	|	ПеремещениеТоваров.Ссылка
	|ИЗ
	|	Документ.ПеремещениеТоваров КАК ПеремещениеТоваров
	|ГДЕ
	|	ПеремещениеТоваров.КорректировкаЗаказаПокупателя = &КорректировкаЗаказаПокупателя
	|	И ПеремещениеТоваров.Проведен";
	
	РезультатзапросаПеремещений = ЗапросПеремещенийНаОснование.Выполнить();
	
	Если НЕ РезультатзапросаПеремещений.Пустой() Тогда
		
		ВыборкаПеремещений = РезультатзапросаПеремещений.Выбрать();
		
		Пока ВыборкаПеремещений.Следующий() Цикл
			
			ПеремещениеОбъект = ВыборкаПеремещений.Ссылка.ПолучитьОбъект();
			ПеремещениеОбъект.УстановитьПометкуУдаления(Истина); 	
			
			#Если Клиент Тогда
			Сообщить("Помечен на удаление документ : " + Строка(ПеремещениеОбъект.Ссылка));
			#КонецЕсли
			
		КонецЦикла;		
		
	КонецЕсли;

КонецПроцедуры // ОбработкаУдаленияПроведения

Процедура ОтобратьТоварыИСоздатьЗапросыНаИзменениеКоличества(ПромЗаказ)
	
	ФормаВыбораТоваровДляЗапросов = ЭтотОбъект.ПолучитьФорму("ФормаВыбораТоваровДляЗапросов", ЭтотОбъект);
	ФормаВыбораТоваровДляЗапросов.ЗаказПокупателя = ПромЗаказ.Ссылка; 
	ФормаВыбораТоваровДляЗапросов.ОткрытьМодально();

КонецПроцедуры

Процедура СоздатьПеремещения(ВыводитьСообщение = Ложь, ВыполнятьВФоне = Ложь) Экспорт 
	
	ТекущаяБаза = Константы.База.Получить();
	
	ОрганизацияДляПеремещения = Справочники.Организации.ПустаяСсылка();
	
	Если Константы.АвтоматическиПеремещатьНаОсновнуюОрганизациюПриКорректировкеСборки.Получить() Тогда	
		ОрганизацияДляПеремещения = Константы.ОсновнаяОрганизация.Получить();
	Иначе
		ОрганизацияДляПеремещения = Ссылка.Организация;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	СкладНедопоставка = Константы.СкладНедопоставка.Получить();
	СкладНедостачаПересорт = Константы.СкладНедостачаПересорт.Получить();
	
	Запрос.УстановитьПараметр("ТекущийДокумент", Ссылка);
	Запрос.УстановитьПараметр("СкладНедопоставка", СкладНедопоставка);
	Запрос.УстановитьПараметр("СкладНедостачаПересорт", СкладНедостачаПересорт);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПеремещениеТоваров.Ссылка,
	|	ПеремещениеТоваров.КорректировкаЗаказаПокупателя
	|ПОМЕСТИТЬ ПеремещениеПоСкладуНедопоставки
	|ИЗ
	|	Документ.ПеремещениеТоваров КАК ПеремещениеТоваров
	|ГДЕ
	|	ПеремещениеТоваров.Проведен
	|	И ПеремещениеТоваров.СкладПолучатель = &СкладНедопоставка
	|	И ПеремещениеТоваров.КорректировкаЗаказаПокупателя = &ТекущийДокумент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПеремещениеТоваров.Ссылка,
	|	ПеремещениеТоваров.КорректировкаЗаказаПокупателя
	|ПОМЕСТИТЬ ПеремещениеПоСкладуНедостачаПересорт
	|ИЗ
	|	Документ.ПеремещениеТоваров КАК ПеремещениеТоваров
	|ГДЕ
	|	ПеремещениеТоваров.Проведен
	|	И ПеремещениеТоваров.СкладПолучатель = &СкладНедостачаПересорт
	|	И ПеремещениеТоваров.КорректировкаЗаказаПокупателя = &ТекущийДокумент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КорректировкаЗаказаПокупателяТовары.Ссылка,
	|	КорректировкаЗаказаПокупателяТовары.Причина,
	|	КорректировкаЗаказаПокупателяТовары.Номенклатура,
	|	КорректировкаЗаказаПокупателяТовары.ХарактеристикаНоменклатуры,
	|	КорректировкаЗаказаПокупателяТовары.СерияНоменклатуры,
	|	СУММА(КорректировкаЗаказаПокупателяТовары.Количество) КАК Количество,
	|	КорректировкаЗаказаПокупателяТовары.Коэффициент,
	|	КорректировкаЗаказаПокупателяТовары.ЕдиницаИзмерения,
	|	КорректировкаЗаказаПокупателяТовары.Размещение,
	|	КорректировкаЗаказаПокупателяТовары.ЕдиницаИзмеренияМест,
	|	КорректировкаЗаказаПокупателяТовары.КоличествоМест
	|ПОМЕСТИТЬ ТоварыКПеремещению
	|ИЗ
	|	Документ.КорректировкаЗаказаПокупателя.Товары КАК КорректировкаЗаказаПокупателяТовары
	|ГДЕ
	|	(КорректировкаЗаказаПокупателяТовары.Причина = ЗНАЧЕНИЕ(Перечисление.ПричиныКорректировкиСборки.Недопоставка)
	|			ИЛИ КорректировкаЗаказаПокупателяТовары.Причина = ЗНАЧЕНИЕ(Перечисление.ПричиныКорректировкиСборки.Пересорт)
	|			ИЛИ КорректировкаЗаказаПокупателяТовары.Причина = ЗНАЧЕНИЕ(Перечисление.ПричиныКорректировкиСборки.Недостача))
	|	И КорректировкаЗаказаПокупателяТовары.Ссылка = &ТекущийДокумент
	|	И КорректировкаЗаказаПокупателяТовары.Ссылка.Проведен
	|	И КорректировкаЗаказаПокупателяТовары.Размещение ССЫЛКА Справочник.Склады
	|
	|СГРУППИРОВАТЬ ПО
	|	КорректировкаЗаказаПокупателяТовары.Ссылка,
	|	КорректировкаЗаказаПокупателяТовары.Номенклатура,
	|	КорректировкаЗаказаПокупателяТовары.ХарактеристикаНоменклатуры,
	|	КорректировкаЗаказаПокупателяТовары.СерияНоменклатуры,
	|	КорректировкаЗаказаПокупателяТовары.Причина,
	|	КорректировкаЗаказаПокупателяТовары.Коэффициент,
	|	КорректировкаЗаказаПокупателяТовары.ЕдиницаИзмерения,
	|	КорректировкаЗаказаПокупателяТовары.Размещение,
	|	КорректировкаЗаказаПокупателяТовары.ЕдиницаИзмеренияМест,
	|	КорректировкаЗаказаПокупателяТовары.КоличествоМест
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыКПеремещению.Ссылка,
	|	ТоварыКПеремещению.Причина,
	|	ТоварыКПеремещению.Номенклатура,
	|	ТоварыКПеремещению.ХарактеристикаНоменклатуры,
	|	ТоварыКПеремещению.СерияНоменклатуры,
