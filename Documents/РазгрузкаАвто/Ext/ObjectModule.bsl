	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТЗ.Контрагент КАК Контрагент,
	|	ЕСТЬNULL(КонтактнаяИнформация.Представление, """") КАК ЭлАдрес
	|ИЗ
	|	ТЗ КАК ТЗ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|		ПО (ТЗ.Грузополучатель = (ВЫРАЗИТЬ(КонтактнаяИнформация.Объект.Ссылка КАК Справочник.Контрагенты)))
	|ГДЕ
	|	КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
	|	И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыКонтрагентаДляОбменаДокументами)
	|	И (ВЫРАЗИТЬ(ЕСТЬNULL(КонтактнаяИнформация.Представление, """") КАК СТРОКА(200))) <> """"
	|	И НЕ ВЫРАЗИТЬ(КонтактнаяИнформация.Объект КАК Справочник.Контрагенты).НеПосылатьУведомлениеОДолгах
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаказыПокупателейОстатки.ЗаказПокупателя КАК Заказ,
	|	ЗаказыПокупателейОстатки.Номенклатура КАК Номенклатура,
	|	ЗаказыПокупателейОстатки.Цена КАК Цена,
	|	ЗаказыПокупателейОстатки.КоличествоОстаток КАК Остаток,
	|	0 КАК УжеУчли
	|ИЗ
	|	РегистрНакопления.ЗаказыПокупателей.Остатки(
	|			,
	|			ЗаказПокупателя В
	|					(ВЫБРАТЬ
	|						ТоварыВСборке.ЗаказПокупателя
	|					ИЗ
	|						ТоварыВСборке КАК ТоварыВСборке)
	|				И Номенклатура В
	|					(ВЫБРАТЬ
	|						ТоварыВСборке.Номенклатура
	|					ИЗ
	|						ТоварыВСборке КАК ТоварыВСборке)) КАК ЗаказыПокупателейОстатки" ;
	
	ЗапросПоСборке.УстановитьПараметр("Сборка", ДокСборка);

	Пакет = ЗапросПоСборке.ВыполнитьПакет();
	
	Результат = Пакет[6];
	ТабСборок = Пакет[3].Выгрузить();
	ТаблицаОстатков_ПоРегистру_ЗаказыПокупателей  =  Пакет[8].Выгрузить();

	Док = Неопределено;
	
	ВыборкаПоКонтрагентам  = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаПоКонтрагентам.Следующий() Цикл	
		
		ВыборкаПоДоговорам  = ВыборкаПоКонтрагентам.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаПоДоговорам.Следующий() Цикл
			
			ВыборкаПоГрузополучателям  = ВыборкаПоДоговорам.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаПоГрузополучателям.Следующий() Цикл
				
				СозданХотяБыОдинДокумент = Истина;

				Док = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
				Док.Дата = ДокСборка.Дата + 1;
				
				Док.ВидОперации = Перечисления.ВидыОперацийРеализацияТоваров.ПродажаКомиссия ;
				Док.Организация = ВыборкаПоДоговорам.Договор.Организация; 
				
				Если Док.Организация = Константы.ОсновнаяОрганизация.Получить() Тогда
					
					Док.ОтражатьВБухгалтерскомУчете = Истина;
					Док.ОтражатьВНалоговомУчете = Истина;
					
				КонецЕсли;				  
				
				Док.Контрагент 					= ВыборкаПоГрузополучателям.Контрагент;
				Док.ДоговорКонтрагента 			= ВыборкаПоГрузополучателям.Договор; 
				Док.БанковскийСчетОрганизации 	= Док.Организация.ОсновнойБанковскийСчет; 
				Док.Грузополучатель				= ВыборкаПоГрузополучателям.Грузополучатель;
				
				Док.ОтражатьВУправленческомУчете 	= Истина;
				Док.ВалютаДокумента 				= Рубль;
				Док.УчитыватьНДС 					= Истина;
				Док.СуммаВключаетНДС 				= Истина;
				Док.КурсВзаиморасчетов  			= 1;
				Док.КратностьВзаиморасчетов 		= 1;
				Док.ВидПередачи 					= Перечисления.ВидыПередачиТоваров.СоСклада;
				Док.Ответственный 					= ДокСборка.Ответственный;
				Док.Комментарий						= ПромКомментарий; 		

				// ТЧ Товары
				ВыборкаПоНоменклатуре = ВыборкаПоГрузополучателям.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				
				Пока ВыборкаПоНоменклатуре.Следующий() Цикл   
					
					// выборка по заказу нужна для того, чтобы отразить разные цены по одной и той же номенклатуре, которые могут быть в разных заказах
					ВыборкаПоЗаказу  = ВыборкаПоНоменклатуре.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					
					Пока ВыборкаПоЗаказу.Следующий() Цикл 
						
						Выборка = ВыборкаПоЗаказу.Выбрать();
						
						УстановитьКоличество = Истина;
						
						Пока Выборка.Следующий() Цикл 
							
							Если УстановитьКоличество Тогда 
								
								ВсегоКоличество = Выборка.КоличествоСобрано;
								УстановитьКоличество = Ложь;
								Док.Склад 	= Выборка.Заказ.СкладГруппа;
								Док.Водитель 	= Выборка.Водитель;
								
							КонецЕсли;
							
							Если ВсегоКоличество <= 0 Тогда 
								Прервать;
							КонецЕсли;	  
							
							//    Может быть, что номенклатура в "Заказе покупателя" была по разным ценам. Поэтом проверим
							//  1. Надо ли разбивать  текущие данные из запроса на несколько строк
							//  2. Если надо - то по каким ценам
							СтруктураСДанными = ВернутьСтруктуруДляРазбивкиНаНесколькоСтрок(
							
							Выборка.Номенклатура,Выборка.Заказ,Мин(Выборка.КоличествоВРезерве,ВсегоКоличество));
							
							Если СтруктураСДанными.КоличествоСтрок = Неопределено Тогда 
								
								//  Как и ранее
								НоваяСтрока =  Док.Товары.Добавить();
								НоваяСтрока.Номенклатура 			= Выборка.Номенклатура;
								НоваяСтрока.СерияНоменклатуры 	    = Выборка.СерияНоменклатуры;
								НоваяСтрока.ЕдиницаИзмерения 		= Выборка.ЕдиницаХраненияОстатков;
								НоваяСтрока.Коэффициент 			= Выборка.Коэффициент;
								НоваяСтрока.Количество 			    = Мин(Выборка.КоличествоВРезерве,ВсегоКоличество);
								ВсегоКоличество 					= ВсегоКоличество-НоваяСтрока.Количество;
								
								НоваяСтрока.ЗаказПокупателя 		= Выборка.Заказ;
								НоваяСтрока.Цена 					= Выборка.Цена;
								//+Гавриленков В. 23.12.2025 #
								//НоваяСтрока.СтавкаНДС 			    = Выборка.СтавкаНДС;
								НоваяСтрока.СтавкаНДС 				= УчетНДС.ПолучитьСтавкуНДСПоНоменклатуре(Выборка.Номенклатура, Док.Дата);
								//-Гавриленков В. 23.12.2025 #
								НоваяСтрока.Сумма 				    = НоваяСтрока.Количество * Выборка.Цена;
								НоваяСтрока.СуммаНДС 				= УчетНДС.РассчитатьСуммуНДС(НоваяСтрока.Сумма, Истина, Истина, УчетНДС.ПолучитьСтавкуНДС(НоваяСтрока.СтавкаНДС));
								НоваяСтрока.СпособСписанияОстаткаТоваров = Перечисления.СпособыСписанияОстаткаТоваров.ИзРезерва;
								НоваяСтрока.Комментарий 			= Выборка.Комментарий;
								
							Иначе 
								
								КоличествоНадоРаскидатьПоЦенам =    Мин(Выборка.КоличествоВРезерве,ВсегоКоличество);
								//   Это количество надо разбить на несколько строк
								ТаблицаСКоличествомИЦенами = СтруктураСДанными.ТЗ;
								
								Для каждого ТекСтр  Из ТаблицаСКоличествомИЦенами Цикл
									
									Если КоличествоНадоРаскидатьПоЦенам = 0 Тогда 
										Прервать;
									КонецЕсли;
									
									ТекущеееКоличество =  ТекСтр.Количество;
									ТекущаяЦена =   ТекСтр.Цена;
									
									НоваяСтрока =  Док.Товары.Добавить();
									НоваяСтрока.Номенклатура 			= Выборка.Номенклатура;
									НоваяСтрока.СерияНоменклатуры 	    = Выборка.СерияНоменклатуры;
									НоваяСтрока.ЕдиницаИзмерения 		= Выборка.ЕдиницаХраненияОстатков;
									НоваяСтрока.Коэффициент 			= Выборка.Коэффициент;
									НоваяСтрока.Количество 			    = ТекущеееКоличество;
									ВсегоКоличество 					= ВсегоКоличество - НоваяСтрока.Количество;
									КоличествоНадоРаскидатьПоЦенам      =  КоличествоНадоРаскидатьПоЦенам - НоваяСтрока.Количество;
									
									НоваяСтрока.ЗаказПокупателя 		= Выборка.Заказ;
									НоваяСтрока.Цена 					= ТекущаяЦена;
									//+Гавриленков В. 23.12.2025 #
									//НоваяСтрока.СтавкаНДС 			    = Выборка.СтавкаНДС;
									НоваяСтрока.СтавкаНДС 				= УчетНДС.ПолучитьСтавкуНДСПоНоменклатуре(Выборка.Номенклатура, Док.Дата);
									//-Гавриленков В. 23.12.2025 #
									НоваяСтрока.Сумма 				    = НоваяСтрока.Количество * ТекущаяЦена;
									НоваяСтрока.СуммаНДС 				= УчетНДС.РассчитатьСуммуНДС(НоваяСтрока.Сумма, Истина, Истина, УчетНДС.ПолучитьСтавкуНДС(НоваяСтрока.СтавкаНДС));
									НоваяСтрока.СпособСписанияОстаткаТоваров = Перечисления.СпособыСписанияОстаткаТоваров.ИзРезерва;
									НоваяСтрока.Комментарий 			= Выборка.Комментарий;
									
								КонецЦикла; 
								
							КонецЕсли;
							
						КонецЦикла;
						
					КонецЦикла;
					
				КонецЦикла;
				
				// Заполнение ТЧ Сборки
				Отбор = Новый Структура();
				Отбор.Вставить("Грузополучатель", ВыборкаПоГрузополучателям.Грузополучатель);
				Отбор.Вставить("Договор", ВыборкаПоДоговорам.Договор);
				СтрокиСборок = ТабСборок.НайтиСтроки(Отбор);
				
				Если СтрокиСборок.Количество() <> 0 Тогда 
					
					Для Каждого ТекСборка ИЗ СтрокиСборок Цикл  
						
						НоваяСтрокаСборки =  Док.ДокументыСборкиЗаказов.Добавить();
						НоваяСтрокаСборки.ДокументСборки = ТекСборка.ДокументСборки;
						
					КонецЦикла; 
					
				КонецЕсли;
				
				Если Док.Товары.Количество()  > 0 Тогда
					
					Док.Записать();
					мСтруктураПараметровВзаиморасчетов = Новый Структура;
					мСтруктураПараметровВзаиморасчетов.Вставить("СтруктураТабличныхЧастей", Новый Структура("Товары, Услуги"));
					мСтруктураПараметровВзаиморасчетов.Вставить("Направление", "Реализация");
					мСтруктураПараметровВзаиморасчетов.Вставить("ЕстьЗаказыВТабличныхЧастях", Истина);
					мСтруктураПараметровВзаиморасчетов.Вставить("ИмяЗаказаВТабличныхЧастях", "ЗаказПокупателя"); 					
					
					УправлениеВзаиморасчетами.ДополнитьСтруктуруПараметровДляЗаполненияТаблицыДокументовРасчетов(Док, мСтруктураПараметровВзаиморасчетов);
					УправлениеВзаиморасчетами.ЗаполнитьТаблицуДокументовРасчетовСКонтрагентом(Док, мСтруктураПараметровВзаиморасчетов);
					
					Док.ЗаполнитьЯчейки();
					
					Попытка
						Док.Записать(РежимЗаписиДокумента.Проведение);
					Исключение
						Отказ = Истина;
					КонецПопытки;

				КонецЕсли; 	
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;  
КонецПроцедуры

Функция ВернутьСтруктуруДляРазбивкиНаНесколькоСтрок(Номенклатура,Заказ,КоличествоИзРеализации)
	
	//   Цель функции : вернуть структуру из двух значений.
	//   Первое значение ("КоличествоСтрок") - кол. строк на которые надо разбить текщую строку из запроса
	//   Второе значение ("ТЗ") - таблица значений из двух колонок
	//   Колонка 1 - содержит количество номенклатуры с ценой
	//   Колонка 2-  содержит  саму цену
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Количество");
	ТЗ.Колонки.Добавить("Цена");
	
	СтруктураВозврата = Новый Структура();
	МакимумРазныхЦен = КоличествоИзРеализации;

	Для каждого ТекСтр Из ТаблицаОстатков_ПоРегистру_ЗаказыПокупателей Цикл
		
		Если МакимумРазныхЦен = 0 Тогда 
			Прервать;
		КонецЕсли;
		
		Если ТекСтр.Заказ <> Заказ ИЛИ ТекСтр.Номенклатура <> Номенклатура Тогда 
			Продолжить;
		КонецЕсли;

		Если ТекСтр.УжеУчли >= ТекСтр.Остаток Тогда 
			Продолжить;
		КонецЕсли;
		
		НС = ТЗ.Добавить();
		НС.Количество = МИН(ТекСтр.Остаток - ТекСтр.УжеУчли, МакимумРазныхЦен);
		НС.Цена = ТекСтр.Цена;
		//
		ТекСтр.УжеУчли = ТекСтр.УжеУчли +НС.Количество;
		МакимумРазныхЦен = МакимумРазныхЦен - НС.Количество;

	КонецЦикла;  

	СтруктураВозврата.Вставить("КоличествоСтрок", ?(ТЗ.Количество() = 0, Неопределено, ТЗ.Количество()));
	СтруктураВозврата.Вставить("ТЗ", ТЗ);

	Возврат СтруктураВозврата;

КонецФункции

Процедура ОтправитьПисьмоОПереносеДоставки(ТаблицаДокументов , ДатаПереноса)

	АдресЭлПочты = МСК.ПолучитьЭлектронныйАдрес(Грузополучатель);
	
	Если ЗначениеЗаполнено(АдресЭлПочты) Тогда   
		
		ОтправлятьПочту = Истина;
		УчетнаяЗапись = Константы.ОсновнаяУчетнаяЗаписьЭлектроннойПочты.Получить();	
		
		Если Константы.НеОтправлятьПочту.Получить() ИЛИ НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
			ОтправлятьПочту = Ложь;
		КонецЕсли;
		
		Профиль = УправлениеЭлектроннойПочтой.ПолучитьИнтернетПочтовыйПрофиль(УчетнаяЗапись);	
		Почта = Новый ИнтернетПочта; 
		
		Попытка
			Почта.Подключиться(Профиль);
		Исключение
			ОтправлятьПочту = Ложь;  
		КонецПопытки;
		
		Если ОтправлятьПочту Тогда
			
			Для Каждого СтрокаТаблРТУ Из ТаблицаДокументов Цикл  
				
				ПромРТУ = СтрокаТаблРТУ.РТУ;   
				
				Сообщение = Новый ИнтернетПочтовоеСообщение;
				Сообщение.Тема = "Перенос доставки";
				
				МассивАдресов = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(АдресЭлПочты, ";");
				
				Для каждого ТекАдрес Из МассивАдресов Цикл
					Сообщение.Получатели.Добавить(ТекАдрес); 
				КонецЦикла;
				
				Сообщение.Отправитель = УчетнаяЗапись.АдресЭлектроннойПочты;
		
				ТекстТелаПисьма = "</table><p>Уважаемый(ая) " + СокрЛП(Контрагент.НаименованиеПолное) +" !</p>" + Символы.ПС + Символы.ПС; 
				
				СчетФактура = УчетНДС.НайтиПодчиненныйСчетФактуру(ПромРТУ);
				
				ТекстТелаПисьма = ТекстТелаПисьма  + "</table><p>Уведомляем Вас, что по документу <b> Реализация товаров и услуг № " + СокрЛП(ПромРТУ.Номер) 
				                + " от " + СокрЛ(ПромРТУ.Дата) + ?(ЗначениеЗаполнено(СчетФактура), "(Счёт-фактура выданный № " + СокрЛП(СчетФактура.Номер) 
								+ " от " + СокрЛП(СчетФактура.Дата) + ")", "") + "</b> экспедитором был осуществлён перенос доставки." 
								+ ?(ПромРТУ.ПометкаУдаления, " Указанная накладная аннулирована, товар поступит Вам с новым (переоформленным) документом  <b>" 
								+ Формат(ДатаПереноса, "ДЛФ=D"), "") + "</b><br>."; 

				ТелефонОрганизации = ПолучитьТелефонОрганизации(ПромРТУ.Организация);  
				
				Если ЗначениеЗаполнено(ТелефонОрганизации) Тогда
					ТекстТелаПисьма = ТекстТелаПисьма + "</table><p>При возникновении вопросов просим Вас обратиться по телефону " + ТелефонОрганизации + ".<br></p>";
				КонецЕсли;
				
				ТекстТелаПисьма = ТекстТелаПисьма + "</table><p>С Уважением , " + СокрЛП(ПромРТУ.Организация.Наименование) + ".<br> Склад - "  
				                + СокрЛП(Константы.База.Получить()) + "</p>"; 
				
				Сообщение.Тексты.Добавить(ТекстТелаПисьма,ТипТекстаПочтовогоСообщения.HTML);
				
				Попытка
					
					Почта.Послать(Сообщение);
					ТекстСообщения = "Отправлено письмо " + СокрЛП(Грузополучатель.Наименование) + " на адрес " + АдресЭлПочты + " с уведомлением о переносе доставки";
					ЗаписьЖурналаРегистрации("Отправка электронной почты.Успешно", УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);	
					
				Исключение
					
					ТекстСообщения = "НЕ отправлено письмо " + СокрЛП(Грузополучатель.Наименование) + " на адрес " + АдресЭлПочты + " с уведомлением о корректировке сборки";
					ЗаписьЖурналаРегистрации("Отправка электронной почты.Ошибка",УровеньЖурналаРегистрации.Информация,,, ТекстСообщения + Символы.ПС + ОписаниеОшибки());	

				КонецПопытки;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры 

Функция ПолучитьТелефонОрганизации(Организация) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтактнаяИнформация.Представление
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Объект = &Объект
	|	И КонтактнаяИнформация.Тип = &Тип
	|	И КонтактнаяИнформация.Вид = &Вид";
	
	Запрос.УстановитьПараметр("Объект", Организация);
	Запрос.УстановитьПараметр("Тип", Перечисления.ТипыКонтактнойИнформации.Телефон);
	Запрос.УстановитьПараметр("Вид", Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации);
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл		
		Возврат СокрЛП(Выборка.Представление);		
	КонецЦикла;      
	
	Возврат ""; 

КонецФункции