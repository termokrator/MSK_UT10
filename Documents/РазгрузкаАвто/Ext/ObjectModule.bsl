Перем ТаблицаОстатков_ПоРегистру_ЗаказыПокупателей;

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ЗначениеЗаполнено(Грузополучатель) И Не ЗначениеЗаполнено(МаршрутДоставки) Тогда
		МаршрутДоставки = Грузополучатель.МаршрутДоставки;
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ , РежимПроведения)

	ТаблицаГМ = Новый ТаблицаЗначений;
	ТаблицаГМ.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("Документссылка.ГрузовоеМесто")); 
	ТаблицаГМ.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(200, ДопустимаяДлина.Переменная))); 
	
	СписокГМСклад = ТаблицаГМ.Скопировать();
	СписокГМВодитель = ТаблицаГМ.Скопировать();
	
	Если НЕ ГМПоложилНаМаршрут.Пустая() Тогда

		ЗапросРТУ = Новый Запрос;
		ЗапросРТУ.Текст = 
		//+Кабанов А.В. 10.03.2025 # UT10-5127
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РазгрузкаАвтоГрузовыеМеста.РТУ,
		|	ВЫБОР
		|		КОГДА (РазгрузкаАвтоГрузовыеМеста.Ссылка.Грузополучатель.ПереносДоставкиБезУдаленияРТУ
		|				ИЛИ (РазгрузкаАвтоГрузовыеМеста.РТУ.ДоговорКонтрагента.ЛицевойСчет
		|					ИЛИ РазгрузкаАвтоГрузовыеМеста.РТУ.ДоговорКонтрагента.РозничнаяПродажа))
		|				И РазгрузкаАвтоГрузовыеМеста.ПереданоНаСклад
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ПоменятьСтатус
		|ПОМЕСТИТЬ ВТ_РТУ
		|ИЗ
		|	Документ.РазгрузкаАвто.ГрузовыеМеста КАК РазгрузкаАвтоГрузовыеМеста
		|ГДЕ
		|	РазгрузкаАвтоГрузовыеМеста.Ссылка = &Разгрузка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	РазгрузкаАвтоГрузовыеМеста.РТУ,
		|	ВЫБОР
		|		КОГДА (РазгрузкаАвтоГрузовыеМеста.Ссылка.Грузополучатель.ПереносДоставкиБезУдаленияРТУ
		|				ИЛИ (РазгрузкаАвтоГрузовыеМеста.РТУ.ДоговорКонтрагента.ЛицевойСчет
		|					ИЛИ РазгрузкаАвтоГрузовыеМеста.РТУ.ДоговорКонтрагента.РозничнаяПродажа))
		|				И РазгрузкаАвтоГрузовыеМеста.ПринятоСкладом
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ
		|ИЗ
		|	Документ.РазгрузкаАвто.ГрузовыеМеста КАК РазгрузкаАвтоГрузовыеМеста
		|ГДЕ
		|	РазгрузкаАвтоГрузовыеМеста.Ссылка = &Разгрузка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_РТУ.РТУ,
		|	МАКСИМУМ(НЕ ЕСТЬNULL(ВыкупСОтветственногоХраненияДокументыОснованияВыкупаТОХ.Ссылка, ЗНАЧЕНИЕ(Документ.ВыкупСОтветственногоХранения.ПустаяСсылка)) = ЗНАЧЕНИЕ(Документ.ВыкупСОтветственногоХранения.ПустаяСсылка)) КАК ЕстьВыкуп
		|ПОМЕСТИТЬ ВТ_Выкупы
		|ИЗ
		|	ВТ_РТУ КАК ВТ_РТУ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВыкупСОтветственногоХранения.ДокументыОснованияВыкупаТОХ КАК ВыкупСОтветственногоХраненияДокументыОснованияВыкупаТОХ
		|		ПО ВТ_РТУ.РТУ.Ссылка = ВыкупСОтветственногоХраненияДокументыОснованияВыкупаТОХ.ДокументОснование
		|			И (НЕ ВыкупСОтветственногоХраненияДокументыОснованияВыкупаТОХ.Ссылка.ПометкаУдаления)
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_РТУ.РТУ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_РТУ.РТУ,
		|	МИНИМУМ(ВЫБОР
		|			КОГДА ВТ_Выкупы.ЕстьВыкуп
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ВТ_РТУ.ПоменятьСтатус
		|		КОНЕЦ) КАК ПоменятьСтатус
		|ИЗ
		|	ВТ_РТУ КАК ВТ_РТУ
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Выкупы КАК ВТ_Выкупы
		|		ПО ВТ_РТУ.РТУ = ВТ_Выкупы.РТУ
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_РТУ.РТУ";

		//"ВЫБРАТЬ РАЗЛИЧНЫЕ
		//|	РазгрузкаАвтоГрузовыеМеста.РТУ,
		//|	ВЫБОР
		//|		КОГДА РазгрузкаАвтоГрузовыеМеста.Ссылка.Грузополучатель.ПереносДоставкиБезУдаленияРТУ
		//|				И РазгрузкаАвтоГрузовыеМеста.ПереданоНаСклад
		//|			ТОГДА ИСТИНА
		//|		ИНАЧЕ ЛОЖЬ
		//|	КОНЕЦ КАК ПоменятьСтатус
		//|ПОМЕСТИТЬ ВТ_РТУ
		//|ИЗ
		//|	Документ.РазгрузкаАвто.ГрузовыеМеста КАК РазгрузкаАвтоГрузовыеМеста
		//|ГДЕ
		//|	РазгрузкаАвтоГрузовыеМеста.Ссылка = &Разгрузка
		//|
		//|ОБЪЕДИНИТЬ ВСЕ
		//|
		//|ВЫБРАТЬ
		//|	РазгрузкаАвтоГрузовыеМеста.РТУ,
		//|	ВЫБОР
		//|		КОГДА РазгрузкаАвтоГрузовыеМеста.Ссылка.Грузополучатель.ПереносДоставкиБезУдаленияРТУ
		//|				И РазгрузкаАвтоГрузовыеМеста.ПринятоСкладом
		//|			ТОГДА ИСТИНА
		//|		ИНАЧЕ ЛОЖЬ
		//|	КОНЕЦ
		//|ИЗ
		//|	Документ.РазгрузкаАвто.ГрузовыеМеста КАК РазгрузкаАвтоГрузовыеМеста
		//|ГДЕ
		//|	РазгрузкаАвтоГрузовыеМеста.Ссылка = &Разгрузка
		//|;
		//|
		//|////////////////////////////////////////////////////////////////////////////////
		//|ВЫБРАТЬ РАЗЛИЧНЫЕ
		//|	ВТ_РТУ.РТУ,
		//|	МАКСИМУМ(НЕ ЕСТЬNULL(ВыкупСОтветственногоХраненияДокументыОснованияВыкупаТОХ.Ссылка, ЗНАЧЕНИЕ(Документ.ВыкупСОтветственногоХранения.ПустаяСсылка)) = ЗНАЧЕНИЕ(Документ.ВыкупСОтветственногоХранения.ПустаяСсылка)) КАК ЕстьВыкуп
		//|ПОМЕСТИТЬ ВТ_Выкупы
		//|ИЗ
		//|	ВТ_РТУ КАК ВТ_РТУ
		//|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВыкупСОтветственногоХранения.ДокументыОснованияВыкупаТОХ КАК ВыкупСОтветственногоХраненияДокументыОснованияВыкупаТОХ
		//|		ПО ВТ_РТУ.РТУ.Ссылка = ВыкупСОтветственногоХраненияДокументыОснованияВыкупаТОХ.ДокументОснование
		//|			И (НЕ ВыкупСОтветственногоХраненияДокументыОснованияВыкупаТОХ.Ссылка.ПометкаУдаления)
		//|
		//|СГРУППИРОВАТЬ ПО
		//|	ВТ_РТУ.РТУ
		//|;
		//|
		//|////////////////////////////////////////////////////////////////////////////////
		//|ВЫБРАТЬ
		//|	ВТ_РТУ.РТУ,
		//|	МИНИМУМ(ВЫБОР
		//|			КОГДА ВТ_Выкупы.ЕстьВыкуп
		//|				ТОГДА ИСТИНА
		//|			ИНАЧЕ ВТ_РТУ.ПоменятьСтатус
		//|		КОНЕЦ) КАК ПоменятьСтатус
		//|ИЗ
		//|	ВТ_РТУ КАК ВТ_РТУ
		//|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Выкупы КАК ВТ_Выкупы
		//|		ПО ВТ_РТУ.РТУ = ВТ_Выкупы.РТУ
		//|
		//|СГРУППИРОВАТЬ ПО
		//|	ВТ_РТУ.РТУ";
		//-Кабанов А.В. 10.03.2025 # UT10-5127
		
		ЗапросРТУ.УстановитьПараметр("Разгрузка", Ссылка);
		
		ТаблицаРеализаций = ЗапросРТУ.Выполнить().Выгрузить();
		
		Для Каждого СтрокаРТУ ИЗ ТаблицаРеализаций Цикл
			
			Если НЕ СтрокаРТУ.РТУ.ПометкаУдаления Тогда
				
				Если НЕ СтрокаРТУ.ПоменятьСтатус Тогда
					
					РТУОбъект = СтрокаРТУ.РТУ.ПолучитьОбъект();
					РТУОбъект.УстановитьПометкуУдаления(Истина);
					
				Иначе
					УстановитьСтатусПереносДоставки(СтрокаРТУ.РТУ);				
				КонецЕсли;			
				
			КонецЕсли;
			
		КонецЦикла;

		ПромДатаПереноса = Дата(1,1,1);
		
		Для Каждого ЗаписьГМ Из ГрузовыеМеста Цикл  
			
			ПромДатаПереноса = НачалоДня(ЗаписьГМ.ДатаПереноса);
			
			Если ЗаписьГМ.ГрузовоеМесто.Погружено Тогда 
				
				ГМОбъект = ЗаписьГМ.ГрузовоеМесто.ПолучитьОбъект();
				ГМОбъект.Погружено = Ложь;
				ГМОбъект.Записать(РежимЗаписиДокумента.Запись);
				
			КонецЕсли;
			
			Если НЕ ЗаписьГМ.ПринятоСкладом Тогда
				
				Если ЗаписьГМ.ПереданоНаСклад Тогда
					
					ЕстьВСпискеГМСклад = СписокГМСклад.Найти(ЗаписьГМ.ГрузовоеМесто,"Ссылка");
					
					Если ЕстьВСпискеГМСклад = Неопределено Тогда			
						
						НоваяСтрокаСпискаГМСклад        = СписокГМСклад.Добавить();
						НоваяСтрокаСпискаГМСклад.Ссылка = ЗаписьГМ.ГрузовоеМесто;
						НоваяСтрокаСпискаГМСклад.Номер  = "%Место " + ОбщегоНазначения.ПолучитьНомерНаПечать(ЗаписьГМ.ГрузовоеМесто,,, Истина) + "%";
						
					КонецЕсли;	
					
				Иначе
					
					ЕстьВСпискеГМВодитель = СписокГМВодитель.Найти(ЗаписьГМ.ГрузовоеМесто,"Ссылка");
					
					Если ЕстьВСпискеГМВодитель = Неопределено Тогда
						
						НоваяСтрокаСпискаГМВодители        = СписокГМВодитель.Добавить();
						НоваяСтрокаСпискаГМВодители.Ссылка = ЗаписьГМ.ГрузовоеМесто;
						НоваяСтрокаСпискаГМВодители.Номер  = "%Место " + ОбщегоНазначения.ПолучитьНомерНаПечать(ЗаписьГМ.ГрузовоеМесто,,, Истина) + "%";
						
					КонецЕсли;
					
				КонецЕсли;
				
			Иначе
				
				Если НЕ НачалоДня(ЗаписьГМ.ГрузовоеМесто.Сборка.ДатаДоставкиКлиенту) = НачалоДня(ЗаписьГМ.ДатаПереноса) Тогда  
					
					СборкаОбъект = ЗаписьГМ.ГрузовоеМесто.Сборка.ПолучитьОбъект();
					СборкаОбъект.ДатаДоставкиКлиенту = НачалоДня(ЗаписьГМ.ДатаПереноса) + 3600;
					СборкаОбъект.Записать(РежимЗаписиДокумента.Запись, РежимПроведенияДокумента.Неоперативный);
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		
		Если НЕ СписокГМСклад.Количество() = 0 Тогда
			СоздатьКорректировкуСборки(Отказ,СписокГМСклад,Перечисления.ПричиныКорректировкиСборки.Недостача); 			
		КонецЕсли;			
		
		Если НЕ СписокГМВодитель.Количество() = 0 Тогда
			СоздатьКорректировкуСборки(Отказ,СписокГМВодитель,Перечисления.ПричиныКорректировкиСборки.ОтказПоставщика); 			
		КонецЕсли;	
		
		Если НЕ Отказ Тогда 
			
			Если ЗначениеЗаполнено(ПромДатаПереноса) И НЕ ТаблицаРеализаций.Количество() = 0 Тогда
				ОтправитьПисьмоОПереносеДоставки(ТаблицаРеализаций , ПромДатаПереноса); 
			КонецЕсли;		
			
			СписокСборок = Новый СписокЗначений;
			
			Для Каждого ТекСтрокаДоставка Из ГрузовыеМеста Цикл
				
				ЕстьСборкаВСписке = СписокСборок.НайтиПоЗначению(ТекСтрокаДоставка.ГрузовоеМесто.Сборка);
				
				Если ЕстьСборкаВСписке = Неопределено Тогда
					СписокСборок.Добавить(ТекСтрокаДоставка.ГрузовоеМесто.Сборка);
				КонецЕсли;			
				
			КонецЦикла;		
			
			Движения.ЗаданиеНаДоставку.Записывать = Истина;
			Движения.ЗаданиеНаДоставку.Очистить();
			
			Для Каждого ТекСтрокаДоставка Из СписокСборок Цикл
				
				Движение                 = Движения.ЗаданиеНаДоставку.Добавить();
				Движение.Период          = Дата;
				Движение.ЗаданиеНаСборку = ТекСтрокаДоставка.Значение;
				Движение.Водитель        = Водитель;
				Движение.Контрагент      = Грузополучатель;
				Движение.Количество      = -1;
				
			КонецЦикла;
			
			ОбъектЗадание = ЗаданиеНаДоставку.ПолучитьОбъект();
			
			Для Каждого ТекСтрокаДоставка Из СписокСборок Цикл
				
				ЕстьСборкаВТаблЧасти = ОбъектЗадание.Доставка.Найти(ТекСтрокаДоставка.Значение,"ДокументСборки");
				
				Если НЕ ЕстьСборкаВТаблЧасти = Неопределено Тогда
					ЕстьСборкаВТаблЧасти.Отменено = Истина;
				КонецЕсли;				
				
			КонецЦикла;
			
			ОбъектЗадание.Записать(РежимЗаписиДокумента.Запись);
			
			Попытка
				ОбъектЗадание.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЕсли;  	

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ГМПринял = Справочники.ФизическиеЛица.ПустаяСсылка();
	ГМПоложилНаМаршрут = Справочники.ФизическиеЛица.ПустаяСсылка();
	
	Для Каждого ЗаписьГМ Из ГрузовыеМеста Цикл
		
		ЗаписьГМ.ПереданоНаСклад = Ложь;
		ЗаписьГМ.ПринятоСкладом = Ложь;
		
	КонецЦикла; 
	
КонецПроцедуры

Процедура СоздатьКорректировкуСборки(Отказ, СписокГМ, ПромПричина)
	
	ЗапросТоваровДляКорректировки = Новый Запрос;
	ЗапросТоваровДляКорректировки.Текст =
	"ВЫБРАТЬ
	|	Константы.ЯчейкаДоВыяснения
	|ПОМЕСТИТЬ Константа
	|ИЗ
	|	Константы КАК Константы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СписокГМ.Ссылка,
	|	СписокГМ.Номер
	|ПОМЕСТИТЬ СписокГМИзПараметра
	|ИЗ
	|	&СписокГМ КАК СписокГМ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ГрузовоеМестоТовары.Ссылка.Сборка,
	|	СписокГМИзПараметра.Номер,
	|	ГрузовоеМестоТовары.Номенклатура,
	|	СУММА(ГрузовоеМестоТовары.Количество) КАК Количество,
	|	ГрузовоеМестоТовары.Заказ
	|ПОМЕСТИТЬ СписокТоваров
	|ИЗ
	|	СписокГМИзПараметра КАК СписокГМИзПараметра
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ГрузовоеМесто.Товары КАК ГрузовоеМестоТовары
	|		ПО СписокГМИзПараметра.Ссылка = ГрузовоеМестоТовары.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ГрузовоеМестоТовары.Заказ,
	|	ГрузовоеМестоТовары.Номенклатура,
	|	СписокГМИзПараметра.Номер,
	|	ГрузовоеМестоТовары.Ссылка.Сборка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СборкаЗаказовПокупателяЗаказано.Ссылка,
	|	СборкаЗаказовПокупателяЗаказано.Заказ,
	|	СборкаЗаказовПокупателяЗаказано.Номенклатура,
	|	СборкаЗаказовПокупателяЗаказано.Ячейка,
	|	СУММА(ВЫБОР
	|			КОГДА ЕСТЬNULL(СписокТоваров.Количество, 0) >= СборкаЗаказовПокупателяЗаказано.Факт
	|				ТОГДА СборкаЗаказовПокупателяЗаказано.Факт
	|			ИНАЧЕ ЕСТЬNULL(СписокТоваров.Количество, 0) - СборкаЗаказовПокупателяЗаказано.Факт
	|		КОНЕЦ) КАК Корректировать,
	|	МАКСИМУМ(СборкаЗаказовПокупателяЗаказано.Факт) КАК ПоДокументу
	|ПОМЕСТИТЬ ТаблицаИтого
	|ИЗ
	|	СписокТоваров КАК СписокТоваров
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СборкаЗаказовПокупателя.Заказано КАК СборкаЗаказовПокупателяЗаказано
	|		ПО СписокТоваров.Сборка = СборкаЗаказовПокупателяЗаказано.Ссылка
	|			И СписокТоваров.Номенклатура = СборкаЗаказовПокупателяЗаказано.Номенклатура
	|			И (СборкаЗаказовПокупателяЗаказано.ГрузовоеМесто ПОДОБНО СписокТоваров.Номер)
	|			И СписокТоваров.Заказ = СборкаЗаказовПокупателяЗаказано.Заказ
	|
	|СГРУППИРОВАТЬ ПО
	|	СборкаЗаказовПокупателяЗаказано.Ссылка,
	|	СборкаЗаказовПокупателяЗаказано.Заказ,
	|	СборкаЗаказовПокупателяЗаказано.Номенклатура,
	|	СборкаЗаказовПокупателяЗаказано.Ячейка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаИтого.Ссылка КАК Сборка,
	|	ТаблицаИтого.Заказ КАК ЗаказПокупателя,
	|	ТаблицаИтого.Номенклатура КАК Номенклатура,
	|	ТаблицаИтого.Заказ.СкладГруппа КАК Склад,
	|	ВЫБОР
	|		КОГДА &Причина = ЗНАЧЕНИЕ(Перечисление.ПричиныКорректировкиСборки.ОтказПоставщика)
	|			ТОГДА ТаблицаИтого.Ячейка
	|		ИНАЧЕ Константа.ЯчейкаДоВыяснения
	|	КОНЕЦ КАК Ячейка,
	|	ВЫБОР
	|		КОГДА ТаблицаИтого.Корректировать <= ЕСТЬNULL(ТоварыВСборкеОстатки.СобраноОстаток, 0)
	|			ТОГДА ТаблицаИтого.Корректировать
	|		ИНАЧЕ ЕСТЬNULL(ТоварыВСборкеОстатки.СобраноОстаток, 0)
	|	КОНЕЦ КАК Количество,
	|	ВЫБОР
	|		КОГДА ТаблицаИтого.Корректировать <= ЕСТЬNULL(ТоварыВСборкеОстатки.СобраноОстаток, 0)
	|			ТОГДА ТаблицаИтого.Корректировать
	|		ИНАЧЕ ЕСТЬNULL(ТоварыВСборкеОстатки.СобраноОстаток, 0)
	|	КОНЕЦ КАК Факт,
	|	&Причина,
	|	ВЫБОР
	|		КОГДА &Причина = ЗНАЧЕНИЕ(Перечисление.ПричиныКорректировкиСборки.ОтказПоставщика)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Ячейки.ПустаяСсылка)
	|		ИНАЧЕ ТаблицаИтого.Ячейка
	|	КОНЕЦ КАК ПроблемнаяЯчейка,
	|	ЕСТЬNULL(ЗаказыОстатки.Цена, 0) КАК Цена
	|ИЗ
	|	ТаблицаИтого КАК ТаблицаИтого
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВСборке.Остатки КАК ТоварыВСборкеОстатки
	|		ПО ТаблицаИтого.Ссылка = ТоварыВСборкеОстатки.Сборка
	|			И ТаблицаИтого.Заказ = ТоварыВСборкеОстатки.ЗаказПокупателя
	|			И ТаблицаИтого.Номенклатура = ТоварыВСборкеОстатки.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ЗаказыПокупателейОстатки.ЗаказПокупателя КАК ЗаказПокупателя,
	|			ЗаказыПокупателейОстатки.Номенклатура КАК Номенклатура,
	|			МАКСИМУМ(ВЫРАЗИТЬ(ЗаказыПокупателейОстатки.СуммаВзаиморасчетовОстаток / ЕСТЬNULL(ЗаказыПокупателейОстатки.КоличествоОстаток, 1) КАК ЧИСЛО(15, 2))) КАК Цена
	|		ИЗ
	|			РегистрНакопления.ЗаказыПокупателей.Остатки(
	|					,
	|					(ЗаказПокупателя, Номенклатура, ИСТИНА) В
	|						(ВЫБРАТЬ
	|							ТаблицаИтого.Заказ КАК ЗаказПокупателя,
	|							ТаблицаИтого.Номенклатура КАК Номенклатура,
	|							ИСТИНА
	|						ИЗ
	|							ТаблицаИтого КАК ТаблицаИтого)) КАК ЗаказыПокупателейОстатки
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ЗаказыПокупателейОстатки.ЗаказПокупателя,
	|			ЗаказыПокупателейОстатки.Номенклатура) КАК ЗаказыОстатки
	|		ПО ТаблицаИтого.Заказ = ЗаказыОстатки.ЗаказПокупателя
	|			И ТаблицаИтого.Номенклатура = ЗаказыОстатки.Номенклатура,
	|	Константа КАК Константа
	|ГДЕ
	|	НЕ ТаблицаИтого.Ссылка ЕСТЬ NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТаблицаИтого.Ссылка,
	|	Номенклатура"; 
	
	ЗапросТоваровДляКорректировки.УстановитьПараметр("СписокГМ", СписокГМ);
	ЗапросТоваровДляКорректировки.УстановитьПараметр("Причина", ПромПричина);

	РезультатЗапросаТоварыДляКорректировки = ЗапросТоваровДляКорректировки.Выполнить();

	Если НЕ РезультатЗапросаТоварыДляКорректировки.Пустой() Тогда

		КомментарийГМ = "";

		Для Каждого СтрокаГМ Из СписокГМ Цикл
			
			ПромГМ = СтрокаГМ.Ссылка;
			КомментарийГМ = КомментарийГМ + ?(КомментарийГМ = "", "", ",") + СокрЛП(ПромГМ.Номер);		
			
		КонецЦикла;

		ВыборкаТоварыДляКорректировки = РезультатЗапросаТоварыДляКорректировки.Выбрать();

		ТекСборка = Неопределено;
		НовыйДокументКорректировкаСборки = Неопределено;

		Пока ВыборкаТоварыДляКорректировки.Следующий() Цикл

			Если НЕ ТекСборка = ВыборкаТоварыДляКорректировки.Сборка Тогда

				ТекСборка = ВыборкаТоварыДляКорректировки.Сборка;

				Если НЕ НовыйДокументКорректировкаСборки = Неопределено Тогда

					Попытка
						НовыйДокументКорректировкаСборки.ПровестиИСоздатьКорректировкиЗаказа();
					Исключение 
						Отказ = Истина;
					КонецПопытки; 					

				КонецЕсли;				

				НовыйДокументКорректировкаСборки = Документы.КорректировкаСборкиЗаказовПокупателя.СоздатьДокумент();
				НовыйДокументКорректировкаСборки.Исполнено = Истина;
				НовыйДокументКорректировкаСборки.СборкаЗаказовПокупателя = ВыборкаТоварыДляКорректировки.Сборка;
				НовыйДокументКорректировкаСборки.Контрагент	=	ВыборкаТоварыДляКорректировки.Сборка.Контрагент;
				НовыйДокументКорректировкаСборки.Грузополучатель =	ВыборкаТоварыДляКорректировки.Сборка.Грузополучатель;
				НовыйДокументКорректировкаСборки.Организация	=	ВыборкаТоварыДляКорректировки.Сборка.Организация;		
				НовыйДокументКорректировкаСборки.Ответственный	=	ВыборкаТоварыДляКорректировки.Сборка.Ответственный;	
				НовыйДокументКорректировкаСборки.Дата	=	ТекущаяДата();
				НовыйДокументКорректировкаСборки.Комментарий = "Потеря " + ?(ПромПричина = Перечисления.ПричиныКорректировкиСборки.ОтказПоставщика, 
				                                    "водителем" + СокрЛП(ЗаданиеНаДоставку.Водитель), "складом") + " грузомест " + СокрЛП(КомментарийГМ);

			КонецЕсли;

			НоваяСтрокаКорректировки = НовыйДокументКорректировкаСборки.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаКорректировки, ВыборкаТоварыДляКорректировки);			

		КонецЦикла;

		Если НЕ НовыйДокументКорректировкаСборки = Неопределено И НЕ НовыйДокументКорректировкаСборки.Проведен Тогда

			Попытка
				НовыйДокументКорректировкаСборки.ПровестиИСоздатьКорректировкиЗаказа();
			Исключение 
				Отказ = Истина;
			КонецПопытки

		КонецЕсли;

		Попытка

			Для Каждого СтрокаГМ Из СписокГМ Цикл

				ПромГМ = СтрокаГМ.Ссылка;

				Если НЕ ПромГМ.ПометкаУдаления И НЕ СтрокаГМ.Ссылка.Неактуально_КорректировкаСборки Тогда

					ОбъектГМ = ПромГМ.Получитьобъект();
					ОбъектГМ.Записать(РежимЗаписиДокумента.ОтменаПроведения);	
					ОбъектГМ.Неактуально_КорректировкаСборки = Истина;
					ОбъектГМ.ПометкаУдаления =  Истина;
					ОбъектГМ.Записать(РежимЗаписиДокумента.Запись);

				КонецЕсли;			

			КонецЦикла;

		Исключение 

			Отказ = Истина;

		КонецПопытки;

		Если ПромПричина = Перечисления.ПричиныКорректировкиСборки.ОтказПоставщика Тогда

			ВыборкаТоварыДляДокументовПоВодителю = РезультатЗапросаТоварыДляКорректировки.Выбрать();

			ДокументЗаказНаВодителя = Документы.ЗаказПокупателя.СоздатьДокумент();
			ДокументЗаказНаВодителя.Дата = ТекущаяДата();
			ДокументЗаказНаВодителя.СпособДоставки = Перечисления.СпособДоставки.Самовывоз;
			ДокументЗаказНаВодителя.Контрагент = Константы.КонтрагентВодитель.Получить();
			ДокументЗаказНаВодителя.Грузополучатель = ДокументЗаказНаВодителя.Контрагент;
			ДокументЗаказНаВодителя.ДоговорКонтрагента = ДокументЗаказНаВодителя.Контрагент.ОсновнойДоговорКонтрагента;
			ДокументЗаказНаВодителя.ВалютаДокумента = ДокументЗаказНаВодителя.ДоговорКонтрагента.ВалютаВзаиморасчетов;
			ДокументЗаказНаВодителя.КратностьВзаиморасчетов = 1;
			ДокументЗаказНаВодителя.КурсВзаиморасчетов = 1;
			ДокументЗаказНаВодителя.Организация = ДокументЗаказНаВодителя.ДоговорКонтрагента.Организация;
			ДокументЗаказНаВодителя.IDСклада = ?(Константы.FTPВыгрузкаОстатковКаталог.Получить() = "", "1", Константы.FTPВыгрузкаОстатковКаталог.Получить());
			ДокументЗаказНаВодителя.СкладГруппа = Константы.ОсновнойСклад.Получить();
			ДокументЗаказНаВодителя.УчитыватьНДС = Истина;
			ДокументЗаказНаВодителя.СуммаВключаетНДС = Истина; 
			ДокументЗаказНаВодителя.Комментарий = "Потеря водителем " + СокрЛП(ЗаданиеНаДоставку.Водитель) + " грузомест " + СокрЛП(КомментарийГМ); 		

			Пока ВыборкаТоварыДляДокументовПоВодителю.Следующий() Цикл

				НоваяСтрокаЗаказа = ДокументЗаказНаВодителя.Товары.Добавить();
				НоваяСтрокаЗаказа.Номенклатура = ВыборкаТоварыДляДокументовПоВодителю.Номенклатура;
				НоваяСтрокаЗаказа.ЕдиницаИзмерения = НоваяСтрокаЗаказа.Номенклатура.ЕдиницаХраненияОстатков;
				ДокументЗаказНаВодителя.ПриИзмененииНоменклатурыТоваров(НоваяСтрокаЗаказа); 
				НоваяСтрокаЗаказа.Количество   = ВыборкаТоварыДляДокументовПоВодителю.Количество;
				НоваяСтрокаЗаказа.Цена		   = ВыборкаТоварыДляДокументовПоВодителю.Цена;
				ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(НоваяСтрокаЗаказа, ДокументЗаказНаВодителя);
				ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НоваяСтрокаЗаказа, ДокументЗаказНаВодителя);  			

			КонецЦикла;

			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("ВидимостьСерии",     Истина);
			СтруктураПараметров.Вставить("Авторезервирование", Истина);
			СтруктураПараметров.Вставить("Авторазмещение",     Ложь);
			СтруктураПараметров.Вставить("СтратегияАвторезервированияПоЗаказам", Перечисления.СтратегииАвторезервированияНоменклатуры.СначалаНаСкладахПотомВЗаказахПоставщикам);		

			ДокументЗаказНаВодителя.ЗаполнитьТабличныеЧастиПередПроведениемУпр(СтруктураПараметров);

			МСКWEB.ОбработкаРазмещенияИЦенЗаказаПокупателя(ДокументЗаказНаВодителя);

			Попытка
				ДокументЗаказНаВодителя.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				Отказ  = Истина;
			КонецПопытки;

			Если НЕ Отказ И  ДокументЗаказНаВодителя.Проведен Тогда

				ДокСборка = Документы.СборкаЗаказовПокупателя.СоздатьДокумент();
				ДокСборка.Дата 				  = ДокументЗаказНаВодителя.Дата+1;
				ДокСборка.Контрагент 		  = ДокументЗаказНаВодителя.Контрагент;
				ДокСборка.Грузополучатель 	  = ДокументЗаказНаВодителя.Грузополучатель;
				ДокСборка.МаршрутДоставки 	  = Справочники.МаршрутыДоставки.ПустаяСсылка();
				ДокСборка.Договор 			  = ДокументЗаказНаВодителя.ДоговорКонтрагента;
				ДокСборка.СпособДоставки 	  = ДокументЗаказНаВодителя.СпособДоставки;
				ДокСборка.Дата 				  = ТекущаяДата();
				ДокСборка.ВремяНачалаСборки   = ТекущаяДата();
				ДокСборка.ВремяОкончанияСборки= ТекущаяДата();
				ДокСборка.ДатаДоставкиКлиенту = ТекущаяДата();
				ДокСборка.Организация 		  = ДокументЗаказНаВодителя.Организация;
				ДокСборка.Ответственный		  = ЗаданиеНаДоставку.Водитель;
				ВыборкаСборкаДляДокументовПоВодителю = РезультатЗапросаТоварыДляКорректировки.Выбрать();

				Пока ВыборкаСборкаДляДокументовПоВодителю.Следующий() Цикл

					НоваяСтрокаСборки = ДокСборка.Заказано.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрокаСборки, ВыборкаСборкаДляДокументовПоВодителю);
					НоваяСтрокаСборки.Подборка = Перечисления.ПодборкаНоменклатуры.Собрано;
					НоваяСтрокаСборки.Заказ = ДокументЗаказНаВодителя.Ссылка;

				КонецЦикла;

				ДокСборка.КоличествоУпаковочныхМест = 1;
				ДокСборка.ДокументСобранИУпакован = Истина;

				Попытка
					ДокСборка.Записать(РежимЗаписиДокумента.Проведение);
				Исключение
					Отказ = Истина; 
				КонецПопытки;

			КонецЕсли;

			Если НЕ Отказ И ДокСборка.Проведен Тогда
				СоздатьРеализациюПоВодителю(ДокСборка.Ссылка,СокрЛП(ДокументЗаказНаВодителя.Комментарий),Отказ);
			КонецЕсли;	
			
		КонецЕсли;		
		
	КонецЕсли;	
КонецПроцедуры

Процедура УстановитьСтатусПереносДоставки(ДокументРеализации)
	
	СтатусДоставки = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
	СтатусДоставки.Отбор.Объект.Установить(ДокументРеализации);
	СтатусДоставки.Отбор.Свойство.Установить(ПланыВидовХарактеристик.СвойстваОбъектов.СтатусДоставки);
	
	УстановитьПривилегированныйРежим(Истина);	
	СтатусДоставки.Прочитать(); 
	СтатусДоставки.Очистить();
		
	НовыйСтатусДоставки          = СтатусДоставки.Добавить();
	НовыйСтатусДоставки.Объект   = ДокументРеализации;
	НовыйСтатусДоставки.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.СтатусДоставки;
	НовыйСтатусДоставки.Значение = Перечисления.СтатусыДоставки.ПереносДоставки;
	
	СтатусДоставки.Записать();

	УстановитьПривилегированныйРежим(Ложь);	

КонецПроцедуры

Процедура СоздатьРеализациюПоВодителю(ДокСборка, ПромКомментарий, Отказ)
	
	Рубль = Справочники.Валюты.НайтиПоКоду("643");	
	
	ЗапросПоСборке = Новый Запрос;
	ЗапросПоСборке.Текст =
	"ВЫБРАТЬ
	|	ИзСборки.Грузополучатель КАК Грузополучатель,
	|	ИзСборки.Договор,
	|	ИзСборки.Ответственный КАК Водитель,
	|	ИзСборки.СпособДоставки,
	|	ИзСборки.ДоговорВладелец КАК Контрагент
	|ПОМЕСТИТЬ ТЗ
	|ИЗ
	|	(ВЫБРАТЬ
	|		СборкаЗаказовПокупателя.Грузополучатель КАК Грузополучатель,
	|		СборкаЗаказовПокупателя.Договор КАК Договор,
	|		СборкаЗаказовПокупателя.Ответственный КАК Ответственный,
	|		СборкаЗаказовПокупателя.СпособДоставки КАК СпособДоставки,
