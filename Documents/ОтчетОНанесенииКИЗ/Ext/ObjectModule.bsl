Процедура ЗаполнитьПоЗаказуНаЭмиссию(ЗаказНаЭмиссию)  
	
	//+Шульман А. 02.10.2025 #UT10-5445
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ЗаказНаЭмиссию, , "Номер, Дата");
	ЭтотОбъект.Основание = ЗаказНаЭмиссию;
	ЭтотОбъект.Дата = ТекущаяДата();         
	
	Запрос = Новый Запрос;     
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказНаЭмиссиюТовары.Номенклатура,
	|	ШтрихкодыНоменклатуры.Ссылка КАК ШтрихКодМаркировки
	|ИЗ
	|	Документ.ЗаказНаЭмиссиюКодовМаркировкиСУЗ.Товары КАК ЗаказНаЭмиссиюТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПулКодовМаркировкиСУЗ КАК ПулКодовМаркировкиСУЗ
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
	|			ПО ПулКодовМаркировкиСУЗ.КодМаркировки = ШтрихкодыНоменклатуры.КодМаркировки
	|		ПО ЗаказНаЭмиссиюТовары.Номенклатура = ПулКодовМаркировкиСУЗ.Номенклатура
	|			И ЗаказНаЭмиссиюТовары.GTIN = ПулКодовМаркировкиСУЗ.GTIN
	|			И (ПулКодовМаркировкиСУЗ.ЗаказНаЭмиссию = &ЗаказНаЭмиссию)
	|			И (ЗаказНаЭмиссиюТовары.Ссылка = &ЗаказНаЭмиссию)";
	
	Запрос.УстановитьПараметр("ЗаказНаЭмиссию", ЗаказНаЭмиссию);  
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл    
		
		ДобСтрока = Товары.Добавить();
		ДобСтрока.Номенклатура = Выборка.Номенклатура;
		ДобСтрока.ШтрихКодМаркировки = Выборка.ШтрихКодМаркировки;
		
	КонецЦикла;
	//-Шульман А. 02.10.2025 #UT10-5445

КонецПроцедуры

