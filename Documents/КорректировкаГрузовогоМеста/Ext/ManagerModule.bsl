Процедура ПечатьЗаданияНаКорректировку(ПромДок, ИмяМакета, ВернутьТабДок = Неопределено) Экспорт
	
	Макет = ПолучитьМакет("ЗаданиеНаКорректировку");
	ТабДок  = Новый ТабличныйДокумент;
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	
	Если ПромДок.ГрузовоеМесто.Сборка.СпособДоставки = Перечисления.СпособДоставки.Самовывоз Тогда
		ПечМаршрутДоставки = ?(ПромДок.ГрузовоеМесто.Сборка.ТаксиДоставка, "ТАКСИ ДОСТАВКА", "Самовывоз");	
	Иначе
		ПечМаршрутДоставки = СокрЛП(ПромДок.ГрузовоеМесто.Сборка.МаршрутДоставки);
	КонецЕсли;
	
	ОбластьМакета.Параметры.МаршрутДоставки = ПечМаршрутДоставки;
	ОбластьМакета.Параметры.Номер = ПромДок.Номер;
	ОбластьМакета.Параметры.Дата = Формат(ПромДок.Дата, "ДЛФ=D");
	ОбластьМакета.Параметры.НомерCборки = ПромДок.ГрузовоеМесто.Сборка.Номер;
	ОбластьМакета.Параметры.ДатаСборки = Формат(ПромДок.ГрузовоеМесто.Сборка.Дата, "ДЛФ=D");
	ОбластьМакета.Параметры.Клиент = ПромДок.Грузополучатель.Наименование; 
	ОбластьМакета.Параметры.СпособДоставки = ПромДок.ГрузовоеМесто.Сборка.СпособДоставки;
		
	Если ЗначениеЗаполнено(ПромДок.ГрузовоеМесто.ШКОбособленного) Тогда
		
		ПромНомерГМ = Прав(ПромДок.ГрузовоеМесто.ШКОбособленного, 9); 
		
		Пока Лев(ПромНомерГМ, 1) = "0" Цикл
			ПромНомерГМ = Сред(ПромНомерГМ, 2);
		КонецЦикла;   
		 
		ОбластьМакета.Параметры.Код = "Транзит" + Символы.ПС + СокрЛП("ГМ" + ПромНомерГМ); 
		
	Иначе
		ОбластьМакета.Параметры.Код = СокрЛП("ГМ" + ОбщегоНазначения.ПолучитьНомерНаПечать(ПромДок.ГрузовоеМесто,,, Истина));
	КонецЕсли; 
	
	ШтрихкодированиеПечатныхФорм.ВывестиШтрихкодВТабличныйДокумент(ТабДок, Макет, ОбластьМакета, ПромДок.Ссылка); 
	
	ТабДок.Вывести(ОбластьМакета);
	
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	
	Для Каждого СтрокаТовары Из ПромДок.Товары Цикл
		
		ОбластьСтрока.Параметры.Сч = СтрокаТовары.НомерСтроки;
		ОбластьСтрока.Параметры.Производитель = СтрокаТовары.Номенклатура.Родитель;
		ОбластьСтрока.Параметры.КодПроизводителя = СтрокаТовары.Номенклатура.КодПроизводителя;
		ОбластьСтрока.Параметры.Номенклатура = СтрокаТовары.Номенклатура.Наименование;
		ОбластьСтрока.Параметры.Кол = СтрокаТовары.КоличествоВГрузоместе;
		ОбластьСтрока.Параметры.КолИзъять = СтрокаТовары.Количество;  
		
		ТабДок.Вывести(ОбластьСтрока);
		
	КонецЦикла;    
	
	ТабДок.АвтоМасштаб = Истина;
	
	МСК.ЗафиксироватьПечатьДокумента(ПромДок.Ссылка, ИмяМакета, "Задание на корректировку ГМ");
	
	Если ВернутьТабДок = Неопределено Тогда			
		ТабДок.Показать();
	Иначе
		ВернутьТабДок = ТабДок;	
	КонецЕсли;	
	
КонецПроцедуры
