
Процедура ИзменитьСтатусЗаданияНаДоставку(СтатусУстановки) Экспорт
	
	СтатусВыполнения = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
	СтатусВыполнения.Отбор.Объект.Установить(ЗаданиеНаДоставку);
	СтатусВыполнения.Отбор.Свойство.Установить(ПланыВидовХарактеристик.СвойстваОбъектов.СтатусВыполнения);
	
	СтатусВыполнения.Прочитать();
	
	Если СтатусВыполнения.Количество() = 0 Тогда
		
		НовыйСтатусВыполнения = СтатусВыполнения.Добавить();
		НовыйСтатусВыполнения.Объект = ЗаданиеНаДоставку;
		НовыйСтатусВыполнения.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.СтатусВыполнения;
		
	Иначе
		НовыйСтатусВыполнения = СтатусВыполнения[0];
	КонецЕсли;
	
	НовыйСтатусВыполнения.Значение = СтатусУстановки;
	СтатусВыполнения.Записать(); 	

КонецПроцедуры

Функция ПолучитьСтруктуруПечатныхФорм() Экспорт
	
	СтруктураМакетов = Новый Структура;
	
	СтруктураМакетов.Вставить("Макет", "Акт приема-передачи");
	Возврат СтруктураМакетов;
	
КонецФункции // ПолучитьСтруктуруПечатныхФорм()


Процедура ДвиженияПоРегистрам()

	// сколько товаров мы ждем от водителя	
	ТаблицаОстатков = РаботаСТоварамиНаДоставке.ТоварыНаДоставке(ЭтотОбъект.Ссылка);	
	
	// сколько товаров он сдал	
	ТаблицаДокумента = ЭтотОбъект.Товары.Выгрузить(,"ДокументРеализации, Номенклатура, КоличествоПлан, КоличествоФакт");
	
	
	// закинем обе таблицы во временные таблицы
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Параметры.Вставить("ТаблицаОстатков", ТаблицаОстатков);
	Запрос.Параметры.Вставить("ТаблицаДокумента", ТаблицаДокумента);
	Запрос.Параметры.Вставить("ЗаданиеНаДоставку", ЭтотОбъект.ЗаданиеНаДоставку);	
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаблицаОстатков.ЗаданиеНаДоставку,
	               |	ТаблицаОстатков.ДокументРеализации,
	               |	ТаблицаОстатков.Номенклатура,
	               |	ТаблицаОстатков.Количество,
	               |	ТаблицаОстатков.КоличествоВозвращенногоТовара
	               |ПОМЕСТИТЬ ТаблицаОстатков
	               |ИЗ
	               |	&ТаблицаОстатков КАК ТаблицаОстатков";
	Запрос.Выполнить();
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	&ЗаданиеНаДоставку,
	               |	ТаблицаДокумента.ДокументРеализации,
	               |	ТаблицаДокумента.Номенклатура,
	               |	ТаблицаДокумента.КоличествоПлан,				   
	               |	ТаблицаДокумента.КоличествоФакт
	               |ПОМЕСТИТЬ ТаблицаДокумента
	               |ИЗ
	               |	&ТаблицаДокумента КАК ТаблицаДокумента";
	Запрос.Выполнить();
	
	
// формируем таблицу движений, специально поместив в неё нулевые количества для корректной печати.
// Потому что нужна совпадающая нумерация строк и в табличной части, и в движениях
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаДокумента.ЗаданиеНаДоставку,
		|	ТаблицаДокумента.ДокументРеализации,
		|	ТаблицаДокумента.Номенклатура,
		|	ВЫБОР
		|		КОГДА ТаблицаДокумента.КоличествоФакт > ЕСТЬNULL(ТаблицаОстатков.Количество, 0)
		|			ТОГДА ЕСТЬNULL(ТаблицаОстатков.Количество, 0)
		|		ИНАЧЕ ТаблицаДокумента.КоличествоФакт
		|	КОНЕЦ КАК Количество,
		|	ТаблицаДокумента.КоличествоФакт - ВЫБОР
		|		КОГДА ТаблицаДокумента.КоличествоФакт > ЕСТЬNULL(ТаблицаОстатков.Количество, 0)
		|			ТОГДА ЕСТЬNULL(ТаблицаОстатков.Количество, 0)
		|		ИНАЧЕ ТаблицаДокумента.КоличествоФакт
		|	КОНЕЦ КАК КоличествоВозвращенногоТовара,
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения
		|ИЗ
		|	ТаблицаДокумента КАК ТаблицаДокумента
		|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаОстатков КАК ТаблицаОстатков
		|		ПО ТаблицаДокумента.ЗаданиеНаДоставку = ТаблицаОстатков.ЗаданиеНаДоставку
		|			И ТаблицаДокумента.ДокументРеализации = ТаблицаОстатков.ДокументРеализации
		|			И ТаблицаДокумента.Номенклатура = ТаблицаОстатков.Номенклатура";
	
	ТаблицаДляПроведения = Запрос.Выполнить().Выгрузить();
	
	Движения.ТоварыНаДоставке.Записывать = Истина;
	ТаблицаДляПроведения.Колонки.Добавить("Период");
	ТаблицаДляПроведения.ЗаполнитьЗначения(ЭтотОбъект.Дата, "Период");
	Движения.ТоварыНаДоставке.Загрузить(ТаблицаДляПроведения);
	
// Устанавливаем статус в случае, если совпали план-факт

	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаДокумента.ЗаданиеНаДоставку,
		|	ТаблицаДокумента.ДокументРеализации,
		|	ТаблицаДокумента.Номенклатура,
		|	СУММА(ТаблицаДокумента.КоличествоПлан - ТаблицаДокумента.КоличествоФакт) КАК Разница
		|ИЗ
		|	ТаблицаДокумента КАК ТаблицаДокумента
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаДокумента.Номенклатура,
		|	ТаблицаДокумента.ДокументРеализации,
		|	ТаблицаДокумента.ЗаданиеНаДоставку
		|
		|ИМЕЮЩИЕ
		|	НЕ СУММА(ТаблицаДокумента.КоличествоПлан - ТаблицаДокумента.КоличествоФакт) = 0";
	
	Если Запрос.Выполнить().Пустой() Тогда
// все ок		
		ИзменитьСтатусЗаданияНаДоставку(Перечисления.СтатусыВыполнения.Выполнено);
	КонецЕсли;		
	
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	ДатаВключенияТоваровНаДоставке	=	Константы.ДатаВключенияТоваровНаДоставке.Получить();
	
	Если (НЕ ЗНачениеЗаполнено(ДатаВключенияТоваровНаДоставке))  // пустая константа
		ИЛИ (НачалоДня(ДатаВключенияТоваровНаДоставке) >  ЭтотОбъект.Дата) Тогда   // константа больше даты документа
		//	оставляем движения
			Возврат
	Иначе
		//	все нормально, проводим
		ОбщегоНазначения.УдалитьДвиженияРегистратора(ЭтотОбъект, Отказ);
		ДвиженияПоРегистрам()
	КонецЕсли;
	
	
КонецПроцедуры

Процедура Печать(ИмяМакета, КоличествоЭкземпляров = 1, НаПринтер = Ложь) Экспорт
	
	#Если Клиент Тогда	
	Если ЭтоНовый() Тогда
		Предупреждение("Документ можно распечатать только после его записи");
		Возврат;
	ИначеЕсли Не УправлениеДопПравамиПользователей.РазрешитьПечатьНепроведенныхДокументов(Проведен) Тогда
		Предупреждение("Недостаточно полномочий для печати непроведенного документа!");
		Возврат;
	КонецЕсли;
	
	Если Не РаботаСДиалогами.ПроверитьМодифицированность(ЭтотОбъект) Тогда
		Возврат;
	КонецЕсли;
			
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	АктВозвратаТоваровНаСклад.Дата,
	               |	АктВозвратаТоваровНаСклад.Номер,
	               |	АктВозвратаТоваровНаСклад.Водитель,
	               |	АктВозвратаТоваровНаСклад.Ответственный
	               |ИЗ
	               |	Документ.АктВозвратаТоваровНаСклад КАК АктВозвратаТоваровНаСклад
	               |ГДЕ
	               |	АктВозвратаТоваровНаСклад.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Товары.Номенклатура,
	               |	Товары.Родитель,
	               |	Товары.Артикул,
	               |	Товары.КодПроизводителя,
	               |	Товары.ГрузовоеМесто,
	               |	СУММА(Товары.Количество) КАК Количество,
	               |	Товары.ТипРазмещения
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ТоварыНаДоставке.Номенклатура КАК Номенклатура,
	               |		ТоварыНаДоставке.Номенклатура.Родитель КАК Родитель,
	               |		ТоварыНаДоставке.Номенклатура.Артикул КАК Артикул,
	               |		ТоварыНаДоставке.Номенклатура.КодПроизводителя КАК КодПроизводителя,
	               |		АктВозвратаТоваровНаСкладТовары.ГрузовоеМесто КАК ГрузовоеМесто,
	               |		СУММА(ВЫБОР
	               |				КОГДА ЕСТЬNULL(ТоварыНаДоставке.Количество, 0) = 0
	               |					ТОГДА ЕСТЬNULL(ТоварыНаДоставке.КоличествоВозвращенногоТовара, 0)
	               |				ИНАЧЕ ЕСТЬNULL(ТоварыНаДоставке.Количество, 0)
	               |			КОНЕЦ) КАК Количество,
	               |		ВЫБОР
	               |			КОГДА ЕСТЬNULL(ТоварыНаДоставке.Количество, 0) = 0
	               |				ТОГДА ""В ячейку Возврат""
	               |			ИНАЧЕ ""На доставку""
	               |		КОНЕЦ КАК ТипРазмещения
	               |	ИЗ
	               |		РегистрНакопления.ТоварыНаДоставке КАК ТоварыНаДоставке
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АктВозвратаТоваровНаСклад.Товары КАК АктВозвратаТоваровНаСкладТовары
	               |			ПО ТоварыНаДоставке.НомерСтроки = АктВозвратаТоваровНаСкладТовары.НомерСтроки
	               |				И ТоварыНаДоставке.Номенклатура = АктВозвратаТоваровНаСкладТовары.Номенклатура
	               |				И ТоварыНаДоставке.ДокументРеализации = АктВозвратаТоваровНаСкладТовары.ДокументРеализации
	               |	ГДЕ
	               |		ТоварыНаДоставке.Регистратор = &Ссылка
	               |		И АктВозвратаТоваровНаСкладТовары.Ссылка = &Ссылка
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		АктВозвратаТоваровНаСкладТовары.ГрузовоеМесто,
	               |		ВЫБОР
	               |			КОГДА ЕСТЬNULL(ТоварыНаДоставке.Количество, 0) = 0
	               |				ТОГДА ""В ячейку Возврат""
	               |			ИНАЧЕ ""На доставку""
	               |		КОНЕЦ,
	               |		ТоварыНаДоставке.Номенклатура,
	               |		ТоварыНаДоставке.Номенклатура.Родитель,
	               |		ТоварыНаДоставке.Номенклатура.Артикул,
	               |		ТоварыНаДоставке.Номенклатура.КодПроизводителя) КАК Товары
	               |ГДЕ
	               |	Товары.Количество > 0
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Товары.ТипРазмещения,
	               |	Товары.ГрузовоеМесто,
	               |	Товары.КодПроизводителя,
	               |	Товары.Артикул,
	               |	Товары.Номенклатура,
	               |	Товары.Родитель
	               |АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	Пакет = Запрос.ВыполнитьПакет();
	
	ЗапросШапка = Пакет[0].Выгрузить();
	
	Выборка = Пакет[1].Выбрать();
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_АктВозвратаТоваровНаСклад";
	Макет = ПолучитьМакет("Макет");
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	
	Шапка = ЗапросШапка[0];
	ОбластьМакета.Параметры.Заполнить(Шапка);
	
	ОбластьМакета.Параметры.Дата = Формат(Шапка.Дата, "ДЛФ=D");
			
	ТабДок.Вывести(ОбластьМакета);

	Счетчик = 1;

	Пока Выборка.Следующий() Цикл
		
		ОбластьМакета = Макет.ПолучитьОбласть("Строка");
		ОбластьМакета.Параметры.Заполнить(Выборка);
		ОбластьМакета.Параметры.Счетчик = Счетчик;
		
		Если ЗначениеЗаполнено(Выборка.ГрузовоеМесто) Тогда
			ОбластьМакета.Параметры.ГрузовоеМесто = "Место " + ОбщегоНазначения.ПолучитьНомерНаПечать(Выборка.ГрузовоеМесто,,, Истина);
		КонецЕсли;
		
		ТабДок.Вывести(ОбластьМакета);
		Счетчик = Счетчик + 1;
		
	КонецЦикла;
				
	ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
	ОбластьМакета.Параметры.Заполнить(Шапка);
	ТабДок.Вывести(ОбластьМакета);
	
	ТабДок.ОтображатьСетку = Ложь;
	ТабДок.ФиксацияСверху = 4;
	ТабДок.ПолеСлева = 1;
	ТабДок.ПолеСправа = 0;
	ТабДок.АвтоМасштаб = Истина;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	
	УниверсальныеМеханизмы.НапечататьДокумент(ТабДок, КоличествоЭкземпляров, НаПринтер, ОбщегоНазначения.СформироватьЗаголовокДокумента(ЭтотОбъект, ЭтотОбъект.Метаданные().Представление()), Ссылка);
	#КонецЕсли

КонецПроцедуры 
