	ДатаПлатежа = НачалоДня(Документ.Дата);

	Если Документ.Товары.Количество() > 0 И ЗначениеЗаполнено(Документ.Товары[0].ЗаказПокупателя) Тогда 
		КлючСтрокиУсловий = Документ.Товары[0].ЗаказПокупателя.КлючСтрокиУсловий; 
	Иначе                                                                                      
		КлючСтрокиУсловий = 0;                                
	КонецЕсли;
	
	КоличествоДнейОтсрочки = Справочники.ДоговорыКонтрагентов.КоличествоДнейОтсрочки(Документ.ДоговорКонтрагента, КлючСтрокиУсловий);
	
	Если КоличествоДнейОтсрочки > 0 Тогда
		
		ДатаПлатежа = ЗаполнениеДокументов.ОпределитьДату(НачалоДня(Документ.Дата), КоличествоДнейОтсрочки);
		
		//Если Производственный календарь не заполнен, то считаем по календарным дням
		Если Не ЗначениеЗаполнено(ДатаПлатежа) Тогда
			ДатаПлатежа = НачалоДня(Документ.Дата) + КоличествоДнейОтсрочки * 86400;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ДатаПлатежа;

КонецФункции

