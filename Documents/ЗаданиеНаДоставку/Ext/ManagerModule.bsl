	|	0,
	|	ВЫРАЗИТЬ(ВЫБОР
	|			КОГДА АдресДоставки.Объект ЕСТЬ NULL
	|				ТОГДА """"
	|			ИНАЧЕ ВЫБОР
	|					КОГДА ПОДСТРОКА(АдресДоставки.Поле4, 1, 100) = """"
	|							И ПОДСТРОКА(АдресДоставки.Поле6, 1, 100) = """"
	|							И ПОДСТРОКА(АдресДоставки.Поле7, 1, 100) = """"
	|							И ПОДСТРОКА(АдресДоставки.Поле8, 1, 100) = """"
	|							И ПОДСТРОКА(АдресДоставки.Поле9, 1, 100) = """"
	|						ТОГДА АдресДоставки.Представление
	|					ИНАЧЕ АдресДоставки.Поле4 + "" "" + АдресДоставки.Поле5 + "", "" + АдресДоставки.Поле6 + "", дом № "" + АдресДоставки.Поле7 + "" "" + ВЫБОР
	|							КОГДА ПОДСТРОКА(АдресДоставки.Поле8, 1, 100) = """"
	|								ТОГДА """"
	|							ИНАЧЕ "" корпус "" + АдресДоставки.Поле8
	|						КОНЕЦ + "" "" + ВЫБОР
	|							КОГДА ПОДСТРОКА(АдресДоставки.Поле9, 1, 100) = """"
	|								ТОГДА """"
	|							ИНАЧЕ "" оф."" + АдресДоставки.Поле9
	|						КОНЕЦ + """"
	|				КОНЕЦ
	|		КОНЕЦ КАК СТРОКА(999)),
	|	ВЫРАЗИТЬ(ВЫБОР
	|			КОГДА ТелефонКонтрагента.Объект ЕСТЬ NULL
	|				ТОГДА """"
	|			ИНАЧЕ ТелефонКонтрагента.Представление
	|		КОНЕЦ КАК СТРОКА(100)),
	|	NULL,
	|	NULL
	|ИЗ
	|	Документ.ЗаданиеНаДоставку.ДоставкаПоказная КАК ЗаданиеНаДоставкуДоставкаПоказная
	|		ЛЕВОЕ СОЕДИНЕНИЕ СуммыПКО КАК СуммыПКО
	|		ПО ЗаданиеНаДоставкуДоставкаПоказная.Контрагент = СуммыПКО.ТекКонтрагент
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК АдресДоставки
	|		ПО ЗаданиеНаДоставкуДоставкаПоказная.Контрагент = АдресДоставки.Объект
	|			И (АдресДоставки.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес))
	|			И (АдресДоставки.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресДоставкиКонтрагента))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК ТелефонКонтрагента
	|		ПО ЗаданиеНаДоставкуДоставкаПоказная.Контрагент = ТелефонКонтрагента.Объект
	|			И (ТелефонКонтрагента.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон))
	|			И (ТелефонКонтрагента.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонКонтрагента)),
	|	(ВЫБРАТЬ
	|		Константы.ОсновнаяОрганизация КАК ОсновнаяОрганизация
	|	ИЗ
	|		Константы КАК Константы) КАК КонстОснОрганизация
	|ГДЕ
	|	ЗаданиеНаДоставкуДоставкаПоказная.Ссылка = &Ссылка
	|	И ЗаданиеНаДоставкуДоставкаПоказная.Деньги
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫРАЗИТЬ(ВЫБОР
	|			КОГДА ТелефонКонтрагента.Объект ЕСТЬ NULL
	|				ТОГДА """"
	|			ИНАЧЕ ТелефонКонтрагента.Представление
	|		КОНЕЦ КАК СТРОКА(100)),
	|	ЗаданиеНаДоставкуДоставкаПоказная.Контрагент,
	|	ВЫРАЗИТЬ(ВЫБОР
	|			КОГДА АдресДоставки.Объект ЕСТЬ NULL
	|				ТОГДА """"
	|			ИНАЧЕ ВЫБОР
	|					КОГДА ПОДСТРОКА(АдресДоставки.Поле4, 1, 100) = """"
	|							И ПОДСТРОКА(АдресДоставки.Поле6, 1, 100) = """"
	|							И ПОДСТРОКА(АдресДоставки.Поле7, 1, 100) = """"
	|							И ПОДСТРОКА(АдресДоставки.Поле8, 1, 100) = """"
	|							И ПОДСТРОКА(АдресДоставки.Поле9, 1, 100) = """"
	|						ТОГДА АдресДоставки.Представление
	|					ИНАЧЕ АдресДоставки.Поле4 + "" "" + АдресДоставки.Поле5 + "", "" + АдресДоставки.Поле6 + "", дом № "" + АдресДоставки.Поле7 + "" "" + ВЫБОР
	|							КОГДА ПОДСТРОКА(АдресДоставки.Поле8, 1, 100) = """"
	|								ТОГДА """"
	|							ИНАЧЕ "" корпус "" + АдресДоставки.Поле8
	|						КОНЕЦ + "" "" + ВЫБОР
	|							КОГДА ПОДСТРОКА(АдресДоставки.Поле9, 1, 100) = """"
	|								ТОГДА """"
	|							ИНАЧЕ "" оф."" + АдресДоставки.Поле9
	|						КОНЕЦ + """"
	|				КОНЕЦ
	|		КОНЕЦ КАК СТРОКА(999))
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|ИТОГИ
	|	СУММА(КоличествоМест),
	|	МАКСИМУМ(Возврат),
	|	МАКСИМУМ(Маршрут),
	|	МАКСИМУМ(ПриоритетВМаршруте),
	|	МИНИМУМ(НомерСтроки),
	|	МАКСИМУМ(СуммаПКО),
	|	МАКСИМУМ(СуммаПКОУпр),
	|	МАКСИМУМ(ДокументЧек),
	|	МАКСИМУМ(АдресДоставки),
	|	МАКСИМУМ(Тел)
	|ПО
	|	Грузополучатель
	|АВТОУПОРЯДОЧИВАНИЕ" ;
	
	Запрос.УстановитьПараметр("Ссылка",ДокСсылка);
	
	Пакет = Запрос.ВыполнитьПакет();
	ЗапросШапка = Пакет[2].Выгрузить();
	ЗК = Пакет[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ПроверяемДоверенность = Константы.ИспользоватьДоверенностиКлиентов.Получить();
		
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ЗаданиеНаДоставку_ОтчетОВыполнении";
	Макет = ПолучитьМакет("ОтчетОВыполнении");
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка|Основная");
	
	Шапка = ЗапросШапка[0];
	ОбластьМакета.Параметры.Заполнить(Шапка);
	ОбластьМакета.Параметры.Дата = Формат(Шапка.Дата,"ДЛФ=D");
	ТабДок.Вывести(ОбластьМакета); 

	Если ПроверяемДоверенность Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка|Доверенности");
		ТабДок.Присоединить(ОбластьМакета);
	КонецЕсли;			
	
	ТекНом = 0;
	
	ЗапросГП = Новый Запрос;
	ЗапросГП.Текст = 
	"ВЫБРАТЬ
	|	Контрагенты.Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ГоловнойКонтрагент = &ГоловнойКонтрагент
	|	И Контрагенты.Ссылка <> &ГоловнойКонтрагент";
	
	//+Кабанов А.В. 21.04.2025 # UT10-5202
	ЗапросДолга = Новый Запрос;
	ЗапросДолга.Текст =
	"ВЫБРАТЬ
	|	ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстатки.ДокументРасчетовСКонтрагентом,
	|	ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстатки.СуммаВзаиморасчетовОстаток
	|ИЗ
	|	РегистрНакопления.ВзаиморасчетыСКонтрагентамиПоДокументамРасчетов.Остатки(, ДокументРасчетовСКонтрагентом = &Реализация) КАК ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстатки
	|ГДЕ
	|	ВзаиморасчетыСКонтрагентамиПоДокументамРасчетовОстатки.СуммаВзаиморасчетовОстаток > 0";
	//-Кабанов А.В. 21.04.2025 # UT10-5202

	Пока ЗК.Следующий() Цикл
		
		ЗапросКонтрагенты = ЗК.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ЗапросКонтрагенты.Следующий() Цикл			
			
			ТекстВозврат = "";
			
			Если ЗК.Возврат = 1 Тогда 
				
				Если ЗапросКонтрагенты.Возврат = 1  Тогда 
					// не выводим строчку возврата
					Продолжить;
				Иначе
					ТекстВозврат = "Да";
					// но о том, что по конрагенту есть возврат, отметим
				КонецЕсли;
			КонецЕсли;
			
			ОбластьМакета = Макет.ПолучитьОбласть("Строка|Основная");
			ОбластьМакета.Параметры.Заполнить(ЗапросКонтрагенты);

			Если ЗапросКонтрагенты.АдресДоставки = "" Или ЗапросКонтрагенты.Тел = "" Тогда
				
				ЗапросГП.УстановитьПараметр("ГоловнойКонтрагент", ЗапросКонтрагенты.Грузополучатель);
				РезультатГП = ЗапросГП.Выполнить();
				
				Если НЕ РезультатГП.Пустой() Тогда
					
					ВыборкаГП = РезультатГП.Выбрать();
					ВыборкаГП.Следующий();
					
					Если ЗапросКонтрагенты.АдресДоставки = "" Тогда
						ОбластьМакета.Параметры.АдресДоставки = МСК.ПолучитьАдресДоставки(ВыборкаГП.Ссылка);
					КонецЕсли;
					
					Если ЗапросКонтрагенты.Тел = "" Тогда
						ОбластьМакета.Параметры.Тел = МСК.ПолучитьТелефоны(ВыборкаГП.Ссылка);
					КонецЕсли; 			
					
				КонецЕсли;			
				
			КонецЕсли;		
			
			ОбластьМакета.Параметры.Возврат = ТекстВозврат;
			
			ТекНом = ТекНом + 1;
			ОбластьМакета.Параметры.Сч = ТекНом;
			ПечСписокДокументов = "";
			ПечСуммаРеализации = 0;			
			ПечСтатусыДоставки = "";
			ПечВремяПередачи   = "";
			
			ПечОплатаНаличными = ?(ЗапросКонтрагенты.ПриемДенег, "Да", "");
			
			ЗапросДок = ЗапросКонтрагенты.Выбрать();
			
			Пока ЗапросДок.Следующий() Цикл
				
				ПечСписокДокументов = ПечСписокДокументов + ?(ЗначениеЗаполнено(ПечСписокДокументов), Символы.ПС, "") + СокрЛП(ЗапросДок.Номер);
				ПечСуммаРеализации  = ПечСуммаРеализации + ЗапросДок.СуммаРеализации; 
				ПечСтатусыДоставки  = ПечСтатусыДоставки + ?(ЗначениеЗаполнено(ПечСтатусыДоставки), Символы.ПС, "") + СокрЛП(ЗапросДок.СтатусДоставки);
				ПечВремяПередачи    = ПечВремяПередачи + ?(ЗначениеЗаполнено(ПечВремяПередачи), Символы.ПС, "") + СокрЛП(ЗапросДок.ВремяПередачи);
				
				Если ЗапросДок.ПриемДенег Тогда 
					ПечОплатаНаличными = "Да";
				КонецЕсли;	
						
			КонецЦикла;	
			
			ПечСписокДокументов	= ПечСписокДокументов + ?(ЗначениеЗаполнено(ПечСписокДокументов), "", СокрЛП(ЗапросКонтрагенты.Номер));
			ПечСуммаРеализации  = ?(ЗначениеЗаполнено(ПечСуммаРеализации), ПечСуммаРеализации, ЗапросКонтрагенты.СуммаРеализации); 
			ПечСтатусыДоставки	= ПечСтатусыДоставки + ?(ЗначениеЗаполнено(ПечСтатусыДоставки), "", СокрЛП(ЗапросКонтрагенты.СтатусДоставки));
			ПечВремяПередачи	= ПечВремяПередачи	+	?(ЗначениеЗаполнено(ПечВремяПередачи), "", СокрЛП(ЗапросКонтрагенты.ВремяПередачи));
			
			ОбластьМакета.Параметры.СуммаРеализации 	= Формат(ПечСуммаРеализации, "ЧЦ=15; ЧДЦ=2"); 
			ОбластьМакета.Параметры.СписокДокументов 	= ПечСписокДокументов;
			ОбластьМакета.Параметры.ПриемДенег		 	= ПечОплатаНаличными;
			ОбластьМакета.Параметры.СтатусДоставки	 	= ПечСтатусыДоставки;
			ОбластьМакета.Параметры.ВремяПередачи	 	= ПечВремяПередачи;
			
			Если ЗапросКонтрагенты.ДокументЧек <> NULL Тогда 				
				
				ОбластьМакета.Параметры.ПКО = ЗапросКонтрагенты.ДокументЧек.Номер;
				ОбластьМакета.Параметры.ПКОСсылка = ЗапросКонтрагенты.ДокументЧек;
				
			КонецЕсли;    		
			
			//+Кабанов А.В. 21.04.2025 # UT10-5202
			Если ЗапросКонтрагенты.ПриемДенег И ЗапросКонтрагенты.СтатусДоставки = Перечисления.СтатусыДоставки.ТоварПередан Тогда 
				
				ЗапросДолга.УстановитьПараметр("Реализация",ЗапросКонтрагенты.Ссылка);
				РезультатЗапросаДолга = ЗапросДолга.Выполнить();
				
				Если НЕ РезультатЗапросаДолга.Пустой() Тогда
					ОбластьМакета.Параметры.ФактОплаты = "ДОЛГ";	
				Иначе
					ОбластьМакета.Параметры.ФактОплаты = "оплачен";	
				КонецЕсли;
				
			КонецЕсли;			
			//-Кабанов А.В. 21.04.2025 # UT10-5202


			ТабДок.Вывести(ОбластьМакета);

			Если ПроверяемДоверенность Тогда
				
				ОбластьМакета = Макет.ПолучитьОбласть("Строка|Доверенности");
				ОбластьМакета.Параметры.Доверенность = ЗапросКонтрагенты.Доверенность;
				ТабДок.Присоединить(ОбластьМакета);
				
			КонецЕсли;			

		КонецЦикла;
		
	КонецЦикла;
	
	ОбластьМакета = Макет.ПолучитьОбласть("СтрокаИтог|Основная");
	ОбластьМакета.Параметры.СуммаПКО = Шапка.СуммаПКО;
	ОбластьМакета.Параметры.СуммаПКОУпр = Шапка.СуммаПКОУпр; 
	ОбластьМакета.Параметры.СуммаПКОВсего = Шапка.СуммаПКО + Шапка.СуммаПКОУпр; 
	
	ТабДок.Вывести(ОбластьМакета);
	
	УниверсальныеМеханизмы.НапечататьДокумент(ТабДок, 1, Ложь, "Отчет о выполнении документа" + ДокСсылка.Метаданные().Представление(), ДокСсылка);
	
КонецПроцедуры

Функция ПолучитьНомерWMSДляГМ(ГрузовоеМесто) Экспорт

	//+Шульман А. 21.02.2025 #UT10-5103 
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ГрузовоеМесто.Сборка КАК Сборка
	|ПОМЕСТИТЬ ВТ_ГрузовоеМесто
	|ИЗ
	|	Документ.ГрузовоеМесто КАК ГрузовоеМесто
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ГрузовоеМесто.Товары КАК ГрузовоеМестоТовары
	|		ПО ГрузовоеМесто.Ссылка = ГрузовоеМестоТовары.Ссылка
	|			И (ГрузовоеМесто.Ссылка = &ГрузовоеМесто)
	|			И (ГрузовоеМестоТовары.Заказ.ВидПроцесса В (ЗНАЧЕНИЕ(Перечисление.ВидыПроцессов.ВозвратНеликвидаТОХчерезWMS), ЗНАЧЕНИЕ(Перечисление.ВидыПроцессов.ВозвратНеликвидаТОХНапрямуюПоставщику)))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаданиеНаДоставкуДоставка.Ссылка.НомерWMS
	|ИЗ
	|	ВТ_ГрузовоеМесто КАК ВТ_ГрузовоеМесто
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаданиеНаДоставку.Доставка КАК ЗаданиеНаДоставкуДоставка
	|		ПО ВТ_ГрузовоеМесто.Сборка = ЗаданиеНаДоставкуДоставка.ДокументСборки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗаданиеНаДоставкуВозвраты.Ссылка.НомерWMS
	|ИЗ
	|	ВТ_ГрузовоеМесто КАК ВТ_ГрузовоеМесто
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаданиеНаДоставку.Возвраты КАК ЗаданиеНаДоставкуВозвраты
	|		ПО ВТ_ГрузовоеМесто.Сборка = ЗаданиеНаДоставкуВозвраты.ДокументСборки";
	
	Запрос.УстановитьПараметр("ГрузовоеМесто", ГрузовоеМесто);
	
	РезультатЗапроса = Запрос.Выполнить();     
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат "";
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();    
	Возврат Выборка.НомерWMS;
	//-Шульман А. 21.02.2025 #UT10-5103 

КонецФункции // ()  

Функция ПолучитьТаблицуМаршрутаДляОтправкиВЭДО(ЗаданиеНаДоставку = Неопределено, МассивСборок = Неопределено) Экспорт 
	//+Белов А. 25.08.2026 #UT10-6004
		
    Запрос = Новый Запрос;
		
	Если ЗаданиеНаДоставку <> Неопределено Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаданиеНаДоставкуДоставка.Контрагент
		|ИЗ
		|	Документ.ЗаданиеНаДоставку.Доставка КАК ЗаданиеНаДоставкуДоставка
		|ГДЕ
		|	ЗаданиеНаДоставкуДоставка.ДокументСборки ССЫЛКА Документ.СборкаЗаказовПокупателя
		|	И ЗаданиеНаДоставкуДоставка.Ссылка = &Ссылка
		|	И ВЫРАЗИТЬ(ЗаданиеНаДоставкуДоставка.ДокументСборки КАК Документ.СборкаЗаказовПокупателя).Договор.ОтправлятьЭТРН";
		
		Запрос.УстановитьПараметр("Ссылка", ЗаданиеНаДоставку);  
		
	Иначе  
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	СборкаЗаказовПокупателя.Контрагент
		|ИЗ
		|	Документ.СборкаЗаказовПокупателя КАК СборкаЗаказовПокупателя
		|ГДЕ
		|	СборкаЗаказовПокупателя.Ссылка В(&МассивСборок)
		|	И СборкаЗаказовПокупателя.Договор.ОтправлятьЭТРН";
		
		Запрос.УстановитьПараметр("МассивСборок", МассивСборок);  
		
	КонецЕсли;
		
	Рез = Запрос.Выполнить().Выгрузить();   
	
	Возврат Рез;
	
	//-Белов А. 25.08.2026 #UT10-6004
КонецФункции 

Функция ПолучитьЗаказЗаявку(ЗаданиеНаДоставку) Экспорт 
//+Белов А. 25.08.2026 #UT10-6004

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказЗаявка.Ссылка
	|ИЗ
	|	Документ.ЗаказЗаявка КАК ЗаказЗаявка
	|ГДЕ
	|	ЗаказЗаявка.ЗаданиеНаДоставку = &Ссылка
	|	И НЕ ЗаказЗаявка.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Ссылка", ЗаданиеНаДоставку);  
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
//-Белов А. 25.08.2026 #UT10-6004
КонецФункции

Функция ПолучитьМассивРеализацийДляОтправкиВЭДО(ЗаданиеНаДоставку) Экспорт
//+Белов А. 25.08.2026 #UT10-6004

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаданиеНаДоставкуДоставка.ДокументСборки КАК Сборка
	|ПОМЕСТИТЬ ВТ_Сборки
	|ИЗ
	|	Документ.ЗаданиеНаДоставку.Доставка КАК ЗаданиеНаДоставкуДоставка
	|ГДЕ
	|	ЗаданиеНаДоставкуДоставка.Ссылка = &ЗаданиеНаДоставку
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.ДокументыСборкиЗаказов КАК РеализацияТоваровУслугДокументыСборкиЗаказов
	|ГДЕ
	|	РеализацияТоваровУслугДокументыСборкиЗаказов.ДокументСборки В
	|			(ВЫБРАТЬ
	|				ВТ_Сборки.Сборка
	|			ИЗ
	|				ВТ_Сборки)
	|	И НЕ РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка.ПометкаУдаления
	|	И РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка.ДоговорКонтрагента.ОтправлятьЭТРН";
	
	Запрос.УстановитьПараметр("ЗаданиеНаДоставку", ЗаданиеНаДоставку);  
	
	Рез = Запрос.Выполнить().Выгрузить();
	
	Возврат Рез.ВыгрузитьКолонку("Ссылка");
	
