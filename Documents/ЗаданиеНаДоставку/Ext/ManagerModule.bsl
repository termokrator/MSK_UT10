
Процедура СформироватьОтчетОВыполнении(ДокСсылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СУММА(ОчередьПечатиККМ.ТекСумма) КАК ТекСумма,
	|	ОчередьПечатиККМ.ТекРеализация,
	|	ОчередьПечатиККМ.ТекКонтрагент
	|ПОМЕСТИТЬ СуммыПКО
	|ИЗ
	|	РегистрСведений.ОчередьПечатиККМ КАК ОчередьПечатиККМ
	|ГДЕ
	|	ОчередьПечатиККМ.ДокументЧек <> ЗНАЧЕНИЕ(Документ.ПриходныйКассовыйОрдер.ПустаяСсылка)
	|	И ОчередьПечатиККМ.ТекЗадание = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ОчередьПечатиККМ.ТекРеализация,
	|	ОчередьПечатиККМ.ТекКонтрагент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОчередьПечатиККМ.ДокументЧек,
	|	ОчередьПечатиККМ.ТекРеализация
	|ПОМЕСТИТЬ НеПроведенныеПКО
	|ИЗ
	|	РегистрСведений.ОчередьПечатиККМ КАК ОчередьПечатиККМ
	|ГДЕ
	|	ОчередьПечатиККМ.ДокументЧек <> ЗНАЧЕНИЕ(Документ.ПриходныйКассовыйОрдер.ПустаяСсылка)
	|	И ОчередьПечатиККМ.ТекЗадание = &Ссылка
	|	И НЕ ОчередьПечатиККМ.ДокументЧек.Проведен
	|
	|СГРУППИРОВАТЬ ПО
	|	ОчередьПечатиККМ.ДокументЧек,
	|	ОчередьПечатиККМ.ТекРеализация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаданиеНаДоставку.Дата,
	|	ЗаданиеНаДоставку.Номер,
	|	ЗаданиеНаДоставку.Маршрут,
	|	ЗаданиеНаДоставку.Водитель,
	|	СУММА(ВЫБОР
	|			КОГДА ОчередьПечатиККМ.ДокументЧек.Организация = КонстОснОрганизация.ОсновнаяОрганизация
	|				ТОГДА ЕСТЬNULL(ОчередьПечатиККМ.ТекСумма, 0)
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СуммаПКО,
	|	СУММА(ВЫБОР
	|			КОГДА НЕ ОчередьПечатиККМ.ДокументЧек.Организация = КонстОснОрганизация.ОсновнаяОрганизация
	|				ТОГДА ЕСТЬNULL(ОчередьПечатиККМ.ТекСумма, 0)
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СуммаПКОУпр
	|ИЗ
	|	Документ.ЗаданиеНаДоставку КАК ЗаданиеНаДоставку
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОчередьПечатиККМ КАК ОчередьПечатиККМ
	|		ПО (ОчередьПечатиККМ.ТекЗадание = ЗаданиеНаДоставку.Ссылка)
	|			И (ОчередьПечатиККМ.ДокументЧек <> ЗНАЧЕНИЕ(Документ.ПриходныйКассовыйОрдер.ПустаяСсылка)),
	|	(ВЫБРАТЬ
	|		Константы.ОсновнаяОрганизация КАК ОсновнаяОрганизация
	|	ИЗ
	|		Константы КАК Константы) КАК КонстОснОрганизация
	|ГДЕ
	|	ЗаданиеНаДоставку.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаданиеНаДоставку.Дата,
	|	ЗаданиеНаДоставку.Номер,
	|	ЗаданиеНаДоставку.Маршрут,
	|	ЗаданиеНаДоставку.Водитель
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаданиеНаДоставкуДоставка.Контрагент КАК Грузополучатель,
	|	СУММА(ЗаданиеНаДоставкуДоставка.Количество) КАК КоличествоМест,
	|	ВЫБОР
	|		КОГДА ЗаданиеНаДоставкуДоставка.Возврат = ИСТИНА
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Возврат,
	|	ЕСТЬNULL(ЗаданиеНаДоставкуДоставка.ДокументСборки.Договор.ОплатаПоДоговоруНаличными, ЛОЖЬ) КАК ПриемДенег,
	|	ЗаданиеНаДоставкуДоставка.Маршрут КАК Маршрут,
	|	Контрагенты.ПриоритетВМаршруте КАК ПриоритетВМаршруте,
	|	РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка,
	|	РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка.Номер КАК Номер,
	|	МИНИМУМ(ЗаданиеНаДоставкуДоставка.НомерСтроки) КАК НомерСтроки,
	|	ВЫБОР
	|		КОГДА РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка ЕСТЬ NULL
	|				И ЗаданиеНаДоставкуДоставка.Отменено
	|			ТОГДА ""Перенос доставки""
	|		ИНАЧЕ ЕСТЬNULL(ЗначенияСвойствОбъектов.Значение, """")
	|	КОНЕЦ КАК СтатусДоставки,
	|	ЕСТЬNULL(ЗначениеВремениПередачи.Значение, """") КАК ВремяПередачи,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА СуммыПКО.ТекРеализация.Организация = КонстОснОрганизация.ОсновнаяОрганизация
	|				ТОГДА ЕСТЬNULL(СуммыПКО.ТекСумма, 0)
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СуммаПКО,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА НЕ СуммыПКО.ТекРеализация.Организация = КонстОснОрганизация.ОсновнаяОрганизация
	|				ТОГДА ЕСТЬNULL(СуммыПКО.ТекСумма, 0)
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СуммаПКОУпр,
	|	НеПроведенныеПКО.ДокументЧек КАК ДокументЧек,
	|	ЕСТЬNULL(РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка.СуммаДокумента, 0) КАК СуммаРеализации,
	|	ВЫРАЗИТЬ(ВЫБОР
	|			КОГДА АдресДоставки.Объект ЕСТЬ NULL
	|				ТОГДА """"
	|			ИНАЧЕ ВЫБОР
	|					КОГДА ПОДСТРОКА(АдресДоставки.Поле4, 1, 100) = """"
	|							И ПОДСТРОКА(АдресДоставки.Поле6, 1, 100) = """"
	|							И ПОДСТРОКА(АдресДоставки.Поле7, 1, 100) = """"
	|							И ПОДСТРОКА(АдресДоставки.Поле8, 1, 100) = """"
	|							И ПОДСТРОКА(АдресДоставки.Поле9, 1, 100) = """"
	|						ТОГДА АдресДоставки.Представление
	|					ИНАЧЕ АдресДоставки.Поле2 + "", "" + АдресДоставки.Поле3 + АдресДоставки.Поле4 + "" "" + АдресДоставки.Поле5 + "", "" + АдресДоставки.Поле6 + "", дом № "" + АдресДоставки.Поле7 + "" "" + ВЫБОР
	|							КОГДА ПОДСТРОКА(АдресДоставки.Поле8, 1, 100) = """"
	|								ТОГДА """"
	|							ИНАЧЕ "" корпус "" + АдресДоставки.Поле8
	|						КОНЕЦ + "" "" + ВЫБОР
	|							КОГДА ПОДСТРОКА(АдресДоставки.Поле9, 1, 100) = """"
	|								ТОГДА """"
	|							ИНАЧЕ "" оф."" + АдресДоставки.Поле9
	|						КОНЕЦ + """"
	|				КОНЕЦ
	|		КОНЕЦ КАК СТРОКА(250)) КАК АдресДоставки,
	|	ВЫРАЗИТЬ(ВЫБОР
	|			КОГДА ТелефонКонтрагента.Объект ЕСТЬ NULL
	|				ТОГДА """"
	|			ИНАЧЕ ТелефонКонтрагента.Представление
	|		КОНЕЦ КАК СТРОКА(100)) КАК Тел,
	|	ВЫБОР
	|		КОГДА КатегорииОбъектов.Объект ЕСТЬ NULL
	|			ТОГДА """"
	|		ИНАЧЕ ""ДА""
	|	КОНЕЦ КАК Доверенность,
	|	ВЫБОР
	|		КОГДА РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка.Организация = КонстОснОрганизация.ОсновнаяОрганизация
	|				И НЕ РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка.ДоговорКонтрагента.РозничнаяПродажа
	|				И НЕ РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка.ДоговорКонтрагента.ЛицевойСчет
	|				И НЕ РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка.ДоговорКонтрагента.Владелец.СтатусФНСКонтрагента = ЗНАЧЕНИЕ(Справочник.СтатусыФНСКонтрагента.КонтрагентЕстьВБазеФНС)
	|			ТОГДА РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка.ДоговорКонтрагента.Владелец.СтатусФНСКонтрагента
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК СтатусФНС
	|ИЗ
	|	Документ.ЗаданиеНаДоставку.Доставка КАК ЗаданиеНаДоставкуДоставка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО ЗаданиеНаДоставкуДоставка.Контрагент = Контрагенты.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК АдресДоставки
	|		ПО (АдресДоставки.Объект = Контрагенты.Ссылка)
	|			И (АдресДоставки.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес))
	|			И (АдресДоставки.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресДоставкиКонтрагента))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК ТелефонКонтрагента
	|		ПО (ТелефонКонтрагента.Объект = Контрагенты.Ссылка)
	|			И (ТелефонКонтрагента.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон))
	|			И (ТелефонКонтрагента.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонКонтрагента))
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.ДокументыСборкиЗаказов КАК РеализацияТоваровУслугДокументыСборкиЗаказов
	|			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|				ЗначенияСвойствОбъектов.Объект КАК Объект,
	|				ЗначенияСвойствОбъектов.Значение КАК Значение
	|			ИЗ
	|				РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	|			ГДЕ
	|				ЗначенияСвойствОбъектов.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СвойстваОбъектов.СтатусДоставки)) КАК ЗначенияСвойствОбъектов
	|			ПО РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка = ЗначенияСвойствОбъектов.Объект
	|			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|				ЗначенияСвойствОбъектов.Объект КАК Объект,
	|				ЗначенияСвойствОбъектов.Значение КАК Значение
	|			ИЗ
	|				РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	|			ГДЕ
	|				ЗначенияСвойствОбъектов.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СвойстваОбъектов.ВремяПередачи)) КАК ЗначениеВремениПередачи
	|			ПО РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка = ЗначениеВремениПередачи.Объект
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КатегорииОбъектов КАК КатегорииОбъектов
	|			ПО РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка = КатегорииОбъектов.Объект
	|				И (КатегорииОбъектов.Категория = ЗНАЧЕНИЕ(Справочник.КатегорииОбъектов.НетАктуальнойДоверенности))
	|		ПО ЗаданиеНаДоставкуДоставка.ДокументСборки = РеализацияТоваровУслугДокументыСборкиЗаказов.ДокументСборки
	|			И (РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка.Проведен)
	|			И (НЕ ЗаданиеНаДоставкуДоставка.Отменено)
	|		ЛЕВОЕ СОЕДИНЕНИЕ СуммыПКО КАК СуммыПКО
	|		ПО (РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка = СуммыПКО.ТекРеализация)
	|		ЛЕВОЕ СОЕДИНЕНИЕ НеПроведенныеПКО КАК НеПроведенныеПКО
	|		ПО (РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка = НеПроведенныеПКО.ТекРеализация),
	|	(ВЫБРАТЬ
	|		Константы.ОсновнаяОрганизация КАК ОсновнаяОрганизация
	|	ИЗ
	|		Константы КАК Константы) КАК КонстОснОрганизация
	|ГДЕ
	|	ЗаданиеНаДоставкуДоставка.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаданиеНаДоставкуДоставка.Контрагент,
	|	Контрагенты.ПриоритетВМаршруте,
	|	ВЫРАЗИТЬ(ВЫБОР
	|			КОГДА ТелефонКонтрагента.Объект ЕСТЬ NULL
	|				ТОГДА """"
	|			ИНАЧЕ ТелефонКонтрагента.Представление
	|		КОНЕЦ КАК СТРОКА(100)),
	|	РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка,
	|	РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка.Номер,
	|	ЕСТЬNULL(ЗаданиеНаДоставкуДоставка.ДокументСборки.Договор.ОплатаПоДоговоруНаличными, ЛОЖЬ),
	|	ВЫБОР
	|		КОГДА ЗаданиеНаДоставкуДоставка.Возврат = ИСТИНА
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ,
	|	ЗаданиеНаДоставкуДоставка.Маршрут,
	|	ЕСТЬNULL(ЗначениеВремениПередачи.Значение, """"),
	|	НеПроведенныеПКО.ДокументЧек,
	|	ЕСТЬNULL(РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка.СуммаДокумента, 0),
	|	ВЫРАЗИТЬ(ВЫБОР
	|			КОГДА АдресДоставки.Объект ЕСТЬ NULL
	|				ТОГДА """"
	|			ИНАЧЕ ВЫБОР
	|					КОГДА ПОДСТРОКА(АдресДоставки.Поле4, 1, 100) = """"
	|							И ПОДСТРОКА(АдресДоставки.Поле6, 1, 100) = """"
	|							И ПОДСТРОКА(АдресДоставки.Поле7, 1, 100) = """"
	|							И ПОДСТРОКА(АдресДоставки.Поле8, 1, 100) = """"
	|							И ПОДСТРОКА(АдресДоставки.Поле9, 1, 100) = """"
	|						ТОГДА АдресДоставки.Представление
	|					ИНАЧЕ АдресДоставки.Поле2 + "", "" + АдресДоставки.Поле3 + АдресДоставки.Поле4 + "" "" + АдресДоставки.Поле5 + "", "" + АдресДоставки.Поле6 + "", дом № "" + АдресДоставки.Поле7 + "" "" + ВЫБОР
	|							КОГДА ПОДСТРОКА(АдресДоставки.Поле8, 1, 100) = """"
	|								ТОГДА """"
	|							ИНАЧЕ "" корпус "" + АдресДоставки.Поле8
	|						КОНЕЦ + "" "" + ВЫБОР
	|							КОГДА ПОДСТРОКА(АдресДоставки.Поле9, 1, 100) = """"
	|								ТОГДА """"
	|							ИНАЧЕ "" оф."" + АдресДоставки.Поле9
	|						КОНЕЦ + """"
	|				КОНЕЦ
	|		КОНЕЦ КАК СТРОКА(250)),
	|	ВЫБОР
	|		КОГДА РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка ЕСТЬ NULL
	|				И ЗаданиеНаДоставкуДоставка.Отменено
	|			ТОГДА ""Перенос доставки""
	|		ИНАЧЕ ЕСТЬNULL(ЗначенияСвойствОбъектов.Значение, """")
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА КатегорииОбъектов.Объект ЕСТЬ NULL
	|			ТОГДА """"
	|		ИНАЧЕ ""ДА""
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка.Организация = КонстОснОрганизация.ОсновнаяОрганизация
	|				И НЕ РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка.ДоговорКонтрагента.РозничнаяПродажа
	|				И НЕ РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка.ДоговорКонтрагента.ЛицевойСчет
	|				И НЕ РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка.ДоговорКонтрагента.Владелец.СтатусФНСКонтрагента = ЗНАЧЕНИЕ(Справочник.СтатусыФНСКонтрагента.КонтрагентЕстьВБазеФНС)
	|			ТОГДА РеализацияТоваровУслугДокументыСборкиЗаказов.Ссылка.ДоговорКонтрагента.Владелец.СтатусФНСКонтрагента
	|		ИНАЧЕ """"
	|	КОНЕЦ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
