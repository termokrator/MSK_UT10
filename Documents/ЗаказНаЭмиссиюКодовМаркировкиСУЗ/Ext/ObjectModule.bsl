
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	СтруктураОбязательныхПолей = Новый Структура("Организация, ВидПродукции, СпособИзготовления, СпособВводаВОборот");
	
	Заголовок = "Уажите реквизиты шапки документа";
	
	ЗаполнениеДокументов.ПроверитьЗаполнениеШапкиДокумента(ЭтотОбъект, СтруктураОбязательныхПолей, Отказ, Заголовок);
	
	Заголовок = "Уажите реквизиты табличной части товары документа";

	СтруктураОбязательныхПолей = Новый Структура("Номенклатура, GTIN, Количество ");

	ЗаполнениеДокументов.ПроверитьЗаполнениеТабличнойЧасти(ЭтотОбъект, "Товары", СтруктураОбязательныхПолей, Отказ, Заголовок);

	Если Товары.Количество() = 0 Тогда
		
		ОбщегоНазначения.СообщитьИнформациюПользователю("Не заполнена табличная часть товары");
		
		Отказ = ИСТИНА;
		
	КонецЕсли;

КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если Статус = Перечисления.СтатусыЗаказаНаМаркировку.Отправлен Тогда
		
		//Маркировка.СоздатьИсходящееСообщениеМаркировка(ЭтотОбъект.Ссылка);

	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Если ДанныеЗаполнения = Неопределено Тогда Возврат; КонецЕсли;

	ЭтотОбъект.Основание = ДанныеЗаполнения.Ссылка;
	ЗаполнитьЗначенияСвойств(ЭтотОбъект,ДанныеЗаполнения);
	ЭтотОбъект.Номер = "";
	ЭтотОбъект.Дата = ТекущаяДата();

	Для Каждого СтрокаТовары ИЗ ДанныеЗаполнения.Товары Цикл
		
		НоваяСтрокаТовары = ЭтотОбъект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаТовары,СтрокаТовары);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Если Статус = Перечисления.СтатусыЗаказаНаМаркировку.Обработан Тогда
		
		Если ЗначениеЗаполнено(Основание) Тогда
			
			МаркировкаОбъект = Основание.ПолучитьОбъект();
			МаркировкаОбъект.Статус = Перечисления.СтатусыМаркировкиТоваров.Нанесение;
			МаркировкаОбъект.Записать(); 
			
		КонецЕсли;  
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОтчетОНанесенииКИЗ.Ссылка
		|ИЗ
		|	Документ.ОтчетОНанесенииКИЗ КАК ОтчетОНанесенииКИЗ
		|ГДЕ
		|	ОтчетОНанесенииКИЗ.Основание = &Основание
		|	И ОтчетОНанесенииКИЗ.Проведен";
		
		Запрос.УстановитьПараметр("Основание", Ссылка);
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			
			НовыйДокументЗНЭ = Документы.ОтчетОНанесенииКИЗ.СоздатьДокумент();	
			//+Пашкин О.А. 01.08.2025 # UT10-5358
			НовыйДокументЗНЭ.Заполнить(Ссылка);
			//-Пашкин О.А. 01.08.2025 # UT10-5358
			НовыйДокументЗНЭ.Записать(РежимЗаписиДокумента.Проведение);
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
