	|	Таб.Ячейка КАК Ячейка,
	|	СУММА(Таб.Количество) КАК Количество,
	|	СУММА(Таб.КоличествоВДокументе) КАК КоличествоВДокументе
	|ПОМЕСТИТЬ ТабРезультата
	|ИЗ
	|	(ВЫБРАТЬ
	|		ТоварыВЯчейках.Склад КАК Склад,
	|		ТоварыВЯчейках.Номенклатура КАК Номенклатура,
	|		ТоварыВЯчейках.Ячейка КАК Ячейка,
	|		-ТоварыВЯчейках.Количество КАК Количество,
	|		0 КАК КоличествоВДокументе
	|	ИЗ
	|		РегистрНакопления.ТоварыВЯчейках КАК ТоварыВЯчейках
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Корректировки КАК Корректировки
	|			ПО ТоварыВЯчейках.Регистратор = Корректировки.Ссылка
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ДвиженияТоварыВЯчейках.Склад,
	|		ДвиженияТоварыВЯчейках.Номенклатура,
	|		ДвиженияТоварыВЯчейках.Ячейка,
	|		ДвиженияТоварыВЯчейках.Количество,
	|		0
	|	ИЗ
	|		ДвиженияТоварыВЯчейках КАК ДвиженияТоварыВЯчейках
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ТабТовары.Склад,
	|		ТабТовары.Номенклатура,
	|		ТабТовары.Ячейка,
	|		0,
	|		ТабТовары.Количество
	|	ИЗ
	|		ТабДокумента КАК ТабТовары) КАК Таб
	|
	|СГРУППИРОВАТЬ ПО
	|	Таб.Склад,
	|	Таб.Номенклатура,
	|	Таб.Ячейка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таб2.ЗаказПокупателя КАК ЗаказПокупателя,
	|	Таб2.Номенклатура КАК Номенклатура,
	|	СУММА(Таб2.Количество) КАК Количество,
	|	СУММА(Таб2.КоличествоВДокументе) КАК КоличествоВДокументе,
	|	СУММА(Таб2.КоличествоСДокументом) КАК КоличествоСДокументом
	|ПОМЕСТИТЬ ТабРезультатаТоварыКсборке
	|ИЗ
	|	(ВЫБРАТЬ
	|		ТоварыГотовыеКСборке.ЗаказПокупателя КАК ЗаказПокупателя,
	|		ТоварыГотовыеКСборке.Номенклатура КАК Номенклатура,
	|		-ТоварыГотовыеКСборке.Количество КАК Количество,
	|		0 КАК КоличествоВДокументе,
	|		-ТоварыГотовыеКСборке.Количество КАК КоличествоСДокументом
	|	ИЗ
	|		РегистрНакопления.ТоварыГотовыеКСборке КАК ТоварыГотовыеКСборке
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Корректировки КАК Корректировки
	|			ПО ТоварыГотовыеКСборке.Регистратор = Корректировки.Ссылка
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ДвиженияТоварыГотовыеКСборке.ЗаказПокупателя,
	|		ДвиженияТоварыГотовыеКСборке.Номенклатура,
	|		ДвиженияТоварыГотовыеКСборке.Количество,
	|		0,
	|		ДвиженияТоварыГотовыеКСборке.Количество
	|	ИЗ
	|		ДвиженияТоварыГотовыеКСборке КАК ДвиженияТоварыГотовыеКСборке
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ТабТовары.ЗаказПокупателя,
	|		ТабТовары.Номенклатура,
	|		0,
	|		ТабТовары.Количество,
	|		-ТабТовары.Количество
	|	ИЗ
	|		ТабДокумента КАК ТабТовары) КАК Таб2
	|
	|СГРУППИРОВАТЬ ПО
	|	Таб2.ЗаказПокупателя,
	|	Таб2.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабРезультата.Склад,
	|	ТабРезультата.Номенклатура,
	|	ТабРезультата.Ячейка,
	|	ТабРезультата.Количество,
	|	ТабРезультата.КоличествоВДокументе,
	|	ВЫБОР
	|		КОГДА ТабРезультата.Количество - ТабРезультата.КоличествоВДокументе < 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЕстьОшибкиПревышенияКоличества
	|ИЗ
	|	ТабРезультата КАК ТабРезультата
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДвиженияТоварыВЯчейках КАК ДвиженияТоварыВЯчейках
	|		ПО ТабРезультата.Склад = ДвиженияТоварыВЯчейках.Склад
	|			И ТабРезультата.Ячейка = ДвиженияТоварыВЯчейках.Ячейка
	|			И ТабРезультата.Номенклатура = ДвиженияТоварыВЯчейках.Номенклатура
	|ГДЕ
	|	ТабРезультата.Количество - ТабРезультата.КоличествоВДокументе < 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабРезультатаТоварыКсборке.ЗаказПокупателя,
	|	ТабРезультатаТоварыКсборке.Номенклатура,
	|	ТабРезультатаТоварыКсборке.Количество,
	|	ТабРезультатаТоварыКсборке.КоличествоВДокументе,
	|	ВЫБОР
	|		КОГДА ТабРезультатаТоварыКсборке.Количество - ТабРезультатаТоварыКсборке.КоличествоВДокументе < 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЕстьОшибкиПревышенияКоличества
	|ИЗ
	|	ТабРезультатаТоварыКсборке КАК ТабРезультатаТоварыКсборке
	|ГДЕ
	|	ТабРезультатаТоварыКсборке.Количество - ТабРезультатаТоварыКсборке.КоличествоВДокументе < 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабРезультатаТоварыКсборке.ЗаказПокупателя,
	|	ТабРезультатаТоварыКсборке.Номенклатура,
	|	ТабРезультатаТоварыКсборке.КоличествоСДокументом
	|ИЗ
	|	ТабРезультатаТоварыКсборке КАК ТабРезультатаТоварыКсборке
	|ГДЕ
	|	ТабРезультатаТоварыКсборке.КоличествоСДокументом > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабДокумента.Ссылка,
	|	ТабДокумента.Контрагент,
	|	ТабДокумента.ЗаказПокупателя,
	|	ТабДокумента.Номенклатура,
	|	ТабДокумента.Причина,
	|	СУММА(ТабДокумента.Количество) КАК Количество
	|ПОМЕСТИТЬ ТабДокументаГруппа
	|ИЗ
	|	ТабДокумента КАК ТабДокумента
	|
	|СГРУППИРОВАТЬ ПО
	|	ТабДокумента.Ссылка,
	|	ТабДокумента.Контрагент,
	|	ТабДокумента.ЗаказПокупателя,
	|	ТабДокумента.Номенклатура,
	|	ТабДокумента.Причина
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабДокументаГруппа.ЗаказПокупателя,
	|	ТабДокументаГруппа.Номенклатура,
	|	ЕСТЬNULL(ТоварыВСборкеОбороты.СобраноРасход, 0) КАК Количество,
	|	ТабДокументаГруппа.Количество КАК КоличествоВДокументе
	|ИЗ
	|	ТабДокументаГруппа КАК ТабДокументаГруппа
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВСборке.Обороты(
	|				,
	|				&ДатаОстатков,
	|				Регистратор,
	|				(Сборка, Контрагент, ЗаказПокупателя, Номенклатура) В
	|					(ВЫБРАТЬ
	|						ТабДокумента.Ссылка,
	|						ТабДокумента.Контрагент,
	|						ТабДокумента.ЗаказПокупателя,
	|						ТабДокумента.Номенклатура
	|					ИЗ
	|						ТабДокумента КАК ТабДокумента)) КАК ТоварыВСборкеОбороты
	|		ПО ТабДокументаГруппа.Ссылка = ТоварыВСборкеОбороты.Сборка
	|			И ТабДокументаГруппа.Контрагент = ТоварыВСборкеОбороты.Контрагент
	|			И ТабДокументаГруппа.ЗаказПокупателя = ТоварыВСборкеОбороты.ЗаказПокупателя
	|			И ТабДокументаГруппа.Номенклатура = ТоварыВСборкеОбороты.Номенклатура
	|ГДЕ
	|	ТабДокументаГруппа.Количество > 0";  
	
	Запрос.УстановитьПараметр("Сборка", СборкаЗаказовПокупателя);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("ДатаОстатков", ТекущаяДата());
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка  Тогда
		Возврат;
	КонецЕсли;  
	
	Если Не ДополнительныеСвойства.Свойство("НеПроверятьНоменклатуруНаКратность") Тогда
		
		ДатаНачалаПроверкиКратностиНоменклатуры = Константы.ДатаНачалаПроверкиКратностиНоменклатуры.Получить();
		
		Если РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения И 
			ЗначениеЗаполнено(ДатаНачалаПроверкиКратностиНоменклатуры) И 
			НачалоДня(ДатаНачалаПроверкиКратностиНоменклатуры) <= НачалоДня(Дата) Тогда
			
			ТаблицаТоваров = Товары.Выгрузить(,"Номенклатура,Количество");  
			ТаблицаТоваров.Очистить();
			
			Для Каждого СтрокаТовары Из Товары Цикл
				
				Если МСК.НеобходимоПроверятьКратностьВЗаказе(СтрокаТовары.ЗаказПокупателя) Тогда
					
					НоваяСтрока = ТаблицаТоваров.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТовары);
					
				КонецЕсли; 			
				
			КонецЦикла;	
			
			ТаблицаТоваров.Свернуть("Номенклатура", "Количество");
			
			Для каждого ТекСтр Из ТаблицаТоваров  Цикл
				
				Если МСК.ПроверкаНоменклатурыНаКратность(ТекСтр.Номенклатура,ТекСтр.Количество) = Ложь Тогда 
					
					Отказ = Истина;
					Сообщить("Для номенклатуры " + ТекСтр.Номенклатура + ", Ошибка в КРАТНОСТИ!");
					
				КонецЕсли;
				
			КонецЦикла; 
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Отказ Тогда 
		Возврат;
	КонецЕсли;
	
	Если РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения Тогда 
		
		ТекстОтвета = МСК.ПроверкаНаСтороннийСклад(ЭтотОбъект);
		
		Если ТекстОтвета <> ""  Тогда 
			
			#Если Клиент Тогда
				Предупреждение(ТекстОтвета);
			#КонецЕсли
			
			Отказ = Истина;
			Возврат;
			
		КонецЕсли;
		
		Если Дата >= Константы.ДатаНачалаПроведенияКорректировкиСборкиПоРегиструТоварыВЯчейкахСУчетомИсполнено.Получить() Тогда 
			
			Если ПоискПричиныПоТабличнойЧастиТовары() = 0 Тогда
				Исполнено = Истина;
			Иначе
				
				Если ЗначениеЗаполнено(Ссылка) Тогда 
					
					Запрос = Новый Запрос;
					Запрос.Текст = 
					"ВЫБРАТЬ
					|	НапечатанныеДокументы.Документ,
					|	НапечатанныеДокументы.Макет,
					|	НапечатанныеДокументы.Ответственный,
					|	НапечатанныеДокументы.ДатаПечати,
					|	НапечатанныеДокументы.СинонимМакета
					|ИЗ
					|	РегистрСведений.НапечатанныеДокументы КАК НапечатанныеДокументы
					|ГДЕ
					|	НапечатанныеДокументы.Документ = &Документ
					|	И НапечатанныеДокументы.Макет = &Макет";
					
					Запрос.УстановитьПараметр("Документ", Ссылка);
					Запрос.УстановитьПараметр("Макет", "ЗаданиеНаРазбор");
					
					РезультатЗапроса = Запрос.Выполнить();
					Исполнено = НЕ РезультатЗапроса.Пустой();
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если РежимЗаписи <> РежимЗаписиДокумента.Запись Тогда 
		
		Если НЕ ЗначениеЗаполнено(Организация) Тогда 
			
			Отказ = Истина;
			Сообщить("Не заполнено поле 'Организация'");
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Контрагент) Тогда 
			
			Отказ = Истина;
			Сообщить("Не заполнено поле 'Контрагент'");
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Ответственный) Тогда 
			
			Если Исполнено  Тогда 
				
				Отказ = Истина;
				Сообщить("Не заполнено поле 'Ответственный'");
				
			Иначе
				
				Если НЕ РольДоступна("РедактированиеДокументовСборки") Тогда 
					
					Отказ = Истина;
					Сообщить("Не заполнено поле 'Ответственный'");
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Грузополучатель) Тогда 
		Грузополучатель = СборкаЗаказовПокупателя.Грузополучатель;
	КонецЕсли;	
	
	Для Каждого Стр из Товары Цикл 
		
		Если НЕ ЗначениеЗаполнено(Стр.Причина) Тогда 
			
			Отказ = Истина;
			Сообщить("В строке " + Стр.НомерСтроки + " не заполнена причина корректировки!");
			
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(Стр.Ячейка) Тогда 
			
			Отказ = Истина;
			Сообщить("В строке " + Стр.НомерСтроки + " не заполнена ячейка!");
			
		КонецЕсли;

	КонецЦикла;
	
	Если ЗначениеЗаполнено(СборкаЗаказовПокупателя) 
		И СборкаЗаказовПокупателя.ПолностьюОткорректирована 
		И РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения 
		Тогда 
		
		ОбъектСборка = СборкаЗаказовПокупателя.ПолучитьОбъект();
		ОбъектСборка.ДополнительныеСвойства.Вставить("НеВыполнятьПроверкуНаДатыЗапрета", Истина); 
		ОбъектСборка.ПолностьюОткорректирована = Ложь;
		ОбъектСборка.Записать(РежимЗаписиДокумента.Запись);
		
	КонецЕсли;
	
	Если ЭтоНовый()	Тогда 
		ОткорректированНеСобранным = НЕ СборкаЗаказовПокупателя.ДокументСобранИУпакован;
	КонецЕсли;	 
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	СборкаЗаказовПокупателя = "";

КонецПроцедуры

Процедура СоздатьКорректировкиЗаказа(ВыводитьСообщение = Ложь) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущийДокумент", Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КорректировкаСборкиЗаказовПокупателяТовары.ЗаказПокупателя  КАК ЗаказПокупателя
	|ИЗ
	|	Документ.КорректировкаСборкиЗаказовПокупателя.Товары КАК КорректировкаСборкиЗаказовПокупателяТовары
	|ГДЕ
	|	КорректировкаСборкиЗаказовПокупателяТовары.Ссылка = &ТекущийДокумент";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НовыйДок = Документы.КорректировкаЗаказаПокупателя.СоздатьДокумент();
		НовыйДок.Дата = ТекущаяДата() + 1;
		
		СтруктураЗаполнения = Новый Структура;
		СтруктураЗаполнения.Вставить("ДокументОснование", Выборка.ЗаказПокупателя);
		СтруктураЗаполнения.Вставить("КорректировкаСборки", Ссылка);
		СтруктураЗаполнения.Вставить("ТипЗаполнения", "ПоКорректировкеСборки");
		
		
		НовыйДок.Заполнить(СтруктураЗаполнения);
		
		Если НовыйДок.Товары.Количество()= 0 Тогда 
			
			Если ВыводитьСообщение Тогда 
				Сообщить("Для заказа " + Выборка.ЗаказПокупателя + " создание корректировки заказа не требуется.");
			КонецЕсли;
			
		Иначе

			Попытка  
				
				Если ДополнительныеСвойства.Свойство("НеПроверятьНоменклатуруНаКратность") Тогда
					НовыйДок.ДополнительныеСвойства.Вставить("НеПроверятьНоменклатуруНаКратность", Истина);
				КонецЕсли;
				
				НовыйДок.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("создана " + Строка(НовыйДок.Ссылка) + " к документу " + Строка(Выборка.ЗаказПокупателя));
				НовыйДок.СоздатьПеремещения(Ложь, Истина);

			Исключение
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка при создании корректировки заказа покупателя. Проверьте и проведите документ вручную!");
				НовыйДок.ПолучитьФорму("ФормаДокумента").Открыть();  
				
				//+Гавриленков В. 07.11.2025 #UT10-5497
				ЗаписьЖурналаРегистрации("Создание Корректировки заказа", УровеньЖурналаРегистрации.Ошибка, Метаданные.Документы.КорректировкаСборкиЗаказовПокупателя,, "Ошибка при создании корректировки заказа покупателя: " + ОписаниеОшибки());
				//-Гавриленков В. 07.11.2025 #UT10-5497
				
			КонецПопытки

		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // СоздатьКорректировкиЗаказа()

Процедура ПроверитьПолностьюОткорректирована()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТоварыВСборкеОстатки.Сборка,
	|	ТоварыВСборкеОстатки.Контрагент,
	|	ТоварыВСборкеОстатки.ЗаказПокупателя,
	|	ТоварыВСборкеОстатки.Номенклатура,
	|	ТоварыВСборкеОстатки.СобраноОстаток,
	|	ТоварыВСборкеОстатки.СуммаСобраноОстаток,
	|	ТоварыВСборкеОстатки.КСборкеОстаток,
	|	ТоварыВСборкеОстатки.СуммаКСборкеОстаток
	|ИЗ
	|	РегистрНакопления.ТоварыВСборке.Остатки(, Сборка = &СборкаОснование) КАК ТоварыВСборкеОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыВСборке.Регистратор,
	|	ТоварыВСборке.Сборка,
	|	ТоварыВСборке.Контрагент,
	|	ТоварыВСборке.ЗаказПокупателя,
	|	ТоварыВСборке.Номенклатура,
	|	ТоварыВСборке.Собрано,
	|	ТоварыВСборке.КСборке,
	|	ТоварыВСборке.СуммаКСборке,
	|	ТоварыВСборке.Причина
	|ИЗ
	|	РегистрНакопления.ТоварыВСборке КАК ТоварыВСборке
	|ГДЕ
	|	ТоварыВСборке.Сборка = &СборкаОснование
	|	И НЕ ТоварыВСборке.Регистратор ССЫЛКА Документ.КорректировкаСборкиЗаказовПокупателя
	|	И ТоварыВСборке.Активность
	|	И ТоварыВСборке.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)";
	
	Запрос.УстановитьПараметр("СборкаОснование", СборкаЗаказовПокупателя);
	
	Пакет = Запрос.ВыполнитьПакет();
	
	ТабОстатков	= Пакет[0].Выгрузить();
	ТабКорректировок	= Пакет[1].Выгрузить();
	ПолностьОткорректирована = Ложь;
	
	Если ТабОстатков.Количество() = 0 И ТабКорректировок.Количество()= 0 Тогда
		ПолностьОткорректирована = Истина;
	КонецЕсли;	
	
	Если СборкаЗаказовПокупателя.ПолностьюОткорректирована <> ПолностьОткорректирована  Тогда 
		
		ОбъектСборка = СборкаЗаказовПокупателя.ПолучитьОбъект();
		ОбъектСборка.ДополнительныеСвойства.Вставить("НеВыполнятьПроверкуНаДатыЗапрета", Истина); 
		ОбъектСборка.ПолностьюОткорректирована = ПолностьОткорректирована;

		Если ОбъектСборка.Проведен Тогда
			ОбъектСборка.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			ОбъектСборка.Записать(РежимЗаписиДокумента.Запись); 
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // ПроверитьПолностьюОткорректирована()

Функция ПровестиИСоздатьКорректировкиЗаказа() Экспорт
	
	Попытка
		
		Записать(РежимЗаписиДокумента.Проведение);
		ПроверитьПолностьюОткорректирована();
		
		Если Дата >= Константы.ДатаНачалаПроведенияКорректировкиСборкиПоРегиструТоварыВЯчейкахСУчетомИсполнено.Получить() Тогда 
			
			Если Исполнено Тогда 
				СоздатьКорректировкиЗаказа(Истина);
			КонецЕсли;
			
		Иначе
			СоздатьКорректировкиЗаказа(Истина);
		КонецЕсли;
		
		Возврат Истина;
		
	Исключение   
		
		#Если Клиент Тогда
			Сообщить(ОписаниеОшибки());
		#КонецЕсли
		
		//+Гавриленков В. 07.11.2025 #UT10-5497
		ЗаписьЖурналаРегистрации("Создание Корректировки заказа", УровеньЖурналаРегистрации.Ошибка, Метаданные.Документы.КорректировкаСборкиЗаказовПокупателя,, ОписаниеОшибки());
		//-Гавриленков В. 07.11.2025 #UT10-5497
			
		Возврат Ложь; 
		
	КонецПопытки;
	
КонецФункции 

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	//Если РольДоступна("РедактированиеДокументовСборки") И Не Исполнено Тогда 
	//	МассивНепроверяемыхРеквизитов = Новый Массив;
	//	МассивНепроверяемыхРеквизитов.Добавить("Ответственный");
	//	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	//КонецЕсли;
	
КонецПроцедуры

#Если Клиент Тогда
	Процедура Печать(ИмяМакета, КоличествоЭкземпляров = 1, НаПринтер = Ложь, НеВыводитьДиалогВыбораОтветственного = Ложь, _Ответственный = Неопределено) Экспорт
		
		Если ЭтоНовый() Тогда
			Предупреждение("Документ можно распечатать только после его записи");
			Возврат;
		ИначеЕсли Не УправлениеДопПравамиПользователей.РазрешитьПечатьНепроведенныхДокументов(Проведен) Тогда
			Предупреждение("Недостаточно полномочий для печати непроведенного документа!");
			Возврат;
		КонецЕсли;
		
		Если Не РаботаСДиалогами.ПроверитьМодифицированность(ЭтотОбъект) Тогда
			Возврат;
		КонецЕсли;
		
		Если ИмяМакета = "Ячейки" Тогда
			ТабДокумент = ПечатьПоЯчейкам();
		ИначеЕсли ИмяМакета = "ЗаданиеНаРазбор" Тогда
			
			Если НеВыводитьДиалогВыбораОтветственного Тогда
				
				ТабДокумент = ПечатьЗаданияНаРазбор(КоличествоЭкземпляров);
				
				Если Константы.ОбъединятьСборкиПриПечати.Получить() Тогда
					КоличествоЭкземпляров = 1;
				КонецЕсли;

			Иначе
				
				ВыбОтветственный = Ответственный;

				Если ЗначениеЗаполнено(_Ответственный) Тогда
					
					Если _Ответственный <> Ответственный Тогда
						Ответственный = _Ответственный;
					КонецЕсли;

					ТабДокумент = ПечатьЗаданияНаРазбор(КоличествоЭкземпляров);									
					
					Если Константы.ОбъединятьСборкиПриПечати.Получить() Тогда
						КоличествоЭкземпляров = 1;
					КонецЕсли;  

					ПровестиИСоздатьКорректировкиЗаказа();
					
				Иначе
					
					Если ВвестиЗначение(ВыбОтветственный, "Укажите ответственного", ) Тогда
						
						Если ВыбОтветственный <> Ответственный  Тогда 
							Ответственный = ВыбОтветственный;
						КонецЕсли;

						ТабДокумент = ПечатьЗаданияНаРазбор(КоличествоЭкземпляров);
						
						Если Константы.ОбъединятьСборкиПриПечати.Получить() Тогда
							КоличествоЭкземпляров = 1;
						КонецЕсли;

						ПровестиИСоздатьКорректировкиЗаказа();
						
					КонецЕсли;
					
				КонецЕсли;

			КонецЕсли;
			
		КонецЕсли;
		
		Если ТабДокумент <> 0 Тогда 
			УниверсальныеМеханизмы.НапечататьДокумент(ТабДокумент, КоличествоЭкземпляров, НаПринтер, ОбщегоНазначения.СформироватьЗаголовокДокумента(ЭтотОбъект), Ссылка);
		КонецЕсли;
		
	КонецПроцедуры // Печать
#КонецЕсли

// Возвращает доступные варианты печати документа
//
// Вовращаемое значение:
//  Струткура, каждая строка которой соответствует одному из вариантов печати
//  
Функция ПолучитьСтруктуруПечатныхФорм() Экспорт
	
	СтруктураМакетов = Новый Структура;
	СтруктураМакетов.Вставить("Ячейки", "Номенклатура по ячейкам");
	
	Если Дата >= Константы.ДатаНачалаПроведенияКорректировкиСборкиПоРегиструТоварыВЯчейкахСУчетомИсполнено.Получить() Тогда 
		СтруктураМакетов.Вставить("ЗаданиеНаРазбор", "Задание на разбор");
	КонецЕсли;
	
	Возврат СтруктураМакетов;
	
КонецФункции // ПолучитьСтруктуруПечатныхФорм()

Функция ПечатьПоЯчейкам()
	
	Если ЭтоНовый() Тогда
		Записать();
	КонецЕсли;
	
	Макет = ПолучитьМакет("Ячейки");
	ТабДок  = Новый ТабличныйДокумент;
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	ОбластьМакета.Параметры.Номер = Ссылка.Номер;
	ОбластьМакета.Параметры.Дата = Формат(Ссылка.Дата,"ДЛФ=D");
	ОбластьМакета.Параметры.Клиент = Ссылка.Контрагент;
	ТабДок.Вывести(ОбластьМакета);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТоварыВЯчейкахОстаткиИОбороты.Номенклатура.Родитель КАК НоменклатураРодитель,
	|	ТоварыВЯчейкахОстаткиИОбороты.Номенклатура.КодПроизводителя КАК КодПроизводителя,
	|	ТоварыВЯчейкахОстаткиИОбороты.Номенклатура КАК Номенклатура,
	|	ТоварыВЯчейкахОстаткиИОбороты.Ячейка КАК Ячейка,
	|	ТоварыВЯчейкахОстаткиИОбороты.Склад,
	|	ТоварыВЯчейкахОстаткиИОбороты.КоличествоПриход,
	|	ТоварыВЯчейкахОстаткиИОбороты.КоличествоКонечныйОстаток
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.ОстаткиИОбороты(, , Регистратор, , Номенклатура В (&МассивНоменклатуры)) КАК ТоварыВЯчейкахОстаткиИОбороты
	|ГДЕ
	|	ТоварыВЯчейкахОстаткиИОбороты.Регистратор = &Регистратор
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТоварыВЯчейкахОстаткиИОбороты.Ячейка.Код УБЫВ,
	|	НоменклатураРодитель,
	|	КодПроизводителя"; 
	
	
	Запрос.УстановитьПараметр("Регистратор", Ссылка);
	Запрос.УстановитьПараметр("МассивНоменклатуры", Товары.ВыгрузитьКолонку("Номенклатура"));
	
	Результат = Запрос.Выполнить();
	ВыборкаНоменклатура = Результат.Выбрать();
	Сч = 1;
	
	Пока ВыборкаНоменклатура.Следующий() Цикл
		
		ОбластьМакета = Макет.ПолучитьОбласть("Строка");
		ОбластьМакета.Параметры.Папа 				= ВыборкаНоменклатура.НоменклатураРодитель;
		ОбластьМакета.Параметры.КодПроизводителя	= ВыборкаНоменклатура.КодПроизводителя;
		ОбластьМакета.Параметры.Номенклатура 		= ВыборкаНоменклатура.Номенклатура;
		ОбластьМакета.Параметры.Ячейка     			= ВыборкаНоменклатура.Ячейка;
		ОбластьМакета.Параметры.Кол	          		= ВыборкаНоменклатура.КоличествоПриход;
		ОбластьМакета.Параметры.ОстатокВЯчейке   	= ВыборкаНоменклатура.КоличествоКонечныйОстаток;
		ОбластьМакета.Параметры.Сч = Сч;
		ТабДок.Вывести(ОбластьМакета);
		Сч  = Сч + 1;
		
	КонецЦикла;
	
	Возврат ТабДок;
	
КонецФункции

Функция ПечатьЗаданияНаРазбор(КолЭкземпляров = 1) Экспорт
	
	Если ПоискПричиныПоТабличнойЧастиТовары() = 0 Тогда 

		Сообщить("Печать задания на разбор не требуется");
		Возврат 0;
		
	КонецЕсли;

	ТабДокСводный = Новый ТабличныйДокумент;
	ТабДокСводный.ПолеСлева = 1;
	ТабДокСводный.ПолеСправа = 1;
	ТабДокСводный.ПолеСнизу = 1; 
	ТабДокСводный.ПолеСверху = 1; 
	ТабДокСводный.АвтоМасштаб = Истина;
	ОбъединяемНаОдинЛист = Ложь;
	КоличествоСтрок = Товары.Количество();
	
	Если Константы.ОбъединятьСборкиПриПечати.Получить() И КолЭкземпляров > 1 Тогда
		
		ОбъединяемНаОдинЛист = Истина;
		МассивВыводимыхОбластей = Новый Массив;
		
	КонецЕсли;

	Макет = ПолучитьМакет("ЗаданиеНаРазбор");
	
	ТабДокумент = Новый ТабличныйДокумент;
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	ОбластьМакета.Параметры.Номер = Номер;
	ОбластьМакета.Параметры.Дата = Дата;
	ОбластьМакета.Параметры.НомерСборки = СборкаЗаказовПокупателя.Номер;
	ОбластьМакета.Параметры.ДатаСборки = СборкаЗаказовПокупателя.Дата;
	ОбластьМакета.Параметры.Грузополучатель = СборкаЗаказовПокупателя.Грузополучатель;
	ОбластьМакета.Параметры.ИнформацияОМаршруте = ?(СборкаЗаказовПокупателя.СпособДоставки = Перечисления.СпособДоставки.Самовывоз, 
	                     "САМОВЫВОЗ", "Маршрут: " + СборкаЗаказовПокупателя.МаршрутДоставки);
	
	ТабДокумент.Вывести(ОбластьМакета);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	КорректировкаСборкиЗаказовПокупателяТовары.Номенклатура,
	|	КорректировкаСборкиЗаказовПокупателяТовары.Ячейка,
	|	СУММА(КорректировкаСборкиЗаказовПокупателяТовары.Количество) КАК Кол,
	|	КорректировкаСборкиЗаказовПокупателяТовары.Номенклатура.Родитель КАК Папа,
	|	КорректировкаСборкиЗаказовПокупателяТовары.Номенклатура.КодПроизводителя КАК КодП,
	|	КорректировкаСборкиЗаказовПокупателяТовары.Номенклатура.ЕдиницаХраненияОстатков КАК ЕдИзм
	|ИЗ
	|	Документ.КорректировкаСборкиЗаказовПокупателя.Товары КАК КорректировкаСборкиЗаказовПокупателяТовары
	|ГДЕ
	|	КорректировкаСборкиЗаказовПокупателяТовары.Ссылка = &Ссылка
	|	И ( КорректировкаСборкиЗаказовПокупателяТовары.Причина = ЗНАЧЕНИЕ(Перечисление.ПричиныКорректировкиСборки.ОтказКлиента)				   
	|        ИЛИ  КорректировкаСборкиЗаказовПокупателяТовары.Причина = ЗНАЧЕНИЕ(Перечисление.ПричиныКорректировкиСборки.ОтказПоставщика) )  
	|
	|СГРУППИРОВАТЬ ПО
	|	КорректировкаСборкиЗаказовПокупателяТовары.Номенклатура,
	|	КорректировкаСборкиЗаказовПокупателяТовары.Ячейка,
	|	КорректировкаСборкиЗаказовПокупателяТовары.Номенклатура.Родитель,
	|	КорректировкаСборкиЗаказовПокупателяТовары.Номенклатура.КодПроизводителя,
	|	КорректировкаСборкиЗаказовПокупателяТовары.Номенклатура.ЕдиницаХраненияОстатков
	|
	|УПОРЯДОЧИТЬ ПО
	|	Папа,
	|	КодП
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	ТоварыКРазбору = Запрос.Выполнить().Выгрузить();
	Сч = 1;
	
	Для каждого ТекСтр  Из ТоварыКРазбору Цикл
		
		ОбластьМакета = Макет.ПолучитьОбласть("Строка");
		ОбластьМакета.Параметры.Сч  = Сч;
		ОбластьМакета.Параметры.Заполнить(ТекСтр);
		ТабДокумент.Вывести(ОбластьМакета);
		Сч = Сч+1;
		
	КонецЦикла;
	
	МСК.ЗафиксироватьПечатьДокумента(Ссылка,"ЗаданиеНаРазбор", "Задание на разбор");
	Исполнено = Истина;

	Если ОбъединяемНаОдинЛист Тогда 
		
		ОбластьМакета = Макет.ПолучитьОбласть("Разделитель");
		ТабДокумент.Вывести(ОбластьМакета);  	
		МассивВыводимыхОбластей.Очистить();
		
		ПромТабДок = Новый ТабличныйДокумент;
		ПромТабДок.АвтоМасштаб = Истина;
		
		Для Экземпляров = 1 По КолЭкземпляров Цикл
			МассивВыводимыхОбластей.Добавить(ТабДокумент);				
		КонецЦикла;
		
		Для Экземпляров = 1 По КолЭкземпляров Цикл
			
			ТабДокСводный.Вывести(ТабДокумент);
			
			Если НЕ ПромТабДок.ПроверитьВывод(МассивВыводимыхОбластей) Тогда
				ТабДокСводный.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;					
			
		КонецЦикла;				 
		
		ТабДокумент.Очистить();
		
	КонецЕсли; 
	
	Если НЕ ТабДокСводный.КоличествоСтраниц() = 0 Тогда
		Возврат ТабДокСводный; 
	Иначе
		Возврат ТабДокумент;			
	КонецЕсли;

КонецФункции

Процедура ОбработкаУдаленияПроведения(Отказ) 
	
	Если Не Отказ И Константы.AMQP_ВыгружатьДанные.Получить() И СборкаЗаказовПокупателя.Договор.ВыгружаетсяВБиллинг Тогда
		Рез = AMQP_РаботаСДокументами.ОтменитьДокументКорректировкиБлокировкиВБиллинге(Ссылка);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КорректировкаЗаказаПокупателяТовары.Ссылка
	|ИЗ
	|	Документ.КорректировкаСборкиЗаказовПокупателя.Товары КАК КорректировкаСборкиЗаказовПокупателяТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КорректировкаЗаказаПокупателя.Товары КАК КорректировкаЗаказаПокупателяТовары
	|		ПО КорректировкаСборкиЗаказовПокупателяТовары.Номенклатура = КорректировкаЗаказаПокупателяТовары.Номенклатура
	|			И КорректировкаСборкиЗаказовПокупателяТовары.ЗаказПокупателя = КорректировкаЗаказаПокупателяТовары.Ссылка.ЗаказПокупателя
	|			И КорректировкаСборкиЗаказовПокупателяТовары.Ссылка.Дата <= КорректировкаЗаказаПокупателяТовары.Ссылка.Дата
	|ГДЕ
	|	КорректировкаСборкиЗаказовПокупателяТовары.Ссылка = &КорректировкаСсылка
	|	И КорректировкаЗаказаПокупателяТовары.Ссылка.Проведен";
	
	Запрос.УстановитьПараметр("КорректировкаСсылка", Ссылка);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Об = Выборка.Ссылка.ПолучитьОбъект();
		Об.УстановитьПометкуУдаления(Истина); 	
		сообщить("Помечен на удаление документ : " + Строка(Об.Ссылка));
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПоискПричиныПоТабличнойЧастиТовары() Экспорт
	
	СписокПричин = ПолучитьСписокПричинОтказа();
	
	Для каждого Элемент  Из СписокПричин Цикл
		
		СтруктураПоиска = Новый Структура("Причина", Элемент.Значение);
		МассивСтрок = Товары.НайтиСтроки(СтруктураПоиска);
		
		Если МассивСтрок.Количество() > 0 Тогда
			
			Количество = МассивСтрок.Количество();
			Возврат Количество;
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	Возврат 0;
	
КонецФункции

Функция ПолучитьСписокПричинОтказа()
	
	СписокПричин = Новый Структура;
	СписокПричин.Вставить("ОтказКлиента", Перечисления.ПричиныКорректировкиСборки.ОтказКлиента);	
	СписокПричин.Вставить("ОтказПоставщика", Перечисления.ПричиныКорректировкиСборки.ОтказПоставщика);
	
	Возврат СписокПричин;
	
КонецФункции;





