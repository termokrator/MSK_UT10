
Процедура ЗаполнитьТоварыПоЯчейкам(Сборка) Экспорт 
	
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда 
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ТоварыВСборкеОстатки.Сборка,
		|	ТоварыВСборкеОстатки.Контрагент,
		|	ТоварыВСборкеОстатки.ЗаказПокупателя,
		|	ТоварыВСборкеОстатки.Номенклатура,
		|	ТоварыВСборкеОстатки.СобраноОстаток + ТоварыВСборкеОстатки.КСборкеОстаток КАК Количество
		|ИЗ
		|	РегистрНакопления.ТоварыВСборке.Остатки(, Сборка = &Сборка) КАК ТоварыВСборкеОстатки
		|ГДЕ
		|	ТоварыВСборкеОстатки.СобраноОстаток + ТоварыВСборкеОстатки.КСборкеОстаток > 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТоварыВЯчейках.Склад,
		|	ТоварыВЯчейках.Номенклатура,
		|	ТоварыВЯчейках.Ячейка,
		|	СУММА(ТоварыВЯчейках.Количество) КАК Количество
		|ИЗ
		|	РегистрНакопления.ТоварыВЯчейках КАК ТоварыВЯчейках
		|ГДЕ
		|	ТоварыВЯчейках.Регистратор = &Сборка
		|
		|СГРУППИРОВАТЬ ПО
		|	ТоварыВЯчейках.Склад,
		|	ТоварыВЯчейках.Номенклатура,
		|	ТоварыВЯчейках.Ячейка";
		
		
		Запрос.УстановитьПараметр("Сборка", Сборка);
		Пакет = Запрос.ВыполнитьПакет();
		
		ТабЗаказов	= Пакет[0].Выгрузить();
		ТабЯчеек	= Пакет[1].Выгрузить();
		
		Для Каждого ТекЗаказ Из ТабЗаказов Цикл
			
			НайденныеСтроки =  ТабЯчеек.НайтиСтроки(Новый Структура("Номенклатура",ТекЗаказ.Номенклатура));
			Для каждого ТекСтрока Из НайденныеСтроки Цикл  
				
				Если ТекЗаказ.Количество <= 0 Тогда 
					Прервать;
				КонецЕсли;
				
				Если ТекСтрока.Количество = 0 Тогда 
					Продолжить;
				КонецЕсли;
				
				ВычестьИзТекЯчейки = Мин(ТекСтрока.Количество,ТекЗаказ.Количество);
				
				ТекСтрока.Количество = ТекСтрока.Количество - ВычестьИзТекЯчейки ;
				ТекЗаказ.Количество = ТекЗаказ.Количество - ВычестьИзТекЯчейки;
				
				НоваяСтрока = Товары.Добавить();
				НоваяСтрока.ЗаказПокупателя = ТекЗаказ.ЗаказПокупателя;
				НоваяСтрока.Номенклатура 	= ТекСтрока.Номенклатура;
				НоваяСтрока.Склад		 	= ТекСтрока.Склад;
				НоваяСтрока.Ячейка		 	= ТекСтрока.Ячейка;
				НоваяСтрока.Количество		= ВычестьИзТекЯчейки;
			КонецЦикла;	
			
		КонецЦикла;			
		
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ТоварыВСборкеОстатки.Контрагент,
		|	ТоварыВСборкеОстатки.ЗаказПокупателя,
		|	ТоварыВСборкеОстатки.Номенклатура,
		|	ТоварыВСборкеОстатки.СобраноОстаток + ТоварыВСборкеОстатки.КСборкеОстаток КАК Количество
		|ПОМЕСТИТЬ ТоварыВСборке
		|ИЗ
		|	РегистрНакопления.ТоварыВСборке.Остатки(, Сборка = &Сборка) КАК ТоварыВСборкеОстатки
		|ГДЕ
		|	ТоварыВСборкеОстатки.СобраноОстаток + ТоварыВСборкеОстатки.КСборкеОстаток > 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТоварыВЯчейках.Склад,
		|	ТоварыВЯчейках.Номенклатура,
		|	ТоварыВЯчейках.Ячейка,
		|	СУММА(ТоварыВЯчейках.Количество) КАК Количество
		|ПОМЕСТИТЬ ДвиженияПоЯчейкам
		|ИЗ
		|	РегистрНакопления.ТоварыВЯчейках КАК ТоварыВЯчейках
		|ГДЕ
		|	ТоварыВЯчейках.Регистратор = &Сборка
		|
		|СГРУППИРОВАТЬ ПО
		|	ТоварыВЯчейках.Склад,
		|	ТоварыВЯчейках.Номенклатура,
		|	ТоварыВЯчейках.Ячейка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Таб.Склад КАК Склад,
		|	Таб.Номенклатура КАК Номенклатура,
		|	Таб.Ячейка КАК Ячейка,
		|	СУММА(Таб.Количество) КАК Количество
		|ИЗ
		|	(ВЫБРАТЬ
		|		ТоварыВЯчейках.Склад КАК Склад,
		|		ТоварыВЯчейках.Номенклатура КАК Номенклатура,
		|		ТоварыВЯчейках.Ячейка КАК Ячейка,
		|		-ТоварыВЯчейках.Количество КАК Количество
		|	ИЗ
		|		РегистрНакопления.ТоварыВЯчейках КАК ТоварыВЯчейках
		|	ГДЕ
		|		ТоварыВЯчейках.Регистратор = &Корректировка
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ДвиженияПоЯчейкам.Склад,
		|		ДвиженияПоЯчейкам.Номенклатура,
		|		ДвиженияПоЯчейкам.Ячейка,
		|		ДвиженияПоЯчейкам.Количество
		|	ИЗ
		|		ДвиженияПоЯчейкам КАК ДвиженияПоЯчейкам) КАК Таб
		|
		|СГРУППИРОВАТЬ ПО
		|	Таб.Склад,
		|	Таб.Номенклатура,
		|	Таб.Ячейка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Таб2.Контрагент КАК Контрагент,
		|	Таб2.ЗаказПокупателя КАК ЗаказПокупателя,
		|	Таб2.Номенклатура КАК Номенклатура,
		|	СУММА(Таб2.Количество) КАК Количество
		|ИЗ
		|	(ВЫБРАТЬ
		|		ТоварыВСборке2.Контрагент КАК Контрагент,
		|		ТоварыВСборке2.ЗаказПокупателя КАК ЗаказПокупателя,
		|		ТоварыВСборке2.Номенклатура КАК Номенклатура,
		|		ТоварыВСборке2.Собрано + ТоварыВСборке2.КСборке КАК Количество
		|	ИЗ
		|		РегистрНакопления.ТоварыВСборке КАК ТоварыВСборке2
		|	ГДЕ
		|		ТоварыВСборке2.Регистратор = &Корректировка
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ТоварыВСборке.Контрагент,
		|		ТоварыВСборке.ЗаказПокупателя,
		|		ТоварыВСборке.Номенклатура,
		|		ТоварыВСборке.Количество
		|	ИЗ
		|		ТоварыВСборке КАК ТоварыВСборке) КАК Таб2
		|
		|СГРУППИРОВАТЬ ПО
		|	Таб2.Контрагент,
		|	Таб2.ЗаказПокупателя,
		|	Таб2.Номенклатура";
		
		Запрос.УстановитьПараметр("Корректировка", Ссылка);
		Запрос.УстановитьПараметр("Сборка", Сборка);
		
		Пакет = Запрос.ВыполнитьПакет();
		
		ТабЗаказов	= Пакет[2].Выгрузить();
		ТабЯчеек	= Пакет[3].Выгрузить();
		
		Для Каждого ТекЗаказ Из ТабЗаказов Цикл
			
			НайденныеСтроки =  ТабЯчеек.НайтиСтроки(Новый Структура("Номенклатура",ТекЗаказ.Номенклатура));
			Для каждого ТекСтрока Из НайденныеСтроки Цикл  
				
				Если ТекЗаказ.Количество <= 0 Тогда 
					Прервать;
				КонецЕсли;
				
				Если ТекСтрока.Количество = 0 Тогда 
					Продолжить;
				КонецЕсли;
				
				ВычестьИзТекЯчейки = Мин(ТекСтрока.Количество,ТекЗаказ.Количество);
				
				ТекСтрока.Количество = ТекСтрока.Количество - ВычестьИзТекЯчейки ;
				ТекЗаказ.Количество = ТекЗаказ.Количество - ВычестьИзТекЯчейки;
				
				НоваяСтрока = Товары.Добавить();
				НоваяСтрока.ЗаказПокупателя = ТекСтрока.ЗаказПокупателя; //ТекЗаказ.ЗаказПокупателя;
				НоваяСтрока.Номенклатура 	= ТекСтрока.Номенклатура;
				НоваяСтрока.Склад		 	= ТекЗаказ.Склад;
				НоваяСтрока.Ячейка		 	= ТекЗаказ.Ячейка;
				НоваяСтрока.Количество		= ВычестьИзТекЯчейки;
				
			КонецЦикла;	
			
		КонецЦикла;			
		
	КонецЕсли;	
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.СборкаЗаказовПокупателя") Тогда
		
		СборкаЗаказовПокупателя = ДанныеЗаполнения;
		ЗаполнениеДокументов.ЗаполнитьШапкуДокументаПоОснованию(ЭтотОбъект, ДанныеЗаполнения);
		Грузополучатель = ДанныеЗаполнения.Грузополучатель;
		Ответственный = ДанныеЗаполнения.Ответственный;
		Дата = ТекущаяДата();
		
		Если ДанныеЗаполнения.Проведен Тогда       
			
			//+Шульман А. 10.10.2025 #UT10-5452  
			//+Шульман А. 24.10.2025 #UT10-5483 
			Если ДанныеЗаполнения.СпособДоставки = Перечисления.СпособДоставки.НашаДоставка Или ДанныеЗаполнения.УпаковыватьСамовывоз Тогда
			//-Шульман А. 24.10.2025 #UT10-5483 
				#Если Клиент Тогда            
					
					СтандартнаяОбработка = Ложь;                        
					ДополнительныеСвойства.Вставить("НеОткрывать", Истина);
					ОтобратьТоварыИСоздатьЗапросыНаИзменениеКоличества(ДанныеЗаполнения);  
					
				#Иначе
					ЗаполнитьТоварыПоЯчейкам(ДанныеЗаполнения);				
				#КонецЕсли
			//-Шульман А. 10.10.2025 #UT10-5452
				
			Иначе       
				ЗаполнитьТоварыПоЯчейкам(ДанныеЗаполнения);				
			КонецЕсли;
				
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОтобратьТоварыИСоздатьЗапросыНаИзменениеКоличества(ДокументСборка)
	
	//+Шульман А. 10.10.2025 #UT10-5452
	ФормаВыбораТоваровДляЗапросов = ЭтотОбъект.ПолучитьФорму("ФормаВыбораТоваровДляЗапросов", ЭтотОбъект);
	ФормаВыбораТоваровДляЗапросов.ДокументСборка = ДокументСборка; 
	ФормаВыбораТоваровДляЗапросов.ОткрытьМодально();
	//-Шульман А. 10.10.2025 #UT10-5452

КонецПроцедуры

Функция ПроверитьКорректностьЗаполненияДокумента()
	
	СтруктураВозврата = Новый Структура;
	
	Отказ = Ложь;
	
	Если Товары.Количество()= 0 Тогда 
		
		Сообщить("Не заполнена табличная часть товары для выполнения корректировки!");
		Возврат СтруктураВозврата.Вставить("Отказ", Истина);
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА КорректировкаСборкиЗаказовПокупателя.Организация = КорректировкаСборкиЗаказовПокупателя.СборкаЗаказовПокупателя.Организация
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьОшибкиЗаполненияОрганизации,
	|	ВЫБОР
	|		КОГДА КорректировкаСборкиЗаказовПокупателя.Контрагент = КорректировкаСборкиЗаказовПокупателя.СборкаЗаказовПокупателя.Контрагент
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьОшибкиЗаполненияКонтрагента,
	|	ВЫБОР
	|		КОГДА КорректировкаСборкиЗаказовПокупателя.Грузополучатель = КорректировкаСборкиЗаказовПокупателя.СборкаЗаказовПокупателя.Грузополучатель
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьОшибкиЗаполненияГрузополучателя
	|ИЗ
	|	Документ.КорректировкаСборкиЗаказовПокупателя КАК КорректировкаСборкиЗаказовПокупателя
	|ГДЕ
	|	КорректировкаСборкиЗаказовПокупателя.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыВЯчейках.Склад,
	|	ТоварыВЯчейках.Номенклатура,
	|	ТоварыВЯчейках.Ячейка,
	|	СУММА(ТоварыВЯчейках.Количество) КАК Количество
	|ПОМЕСТИТЬ ДвиженияТоварыВЯчейках
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках КАК ТоварыВЯчейках
	|ГДЕ
	|	ТоварыВЯчейках.Регистратор = &Сборка
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыВЯчейках.Склад,
	|	ТоварыВЯчейках.Номенклатура,
	|	ТоварыВЯчейках.Ячейка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыГотовыеКСборке.Номенклатура,
	|	СУММА(ТоварыГотовыеКСборке.Количество) КАК Количество,
	|	ТоварыГотовыеКСборке.ЗаказПокупателя КАК ЗаказПокупателя
	|ПОМЕСТИТЬ ДвиженияТоварыГотовыеКСборке
	|ИЗ
	|	РегистрНакопления.ТоварыГотовыеКСборке КАК ТоварыГотовыеКСборке
	|ГДЕ
	|	ТоварыГотовыеКСборке.Регистратор = &Сборка
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыГотовыеКСборке.Номенклатура,
	|	ТоварыГотовыеКСборке.ЗаказПокупателя
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КорректировкаСборкиЗаказовПокупателя.Ссылка
	|ПОМЕСТИТЬ Корректировки
	|ИЗ
	|	Документ.КорректировкаСборкиЗаказовПокупателя КАК КорректировкаСборкиЗаказовПокупателя
	|ГДЕ
	|	КорректировкаСборкиЗаказовПокупателя.СборкаЗаказовПокупателя = &Сборка
	|	И КорректировкаСборкиЗаказовПокупателя.Ссылка <> &Ссылка
	|	И КорректировкаСборкиЗаказовПокупателя.Ссылка.Проведен
	|	И КорректировкаСборкиЗаказовПокупателя.Дата <= &ДатаОстатков
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабДокумента.Ссылка.СборкаЗаказовПокупателя КАК Ссылка,
	|	&Контрагент КАК Контрагент,
	|	ТабДокумента.Номенклатура,
	|	ТабДокумента.Ячейка,
	|	ТабДокумента.Склад,
	|	ТабДокумента.ЗаказПокупателя,
	|	ТабДокумента.Количество,
	|	ТабДокумента.Причина
	|ПОМЕСТИТЬ ТабДокумента
	|ИЗ
	|	Документ.КорректировкаСборкиЗаказовПокупателя.Товары КАК ТабДокумента
	|ГДЕ
	|	ТабДокумента.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таб.Склад КАК Склад,
	|	Таб.Номенклатура КАК Номенклатура,
	|	Таб.Ячейка КАК Ячейка,
	|	СУММА(Таб.Количество) КАК Количество,
	|	СУММА(Таб.КоличествоВДокументе) КАК КоличествоВДокументе
	|ПОМЕСТИТЬ ТабРезультата
	|ИЗ
	|	(ВЫБРАТЬ
	|		ТоварыВЯчейках.Склад КАК Склад,
	|		ТоварыВЯчейках.Номенклатура КАК Номенклатура,
	|		ТоварыВЯчейках.Ячейка КАК Ячейка,
	|		-ТоварыВЯчейках.Количество КАК Количество,
	|		0 КАК КоличествоВДокументе
	|	ИЗ
	|		РегистрНакопления.ТоварыВЯчейках КАК ТоварыВЯчейках
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Корректировки КАК Корректировки
	|			ПО ТоварыВЯчейках.Регистратор = Корректировки.Ссылка
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ДвиженияТоварыВЯчейках.Склад,
	|		ДвиженияТоварыВЯчейках.Номенклатура,
	|		ДвиженияТоварыВЯчейках.Ячейка,
	|		ДвиженияТоварыВЯчейках.Количество,
	|		0
	|	ИЗ
	|		ДвиженияТоварыВЯчейках КАК ДвиженияТоварыВЯчейках
	|	
