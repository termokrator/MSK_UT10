	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабРезультатаТоварыКсборке.ЗаказПокупателя,
	|	ТабРезультатаТоварыКсборке.Номенклатура,
	|	ТабРезультатаТоварыКсборке.КоличествоСДокументом
	|ИЗ
	|	ТабРезультатаТоварыКсборке КАК ТабРезультатаТоварыКсборке
	|ГДЕ
	|	ТабРезультатаТоварыКсборке.КоличествоСДокументом > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабДокумента.Ссылка,
	|	ТабДокумента.Контрагент,
	|	ТабДокумента.ЗаказПокупателя,
	|	ТабДокумента.Номенклатура,
	|	ТабДокумента.Причина,
	|	СУММА(ТабДокумента.Количество) КАК Количество
	|ПОМЕСТИТЬ ТабДокументаГруппа
	|ИЗ
	|	ТабДокумента КАК ТабДокумента
	|
	|СГРУППИРОВАТЬ ПО
	|	ТабДокумента.Ссылка,
	|	ТабДокумента.Контрагент,
	|	ТабДокумента.ЗаказПокупателя,
	|	ТабДокумента.Номенклатура,
	|	ТабДокумента.Причина
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаказПокупателяТовары.Ссылка КАК ЗаказПокупателя,
	|	ЗаказПокупателяТовары.Номенклатура,
	|	МИНИМУМ(ЗаказПокупателяТовары.Цена) КАК Цена
	|ПОМЕСТИТЬ ЦеныНоменклатуры
	|ИЗ
	|	Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары
	|ГДЕ
	|	(ЗаказПокупателяТовары.Ссылка, ЗаказПокупателяТовары.Номенклатура) В
	|			(ВЫБРАТЬ
	|				ТабДокумента.ЗаказПокупателя,
	|				ТабДокумента.Номенклатура
	|			ИЗ
	|				ТабДокумента КАК ТабДокумента)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказПокупателяТовары.Ссылка,
	|	ЗаказПокупателяТовары.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабДокументаГруппа.Ссылка,
	|	ТабДокументаГруппа.Контрагент,
	|	ТабДокументаГруппа.ЗаказПокупателя,
	|	ТабДокументаГруппа.Номенклатура,
	|	ЕСТЬNULL(ТоварыВСборкеОстатки.СобраноОстаток, 0) + ЕСТЬNULL(ТоварыВСборкеОстатки.КСборкеОстаток, 0) КАК Количество,
	|	ТабДокументаГруппа.Количество КАК КоличествоВДокументе,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ТоварыВСборкеОстатки.СобраноОстаток, 0) + ЕСТЬNULL(ТоварыВСборкеОстатки.КСборкеОстаток, 0) - ТабДокументаГруппа.Количество < 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЕстьОшибкиПревышенияКоличества,
	|	ЕСТЬNULL(ЦеныНоменклатуры.Цена, 0) * ТабДокументаГруппа.Количество КАК Сумма,
	|	ТабДокументаГруппа.Причина
	|ИЗ
	|	ТабДокументаГруппа КАК ТабДокументаГруппа
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВСборке.Остатки(
	|				&ДатаОстатков,
	|				(Сборка, Контрагент, ЗаказПокупателя, Номенклатура) В
	|					(ВЫБРАТЬ
	|						ТабДокумента.Ссылка,
	|						ТабДокумента.Контрагент,
	|						ТабДокумента.ЗаказПокупателя,
	|						ТабДокумента.Номенклатура
	|					ИЗ
	|						ТабДокумента КАК ТабДокумента)) КАК ТоварыВСборкеОстатки
	|		ПО ТабДокументаГруппа.Ссылка = ТоварыВСборкеОстатки.Сборка
	|			И ТабДокументаГруппа.Контрагент = ТоварыВСборкеОстатки.Контрагент
	|			И ТабДокументаГруппа.ЗаказПокупателя = ТоварыВСборкеОстатки.ЗаказПокупателя
	|			И ТабДокументаГруппа.Номенклатура = ТоварыВСборкеОстатки.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ ЦеныНоменклатуры КАК ЦеныНоменклатуры
	|		ПО ТабДокументаГруппа.ЗаказПокупателя = ЦеныНоменклатуры.ЗаказПокупателя
	|			И ТабДокументаГруппа.Номенклатура = ЦеныНоменклатуры.Номенклатура
	|ГДЕ
	|	ТабДокументаГруппа.Количество > 0";

	Запрос.УстановитьПараметр("Сборка", СборкаЗаказовПокупателя);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("ДатаОстатков", ТекущаяДата()); 
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ОшибкиШапки = МассивРезультатов[0].Выгрузить();
	
	Для Каждого СтрокаТаблицы Из ОшибкиШапки Цикл 
		
		Если СтрокаТаблицы.ЕстьОшибкиЗаполненияОрганизации Тогда 
			
			Отказ = Истина;
			Сообщить("Организация в документе корректировки не соответствует организации в документе сборки!");
			
		КонецЕсли;
		
		Если СтрокаТаблицы.ЕстьОшибкиЗаполненияКонтрагента Тогда 
			
			Отказ = Истина;
			Сообщить("Контрагент в документе корректировки не соответствует контрагенту в документе сборки!");
			
		КонецЕсли;
		
		Если СтрокаТаблицы.ЕстьОшибкиЗаполненияГрузополучателя Тогда 
			
			Отказ = Истина;
			Сообщить("Грузополучатель в документе корректировки не соответствует грузополучателю в документе сборки!");
			
		КонецЕсли;	
		
	КонецЦикла;
	
	ТаблицаОшибокКоличестваПоЯчейкам = МассивРезультатов[7].Выгрузить();
	
	Для Каждого СтрокаТаблицы Из ТаблицаОшибокКоличестваПоЯчейкам Цикл 
		
		Если СтрокаТаблицы.ЕстьОшибкиПревышенияКоличества Тогда 
			
			Отказ = Истина;
			Сообщить("Для номенклатуры " + СтрокаТаблицы.Номенклатура + " по складу " + СтрокаТаблицы.Склад + 
			" по ячейке " + СтрокаТаблицы.Ячейка + " превышено допустимое количество корректировки " + Символы.ПС + "(Попытка откорректировать: " + СтрокаТаблицы.КоличествоВДокументе + 
			" ед., возможно откорректировать: " + СтрокаТаблицы.Количество + " ед.)!");
			
		КонецЕсли;	
		
	КонецЦикла;	
	
	ТаблицаОшибокКоличестваПоСборкам = МассивРезультатов[8].Выгрузить();
	
	Для Каждого СтрокаТаблицы Из ТаблицаОшибокКоличестваПоСборкам Цикл 
		
		Если СтрокаТаблицы.ЕстьОшибкиПревышенияКоличества Тогда 
			
			Отказ = Истина;
			Сообщить("Для номенклатуры " + СтрокаТаблицы.Номенклатура + " по заказу " + СтрокаТаблицы.ЗаказПокупателя + 
			" превышено допустимое количество корректировки " + Символы.ПС + "(Попытка откорректировать: " + СтрокаТаблицы.КоличествоВДокументе + 
			" ед., возможно откорректировать: " + СтрокаТаблицы.Количество + " ед.)!");
			
		КонецЕсли;	
		
	КонецЦикла;	
	
	
	ТаблицаОшибокТоварыВСборке = МассивРезультатов[12].Выгрузить();
	
	Для Каждого СтрокаТаблицы Из ТаблицаОшибокТоварыВСборке Цикл 
		
		Если СтрокаТаблицы.ЕстьОшибкиПревышенияКоличества Тогда 
			
			Отказ = Истина;
			Сообщить("Для номенклатуры " + СтрокаТаблицы.Номенклатура + " по заказу " + СтрокаТаблицы.ЗаказПокупателя + Символы.ПС + 
			"по сборке " + СтрокаТаблицы.Ссылка + 
			" превышено допустимое количество корректировки по регистру Товары В Сборке :" + Символы.ПС + "(Попытка откорректировать: " + СтрокаТаблицы.КоличествоВДокументе + 
			" ед., возможно откорректировать: " + СтрокаТаблицы.Количество + " ед.)!");
			
		КонецЕсли;	
		
	КонецЦикла;	
	
	СоздаватьДвиженияПоРегиструНоменклатураГотоваяЕхатьККлиенту = Ложь;

	СтруктураВозврата.Вставить("Отказ", Отказ);
	СтруктураВозврата.Вставить("СоздаватьДвиженияПоРегиструНоменклатураГотоваяЕхатьККлиенту", СоздаватьДвиженияПоРегиструНоменклатураГотоваяЕхатьККлиенту);
	СтруктураВозврата.Вставить("ТаблицаТоварыВСборке", ТаблицаОшибокТоварыВСборке);
	
	Возврат СтруктураВозврата;
	
КонецФункции

Процедура ПроверитьКорректностьЗаполненияКодовМаркировки(Отказ)

	//+Шульман А. 24.09.2025 #UT10-5433  
	Если КодыМаркировки.Количество() = 0  Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(тзКодыМаркировки.КодМаркировки КАК Справочник.ШтрихкодыНоменклатуры) КАК ШтрихкодНоменклатуры
		|ПОМЕСТИТЬ ВТ_КодыДокумента
		|ИЗ
		|	&тзКодыМаркировки КАК тзКодыМаркировки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_КодыДокумента.ШтрихкодНоменклатуры КАК ШтрихкодНоменклатуры,
		|	ВТ_КодыДокумента.ШтрихкодНоменклатуры.Номенклатура КАК Номенклатура,
		|	ЕСТЬNULL(ДвижениеКодовСборка.Регистратор, ЗНАЧЕНИЕ(Документ.СборкаЗаказовПокупателя.ПустаяСсылка)) КАК Сборка,
		|	ЕСТЬNULL(ДвижениеКодовКорректировкаСборки.Регистратор, ЗНАЧЕНИЕ(Документ.КорректировкаСборкиЗаказовПокупателя.ПустаяСсылка)) КАК КорректировкаСборки
		|ИЗ
		|	ВТ_КодыДокумента КАК ВТ_КодыДокумента
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ДвижениеКодовМаркировкиСУЗ КАК ДвижениеКодовСборка
		|		ПО ВТ_КодыДокумента.ШтрихкодНоменклатуры = ДвижениеКодовСборка.ШтрихкодНоменклатуры
		|			И (ДвижениеКодовСборка.Основание = &Сборка)
		|			И (ДвижениеКодовСборка.Регистратор ССЫЛКА Документ.СборкаЗаказовПокупателя)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ДвижениеКодовМаркировкиСУЗ КАК ДвижениеКодовКорректировкаСборки
		|		ПО ВТ_КодыДокумента.ШтрихкодНоменклатуры = ДвижениеКодовКорректировкаСборки.ШтрихкодНоменклатуры
		|			И (ДвижениеКодовКорректировкаСборки.Основание = &Сборка)
		|			И (НЕ ДвижениеКодовКорректировкаСборки.Регистратор = &Ссылка)
		|			И (ДвижениеКодовКорректировкаСборки.Регистратор ССЫЛКА Документ.КорректировкаСборкиЗаказовПокупателя)
		|ГДЕ
		|	ДвижениеКодовСборка.Основание = &Сборка
		|	И НЕ ДвижениеКодовСборка.Регистратор = &Ссылка
		|ИТОГИ
		|	МАКСИМУМ(Номенклатура),
		|	МАКСИМУМ(Сборка),
		|	МАКСИМУМ(КорректировкаСборки)
		|ПО
		|	ШтрихкодНоменклатуры";
	
	Запрос.УстановитьПараметр("ДокументСобранИУпакован", СборкаЗаказовПокупателя.ДокументСобранИУпакован);
	Запрос.УстановитьПараметр("Сборка", СборкаЗаказовПокупателя);
	Запрос.УстановитьПараметр("Ссылка", Ссылка); 
	Запрос.УстановитьПараметр("тзКодыМаркировки", КодыМаркировки.Выгрузить());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаШК = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаШК.Следующий() Цикл    
		
		Выборка = ВыборкаШК.Выбрать();
		
		Пока Выборка.Следующий() Цикл
		
			Если Не ЗначениеЗаполнено(Выборка.Сборка) Тогда
			
				Отказ = Истина;
				Сообщить("Для номенклатуры " + Выборка.Номенклатура + " код маркировки " 
				+ Выборка.ШтрихкодНоменклатуры.КодМаркировки + " не собран/не находится на сборке");
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Выборка.КорректировкаСборки) Тогда
			
				Отказ = Истина;
				Сообщить("Для номенклатуры " + Выборка.Номенклатура + " код маркировки " 
				+ Выборка.ШтрихкодНоменклатуры.КодМаркировки + " уже есть в " + Выборка.КорректировкаСборки);
				
			КонецЕсли;
			
		КонецЦикла;
			
	КонецЦикла;
	//-Шульман А. 24.09.2025 #UT10-5433

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ОбщегоНазначения.УдалитьДвиженияРегистратора(ЭтотОбъект, Отказ);
	
	СтруктураОтвета = ПроверитьКорректностьЗаполненияДокумента();
	
	Если СтруктураОтвета.Отказ Тогда 
		
		Отказ = Истина;
		Возврат;
		
	КонецЕсли;	
	
	//+Шульман А. 24.09.2025 #UT10-5433
	ПроверитьКорректностьЗаполненияКодовМаркировки(Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	//-Шульман А. 24.09.2025 #UT10-5433
	
	ОбщегоНазначения.УдалитьДвиженияРегистратора(ЭтотОбъект, Отказ);
	
	Движения.ТоварыГотовыеКСборке.Записывать = Истина;
	Движения.НоменклатураГотоваяЕхатьККлиенту.Записывать = Истина;
	Движения.СобраноПоЗаказу.Записывать = Истина;
	Движения.ТоварыВСборке.Записывать = Истина;   
	//+Шульман А. 24.09.2025 #UT10-5433    
	Движения.ДвижениеКодовМаркировкиСУЗ.Записывать = Истина;
	//-Шульман А. 24.09.2025 #UT10-5433
	
	//ТоварыВЯчейках
	ПроводитьПоЯчейкам = Ложь;
	
	Если Дата < Константы.ДатаНачалаПроведенияКорректировкиСборкиПоРегиструТоварыВЯчейкахСУчетомИсполнено.Получить() Тогда 
		ПроводитьПоЯчейкам = Истина;
	Иначе
		ПроводитьПоЯчейкам = Исполнено;
	КонецЕсли;
	
	Если ПроводитьПоЯчейкам Тогда 
		
		Движения.ТоварыВЯчейках.Записывать = Истина;
		
		ТЧТовары = Товары.Выгрузить(,"Номенклатура,Склад,Ячейка,ПроблемнаяЯчейка,Количество");
		ТЧТовары.Свернуть("Номенклатура,Склад,ПроблемнаяЯчейка,Ячейка","Количество");
		
		Для каждого ТекСтр Из ТЧТовары Цикл
			
			Если ТекСтр.Количество > 0 Тогда 
				
				Движение 				= Движения.ТоварыВЯчейках.Добавить();
				Движение.Период 		= Дата;
				Движение.ВидДвижения 	= ВидДвиженияНакопления.Приход;
				Движение.Номенклатура 	= ТекСтр.Номенклатура ;
				Движение.Склад 			= ТекСтр.Склад;
				Движение.Ячейка 		= ТекСтр.Ячейка ;
				Движение.Количество 	= ТекСтр.Количество;
				Движение.ПроблемнаяЯчейка = ТекСтр.ПроблемнаяЯчейка;
				
			КонецЕсли;
			
		КонецЦикла; 
		
	КонецЕсли;
	
	//ТоварыГотовыеКСборке
	ТЧТоварыПоЗакказу = Товары.Выгрузить(, "Номенклатура,ЗаказПокупателя,Количество");
	ТЧТоварыПоЗакказу.Свернуть("Номенклатура,ЗаказПокупателя", "Количество");
	
	Для каждого ТекСтр Из ТЧТоварыПоЗакказу Цикл
		
		Если ТекСтр.Количество > 0 Тогда 
			
			Движение 				= Движения.ТоварыГотовыеКСборке.Добавить();
			Движение.Период 		= Дата;
			Движение.ВидДвижения 	= ВидДвиженияНакопления.Приход;
			Движение.Номенклатура 	= ТекСтр.Номенклатура ;
			Движение.ЗаказПокупателя= ТекСтр.ЗаказПокупателя;
			Движение.Количество 	= ТекСтр.Количество; 
			Движение.Назначение 	= СборкаЗаказовПокупателя.Назначение;
			
			ДвижениеСобрано 				= Движения.СобраноПоЗаказу.Добавить();
			ДвижениеСобрано.Регистратор		= Ссылка;
			ДвижениеСобрано.Период 			= Дата;
			ДвижениеСобрано.Заказ 			= ТекСтр.ЗаказПокупателя;
			ДвижениеСобрано.Номенклатура 	= ТекСтр.Номенклатура;
			ДвижениеСобрано.Количество 		= -ТекСтр.Количество;   
			
		КонецЕсли;
		
	КонецЦикла; 
	
	
	//НоменклатураГотоваяЕхатьККлиенту
	// Если ВСЕ позиции по ЗаказуПокупателя откорректированы, то необходимо сделать движение по регистру
	СоздаватьДвижения = Неопределено;
	
	Если СтруктураОтвета.Свойство("СоздаватьДвиженияПоРегиструНоменклатураГотоваяЕхатьККлиенту", СоздаватьДвижения) И СборкаЗаказовПокупателя.ДокументСобранИУпакован Тогда 
		
		Если СоздаватьДвижения Тогда 
			
			Движение 							= Движения.НоменклатураГотоваяЕхатьККлиенту.Добавить();
			Движение.Период 					= Дата;
			Движение.ВидДвижения 				= ВидДвиженияНакопления.Расход;
			Движение.ДокументСборкиНоменклатуры = СборкаЗаказовПокупателя;
			Движение.Организация 				= Организация;
			Движение.Количество 				= 1;
			
		КонецЕсли;
		
	КонецЕсли;	
	
	
	//ТоварыВСборке
	ТаблицаТоварыВСборке = Неопределено;
	
	Если СтруктураОтвета.Свойство("ТаблицаТоварыВСборке", ТаблицаТоварыВСборке) И ТаблицаТоварыВСборке.Количество() <> 0 Тогда
		
		//+Шульман А. 24.09.2025 #UT10-5433
		ДокументСобранИУпакован = СборкаЗаказовПокупателя.ДокументСобранИУпакован;
		//-Шульман А. 24.09.2025 #UT10-5433
		
		Для Каждого ТекСтр Из ТаблицаТоварыВСборке Цикл
			
			ДвижениеТоварыВСборке 					= Движения.ТоварыВСборке.Добавить();
			ДвижениеТоварыВСборке.ВидДвижения 		= ВидДвиженияНакопления.Расход;
			ДвижениеТоварыВСборке.Период 			= Дата;
			ДвижениеТоварыВСборке.Регистратор 		= Ссылка;
			ДвижениеТоварыВСборке.Сборка		 	= СборкаЗаказовПокупателя;
			ДвижениеТоварыВСборке.Контрагент 		= ТекСтр.Контрагент;
			ДвижениеТоварыВСборке.ЗаказПокупателя 	= ТекСтр.ЗаказПокупателя;
			ДвижениеТоварыВСборке.Номенклатура 		= ТекСтр.Номенклатура;
			ДвижениеТоварыВСборке.Причина 			= ТекСтр.Причина;  
			ДвижениеТоварыВСборке.Назначение 		= СборкаЗаказовПокупателя.Назначение; 
			
			Если Дата > Константы.ДатаНачалаПроведенияКСборкеПоНовомуАлгоритму.Получить() Тогда	 
				
				Если ОткорректированНеСобранным Тогда 
					
					ДвижениеТоварыВСборке.КСборке	 		= ТекСтр.КоличествоВДокументе;
					ДвижениеТоварыВСборке.СуммаКСборке		= ТекСтр.Сумма;
					
				Иначе
					
					ДвижениеТоварыВСборке.Собрано	 		= ТекСтр.КоличествоВДокументе;
					ДвижениеТоварыВСборке.СуммаСобрано		= ТекСтр.Сумма;
					
				КонецЕсли;
				
			Иначе
				
				Если ДокументСобранИУпакован Тогда 
					
					ДвижениеТоварыВСборке.Собрано	 		= ТекСтр.КоличествоВДокументе;
					ДвижениеТоварыВСборке.СуммаСобрано		= ТекСтр.Сумма;
					
				Иначе
					
					ДвижениеТоварыВСборке.КСборке	 		= ТекСтр.КоличествоВДокументе;
					ДвижениеТоварыВСборке.СуммаКСборке		= ТекСтр.Сумма;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;     
		
		//+Шульман А. 24.09.2025 #UT10-5433
		Для каждого тзСтрока Из КодыМаркировки Цикл
			
			ДвижениеКМ 					= Движения.ДвижениеКодовМаркировкиСУЗ.Добавить();
			ДвижениеКМ.ВидДвижения 		= ВидДвиженияНакопления.Приход;
			ДвижениеКМ.Период 			= Дата;
			ДвижениеКМ.Регистратор 		= Ссылка;                       
			ДвижениеКМ.Склад            = СборкаЗаказовПокупателя;
			ДвижениеКМ.ШтрихкодНоменклатуры = тзСтрока.КодМаркировки;
			ДвижениеКМ.Основание        = СборкаЗаказовПокупателя;     
			
			Если ДокументСобранИУпакован Тогда 
				ДвижениеКМ.Собрано = -1;
			Иначе
				ДвижениеКМ.КСборке = -1;
			КонецЕсли;
		
		КонецЦикла;
		//-Шульман А. 24.09.2025 #UT10-5433
		
	КонецЕсли;
	
	//Грузовые места помечаем на удаление, если все скорректированные позиции составляют целые грузовые места
	Если Исполнено Тогда 
		
		ТаблицаТоварыВСборке.Свернуть("ЗаказПокупателя,Номенклатура", "КоличествоВДокументе,Количество"); 
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ТаблицаТоваровВСборке", ТаблицаТоварыВСборке);
		Запрос.УстановитьПараметр("Сборка", СборкаЗаказовПокупателя);
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаТоваровВСборке.ЗаказПокупателя,
		|	ТаблицаТоваровВСборке.Номенклатура,
		|	ТаблицаТоваровВСборке.КоличествоВДокументе КАК КоличествоКорректируем,
		|	ТаблицаТоваровВСборке.Количество КАК Количество
		|ПОМЕСТИТЬ ТаблицаТоваровВСборке
		|ИЗ
		|	&ТаблицаТоваровВСборке КАК ТаблицаТоваровВСборке
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ГрузовоеМестоТовары.Ссылка,
		|	ГрузовоеМестоТовары.Заказ,
		|	ГрузовоеМестоТовары.Номенклатура,
		|	СУММА(ГрузовоеМестоТовары.Количество) КАК КоличествоВГрузовомМесте
		|ПОМЕСТИТЬ ГрузовыеМеста
		|ИЗ
		|	Документ.ГрузовоеМесто.Товары КАК ГрузовоеМестоТовары
		|ГДЕ
		|	ГрузовоеМестоТовары.Ссылка.Сборка = &Сборка
		|	И ГрузовоеМестоТовары.Ссылка.ПометкаУдаления = ЛОЖЬ
		|	И ВЫБОР
		|			КОГДА ГрузовоеМестоТовары.Ссылка.Сборка.УпаковыватьСамовывоз
		|				ТОГДА ГрузовоеМестоТовары.Ссылка.РеализацияСамовывоза = ЗНАЧЕНИЕ(Документ.РеализацияТоваровУслуг.ПустаяСсылка)
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|
		|СГРУППИРОВАТЬ ПО
		|	ГрузовоеМестоТовары.Заказ,
		|	ГрузовоеМестоТовары.Номенклатура,
		|	ГрузовоеМестоТовары.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ГрузовыеМеста.Ссылка КАК ГрузовоеМесто,
		|	ГрузовыеМеста.Заказ КАК Заказ,
		|	ГрузовыеМеста.Номенклатура КАК Номенклатура,
		|	ЕСТЬNULL(ГрузовыеМеста.КоличествоВГрузовомМесте, 0) КАК Упаковано,
		|	ЕСТЬNULL(ТаблицаТоваровВСборке.КоличествоКорректируем, 0) КАК Корректируем,
		|	ЕСТЬNULL(ТаблицаТоваровВСборке.Количество, 0) КАК Всего,
		|	ЕСТЬNULL(ТаблицаТоваровВСборке.Количество, 0) - ЕСТЬNULL(ГрузовыеМеста.КоличествоВГрузовомМесте, 0) КАК Неупаковано,
		|	ЕСТЬNULL(ТаблицаТоваровВСборке.КоличествоКорректируем, 0) - (ЕСТЬNULL(ТаблицаТоваровВСборке.Количество, 0) - ЕСТЬNULL(ГрузовыеМеста.КоличествоВГрузовомМесте, 0)) КАК КорректировкаГМ
		|ПОМЕСТИТЬ ИтоговаяТаблица
		|ИЗ
		|	ГрузовыеМеста КАК ГрузовыеМеста
		|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаТоваровВСборке КАК ТаблицаТоваровВСборке
		|		ПО ГрузовыеМеста.Заказ = ТаблицаТоваровВСборке.ЗаказПокупателя
		|			И ГрузовыеМеста.Номенклатура = ТаблицаТоваровВСборке.Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ИтоговаяТаблица.ГрузовоеМесто КАК ГрузовоеМесто,
		|	ИтоговаяТаблица.Заказ КАК Заказ,
		|	ИтоговаяТаблица.Номенклатура КАК Номенклатура,
		|	ИтоговаяТаблица.КорректировкаГМ КАК КорректировкаГМ
		|ИЗ
		|	ИтоговаяТаблица КАК ИтоговаяТаблица
		|ГДЕ
		|	ИтоговаяТаблица.Корректируем > 0
		|	И ИтоговаяТаблица.КорректировкаГМ > 0
		|ИТОГИ
		|	СУММА(КорректировкаГМ)
		|ПО
		|	ГрузовоеМесто,
		|	Заказ,
		|	Номенклатура";
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если НЕ РезультатЗапроса.Пустой() Тогда
			
			ВыборкаПоГМ = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаПоГМ.Следующий() Цикл
				
				ГрузоместоОбъект = ВыборкаПоГМ.ГрузовоеМесто.ПолучитьОбъект();
				
				КоличествоПослеКорректировки = ГрузоместоОбъект.Товары.Итог("Количество");

				ВыборкаПоЗаказам = ВыборкаПоГМ.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				
				Пока ВыборкаПоЗаказам.Следующий() Цикл					
					
					ВыборкаПоНом = ВыборкаПоЗаказам.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					
					Пока ВыборкаПоНом.Следующий() Цикл
						
						ЕстьСтрокаВТаблицеКорректировки = ТаблицаТоварыВСборке.НайтиСтроки(Новый Структура("Номенклатура,ЗаказПокупателя", ВыборкаПоНом.Номенклатура, ВыборкаПоНом.Заказ));
						
						Если ЕстьСтрокаВТаблицеКорректировки[0].КоличествоВДокументе = 0 Тогда 
							Продолжить;
						КонецЕсли;
						
						ЕстьСтрокаВТабличнойЧасти = ГрузоместоОбъект.Товары.НайтиСтроки(Новый Структура("Номенклатура,Заказ", ВыборкаПоНом.Номенклатура, ВыборкаПоНом.Заказ));
						
						Если НЕ ЕстьСтрокаВТабличнойЧасти.Количество() = 0 Тогда 
							
							ПромСтрока = ЕстьСтрокаВТабличнойЧасти[0];
							КоличествоПослеКорректировки = КоличествоПослеКорректировки - ВыборкаПоНом.КорректировкаГМ;
							
						КонецЕсли;
						
						ЕстьСтрокаВТаблицеКорректировки[0].КоличествоВДокументе = ЕстьСтрокаВТаблицеКорректировки[0].КоличествоВДокументе - ВыборкаПоНом.КорректировкаГМ;
						
					КонецЦикла; 
					
				КонецЦикла; 
				
				Если КоличествоПослеКорректировки > 0 Тогда  
					
					// Проверить другие корректировки  
					ТаблицаТоварыПрочихКорректировокСборок = ПолучитьТаблицуТоваровПрочихКорректировокСборок(); 
					
					Для Каждого ТекСтрока Из ТаблицаТоварыПрочихКорректировокСборок Цикл  
						
						МассивНайденных = ГрузоместоОбъект.Товары.НайтиСтроки(Новый Структура("Номенклатура, Заказ", ТекСтрока.Номенклатура, ТекСтрока.ЗаказПокупателя));
						
						Если МассивНайденных.Количество() > 0 Тогда 
							КоличествоПослеКорректировки = КоличествоПослеКорректировки - Мин(МассивНайденных[0].Количество, ТекСтрока.КоличествоВДокументе);
						КонецЕсли;
						
					КонецЦикла;
					
				КонецЕсли;
				
				Попытка

					Если КоличествоПослеКорректировки = 0 Тогда

						ГрузоместоОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);						
						ГрузоместоОбъект.ПометкаУдаления = Истина;
						ГрузоместоОбъект.Неактуально_КорректировкаСборки = Истина;
						ГрузоместоОбъект.КорректировкаСборки = Ссылка;
						ГрузоместоОбъект.Записать(РежимЗаписиДокумента.Запись);
						
					Иначе
						ГрузоместоОбъект.Записать(РежимЗаписиДокумента.Проведение);
					КонецЕсли;
					
				Исключение
					
					#Если Клиент Тогда
						Сообщить(ОписаниеОшибки());
					#КонецЕсли
					
					//+Гавриленков В. 07.11.2025 #UT10-5497
					ЗаписьЖурналаРегистрации("Проведение Корректировки сборки заказов покупателя", УровеньЖурналаРегистрации.Ошибка, Метаданные.Документы.КорректировкаСборкиЗаказовПокупателя,, "Грузовое место " + Строка(ГрузоместоОбъект.Номер) + " не помечен на удаление: " + ОписаниеОшибки());
					//-Гавриленков В. 07.11.2025 #UT10-5497
					
				КонецПопытки;   			
				
			КонецЦикла;			
			
		КонецЕсли;

	КонецЕсли;
	
	ТаблицаТоваров = Товары.Выгрузить();
	ТаблицаТоваров.Свернуть("Номенклатура", "Количество");
	
	#Если Клиент Тогда
		Оповестить("ВведенаКорректировка", ТаблицаТоваров);
	#КонецЕсли
	
	Если Не Отказ И Константы.AMQP_ВыгружатьДанные.Получить() И СборкаЗаказовПокупателя.Договор.ВыгружаетсяВБиллинг Тогда
		Рез = AMQP_РаботаСДокументами.ОтправитьДокументКорректировкиВБиллинг(Ссылка);
	КонецЕсли;

КонецПроцедуры   

Функция ПолучитьТаблицуТоваровПрочихКорректировокСборок()  

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА КорректировкаСборкиЗаказовПокупателя.Организация = КорректировкаСборкиЗаказовПокупателя.СборкаЗаказовПокупателя.Организация
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьОшибкиЗаполненияОрганизации,
	|	ВЫБОР
	|		КОГДА КорректировкаСборкиЗаказовПокупателя.Контрагент = КорректировкаСборкиЗаказовПокупателя.СборкаЗаказовПокупателя.Контрагент
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьОшибкиЗаполненияКонтрагента,
	|	ВЫБОР
	|		КОГДА КорректировкаСборкиЗаказовПокупателя.Грузополучатель = КорректировкаСборкиЗаказовПокупателя.СборкаЗаказовПокупателя.Грузополучатель
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьОшибкиЗаполненияГрузополучателя,
	|	КорректировкаСборкиЗаказовПокупателя.Ссылка
	|ПОМЕСТИТЬ ВТ_КорректировкиСборок
	|ИЗ
	|	Документ.КорректировкаСборкиЗаказовПокупателя КАК КорректировкаСборкиЗаказовПокупателя
	|ГДЕ
	|	КорректировкаСборкиЗаказовПокупателя.СборкаЗаказовПокупателя = &Сборка
	|	И КорректировкаСборкиЗаказовПокупателя.Ссылка <> &Ссылка
	|	И КорректировкаСборкиЗаказовПокупателя.Проведен = ИСТИНА
	|	И КорректировкаСборкиЗаказовПокупателя.Исполнено = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыВЯчейках.Склад,
	|	ТоварыВЯчейках.Номенклатура,
	|	ТоварыВЯчейках.Ячейка,
	|	СУММА(ТоварыВЯчейках.Количество) КАК Количество
	|ПОМЕСТИТЬ ДвиженияТоварыВЯчейках
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках КАК ТоварыВЯчейках
	|ГДЕ
	|	ТоварыВЯчейках.Регистратор = &Сборка
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыВЯчейках.Склад,
	|	ТоварыВЯчейках.Номенклатура,
	|	ТоварыВЯчейках.Ячейка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыГотовыеКСборке.Номенклатура,
	|	СУММА(ТоварыГотовыеКСборке.Количество) КАК Количество,
	|	ТоварыГотовыеКСборке.ЗаказПокупателя КАК ЗаказПокупателя
	|ПОМЕСТИТЬ ДвиженияТоварыГотовыеКСборке
	|ИЗ
	|	РегистрНакопления.ТоварыГотовыеКСборке КАК ТоварыГотовыеКСборке
	|ГДЕ
	|	ТоварыГотовыеКСборке.Регистратор = &Сборка
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыГотовыеКСборке.Номенклатура,
	|	ТоварыГотовыеКСборке.ЗаказПокупателя
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КорректировкаСборкиЗаказовПокупателя.Ссылка
	|ПОМЕСТИТЬ Корректировки
	|ИЗ
	|	Документ.КорректировкаСборкиЗаказовПокупателя КАК КорректировкаСборкиЗаказовПокупателя
	|ГДЕ
	|	КорректировкаСборкиЗаказовПокупателя.СборкаЗаказовПокупателя = &Сборка
	|	И КорректировкаСборкиЗаказовПокупателя.Ссылка = &Ссылка
	|	И КорректировкаСборкиЗаказовПокупателя.Ссылка.Проведен
	|	И КорректировкаСборкиЗаказовПокупателя.Дата <= &ДатаОстатков
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабДокумента.Ссылка.СборкаЗаказовПокупателя КАК Ссылка,
