	НовыйЗаказНаПеремещениеВОП.IDСклада                = ?(Константы.FTPВыгрузкаОстатковКаталог.Получить() = "", 1, Число(Константы.FTPВыгрузкаОстатковКаталог.Получить()));
	НовыйЗаказНаПеремещениеВОП.УчитыватьНДС            = Истина;
	НовыйЗаказНаПеремещениеВОП.СуммаВключаетНДС        = Истина;
	НовыйЗаказНаПеремещениеВОП.ВалютаДокумента         = НовыйЗаказНаПеремещениеВОП.мВалютаРегламентированногоУчета;
	НовыйЗаказНаПеремещениеВОП.КратностьВзаиморасчетов = 1;
	НовыйЗаказНаПеремещениеВОП.КурсВзаиморасчетов      = 1; 
	НовыйЗаказНаПеремещениеВОП.Комментарий             = "Создан для передачи в ОП";

	Для Каждого СтрокаТаблЧастиТовары Из Ссылка.Товары Цикл
		
		НоваяСтрокаЗаказа = НовыйЗаказНаПеремещениеВОП.Товары.Добавить();
        ЗаполнитьЗначенияСвойств(НоваяСтрокаЗаказа,СтрокаТаблЧастиТовары);		
		НоваяСтрокаЗаказа.Размещение = Склад;
		//+Гавриленков В. 18.12.2025 #UT10-5598
		//НоваяСтрокаЗаказа.СтавкаНДС = НоваяСтрокаЗаказа.Номенклатура.СтавкаНДС;
		НоваяСтрокаЗаказа.СтавкаНДС = УчетНДС.ПолучитьСтавкуНДСПоНоменклатуре(НоваяСтрокаЗаказа.Номенклатура, НовыйЗаказНаПеремещениеВОП.Дата);
		//-Гавриленков В. 18.12.2025 #UT10-5598
		ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НоваяСтрокаЗаказа, НовыйЗаказНаПеремещениеВОП);
		
	КонецЦикла;
	
	НовыйЗаказНаПеремещениеВОП.Записать();
	
	Попытка
		
		НовыйЗаказНаПеремещениеВОП.Записать(РежимЗаписиДокумента.Проведение); 
		#Если Клиент Тогда 	 
			Сообщить("Записан документ " + СокрЛП(НовыйЗаказНаПеремещениеВОП)); 
		#КонецЕсли
		ЗаказНаперемещениеВОП = НовыйЗаказНаПеремещениеВОП.Ссылка;
		Записать();
		
	Исключение                  
		#Если Клиент Тогда 	 
			Сообщить("При записи документа " + СокрЛП(НовыйЗаказНаПеремещениеВОП)+" произошла ошибка "); 
		#КонецЕсли
		Отказ = Истина;
		Возврат;
		
	КонецПопытки;
	
	// Создаем документи сборка
	НовыйДокументСборкаЗаказов 					         = Документы.СборкаЗаказовПокупателя.СоздатьДокумент();
	НовыйДокументСборкаЗаказов.Дата				         = ТекущаяДата();
	НовыйДокументСборкаЗаказов.Ответственный             = Справочники.ФизическиеЛица.Автосборка;
	НовыйДокументСборкаЗаказов.ВремяНачалаСборки         = ТекущаяДата();
	НовыйДокументСборкаЗаказов.ВремяОкончанияСборки      = ТекущаяДата();
	НовыйДокументСборкаЗаказов.ДокументСобранИУпакован   = Истина; 
	НовыйДокументСборкаЗаказов.КоличествоУпаковочныхМест = 1;
	НовыйДокументСборкаЗаказов.Контрагент 		         = ГрузополучательТОХ.ГоловнойКонтрагент;
	НовыйДокументСборкаЗаказов.Грузополучатель 	         = ГрузополучательТОХ; 
	НовыйДокументСборкаЗаказов.Договор 			         = ДоговорГрузополучателяТОХ;
	НовыйДокументСборкаЗаказов.СпособДоставки 	         = Перечисления.СпособДоставки.Самовывоз;
	НовыйДокументСборкаЗаказов.ВремяНачалаСборки         = ТекущаяДата();
	НовыйДокументСборкаЗаказов.ДатаДоставкиКлиенту       = ТекущаяДата();
	НовыйДокументСборкаЗаказов.Организация 		         = Организация; 
	НовыйДокументСборкаЗаказов.ДоговорПоставщикаТОХ      = ДоговорКонтрагента;

	ТоварыЗаказаПокупателя = ЗаказНаперемещениеВОП.Товары.Выгрузить(,"Номенклатура,Количество"); 
