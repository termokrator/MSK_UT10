	ТоварыЗаказаПокупателя.Колонки.Добавить("Заказ");
	ТоварыЗаказаПокупателя.ЗаполнитьЗначения(ЗаказНаперемещениеВОП.Ссылка,"Заказ");	
	
	ТоварыЗаказаПокупателя.Колонки.Добавить("Ячейка"); 
	ТоварыЗаказаПокупателя.ЗаполнитьЗначения(ЯчейкаВиртуальногоРазмещенияТОХ,"Ячейка");
	
	ТоварыЗаказаПокупателя.Колонки.Добавить("Подборка");
	ТоварыЗаказаПокупателя.ЗаполнитьЗначения(Перечисления.ПодборкаНоменклатуры.Собрано,"Подборка");	
	
	ТоварыЗаказаПокупателя.Колонки.Добавить("Факт");

	Для Каждого ПромСтрокаТоварыЗаказа Из ТоварыЗаказаПокупателя Цикл
		ПромСтрокаТоварыЗаказа.Факт = ПромСтрокаТоварыЗаказа.Количество;
	КонецЦикла;
	
	Для Каждого СтрокаТоварыЗаказаПокупателя Из ТоварыЗаказаПокупателя Цикл
		
		НоваяСтрокаСборкиЗаказов = НовыйДокументСборкаЗаказов.Заказано.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаСборкиЗаказов,СтрокаТоварыЗаказаПокупателя);
		
	КонецЦикла;
	
    НовыйДокументСборкаЗаказов.Записать();
	
	Попытка
		
		НовыйДокументСборкаЗаказов.Записать(РежимЗаписиДокумента.Проведение);
		#Если Клиент Тогда 	
		Сообщить("Записан документ " + СокрЛП(НовыйДокументСборкаЗаказов));  
		#КонецЕсли
		
	Исключение
		#Если Клиент Тогда 	
		Сообщить("При записи документа " + СокрЛП(НовыйДокументСборкаЗаказов)+" произошла ошибка ");
		#КонецЕсли
		Отказ = Истина;
		Возврат;
		
	КонецПопытки;
	
	// Создаем документ реализация 
	НовыйДокументРеализация									= Документы.РеализацияТоваровУслуг.СоздатьДокумент();
	НовыйДокументРеализация.Дата							= ТекущаяДата(); 
	НовыйДокументРеализация.ВидОперации 					= Перечисления.ВидыОперацийРеализацияТоваров.ПродажаКомиссия ;
	НовыйДокументРеализация.Организация 					= Организация; 
	
	Если НовыйДокументРеализация.Организация = Константы.ОсновнаяОрганизация.Получить() Тогда
		
		НовыйДокументРеализация.ОтражатьВБухгалтерскомУчете = Истина;
		НовыйДокументРеализация.ОтражатьВНалоговомУчете     = Истина;
		
	КонецЕсли;				  
	
	НовыйДокументРеализация.Контрагент 					    = ГрузополучательТОХ.ГоловнойКонтрагент;
	НовыйДокументРеализация.ДоговорКонтрагента 			    = ДоговорГрузополучателяТОХ; 
	НовыйДокументРеализация.БанковскийСчетОрганизации 	    = Организация.ОсновнойБанковскийСчет; 
	НовыйДокументРеализация.Грузополучатель				    = ГрузополучательТОХ; 
	НовыйДокументРеализация.Склад   						= Склад;
	НовыйДокументРеализация.ОтражатьВУправленческомУчете    = Истина;
	НовыйДокументРеализация.ВалютаДокумента 			    = ДоговорГрузополучателяТОХ.ВалютаВзаиморасчетов;
	НовыйДокументРеализация.УчитыватьНДС 				    = Истина;
	НовыйДокументРеализация.СуммаВключаетНДС 			    = Истина;
	НовыйДокументРеализация.КурсВзаиморасчетов  		    = 1;
	НовыйДокументРеализация.КратностьВзаиморасчетов 	    = 1;
	НовыйДокументРеализация.ВидПередачи 				    = Перечисления.ВидыПередачиТоваров.СоСклада;
	НовыйДокументРеализация.Ответственный 			        = ПараметрыСеанса.ТекущийПользователь;
	НовыйДокументРеализация.ДоговорПоставщикаТОХ            = ДоговорКонтрагента; 
	НовыйДокументРеализация.Комментарий                     = "Создан для передачи в ОП";

	Для Каждого СтрокаЗаказаНаПеремещение Из ЗаказНаперемещениеВОП.Товары Цикл
		
		НоваяСтрокаРеализации							   = НовыйДокументРеализация.Товары.Добавить(); 
		НоваяСтрокаРеализации.Номенклатура 			       = СтрокаЗаказаНаПеремещение.Номенклатура;
		НоваяСтрокаРеализации.СерияНоменклатуры 	       = СтрокаЗаказаНаПеремещение.СерияНоменклатуры;
		НоваяСтрокаРеализации.ЕдиницаИзмерения 		       = СтрокаЗаказаНаПеремещение.ЕдиницаИзмерения ;
		НоваяСтрокаРеализации.Коэффициент 			       = СтрокаЗаказаНаПеремещение.Коэффициент;
		НоваяСтрокаРеализации.Количество 			       = СтрокаЗаказаНаПеремещение.Количество;
		НоваяСтрокаРеализации.ЗаказПокупателя 		       = ЗаказНаперемещениеВОП.Ссылка ;
		НоваяСтрокаРеализации.Цена 					       = СтрокаЗаказаНаПеремещение.Цена;
		НоваяСтрокаРеализации.СтавкаНДС 			       = СтрокаЗаказаНаПеремещение.СтавкаНДС ;
		НоваяСтрокаРеализации.Сумма 				       = НоваяСтрокаРеализации.Количество*СтрокаЗаказаНаПеремещение.Цена;
		НоваяСтрокаРеализации.СуммаНДС 					   = УчетНДС.РассчитатьСуммуНДС(НоваяСтрокаРеализации.Сумма, Истина, Истина, 
		                                                     УчетНДС.ПолучитьСтавкуНДС(НоваяСтрокаРеализации.СтавкаНДС));
		НоваяСтрокаРеализации.СпособСписанияОстаткаТоваров = Перечисления.СпособыСписанияОстаткаТоваров.ИзРезерва;
		
	КонецЦикла;
	
	НовыйДокументРеализация.ЗаполнитьЯчейки();

	НоваяСтрокаСборкиРеализация = НовыйДокументРеализация.ДокументыСборкиЗаказов.Добавить();
	НоваяСтрокаСборкиРеализация.ДокументСборки = НовыйДокументСборкаЗаказов.Ссылка;
	
	НовыйДокументРеализация.Записать();

	Попытка
		
		НовыйДокументРеализация.Записать(РежимЗаписиДокумента.Проведение);  
		
		Если НовыйДокументРеализация.ОтражатьВБухгалтерскомУчете И НовыйДокументРеализация.Проведен Тогда
			
			Если УчетНДС.ДопустимоСозданиеСчетаФактурыПоПараметруКроссДокинг(НовыйДокументРеализация.Ссылка) 
				И УчетНДС.ДопустимоСозданиеСчетаФактурыПоПараметруОформлятьРеализацииКакВнутреннееПеремещение(НовыйДокументРеализация.Ссылка) 										
				И УчетНДС.ДопустимоСозданиеСчетаФактурыПоОбособленномуПодразделению(НовыйДокументРеализация.Ссылка) 
				И НЕ НовыйДокументРеализация.Контрагент = Константы.КонтрагентВодитель.Получить() Тогда
				
				ДокСФ = Документы.СчетФактураВыданный.СоздатьДокумент();
				ДокСФ.Дата = НовыйДокументРеализация.Дата + 1;	
				ДокСФ.Выставлен = Истина;
				ДокСФ.ДатаВыставления = ТекущаяДата();
				ДокСФ.ДокументыОснования.Очистить();
				ДокСФ.Заполнить(НовыйДокументРеализация.Ссылка);
				ДокСФ.ДатаНомерДокументовОплаты.Добавить();
				ДокСФ.Ответственный = ПараметрыСеанса.ТекущийПользователь;
				ДокСФ.Записать(РежимЗаписиДокумента.Проведение);  
				
			КонецЕсли;
			
		КонецЕсли; 
		
		#Если Клиент Тогда 		
			Сообщить("Записан документ " + СокрЛП(НовыйДокументРеализация));
		#КонецЕсли

	Исключение
		
		#Если Клиент Тогда
		Сообщить("При записи документа " + СокрЛП(НовыйДокументРеализация)+" произошла ошибка "); 
		#КонецЕсли
		Отказ = Истина;
		Возврат;
		
	КонецПопытки;

КонецПроцедуры

	
мВалютаРегламентированногоУчета = глЗначениеПеременной("ВалютаРегламентированногоУчета");
УказаниеСкладов = глЗначениеПеременной("УказаниеСкладовВТабличнойЧастиДокументов");

мУказаниеСкладовВТЧ = (УказаниеСкладов = Перечисления.ВариантыУказанияСкладовВТабличнойЧастиДокументов.ДляДокументовПоступленияРеализации)
Или (УказаниеСкладов = Перечисления.ВариантыУказанияСкладовВТабличнойЧастиДокументов.ДляДокументовПоступления);