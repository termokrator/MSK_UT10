Перем мВалютаРегламентированногоУчета Экспорт;
Перем мУказаниеСкладовВТЧ Экспорт;
Перем мУдалятьДвижения;

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Если мУдалятьДвижения Тогда
		ОбщегоНазначения.УдалитьДвиженияРегистратора(ЭтотОбъект, Отказ);
	КонецЕсли;
	
	//Товары на складах 
	НаборДвижений = Движения.ТоварыНаСкладах;
	ТаблицаДвижений = НаборДвижений.ВыгрузитьКолонки();
	
	Для Каждого СтрокаТовары Из Товары Цикл
		
		СтрокаДвижений = ТаблицаДвижений.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДвижений,СтрокаТовары);
		
	КонецЦикла;	
	
	ТаблицаДвижений.ЗаполнитьЗначения(Справочники.Качество.Новый, "Качество");
	ТаблицаДвижений.ЗаполнитьЗначения(Склад, "Склад");
	
	НаборДвижений.мПериод            = Дата;
	НаборДвижений.мТаблицаДвижений   = ТаблицаДвижений;
	
	Если Не Отказ Тогда
		Движения.ТоварыНаСкладах.ВыполнитьПриход();
	КонецЕсли;
	
	//+Шульман А. 16.12.2024 #UT10-4995
	Если Справочники.МТ_ПредопределенныеЗначения.ИспользоватьПроцессПеремещениеНеликвидаТОХвГП.Значение = Истина 
	   И ВидПроцесса = Перечисления.ВидыПроцессов.ПеремещениеНеликвидаТОХвГП Тогда  
	   // Не делать движение по ТоварыОтветственногоХранения
	//-Шульман А. 16.12.2024 #UT10-4995
	   
	Иначе
		//Товары ответственного хранения 
		НаборДвижений = Движения.ТоварыОтветственногоХранения;
		ТаблицаДвижений = НаборДвижений.ВыгрузитьКолонки();
		
		Для Каждого СтрокаТовары Из Товары Цикл
			
			СтрокаДвижений = ТаблицаДвижений.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДвижений,СтрокаТовары);
			
		КонецЦикла;	
		
		ТаблицаДвижений.ЗаполнитьЗначения(Организация, "Организация");
		ТаблицаДвижений.ЗаполнитьЗначения(Контрагент, "Контрагент");
		ТаблицаДвижений.ЗаполнитьЗначения(ДоговорКонтрагента, "ДоговорКонтрагента");
		
		НаборДвижений.мПериод            = Дата;
		НаборДвижений.мТаблицаДвижений   = ТаблицаДвижений;
		
		Если Не Отказ Тогда
			Движения.ТоварыОтветственногоХранения.ВыполнитьПриход();
		КонецЕсли;  
		
	КонецЕсли;
	
	// ТОВАРЫ ПО РЕГИСТРУ ТоварыОрганизаций.
	НаборДвижений = Движения.ТоварыОрганизаций;	
	
	// Получим таблицу значений, совпадающую со структурой набора записей регистра.
	ТаблицаДвижений = НаборДвижений.ВыгрузитьКолонки();
	
	// Заполним таблицу движений.
	//ОбщегоНазначения.ЗагрузитьВТаблицуЗначений(ТаблицаПоТоварам, ТаблицаДвижений);
	Для Каждого СтрокаТовары Из Товары Цикл
		СтрокаДвижений = ТаблицаДвижений.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДвижений,СтрокаТовары);
	КонецЦикла;	
	
	// Недостающие поля.
	ТаблицаДвижений.ЗаполнитьЗначения(Организация, "Организация");
	ТаблицаДвижений.ЗаполнитьЗначения(Неопределено,"Комиссионер"); 
	ТаблицаДвижений.ЗаполнитьЗначения(Склад,"Склад");
	ТаблицаДвижений.ЗаполнитьЗначения(Справочники.Качество.Новый, "Качество");
	
	СтруктураУП = ОбщегоНазначения.ПолучитьПараметрыУчетнойПолитики(ТекущаяДата(), Отказ, , "Упр"); 
	
	Если Не Отказ Тогда
		ВестиУчетТоваровОрганизацийВРазрезеСкладов = СтруктураУП.ВестиУчетТоваровОрганизацийВРазрезеСкладов;
	КонецЕсли;
	
	Если Не ВестиУчетТоваровОрганизацийВРазрезеСкладов Тогда
		ТаблицаДвижений.ЗаполнитьЗначения(Неопределено, "Склад");
	КонецЕсли;
	
	НаборДвижений.мПериод            = Дата;
	НаборДвижений.мТаблицаДвижений   = ТаблицаДвижений;
	
	Если Не Отказ Тогда                  
		
		//+Шульман А. 16.12.2024 #UT10-4995
		Если Справочники.МТ_ПредопределенныеЗначения.ИспользоватьПроцессПеремещениеНеликвидаТОХвГП.Значение = Истина 
		   И ВидПроцесса = Перечисления.ВидыПроцессов.ПеремещениеНеликвидаТОХвГП Тогда   
		   
			ДвиженияПоРегиструТоварыОтветственногоХраненияПереданные(Отказ);		  
		//-Шульман А. 16.12.2024 #UT10-4995
		   
		Иначе
			ВыполнитьДвижениеПоРегиструТОХП(Отказ);   
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не Отказ Тогда
		Движения.ТоварыОрганизаций.ВыполнитьПриход();
	КонецЕсли;
	
	//+Кабанов А.В. 15.07.2025 # UT10-5323
	// ТОВАР ПО РЕГИСТРУ ЗаказыПоставщикам.
	НаборДвижений = Движения.ЗаказыПоставщикам;	
	
	// Получим таблицу значений, совпадающую со структурой набора записей регистра.
	ТаблицаДвижений = НаборДвижений.ВыгрузитьКолонки();
	
	Для Каждого СтрокаТовары Из Товары Цикл 
		
		СтрокаДвижений = ТаблицаДвижений.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДвижений,СтрокаТовары);
		СтрокаДвижений.СуммаВзаиморасчетов = СтрокаТовары.Сумма;
		СтрокаДвижений.СуммаУпр            = СтрокаТовары.Сумма;
		//+Гавриленков В. 18.12.2025 #UT10-5598
		//СтрокаДвижений.СтавкаНДС           = СтрокаТовары.Номенклатура.СтавкаНДС;
		СтрокаДвижений.СтавкаНДС           = УчетНДС.ПолучитьСтавкуНДСПоНоменклатуре(СтрокаТовары.Номенклатура, Дата);
		//-Гавриленков В. 18.12.2025 #UT10-5598
		
	КонецЦикла;

	СтруктТаблицДокумента = Новый Структура;
	СтруктТаблицДокумента.Вставить("ТаблицаПоТоварам",      ТаблицаДвижений);
	
	ТаблицыДанныхДокумента = ОбщегоНазначения.ЗагрузитьТаблицыДокументаВСтруктуру(Движения.ЗаказыПоставщикам, СтруктТаблицДокумента);
	
	ОбщегоНазначения.УдалитьСтрокиИзТаблицДокумента(ТаблицыДанныхДокумента, "ЗаказПоставщику");
	
	Для Каждого СтрокаДвижений Из ТаблицыДанныхДокумента.ТаблицаПоТоварам Цикл 
		СтрокаДвижений.ДоговорКонтрагента  = СтрокаДвижений.ЗаказПоставщику.ДоговорКонтрагента;		
	КонецЦикла;
	
	ОбщегоНазначения.УстановитьЗначениеВТаблицыДокумента(ТаблицыДанныхДокумента, "СтатусПартии", Перечисления.СтатусыПартийТоваров.Купленный, "ТаблицаПоТоварам");
	
	ОбщегоНазначения.ЗаписатьТаблицыДокументаВРегистр(Движения.ЗаказыПоставщикам, ВидДвиженияНакопления.Расход, ТаблицыДанныхДокумента, Дата);
	
	//-Кабанов А.В. 15.07.2025 # UT10-5323

	//+Кабанов А.В. 12.11.2024 #UT10-4872
	Если Не Отказ Тогда
		Если МСКWEB.ЗначениеДопСвойства(Ссылка,ПланыВидовХарактеристик.СвойстваОбъектов.СтатусПриемки) = Неопределено Тогда
			МСКWEB.УстановитьЗначениеДопСвойства(Ссылка,ПланыВидовХарактеристик.СвойстваОбъектов.СтатусПриемки,Перечисления.СтатусыПриемки.ВПути);
		КонецЕсли;
	КонецЕсли;
	//-Кабанов А.В. 12.11.2024 #UT10-4872
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	мУдалятьДвижения = НЕ ЭтоНовый();
	
	Если ОбменДанными.Загрузка  Тогда
		Возврат;
	КонецЕсли;
	
	СуммаДокумента = УчетНДС.ПолучитьСуммуДокументаСНДС(ЭтотОбъект);
	// Проверка заполнения единицы измерения мест и количества мест
	ОбработкаТабличныхЧастей.ПриЗаписиПроверитьЕдиницуИзмеренияМест(Товары);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	НепроверяемыеРеквизиты = Новый Массив;

	НепроверяемыеРеквизиты.Добавить("ДатаВходящегоДокумента");
	НепроверяемыеРеквизиты.Добавить("НомерВходящегоДокумента");
    НепроверяемыеРеквизиты.Добавить("НомерСкладскогоДокумента");
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);

КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ОбщегоНазначения.УдалитьДвиженияРегистратора(ЭтотОбъект, Отказ); 

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ИДДокументаВСмежнойБазе = "";
	
КонецПроцедуры

Процедура ВыполнитьДвижениеПоРегиструТОХП(Отказ)
	
	НаборДвижений = Движения.ТоварыТОХпоДаннымПоставщиков;
	ТаблицаДвижений = НаборДвижений.ВыгрузитьКолонки();
	
	Для Каждого СтрокаТовары Из Товары Цикл
		
		СтрокаДвижений = ТаблицаДвижений.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДвижений,СтрокаТовары);
		
	КонецЦикла;	
	
	ТаблицаДвижений.ЗаполнитьЗначения(Организация, "Организация");
	ТаблицаДвижений.ЗаполнитьЗначения(Контрагент, "Контрагент");
	ТаблицаДвижений.ЗаполнитьЗначения(ДоговорКонтрагента, "Договор");
	
	НаборДвижений.мПериод            = Дата;
	НаборДвижений.мТаблицаДвижений   = ТаблицаДвижений;
	
	Если Не Отказ Тогда
		Движения.ТоварыТОХпоДаннымПоставщиков.ВыполнитьПриход();
	КонецЕсли;
	
	Если НЕ Отказ Тогда
		ОтправитьВОП(Отказ);
	КонецЕсли;

КонецПроцедуры     

Процедура ДвиженияПоРегиструТоварыОтветственногоХраненияПереданные(Отказ)	
	
	//+Шульман А. 16.12.2024 #UT10-4995
	НаборДвижений = Движения.ТоварыОтветственногоХраненияПереданные;	
	ТаблицаДвижений = НаборДвижений.ВыгрузитьКолонки(); 

    ЗапросДвиженийТоварыТОХПереданные = Новый Запрос;
	ЗапросДвиженийТоварыТОХПереданные.Текст =
	"ВЫБРАТЬ
	|	ПоступлениеТоваровНаОтветственноеХранение.Ссылка.Организация КАК Организация,
	|	ПоступлениеТоваровНаОтветственноеХранение.Ссылка.Контрагент КАК Контрагент,
	|	ПоступлениеТоваровНаОтветственноеХранение.Ссылка.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ПоступлениеТоваровНаОтветственноеХранение.Ссылка.Филиал КАК Филиал,
	|	ПоступлениеТоваровНаОтветственноеХранение.Номенклатура,
	|	ПоступлениеТоваровНаОтветственноеХранение.ХарактеристикаНоменклатуры,
	|	ПоступлениеТоваровНаОтветственноеХранение.СерияНоменклатуры,
	|	ПоступлениеТоваровНаОтветственноеХранение.Количество
	|ИЗ
	|	Документ.ПоступлениеТоваровНаОтветственноеХранение.Товары КАК ПоступлениеТоваровНаОтветственноеХранение
	|ГДЕ
	|	ПоступлениеТоваровНаОтветственноеХранение.Ссылка = &Ссылка";
	
	ЗапросДвиженийТоварыТОХПереданные.УстановитьПараметр("Ссылка",Ссылка);
	
	ПромТаблицаДвижений = ЗапросДвиженийТоварыТОХПереданные.Выполнить().Выгрузить();
	
	ОбщегоНазначения.ЗагрузитьВТаблицуЗначений(ПромТаблицаДвижений, ТаблицаДвижений);
	НаборДвижений.мПериод          = Дата;
	НаборДвижений.мТаблицаДвижений = ТаблицаДвижений;			
	
	Если Не Отказ Тогда
		Движения.ТоварыОтветственногоХраненияПереданные.ВыполнитьРасход();
	КонецЕсли;
	//-Шульман А. 16.12.2024 #UT10-4995

КонецПроцедуры

Процедура ОтправитьВОП(Отказ) Экспорт 
	
	ЯчейкаВиртуальногоРазмещенияТОХ = Константы.ЯчейкаДляВиртуальногоРазмещенияТОХ.Получить();

	Если  НЕ ЗначениеЗаполнено(ГрузополучательТОХ) Или НЕ ЗначениеЗаполнено(ДоговорГрузополучателяТОХ) 
		ИЛИ НЕ ЗначениеЗаполнено(ЯчейкаВиртуальногоРазмещенияТОХ) ИЛИ ЗначениеЗаполнено(ЗаказНаперемещениеВОП)  Тогда
		Возврат;
	КонецЕсли;         
	
	//Создаем документ размещение по ячейкам
	СоздаемРазмещение = Истина;
	
	ЕстьДокументРазмещения = Документы.РазмещениеПоЯчейкам.НайтиПоРеквизиту("ДокументОснование",Ссылка);
	
	Если ЗначениеЗаполнено(ЕстьДокументРазмещения) И ЕстьДокументРазмещения.Проведен Тогда
		СоздаемРазмещение = Ложь;
	КонецЕсли;
	
	Если СоздаемРазмещение Тогда
		
		НовыйДокументРазмещение                          = Документы.РазмещениеПоЯчейкам.СоздатьДокумент();
		НовыйДокументРазмещение.ДокументОснование        = Ссылка;
		НовыйДокументРазмещение.Дата                     = ТекущаяДата();
		НовыйДокументРазмещение.Склад                    = Склад;							
		НовыйДокументРазмещение.Ответственный            = ПараметрыСеанса.ТекущийПользователь.ФизЛицо;
		НовыйДокументРазмещение.НомерСкладскогоДокумента = НомерСкладскогоДокумента;
		НовыйДокументРазмещение.Клеверенс                = Истина;
		НовыйДокументРазмещение.Комментарий              = "Создан для передачи в ОП";
		
		ТаблицаТоваров = Товары.Выгрузить(,"Номенклатура,Количество");
		ТаблицаТоваров.Свернуть("Номенклатура","Количество"); 
		
		Для Каждого СтрокаТаблицыТоваров  Из ТаблицаТоваров Цикл
			
			Товар			     = НовыйДокументРазмещение.Товары.Добавить();	
			Товар.Номенклатура   = СтрокаТаблицыТоваров.Номенклатура;
			Товар.Количество     = СтрокаТаблицыТоваров.Количество;
			Товар.Ячейка         = ЯчейкаВиртуальногоРазмещенияТОХ;
			Товар.ВведеноВручную = Ложь;
			
		КонецЦикла;
		
		НовыйДокументРазмещение.Записать();

		Попытка
			
			НовыйДокументРазмещение.Записать(РежимЗаписиДокумента.Проведение);
			#Если Клиент Тогда 	 
			Сообщить("Записан документ " + СокрЛП(НовыйДокументРазмещение));
			#КонецЕсли    
		
		Исключение               
		
			#Если Клиент Тогда 	 
			Сообщить("При записи документа " + СокрЛП(НовыйДокументРазмещение) + " произошла ошибка "); 
			#КонецЕсли
			Отказ = Истина;
			Возврат;
			
		КонецПопытки;
		
	КонецЕсли;
	
	//Создаем заказ покупателя
	
	НовыйЗаказНаПеремещениеВОП                         = Документы.ЗаказПокупателя.СоздатьДокумент();
	НовыйЗаказНаПеремещениеВОП.Дата                    = ТекущаяДата();
	НовыйЗаказНаПеремещениеВОП.ДатаОтгрузки            = ТекущаяДата();
	НовыйЗаказНаПеремещениеВОП.Ответственный           = ПараметрыСеанса.ТекущийПользователь;
	НовыйЗаказНаПеремещениеВОП.Организация             = Организация;
	НовыйЗаказНаПеремещениеВОП.Контрагент              = ГрузополучательТОХ.ГоловнойКонтрагент;
	НовыйЗаказНаПеремещениеВОП.Грузополучатель         = ГрузополучательТОХ;
	НовыйЗаказНаПеремещениеВОП.ДоговорКонтрагента      = ДоговорГрузополучателяТОХ;
	НовыйЗаказНаПеремещениеВОП.ДоговорПоставщикаТОХ    = ДоговорКонтрагента; 
	НовыйЗаказНаПеремещениеВОП.ТипЦен                  = ДоговорГрузополучателяТОХ.ТипЦен;
	
	ЗаполнениеДокументов.ЗаполнитьШапкуДокумента(НовыйЗаказНаПеремещениеВОП, ПараметрыСеанса.ТекущийПользователь, 
	             НовыйЗаказНаПеремещениеВОП.мВалютаРегламентированногоУчета, "Продажа", Неопределено, Неопределено, 
				 НовыйЗаказНаПеремещениеВОП.мСтруктураПараметровДляПолученияДоговора);
	
	НовыйЗаказНаПеремещениеВОП.СпособДоставки          = Перечисления.СпособДоставки.Самовывоз;
