КонецФункции

Процедура СоздатьСФПоКорректировке(НДок, ПараметрыСтруктура)
	
	НСф = Документы.СчетФактураПолученный.СоздатьДокумент();
	НСф.Дата = ТекущаяДата();
	НСф.Заполнить(НДок.Ссылка);            
	НСф.НомерВходящегоДокумента = ПараметрыСтруктура.НомерСФ;
	НСф.ДатаВходящегоДокумента = XMLЗначение(Тип("Дата"), ПараметрыСтруктура.ДатаСФ);
	
	Если НСф.ДокументыОснования.Количество() > 0 Тогда
		
		СФ = УчетНДС.НайтиПодчиненныйСчетФактуру(НДок.ДокументПоступления, "СчетФактураПолученный");
		
		Если ЗначениеЗаполнено(СФ) Тогда
			
			НСф.ДокументыОснования[0].НомерИсходногоДокумента = СФ.НомерВходящегоДокумента;
			НСф.ДокументыОснования[0].ДатаИсходногоДокумента = СФ.ДатаВходящегоДокумента;
			
		Иначе
			
			НСф.ДокументыОснования[0].НомерИсходногоДокумента = НСф.НомерВходящегоДокумента;
			НСф.ДокументыОснования[0].ДатаИсходногоДокумента = НСф.ДатаВходящегоДокумента;
			
		КонецЕсли;
		
	КонецЕсли;
	
	НСф.Записать(РежимЗаписиДокумента.Проведение);	
	
КонецПроцедуры

Функция ПолучитьКорректировкуПоИД(ИД)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КорректировкаПоступления.Ссылка
	|ИЗ
	|	Документ.КорректировкаПоступления КАК КорректировкаПоступления
	|ГДЕ
	|	КорректировкаПоступления.ИДДокументаВСмежнойБазе = &ИДДокументаВСмежнойБазе
	|	И НЕ КорректировкаПоступления.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ИДДокументаВСмежнойБазе", ИД);  
	
	Выборка = Запрос.Выполнить().Выбрать();                
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;                 
	
	Возврат Неопределено;
		
КонецФункции
