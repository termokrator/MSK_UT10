			Попытка
				
				Об = Ссылка.ПолучитьОбъект();
				Об.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
				
				СФ = УчетНДС.НайтиПодчиненныйСчетФактуру(Об.Ссылка, "СчетФактураПолученный");
	
				Если Не ЗначениеЗаполнено(СФ) Тогда
					
