Функция СоздатьКорректировкуПТУ(ПараметрыСтруктура) Экспорт
	//+Белов А. 22.10.2025 #UT10-5464
	
	СтруктураВозврата = Новый Структура("Результат, Сообщение", Ложь, "");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПоступлениеТоваровУслуг.Ссылка,
	|	1 КАК Приоритет
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
	|ГДЕ
	|	ПоступлениеТоваровУслуг.ИДДокументаВСмежнойБазе = &ИДДокументаВСмежнойБазе
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КорректировкаПоступления.Ссылка,
	|	2
	|ИЗ
	|	Документ.КорректировкаПоступления КАК КорректировкаПоступления
	|ГДЕ
	|	КорректировкаПоступления.ИДДокументаВСмежнойБазе = &ИДДокументаВСмежнойБазе
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет";
	
	Запрос.УстановитьПараметр("ИДДокументаВСмежнойБазе", ПараметрыСтруктура.ОснованиеГУИД);  
	
	Выборка = Запрос.Выполнить().Выбрать(); 
	
	Если Выборка.Следующий() Тогда		
		ДокументОснование = Выборка.Ссылка;
	Иначе
		
		СтруктураВозврата.Сообщение = "Не найден документ основание";
		Возврат СтруктураВозврата;
		
	КонецЕсли;           
	
	Ссылка = ПолучитьКорректировкуПоИД(ПараметрыСтруктура.ГУИД);
	
