					Если СтрокаПоиска.Количество = 0 Тогда
						СтрокаПоиска.Заказ = Неопределено;
					КонецЕсли;
					СтрокаПоиска.ОтражатьТоварныйУчет = Истина;
					
					СтрокаПоиска.Обработано = Истина;
					ИзмененияВнесены = Истина;
					
				КонецЦикла;
				
			КонецЕсли;
			
