			ФильтрПоНоменклатуре = мТаблицаДвиженийПартииТоваровНаСкладах.ВыгрузитьКолонку("Номенклатура");
			ФильтрПоСкладу = мТаблицаДвиженийПартииТоваровНаСкладах.ВыгрузитьКолонку("Склад");
			ФильтрПоХарактеристикаНоменклатуры = мТаблицаДвиженийПартииТоваровНаСкладах.ВыгрузитьКолонку("ХарактеристикаНоменклатуры");
			ФильтрПоСерияНоменклатуры = мТаблицаДвиженийПартииТоваровНаСкладах.ВыгрузитьКолонку("СерияНоменклатуры");
			ФильтрПоКачество = мТаблицаДвиженийПартииТоваровНаСкладах.ВыгрузитьКолонку("Качество"); 
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ПартииТоваровНаСкладахОстатки.Номенклатура,
			|	ПартииТоваровНаСкладахОстатки.Склад,
			|	ПартииТоваровНаСкладахОстатки.ХарактеристикаНоменклатуры,
			|	ПартииТоваровНаСкладахОстатки.СерияНоменклатуры,
			|	ПартииТоваровНаСкладахОстатки.ДокументОприходования,
			|	ПартииТоваровНаСкладахОстатки.СтатусПартии,
			|	ПартииТоваровНаСкладахОстатки.Заказ,
			|	ПартииТоваровНаСкладахОстатки.Качество,
			|	СУММА(ПартииТоваровНаСкладахОстатки.КоличествоОстаток) КАК КоличествоОстаток,
			|	СУММА(ПартииТоваровНаСкладахОстатки.СтоимостьОстаток) КАК СтоимостьОстаток
			|ИЗ
			|	РегистрНакопления.ПартииТоваровНаСкладах.Остатки(
			|			&Д,
			|			Качество В (&Качество)
			|				И Номенклатура В (&Номенклатура)
			|				И Склад В (&Склад)
			|				И ХарактеристикаНоменклатуры В (&ХарактеристикаНоменклатуры)) КАК ПартииТоваровНаСкладахОстатки
			|
			|СГРУППИРОВАТЬ ПО
			|	ПартииТоваровНаСкладахОстатки.Номенклатура,
			|	ПартииТоваровНаСкладахОстатки.Склад,
			|	ПартииТоваровНаСкладахОстатки.ХарактеристикаНоменклатуры,
			|	ПартииТоваровНаСкладахОстатки.СерияНоменклатуры,
			|	ПартииТоваровНаСкладахОстатки.ДокументОприходования,
			|	ПартииТоваровНаСкладахОстатки.СтатусПартии,
			|	ПартииТоваровНаСкладахОстатки.Заказ,
			|	ПартииТоваровНаСкладахОстатки.Качество
			|
			|УПОРЯДОЧИТЬ ПО
			|	ПартииТоваровНаСкладахОстатки.ДокументОприходования.Дата";
			
			Запрос.УстановитьПараметр("Д", Д);
			Запрос.УстановитьПараметр("Качество", ФильтрПоКачество);
			Запрос.УстановитьПараметр("Номенклатура", ФильтрПоНоменклатуре);
			Запрос.УстановитьПараметр("Склад", ФильтрПоСкладу);
			Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры", ФильтрПоХарактеристикаНоменклатуры ); 
			
			ОстаткиПоПартиям = Запрос.Выполнить().Выгрузить();  
			
			КолонкиГруппировки = "";
			КолонкиСуммирования = "";  
			
			Для Каждого ТекКолонка Из мТаблицаДвиженийПартииТоваровНаСкладах.Колонки Цикл
				
