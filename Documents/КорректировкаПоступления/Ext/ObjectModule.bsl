					КолонкиСуммирования = КолонкиСуммирования + ", " + ТекКолонка.Имя;
				Иначе
					КолонкиГруппировки = КолонкиГруппировки + ", " + ТекКолонка.Имя;
				КонецЕсли;
				
			КонецЦикла; 
			
			мТаблицаДвиженийПартииТоваровНаСкладах.Свернуть(Сред(КолонкиГруппировки, 2), Сред(КолонкиСуммирования, 2));
			
			сч = 0;
			Пока сч < мТаблицаДвиженийПартииТоваровНаСкладах.Количество() Цикл  
				
				ТекСтр = мТаблицаДвиженийПартииТоваровНаСкладах.Получить(сч);   
				
				Если ТекСтр.Добавлена Тогда
					сч = сч + 1;
					Продолжить;
				КонецЕсли;
				
				Если ТекСтр.Количество < 0 Тогда
					НадоСписать = -ТекСтр.Количество;
					ВидДвижения = ВидДвиженияНакопления.Расход;
					Стоимость   = -ТекСтр.Стоимость;
				Иначе
					НадоСписать = ТекСтр.Количество;
					ВидДвижения = ВидДвиженияНакопления.Приход;  
					Стоимость   = ТекСтр.Стоимость;
				КонецЕсли;  
				
				СтруктураОтбора = Новый Структура("Номенклатура, Склад, ХарактеристикаНоменклатуры, СерияНоменклатуры, Качество, ДокументОприходования, Заказ, СтатусПартии",
				ТекСтр.Номенклатура, 
				ТекСтр.Склад, 
				ТекСтр.ХарактеристикаНоменклатуры, 
				ТекСтр.СерияНоменклатуры, 
				ТекСтр.Качество,
				ТекСтр.ДокументОприходования,
				ТекСтр.Заказ,
				ТекСтр.СтатусПартии);  
				
				
				МассивСтрок = ОстаткиПоПартиям.НайтиСтроки(СтруктураОтбора); 
				
				Если МассивСтрок.Количество() > 0 Тогда
					
					НайденнаяСтрока = МассивСтрок[0];	
					
					Если НадоСписать = 0 Тогда 
						Прервать;
					КонецЕсли; 
					
					Если НайденнаяСтрока.КоличествоОстаток >= 0 Тогда 
						
						НайденнаяСтрока.КоличествоОстаток = НайденнаяСтрока.КоличествоОстаток - НадоСписать;
						НайденнаяСтрока.СтоимостьОстаток = НайденнаяСтрока.СтоимостьОстаток - Стоимость;
						сч = сч + 1;
						Продолжить;
						
					КонецЕсли; 
					
					
					КоличествоПревышение = -НайденнаяСтрока.КоличествоОстаток; 
					СтоимостьПревышение = -НайденнаяСтрока.СтоимостьОстаток;
					
					Если НадоСписать <= КоличествоПревышение Тогда  
						
						СтруктураПоиска = Новый Структура("Номенклатура, Склад, ХарактеристикаНоменклатуры, Качество",
						ТекСтр.Номенклатура, 
						ТекСтр.Склад, 
						ТекСтр.ХарактеристикаНоменклатуры, 
						ТекСтр.Качество); 
						
						Если КорректировкаПоВыкупу Тогда
							СтруктураПоиска.Вставить("ДокументОприходования", ТекСтр.ДокументОприходования);
						КонецЕсли;
						
						МассивОстатков = ОстаткиПоПартиям.НайтиСтроки(СтруктураПоиска);
						
						КоличествоРаспределить = НадоСписать;  
						СтоимостьРаспределить = Стоимость;
						
						Для Каждого СтрокаОстатков Из МассивОстатков Цикл
							
							Если КоличествоРаспределить <= 0 Тогда
								Прервать;
							КонецЕсли;
							
							Если СтрокаОстатков.ДокументОприходования = ТекСтр.ДокументОприходования 
								Или СтрокаОстатков.КоличествоОстаток <= 0 Тогда
								Продолжить;
							КонецЕсли;  
							
							КоличествоВРегистр = Мин(СтрокаОстатков.КоличествоОстаток, КоличествоРаспределить);
							КоличествоРаспределить = КоличествоРаспределить - КоличествоВРегистр;  
							
							СтоимостьВРегистр = Мин(СтрокаОстатков.СтоимостьОстаток, СтоимостьРаспределить);
							СтоимостьРаспределить = СтоимостьРаспределить - СтоимостьВРегистр;
							
							НС = мТаблицаДвиженийПартииТоваровНаСкладах.Добавить();
							НС.ВидДвижения = ТекСтр.ВидДвижения;
							НС.Период = Дата;
							НС.ДокументОприходования = СтрокаОстатков.ДокументОприходования;
							НС.СтатусПартии  = СтрокаОстатков.СтатусПартии;
							НС.Заказ = СтрокаОстатков.Заказ;
							НС.Склад = ТекСтр.Склад;
							НС.Номенклатура  =   ТекСтр.Номенклатура;
							НС.ХарактеристикаНоменклатуры  =   ТекСтр.ХарактеристикаНоменклатуры;
							НС.СерияНоменклатуры  =   СтрокаОстатков.СерияНоменклатуры;
							НС.Качество  =   ТекСтр.Качество;  
							НС.Количество = -КоличествоВРегистр;
							НС.Стоимость = 	-СтоимостьВРегистр;
							НС.Регистратор = Ссылка;
							НС.Активность = Истина;
							НС.СписаниеПартий = Истина;
							НС.КодОперации =  ТекСтр.КодОперации;  
							
							НС.Добавлена = Истина;   
							
							СтрокаОстатков.КоличествоОстаток = СтрокаОстатков.КоличествоОстаток - КоличествоВРегистр;
							СтрокаОстатков.СтоимостьОстаток = СтрокаОстатков.СтоимостьОстаток - СтоимостьВРегистр;
							
						КонецЦикла;
						
						мТаблицаДвиженийПартииТоваровНаСкладах.Удалить(ТекСтр);   
						
					Иначе   
						
						ТекСтр.Количество = -1 * (НадоСписать + НайденнаяСтрока.КоличествоОстаток);  
						ТекСтр.Стоимость = -1 * (Стоимость + НайденнаяСтрока.СтоимостьОстаток);
						
						СтруктураПоиска = Новый Структура("Номенклатура, Склад, ХарактеристикаНоменклатуры, Качество",
						ТекСтр.Номенклатура, 
						ТекСтр.Склад, 
						ТекСтр.ХарактеристикаНоменклатуры, 
						ТекСтр.Качество); 
						
						Если КорректировкаПоВыкупу Тогда
							СтруктураПоиска.Вставить("ДокументОприходования", ТекСтр.ДокументОприходования);
						КонецЕсли;
						
						МассивОстатков = ОстаткиПоПартиям.НайтиСтроки(СтруктураПоиска);
						
						КоличествоРаспределить = НадоСписать - Sqrt(ТекСтр.Количество * ТекСтр.Количество); 
						СтоимостьРаспределить = Стоимость - Sqrt(ТекСтр.Стоимость * ТекСтр.Стоимость);
						
						Для Каждого СтрокаОстатков Из МассивОстатков Цикл
							
							Если КоличествоРаспределить <= 0 Тогда
								Прервать;
							КонецЕсли;
							
							Если СтрокаОстатков.ДокументОприходования = ТекСтр.ДокументОприходования 
								Или СтрокаОстатков.КоличествоОстаток <= 0 Тогда
								Продолжить;
							КонецЕсли;  
							
							КоличествоВРегистр = Мин(СтрокаОстатков.КоличествоОстаток, КоличествоРаспределить);
							КоличествоРаспределить = КоличествоРаспределить - КоличествоВРегистр;  
							
							СтоимостьЕдОстаток = ?(СтрокаОстатков.КоличествоОстаток = 0, 0, СтрокаОстатков.СтоимостьОстаток / СтрокаОстатков.КоличествоОстаток);
							СтоимостьВРегистр = СтоимостьЕдОстаток * КоличествоВРегистр; //Мин(СтрокаОстатков.СтоимостьОстаток, СтоимостьРаспределить);
							СтоимостьРаспределить = СтоимостьРаспределить - СтоимостьВРегистр;
							
							НС = мТаблицаДвиженийПартииТоваровНаСкладах.Добавить();
							НС.ВидДвижения = ТекСтр.ВидДвижения;
							НС.Период = Дата;
							НС.ДокументОприходования = СтрокаОстатков.ДокументОприходования;
							НС.СтатусПартии  = СтрокаОстатков.СтатусПартии;
							НС.Заказ = СтрокаОстатков.Заказ;
							НС.Склад = ТекСтр.Склад;
							НС.Номенклатура  =   ТекСтр.Номенклатура;
							НС.ХарактеристикаНоменклатуры  =   ТекСтр.ХарактеристикаНоменклатуры;
							НС.СерияНоменклатуры  =   СтрокаОстатков.СерияНоменклатуры;
							НС.Качество  =   ТекСтр.Качество;  
							НС.Количество = -КоличествоВРегистр;
							НС.Стоимость = 	-СтоимостьВРегистр;
							НС.Регистратор = Ссылка;
							НС.Активность = Истина;
							НС.СписаниеПартий = Истина;
							НС.КодОперации =  ТекСтр.КодОперации;  
							
							НС.Добавлена = Истина;     
							
							СтрокаОстатков.КоличествоОстаток = СтрокаОстатков.КоличествоОстаток - КоличествоВРегистр;
							СтрокаОстатков.СтоимостьОстаток = СтрокаОстатков.СтоимостьОстаток - СтоимостьВРегистр;
							
						КонецЦикла;
						
						сч = сч + 1;   
						
					КонецЕсли;
					
				Иначе     
					сч = сч + 1;						
				КонецЕсли; 
			КонецЦикла;
			
			Движения.ПартииТоваровНаСкладах.Загрузить(мТаблицаДвиженийПартииТоваровНаСкладах);
			Движения.ПартииТоваровНаСкладах.Записать();
			//-Гавриленков В. 02.11.2024 #UT10-4861
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры // ОбработкаПроведения()
//
Функция ПроверкаНаНаличиеПоУпрОрганизации(Номенклатура, ХарактеристикаНоменклатуры, Склад,
	СерияНоменклатуры, Количество, Д, УправленческаяОрганизация) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТоварыОрганизацийОстатки.Номенклатура,
	               |	ТоварыОрганизацийОстатки.Склад,
	               |	ТоварыОрганизацийОстатки.ХарактеристикаНоменклатуры,
	               |	ТоварыОрганизацийОстатки.СерияНоменклатуры,
	               |	ТоварыОрганизацийОстатки.Качество,
	               |	ТоварыОрганизацийОстатки.КоличествоОстаток
	               |ИЗ
	               |	РегистрНакопления.ТоварыОрганизаций.Остатки(
	               |			&Д,
	               |			Номенклатура = &Номенклатура
	               |				И СерияНоменклатуры = &СерияНоменклатуры
	               |				И Склад = &Склад
	               |				И ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры
	               |				И Организация = &Организация) КАК ТоварыОрганизацийОстатки";
	
	Запрос.УстановитьПараметр("Д", Д);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("СерияНоменклатуры",СерияНоменклатуры );
	Запрос.УстановитьПараметр("Склад",Склад );
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры", ХарактеристикаНоменклатуры);
	Запрос.УстановитьПараметр("Организация", УправленческаяОрганизация);
	
	Остатки = Запрос.Выполнить().Выгрузить();
	
	Если Остатки.Количество() = 0 Тогда 
		Возврат Ложь;
	Иначе 
		
		Если Остатки[0].КоличествоОстаток >= Количество * (-1) Тогда 
			Возврат Истина;
		Иначе 
			Возврат Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции
																																			
Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ОбщегоНазначения.УдалитьДвиженияРегистратора(ЭтотОбъект, Отказ);
	
КонецПроцедуры // ОбработкаУдаленияПроведения

// Функция создает таблицу для формирования сторнирующих движений по рег. Партии товаров на складах, в случае поступления по ордеру
//
Функция СоздатьТаблицуСторнированияПартийПриПоступленииПоОрдеру(ТабТовары)
	
	ТаблицаПартииПоОрдерам = ТабТовары.Скопировать();
	
	Если ТаблицаПартииПоОрдерам.Колонки.Найти("ДокументОприходования") = Неопределено Тогда
		ТаблицаПартииПоОрдерам.Колонки.Добавить("ДокументОприходования");
	КонецЕсли;
	
	Сч = 0;
	
	Пока Сч < ТаблицаПартииПоОрдерам.Количество() Цикл
		
		СтрокаТаблицы = ТаблицаПартииПоОрдерам.Получить(Сч);
		
		Если СтрокаТаблицы.БезПраваПродажи = Истина Тогда
			ТаблицаПартииПоОрдерам.Удалить(СтрокаТаблицы);
		Иначе
			
			// Документ оприходования - приходный ордрер
			СтрокаТаблицы.ДокументОприходования = СтрокаТаблицы.ДокументПолучения;
			СтрокаТаблицы.Склад                 = СтрокаТаблицы.ПриходныйОрдерСклад;
			СтрокаТаблицы.Количество            = -СтрокаТаблицы.Количество;
			
			Если НЕ ТаблицаПартииПоОрдерам.Колонки.Найти("Заказ") = Неопределено Тогда
				СтрокаТаблицы.Заказ             = Неопределено;
			КонецЕсли;
			
			// Если партионный учет по сериям не ведется, то надо очистить серию
			Если НЕ СтрокаТаблицы.ВестиПартионныйУчетПоСериям Тогда
				СтрокаТаблицы.СерияНоменклатуры = Неопределено;
			КонецЕсли;
			
			Сч = Сч + 1;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаПартииПоОрдерам;
	
КонецФункции // СоздатьТаблицуСторнированияПартийПриПоступленииПоОрдеру(ТаблицаПоТоварам)


#Если Клиент Тогда
	
Функция ПечатьТорг2() Экспорт
		
	ОрганизацияДляПечФормы = СокрЛП(Константы.ОсновнаяОрганизация.Получить().Наименование);
	ТабличныйДокумент = Новый ТабличныйДокумент;			
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ОтветственныеЛицаОрганизацииСрезПоследних.ФизическоеЛицо КАК Руководитель
	|ИЗ
	|	РегистрСведений.ОтветственныеЛицаОрганизации.СрезПоследних(
	|			&Д,
	|			ОтветственноеЛицо = &ОтветственноеЛицо
	|				И СтруктурнаяЕдиница = &СтруктурнаяЕдиница) КАК ОтветственныеЛицаОрганизацииСрезПоследних";
	
	Запрос.УстановитьПараметр("СтруктурнаяЕдиница", Организация);
	Запрос.УстановитьПараметр("Д", Дата);
	Запрос.УстановитьПараметр("ОтветственноеЛицо", Перечисления.ОтветственныеЛицаОрганизации.Руководитель);
	
	РуководительТаблица = Запрос.Выполнить().Выгрузить();
	
	Если РуководительТаблица.Количество() = 0 Тогда 
		Руководитель = "";
	Иначе    
		
		Руководитель =  РуководительТаблица[0].Руководитель ;
		ФамилияИмяОтчествоФизЛица      	 = ФормированиеПечатныхФорм.ФамилияИмяОтчество(Руководитель, Дата);
		ПерваяБукваОтчества =  Лев(ФамилияИмяОтчествоФизЛица.Отчество, 1);
		ПерваяБукваИмя =  Лев(ФамилияИмяОтчествоФизЛица.Имя, 1);
		Руководитель= ФамилияИмяОтчествоФизЛица.Фамилия + " " + ПерваяБукваИмя + "." + ПерваяБукваОтчества + ".";   
		
	КонецЕсли;
	
	МассивТаблиц = Новый Массив;
	
	НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
	
	Макет = ПолучитьМакет("ТОРГ2");
	
	ЗапросШапка = Новый Запрос;
	ЗапросШапка.Текст =
	"ВЫБРАТЬ
	|	КорректировкаПоступления.Ссылка,
	|	КорректировкаПоступления.Контрагент,
	|	КорректировкаПоступления.Организация,
	|	КорректировкаПоступления.Дата,
	|	КорректировкаПоступления.Номер,
	|	КорректировкаПоступления.ДокументПоступления КАК Основание,
	|	КорректировкаПоступления.ДокументПоступления.Дата КАК ОснованиеДата,
	|	КорректировкаПоступления.ДокументПоступления.Номер КАК ОснованиеНомер,
	|	КорректировкаПоступления.ДоговорКонтрагента,
	|	КорректировкаПоступления.ДоговорКонтрагента.Дата КАК ДоговорДата,
	|	КорректировкаПоступления.ДоговорКонтрагента.Номер КАК ДоговорНомер
	|ИЗ
	|	Документ.КорректировкаПоступления КАК КорректировкаПоступления
	|ГДЕ
	|	КорректировкаПоступления.Ссылка = &Ссылка";
	
	ЗапросШапка.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
	ВыборкаШапка = ЗапросШапка.Выполнить().Выбрать();
	ВыборкаШапка.Следующий();
	
	ЗапросТаблица = Новый Запрос;
	ЗапросТаблица.Текст =
	"ВЫБРАТЬ
	|	КорректировкаПоступленияТовары.Номенклатура,
	|	КорректировкаПоступленияТовары.ЕдиницаИзмерения,
	|	СУММА(КорректировкаПоступленияТовары.Количество) КАК Количество,
	|	СУММА(КорректировкаПоступленияТовары.КоличествоДоИзменения) КАК КоличествоДоИзменения,
	|	ВЫБОР
	|		КОГДА КорректировкаПоступленияТовары.Количество = 0
	|			ТОГДА КорректировкаПоступленияТовары.ЦенаДоИзменения
	|		ИНАЧЕ КорректировкаПоступленияТовары.Цена
	|	КОНЕЦ КАК Цена,
	|	КорректировкаПоступленияТовары.ЦенаДоИзменения КАК ЦенаДоИзменения,
	|	СУММА(КорректировкаПоступленияТовары.Сумма) КАК Сумма,
	|	СУММА(КорректировкаПоступленияТовары.СуммаДоИзменения) КАК СуммаДоИзменения,
	|	КорректировкаПоступленияТовары.ЕдиницаИзмерения.ЕдиницаПоКлассификатору.Код КАК ЕдиницаИзмеренияКод,
	|	КорректировкаПоступленияТовары.Номенклатура.КодПроизводителя КАК Артикул
	|ПОМЕСТИТЬ ВтТовары
	|ИЗ
	|	Документ.КорректировкаПоступления.Товары КАК КорректировкаПоступленияТовары
	|ГДЕ
	|	КорректировкаПоступленияТовары.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	КорректировкаПоступленияТовары.Номенклатура,
	|	КорректировкаПоступленияТовары.ЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА КорректировкаПоступленияТовары.Количество = 0
	|			ТОГДА КорректировкаПоступленияТовары.ЦенаДоИзменения
	|		ИНАЧЕ КорректировкаПоступленияТовары.Цена
	|	КОНЕЦ,
	|	КорректировкаПоступленияТовары.ЕдиницаИзмерения.ЕдиницаПоКлассификатору.Код,
	|	КорректировкаПоступленияТовары.Номенклатура.КодПроизводителя,
	|	КорректировкаПоступленияТовары.ЦенаДоИзменения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВтТовары.Номенклатура,
	|	ВтТовары.ЕдиницаИзмерения,
	|	ВтТовары.Количество,
	|	ВтТовары.КоличествоДоИзменения,
	|	ВтТовары.Цена,
	|	ВтТовары.ЦенаДоИзменения,
	|	ВтТовары.Сумма,
	|	ВтТовары.СуммаДоИзменения,
	|	ВтТовары.ЕдиницаИзмеренияКод,
	|	ВтТовары.Артикул
	|ИЗ
	|	ВтТовары КАК ВтТовары
	|ГДЕ
	|	НЕ(ВтТовары.Количество = ВтТовары.КоличествоДоИзменения
	|				И ВтТовары.Цена = ВтТовары.ЦенаДоИзменения)";
	
	ЗапросТаблица.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
	ТЧ_Товары = ЗапросТаблица.Выполнить().Выгрузить();
	
	НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
	
	ОбластьМакета = Макет.ПолучитьОбласть("Страница1Шапка");
	СведенияОГрузополучателе  = УправлениеКонтактнойИнформацией.СведенияОЮрФизЛице(ВыборкаШапка.Организация,  ВыборкаШапка.Дата);
	СведенияОГрузоотправитель = УправлениеКонтактнойИнформацией.СведенияОЮрФизЛице(ВыборкаШапка.Контрагент, ВыборкаШапка.Дата);
	ОбластьМакета.Параметры.ФактическийАдрес = ФормированиеПечатныхФорм.ОписаниеОрганизации(СведенияОГрузополучателе, 
	"ФактическийАдрес");
	ОбластьМакета.Параметры.Организация = ФормированиеПечатныхФорм.ОписаниеОрганизации(СведенияОГрузополучателе, 
	"ПолноеНаименование,ФактическийАдрес,Телефоны");
	ОбластьМакета.Параметры.Поставщик = ФормированиеПечатныхФорм.ОписаниеОрганизации(СведенияОГрузоотправитель, 
	"ПолноеНаименование,ЮридическийАдрес,Телефоны");
	ОбластьМакета.Параметры.Грузоотправитель = ФормированиеПечатныхФорм.ОписаниеОрганизации(СведенияОГрузоотправитель, 
	"ПолноеНаименование,ЮридическийАдрес,Телефоны");
	ОбластьМакета.Параметры.КодОКПО = СведенияОГрузополучателе.КодПоОКПО;
	
	//Дата день, месяц, год
	ОбластьМакета.Параметры.ДатаДень = Формат(ВыборкаШапка.Дата,"ДФ=dd");
	ОбластьМакета.Параметры.ДатаМесяц = Формат(ВыборкаШапка.Дата, "ДФ=MMММ");
	ОбластьМакета.Параметры.ДатаГод = Формат(ВыборкаШапка.Дата, "ДФ=yyyy"); 
	//-------------------
	//номер и дата договора, номер и дата основания
	ОбластьМакета.Параметры.НомДоговора = ВыборкаШапка.ДоговорНомер;
	ОбластьМакета.Параметры.ДатаДогДень = Формат(ВыборкаШапка.ДоговорДата,"ДФ=dd");
	ОбластьМакета.Параметры.ДатаДогМесяц = Формат(ВыборкаШапка.ДоговорДата,"ДФ=MMMM");
	ОбластьМакета.Параметры.ДатаДогГод = Формат(ВыборкаШапка.ДоговорДата,"ДФ=yyyy");
	ОбластьМакета.Параметры.Руководитель = Руководитель;
	
	СчетФактура = УчетНДС.НайтиПодчиненныйДокумент(ВыборкаШапка.Основание, "СчетФактураПолученный");
	
	Если СчетФактура  = Неопределено Тогда 
		
		Сообщить("У документа - основания не введена счет фактура. Печать невозможна!!", СтатусСообщения.ОченьВажное);
		Возврат Неопределено;
		
	КонецЕсли;
	
	ДатаОтпрвленияТовара = Формат(СчетФактура.ДатаВходящегоДокумента, "ДЛФ=DD");
	НомерПробела =   Найти(ДатаОтпрвленияТовара, " ");
	ДатаОтпрвленияТовараЧисло = Лев(ДатаОтпрвленияТовара,НомерПробела - 1);
	
	ДатаОтпрвленияТовараМесяцГод = Сред(ДатаОтпрвленияТовара,НомерПробела + 1);
	ОбластьМакета.Параметры.ДатаОтпрвленияТовараЧисло = ДатаОтпрвленияТовараЧисло;
	ОбластьМакета.Параметры.ДатаОтпрвленияТовараМесяцГод =ДатаОтпрвленияТовараМесяцГод; 
	ОбластьМакета.Параметры.НаименованиеПоставщика = ВыборкаШапка.Основание.Контрагент.НаименованиеПолное;
	
	ДатаСчетаФактуры = СчетФактура.ДатаВходящегоДокумента;
	ОбластьМакета.Параметры.СчетФактураНомер = СокрЛП(СчетФактура.НомерВходящегоДокумента);
	ОбластьМакета.Параметры.СчетФактураДатаДень = Формат(ДатаСчетаФактуры, "ДФ=dd");
	ОбластьМакета.Параметры.СчетФактураДатаМесяц = Формат(ДатаСчетаФактуры, "ДФ=MMMM");
	ОбластьМакета.Параметры.СчетФактураДатаГод = Формат(ДатаСчетаФактуры, "ДФ=yyyy");
	
	ОбластьМакета.Параметры.ОснованиеНомер = СокрЛП(СчетФактура.НомерВходящегоДокумента);
	ОбластьМакета.Параметры.ОснованиеДата  = Формат(ДатаСчетаФактуры, "ДФ='dd.MM.yyyy ""г.""'");
	
	//-------------------------------------------
	
	ОбластьМакета.Параметры.Номер =ПолучитьЦифрыОтНомера(ВыборкаШапка.Номер);
	ОбластьМакета.Параметры.Дата  = ВыборкаШапка.Дата;				
	
	
	ТабличныйДокумент.Вывести(ОбластьМакета);			
	
	ОбластьШапка = Макет.ПолучитьОбласть("Страница1Таблица1Шапка");
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	ОбластьШапка = Макет.ПолучитьОбласть("Страница1Таблица1Строка");
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	
	ОбластьШапка = Макет.ПолучитьОбласть("Страница2Шапка");
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	ОбластьШапка = Макет.ПолучитьОбласть("Страница2Таблица2Шапка");
	ТабличныйДокумент.Вывести(ОбластьШапка); 
	
	СоответствиеПоДаннымПоставщика = Новый Соответствие;  
	ТаблицаЗаключение = Новый ТаблицаЗначений;
	ТаблицаЗаключение.Колонки.Добавить("ГруппаТовара"); 
	ТаблицаЗаключение.Колонки.Добавить("КодПроизводителя");
	ТаблицаЗаключение.Колонки.Добавить("Сумма");
	ТаблицаЗаключение.Колонки.Добавить("НаименованиеТовара");
	ТаблицаЗаключение.Колонки.Добавить("Номенклатура");
	
	Для Каждого СтрокаТЧ Из Товары Цикл
		
		СтруктураСДанными = _ПолучитьСтруктуруТовара(СтрокаТЧ);  
		
		Если СтруктураСДанными = Неопределено Тогда
			Продолжить;
		КонецЕсли; 
		
		ПоДаннымПоставщика =СтруктураСДанными.ПоДаннымПоставщика; 
		СоответствиеПоДаннымПоставщика.Вставить(СтрокаТЧ.Номенклатура, ПоДаннымПоставщика); 
		СтруктураПоиска = Новый Структура("ГруппаТовара, КодПроизводителя, НаименованиеТовара, Номенклатура", 
		                  СтруктураСДанными.Группа, СтруктураСДанными.КодПроизводителя, СтруктураСДанными.НаименованиеТовара, СтрокаТЧ.Номенклатура);
		МассивНайденных = ТаблицаЗаключение.НайтиСтроки(СтруктураПоиска);
		
		Если МассивНайденных.Количество() = 0 Тогда
			
			НовСтрока = ТаблицаЗаключение.Добавить();
			НовСтрока.ГруппаТовара = СтруктураСДанными.Группа;  
			НовСтрока.КодПроизводителя = СтруктураСДанными.КодПроизводителя;
			НовСтрока.НаименованиеТовара = СтруктураСДанными.НаименованиеТовара;
			НовСтрока.Номенклатура = СтрокаТЧ.Номенклатура; 
			НовСтрока.Сумма = 0; 
			ОбластьШапка = Макет.ПолучитьОбласть("Страница2Таблица2Строка");
			ОбластьШапка.Параметры.НаименованиеТовара = СтруктураСДанными.НаименованиеТовара;
			ОбластьШапка.Параметры.БазоваяЕдИзм =   СтруктураСДанными.ЕдИзм;
			
			ОбластьШапка.Параметры.ПоДаннымПоставщика = ПоДаннымПоставщика;
			ТабличныйДокумент.Вывести(ОбластьШапка);
			
		КонецЕсли;

		ЗаМинусомВозврата	= СтруктураСДанными.ЗаМинусомВозврата;	
		Расхождение = ПоДаннымПоставщика - ЗаМинусомВозврата ;
		
	КонецЦикла;
	
	ОбластьШапка = Макет.ПолучитьОбласть("Страница2Продолжение1");
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	ОбластьШапка = Макет.ПолучитьОбласть("Страница2Таблица2");
	ОбластьШапка.Параметры.ПоДаннымПоставщика =  ПоДаннымПоставщика;
	ОбластьШапка.Параметры.ЗаМинусомВозврата = ЗаМинусомВозврата;
	ОбластьШапка.Параметры.Расхождение = Расхождение;
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	ОбластьШапка = Макет.ПолучитьОбласть("Страница2Таблица3Шапка");
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Страница2Таблица3Строка");
	
	Ном = 0;
	
	Для каждого СтрокаТЗ Из ТЧ_Товары Цикл
		
		Ном = Ном + 1;
		ОбластьМакета.Параметры.Заполнить(СтрокаТЗ);
		ОбластьМакета.Параметры.Ном = Ном;
		//+Марков И. 04.03.2025 #UT10-5129
		ПоДаннымПоставщика = СоответствиеПоДаннымПоставщика.Получить(СтрокаТЗ.Номенклатура);
		ОбластьМакета.Параметры.ПоДаннымПоставщика = ПоДаннымПоставщика;
		//-Марков И. 04.03.2025 #UT10-5129
		
		Если  СтрокаТЗ.Цена <> 0 Тогда 
			ОбластьМакета.Параметры.СуммаДоИзменения = ПоДаннымПоставщика * СтрокаТЗ.Цена;
		Иначе 
			ОбластьМакета.Параметры.СуммаДоИзменения = ПоДаннымПоставщика * СтрокаТЗ.ЦенаДоИзменения;
		КонецЕсли;
		
		ТабличныйДокумент.Вывести(ОбластьМакета);
		
	КонецЦикла; 
	
	
	ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	ОбластьШапка = Макет.ПолучитьОбласть("Страница3Шапка"); 

	ТаблицаЗаключениеКопия = ТаблицаЗаключение.Скопировать();
	ТаблицаЗаключениеКопия.Свернуть("ГруппаТовара");
	
	СтрокаГруппа = "";
	
	Для Каждого Стр Из ТаблицаЗаключениеКопия Цикл  
		СтрокаГруппа = СтрокаГруппа + ", " + Строка(Стр.ГруппаТовара);
	КонецЦикла;
	
	СтрокаГруппаТовара = Сред(СтрокаГруппа, 3);
	ОбластьШапка.Параметры.Группа = СтрокаГруппаТовара;
	ОбластьШапка.Параметры.ДатаОтпрвленияТовараЧисло = ДатаОтпрвленияТовараЧисло;
	ОбластьШапка.Параметры.ДатаОтпрвленияТовараМесяцГод = ДатаОтпрвленияТовараМесяцГод;
	
	
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	ОбластьШапка = Макет.ПолучитьОбласть("Страница3Таблица4Шапка");
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Страница3Таблица4Строка");
	
	СуммаДляИтого = 0;
	
	Ном = 0;
	
	Для каждого СтрокаТЗ Из ТЧ_Товары Цикл   
		
		СуммаПоСтроке = 0;
		
		Ном = Ном +1;
		ОбластьМакета.Параметры.Заполнить(СтрокаТЗ);
		ОбластьМакета.Параметры.Ном = Ном;
		ОбластьМакета.Параметры.КолФакт = СтрокаТЗ.Количество;
		ОбластьМакета.Параметры.ЦенаФакт = СтрокаТЗ.Цена;
		ОбластьМакета.Параметры.СуммаФакт = СтрокаТЗ.Сумма;
		
		ОбластьМакета.Параметры.КолБрак = 0;
		ОбластьМакета.Параметры.СуммаБрак = 0;
		
		ОбластьМакета.Параметры.Количество = 0;
		ОбластьМакета.Параметры.Сумма = 0;
		ОбластьМакета.Параметры.КолИзлишек = 0;
		ОбластьМакета.Параметры.СуммаИзлишек = 0;
		
		ЕщеПоступилоСумма = 0 ;
		ЕщеПоступило = 0;
		
		Если СтрокаТЗ.Количество > СтрокаТЗ.КоличествоДоИзменения Тогда
			
			ОбластьМакета.Параметры.КолИзлишек = СтрокаТЗ.Количество - СтрокаТЗ.КоличествоДоИзменения;
			ОбластьМакета.Параметры.СуммаИзлишек = СтрокаТЗ.Сумма - СтрокаТЗ.СуммаДоИзменения;
			ОбластьМакета.Параметры.КолФакт  = СтрокаТЗ.Количество;
			ОбластьМакета.Параметры.ЦенаФакт  = СтрокаТЗ.ЦенаДоИзменения;
			ОбластьМакета.Параметры.СуммаФакт  = СтрокаТЗ.Сумма;
			СуммаДляИтого = СуммаДляИтого + ОбластьМакета.Параметры.СуммаИзлишек; 
			СуммаПоСтроке = ОбластьМакета.Параметры.СуммаИзлишек;
			
		КонецЕсли;
		
		Если СтрокаТЗ.Количество < СтрокаТЗ.КоличествоДоИзменения Тогда

			ОбластьМакета.Параметры.Количество = - СтрокаТЗ.Количество + СтрокаТЗ.КоличествоДоИзменения;
			ОбластьМакета.Параметры.Сумма = - СтрокаТЗ.Сумма + СтрокаТЗ.СуммаДоИзменения;
			СуммаДляИтого = СуммаДляИтого+ОбластьМакета.Параметры.Сумма ;
			СуммаПоСтроке = ОбластьМакета.Параметры.Сумма;
			
			ОбластьМакета.Параметры.КолФакт  = СтрокаТЗ.Количество;
			ОбластьМакета.Параметры.ЦенаФакт  = СтрокаТЗ.ЦенаДоИзменения;
			ОбластьМакета.Параметры.СуммаФакт  = СтрокаТЗ.Сумма;
			
		КонецЕсли;		
		
		ТабличныйДокумент.Вывести(ОбластьМакета);    
		
		НайденнаяСтрока = ТаблицаЗаключение.Найти(СтрокаТЗ.Номенклатура, "Номенклатура");
		
		Если НайденнаяСтрока <> Неопределено Тогда
			НайденнаяСтрока.Сумма = НайденнаяСтрока.Сумма + СуммаПоСтроке;
		КонецЕсли;
		
	КонецЦикла; 
	
	
	ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	ОбластьШапка = Макет.ПолучитьОбласть("Страница4Шапка");
	ОбластьШапка.Параметры.ПодробноеОписаниеДефектов = ПодробноеОписаниеДефектов; 

	ТекстЗаключение = "";
	
	Для Каждого Стр Из ТаблицаЗаключение Цикл                                                                                                                                                   
		ТекстЗаключение = ТекстЗаключение + СокрЛП(ЗаключениеКомиссии) + " " + Строка(Стр.ГруппаТовара) + "  " 
		+ Стр.КодПроизводителя + " " + Стр.НаименованиеТовара + " на сумму " + Формат(Стр.Сумма, "ЧГ=0") + " руб." + Символы.ПС; 
	КонецЦикла;
	
	ОбластьШапка.Параметры.ЗаключениеКомиссии = ТекстЗаключение;

	//   Члены комиссии
	ФамилияИмяОтчествоФизЛица = ФормированиеПечатныхФорм.ФамилияИмяОтчество(Председатель, Дата);
	ПерваяБукваОтчества =  Лев(ФамилияИмяОтчествоФизЛица.Отчество, 1);
	ПерваяБукваИмя =  Лев(ФамилияИмяОтчествоФизЛица.Имя, 1);
	Пред= ФамилияИмяОтчествоФизЛица.Фамилия + " " + ПерваяБукваИмя + "." + ПерваяБукваОтчества + ".";
	ОбластьШапка.Параметры.Председатель  = Пред  ;
	ОбластьШапка.Параметры.Должность  = ОрганизацияДляПечФормы + " " + МСК.ПолучитьДолжностьФЛ(Председатель);
	
	
	ФамилияИмяОтчествоФизЛица      	 = ФормированиеПечатныхФорм.ФамилияИмяОтчество(Член1, Дата);
	ПерваяБукваОтчества =  Лев(ФамилияИмяОтчествоФизЛица.Отчество, 1);
	ПерваяБукваИмя =  Лев(ФамилияИмяОтчествоФизЛица.Имя, 1);
	Член1_= ФамилияИмяОтчествоФизЛица.Фамилия + " " + ПерваяБукваИмя + "." + ПерваяБукваОтчества + ".";
	ОбластьШапка.Параметры.Член1  = Член1_  ;
	ОбластьШапка.Параметры.Должность1  = ОрганизацияДляПечФормы + " " + МСК.ПолучитьДолжностьФЛ(Член1);
	
	
	ФамилияИмяОтчествоФизЛица      	 = ФормированиеПечатныхФорм.ФамилияИмяОтчество(Член2, Дата);
	ПерваяБукваОтчества =  Лев(ФамилияИмяОтчествоФизЛица.Отчество, 1);
	ПерваяБукваИмя =  Лев(ФамилияИмяОтчествоФизЛица.Имя, 1);
	Член2_= ФамилияИмяОтчествоФизЛица.Фамилия + " " + ПерваяБукваИмя + "." + ПерваяБукваОтчества + ".";
	ОбластьШапка.Параметры.Член2  = Член2_  ;
	ОбластьШапка.Параметры.Должность2  = ОрганизацияДляПечФормы + " " + МСК.ПолучитьДолжностьФЛ(Член2);
	
	
	ФамилияИмяОтчествоФизЛица      	 = ФормированиеПечатныхФорм.ФамилияИмяОтчество(Член3, Дата);
	ПерваяБукваОтчества =  Лев(ФамилияИмяОтчествоФизЛица.Отчество, 1);
	ПерваяБукваИмя =  Лев(ФамилияИмяОтчествоФизЛица.Имя, 1);
	Член3_= ФамилияИмяОтчествоФизЛица.Фамилия + " " + ПерваяБукваИмя + "." + ПерваяБукваОтчества + ".";
	ОбластьШапка.Параметры.Член3  = Член3_  ;
	ОбластьШапка.Параметры.Должность3  = ОрганизацияДляПечФормы + " " + МСК.ПолучитьДолжностьФЛ(Член3);
	
	
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	Возврат ТабличныйДокумент;		
		
КонецФункции

Функция ПечатьТорг2Брак() Экспорт
		
	ОрганизацияДляПечФормы = СокрЛП(Константы.ОсновнаяОрганизация.Получить().Наименование);
	ТабличныйДокумент = Новый ТабличныйДокумент;			
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ОтветственныеЛицаОрганизацииСрезПоследних.ФизическоеЛицо КАК Руководитель
	|ИЗ
	|	РегистрСведений.ОтветственныеЛицаОрганизации.СрезПоследних(
	|			&Д,
	|			ОтветственноеЛицо = &ОтветственноеЛицо
	|				И СтруктурнаяЕдиница = &СтруктурнаяЕдиница) КАК ОтветственныеЛицаОрганизацииСрезПоследних";
	
	Запрос.УстановитьПараметр("СтруктурнаяЕдиница",Организация );
	Запрос.УстановитьПараметр("Д",Дата );
	Запрос.УстановитьПараметр("ОтветственноеЛицо",Перечисления.ОтветственныеЛицаОрганизации.Руководитель );
	
	РуководительТаблица = Запрос.Выполнить().Выгрузить();
	
	Если РуководительТаблица.Количество() = 0 Тогда 
		Руководитель = "";
	Иначе 
		
		Руководитель =  РуководительТаблица[0].Руководитель ;
		ФамилияИмяОтчествоФизЛица = ФормированиеПечатныхФорм.ФамилияИмяОтчество(Руководитель, Дата);
		ПерваяБукваОтчества =  Лев(ФамилияИмяОтчествоФизЛица.Отчество, 1);
		ПерваяБукваИмя =  Лев(ФамилияИмяОтчествоФизЛица.Имя, 1);
		Руководитель= ФамилияИмяОтчествоФизЛица.Фамилия + " " + ПерваяБукваИмя + "." + ПерваяБукваОтчества + ".";
		
	КонецЕсли;
	
	МассивТаблиц = Новый Массив;
	НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
	Макет = ПолучитьМакет("ТОРГ2");
	
	ЗапросШапка = Новый Запрос;
	ЗапросШапка.Текст =
	"ВЫБРАТЬ
	|	КорректировкаПоступления.Ссылка,
	|	КорректировкаПоступления.Контрагент,
	|	КорректировкаПоступления.Организация,
	|	КорректировкаПоступления.Дата,
	|	КорректировкаПоступления.Номер,
	|	КорректировкаПоступления.ДокументПоступления КАК Основание,
	|	КорректировкаПоступления.ДокументПоступления.Дата КАК ОснованиеДата,
	|	КорректировкаПоступления.ДокументПоступления.Номер КАК ОснованиеНомер,
	|	КорректировкаПоступления.ДоговорКонтрагента,
	|	КорректировкаПоступления.ДоговорКонтрагента.Дата КАК ДоговорДата,
	|	КорректировкаПоступления.ДоговорКонтрагента.Номер КАК ДоговорНомер
	|ИЗ
	|	Документ.КорректировкаПоступления КАК КорректировкаПоступления
	|ГДЕ
	|	КорректировкаПоступления.Ссылка = &Ссылка";
	
	ЗапросШапка.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
	ВыборкаШапка = ЗапросШапка.Выполнить().Выбрать();
	ВыборкаШапка.Следующий();
	
	ЗапросТаблица = Новый Запрос;
	ЗапросТаблица.Текст =
	"ВЫБРАТЬ
	|	КорректировкаПоступленияТовары.Номенклатура,
	|	КорректировкаПоступленияТовары.ЕдиницаИзмерения,
	|	СУММА(КорректировкаПоступленияТовары.Количество) КАК Количество,
	|	СУММА(КорректировкаПоступленияТовары.КоличествоДоИзменения) КАК КоличествоДоИзменения,
	|	ВЫБОР
	|		КОГДА КорректировкаПоступленияТовары.Количество = 0
	|			ТОГДА КорректировкаПоступленияТовары.ЦенаДоИзменения
	|		ИНАЧЕ КорректировкаПоступленияТовары.Цена
	|	КОНЕЦ КАК Цена,
	|	КорректировкаПоступленияТовары.ЦенаДоИзменения КАК ЦенаДоИзменения,
	|	СУММА(КорректировкаПоступленияТовары.Сумма) КАК Сумма,
	|	СУММА(КорректировкаПоступленияТовары.СуммаДоИзменения) КАК СуммаДоИзменения,
	|	КорректировкаПоступленияТовары.ЕдиницаИзмерения.ЕдиницаПоКлассификатору.Код КАК ЕдиницаИзмеренияКод,
	|	КорректировкаПоступленияТовары.Номенклатура.КодПроизводителя КАК Артикул
	|ПОМЕСТИТЬ ВтТовары
	|ИЗ
	|	Документ.КорректировкаПоступления.Товары КАК КорректировкаПоступленияТовары
	|ГДЕ
	|	КорректировкаПоступленияТовары.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	КорректировкаПоступленияТовары.Номенклатура,
	|	КорректировкаПоступленияТовары.ЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА КорректировкаПоступленияТовары.Количество = 0
	|			ТОГДА КорректировкаПоступленияТовары.ЦенаДоИзменения
	|		ИНАЧЕ КорректировкаПоступленияТовары.Цена
	|	КОНЕЦ,
	|	КорректировкаПоступленияТовары.ЕдиницаИзмерения.ЕдиницаПоКлассификатору.Код,
	|	КорректировкаПоступленияТовары.Номенклатура.КодПроизводителя,
	|	КорректировкаПоступленияТовары.ЦенаДоИзменения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВтТовары.Номенклатура,
	|	ВтТовары.ЕдиницаИзмерения,
	|	ВтТовары.Количество,
	|	ВтТовары.КоличествоДоИзменения,
	|	ВтТовары.Цена,
	|	ВтТовары.ЦенаДоИзменения,
	|	ВтТовары.Сумма,
	|	ВтТовары.СуммаДоИзменения,
	|	ВтТовары.ЕдиницаИзмеренияКод,
	|	ВтТовары.Артикул
	|ИЗ
	|	ВтТовары КАК ВтТовары
	|ГДЕ
	|	НЕ(ВтТовары.Количество = ВтТовары.КоличествоДоИзменения
	|				И ВтТовары.Цена = ВтТовары.ЦенаДоИзменения)";
	
	ЗапросТаблица.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
	ТЧ_Товары = ЗапросТаблица.Выполнить().Выгрузить();
	
	НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
	
	ОбластьМакета = Макет.ПолучитьОбласть("Страница1Шапка");
	СведенияОГрузополучателе  = УправлениеКонтактнойИнформацией.СведенияОЮрФизЛице(ВыборкаШапка.Организация,  ВыборкаШапка.Дата);
	СведенияОГрузоотправитель = УправлениеКонтактнойИнформацией.СведенияОЮрФизЛице(ВыборкаШапка.Контрагент, ВыборкаШапка.Дата);
	ОбластьМакета.Параметры.ФактическийАдрес = ФормированиеПечатныхФорм.ОписаниеОрганизации(СведенияОГрузополучателе, 
	"ФактическийАдрес");
	ОбластьМакета.Параметры.Организация = ФормированиеПечатныхФорм.ОписаниеОрганизации(СведенияОГрузополучателе, 
	"ПолноеНаименование,ФактическийАдрес,Телефоны");
	ОбластьМакета.Параметры.Поставщик = ФормированиеПечатныхФорм.ОписаниеОрганизации(СведенияОГрузоотправитель, 
	"ПолноеНаименование,ЮридическийАдрес,Телефоны");
	ОбластьМакета.Параметры.Грузоотправитель = ФормированиеПечатныхФорм.ОписаниеОрганизации(СведенияОГрузоотправитель, 
	"ПолноеНаименование,ЮридическийАдрес,Телефоны");
	ОбластьМакета.Параметры.КодОКПО = СведенияОГрузополучателе.КодПоОКПО;
	
	//Дата день, месяц, год
	ОбластьМакета.Параметры.ДатаДень = Формат(ВыборкаШапка.Дата,"ДФ=dd");
	ОбластьМакета.Параметры.ДатаМесяц = Формат(ВыборкаШапка.Дата, "ДФ=MMММ");
	ОбластьМакета.Параметры.ДатаГод = Формат(ВыборкаШапка.Дата, "ДФ=yyyy"); //ДанныеПечати.Датагод;
	//-------------------
	//номер и дата договора, номер и дата основания
	ОбластьМакета.Параметры.НомДоговора = ВыборкаШапка.ДоговорНомер;
	ОбластьМакета.Параметры.ДатаДогДень = Формат(ВыборкаШапка.ДоговорДата,"ДФ=dd");
	ОбластьМакета.Параметры.ДатаДогМесяц = Формат(ВыборкаШапка.ДоговорДата,"ДФ=MMMM");
	ОбластьМакета.Параметры.ДатаДогГод = Формат(ВыборкаШапка.ДоговорДата,"ДФ=yyyy");
	ОбластьМакета.Параметры.Руководитель = Руководитель;
	
	СчетФактура = УчетНДС.НайтиПодчиненныйДокумент(ВыборкаШапка.Основание, "СчетФактураПолученный");
	
	Если СчетФактура = Неопределено Тогда 
		
		Сообщить("У документа - основания не введена счет фактура. Печать невозможна!!", СтатусСообщения.ОченьВажное);
		Возврат Неопределено;
		
	КонецЕсли;
	
	ДатаОтпрвленияТовара = Формат(СчетФактура.ДатаВходящегоДокумента, "ДЛФ=DD");
	НомерПробела =   Найти(ДатаОтпрвленияТовара, " ");
	ДатаОтпрвленияТовараЧисло = Лев(ДатаОтпрвленияТовара, НомерПробела - 1);
	
	ДатаОтпрвленияТовараМесяцГод = Сред(ДатаОтпрвленияТовара, НомерПробела + 1);
	ОбластьМакета.Параметры.ДатаОтпрвленияТовараЧисло = ДатаОтпрвленияТовараЧисло;
	ОбластьМакета.Параметры.ДатаОтпрвленияТовараМесяцГод =ДатаОтпрвленияТовараМесяцГод; 
	ОбластьМакета.Параметры.НаименованиеПоставщика = ВыборкаШапка.Основание.Контрагент.НаименованиеПолное ;
	
	ДатаСчетаФактуры = СчетФактура.ДатаВходящегоДокумента;
	ОбластьМакета.Параметры.СчетФактураНомер = СокрЛП(СчетФактура.НомерВходящегоДокумента);
	ОбластьМакета.Параметры.СчетФактураДатаДень = Формат(ДатаСчетаФактуры, "ДФ=dd");
	ОбластьМакета.Параметры.СчетФактураДатаМесяц = Формат(ДатаСчетаФактуры, "ДФ=MMMM");
	ОбластьМакета.Параметры.СчетФактураДатаГод = Формат(ДатаСчетаФактуры, "ДФ=yyyy");
	
	ОбластьМакета.Параметры.ОснованиеНомер = СокрЛП(СчетФактура.НомерВходящегоДокумента);
	ОбластьМакета.Параметры.ОснованиеДата  = Формат(ДатаСчетаФактуры, "ДФ='dd.MM.yyyy ""г.""'");
	
	//-------------------------------------------
	
	ОбластьМакета.Параметры.Номер = ПолучитьЦифрыОтНомера(ВыборкаШапка.Номер);
	ОбластьМакета.Параметры.Дата  = ВыборкаШапка.Дата;				
	
	ТабличныйДокумент.Вывести(ОбластьМакета);			
	
	ОбластьШапка = Макет.ПолучитьОбласть("Страница1Таблица1Шапка");
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	ОбластьШапка = Макет.ПолучитьОбласть("Страница1Таблица1Строка");
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	ОбластьШапка = Макет.ПолучитьОбласть("Страница2Шапка");
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	ОбластьШапка = Макет.ПолучитьОбласть("Страница2Таблица2Шапка");
	ТабличныйДокумент.Вывести(ОбластьШапка); 
	
	СоответствиеПоДаннымПоставщика = Новый Соответствие;  
	ТаблицаЗаключение = Новый ТаблицаЗначений;
	ТаблицаЗаключение.Колонки.Добавить("ГруппаТовара"); 
	ТаблицаЗаключение.Колонки.Добавить("КодПроизводителя");
	ТаблицаЗаключение.Колонки.Добавить("Сумма");
	ТаблицаЗаключение.Колонки.Добавить("НаименованиеТовара");
	ТаблицаЗаключение.Колонки.Добавить("Номенклатура");
	
	Для Каждого СтрокаТЧ Из Товары Цикл
		
		СтруктураСДанными = _ПолучитьСтруктуруТовара(СтрокаТЧ);  
		
		Если СтруктураСДанными = Неопределено Тогда
			Продолжить;
		КонецЕсли; 
		
		ПоДаннымПоставщика = СтруктураСДанными.ПоДаннымПоставщика; 
		СоответствиеПоДаннымПоставщика.Вставить(СтрокаТЧ.Номенклатура, ПоДаннымПоставщика); 
		
		СтруктураПоиска = Новый Структура("ГруппаТовара, КодПроизводителя, НаименованиеТовара, Номенклатура", 
		                  СтруктураСДанными.Группа, СтруктураСДанными.КодПроизводителя, СтруктураСДанными.НаименованиеТовара, СтрокаТЧ.Номенклатура);
		МассивНайденных = ТаблицаЗаключение.НайтиСтроки(СтруктураПоиска);
		
		Если МассивНайденных.Количество() = 0 Тогда
			
			НовСтрока = ТаблицаЗаключение.Добавить();
			НовСтрока.ГруппаТовара = СтруктураСДанными.Группа;  
			НовСтрока.КодПроизводителя = СтруктураСДанными.КодПроизводителя;
			НовСтрока.НаименованиеТовара = СтруктураСДанными.НаименованиеТовара;
			НовСтрока.Номенклатура = СтрокаТЧ.Номенклатура; 
			НовСтрока.Сумма = 0; 
			
			ОбластьШапка = Макет.ПолучитьОбласть("Страница2Таблица2Строка");
			ОбластьШапка.Параметры.НаименованиеТовара = СтруктураСДанными.НаименованиеТовара;
			ОбластьШапка.Параметры.БазоваяЕдИзм = СтруктураСДанными.ЕдИзм;
			
			ОбластьШапка.Параметры.ПоДаннымПоставщика = ПоДаннымПоставщика;
			ТабличныйДокумент.Вывести(ОбластьШапка);
			
		КонецЕсли;
		
		ЗаМинусомВозврата = СтруктураСДанными.ЗаМинусомВозврата;	
		Расхождение = ПоДаннымПоставщика - ЗаМинусомВозврата ;
		
	КонецЦикла;
	
	ОбластьШапка = Макет.ПолучитьОбласть("Страница2Продолжение1");
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	ОбластьШапка = Макет.ПолучитьОбласть("Страница2Таблица2");
	ОбластьШапка.Параметры.ПоДаннымПоставщика =  ПоДаннымПоставщика;
	ОбластьШапка.Параметры.ЗаМинусомВозврата = ПоДаннымПоставщика;
	ОбластьШапка.Параметры.Расхождение = 0;
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	ОбластьШапка = Макет.ПолучитьОбласть("Страница2Таблица3Шапка");
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Страница2Таблица3Строка");
	
	Ном = 0;
	
	Для каждого СтрокаТЗ Из ТЧ_Товары Цикл
		
		Ном = Ном + 1;
		ОбластьМакета.Параметры.Заполнить(СтрокаТЗ);
		ОбластьМакета.Параметры.Ном = Ном; 
		ОбластьМакета.Параметры.ПоДаннымПоставщика = СоответствиеПоДаннымПоставщика.Получить(СтрокаТЗ.Номенклатура);
		
		Если СтрокаТЗ.Цена <> 0 Тогда 
			ОбластьМакета.Параметры.СуммаДоИзменения = ПоДаннымПоставщика * СтрокаТЗ.Цена;
		Иначе 
			ОбластьМакета.Параметры.СуммаДоИзменения = ПоДаннымПоставщика * СтрокаТЗ.ЦенаДоИзменения;
		КонецЕсли;
		
		ТабличныйДокумент.Вывести(ОбластьМакета);
		
	КонецЦикла; 
	
	ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	ОбластьШапка = Макет.ПолучитьОбласть("Страница3Шапка"); 

	ТаблицаЗаключениеКопия = ТаблицаЗаключение.Скопировать();
	ТаблицаЗаключениеКопия.Свернуть("ГруппаТовара");
	СтрокаГруппа = "";
	
	Для Каждого Стр Из ТаблицаЗаключениеКопия Цикл  
		СтрокаГруппа = СтрокаГруппа + ", " + Строка(Стр.ГруппаТовара);
	КонецЦикла;
	
	СтрокаГруппаТовара = Сред(СтрокаГруппа, 3);
	ОбластьШапка.Параметры.Группа = СтрокаГруппаТовара;
	ОбластьШапка.Параметры.ДатаОтпрвленияТовараЧисло = ДатаОтпрвленияТовараЧисло;
	ОбластьШапка.Параметры.ДатаОтпрвленияТовараМесяцГод = ДатаОтпрвленияТовараМесяцГод;
	
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	ОбластьШапка = Макет.ПолучитьОбласть("Страница3Таблица4Шапка");
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Страница3Таблица4Строка");
	
	СуммаДляИтого = 0;
	
	Ном = 0;
	
	Для каждого СтрокаТЗ Из ТЧ_Товары Цикл   
		
		СуммаПоСтроке = 0;
		
		Ном = Ном +1;
		ОбластьМакета.Параметры.Заполнить(СтрокаТЗ); 

		ОбластьМакета.Параметры.Ном = Ном;
		ПромКолПоДокументу = СоответствиеПоДаннымПоставщика.Получить(СтрокаТЗ.Номенклатура);  
		ОбластьМакета.Параметры.КолФакт = ПромКолПоДокументу;
		ОбластьМакета.Параметры.ЦенаФакт = СтрокаТЗ.Цена;
		ОбластьМакета.Параметры.СуммаФакт = ПромКолПоДокументу * СтрокаТЗ.Цена;
		
		ОбластьМакета.Параметры.КолБрак = СтрокаТЗ.Количество;
		ОбластьМакета.Параметры.СуммаБрак = СтрокаТЗ.Сумма;
		
		ОбластьМакета.Параметры.Количество = 0;
		ОбластьМакета.Параметры.Сумма = 0;
		ОбластьМакета.Параметры.КолИзлишек = 0;
		ОбластьМакета.Параметры.СуммаИзлишек = 0;
		
		ЕщеПоступилоСумма = 0 ;
		ЕщеПоступило = 0;
		
		Если СтрокаТЗ.Количество > СтрокаТЗ.КоличествоДоИзменения Тогда
			
			ОбластьМакета.Параметры.КолИзлишек = СтрокаТЗ.Количество - СтрокаТЗ.КоличествоДоИзменения;
			ОбластьМакета.Параметры.СуммаИзлишек = СтрокаТЗ.Сумма - СтрокаТЗ.СуммаДоИзменения;
			СуммаДляИтого = СуммаДляИтого + ОбластьМакета.Параметры.СуммаИзлишек; 
			СуммаПоСтроке = ОбластьМакета.Параметры.СуммаИзлишек;
			
		КонецЕсли;
		
		Если СтрокаТЗ.Количество < СтрокаТЗ.КоличествоДоИзменения Тогда
			
			ОбластьМакета.Параметры.КолБрак = -СтрокаТЗ.Количество + СтрокаТЗ.КоличествоДоИзменения;
			ОбластьМакета.Параметры.СуммаБрак = -СтрокаТЗ.Сумма + СтрокаТЗ.СуммаДоИзменения;			
			
			СуммаДляИтого = СуммаДляИтого+ОбластьМакета.Параметры.Сумма;
			СуммаПоСтроке = - СтрокаТЗ.Сумма + СтрокаТЗ.СуммаДоИзменения;

		КонецЕсли;		
		
		ТабличныйДокумент.Вывести(ОбластьМакета);    
		
		НайденнаяСтрока = ТаблицаЗаключение.Найти(СтрокаТЗ.Номенклатура, "Номенклатура");
		
		Если НайденнаяСтрока <> Неопределено Тогда
			НайденнаяСтрока.Сумма = НайденнаяСтрока.Сумма + СуммаПоСтроке;
		КонецЕсли;
		
	КонецЦикла; 
	
	ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	ОбластьШапка = Макет.ПолучитьОбласть("Страница4Шапка");
	ОбластьШапка.Параметры.ПодробноеОписаниеДефектов = ПодробноеОписаниеДефектов; 
	ТекстЗаключение = "";
	
	Для Каждого Стр Из ТаблицаЗаключение Цикл
		
		Если ЗначениеЗаполнено(Стр.Номенклатура) Тогда
			ТекстЗаключение = ТекстЗаключение + СокрЛП(ЗаключениеКомиссии) + " " + Строка(Стр.ГруппаТовара) + "  "
			                + Стр.КодПроизводителя + " " + Стр.НаименованиеТовара + " на сумму " + Формат(Стр.Сумма, "ЧГ=0") + " руб." + Символы.ПС; 
		КонецЕсли;
		
	КонецЦикла;
	
	ОбластьШапка.Параметры.ЗаключениеКомиссии = ТекстЗаключение;
	
	//   Члены комиссии
	ФамилияИмяОтчествоФизЛица = ФормированиеПечатныхФорм.ФамилияИмяОтчество(Председатель, Дата);
	ПерваяБукваОтчества =  Лев(ФамилияИмяОтчествоФизЛица.Отчество,1);
	ПерваяБукваИмя =  Лев(ФамилияИмяОтчествоФизЛица.Имя,1);
	Пред= ФамилияИмяОтчествоФизЛица.Фамилия + " " + ПерваяБукваИмя + "." + ПерваяБукваОтчества + ".";
	ОбластьШапка.Параметры.Председатель  = Пред;
	ОбластьШапка.Параметры.Должность  = ОрганизацияДляПечФормы + " " + МСК.ПолучитьДолжностьФЛ(Председатель);
	
	
	ФамилияИмяОтчествоФизЛица = ФормированиеПечатныхФорм.ФамилияИмяОтчество(Член1, Дата);
	ПерваяБукваОтчества =  Лев(ФамилияИмяОтчествоФизЛица.Отчество, 1);
	ПерваяБукваИмя =  Лев(ФамилияИмяОтчествоФизЛица.Имя, 1);
	Член1_= ФамилияИмяОтчествоФизЛица.Фамилия + " " + ПерваяБукваИмя + "." + ПерваяБукваОтчества + ".";
	ОбластьШапка.Параметры.Член1  = Член1_;
	ОбластьШапка.Параметры.Должность1  = ОрганизацияДляПечФормы + " " + МСК.ПолучитьДолжностьФЛ(Член1);
	
	
	ФамилияИмяОтчествоФизЛица = ФормированиеПечатныхФорм.ФамилияИмяОтчество(Член2, Дата);
	ПерваяБукваОтчества =  Лев(ФамилияИмяОтчествоФизЛица.Отчество, 1);
	ПерваяБукваИмя =  Лев(ФамилияИмяОтчествоФизЛица.Имя, 1);
	Член2_= ФамилияИмяОтчествоФизЛица.Фамилия + " " + ПерваяБукваИмя + "." + ПерваяБукваОтчества + ".";
	ОбластьШапка.Параметры.Член2  = Член2_;
	ОбластьШапка.Параметры.Должность2  = ОрганизацияДляПечФормы + " " + МСК.ПолучитьДолжностьФЛ(Член2);
	
	
	ФамилияИмяОтчествоФизЛица = ФормированиеПечатныхФорм.ФамилияИмяОтчество(Член3, Дата);
	ПерваяБукваОтчества =  Лев(ФамилияИмяОтчествоФизЛица.Отчество, 1);
	ПерваяБукваИмя =  Лев(ФамилияИмяОтчествоФизЛица.Имя, 1);
	Член3_= ФамилияИмяОтчествоФизЛица.Фамилия + " " + ПерваяБукваИмя + "." + ПерваяБукваОтчества + ".";
	ОбластьШапка.Параметры.Член3  = Член3_;
	ОбластьШапка.Параметры.Должность3  = ОрганизацияДляПечФормы + " " + МСК.ПолучитьДолжностьФЛ(Член3);
	
	ТабличныйДокумент.Вывести(ОбластьШапка);
	Возврат ТабличныйДокумент;		

КонецФункции

Процедура  НайтиПоступлениеИзДругихСтрок(Номенклатура, ЕщеПоступилоСумма, ЕщеПоступило)
	
	ЕщеПоступилоСумма = 0;
	ЕщеПоступило = 0;
	
	Для каждого ТекСтр Из Товары Цикл
		
		Если ТекСтр.Номенклатура =  Номенклатура Тогда 
			
			ЕщеПоступило = ЕщеПоступило + ТекСтр.Количество ;
			ЕщеПоступилоСумма = ЕщеПоступилоСумма + ТекСтр.Сумма;

		КонецЕсли;
		
	КонецЦикла; 

КонецПроцедуры

Функция ПолучитьЦифрыОтНомера(ОснованиеНомер)
	
	НомерОдниЦыфры = ОснованиеНомер;
	Х = 1;
	
	Пока Х < СтрДлина(НомерОдниЦыфры) + 1 Цикл
		
		ПервыйСимвол = Лев(НомерОдниЦыфры, 1); 
		
		Если ПервыйСимвол =  "1" или ПервыйСимвол = "2" или ПервыйСимвол = "3"
			или ПервыйСимвол = "4" или ПервыйСимвол = "5" или ПервыйСимвол = "6" или ПервыйСимвол = "7" или ПервыйСимвол = "8" или ПервыйСимвол = "9" Тогда 
			
			Возврат НомерОдниЦыфры;
			НомерОдниЦыфры = сред(НомерОдниЦыфры, 2); 
			
		Иначе 
			НомерОдниЦыфры = сред(НомерОдниЦыфры, 2);
		КонецЕсли;
		
	КонецЦикла; 
	
	Возврат ОснованиеНомер;

КонецФункции

Функция ПолучитьСтруктуруТовара()
	
	СтруктураНаВозврат = Новый Структура("НаименованиеТовара,ЕдИзм,Группа,Сумма,КодПроизводителя,ПоДаннымПоставщика,ЗаМинусомВозврата");
	
	Для каждого ТекСтр Из Товары Цикл
		
		Если ТекСтр.Количество <> ТекСтр.КоличествоДоИзменения Тогда 
			
			СтруктураНаВозврат.НаименованиеТовара = ТекСтр.Номенклатура.Наименование;
			СтруктураНаВозврат.ЕдИзм = ТекСтр.Номенклатура.БазоваяЕдиницаИзмерения.Наименование;
			СтруктураНаВозврат.Группа = ТекСтр.Номенклатура.Родитель;
			СтруктураНаВозврат.Сумма = ТекСтр.СуммаДоИзменения;
			СтруктураНаВозврат.КодПроизводителя = ТекСтр.Номенклатура.КодПроизводителя;
			
			СтруктураНоменклатурыВозврата = ПолучитьСтруктуру(ТекСтр.Номенклатура);
			
			СтруктураНаВозврат.ПоДаннымПоставщика = СтруктураНоменклатурыВозврата.ПоДаннымПоставщика;
			СтруктураНаВозврат.ЗаМинусомВозврата = СтруктураНоменклатурыВозврата.ЗаМинусомВозврата;
