
Процедура ПриЗаписи(Отказ, Замещение)
//+Белов А. 21.11.2024 # UT10-4928

	Для каждого Запись Из ЭтотОбъект Цикл
		
		Если Не Запись.Коробка <> Справочники.КоробкиХраненияДокументов.КоробкаЭДО Тогда
			Продолжить;	
		КонецЕсли;  
		
		Если Не ЗначениеЗаполнено(Запись.Документ) Тогда
			Продолжить;
		КонецЕсли;
		
		СтруктураЗаписи = Новый Структура;
		СтруктураЗаписи.Вставить("Статус", Перечисления.СтатусыОбменаЭДО.Завершен);
		СтруктураЗаписи.Вставить("Период", Запись.ДатаПолучения);
		СтруктураЗаписи.Вставить("Ошибка", "");            
		
		Комментарий = "";
		
		Комментарий = Комментарий + "Коробка: " + Строка(Запись.Коробка);
		Комментарий = Комментарий + Символы.ПС + "№ пп: " + Строка(Запись.НомерПоПорядку);    
		Комментарий = Комментарий + Символы.ПС + "ФИО получателя: " + Запись.ФИО;
		Комментарий = Комментарий + Символы.ПС + "Дата получения: " + Строка(Запись.ДатаПолучения);
		Комментарий = Комментарий + Символы.ПС + "Дата последнего изменения: " + Строка(Запись.ДатаПоследнегоИзменения);
		Комментарий = Комментарий + Символы.ПС + "Сумма документа: " + Строка(Запись.СуммаДокумента);
		Комментарий = Комментарий + Символы.ПС + "Оригиналы получены: " + Строка(Запись.ОригиналыПолучены);
		Комментарий = Комментарий + Символы.ПС + "Ошибка оформления: " + Строка(Запись.НетПечати);
		Комментарий = Комментарий + Символы.ПС + "Не актуально: " + Строка(Запись.НеАктуально);
		
		СтруктураЗаписи.Вставить("Комментарий", Комментарий);
		
		AMQP_РаботаСДокументами_ver2.СформироватьСообщениеСостояниеЭДО(Запись.Документ, СтруктураЗаписи);
		
	КонецЦикла;

//-Белов А. 21.11.2024 # UT10-4928	
КонецПроцедуры
