КонецФункции // ()


Процедура ОбработкаВыбораШаблона()
	
	КонецОповещения=НачалоОповещения+?(ВариантШаблона=1,7200,600);

	Макет=РегистрыСведений.ОповещенияПользователей.ПолучитьМакет(ШаблоныСоответствие.Получить(ВариантШаблона));
	
	ТекстТТ=макет.ПолучитьТекст();
	
	СтруктураВложений			= Новый Структура;
		
	ТекстТТ=СтрЗаменить(ТекстТТ,"*НачалоШаблона", "Предварительно");

	ТекстТТ=СтрЗаменить(ТекстТТ,"*НачалаОбновления",формат(КонецОповещения,"ДЛФ=DDT")); 
	
	ВремяТехническихРабот = КонецОповещения+ВремяРеглРабот*60;
	
	ТекстТТ=СтрЗаменить(ТекстТТ,"*ВремяТехническихРабот",формат(ВремяТехническихРабот,"ДЛФ=DDT"));
	
	ТекстТТ=СтрЗаменить(ТекстТТ,"*ИмяБазы", Метаданные.Синоним);
	
	ТекстТТ=СтрЗаменить(ТекстТТ,"*Версия", Метаданные.Версия);

	ТекстТТ=СтрЗаменить(ТекстТТ,"*ОписаниеОбновления", "");

	ТекстТТ=СтрЗаменить(ТекстТТ,"*Отправитель", ПараметрыСеанса.ТекущийПользователь);
	
	ТекстСообщения.УстановитьHTML(ТекстТТ,СтруктураВложений);
	
КонецПроцедуры
 

&НаСервере
Процедура ЗаполнитьСписокПользователей()
	ТЧСоединения.Очистить();
	
	Если ТолькоАктивныеПользователи Тогда
		
		//Пользователи онлайн
		МассивПодключений = ПолучитьСоединенияИнформационнойБазы();
		
		
		Для Индекс = 0 По МассивПодключений.ВГраница()Цикл
			Если МассивПодключений[Индекс].ИмяПриложения = "1CV8" ИЛИ МассивПодключений[Индекс].ИмяПриложения = "1CV8C" Тогда
				
				Если МассивПодключений[Индекс].Пользователь <> Неопределено Тогда
					ПользовательИмя = СокрП(МассивПодключений[Индекс].Пользователь.Имя);
					Ид = Строка(МассивПодключений[Индекс].Пользователь.УникальныйИдентификатор);
					СтрокаТЗ = ТЧСоединения.Добавить();
					СтрокаТЗ.ИмяКомпьютера = МассивПодключений[Индекс].ИмяКомпьютера;
					СтрокаТЗ.Пользователь = МассивПодключений[Индекс].Пользователь.Имя;
                    СтрокаТЗ.ИдентификаторПользователяИБ = МассивПодключений[Индекс].Пользователь.УникальныйИдентификатор;

				КонецЕсли; 
				
			Иначе
				Продолжить;
			КонецЕсли;
			
		КонецЦикла; 
		
		
	Иначе
		Выборка = Справочники.Пользователи.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Выборка.ПометкаУдаления тогда
                Продолжить;
            КонецЕсли;
            СтрокаТЗ = ТЧСоединения.Добавить();
            СтрокаТЗ.Пользователь = Выборка.Код;
            СтрокаТЗ.ИдентификаторПользователяИБ = Выборка.ИдентификаторПользователяИБ;
            
        КонецЦикла; 
    КонецЕсли;  
    
КонецПроцедуры

