&НаСервере
Процедура ПриОткрытииНасервере()

	Если Не ТолькоПросмотр Тогда
		
		НомерСообщения = РегистрыСведений.ОповещенияПользователей.ПолучитьСледНомерОповещения();
		
		Заголовок = "Оповещение №"+НомерСообщения;
		
		НачалоОповещения=Текущаядата();
		
		ИнтервалРассылки=10;
		
		КонецОповещения = Текущаядата()+120*60; //2 часа
		
		ВремяРеглРабот=10;
		
		ТолькоАктивныеПользователи = Истина;
		
		ЗаполнитьСписокПользователей();
		
		ЗаполнитьСписокШаблонов();
		
		ОбработкаВыбораШаблона();
		
	Иначе
		
		ЭтаФорма.ТолькоПросмотр = ТолькоПросмотр;
		
		Элементы.ТЧСоединения.Доступность = Ложь;
		Элементы.ТолькоРаботающиеПользователи.Доступность = Ложь;
		
		Элементы.ФормаОтправитьВсем.Доступность = Ложь;
		Элементы.ФормаОтправитьСообщение.Доступность = Ложь;
		
		Элементы.НачалоОповещения.доступность = Ложь;
		Элементы.ОкончаниеОповещения.доступность = Ложь;
		Элементы.ВремяРеглРабот.доступность = Ложь;

		Элементы.ТЧСоединения.Заголовок = "Доставлено";

		Элементы.АктивныеПользователиПометка.Заголовок ="Доставлено"; 
		Элементы.ТЧСоединенияОтметитьВсе.доступность = Ложь;
		Элементы.ТЧСоединенияСнятьВсе.доступность = Ложь;
		Элементы.ТЧСоединенияОбновить.доступность = Ложь;
		

		ТЧСоединения.Очистить();
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОповещенияПользователей.НомерСообщения,
		|	ОповещенияПользователей.Получатель,
		|	ОповещенияПользователей.НачалоОповещения,
		|	ОповещенияПользователей.КонецОповещения,
		|	ОповещенияПользователей.Дата,
		|	ОповещенияПользователей.ВремяПрочтения,
		|	ОповещенияПользователей.Отправитель,
		|	ОповещенияПользователей.Сообщение,
		|	ОповещенияПользователей.Доставлено,
		|	ОповещенияПользователей.Ответ,
		|	ОповещенияПользователей.Тема,
		|	ОповещенияПользователей.Прочитано
		|ИЗ
		|	РегистрСведений.ОповещенияПользователей КАК ОповещенияПользователей
		|ГДЕ
		|	ОповещенияПользователей.НомерСообщения = &НомерСообщения";
		
		Запрос.УстановитьПараметр("НомерСообщения", НомерСообщения);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			СтрокаТЗ = ТЧСоединения.Добавить();
			СтрокаТЗ.Пометка 	  = Выборка.Доставлено;
			СтрокаТЗ.Пользователь = Выборка.Получатель;
		КонецЦикла;
		
		ЗаполнитьЗначенияСвойств(ЭтаФорма, Выборка);

		Модифицированность = Ложь;
		
	КонецЕсли; 

КонецПроцедуры
 

