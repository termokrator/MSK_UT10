Перем ШаблоныСоответствие;

#Область КлиентОповещенияПользователей

Функция ПолучитьСообщенияОбработкиОповещения()  Экспорт
	
	Получатель=ПараметрыСеанса.ТекущийПользователь;	
	
	СтруктураОбработкиОповещения = РегистрыСведений.ОповещенияПользователей.СтруктураОбработкиОповещения();

	УстановитьПривилегированныйРежим(истина);	
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Оповещения.НомерСообщения,
	|	Оповещения.Получатель,
	|	Оповещения.НачалоОповещения,
	|	Оповещения.КонецОповещения,
	|	Оповещения.Дата,
	|	Оповещения.ВремяПрочтения,
	|	Оповещения.Отправитель,
	|	Оповещения.Сообщение,
	|	Оповещения.Доставлено,
	|	Оповещения.Ответ,
	|	Оповещения.Тема,
	|	Оповещения.Прочитано
	|ИЗ
	|	РегистрСведений.ОповещенияПользователей КАК Оповещения
	|ГДЕ
	|	Оповещения.Получатель = &Получатель
	|	И &ТекДата МЕЖДУ Оповещения.НачалоОповещения И Оповещения.КонецОповещения
	|	И НЕ Оповещения.Прочитано";
	
	Запрос.УстановитьПараметр("ТекДата", ТекущаяДата());
	Запрос.УстановитьПараметр("Получатель",Получатель);
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураОбработкиОповещения,Выборка);
	Иначе 
		СтруктураОбработкиОповещения = Неопределено;
	КонецЕсли; 
	
	УстановитьПривилегированныйРежим(ложь);
	
	Возврат СтруктураОбработкиОповещения;
КонецФункции

#КонецОбласти



#Область ОсновныеПроцедурыИФункцииМодуля

&НаСервере
Функция ОтправитьСообщенияСервер(ОтправлятьВсем=ложь)
	
	МассивОшибок = Новый Массив;
	
	УстановитьПривилегированныйРежим(истина);
	
	СохраняемыйТекстСообщения= ВызватьОбработкуТекстаСервер();
	
	Если  СохраняемыйТекстСообщения="" тогда  
		МассивОшибок.Добавить("Текст сообщения не заполнен!");
	КонецЕсли;
	
	Если МассивОшибок.Количество() = 0 Тогда
		
		Если ОтправлятьВсем Тогда
			
			Для Каждого Стр Из ТЧСоединения Цикл   
				
				СтруктураЗаписи = РегистрыСведений.ОповещенияПользователей.СтруктураОбработкиОповещения();
				
				ЗаполнитьЗначенияСвойств(СтруктураЗаписи,ЭтаФорма);
				СтруктураЗаписи.Вставить("Дата",		НачалоОповещения);
				СтруктураЗаписи.Вставить("Получатель",	РегистрыСведений.ОповещенияПользователей.НайтиПользователя(Стр));
				СтруктураЗаписи.Вставить("Сообщение",	СохраняемыйТекстСообщения);
				СтруктураЗаписи.Вставить("Отправитель",	ПараметрыСеанса.ТекущийПользователь);
				
				РегистрыСведений.ОповещенияПользователей.ЗаписатьОповещение(НомерСообщения,СтруктураЗаписи);
				
			КонецЦикла;
			
		Иначе
			ЕстьВыбранные = Ложь;
			Для Каждого Стр Из ТЧСоединения Цикл   
				
				Если Стр.Пометка Тогда
					
					СтруктураЗаписи = РегистрыСведений.ОповещенияПользователей.СтруктураОбработкиОповещения();
					ЗаполнитьЗначенияСвойств(СтруктураЗаписи,ЭтаФорма);
					СтруктураЗаписи.Вставить("Дата",		НачалоОповещения);
					СтруктураЗаписи.Вставить("Получатель",	РегистрыСведений.ОповещенияПользователей.НайтиПользователя(Стр));
					СтруктураЗаписи.Вставить("Сообщение",	СохраняемыйТекстСообщения);
					СтруктураЗаписи.Вставить("Отправитель",	ПараметрыСеанса.ТекущийПользователь);
					
					РегистрыСведений.ОповещенияПользователей.ЗаписатьОповещение(НомерСообщения,СтруктураЗаписи);
	
					Если Не ЕстьВыбранные Тогда
						ЕстьВыбранные = Истина;
					КонецЕсли; 
				КонецЕсли;
				
			КонецЦикла;
			
			Если Не ЕстьВыбранные Тогда
				МассивОшибок.Добавить("Пользователи не выбраны!");
			КонецЕсли; 
		КонецЕсли; 	

	КонецЕсли; 
	
	УстановитьПривилегированныйРежим(Ложь);	
	
	Возврат МассивОшибок;
КонецФункции 

#КонецОбласти



