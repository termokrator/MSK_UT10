&НаСервере
Функция ПолучитьТекстHTMLВставкиФорматированногоДокумента(ФорматированныйДокумент) Экспорт
	// Обрабатываем комментарии
	ТекстHTML					= "";
	СтруктураВложений			= Новый Структура;
	ФорматированныйДокумент.ПолучитьHTML(ТекстHTML, СтруктураВложений); 
	// Получаем чистый HTML код вложений тела ФД
	п1 = Найти(ТекстHTML, "<body>"); 
	п2 = Найти(ТекстHTML, "</body>");
	
	ТекстHTML =СокрЛП(СтрЗаменить(Сред(ТекстHTML, п1, п2 - п1), "<body>", "")); 
	// Обрабатываем вложения и кодируем для вставки в HTML код
	Для Каждого ЭлементВложения Из СтруктураВложений Цикл
		Ключ		= ЭлементВложения.Ключ;
		Вложение	= ЭлементВложения.Значение;
		
		ФорматПикчи	= Вложение.Формат();
		
		КартинкаВКодировкеBase64= Base64Строка(Вложение.ПолучитьДвоичныеДанные());
		СтрокаПодстановкиHTML	= "data:image/"+ФорматПикчи+";base64,"+КартинкаВКодировкеBase64;
		ТекстHTML				= СтрЗаменить(ТекстHTML, Ключ, СтрокаПодстановкиHTML);
	КонецЦикла;
	// Вернем готовый текст HTML
	Возврат ТекстHTML;
КонецФункции

&НаСервере
Функция ВызватьОбработкуТекстаСервер()
	// Соответствие вставки HTML блоков ФД
	СоответствиеВставокФД = Новый Соответствие;
	// Создаем объект док HTML для сборки переданных ФД в 1 и вывода
	ДокументHTML = Новый ДокументHTML;
	// Плучим тело дока и вставим его в документ
	КорневойЭлемент = ДокументHTML.СоздатьЭлемент("BODY");
	ДокументHTML.ЭлементДокумента.ДобавитьДочерний(КорневойЭлемент);
	//*************************************************************
	//*************************************************************
	// Добавим узлы полученные из ФД поля номер 1 предварительно обрамив их разделительными линиями
	//Разделитель перед выводом ФД нмоер 1
	ЛинияРазделитель	= ДокументHTML.СоздатьЭлемент("hr");
	КорневойЭлемент.ДобавитьДочерний(ЛинияРазделитель);
	//-----------
	ТекстHTMLВставки	= ПолучитьТекстHTMLВставкиФорматированногоДокумента(ТекстСообщения);
	если   ТекстHTMLВставки="" тогда возврат ""; конецесли;
	//---
	УИДВставкиФД		= Строка(Новый УникальныйИдентификатор);
	//---
	СоответствиеВставокФД.Вставить(УИДВставкиФД, ТекстHTMLВставки);
	// Создаем из УИДа блок HTML и вставляем его в тело документа для последующей замены чистым HTML ФД
	ВставкаКодаФД		= ДокументHTML.СоздатьТекстовыйУзел(УИДВставкиФД);	
	КорневойЭлемент.ДобавитьДочерний(ВставкаКодаФД);
	//Разделитель после вывода ФД номер 1
	ЛинияРазделитель	= ДокументHTML.СоздатьЭлемент("hr");
	КорневойЭлемент.ДобавитьДочерний(ЛинияРазделитель);
	//*************************************************************
	//*************************************************************
	// Запишем сформированный HTML документ и получим его код для отображения
	ЗаписьHTML = Новый ЗаписьHTML;
	ЗаписьHTML.УстановитьСтроку();
	
	ЗаписьDOM = Новый ЗаписьDOM();
	ЗаписьDOM.Записать(ДокументHTML,ЗаписьHTML);
	// Получим текст HTML дока
	ЧистыйHTML = ЗаписьHTML.Закрыть();
	// Заменяем УИДы вставок на реальный код
	Для Каждого ОбъектСоответствияФД Из СоответствиеВставокФД Цикл	
		ЧистыйHTML = СтрЗаменить(ЧистыйHTML,ОбъектСоответствияФД.Ключ,ОбъектСоответствияФД.Значение);
	КонецЦикла;	
	// Выводим готовый HTML;
	//ПолеHTMLДокумента = ЧистыйHTML;
	возврат (ЧистыйHTML);
КонецФункции

