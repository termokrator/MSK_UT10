#Область ОповещенияПользователейСервер
 
Функция ЗаписатьОповещение(НомерСообщения,СтруктураЗаписи)Экспорт
	
	УстановитьПривилегированныйРежим(Истина);	
	
	Оповещение 					= РегистрыСведений.ОповещенияПользователей.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(Оповещение,СтруктураЗаписи);
	Оповещение.НомерСообщения = НомерСообщения;
	Оповещение.Записать();

	УстановитьПривилегированныйРежим(Ложь);	

КонецФункции // ЗаписатьОповещение()

Функция ЗаписатьОповещениеОДоставке(ПараметрыЗаписиОДоставке)Экспорт
	
	ПараметрыЗаписиОДоставке.Вставить("Доставлено",Истина);

	
	ЗаписатьОповещение(ПараметрыЗаписиОДоставке.НомерСообщения,ПараметрыЗаписиОДоставке);

КонецФункции // ЗаписатьОповещениеОДоставке()

Функция ПолучитьСледНомерОповещения()  Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ОповещенияПользователей.НомерСообщения
		|ИЗ
		|	РегистрСведений.ОповещенияПользователей КАК ОповещенияПользователей
		|
		|УПОРЯДОЧИТЬ ПО
		|	ОповещенияПользователей.Дата УБЫВ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		НомерСообщения = ВыборкаДетальныеЗаписи.НомерСообщения;	
	Иначе
		НомерСообщения = 0;
	КонецЕсли;
	
	НомерСообщения = НомерСообщения+1;
	
	Возврат НомерСообщения;
	
КонецФункции // ПолучитьСледНомерСообщения()
 
Функция СтруктураОбработкиОповещения() Экспорт

	СтруктураОбработкиОповещения = Новый Структура(
	"НомерСообщения,Тема, Получатель,НачалоОповещения,КонецОповещения,Дата,ВремяПрочтения,Отправитель,Сообщение, Доставлено,Прочитано, Ответ,ТолькоПросмотр",
	Неопределено,Неопределено,Неопределено,Неопределено,Неопределено,Неопределено,Неопределено,"",Ложь,"",Ложь,Ложь);
	
	Возврат СтруктураОбработкиОповещения;
КонецФункции // ()

Процедура УдалитьВсеОповещенияНаСервере() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);	
	
	НЗ = РегистрыСведений.ОповещенияПользователей.СоздатьНаборЗаписей();
	НЗ.Очистить();
	НЗ.Записать();
	
	УстановитьПривилегированныйРежим(Ложь);	
	
КонецПроцедуры

