
&НаКлиенте
Функция ПолучитьСообщенияОбработкиОповещения(ЗавершитьРаботу = Ложь)  Экспорт
	
	Получатель=ПараметрыСеанса.ТекущийПользователь;	
	
	СтруктураОбработкиОповещения = РегистрыСведений.ОповещенияПользователей.СтруктураОбработкиОповещения();

	УстановитьПривилегированныйРежим(истина);	
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Оповещения.НомерСообщения,
	|	Оповещения.Получатель,
	|	Оповещения.НачалоОповещения,
	|	Оповещения.КонецОповещения,
	|	Оповещения.Дата,
	|	Оповещения.ВремяПрочтения,
	|	Оповещения.Отправитель,
	|	Оповещения.Сообщение,
	|	Оповещения.Доставлено,
	|	Оповещения.Ответ,
	|	Оповещения.Тема,
	|	Оповещения.Прочитано
	|ИЗ
	|	РегистрСведений.ОповещенияПользователей КАК Оповещения
	|ГДЕ
	|	Оповещения.Получатель = &Получатель
	|	И &ТекДата МЕЖДУ Оповещения.НачалоОповещения И Оповещения.КонецОповещения
	|	И НЕ Оповещения.Прочитано";
	
	Запрос.УстановитьПараметр("ТекДата", ТекущаяДата());
	Запрос.УстановитьПараметр("Получатель",Получатель);
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураОбработкиОповещения,Выборка);
	Иначе 
		СтруктураОбработкиОповещения = Неопределено;
	КонецЕсли; 
	
	УстановитьПривилегированныйРежим(ложь);
	
	Возврат СтруктураОбработкиОповещения;
КонецФункции


#Область УстановкаПараметровСеанса

Процедура УстановкаПараметровСеанса(ТребуемыеПараметры)Экспорт
	ИнициализацияПользователя();
КонецПроцедуры

Процедура ИнициализацияПользователя()
	
	ТекПользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
	
	Если ТекПользователь.Имя = "" Тогда
		ИмяПользователя           = "НеАвторизован";
		ПолноеИмяПользователя     = "Не авторизован";
	Иначе
		ИмяПользователя           = ИмяПользователя();
		
		Если ПустаяСтрока(ПолноеИмяПользователя()) Тогда
			ПолноеИмяПользователя = ИмяПользователя;
		Иначе
			ПолноеИмяПользователя = ПолноеИмяПользователя();
		КонецЕсли;
	КонецЕсли;
	
	спрСсылка = Справочники.Пользователи.НайтиПоКоду(ИмяПользователя);
	Если спрСсылка.Пустая() Тогда		
		спрОбъект = Справочники.Пользователи.СоздатьЭлемент();
		спрОбъект.Код = ИмяПользователя;
		спрОбъект.Наименование = ПолноеИмяПользователя;
		спрОбъект.Записать();		
		ПараметрыСеанса.ТекущийПользователь = спрОбъект.Ссылка;		
	Иначе		
		ПараметрыСеанса.ТекущийПользователь = спрСсылка;		
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти 


       
#Область ОповещенияПользователеОбычноеПриложениеКлиент

Функция Инициализация(ПолеHTMLДокумента, Принудительно = Ложь) Экспорт
	
	Эксплорер = ПолеHTMLДокумента;
	
	ДвоичныеДанные 	= ПолучитьМакет("TinyMCE_zip");
	КаталогДанных  	= ПолучитьКаталогДанных();
	КаталогСкриптов = КаталогДанных + "tinymce\";
	ФайлАрхива 		= КаталогДанных + "TinyMCE.zip";
	
	ФайлКаталогСкриптов = Новый Файл(КаталогСкриптов);
	ФайлСкрипта = КаталогСкриптов + "tinyMCE\jscripts\tiny_mce\tiny_mce.js";
	Файл = Новый Файл(ФайлСкрипта);
	Если НЕ Принудительно И ФайлКаталогСкриптов.Существует() И Файл.Существует() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Файл = Новый Файл(КаталогСкриптов);
	Если НЕ Файл.Существует() Тогда
		СоздатьКаталог(КаталогСкриптов);
	КонецЕсли;
	
	Попытка
		ДвоичныеДанные.Записать(ФайлАрхива);
	Исключение
		Сообщить(ОписаниеОшибки(), СтатусСообщения.Информация);
		Возврат Ложь;
	КонецПопытки;
	
	зип = Новый ЧтениеZipФайла(ФайлАрхива);
	зип.ИзвлечьВсе(КаталогСкриптов, РежимВосстановленияПутейФайловZIP.Восстанавливать);
	УдалитьФайлы(ФайлАрхива);
	
	Возврат Истина;
КонецФункции

Процедура ПоказатьТекст(ПолеHTMLДокумента, Текст, Редактирование = Ложь, ФайлCSS = Неопределено) Экспорт
	
	КаталогДанных = ПолучитьКаталогДанных();

	ТекстНастроек = ПолучитьМакет("TinyMCE_txt").ПолучитьТекст();
	
	Т = Новый ТекстовыйДокумент;
	Т.ДобавитьСтроку("<HTML><HEAD><meta http-equiv=""Content-Type"" content=""text/html; charset=windows-1251"" content=""no-cache"">");
	Если Редактирование И ЗначениеЗаполнено(ТекстНастроек) Тогда
		Т.ДобавитьСтроку("<script type=""text/javascript"" src=""tinyMCE/tinyMCE/jscripts/tiny_mce/tiny_mce.js""></script>");
		Т.ДобавитьСтроку(ТекстНастроек);
		Т.ДобавитьСтроку("</HEAD><BODY><FONT FACE=""Arial"" SIZE=""-1"">");
		Т.ДобавитьСтроку("<form method=""\"" action=""\"" onsubmit=""return false;"">");
		Т.ДобавитьСтроку("<textarea id=""elm1"" name=""elm1"" style=""width: 100%;height:100%"">");
	Иначе
		Т.ДобавитьСтроку("</HEAD><BODY><FONT FACE=""Arial"" SIZE=""-1"">");
	КонецЕсли;
	
	Т.ДобавитьСтроку(Текст);
	
	Если Редактирование И ЗначениеЗаполнено(ТекстНастроек) Тогда
		Т.ДобавитьСтроку("</textarea>");
	КонецЕсли;
	
	Т.ДобавитьСтроку("</FONT></BODY></HTML>");
	
	Если ФайлCSS <> Неопределено Тогда
		Файл = Новый Файл(ФайлCSS);
		Если Файл.Существует() Тогда
			КопироватьФайл(ФайлCSS, КаталогДанных + "temp.css");
			
			ВремТекст = Т.ПолучитьТекст();
			ВремТекст = СтрЗаменить(ВремТекст, "[CSS]", КаталогДанных + "temp.css");
			Т.УстановитьТекст(ВремТекст);
		КонецЕсли;
	КонецЕсли;
			
	ВремФайл = КаталогДанных + "temp.html";
	Т.Записать(ВремФайл, КодировкаТекста.ANSI);
	
	ПолеHTMLДокумента.Перейти(ВремФайл);
КонецПроцедуры

