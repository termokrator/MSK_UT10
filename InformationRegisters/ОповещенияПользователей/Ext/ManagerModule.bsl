Функция НайтиПользователя(СтрТЧ) Экспорт

    УИД = Новый УникальныйИдентификатор(СтрТЧ.ИдентификаторПользователяИБ);
    
    ОбъектМетаданных = Метаданные.Справочники["Пользователи"];
    ОбъектМенеджер   = Справочники.Пользователи;
    
    Если ЕстьРеквизит("ИдентификаторПользователяИБ",ОбъектМетаданных) Тогда
        
        Пользователь = ОбъектМенеджер.НайтиПоРеквизиту("ИдентификаторПользователяИБ",УИД);
        
    Иначе
        
        Пользователь = ОбъектМенеджер.НайтиПоКоду(СтрТЧ.Пользователь);
        
        Если Не ЗначениеЗаполнено(Пользователь) Тогда
        
        	Пользователь = ОбъектМенеджер.НайтиПоНаименованию(СтрТЧ.Пользователь);
        
        КонецЕсли; 

        Если Не ЗначениеЗаполнено(Пользователь) Тогда
        
        	Сообщить("Пользователь """+Пользователь+""" не найден.",СтатусСообщения.Важное);
        
        КонецЕсли; 

    КонецЕсли; 
    
    Возврат Пользователь;

КонецФункции // ()

Функция ЕстьРеквизит(ИмяРеквизита, ОбъектМетаданных) Экспорт
    
    Если ОбъектМетаданных.Реквизиты.Найти(ИмяРеквизита) = Неопределено Тогда
        Возврат Ложь;
    Иначе
        Возврат Истина;
    КонецЕсли; 
    
КонецФункции // ЕстьРеквизит()

