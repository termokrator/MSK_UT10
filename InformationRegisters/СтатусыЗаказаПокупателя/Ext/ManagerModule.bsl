//Контроль изменения данные в документе

Функция ЕстьРазличияЗаписей(ДокументПроверки)  
	
	ТаблицаДокумента = ДокументПроверки.Товары.Выгрузить();
	ТаблицаДокумента.Свернуть("Номенклатура", "Количество");  
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СтатусыЗаказаПокупателя.Номенклатура,
	|	СУММА(СтатусыЗаказаПокупателя.КоличествоОжидается) КАК Количество
	|ИЗ
	|	РегистрСведений.СтатусыЗаказаПокупателя КАК СтатусыЗаказаПокупателя
	|ГДЕ
	|	СтатусыЗаказаПокупателя.Документ = &Документ
	|
	|СГРУППИРОВАТЬ ПО
	|	СтатусыЗаказаПокупателя.Номенклатура";
	
	Запрос.УстановитьПараметр("Документ", ДокументПроверки);
	
	ТаблицаСверки = Запрос.Выполнить().Выгрузить();

	ТаблицаРазличий = РазницаТаблицЗначений(ТаблицаДокумента, ТаблицаСверки);
	
	Возврат ТаблицаРазличий.Количество() > 0; 
	
КонецФункции

Функция РазницаТаблицЗначений(ТаблицаИсходная, ТаблицаСравнения)
	
    ВсеКолонки = "";  
	
    Для Каждого Колонка Из ТаблицаИсходная.Колонки Цикл 
        ВсеКолонки = ВсеКолонки + ", " + Колонка.Имя
	КонецЦикла;   
	
    ВсеКолонки = Сред(ВсеКолонки, 2);
    
    Таблица = ТаблицаСравнения.Скопировать();    
    
    Таблица.Колонки.Добавить("Знак", Новый ОписаниеТипов("Число"));
    
    Таблица.ЗаполнитьЗначения(1, "Знак");
    
	Для Каждого Строка Из ТаблицаИсходная Цикл 
		ЗаполнитьЗначенияСвойств(Таблица.Добавить(), Строка); 
	КонецЦикла;
    
    Таблица.Колонки.Добавить("Счётчик");
    Таблица.ЗаполнитьЗначения(1, "Счётчик");
    
    Таблица.Свернуть(ВсеКолонки, "Знак, Счётчик");
    
    ТаблицаРазличий = Таблица.Скопировать(Новый Структура("Счётчик", 1), ВсеКолонки + ", Знак");
    ТаблицаРазличий.Сортировать("Номенклатура");
    
    Возврат ТаблицаРазличий;   
    
КонецФункции     

