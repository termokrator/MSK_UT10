&НаКлиенте
Процедура АдресДоставкиНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	Текст = "";
	Подсказка = "Введите адрес доставки";
	Если ВвестиСтроку(Текст, Подсказка, 0, Ложь) Тогда
		
		АдресДоставки = Текст;	
		АдресСтруктура = Ложь;
		
	КонецЕсли;

КонецПроцедуры
