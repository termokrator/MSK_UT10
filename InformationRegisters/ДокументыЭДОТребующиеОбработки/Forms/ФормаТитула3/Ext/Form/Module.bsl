
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Дата = ТекущаяДата();
	
	Идентификатор = Параметры.Идентификатор;
	
	ФактическаяДатаИВремяПрибытия = Дата - 60*30;
	ФактическаяДатаИВремяУбытия = Дата; 
	ПлановаяДатаИВремяПрибытия = Дата;  
	
	Вес = Параметры.Вес;
	КоличествоМест = Параметры.КоличествоМест;
	
	Если Параметры.Свойство("АдресДоставки") Тогда
		
		Если ТипЗнч(Параметры.АдресДоставки) = Тип("Структура") Тогда
			АдресДоставки = СтруктураВСтроку(Параметры.АдресДоставки);	
			АдресСтруктура = Истина;
		Иначе
			АдресДоставки = Параметры.АдресДоставки;	
		КонецЕсли;
		
	КонецЕсли;		
	
	СостояниеГруза = "Груз принят без замечаний";	
	
КонецПроцедуры

&НаСервере
Функция СтруктураВСтроку(Структура)
	
	Результат = "";
	
	Для Каждого КлючЗначение Из Структура Цикл
        Результат = Результат + КлючЗначение.Ключ + " = " + Строка(КлючЗначение.Значение) + "; ";
	КонецЦикла; 
	
    Возврат Результат;  
	
КонецФункции

&НаКлиенте
Процедура Ок(Команда)
	
	МассивРеквизитовПроверки = Новый Массив;
	МассивРеквизитовПроверки.Добавить("ФактическаяДатаИВремяПрибытия");
	МассивРеквизитовПроверки.Добавить("ФактическаяДатаИВремяУбытия");
	МассивРеквизитовПроверки.Добавить("ПлановаяДатаИВремяПрибытия");
	МассивРеквизитовПроверки.Добавить("Вес");
	МассивРеквизитовПроверки.Добавить("КоличествоМест");
	МассивРеквизитовПроверки.Добавить("АдресДоставки");
	МассивРеквизитовПроверки.Добавить("СостояниеГруза");
	
	Для каждого РеквПроверки Из МассивРеквизитовПроверки Цикл
		
		Если Не ЗначениеЗаполнено(ЭтаФорма[РеквПроверки]) Тогда
			
			Сообщить("Не заполнен реквизит: " + РеквПроверки);
			Возврат;
			
		КонецЕсли;
		
	КонецЦикла;    
	
	СтруктураВозврата = Новый Структура;   
	СтруктураВозврата.Вставить("Идентификатор", Идентификатор);
	СтруктураВозврата.Вставить("Вес", Вес);
	СтруктураВозврата.Вставить("КоличествоМест", КоличествоМест);
	СтруктураВозврата.Вставить("СостояниеГруза", СостояниеГруза);
	СтруктураВозврата.Вставить("ФактическаяДатаИВремяПрибытия", ФактическаяДатаИВремяПрибытия);
	СтруктураВозврата.Вставить("ФактическаяДатаИВремяУбытия", ФактическаяДатаИВремяУбытия);
	СтруктураВозврата.Вставить("ПлановаяДатаИВремяПрибытия", ПлановаяДатаИВремяПрибытия);
	
	Если АдресСтруктура Тогда 		                           
		СтруктураВозврата.Вставить("АдресДоставки", АдресВСтруктуру(АдресДоставки));
	Иначе
		СтруктураВозврата.Вставить("АдресДоставки", АдресДоставки);
	КонецЕсли;	
	
	Оповестить("Титул3", СтруктураВозврата);
	Закрыть(); 
		
КонецПроцедуры

Функция АдресВСтруктуру(СтрокаАдреса) 
	
	Адрес = Новый Структура;
	
	// Разбиваем строку на пары "Ключ = Значение"
	Пары = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(СтрокаАдреса, ";");
	
	Для Каждого Пара Из Пары Цикл
		Пара = СокрЛП(Пара);
		Если ПустаяСтрока(Пара) Тогда
			Продолжить;
		КонецЕсли;
		
		// Делим на ключ и значение (только по первому "=")
		ПозицияРавно = Найти(Пара, "=");
		Если ПозицияРавно = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Ключ     = СокрЛП(Лев(Пара, ПозицияРавно - 1));
		Значение = СокрЛП(Сред(Пара, ПозицияРавно + 1));
		
		// Добавляем в структуру
		Адрес.Вставить(Ключ, Значение); 
		
	КонецЦикла;  
	
	Возврат Адрес;
	
КонецФункции

